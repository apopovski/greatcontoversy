\u47803 \u54616 \u50668  \u47736 \u47581 \u54644  \u44032 \u44256  \u51080 \u45796 . \u44536 \u46308 \u51008  \u54616 \u45208 \u45784 \u44760  \u46300 \u47540  \u49901 \u51068 \u51312 \u50752  \u54732 \u44552 \u51012  \u46020 \u46161 \u51656 \u54616 \u45716  \u54620 \u54200 , \u44032 \u45212 \u54620  \u51088 \u46308 \u51012  \u44396 \u51228 \u54616 \u44144 \u45208  \u48373 \u51020 \u49324 \u50629 \u51012  \u50976 \u51648 \u54616 \u45716  \u51068 \u48372 \u45796  \u45908 \u50865  \u47566 \u51008  \u44163 \u51012  \u44536 \u46308 \u51012  \u47736 \u47581 \u49884 \u53412 \u45716  \u51221 \u50837 \u51032  \u51228 \u45800  \u50948 \u50640 \u49436  \u48520 \u49332 \u46972  \u48260 \u47536 \u45796 . \u47564 \u51068  \u44536 \u47532 \u49828 \u46020 \u47484  \u46384 \u47476 \u45716  \u51088 \u46308 \u51060 \u46972 \u44256  \u44277 \u50616 \u54616 \u45716  \u47784 \u46304  \u49324 \u46988 \u46308 \u51060  \u51652 \u51221 \u51004 \u47196  \u49457 \u54868 \u46104 \u50632 \u51012  \u44163  \u44057 \u51004 \u47732  \u44536 \u46308 \u51032  \u51116 \u47932 \u51008  \u50424 \u45936 \u50630 \u44256  \u54644 \u47196 \u50868  \u48169 \u51333 \u50640  \u45229 \u48708 \u46104 \u51648  \u50500 \u45768 \u54616 \u44256  \u51452 \u45784 \u51032  \u48372 \u44256 \u47196  \u46028 \u50500 \u44032 \u44172  \u46104 \u50632 \u51012  \u44163 \u51060 \u47728 , \u44536 \u47532 \u49828 \u46020 \u51064 \u46308 \u51008  \u51208 \u51228 \u50752  \u44537 \u44592 \u50752  \u51088 \u50500  \u55148 \u49373 \u51032  \u47784 \u48376 \u51012  \u48372 \u51060 \u44172  \u46104 \u50632 \u51012  \u44163 \u51060 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u46308 \u51008  \u49464 \u49345 \u51032  \u48731 \u51060  \u46104 \u50632 \u51012  \u44163 \u51060 \u45796 .\
