\uc0\u49324 \u46988 \u46308 \u51032  \u44048 \u52628 \u50612 \u51652  \u51060 \u44592 \u51452 \u51032 \u44032  \u54616 \u45720  \u52293 \u46308 \u50640 \u45716  \u45208 \u53440 \u45208 \u44172  \u46108 \u45796 . \u44144 \u44592 \u45716  \u46041 \u47308 \u51064 \u44036 \u50640  \u45824 \u54620  \u51032 \u47924 \u47484  \u45796 \u54616 \u51648  \u50500 \u45768 \u54620  \u44163 , \u44536 \u47532 \u49828 \u46020 \u51032  \u50836 \u44396 \u47484  \u46321 \u54620 \u55176  \u54620  \u44163  \u46321 \u50640  \u45824 \u54620  \u44592 \u47197 \u51060  \u51080 \u45796 . \u44144 \u44592 \u50640 \u49436  \u44536 \u46308 \u51008  \u44536 \u47532 \u49828 \u46020 \u44760  \u49549 \u54620  \u49884 \u44036 \u44284  \u49373 \u44033 \u44284  \u45733 \u47141 \u51012  \u50620 \u47560 \u45208  \u51088 \u51452  \u49324 \u45800 \u50640 \u44172  \u51452 \u50632 \u45716 \u51648 \u50640  \u45824 \u54616 \u50668  \u48372 \u44172  \u46112  \u44163 \u51060 \u45796 . \u52380 \u49324 \u46308 \u51060  \u54616 \u45720 \u47196  \u44032 \u51256 \u44032 \u45716  \u44592 \u47197 \u51008  \u52280 \u51004 \u47196  \u49836 \u54536  \u44592 \u47197 \u51060 \u45796 . \u44536 \u47532 \u49828 \u46020 \u51032  \u51228 \u51088 \u46972 \u44256  \u44277 \u50616 \u54616 \u45716  \u54788 \u47749 \u54620  \u49324 \u46988 \u46308 \u51060  \u49464 \u49549 \u51201  \u51116 \u49328 \u51012  \u50619 \u44256  \u49464 \u49549 \u51201  \u54693 \u46973 \u51012  \u51600 \u44592 \u44592 \u50640  \u47792 \u46160 \u54616 \u44256  \u51080 \u45796 . \u46024 \u44284  \u49884 \u44036 \u44284  \u55192 \u51060  \u47800 \u52264 \u47548 \u44284  \u48169 \u51333 \u50640  \u55148 \u49373 \u46108 \u45796 . \u44592 \u46020 \u50752  \u49457 \u44221  \u50672 \u44396 \u50752  \u49900 \u47161 \u51032  \u44216 \u48708 \u50752  \u51396 \u51032  \u44256 \u48177 \u50640 \u45716  \u44144 \u51032  \u49884 \u44036 \u51012  \u48148 \u52824 \u51648  \u50506 \u45716 \u45796 .\
\uc0\u49324 \u45800 \u51008  \u50864 \u47532 \u44032  \u44032 \u51109  \u51096  \u50508 \u50500 \u50556  \u54624  \u51068 \u46308 \u51012  \u49373 \u44033 \u51648  \u47803 \u54616 \u46020 \u47197  \u54616 \u44592  \u50948 \u54616 \u50668  \u50864 \u47532 \u51032  \u47560 \u51020 \u51012  \u48764 \u50519 \u44256 \u51088  \u47924 \u49688 \u54620  \u44036 \u44228 \u47484  \u44256 \u50504 \u54620 \u45796 . \u44536  \u44592 \u47564 \u51088 \u51032  \u44340 \u49688 \u45716  \u49549 \u51396 \u51032  \u55148 \u49373  \u51228 \u47932 \u44284  \u51204 \u45733 \u54616 \u49888  \u51473 \u48372 \u51088 \u47484  \u48157 \u55176  \u48372 \u50668  \u51452 \u45716  \u50948 \u45824 \u54620  \u51652 \u47532 \u47484  \u49899 \u50612 \u54620 \u45796 . \u44536 \u45716  \u44536 \u50640 \u44172  \u51080 \u50612 \u49436  \u47564 \u49324 \u45716  \u49324 \u46988 \u51032  \u47560 \u51020 \u51012  \u50696 \u49688 \u45784 \u44284  \u44536 \u48516 \u51032  \u51652 \u47532 \u50640 \u49436  \u46496 \u45208 \u44172  \u54616 \u45716  \u51068 \u50640  \u45804 \u47140  \u51080 \u45796 \u45716  \u44163 \u51012  \u50504 \u45796 .\
