\f1\b0 \cf0 \
\uc0\u44536 \u47532 \u49828 \u46020 \u44368 \u44397 \u51032  \u50668 \u47084  \u50948 \u51221 \u51088 \u46308 \u51060  \u49901 \u44228 \u47749 \u51012  \u51648 \u53412 \u45716  \u51088 \u46308 \u50640 \u44172 \u49436  \u51221 \u48512 \u51032  \u48372 \u54840 \u47484  \u51228 \u44144 \u54644  \u48260 \u47532 \u44256  \u44536 \u46308 \u51012  \u47736 \u47581 \u49884 \u53412 \u47140  \u54616 \u45716  \u51088 \u46308 \u51032  \u49552 \u50640  \u45336 \u44200 \u51456 \u45796 \u45716  \u48277 \u47161 \u51012  \u48152 \u54252 \u54616 \u44172  \u46104 \u47732 , \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u46308 \u51008  \u46020 \u49884 \u50752  \u52492 \u46973 \u51012  \u46496 \u45208  \u44032 \u51109  \u54889 \u47049 \u54616 \u44256  \u51064 \u51201 \u51060  \u46300 \u47928  \u44275 \u51004 \u47196  \u54588 \u54616 \u50668  \u54632 \u44760  \u47924 \u47532 \u47484  \u51648 \u50612  \u44144 \u54616 \u44172  \u46112  \u44163 \u51060 \u45796 . \u47566 \u51008  \u49324 \u46988 \u51008  \u49328 \u50501 \u46308 \u47196  \u51060 \u47336 \u50612 \u51652  \u50836 \u49352 \u50640 \u49436  \u54588 \u45212 \u52376 \u47484  \u52286 \u51012  \u44163 \u51060 \u45796 . \u44536 \u46308 \u51008  \u54588 \u50640 \u47805  \u44264 \u51676 \u44592 \u50640  \u49704 \u50612  \u51080 \u45912  \u44536 \u47532 \u49828 \u46020 \u51064 \u46308 \u52376 \u47100  \u46405 \u51032  \u45458 \u51008  \u44275 \u51012  \u49457 \u49548 \u47196  \u49340 \u44256  \'93\u44204 \u44256 \u54620  \u48148 \u50948 \'94 (\u49324  33:16) \u47484  \u51452 \u49888  \u54616 \u45208 \u45784 \u44760  \u44048 \u49324 \u54624  \u44163 \u51060 \u45796 . \u44536 \u47084 \u45208  \u47784 \u46304  \u48124 \u51313 \u44284  \u47784 \u46304  \u44228 \u52789 \u51032  \u49324 \u46988 \u46308 , \u45458 \u51008  \u51088 \u50752  \u45230 \u51008  \u51088 , \u48512 \u54620  \u51088 \u50752  \u44032 \u45212 \u54620  \u51088 , \u48177 \u49353  \u51064 \u51333 \u44284  \u50976 \u49353  \u51064 \u51333 \u51012  \u47561 \u47200 \u54616 \u44256  \u47566 \u51008  \u49324 \u46988 \u46308 \u51060  \u44537 \u55176  \u48512 \u45817 \u54616 \u44256  \u51092 \u51064 \u54620  \u49549 \u48149 \u51012  \u48155 \u51012  \u44163 \u51060 \u45796 . \u54616 \u45208 \u45784 \u51032  \u49324 \u46993 \u51012  \u51077 \u51008  \u48177 \u49457 \u46308 \u51008  \u44340 \u47196 \u50868  \u45216 \u51012  \u48372 \u45236 \u44256 , \u49632 \u49324 \u49836 \u50640  \u47588 \u51060 \u44256  \u44048 \u50725 \u50640  \u44039 \u55176 \u44256 , \u49324 \u54805  \u49440 \u44256 \u47484  \u48155 \u44256 , \u44536  \u51473  \u45908 \u47084 \u45716  \u50612 \u46177 \u44256  \u48520 \u44208 \u54620  \u50725 \u50640  \u44039 \u55176 \u50612  \u44592 \u50500 \u47196  \u44144 \u51032  \u51453 \u51012  \u51648 \u44221 \u51012  \u45817 \u54624  \u44163 \u51060 \u45796 . \u50500 \u47924 \u46020  \u44536 \u46308 \u51032  \u49888 \u51020  \u49548 \u47532 \u47484  \u46308 \u50612 \u51452 \u51648  \u50506 \u44256 , \u50500 \u47924 \u46020  \u44536 \u46308 \u51012  \u46037 \u44256 \u51088  \u51600 \u44144 \u51060  \u49552 \u51012  \u48855 \u45716  \u51088 \u44032  \u50630 \u51012  \u44163 \u51060 \u45796 .\
\uc0\u51060 \u50752  \u44057 \u51008  \u49884 \u47144 \u51032  \u46412 \u51032  \u51452 \u45784 \u44760 \u49436  \u45817 \u49888 \u51032  \u48177 \u49457 \u51012  \u51082 \u50612 \u48260 \u47532 \u49892 \u44620 ? \u44536 \u48516 \u44760 \u49436 \u45716  \u54861 \u49688  \u51204  \u49464 \u49345 \u51012  \u49900 \u54032 \u54616 \u49892  \u46412  \u52649 \u49457 \u46108  \u45432 \u50500 \u47484  \u51082 \u50612 \u48260 \u47532 \u49512 \u45912 \u44032 ? \u44536 \u48516 \u44760 \u49436  \u54616 \u45720 \u50640 \u49436  \u48520 \u51012  \u45236 \u47140  \u54217 \u50896 \u51032  \u46020 \u49884 \u46308 \u51012  \u53468 \u50892  \u48260 \u47532 \u49892  \u46412  \u47215 \u51012  \u51082 \u50612 \u48260 \u47532 \u49512 \u45912 \u44032 ? \u44536 \u48516 \u44760 \u49436 \u45716  \u50528 \u44413 \u50640 \u49436  \u50864 \u49345  \u49709 \u48176 \u51088 \u46308 \u50640 \u44172  \u46168 \u47084 \u49912 \u50668  \u51080 \u45716  \u50836 \u49481 \u51012  \u51082 \u51004 \u49512 \u45912 \u44032 ? \u44536 \u48516 \u44760 \u49436 \u45716  \u51060 \u49464 \u48296 \u51060  \u48148 \u50508  \u49440 \u51648 \u51088 \u46308 \u51032  \u50868 \u47749 \u44284  \u44057 \u51060  \u47564 \u46308 \u44192 \u45796 \u44256  \u50648 \u47532 \u50556 \u47484  \u50948 \u54801 \u54616 \u45716  \u47609 \u49464 \u47484  \u54664 \u51012  \u46412  \u44536 \u47484  \u51082 \u50612 \u48260 \u47532 \u49512 \u45912 \u44032 ? \u44536 \u48516 \u44760 \u49436 \u45716  \u54400 \u47924 \u48520 \u50640  \u45912 \u51256 \u51652  \u54988 \u47469 \u54620  \u49464  \u52397 \u45380 \u51012  \u51082 \u51004 \u49884 \u44144 \u45208  \u49324 \u51088 \u44404 \u50640  \u46308 \u50612 \u44036  \u45796 \u45768 \u50648 \u51012  \u51082 \u51004 \u49512 \u45912 \u44032 ?\
\'93\uc0\u50724 \u51649  \u49884 \u50728 \u51060  \u51060 \u47476 \u44592 \u47484  \u50668 \u54840 \u50752 \u44760 \u49436  \u45208 \u47484  \u48260 \u47532 \u49884 \u47728  \u51452 \u44760 \u49436  \u45208 \u47484  \u51082 \u51004 \u49512 \u45796  \u54616 \u50688 \u44144 \u45768 \u50752  \u50668 \u51064 \u51060  \u50612 \u52236  \u44536  \u51222  \u47673 \u45716  \u51088 \u49885 \u51012  \u51082 \u44192 \u51004 \u47728  \u51088 \u44592  \u53468 \u50640 \u49436  \u45212  \u50500 \u46308 \u51012  \u44557 \u55100 \u55176  \u50668 \u44592 \u51648  \u50506 \u44192 \u45712 \u45264  \u44536 \u46308 \u51008  \u54841 \u49884  \u51082 \u51012 \u51648 \u46972 \u46020  \u45208 \u45716  \u45320 \u47484  \u51082 \u51648  \u50500 \u45768 \u54624  \u44163 \u51060 \u46972  \u45236 \u44032  \u45320 \u47484  \u45236  \u49552 \u48148 \u45797 \u50640  \u49352 \u44220 \u44256  \u45320 \u51032  \u49457 \u48317 \u51060  \u54637 \u49345  \u45236  \u50526 \u50640  \u51080 \'94 (\u49324  49:14~16) \u45712 \u45768 \u46972 . \u47564 \u44400 \u51032  \u50668 \u54840 \u50752 \u44760 \u49436 \u45716  \'93\u47924 \u47495  \u45320 \u55148 \u47484  \u48276 \u54616 \u45716  \u51088 \u45716  \u44536 \u51032  \u45576 \u46041 \u51088 \u47484  \u48276 \u54616 \u45716  \u44163 \u51060 \u46972 \'94 (\u49829  2:8) \u44256  \u47568 \u50432 \u54616 \u49512 \u45796 .\
\uc0\u48708 \u47197  \u50896 \u49688 \u46308 \u51060  \u44536 \u46308 \u51012  \u50725 \u50640  \u44032 \u46164 \u45796  \u54624 \u51648 \u46972 \u46020  \u44048 \u50725 \u51032  \u48317 \u51060  \u44536 \u46308 \u51032  \u50689 \u54844 \u44284  \u44536 \u47532 \u49828 \u46020 \u50752 \u51032  \u44368 \u53685 \u51012  \u52264 \u45800 \u49884 \u53420  \u49688 \u45716  \u50630 \u45796 . \u44536 \u46308 \u51032  \u47784 \u46304  \u50672 \u50557 \u54632 \u51012  \u48372 \u49884 \u44256  \u47784 \u46304  \u49884 \u54744 \u51012  \u51096  \u50500 \u49884 \u45716  \u44536 \u48516 \u44760 \u49436 \u45716  \u49464 \u49549 \u51201 \u51064  \u47784 \u46304  \u44428 \u49464 \u47484  \u52488 \u50900 \u54616 \u49888  \u48516 \u51060 \u49884 \u45796 . \u52380 \u49324 \u46308 \u51008  \u51201 \u47561 \u54620  \u50725 \u50640  \u44039 \u54784  \u51080 \u45716  \u44536 \u46308 \u51012  \u52286 \u50500 \u44032 \u49436  \u54616 \u45720 \u51032  \u48731 \u44284  \u54217 \u54868 \u47484  \u51460  \u44163 \u51060 \u45796 . \u44536  \u44048 \u50725 \u51008  \u47560 \u52824  \u44417 \u44432 \u52376 \u47100  \u46112  \u44163 \u51060 \u45796 . \u50780 \u45264 \u54616 \u47732  \u44144 \u44592 \u50640 \u45716  \u48127 \u51020 \u51060  \u47566 \u51008  \u49324 \u46988 \u46308 \u51060  \u51080 \u51004 \u48064 \u47196  \u47560 \u52824  \u48148 \u50872 \u44284  \u49892 \u46972 \u44032  \u48716 \u47549 \u48372  \u44048 \u50725 \u50640 \u49436  \u48164 \u51473 \u50640  \u44592 \u46020 \u54616 \u44256  \u52268 \u48120 \u54664 \u51012  \u46412 \u52376 \u47100  \u44536  \u51020 \u49328 \u54620  \u45812 \u48316 \u46973 \u51060  \u54616 \u45720 \u48731 \u51004 \u47196  \u48731 \u45216  \u44163 \u51060 \u44592  \u46412 \u47928 \u51060 \u45796 .\
\uc0\u54616 \u45208 \u45784 \u51032  \u54805 \u48268 \u51060  \u45817 \u49888 \u51032  \u48177 \u49457 \u46308 \u51012  \u50517 \u48149 \u54616 \u44256  \u51453 \u51060 \u44256 \u51088  \u54616 \u45716  \u51088 \u46308 \u50640 \u44172  \u45236 \u47540  \u44163 \u51060 \u45796 . \u54616 \u45208 \u45784 \u51032  \u50724 \u47000  \u52280 \u51004 \u49900 \u51008  \u49324 \u46988 \u46308 \u51060  \u48276 \u51396 \u54616 \u45716  \u45936  \u45824 \u45812 \u54644 \u51648 \u44172  \u54620 \u45796 . \u44536 \u47084 \u45208  \u50724 \u47000  \u51648 \u52404 \u46108 \u45796 \u44256  \u54644 \u49436  \u48516 \u47749 \u54616 \u44256  \u46160 \u47140 \u50868  \u44536  \u54805 \u48268 \u51060  \u44208 \u53076  \u44048 \u54644 \u51648 \u45716  \u44163 \u51008  \u50500 \u45768 \u45796 . \'93\u50668 \u54840 \u50752 \u44760 \u49436  \u48652 \u46972 \u49900  \u49328 \u50640 \u49436 \u50752  \u44057 \u51060  \u51068 \u50612 \u45208 \u49884 \u47728  \u44592 \u46300 \u50728  \u44264 \u51676 \u44592 \u50640 \u49436 \u50752  \u44057 \u51060  \u51652 \u45432 \u54616 \u49324  \u51088 \u44592  \u51068 \u51012  \u54665 \u54616 \u49884 \u47532 \u45768  \u44536  \u51068 \u51060  \u48708 \u49345 \u54624  \u44163 \u51060 \u47728  \u51088 \u44592  \u44277 \u51012  \u51060 \u47336 \u49884 \u47532 \u45768  \u44536  \u44277 \u51060  \u44592 \u51060 \u54624  \u44163 \u51076 \u51060 \u46972 \'94 (\u49324  28:21). \u50864 \u47532 \u51032  \u51088 \u48708 \u54616 \u49888  \u54616 \u45208 \u45784 \u44760 \u49436  \u54805 \u48268 \u54616 \u45716  \u51068 \u51012  \u54616 \u49884 \u45716  \u44163 \u51008  \u48708 \u49345 \u54620  \u51068 \u51060 \u45796 . \'93\u51452  \u50668 \u54840 \u50752 \u51032  \u47568 \u50432 \u50640  \u45208 \u51032  \u49334 \u51012  \u46160 \u44256  \u47609 \u49464 \u54616 \u45432 \u45768  \u45208 \u45716  \u50501 \u51064 \u51032  \u51453 \u45716  \u44163 \u51012  \u44592 \u48848 \u54616 \u51648  \u50500 \u45768 \u54616 \u44256  \u50501 \u51064 \u51060  \u44536  \u44600 \u50640 \u49436  \u46028 \u51060 \u53020  \u46496 \u45208 \u49436  \u49324 \u45716  \u44163 \u51012  \u44592 \u48848 \u54616 \u45432 \u46972 \'94 (\u44180  33:11). \u50668 \u54840 \u50752 \u44760 \u49436 \u45716  \'93\u51088 \u48708 \u47213 \u44256  \u51008 \u54812 \u47213 \u44256  \u45432 \u54616 \u44592 \u47484  \u45908 \u46356 \u54616 \u44256  \u51064 \u51088 \u50752  \u51652 \u49892 \u51060  \u47566 \u51008  \u54616 \u45208 \u45784 \u51060 \'94 (\u52636  34:6) \u49884 \u45796 . \u44536 \u47084 \u45208  \u44536 \u48516 \u44760 \u49436 \u45716  \'93\u54805 \u48268  \u48155 \u51012  \u51088 \u45716  \u44208 \u45800 \u53076  \u47732 \u51396 \u54616 \u51648  \u50506 \'94 (\u52636  34:7) \u51004 \u49888 \u45796 . \'93\u50668 \u54840 \u50752 \u45716  \u45432 \u54616 \u44592 \u47484  \u45908 \u46356 \u54616 \u49884 \u47728  \u44428 \u45733 \u51060  \u53356 \u49884 \u47728  \u51396 \u51064 \u51008  \u44208 \u53076  \u49324 \u54616 \u51648  \u50500 \u45768 \u54616 \u49884 \u45712 \u45768 \u46972 \'94 (\u52636  34:6, 7; \u45208  1:3). \u51032  \u44032 \u50868 \u45936 \u49436  \u54665 \u54616 \u49884 \u45716  \u47924 \u49436 \u50868  \u51068 \u51012  \u53685 \u54616 \u50668  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u51667 \u48159 \u55180  \u50984 \u48277 \u51032  \u44428 \u50948 \u47484  \u50745 \u54840 \u54616 \u49892  \u44163 \u51060 \u45796 . \u50984 \u48277 \u51012  \u48276 \u54620  \u51088 \u46308 \u50640 \u44172  \u45236 \u47540  \u49900 \u54620  \u54805 \u48268 \u51032  \u51221 \u46020 \u45716  \u51452 \u45784 \u44760 \u49436  \u44277 \u51032 \u47484  \u51665 \u54665 \u54616 \u49884 \u44592 \u44620 \u51648  \u50724 \u47000  \u52280 \u51004 \u49888  \u44163 \u51004 \u47196  \u50508  \u49688  \u51080 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436  \u50724 \u47000  \u52280 \u51004 \u49884 \u44256  \u44536 \u48516 \u44760 \u49436  \u54756 \u50500 \u47140  \u48372 \u49884 \u45716  \u51396 \u51032  \u48516 \u47049 \u51060  \u52264 \u44592 \u44620 \u