\u51012  \u46412  \u50668 \u44592 \u49436  \u49332 \u50520 \u45796 . \u49373 \u47749 \u51032  \u49884 \u50668 \u51088 \u44760 \u49436  \u49440 \u54620  \u49912 \u50880 \u51012  \u49912 \u50868  \u49324 \u46988 \u46308 \u51012  \u44648 \u50864 \u49892  \u46412 \u50640 , \u44536 \u47532 \u49828 \u46020 \u47484  \u50948 \u54616 \u50668  \u51453 \u51076 \u51012  \u45817 \u54620  \u47566 \u51008  \u49692 \u44368 \u51088 \u46308 \u51060  \u51060  \u51020 \u49328 \u54620  \u44404 \u49549 \u50640 \u49436  \u45208 \u50732  \u44163 \u51060 \u45796 .\
\uc0\u51060 \u47084 \u54620  \u44536 \u47532 \u49828 \u46020 \u51032  \u51613 \u51064 \u46308 \u51008  \u44537 \u49900 \u54620  \u48149 \u54644 \u47484  \u48155 \u51004 \u47732 \u49436 \u46020  \u44536 \u46308 \u51032  \u49888 \u50521 \u51012  \u44648 \u45143 \u51060  \u48372 \u51204 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u50728 \u44054  \u54200 \u47532 \u54620  \u44163 \u46308 \u51012  \u45796  \u48764 \u50519 \u44592 \u44256  \u54663 \u48731 \u51312 \u52264  \u48380  \u49688  \u50630 \u45716  \u50612 \u46160 \u50868  \u46405  \u49549 \u50640 \u49436 , \u44536 \u47084 \u45208  \u48512 \u46300 \u47084 \u50868  \u46405 \u51032  \u54408 \u49549 \u50640 \u49436  \u51648 \u45236 \u45716  \u46041 \u50504 , \u54620 \u47560 \u46356 \u51032  \u48520 \u54217 \u46020  \u51077  \u48150 \u50640  \u45236 \u51648  \u50506 \u50520 \u45796 . \u44536 \u46308 \u51008  \u48127 \u51020 \u44284  \u51064 \u45236 \u50752  \u55148 \u47581 \u51060  \u44032 \u46301 \u54620  \u47568 \u47196  \u49436 \u47196  \u44201 \u47140 \u54616 \u47728  \u44417 \u54605 \u44284  \u44340 \u47196 \u50880 \u51012  \u44204 \u46356 \u50632 \u45796 . \u50728 \u44054  \u49464 \u49345 \u51201 \u51064  \u52629 \u48373 \u46308 \u51012  \u51075 \u50612 \u48260 \u47532 \u45716  \u44163 \u46020  \u44536 \u46308 \u47196  \u54616 \u50668 \u44552  \u44536 \u47532 \u49828 \u46020 \u47484  \u48127 \u45716  \u49888 \u50521 \u51012  \u48260 \u47532 \u46020 \u47197  \u47564 \u46308  \u49688  \u50630 \u50632 \u45796 . \u49884 \u47144 \u44284  \u48149 \u54644 \u45716  \u44536 \u46308 \u51060  \u48155 \u51012  \u50504 \u49885 \u44284  \u49345 \u44553 \u51012  \u54693 \u54616 \u50668  \u45908 \u50865  \u44032 \u44620 \u51060  \u45208 \u50500 \u44032 \u44172  \u54616 \u45716  \u48156 \u44152 \u51020 \u50640  \u51648 \u45208 \u51648  \u50506 \u50520 \u45796 .\
\uc0\u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u50715 \u51201 \u51032  \u54616 \u45208 \u45784 \u51032  \u51333 \u46308 \u52376 \u47100  \'93\u45908  \u51339 \u51008  \u48512 \u54876 \u51012  \u50619 \u44256 \u51088  \u54616 \u50668  \u50501 \u54805 \u51012  \u48155 \u46104  \u44396 \u52264 \u55176  \u47732 \u54616 \u51648  \u50500 \u45768 \u54616 \u50688 \'94 (\u55176  11:35) \u45796 . \u44536 \u46308 \u51008  \u44536 \u47532 \u49828 \u46020 \u47484  \u51064 \u54616 \u50668  \u54605 \u48149 \u51012  \u48155 \u51012  \u46412 \u50640 \u45716  \'93\u44592 \u48848 \u54616 \u44256  \u51600 \u44144 \u50892 \u54616 \u46972  \u54616 \u45720 \u50640 \u49436  \u45320 \u55148 \u51032  \u49345 \u51060  \u53372 \u51060 \u46972  \u45320 \u55148  \u51204 \u50640  \u51080 \u45912  \u49440 \u51648 \u51088 \u46308 \u51012  \u51060 \u44057 \u51060  \u54605 \u48149 \u54616 \u50688 \u45712 \u45768 \u46972 \'94\u45716  \u51452 \u45784 \u51032  \u47568 \u50432 \u51012  \u49345 \u44592 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u51652 \u47532 \u47484  \u50948 \u54616 \u50668  \u44256 \u45212  \u48155 \u44592 \u50640  \u54633 \u45817 \u55176  \u50668 \u44608 \u51012  \u51077 \u50632 \u45796 \u45716  \u49324 \u49892 \u47196  \u51600 \u44144 \u50892 \u54616 \u50688 \u51004 \u47728  \u46385 \u46385  \u49548 \u47532 \u47484  \u45236 \u47728  \u53440 \u50724 \u47476 \u45716  \u48520 \u44867  \u49549 \u50640 \u49436  \u49849 \u47532 \u51032  \u45432 \u47000 \u47484  \u48520 \u47104 \u45796 . \u44536 \u46308 \u51008  \u48127 \u51020 \u51004 \u47196  \u50948 \u47484  \u52432 \u45796 \u48372 \u44256 , \u54616 \u45720 \u50640  \u44228 \u49888  \u44536 \u47532 \u49828 \u46020 \u50752  \u52380 \u49324 \u46308 \u51060  \u44618 \u51008  \u44288 \u49900 \u51012  \u44032 \u51648 \u44256  \u44536 \u46308 \u51012  \u51452 \u47785 \u54616 \u49884 \u44256 , \u44536 \u46308 \u51032  \u55124 \u46308 \u47532 \u51648  \u50506 \u45716  \u53468 \u46020 \u47484  \u44592 \u44732 \u51060  \u48155 \u51