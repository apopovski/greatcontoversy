\uc0\u51228 \u51088 \u46308 \u51008  \u50696 \u47336 \u49332 \u47128 \u51032  \u47736 \u47581 \u51012  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u51204  \u49464 \u44228 \u51201 \u51064  \u51228 \u44397 \u51032  \u48372 \u51340 \u47484  \u48764 \u50519 \u51004 \u49884 \u44256 , \u50756 \u44256 \u54620  \u50976 \u45824 \u51064 \u46308 \u51012  \u48268 \u54616 \u49884 \u44256 , \u50976 \u45824  \u44397 \u44032 \u47196 \u48512 \u53552  \u47196 \u47560 \u51032  \u47693 \u50640 \u47484  \u44734 \u50612  \u48260 \u47532 \u49884 \u44256 \u51088  \u49464 \u49549 \u51201  \u50689 \u44305 \u51004 \u47196  \u50724 \u49892  \u49324 \u44148 \u44284  \u44288 \u47144 \u49884 \u53040 \u45796 . \u51452 \u45784 \u44760 \u49436 \u45716  \u51068 \u52237 \u51060  \u45817 \u49888 \u44760 \u49436  \u46160  \u48264 \u51704 \u47196  \u50724 \u49884 \u47532 \u46972 \u44256  \u44536 \u46308 \u50640 \u44172  \u47568 \u50432 \u54616 \u49512 \u50632 \u45796 . \u44536 \u47084 \u48064 \u47196  \u44536 \u46308 \u51008  \u50696 \u47336 \u49332 \u47128 \u51032  \u49900 \u54032 \u50640  \u44288 \u54620  \u47568 \u50432 \u51012  \u46308 \u51012  \u46412 , \u50696 \u49688 \u44760 \u49436  \u47568 \u50432 \u54616 \u49888  \u44536  \u51116 \u47548 \u51012  \u54924 \u49345 \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u46308 \u51008  \u44048 \u46988 \u49328  \u50948 \u50640 \u49436  \u50696 \u49688 \u45784  \u51452 \u50948 \u50640  \u46168 \u47084 \u50505 \u50500  \'93\u50612 \u45712  \u46412 \u50640  \u51060 \u47088  \u51068 \u51060  \u51080 \u44192 \u49324 \u50724 \u47728  \u46608  \u51452 \u51032  \u51076 \u54616 \u49900 \u44284  \u49464 \u49345  \u45149 \u50640 \u45716  \u47924 \u49832  \u51669 \u51312 \u44032  \u51080 \u49324 \u50724 \u47532 \u51060 \u44620 \'94 (\u47560  24:3) \u46972 \u44256  \u47932 \u50632 \u45796 .\
\uc0\u51088 \u48708 \u47213 \u44172 \u46020  \u44536  \u51228 \u51088 \u46308 \u50640 \u44172  \u48120 \u47000 \u44032  \u44032 \u47532 \u50892 \u51276 \u45796 . \u44536  \u46412 \u50640  \u44536 \u46308 \u51060  \u44396 \u49549 \u51452 \u44760 \u49436  \u44256 \u45212 \u51012  \u48155 \u51004 \u49884 \u44256  \u46028 \u50500 \u44032 \u49892  \u44163 \u44284  \u44536  \u46020 \u49884 \u50752  \u49457 \u51204 \u51060  \u47736 \u47581 \u45817 \u54616 \u44172  \u46112  \u46160  \u44032 \u51648 \u51032  \u47924 \u49436 \u50868  \u49324 \u49892 \u51012  \u50756 \u51204 \u55176  \u44648 \u45804 \u50520 \u50632 \u45908 \u46972 \u47732 , \u44536 \u46308 \u51008  \u46160 \u47140 \u50880 \u50640  \u45580 \u47140  \u50517 \u46020 \u45817 \u54616 \u44256  \u47568 \u50520 \u51012  \u44163 \u51060 \u45796 . \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u44536 \u46308 \u50640 \u44172  \u49464 \u49345 \u51032  \u51333 \u47568 \u51060  \u51080 \u44592  \u51204 \u50640  \u51068 \u50612 \u45216  \u53360  \u49324 \u44148 \u46308 \u51032  \u50980 \u44285 \u47564 \u51012  \u48372 \u50668  \u51452 \u49512 \u45796 . \u44536 \u48516 \u51032  \u47568 \u50432 \u51060  \u45817 \u49884 \u50640 \u45716  \u50756 \u51204 \u55176  \u51060 \u54644 \u46104 \u51648  \u47803 \u54616 \u50688 \u51004 \u45208  \u45817 \u49888 \u51032  \u48177 \u49457 \u46308 \u51060  \u44536  \u46412  \u51452 \u50612 \u51652  \u44368 \u54984 \u51012  \u54596 \u50836 \u47196  \u54616 \u44172  \u46112  \u46412 \u50640  \u48157 \u54784 \u51648 \u44172  \u46112  \u44163 \u51060 \u50632 \u45796 . \u44536 \u48516 \u44760 \u49436  \u47568 \u50432 \u54616 \u49888  \u50696 \u50616 \u50640 \u45716  \u46160  \u44032 \u51648  \u51032 \u48120 \u44032  \u51080 \u50632 \u45796 . \u44536 \u44163 \u51008  \u50696 \u47336 \u49332 \u47128 \u51032  \u47736 \u47581 \u51032  \u51204 \u51312  (\u21069 \u20806 ) \u47484  \u48372 \u50668  \u51452 \u45716  \u46041 \u49884 \u50640  \u47560 \u51648 \u47561  \u53360  \u45216 \u51032  \u46160 \u47140 \u50868  \u49324 \u44148 \u51012  \u48120 \u47532  \u50508 \u47140  \u51452 \u45716  \u44163 \u51060 \u50632 \u45796 .\
\uc0\u50696 \u49688 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u47568 \u50432 \u51012  \u46307 \u44256  \u51080 \u45716  \u51228 \u51088 \u46308 \u50640 \u44172  \u48176 \u50669 \u54620  \u51060 \u49828 \u46972 \u50648 \u50640 \u44172  \u45236 \u47540  \u49900 \u54032 , \u53945 \u55176  \u47700 \u49884 \u50556 \u47484  \u44144 \u51208 \u54616 \u44256  \u49901 \u51088 \u44032 \u50640  \u47803  \u48149 \u51008  \u51068 \u47196  \u51064 \u54616 \u50668  \u44536 \u46308 \u50640 \u44172  \u45236 \u47540  \u48372 \u51025 \u51032  \u51669 \u48268 \u51012  \u49440 \u54252 \u54616 \u49512 \u45796 . \u46160 \u47140 \u50868  \u49324 \u44148 \u51060  \u51208 \u51221 \u50640  \u51060 \u47476 \u44592  \u51204 \u50640  \u47676 \u51200  \u48516 \u47749 \u54620  \u51669 \u51312 \u44032  \u51080 \u51012  \u44163 \u51060 \u45796 . \u44536  \u47924 \u49436 \u50892 \u54616 \u45912  \u49884 \u44036 \u51008  \u44049 \u51088 \u44592  \u46608 \u54620  \u49888 \u49549 \u55176  \u51060 \u47484  \u44163 \u51060 \u45796 . \u44396 \u51452 \u44760 \u49436 \u45716  \u45817 \u49888 \u51012  \u46384 \u47476 \u45716  \u49324 \u46988 \u46308 \u50640 \u44172  \'93\u44536 \u47084 \u48064 \u47196  \u45320 \u55148 \u44032  \u49440 \u51648 \u51088  \u45796 \u45768 \u50648 \u51032  \u47568 \u54620 \u48148  \u47736 \u47581 \u51032  \u44032 \u51613 \u54620  \u44163 \u51060  \u44144 \u47337 \u54620  \u44275 \u50640  \u49440  \u44163 \u51012  \u48372 \u44144 \u46304  (\u51069 \u45716  \u51088 \u45716  \u44648 \u45804 \u51012 \u51652 \u51200 ) \u44536  \u46412 \u50640  \u50976 \u45824 \u50640  \u51080 \u45716  \u51088 \u46308 \u51008  \u49328 \u51004 \u47196  \u46020 \u47581 \u54624 \u51648 \u50612 \u45796 \'94\u46972 \u44256  \u44221 \u44256 \u54616 \u49512 \u45796 . \u44263  \u50864 \u49345  \u49709 \u48176 \u54616 \u45716  \u47196 \u47560 \u51032  \u44400 \u44592  (\u36557 \u26071 ) \u44032  \u50696 \u47336 \u49332 \u47128  \u49457 \u48317  \u48150  \u49688  \u47560 \u51068 \u44620 \u51648  \u48120 \u52824 \u45716  \u44144 \u47337 \u54620  \u46405  (\u32854 \u22320 ) \u50640  \u49464 \u50892 \u51656  \u46412 \u50640  \u44536 \u47532 \u49828 \u46020 \u47484  \u46384 \u47476 \u45716  \u49324 \u46988 \u46308 \u51008  \u46020 \u47581 \u54616 \u50668  \u50504 \u51204 \u51012  \u50619 \u50612 \u50556  \u54624  \u44163 \u51060 \u50632 \u45796 . \u44221 \u44256 \u54616 \u45716  \u51669 \u51312 \u44032  \u48372 \u51068  \u46412 \u50640  \u46020 \u47581 \u54616 \u44592 \u47484  \u50896 \u54616 \u45716  \u49324 \u46988 \u46308 \u51008  \u51648 \u52404  \u50630 \u51060  \u49436 \u46168 \u47084 \u50556  \u54624  \u44163 \u51060 \u50632 \u45796 . \u50696 \u47336 \u49332 \u47128 \u51008  \u47932 \u47200 \u51060 \u50836 , \u50728  \u50976 \u45824  \u46405 \u50640 \u49436 \u46020  \u46020 \u47581 \u54616 \u46972 \u45716  \u49888 \u54840 \u50640  \u51593 \u49884  \u49692 \u51333 \u54644 \u50556  \u54624  \u44163 \u51060 \u50632 \u45796 . \u44536  \u46412  \u51648 \u48533  \u50948 \u50640  \u51080 \u45912  \u49324 \u46988 \u51008 , \u50500 \u47924 \u47532  \u44050 \u51652  \u48372 \u47932 \u51060 \u46972  \u54616 \u45908 \u46972 \u46020  \u44536 \u44163 \u51012  \u44148 \u51648 \u44592  \u50948 \u54644  \u45236 \u47140 \u44032 \u49436  \u51665  \u50504 \u51004 \u47196  \u46308 \u50612 \u44032 \u51648  \u47568  \u44163 \u51060 \u50632 \u45796 . \u48173 \u44284  \u54252 \u46020 \u50896 \u50640 \u49436  \u51068 \u54616 \u45912  \u49324 \u46988 \u46308 \u51008  \u45908 \u50868  \u45216 \u50640  \u51068 \u54616 \u44592  \u50948 \u54616 \u50668  \u48279 \u50612 \u46164  \u44169 \u50743 \u51012  \u44032 \u51648 \u47084  \u46104 \u46028 \u50500 \u44048 \u51004 \u47196  \u49884 \u44036 \u51012  \u50024 \u49436 \u45716  \u50504  \u46112  \u44163 \u51060 \u50632 \u45796 . \u44536 \u46308 \u51008  \u45796 \u47480  \u49324 \u46988 \u46308 \u44284  \u54632 \u44760  \u47736 \u47581 \u51012  \u45817 \u54616 \u51648  \u50506 \u44592  \u50948 \u54616 \u50668  \u54620  \u49692 \u44036 \u46020  \u51648 \u52404 \u54616 \u51648  \u47568 \u50500 \u50556  \u54624  \u44163 \u51060 \u50632 \u45796 .\
\uc0\u54756 \u47215 \u51060  \u45796 \u49828 \u47532 \u45912  \u45817 \u49884 \u51032  \u50696 \u47336 \u49332 \u47128 \u51008  \u47588 \u50864  \u50500 \u47492 \u45813 \u44172  \u45800 \u51109 \u46104 \u50632 \u51012  \u49104 \u47564  \u50500 \u45768 \u46972  \u53457 \u44284  \u49457 \u48317 \u44284  \u48372 \u47336  (\u22561 \u22744 ) \u46308 \u51012  \u49464 \u50912 \u44256 , \u45908 \u50865 \u51060  \u51648 \u49464 \u44620 \u51648 \u46020  \u51339 \u50520 \u51004 \u48064 \u47196  \u44536  \u49457 \u51060 \u50556 \u47568 \u47196  \u54632 \u46973 \u49884 \u53420  \u49688  \u50630 \u45716  \u49457 \u44284  \u44057 \u50520 \u45796 . \u44536 \u47084 \u48064 \u47196  \u44536  \u45817 \u49884 \u50640  \u50696 \u47336 \u49332 \u47128 \u51032  \u47736 \u47581 \u51012  \u44277 \u44277 \u50672 \u54616 \u44172  \u50696 \u50616 \u54616 \u45716  \u44163 \u51008  \u47560 \u52824  \u45432 \u50500 \u44032  \u45817 \u49884 \u51032  \u49324 \u46988 \u46308 \u50640 \u44172  \u52712 \u44553 \u46104 \u50632 \u45912  \u44163 \u52376 \u47100  \u51221 \u49888  \u48736 \u51652  \u44221 \u44256 \u51088 \u47196  \u48520 \u47540  \u49688 \u48150 \u50640  \u50630 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \'93\u52380 \u51648 \u45716  \u50630 \u50612 \u51648 \u44192 \u51004 \u45208  \u45236  \u47568 \u51008  \u50630 \u50612 \u51648 \u51648  \u50500 \u45768 \u54616 \u47532 \u46972 \'94 (\u47560  24:35) \u44256  \u47568 \u50432 \u54616 \u49512 \u45796 . \u50696 \u47336 \u49332 \u47128 \u51008  \u44536  \u51396 \u47196  \u51064 \u54616 \u50668  \u51060 \u48120  \u51652 \u45432 \u51032  \u49440 \u44256 \u47484  \u48155 \u50520 \u51004 \u47728 , \u44536  \u50756 \u44256 \u54620  \u48520 \u49888 \u51004 \u47196  \u47736 \u47581 \u51032  \u50868 \u47749 \u51012  \u54869 \u51221 \u51648 \u50632 \u45796 .\
