\uc0\u50501 \u54620  \u51088 \u46308 \u51008  \u47588 \u50864  \u53685 \u48516 \u54644  \u54620 \u45796 . \u44536 \u44163 \u51008  \u44536 \u46308 \u51060  \u54616 \u45208 \u45784 \u44284  \u44536 \u46308 \u51032  \u46041 \u47308  \u51064 \u44036 \u46308 \u50640  \u45824 \u54620  \u51032 \u47924 \u47484  \u46321 \u54620 \u55176  \u54616 \u44256  \u51396 \u47484  \u48276 \u54616 \u50688 \u44592  \u46412 \u47928 \u50640 \u49436 \u44032  \u50500 \u45768 \u44256  \u54616 \u45208 \u45784 \u51060  \u49849 \u47532 \u54616 \u49512 \u44592  \u46412 \u47928 \u51060 \u45796 . \u44536 \u46308 \u51008  \u54788 \u49892 \u51201 \u51064  \u44208 \u44284 \u47484  \u54620 \u53444 \u54616 \u45716  \u44163 \u51060 \u47728  \u44536 \u46308 \u51032  \u51396 \u50501 \u51012  \u54924 \u44060 \u54616 \u45716  \u44163 \u51008  \u50500 \u45768 \u45796 . \u47564 \u51068  \u44536 \u46308 \u51060  \u51060 \u44600  \u49688  \u51080 \u51012  \u44163  \u44057 \u51004 \u47732  \u44536 \u46308 \u51008  \u44536  \u51068 \u51012  \u50948 \u54616 \u50668  \u49688 \u45800 \u51012  \u44032 \u47532 \u51648  \u50506 \u51012  \u44163 \u51060 \u45796 .\
\uc0\u44536 \u46308 \u51060  \u51312 \u47217 \u54616 \u44256  \u47784 \u50837 \u54616 \u44256  \u47736 \u47581 \u49884 \u53412 \u44256 \u51088  \u55148 \u47581 \u54664 \u45912  \u51088 \u46308 \u51060  \u51656 \u48337 \u44284  \u54253 \u54413 \u44284  \u51648 \u51652 \u50640 \u46020  \u50500 \u47924 \u47088  \u54644 \u47484  \u48155 \u51648  \u50506 \u50520 \u45796 \u45716  \u49324 \u49892 \u51012  \u49464 \u49345 \u51008  \u48372 \u44172  \u46108 \u45796 . \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51012  \u48276 \u54620  \u51088 \u46308 \u50640 \u44172  \u49324 \u47476 \u45716  \u48520 \u51060  \u46104 \u49884 \u45716  \u48516 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u48177 \u49457 \u46308 \u50640 \u44172  \u50504 \u51204 \u54620  \u54588 \u45212 \u52376 \u44032  \u46104 \u49888 \u45796 .\
\uc0\u49324 \u46988 \u46308 \u51032  \u51064 \u44592 \u47484  \u50619 \u44592  \u50948 \u54616 \u50668  \u51652 \u47532 \u47484  \u51200 \u48260 \u47536  \u47785 \u49324 \u45716  \u44536 \u51032  \u44368 \u54984 \u51032  \u49457 \u44201 \u44284  \u50689 \u54693 \u51012  \u51060 \u51228  \u48516 \u48324 \u54616 \u44172  \u46108 \u45796 . \u44536 \u44032  \u44053 \u45800 \u50640  \u49456 \u51012  \u46412 , \u44144 \u47532 \u47196  \u44152 \u50612 \u44040  \u46412 , \u50668 \u47084  \u44032 \u51648  \u49373 \u50528 \u51032  \u51109 \u47732 \u50640 \u49436  \u49324 \u46988 \u46308 \u44284  \u44368 \u51228 \u54624  \u46412 , \u51204 \u51648  (\u20840 \u30693 ) \u54616 \u49888  \u48516 \u51032  \u45576 \u51060  \u50616 \u51228 \u45208  \u44536 \u47484  \u46496 \u45208 \u51648  \u50500 \u45768 \u54620  \u44163 \u51060  \u48516 \u47749 \u54616 \u45796 . \u49900 \u47161 \u51032  \u47784 \u46304  \u49345 \u53468 , \u44592 \u47197 \u46108  \u47784 \u46304  \u47928 \u51088 , \u54364 \u54788 \u54620  \u47784 \u46304  \u47568 , \u49324 \u46988 \u46308 \u51012  \u44144 \u51667 \u46108  \u54588 \u45212 \u52376 \u50640  \u49772 \u44172  \u54620  \u47784 \u46304  \u54665 \u46041  \u46321 \u51008  \u51060 \u48120  \u50472 \u47484  \u49100 \u47160 \u45796 . \u51060 \u51228  \u44536 \u51032  \u51452 \u50948 \u50640  \u51080 \u45716  \u48520 \u54665 \u54616 \u44256  \u51075 \u50612 \u48260 \u47536  \u48148  \u46108  \u50689 \u54844 \u51012  \u53685 \u54616 \u50668  \u44536 \u45716  \u49688 \u54869 \u51012  \u48148 \u46972 \u48376 \u45796 .\
\uc0\u50668 \u54840 \u50752 \u44760 \u49436  \u47568 \u50432 \u54616 \u49512 \u45796 . \'93\u44536 \u46308 \u51060  \u46392  \u45236  \u48177 \u49457 \u51032  \u49345 \u52376 \u47484  \u49900 \u49345 \u55176  \u44256 \u52432  \u51452 \u47728  \u47568 \u54616 \u44592 \u47484  \u54217 \u44053 \u54616 \u45796  \u54217 \u44053 \u54616 \u45796  \u54616 \u45208  \u54217 \u44053 \u51060  \u50630 \u46020 \u45796 \'94 (\u47128  8:11). \'93\u45236 \u44032  \u49836 \u54532 \u44172  \u54616 \u51648  \u50500 \u45768 \u54620  \u51032 \u51064 \u51032  \u47560 \u51020 \u51012  \u45320 \u55148 \u44032  \u44144 \u51667 \u47568 \u47196  \u44540 \u49900 \u54616 \u44172  \u54616 \u47728  \u45320 \u55148 \u44032  \u46608  \u50501 \u51064 \u51032  \u49552 \u51012  \u44403 \u44172  \u54616 \u50668  \u44536  \u50501 \u54620  \u44600 \u50640 \u49436  \u46028 \u51060 \u53020  \u46496 \u45208  \u49334 \u51012  \u50619 \u51648  \u47803 \u54616 \u44172  \u54616 \u50688 \'94 (\u44180  13:22) \u46020 \u45796 .\
\'93\uc0\u45236  \u47785 \u51109 \u51032  \u50577  \u47924 \u47532 \u47484  \u47736 \u54616 \u47728  \u55145 \u45716  \u47785 \u51088 \u50640 \u44172  \u54868  \u51080 \u51004 \u47532 \u46972  \'85\u48372 \u46972  \u45236 \u44032  \u45320 \u55148 \u51032  \u50501 \u54665 \u51012  \u51064 \u54616 \u50668  \u45320 \u55148 \u50640 \u44172  \u48372 \u51025 \u54616 \u47532 \u46972 \'94, \'93\u45320 \u55148  \u47785 \u51088 \u46308 \u50500  \u50808 \u52432  \u50528 \u44257 \u54616 \u46972  \u45320 \u55148  \u50577 \u46524 \u51032  \u51064 \u46020 \u51088 \u46308 \u50500  \u51116 \u50640  \u44404 \u46972  \u51060 \u45716  \u45320 \u55148  \u46020 \u47449 \u51012  \u45817 \u54624  \u45216 \u44284  \u55145 \u51020 \u51012  \u45817 \u54624  \u44592 \u54620 \u51060  \u52284 \u51020 \u51064 \u51593 \'85\u47785 \u51088 \u46308 \u51008  \u46020 \u47581 \u54624  \u49688  \u50630 \u44192 \u44256  \u50577 \u46524 \u51032  \u51064 \u46020 \u51088 \u46308 \u51008  \u46020 \u54588 \u54624  \u49688  \u50630 \u51004 \u47532 \u47196 \u45796 \'94 (\u47128  23:1, 2, 25:34, 35).\
\uc0\u47785 \u49324 \u46308 \u44284  \u49324 \u46988 \u46308 \u51008  \u44536 \u46308 \u51060  \u54616 \u45208 \u45784 \u44284 \u51032  \u44288 \u44228 \u47484  \u50732 \u48148 \u47476 \u44172  \u50976 \u51648 \u54616 \u51648  \u47803 \u54620  \u44163 \u51012  \u44648 \u45803 \u45716 \u45796 . \u44536 \u46308 \u51008  \u44277 \u54217 \u54616 \u44256  \u51032 \u47196 \u50868  \u50984 \u48277 \u51032  \u51228 \u51221 \u51088 \u51060 \u49888  \u54616 \u45208 \u45784 \u51012  \u45824 \u51201 \u54616 \u50668  \u48152 \u50669 \u54644  \u50728  \u44163 \u51012  \u51064 \u51221 \u54620 \u45796 . \u54616 \u45208 \u45784 \u51032  \u54984 \u44228 \u47484  \u48260 \u47160 \u44592  \u46412 \u47928 \u50640  \u49688 \u47566 \u51008  \u51396 \u50501 \u44284  \u48520 \u54868 \u50752  \u51613 \u50724 \u50752  \u48520 \u48277 \u51032  \u49368 \u51060  \u50676 \u47140  \u47560 \u52840 \u45236  \u51060  \u49464 \u49345 \u51008  \u45331 \u51008  \u51204 \u51137 \u53552 \u50752  \u48512 \u54056 \u51032  \u49884 \u44417 \u52285 \u51060  \u46104 \u50612  \u48260 \u47160 \u45796 . \u51652 \u47532 \u47484  \u44144 \u51208 \u54616 \u44256  \u50724 \u47448 \u47484  \u44256 \u49688 \u54616 \u44592 \u47196  \u51089 \u51221 \u54620  \u51088 \u46308 \u50640 \u44172  \u51060  \u49324 \u49892 \u51008  \u48516 \u47749 \u54616 \u44172  \u45208 \u53440 \u45212 \u45796 . \u48520 \u49692 \u51333 \u54616 \u44256  \u48520 \u52649 \u54620  \u51088 \u46308 \u51060  \u50689 \u50896 \u55176  \u51075 \u50612 \u48260 \u47536  \u50689 \u49373 \u51012  \u52286 \u44256 \u51088  \u54616 \u45716  \u44040 \u47581 \u51008  \u46020 \u51200 \u55176  \u47568 \u47196  \u54364 \u54788 \u54624  \u49688  \u50630 \u45796 . \u49464 \u49345 \u50640 \u49436  \u51116 \u45733 \u44284  \u45733 \u48320  \u46412 \u47928 \u50640  \u49709 \u48176 \u47484  \u48155 \u45912  \u49324 \u46988 \u46308 \u46020  \u51060 \u51228 \u45716  \u44536 \u44163 \u46308 \u51032  \u51652 \u49345 \u51012  \u44648 \u45803 \u45716 \u45796 . \u44536 \u46308 \u51008  \u48276 \u51396 \u47196  \u51064 \u54616 \u50668  \u47784 \u46304  \u44163 \u51012  \u49345 \u49892 \u54620  \u44163 \u51012  \u44648 \u45803 \u45716 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u46308 \u51008  \u51648 \u44552 \u44620 \u51648  \u47784 \u47736 \u54644  \u50728  \u52649 \u49457 \u46108  \u49457 \u46020 \u46308 \u51032  \u48156  \u50500 \u47000  \u44999 \u50612  \u50638 \u46300 \u47140  \u54616 \u45208 \u45784 \u44760 \u49436  \u49457 \u46020 \u46308 \u51012  \u49324 \u46993 \u54616 \u49512 \u45796 \u45716  \u49324 \u49892 \u51012  \u44256 \u48177 \u54620 \u45796 .\
