\f1\b0 \cf0 \
\uc0\u44536 \u46308 \u51008  \u50689 \u44397  \u44397 \u44368 \u54924 \u51032  \u44368 \u51064 \u51004 \u47196 \u49436  \u44536  \u44368 \u54924 \u51032  \u50696 \u48176  \u54805 \u49885 \u50640  \u47588 \u50864  \u44053 \u54620  \u50528 \u52265 \u51012  \u44032 \u51648 \u44256  \u51080 \u50632 \u51648 \u47564  \u51452 \u45784 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u47568 \u50432 \u51012  \u53685 \u54616 \u50668  \u45908 \u50865  \u45458 \u51008  \u54364 \u51456 \u51012  \u44536 \u46308 \u50640 \u44172  \u51228 \u49884 \u54616 \u49512 \u45796 . \u49457 \u47161 \u44760 \u49436 \u45716  \u44536 \u47532 \u49828 \u46020 \u50752  \u44536 \u48516 \u51032  \u49901 \u51088 \u44032 \u47484  \u51204 \u54616 \u46972 \u44256  \u44536 \u46308 \u51012  \u44053 \u44428 \u54616 \u49512 \u45796 . \u51648 \u44537 \u55176  \u45458 \u51004 \u49888  \u48516 \u51032  \u44428 \u45733 \u51060  \u44536 \u46308 \u51032  \u54876 \u46041 \u50640  \u54632 \u44760  \u54616 \u50688 \u45796 . \u49688 \u52380  \u47749 \u51032  \u49324 \u46988 \u46308 \u51060  \u51396 \u47484  \u44648 \u45803 \u44256 , \u51652 \u49900 \u51004 \u47196  \u54924 \u44060 \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536  \u50577 \u46308 \u51012  \u50557 \u53448 \u54616 \u47140 \u45716  \u51060 \u47532 \u46308 \u47196 \u48512 \u53552  \u44536 \u46308 \u51012  \u48372 \u54840 \u54616 \u45716  \u51068 \u51060  \u54596 \u50836 \u54616 \u44172  \u46104 \u50632 \u45796 . \u50920 \u49836 \u47532 \u45716  \u49352 \u47196 \u50868  \u44368 \u54028 \u47484  \u47564 \u46308  \u49373 \u44033 \u51060  \u51204 \u54784  \u50630 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u44048 \u47532 \u44368  (Methodist Connection) \u46972 \u45716  \u47749 \u52845 \u51004 \u47196  \u54620  \u51312 \u51649 \u51012  \u44032 \u51648 \u44172  \u46104 \u50632 \u45796 .\
\uc0\u44536  \u51204 \u46020 \u51088 \u46308 \u51008  \u44397 \u44368 \u47196 \u48512 \u53552  \u51060 \u54644 \u54616 \u44592  \u50612 \u47140 \u50872  \u47564 \u53372  \u49900 \u54620  \u48152 \u45824 \u47484  \u48155 \u50520 \u45796 . \u44536 \u47084 \u45208  \u51648 \u54812 \u47196 \u50864 \u49888  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u44536  \u44397 \u44368  \u51088 \u52404 \u50640 \u49436  \u44060 \u54785 \u51012  \u51068 \u51004 \u53412 \u45716  \u49324 \u44148 \u46308 \u51060  \u51068 \u50612 \u45208 \u44172  \u54616 \u49512 \u45796 . \u44536 \u44163 \u51060  \u51204 \u54784  \u50808 \u48512 \u47196 \u48512 \u53552  \u50772 \u50632 \u45908 \u46972 \u47732  \u44536 \u44163 \u51008  \u44536 \u44163 \u51012  \u47588 \u50864  \u54596 \u50836 \u47196  \u54616 \u45716  \u45236 \u48512 \u50640 \u44620 \u51648  \u52840 \u53804 \u54624  \u49688  \u50630 \u50632 \u51012  \u44163 \u51060 \u45796 . \u44536 \u47084 \u45208  \u48512 \u55141 \u51012  \u51452 \u51109 \u54616 \u45716  \u51204 \u46020 \u51088 \u46308 \u51008  \u44368 \u51064 \u46308 \u51060 \u50632 \u51004 \u48064 \u47196 , \u44592 \u54924 \u47564  \u50619 \u51004 \u47732  \u44368 \u54924 \u51032  \u45236 \u48512 \u50640 \u49436  \u51068 \u51012  \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u45796 \u47480  \u48169 \u48277 \u51004 \u47196 \u45716  \u46308 \u50612 \u44040  \u49688  \u50630 \u45716  \u47928 \u46308 \u51012  \u53685 \u54616 \u50668  \u51652 \u47532 \u44032  \u46308 \u50612 \u44032 \u44172  \u46104 \u50632 \u45796 . \u50612 \u46500  \u49457 \u51649 \u51088 \u46308 \u51008  \u46020 \u45909 \u51201  \u54844 \u49688 \u49345 \u53468 \u50640 \u49436  \u44648 \u50612 \u45208 \u49436  \u51088 \u44592 \u46308 \u51032  \u44368 \u44396 \u50640 \u49436  \u50676 \u47148 \u54620  \u51204 \u46020 \u51088 \u44032  \u46104 \u50632 \u45796 . \u44536 \u47532 \u54616 \u50668  \u54805 \u49885 \u51452 \u51032 \u47196  \u47560 \u48708 \u46104 \u50632 \u45912  \u44368 \u54924 \u46308 \u51060  \u49373 \u44592 \u47484  \u46104 \u52286 \u50520 \u45796 .\
\uc0\u50920 \u49836 \u47532 \u51032  \u49884 \u45824 \u50640  \u51080 \u50612 \u49436 \u45716  \u44033  \u49884 \u45824 \u51032  \u44368 \u54924  \u50669 \u49324 \u44032 \u44032  \u49892 \u51613 \u54616 \u45716  \u48148 \u50752  \u44057 \u51060  \u44033 \u44033  \u44057 \u51648  \u50506 \u51008  \u49440 \u47932 \u51012  \u48155 \u51008  \u49324 \u46988 \u46308 \u51060  \u47784 \u46160  \u51088 \u44592 \u46308 \u51060  \u47585 \u51008  \u51649 \u47924 \u47484  \u44048 \u45817 \u54616 \u44256  \u51080 \u50632 \u45796 . \u44536 \u46308 \u51060  \u44032 \u47476 \u52824 \u45716  \u44368 \u47532 \u46308 \u51008  \u47784 \u46304  \u51216 \u50640  \u51080 \u50612 \u49436  \u51068 \u52824 \u46104 \u51648 \u45716  \u50506 \u50520 \u51004 \u45208  \u47784 \u46304  \u49324 \u46988 \u46308 \u51008  \u54616 \u45208 \u45784 \u51032  \u49457 \u47161 \u51004 \u47196  \u44048 \u46041 \u51012  \u48155 \u44256  \u51080 \u50632 \u51004 \u47728 , \u49324 \u46988 \u46308 \u51012  \u44536 \u47532 \u49828 \u46020 \u44760 \u47196  \u51064 \u46020 \u54616 \u45716  \u47785 \u51201 \u51004 \u47196  \u53685 \u51068 \u46104 \u50612  \u51080 \u50632 \u45796 . \u55083 \u54596 \u46300 \u50752  \u50920 \u49836 \u47532  \u54805 \u51228 \u50752 \u51032  \u44204 \u54644  \u52264 \u51060 \u45716  \u54620  \u46412  \u49436 \u47196  \u48516 \u47532 \u46112  \u50948 \u54744 \u51012  \u45236 \u54252 \u54616 \u44256  \u51080 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44536 \u46308 \u51008  \u44536 \u47532 \u49828 \u46020 \u51032  \u54617 \u44368 \u50640 \u49436  \u50728 \u50976 \u47484  \u48176 \u50912 \u51004 \u48064 \u47196  \u49345 \u54840 \u44036 \u51032  \u51064 \u45236 \u50752  \u49324 \u46993 \u51004 \u47196  \u54868 \u47785 \u54644 \u51276 \u45796 . \u50724 \u47448 \u50752  \u48520 \u48277 \u51060  \u46020 \u52376 \u50640  \u52649 \u47564 \u54616 \u44256 , \u51396 \u51064 \u46308 \u51060  \u47736 \u47581 \u51004 \u47196  \u48736 \u51256 \u44032 \u44256  \u51080 \u45716  \u46041 \u50504  \u44536 \u46308 \u51008  \u45436 \u51137 \u51004 \u47196  \u49884 \u44036 \u51012  \u54728 \u48708 \u54624  \u49688  \u50630 \u50632 \u45796 .\
\uc0\u54616 \u45208 \u45784 \u51032  \u51333 \u46308 \u51008  \u54744 \u54620  \u44600 \u51012  \u44152 \u50632 \u45796 . \u49464 \u47141  \u51080 \u44256  \u54617 \u49885  \u51080 \u45716  \u49324 \u46988 \u46308 \u51008  \u44536 \u46308 \u51012  \u45824 \u51201 \u54616 \u45716  \u51068 \u50640  \u55192 \u51012  \u44592 \u50872 \u50688 \u45796 . \u50620 \u47560  \u54980 \u50640 \u45716  \u47566 \u51008  \u49457 \u51649 \u51088 \u46308 \u51060  \u48516 \u47749 \u54620  \u51201 \u51032 \u47484  \u45208 \u53440 \u45236 \u50632 \u44256 , \u49692 \u44208 \u54620  \u48127 \u51020 \u44284  \u44536  \u48127 \u51020 \u51012  \u51613 \u44144 \u54616 \u45716  \u49324 \u46988 \u46308 \u50640  \u45824 \u54616 \u50668  \u44368 \u54924 \u51032  \u47928 \u46308 \u51012  \u45803 \u50500  \u48260 \u47160 \u45796 . \u44053 \u45800  \u50948 \u50640 \u49436  \u44536 \u46308 \u51012  \u48708 \u45212 \u54616 \u45716  \u49457 \u51649 \u51088 \u46308 \u51032  \u54665 \u46041 \u51008  \u50516 \u55121 \u44284  \u47924 \u51648 \u50752  \u48520 \u48277 \u51012  \u51088 \u50500 \u45236 \u45716  \u50836 \u49548 \u44032  \u46104 \u50632 \u45796 . \u50668 \u47084  \u48264  \u51316  \u50920 \u49836 \u47532 \u45716  \u54616 \u45208 \u45784 \u51032  \u51088 \u48708 \u47196 \u50868  \u51060 \u51201 \u51004 \u47196  \u51453 \u51020 \u51012  \u47732 \u54616 \u50688 \u45796 . \u44201 \u45432 \u54620  \u54253 \u46020 \u51032  \u47924 \u47532 \u44032  \u44536 \u47484  \u49845 \u44201 \u54616 \u50668  \u54588 \u54624  \u44600 \u51060  \u50630 \u45716  \u46319 \u51060  \u48372 \u50688 \u51012  \u46412  \u49324 \u46988 \u51032  \u47784 \u50577 \u51012  \u54620  \u52380 \u49324 \u44032  \u44536 \u51032  \u44225 \u50640  \u45208 \u53440 \u45228 \u45796 . \u44536 \u47084 \u51088  \u54253 \u46020 \u46308 \u51008  \u47932 \u47084 \u44032 \u44256 , \u44536 \u47532 \u49828 \u46020 \u51032  \u51333 \u51008  \u44536  \u50948 \u54744 \u54620  \u51109 \u49548 \u50640 \u49436  \u47924 \u49324 \u55176  \u54588 \u54644  \u