\f1\b0 \cf0 \
\uc0\u44060 \u54785  \u49324 \u50629 \u51012  \u54980 \u50896 \u54616 \u45716  \u54620  \u52828 \u44396 \u50640 \u44172  \u47336 \u53552 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u54200 \u51648 \u54616 \u50688 \u45796 . \'93\u50864 \u47532 \u45716  \u50672 \u44396 \u50752  \u51648 \u47141  (\u26234 \u21147 ) \u51004 \u47196  \u49457 \u44221 \u51012  \u44648 \u45804 \u51012  \u49688  \u50630 \u45796 . \u44536 \u45824 \u44032  \u51228 \u51068  \u47676 \u51200  \u54644 \u50556  \u54624  \u51068 \u51008  \u44592 \u46020 \u51060 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436  \u53356 \u49888  \u51088 \u48708 \u47484  \u44536 \u45824 \u50640 \u44172  \u54728 \u46973 \u54616 \u49492 \u49436  \u44536 \u45824 \u44032  \u49457 \u44221 \u51032  \u52280 \u46907 \u51012  \u51060 \u54644 \u54624  \u49688  \u51080 \u46020 \u47197  \u44036 \u44396 \u54616 \u46972 . \u54616 \u45208 \u45784 \u44760 \u49436  \u52828 \u55176  \u47568 \u50432 \u54616 \u49888  \u48148 \u50752  \u44057 \u51060  \'91\u51200 \u55148 \u44032  \u45796  \u54616 \u45208 \u45784 \u51032  \u44032 \u47476 \u52824 \u49900 \u51012  \u48155 \u51004 \u47532 \u46972 .\'92 \u44536 \u47084 \u48064 \u47196  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51032  \u51200 \u51088 \u51060 \u49888  \u54616 \u45208 \u45784  \u50808 \u50640 \u45716  \u44536 \u48516 \u51032  \u47568 \u50432 \u51012  \u54644 \u49437 \u54624  \u51088 \u44032  \u50630 \u45796 . \u51088 \u44592 \u51032  \u51060 \u54644 \u47141  (\u63972 \u35299 \u21147 ) \u51012  \u51032 \u51648 \u54616 \u51648  \u47568 \u44256  \u51204 \u51201 \u51004 \u47196  \u54616 \u45208 \u45784 \u47564 \u51012  \u51032 \u51648 \u54616 \u44256  \u49457 \u47161 \u51032  \u44048 \u54868 \u47141 \u47564  \u51032 \u51648 \u54616 \u44592  \u48148 \u46976 \u45796 . \u44536 \u47532 \u44256  \u44536  \u49324 \u49892 \u51012  \u52404 \u54744 \u54616 \u44256  \u51080 \u45716  \u54620  \u49324 \u46988 \u51032  \u47568 \u51012  \u48127 \u50612 \u46972 \'94 (D\'92Aubigne, b.3, ch.7). \u50668 \u44592 \u50640 \u45716  \u51060  \u49884 \u45824 \u47484  \u50948 \u54620  \u50628 \u49689 \u54620  \u51652 \u47532 \u47484  \u45796 \u47480  \u49324 \u46988 \u46308 \u50640 \u44172  \u51204 \u54616 \u46020 \u47197  \u54616 \u45208 \u45784 \u51032  \u48512 \u47476 \u49900 \u51012  \u48155 \u50520 \u45796 \u44256  \u49373 \u44033 \u54616 \u45716  \u49324 \u46988 \u46308 \u50640 \u44172  \u51452 \u45716  \u51473 \u50836 \u54620  \u44368 \u54984 \u51060  \u51080 \u45796 . \u51060 \u47084 \u54620  \u51652 \u47532 \u46308 \u51008  \u49324 \u46988 \u51060  \u47564 \u46308 \u50612 \u45240  \u51204 \u49444 \u51060 \u45208  \u51060 \u50556 \u44592 \u47484  \u49324 \u46993 \u54616 \u45716  \u49324 \u46988 \u46308 \u44284  \u49324 \u45800 \u51032  \u51201 \u44060 \u49900 \u51012  \u51068 \u51004 \u53420  \u44163 \u51060 \u45796 . \u50501 \u51032  \u49464 \u47141 \u44284  \u53804 \u51137 \u54624  \u46412 \u45716  \u49324 \u46988 \u51032  \u51648 \u47141  (\u26234 \u21147 ) \u44284  \u51648 \u54812  \u51060 \u49345 \u51032  \u47924 \u50631 \u51060  \u51080 \u50612 \u50556  \u54620 \u45796 .\
\uc0\u50896 \u49688 \u46308 \u51060  \u44288 \u47168 \u45208  \u50976 \u51204 \u51060 \u45208  \u48277 \u50773 \u51032  \u44428 \u50948 \u45208  \u51452 \u51109 \u51012  \u44032 \u51648 \u44256  \u45824 \u54637 \u54644  \u50732  \u46412 , \u47336 \u53552 \u45716  \u49457 \u44221 , \u50724 \u51649  \u49457 \u44221 \u51004 \u47196 \u50024  \u44536 \u44163 \u46308 \u51012  \u45824 \u54637 \u54616 \u50688 \u45796 . \u49457 \u44221 \u50640 \u45716  \u44536 \u46308 \u51060  \u45824 \u45813 \u54624  \u49688  \u50630 \u45716  \u45436 \u51613 \u51060  \u51080 \u50632 \u45796 . \u44536 \u47084 \u48064 \u47196  \u54805 \u49885 \u44284  \u48120 \u49888 \u51032  \u51333 \u51060  \u46108  \u44536 \u46308 \u51008  \u47560 \u52824  \u50976 \u45824 \u51064 \u46308 \u51060  \u44536 \u47532 \u49828 \u46020 \u51032  \u54588 \u47484  \u45804 \u46972 \u44256  \u49548 \u46041 \u54664 \u45912  \u44163 \u52376 \u47100  \u47336 \u53552 \u51032  \u54588 \u47484  \u45804 \u46972 \u44256  \u49548 \u46041 \u54616 \u50688 \u45796 . \u47196 \u47560 \u44368 \u51032  \u50676 \u49457 \u48516 \u51088 \u46308 \u51008  \'93\u44536 \u45716  \u51060 \u45800 \u51088 \u51060 \u45796 \'94\u46972 \u44256  \u48512 \u47476 \u51670 \u50632 \u45796 . \'93\u44536 \u50752  \u44057 \u51060  \u47924 \u49436 \u50868  \u51060 \u45800 \u51088 \u47484  \u51104 \u49884 \u46972 \u46020  \u49332 \u47140 \u46160 \u45716  \u44163 \u51008  \u44368 \u54924 \u50640  \u45824 \u54620  \u53360  \u48152 \u50669 \u51060 \u45796 . \u44536 \u47484  \u51453 \u51068  \u44368 \u49688 \u45824 \u47484  \u49464 \u50864 \u51088 \'94 (D\'92Aubigne, b.3, ch.9). \u44536 \u47084 \u45208  \u47336 \u53552 \u45716  \u44536 \u46308 \u51032  \u48516 \u45432 \u51032  \u51228 \u47932 \u51060  \u46104 \u51648  \u50500 \u45768 \u54616 \u50688 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u44536 \u47484  \u53685 \u54616 \u50668  \u54616 \u49892  \u51068 \u51060  \u50500 \u51649  \u51080 \u50632 \u51004 \u48064 \u47196  \u44536 \u47484  \u48372 \u54840 \u54616 \u49884 \u44592  \u50948 \u54616 \u50668  \u52380 \u49324 \u46308 \u51012  \u48372 \u45236 \u49512 \u45796 . \u44536 \u47084 \u45208  \u47336 \u53552 \u47196 \u48512 \u53552  \u44480 \u51473 \u54620  \u48731 \u51012  \u48155 \u51008  \u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u49324 \u45800 \u51032  \u48516 \u45432 \u51032  \u54364 \u51201 \u51060  \u46104 \u50612  \u51652 \u47532 \u47484  \u50948 \u54616 \u50668  \u45812 \u45824 \u55176  \u44256 \u47928 \u44284  \u51453 \u51076 \u51012  \u45817 \u54616 \u50688 \u45796 .\
\uc0\u47336 \u53552 \u51032  \u44032 \u47476 \u52840 \u51008  \u50728  \u46021 \u51068  \u50504 \u50640  \u51080 \u45716  \u51648 \u44033  \u51080 \u45716  \u49324 \u46988 \u46308 \u51032  \u51452 \u51032 \u47484  \u45132 \u50632 \u45796 . \u44536 \u51032  \u49444 \u44368 \u50752  \u51200 \u49436 \u50640 \u49436  \u47924 \u49688 \u54620  \u49324 \u46988 \u46308 \u51012  \u44033 \u49457 \u49884 \u53412 \u44256  \u44648 \u50864 \u52824 \u45716  \u48731 \u51032  \u44305 \u49440 \u51060  \u45208 \u50772 \u45796 . \u49328  \u48127 \u51020 \u51060  \u47588 \u50864  \u50724 \u47019 \u46041 \u50504  \u44368 \u54924 \u44032  \u44256 \u49688 \u54644  \u50728  \u51453 \u51008  \u54805 \u49885 \u51452 \u51032 \u47484  \u45824 \u49888 \u54616 \u44172  \u46104 \u50632 \u45796 . \u48177 \u49457 \u46308 \u51008  \u45216 \u47560 \u45796  \u47196 \u47560 \u44368 \u51032  \u48120 \u49888 \u50640  \u45824 \u54620  \u54869 \u49888 \u51012  \u51075 \u50612 \u44032 \u44256  \u51080 \u50632 \u45796 . \u54200 \u44204 \u51032  \u51109 \u48317 \u51008  \u51228 \u44144 \u46104 \u50612  \u44052 \u45796 . \u47336 \u53552 \u44032  \u47784 \u46304  \u44368 \u47532 \u50752  \u51452 \u51109 \u51012  \u49884 \u54744 \u54616 \u45716  \u45936  \u49324 \u50857 \u54644  \u50728  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51008  \u51340 \u50864 \u50640  \u45216 \u49440  \u44160 \u52376 \u47100  \u48177 \u49457 \u46308 \u51032  \u47560 \u51020 \u49549 \u51012  \u46763 \u44256  \u46308 \u50612 \u44032 \u44256  \u51080 \u50632 \u45796 . \u46020 \u52376 \u50640 \u49436  \u50689 \u51201  \u54693 \u49345 \u50640  \u45824 \u54620  \u44040 \u47581 \u51060  \u51068 \u44648 \u50892 \u51648 \u44256  \u51080 \u50632 \u45796 . \u51204 \u50640  \u50630 \u45912  \u51032 \u50640  \u45824 \u54620  \u51452 \u47548 \u44284  \u47785 \u47560 \u47492 \u51060  \u46020 \u52376 \u50640 \u49436  \u51068 \u50612 \u45228 \u45796 . \u50724 \u47019 \u46041 \u50504  \u51064 \u44036 \u51032  \u51032 \u49885  (\u20736 \u24335 ) \u44284  \u51648 \u49345  (\u22320 \u19978 ) \u51032  \u51473 \u48372 \u51088 \u46308 \u47564 \u51012  \u48148 \u46972 \u48372 \u44256  \u51080 \u45912  \u49324 \u46988 \u46308 \u51032  \u45576 \u51060  \u51060 \u51228 \u45716  \u54924 \u44060 \u50752  \u48127 \u51020 \u51004 \u47196  \u44536 \u47532 \u49828 \u46020 \u50752  \u49901 \u51088 \u44032 \u50640  \u47803  \u48149 \u55176 \u49888  \u48516 \u51012  \u48148 \u46972 \u48372 \u44172  \u46104 \u50632 \u45796 .\
\uc0\u51060 \u52376 \u47100  \u51068 \u48152  \u49324 \u46988 \u46308 \u51032  \u44288 \u49900 \u51060  \u54140 \u51256 \u44048 \u50640  \u46384 \u46972  \u48277 \u50773 \u51032  \u44428 \u47141 \u51008  \u54620 \u52789  \u45908  \u50948 \u54801 \u51012  \u48155 \u44172  \u46104 \u50632 \u45796 . \u47336 \u53552 \u45716  \u51060 \u45800 \u51012  \u51452 \u51109 \u54616 \u45716  \u51088 \u46972 \u45716  \u44256 \u49548 \u50640  \u45813 \u48320 \u54616 \u44592  \u50948 \u54616 \u50668  \u47196 \u47560 \u47196  \u52636 \u46160 \u54616 \u46972 \u45716  \u47749 \u47161 \u51012  \u48155 \u50520 \u45796 . \u51060  \u47749 \u47161 \u51008  \u44536 \u51032  \u52828 \u44396 \u46308 \u50640 \u44172  \u44277 \u54252 \u44048 \u51012  \u51452 \u50632 \u45796 . \u44536 \u46308 \u51008  \u50696 \u49688 \u45784 \u51032  \u49692 \u44368 \u51088 \u46308 \u51032  \u54588 \u50640  \u51060 \u48120  \u52712 \u54620  \u53440 \u46973 \u54620  \u47196 \u47560 \u50640  \u47336 \u53552 \u47484  \u48372 \u45236 \u45716  \u44163 \u51008  \u44536 \u47484  \u50948 \u54744  \u49549 \u50640  \u48736 \u46888 \u47532 \u45716  \u44163 \u44284  \u44057 \u45796 \u45716  \u49324 \u49892 \u51012  \u50508 \u50520 \u45796 . \u44536 \u46308 \u51008  \u47336 \u53552 \u44032  \u47196 \u47560 \u50640  \u44032 \u45716  \u44163 \u51012  \u48152 \u45824 \u54616 \u44256 , \u44536 \u44032  \u46021 \u51068 \u50640 \u49436  \u49900 \u47928 \u51012  \u48155 \u46020 \u47197  \u54644 \u45804 \u46972 \u44256  \u50836 \u44396 \u54616 \u50688 \u45796 .\
