\f1\b0 \cf0 \
\uc0\u44536 \u47084 \u48064 \u47196  \u49440 \u51648 \u51088 \u51032  \u47568 \u50640  \u51032 \u54616 \u47732  1798\u45380  \u51312 \u44552  \u51204 \u50640  \u50612 \u46500  \u44537 \u50501 \u54620  \u49457 \u44201 \u51032  \u49464 \u47141 \u51060  \u51068 \u50612 \u45208  \u49457 \u44221 \u51012  \u45824 \u54637 \u54616 \u50668  \u49912 \u50864 \u44172  \u46112  \u44163 \u51060 \u50632 \u45796 . \u44536 \u47532 \u54616 \u50668  \u54616 \u45208 \u45784 \u51032  \u46160  \u51613 \u51064 \u51060  \u52840 \u47925 \u51012  \u51648 \u53420  \u49688 \u48150 \u50640  \u50630 \u45716  \u44536  \u45208 \u46972 \u50640 \u49436  \u48148 \u47196 \u51032  \u47924 \u49888 \u47200 \u44284  \u49548 \u46036 \u51032  \u51020 \u46976 \u51060  \u45208 \u53440 \u45216  \u44163 \u51060 \u50632 \u45796 .\
\uc0\u51060  \u50696 \u50616 \u51008  \u54532 \u46993 \u49828 \u51032  \u50669 \u49324 \u50640 \u49436  \u44032 \u51109  \u51221 \u54869 \u54616 \u44256  \u54788 \u51200 \u54616 \u44172  \u49457 \u52712 \u46104 \u50632 \u45796 . 1793\u45380  \u54532 \u46993 \u49828  \u54785 \u47749  \u45817 \u49884 \u50640  \'93\u47928 \u47749 \u44397 \u50640 \u49436  \u52636 \u49373 \u54616 \u50668  \u44368 \u50977 \u51012  \u48155 \u44256 , \u50976 \u47101 \u51032  \u45208 \u46972 \u46308  \u44032 \u50868 \u45936  \u44032 \u51109  \u50864 \u49688 \u54620  \u45208 \u46972 \u47484  \u53685 \u52824 \u54616 \u45716  \u44428 \u47532 \u47484  \u44032 \u51652  \u51032 \u50896 \u46308 \u47196  \u44396 \u49457 \u46108  \u51032 \u54924 \u50640 \u49436  \u49324 \u46988 \u51032  \u47560 \u51020 \u50640  \u48155 \u50500 \u46308 \u51064  \u44032 \u51109  \u50628 \u49689 \u54620  \u51652 \u47532 \u47484  \u51060 \u44396 \u46041 \u49457 \u51004 \u47196  \u48512 \u51064 \u54616 \u44256  \u47564 \u51109 \u51068 \u52824 \u47196  \u54616 \u45208 \u45784 \u44760  \u45824 \u54620  \u49888 \u50521 \u44284  \u50696 \u48176 \u47484  \u48512 \u51064 \u54616 \u45716  \u51020 \u49457 \u51012  \u49464 \u44228 \u45716  \u52376 \u51020 \u51004 \u47196  \u46307 \u44172  \u46104 \u50632 \u45796 \'94 (Sir Walter Scott, Life of Napopeon, vol.1, ch.17). \'93\u50864 \u51452 \u51032  \u52285 \u51312 \u51452 \u50640  \u45824 \u54616 \u50668  \u44277 \u44277 \u50672 \u54616 \u44172  \u48152 \u50669 \u51032  \u49552 \u51012  \u46304  \u44397 \u44032 \u47196 \u49436  \u48127 \u51012  \u47564 \u54620  \u44592 \u47197 \u51012  \u45224 \u44596  \u45208 \u46972 \u45716  \u49464 \u44228 \u50640 \u49436  \u50724 \u51649  \u54532 \u46993 \u49828 \u49104 \u51060 \u45796 . \u50689 \u44397 , \u46021 \u51068 , \u49828 \u54168 \u51064 , \u44536  \u48150 \u51032  \u45796 \u47480  \u45208 \u46972 \u50640 \u49436 \u46020  \u54616 \u45208 \u45784 \u51012  \u47784 \u46021 \u54616 \u45716  \u51088 \u46308 \u44284  \u47924 \u49888 \u47200 \u51012  \u51452 \u51109 \u54616 \u45716  \u51088 \u46308 \u51060  \u44228 \u49549 \u54644 \u49436  \u47566 \u51060  \u51316 \u51116 \u54644  \u50772 \u44256  \u51648 \u44552 \u46020  \u50668 \u51204 \u55176  \u51316 \u51116 \u54616 \u44256  \u51080 \u45796 . \u44536 \u47084 \u45208  \u54532 \u46993 \u49828 \u45716  \u51032 \u54924 \u51032  \u44208 \u51032 \u47196 \u50024  \u47924 \u49888 \u47200 \u51012  \u49440 \u50616 \u54664 \u44256 , \u49688 \u46020  (\u39318 \u37117 ) \u51032  \u47784 \u46304  \u51064 \u44396 \u50752  \u44536  \u48150 \u51032  \u47784 \u46304  \u44275 \u50640 \u49436  \u47924 \u49688 \u54620  \u49324 \u46988 \u46308 \u51060  \u45224 \u45376 \u47484  \u47561 \u47200 \u54616 \u44256  \u44536  \u44208 \u51032 \u47484  \u49688 \u46973 \u54616 \u44256 , \u44592 \u49256 \u51004 \u47196  \u45432 \u47000 \u54616 \u47728  \u52644 \u51012  \u52632  \u50976 \u51068 \u51032  \u44397 \u44032 \u47196 \u49436  \u49464 \u44228  \u50669 \u49324 \u49345  \u44536  \u50976 \u47168 \u47484  \u52286 \u50500 \u48380  \u49688  \u50630 \u45796 \'94 (Blackwood\'92s Magazine, November 1870).\
\uc0\u54532 \u46993 \u49828 \u45716  \u53945 \u55176  \u49548 \u46036 \u50640 \u49436  \u54788 \u51200 \u54616 \u44172  \u45208 \u53440 \u45228 \u45912  \u53945 \u51669 \u51012  \u46300 \u47084 \u45236 \u50632 \u45796 . \u54532 \u46993 \u49828  \u54785 \u47749  \u45817 \u49884 \u50640 \u45716  \u50715 \u45216 \u51032  \u54217 \u50896  (\u24179 \u21407 ) \u51032  \u46020 \u49884 \u46308 \u51012  \u47736 \u47581 \u49884 \u53040 \u45912  \u44163 \u44284  \u46609 \u44057 \u51008  \u46020 \u45909 \u51201  \u53440 \u46973 \u44284  \u48512 \u54056 \u44032  \u54200 \u47564 \u54664 \u45796 . \u44536 \u47532 \u44256  \u50669 \u49324 \u44032 \u45716  \u50696 \u50616 \u50640  \u44592 \u47197 \u46108  \u44536 \u45824 \u47196  \u54532 \u46993 \u49828 \u51032  \u47924 \u49888 \u47200 \u44284  \u51020 \u46976 \u54620  \u49345 \u53468 \u47484  \u44592 \u47197 \u54644  \u45459 \u50520 \u45796 . \'93\u51333 \u44368 \u50640  \u50689 \u54693 \u51012  \u45180 \u52828  \u48277 \u47456 \u44284  \u48128 \u51217 \u54620  \u44288 \u44228 \u47484  \u44032 \u51652  \u44163 \u51008  \u44208 \u54844 \u51032  \u44221 \u49884 \u50688 \u45796 . \u49324 \u46988 \u51060  \u47610 \u51012  \u49688  \u51080 \u45716  \u44032 \u51109  \u49888 \u49457 \u54620  \u44228 \u50557 \u51060 \u47728  \u49324 \u54924 \u51032  \u44204 \u44256 \u54620  \u44592 \u52488 \u50640  \u44032 \u51109  \u44053 \u47141 \u54620  \u50669 \u54624 \u51012  \u54616 \u45716  \u44208 \u54844  \u51228 \u46020 \u44032  \u45817 \u49324 \u51088  \u46160  \u49324 \u46988 \u51060  \u47560 \u51020 \u45824 \u47196  \u44208 \u54633 \u54616 \u50688 \u45796 \u44032  \u45796 \u49884  \u54756 \u50612 \u51656  \u49688  \u51080 \u45716  \u51068 \u49884 \u51201 \u51064  \u49457 \u44201 \u51012  \u46948  \u45800 \u49692 \u54620  \u48124 \u44036  \u44228 \u50557 \u51004 \u47196  \u51204 \u46973 \u54644  \u48260 \u47160 \u45796 . \'85\u50501 \u47560 \u46308 \u51060  \u51064 \u47448 \u51032  \u44032 \u51221 \u49373 \u54876 \u50640  \u51080 \u50612 \u49436  \u44032 \u51109  \u44256 \u44480 \u54616 \u44256 , \u50500 \u47492 \u45813 \u44256 , \u50689 \u44396 \u51201 \u51064  \u44163 \u51012  \u44032 \u51109  \u54952 \u44284 \u51201 \u51004 \u47196  \u54028 \u44340 \u54644  \u48260 \u47532 \u44256 , \u44536 \u46308 \u51060  \u47785 \u51201 \u54620  \u54644 \u46021 \u51012  \u45824 \u45824 \u47196  \u50689 \u49549 \u49884 \u53412 \u44256  \u49457 \u52712 \u54616 \u45716  \u48169 \u48277 \u51012  \u48156 \u44204 \u54616 \u47140 \u44256  \u54620 \u45796 \u47732 , \u44208 \u54844  \u51228 \u46020 \u47484  \u47924 \u45320 \u46888 \u47532 \u45716  \u44163 \u48372 \u45796  \u45908 \u50865  \u54952 \u44284 \u51201 \u51064  \u48169 \u48277 \u51008  \u50630 \u51012  \u44163 \u51060 \u45796 . \'85\u47896 \u54620  \u47568 \u51012  \u51096 \u54616 \u44592 \u47196  \u50976 \u47749 \u54620  \u50668 \u48176 \u50864  \u49548 \u54588  \u50500 \u45440 \u46300  (Sophie Arnoult) \u45716  \u54532 \u46993 \u49828 \u51032  \u54785 \u47749  \u49884 \u45824 \u51032  \u44208 \u54844 \u51012  \'91\u44036 \u51020 \u51032  \u50696 \u49885  (\u63926 \u24335 ) \'92\u51004 \u47196  \u54217 \u54616 \u50688 \u45796 \'94 (Scott, vol.1, ch.17).\
\'93\uc0\u51452 \u44760 \u49436  \u49901 \u51088 \u44032 \u50640  \u47803  \u48149 \u55176 \u49888  \u44275 \u51060 \u45768 \u46972 \'94\u45716  \u50696 \u50616 \u51008  \u44544 \u51088  \u44536 \u45824 \u47196  \u54532 \u46993 \u49828 \u50640 \u49436  \u49457 \u52712 \u46104 \u50632 \u45796 . \u44536 \u47532 \u49828 \u46020 \u44760  \u45824 \u54620  \u51201 \u51032  (\u25973 \u24847 ) \u44032  \u51060  \u45208 \u46972 \u50640 \u49436 \u48372 \u45796  \u45908 \u50865  \u54788 \u51200 \u55176  \u45208 \u53440 \u45212  \u45208 \u46972 \u45716  \u50630 \u45796 . \u51652 \u47532 \u47484  \u51060  \u45208 \u46972 \u50640 \u49436 \u48372 \u45796  \u45908 \u50865  \u47609 \u47148 \u54616 \u44256  \u51092 \u54841 \u54616 \u44172  \u48152 \u45824 \u54620  \u45208 \u46972 \u46020  \u50630 \u45796 . \u48373 \u51020 \u51012  \u48127 \u45716  \u49324 \u46988 \u46308 \u50640 \u44172  \u48149 \u54644 \u47484  \u44032 \u54632 \u51004 \u47196  \u54532 \u46993 \u49828 \u45716  \u44536 \u47532 \u49828 \u46020 \u51032  \u51228 \u51088 \u46308 \u51012  \u53685 \u54616 \u50668  \u44536 \u47532 \u49828 \u46020 \u47484  \u49901 \u51088 \u44032 \u50640  \u47803  \u48149 \u50520 \u45796 .\
\pard\pardeftab720\sa319\partightenfactor0

\f0\b \cf0 \uc0\u54532 \u46993 \u49828 \u51032  \u50948 \u44536 \u45432 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u49457 \u46020 \u51032  \u54588 \u45716  \u50668 \u47084  \u49464 \u44592 \u50640  \u44152 \u52432  \u55128 \u47104 \u45796 . \u50760 \u45940 \u49828 \u44368 \u46020 \u46308 \u51060  \'93\u54616 \u45208 \u45784 \u51032  \u44228 \u47749 \u44284  \u50696 \u49688 \u51032  \u51613 \u44144 \u47484  \u50948 \u54616 \u50668 \'94 \u54588 \u50640 \u47805  \u49328 \u50640 \u49436  \u44536 \u46308 \u51032  \u49373 \u47749 \u51012  \u48260 \u47160 \u51012  \u46412 , \u54532 \u46993 \u49828 \u50640 \u49436 \u45716  \u44536 \u46308 \u51032  \u54805 \u51228 \u51064  \u50508 \u48708 \u51232 \u49828  (Albigens) \u46308 \u51060  \u51652 \u47532 \u50640  \u45824 \u54616 \u50668  \u46041 \u51068 \u54620  \u51613 \u44144 \u47484  \u54616 \u50688 \u45796 . \u51333 \u44368 \u44060 \u54785  \u45817 \u49884 \u50640  \u44536  \u44368 \u46020 \u46308 \u51008  \u52280 \u54841 \u54620  \u44256 \u47928 \u51004 \u47196  \u51453 \u51020 \u51012  \u45817 \u54616 \u50688 \u45796 . \u50773 \u44284  \u44480 \u51313 \u46308 \u44284  \u49345 \u47448  \u44228 \u44553 \u51032  \u48512 \u51064 \u46308 \u44284  \u50672 \u50557 \u54620  \u52376 \u45376 \u46308 \u44284  \u44536  \u45208 \u46972 \u51032  \u44368 \u47564 \u54620  \u49324 \u46988 \u46308 \u44284  \u47924 \u49324 \u46308 \u51008  \u50696 \u49688 \u45784 \u51012  \u50948 \u54616 \u50668  \u49692 \u44368 \u45817 \u54616 \u45716  \u49324 \u46988 \u46308 \u51032  \u44256 \u53685 \u51012  \u48372 \u44256  \u51600 \u44144 \u50892 \u54616 \u50688 \u45796 . \u50857 \u44048 \u54620  \u50948 \u44536 \u45432  (Huguenot) \u46308 \u51008  \u49324 \u46988 \u51032  \u50577 \u49900 \u51060  \u44032 \u51109  \u49888 \u49457 \u54616 \u44172  \u50668 \u44592 \u45716  \u44428 \u50948 \u47484  \u50745 \u54840 \u54616 \u44592  \u50948 \u54616 \u50668  \u49912 \u50880 \u51012  \u44228 \u49549 \u54616 \u44256 , \u47566 \u51008  \u52824 \u50676 \u54620  \u51204 \u51137 \u53552 \u50640 \u49436  \u54588 \u47484  \u55128 \u47160 \u45796 . \u44060 \u49888 \u44368 \u46020 \u46308 \u51008  \u48277 \u47456 \u49345  \u48372 \u54840 \u50640 \u49436  \u51228 \u50808 \u46108  \u51088 \u47196  \u51064 \u51221 \u46104 \u50612  \u44536 \u46308 \u51032  \u47672 \u47532 \u50640 \u45716  \u54788 \u49345 \u44552 \u51060  \u48537 \u44172  \u46104 \u50632 \u44256 , \u44536 \u46308 \u51008  \u46308 \u51664 \u49849 \u46308 \u52376 \u47100  \u49324 \u45285 \u51032  \u45824 \u49345 \u51060  \u46104 \u50632 \u45796 .\
\uc0\u44256 \u45824  \u44536 \u47532 \u49828 \u46020 \u51064 \u46308  \u51473 \u51032  \u49548 \u49688 \u51032  \u54980 \u50696 \u46308 \u47196 \u49436  18\u49464 \u44592  \u45817 \u49884 \u44620 \u51648  \u54532 \u46993 \u49828 \u51032  \u45224 \u48169  \u49328 \u51473 \u50640  \u49704 \u50612 \u49436  \u44144 \u51452 \u54616 \u44256  \u51080 \u45912  \'93\u44305 \u50556  \u44368 \u54924 \'94\u45716  \u50668 \u51204 \u55176  \u51312 \u49345 \u46308 \u51032  \u49888 \u50521 \u51012  \u44403 \u44172  \u51648 \u53412 \u44256  \u51080 \u50632 \u45796 . \u48164 \u51012  \u53960 \u53440 \u49436  \u44536 \u46308 \u51060  \u49328 \u51473 \u53553 \u51060 \u45208  \u51201 \u47561 \u54620  \u46308 \u50640 \u49436  \u47792 \u47000  \u51665 \u54924 \u47484  \u50676 \u44256 \u51088  \u54624  \u46412 , \u44536 \u46308 \u51008  \u44049 \u51089 \u49828 \u47088  \u50857 \u44592 \u48337  (\u63940 \u39438 \u20853 ) \u46308 \u51032  \u52628 \u44201 \u51004 \u47196  \u48537 \u51105 \u55176 \u44172  \u46104 \u50632 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u46308 \u51008  \u45432 \u50696 \u45208  \u51396 \u49688 \u46308 \u51060  \u45432 \u47484  \u51200 \u50612  \u45796 \u45768 \u45716  \u44068 \u47532 \u49440  (galleys) \u50640 \u49436  \u51453 \u45716  \u45216 \u44620 \u51648  \u44256 \u50669 \u51012  \u45817 \u54616 \u44172  \u46104 \u50632 \u45796 . \u54532 \u46993 \u49828 \u50640 \u49436  \u44032 \u51109  \u49692 \u49688 \u54616 \u44256 , \u44592 \u54408  \u51080 \u44256 , \u51648 \u49457 \u51201 \u51064  \u49324 \u46988 \u46308 \u51008  \u44053 \u46020 \u46308 \u44284  \u49332 \u51064 \u51088 \u46308  \u49324 \u51060 \u50640  \u49438 \u50668 \u49436  \u47568 \u54624  \u49688  \u50630 \u45716  \u44256 \u53685 \u51012  \u44202 \u51004 \u47732 \u49436  \u49632 \u49324 \u49836 \u50640  \u47588 \u50668  \u51080 \u44172  \u46104 \u50632 \u45796  (Wylie, b.22, ch.6 \u52280 \u51312 ). \u51328  \u45908  \u51088 \u48708 \u47196 \u50868  \u52376 \u48516 \u51012  \u48155 \u51008  \u49324 \u46988 \u46308 \u51008  \u50500 \u47924 \u47088  \u47924 \u51109 \u46020  \u50630 \u51060  \u49549 \u51208 \u50630 \u45716  \u54805 \u54200 \u50640 \u49436  \u44592 \u46020 \u54616 \u44256 \u51088  \u47924 \u47502 \u51012  \u44999 \u50632 \u51012  \u46412  \u52280 \u54841 \u54616 \u44172  \u49324 \u44201 \u51012  \u45817 \u54616 \u50688 \u45796 . \u49688 \u48177  \u47749 \u51032  \u45208 \u51060  \u47566 \u51008  \u45224 \u51088 \u46308 , \u48169 \u48708  \u50630 \u45716  \u50668 \u51088 \u46308 , \u52380 \u51652 \u54620  \u50612 \u47536 \u51060 \u46308 \u51060  \u44536 \u46308 \u51032  \u51665 \u54924  \u51109 \u49548 \u50640 \u49436  \u49332 \u54644 \u46104 \u50612  \u44536 \u45824 \u47196  \u45236 \u48260 \u47140 \u51276 \u45796 . \u44536 \u46308 \u51060  \u54217 \u49548 \u50640  \u51665 \u54924 \u47484  \u54616 \u45912  \u49328  \u51473 \u53553 \u51060 \u45208  \u49328 \u47548  \u49549 \u51012  \u51648 \u45208 \u44040  \u46412  \u49884 \u52404 \u44032  \u54400 \u48173  \u49324 \u48169 \u50640  \u55145 \u50612 \u51256  \u51080 \u44144 \u45208  \u45208 \u47924 \u50640  \u47588 \u45804 \u47140  \u51080 \u45716  \u44163 \u51012  \u48372 \u45716  \u51068 \u51008  \u48324 \u47196  \u55148 \u44480 \u54620  \u51068 \u51060  \u50500 \u45768 \u50632 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u46308 \u51032  \u45208 \u46972 \u45716  \'93\u44160 \u44284  \u46020 \u45180 \u50752  \u45208 \u47924  (\u54868 \u54805 \u50640  \u50416 \u45716  \u51109 \u51089 ) \u47196 \u50024  \u54889 \u47049 \u54616 \u50668 \u51276 \u44256 , \u54616 \u45208 \u51032  \u50424 \u50424 \u54616 \u44256  \u53360  \u44305 \u50556 \u47196  \u48148 \u45068 \u44256  \u47568 \u50520 \u45796 .\'94 \'93\u51060 \u52376 \u47100  \u55113 \u50501 \u54620  \u49324 \u44148 \u51008 \'85\u50516 \u55121 \u49884 \u45824 \u50640  \u54665 \u54616 \u50668 \u51652  \u44163 \u51060  \u50500 \u45768 \u46972  \u47336 \u51060  14\u49464 \u51032  \u52268 \u46976 \u54620  \u49884 \u45824 \u50640  \u51088 \u54665 \u46104 \u50632 \u45796 . \u44536  \u45817 \u49884 \u50640  \u44284 \u54617 \u51008  \u48156 \u45804 \u46104 \u44256  \u47928 \u50696 \u44032  \u48512 \u55141 \u46104 \u44256 , \u44417 \u44432 \u44284  \u49688 \u46020 \u50640  \u49324 \u45716  \u49457 \u51649 \u51088 \u46308 \u51008  \u50976 \u49885 \u54616 \u44256  \u47568  \u51096 \u54616 \u45716  \u48320 \u49324 \u46308 \u51060 \u47728 , \u44216 \u49552 \u44284  \u51088 \u48708 \u51032  \u48120 \u45909 \u51012  \u49324 \u46993 \u54616 \u45716  \u51088 \u46308 \u47196  \u51064 \u51221 \u48155 \u44256  \u51080 \u50632 \u45796 \'94 (Wylie, b.22, ch.7).\
\uc0\u51396 \u50501 \u51032  \u52280 \u54841 \u54620  \u47785 \u47197  \u44032 \u50868 \u45936 \u49436  \u44032 \u51109  \u50516 \u55121 \u54620  \u44163 , \u44263  \u44033  \u49464 \u44592 \u47484  \u53685 \u54616 \u50668  \u51088 \u54665 \u46108  \u51092 \u51064 \u47924 \u46020 \u54620  \u51068  \u51473 \u50640 \u49436  \u44032 \u51109  \u45140 \u52237 \u49828 \u47088  \u47564 \u54665 \u51008  \u49457  \u48148 \u46028 \u47196 \u47588  \u51228 \u51068  (\u31085 \u26085 ) \u45824 \u54617 \u49332 \u51060 \u45796 . \u49464 \u49345 \u51008  \u50724 \u45720 \u45216 \u46020  \u50668 \u51204 \u55176  \u44536  \u51092 \u51064 \u54616 \u44256  \u48708 \u50676 \u54616 \u44592  \u51060 \u47484  \u45936  \u50630 \u45716  \u49845 \u44201 \u51032  \u44305 \u44221 \u51012  \u44277 \u54252 \u50752  \u51204 \u50984 \u47196 \u50024  \u54924 \u49345 \u54616 \u51648  \u50506 \u51012  \u49688  \u50630 \u45796 . \u54532 \u46993 \u49828 \u51032  \u50773 \u51008  \u47196 \u47560 \u44368 \u51032  \u49849 \u47140 \u50752  \u51452 \u44368 \u46308 \u51032  \u44053 \u50836 \u47196  \u44536  \u55113 \u50501 \u54620  \u54665 \u50948 \u47484  \u47925 \u51064 \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u49324 \u48169 \u51060  \u44256 \u50836 \u54620  \u54620 \u48164 \u51473 \u51032  \u51201 \u47561 \u51012  \u44648 \u46888 \u47532 \u44256  \u50872 \u47140  \u54140 \u51652  \u50773 \u44417 \u51032  \u53360  \u51333 \u49548 \u47532 \u45716  \u54617 \u49332 \u50640  \u45824 \u54620  \u49888 \u54840 \u44032  \u46104 \u50632 \u45796 . \u49688 \u52380  \u47749 \u51032  \u44060 \u49888 \u44368 \u46020 \u46308 \u51008  \u50773 \u51032  \u47749 \u50696 \u47484  \u44148  \u50557 \u49549 \u47564 \u51012  \u49888 \u47280 \u54616 \u44256  \u44033 \u51088 \u51032  \u51665 \u50640 \u49436  \u54217 \u50504 \u55176  \u51088 \u44256  \u51080 \u50632 \u45716 \u45936 , \u44536 \u46308 \u51008  \u50500 \u47924 \u47088  \u44221 \u44256 \u46020  \u50630 \u51060  \u44049 \u51088 \u44592  \u45132 \u47140  \u45208 \u44032  \u47924 \u52280 \u54616 \u44172  \u49332 \u50977 \u51012  \u45817 \u54616 \u50688 \u45796 .\
