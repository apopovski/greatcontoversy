\uc0\u44536 \u47084 \u45208  \u44536 \u47532 \u49828 \u46020 \u51032  \u47785 \u51201 \u51008  \u51340 \u51208 \u46104 \u51648  \u50506 \u50520 \u45796 . \u51452 \u45784 \u44760 \u49436  \u50501 \u47161 \u46308 \u50640 \u44172  \u46076 \u51648  \u46524 \u46308 \u51012  \u47736 \u54616 \u46020 \u47197  \u54728 \u46973 \u54616 \u49888  \u44163 \u51008  \u51060 \u51061 \u51012  \u50619 \u44592  \u50948 \u54616 \u50668  \u44536 \u47084 \u54620  \u45908 \u47084 \u50868  \u51664 \u49849 \u51012  \u44592 \u47476 \u45716  \u50976 \u45824 \u51064 \u46308 \u51012  \u44204 \u52293 \u54616 \u49884 \u44592  \u50948 \u54632 \u51060 \u50632 \u45796 . \u47564 \u51068  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u51060 \u46412 \u50640  \u44536  \u49324 \u44480 \u46308 \u51012  \u47561 \u51648  \u50500 \u45768 \u54616 \u49512 \u51012  \u44163  \u44057 \u51004 \u47732  \u49324 \u44480 \u46308 \u51008  \u46076 \u51648 \u49104  \u50500 \u45768 \u46972  \u44536  \u51648 \u53412 \u45716  \u51088 \u46308 \u44284  \u44536  \u51452 \u51064 \u44620 \u51648 \u46020  \u48148 \u45796  \u44032 \u50868 \u45936  \u48736 \u51648 \u44172  \u54616 \u50688 \u51012  \u44163 \u51060 \u45796 . \u44536  \u46076 \u51648 \u47484  \u51648 \u53412 \u45716  \u51088 \u46308 \u44284  \u51452 \u51064 \u51060  \u48372 \u54840 \u46108  \u44163 \u51008  \u50724 \u51649  \u44536 \u46308 \u51032  \u44396 \u50896 \u51012  \u50948 \u54616 \u50668  \u50669 \u49324 \u54620  \u51452 \u45784 \u51032  \u45733 \u47141 \u50640  \u51032 \u54620  \u44163 \u51060 \u50632 \u45796 . \u46608 \u54620  \u44536  \u49324 \u44148 \u51008  \u51228 \u51088 \u46308 \u50640 \u44172  \u51064 \u47448 \u50752  \u51664 \u49849 \u46308 \u50640 \u44172  \u45208 \u53440 \u45208 \u45716  \u51092 \u51064 \u54620  \u49324 \u45800 \u51032  \u49464 \u47141 \u51012  \u48372 \u50668  \u51452 \u44592  \u50948 \u54632 \u51060 \u50632 \u45796 . \u44396 \u51452 \u44760 \u49436 \u45716  \u45817 \u49888 \u51012  \u46384 \u47476 \u45716  \u51088 \u46308 \u5