\uc0\u51228 \u51088 \u46308 \u51060  \u51452 \u45784 \u51032  \u51060 \u47492 \u51004 \u47196  \u51204 \u54620  \u44163 \u51008  \u49464 \u48128 \u54620  \u48512 \u48516 \u50640  \u51060 \u47476 \u44592 \u44620 \u51648  \u51221 \u54869 \u54620  \u44163 \u51060 \u50632 \u44256  \u44144 \u44592 \u49436  \u47568 \u54620  \u49324 \u44148 \u46308 \u51008  \u44536  \u45817 \u49884 \u50640  \u51060 \u48120  \u51068 \u50612 \u45208 \u44256  \u51080 \u45716  \u44163 \u46308 \u51060 \u50632 \u45796 . \'93\u46412 \u44032  \u52284 \u44256  \u54616 \u45208 \u45784  \u45208 \u46972 \u44032  \u44032 \u44620 \u50912 \'94\u45796 \u45716  \u44163 \u51060  \u44536 \u46308 \u51032  \u44592 \u48324 \u51060 \u50632 \u45796 . \'93\u46412 \u44032 \'94 \u52264 \u44172  \u46104 \u51088 , \u44263  \u45796 \u45768 \u50648 \u49436  9\u51109 \u51032  69\u51452 \u51068 \u51060  \u45149 \u45208 \u44256  \'93\u44592 \u47492  \u48512 \u51020 \u51012  \u48155 \u51008  \u51088  \u47700 \u49884 \u50556 \'94\u44032  \u50732  \u44592 \u50557 \u51060  \u52284 \u51012  \u46412 \u50640  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u50836 \u45800 \u44053 \u50640 \u49436  \u52840 \u47168  \u50836 \u54620 \u50640 \u44172  \u52840 \u47168 \u47484  \u48155 \u51004 \u49884 \u44256  \u49457 \u47161 \u51032  \u44592 \u47492 \u48512 \u51020 \u51012  \u48155 \u51004 \u49512 \u45796 . \u44536 \u47532 \u44256  \u44536 \u46308 \u51060  \u44032 \u44620 \u50912 \u45796 \u44256  \u49440 \u54252 \u54620  \'93\u54616 \u45208 \u45784  \u45208 \u46972 \'94\u45716  \u44536 \u47532 \u49828 \u46020 \u51032  \u51453 \u51004 \u49900 \u51004 \u47196  \u44148 \u49444 \u46104 \u50632 \u45796 . \u44536  \u45208 \u46972 \u45716  \u44536 \u48516 \u51032  \u51228 \u51088 \u46308 \u51060  \u48127 \u44256  \u44032 \u47476 \u52452 \u45912  \u48148 \u50752  \u44057 \u51060  \u51060  \u49464 \u49345 \u51032  \u45208 \u46972 \u44032  \u50500 \u45768 \u50632 \u45796 . \u44536 \u47111 \u45796 \u44256  \u54644 \u49436  \u44536  \u45208 \u46972 \u45716  \'93\u45208 \u46972 \u50752  \u44428 \u49464 \u50752  \u50728  \u52380 \u54616  \u50676 \u44397 \u51032  \u50948 \u49464 \u44032  \u51648 \u44537 \u55176  \u45458 \u51004 \u49888  \u51088 \u51032  \u49457 \u48124 \u50640 \u44172  \u48537 \u51064  \u48148 \'94 \u46104 \u44256 , \'93\u47784 \u46304  \u44428 \u49464  \u51080 \u45716  \u51088 \u44032  \u45796  \u44536 \u47484  \u49452 \u44200  \u48373 \u51333 \'94 (\u45800  7:27) \u54624  \u50689 \u50896 \u54620  \u45208 \u46972 , \u44263  \u51109 \u52264  \u49464 \u50892 \u51656  \u48520 \u47736 \u51032  \u45208 \u46972 \u47484  \u51032 \u48120 \u54616 \u45716  \u44163 \u51060  \u50500 \u45768 \u50632 \u45796 . \u49457 \u44221 \u50640  \u44592 \u47197 \u46108  \'93\u54616 \u45208 \u45784 \u51032  \u45208 \u46972 \'94\u45716  \u51008 \u54812 \u51032  \u50773 \u44397 \u44284  \u50689 \u44305 \u51032  \u50773 \u44397 \u51012  \u45796  \u44057 \u51060  \u44032 \u47532 \u53412 \u45716  \u45936  \u49324 \u50857 \u46104 \u50632 \u45796 . \u51008 \u54812 \u51032  \u50773 \u44397 \u51008  \u48148 \u50872 \u51060  \u55176 \u48652 \u47532 \u51064 \u46308 \u50640 \u44172  \u48372 \u45240  \u54200 \u51648 \u50640 \u49436  \u48516 \u47749 \u55176  \u52286 \u50500 \u48380  \u49688  \u51080 \u45796 . \u49324 \u46020  \u48148 \u50872 \u51008  \u44536 \u47532 \u49828 \u46020 \u44032  \'93\u50864 \u47532  \u50672 \u50557 \u54632 \u51012  \u52404 \u55100 \u54616 \u51648  \u50500 \u45768 \u54616 \u45716  \u51088 \u44032  \u50500 \u45768 \u50836 \'94 \u51088 \u48708 \u54616 \u49888  \u51473 \u48372 \u51088 \u51060 \u49900 \u51012  \u51648 \u51201 \u54620  \u45796 \u51020 \u50640  \'93\u44536 \u47084 \u48064 \u47196  \u50864 \u47532 \u44032  \u44557 \u55100 \u54616 \u49900 \u51012  \u48155 \u44256  \u46412 \u47484  \u46384 \u46972  \u46037 \u45716  \u51008 \u54812 \u47484  \u50619 \u44592  \u50948 \u54616 \u50668  \u51008 \u54812 \u51032  \u48372 \u51340  \u50526 \u50640  \u45812 \u45824 \u55176  \u45208 \u50500 \u44040  \