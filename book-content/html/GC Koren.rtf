\f1\b0 \cf0 \
\uc0\u44536  \u45817 \u49884 \u50640 \u45716  \u44592 \u46020 \u51032  \u51025 \u45813 \u51012  \u48155 \u45716  \u48127 \u51020 , \u48152 \u46300 \u49884  \u48372 \u49345 \u51012  \u48155 \u45716  \u48127 \u51020 \u51060  \u51080 \u50632 \u45796 . \u47560 \u52824  \u47700 \u47560 \u47480  \u46405 \u50640  \u49548 \u45208 \u44592 \u44032  \u45236 \u47532 \u45716  \u44163 \u52376 \u47100  \u50676 \u49900 \u51004 \u47196  \u52286 \u50500  \u44396 \u54616 \u45716  \u51088 \u46308 \u50640 \u44172  \u51008 \u54812 \u51032  \u50689 \u51060  \u51076 \u54616 \u50688 \u45796 . \u50724 \u47000 \u51648  \u50506 \u50500 \u49436  \u44536 \u46308 \u51032  \u44396 \u51452 \u47484  \u45824 \u47732 \u54616 \u50668  \u47564 \u45216  \u44163 \u51012  \u44592 \u45824 \u54616 \u45716  \u49324 \u46988 \u46308 \u51008  \u47568 \u54624  \u49688  \u50630 \u51060  \u50628 \u49689 \u54620  \u44592 \u49256 \u51012  \u45712 \u44808 \u45796 . \u54616 \u45208 \u45784 \u51032  \u52629 \u48373 \u51060  \u52649 \u49457 \u46104 \u44256  \u44221 \u44148 \u54620  \u47924 \u47532 \u46308  \u50948 \u50640  \u54413 \u49457 \u55176  \u51452 \u50612 \u51656  \u46412  \u49457 \u47161 \u51032  \u48512 \u46300 \u47101 \u44172  \u54616 \u44256  \u49692 \u51333 \u52992  \u54616 \u45716  \u45733 \u47141 \u51060  \u47560 \u51020 \u46308 \u51012  \u45433 \u50688 \u45796 .\
\uc0\u44592 \u48324 \u51012  \u48155 \u50500 \u46308 \u51064  \u49324 \u46988 \u46308 \u51008  \u51452 \u51032  \u44618 \u44256  \u50628 \u49689 \u54616 \u44172  \u44536 \u46308 \u51032  \u51452 \u45784 \u51012  \u50689 \u51217 \u54624  \u44163 \u51004 \u47196  \u44592 \u45824 \u54664 \u45912  \u49884 \u44592 \u47484  \u48148 \u46972 \u48372 \u44172  \u46104 \u50632 \u45796 . \u44536 \u46308 \u51008  \u47588 \u51068  \u50500 \u52840  \u54616 \u45208 \u45784 \u44760 \u49436  \u44032 \u45225 \u54644  \u51452 \u49888  \u51613 \u44144 \u47484  \u50619 \u45716  \u44163 \u51012  \u44536 \u46308 \u51032  \u52395 \u51704  \u46104 \u45716  \u51032 \u47924 \u47196  \u50668 \u44220 \u45796 . \u44536 \u46308 \u51032  \u47560 \u51020 \u51008  \u48128 \u51217 \u55176  \u50672 \u54633 \u46104 \u50632 \u51004 \u47728 , \u44536 \u46308 \u51008  \u49436 \u47196 \u47484  \u50948 \u54616 \u50668  \u44592 \u46020 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u46412 \u46412 \u47196  \u54620 \u51201 \u54620  \u44275 \u50640  \u47784 \u50668 \u49436  \u54616 \u45208 \u45784 \u44284  \u44368 \u53685 \u54616 \u50688 \u45716 \u45936 , \u54632 \u44760  \u47784 \u50668 \u49436  \u44592 \u46020 \u54616 \u44256  \u44536 \u47532 \u44256  \u49436 \u47196 \u47484  \u50948 \u54616 \u50668  \u44592 \u46020 \u54616 \u45716  \u49548 \u47532 \u44032  \u46308 \u44284  \u49714  \u49324 \u51060 \u50640 \u49436  \u54616 \u45720 \u47196  \u49345 \u45804 \u46104 \u50632 \u45796 . \u44396 \u51452 \u44760 \u49436  \u51064 \u51221 \u54644  \u51452 \u49884 \u45716  \u54869 \u51613 \u51060  \u44536 \u46308 \u50640 \u44172 \u45716  \u45216 \u47560 \u45796 \u51032  \u50577 \u49885 \u48372 \u45796  \u45908 \u50865  \u54596 \u50836 \u54616 \u50688 \u45796 . \u44536 \u47084 \u48064 \u47196  \u47564 \u51068  \u44536 \u46308 \u51032  \u47560 \u51020 \u50640  \u50612 \u46160 \u50868  \u44396 \u47492 \u51060  \u45934 \u51060 \u45716  \u46412 \u50640 \u45716  \u44536 \u44163 \u51060  \u49324 \u46972 \u51648 \u44592 \u44620 \u51648  \u49772 \u51648  \u50506 \u44256  \u44592 \u46020 \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u50857 \u49436 \u54644  \u51452 \u49884 \u45716  \u51008 \u54812 \u47484  \u48155 \u51008  \u51613 \u44144 \u47484  \u45712 \u45180 \u44172  \u46112  \u46412 \u50640  \u44536 \u46308 \u51008  \u51088 \u44592 \u46308 \u51060  \u51652 \u49900 \u51004 \u47196  \u49324 \u46993 \u54616 \u45716  \u44396 \u51452 \u44760 \u49436  \u45208 \u53440 \u45208 \u44592 \u47484  \u49324 \u47784 \u54616 \u50688 \u45796 .\
\uc0\u44536 \u47084 \u45208  \u44536 \u46308 \u51008  \u45796 \u49884 \u44552  \u49892 \u47581 \u54624  \u49688 \u48150 \u50640  \u50630 \u45716  \u50868 \u47749 \u50640  \u52376 \u54644  \u51080 \u50632 \u45796 . \u44592 \u45824 \u54664 \u45912  \u49884 \u44036 \u51008  \u51648 \u45208 \u44052 \u51004 \u45208  \u44536 \u46308 \u51032  \u44396 \u51452 \u44760 \u49436 \u45716  \u45208 \u53440 \u45208 \u51648  \u50506 \u51004 \u49512 \u45796 . \u44536 \u46308 \u51008  \u51208 \u45824 \u51201 \u51064  \u54869 \u49888 \u51012  \u44032 \u51648 \u44256  \u51116 \u47548 \u51012  \u44592 \u45796 \u47160 \u51004 \u48064 \u47196 , \u44536 \u46308 \u51008  \u51068 \u52237 \u51060  \u44396 \u51452 \u51032  \u47924 \u45924 \u50640  \u44032 \u49436  \u44536  \u47924 \u45924 \u51060  \u48708 \u50612  \u51080 \u45716  \u44163 \u51012  \u48372 \u44256  \'93\u49324 \u46988 \u51060  \u45236  \u51452 \u47484  \u44032 \u51256 \u45796 \u44032  \u50612 \u46356  \u46160 \u50632 \u45716 \u51648  \u45236 \u44032  \u50508 \u51648  \u47803 \u54632 \u51060 \u45768 \u51060 \u45796 \'94 (\u50836  20:13) \u44256  \u50872 \u47728  \u48512 \u47476 \u51670 \u45716  \u47560 \u47532 \u50500 \u44032  \u45712 \u44808 \u45912  \u44163 \u44284  \u44057 \u51008  \u49836 \u54548 \u51012  \u44221 \u54744 \u54664 \u45796 .\
\uc0\u44536  \u44592 \u48324 \u51060  \u54841 \u49884  \u51652 \u49892 \u54624 \u45716 \u51648 \u46020  \u47784 \u47480 \u45796 \u45716  \u44277 \u54252 \u44048  (\u24656 \u24598 \u24863 ) \u51008  \u51104 \u49884  \u46041 \u50504  \u48127 \u51648  \u50506 \u45716  \u49464 \u49345  \u49324 \u46988 \u46308 \u50640 \u44172  \u51088 \u51228  (\u33258 \u21046 ) \u54616 \u45716  \u47560 \u51020 \u51012  \u51452 \u50632 \u45796 . \u44536  \u44277 \u54252 \u51032  \u44048 \u51221 \u51008  \u44592 \u45824 \u54664 \u45912  \u49884 \u44036 \u51060  \u51648 \u45212  \u54980 \u50640 \u46020  \u51593 \u49884  \u49324 \u46972 \u51648 \u51648  \u50506 \u50520 \u45796 . \u52376 \u51020 \u50640 \u45716  \u44536 \u46308 \u51060  \u49892 \u47581 \u54620  \u49324 \u46988 \u46308  \u50526 \u50640 \u49436  \u49849 \u47532 \u54620  \u44163 \u52376 \u47100  \u44048 \u55176  \u44592 \u48848 \u54616 \u51648  \u47803 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u54616 \u45208 \u45784 \u51032  \u51652 \u45432 \u51032  \u54364 \u44032  \u45208 \u53440 \u45208 \u51648  \u50506 \u51088  \u44536 \u46308 \u51008  \u51204 \u51068 \u51032  \u45824 \u45812 \u54620  \u47560 \u51020 \u51012  \u54924 \u48373 \u54616 \u50668  \u45796 \u49884  \u48708 \u45212 \u44284  \u51312 \u49548 \u47484  \u49884 \u51089 \u54616 \u50688 \u45796 . \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u49549 \u55176  \u51116 \u47548 \u54616 \u49892  \u44163 \u51012  \u48127 \u45432 \u46972 \u44256  \u44277 \u50616 \u54620  \u47566 \u51008  \u47924 \u47532 \u46308 \u51008  \u44536 \u46308 \u51032  \u49888 \u50521 \u51012  \u48260 \u47160 \u45796 . \u45824 \u45800 \u55176  \u53360  \u54869 \u49888 \u51012  \u44032 \u51648 \u44256  \u51080 \u45912  \u49324 \u46988 \u46308 \u51008  \u44536 \u46308 \u51032  \u51088 \u51316 \u49900 \u50640  \u53360  \u49345 \u52376 \u47484  \u48155 \u44256  \u47560 \u52824  \u49464 \u49345 \u50640 \u49436  \u45236 \u50612  \u51923 \u44596  \u44163 \u52376 \u47100  \u45712 \u44808 \u45796 . \u44536 \u46308 \u51008  \u50836 \u45208 \u52376 \u47100  \u54616 \u45208 \u45784 \u51012  \u50896 \u47581 \u54616 \u50688 \u44256  \u52264 \u46972 \u47532  \u49324 \u45716  \u44163 \u48372 \u45796  \u51453 \u44592 \u47484  \u50896 \u54616 \u50688 \u45796 . \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u50640  \u49888 \u50521 \u51032  \u44592 \u52488 \u47484  \u46160 \u51648  \u50506 \u44256  \u49324 \u46988 \u51032  \u51032 \u44204 \u50640  \u49888 \u50521 \u51032  \u44592 \u52488 \u47484  \u46160 \u50632 \u45912  \u49324 \u46988 \u46308 \u51008  \u51060 \u46412 \u50640  \u51593 \u49884  \u44536 \u46308 \u51032  \u44204 \u54644 \u47484  \u48148 \u44984 \u50632 \u45796 . \u51032 \u51648 \u44032  \u48149 \u50557 \u54616 \u44256  \u44161 \u51060  \u47566 \u51008  \u51088 \u46308 \u51008  \u51312 \u47217 \u54616 \u45716  \u51088 \u46308 \u44284  \u54633 \u49464 \u54616 \u50668  \u45796 \u49884 \u45716  \u46160 \u47140 \u50892 \u54616 \u44144 \u45208  \u51116 \u47548 \u51012  \u44592 \u45824 \u54624  \u54596 \u50836 \u44032  \u50630 \u45796 \u44256  \u51452 \u51109 \u54616 \u50688 \u45796 . \u49884 \u44592 \u45716  \u44221 \u44284 \u54616 \u50688 \u51004 \u45208  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u50724 \u49884 \u51648  \u50506 \u50520 \u51004 \u47728 , \u49464 \u49345 \u51008  \u51648 \u45208 \u44036  \u49688 \u52380 \u45380  \u46041 \u50504 \u44284  \u47560 \u52268 \u44032 \u51648 \u47196  \u48320 \u54632 \u51060  \u50630 \u50632 \u45796 .\
\uc0\u50676 \u49457  \u51080 \u44256  \u51652 \u49892 \u54620  \u49888 \u51088 \u46308 \u51008  \u44536 \u47532 \u49828 \u46020 \u47484  \u50948 \u54616 \u50668  \u47784 \u46304  \u44163 \u51012  \u48260 \u47532 \u44256  \u51204 \u48372 \u45796  \u44536 \u47532 \u49828 \u46020  \u50526 \u50640  \u45908 \u50865  \u44032 \u44620 \u51060  \u45208 \u50500 \u44052 \u45796 . \u44536 \u46308 \u51008  \u44536 \u46308 \u51060  \u54869 \u49888 \u54620  \u44536 \u45824 \u47196  \u49464 \u49345 \u50640  \u52572 \u54980 \u51032  \u44221 \u44256 \u47484  \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u48120 \u44396 \u50640  \u44536 \u46308 \u51060  \u51452 \u45784 \u44284  \u54616 \u45720 \u51032  \u52380 \u49324 \u46308 \u50640 \u44172  \u50689 \u51217 \u46104 \u47532 \u46972 \u44256  \u44592 \u45824 \u54616 \u47732 \u49436  \u44221 \u44256 \u51032  \u44592 \u48324 \u51012  \u48155 \u51648  \u50506 \u51008  \u51088 \u46308 \u44284 \u51032  \u44368 \u51228 \u50640 \u49436  \u44144 \u51032  \u46496 \u45208  \u51080 \u50632 \u45796 . \u44536 \u46308 \u51008  \u44036 \u51208 \u54620  \u47560 \u51020 \u51004 \u47196  \'93\u51452  \u50696 \u49688 \u50668  \u49549 \u55176  \u50724 \u49884 \u50741 \u49548 \u49436 \'94\u46972 \u44256  \u44592 \u46020 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u51452 \u45784 \u44760 \u49436 \u45716  \u50724 \u49884 \u51648  \u50500 \u45768 \u54616 \u49512 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u46308 \u51008  \u45796 \u49884  \u49373 \u50528 \u51032  \u50684 \u47140 \u50752  \u49688 \u44256 \u51032  \u47924 \u44144 \u50868  \u51664 \u51012  \u51656  \u49688 \u48150 \u50640  \u50630 \u50632 \u45796 . \u44536 \u47532 \u44256  \u51312 \u47217 \u54616 \u45716  \u49464 \u49345 \u51032  \u47784 \u50837 \u44284  \u51312 \u49548 \u47484  \u44204 \u46356 \u45716  \u51068 \u51008  \u48127 \u51020 \u44284  \u51064 \u45236 \u44032  \u50836 \u47581 \u46104 \u45716  \u47924 \u49436 \u50868  \u49884 \u47144 \u51060 \u50632 \u45796 .\
