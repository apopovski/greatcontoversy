\f1\b0 \cf0 \
\uc0\u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u51116 \u47548 \u54616 \u49892  \u46412  \u50501 \u54620  \u51088 \u46308 \u51008  \u50728  \u51648 \u47732 \u50640 \u49436  \u49324 \u46972 \u51652 \u45796 . \u44536 \u46308 \u51008  \u51452 \u45784 \u51032  \u51077 \u51032  \u44592 \u50868 \u51004 \u47196  \u51453 \u44256  \u51452 \u45784 \u51032  \u50689 \u44305 \u51032  \u48731 \u51004 \u47196  \u47736 \u47581 \u45817 \u54620 \u45796 . \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u45817 \u49888 \u51032  \u48177 \u49457 \u51012  \u54616 \u45208 \u45784 \u51032  \u46020 \u49457 \u51004 \u47196  \u45936 \u47140 \u44032 \u49884 \u48064 \u47196  \u51060  \u49464 \u49345 \u50640 \u45716  \u44144 \u48124 \u46308 \u51060  \u50630 \u50612 \u51652 \u45796 . \'93\u50668 \u54840 \u50752 \u44760 \u49436  \u46405 \u51012  \u44277 \u54728 \u54616 \u44172  \u54616 \u49884 \u47728  \u54889 \u47924 \u54616 \u44172  \u54616 \u49884 \u47728  \u46244 \u51665 \u50612 \u50638 \u51004 \u49884 \u44256  \u44536  \u44144 \u48124 \u51012  \u55145 \u51004 \u49884 \u47532 \'94\u46972 . \'93\u46405 \u51060  \u50728 \u51204 \u55176  \u44277 \u54728 \u54616 \u44172  \u46104 \u44256  \u50728 \u51204 \u55176  \u54889 \u47924 \u54616 \u44172  \u46104 \u47532 \u46972  \u50668 \u54840 \u50752 \u44760 \u49436  \u51060  \u47568 \u50432 \u51012  \u54616 \u49512 \u45712 \u45768 \u46972 .\'94 \'93\u46405 \u51060  \u46608 \u54620  \u44536  \u44144 \u48124  \u50500 \u47000 \u49436  \u45908 \u47101 \u44172  \u46104 \u50632 \u51004 \u45768  \u51060 \u45716  \u44536 \u46308 \u51060  \u50984 \u48277 \u51012  \u48276 \u54616 \u47728  \u50984 \u47168 \u47484  \u50612 \u44592 \u47728  \u50689 \u50896 \u54620  \u50616 \u50557 \u51012  \u54028 \u54616 \u50688 \u51020 \u51060 \u46972  \u44536 \u47084 \u48064 \u47196  \u51200 \u51452 \u44032  \u46405 \u51012  \u49340 \u53040 \u44256  \u44536  \u51473 \u50640  \u44144 \u54616 \u45716  \u51088 \u46308 \u51060  \u51221 \u51396 \u54632 \u51012  \u45817 \u54616 \u50688 \u44256  \u46405 \u51032  \u44144 \u48124 \u51060  \u48520 \u53440 \'94 (\u49324  24:1, 3, 5, 6) \u47532 \u46972 .\
\uc0\u50728  \u46405 \u51008  \u54889 \u47049 \u54620  \u54889 \u47924 \u51648 \u44057 \u51060  \u46108 \u45796 . \u51648 \u51652 \u51004 \u47196  \u54028 \u44340 \u46108  \u46020 \u49884 \u50752  \u52492 \u46973 \u46308 \u51032  \u54224 \u54728 \u46308 , \u49100 \u47532 \u51704  \u48977 \u55180  \u49688 \u47785 \u46308 , \u48148 \u45796 \u50640 \u49436  \u53888 \u50612 \u45208 \u50724 \u44256  \u46405 \u51060  \u44040 \u46972 \u51648 \u48064 \u47196  \u49567 \u50500 \u50732 \u46972  \u50668 \u44592 \u51200 \u44592  \u55145 \u50612 \u51256  \u51080 \u45716  \u44144 \u52828  \u48148 \u50948 \u46308 \u51060  \u51648 \u44396  \u54364 \u47732 \u50640  \u45328 \u47140  \u51080 \u45796 . \u46608 \u54620  \u52964 \u45796 \u46976  \u46041 \u44404 \u46308 \u51008  \u49328 \u46308 \u51060  \u44536  \u44592 \u52488 \u48512 \u53552  \u44040 \u46972 \u51652  \u51648 \u51216 \u51012  \u47568 \u54644  \u51456 \u45796 .\
\uc0\u51060 \u46412 \u50640  \u51060 \u47336 \u50612 \u51648 \u45716  \u49324 \u44148 \u51008  \u46608 \u54620  \u45824 \u49549 \u51396 \u51068 \u51032  \u47560 \u51648 \u47561  \u50628 \u49689 \u54620  \u48393 \u49324 \u47196  \u50696 \u54364 \u46104 \u50632 \u45796 . \u51648 \u49457 \u49548 \u51032  \u48393 \u49324 \u44032  \u47560 \u52432 \u51648 \u44256 , \u49549 \u51396  \u51228 \u47932 \u51032  \u54588 \u51032  \u44277 \u47196 \u47196  \u51060 \u49828 \u46972 \u50648 \u51032  \u47784 \u46304  \u51396 \u44032  \u49457 \u49548 \u50640 \u49436  \u50734 \u44200 \u51648 \u47732 , \u50500 \u49324 \u49472  \u50684 \u49548 \u44032  \u49328  \u52292 \u47196  \u50668 \u54840 \u50752  \u50526 \u50640  \u45132 \u47140 \u45208 \u50772 \u45796 . \u44536 \u46412  \u45824 \u51228 \u49324 \u51109 \u51008  \u54924 \u51473  \u50526 \u50640 \u49436  \'93\u51060 \u49828 \u46972 \u50648  \u51088 \u49552 \u51032  \u47784 \u46304  \u48520 \u51032 \u50752  \u44536  \u48276 \u54620  \u47784 \u46304  \u51396 \u47484  \u44256 \u54616 \u44256  \u44536  \u51396 \u47484  \u50684 \u49548 \u51032  \u47672 \u47532 \u50640  \u46160 \'94 (\u47112  16:21) \u50632 \u45796 . \u44536 \u50752  \u46609 \u44057 \u51008  \u48169 \u48277 \u51004 \u47196  \u54616 \u45720  \u49457 \u49548 \u51032  \u49549 \u51396  \u49324 \u50629 \u51060  \u50756 \u49457 \u46104 \u47732  \u54616 \u45208 \u45784 \u44284  \u52380 \u49324 \u46308 \u44284  \u44396 \u49549 \u48155 \u51008  \u53360  \u47924 \u47532 \u46308  \u50526 \u50640 \u49436  \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u51032  \u51396 \u45716  \u49324 \u45800 \u50640 \u44172  \u45459 \u51068  \u44163 \u51060 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u46308 \u51008  \u50976 \u54841 \u54616 \u50668  \u48276 \u54616 \u44172  \u54620  \u47784 \u46304  \u51396 \u51032  \u52293 \u51076 \u51012  \u49324 \u45800 \u51060  \u51256 \u50556  \u54624  \u44163 \u51004 \u47196  \u49440 \u44256 \u46112  \u44163 \u51060 \u45796 . \u47560 \u52824  \u50500 \u49324 \u49472  \u50684 \u49548 \u44032  \u49324 \u46988 \u51060  \u49332 \u51648  \u50506 \u45716  \u51648 \u50669 \u51004 \u47196  \u51923 \u44200 \u45228 \u45912  \u44163 \u52376 \u47100  \u49324 \u45800 \u46020  \u50424 \u50424 \u54620  \u51648 \u44396 , \u44263  \u44144 \u48124 \u51060  \u50630 \u44256  \u54889 \u47049 \u54620  \u44305 \u50556 \u47196  \u52628 \u48169 \u45817 \u54624  \u44163 \u51060 \u45796 .\
\uc0\u50836 \u54620 \u44228 \u49884 \u47197 \u51032  \u44592 \u51088  \u50836 \u54620 \u51008  \u49324 \u45800 \u51060  \u52628 \u48169 \u46112  \u44163 \u44284  \u46405 \u51060  \u54889 \u54224 \u54616 \u44256  \u54844 \u46024 \u54620  \u49345 \u53468 \u47196  \u48148 \u45076  \u44163 \u51012  \u50696 \u50616 \u54616 \u44256 , \u44536 \u50752  \u44057 \u51008  \u49345 \u53468 \u44032  \u51068 \u52380  \u45380  \u46041 \u50504  \u51316 \u49549 \u46112  \u44163 \u51012  \u47568 \u54620 \u45796 . \u51452 \u45784 \u51032  \u51116 \u47548 \u51032  \u44305 \u44221 \u44284  \u50501 \u51064 \u51032  \u47736 \u47581 \u50640  \u44288 \u54616 \u50668  \u47568 \u54620  \u54980  \u50696 \u50616 \u51008  \u45796 \u49884  \u44228 \u49549 \u46108 \u45796 . \'93\u46608  \u45236 \u44032  \u48372 \u47588  \u52380 \u49324 \u44032  \u47924 \u51200 \u44081  \u50676 \u49632 \u50752  \u53360  \u49632 \u49324 \u49836 \u51012  \u44536  \u49552 \u50640  \u44032 \u51648 \u44256  \u54616 \u45720 \u47196 \u49436  \u45236 \u47140 \u50752 \u49436  \u50857 \u51012  \u51105 \u51004 \u45768  \u44263  \u50715 \u48192 \u51060 \u50836  \u47560 \u44480 \u50836  \u49324 \u45800 \u51060 \u46972  \u51105 \u50500  \u51068 \u52380  \u45380  \u46041 \u50504  \u44208 \u48149 \u54616 \u50668  \u47924 \u51200 \u44081 \u50640  \u45912 \u51256  \u51104 \u44536 \u44256  \u44536  \u50948 \u50640  \u51064 \u48393 \u54616 \u50668  \u52380  \u45380 \u51060  \u52264 \u46020 \u47197  \u45796 \u49884 \u45716  \u47564 \u44397 \u51012  \u48120 \u54841 \u54616 \u51648  \u47803 \u54616 \u44172  \u54616 \u50688 \u45796 \u44032  \u44536  \u54980 \u50640 \u45716  \u48152 \u46300 \u49884  \u51104 \u44624  \u45459 \u51060 \u47532 \u46972 \'94 (\u44228  20:1~3).\
\'93\uc0\u47924 \u51200 \u44081 \'94\u51060 \u46972 \u45716  \u54364 \u54788 \u51008  \u46405 \u51060  \u54844 \u46024 \u54616 \u44256  \u50516 \u55121 \u54620  \u49345 \u53468 \u47196  \u46104 \u50612  \u51080 \u45716  \u44163 \u51012  \u45208 \u53440 \u45240  \u44163 \u51076 \u51060  \u45796 \u47480  \u49457 \u44221 \u51208 \u46308 \u50640  \u51032 \u54616 \u50668  \u47749 \u48177 \u54644 \u51652 \u45796  (\u52285  1:2; \'93\u44618 \u51020 \'94\u51060 \u46972 \u44256  \u48264 \u50669 \u46108  \u47568 \u51032  \u55176 \u48652 \u47532 \u50612 \u45716  \u44396 \u50557  \u49457 \u44221 \u51012  \u48264 \u50669 \u54620  70\u51064  \u50669 \u50640  \u51032 \u54616 \u47732  \u50836 \u54620 \u44228 \u49884 \u47197  20\u51109  1~3\u51208 \u51032  \'93\u47924 \u51200 \u44081 \'94\u44284  \u46041 \u51068 \u54620  \u47568 \u51076 ). \'93\u53468 \u52488 \'94\u51032  \u46405 \u51032  \u49345 \u53468 \u50640  \u45824 \u54616 \u50668  \u49457 \u44221 \u51008  \'93\u54844 \u46024 \u54616 \u44256  \u55121 \u50516 \u51060  \u44618 \u51020  \u50948 \u50640  \u51080 \'94\u45796 \u44256  \u47568 \u54620 \u45796 . \u50696 \u50616 \u51008  \u46405 \u51060  \u52572 \u49548 \u54620  \u48512 \u48516 \u51201 \u51004 \u47196  \u44536 \u47084 \u54620  \u49345 \u53468 \u47196  \u46028 \u50500 \u44040  \u44163 \u51060 \u46972 \u44256  \u47568 \u54620 \u45796 . \u49440 \u51648 \u51088  \u50696 \u47112 \u48120 \u50556 \u45716  \u51109 \u52264  \u51080 \u51012  \u54616 \u45208 \u45784 \u51032  \u53360  \u45216 \u51012  \u48148 \u46972 \u48372 \u44256  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u54616 \u50688 \u45796 . \'93\u45236 \u44032  \u46405 \u51012  \u48376 \u51593  \u54844 \u46024 \u54616 \u44256  \u44277 \u54728 \u54616 \u47728  \u54616 \u45720 \u46308 \u51012  \u50864 \u47084 \u47480 \u51593  \u44144 \u44592  \u48731 \u51060  \u50630 \u51004 \u47728  \u45236 \u44032  \u49328 \u46308 \u51012  \u48376 \u51593  \u45796  \u51652 \u46041 \u54616 \u47728  \u51089 \u51008  \u49328 \u46308