\uc0\u50724 \u45720 \u45216  \u50864 \u47532 \u45716  \u45824 \u49549 \u51396 \u51068 \u50640  \u49332 \u44256  \u51080 \u45796 . \u54364 \u49345 \u51201  \u51032 \u49885 \u50640 \u49436 , \u45824 \u51228 \u49324 \u51109 \u51060  \u51060 \u49828 \u46972 \u50648  \u48177 \u49457 \u51012  \u50948 \u54616 \u50668  \u49549 \u51396 \u51032  \u48393 \u49324 \u47484  \u54616 \u45716  \u46041 \u50504  \u47784 \u46304  \u49324 \u46988 \u51008  \u45796  \u54616 \u45208 \u45784  \u50526 \u50640  \u51396 \u47484  \u54924 \u44060 \u54616 \u44256  \u44216 \u49552 \u54620  \u53468 \u46020 \u47196 \u50024  \u44536 \u46308 \u51032  \u49900 \u47161 \u51012  \u44340 \u47213 \u44172  \u54644 \u50556  \u54664 \u45796 . \u44536 \u47111 \u44172  \u54616 \u51648  \u50500 \u45768 \u54616 \u45716  \u51088 \u45716  \u48177 \u49457  \u51473 \u50640 \u49436  \u45130 \u50612 \u51656  \u44163 \u51060 \u50632 \u45796 . \u44536 \u50752  \u44057 \u51060  \u51088 \u44592  \u51060 \u47492 \u51060  \u49373 \u47749 \u52293 \u50640 \u49436  \u46020 \u47568 \u46104 \u44592 \u47484  \u50896 \u52824  \u50500 \u45768 \u54616 \u45716  \u47784 \u46304  \u49324 \u46988 \u51008  \u44536 \u46308 \u51032  \u51008 \u54812 \u51032  \u49884 \u44592 \u44032  \u50620 \u47560  \u45224 \u51648  \u50500 \u45768 \u54620  \u50724 \u45720 \u45216  \u51396 \u47484  \u49836 \u54140 \u54616 \u44256  \u51652 \u51221 \u51004 \u47196  \u54924 \u44060 \u54632 \u51004 \u47196  \u54616 \u45208 \u45784  \u50526 \u50640 \u49436  \u44536 \u46308 \u51032  \u49900 \u47161 \u51012  \u44340 \u47213 \u44172  \u54644 \u50556  \u54620 \u45796 . \u44536 \u46308 \u51008  \u49900 \u44033 \u54616 \u44256  \u52384 \u51200 \u54616 \u44172  \u47560 \u51020 \u51012  \u49332 \u54196 \u50556  \u54620 \u45796 . \u44536 \u47532 \u49828 \u46020 \u51064 \u51060 \u46972 \u44256  \u44277 \u50616 \u54616 \u45716  \u45320 \u47924 \u46020  \u47566 \u51008  \u49324 \u46988 \u46308 \u51060  \u44032 \u51648 \u44256  \u51080 \u45716  \u48512 \u54728  (\u28014 \u34395 ) \u54616 \u44256  \u44221 \u48149 \u54620  \u51221 \u49888 \u51008  \u48152 \u46300 \u49884  \u48260 \u47140 \u51256 \u50556  \u54620 \u45796 . \u51648 \u48176 \u44428 \u51012  \u51109 \u50501 \u54616 \u44256 \u51088  \u51068 \u50612 \u45208 \u45716  \u50501 \u54620  \u44221 \u54693 \u46308 \u51012  \u51060 \u44592 \u44256 \u51088  \u54616 \u45716  \u47784 \u46304  \u49324 \u46988  \u50526 \u50640 \u45716  \u48152 \u46300 \u49884  \u44201 \u47148 \u54620  \u53804 \u51137 \u51060  \u51080 \u45796 . \u51456 \u48708 \u54616 \u45716  \u51068 \u51008  \u44060 \u51064 \u51201 \u51004 \u47196  \u54624  \u51068 \u51060 \u45796 . \u50864 \u47532 \u45716  \u45800 \u52404 \u51201 \u51004 \u47196  \u44396 \u50896 \u51012  \u50619 \u51648  \u50506 \u45716 \u45796 . \u49324 \u46988 \u51032  \u49692 \u44208 \u44284  \u54732 \u49888 \u51060  \u45796 \u47480  \u49324 \u46988 \u51032  \u44536 \u47088  \u53945 \u49457 \u51032  \u44208 \u54632 \u51012  \u48372 \u52649 \u54644  \u51460  \u49688  \u50630 \u45796 . \u48708 \u47197  \u50728  \u51064 \u47448 \u44032  \u54616 \u45208 \u45784  \u50526 \u50640 \u49436  \u49900 \u54032 \u51012  \u48155 \u51012 \u51648 \u46972 \u46020  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u44033  \u44060 \u51064 \u51032  \u49324 \u44148 \u51012  \u51312 \u49324 \u54616 \u49884 \u44592 \u47484  \u47560 \u52824  \u49464 \u49345 \u50640  \u44536  \u54620  \u49324 \u46988 \u48150 \u50640 \u45716  \u45796 \u47480  \u49324 \u46988 \u51060  \u50630 \u45716  \u44163 \u52376 \u47100  \u49464 \u48128 \u55176  \u54616 \u49892  \u44163 \u51060 \u45796 . \u47784 \u46304  \u49324 \u46988 \u51060  \u51312 \u49324 \u47484  \u48155 \u46104  \u54000 \u45208  \u51452 \u47492 \u51105 \u55180  \u44163 \u51060 \u45208  \u51060 \u47088  \u44163 \u46308 \u51060  \u50630 \u50612 \u50556  \u54620 \u45796 .\
\uc0\u49549 \u51396 \u51032  \u48393 \u49324 \u44032  \u47560 \u52832  \u47924 \u47157 \u51032  \u44305 \u44221 \u51008  \u49892 \u47196  \u50628 \u49689 \u54616 \u45796 . \u44144 \u44592 \u50640  \u44288 \u47144 \u46108  \u44288 \u49900 \u51008  \u52280 \u51004 \u47196  \u49900 \u44033 \u54616 \u45796 . \u49900 \u54032 \u51008  \u50724 \u45720 \u45216  \u54616 \u45720 \u50640  \u51080 \u45716  \u49457 \u49548 \u50640 \u49436  \u51652 \u54665 \u46104 \u44256  \u51080 \u45796 . \u51060  \u49324 \u50629 \u51008  \u50724 \u47019 \u46041 \u50504  \u44228 \u49549 \u46104 \u50612  \u50772 \u45796 . \u49888 \u49549 \u55176 , \u50620 \u47560 \u45208  \u49888 \u49549 \u55176  \u50724 \u45720 \u45216  \u49332 \u50500  \u51080 \u45716  \u51088 \u46308 \u51032  \u49324 \u44148 \u51060  \u52712 \u44553 \u46112 \u51648  \u50500 \u47924 \u46020  \u47784 \u47480 \u45796 . \u50628 \u49689 \u54616 \u49888  \u54616 \u45208 \u45784  \u50526 \u50640  \u50864 \u47532 \u51032  \u50728  \u49373 \u50528 \u44032  \u46300 \u47084 \u45216  \u44163 \u51060 \u45796 . \u51060  \u49884 \u51216 \u50640 \u49436  \u44033  \u49324 \u46988 \u51060  \u44396 \u51452 \u51032  \u44428 \u44256 \u50640  \u50976 \u51032 \u54616 \u45716  \u44163 \u51060  \u47924 \u50631 \u48372 \u45796  \u50836 \u44596 \u54616 \u45796 . \'93\u51452 \u51032 \u54616 \u46972  \u44648 \u50612  \u51080 \u51004 \u46972  \u44536  \u46412 \u44032  \u50616 \u51228 \u51064 \u51648  \u50508 \u51648  \u47803 \u54632 \u51060 \u45768 \u46972 \'94 (\u47561  13:33). \'93\u47564 \u51068  \u51068 \u44648 \u51648  \u50500 \u45768 \u54616 \u47732  \u45236 \u44032  \u46020 \u51201 \u44057 \u51060  \u51060 \u47476 \u47532 \u45768  \u50612 \u45712  \u49884 \u50640  \u45348 \u44172  \u51076 \u54624 \u45716 \u51648  \u45348 \u44032  \u50508 \u51648  \u47803 \u54616 \u47532 \u46972 \'94 (\u44228  3:3).\
\uc0\u51312 \u49324  \u49900 \u54032 \u51032  \u49324 \u50629 \u51060  \u47560 \u52824 \u44172  \u46104 \u47732  \u47784 \u46304  \u49324 \u46988 \u51032  \u50868 \u47749 \u51008  \u49373 \u49324 \u44036 \u50640  \u44208 \u51221 \u46112  \u44163 \u51060 \u45796 . \u51008 \u54812 \u51032  \u49884 \u44592 \u45716  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u54616 \u45720  \u44396 \u47492 \u51012  \u53440 \u44256  \u51116 \u47548 \u54616 \u49884 \u44592  \u51312 \u44552  \u51204 \u50640  \u47560 \u52432 \u51652 \u45796 . \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u44536 \u46412 \u51032  \u51068 \u51012  \u48120 \u47532  \u45236 \u45796 \u48372 \u49884 \u44256  \u50836 \u54620 \u44228 \u49884 \u47197 \u50640 \u49436  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u50432 \u54616 \u49888 \u45796 . \'93\u48520 \u51032 \u47484  \u54616 \u45716  \u51088 \u45716  \u44536 \u45824 \u47196  \u48520 \u51032 \u47484  \u54616 \u44256  \u45908 \u47084 \u50868  \u51088 \u45716  \u44536 \u45824 \u47196  \u45908 \u47101 \u44256  \u51032 \u47196 \u50868  \u51088 \u45716  \u44536 \u45824 \u47196  \u51032 \u47484  \u54665 \u54616 \u44256  \u44144 \u47337 \u54620  \u51088 \u45716  \u44536 \u45824 \u47196  \u44144 \u47337 \u46104 \u44172  \u54616 \u46972  \u48372 \u46972  \u45236 \u44032  \u49549 \u55176  \u50724 \u47532 \u45768  \u45236 \u44032  \u51460  \u49345 \u51060  \u45236 \u44172  \u51080 \u50612  \u44033  \u49324 \u46988 \u50640 \u44172  \u44536 \u51032  \u51068 \u54620  \u45824 \u47196  \u44058 \u50500  \u51452 \u47532 \u46972 \'94 (\u44228  22:11, 12).\
\uc0\u51032 \u51064 \u44284  \u50501 \u51064 \u51008  \u44536 \u46308 \u51032  \u49373 \u54876  \u49345 \u53468  \u44536 \u45824 \u47196  \u50668 \u51204 \u55176  \u49464 \u49345 \u50640  \u49332 \u47732 \u49436  \u54616 \u45720  \u49457 \u49548 \u50640 \u49436  \u52384 \u54924 \u54624  \u49688  \u50630 \u45716  \u47560 \u51648 \u47561  \u44208 \u51221 \u51060  \u45236 \u47536  \u44163 \u46020  \u47784 \u47476 \u44256  \u48173  \u44040 \u44256  \u51665 \u51667 \u44256  \u47673 \u44256  \u47560 \u49884 \u44256  \u54624  \u44163 \u51060 \u45796 . \u54861 \u49688  \u51204 \u50640  \u45432 \u50500 \u44032  \u48169 \u51452 \u50640  \u46308 \u50612 \u44036  \u54980  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u44536 \u47484  \u48176  \u50504 \u50640  \u46160 \u44256  \u44221 \u44148 \u52824  \u47803 \u54620  \u51088 \u46308 \u51008  \u48176  \u48150 \u50640  \u46160 \u49888  \u52292  \u47928 \u51012  \u45803 \u51004 \u49512 \u45796 . 7\u51068  \u46041 \u50504  \u49324 \u46988 \u46308 \u51008  \u44536 \u46308 \u51032  \u50868 \u47749 \u51060  \u44208 \u51221 \u46108  \u44163 \u51012  \u47784 \u47476 \u44256  \u44221 \u49556 \u54616 \u44256  \u53132 \u46973 \u51012  \u49324 \u46993 \u54616 \u45716  \u49373 \u54876 \u51012  \u44228 \u49549 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u46608 \u54620  \u51076 \u48149 \u54620  \u49900 \u54032 \u50640  \u44288 \u54620  \u44221 \u44256 \u47484  \u51312 \u47217 \u54616 \u50688 \u45796 . \u44396 \u51452 \u44760 \u49436 \u45716  \'93\u51064 \u51088 \u51032  \u51076 \u54632 \u46020  \u51060 \u50752  \u44057 \u51004 \u47532 \u46972 \'94 (\u47560  24:39) \u44256  \u47568 \u50432 \u54616 \u49512 \u45796 . \u44033  \u49324 \u46988 \u51032  \u50868 \u47749 \u51060  \u44208 \u51221 \u46104 \u44256  \u48276 \u51396 \u54620  \u51064 \u47448 \u50640  \u45824 \u54620  \u51008 \u54812 \u51032  \u52488 \u52397 \u51060  \u52384 \u54924 \u46104 \u45716  \u47560 \u51648 \u47561  \u49884 \u44036 \u51008  \u48164 \u51473 \u50640  \u46020