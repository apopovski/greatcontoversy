\'93\uc0\u45348  \u48177 \u49457 \u44284  \u45348  \u44144 \u47337 \u54620  \u49457 \u51012  \u50948 \u54616 \u50668  \u52832 \u49901  \u51060 \u47112 \u47196  \u44592 \u54620 \u51012  \u51221 \u54616 \u50688 \u45208 \u45768 \'85\u44536 \u47084 \u48064 \u47196  \u45320 \u45716  \u44648 \u45804 \u50500  \u50508 \u51648 \u45768 \u46972  \u50696 \u47336 \u49332 \u47128 \u51012  \u51473 \u44148 \u54616 \u46972 \u45716  \u50689 \u51060  \u45216  \u46412 \u48512 \u53552  \u44592 \u47492 \u48512 \u51020 \u51012  \u48155 \u51008  \u51088  \u44263  \u50773 \u51060  \u51068 \u50612 \u45208 \u44592 \u44620 \u51648  \u51068 \u44273  \u51060 \u47112 \u50752  \u50977 \u49901 \u51060  \u51060 \u47112 \u44032  \u51648 \u45216  \u44163 \u51060 \u50836  \u44536  \u46412  \u44260 \u46976 \u54620  \u46041 \u50504 \u50640  \u49457 \u51060  \u51473 \u44148 \u46104 \u50612  \u44144 \u47532 \u50752  \u54644 \u51088 \u44032  \u51060 \u47344  \u44163 \u51060 \u47728  \u50977 \u49901 \u51060  \u51060 \u47112  \u54980 \u50640  \u44592 \u47492  \u48512 \u51020 \u51012  \u48155 \u51008  \u51088 \u44032  \u45130 \u50612 \u51256  \u50630 \u50612 \u51656  \u44163 \u51060 \u47728 \'85\u44536 \u44032  \u51109 \u52264  \u47566 \u51008  \u49324 \u46988 \u51004 \u47196  \u45908 \u48520 \u50612  \u54620  \u51060 \u47112  \u46041 \u50504 \u51032  \u50616 \u50557 \u51012  \u44403 \u44172  \u51221 \u54616 \u44192 \u44256  \u44536 \u44032  \u44536  \u51060 \u47112 \u51032  \u51208 \u48152 \u50640  \u51228 \u49324 \u50752  \u50696 \u47932 \u51012  \u44552 \u51648 \u54624  \u44163 \u51060 \'94 (\u45800  9:24~27) \u45796 .\
\uc0\u51060 \u46412 \u50640  \u52380 \u49324 \u45716  \u45796 \u45768 \u50648 \u51060  8\u51109 \u50640 \u49436  \u51060 \u54644 \u54616 \u51648  \u47803 \u54620  \u51216 , \u44263  \u46412 \u50640  \u44288 \u54620  \u44163 , \'93\u51060 \u52380 \u49340 \u48177  \u51452 \u50556 \u44620 \u51648 \u45768  \u44536  \u46412 \u50640  \u49457 \u49548 \u44032  \u51221 \u44208 \u54616 \u44172  \u54632 \u51012  \u51077 \u51004 \u47532 \u46972 \'94\u44256  \u54620  \u47568 \u50432 \u50640  \u45824 \u54616 \u50668  \u49444 \u47749 \u54616 \u50668  \u51460  \u47785 \u51201 \u51004 \u47196  \u48372 \u45236 \u49900 \u51012  \u48155 \u50520 \u45796 . \u52380 \u49324 \u44032  \u45796 \u45768 \u50648 \u50640 \u44172  \'93\u51060  \u51068 \u51012  \u49373 \u44033 \u54616 \u44256  \u44536  \u51060 \u49345 \u51012  \u44648 \u45804 \u51012 \u51648 \u45768 \u46972 \'94\u44256  \u47749 \u54620  \u54980 \u50640  \u44263  \u51060 \u50612 \u49436  \u54620  \u52395 \u47568 \u51008  \'93\u45348  \u48177 \u49457 \u44284  \u45348  \u44144 \u47337 \u54620  \u49457 \u51012  \u50948 \u54616 \u50668  \u52832 \u49901  \u51060 \u47112 \u47196  \u44592 \u54620 \u51012  \u51221 \u54616 \u50688 \u45796 \'94\u45716  \u44163 \u51060 \u45796 . \u50668 \u44592 \u50640 \u49436  \u50616 \u44553 \u54620  \'93\u44592 \u54620 \u51012  \u51221 \u54616 \u50688 \'94\u45796 \u45716  \u47568 \u51008  \'93\u45130 \u50612  \u45240 \u45796 \'94\u45716  \u47568 \u51060 \u45796 . \u52380 \u49324 \u45716  \u52832 \u49901  \u51452 \u51068  (\u52832 \u49901  \u51060 \u47112 ) \u44263  490\u45380 \u51012  \u53945 \u48324 \u55176  \u50976 \u45824 \u51064 \u51012  \u50948 \u54616 \u50668  \u45130 \u50612 \u45236 \u50612 \u50556  \u54620 \u45796 \u44256  \u47568 \u54620 \u45796 . \u44536 \u47111 \u45796 \u47732  \u44536 \u44163 \u51008  \u50612 \u46356 \u49436  \u45130 \u50612  \u45244  \u44163 \u51064 \u44032 ? 2300\u51068 \u51060  \u45796 \u45768 \u50648  8\u51109 \u50640 \u49436  \u47568 \u54620  \u50976 \u51068 \u51032  \u4459