\f1\b0 \cf0 \
\uc0\u48288 \u47480 \u50640  \u51080 \u45716  \u46020 \u48120 \u45768 \u53356 \u54924  \u49849 \u47140 \u46308 \u51008  \u51060  \u51116 \u44036  \u47566 \u51008  \u51210 \u51008  \u54617 \u49373 \u51012  \u49548 \u50976 \u54624  \u49688 \u47564  \u51080 \u51004 \u47732  \u44536 \u46308 \u50640 \u44172  \u53360  \u47749 \u50696 \u50752  \u51060 \u51061 \u51060  \u51080 \u51012  \u51460 \u47196  \u49373 \u44033 \u54664 \u45796 . \u50500 \u51649  \u45208 \u51060 \u44032  \u50612 \u47540 \u51648 \u46972 \u46020 , \u47568 \u44284  \u47928 \u54596 \u50640  \u51116 \u44036 \u51060  \u53945 \u52636 \u54624  \u49104  \u50500 \u45768 \u46972  \u51020 \u50501 \u51060 \u45208  \u49884 \u50640  \u51080 \u50612 \u49436 \u46020  \u52380 \u51116 \u51201 \u51064  \u49548 \u51656 \u51012  \u44032 \u51648 \u44256  \u51080 \u45716  \u44536 \u45716  \u44536 \u46308 \u51060  \u50808 \u44288 \u49345 \u51004 \u47196  \u45208 \u53440 \u45236 \u45716  \u54868 \u47140 \u54620  \u47784 \u46304  \u49884 \u50948 \u48372 \u45796 \u45716  \u49324 \u46988 \u46308 \u51012  \u44536 \u46308 \u51032  \u50696 \u48176 \u50640  \u51060 \u45132 \u50612  \u46308 \u50668  \u44536 \u46308 \u51032  \u49688 \u51077 \u51012  \u51613 \u44032 \u49884 \u53412 \u45716  \u51068 \u50640  \u45908 \u50865  \u54952 \u44284 \u51201 \u51064  \u51068 \u51012  \u54624  \u44163 \u51060 \u46972 \u44256  \u49373 \u44033 \u54616 \u50688 \u45796 . \u44536 \u47084 \u48064 \u47196  \u44536 \u46308 \u51008  \u44592 \u47564 \u44284  \u50500 \u52392 \u51004 \u47196  \u52768 \u48729 \u44544 \u47532 \u47484  \u44536 \u46308 \u51032  \u49849 \u50896 \u51004 \u47196  \u51060 \u45132 \u50612  \u46308 \u51060 \u44256 \u51088  \u50528 \u47484  \u50044 \u45796 . \u47336 \u53552 \u45716  \u54617 \u49373  \u49884 \u45824 \u50640  \u49688 \u46020 \u50896 \u51032  \u48169 \u50640  \u54028 \u47931 \u54784  \u51080 \u50632 \u45716 \u45936 , \u54616 \u45208 \u45784 \u51032  \u49453 \u47532 \u44032  \u44536 \u47484  \u54644 \u48169 \u49884 \u53020  \u51452 \u51648  \u50506 \u50520 \u45796 \u47732 , \u44536 \u45716  \u49464 \u49345 \u50640 \u49436  \u51075 \u50612 \u48260 \u47536  \u48148  \u46104 \u50632 \u51012  \u44163 \u51060 \u50632 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u52768 \u48729 \u44544 \u47532 \u50640 \u44172  \u44536 \u50752  \u46609 \u44057 \u51008  \u50948 \u54744 \u51012  \u45817 \u54616 \u46020 \u47197  \u54728 \u46973 \u54616 \u51648  \u50500 \u45768 \u54616 \u49512 \u45796 . \u54616 \u45208 \u45784 \u51032  \u49453 \u47532 \u50640  \u51032 \u54616 \u50668  \u44536 \u51032  \u50500 \u48260 \u51648 \u45716  \u44536  \u53441 \u48156 \u49849 \u46308 \u51032  \u44228 \u54925 \u51012  \u47676 \u51200  \u50508 \u44172  \u46104 \u50632 \u45796 . \u44536 \u45716  \u51088 \u44592 \u51032  \u50500 \u46308 \u51060  \u44172 \u51004 \u47476 \u44256  \u47924 \u44032 \u52824 \u54620  \u49849 \u47140 \u51032  \u49373 \u54876 \u51012  \u49332 \u46020 \u47197  \u54728 \u46973 \u54624  \u51032 \u49324 \u44032  \u50630 \u50632 \u45796 . \u44536 \u45716  \u50500 \u46308 \u51032  \u51204 \u46020 \u50976 \u47581 \u54620  \u51109 \u47000 \u44032  \u50948 \u53468 \u47196 \u50868  \u44163 \u51012  \u50508 \u44256 , \u51648 \u52404  \u47568 \u44256  \u51665 \u51004 \u47196  \u46028 \u50500 \u50724 \u46020 \u47197  \u51648 \u49884 \u54616 \u50688 \u45796 .\
\uc0\u44536 \u45716  \u48512 \u52828 \u51032  \u47749 \u47161 \u51012  \u49692 \u51333 \u54616 \u50688 \u51004 \u45208 , \u45208 \u51060  \u50612 \u47536  \u44536 \u50640 \u44172  \u44256 \u54693 \u51032  \u49328 \u44264 \u51008  \u47564 \u51313 \u51012  \u51460  \u49688  \u50630 \u50632 \u45796 . \u50724 \u47000 \u51648  \u50500 \u45768 \u54616 \u50668  \u44536 \u45716  \u54617 \u50629 \u51012  \u44228 \u49549 \u54616 \u44592  \u50948 \u54616 \u50668  \u48148 \u51236  (Basel) \u47196  \u44052 \u45796 . \u52768 \u48729 \u44544 \u47532 \u45716  \u44144 \u44592 \u50640 \u49436  \u48708 \u47196 \u49548  \u44050 \u50630 \u51060  \u50619 \u51012  \u49688  \u51080 \u45716  \u54616 \u45208 \u45784 \u51032  \u51008 \u54812 \u51032  \u48373 \u51020 \u51012  \u48155 \u44172  \u46104 \u50632 \u45796 . \u44256 \u50612 \u54617  (\u21476 \u35486 \u23416 ) \u51032  \u44368 \u49324 \u51060 \u45912  \u48708 \u53596 \u48148 \u54616  (Wittembach) \u45716  \u55176 \u48652 \u47532 \u50612 \u50752  \u54764 \u46972 \u50612 \u47484  \u50672 \u44396 \u54616 \u45912  \u51473  \u49457 \u44221 \u51012  \u44648 \u45803 \u44172  \u46104 \u44256 , \u44536 \u51032  \u47928 \u54616 \u50640 \u49436  \u50672 \u44396 \u50640  \u51333 \u49324 \u54616 \u45716  \u54617 \u49373 \u46308 \u51032  \u49900 \u51473 \u50640 \u44620 \u51648 \u46020  \u54616 \u45720 \u47196 \u48512 \u53552  \u50724 \u45716  \u48731 \u51012  \u48708 \u52628 \u50612  \u51452 \u45716  \u49324 \u46988 \u51060  \u46104 \u50632 \u45796 . \u44536 \u45716  \u54617 \u51088 \u50752  \u52384 \u54617 \u51088 \u44032  \u44032 \u47476 \u52828  \u51060 \u47200 \u48372 \u45796  \u45908 \u50865  \u50724 \u47000 \u46104 \u44256  \u47924 \u54620 \u55176  \u50948 \u45824 \u54620  \u44032 \u52824 \u47484  \u44032 \u51652  \u51652 \u47532 \u44032  \u44144 \u44592 \u50640  \u51080 \u45796 \u45716  \u44163 \u51012  \u47568 \u54616 \u50688 \u45796 . \u44536  \u50724 \u47004  \u51652 \u47532 \u46976  \u44536 \u47532 \u49828 \u46020 \u51032  \u51453 \u51020 \u51060  \u51396 \u51064 \u51032  \u50976 \u51068 \u54620  \u44396 \u49549  (\u25937 \u36118 ) \u51060  \u46108 \u45796 \u45716  \u51652 \u47532 \u50688 \u45796 . \u51060  \u51652 \u47532 \u45716  \u52768 \u48729 \u44544 \u47532 \u50640 \u44172  \u51080 \u50612 \u49436  \u48157 \u50500 \u50724 \u45716  \u49352 \u48317 \u51032  \u52395  \u44305 \u49440 \u44284  \u44057 \u50520 \u45796 .\
\uc0\u50620 \u47560  \u54980 \u50640  \u52768 \u48729 \u44544 \u47532 \u45716  \u48148 \u51236 \u50640 \u49436  \u46496 \u45208  \u54596 \u49373  (\u30050 \u29983 ) \u51032  \u49324 \u50629 \u51012  \u52265 \u49688 \u54616 \u44172  \u46104 \u50632 \u45796 . \u47592  \u52376 \u51020 \u51032  \u51068 \u53552 \u45716  \u44256 \u54693 \u51032  \u49328 \u44264 \u50640 \u49436  \u44284 \u55176  \u47680 \u51648  \u50500 \u45768 \u54620  \u50508 \u54532 \u49828 \u51032  \u44368 \u44396 \u50688 \u45796 . \u44536 \u45716  \u49888 \u48512 \u47196  \u49436 \u54408 \u51012  \u48155 \u44256 , \'93\u44536 \u51032  \u50728  \u47560 \u51020 \u51012  \u45796 \u54616 \u50668  \u49457 \u44221 \u51032  \u51652 \u47532 \u47484  \u53456 \u44396 \u54616 \u45716  \u45936  \u51204 \u45392 \u54616 \u50688 \u45716 \u45936 , \u44536  \u51060 \u50976 \u45716  \u44536 \u44032  \u47585 \u51008  \u44536 \u47532 \u49828 \u46020 \u51032  \u50577 \u47924 \u47532 \u47484  \u52824 \u45716  \u45936 \u45716  \u49457 \u44221 \u51012  \u48157 \u55176  \u51060 \u54644 \u54616 \u45716  \u44163 \u51060  \u54596 \u50836 \u54632 \u51012  \u45712 \u44808 \u44592  \u46412 \u47928 \u51060 \u50632 \u45796 \'94 (Wylie, b.8, ch.1) \u44256  \u46041 \u47308  \u44060 \u54785 \u51088 \u51032  \u54620  \u49324 \u46988 \u51008  \u47568 \u54616 \u50688 \u45796 . \u49457 \u44221 \u51012  \u53456 \u44396 \u54616 \u47732  \u54624 \u49688 \u47197  \u49457 \u44221 \u51008  \u51652 \u47532 \u46972 \u45716  \u44163 \u44284 , \u47196 \u47560 \u44368 \u45716  \u51060 \u45800 \u51060 \u46972 \u45716  \u44163 \u51060  \u45908 \u50865  \u48516 \u47749 \u54616 \u44172  \u45824 \u51312 \u46104 \u50612  \u45208 \u53440 \u45228 \u45796 . \u47560 \u52840 \u45236  \u44536 \u45716  \u49457 \u44221 \u51060  \u52280 \u51004 \u47196  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51060 \u47728  \u45800  \u54616 \u45208 \u51032  \u50756 \u51204 \u54616 \u44256  \u50724 \u47448  \u50630 \u45716  \u54364 \u51456 \u51076 \u51012  \u51064 \u51221 \u54616 \u44172  \u46104 \u50632 \u45796 . \u44536 \u45716  \u46608 \u54620  \u49457 \u44221 \u51008  \u50724 \u51649  \u49457 \u44221 \u51004 \u47196 \u50024 \u47564  \u54644 \u49437 \u54644 \u50556  \u54620 \u45796 \u45716  \u44163 \u51012  \u50508 \u50520 \u45796 . \u44536 \u45716  \u49457 \u44221 \u51012  \u44032 \u51648 \u44256  \u51088 \u44592 \u51032  \u49440 \u51077 \u44204 \u51060  \u46104 \u50612  \u51080 \u45716  \u51060 \u47200 \u51060 \u45208  \u44368 \u47532 \u47484  \u51648 \u51648 \u54616 \u45716  \u49444 \u47749 \u51032  \u46020 \u44396 \u47196  \u49340 \u51648  \u50500 \u45768 \u54616 \u44256  \u49457 \u44221  \u51088 \u52404 \u51032  \u51649 \u51217 \u51201 \u51060 \u44256  \u48516 \u47749 \u54620  \u44368 \u54984 \u51060  \u47924 \u50631 \u51064 \u51648 \u50640  \u45824 \u54616 \u50668  \u48176 \u50872  \u51032 \u47924 \u44032  \u51080 \u45796 \u44256  \u51452 \u51109 \u54616 \u50688 \u45796 . \u44536 \u45716  \u49457 \u44221 \u51032  \u51032 \u48120 \u47484  \u50756 \u51204 \u54616 \u44256  \u51221 \u54869 \u54616 \u44172  \u51060 \u54644 \u54616 \u44592  \u50948 \u54616 \u50668  \u50728 \u44054  \u45432 \u47141 \u51012  \u50500 \u45180 \u51648  \u50500 \u45768 \u54616 \u50688 \u51004 \u47728 , \u46608 \u54620  \u49457 \u47161 \u51032  \u46020 \u50880 \u51012  \u44036 \u44396 \u54616 \u50688 \u45796 . \u44536 \u45716  \u49457 \u47161 \u44760 \u49436  \u51652 \u49892 \u54616 \u44172  \u44036 \u44396 \u54616 \u45716  \u47784 \u46304  \u49324 \u46988 \u50640 \u44172  \u44536  \u52280 \u46907 \u51012  \u46300 \u47084 \u45236  \u51452 \u49888 \u45796 \u44256  \u47568 \u54616 \u50688 \u45796 .\
\pard\pardeftab720\sa319\partightenfactor0

\f0\b \cf0 \uc0\u52768 \u48729 \u44544 \u47532 \u50752  \u47336 \u53552 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u52768 \u48729 \u44544 \u47532 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u54616 \u50688 \u45796 . \'93\u49457 \u44221 \u51008  \u54616 \u45208 \u45784 \u44760 \u47196 \u48512 \u53552  \u50728  \u44163 \u51060 \u47728  \u49324 \u46988 \u50640 \u44172 \u49436  \u50728  \u44163 \u51060  \u50500 \u45768 \u45796 . \u44536 \u47084 \u48064 \u47196  \u54616 \u45208 \u45784 \u44760 \u47196 \u48512 \u53552  \u50728  \u47568 \u50432 \u51012  \u51060 \u54644 \u54624  \u49688  \u51080 \u46020 \u47197  \u54644 \u51452 \u49884 \u45716  \u48516 \u51008  \u54616 \u45208 \u45784 \u51060 \u49884 \u45796 . \'85\u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51008  \u51204 \u54784  \u52265 \u50724 \u44032  \u50630 \u45796 . \u44536 \u44163 \u51008  \u51652 \u49892 \u47196  \u44305 \u47749 \u54620  \u44163 \u51060 \u47728 , \u44368 \u54984  \u51088 \u52404 \u51060 \u47728 , \u44228 \u49884  \u51088 \u52404 \u51060 \u45796 . \u44536 \u44163 \u51008  \u44396 \u50896 \u44284  \u51008 \u54812 \u47196 \u50024  \u49324 \u46988 \u51032  \u47560 \u51020 \u51012  \u48708 \u52628 \u50612 \u51452 \u47728 , \u54616 \u45208 \u45784  \u50504 \u50640 \u49436  \u49828 \u49828 \u47196  \u50948 \u47196 \u54616 \u44256 , \u49828 \u49828 \u47196  \u44216 \u49552 \u54616 \u44172  \u54616 \u47728 , \u47560 \u52840 \u45236  \u50728 \u51204 \u55176  \u51088 \u44592 \u47484  \u51082 \u44256  \u54616 \u45208 \u45784 \u51012  \u51032 \u51648 \u54616 \u44172  \u54644 \u51452 \u45716  \u44163 \u51060 \u45796 .\'94 \u51060  \u47568 \u51032  \u52280 \u46907 \u51012  \u52768 \u48729 \u44544 \u47532  \u51088 \u49888 \u51008  \u49892 \u51228 \u47196  \u52404 \u54744 \u54616 \u50688 \u45796 . \u44536 \u45716  \u44536  \u45817 \u49884 \u51032  \u52404 \u54744 \u51012  \u54980 \u51068 \u50640  \u51060 \u47111 \u44172  \u44592 \u47197 \u54616 \u50688 \u45796 . \'93\u45236 \u44032  \u50728 \u51204 \u55176  \u45236  \u51088 \u49888 \u51012  \u49457 \u44221  \u47568 \u50432 \u50640  \u48148 \u52824 \u44256 \u51088  \u54664 \u51012  \u46412  \u52384 \u54617 \u44284  \u49888 \u54617  (\u49828 \u53084 \u46972  \u52384 \u54617 \u51201 \u51064 ) \u50640 \u49436  \u50724 \u45716  \u50672 \u49345  (\u63895 \u24819 ) \u51060  \u45208 \u50640 \u44172  \u44040 \u46321 \u51012  \u51068 \u51004 \u53020  \u51452 \u50632 \u45796 . \u44536 \u47532 \u54616 \u50668  \u45208 \u45716  \u47560 \u52840 \u45236  \u45796 \u51020 \u44284  \u44057 \u51008  \u44208 \u47200 \u50640  \u46020 \u45804 \u54616 \u50688 \u45796 . \'91\u45320 \u45716  \u51060 \u47084 \u54620  \u47784 \u46304  \u44144 \u51667  \u44163 \u46308 \u51012  \u45236 \u50612 \u48260 \u47532 \u44256 , \u54616 \u45208 \u45784 \u51032  \u45800 \u49692 \u54620  \u47568 \u50432 \u50640  \u45208 \u53440 \u45212  \u52280 \u46907 \u51012  \u48176 \u50892 \u50556  \u54620 \u45796 .\'92 \u44536  \u54980 \u50640  \u45208 \u45716  \u54616 \u45208 \u45784 \u51012  \u54693 \u54616 \u50668  \u44536 \u48516 \u51032  \u48731 \u51012  \u44396 \u54616 \u44172  \u46104 \u50632 \u45716 \u45936  \u44536  \u46412 \u48512 \u53552  \u45208 \u45716  \u45908 \u50865  \u49789 \u44172  \u49457 \u44221 \u51012  \u51060 \u54644 \u54616 \u44172  \u46104 \u50632 \u45796 \'94 (Wylie, b.8, ch.6).\
\uc0\u52768 \u48729 \u44544 \u47532 \u44032  \u51204 \u54620  \u44368 \u47532 \u45716  \u47336 \u53552 \u50640 \u44172 \u49436  \u48176 \u50868  \u44163 \u51060  \u50500 \u45768 \u50632 \u45796 . \u44536 \u44163 \u51008  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u52828 \u55176  \u44032 \u47476 \u52432  \u51452 \u49888  \u44163 \u51060 \u50632 \u45796 . \u44536  \u49828 \u50948 \u49828 \u51032  \u44060 \u54785 \u51088 \u45716  \u51060 \u47111 \u44172  \u47568 \u54616 \u50688 \u45796 . \'93\u47336 \u53552 \u44032  \u44536 \u47532 \u49828 \u46020 \u47484  \u51204 \u54028 \u54620 \u45796 \u47732 , \u44536 \u45716  \u45208 \u50752  \u44057 \u51008  \u51068 \u51012  \u54616 \u44256  \u51080 \u45716  \u44163 \u51060 \u45796 . \u47336 \u53552 \u44032  \u44536 \u47532 \u49828 \u46020 \u50640 \u44172  \u51064 \u46020 \u54620  \u49324 \u46988 \u46308 \u51008  \u45236 \u44032  \u51064 \u46020 \u54620  \u49324 \u46988 \u48372 \u45796  \u44536  \u49688 \u54952 \u44032  \u47566 \u51012  \u44163 \u51060 \u45796 . \u44536 \u47084 \u45208  \u44536 \u44163 \u51008  \u50500 \u47924  \u47928 \u51228 \u44032  \u46104 \u51648  \u50506 \u45716 \u45796 . \u45208 \u45716  \u44536 \u47532 \u49828 \u46020 \u51032  \u51060 \u47492  \u51060 \u50808 \u50640  \u50612 \u46496 \u54620  \u51060 \u47492 \u46020  \u51613 \u44144 \u54616 \u51648  \u50506 \u45716 \u45796 . \u45208 \u45716  \u45796 \u47564  \u44536 \u48516 \u51032  \u44400 \u49324 \u51060 \u47728  \u50724 \u51649  \u44536 \u48516 \u47564 \u51060  \u45208 \u51032  \u45824 \u51109 \u51060 \u49884 \u45796 . \u45208 \u45716  \u45800  \u54620  \u44396 \u51208 \u46020  \u47336 \u53552 \u50640 \u44172  \u50024  \u48372 \u45240  \u51068 \u51060  \u50630 \u50632 \u44256 , \u47336 \u53552  \u50669 \u49884  \u45208 \u50640 \u44172  \u44536 \u47084 \u54616 \u50688 \u45796 . \u44536 \u47111 \u45796 \u47732  \u50620 \u47560 \u45208  \u49888 \u44592 \u54620  \u51068 \u51064 \u44032 ?\'85\u50864 \u47532  \u46160  \u49324 \u46988 \u51060  \u54620  \u48264 \u46020  \u44057 \u51060  \u51032 \u45436 \u54620  \u51068 \u51060  \u50630 \u50632 \u51020 \u50640 \u46020  \u48520 \u44396 \u54616 \u44256 , \u44536 \u47532 \u49828 \u46020 \u51032  \u44368 \u47532 \u47484  \u44536 \u52376 \u47100  \u51068 \u47456 \u51201 \u51004 \u47196  \u47568 \u54616 \u44172  \u46108  \u44163 \u51008  \u49888 \u44592 \u54620  \u51068 \u51060  \u50500 \u45772 \u44032 ? \u51060  \u49324 \u49892  \u51088 \u52404 \u45716  \u49457 \u47161 \u51032  \u51312 \u54868 \u44032  \u50612 \u46496 \u54616 \u45796 \u45716  \u44163 \u51012  \u48372 \u50668  \u51452 \u44256  \u51080 \u45796 \'94 (D\'92Aubigne, b.8, ch.9).\
\pard\pardeftab720\sa319\partightenfactor0

\f0\b \cf0 \uc0\u49692 \u48373 \u51020 \u51032  \u52380 \u47749  (\u38369 \u26126 )\
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u52768 \u48729 \u44544 \u47532 \u45716  1516\u45380 \u50640  \u50500 \u51064 \u51648 \u45944 \u47480  (Einsideln) \u49688 \u46020 \u50896 \u51032  \u49444 \u44368 \u51088 \u47196  \u52488 \u52397 \u51012  \u48155 \u50520 \u45796 . \u44536 \u45716  \u44536  \u44275 \u50640 \u49436  \u47196 \u47560 \u51032  \u48512 \u54056 \u47484  \u45908 \u50865  \u51096  \u48380  \u49688  \u51080 \u50632 \u44256 , \u44060 \u54785 \u51088 \u47196 \u49436 \u51032  \u44048 \u54868 \u47484  \u44256 \u54693  \u50508 \u54532 \u49828  \u51648 \u50669 \u51012  \u45336 \u50612  \u47680 \u47532 \u44620 \u51648  \u48156 \u55064 \u54616 \u44172  \u46104 \u50632 \u45796 . \u50500 \u51064 \u51648 \u45944 \u47480 \u51032  \u47749 \u47932 \u51008  \u46041 \u51221 \u45376  \u47560 \u47532 \u50500 \u51032  \u49345  (\u20687 ) \u51060 \u50632 \u45716 \u45936 , \u44536 \u44163 \u51008  \u44592 \u51201 \u51012  \u54665 \u54616 \u45716  \u45733 \u47141 \u51060  \u51080 \u45796 \u45716  \u49548 \u47928 \u44620 \u51648  \u45208  \u51080 \u50632 \u45796 . \u49688 \u46020 \u50896  \u51077 \u44396 \u50640 \u45716  \'93\u51060  \u44275 \u50640 \u49436  \u50756 \u51204 \u54620  \u49549 \u51396 \u47484  \u50619 \u51012  \u49688  \u51080 \u45796 \'94 (D\'92Aubigne, b.8, ch.5) \u45716  \u44544 \u51060  \u49352 \u44200 \u51256  \u51080 \u50632 \u45796 . \u44536 \u47532 \u44256  \u51060  \u47560 \u47532 \u50500  \u49345 \u51060  \u50504 \u52824 \u46104 \u50612  \u51080 \u45716  \u51204 \u44033 \u50640 \u45716  \u50616 \u51228 \u45208  \u49692 \u47168 \u51088 \u44032  \u44536 \u52824 \u51648  \u50500 \u45768 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u50672 \u51473 \u51032  \u45824 \u51208 \u44592 \u51032  \u44592 \u44036 \u51060  \u46104 \u47732  \u49828 \u50948 \u49828 \u51032  \u44397 \u45236 \u50640 \u45716  \u47568 \u54624  \u44163 \u46020  \u50630 \u44256  \u47680 \u47532  \u54532 \u46993 \u49828 \u50752  \u46021 \u51068 \u50640 \u49436 \u44620 \u51648  \u47566 \u51008  \u44400 \u51473 \u51060  \u47784 \u50668  \u50772 \u45796 . \u52768 \u48729 \u44544 \u47532 \u45716  \u51060 \u47084 \u54620  \u44305 \u44221 \u51012  \u48372 \u44256  \u47588 \u50864  \u44256 \u53685 \u49828 \u47101 \u44172  \u45712 \u44808 \u51004 \u45208 , \u44536 \u45716  \u44536  \u44592 \u54924 \u47484  \u51060 \u50857 \u54616 \u50668  \u48120 \u49888 \u51032  \u45432 \u50696 \u44032  \u46108  \u49324 \u46988 \u46308 \u50640 \u44172  \u48373 \u51020 \u51004 \u47196  \u47568 \u48120 \u50516 \u51008  \u51088 \u50976 \u47484  \u51204 \u54028 \u54616 \u44172  \u46104 \u50632 \u45796 .\
\uc0\u44536 \u45716  \u47568 \u54616 \u50688 \u45796 . \'93\u45796 \u47480  \u50500 \u47924  \u44275 \u48372 \u45796 \u46020  \u51060  \u49457 \u51204 \u50640  \u53945 \u48324 \u55176  \u54616 \u45208 \u45784 \u51060  \u44228 \u49884 \u45796 \u44256  \u49373 \u44033 \u54644 \u49436 \u45716  \u50504  \u46108 \u45796 . \u44536 \u45824 \u46308 \u51060  \u44144 \u51452 \u54616 \u45716  \u45208 \u46972 \u44032  \u50612 \u46356 \u46304 \u51648  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u44536 \u45824 \u46308 \u51032  \u51452 \u50948 \u50640  \u44228 \u49884 \u47728 , \u44536 \u45824 \u46308 \u51032  \u49548 \u50896 \u50640  \u44480 \u47484  \u44592 \u50872 \u50668  \u51452 \u49888 \u45796 . \'85\u44536 \u45824 \u46308 \u51008  \u44256 \u54665  (\u33510 \u34892 ), \u47676  \u44600 \u51032  \u49692 \u47168 , \u54732 \u47932 , \u49457 \u49345  (\u32854 \u20687 ), \u46041 \u51221 \u45376  \u47560 \u47532 \u50500 \u50752  \u49457 \u46020 \u46308 \u51032  \u44592 \u46020  \u46321 \u51012  \u53685 \u54616 \u50668  \u54616 \u45208 \u45784 \u51032  \u51008 \u54812 \u47484  \u48155 \u51012  \u49688  \u51080 \u45796 \u44256  \u49373 \u44033 \u54616 \u45716 \u44032 ? \u44536 \u47532 \u44256  \u50864 \u47532 \u51032  \u44596  \u44592 \u46020 \u50640  \u50612 \u46500  \u44277 \u47196 \u44032  \u51080 \u45796 \u44256  \u49373 \u44033 \u54616 \u45716 \u44032 ? \u48264 \u51789 \u48264 \u51789 \u54616 \u45716  \u46160 \u44148  (\u38957 \u24062 ), \u48152 \u48152 \u54616 \u44172  \u48124  \u47672 \u47532 , \u52824 \u47105 \u52824 \u47105  \u45132 \u47532 \u45716  \u50743 , \u44552 \u48149 \u51004 \u47196  \u50500 \u47196 \u49352 \u44596  \u45927 \u49888 , \u44536  \u47784 \u46304  \u44163 \u46308 \u51060  \u47924 \u49832  \u50976 \u51061 \u51060  \u51080 \u51004 \u47532 \u46972 \u44256  \u49373 \u44033 \u54616 \u45716 \u44032 ?\'85\u54616 \u45208 \u45784 \u51008  \u47560 \u51020 \u51012  \u48372 \u49888 \u45796 . \u44536 \u47088 \u45936  \u50864 \u47532 \u51032  \u47560 \u51020 \u51008  \u44536 \u48516 \u50640 \u44172 \u49436  \u47680 \u47532  \u46496 \u45208  \u51080 \u45796 . \u49901 \u51088 \u44032 \u50640  \u45804 \u47532 \u49888  \u44536 \u47532 \u49828 \u46020 \u45716  \u47784 \u46304  \u48127 \u45716  \u51088 \u46308 \u51032  \u51396 \u47484  \u50689 \u50896 \u55176  \u48372 \u49345 \u54616 \u49888  \u55148 \u49373  \u51228 \u47932 \u51060  \u46104 \u49888 \u45796 \'94 (D\'92Au-bigne, b.8, ch.5).\
\uc0\u47566 \u51008  \u49324 \u46988 \u46308 \u50640 \u44172  \u51060 \u47084 \u54620  \u49444 \u44368 \u45716  \u54872 \u50689 \u51012  \u48155 \u51648  \u47803 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u44536 \u46308 \u51032  \u44340 \u47196 \u50868  \u50668 \u54665 \u51060  \u50500 \u47924 \u47088  \u54952 \u47141 \u51060  \u50630 \u45796 \u45716  \u47568 \u51012  \u46307 \u44256  \u53356 \u44172  \u49892 \u47581 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u44536 \u47532 \u49828 \u46020 \u47196  \u47568 \u48120 \u50516 \u50500  \u44536 \u46308 \u50640 \u44172  \u44050 \u50630 \u51060  \u51228 \u44277 \u46108  \u51396 \u51032  \u49324 \u50976 \u47484  \u51060 \u54644 \u54624  \u49688  \u50630 \u50632 \u45796 . \u44536 \u46308 \u51008  \u47196 \u47560 \u44368 \u44032  \u51648 \u49884 \u54644 \u51456  \u44536 \u45824 \u47196  \u52380 \u44397 \u50640  \u44032 \u45716  \u50715 \u44600 \u51012  \u46384 \u46972 \u44032 \u45716  \u51068 \u51012  \u47564 \u51313 \u54616 \u44172  \u50668 \u44592 \u50632 \u45796 . \u44536 \u46308 \u51008  \u44536 \u48372 \u45796  \u45908  \u51339 \u51008  \u44600 \u51012  \u52286 \u45716  \u44163 \u51012  \u48264 \u44144 \u47213 \u44172  \u50668 \u44592 \u44256  \u49899 \u50612 \u54616 \u50688 \u45796 . \u47560 \u51020 \u51032  \u51221 \u44208 \u51012  \u44396 \u54616 \u45716  \u44163 \u48372 \u45796  \u48277 \u50773 \u44284  \u49888 \u48512 \u50640 \u44172  \u44536 \u46308 \u51032  \u44396 \u50896 \u51012  \u51032 \u53441 \u54616 \u45716  \u44163 \u51060  \u45908 \u50865  \u49772 \u50912 \u45796 .\
\uc0\u44536 \u47084 \u45208  \u45796 \u47480  \u54620  \u48512 \u47448 \u51032  \u49324 \u46988 \u46308 \u51008  \u44536 \u47532 \u49828 \u46020 \u47484  \u53685 \u54616 \u50668  \u44396 \u49549 \u51012  \u50619 \u45716 \u45796 \u45716  \u49548 \u49885 \u51012  \u44592 \u49256 \u51004 \u47196  \u48155 \u50500 \u46308 \u50688 \u45796 . \u47196 \u47560 \u44368 \u51032  \u51032 \u49885 \u46308 \u51012  \u51648 \u53428 \u51004 \u47196  \u47560 \u51020 \u51032  \u54217 \u50504 \u51012  \u50619 \u51648  \u47803 \u54616 \u50688 \u51004 \u48064 \u47196  \u44536 \u46308 \u51008  \u48127 \u51020 \u51004 \u47196  \u44396 \u51452 \u51032  \u54588 \u47484  \u44536 \u46308 \u51032  \u51396 \u47484  \u49324 \u50976 \u54616 \u44592  \u50948 \u54616 \u50668  \u55128 \u47532 \u49888  \u44163 \u51004 \u47196  \u48155 \u50500 \u46308 \u50688 \u45796 . \u44536  \u49324 \u46988 \u46308 \u51008  \u44256 \u54693 \u51004 \u47196  \u46028 \u50500 \u44032 \u49436  \u44536 \u46308 \u51060  \u48155 \u51008  \u44480 \u51473 \u54620  \u48731 \u51012  \u45796 \u47480  \u49324 \u46988 \u46308 \u50640 \u44172  \u45208 \u53440 \u45236 \u50632 \u45796 . \u44536 \u47532 \u54616 \u50668  \u51652 \u47532 \u45716  \u51060  \u47560 \u51012 \u50640 \u49436  \u51200  \u47560 \u51012 \u47196 , \u51060  \u44256 \u51012 \u50640 \u49436  \u51200  \u44256 \u51012 \u47196  \u54140 \u51276 \u51004 \u47728 , \u44536  \u44208 \u44284  \u47560 \u47532 \u50500 \u51032  \u51204 \u45817  (\u27583 \u22530 ) \u51012  \u52286 \u50500 \u44032 \u45716  \u49692 \u47168 \u51088 \u46308 \u51032  \u49688 \u45716  \u54788 \u51200 \u54616 \u44172  \u44048 \u49548 \u46104 \u50632 \u45796 . \u46384 \u46972 \u49436  \u50696 \u47932 \u51032  \u50529 \u49688 \u46020  \u44048 \u49548 \u46104 \u50632 \u51004 \u47728  \u44144 \u44592 \u49436  \u51648 \u52636 \u46104 \u45716  \u52768 \u48729 \u44544 \u47532 \u51032  \u48393 \u44553 \u46020  \u44048 \u49548 \u46104 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44305 \u49888  (\u29378 \u20449 ) \u44284  \u48120 \u49888 \u51032  \u49464 \u47141 \u51060  \u44648 \u50612 \u51648 \u45716  \u44163 \u51012  \u48380  \u46412 , \u44536 \u44163 \u51008  \u44536 \u50640 \u44172  \u44592 \u49256 \u51012  \u44032 \u51256 \u45796  \u51460  \u49104 \u51060 \u50632 \u45796 .\
\pard\pardeftab720\sa319\partightenfactor0

\f0\b \cf0 \uc0\u44368 \u44428 \u51032  \u50517 \u48149 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u44368 \u54924 \u51032  \u45817 \u44397 \u51088 \u46308 \u51008  \u52768 \u48729 \u44544 \u47532 \u44032  \u54616 \u44256  \u51080 \u45716  \u51068 \u51012  \u51204 \u54784  \u47784 \u47476 \u45716  \u44163 \u51008  \u50500 \u45768 \u50632 \u45796 . \u44536 \u47084 \u45208  \u50620 \u47560  \u46041 \u50504 \u51008  \u44036 \u49453 \u54616 \u44592 \u47484  \u54588 \u54664 \u45796 . \u44536 \u46308 \u51008  \u44536 \u47484  \u44536 \u46308 \u51032  \u54200 \u50640  \u47672 \u47932 \u47084  \u46160 \u44592 \u47484  \u50896 \u54616 \u44592  \u46412 \u47928 \u50640  \u50668 \u47084  \u44032 \u51648  \u50500 \u52392 \u54616 \u45716  \u47568 \u47196 \u50024  \u44536 \u51032  \u47560 \u51020 \u51012  \u49324 \u44256 \u51088  \u45432 \u47141 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45716  \u46041 \u50504 \u50640  \u51652 \u47532 \u45716  \u45908 \u50865 \u45908  \u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u51012  \u49324 \u47196 \u51105 \u44256  \u51080 \u50632 \u45796 .\
\uc0\u50500 \u51064 \u51648 \u45944 \u47480 \u50640 \u49436 \u51032  \u52768 \u48729 \u44544 \u47532 \u51032  \u54876 \u46041 \u51008  \u45331 \u51008  \u48516 \u50556 \u51032  \u49324 \u50629 \u51012  \u50948 \u54616 \u50668  \u44536 \u47484  \u51456 \u48708 \u49884 \u53020  \u51452 \u50632 \u45796 . \u50724 \u47000 \u51648  \u50506 \u50500 \u49436  \u44536 \u45716  \u44536  \u51068 \u50640  \u52265 \u49688 \u54624  \u44163 \u51060 \u50632 \u45796 . 3\u45380  \u54980 \u50640  \u44536 \u45716  \u52712 \u47532 \u55176  (Zurich) \u45824 \u49457 \u45817 \u51032  \u49444 \u44368 \u51088 \u47196  \u51076 \u47749 \u46104 \u50632 \u45796 . \u52712 \u47532 \u55176 \u45716  \u44536  \u45817 \u49884  \u49828 \u50948 \u49828  \u50672 \u48169  (\u63895 \u37030 ) \u50640 \u49436  \u44032 \u51109  \u51473 \u50836 \u54620  \u46020 \u49884 \u50688 \u51004 \u48064 \u47196  \u50668 \u44592 \u50640 \u49436  \u45208 \u53440 \u45236 \u45716  \u50689 \u54693 \u47141 \u51008  \u47680 \u47532 \u44620 \u51648  \u48120 \u52832  \u49688  \u51080 \u50632 \u45796 . \u44536 \u47088 \u45936  \u44536 \u47484  \u52712 \u47532 \u55176 \u47196  \u52488 \u45824 \u54620  \u44368 \u51649  (\u25934 \u32887 ) \u46308 \u51008  \u54785 \u49888 \u51201 \u51064  \u44368 \u47532 \u44032  \u46308 \u50612 \u50724 \u45716  \u44163 \u51012  \u51339 \u50500 \u54616 \u51648  \u50506 \u50520 \u51004 \u48064 \u47196  \u52768 \u48729 \u44544 \u47532 \u51032  \u51032 \u47924 \u50640  \u45824 \u54616 \u50668  \u45796 \u51020 \u44284  \u44057 \u51008  \u51648 \u49884 \u47484  \u54616 \u50688 \u45796 .\
\'93\uc0\u44536 \u45824 \u45716  \u44032 \u51109  \u51201 \u51008  \u50529 \u49688 \u51032  \u50672 \u44552 \u51060 \u46972 \u46020  \u51060 \u47484  \u46321 \u54620 \u55176  \u50668 \u44592 \u51648  \u47568 \u44256  \u44368 \u54924 \u51032  \u49688 \u51077 \u51004 \u47196  \u49340 \u45716  \u51068 \u50640  \u47784 \u46304  \u45432 \u47141 \u51012  \u45796 \u54624  \u44163 \u51060 \u45796 . \u44536 \u45824 \u45716  \u44053 \u45800 \u50640 \u49436 \u45208  \u52280 \u54924 \u49548 \u50640 \u49436 \u45208  \u49888 \u46020 \u46308 \u50640 \u44172  \u44536 \u46308 \u51032  \u49901 \u51068 \u51312 \u50752  \u44536 \u48150 \u51032  \u54924 \u48708 \u47484  \u46300 \u47532 \u46020 \u47197  \u51109 \u47140 \u54632 \u51004 \u47196  \u50672 \u44552 \u51004 \u47196 \u50024  \u44536 \u46308 \u51060  \u44368 \u54924 \u47484  \u49324 \u46993 \u54616 \u45716  \u44163 \u51012  \u45208 \u53440 \u45236 \u46020 \u47197  \u54616 \u46972 . \u44536 \u45824 \u45716  \u48337 \u51088 \u46308 \u51060  \u46300 \u47532 \u45716  \u50672 \u44552 \u51060 \u45208  \u48120 \u49324 \u50752  \u50668 \u47084  \u44032 \u51648  \u51032 \u49885 \u51012  \u54665 \u54624  \u46412 \u50640  \u46300 \u47532 \u45716  \u47784 \u46304  \u50672 \u44552 \u51004 \u47196 \u50024  \u49688 \u51077 \u51012  \u51613 \u44032 \u49884 \u53412 \u45716  \u51068 \u50640  \u50676 \u49900 \u51012  \u45796 \u54616 \u46972 . \u51032 \u49885 \u51012  \u54665 \u54616 \u45716  \u44163 \u44284  \u49444 \u44368 \u47484  \u54616 \u45716  \u44163 , \u44368 \u51064 \u46308 \u51012  \u46028 \u48372 \u45716  \u44163  \u46321 \u51008  \u47785 \u49324 \u51032  \u51649 \u47924 \u51060 \u45796 . \u44536 \u47084 \u45208  \u44536 \u47088  \u51068 \u46308 \u51008  \u44536  \u51068 \u51012  \u51204 \u45812 \u54620  \u47785 \u49324 \u51032  \u51032 \u47924 \u51060 \u44592 \u46020  \u54616 \u45796 . \u44536 \u47084 \u48064 \u47196  \u44536 \u47088  \u51068 \u46308 \u51008  \u44536 \u50640 \u44172  \u47585 \u44592 \u46104 , \u53945 \u55176  \u49444 \u44368  \u44057 \u51008  \u44163 \u51008  \u45824 \u47532 \u51088 \u50640 \u44172  \u50948 \u53441 \u54616 \u45716  \u44163 \u51060  \u51339 \u45796 . \u44536 \u45824 \u45716  \u45796 \u47564  \u51648 \u50948 \u50752  \u47749 \u47581 \u51060  \u51080 \u45716  \u51088 \u46308 \u50640 \u44172 \u47564  \u51032 \u49885 \u51012  \u51665 \u54665 \u54616 \u46104 , \u51032 \u47280 \u54624  \u46412 \u50640 \u47564  \u51060 \u47484  \u54665 \u54616 \u44256  \u50500 \u47924 \u50640 \u44172 \u45208  \u52264 \u48324  \u50630 \u51060  \u54644 \u49436 \u45716  \u50504  \u46108 \u45796 \'94 (D\'92Aubigne, b.8, ch.6).\
\uc0\u52768 \u48729 \u44544 \u47532 \u45716  \u51104 \u51104 \u55176  \u51088 \u44592 \u51032  \u52293 \u47924 \u50640  \u45824 \u54616 \u50668  \u46308 \u51008  \u54980 \u50640 , \u47676 \u51200  \u51060 \u47084 \u54620  \u51473 \u50836 \u54620  \u50948 \u52824 \u50640  \u48512 \u47492 \u51012  \u48155 \u44172  \u46108  \u44163 \u51012  \u50689 \u44305 \u49828 \u47101 \u44172  \u49373 \u44033 \u54620 \u45796 \u45716  \u46907 \u51004 \u47196  \u44048 \u49324 \u51032  \u47568 \u51012  \u54616 \u44256 , \u45796 \u51020 \u50640  \u44536 \u44032  \u52712 \u54624  \u48169 \u52840 \u50640  \u45824 \u54616 \u50668  \u47568 \u54616 \u50688 \u45796 . \'93\u44536 \u47532 \u49828 \u46020 \u51032  \u49373 \u50528 \u45716  \u47588 \u50864  \u50724 \u47019 \u46041 \u50504  \u49324 \u46988 \u46308 \u50640 \u44172 \u49436  \u44048 \u52628 \u50612 \u51276 \u45796 . \u44536 \u47084 \u48064 \u47196  \u45208 \u45716  \u47560 \u53468 \u48373 \u51020 \u51012  \u51204 \u48512  \u49444 \u44368 \u51032  \u51116 \u47308 \u47196  \u49340 \u46104 \'85\u44144 \u47337 \u54620  \u47568 \u50432 \u51032  \u49368 \u50640 \u49436  \u50728 \u51204 \u55176  \u51060 \u47484  \u44600 \u50612 \u45236 \u44256 , \u44536  \u44618 \u51060 \u47484  \u52769 \u51221 \u54616 \u47732 \u49436  \u51208 \u46308 \u51012  \u49436 \u47196  \u48708 \u44368 \u54616 \u50668  \u51060 \u54644 \u54616 \u44592  \u50948 \u54616 \u50668  \u54637 \u49345  \u50676 \u49900 \u51004 \u47196  \u44592 \u46020 \u54624  \u49373 \u44033 \u51060 \u45796 . \u54616 \u45208 \u45784 \u44760  \u50689 \u44305 \u51012  \u46028 \u47532 \u44256 , \u44536 \u48516 \u51032  \u46021 \u49373 \u51088 \u47484  \u52268 \u50577 \u54616 \u44256 , \u50689 \u54844 \u46308 \u51032  \u52280 \u46108  \u44396 \u50896 \u51012  \u50948 \u54616 \u50668  \u51068 \u54616 \u44256 , \u51200 \u46308 \u51032  \u52280  \u49888 \u50521  \u50504 \u50640  \u44403 \u44172  \u49436 \u46020 \u47197  \u54644 \u51452 \u44592  \u50948 \u54616 \u50668  \u45208 \u45716  \u49457 \u51649 \u50640  \u54732 \u49888 \u54624  \u44163 \u51060 \u45796 \'94 (D\'92Aubigne, b.8, ch.6). \u48708 \u47197  \u49457 \u51649 \u51088 \u46308  \u51473 \u51032  \u50612 \u46500  \u49324 \u46988 \u46308 \u51008  \u44536 \u51032  \u44228 \u54925 \u51012  \u51064 \u51221 \u54616 \u51648  \u50506 \u44256  \u44536  \u51068 \u51012  \u54616 \u51648  \u47803 \u54616 \u46020 \u47197  \u44053 \u44428 \u54616 \u50688 \u51648 \u47564 , \u52768 \u48729 \u44544 \u47532 \u45716  \u45800 \u54840 \u54616 \u44172  \u54620  \u44152 \u51020 \u46020  \u50577 \u48372 \u54616 \u51648  \u50500 \u45768 \u54616 \u50688 \u45796 . \u44536 \u45716  \u50612 \u46500  \u49352 \u47196 \u50868  \u48169 \u52840 \u51012  \u49548 \u44060 \u54616 \u47140 \u45716  \u44163 \u51060  \u50500 \u45768 \u44256  \u48372 \u45796  \u49692 \u44208 \u54616 \u45912  \u52488 \u52285 \u44592 \u51032  \u44368 \u54924 \u50640 \u49436  \u51060 \u48120  \u49892 \u52380 \u54664 \u45912  \u50715  \u48169 \u52840 \u51012  \u46384 \u47476 \u45716  \u45936  \u48520 \u44284 \u54616 \u45796 \u45716  \u44163 \u51012  \u51452 \u51109 \u54616 \u50688 \u45796 .\
\uc0\u48268 \u50024  \u44536 \u44032  \u44032 \u47476 \u52828  \u51652 \u47532 \u50640  \u45824 \u54620  \u55141 \u48120 \u44032  \u49373 \u44220 \u51004 \u48064 \u47196 , \u47566 \u51008  \u49324 \u46988 \u46308 \u51060  \u44536 \u51032  \u49444 \u44368 \u47484  \u46307 \u44592  \u50948 \u54616 \u50668  \u47792 \u47140 \u50772 \u45796 . \u52397 \u51473 \u46308  \u44032 \u50868 \u45936 \u45716  \u50724 \u47019 \u46041 \u50504  \u44368 \u54924 \u50640  \u52636 \u49437 \u54616 \u51648  \u50506 \u45912  \u49324 \u46988 \u46308 \u46020  \u51080 \u50632 \u45796 . \u44536 \u45716  \u48373 \u51020 \u49436 \u47484  \u54196 \u44256  \u44536 \u47532 \u49828 \u46020 \u51032  \u49373 \u50528 \u50752  \u44368 \u54984 \u44284  \u51453 \u51020 \u50640  \u45824 \u54620  \u50689 \u44048 \u51201 \u51064  \u51060 \u50556 \u44592 \u47484  \u51069 \u50612  \u51452 \u44256  \u49444 \u47749 \u54644  \u51452 \u45716  \u44163 \u51004 \u47196  \u48393 \u49324 \u47484  \u49884 \u51089 \u54616 \u50688 \u45796 . \u44536 \u45716  \u50500 \u51064 \u51648 \u45944 \u47480 \u50640 \u49436  \u54620  \u44163 \u44284  \u44057 \u51060  \u50668 \u44592 \u50640 \u49436 \u46020  \u49457 \u44221  \u47568 \u50432 \u47564 \u51060  \u44536 \u47495 \u46120 \u51060  \u50630 \u45716  \u50976 \u51068 \u54620  \u44428 \u50948 \u51032  \u47568 \u50432 \u51060 \u47728 , \u44536 \u47532 \u49828 \u46020 \u51032  \u51453 \u51020 \u47564 \u51060  \u50756 \u51204 \u54620  \u55148 \u49373 \u51060 \u46972 \u44256  \u44053 \u51312 \u54616 \u50688 \u45796 . \'93\u45208 \u45716  \u44536 \u45824 \u46308 \u51012  \u52280 \u46108  \u44396 \u50896 \u51032  \u44540 \u50896 \u51060 \u49888  \u44536 \u47532 \u49828 \u46020 \u44760 \u47196 , \u44536 \u47532 \u49828 \u46020 \u44760 \u47196 \u47564  \u51064 \u46020 \u54616 \u45716  \u51068 \u51012  \u50896 \u54620 \u45796 \'94 (D\'92Aubigne, b.8, ch.6) \u44256  \u44536 \u45716  \u47568 \u54616 \u50688 \u45796 . \u44536  \u49444 \u44368 \u51088 \u51032  \u51452 \u50948 \u50640 \u45716  \u51221 \u52824 \u44032 \u46308 \u44284  \u54617 \u51088 \u46308 \u47196 \u48512 \u53552  \u44592 \u49696 \u51088 \u50752  \u45453 \u48512 \u46308 \u50640  \u51060 \u47476 \u44592 \u44620 \u51648  \u50728 \u44054  \u44228 \u44553 \u51032  \u49324 \u46988 \u46308 \u51060  \u47784 \u50688 \u45796 . \u44536 \u46308 \u51008  \u44618 \u51008  \u55141 \u48120 \u47484  \u44032 \u51648 \u44256  \u44536 \u51032  \u47568 \u50640  \u44480 \u47484  \u44592 \u50872 \u50688 \u45796 . \u44536 \u45716  \u44050 \u50630 \u51060  \u48155 \u51012  \u49688  \u51080 \u45716  \u44396 \u50896 \u51012  \u51204 \u54616 \u50688 \u51012  \u49104 \u47564  \u50500 \u45768 \u46972  \u44536  \u45817 \u49884 \u51032  \u51396 \u50501 \u44284  \u48512 \u54056 \u50640  \u45824 \u54616 \u50668  \u44592 \u53444 \u50630 \u51060  \u44204 \u52293 \u54616 \u50688 \u45796 . \u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u54616 \u45208 \u45784 \u51012  \u52268 \u49569 \u54616 \u47732 \u49436  \u49457 \u45817 \u50640 \u49436  \u46028 \u50500 \u44052 \u45796 . \u44536 \u46308 \u51008  \'93\u44536  \u49324 \u46988 \u51060 \u50556 \u47568 \u47196  \u51652 \u47532 \u47484  \u51204 \u54616 \u45716  \u49324 \u46988 \u51060 \u45796 . \u44536  \u49324 \u46988 \u51060 \u50556 \u47568 \u47196  \u50864 \u47532 \u47484  \u50528 \u44413 \u51032  \u50516 \u55121 \u50640 \u49436  \u51064 \u46020 \u54644  \u45244  \u50864 \u47532 \u51032  \u47784 \u49464 \u44032  \u46112  \u44163 \u51060 \u45796 \'94 (D\'92Aubigne, b.8, ch.6) \u44256  \u47568 \u54616 \u50688 \u45796 .\
\pard\pardeftab720\sa319\partightenfactor0

\f0\b \cf0 \uc0\u48373 \u51020 \u51452 \u51032 \u50752  \u44368 \u44428 \u51452 \u51032 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u52376 \u51020 \u50640 \u45716  \u44536 \u51032  \u54876 \u46041 \u51060  \u53356 \u44172  \u54872 \u50689 \u51012  \u48155 \u50520 \u51004 \u45208 , \u50620 \u47560  \u54980 \u50640 \u45716  \u48152 \u45824 \u44032  \u51068 \u50612 \u45228 \u45796 . \u49849 \u47140 \u46308 \u51008  \u44536 \u51032  \u49324 \u50629 \u51012  \u48169 \u54644 \u54616 \u44256  \u44536 \u51032  \u44368 \u54984 \u51012  \u51221 \u51396 \u54616 \u44592 \u47196  \u51089 \u51221 \u54616 \u50688 \u45796 . \u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u51312 \u49548 \u50752  \u48708 \u45212 \u51004 \u47196  \u44536 \u47484  \u44277 \u44201 \u54616 \u50688 \u44256 , \u50612 \u46500  \u49324 \u46988 \u46308 \u51008  \u47924 \u47168 \u54620  \u47568 \u44284  \u54801 \u48149 \u51004 \u47196  \u44536 \u47484  \u45824 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u52768 \u48729 \u44544 \u47532 \u45716  \u47784 \u46304  \u51068 \u51012  \u51064 \u45236 \u54616 \u47732 \u49436  \'93\u50864 \u47532 \u44032  \u50501 \u54620  \u51088 \u46308 \u51012  \u50696 \u49688  \u44536 \u47532 \u49828 \u46020 \u44760  \u51064 \u46020 \u54616 \u47140 \u47732  \u50668 \u47084  \u44032 \u51648  \u51068 \u50640  \u45576 \u51012  \u44048 \u51648  \u50506 \u51004 \u47732  \u50504  \u46108 \u45796 \'94 (D\'92Aubigne, b.8, ch.6) \u44256  \u47568 \u54616 \u50688 \u45796 .\
\uc0\u44536  \u51592 \u51020 \u50640  \u44060 \u54785  \u49324 \u50629 \u51032  \u48156 \u51204 \u51012  \u50948 \u54616 \u50668  \u54620  \u49324 \u46988 \u51060  \u46308 \u50612  \u50772 \u45796 . \u48148 \u51236 \u50640  \u51080 \u45716  \u44060 \u54785  \u49888 \u50521 \u51012  \u44032 \u51652  \u54620  \u52828 \u44396 \u50640  \u51032 \u54616 \u50668  \u47336 \u49884 \u50504  (Lucian) \u51032  \u54620  \u49324 \u46988 \u51060  \u47336 \u53552 \u51032  \u51200 \u49436  \u47751  \u44428 \u51012  \u44032 \u51648 \u44256  \u52712 \u47532 \u55176 \u47196  \u54028 \u49569 \u46104 \u50632 \u45796 . \u44536 \u47484  \u48372 \u45240  \u52828 \u44396 \u45716  \u44536  \u52293 \u46308 \u51012  \u54028 \u45716  \u44163 \u51060  \u48373 \u51020 \u51032  \u48731 \u51012  \u51204 \u54616 \u45716  \u45936  \u50976 \u47141 \u54620  \u48169 \u54200 \u51060  \u46112  \u44163 \u51060 \u46972 \u44256  \u47568 \u54616 \u50688 \u45796 . \u44536 \u45716  \u52768 \u48729 \u44544 \u47532 \u50640 \u44172  \u45796 \u51020 \u44284  \u44057 \u51060  \u54200 \u51648 \u54616 \u50688 \u45796 . \'93\u51060  \u49324 \u46988 \u51032  \u49888 \u51473 \u54616 \u44256  \u49836 \u44592 \u47196 \u50868  \u47560 \u51020 \u50640  \u45824 \u54616 \u50668 \u45716  \u51228 \u44032  \u48372 \u51613 \u54633 \u45768 \u45796 . \u44536 \u47084 \u48064 \u47196  \u44536 \u50640  \u45824 \u54620  \u44204 \u54644 \u44032  \u51200 \u50752  \u44057 \u45796 \u47732  \u44536 \u47196  \u54616 \u50668 \u44552  \u47336 \u53552 \u51032  \u51200 \u49436 \u47484  \u44032 \u51648 \u44256  \u50728  \u49828 \u50948 \u49828  \u45208 \u46972 \u51032  \u46020 \u49884 \u50752  \u51021 \u44284  \u52492 \u46973 \u51012  \u48169 \u47928 \u54616 \u46104 , \u51665 \u51665 \u47560 \u45796  \u48736 \u51664 \u50630 \u51060  \u48169 \u47928 \u54616 \u44172  \u54616 \u44256 , \u52293 \u51008  \u53945 \u48324 \u55176  \u51068 \u48152  \u48177 \u49457 \u46308 \u51012  \u50948 \u54616 \u50668  \u51200 \u49696 \u54620  \'91\u51452 \u51032  \u44592 \u46020 \u47928 \u51032  \u51452 \u54644 \'92\u44032  \u51201 \u45817 \u54624  \u44163 \u51077 \u45768 \u45796 . \u44536 \u47532 \u44256  \u48177 \u49457 \u46308 \u51060  \u45908  \u47566 \u51060  \u50508 \u44172  \u46104 \u47732  \u50508 \u44172  \u46112 \u49688 \u47197  \u44536 \u46308 \u51008  \u45908 \u50865  \u47566 \u51060  \u49324 \u44172  \u46112  \u44163 \u51077 \u45768 \u45796 \'94 (D\'92Aubigne, b.8, ch.6).\
\uc0\u54616 \u45208 \u45784 \u44760 \u49436  \u47924 \u51648 \u50752  \u48120 \u49888 \u51032  \u49549 \u48149 \u51012  \u44648 \u46888 \u47532 \u44256 \u51088  \u51456 \u48708 \u54616 \u44256  \u44228 \u49884 \u45716  \u48148 \u47196  \u44536  \u46412 \u50640 , \u49324 \u45800 \u51008  \u49324 \u46988 \u46308 \u51012  \u50516 \u55121  \u44032 \u50868 \u45936  \u47931 \u50612  \u46160 \u44256 , \u44536 \u46308 \u51032  \u49549 \u48149 \u51012  \u45908 \u50865  \u44403 \u44172  \u54616 \u44592  \u50948 \u54616 \u50668  \u45908 \u50865  \u53360  \u55192 \u51004 \u47196  \u51068 \u54616 \u50688 \u45796 . \u49324 \u46988 \u46308 \u51060  \u50668 \u47084  \u44057 \u51648  \u50500 \u45768 \u54620  \u44275 \u50640 \u49436  \u51068 \u50612 \u45208 \u49436  \u48177 \u49457 \u46308 \u50640 \u44172  \u44536 \u47532 \u49828 \u46020 \u51032  \u54588 \u47196  \u47568 \u48120 \u50516 \u50500  \u51396 \u51032  \u49324 \u50976 \u50752  \u52845 \u51032 \u47484  \u50619 \u45716 \u45796 \u44256  \u44032 \u47476 \u52824 \u44256  \u51080 \u51012  \u46412  \u47196 \u47560 \u44368 \u45716  \u47784 \u46304  \u44536 \u47532 \u49828 \u46020 \u44368 \u44397 \u50640 \u49436  \u49352 \u47196 \u50868  \u45733 \u47141 \u51004 \u47196  \u44144 \u47000 \u49548 \u47484  \u50676 \u44256 , \u47732 \u51396 \u48512 \u47484  \u54036 \u44592  \u49884 \u51089 \u54616 \u50688 \u45796 .\
\uc0\u47784 \u46304  \u51396 \u45716  \u44536  \u44050 \u51060  \u51221 \u54644 \u51256  \u51080 \u50632 \u51004 \u47728 , \u44368 \u54924 \u51032  \u44552 \u44256 \u47564  \u52292 \u50892 \u51652 \u45796 \u47732  \u49324 \u46988 \u46308 \u51008  \u51088 \u50976 \u47213 \u44172  \u48276 \u51396 \u54624  \u49688  \u51080 \u46020 \u47197  \u54728 \u50857 \u46104 \u50612  \u51080 \u50632 \u45796 . \u44536 \u47532 \u54616 \u50668  \u46160  \u44032 \u51648  \u50868 \u46041 \u51060  \u51204 \u44060 \u46104 \u50632 \u45796 . \u54616 \u45208 \u45716  \u46024 \u51012  \u48155 \u44256  \u51396 \u47484  \u50857 \u49436 \u54616 \u50668  \u51456 \u45796 \u45716  \u50868 \u46041 \u51060 \u50632 \u44256 , \u45796 \u47480  \u54616 \u45208 \u45716  \u44536 \u47532 \u49828 \u46020 \u47484  \u53685 \u54616 \u50668  \u51396 \u47484  \u50857 \u49436 \u54644  \u51456 \u45796 \u45716  \u50868 \u46041 \u51060 \u50632 \u45796 . \u47196 \u47560 \u44368 \u45716  \u51396 \u47484  \u51064 \u54728 \u54644  \u51468 \u51004 \u47196  \u51088 \u44592 \u46308 \u51032  \u51116 \u50896  (\u36001 \u28304 ) \u51060  \u45720 \u50612 \u45228 \u44256 , \u44060 \u54785 \u51088 \u46308 \u51008  \u51396 \u47484  \u44204 \u52293 \u54632 \u51004 \u47196  \u44536 \u47532 \u49828 \u46020 \u47484  \u49549 \u51396 \u51452 \u50752  \u44396 \u51452 \u47196  \u51648 \u51201 \u54616 \u50688 \u45796 .\
\uc0\u46021 \u51068 \u50640 \u49436 \u45716  \u47732 \u51396 \u48512 \u51032  \u54032 \u47588 \u44032  \u46020 \u48120 \u45768 \u53356 \u54924  \u49849 \u47140 \u46308 \u50640 \u44172  \u50948 \u53441 \u46104 \u50612  \u53580 \u52412  (Tetzel) \u51060 \u46972 \u45716  \u54217 \u54032  \u45208 \u49244  \u49324 \u46988 \u51004 \u47196  \u47568 \u48120 \u50516 \u50500  \u54665 \u54644 \u51276 \u45796 . \u44536 \u47084 \u45208  \u49828 \u50948 \u49828 \u50640 \u49436 \u45716  \u44536  \u51068 \u51012  \u51060 \u53448 \u47532 \u50500 \u51032  \u49849 \u47140  \u49340 \u49552  (Samson) \u51060 \u46972 \u45716  \u51088 \u51032  \u51648 \u55064  \u50500 \u47000  \u54532 \u46976 \u52404 \u49828 \u53076  \u49688 \u46020 \u54924 \u50640 \u49436  \u51452 \u44288 \u54616 \u50688 \u45796 . \u49340 \u49552 \u51008  \u46021 \u51068 \u44284  \u49828 \u50948 \u49828 \u50640 \u49436  \u47561 \u45824 \u54620  \u44552 \u54408 \u51012  \u47784 \u51665 \u54616 \u50668  \u48277 \u50773 \u51032  \u44552 \u44256 \u47484  \u52292 \u50892  \u51468 \u51004 \u47196 \u50024  \u44368 \u54924 \u47484  \u50948 \u54616 \u50668  \u51060 \u48120  \u53360  \u44277 \u51201 \u51012  \u45208 \u53440 \u45240  \u49324 \u46988 \u51060 \u50632 \u45796 . \u44536 \u45716  \u49828 \u50948 \u49828 \u47484  \u49692 \u54924 \u54616 \u47732 \u49436  \u47566 \u51008  \u44400 \u51473 \u51012  \u47784 \u50520 \u45716 \u45936 , \u48712 \u44417 \u54620  \u45453 \u48124 \u46308 \u47196 \u48512 \u53552 \u45716  \u50528 \u50024  \u48268 \u50612 \u45459 \u51008  \u51201 \u51008  \u46024 \u51012  \u48764 \u50519 \u50520 \u44256 , \u48512 \u50836 \u54620  \u44228 \u44553 \u51032  \u49324 \u46988 \u46308 \u47196 \u48512 \u53552 \u45716  \u44144 \u50529 \u51032  \u44552 \u51204 \u51012  \u52265 \u52712 \u54616 \u50688 \u45796 . \u48708 \u47197  \u51333 \u44368  \u44060 \u54785 \u51032  \u50689 \u54693 \u51060  \u51060 \u47084 \u54620  \u48512 \u45817 \u54620  \u47588 \u47588 \u47484  \u51221 \u51648 \u49884 \u53412 \u45716  \u45936 \u44620 \u51648 \u45716  \u51060 \u47476 \u51648  \u50500 \u45768 \u54616 \u50688 \u51004 \u45208  \u48268 \u50024  \u44536  \u49688 \u51077 \u51012  \u51201 \u51648  \u50506 \u44172  \u44048 \u49548 \u49884 \u53040 \u45796 . \u52768 \u48729 \u44544 \u47532 \u44032  \u50500 \u51649  \u50500 \u51064 \u51648 \u45944 \u47480 \u50640  \u51080 \u51012  \u46412 \u50640  \u49340 \u49552 \u51008  \u49828 \u50948 \u49828 \u47196  \u46308 \u50612 \u50772 \u51004 \u47728 , \u44536 \u45716  \u44263  \u47732 \u51396 \u48512 \u47484  \u44032 \u51648 \u44256  \u51060 \u50883  \u44256 \u51012 \u44620 \u51648  \u51217 \u44540 \u54644  \u50772 \u45796 . \u44536  \u49548 \u47928 \u51012  \u46307 \u44256 , \u44060 \u54785 \u51088 \u45716  \u44536  \u51068 \u51012  \u48152 \u45824 \u54616 \u44592  \u50948 \u54616 \u50668  \u44263  \u46496 \u45228 \u45796 . \u44536  \u46412 \u50640  \u46160  \u49324 \u46988 \u51060  \u47564 \u45208 \u51648 \u45716  \u47803 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536  \u49849 \u47140 \u51032  \u44144 \u51667 \u51012  \u54253 \u47196 \u54616 \u50668  \u44536 \u47196  \u54616 \u50668 \u44552  \u45796 \u47480  \u51648 \u48169 \u51004 \u47196  \u44040  \u49688 \u48150 \u50640  \u50630 \u46020 \u47197  \u54632 \u51004 \u47196  \u52768 \u48729 \u44544 \u47532 \u45716  \u49457 \u44277 \u51012  \u44144 \u46160 \u50632 \u45796 .\
