\uc0\u52860 \u48712 \u51008  \u50668 \u51204 \u55176  \u54028 \u47532 \u50640 \u49436  \u50672 \u44396 \u50752  \u47749 \u49345 \u44284  \u44592 \u46020 \u47196 \u50024  \u51109 \u47000 \u51032  \u49324 \u50629 \u51012  \u50948 \u54620  \u51456 \u48708 \u47484  \u44054 \u52628 \u45716  \u54620 \u54200  \u51652 \u47532 \u47484  \u44228 \u49549  \u51204 \u54616 \u44256  \u51080 \u50632 \u45796 . \u44536 \u47084 \u45208  \u47560 \u52840 \u45236  \u44536 \u45716  \u51032 \u49900 \u51012  \u48155 \u44172  \u46104 \u50632 \u45796 . \u45817 \u44397 \u51088 \u46308 \u51008  \u44536 \u47484  \u54868 \u54805 \u50640  \u52376 \u54616 \u44256 \u51088  \u44208 \u49900 \u54616 \u50688 \u45796 . \u44536 \u45716  \u50504 \u51204 \u54616 \u44172  \u49704 \u50612  \u51080 \u50632 \u51004 \u48064 \u47196  \u44536 \u51032  \u49888 \u48320 \u51060  \u44536 \u52376 \u47100  \u50948 \u54744 \u54620  \u51460 \u51008  \u49373 \u44033 \u51648  \u50506 \u50520 \u45796 . \u44536 \u47084 \u45208  \u50612 \u45712  \u45216  \u52828 \u44396 \u46308 \u51060  \u44536 \u50640 \u44172 \u47196  \u44553 \u55176  \u45804 \u47140 \u50752 \u49436  \u44536 \u47484  \u52404 \u54252 \u54616 \u44592  \u50948 \u54616 \u50668  \u44288 \u47532 \u46308 \u51060  \u50724 \u44256  \u51080 \u45796 \u45716  \u49548 \u49885 \u51012  \u50508 \u47140 \u51452 \u50632 \u45796 . \u48148 \u47196  \u44536  \u46412 \u50640  \u45824 \u47928 \u51012  \u46160 \u46300 \u47532 \u45716  \u50836 \u46976 \u54620  \u49548 \u47532 \u44032  \u46308 \u47140 \u50772 \u45796 . \u51068 \u44033 \u46020  \u51648 \u52404 \u54624  \u46412 \u44032  \u50500 \u45768 \u50632 \u45796 . \u44536 \u51032  \u52828 \u44396 \u46308  \u51473 \u51032  \u47751  \u49324 \u46988 \u51060  \u47928 \u50640  \u49436 \u49436  \u44288 \u47532 \u46308 \u51012  \u51648 \u52404 \u49884 \u53412 \u44256  \u51080 \u45716  \u46041 \u50504 , \u45796 \u47480  \u49324 \u46988 \u46308 \u51008  \u44553 \u55176  \u44536  \u44060 \u54785 \u51088 \u47484  \u52285 \u47928 \u51004 \u47196  \u45804 \u50500  \u45236 \u47160 \u45796 . \u44536 \u45716  \u51116 \u48744 \u47532  \u49884 \u44032 \u47484  \u48736 \u51256 \u45208 \u44052 \u45796 . \u44536 \u45716  \u44060 \u54785 \u51452 \u51032 \u50640  \u54840 \u51032 \u47484  \u44032 \u51648 \u44256  \u51080 \u45716  \u54620  \u45432 \u46041 \u51088 \u51032  \u51665 \u50640  \u46308 \u50612 \u44032 \u49436  \u44536  \u51665  \u51452 \u51064 \u51032  \u51032 \u48373 \u51012  \u50619 \u50612  \u51077 \u44256 , \u44333 \u51060 \u47484  \u50612 \u44648 \u50640  \u47700 \u44256 , \u44600 \u51012  \u46496 \u45228 \u45796 . \u44536 \u45716  \u45224 \u51901 \u51004 \u47196  \u44032 \u49436  \u47560 \u44032 \u47112 \u53944  \u50689  (\u63924 ) \u50640 \u49436  \u45796 \u49884 \u44552  \u54588 \u45212 \u52376 \u47484  \u52286 \u50520 \u45796  (D\'92Aubigne, b.2, ch.30 \u52280 \u51312 ).\
\uc0\u50976 \u47141 \u54620  \u52828 \u44396 \u46308 \u51032  \u48372 \u54840  \u50500 \u47000  \u44144 \u44592 \u49436  \u47751  \u44060 \u50900  \u46041 \u50504  \u50504 \u51204 \u54616 \u44172  \u52404 \u47448 \u54616 \u47732 \u49436  \u44536 \u45716  \u50668 \u51204 \u55176  \u50672 \u44396 \u50640  \u47792 \u46160 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u51032  \u47560 \u51020 \u51008  \u54532 \u46993 \u49828 \u51032  \u48373 \u51020 \u54868 \u50640  \u51080 \u50632 \u51004 \u48064 \u47196 , \u44536 \u45716  \u50724 \u47019 \u46041 \u50504  \u54616 \u45716  \u51068 \u50630 \u51060  \u51648 \u45244  \u49688  \u50630 \u50632 \u45796 . \u48149 \u54644 \u51032  \u54253 \u54413 \u51060  \u51092 \u51092 \u54644 \u51648 \u51088 \u47560 \u51088  \u44536 \u45716  \u54252 \u54000 \u50612  (Poitiers) \u50640 \u49436  \u49352 \u47196 \u50868  \u51068 \u53552 \u47484  \u48156 \u44204 \u54616 \u50688 \u45796 . \u44144 \u44592 \u50640 \u45716  \u45824 \u54617 \u46020  \u51080 \u50632 \u44256 , \u48373 \u51020 \u51452 \u51032 \u44032  \u54840 \u54217 \u51012  \u48155 \u44256  \u51080 \u50632 \u45796 . \u47784 \u46304  \u44228 \u44553 \u51032  \u49324 \u46988 \u46308 \u51060  \u51600 \u44144 \u50868  \u47560 \u51020 \u51004 \u47196  \u44480 \u47484  \u44592 \u50872 \u50688 \u45796 . \u44277 \u51201 \u51064  \u49444 \u44368 \u45716  \u54616 \u51648  \u47803 \u54616 \u50688 \u51648 \u47560 \u45716  \u52860 \u48712 \u51008  \u44256 \u44288 \u51032  \u51665 \u50640 \u49436 \u45208  \u44536 \u51032  \u49689 \u49548 \u50640 \u49436 \u45208  \u46412 \u47196 \u45716  \u44277 \u50896 \u50640 \u49436  \u55148 \u47581 \u54616 \u45716  \u49324 \u46988 \u46308 \u50640 \u44172  \u50689 \u49373 \u51032  \u47568 \u50432 \u51012  \u46308 \u47140 \u51452 \u50632 \u45796 . \u50620 \u47560  \u54980 \u50640  \u52397 \u51473 \u51060  \u45720 \u50612 \u44048 \u50640  \u46384 \u46972  \u46020 \u49884 \u51032  \u48150 \u50640 \u49436  \u47784 \u51060 \u45716  \u44163 \u51060  \u45908 \u50865  \u50504 \u51204 \u54620  \u44163 \u52376 \u47100  \u49373 \u44033 \u46104 \u50632 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44618 \u44256  \u51329 \u51008  \u49328 \u44264 \u51676 \u44592 \u50640  \u51080 \u45716  \u46041 \u44404 \u51012  \u51665 \u54924 \u49548 \u47196  \u53469 \u54616 \u50688 \u45716 \u45936 , \u44536  \u44275 \u51008  \u49688 \u47785 \u44284  \u50516 \u49437 \u46308 \u47196  \u46168 \u47084 \u49912 \u50668  \u51080 \u50612 \u49436  \u45908 \u50865  \u50504 \u51204 \u54620  \u54588 \u45212 \u52376 \u44032  \u46104 \u50632 \u45796 . \u51201 \u51008  \u47924 \u47532 \u46308 \u51012  \u51060 \u47336 \u50612  \u44033 \u44033  \u45796 \u47480  \u44600 \u47196  \u49884 \u44032 \u47484  \u48279 \u50612 \u45208  \u51060 \u44275 \u51004 \u47196  \u47784 \u50688 \u45796 . \u44536 \u45716  \u44536  \u44201 \u47532 \u46108  \u51109 \u49548 \u50640 \u49436  \u49457 \u44221 \u51012  \u51069 \u44256  \u49444 \u47749 \u54616 \u50688 \u45796 . \u54532 \u46993 \u49828 \u51032  \u44060 \u49888 \u44368 \u46020 \u44032  \u52376 \u51020 \u51004 \u47196  \u49457 \u47564 \u52268  \u50696 \u49885 \u51012  \u54620  \u44275 \u51060  \u48148 \u47196  \u51060  \u44275 \u51060 \u50632 \u45796 . \u51060  \u51089 \u51008  \u44368 \u54924 \u50640 \u49436  \u47751  \u49324 \u46988 \u51032  \u52649 \u49892 \u54620  \u48373 \u51020  \u51204 \u46020 \u51088 \u46308 \u51060  \u50808 \u48512 \u47196  \u54028 \u44204 \u46104 \u50632 \u45796 .\
\uc0\u52860 \u48712 \u51008  \u45796 \u49884  \u54028 \u47532 \u47196  \u46028 \u50500 \u50772 \u45796 . \u44536 \u45716  \u54620  \u44397 \u44032 \u47196 \u49436 \u51032  \u54532 \u46993 \u49828 \u44032  \u51333 \u44368 \u44060 \u54785 \u51012  \u48155 \u50500 \u46308 \u50668 \u50556  \u54620 \u45796 \u45716  \u55148 \u47581 \u51012  \u46020 \u51200 \u55176  \u54252 \u44592 \u54624  \u49688  \u50630 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u49324 \u50629 \u51032  \u47928 \u54840 \u44032  \u44144 \u51032  \u45803 \u55176 \u44172  \u46108  \u44163 \u51012  \u50508 \u50520 \u45796 . \u48373 \u51020 \u51012  \u51204 \u54616 \u45716  \u44163 \u51008  \u54868 \u54805 \u51452 \u47196  \u51649 \u54665 \u54616 \u45716  \u44163 \u51060 \u50632 \u45796 . \u44536 \u47000 \u49436  \u44536 \u45716  \u47560 \u52840 \u45236  \u46021 \u51068 \u47196  \u44032 \u44256 \u51088  \u51089 \u51221 \u54616 \u50688 \u45796 . \u44536 \u44032  \u54532 \u46993 \u49828 \u50640 \u49436  \u47792 \u47000  \u53448 \u52636 \u54616 \u51088 \u47560 \u51088  \u49900 \u54620  \u54253 \u54413 \u50864 \u44032  \u44536  \u45208 \u46972 \u51032  \u44060 \u54785 \u54028 \u50640 \u44172  \u50628 \u49845 \u54616 \u50688 \u45796 . \u44536 \u44032  \u54532 \u46993 \u49828 \u50640  \u47672 \u47932 \u47084  \u51080 \u50632 \u45908 \u46972 \u47732  \u44536 \u45716  \u48516 \u47749 \u55176  \u51453 \u51020 \u51012  \u47732 \u54624  \u49688  \u50630 \u50632 \u51012  \u44163 \u51060 \u45796 .\
