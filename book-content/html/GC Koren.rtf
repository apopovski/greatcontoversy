\'93\uc0\u44536  \u46412 \u50640  \u52380 \u44397 \u51008  \u47560 \u52824  \u46321 \u51012  \u46308 \u44256  \u49888 \u46993 \u51012  \u47582 \u51004 \u47084  \u45208 \u44036  \u50676  \u52376 \u45376 \u50752  \u44057 \u45796  \u54616 \u47532 \u45768  \u44536  \u51473 \u50640  \u45796 \u49455 \u51008  \u48120 \u47144 \u54616 \u44256  \u45796 \u49455 \u51008  \u49836 \u44592  \u51080 \u45716 \u51648 \u46972  \u48120 \u47144 \u54620  \u51088 \u46308 \u51008  \u46321 \u51012  \u44032 \u51648 \u46104  \u44592 \u47492 \u51012  \u44032 \u51648 \u51648  \u50500 \u45768 \u54616 \u44256  \u49836 \u44592  \u51080 \u45716  \u51088 \u46308 \u51008  \u44536 \u47495 \u50640  \u44592 \u47492 \u51012  \u45812 \u50500  \u46321 \u44284  \u54632 \u44760  \u44032 \u51256 \u44052 \u45908 \u45768  \u49888 \u46993 \u51060  \u45908 \u46356  \u50724 \u48064 \u47196  \u45796  \u51320 \u47728  \u51096 \u49352  \u48164 \u51473 \u50640  \u49548 \u47532 \u44032  \u45208 \u46104  \u48372 \u46972  \u49888 \u46993 \u51060 \u47196 \u45796  \u47582 \u51004 \u47084  \u45208 \u50724 \u46972  \u54616 \'94\u45908 \u46972 .\
