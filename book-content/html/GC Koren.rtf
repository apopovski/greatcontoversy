\'93\uc0\u50668 \u51088 \u44032  \u48192 \u50640 \u44172  \u47568 \u54616 \u46104  \u46041 \u49328  \u45208 \u47924 \u51032  \u49892 \u44284 \u47484  \u50864 \u47532 \u44032  \u47673 \u51012  \u49688  \u51080 \u51004 \u45208  \u46041 \u49328  \u51473 \u50521 \u50640  \u51080 \u45716  \u45208 \u47924 \u51032  \u49892 \u44284 \u45716  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u50640  \u45320 \u55148 \u45716  \u47673 \u51648 \u46020  \u47568 \u44256  \u47564 \u51648 \u51648 \u46020  \u47568 \u46972  \u45320 \u55148 \u44032  \u51453 \u51012 \u44620  \u54616 \u45432 \u46972  \u54616 \u49512 \u45712 \u45768 \u46972  \u48192 \u51060  \u50668 \u51088 \u50640 \u44172  \u51060 \u47476 \u46104  \u45320 \u55148 \u44032  \u44208 \u53076  \u51453 \u51648  \u50500 \u45768 \u54616 \u47532 \u46972  \u45320 \u55148 \u44032  \u44536 \u44163 \u51012  \u47673 \u45716  \u45216 \u50640 \u45716  \u45320 \u55148  \u45576 \u51060  \u48157 \u50500  \u54616 \u45208 \u45784 \u44284  \u44057 \u51060  \u46104 \u50612  \u49440 \u50501 \u51012  \u50508  \u51460 \u51012  \u54616 \u45208 \u45784 \u51060  \u50500 \u49900 \u51060 \u45768 \u46972 \'94 (\u52285  3:2~5). \u44536 \u45716  \u44536 \u46308 \u51060  \u54616 \u45208 \u45784 \u44284  \u44057 \u50500 \u51648 \u44256  \u51204 \u48372 \u45796  \u45908 \u50865  \u53360  \u51648 \u54812 \u47484  \u49548 \u50976 \u54616 \u44172  \u46104 \u50612  \u44536  \u51316 \u51116 \u44032  \u45908 \u50865  \u44256 \u49345 \u54620  \u49345 \u53468 \u47196  \u48148 \u45076  \u49688  \u51080 \u45796 \u44256  \u51452 \u51109 \u54616 \u50688 \u45796 . \u54616 \u50752 \u44032  \u50976 \u54841 \u50640  \u45336 \u50612 \u51648 \u44256  \u44536 \u51032  \u50689 \u54693 \u51012  \u48155 \u50500  \u50500 \u45812 \u46020  \u51396 \u47484  \u51667 \u44172  \u46104 \u50632 \u45796 . \u44536 \u46308 \u51008  \u54616 \u45208 \u45784 \u44760 \u49436  \u47568 \u50432 \u54616 \u49888  \u51032 \u48120 \u50752 \u45716  \u51204 \u54784  \u48152 \u45824 \u46104 \u45716  \u48192 \u51032  \u47568 \u51012  \u48155 \u50500 \u46308 \u50688 \u45796 . \u44536 \u46308 \u51008  \u52285 \u51312 \u51452 \u47484  \u48127 \u51648  \u50506 \u44256  \u54616 \u45208 \u45784 \u44760 \u49436  \u44536 \u46308 \u51032  \u51088 \u50976 \u47484  \u49549 \u48149 \u54616 \u49884 \u45716  \u44163 \u52376 \u47100  \u49373 \u44033 \u54616 \u44256  \u44536 \u48516 \u51032  \u50984 \u48277 \u51012  \u48276 \u54632 \u51004 \u47196 \u50024  \u53360  \u51648 \u54812 \u50752  \u45458 \u51008  \u50948 \u52824 \u47484  \u50619 \u51012  \u49688  \u51080 \u51012  \u44163 \u51004 \u47196  \u49345 \u49345 \u54664 \u45796 .\
