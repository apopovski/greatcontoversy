\uc0\u44536 \u47532 \u54616 \u50668  \u44536 \u45716  \u51060 \u47084 \u54620  \u50672 \u44396 \u47484  \u53685 \u54616 \u50668  \u49457 \u44221 \u50640  \u44592 \u47197 \u46108  \u50668 \u47084  \u44032 \u51648  \u50672 \u45824 \u51201  \u44592 \u44036 \u51060  \u48148 \u47196  \u44536 \u47532 \u49828 \u46020 \u51032  \u51116 \u47548 \u50640 \u44620 \u51648  \u51060 \u47476 \u44256  \u51080 \u45796 \u45716  \u44163 \u51012  \u48156 \u44204 \u54616 \u44256  \u47560 \u52840 \u45236  \u44536 \u45716  \u44536  \u50672 \u45824 \u51201  \u44592 \u44036 \u51060  \u44263  \u54616 \u45208 \u45784 \u44760 \u49436  \u44536  \u51333 \u46308 \u50640 \u44172  \'93\u48120 \u47532  \u48372 \u51060 \u49888  \u44592 \u44036 \u46308 \'94\u51060 \u46972 \u44256  \u49373 \u44033 \u54616 \u44172  \u46104 \u50632 \u45796 . \u47784 \u49464 \u45716  \'93\u50724 \u47896 \u54620  \u51068 \u51008  \u50864 \u47532  \u54616 \u45208 \u45784  \u50668 \u54840 \u50752 \u44760  \u49549 \u54616 \u50688 \u44144 \u45768 \u50752  \u45208 \u53440 \u45212  \u51068 \u51008  \u50689 \u44396 \u55176  \u50864 \u47532 \u50752  \u50864 \u47532  \u51088 \u49552 \u50640 \u44172  \u49549 \u54616 \u50688 \'94 (\u49888  29:29) \u45796 \u44256  \u47568 \u54616 \u50688 \u45796 . \u51452 \u45784 \u44760 \u49436 \u45716  \u50500 \u47784 \u49828 \u47484  \u53685 \u54616 \u50668  \'93\u51452  \u50668 \u54840 \u50752 \u44760 \u49436 \u45716  \u51088 \u44592 \u51032  \u48708 \u48128 \u51012  \u44536  \u51333  \u49440 \u51648 \u51088 \u46308 \u50640 \u44172  \u48372 \u51060 \u51648  \u50500 \u45768 \u54616 \u49884 \u44256 \u45716  \u44208 \u53076  \u54665 \u54616 \u49900 \u51060  \u50630 \u51004 \u49884 \u47532 \u46972 \'94 (\u50516  3:7) \u44256  \u47568 \u50432 \u54616 \u49512 \u45796 . \u44536 \u47084 \u48064 \u47196  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51012  \u50672 \u44396 \u54616 \u45716  \u49324 \u46988 \u46308 \u51008  \u45572 \u44396 \u45208  \u51064 \u47448  \u50669 \u49324 \u50640 \u49436  \u51068 