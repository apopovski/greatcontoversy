\uc0\u48277 \u50773 \u44368 \u45716  \u49457 \u44221 \u51032  \u50696 \u50616 \u51060  \u47560 \u51648 \u47561  \u49884 \u45824 \u50640  \u48176 \u46020 \u54616 \u45716  \u51068 \u51060  \u51080 \u51004 \u47532 \u46972 \u44256  \u47568 \u54620  \u48148 \u47196  \u44536 \u45824 \u47196 \u51032  \u45800 \u52404 \u51060 \u45796  (\u49332 \u54980  2:3, 4). \u51088 \u44592 \u51032  \u47785 \u51201 \u51012  \u51060 \u47336 \u45716  \u45936  \u44032 \u51109  \u54200 \u47532 \u54620  \u44600 \u51012  \u52712 \u54616 \u45716  \u44163 \u51060  \u44536 \u51032  \u51221 \u52293 \u51032  \u54616 \u45208 \u51060 \u45796 . \u44536 \u45716  \u50668 \u47084  \u44032 \u51648  \u44032 \u48320 \u51201 \u51064  \u47784 \u50577  \u50500 \u47000  \u48320 \u54632 \u50630 \u45716  \u48192 \u51032  \u46021 \u51012  \u44048 \u52628 \u44256  \u51080 \u45796 . \'93\u50864 \u47532 \u45716  \u51060 \u45800 \u51088 \u45208  \u51060 \u45800 \u51088 \u47196  \u51032 \u49900 \u46104 \u45716  \u49324 \u46988 \u46308 \u51012  \u49888 \u47280 \u54644 \u49436 \u45716  \u50504  \u46108 \u45796 \'94 (Lenfant, vol.1, p.516) \u44256  \u48277 \u50773 \u44368 \u45716  \u51452 \u51109 \u54620 \u45796 . \u49457 \u46020 \u51032  \u54588 \u47196  \u44592 \u47197 \u46108  \u52380 \u50668  \u45380 \u51032  \u44592 \u47197 \u51012  \u44032 \u51652  \u51060  \u49464 \u47141 \u51060  \u50724 \u45720 \u45216  \u44536 \u47532 \u49828 \u46020 \u44368 \u51032  \u51068 \u48512 \u47196  \u51064 \u51221 \u46104 \u50612 \u50556  \u54624  \u44163 \u51064 \u44032 ?\
