\'93\uc0\u51060  \u51068  \u54980 \u50640  \u45796 \u47480  \u52380 \u49324 \u44032  \u54616 \u45720 \u50640 \u49436  \u45236 \u47140 \u50724 \u45716  \u44163 \u51012  \u48372 \u45768  \u53360  \u44428 \u49464 \u47484  \u44032 \u51276 \u45716 \u45936  \u44536 \u51032  \u50689 \u44305 \u51004 \u47196  \u46405 \u51060  \u54872 \u54616 \u50668 \u51648 \u45908 \u46972  \u55192 \u49468  \u51020 \u49457 \u51004 \u47196  \u50808 \u52432  \u44032 \u47196 \u46104  \u47924 \u45320 \u51276 \u46020 \u45796  \u47924 \u45320 \u51276 \u46020 \u45796  \u53360  \u49457  \u48148 \u48296 \u47200 \u51060 \u50668  \u44480 \u49888 \u51032  \u52376 \u49548 \u50752  \u44033 \u51333  \u45908 \u47084 \u50868  \u50689 \u51032  \u47784 \u51060 \u45716  \u44275 \u44284  \u44033 \u51333  \u45908 \u47101 \u44256  \u44032 \u51613 \u54620  \u49352 \u51032  \u47784 \u51060 \u45716  \u44275 \u51060  \u46104 \u50632 \u46020 \u45796 \'94, \'93\u45236 \u44032  \u46308 \u51004 \u45768  \u54616 \u45720 \u47196 \u49436  \u45796 \u47480  \u51020 \u49457 \u51060  \u45208 \u49436  \u44032 \u47196 \u46104  \u45236  \u48177 \u49457 \u50500  \u44144 \u44592 \u49436  \u45208 \u50752  \u44536 \u51032  \u51396 \u50640  \u52280 \u50696 \u54616 \u51648  \u47568 \u44256  \u44536 \u51032  \u48155 \u51012  \u51116 \u50521 \u46308 \u51012  \u48155 \u51648  \u47568 \u46972 \'94 (\u44228  18:1, 2, 4).\
\uc0\u51060  \u49457 \u44221 \u51208 \u51008  \u50836 \u54620 \u44228 \u49884 \u47197  14\u51109 \u51032  \u46168 \u51704  \u52380 \u49324 \u44032  \u49440 \u54252 \u54620  \u48148 \u48296 \u47200 \u51060  \u47924 \u45320 \u51276 \u45796 \u45716  \u44592 \u48324 \u51060  \u48152 \u48373 \u54616 \u50668  \u51204 \u54644 \u51648 \u45716  \u46412 \u47484  \u44032 \u47532 \u53020  \u51456 \u45796  (\u44228  18:4 \u52280 \u51312 ). \u44536 \u47532 \u44256  \u44536 \u44163 \u51008  1844\u45380  \u50668 \u47492 \u50640  \u44536  \u44592 \u48324 \u51060  \u52376 \u51020  \u49440 \u54252 \u46108  \u51060 \u47000  \u48148 \u48296 \u47200 \u51012  \u44396 \u49457 \u54616 \u44256  \u51080 \u45716  \u47784 \u46304  \u45800 \u52404 \u50640  \u52840 \u53804 \u46108  \u53440 \u46973 \u51032  \u49345 \u53468 \u47484  \u52392 \u44032 \u54644 \u49436  \u47568 \u54644  \u51456 \u45796 . \u50668 \u44592 \u50640 \u45716  \u51333 \u44368 \u44228 \u51032  \u46160 \u47140 \u50868  \u49345 \u53468 \u44032  \u47896 \u49324 \u46104 \u50612  \u51080 \u45796 . \u51652 \u47532 \u47484  \u44144 \u51208 \u54624  \u46412 \u47560 \u45796  \u49324 \u46988 \u51032  \u47560 \u51020 \u51008  \u45908 \u50865  \u50612 \u46177 \u44256  \u45908 \u50865  \u50756 \u44256 \u54644 \u51256 \u49436  \u44536 \u46308 \u51008  \u47560 \u52840 \u45236  \u45824 \u45812 \u54620  \u48520 \u49888 \u51004 \u47196  \u47924 \u51109 \u54616 \u44172  \u46108 \u45796 . \u44536 \u46308 \u51008  \u54616 \u45208 \u45784 \u44760 \u49436  \u51452 \u49888  \u44221 \u44256 \u47484  \u47924 \u49884 \u54616 \u50668  \u49901 \u44228 \u47749  \u51473  \u54620  \u44228 \u47749 \u51012  \u44228 \u49549 \u54644 \u49436  \u48276 \u54616 \u44256  \u47560 \u52840 \u45236  \u44536 \u46308 \u51008  \u44536  \u44228 \u47749 \u51012  \u44144 \u47337 \u55176  \u51648 \u53412 \u45716  \u49324 \u46988 \u46308 \u51012  \u48149 \u54644 \u54616 \u44172  \u46104 \u50632 \u45796 . \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u47568 \u50432 \u44284  \u45817 \u49888 \u51032  \u48177 \u49457 \u50640 \u44172  \u44284 \u54644 \u51648 \u45716  \u47736 \u49884 \u47484  \u53685 \u54616 \u50668  \u47924 \u49884 \u45817 \u54616 \u49888 \u45796 . \u44053 \u49888 \u49696 \u51032  \u44368 \u54984 \u51060  \u44368 \u54924 \u50640  \u50857 \u45225 \u46104 \u44256 , \u48320 \u54868 \u46104 \u51648  \u47803 \u54620  \u49324 \u46988 \u51032  \u47560 \u51020 \u51012  \u48537 \u46308 \u44256  \u51080 \u45912  \u51228 \u51116 \u44032  \u49324 \u46972 \u51648 \u47732  \u49888 \u50521 \u51032  \u44256 \u48177 \u51008  \u44032 \u51109  \u48708 \u50676 \u54620  \u51396 \u50501 \u51012  \u49704 \u44592 \u44592  \u50948 \u54620  \u44396 \u49892 \u51060  \u46112  \u44163 \u51060 \u45796 . \u44053 \u49888 \u49696 \u51032  \u51060 \u51201 \u51012  \u48127 \u45716  \u49888 \u50521 \u51008  \u48120 \u54841 \u54616 \u45716  \u50689 \u44284  \u47560 \u44480 \u51032  \u44032 \u47476 \u52840 \u51060  \u46308 \u50612 \u50732  \u49688  \u51080 \u45716  \u47928 \u51012  \u50676 \u50612  \u51452 \u44172  \u46112  \u44163 \u51060 \u48064 \u47196  \u50501 \u54620  \u52380 \u49324 \u46308 \u51032  \u44048 \u54868 \u47484  \u44368 \u54924  \u50504 \u50640 \u49436  \u45712 \u45180 \u44172  \u46112  \u44163 \u51060 \u45796 .\
\uc0\u51060  \u50696 \u50616 \u50640 \u45716  \u48148 \u48296 \u47200 \u49884 \u45824 \u50640  \u45824 \u54616 \u50668  \u45796 \u51020 \u44284  \u44057 \u51060  \u44592 \u47197 \u46104 \u50612  \u51080 \u45796 . \'93\u44536  \u51396 \u45716  \u54616 \u45720 \u50640  \u49324 \u47924 \u52452 \u51004 \u47728  \u54616 \u45208 \u45784 \u51008  \u44536 \u51032  \u48520 \u51032 \u54620  \u51068 \u51012  \u44592 \u50613 \u54616 \u49888 \u51648 \u46972 \'94 (\u44228  18:50). \u48148 \u48296 \u47200 \u51032  \u51396 \u45716  \u52264 \u44256  \u45336 \u52432  \u51080 \u51004 \u47728  \u44536 \u51032  \u47736 \u47581 \u51032  \u49884 \u44592 \u45716  \u51208 \u48149 \u54644  \u50772 \u45796 . \u44536 \u47084 \u45208  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u48148 \u48296 \u47200  \u44032 \u50868 \u45936  \u54620  \u48177 \u49457 \u51012  \u44032 \u51648 \u44256  \u44228 \u49888 \u45796 . \u44536 \u47084 \u48064 \u47196  \u54616 \u45208 \u45784 \u51032  \u49900 \u54032 \u51060  \u45236 \u47532 \u44592  \u51204 \u50640  \u44536  \u52649 \u49457 \u46108  \u51088 \u46308 \u51008  \'93\u44536 \u51032  \u51396 \u50640  \u52280 \u50668 \u54616 \u51648  \u47568 \u44256  \u44536 \u51032  \u48155 \u51012  \u51116 \u50521 \u46308 \u51012  \u48155 \u51648  \u47568 \'94 (\u44228  18:4) \u46020 \u47197  \u48520 \u47084 \u45252 \u51012  \u48155 \u50500 \u50556  \u54620 \u45796 . \u44536 \u47532 \u54616 \u50668  \u54616 \u45720 \u50640 \u49436  \u45236 \u47140 \u50724 \u45716  \u52380 \u49324 \u47196  \u54364 \u49345 \u46108  \u50868 \u46041 \u51008  \u44536 \u51032  \u50689 \u44305 \u51004 \u47196  \u46405 \u51012  \u54872 \u54616 \u44172  \u48708 \u52628 \u44256  \u53360  \u51020 \u49457 \u51004 \u47196  \u50808 \u52824 \u47732 \u49436  \u48148 \u48296 \u47200 \u51032  \u51396 \u47484  \u51648 \u51201 \u54616 \u44256  \u51080 \u45796 . \u51060  \u52380 \u49324 \u51032  \u44592 \u48324 \u44284  \u44288 \u47144 \u54616 \u50668  \'93\u45236  \u48177 \u49457 \u50500  \u44144 \u44592 \u49436  \u45208 \'94\u50724 \u46972 \u45716  \u51020 \u49457 \u51060  \u46308 \u47536 \u45796 . \u51060  \u49440 \u54252 \u45716  \u49483 \u51704  \u52380 \u49324 \u51032  \u44592 \u48324 \u44284  \u54632 \u44760  \u46405 \u50948 \u51032  \u51452 \u48124 \u50640 \u44172  \u51452 \u50612 \u51256 \u50556  \u54624  \u47560 \u51648 \u47561  \u44221 \u44256 \u44032  \u46108 \u45796 .\
\uc0\u49464 \u49345 \u50640 \u49436  \u51068 \u50612 \u45216  \u49324 \u53468 \u45716  \u52280 \u51004 \u47196  \u47924 \u49453 \u45796 . \u54616 \u45208 \u45784 \u51032  \u44228 \u47749 \u51012  \u45824 \u54637 \u54616 \u45716  \u49912 \u50880 \u50640  \u44032 \u45812 \u54616 \u44256  \u51080 \u45716  \u49464 \u49345 \u51032  \u49464 \u47141 \u46308 \u51008  \'93\u47784 \u46304  \u51088  \u44263  \u51089 \u51008  \u51088 \u45208  \u53360  \u51088 \u45208  \u48512 \u51088 \u45208  \u48712 \u44417 \u54620  \u51088 \u45208  \u51088 \u50976 \u54620  \u51088 \u45208  \u51333 \u46308 \u47196 \'94 (\u44228  13:16) \u44144 \u51667  \u50504 \u49885 \u51068 \u51012  \u51648 \u53428 \u51004 \u47196 \u50024  \u44368 \u54924 \u51032  \u49845 \u44288 \u51012  \u46384 \u47476 \u46020 \u47197  \u47749 \u47161 \u54624  \u44163 \u51060 \u45796 . \u44144 \u44592 \u50640  \u49692 \u51333 \u54616 \u44592 \u47484  \u44144 \u51208 \u54616 \u45716  \u51088 \u46308 \u51008  \u47784 \u46160  \u48277 \u47456 \u49345  \u54805 \u48268 \u51012  \u48155 \u44172  \u46104 \u44256  \u47560 \u52840 \u45236  \u44536 \u46308 \u51008  \u49324 \u54805 \u51012  \u48155 \u50500  \u47560 \u46405 \u54616 \u45796 \u45716  \u49440 \u44256 \u47484  \u48155 \u44172  \u46112  \u44163 \u51060 \u45796 . \u44536 \u47084 \u45208  \u51060 \u50752  \u48152 \u45824 \u47196  \u52285 \u51312 \u51452 \u51032  \u50504 \u49885 \u51068 \u51012  \u51648 \u53412 \u46020 \u47197  \u47749 \u47161 \u54616 \u45716  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51008  \u49692 \u51333 \u51012  \u50836 \u44396 \u54616 \u44256  \u54616 \u45208 \u45784 \u51032  \u44228 \u47749 \u51012  \u48276 \u54616 \u45716  \u47784 \u46304  \u51088 \u46308 \u51060  \u51652 \u45432 \u47484  \u48155 \u51012  \u44163 \u51012  \u44221 \u44256 \u54644 \u51456 \u45796 .\
