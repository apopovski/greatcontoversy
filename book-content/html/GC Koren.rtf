\uc0\u44592 \u47197 \u52293 \u46308 \u51060  \u54204 \u52432 \u51648 \u51088 \u47560 \u51088  \u50696 \u49688 \u45784 \u51032  \u45576 \u51008  \u50501 \u51064 \u46308 \u51012  \u51452 \u47785 \u54616 \u49888 \u45796 . \u44536 \u46412  \u44536 \u46308 \u51008  \u44536 \u46308 \u51060  \u51648 \u44552 \u44751  \u48276 \u54620  \u47784 \u46304  \u51396 \u47484  \u44648 \u45803 \u45716 \u45796 . \u44536 \u46308 \u51008  \u44536 \u46308 \u51032  \u48156 \u51060  \u50612 \u46356 \u50640 \u49436 \u48512 \u53552  \u49692 \u44208 \u44284  \u49457 \u44208 \u51032  \u44600 \u50640 \u49436  \u48279 \u50612 \u45228 \u45716 \u51648 , \u44536 \u46308 \u51032  \u44368 \u47564 \u44284  \u48152 \u50669 \u51060  \u44536 \u46308 \u51012  \u50620 \u47560 \u45208  \u49900 \u54616 \u44172  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51012  \u48276 \u54616 \u44172  \u54616 \u50688 \u45716 \u51648  \u44648 \u45803 \u44172  \u46108 \u45796 . \u44536 \u46308 \u51012  \u51396 \u50640  \u48736 \u51648 \u44172  \u54620  \u47588 \u54841 \u51201 \u51064  \u49884 \u54744 \u51012  \u48155 \u51008  \u44163 , \u52629 \u48373 \u51012  \u47924 \u49884 \u54620  \u44163 , \u54616 \u45208 \u45784 \u51032  \u49324 \u51088 \u46308 \u51012  \u47784 \u50837 \u54620  \u44163 , \u44221 \u44256 \u47484  \u44144 \u51208 \u54620  \u44163 , \u50756 \u44256 \u54616 \u44256  \u54924 \u44060 \u54616 \u51648  \u50506 \u51008  \u47560 \u51020 \u51004 \u47196  \u51088 \u48708 \u51032  \u47932 \u44208 \u51012  \u47932 \u47532 \u52432  \u48260 \u47536  \u44163 , \u44536  \u47784 \u46304  \u44163 \u46308 \u51060  \u47560 \u52824  \u48520 \u47196  \u44592 \u47197 \u46108  \u47928 \u51088 \u50752  \u44057 \u51060  \u45208 \u53440 \u45212 \u45796 .\
\uc0\u48372 \u51340  \u50948 \u50640  \u49901 \u51088 \u44032 \u44032  \u45208 \u53440 \u45212 \u45796 . \u44536 \u47532 \u44256  \u50500 \u45812 \u51032  \u50976 \u54841 \u44284  \u53440 \u46973 , \u44536  \u54980 \u50640  \u44228 \u49549 \u51201 \u51004 \u47196  \u51204 \u44060 \u46104 \u45716  \u50948 \u45824 \u54620  \u44396 \u49549 \u51032  \u44221 \u47452 \u51032  \u51109 \u47732 \u46308 \u51060  \u47560 \u52824  \u54028 \u45432 \u46972 \u47560 \u52376 \u47100  \u54204 \u52432 \u51652 \u45796 . \u44396 \u51452 \u51032  \u48708 \u52380 \u54620  \u53444 \u49373 , \u44536 \u48516 \u51032  \u45800 \u49692 \u54616 \u44256  \u50577 \u49692 \u54620  \u52488 \u44592  \u49373 \u50528 , \u50836 \u45800 \u44053 \u50640 \u49436 \u51032  \u52840 \u47168 , \u44305 \u50556 \u50640 \u49436 \u51032  \u44552 \u49885 \u44284  \u49884 \u54744 , \u54616 \u45720 \u51032  \u44032 \u51109  \u44480 \u51473 \u54620  \u52629 \u48373 \u46308 \u51012  \u49324 \u46988 \u46308 \u50640 \u44172  \u50508 \u47140  \u51456  \u44536 \u48516 \u51032  \u44277 \u49373 \u50528 , \u49324 \u46993 \u44284  \u51088 \u48708 \u51032  \u48393 \u49324 \u47196  \u54588 \u44260 \u54644 \u51652  \u45230 \u44284 , \u54620 \u51201 \u54620  \u49328 \u50640 \u49436  \u44592 \u46020 \u54616 \u47728  \u44648 \u50612  \u51080 \u45912  \u48164 \u46308 , \u44536 \u48516 \u51032  \u51008 \u54812 \u50640  \u45824 \u54616 \u50668  \u51656 \u53804 \u50752  \u51613 \u50724 \u50752  \u50501 \u51032 \u50640 \u49436  \u45208 \u50728  \u51020 \u47784 , \u50728  \u49464 \u49345 \u51032  \u51396  \u51664 \u50640  \u45580 \u47160 \u45912  \u46160 \u47157 \u44256  \u49888 \u48708 \u54620  \u44191 \u49464 \u47560 \u45348 \u51032  \u44256 \u48124 , \u49332 \u44592 \u46321 \u46321 \u54620  \u54253 \u46020 \u46308 \u51032  \u49552 \u51004 \u47196  \u45336 \u50612 \u44032 \u44172  \u46108  \u48176 \u48152 , \u44032 \u51109  \u49324 \u46993 \u54616 \u45716  \u51228 \u51088 \u46308 \u50640 \u44172  \u48260 \u47548 \u51012  \u48155 \u44256  \u50696 \u47336 \u49332 \u47128  \u44144 \u47532 \u47484  \u45212 \u54253 \u54616 \u44172  \u45132 \u47140  \u45796 \u45768 \u49888  \u51200 \u54637  \u50630 \u45716  \u51396 \u51064 , \u51032 \u44592 \u50577 \u50577 \u54616 \u44172  \u44536 \u48516 \u51012  \u50504 \u45208 \u49828  \u50526 \u50640  \u49464 \u50868  \u44163 , \u45824 \u51228 \u49324 \u51109 \u51032  \u51665 \u50640 \u49436  \u49569 \u49324  \u48155 \u44256 , \u48716 \u46972 \u46020 \u51032  \u51116 \u54032 \u51221 \u50640 \u49436 , \u46608 \u54620  \u48708 \u44161 \u54616 \u44256  \u51092 \u51064 \u54620  \u54756 \u47215  \u50526 \u50640 \u49436  \u51312 \u49548 \u50752  \u47784 \u50837 \u44284  \u44256 \u47928 \u51012  \u45817 \u54616 \u49884 \u44256  \u47560 \u52840 \u45236  \u49324 \u54805  \u49440 \u44256 \u47484  \u48155 \u51004 \u49888  \u54616 \u45208 \u45784 \u51032  \u50500 \u46308 , \u51060  \u47784 \u46304  \u51109 \u47732 \u46308 \u51060  \u49373 \u49373 \u54616 \u44172  \u47896 \u49324 \u46108 \u45796 .\
\uc0\u51060 \u51228 \u45716  \u53356 \u44172  \u46041 \u50836 \u54616 \u45716  \u47924 \u47532 \u46308  \u50526 \u50640 \u49436  \u47560 \u51648 \u47561  \u44305 \u44221 , \u51064 \u45236 \u51032  \u49688 \u45212 \u51088 \u44032  \u44040 \u48148 \u47532 \u47196  \u44032 \u45716  \u44600 \u51012  \u46384 \u46972 \u44032 \u44256 , \u54616 \u45720 \u51032  \u50773 \u44760 \u49436  \u49901 \u51088 \u44032 \u50640  \u45804 \u47532 \u49884 \u44256 , \u44368 \u47564 \u54620  \u51228 \u49324 \u51109 \u46308 \u44284  \u51312 \u47217 \u54616 \u45716  \u54253 \u46020 \u46308 \u51060  \u51453 \u50612  \u44032 \u45716  \u44536 \u48516 \u51032  \u44256 \u48124 \u51012  \u51312 \u47217 \u54616 \u44256 , \u52488 \u51088 \u50672 \u51201  \u55121 \u50516 \u51060  \u45208 \u53440 \u45208 \u44256 , \u46405 \u51060  \u55124 \u46308 \u47140  \u48148 \u50948 \u44032  \u44648 \u50612 \u51648 \u47728  \u47924 \u45924 \u51060  \u50676 \u47532 \u48064 \u47196  \u49464 \u49345 \u51032  \u44396 \u51452 \u44760 \u49436  \u49373 \u47749 \u51012  \u48260 \u47532 \u49884 \u45716  \u49692 \u44036 \u51012  \u50508 \u47140  \u51452 \u45716  \u44305 \u44221 \u46308 \u51060  \u45208 \u53440 \u45212 \u45796 .\
\uc0\u51060 \u50752  \u44057 \u51060  \u51204 \u50640  \u51080 \u50632 \u45912  \u44536 \u45824 \u47196 \u51032  \u47924 \u49436 \u50868  \u44305 \u44221 \u46308 \u51060  \u45208 \u53440 \u45212 \u45796 . \u49324 \u45800 \u44284  \u44536 \u51032  \u49324 \u51088 \u46308 \u44284  \u44536 \u51032  \u48177 \u49457 \u46308 \u51008  \u44536 \u46308 \u51060  \u54620  \u51068 \u51060  \u46300 \u47084 \u45208 \u51648  \u47803 \u54616 \u46020 \u47197  \u47561 \u51012  \u55192 \u51060  \u50630 \u45796 . \u44033  \u51068 \u51012  \u45812 \u45817 \u54664 \u45912  \u51088 \u45716  \u44536 \u44032  \u54620  \u50669 \u54624 \u51012  \u54924 \u49345 \u54620 \u45796 . \u51060 \u49828 \u46972 \u50648 \u51032  \u50773 \u51012  \u51453 \u51060 \u44592  \u50948 \u54616 \u50668  \u47924 \u44396  (\u28961 \u22434 ) \u54620  \u50500 \u51060 \u46308 \u51012  \u49332 \u54644 \u54620  \u54756 \u47215 , \u44032 \u52293 \u48155 \u45716  \u49900 \u47161 \u51012  \u45804 \u47000 \u44592  \u50948 \u54616 \u50668  \u52840 \u47168  \u50836 \u54620 \u51032  \u54588 \u47484  \u55128 \u47536  \u50556 \u48708 \u54620  \u54756 \u47196 \u46356 \u50500 , \u51648 \u51312  \u50630 \u45716  \u48716 \u46972 \u46020 , \u51312 \u47217 \u54616 \u45912  \u44400 \u51064 \u46308 , \'93\u44536  \u54588 \u47484  \u50864 \u47532 \u50752  \u50864 \u47532  \u51088 \u49552 \u50640 \u44172  \u46028 \u47540 \u51648 \u50612 \u45796 \'94\u44256  \u50808 \u52828  \u51228 \u49324 \u51109 \u46308 \u44284  \u51109 \u47196 \u46308 \u44284  \u44305 \u51201 \u51064  \u47924 \u47532 , \u44536 \u46308  \u47784 \u46160 \u44032  \u44536 \u46308 \u51032  \u51396 \u44032  \u50620 \u47560 \u45208  \u44032 \u51613 \u54632 \u51012  \u48372 \u44172  \u46108 \u45796 . \u44396 \u50896 \u48155 \u51008  \u47924 \u47532 \u46308 \u51060  \u44536 \u46308 \u51032  \u47732 \u47448 \u44288 \u51012  \u44396 \u51452 \u51032  \u48156  \u50526 \u50640  \u45912 \u51648 \u47732 \u49436  \'93\u44536 \u48516 \u44760 \u49436  \u45208 \u47484  \u50948 \u54616 \u