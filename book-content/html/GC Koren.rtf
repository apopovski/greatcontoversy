\uc0\u44053 \u49888 \u49696 \u51032  \u51221 \u52404 \u50640  \u45824 \u54616 \u50668  \u45796 \u47480  \u50500 \u47924  \u51613 \u44144 \u44032  \u50630 \u51012 \u51648 \u46972 \u46020  \u44536 \u47532 \u49828 \u46020 \u51064 \u51008  \u44536  \u50689 \u46308 \u51060  \u51032 \u50752  \u51396 \u47484  \u44396 \u48324 \u54616 \u51648  \u50506 \u44256 , \u44032 \u51109  \u44256 \u44480 \u54616 \u44256  \u49692 \u44208 \u54620  \u44536 \u47532 \u49828 \u46020 \u51032  \u49324 \u46020 \u46308 \u44284  \u44032 \u51109  \u53440 \u46973 \u54620  \u49324 \u45800 \u51032  \u51333 \u46308 \u51012  \u44396 \u48324 \u54616 \u51648  \u50506 \u45716  \u44163 \u51004 \u47196 \u46020  \u52649 \u48516 \u55176  \u50508  \u49688  \u51080 \u45796 . \u49324 \u46988 \u46308  \u51473  \u44032 \u51109  \u48708 \u50676 \u54620  \u51088 \u44032  \u54616 \u45720 \u50640 \u49436  \u45458 \u51076 \u51012  \u48155 \u45716 \u45796 \u44256  \u51452 \u51109 \u54632 \u51004 \u47196  \u49324 \u45800 \u51008  \u49464 \u49345 \u51012  \u54693 \u54616 \u50668  \u47568 \u54620 \u45796 . \'93\u44536 \u45824 \u46308 \u51060  \u50500 \u47924 \u47532  \u50501 \u54624 \u51648 \u46972 \u46020 , \u44536 \u47532 \u44256  \u54616 \u45208 \u45784 \u44284  \u49457 \u44221 \u51012  \u48127 \u46304 \u51648  \u48127 \u51648  \u50506 \u46304 \u51648  \u49345 \u44288 \u51060  \u50630 \u45796 . \u44536 \u45824 \u46308  \u47560 \u51020 \u45824 \u47196  \u49332 \u46972 . \u54616 \u45720 \u51008  \u44536 \u45824 \u46308 \u51060  \u50689 \u50896 \u55176  \u49332  \u44275 \u51060 \u45796 .\'94 \u44053 \u49888 \u49696 \u51032  \u44368 \u49324 \u46308 \u51008  \'93\u47784 \u46304  \u54665 \u50501 \u54616 \u45716  \u51088 \u45716  \u50668 \u54840 \u50752 \u51032  \u45576 \u50640  \u49440 \u55176  \u48372 \u51060 \u47728  \u44536 \u50640 \u44172  \u44592 \u49256 \u51060  \u46108 \u45796  \'85\u44277 \u51032 \u51032  \u54616 \u45208 \u45784 \u51060  \u50612 \u46356  \u44228 \u49884 \u45264 \'94 (\u47568  2:17) \u44256  \u49892 \u