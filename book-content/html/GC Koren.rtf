\uc0\u51452 \u45784 \u44760 \u49436 \u45716  \u49440 \u51648 \u51088  \u48120 \u44032 \u47484  \u53685 \u54616 \u50668  \'93\u50556 \u44273  \u51313 \u49549 \u51032  \u46160 \u47161 \u44284  \u51060 \u49828 \u46972 \u50648  \u51313 \u49549 \u51032  \u52824 \u47532 \u51088  \u44263  \u44277 \u51032 \u47484  \u48120 \u50892 \u54616 \u44256  \u51221 \u51649 \u54620  \u44163 \u51012  \u44413 \u44172  \u54616 \u45716  \u51088 \u46308 \u50500  \u52397 \u52968 \u45824  \u51060  \u47568 \u51012  \u46308 \u51012 \u51648 \u50612 \u45796  \u49884 \u50728 \u51012  \u54588 \u47196 , \u50696 \u47336 \u49332 \u47128 \u51012  \u51396 \u50501 \u51004 \u47196  \u44148 \u52629 \u54616 \u45716 \u46020 \u45796  \u44536  \u46160 \u47161 \u51008  \u45516 \u47932 \u51012  \u50948 \u54616 \u50668  \u51116 \u54032 \u54616 \u47728  \u44536  \u51228 \u49324 \u51109 \u51008  \u49327 \u51012  \u50948 \u54616 \u50668  \u44368 \u54984 \u54616 \u47728  \u44536  \u49440 \u51648 \u51088 \u45716  \u46024 \u51012  \u50948 \u54616 \u50668  \u51216 \u52824 \u47732 \u49436  \u50724 \u55176 \u47140  \u50668 \u54840 \u50752 \u47484  \u51032 \u47280 \u54616 \u50668  \u51060 \u47476 \u44592 \u47484  \u50668 \u54840 \u50752 \u44760 \u49436  \u50864 \u47532  \u51473 \u50640  \u44228 \u49884 \u51648  \u50500 \u45768 \u54616 \u45264  \u51116 \u50521 \u51060  \u50864 \u47532 \u50640 \u44172  \u51076 \u54616 \u51648  \u50500 \u45768 \u54616 \u47532 \u46972  \u54616 \u45716 \u46020 \u45796 \'94 (\u48120  3:9~11) \u46972 \u44256  \u47568 \u50432 \u54616 \u49512 \u45796 .\
\uc0\u51060  \u47568 \u50432 \u51008  \u48512 \u54056 \u54616 \u44256  \u46021 \u49440 \u51201 \u51064  \u50696 \u47336 \u49332 \u47128 \u51032  \u44144 \u48124 \u46308 \u51032  \u54805 \u54200 \u51012  \u50668 \u49892 \u55176  \u47896 \u49324 \u54664 \u45796 . \u44536 \u46308 \u51008  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51032  \u44032 \u47476 \u52840 \u51012  \u50628 \u44201 \u55176  \u51648 \u53412 \u45432 \u46972 \u44256  \u51452 \u51109 \u54616 \u47732 \u49436 \u46020  \u44536  \u47784 \u46304  \u50896 \u52825 \u46308 \u51012  \u48276 \u54616 \u44256  \u51080 \u50632 \u45796 . \u44536 \u46308 \u51008  \u50696 \u49688 \u45784 \u51032  \u49692 \u44208 \u44284  \u49457 \u44208 \u51060  \u44536 \u46308 \u51032  \u48520 \u51032 \u47484  \u46300 \u47084 \u45236  \u51452 \u50632 \u44592  \u46412 \u47928 \u50640  \u44536 \u47532 \u49828 \u46020 \u47484  \u51613 \u50724 \u54616 \u50688 \u45796 . \u46608  \u44536 \u46308 \u51008  \u51088 \u44592 \u46308 \u51032  \u51396 \u51032  \u44208 \u44284 \u47196  \u51060 \u47476 \u47084  \u50728  \u47784 \u46304  \u51116 \u45212 \u51032  \u50896 \u51064 \u51060  \u44536 \u48516 \u50640 \u44172  \u51080 \u45796 \u44256  \u48708 \u45212 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u44536 \u48516 \u51032  \u47924 \u51396 \u47484  \u50508 \u44256 \u49436 \u46020  \u44536 \u46308 \u51032  \u45208 \u46972 \u51032  \u50504 \u51204 \u51012  \u50948 \u54616 \u50668  \u44536 \u48516 \u51032  \u51453 \u51020 \u51060  \u54596 \u50836 \u54616 \u45796 \u44256  \u51452 \u51109 \u54616 \u50688 \u50632 \u45796 . \u50976 \u45824 \u51032  \u51648 \u46020 \u51088 \u46308 \u51008  \'93\u47564 \u51068  \u51200 \u47484  \u51060 \u45824 \u47196  \u46160 \u47732  \u47784 \u46304  \u49324 \u46988 \u51060  \u51200 \u47484  \u48127 \u51012  \u44163 \u51060 \u50836  \u44536 \u47532 \u44256  \u47196 \u47560 \u51064 \u46308 \u51060  \u50752 \u49436  \u50864 \u47532  \u46405 \u44284  \u48124 \u51313 \u51012  \u48764 \u50519 \u50500  \u44032 \u47532 \u46972 \'94 (\u50836  11:48) \u44256  \u47568 \u54616 \u50688 \u45796 . \u44536 \u47532 \u49828 \u46020 \u47484  \u55148 \u49373 \u49884 \u53412 \u47732  \u44536 \u46308 \u51008  \u45796 \u49884  \u54620  \u48264  \u45908  \u44053 \u54616 \u44256  \u45800 \u44208 \u46108  \u45208 \u46972 \u44032  \u46112 \u51648 \u46020  \u47784 \u47484  \u51068 \u51060 \u50632 \u45796 . \u44536 \u46308 \u51008  \u44536 \u47111 \u44172  \u52628 \u47200 \u54616 \u50688 \u51004 \u47728 , \u54620  \u49324 \u46988 \u51060  \u51453 \u45716  \u44163 \u51060  \u50728  \u45208 \u46972 \u44032  \u47581 \u54616 \u45716  \u44163 \u48372 \u45796  \u45227 \u45796 \u44256  \u54616 \u45716  \u45824 \u51228 \u49324 \u51109 \u51032  \u44208 \u51221 \u50640  \u52268 \u46041 \u54616 \u50688 \u45796 .\
\uc0\u44536 \u50752  \u44057 \u51060  \u54616 \u50668  \u50976 \u45824 \u51032  \u51648 \u46020 \u51088 \u46308 \u51008  \'93\u49884 \u50728 \u51012  \u54588 \u47196 , \u50696 \u47336 \u49332 \u47128 \u51012  \u51396 \u50501 \u51004 \u47196  \u44148 \u52629 \u54616 \'94 (\u48120  3:10) \u50688 \u45796 . \u44536 \u46308 \u51008  \u44396 \u51452 \u44760 \u49436  \u44536 \u46308 \u51032  \u51396 \u47484  \u52293 \u47581 \u54616 \u49888  \u44620 \u45805 \u50640  \u44536 \u48516 \u51012  \u51453 \u50688 \u51004 \u47732 \u49436 \u46020  \u51088 \u49888 \u46308 \u51012  \u54616 \u45208 \u45784 \u51032  \u51008 \u52509  \u48155 \u45716  \u48177 \u49457 \u51004 \u47196  \u44036 \u51452 \u54616 \u44256 , \u51452 \u45784 \u44760 \u49436  \u44536 \u46308 \u51012  \u50896 \u49688 \u51032  \u49552 \u50640 \u49436  \u44148 \u51256 \u51452 \u49884 \u46972 \u44256  \u44592 \u45824 \u54616 \u47532 \u47564 \u53372  \u46021 \u49440 \u51201 \u51060 \u50632 \u45796 . \u51060 \u47084 \u48064 \u47196  \u49440 \u51648 \u51088 \u45716  \'93\u45320 \u55148 \u47196  \u51064 \u54616 \u50668  \u49884 \u50728 \u51008  \u48173 \u44057 \u51060  \u44042 \u51012  \u45817 \u54616 \u44256  \u50696 \u47336 \u49332 \u47128 \u51008  \u47924 \u45908 \u44592 \u44032  \u46104 \u44256  \u49457 \u51204 \u51032  \u49328 \u51008  \u49688 \u54400 \u51032  \u45458 \u51008  \u44275 \u44284  \u44057 \u44172  \u46104 \u47532 \u46972 \'94 (\u48120  3:12) \u44256  \u50696 \u50616 \u54616 \u50688 \u45796 .\
\uc0\u50696 \u47336 \u49332 \u47128 \u51032  \u50868 \u47749 \u51060  \u44536 \u47532 \u49828 \u46020  \u51088 \u49888 \u51032  \u51077 \u51004 \u47196  \u49440 \u44256 \u46108  \u54980  \u44144 \u51032  40\u45380  \u46041 \u50504  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u44536  \u49457 \u44284  \u44536  \u48177 \u49457 \u50640  \u45824 \u54620  \u54805 \u48268 \u51012  \u48120 \u47336 \u50612  \u50724 \u49512 \u45796 . \u45817 \u49888 \u51032  \u48373 \u51020 \u51012  \u44144 \u51208 \u54616 \u44256  \u45817 \u49888 \u51032  \u50500 \u46308 \u51012  \u51453 \u51064  \u51088 \u46308 \u50640  \u45824 \u54620  \u54616 \u45208 \u45784 \u51032  \u50724 \u47000  \u52280 \u51004 \u49900 \u51008  \u45440 \u46972 \u50912 \u45796 . \u50676 \u47588  \u47610 \u51648  \u50506 \u45716  \u45208 \u47924 \u51032  \u48708 \u50976 \u45716  \u50976 \u45824 \u51064 \u50640  \u45824 \u54620  \u54616 \u45208 \u45784 \u51032  \u52376 \u49324 \u47484  \u51096  \u49444 \u47749 \u54644  \u51456 \u45796 . \'93\u52237 \u50612  \u48260 \u47532 \u46972  \u50612 \u52236  \u46405 \u47564  \u48260 \u47532 \u45712 \u45264 \'94 (\u45573  13:7) \u44256  \u54616 \u45716  \u47749 \u47161 \u51008  \u51060 \u48120  \u54616 \u45804 \u46104 \u50632 \u51648 \u47560 \u45716 , \u54616 \u45208 \u45784 \u51032  \u51008 \u54812 \u45716  \u44536  \u51068 \u51012  \u51104 \u44624  \u46041 \u50504  \u51648 \u52404 \u54616 \u50688 \u45796 . \u50976 \u45824 \u51064  \u44032 \u50868 \u45936 \u45716  \u50500 \u51649 \u46020  \u44536 \u47532 \u49828 \u46020 \u51032  \u54408 \u49457 \u44284  \u49324 \u50629 \u50640  \u44288 \u54616 \u50668  \u50508 \u51648  \u47803 \u54616 \u45716  \u49324 \u46988 \u46308 \u51060  \u47566 \u50520 \u45796 . \u44536 \u47532 \u44256  \u44536 \u46308 \u51032  \u51088 \u45376 \u46308 \u51008  \u51068 \u52237 \u51060  \u44536 \u46308 \u51032  \u48512 \u47784 \u44032  \u44144 \u51208 \u54620  \u48731 \u51012  \u48155 \u50500 \u49436  \u49892 \u52380 \u54624  \u44592 \u54924 \u47484  \u50619 \u51648  \u47803 \u54616 \u50688 \u45796 . \u44536 \u47084 \u48064 \u47196  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u49324 \u46020 \u46308 \u44284  \u44536  \u46041 \u47308 \u46308 \u51032  \u51204 \u46020 \u47484  \u53685 \u54616 \u50668  \u44536 \u46308 \u50640 \u44172  \u48731 \u51012  \u48708 \u52628 \u50612  \u51452 \u44256 \u51088  \u54616 \u49512 \u45796 . \u44536 \u47532 \u49828 \u46020 \u51032  \u53444 \u49373 \u44284  \u44536 \u48516 \u51032  \u49373 \u50528 \u45716  \u47932 \u47200 \u51060 \u50836 , \u44536 \u48516 \u51032  \u51453 \u51020 \u44284  \u48512 \u54876 \u47196  \u47568 \u48120 \u50516 \u50500  \u50696 \u50616 \u51060  \u50612 \u46523 \u44172  \u49457 \u52712 \u46108  \u44163 \u51012  \u44536 \u46308 \u50640 \u44172  \u50508 \u47140  \u51452 \u50612 \u50556  \u54664 \u45796 . \u44536  \u51088 \u45376 \u46308 \u51060  \u48512 \u47784 \u51032  \u51396  \u46412 \u47928 \u50640  \u54805 \u48268 \u51012  \u49440 \u44256 \u48155 \u51648 \u45716  \u50500 \u45768 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u46308 \u51008  \u48512 \u47784 \u46308 \u50640 \u44172  \u51452 \u50612 \u51652  \u48731 \u51008  \u47932 \u47200 \u51060 \u50836 , \u44536 \u46308  \u51088 \u49888 \u46308 \u51060  \u48155 \u51008  \u48731 \u44620 \u51648 \u46020  \u44144 \u51208 \u54616 \u48064 \u47196  \u48512 \u47784 \u51032  \u51396 \u50640  \u46041 \u52280 \u54616 \u45716  \u51088 \u46308 \u51060  \u46104 \u50632 \u51012  \u49104 \u47564  \u50500 \u45768 \u46972  \u44536 \u46308 \u51032  \u51396 \u50501 \u51032  \u51092 \u51012  \u44032 \u46301  \u52292 \u50912 \u45796 .\
