\uc0\u44368 \u54924  \u45236 \u51032  \u48516 \u50676 \u51008  \u50668 \u51204 \u55176  \u44228 \u49549 \u46104 \u50632 \u45796 . \u49464  \u49324 \u46988 \u51032  \u48277 \u50773 \u51060  \u51228 \u44033 \u44592  \u52572 \u49345 \u44428 \u51012  \u51109 \u50501 \u53076 \u51088  \u45796 \u53804 \u44256  \u51080 \u50632 \u51004 \u48064 \u47196  \u44536 \u47532 \u49828 \u46020 \u44368 \u44397 \u51008  \u48276 \u51396 \u50752  \u49548 \u46041 \u51004 \u47196  \u52649 \u47564 \u54616 \u50668 \u51276 \u45796 . \u44536 \u46308 \u51008  \u54588 \u52264 \u50640  \u51200 \u51452 \u54616 \u45716  \u44163 \u47564 \u51004 \u47196  \u47564 \u51313 \u54616 \u51648  \u50506 \u44256 , \u49464 \u49549 \u51201  \u47924 \u47141 \u50640  \u54840 \u49548 \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44033 \u44033  \u47924 \u44592 \u47484  \u44396 \u51077 \u54616 \u44256  \u44400 \u45824 \u47484  \u47784 \u51665 \u54616 \u44592  \u50948 \u54616 \u50668  \u50528 \u50044 \u45796 . \u47932 \u47200  \u46024 \u51060  \u54596 \u50836 \u54616 \u50688 \u45796 . \u44536 \u47084 \u48064 \u47196  \u46024 \u51012  \u47560 \u47144 \u54616 \u44592  \u50948 \u54616 \u50668  \u49548 \u50948  \u44368 \u54924 \u50640  \u49549 \u54620  \u51008 \u49324 , \u51648 \u50948 , \u52629 \u48373  \u46321 \u51060  \u46024 \u51004 \u47196  \u47588 \u47588 \u46104 \u50632 \u45796 . \u49888 \u48512 \u46308 \u46020  \u50669 \u49884  \u44536 \u46308 \u51032  \u50948 \u50640  \u51080 \u45716  \u49457 \u51649 \u51088 \u46308 \u51032  \u48376 \u51012  \u48155 \u50500  \u49457 \u51649 \u51012  \u47588 \u47588 \u54616 \u44256  \u51088 \u44592 \u51032  \u49345 \u45824 \u51088 \u47484  \u45336 \u50612 \u46888 \u47532 \u44256  \u51088 \u44592 \u51032  \u49464 \u47141 \u51012  \u44053 \u54868 \u54616 \u44592  \u50948 \u54616 \u50668  \u49912 \u50912 \u45796 . \u51060 \u47084 \u54620  \u52384 \u47732 \u54588 \u54620  \u54665 \u46041 \u46308 \u51060  \u45216 \u47560 \u45796  \u51613 \u44032 \u46104 \u50612 \u44048 \u51004 \u47196  \u54980 \u49828 \u45716  \u49548 \u50948  \u51333 \u44368 \u46972 \u45716  \u51060 \u47492 \u51004 \u47196  \u50857 \u51064 \u46104 \u45716  \u44032 \u51613 \u54620  \u54665 \u50948 \u50640  \u45824 \u54616 \u50668  \u44053 \u47141 \u54616 \u44172  \u48708 \u45212 \u54616 \u50688 \u45796 . \u46608 \u54620  \u48177 \u49457 \u46308 \u46020  \u47196 \u47560 \u44368 \u51032  \u51648 \u46020 \u51088 \u46308 \u51060  \u44536 \u47532 \u49828 \u46020 \u44368 \u44397 \u51012  \u48708 \u52280 \u54616 \u44172  \u47564 \u46300 \u45716  \u51088 \u46308 \u51060 \u46972 \u44256  \u44277 \u44277 \u50672 \u54616 \u44172  \u48708 \u45212 \u54616 \u50688 \u45796 . \u44536 \u47532 \u44256  \u54532 \u46972 \u54616 \u50640 \u45716  \u48148 \u50556 \u55120 \u47196  \u50976 \u54792 \u51032  \u52280 \u44537 \u51060  \u51068 \u50612 \u45216  \u44163 \u52376 \u47100  \u48372 \u50688 \u45796 . \u50715 \u45216 \u50640  \u44536 \u47084 \u54664 \u45912  \u44163 \u52376 \u47100  \u54616 \u45208 \u45784 \u51032  \u51333 \u51008  \'93\u51060 \u49828 \u46972 \u50648 \u51012  \u44340 \u47213 \u44172  \u54616 \u45716  \u51088 \'94 (\u50773 \u49345  18:17) \u46972 \u45716  \u48708 \u45212 \u51012  \u48155 \u50520 \u45796 . \u44536  \u46020 \u49884 \u45716  \u46160  \u48264 \u51704 \u47196  \u54028 \u47928 \u51012  \u49440 \u44256 \u48155 \u50520 \u44256 , \u54980 \u49828 \u45716  \u49884 \u44264 \u50640  \u51080 \u45716  \u44256 \u54693 \u51004 \u47196  \u46028 \u50500 \u44052 \u45796 . \u46300 \u46356 \u50612  \u49324 \u46993 \u54616 \u45716  \u48288 \u46308 \u47112 \u54772  \u54924 \u45817 \u50640 \u49436  \u54665 \u54616 \u45912  \u44536 \u51032  \u52649 \u49457 \u46108  \u51613 \u50616 \u51008  \u44536 \u52452 \u45796 . \u51060 \u51228  \u44536 \u45716  \u51652 \u47532 \u51032  \u51613 \u51064 \u51004 \u47196 \u49436  \u44536 \u51032  \u49373 \u47749 \u51012  \u48148 \u52824 \u44592  \u51204 \u50640  \u45908 \u50865  \u45331 \u51008  \u47924 \u45824 \u50640 \u49436  \u50728  \u44536 \u47532 \u49828 \u46020 \u44368 \u44397 \u51012  \u54693 \u54616 \u50668  \u47568 \u54624  \u44163 \u51060 \u50632 \u45796 .\
\uc0\u50728  \u50976 \u47101 \u51012  \u54844 \u46976 \u50640  \u48736 \u51648 \u44172  \u54620  \u54868 \u44540 \u51012  \u51228 \u44144 \u54616 \u44592  \u50948 \u54616 \u50668  \u53080 \u49828 \u53444 \u49828 \u50640 \u49436  \u52509 \u54924 \u44032  \u49548 \u51665 \u46104 \u50632 \u45796 . \u51060  \u54924 \u51032 \u45716  \u49884 \u44592 \u49828 \u47928 \u53944  (sigismund) \u54889 \u51228 \u51032  \u55148 \u47581 \u50640  \u46384 \u46972  \u49464  \u44221 \u51137 \u51088  \u51473 \u51032  \u54616 \u45208 \u51064  \u50836 \u54620  23\u49464 \u44032  \u49548 \u51665 \u54620  \u44163 \u51060 \u50632 \u45796 . \u48277 \u50773  \u50836 \u54620 \u51008  \u50896 \u47000  \u54924 \u51032 \u47484  \u49548 \u51665 \u54616 \u45716  \u44163 \u51012  \u54872 \u50689 \u54616 \u51648  \u50500 \u45768 \u54616 \u50688 \u45796 . \u50780 \u45264 \u54616 \u47732  \u44536 \u45716  \u51064 \u44201 \u44284  \u51221 \u52293 \u50640  \u51080 \u50612 \u49436  \u45817 \u49884 \u51032  \u44368 \u51064 \u46308 \u50640 \u44172 \u49436 \u49104  \u50500 \u45768 \u46972  \u53440 \u46973 \u54620  \u51452 \u44368 \u46308 \u47196 \u48512 \u53552 \u46020  \u55184 \u52293 \u44284  \u48708 \u45212 \u51012  \u48155 \u51012  \u51221 \u46020 \u50688 \u44592  \u46412 \u47928 \u51060 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u44048 \u55176  \u49884 \u44592 \u49828 \u47928 \u53944 \u51032  \u46907 \u51012  \u48152 \u45824 \u54624  \u49688 \u44032  \u50630 \u50632 \u45796  (\u48512 \u47197  16 \u52280 \u51312 ).\
\uc0\u54924 \u51032 \u50640 \u49436  \u45804 \u49457 \u46104 \u50612 \u50556  \u54624  \u51452 \u50836 \u54620  \u47785 \u54364 \u45716  \u44368 \u54924 \u51032  \u45236 \u48516 \u51012  \u54868 \u54644 \u49884 \u53412 \u44256 , \u51060 \u45800 \u51012  \u49100 \u47532  \u48977 \u45716  \u44163 \u51060 \u50632 \u45796 . \u44536 \u47084 \u48064 \u47196  \u46160  \u49324 \u46988 \u51032  \u52280 \u52845  (\u20717 \u31281 ) \u48277 \u50773 \u44284  \u49352 \u47196 \u50868  \u51452 \u51109 \u51012  \u54140 \u46888 \u47532 \u45716  \u51452 \u46041 \u51088 \u47196  \u51648 \u47785 \u46108  \u50560  \u54980 \u49828 \u44032  \u44536  \u54924 \u51032 \u50640  \u49548 \u54872 \u46104 \u50632 \u45796 . \u44536  \u52280 \u52845  \u48277 \u50773 \u46308 \u51008  \u47784 \u46160  \u51088 \u44592 \u46308 \u51032  \u49888 \u48320 \u51032  \u50504 \u51204 \u51012  \u50948 \u54616 \u50668  \u51649 \u51217  \u44536  \u54924 \u51032 \u50640  \u52280 \u49437 \u54616 \u51648  \u50506 \u44256  \u44536 \u46308 \u51032  \u45824 \u54364 \u51088 \u46308 \u51012  \u52280 \u49437 \u49884 \u53040 \u45796 . \u48277 \u50773  \u50836 \u54620 \u51008  \u54364 \u47732 \u49345 \u51004 \u47196  \u44536  \u54924 \u51032 \u51032  \u49548 \u51665 \u51088 \u50688 \u51648 \u47564 , \u54889 \u51228 \u44032  \u51088 \u44592 \u47484  \u54224 \u54616 \u47140 \u45716  \u51008 \u48128 \u54620  \u47785 \u51201 \u51060 \u45208  \u50630 \u45716 \u51648 , \u46608 \u45716  \u51088 \u44592 \u44032  \u49340 \u52789 \u44288 \u51012  \u50619 \u44592  \u50948 \u54616 \u50668  \u51088 \u54665 \u54620  \u48276 \u51396 \u50752  \u44536  \u49340 \u52789 \u44288 \u51012  \u50837 \u46104 \u44172  \u54620  \u54665 \u50948 \u50640  \u45824 \u54616 \u50668  \u47928 \u52293 \u45817 \u54616 \u51648 \u45208  \u50506 \u51012 \u51648  \u54616 \u45716  \u50668 \u47084  \u44032 \u51648  \u48520 \u50504 \u44284  \u51032 \u44396 \u49900  (\u30097 \u25084 \u24515 ) \u51012  \u44032 \u51648 \u44256  \u54924 \u51032 \u50640  \u51076 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u44368 \u54924 \u51032  \u45458 \u51008  \u51649 \u48516 \u51012  \u44032 \u51652  \u49324 \u46988 \u46308 \u44284  \u47566 \u51008  \u49688 \u54665 \u50896 \u46308 \u51012  \u45936 \u47532 \u44256  \u50948 \u54413 \u45817 \u45817 \u54616 \u44172  \u53080 \u49828 \u53444 \u49828  \u49457 \u51004 \u47196  \u46308 \u50612 \u44052 \u45796 . \u49884  (\u24066 ) \u51032  \u44256 \u44288 \u46308 \u44284  \u49457 \u51649 \u51088 \u46308 \u51008  \u49688 \u47566 \u51008  \u49884 \u48124 \u46308 \u44284  \u54632 \u44760  \u44536 \u47484  \u54872 \u50689 \u54616 \u50688 \u45796 . \u44536 \u51032  \u47672 \u47532  \u50948 \u50640 \u45716  \u54889 \u44552 \u51004 \u47196  \u47564 \u46304  \u52380 \u44060  (\u22825 \u33995 ) \u44032  \u45934 \u51060 \u50632 \u44256 , \u44536 \u44163 \u51012  \u44536  \u51648 \u48169  \u51109 \u44288  \u45348  \u49324 \u46988 \u51060  \u48537 \u46308 \u44256  \u51080 \u50632 \u45796 . \u49457 \u52404  (\u32854 \u39636 ) \u45716  \u44536 \u51032  \u50526 \u50640 \u49436  \u50868 \u48152 \u46104 \u50612  \u44032 \u44256 , \u52628 \u44592 \u44221 \u46308 \u51032  \u54868 \u47140 \u54620  \u48373 \u51109 \u46308 \u51008  \u49324 \u46988 \u46308 \u51032  \u45576 \u51012  \u48512 \u49884 \u44172  \u54616 \u50688 \u45796 .\
\uc0\u44536  \u46412 \u50640  \u46608  \u45796 \u47480  \u50668 \u54665 \u51088 \u44032  \u53080 \u49828 \u53444 \u49828  \u49457 \u51004 \u47196  \u44032 \u44620 \u51060  \u50724 \u44256  \u51080 \u50632 \u45796 . \u54980 \u49828 \u45716  \u51088 \u44592 \u47484  \u50948 \u54801 \u54616 \u44256  \u51080 \u45716  \u50948 \u54744 \u51012  \u51060 \u48120  \u50508 \u44256  \u51080 \u50632 \u45796 . \u44536 \u45716  \u44536  \u44600 \u51012  \u47560 \u52824  \u50689 \u50896 \u54620  \u51060 \u48324 \u51032  \u44600 \u51064  \u44163 \u52376 \u47100  \u45712 \u45180 \u44256  \u52828 \u44396 \u46308 \u50640 \u44172  \u51089 \u48324 \u51012  \u44256 \u54616 \u50688 \u45796 . \u44536 \u47532 \u44256  \u44536 \u45716  \u52264 \u52784  \u54868 \u54805 \u51452 \u50640  \u44032 \u44620 \u51060  \u44032 \u44256  \u51080 \u45716  \u44163 \u52376 \u47100  \u45712 \u45180 \u47732 \u49436  \u50668 \u54665 \u51012  \u44228 \u49549 \u54616 \u50688 \u45796 . \u44536 \u45716  \u48372 \u54756 \u48120 \u50500 \u51032  \u50773 \u51004 \u47196 \u48512 \u53552  \u44536 \u51032  \u49888 \u48320 \u51032  \u50504 \u51204 \u51012  \u48372 \u51109 \u54616 \u45716  \u53685 \u54665 \u44428 \u51012  \u48155 \u50520 \u44256 , \u46608 \u54620  \u49884 \u44592 \u49828 \u47928 \u53944  \u54889 \u51228 \u44032  \u48372 \u51613 \u54644 \u51452 \u45716  \u50668 \u54665  \u46020 \u51473 \u51032  \u50504 \u51204 \u51012  \u50948 \u54620  \u53685 \u54665 \u44428 \u44620 \u51648 \u46020  \u48155 \u50520 \u51648 \u47564  \u46020 \u51200 \u55176  \u49324 \u47581 \u51012  \u54588 \u54624  \u49688  \u50630 \u45716  \u51460 \u47196  \u49373 \u44033 \u54616 \u44256  \u47784 \u46304  \u51068 \u51012  \u45796  \u52376 \u47532 \u54616 \u44256  \u44052 \u45796 .\
