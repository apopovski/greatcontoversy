\uc0\u51060 \u46412 \u47196 \u48512 \u53552  \u52380 \u45380 \u52196  \u51204 \u50640  \u49884 \u51064  \u45796 \u50967 \u51008  \u51060 \u49828 \u46972 \u50648 \u51032  \u44144 \u47337 \u54620  \u51665 \u51012  \u45817 \u49888 \u51032  \u52376 \u49548 \u47196  \u49340 \u51004 \u49900 \u51004 \u47196  \u54616 \u45208 \u45784 \u44760 \u49436  \u51060 \u49828 \u46972 \u50648 \u50640 \u44172  \u48288 \u54392 \u49888  \u51008 \u52509 \u51012  \u52268 \u50577 \u54616 \u50688 \u45796 . \'93\u44536  \u51109 \u47561 \u51060  \u46608 \u54620  \u49332 \u47128 \u50640  \u51080 \u51020 \u51060 \u50668  \u44536  \u52376 \u49548 \u45716  \u49884 \u50728 \u50640  \u51080 \u46020 \u45796 \'94 (\u49884  76:2). \u44536 \u48516 \u44760 \u49436  \'93\u50976 \u45796  \u51648 \u54028 \u50752  \u44536  \u49324 \u46993 \u54616 \u49884 \u45716  \u49884 \u50728 \u49328 \u51012  \u53469 \u54616 \u49884 \u44256  \u44536  \u49457 \u49548 \u47484  \u49328 \u51032  \u45458 \u51020 \u44057 \u51060 , \u50689 \u50896 \u55176  \u46160 \u49888  \u46405 \u44057 \u51060  \u51648 \u51004 \u49512 \'94 (\u49884  78:68, 69) \u45796 . \u44536  \u52395  \u49457 \u51204 \u51008  \u51060 \u49828 \u46972 \u50648 \u51032  \u50669 \u49324 \u50640 \u49436  \u44032 \u51109  \u48264 \u50689 \u54616 \u50688 \u45912  \u49884 \u45824 \u50640  \u51648 \u51008  \u44163 \u51060 \u50632 \u45796 . \u45796 \u50967 \u50773 \u51008  \u51060  \u47785 \u51201 \u51012  \u50948 \u54616 \u50668  \u47566 \u51008  \u48372 \u54868 \u47484  \u51456 \u48708 \u54616 \u44256  \u46608 \u54620  \u54616 \u45208 \u45784 \u51032  \u51648 \u49884 \u47484  \u46384 \u46972  \u44536 \u44163 \u51012  \u49444 \u44228 \u54616 \u50688 \u45796  (\u45824 \u49345  28:12, 19 \u52280 \u51312 ). \u44536 \u47532 \u44256  \u51060 \u49828 \u46972 \u50648 \u51032  \u50773 \u46308  \u51473 \u50640 \u49436  \u44032 \u51109  \u51648 \u54812 \u47196 \u50868  \u49556 \u47196 \u47788 \u51060  \u44536  \u49324 \u50629 \u51012  \u50756 \u49457 \u49884 \u53040 \u45796 . \u51060  \u49457 \u51204 \u51008  \u51068 \u52237 \u51060  \u51060  \u49464 \u49345 \u50640  \u51080 \u50632 \u45912  \u44148 \u52629 \u47932 \u46308  \u51473 \u50640 \u49436  \u44032 \u51109  \u54988 \u47469 \u54620  \u44163 \u51060 \u50632 \u45796 . \u44536 \u47084 \u45208  \u51452 \u45784 \u44760 \u49436 \u45716  \u49440 \u51648 \u51088  \u54617 \u44060 \u47484  \u53685 \u54616 \u50668  \u46168 \u51704  \u48264  \u49457 \u51204 \u50640  \u45824 \u54616 \u50668  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u50432 \u54616 \u49512 \u45796 . \'93\u51060  \u51204 \u51032  \u45208 \u51473  \u50689 \u44305 \u51060  \u51060 \u51204  \u50689 \u44305 \u48372 \u45796  \u53356 \u47532 \u46972 \'94, \'93\u46608 \u54620  \u47564 \u44397 \u51012  \u51652 \u46041 \u49884 \u53420  \u44163 \u51060 \u47728  \u47564 \u44397 \u51032  \u48372 \u48176 \u44032  \u51060 \u47476 \u47532 \u45768  \u45236 \u44032  \u50689 \u44305 \u51004 \u47196  \u51060  \u51204 \u50640  \u52649 \u47564 \u52992  \u54616 \u47532 \u46972  \u47564 \u44400 \u51032  \u50668 \u54840 \u50752 \u51032  \u47568 \u51060 \u45768 \u46972 \'94 (\u54617  2:9, 7).\
\uc0\u51060  \u49457 \u51204 \u51008  \u52395  \u49457 \u51204 \u51060  \u45712 \u48512 \u44051 \u45348 \u49332 \u50640  \u51032 \u54644  \u54028 \u44340 \u46108  \u54980  \u49324 \u47196 \u51105 \u54784  \u44052 \u45912  \u49324 \u46988 \u46308 \u51060  \u54889 \u54224 \u46108  \u44256 \u44397 \u51004 \u47196  \u46028 \u50500 \u50752 \u49436  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u53444 \u49373 \u54616 \u49884 \u44592  \u50557  500\u45380  \u51204 \u50640  \u45796 \u49884  \u44148 \u52629 \u54620  \u44163 \u51060 \u50632 \u45796 . \u44536  \u49324 \u46988 \u46308  \u44032 \u50868 \u45936 \u45716  \u51068 \u52237 \u51060  \u49556 \u47196 \u47788 \u51060  \u51648 \u51008  \u54988 \u47469 \u54620  \u49457 \u51204 \u51012  \u48376  \u45432 \u51064 \u46308 \u46020  \u51080 \u50632 \u45716 \u45936 , \u44536 \u46308 \u51008  \u49352  \u49457 \u51204 \u51032  \u44592 \u52488 \u44032  \u45459 \u51068  \u46412  \u44536 \u44163 \u51060  \u52376 \u51020  \u49457 \u51204 \u48372 \u45796  \u47803 \u54620  \u44163 \u51012  \u48372 \u44256  \u50872 \u50632 \u45796 . \u44536  \u45817 \u49884  \u49324 \u46988 \u46308 \u51060  \u51068 \u48152 \u51201 \u51004 \u47196  \u44032 \u51276 \u45912  \u44048 \u51221 \u51012  \u49440 \u51648 \u51088 \u45716  \'93\u45320 \u55148  \u51473 \u50640  \u45224 \u50500  \u51080 \u45716  \u51088  \u44263  \u51060  \u51204 \u51032  \u51060 \u51204  \u50689 \u44305 \u51012  \u48376  \u51088 \u44032  \u45572 \u44396 \u45264  \u51060 \u51228  \u51060 \u44163 \u51060  \u45320 \u55148 \u50640 \u44172  \u50612 \u46523 \u44172  \u48372 \u51060 \u45712 \u45264  \u51060 \u44163 \u51060  \u45320 \u55148  \u45576 \u50640  \u48372 \u51096 \u44163 \u51060  \u50630 \u51648  \u50500 \u45768 \u54616 \u45264 \'94 (\u54617  2:3; \u49828  3:12) \u44256  \u44053 \u47141 \u54616 \u44172  \u54364 \u54788 \u54616 \u50688 \u45796 . \u44536 \u47088 \u45936  \u45208 \u51473 \u50640  \u51648 \u51008  \u49457 \u51204 \u51032  \u50689 \u44305 \u51060  \u51060 \u51204 \u50640  \u51080 \u45912  \u49457 \u51204 \u51032  \u50689 \u44305 \u48372 \u45796  \u45908 \u50865  \u53364  \u44163 \u51060 \u46972 \u45716  \u54728 \u46973 \u51060  \u51452 \u50612 \u51276 \u45796 .\
\uc0\u44536 \u47084 \u45208  \u51060  \u46168 \u51704  \u49457 \u51204 \u51008  \u44536  \u50885 \u51109 \u54616 \u44256  \u54868 \u47140 \u54620  \u51216 \u50640  \u51080 \u50612 \u49436  \u52376 \u51020  \u49457 \u51204 \u44284  \u48708 \u44368 \u44032  \u50504  \u46104 \u50632 \u45796 . \u44536 \u47532 \u44256  \u44536  \u52376 \u51020  \u49457 \u51204 \u50640 \u49436  \u54616 \u45208 \u45784 \u51032  \u51076 \u51116 \u47484  \u45208 \u53440 \u45236 \u45912  \u49888 \u49457 \u54620  \u54364 \u51201 \u46308 \u47196  \u47568 \u48120 \u50516 \u50500  \u44144 \u47337 \u54616 \u44172  \u46104 \u51648 \u46020  \u47803 \u54664 \u45796 . \u44536  \u49457 \u51204 \u51012  \u54616 \u45208 \u45784 \u44760 \u49436  \u48155 \u51004 \u49512 \u45796 \u45716  \u50612 \u46500  \u52488 \u51088 \u50672 \u51201  \u44428 \u45733 \u51032  \u54364 \u49884 \u46020  \u50630 \u50632 \u45796 . \u49352 \u47196  \u44148 \u52629 \u46108  \u49457 \u49548 \u47484  \u44032 \u46301  \u52292 \u50872  \u50689 \u44305 \u51032  \u44396 \u47492 \u46020  \u50630 \u50632 \u45796 . \u44536  \u51228 \u45800  \u50948 \u50640  \u51080 \u45716  \u51228 \u47932 \u51012  \u49324 \u47484  \u48520 \u46020  \u45236 \u47140 \u50724 \u51648  \u50506 \u50520 \u45796 . \u51648 \u49457 \u49548 \u51032  \u44536 \u47353 \u46308  \u49324 \u51060 \u50640  \u51080 \u50632 \u45912  \u54616 \u45208 \u45784 \u51032  \u50689 \u44305 \u51032  \u48731  (\u49744 \u53412 \u45208 ) \u46020  \u45908  \u51060 \u49345  \u48380  \u49688  \u50630 \u50632 \u45796 . \u44536  \u44275 \u50640 \u49436  \u48277 \u44452 \u50752  \u49549 \u51396 \u49548 \u50752  \u51613 \u44144 \u51032  \u46160  \u46028 \u54032 \u46020  \u48380  \u49688  \u50630 \u50632 \u45796 . \u51228 \u49324 \u51109 \u46308 \u50640 \u44172  \u50668 \u54840 \u50752 \u51032  \u46907 \u51012  \u50508 \u47532 \u45716  \u51020 \u49457 \u51060  \u54616 \u45720 \u47196 \u48512 \u53552  \u46308 \u47140 \u50724 \u51648 \u46020  \u50506 \u50520 \u45796 .\
\uc0\u50668 \u47084  \u49464 \u44592  \u46041 \u50504 \u50640 , \u50976 \u45824 \u51064 \u46308 \u51008  \u54616 \u45208 \u45784 \u44760 \u49436  \u54617 \u44060 \u47484  \u53685 \u54616 \u50668  \u51452 \u49888  \u54728 \u46973 \u51060  \u50612 \u45712  \u44275 \u50640 \u49436  \u49457 \u52712 \u46104 \u50632 \u45716 \u51648  \u48372 \u51060 \u44592  \u50948 \u54616 \u50668  \u54747 \u46108  \u45432 \u47141 \u51012  \u54644 \u50772 \u45796 . \u44368 \u47564 \u44284  \u48520 \u49888 \u51004 \u47196  \u47568 \u48120 \u50516 \u50500  \u44536 \u46308 \u51032  \u47560 \u51020 \u51008  \u49440 \u51648 \u51088 \u51032  \u47568 \u50432 \u51032  \u52280 \u46907 \u51012  \u44648 \u45803 \u51648  \u47803 \u54616 \u50688 \u45796 . \u46168 \u51704  \u49457 \u51204 \u51008  \u50668 \u54840 \u50752 \u51032  \u50689 \u44305 \u51032  \u44396 \u47492 \u51004 \u47196 \u44032  \u50500 \u45768 \u46972 , \u49888 \u49457 \u51032  \u47784 \u46304  \u52649 \u47564 \u51060  \u50977 \u52404 \u47196  \u44144 \u54616 \u49884 \u45716  \u48516 , \u50977 \u49888 \u51004 \u47196  \u45208 \u53440 \u45208 \u49888  \u54616 \u45208 \u45784 \u44760 \u49436  \u51649 \u51217  \u51076 \u51116 \u54616 \u49900 \u51004 \u47196  \u51316 \u44480 \u54616 \u44172  \u46104 \u50632 \u45796 . \u45208 \u49324 \u47131  \u50696 \u49688 \u45784 \u44760 \u49436  \u49457 \u51204  \u46896 \u50640 \u49436  \u44032 \u47476 \u52824 \u49884 \u44256  \u48337 \u51012  \u44256 \u52824 \u49884 \u45912  \u46412 \u45716  \u52280 \u51004 \u47196  \'93\u47564 \u44397 \u51032  \u49324 \u47784 \u54616 \u45716 \'94 \u48516 \u44760 \u49436  \u45817 \u49888 \u51032  \u49457 \u51204 \u50640  \u50724 \u49888  \u46412 \u50688 \u45796 . \u45796 \u47492  \u50500 \u45772  \u50724 \u51649  \u44536 \u47532 \u49828 \u46020 \u51032  \u51076 \u51116 \u54616 \u49900 \u51004 \u47196  \u46168 \u51704  \u49457 \u51204 \u51032  \u50689 \u44305 \u51008  \u52395  \u49457 \u51204 \u51032  \u50689 \u44305 \u51012  \u45733 \u44032 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u51060 \u49828 \u46972 \u50648 \u51008  \u54616 \u45720 \u51060  \u51452 \u49888  \u49440 \u47932 \u51060 \u49888  \u44536 \u48516 \u51012  \u48176 \u52377 \u54616 \u50688 \u45796 . \u44536  \u44216 \u49552 \u54620  \u49440 \u49373 \u51060  \u44536 \u45216  \u54889 \u44552  \u47928 \u51012  \u53685 \u54616 \u50668  \u45208 \u50724 \u49900 \u51004 \u47196  \u44536  \u50689 \u44305 \u51008  \u49457 \u51204 \u50640 \u49436  \u50689 \u50896 \u55176  \u46496 \u45208  \u48260 \u47532 \u44256  \u47568 \u50520 \u45796 . \'93\u45320 \u55148  \u51665 \u51060  \u54889 \u54224 \u54616 \u50668  \u48260 \u47536  \u48148  \u46104 \u47532 \u46972 \'94 (\u47560  23:38) \u44256  \u54616 \u49888  \u44396 \u51452 \u51032  \u47568 \u50432 \u51008  \u51060 \u48120  \u49457 \u52712 \u46104 \u50632 \u45796 .\
