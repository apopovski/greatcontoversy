\uc0\u49483 \u51704  \u52380 \u49324 \u51032  \u44592 \u48324 \u51012  \u51204 \u54028 \u54616 \u45716  \u51068 \u50640  \u54801 \u47141 \u54616 \u45716  \u52380 \u49324 \u45716  \u44536  \u50689 \u44305 \u51004 \u47196  \u50728  \u49464 \u49345 \u51012  \u54872 \u54616 \u44172  \u54620 \u45796 . \u50728  \u49464 \u44228 \u51201  \u48276 \u50948 \u51032  \u49324 \u50629 \u51060  \u48708 \u49345 \u54620  \u45733 \u47141 \u51004 \u47196  \u49457 \u52712 \u46112  \u44163 \u51060  \u50668 \u44592 \u50640  \u50696 \u50616 \u46104 \u50612  \u51080 \u45796 . 1840\u45380 \u50640 \u49436  1844\u45380 \u44620 \u51648 \u51032  \u51116 \u47548 \u50868 \u46041 \u50640 \u45716  \u54616 \u45208 \u45784 \u51032  \u45733 \u47141 \u51060  \u50689 \u44305 \u49828 \u47101 \u44172  \u45208 \u53440 \u45228 \u45796 . \u52395 \u51704  \u52380 \u49324 \u51032  \u44592 \u48324 \u51008  \u49464 \u44228 \u51032  \u47784 \u46304  \u49440 \u44368 \u51648 \u50640 \u49436  \u51613 \u44144 \u46104 \u50632 \u45796 . \u44536 \u47532 \u44256  \u50612 \u46500  \u45208 \u46972 \u46308 \u50640 \u49436 \u45716  16\u49464 \u44592  \u51333 \u44368  \u44060 \u54785  \u51060 \u54980  \u50612 \u46500  \u44275 \u50640 \u49436  \u51080 \u50632 \u45912  \u44163 \u48372 \u45796  \u44032 \u51109  \u53360  \u51333 \u44368 \u51201  \u44033 \u49457 \u51060  \u51068 \u50612 \u45228 \u45796 . \u44536 \u47084 \u45208  \u49483 \u51704  \u52380 \u49324 \u51032  \u47560 \u51648 \u47561  \u44221 \u44256  \u50500 \u47000  \u51060 \u47336 \u50612 \u51656  \u53360  \u50868 \u46041 \u51008  \u44536 \u44163 \u48372 \u45796  \u55016 \u50476  \u45908  \u46832 \u50612 \u45216  \u44163 \u51060 \u45796 .\
\uc0\u44536  \u50868 \u46041 \u51008  \u50724 \u49692 \u51208 \u51032  \u50868 \u46041 \u44284  \u50976 \u49324 \u54624  \u44163 \u51060 \u45796 . \u48373 \u51020  \u49324 \u50629 \u51032  \u49884 \u52488 \u50640  \u44480 \u51473 \u54620  \u50472 \u50519 \u51032  \u48156 \u50500 \u47484  \u50948 \u54616 \u50668  \u49457 \u47161 \u51012  \u48512 \u50612 \u51452 \u49900 \u51004 \u47196  \u51060 \u47480 \u48708 \u47484  \u51452 \u49888  \u44163 \u52376 \u47100  \u44536  \u49324 \u50629 \u51032  \u51333 \u47568 \u50640 \u45716  \u45734 \u51008 \u48708 \u47484  \u51452 \u49492 \u49436  \u52628 \u49688 \u54624  \u44257 \u49885 \u51012  \u47924 \u47476 \u51061 \u44172  \u54616 \u49892  \u44163 \u51060 \u45796 . \'93\u44536 \u47084 \u48064 \u47196  \u50864 \u47532 \u44032  \u50668 \u54840 \u50752 \u47484  \u50508 \u51088  \u55192 \u50024  \u50668 \u54840 \u50752 \u47484  \u50508 \u51088  \u44536 \u51032  \u45208 \u50724 \u49900 \u51008  \u49352 \u48317 \u48731 \u44057 \u51060  \u51068 \u51221 \u54616 \u45768  \u48708 \u50752  \u44057 \u51060  \u46405 \u51012  \u51201 \u49884 \u45716  \u45734 \u51008 \u48708 \u50752  \u44057 \u51060  \u50864 \u47532 \u50640 \u44172  \u51076 \u54616 \u49884 \u47532 \u46972 \'94 (\u54840  6:3). \'93\u49884 \u50728 \u51032  \u51088 \u45376 \u46308 \u50500  \u45320 \u55148 \u45716  \u45320 \u55148  \u54616 \u45208 \u45784  \u50668 \u54840 \u50752 \u47196  \u51064 \u54616 \u50668  \u44592 \u48848 \u54616 \u47728  \u51600 \u44144 \u50892  \u54624 \u51648 \u50612 \u45796  \u44536 \u44032  \u45320 \u55148 \u47484  \u50948 \u54616 \u50668  \u48708 \u47484  \u45236 \u47532 \u49884 \u46104  \u51060 \u47480 \u48708 \u47484  \u45320 \u55148 \u50640 \u44172  \u51201 \u45817 \u54616 \u44172  \u51452 \u49884 \u47532 \u45768  \u51060 \u47480 \u48708 \u50752  \u45734 \u51008 \u48708 \u44032  \u51204 \u44284  \u44057 \u51012  \u44163 \u51060 \u46972 \'94 (\u50844  2:23). \'93\u47568 \u49464 \u50640  \u45236 \u44032  \u45236  \u50689 \u51004 \u47196  \u47784 \u46304  \u50977 \u52404 \u50640 \u44172  \u48512 \u50612 \u51452 \u47532 \u45768 \'94, \'93\u45572 \u44396 \u46304 \u51648  \u51452 \u51032  \u51060 \u47492 \u51012  \u48512 \u47476 \u45716  \u51088 \u45716  \u44396 \u50896 \u51012  \u50619 \u51004 \u47532 \u46972 \'94 (\u54665  2:17, 21).\
\uc0\u50948 \u45824 \u54620  \u48373 \u51020 \u51032  \u49324 \u50629 \u51008  \u44536  \u49884 \u52488 \u50640  \u45208 \u53440 \u45228 \u45912  \u54616 \u45208 \u45784 \u51032  \u45733 \u47141  \u47803 \u51648 \u50506 \u51008  \u53360  \u45733 \u47141 \u51060  \u45208 \u53440 \u45224 \u51004 \u47196  \u47560 \u52432 \u51648 \u44172  \u46112  \u44163 \u51060 \u45796 . \u48373 \u51020  \u49324 \u50629 \u51032  \u49884 \u52488 \u50640  \u51060 \u47480 \u48708 \u44032  \u45236 \u47548 \u51004 \u47196  \u49457 \u52712 \u46108  \u50696 \u50616 \u46308 \u51008  \u44536  \u49324 \u50629 \u51032  \u51333 \u47568 \u50640  \u45734 \u51008 \u48708 \u44032  \u45236 \u47548 \u51004 \u47196  \u45796 \u49884  \u49457 \u52712 \u46112  \u44163 \u51060 \u45796 . \u44536 \u47532 \u54616 \u50668  \u49324 \u46020  \u48288 \u46300 \u47196 \u44032  \u44592 \u45824 \u54664 \u45912  \'93\u50976 \u53132 \u54616 \u44172  \u46104 \u45716  \u45216 \'94 (\u54665  3:19) \u51060  \u51060 \u47484  \u44163 \u51060 \u45796 . \'93\u44536 \u47084 \u48064 \u47196  \u45320 \u55148 \u44032  \u54924 \u44060 \u54616 \u44256  \u46028 \u51060 \u53020  \u45320 \u55148  \u51396  \u50630 \u51060 \u54632 \u51012  \u48155 \u51004 \u46972  \u51060 \u44057 \u51060  \u54616 \u47732  \u50976 \u53132 \u54616 \u44172  \u46104 \u45716  \u45216 \u51060  \u51452  \u50526 \u51004 \u47196 \u48512 \u53552  \u51060 \u47484  \u44163 \u51060 \u50836  \u51452 \u44760 \u49436  \u45320 \u55148 \u47484  \u50948 \u54616 \u50668  \u50696 \u51221 \u54616 \u49888  \u44536 \u47532 \u49828 \u46020  \u44263  \u50696 \u49688 \u47484  \u48372 \u45236 \u49884 \u47532 \'94 (\u54665  3:20) \u46972 .\
\uc0\u54616 \u45208 \u45784 \u51032  \u51333 \u46308 \u51008  \u44144 \u47337 \u54620  \u54732 \u49888 \u51004 \u47196  \u48731 \u45208 \u44256  \u48157 \u51008  \u54364 \u51221 \u51012  \u50620 \u44404 \u50640  \u51667 \u44256 , \u54616 \u45720 \u50640 \u49436  \u50728  \u44592 \u48324 \u51012  \u49440 \u54252 \u54616 \u44592  \u50948 \u54616 \u50668  \u51060 \u44275 \u50640 \u49436  \u51200 \u44275 \u51004 \u47196  \u48516 \u51452 \u55176  \u50773 \u47000 \u54624  \u44163 \u51060 \u45796 . \u50728  \u49464 \u49345 \u51008  \u47924 \u49688 \u54620  \u51020 \u49457 \u51004 \u47196  \u44221 \u44256 \u47484  \u48155 \u51012  \u44163 \u51060 \u45796 . \u51060 \u51201 \u46308 \u51060  \u51068 \u50612 \u45208 \u44256 , \u48337 \u51088 \u46308 \u51060  \u44256 \u52840 \u51012  \u48155 \u44172  \u46112  \u44163 \u51060 \u47728 , \u54364 \u51201 \u44284  \u44592 \u49324 \u46308 \u51060  \u48127 \u45716  \u49324 \u46988 \u46308 \u50640 \u44172  \u46384 \u47484  \u44163 \u51060 \u45796 . \u49324 \u45800 \u46020  \u46608 \u54620  \u44144 \u51667  \u44592 \u49324 \u46308 \u51012  \u54665 \u54616 \u46104 , \u49900 \u51648 \u50612  \u49324 \u46988 \u46308 \u51032  \u45576 \u50526 \u50640 \u49436  \u48520 \u51060  \u54616 \u45720 \u47196 \u48512 \u53552  \u45236 \u47140 \u50724 \u44172 \u44620 \u51648  \u54624  \u44163 \u51060 \u45796  (\u44228  13:13 \u52280 \u51312 ). \u51060 \u47532 \u54616 \u50668  \u49464 \u49345 \u51032  \u44144 \u48124 \u46308 \u51008  \u44536 \u46308 \u51032  \u51077 \u51109 \u51012  \u48516 \u47749 \u55176  \u52712 \u54616 \u44172  \u46112  \u44163 \u51060 \u45796 .\
\uc0\u44592 \u48324 \u51008  \u48320 \u47200 \u51004 \u47196  \u51204 \u54644 \u51648 \u44592 \u48372 \u45796  \u54616 \u45208 \u45784 \u51032  \u50689 \u51032  \u44618 \u51008  \u44048 \u46041 \u51004 \u47196  \u51204 \u54644 \u51656  \u44163 \u51060 \u45796 . \u48320 \u47200 \u51004 \u47196 \u45716  \u48268 \u50024  \u51228 \u49884 \u46104 \u50632 \u45796 . \u50472 \u50519 \u51008  \u51060 \u48120  \u49100 \u47140 \u51276 \u51004 \u48064 \u47196  \u51060 \u51228 \u45716  \u44536 \u44163 \u51060  \u51088 \u46972 \u45208 \u49436  \u50676 \u47588 \u47484  \u47610 \u51012  \u44163 \u51060 \u45796 . \u49440 \u44368 \u51064 \u46308 \u50640  \u51032 \u54616 \u50668  \u51204 \u45804 \u46108  \u51064 \u49604 \u47932 \u46308 \u51008  \u44048 \u54868 \u47141 \u51012  \u48156 \u55064 \u54644  \u50772 \u45796 . \u44536 \u47084 \u45208  \u44048 \u46041 \u51012  \u48155 \u51008  \u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u51652 \u47532 \u47484  \u52649 \u48516 \u55176  \u51060 \u54644 \u54616 \u44144 \u45208  \u49692 \u51333 \u54616 \u45716  \u51068 \u50640  \u51109 \u50528 \u47484  \u48155 \u50500  \u50772 \u45796 . \u51060 \u51228 \u45716  \u48157 \u51008  \u44305 \u49440 \u51060  \u44033  \u44275 \u51004 \u47196  \u46763 \u44256  \u46308 \u50612 \u44032 \u49436  \u51652 \u47532 \u44032  \u48516 \u47749 \u54616 \u44172  \u46300 \u47084 \u45208 \u44172  \u46108 \u45796 . \u44536 \u47532 \u54616 \u50668  \u54616 \u45208 \u45784 \u51032  \u51221 \u51649 \u54620  \u51088 \u45376 \u46308 \u51008  \u44536 \u46308 \u51012  \u44208 \u48149 \u54616 \u44256  \u51080 \u45912  \u51460 \u51012  \u45130 \u50612  \u48260 \u47532 \u44172  \u46108 \u45796 . \u51060 \u51228 \u45716  \u54792 \u50672 \u44288 \u44228 , \u44368 \u54924  \u44288 \u44228 \u44032  \u44536 \u46308 \u51012  \u48537 \u46308 \u50612 \u46168  \u49688  \u50630 \u51012  \u51221 \u46020 \u47196  \u47924 \u47141 \u54644 \u51652 \u45796 . \u51652 \u47532 \u45716  \u45796 \u47480  \u50612 \u46500  \u44163 \u48372 \u45796  \u45908 \u50865  \u44480 \u51473 \u54616 \u45796 . \u50668 \u47084  \u44592 \u44288 \u46308 \u51060  \u51652 \u47532 \u47484  \u45824 \u51201 \u54616 \u44592  \u50948 \u54616 \u50668  \u44208 \u49549 \u54616 \u50688 \u51012 \u51648 \u46972 \u46020  \u47566 \u51008  \u49324 \u46988 \u46308 \u51060  \u51452 \u45784  \u54200 \u50640  \u49436 \u44172  \u46108 \u45796 .\
