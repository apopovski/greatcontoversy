\f1\b0 \cf0 \
\uc0\u50836 \u54620 \u44228 \u49884 \u47197  14\u51109 \u51008  \u52285 \u51312 \u51452 \u47484  \u44221 \u48176 \u54616 \u46972 \u44256  \u51064 \u47448 \u50640 \u44172  \u50836 \u44396 \u54632 \u44284  \u46041 \u49884 \u50640  \u44536  \u50696 \u50616 \u51008  \u49340 \u51473  \u44592 \u48324 \u51032  \u44208 \u44284 \u47196 \u49436  \u54616 \u45208 \u45784 \u51032  \u44228 \u47749 \u51012  \u51648 \u53412 \u45716  \u54620  \u45800 \u52404 \u47484  \u48372 \u50668  \u51456 \u45796 . \u44536  \u44228 \u47749  \u51473 \u51032  \u54616 \u45208 \u45716  \u54616 \u45208 \u45784 \u44760 \u49436  \u52285 \u51312 \u51452  \u46104 \u49900 \u51012  \u51649 \u51217 \u51201 \u51004 \u47196  \u50508 \u47140  \u51456 \u45796 . \u45367 \u51704  \u44228 \u47749 \u51008  \'93\u51228 \u52832 \u51068 \u51008  \u45320 \u51032  \u54616 \u45208 \u45784  \u50668 \u54840 \u50752 \u51032  \u50504 \u49885 \u51068 \u51064 \u51593 \'85\u51060 \u45716  \u50687 \u49352  \u46041 \u50504 \u50640  \u45208  \u50668 \u54840 \u50752 \u44032  \u54616 \u45720 \u44284  \u46405 \u44284  \u48148 \u45796 \u50752  \u44536  \u44032 \u50868 \u45936  \u47784 \u46304  \u44163 \u51012  \u47564 \u46308 \u44256  \u51228 \u52832 \u51068 \u50640  \u49772 \u50632 \u51020 \u51060 \u46972  \u44536 \u47084 \u48064 \u47196  \u45208  \u50668 \u54840 \u50752 \u44032  \u50504 \u49885 \u51068 \u51012  \u48373 \u46104 \u44172  \u54616 \u50668  \u44536 \u45216 \u51012  \u44144 \u47337 \u54616 \u44172  \u54616 \u50688 \u45712 \u45768 \u46972 \'94 (\u52636 20:10, 11) \u44256  \u47568 \u54620 \u45796 . \u46608 \u54620  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u50504 \u49885 \u51068 \u50640  \u44288 \u54616 \u50668  \'93\u51060 \u44163 \u51060 \'85\u54364 \u51669 \u51060  \u46104 \u50612  \u45320 \u55148 \u47196  \u45236 \u44032  \u50668 \u54840 \u50752  \u45320 \u55148  \u54616 \u45208 \u45784 \u51064  \u51460  \u50508 \u44172  \u54616 \u47532 \u46972 \'94 (\u44180  20:20) \u44256  \u47568 \u50432 \u54616 \u49888 \u45796 . \u44536 \u47532 \u44256  \u44536  \u51060 \u50976 \u50640  \u45824 \u54616 \u50668  \'93\u45208  \u50668 \u54840 \u50752 \u44032  \u50687 \u49352  \u46041 \u50504 \u50640  \u52380 \u51648 \u47484  \u52285 \u51312 \u54616 \u44256  \u51228 \u52832 \u51068 \u50640  \u49772 \u50612  \u54217 \u50504 \u54616 \u50688 \u51020 \u51060 \u45768 \u46972 \'94 (\u52636  31:17) \u44256  \u54620 \u45796 .\
\'93\uc0\u52285 \u51312 \u51032  \u44592 \u45392 \u51068 \u47196 \u49436 \u51032  \u50504 \u49885 \u51068 \u51032  \u51473 \u50836 \u49457 \u51008  \u44536 \u45216 \u51060  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u52285 \u51312 \u51452 \u44032  \u46104 \u49884 \u44256  \u50864 \u47532 \u45716  \u44536 \u48516 \u51032  \u54588 \u51312 \u47932 \u51060  \u46104 \u44592  \u46412 \u47928 \u50640  \u50864 \u47532 \u44032  \u54616 \u45208 \u45784 \u44760  \u50696 \u48176 \u47484  \u46300 \u47140 \u50556  \u54620 \u45796 \u45716  \u44163 \u51012  \u54637 \u49345  \u44032 \u47476 \u52432  \u51452 \u45716  \u45936  \u51080 \u45796 .\'94 \'93\u44536 \u47084 \u48064 \u47196  \u50504 \u49885 \u51068 \u51008  \u54616 \u45208 \u45784 \u51012  \u50696 \u48176 \u54616 \u45716  \u48148 \u47196  \u44592 \u52488 \u44032  \u46108 \u45796 . \u50780 \u45264 \u54616 \u47732  \u44536 \u44163 \u51060  \u51060  \u50948 \u45824 \u54620  \u51652 \u47532 \u47484  \u44032 \u51109  \u44048 \u47749 \u51201 \u51004 \u47196  \u44032 \u47476 \u52432  \u51452 \u44256  \u44536  \u48150 \u51032  \u45796 \u47480  \u51228 \u46020 \u45716  \u51060 \u50752  \u44057 \u51060  \u44032 \u47476 \u52432  \u51452 \u45716  \u44163 \u51060  \u50630 \u44592  \u46412 \u47928 \u51060 \u45796 . \u51228 \u52832 \u51068 \u51032  \u50696 \u48176 \u49104  \u50500 \u45768 \u46972  \u47784 \u46304  \u50696 \u48176 \u51032  \u51652 \u51221 \u54620  \u44592 \u52488 \u45716  \u52285 \u51312 \u51452 \u50752  \u54588 \u51312 \u47932 \u51012  \u44396 \u48324 \u54616 \u45716  \u45936 \u49436  \u45208 \u53440 \u45208 \u44172  \u46108 \u45796 . \u51060  \u53360  \u51652 \u47532 \u45716  \u44208 \u53076  \u54224 \u54624  \u49688  \u50630 \u51012  \u49104  \u50500 \u45768 \u46972  \u51082 \u50612 \u48260 \u47140 \u49436 \u46020  \u50504  \u46108 \u45796 \'94 (J.N.Andrews, History of the Sabbath, Chap.27). \u54616 \u45208 \u45784 \u44760 \u49436  \u50640 \u45940 \u46041 \u49328 \u50640 \u49436  \u50504 \u49885 \u51068 \u51012  \u51228 \u51221 \u54616 \u49888  \u44163 \u51008  \u51060  \u51652 \u47532 \u47484  \u54637 \u49345  \u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u50640  \u44036 \u51649 \u54616 \u44172  \u54616 \u49884 \u44256 \u51088  \u54632 \u51060 \u50632 \u45796 . \u44536 \u47532 \u44256  \u54616 \u45208 \u45784 \u44760 \u49436  \u50864 \u47532 \u51032  \u52285 \u51312 \u51452 \u49884 \u48064 \u47196 , \u50864 \u47532 \u44032  \u44536 \u48516 \u51012  \u44221 \u48176 \u54644 \u50556  \u54620 \u45796 \u45716  \u51652 \u47532 \u44032  \u51316 \u49549 \u54616 \u45716  \u54620  \u50504 \u49885 \u51068 \u46020  \u46608 \u54620  \u44536  \u51613 \u44144 \u50752  \u44592 \u45392 \u51004 \u47196  \u51316 \u49549 \u46104 \u50612 \u50556  \u54620 \u45796 . \u47564 \u51068  \u51064 \u47448 \u44032  \u50724 \u45720 \u45216 \u44620 \u51648  \u50504 \u49885 \u51068 \u51012  \u51648 \u53020  \u50772 \u51012  \u44163  \u44057 \u51004 \u47732  \u44536 \u46308 \u51032  \u49373 \u44033 \u44284  \u50528 \u51221 \u51060  \u52285 \u51312 \u51452 \u44760  \u51665 \u51473 \u46104 \u50612  \u51452 \u45784 \u44760 \u49436 \u45716  \u51316 \u44221 \u44284  \u50696 \u48176 \u51032  \u45824 \u49345 \u51060  \u46104 \u49512 \u51012  \u44163 \u51060 \u47728  \u50864 \u49345 \u49709 \u48176 \u50752  \u47924 \u49888 \u47200 \u51088 \u50752  \u54924 \u51032 \u47200 \u51088 \u44032  \u44208 \u53076  \u49373 \u44200 \u45208 \u51648  \u50506 \u50520 \u51012  \u44163 \u51060 \u45796 . \u50504 \u49885 \u51068  \u51456 \u49688 \u45716  \'93\u54616 \u45720 \u44284  \u46405 \u44284  \u48148 \u45796 \u50752  \u47932 \u46308 \u51032  \u44540 \u50896 \u51012  \u47564 \u46300 \u49888 \'94 \u52280  \u54616 \u45208 \u45784 \u44760  \u45824 \u54620  \u52649 \u49457 \u51032  \u54364 \u51060 \u45796 . \u44536 \u47084 \u48064 \u47196  \u54616 \u45208 \u45784 \u51012  \u44221 \u48176 \u54616 \u44256  \u44536 \u48516 \u51032  \u44228 \u47749 \u51012  \u51648 \u53412 \u46972 \u44256  \u47749 \u47161 \u54616 \u45716  \u44592 \u