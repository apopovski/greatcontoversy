\'93\uc0\u46608  \u47560 \u55124 \u46160  \u45804  \u51068 \u54624  \u44428 \u49464 \u47484  \u48155 \u51004 \u45768 \u46972 .\'94 \u44536 \u47532 \u44256  \u49440 \u51648 \u51088 \u45716  \'93\u44536 \u51032  \u47672 \u47532  \u54616 \u45208 \u44032  \u49345 \u54616 \u50668  \u51453 \u44172  \u46108  \u44163  \u44057 \u45908 \u45768 \'94\u46972 \u44256  \u47568 \u54620 \u45796 . \u44536 \u45716  \'93\u49324 \u47196 \u51105 \u45716  \u51088 \u45716  \u49324 \u47196 \u51105 \u55184  \u44163 \u51060 \u50836  \u52860 \u47196  \u51453 \u51060 \u45716  \u51088 \u45716  \u51088 \u44592 \u46020  \u47560 \u46405 \u55176  \u52860 \u50640  \u51453 \u51004 \u47532 \'94\u46972 \u44256  \u54616 \u50688 \u45796 . \u47560 \u55124 \u46160  \u45804 \u51008  \u45796 \u45768 \u50648 \u49436  7\u51109 \u50640  \u51080 \u45716  \'93\u54620  \u46412 \u50752  \u46160  \u46412 \u50752  \u48152  \u46412 \'94, \u44263  \u49340 \u45380  \u48152 , 1260\u51068 \u44284  \u44057 \u51008  \u44592 \u44036 \u51004 \u47196 \u49436  \u44536 \u44163 \u51008  \u48277 \u50773 \u44428 \u51060  \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u51012  \u54605 \u48149 \u54620  \u44592 \u44036 \u51060 \u45796 . \u44536  \u44592 \u44036 \u51008  \u51204 \u51109  (\u21069 \u31456 ) \u46308 \u50640 \u49436  \u51060 \u48120  \u47568 \u54620  \u48148 \u50752  \u44057 \u51060  \u48277 \u50773 \u44428 \u51060  \u52572 \u49345 \u44428 \u51012  \u51105 \u51008  \u49436 \u44592  538\u45380 \u48512 \u53552  1798\u45380 \u44620 \u51648 \u51032  \u44592 \u44036 \u51060 \u45796 . 1798\u45380 \u50640  \u48277 \u50773 \u51060  \u54532 \u46993 \u49828 \u44400 \u50640 \u44172  \u49324 \u47196 \u51105 \u54784  \u48277 \u50773 \u44428 \u51008  \u52824 \u47749 \u49345 \u51012  \u51077 \u50632 \u51004 \u48064 \u47196  \'93\u49324 \u47196 \u51105 \u45716  \u51088 \u45716  \u49324 \u47196 \u51105 \u55184  \u44163 \u51060 \'94\u46972 \u45716  \u50696 \u50616 \u51060  \u49457 \u52712 \u46104 \u50632 \u45796 .\
