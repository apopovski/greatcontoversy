\uc0\u51116 \u47548 \u51032  \u49884 \u44592 \u47484  \u44032 \u51109  \u48516 \u47749 \u55176  \u44228 \u49884 \u54644 \u51452 \u45716  \u44163 \u52376 \u47100  \u48372 \u51060 \u45716  \u50696 \u50616 \u51008  \u45796 \u45768 \u50648 \u49436  8\u51109  14\u51208 \u51060 \u50632 \u45796 . \'93\u51060 \u52380 \u49340 \u48177  \u51452 \u50556 \u44620 \u51648 \u45768  \u44536  \u46412 \u50640  \u49457 \u49548 \u44032  \u51221 \u44208 \u54616 \u44172  \u54632 \u51012  \u51077 \u51004 \u47532 \u46972 .\'94 \u48128 \u47084 \u45716  \u49457 \u44221  \u47568 \u50432  \u51088 \u52404 \u44032  \u54644 \u49437 \u54644  \u51452 \u45716  \u48277 \u52825 \u50640  \u51032 \u54616 \u50668 , \u50696 \u50616 \u49345  \u54616 \u47336 \u45716  1\u45380 \u51012  \u49345 \u51669  (\u35937 \u24501 ) \u54616 \u45716  \u44163 \u51076 \u51012  \u50508 \u50520 \u45796  (\u48124  14:34; \u44180  4:6 \u52280 \u51312 ). \u44536 \u45716  \u46608 \u54620  2300\u51068 , \u44263  \u49892 \u51228 \u51201 \u51064  2300\u45380 \u51060  \u50976 \u45824 \u51064 \u51032  \u49884 \u45824 \u47484  \u55016 \u50476  \u51648 \u45208 \u45716  \u44163 \u51060 \u48064 \u47196  \u44536 \u44163 \u51060  \u44536  \u44592 \u44036 \u51032  \u49457 \u49548 \u47484  \u44032 \u47532 \u53412 \u45716  \u44163 \u51060  \u50500 \u45784 \u51012  \u50508 \u44172  \u46104 \u50632 \u45796 . \u44536 \u47088 \u45936  \u48128 \u47084 \u45716  \u44536 \u47532 \u49828 \u46020 \u44368  \u49884 \u45824 \u50640  \u51080 \u50612 \u49436  \u51060  \u49464 \u49345 \u51060  \u49457 \u49548 \u46972 \u45716  \u51068 \u48152 \u51201 \u51064  \u44204 \u54644 \u47484  \u48155 \u50500 \u46308 \u51076 \u51004 \u47196  \u45796 \u45768 \u50648 \u49436  8\u51109  14\u51208 \u50640  \u50696 \u50616 \u46108  \u49457 \u49548 \u51032  \u51221 \u44208 \u51012  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u51116 \u47548 \u54616 \u49892  \u46412 \u50640  \u51060  \u51648 \u44396 \u44032  \u48520 \u47196  \u51221 \u44208 \u52992  \u46104 \u45716  \u44163 \u51012  \u51032 \u48120 \u54616 \u45716  \u44163 \u51060 \u46972 \u44256  \u54644 \u49437 \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u45716  2300\u51068 \u51032  \u51221 \u54869 \u54620  \u44592 \u49328 \u51216 \u47564  \u48156 \u44204 \u54624  \u44163  \u44057 \u51004 \u47732  \u44536 \u47532 \u49828 \u46020 \u51032  \u51116 \u47548 \u51032  \u46412 \u47484  \u49789 \u44172  \u54869 \u51221 \u54624  \u49688  \u51080 \u45796 \u44256  \u44208 \u47200 \u51648 \u50632 \u45796 . \u44536 \u45716  \u44536  \u53360  \u51333 \u47568 \u51032  \u46412 , \u44263  \'93\u47784 \u46304  \u44368 \u47564 , \u44428 \u49464 , \u49324 \u52824 , \u54728 \u50689 , \u49324 \u50501 , \u50613 \u50517  \u46321 \u51060  \u45149 \u45208 \u45716  \u46412 , \u51200 \u51452 \u44032  \u51060  \u46405 \u50640 \u49436  \u49324 \u46972 \u51648 \u44256  \u49324 \u47581 \u51060  \u50630 \u50612 \u51648 \u44256  \u54616 \u45208 \u45784 \u51032  \u51333 \u46308 \u44284  \u49440 \u51648 \u51088 \u46308 \u44284  \u49457 \u46020 \u46308 \u44284 , \u44144 \u47337 \u54616 \u49888  \u54616 \u45208 \u45784 \u51032  \u51060 \u47492 \u51012  \u46160 \u47140 \u50892 \u54616 \u45716  \u47784 \u46304  \u49324 \u46988 \u46308 \u51060  \u49345 \u44553 \u51012  \u48155 \u44256  \u49464 \u49345 \u51012  \u47736 \u47581 \u49884 \u53412 \u45716  \u51088 \u46308 \u51032  \u47736 \u47581 \u45817 \u54616 \u45716  \u46412 \u44032  \u54869 \u49892 \u55176  \u50508 \u47140 \u51648 \u44172  \u46112  \u44163 \u51060 \u46972 \u44256  \u49373 \u44033 \u54616 \u50688 \u45796 \'94 (S.Bliss, Memoirs of Wm.Miller, p.76).\
\uc0\u48128 \u47084 \u45716  \u49352 \u47213 \u44256  \u45908 \u50865  \u44618 \u51008  \u50676 \u49457 \u51012  \u44032 \u51648 \u44256  \u50696 \u50616 \u51012  \u44228 \u49549 \u54644 \u49436  \u50672 \u44396 \u54616 \u50688 \u45796 . \u44536 \u45716  \u48164 \u45230 \u51012  \u44032 \u47532 \u51648  \u50506 \u44256  \u50628 \u52397 \u45208 \u44172  \u51473 \u50836 \u54620  \u44536  \u50672 \u44396 \u50640  \u47792 \u46160 \u46104 \u50612  \u48260 \u47160 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u45796 \u45768 \u50648 \u49436  8\u51109 \u50640 \u49436  2300\u51068 \u51032  \u44592 \u49328 \u51216 \u50640  \u44288 \u54620  \u50500 \u47924 \u47088  \u45800 \u49436  (\u31471 \u32214 ) \u46020  \u48156 \u44204 \u54624  \u49688  \u50630 \u50632 \u45796 . \u52380 \u49324  \u44032 \u48652 \u47532 \u50648 \u51060  \u45796 \u45768 \u50648 \u50640 \u44172  \u44536  \u51060 \u49345  (\u30064 \u20687 ) \u51012  \u50508 \u47140  \u51452 \u46972 \u45716  \u47749 \u47161 \u51012  \u48155 \u50520 \u51004 \u45208 , \u44536 \u45716  \u45796 \u45768 \u50648 \u50640 \u44172  \u44536  \u51068 \u48512 \u51032  \u54644 \u49437 \u47564 \u51012  \u50508 \u47140 \u51452 \u50632 \u45796 . \u44368 \u54924 \u50640  \u50628 \u49845 \u54624  \u47924 \u49436 \u50868  \u48149 \u54644 \u44032  \u45796 \u45768 \u50648 \u51032  \u44228 \u49884 \u50640  \u45208 \u53440 \u45228 \u51012  \u46412  \u44536 \u45716  \u50977 \u49888 \u51032  \u44592 \u47141 \u51012  \u51075 \u50612 \u48260 \u47160 \u45796 . \u44536 \u44032  \u44536  \u51060 \u49345  \u45908  \u44204 \u46364  \u49688  \u50630 \u44172  \u46104 \u51088  \u52380 \u49324 \u45716  \u50620 \u47560  \u46041 \u50504  \u44536 \u50640 \u44172 \u49436  \u46496 \u45208 \u44052 \u45796 . \'93\u45796 \u45768 \u50648 \u51060  \u54844 \u51208 \u54616 \u50668  \u49688 \u51068 \u51012  \u50515 \u45796 \u44032  \u51068 \u50612 \u45208 \u49436 \'85\u44536  \u51060 \u49345 \u51012  \u51064 \u54616 \u50668  \u45440 \u46992 \u44256  \u44536  \u46907 