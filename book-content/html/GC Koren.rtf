\uc0\u47336 \u53552 \u51032  \u44032 \u47476 \u52840 \u51008  \u45348 \u45916 \u46976 \u46300 \u50640 \u49436  \u51096  \u51088 \u46980  \u49688  \u51080 \u45716  \u46405 \u51012  \u48156 \u44204 \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44144 \u44592 \u49436  \u50676 \u49457  \u51080 \u44256  \u52649 \u49457 \u46108  \u49324 \u46988 \u46308 \u51060  \u48373 \u51020 \u51012  \u49440 \u54252 \u54616 \u44592  \u50948 \u54616 \u50668  \u51068 \u50612 \u45228 \u45796 . \u45348 \u45916 \u46976 \u46300 \u51032  \u54620  \u51648 \u48169 \u50640 \u49436  \u47700 \u45432  \u49884 \u47788 \u49828  (Menno Simons) \u44032  \u51068 \u50612 \u45228 \u45796 . \u44536 \u45716  \u50896 \u47000  \u47196 \u47560  \u52380 \u51452 \u44368 \u51032  \u44368 \u50977 \u51012  \u48155 \u44256  \u49888 \u48512 \u47196  \u51076 \u47749 \u51012  \u48155 \u51008  \u49324 \u46988 \u51060 \u50632 \u51004 \u48064 \u47196  \u49457 \u44221 \u50640  \u45824 \u54616 \u50668 \u45716  \u51204 \u50672  \u47924 \u51648 \u54624  \u49104  \u50500 \u45768 \u46972 , \u51060 \u45800 \u50640  \u48120 \u54841 \u46112 \u44620  \u46160 \u47140 \u50892 \u49436  \u44536 \u44163 \u51012  \u51069 \u50612  \u48380  \u47560 \u51020 \u51312 \u52264  \u44054 \u51648  \u50506 \u50520 \u45796 . \u44536 \u47084 \u48064 \u47196  \u54868 \u52404 \u49444  (\u21270 \u39636 \u35498 ) \u51032  \u44368 \u47532 \u50640  \u45824 \u54616 \u50668  \u51032 \u54841 \u51060  \u49373 \u44220 \u51012  \u46412 \u50640 , \u44536 \u45716  \u44536 \u44163 \u51012  \u49324 \u45800 \u51032  \u50976 \u54841 \u51060 \u46972  \u54616 \u50668  \u44592 \u46020 \u47484  \u54616 \u44256  \u44256 \u48177 \u51012  \u54632 \u51004 \u47196 \u50024  \u44536  \u47928 \u51228 \u50640 \u49436  \u45459 \u50668 \u45208 \u44256 \u51088  \u45432 \u47141 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u44163 \u51008  \u54747 \u49688 \u44256 \u50640  \u48520 \u44284 \u54664 \u45796 . \u44536 \u47084 \u48064 \u47196  \u44536 \u45716  \u48169 \u53461 \u54620  \u45936  \u48736 \u51256 \u49436  \u50577 \u49900 \u51032  \u49548 \u47532 \u47484  \u49548 \u47736 \u54616 \u47140  \u54616 \u50688 \u51004 \u45208  \u44536 \u44163 \u46020  \u46608 \u54620  \u54747 \u49688 \u44256 \u50640  \u48520 \u44284 \u54616 \u50688 \u45796 . \u50620 \u47560  \u54980 \u50640  \u44536 \u45716  \u49888 \u50557  \u49457 \u44221 \u51012  \u50672 \u44396 \u54616 \u44172  \u46104 \u44256 , \u47336 \u53552 \u51032  \u51200 \u49436 \u47484  \u51069 \u51020 \u51004 \u47196  \u44060 \u54785 \u54028 \u51032  \u49888 \u50521 \u51012  \u48155 \u50500 \u46308 \u51060 \u44172  \u46104 \u50632 \u45796 . \u44536  \u54980  \u50724 \u47000 \u51648  \u50500 \u45768 \u54616 \u50668  \u44536 \u45716  \u44032 \u44620 \u50868  \u52492 \u46973 \u50640 \u49436  \u51116 \u52840 \u47168 \u47484  \u48155 \u51008  \u44620 \u45805 \u51004 \u47196  \u52280 \u54805  (\u26028 \u21009 ) \u51012  \u45817 \u54616 \u45716  \u44163 \u51012  \u47785 \u44201 \u54616 \u50688 \u45796 . \u44536 \u44163 \u51060  \u46041 \u44592 \u44032  \u46104 \u50612  \u44536 \u45716  \u50976 \u50500  \u49464 \u47168 \u50640  \u44288 \u54616 \u50668  \u49457 \u44221 \u51012  \u50672 \u44396 \u54616 \u44172  \u46104 \u50632 \u45796 . \u44536 \u45716  \u49457 \u44221 \u50640 \u49436  \u50976 \u50500  \u49464 \u47168 \u50640  \u45824 \u54620  \u51613 \u44144 \u47484  \u51204 \u54784  \u52286 \u51012  \u49688  \u50630 \u50632 \u45796 . \u44536 \u50752  \u48152 \u47732 \u50640  \u44536 \u45716  \u50612 \u46356 \u50640 \u45208  \u52840 \u47168 \u47484  \u48155 \u45716  \u51312 \u44148 \u51004 \u47196  \u54924 \u44060 \u50752  \u48127 \u51020 \u51060  \u50836 \u44396 \u46104 \u44256  \u51080 \u45796 \u45716  \u44163 \u51012  \u44648 \u45804 \u50520 \u45796 .\
\uc0\u47700 \u45432 \u45716  \u47196 \u47560 \u44368 \u47484  \u48260 \u47532 \u44256  \u51088 \u44592 \u44032  \u48155 \u50500 \u46308 \u51064  \u51652 \u47532 \u47484  \u44032 \u47476 \u52824 \u45716  \u51068 \u50640  \u44536 \u51032  \u49373 \u50528 \u47484  \u48148 \u52452 \u45796 . \u51060 \u48120  \u46021 \u51068 \u44284  \u45348 \u45916 \u46976 \u46300 \u50640 \u45716  \u44305 \u49888 \u51088 \u51032  \u47924 \u47532 \u44032  \u51068 \u50612 \u45208  \u48708 \u54633 \u47532 \u51201 \u51060 \u50836  \u49440 \u46041 \u51201 \u51064  \u44368 \u47532 \u47484  \u51452 \u51109 \u54616 \u50668  \u51656 \u49436 \u50752  \u54413 \u44592 \u47484  \u47928 \u46976 \u52992  \u54616 \u44256  \u54253 \u46041 \u44284  \u47784 \u48152 \u51012  \u51068 \u51004 \u53040 \u45796 . \u47700 \u45432 \u45716  \u51060 \u47084 \u54620  \u50868 \u46041 \u51060  \u54596 \u50672 \u51201 \u51004 \u47196  \u51068 \u51004 \u53420  \u46160 \u47140 \u50868  \u44208 \u44284 \u47484  \u50508 \u44256  \u44305 \u49888 \u51088 \u46308 \u51032  \u44536 \u47495 \u46108  \u44368 \u47532 \u50752  \u47924 \u47784 \u54620  \u48169 \u48277 \u50640  \u45824 \u54616 \u50668  \u51460 \u44592 \u52264 \u44172  \u48152 \u45824 \u54616 \u50688 \u45796 . \u44536 \u47088 \u45936  \u51060 \u47084 \u54620  \u44305 \u49888 \u51088 \u46308 \u50640 \u44172  \u48120 \u54841 \u46104 \u50632 \u45796 \u44032  \u54980 \u50640  \u44536  \u50976 \u54644 \u54620  \u44368 \u47532 \u47484  \u48260 \u47536  \u49324 \u46988 \u46308 \u46020  \u47566 \u50520 \u44256  \u46608 \u54620  \u50715 \u45216 \u51032  \u44536 \u47532 \u49828 \u46020 \u51064 , \u44263  \u50760 \u45940 \u49828 \u51064 \u46308 \u51032  \u44368 \u54984 \u51032  \u50676 \u47588 \u46308 \u46020  \u50668 \u51204 \u55176  \u47566 \u51060  \u45224 \u50500  \u51080 \u50632 \u45796 . \u47700 \u45432 \u45716  \u44536 \u47084 \u54620  \u49324 \u46988 \u46308 \u51012  \u45824 \u49345 \u51004 \u47196  \u47588 \u50864  \u50676 \u47148 \u54616 \u44172  \u51068 \u54620  \u44208 \u44284  \u49457 \u44277 \u51012  \u44144 \u46160 \u50632 \u45796 .\
\uc0\u44536 \u45716  \u48512 \u51064 \u44284  \u51088 \u45376 \u46308 \u51012  \u45936 \u47532 \u44256  25\u45380 \u44036  \u50668 \u54665 \u51012  \u54616 \u50688 \u45796 . \u44536  \u46041 \u50504 \u50640  \u44536 \u45716  \u49900 \u54620  \u44256 \u45212 \u44284  \u48712 \u44417 \u51012  \u52280 \u44256  \u44204 \u46356 \u50632 \u51004 \u47728 , \u46412 \u47196 \u45716  \u49373 \u47749 \u51032  \u50948 \u54801 \u51012  \u45817 \u54616 \u44592 \u46020  \u54616 \u50688 \u45796 . \u44536 \u45716  \u45348 \u45916 \u46976 \u46300 \u50752  \u48513 \u48512  \u46021 \u51068 \u51012  \u46160 \u47336  \u45796 \u45768 \u47732 \u49436  \u51452 \u47196  \u54616 \u47448  \u44228 \u44553 \u51012  \u49345 \u45824 \u47196  \u54876 \u46041 \u54616 \u50688 \u51004 \u47728  \u44536  \u44048 \u54868 \u45716  \u47680 \u47532 \u44620 \u51648  \u48120 \u52452 \u45796 . \u51228 \u54620 \u46108  \u44368 \u50977 \u48150 \u50640  \u48155 \u51648  \u50506 \u50520 \u51004 \u45208  \u49440 \u52380 \u51201 \u51004 \u47196  \u50885 \u48320 \u51201 \u51060 \u50632 \u45912  \u44536 \u45716  \u48520 \u44404 \u51032  \u49457 \u49892 \u49457 \u44284  \u44216 \u49552 \u54620  \u51221 \u49888 \u44284  \u52828 \u51208 \u54620  \u53468 \u46020 \u50752  \u51652 \u49892 \u54616 \u44256  \u50676 \u47148 \u54620  \u48127 \u51020 \u51012  \u44032 \u51652  \u49324 \u46988 \u51060 \u50632 \u51004 \u47728 , \u51088 \u44592 \u51032  \u44368 \u54984 \u51012  \u51088 \u49888 \u51032  \u49373 \u54876 \u47196 \u50024  \u49892 \u51613 \u54616 \u50688 \u45796 . \u44536 \u47084 \u48064 \u47196  \u44536 \u45716  \u49324 \u46988 \u46308 \u51032  \u49888 \u51076 \u51012  \u50619 \u50632 \u45796 . \u44536 \u47484  \u46384 \u47476 \u45716  \u49324 \u46988 \u46308 \u51008  \u44033  \u44275 \u51004 \u47196  \u51923 \u44200 \u45208 \u49436  \u50517 \u48149 \u51012  \u48155 \u50520 \u45796 . \u44536 \u46308 \u51008  \u48012 \u49828 \u53552 \u51064  (Mu..nsterites) \u51060 \u46972 \u45716  \u44305 \u49888 \u51088 \u46308 \u51032  \u47924 \u47532 \u50752  \u46041 \u51068 \u54616 \u44172  \u52712 \u44553 \u46104 \u50612  \u53356 \u44172  \u50612 \u47140 \u50880 \u51012  \u45817 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u47566 \u51008  \u49324 \u46988 \u51060  \u44536 \u51032  \u54876 \u46041 \u51004 \u47196  \u47568 \u48120 \u50516 \u50500  \u54924 \u44060 \u54616 \u50688 \u45796 .\
