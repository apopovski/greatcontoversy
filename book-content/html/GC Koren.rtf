\uc0\u48372 \u50864 \u46020 \u48400  [\u48372 \u50864 \u46020 \u48400 \u45716  \u49828 \u50948 \u49828 \u51032  \u54620  \u51648 \u48169  \u51060 \u47492 \u51004 \u47196 , \u50668 \u44592 \u49436 \u45716  \u44144 \u44592  \u49332 \u45912  \u50760 \u45940 \u49828 \u44368 \u46020 \u46308 \u51012  \u44032 \u47532 \u53412 \u45716  \u47568 \u51060 \u45796 . \'97 \u50669 \u51088  \u51452 ] \u51064 \u46308 \u51032  \u47784 \u46304  \u44368 \u54924 \u45716  \u49692 \u44208 \u54616 \u44256  \u45800 \u49692 \u54620  \u51216 \u50640 \u49436  \u49324 \u46020  \u49884 \u45824 \u51032  \u44368 \u54924 \u50752  \u48708 \u49847 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u48277 \u50773 \u44284  \u51452 \u44368 \u46308 \u51032  \u52572 \u49345 \u44428 \u51012  \u48512 \u51064 \u54616 \u44256 , \u49457 \u44221 \u47564 \u51060  \u44032 \u51109  \u45458 \u44256  \u53952 \u47548 \u50630 \u45716  \u44428 \u50948 \u47484  \u44032 \u51648 \u44256  \u51080 \u45796 \u44256  \u51452 \u51109 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51032  \u47785 \u49324 \u46308 \u51008  \u44144 \u47564 \u54620  \u47196 \u47560 \u44368 \u51032  \u49849 \u47140 \u46308 \u44284 \u45716  \u45804 \u47532 , \u49452 \u44608 \u51012  \u48155 \u51004 \u47140  \u54632 \u51060  \u50500 \u45768 \u46972  \u46020 \u47532 \u50612  \u49452 \u44592 \u47140  \u54616 \u49888  \u51452 \u45784 \u51032  \u47784 \u48376 \u51012  \u46384 \u46992 \u45796 . \u44536 \u46308 \u51008  \u54616 \u45208 \u45784 \u51032  \u50577 \u46524 \u47484  \u54392 \u47480  \u54400 \u48173 \u44284  \u54616 \u45208 \u45784 \u51032  \u44144 \u47337 \u54620  \u47568 \u50432 \u51032  \u49368 \u53552 \u47196  \u51064 \u46020 \u54616 \u50668  \u47673 \u50688 \u45796 . \u44536 \u46308 \u51008  \u51064 \u44036 \u51032  \u54728 \u50689 \u44284  \u54868 \u47140 \u54620  \u44368 \u47564 \u51012  \u45208 \u53440 \u45236 \u45716  \u44144 \u45824 \u54620  \u44368 \u54924 \u45817 \u51060 \u45208  \u44361 \u51109 \u54620  \u49688 \u46020 \u50896  \u45824 \u4