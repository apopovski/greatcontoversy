\f1\b0 \cf0 \
\uc0\u44536 \u47532 \u54616 \u50668  \u49352  \u50616 \u50557 \u51032  \u50557 \u49549 \u51060  \u50756 \u51204 \u55176  \u49457 \u52712 \u46112  \u44163 \u51060 \u45796 . \'93\u45236 \u44032  \u44536 \u46308 \u51032  \u51396 \u50501 \u51012  \u49324 \u54616 \u44256  \u45796 \u49884 \u45716  \u44536  \u51396 \u47484  \u44592 \u50613 \u51648  \u50500 \u45768 \u54616 \u47532 \u46972 \'94 (\u47128  31:34), \'93\u44536 \u45216  \u44536  \u46412 \u50640 \u45716  \u51060 \u49828 \u46972 \u50648 \u51032  \u51396 \u50501 \u51012  \u52286 \u51012 \u51648 \u46972 \u46020  \u50630 \u44192 \u44256  \u50976 \u45796 \u51032  \u51396 \u47484  \u52286 \u51012 \u51648 \u46972 \u46020  \u48156 \u44204 \u52824  \u47803 \u54616 \u47532 \u45768  \u51060 \u45716  \u45236 \u44032  \u45208 \u51032  \u45224 \u44596  \u51088 \u47484  \u49324 \u54624  \u44163 \u51076 \u51060 \u45768 \u46972 \'94 (\u47128  50:20). \'93\u44536 \u45216 \u50640  \u50668 \u54840 \u50752 \u51032  \u49913 \u51060  \u50500 \u47492 \u45813 \u44256  \u50689 \u54868 \u47196 \u50872  \u44163 \u51060 \u50836  \u44536  \u46405 \u51032  \u49548 \u49328 \u51008  \u51060 \u49828 \u46972 \u50648 \u51032  \u54588 \u45212 \u54620  \u51088 \u47484  \u50948 \u54616 \u50668  \u50689 \u54868 \u47213 \u44256  \u50500 \u47492 \u45796 \u50872  \u44163 \u51060 \u47728  \u49884 \u50728 \u50640  \u45224 \u50500  \u51080 \u45716  \u51088 , \u50696 \u47336 \u49332 \u47128 \u50640  \u47672 \u47932 \u47084  \u51080 \u45716  \u51088 , \u44263  \u50696 \u47336 \u49332 \u47128 \u50640  \u51080 \u50612  \u49373 \u51316 \u51088  \u51473  \u45433 \u47749 \u46108  \u47784 \u46304  \u49324 \u46988 \u51008  \u44144 \u47337 \u54616 \u45796  \u52845 \u54632 \u51012  \u50619 \u51004 \u47532 \'94 (\u49324  4:2, 3) \u46972 .\
\uc0\u51312 \u49324  \u49900 \u54032 \u44284  \u51396 \u51032  \u46020 \u47568 \u51008  \u51452 \u45784 \u51032  \u51116 \u47548 \u48372 \u45796  \u47676 \u51200  \u51060 \u47336 \u50612 \u51256 \u50556  \u54620 \u45796 . \u51453 \u51008  \u51088 \u46308 \u51008  \u52293 \u46308 \u50640  \u44592 \u47197 \u46108  \u45824 \u47196  \u49900 \u54032 \u51012  \u48155 \u50500 \u50556  \u54616 \u48064 \u47196  \u44536 \u46308 \u51032  \u49324 \u44148 \u51060  \u49900 \u47532  (\u23529 \u29702 ) \u46104 \u45716  \u51312 \u49324  \u49900 \u54032 \u51060  \u47560 \u52824 \u44592  \u51204 \u50640 \u45716  \u44536 \u46308 \u51032  \u51396 \u44032  \u46020 \u47568 \u46112  \u49688  \u50630 \u45796 . \u49324 \u46020  \u48288 \u46300 \u47196 \u45716  \'93\u50976 \u53132 \u54616 \u44172  \u46104 \u45716  \u45216 \u51060  \u51452  \u50526 \u51004 \u47196 \u48512 \u53552  \u51060 \u47484  \u44163 \u51060 \u50836 \'85\u44536 \u47532 \u49828 \u46020  \u44263  \u50696 \u49688 \u47484  \u48372 \u45236 \u49884 \u47532 \u45768 \'94 (\u54665  3:19, 20) \u46972 \u44256  \u47568 \u54632 \u51004 \u47196  \u50696 \u49688 \u44760 \u49436  \u48372 \u45236 \u49900 \u51012  \u48155 \u45716  \u46412 \u50640  \u48127 \u45716  \u49324 \u46988 \u46308 \u51032  \u51396 \u44032  \u46020 \u47568 \u46112  \u44163 \u51060 \u46972 \u44256  \u48516 \u47749 \u55176  \u47568 \u54620 \u45796 . \u44536 \u47532 \u44256  \u51312 \u49324  \u49900 \u54032 \u51060  \u47560 \u52824 \u47732  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u50724 \u49892  \u44163 \u51060 \u45796 . \u44536 \u47532 \u44256  \u44536 \u48516 \u44760 \u49436 \u45716  \u44536  \u46412 \u50640  \u47784 \u46304  \u49324 \u46988 \u50640 \u44172  \u54665 \u50948 \u45824 \u47196  \u44058 \u50500  \u51452 \u49892  \u44163 \u51060 \u45796 .\
\uc0\u54364 \u49345 \u51201  \u48393 \u49324 \u50640 \u49436  \u45824 \u51228 \u49324 \u51109 \u51008  \u51060 \u49828 \u46972 \u50648  \u51313 \u49549 \u51012  \u50948 \u54616 \u50668  \u49549 \u51396 \u47484  \u47560 \u52824 \u47732  \u46896 \u47196  \u45208 \u50752 \u49436  \u54924 \u51473 \u51012  \u50948 \u54616 \u50668  \u52629 \u48373 \u54616 \u50688 \u45796 . \u44536 \u50752  \u44057 \u51060  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u46020  \u51473 \u48372 \u51088 \u47196 \u49436 \u51032  \u48393 \u49324 \u47484  \u47560 \u52824 \u49884 \u47732  \u44592 \u45796 \u47532 \u44256  \u51080 \u45716  \u45817 \u49888 \u51032  \u48177 \u49457 \u46308 \u51012  \u50689 \u49373 \u51004 \u47196  \u52629 \u48373 \u54616 \u44256  \'93\u44396 \u50896 \u50640  \u51060 \u47476 \u44172  \u54616 \u44592  \u50948 \u54616 \u50668  \u51396 \u50752  \u49345 \u44288 \u50630 \u51060 \'94 (\u55176  9:28) \u45208 \u53440 \u45208 \u49892  \u44163 \u51060 \u45796 . \u46608 \u54620  \u51228 \u49324 \u51109 \u51060  \u49457 \u49548 \u50640 \u49436  \u51396 \u47484  \u50734 \u44600  \u46412 \u50640  \u50500 \u49324 \u49472 \u51012  \u50948 \u54620  \u50684 \u49548 \u51032  \u47672 \u47532  \u50948 \u50640  \u44536  \u51396 \u46308 \u51012  \u44256 \u48177 \u54664 \u45912  \u44163 \u52376 \u47100  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u46020  \u47784 \u46304  \u51396 \u47484  \u51396 \u50501 \u51032  \u52285 \u49884 \u51088 \u50836  \u49440 \u46041 \u51088 \u51064  \u49324 \u45800 \u50640 \u44172  \u50444 \u50872  \u44163 \u51060 \u45796 . \u50500 \u49324 \u49472 \u51012  \u50948 \u54620  \u50684 \u49548 \u44032  \u51060 \u49828 \u46972 \u50648  \u51313 \u49549 \u51032  \u51396 \u47484  \u51648 \u44256  \'93\u47924 \u51064  \u51648 \u44221 \'94 (\u47112  16:22) \u51004 \u47196  \u51923 \u44200 \u45212  \u44163 \u52376 \u47100  \u49324 \u45800  \u50669 \u49884  \u44536 \u44032  \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u50640 \u44172  \u48276 \u54616 \u44172  \u54620  \u51396 \u47484  \u51648 \u44256  \u52380 \u45380  \u46041 \u50504  \u49464 \u49345 \u50640  \u44048 \u44552 \u46112  \u44163 \u51060 \u45796 . \u44536  \u46041 \u50504  \u49464 \u49345 \u51008  \u54889 \u54224 \u54616 \u44256  \u54620  \u49324 \u46988 \u51032  \u51452 \u48124 \u46020  \u50630 \u51012  \u44163 \u51060 \u45796 . \u44536 \u47532 \u44256  \u44536 \u45716  \u47560 \u52840 \u45236  \u50501 \u51064 \u46308 \u51012  \u47784 \u46160  \u47736 \u47581 \u49884 \u53420  \u48520 \u47196 \u50024  \u51396 \u51032  \u48268 \u51012  \u50756 \u51204 \u55176  \u48155 \u44172  \u46112  \u44163 \u51060 \u45796 . \u44536 \u47532 \u54616 \u50668  \u51396 \u44032  \u52572 \u51333 \u51201 \u51004 \u47196  \u44540 \u51208 \u46104 \u44256  \u51652 \u49900 \u51004 \u47196  \u50501 \u51012  \u48260 \u47536  \u47784 \u46304  \u49324 \u46988 \u46308 \u51060  \u44396 \u50896 \u51012  \u48155 \u51020 \u51004 \u47196 \u50024  \u50948 \u45824 \u54620  \u44396 \u49549 \u51032  \u44228 \u54925 \u51060  \u49457 \u52712 \u46112  \u44163 \u51060 \u45796 .\
\uc0\u49900 \u54032 \u51012  \u50948 \u54616 \u50668  \u51221 \u54644 \u51652  \u46412 , \u44263  2300\u51452 \u50556 \u44032  \u47560 \u52824 \u45716  1844\u45380 \u50640  \u51312 \u49324  \u49900 \u54032 \u44284  \u51396 \u47484  \u46020 \u47568 \u54616 \u45716  \u49324 \u50629 \u51060  \u49884 \u51089 \u46104 \u50632 \u45796 . \u44536 \u47532 \u49828 \u46020 \u51032  \u51060 \u47492 \u51012  \u48520 \u47084 \u50728  \u47784 \u46304  \u49324 \u46988 \u46308 \u51008  \u45796  \u51060  \u50628 \u49689 \u54620  \u49900 \u49324 \u47484  \u44144 \u52432 \u50556  \u54620 \u45796 . \u49328  \u51088 \u46308 \u44284  \u51453 \u51008  \u51088 \u46308 \u51060  \u45796  \u44057 \u51060  \'93\u51088 \u44592  \u54665 \u50948 \u47484  \u46384 \u46972  \u52293 \u46308 \u50640  \u44592 \u47197 \u46108  \u45824 \u47196 \'94 \u49900 \u54032 \u51012  \u48155 \u50500 \u50556  \u54620 \u45796 .\
\uc0\u54924 \u44060 \u54616 \u51648  \u50506 \u44256  \u48260 \u47532 \u51648  \u50506 \u51008  \u51396 \u45716  \u50857 \u49436 \u47484  \u48155 \u51648  \u47803 \u54616 \u44256  \u44592 \u47197 \u54620  \u52293 \u46308 \u50640 \u49436  \u46020 \u47568 \u46104 \u51648  \u50506 \u51012  \u44163 \u51060 \u45796 . \u44536 \u47084 \u45208  \u44536 \u44163 \u51008  \u54616 \u45208 \u45784 \u51032  \u53360  \u45216 \u50640  \u44536  \u51396 \u51064 \u50640 \u44172  \u48520 \u47532 \u54620  \u51613 \u44144 \u47484  \u54616 \u44172  \u46112  \u44163 \u51060 \u45796 . \u44536  \u50501 \u54665 \u51008  \u48177 \u51452 \u50640  \u54665 \u54620  \u44163 \u51060 \u45208  \u48164 \u51032  \u50612 \u46176 \u49549 \u50640 \u49436  \u54665 \u54620  \u44163 \u51060  \u45208 \u47484  \u47561 \u47200 \u54616 \u44256  \u50864 \u47532 \u47484  \u52712 \u44553 \u54616 \u49884 \u45716  \u54616 \u45208 \u45784  \u50526 \u50640  \u44277 \u44277 \u50672 \u54616 \u44172  \u45208 \u53440 \u45216  \u44163 \u51060 \u45796 . \u54616 \u45208 \u45784 \u51032  \u52380 \u49324 \u46308 \u51060  \u44536  \u47784 \u46304  \u51396 \u47484  \u47785 \u44201 \u54616 \u44256  \u51208 \u45824 \u47196  \u51096 \u47803 \u51060  \u50630 \u45716  \u44592 \u47197 \u51004 \u47196  \u48372 \u51316 \u54616 \u44256  \u51080 \u45796 . \u51396 \u45716  \u44536  \u48512 \u47784  \u50526 \u50640 \u45208  \u52376 \u51088 \u50752  \u52828 \u44396 \u46308  \u50526 \u50640 \u45716  \u49704 \u44600  \u49688 \u46020  \u51080 \u45796 . \u46608 \u54620  \u44536  \u48276 \u54665 \u51088  \u50808 \u50640 \u45716  \u44536  \u50501 \u51012  \u52628 \u54840 \u46020  \u51032 \u49900 \u54616 \u45716  \u49324 \u46988 \u51060  \u50630 \u51012  \u49688 \u46020  \u51080 \u45796 . \u44536 \u47084 \u45208  \u54616 \u45720 \u50640  \u51080 \u45716  \u51060 \u46308  \u50526 \u50640 \u45716  \u44536 \u44163 \u51060  \u48516 \u47749 \u55176  \u45208 \u53440 \u45212 \u45796 . \u44032 \u51109  \u50612 \u46160 \u50868  \u48164 \u51060 \u45208  \u440