\uc0\u47336 \u53552 \u44032  \u46028 \u50500 \u50752 \u49436  \u49444 \u44368 \u47484  \u54620 \u45796 \u45716  \u47568 \u51060  \u48708 \u53584 \u48288 \u47476 \u53356 \u50640  \u51593 \u49884  \u54140 \u51276 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44400 \u51473 \u46308 \u51060  \u49324 \u48169 \u50640 \u49436  \u47784 \u50668 \u46308 \u50612  \u44368 \u54924 \u45716  \u49324 \u46988 \u46308 \u47196  \u44032 \u46301  \u52292 \u50892 \u51276 \u45796 . \u44536 \u45716  \u44053 \u45800 \u50640  \u50732 \u46972 \u44032 \u49436  \u47588 \u50864  \u51648 \u54812 \u47213 \u44256  \u48512 \u46300 \u47101 \u44172  \u44368 \u54984 \u54616 \u44256 , \u44428 \u47732 \u54616 \u44256 , \u54984 \u44228 \u54616 \u50688 \u45796 . \u50612 \u46500  \u49324 \u46988 \u46308 \u51060  \u54253 \u47141 \u51201 \u51064  \u48169 \u48277 \u51004 \u47196  \u48120 \u49324 \u47484  \u54224 \u51648 \u54616 \u44256 \u51088  \u54664 \u51012  \u46412  \u44536 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u54616 \u50688 \u45796 .\
\'93\uc0\u48120 \u49324 \u45716  \u48512 \u45817 \u54620  \u44163 \u51060 \u48064 \u47196  \u54616 \u45208 \u45784 \u44760 \u49436  \u44536 \u44163 \u51012  \u48152 \u45824 \u54616 \u49901 \u45768 \u45796 . \u44536 \u44163 \u51008  \u54224 \u51648 \u46104 \u50612 \u50556  \u54633 \u45768 \u45796 . \u45208 \u45716  \u50728  \u49464 \u44228 \u50640 \u49436  \u48373 \u51020 \u51060  \u44032 \u47476 \u52828  \u49457 \u47564 \u52268  \u50696 \u49885 \u51012  \u48120 \u49324  \u45824 \u49888 \u51004 \u47196  \u54665 \u54616 \u50668 \u50556  \u54624  \u44163 \u51060 \u46972 \u44256  \u49373 \u44033 \u54633 \u45768 \u45796 . \u44536 \u47084 \u45208  \u50500 \u47924 \u46020  \u44536 \u44163 \u51012  \u54253 \u47141 \u51004 \u47196  \u54224 \u51648 \u54616 \u50668 \u49436 \u45716  \u50504  \u46121 \u45768 \u45796 . \u50864 \u47532 \u45716  \u44536 \u44163 \u51012  \u54616 \u45208 \u45784 \u51032  \u49552 \u50640  \u47585 \u44200 \u50556  \u54633 \u45768 \u45796 . \u44536 \u48516 \u51032  \u47568 \u50432 \u51060  \u44536  \u51068 \u51012  \u54665 \u54624  \u44163 \u51060 \u51648  \u50864 \u47532 \u44032  \u54665 \u54624  \u44163 \u51060  \u50500 \u45785 \u45768 \u45796 . \u50668 \u47084 \u48516 \u51008  \u50780  \u44536 \u47111 \u44172  \u54644 \u50556  \u54616 \u45712 \u45264 \u44256  \u51032 \u47928 \u51012  \u44032 \u51656  \u44163 \u51077 \u45768 \u45796 . \u44536 \u44163 \u51008  \u47560 \u52824  \u46020 \u44277  (\u38518 \u24037 ) \u51060  \u51652 \u55129 \u51012  \u44032 \u51648 \u44256  \u47560 \u51020 \u45824 \u47196  \u47924 \u50631 \u51012  \u47564 \u46300 \u45716  \u44163 \u52376 \u47100 , \u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u51012  \u50864 \u47532 \u44032  \u51648 \u48176 \u54624  \u49688  \u50630 \u45716  \u44620 \u45805 \u51077 \u45768 \u45796 . \u50864 \u47532 \u45716  \u47568 \u54624  \u44428 \u47532 \u47484  \u44032 \u51276 \u51004 \u45208  \u54665 \u54624  \u44428 \u47532 \u45716  \u44032 \u51648 \u51648  \u47803 \u54616 \u50688 \u49845 \u45768 \u45796 . \u50864 \u47532 \u45716  \u45796 \u47564  \u47568 \u47196  \u51204 \u54616 \u45716  \u44163 \u49104 \u51060 \u47728 , \u44536  \u48150 \u51032  \u44163 \u51008  \u54616 \u45208 \u45784 \u44760  \u49549 \u54620  \u44163 \u51077 \u45768 \u45796 . \u47564 \u51068  \u45236 \u44032  \u54253 \u47141 \u51012  \u49324 \u50857 \u54616 \u50688 \u45796 \u47732  \u47924 \u50631 \u51012  \u50619 \u51012  \u49688  \u51080 \u50632 \u44192 \u49845 \u45768 \u44620 ? \u52257 \u44536 \u47536  \u50620 \u44404 , \u54805 \u49885 , \u50613 \u51648 \u47196  \u46384 \u46972  \u54616 \u45716  \u51068 , \u51064 \u50948 \u51201 \u51064  \u51228 \u46020 , \u50948 \u49440 \u49104 \u51068  \u44163 \u51077 \u45768 \u45796 . \u44144 \u44592 \u50640 \u45716  \u49457 \u49892 \u54620  \u47560 \u51020 \u46020 , \u48127 \u51020 \u46020 , \u49324 \u46993 \u46020  \u50630 \u51012  \u44163 \u51077 \u45768 \u45796 . \u44536  \u49464  \u44032 \u51648 \u44032  \u44208 \u54605 \u46104 \u47732  \u47784 \u46304  \u44163 \u51060  \u44208 \u54605 \u46121 \u45768 \u45796 . \u44536 \u47084 \u48064 \u47196  \u44208 \u44284 \u51201 \u51004 \u47196 \u45716  \u47784 \u46304  \u44163 \u51060  \u50424 \u45936 \u50630 \u44172  \u46121 \u45768 \u45796 . \'85\u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u50668 \u47084 \u48516 \u44284  \u45208 \u50752  \u50728  \u49464 \u49345 \u51060  \u50672 \u54633 \u54616 \u50668  \u48156 \u55064 \u54616 \u45716  \u55192 \u48372 \u45796  \u45908 \u50865  \u53360  \u55192 \u51012  \u45817 \u49888 \u51032  \u47568 \u50432 \u47564 \u51004 \u47196 \u46020  \u48156 \u55064 \u54616 \u49892  \u49688  \u51080 \u49845 \u45768 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u49324 \u46988 \u51032  \u47560 \u51020 \u51012  \u48537 \u51105 \u51004 \u49884 \u45716 \u45936 , \u49324 \u46988 \u51032  \u47560 \u51020 \u51060  \u44536 \u48516 \u50640 \u44172  \u48537 \u51105 \u55176 \u44172  \u46104 \u47732  \u47784 \u46304  \u44163 \u51060  \u51060 \u47336 \u50612 \u51665 \u45768 \u45796 . \'85\
\uc0\u45208 \u45716  \u49444 \u44368 \u54616 \u44256 , \u53664 \u51032 \u54616 \u44256 , \u51200 \u49696 \u54624  \u44163 \u51077 \u45768 \u45796 . \u44536 \u47084 \u45208  \u50612 \u46500  \u49324 \u46988 \u46020  \u44053 \u51228 \u54616 \u51648 \u45716  \u50506 \u51012  \u44163 \u51077 \u45768 \u45796 . \u50780 \u45264 \u54616 \u47732  \u48127 \u51020 \u51008  \u54616 \u45208 \u51032  \u51088 \u48156 \u51201 \u51064  \u54665 \u46041 \u51060 \u44592  \u46412 \u47928 \u51077 \u45768 \u45796 . \u45236 \u44032  \u51648 \u44552 \u44620 \u51648  \u54644  \u50728  \u51068 \u51012  \u48372 \u49901 \u49884 \u50724 . \u45208 \u45716  \u48277 \u50773 \u44284  \u47732 \u51396 \u48512 \u50752  \u48277 \u50773 \u45817 \u51012  \u45824 \u54637 \u54616 \u50668  \u49912 \u50912 \u49845 \u45768 \u45796 . \u44536 \u47084 \u45208  \u54253 \u47141 \u51060 \u45208  \u54253 \u46041 \u51004 \u47196  \u44536  \u51068 \u51012  \u54616 \u51648  \u50506 \u50520 \u49845 \u45768 \u45796 . \u45236 \u44032  \u54620  \u47784 \u46304  \u51068 \u51008  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51012  \u51204 \u54028 \u54616 \u44256 , \u49444 \u44368 \u54616 \u44256 , \u51200 \u49696 \u54620  \u44163 \u49104 \u51077 \u45768 \u45796 . \u44536 \u47088 \u45936  \u45236 \u44032  \u51088 \u44256  \u51080 \u45716  \u46041 \u50504 \u50640 \'85\u45236 \u44032  \u51204 \u54620  \u44536  \u47568 \u50432 \u51060  \u48277 \u50773 \u44368 \u47484  \u51204 \u48373 \u49884 \u53040 \u49845 \u45768 \u45796 . \u44536 \u47084 \u48064 \u47196  \u49440 \u54980  (\u36984 \u20399 ) \u45208  \u54889 \u51228 \u51068 \u51648 \u46972 \u46020  \u50612 \u52236 \u54624  \u49688 \u44032  \u50630 \u45716  \u44163 \u51077 \u45768 \u45796 . \u44536 \u47111 \u51648 \u47564  \u45208 \u45716  \u50500 \u47924  \u44163 \u46020  \u54620  \u51068 \u51060  \u50630 \u49845 \u45768 \u45796 . \u45796 \u47564  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51060  \u47784 \u46304  \u44163 \u51012  \u45796 \u54616 \u50688 \u49845 \u45768 \u45796 . \u47564 \u51068  \u45236 \u44032  \u54253 \u47141 \u50640  \u54840 \u49548 \u54616 \u44256 \u51088  \u54664 \u45796 \u47732 , \u50728  \u46021 \u51068 \u51008  \u54588 \u47196 \u50024  \u54861 \u49688 \u47484  \u51060 \u47336 \u50632 \u51012  \u44163 \u51077 \u45768 \u45796 . \u44536 \u47111 \u44172  \u46104 \u50632 \u45796 \u47732  \u44536  \u44208 \u44284 \u44032  \u50612 \u46496 \u54616 \u50688 \u44192 \u49845 \u45768 \u44620 ? \u50977 \u52404 \u50752  \u50689 \u54844 \u51012  \u47784 \u46160  \u54028 \u47736 \u44284  \u54224 \u54728  \u49549 \u51004 \u47196  \u47792 \u50500 \u45347 \u50632 \u51012  \u44163 \u51077 \u45768 \u45796 . \u44536 \u47084 \u48064 \u47196  \u45208 \u45716  \u51312 \u50857 \u55176  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u47564 \u51060  \u50728  \u49464 \u49345 \u50640  \u51204 \u54644 \u51648 \u46020 \u47197  \u54616 \u50688 \u51012  \u49104 \u51077 \u45768 \u45796 \'94 (D\'92Aubigne, b.9, ch.8).\
\uc0\u47336 \u53552 \u45716  1\u51452 \u51068  \u46041 \u50504  \u45216 \u47560 \u45796  \u50676 \u49457  \u51080 \u45716  \u44536  \u52397 \u51473 \u46308 \u51012  \u54693 \u54616 \u50668  \u49444 \u44368 \u47484  \u44228 \u49549 \u54616 \u50688 \u45796 . \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51008  \u44305 \u49888 \u51201 \u51064  \u55141 \u48516 \u51012  \u44032 \u46972 \u50505 \u54804 \u45796 . \u48373 \u51020 \u51032  \u50948 \u47141 \u51060  \u48120 \u54841 \u50640  \u48736 \u51652  \u49324 \u46988 \u46308 \u51012  \u51652 \u47532 \u51032  \u44600 \u47196  \u45796 \u49884  \u46028 \u50500 \u50724 \u44172  \u54616 \u50688 \u45796 .\
