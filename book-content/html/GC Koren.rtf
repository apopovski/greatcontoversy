\uc0\u51333 \u44368  \u44060 \u54785  \u49884 \u45824 \u50640  \u50896 \u49688 \u46308 \u51008  \u44305 \u49888 \u51088 \u46308 \u51060  \u47564 \u46308 \u50612  \u45459 \u51008  \u50728 \u44054  \u50501 \u50640  \u45824 \u54620  \u52293 \u51076 \u51012  \u44305 \u49888 \u51088 \u46308 \u51012  \u44032 \u51109  \u50676 \u47148 \u54616 \u44172  \u48152 \u45824 \u54616 \u44256  \u51080 \u45716  \u48148 \u47196  \u44536  \u49324 \u46988 \u46308 \u50640 \u44172  \u46244 \u51665 \u50612  \u50444 \u50912 \u45796 . \u51060 \u50752  \u44057 \u51008  \u51068 \u51008  \u51116 \u47548 \u50868 \u46041 \u51012  \u48152 \u45824 \u54616 \u45716  \u51088 \u46308 \u51012  \u53685 \u54616 \u50668  \u45796 \u49884  \u45208 \u53440 \u45228 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u46308 \u51008  \u44537 \u45800 \u51088 \u46308 \u44284  \u44305 \u49888 \u51088 \u46308 \u51032  \u44536 \u47495 \u46108  \u51216 \u46308 \u51012  \u44284 \u51109 \u54616 \u44144 \u45208  \u48320 \u51312  (\u35722 \u36896 ) \u54616 \u45716  \u44163 \u47564 \u51004 \u47196  \u47564 \u51313 \u54616 \u51648  \u50500 \u45768 \u54616 \u44256  \u51204 \u54784  \u44540 \u44144 \u46020  \u50630 \u45716  \u51339 \u51648  \u47803 \u54620  \u47568 \u46308 \u51012  \u47564 \u46308 \u50612 \u49436  \u51204 \u54616 \u50688 \u45796 . \u44536  \u49324 \u46988 \u46308 \u51008  \u54200 \u44204 \u44284  \u51613 \u50724 \u47196  \u51088 \u44537 \u46104 \u50632 \u45796 . \u44536 \u46308 \u51008  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u47928  \u50526 \u50640  \u51060 \u47476 \u47104 \u45796 \u45716  \u44592 \u48324 \u50640  \u48520 \u50504 \u54644 \u51276 \u45796 . \u44536 \u46308 \u51008  \u51116 \u47548 \u51032  \u44592 \u48324 \u51060  \u49324 \u49892 \u51060 \u46972 \u47732  \u50612 \u46523 \u44172  \u54616 \u45208  \u54616 \u44256  \u46160 \u47140 \u50892 \u54616 \u50688 \u44256 , \u44536 \u44163 \u51060  \u49324 \u49892 \u51060  \u50500 \u45768 \u44592 \u47484  \u48148 \u46992 \u45796 . \u44536 \u47084 \u48064 \u47196  \u44536 \u46308 \u51008  \u51116 \u47548 \u49888 \u46020 \u46308 \u44284  \u44536 \u46308 \u51032  \u48127 \u51020 \u51012  \u45824 \u54637 \u54616 \u50668  \u49912 \u50864 \u44172  \u46104 \u50632 \u45796 .\
\uc0\u48148 \u50872 \u51060 \u45208  \u47336 \u53552 \u51032  \u49884 \u45824 \u50640  \u44368 \u54924  \u50504 \u50640  \u44305 \u49888 \u51088 \u50752  \u44592 \u47564 \u51088 \u44032  \u51080 \u50632 \u45796 \u44256  \u54616 \u50668  \u44536 \u46308 \u51032  \u49324 \u50629 \u51012  \u51221 \u51396 \u54624  \u49688  \u50630 \u45716  \u44163 \u44284  \u44057 \u51060 , \u49548 \u49688 \u51032  \u44305 \u49888 \u51088 \u44032  \u51116 \u47548 \u49888 \u46020 \u46308  \u44032 \u50868 \u45936  \u46308 \u50612 \u50752 \u49436  \u54876 \u46041 \u54616 \u50688 \u45796 \u44256  \u54616 \u50668  \u44536  \u50868 \u46041 \u51060  \u54616 \u45208 \u45784 \u44760 \u47196 \u48512 \u53552  \u45208 \u50728  \u44163 \u51060  \u50500 \u45768 \u46972 \u44256  \u45800 \u51221 \u54624  \u51060 \u50976 \u45716  \u51204 \u54784  \u50630 \u45796 . \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u46308 \u47196  \u54616 \u50668 \u44552  \u51104 \u50640 \u49436  \u44648 \u50612 \u45208 \u49436  \u50676 \u49900 \u51004 \u47196  \u54924 \u44060 \u54616 \u44256  \u44060 \u54785 \u54616 \u44172  \u54616 \u46972 . \u44536 \u46308 \u51060  \u50696 \u49688 \u44760 \u49436  \u47568 \u50432 \u54616 \u49888  \u44536 \u45824 \u47196 \u51032  \u51652 \u47532 \u47484  \u48176 \u50864 \u44592  \u50948 \u54616 \u50668  \u49457 \u44221 \u51012  \u53456 \u44396 \u54616 \u44172  \u54616 \u46972 . \u44536 \u46308 \u51012  \u54616 \u45208 \u45784 \u44760  \u50756 \u51204 \u55176  \u54732 \u49888 \u54616 \u44172  \u54616 \u46972 . \u44536 \u47532 \u54616 \u47732  \u49324 \u45800 \u51060  \u50668 \u51204 \u55176  \u44648 \u50612  \u54876 \u46041 \u54616 \u44256  \u51080 \u45716  \u51613 \u44144 \u44032  \u50668 \u49892 \u55176  \u45208 \u53440 \u45216  \u44163 \u51060 \u45796 . \u49324 \u45800 \u51008  \u54624  \u49688  \u51080 \u45716  \u50728 \u44054  \u44592 \u47564  \u49688 \u45800 \u51012  \u45796 \u54616 \u50668  \u51088 \u49888 \u51032  \u45733 \u47141 \u51012  \u45208 \u53440 \u45236 \u44256 , \u51088 \u44592 \u51032  \u44428 \u49464  \u50500 \u47000  \u51080 \u45716  \u47784 \u46304  \u53440 \u46973 \u54620  \u52380 \u49324 \u46308 \u50640 \u44172  \u46020 \u50880 \u51012  \u52397 \u54616 \u44256  \u51080 \u45796 .\
\uc0\u44305 \u49888 \u44284  \u48516 \u50676 \u51060  \u51068 \u50612 \u45212  \u44163 \u51008  \u51116 \u47548 \u44592 \u48324 \u51060  \u51204 \u54028 \u46104 \u50632 \u44592  \u46412 \u47928 \u51060  \u50500 \u45768 \u50632 \u45796 . \u51060 \u47088  \u51068 \u46308 \u51060  \u45208 \u53440 \u45212  \u44163 \u51008  1844\u45380  \u50668 \u47492 , \u44263  \u51116 \u47548 \u49888 \u51088 \u46308 \u51060  \u44536 \u46308 \u51032  \u52280 \u46108  \u51077 \u51109 \u50640  \u45824 \u54616 \u50668  \u51032 \u49900 \u51012  \u54408 \u44256  \u48169 \u54889 \u54616 \u45912  \u44536  \u46412 \u50688 \u45796 . \u52395 \u51704  \u52380 \u49324 \u51032  \u44592 \u48324 \u44284  \'93\u48164 \u51473  \u49548 \u47532 \'94\u51032  \u49440 \u54252 \u45716  \u49888 \u51088 \u46308  \u49324 \u51060 \u51032  \u44305 \u49888 \u44284  \u50508 \u47141 \u51012  \u51649 \u51217 \u51201 \u51004 \u47196  \u51652 \u50517 \u54616 \u45716  \u51068 \u51012  \u54616 \u50688 \u45796 . \u51060  \u50628 \u49689 \u54620  \u50868 \u46041 \u50640  \u52280 \u50668 \u54620  \u49324 \u46988 \u46308 \u51008  \u49436 \u47196  \u47560 \u51020 \u51012  \u51068 \u52824 \u54616 \u50688 \u51004 \u47728 , \u44536 \u46308 \u51060  \u51109 \u52264  \u48456 \u50741 \u44592 \u47484  \u44592 \u45824 \u54616 \u45716  \u50696 \u49688 \u45784 \u44284  \u44536 \u46308  \u49345 \u54840 \u44036 \u50640  \u49436 \u47196  \u49324 \u46993 \u54616 \u45716  \u47560 \u51020 \u51004 \u47196  \u52649 \u47564 \u54616 \u50668 \u51276 \u45796 . \u54616 \u45208 \u51032  \u48127 \u51020 , \u54616 \u45208 \u51032  \u48373 \u46108  \u49548 \u47581 \u51008  \u44536 \u46308 \u51012  \u50612 \u46500  \u51064 \u44036 \u51032  \u44048 \u54868 \u47484  \u48155 \u45716  \u44163 \u48372 \u45796  \u54988 \u47469 \u54616 \u44172  \u47564 \u46308 \u50612  \u51452 \u50632 \u44256 , \u49324 \u45800 \u51032  \u44277 \u44201 \u50640  \u45824 \u54620  \u48169 \u54056 \u44032  \u46104 \u50632 \u45796 .\
\'93\uc0\u49888 \u46993 \u51060  \u45908 \u46356  \u50724 \u48064 \u47196  \u45796  \u51320 \u47728  \u51096 \u49352  \u48164 \u51473 \u50640  \u49548 \u47532 \u44032  \u45208 \u46104  \u48372 \u46972  \u49888 \u46993 \u51060 \u47196 \u45796  \u47582 \u51004 \u47084  \u45208 \u50724 \u46972  \u54616 \u47588  \u51060 \u50640  \u44536  \u52376 \u45376 \u46308 \u51060  \u45796  \u51068 \u50612 \u45208  \u46321 \u51012  \u51456 \u48708 \u54624 \u49352  \'85.\'94 1844\u45380  \u50668 \u47492 , \u44263  \u51116 \u47548 \u49888 \u51088 \u46308 \u51060  \u52376 \u51020 \u50640  2300\u51452 \u50556 \u51032  \u45149 \u51060 \u46972 \u44256  \u49373 \u44033 \u54664 \u45912  \u46412 \u47196 \u48512 \u53552  \u44536  \u45796 \u51020 \u50640  \u45796 \u49884  \u50672 \u51109 \u46108  \u44163 \u51004 \u47196  \u44648 \u45803 \u44172  \u46108  \u46412 \u44620 \u51648 \u51032  \u51473 \u44036  \u44592 \u44036 \u50640  \u51060  \u44592 \u48324 \u51008  \u49457 \u44221  \u47568 \u50432  \u44536 \u45824 \u47196  \'93\u48372 \u46972  \u49888 \u46993 \u51060 \u47196 \u45796  \u47582 \u51004 \u47084  \u45208 \u50724 \u46972 \'94\u45716  \u47568 \u47196  \u51204 \u54028 \u46104 \u50632 \u45796 .\
\uc0\u51060  \u50868 \u46041 \u51060  \u51068 \u50612 \u45208 \u44172  \u46108  \u44163 \u51008  2300\u51452 \u50556 \u51032  \u44592 \u51216  (\u36215 \u40670 ) \u51060  \u46104 \u45716  \u50696 \u47336 \u49332 \u47128 \u51012  \u54924 \u48373 \u54616 \u46972 \u45716  \u50500 \u45797 \u49324 \u49828 \u45796  \u50773 \u51032  \u52825 \u47161 \u51060  \u54952 \u47141 \u51012  \u48156 \u49373 \u54620  \u44163 \u51060  \u44592 \u50896 \u51204  457\u45380  \u44032 \u51012 \u51060 \u47728  \u52376 \u51020 \u50640  \u49373 \u44033 \u54664 \u45912  \u44163 \u52376 \u47100  \u44536  \u54644  \u52488 \u44032  \u50500 \u45772  \u49324 \u49892 \u51060  \u54032 \u47749 \u46104 \u50632 \u44592  \u46412 \u47928 \u51060 \u50632 \u45796 . \u44592 \u50896 \u51204  457\u45380  \u44032 \u51012 \u48512 \u53552  \u44228 \u49328 \u54616 \u47732  2300\u51452 \u50556 \u45716  \u48148 \u47196  1844\u45380  \u44032 \u51012 \u50640  \u47560 \u52824 \u44172  \u46108 \u45796  (\u48512 \u47197  27 \u52280 \u51312 ).\
