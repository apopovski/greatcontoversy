\uc0\u47336 \u49828 \u48296 \u51008  \u54616 \u45208 \u45784 \u51032  \u53945 \u48324 \u54620  \u51008 \u52509 \u51012  \u51077 \u44256  \u50728  \u54616 \u45720  \u44400 \u45824 \u51032  \u51316 \u44221 \u51012  \u48155 \u51004 \u47728  \u51088 \u44592 \u51032  \u44256 \u49345 \u54620  \u45733 \u47141 \u51012  \u54876 \u50857 \u54616 \u50668  \u45796 \u47480  \u51060 \u47484  \u48373 \u46104 \u44172  \u54616 \u44256  \u52285 \u51312 \u51452 \u51032  \u50689 \u44305 \u51012  \u45208 \u53440 \u45244  \u49688  \u51080 \u50632 \u45796 . \u44536 \u47084 \u45208  \u49440 \u51648 \u51088 \u45716  \'93\u45348 \u44032  \u50500 \u47492 \u45796 \u50864 \u48064 \u47196  \u47560 \u51020 \u51060  \u44368 \u47564 \u54616 \u50688 \u51004 \u47728  \u45348 \u44032  \u50689 \u54868 \u47196 \u50864 \u48064 \u47196  \u45348  \u51648 \u54812 \u47484  \u45908 \u47101 \u54804 \'94 (\u44180  28:17) \u46020 \u45796 \u46972 \u44256  \u47568 \u54620 \u45796 . \u47336 \u49828 \u48296 \u51008  \u52264 \u52784 \u52264 \u52784  \u51088 \u44592 \u47484  \u45458 \u51060 \u44256 \u51088  \u54616 \u45716  \u50837 \u47581 \u51012  \u54408 \u44172  \u46104 \u50632 \u45796 . \'93\u45348  \u47560 \u51020 \u51060  \u54616 \u45208 \u45784 \u51032  \u47560 \u51020  \u44057 \u51008  \u52404 \u54616 \u50688 \u51004 \u45768 \'94 (\u44180  28:6), \'93\u45348 \u44032  \u45348  \u47560 \u51020 \u50640  \u51060 \u47476 \u44592 \u47484  \u45236 \u44032  \u54616 \u45720 \u50640  \u50732 \u46972  \u54616 \u45208 \u45784 \u51032  \u47943  \u48324  \u50948 \u50640  \u45208 \u51032  \u48372 \u51340 \u47484  \u45458 \u51060 \u47532 \u46972  \u45236 \u44032  \u48513 \u44537  \u51665 \u54924 \u51032  \u49328  \u50948 \u50640  \u51340 \u51221 \u54616 \u47532 \u46972  \u44032 \u51109  \u45458 \u51008  \u44396 \u47492 \u50640  \u50732 \u46972  \u51648 \u44537 \u55176  \u45458 \u51008  \u51088 \u50752  \u48708 \u44592 \u47532 \u46972  \u54616 \u46020 \u45796 \'94 (\u49324  14:13, 14). \u47336 \u49828 \u48296 \u51008  \u54616 \