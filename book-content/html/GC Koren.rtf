\uc0\u51116 \u47548 \u44592 \u48324 \u51008  \u49828 \u52856 \u46356 \u45208 \u48708 \u50500 \u50640 \u46020  \u51204 \u54028 \u46104 \u50612  \u53360  \u55141 \u48120 \u47484  \u51068 \u51004 \u53040 \u45796 . \u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u44221 \u48149 \u54620  \u49345 \u53468 \u50640 \u49436  \u44033 \u49457 \u54616 \u50668  \u44536 \u46308 \u51032  \u51396 \u47484  \u44256 \u48177 \u54616 \u44256 , \u44536 \u47532 \u49828 \u46020 \u51032  \u51060 \u47492 \u51004 \u47196  \u50857 \u49436 \u47484  \u44396 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44397 \u44368 \u54924  (\u22283 \u25934 \u26371 ) \u51032  \u49457 \u51649 \u51088 \u46308 \u51008  \u51060  \u50868 \u46041 \u51012  \u48152 \u45824 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51032  \u50689 \u54693 \u51004 \u47196  \u44592 \u48324 \u51012  \u51204 \u54616 \u45912  \u47751  \u49324 \u46988 \u46308 \u51060  \u53804 \u50725 \u45817 \u54616 \u50688 \u45796 . \u44536 \u47084 \u51088  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u51060 \u52376 \u47100  \u51116 \u47548 \u44592 \u48324 \u51012  \u51204 \u54616 \u45912  \u49324 \u46988 \u46308 \u51060  \u52840 \u47925 \u54616 \u44172  \u46108  \u50668 \u47084  \u44275 \u50640 \u49436  \u50612 \u47536 \u51060 \u46308 \u51012  \u53685 \u54616 \u50668  \u44592 \u51201 \u51201 \u51004 \u47196  \u44592 \u48324 \u51012  \u51204 \u54616 \u44172  \u54616 \u49512 \u45796 . \u44536 \u46308 \u51008  \u48120 \u49457 \u45380 \u51088 \u51060 \u48064 \u47196  \u44397 \u48277 \u51004 \u47196  \u52376 \u48268 \u54624  \u49688 \u44032  \u50630 \u50632 \u44592  \u46412 \u47928 \u50640  \u47560 \u51020  \u45459 \u44256  \u47568 \u54624  \u49688  \u51080 \u50632 \u45796 .\
\uc0\u44536  \u50868 \u46041 \u51008  \u51452 \u47196  \u54616 \u52789  \u44228 \u44553 \u51032  \u49324 \u46988 \u46308 \u51012  \u51473 \u49900 \u51004 \u47196  \u51652 \u52377 \u46104 \u50632 \u45716 \u45936  \u44221 \u44256 \u51032  \u44592 \u48324 \u51012  \u46307 \u44592  \u50948 \u54616 \u50668  \u49324 \u46988 \u46308 \u51060  \u47784 \u51064  \u51109 \u49548 \u45716  \u45824 \u44060  \u45432 \u46041 \u51088 \u51032  \u48708 \u52380 \u54620  \u44032 \u51221 \u46308 \u51060 \u50632 \u45796 . \u44536 \u47532 \u44256  \u44536  \u50612 \u47536 \u51060  \u51204 \u46020 \u51088 \u46308 \u46020  \u51452 \u47196  \u44032 \u45212 \u54620  \u51665 \u50504 \u51032  \u51088 \u45376 \u46308 \u51060 \u50632 \u45796 . \u44536 \u46308  \u44032 \u50868 \u45936 \u45716  6\u49464  \u45236 \u51648  8\u49464 \u51032  \u50612 \u47536 \u51060 \u46308 \u46020  \u51080 \u50632 \u45796 . \u44536 \u46308 \u51008  \u49373 \u54876 \u51012  \u53685 \u54616 \u50668  \u44536 \u46308 \u51060  \u44396 \u51452 \u47484  \u49324 \u46993 \u54616 \u44256  \u54616 \u45208 \u45784 \u51032  \u44144 \u47337 \u54620  \u47749 \u47161 \u51012  \u49692 \u51333 \u54616 \u44256 \u51088  \u45432 \u47141 \u54616 \u44256  \u51080 \u45796 \u45716  \u44163 \u51012  \u51613 \u44144 \u54616 \u50688 \u45716 \u45936 , \u44536 \u46308 \u51060  \u51068 \u49345 \u49373 \u54876 \u50640 \u49436  \u45208 \u53440 \u45236 \u45716  \u51648 \u54812 \u50752  \u51116 \u45733 \u50640  \u51080 \u50612 \u49436 \u45716  \u44057 \u51008  \u45208 \u51060 \u51032  \u45796 \u47480  \u50500 \u51060 \u46308 \u44284  \u48324 \u45796 \u47492 \u51060  \u50630 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44536 \u46308 \u51060  \u51068 \u45800  \u49324 \u46988 \u46308  \u50526 \u50640  \u49436 \u44172  \u46104 \u47732 , \u44536 \u46308 \u51060  \u44032 \u51648 \u44256  \u51080 \u45716  \u51116 \u45733  \u51060 \u49345 \u51032  \u55192 \u51060  \u44536 \u46308 \u51012  \u44048 \u46041 \u49884 \u53412 \u44256  \u51080 \u45796 \u45716  \u44163 \u51060  \u48516 \u47749 \u55176  \u45208 \u53440 \u45228 \u45796 . \u44536  \u51020 \u49457 \u44284  \u53468 \u46020 \u44032  \u48148 \u45068 \u44256 , \'93\u54616 \u45208 \u45784 \u51012  \u46160 \u47140 \u50892 \u54616 \u47728  \u44536 \u50640 \u44172  \u50689 \u44305 \u51012  \u46028 \u47532 \u46972  \u51060 \u45716  \u44536 \u51032  \u49900 \u54032 \u54616 \u49892  \u49884 \u44036 \u51060  \u51060 \u47476 \u47104 \u51020 \'94\u51060 \u46972 \u45716  \u49457 \u44221  \u47568 \u50432 \u51012  \u51064 \u50857 \u54616 \u50668  \u49900 \u54032 \u51032  \u44221 \u44256 \u47484  \u54624  \u46412 \u50640 \u45716  \u50628 \u49689 \u54620  \u45733 \u47141 \u51004 \u47196  \u54616 \u50688 \u45796 . \u46608 \u54620  \u44536 \u46308 \u51008  \u48177 \u49457 \u46308 \u51032  \u51396 \u47484  \u52293 \u47581 \u54616 \u44256 , \u48512 \u46020 \u45909 \u44284  \u48276 \u51396 \u47484  \u51221 \u51396 \u54624  \u49104  \u50500 \u45768 \u46972 , \u49464 \u49549 \u51201 \u51064  \u44163 \u44284  \u48176 \u46020 \u54620  \u51068 \u51012  \u44984 \u51670 \u44256  \u51109 \u52264  \u51076 \u54624  \u54616 \u45208 \u45784 \u51032  \u51652 \u45432 \u50640 \u49436  \u49888 \u49549 \u55176  \u54588 \u54616 \u46020 \u47197  \u51456 \u48708 \u54616 \u46972 \u44256  \u52397 \u51473 \u46308 \u50640 \u44172  \u50628 \u49689 \u55176  \u44221 \u44256 \u54616 \u50688 \u45796 .\
\uc0\u49324 \u46988 \u46308 \u51008  \u44536  \u47568 \u51012  \u46307 \u44256  \u46504 \u50632 \u45796 . \u54924 \u44060 \u52992  \u54616 \u45716  \u54616 \u45208 \u45784 \u51032  \u49457 \u47161 \u51060  \u44536 \u46308 \u51032  \u49900 \u47161 \u50640  \u47568 \u50432 \u54616 \u49512 \u45796 . \u44536  \u44208 \u44284 \u47196  \u47566 \u51008  \u49324 \u46988 \u46308 \u51060  \u44618 \u51008  \u55141 \u48120 \u47484  \u44032 \u51648 \u44256  \u49457 \u44221 \u50672 \u44396 \u47484  \u45796 \u49884  \u54616 \u44172  \u46104 \u50632 \u44256 , \u48169 \u53461 \u54616 \u44256  \u48512 \u51208 \u51228 \u54620  \u49324 \u46988 \u46308 \u51060  \u49373 \u54876 \u51012  \u44060 \u54785 \u54616 \u50688 \u45796 . \u46608 \u54620  \u45796 \u47480  \u49324 \u46988 \u46308 \u51008  \u48512 \u51221 \u51649 \u54620  \u54665 \u46041 \u51012  \u44256 \u52824 \u45716  \u54620 \u54200  \u45320 \u47924 \u45208  \u46748 \u47159 \u54620  \u50629 \u51201 \u46308 \u51060  \u49373 \u44592 \u44172  \u46120 \u51004 \u47196  \u44397 \u44368 \u54924 \u51032  \u49457 \u51649 \u51088 \u51068 \u51648 \u46972 \u46020  \u50612 \u52236 \u54624  \u49688  \u50630 \u51060  \u51060  \u50868 \u46041 \u50640  \u54616 \u45208 \u45784 \u44760 \u49436  \u44057 \u51060  \u54616 \u49888 \u45796 \u45716  \u44163 \u51012  \u49849 \u51064 \u54624  \u49688 \u48150 \u50640  \u50630 \u50632 \u45796 .\
\uc0\u44396 \u51452 \u51032  \u51116 \u47548 \u44592 \u48324 \u51012  \u49828 \u52856 \u46356 \u45208 \u48708 \u50500  \u50668 \u47084  \u45208 \u46972 \u50640  \u51204 \u54028 \u54616 \u45716  \u44163 \u51060  \u54616 \u45208 \u45784 \u51032  \u46907 \u51060 \u50632 \u45796 . \u44536 \u47084 \u48064 \u47196  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u51333 \u46308 \u51032  \u49548 \u47532 \u44032  \u51104 \u51104 \u54616 \u44172  \u46104 \u51088 , \u45817 \u49888 \u51032  \u49324 \u50629 \u51012  \u49457 \u52712 \u54616 \u49884 \u44592  \u50948 \u54616 \u50668  \u50612 \u47536 \u50500 \u51060 \u46308 \u50640 \u44172  \u49457 \u47161 \u51012  \u48512 \u50612  \u51452 \u49492 \u49436  \u51068 \u54616 \u44172  \u54616 \u49512 \u45796 . \u51068 \u52237 \u51060  \u50696 \u49688 \u45784 \u44760 \u49436  \u45817 \u49888 \u51012  \u45796 \u50967 \u51032  \u51088 \u49552 \u51060 \u46972 \u44256  \u48512 \u47476 \u47732 \u49436  \u51333 \u47140 \u45208 \u47924  \u44032 \u51648 \u47484  \u55124 \u46308 \u44256  \u54872 \u54840 \u49457 \u51012  \u50732 \u47532 \u45716  \u47566 \u51008  \u47924 \u47532 \u47484  \u44144 \u45712 \u47532 \u44256  \u50696 \u47336 \u49332 \u47128  \u44032 \u44620 \u51060  \u51060 \u47476 \u49512 \u51012  \u46412  \u51656 \u53804 \u49900 \u51060  \u47566 \u51008  \u48148 \u47532 \u49352 \u51064 \u46308 \u51008  \u44536 \u48516 \u50640 \u44172  \u44536 \u46308 \u51012  \u51104 \u51104 \u54616 \u44172  \u54616 \u46972 \u44256  \u50836 \u44396 \u54616 \u50688 \u45796 . \u44536  \u46412 \u50640  \u50696 \u49688 \u45784 \u44760 \u49436 \u45716  \u44536  \u47784 \u46304  \u51068 \u51060  \u50696 \u50616 \u51032  \u49457 \u52712 \u51060 \u48064 \u47196  \u47564 \u51068  \u44536 \u46308 \u51060  \u51104 \u51104 \u54624  \u44163  \u44057 \u51004 \u47732  \u46028 \u46308 \u51060  \u49548 \u47532  \u51648 \u47476 \u47532 \u46972 \u44256  \u45824 \u45813 \u54616 \u49512 \u45796 . \u48177 \u49457 \u46308 \u51008  \u51228 \u49324 \