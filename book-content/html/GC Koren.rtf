\u51080 \u50612 \u49436 \u46020  \u50612 \u47536 \u50500 \u51060 \u46308 \u51012  \u53685 \u54616 \u50668  \u51068 \u54616 \u49512 \u45796 . \u44396 \u51452 \u44760 \u49436  \u45796 \u49884  \u50724 \u49888 \u45796 \u45716  \u44592 \u48324 \u51060  \u47784 \u46304  \u45208 \u46972 \u50752  \u51648 \u48169 \u44284  \u48177 \u49457 \u50640 \u44172  \u51204 \u54028 \u46112  \u44163 \u51060 \u46972 \u45716  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51008  \u48152 \u46300 \u49884  \u49457 \u52712 \u46104 \u50612 \u50556  \u54620 \u45796 .\
