\'93\uc0\u50864 \u47532 \u45716  \u51060  \u48277 \u47161 \u51012  \u48512 \u51064 \u54616 \u44592 \u47196  \u54616 \u51088 . \u51201 \u50612 \u46020  \u50577 \u49900  \u47928 \u51228 \u50640  \u44288 \u54616 \u50668 \u49436 \u45716  \u45796 \u49688 \u44032  \u44428 \u47141 \u51012  \u44032 \u51648 \u45716  \u44163 \u51060  \u50500 \u45768 \u45796 \'94\u46972 \u44256  \u51228 \u54980 \u46308 \u51008  \u47568 \u54616 \u50688 \u45796 . \u44536 \u47532 \u44256  \u45824 \u51032 \u50896  (\u20195 \u35696 \u21729 ) \u46308 \u51008  \u45796 \u51020 \u44284  \u44057 \u51060  \u49440 \u50616 \u54616 \u50688 \u45796 . \'93\u50864 \u47532 \u44032  \u44397 \u44032 \u51032  \u54217 \u54868 \u47484  \u45572 \u47532 \u45716  \u44163 \u51008  1526\u45380 \u51032  \u52825 \u47161 \u51004 \u47196  \u47568 \u48120 \u50516 \u45716  \u44163 \u51060 \u45796 . \u51060 \u47484  \u54224 \u51648 \u54616 \u45716  \u44163 \u51008  \u50728  \u46021 \u51068 \u51012  \u48516 \u51137 \u44284  \u54844 \u46976  \u44032 \u50868 \u45936  \u48736 \u46888 \u47532 \u45716  \u44163 \u51060 \u45796 . \u44536 \u47084 \u48064 \u47196  \u44397 \u54924 \u45716  \u51204 \u52404  \u54924 \u51032 \u44032  \u50676 \u47532 \u44592 \u44620 \u51648 \u45716  \u49888 \u44368 \u51032  \u51088 \u50976 \u47484  \u48372 \u51316 \u54616 \u45716  \u44163  \u51060 \u50808 \u50640 \u45716  \u50500 \u47924 \u44163 \u46020  \u54624  \u49688  \u50630 \u45796 \'94 (D\'92Aubigne, b.13, ch.5). \u50577 \u49900 \u51032  \u51088 \u50976 \u47484  \u51648 \u53412 \u45716  \u44163 \u51008  \u44397 \u44032 \u51032  \u51032 \u47924 \u51060 \u45796 . \u44536 \u47084 \u45208  \u51333 \u44368 \u50640  \u44288 \u54620  \u47928 \u51228 \u50640  \u51080 \u50612 \u49436 \u45716  \u44536  \u44428 \u54620 \u51060  \u51228 \u54620 \u46104 \u50612  \u51080 \u45796 . \u47784 \u46304  \u51221 \u48512 \u44032  \u44397 \u44032 \u51032  \u44428 \u50948 \u47196 \u50024  \u51333 \u44368 \u51032  \u51032 \u49885 \u51012  \u44508 \u51221 \u54616 \u44144 \u45208  \u44053 \u50836 \u54616 \u47140 \u44256  \u54616 \u45716  \u44163 \u51008  \u48373 \u51020 \u54028  \u44536 \u47532 \u49828 \u46020 \u51064 \u46308 \u51060  \u44536 \u52376 \u47100  \u44256 \u44480 \u54616 \u44172  \u53804 \u51137 \u54644 \u49436  \u51648 \u53412 \u47140 \u44256  \u54620  \u48148 \u47196  \u44536  \u50896 \u52825 \u51012  \u55148 \u49373 \u49884 \u53412 \u44256  \u51080 \u45716  \u44163 \u51060 \u45796 .\
\uc0\u48277 \u50773 \u45817 \u51008  \u44536 \u46308 \u51060  \u49548 \u50948  \'93\u45824 \u45812 \u54620  \u44256 \u51665 \'94\u51060 \u46972 \u44256  \u51060 \u47492 \u51012  \u48537 \u51064  \u49324 \u46988 \u46308 \u51012  \u47736 \u51208 \u49884 \u53412 \u44592 \u47196  \u44208 \u49900 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u47676 \u51200  \u44060 \u54785  \u50868 \u46041 \u51012  \u51648 \u51648 \u54616 \u45716  \u49324 \u46988 \u46308  \u49324 \u51060 \u50640  \u48516 \u50676 \u51012  \u51068 \u51004 \u53412 \u44256 \u51088  \u45432 \u47141 \u54616 \u44256 , \u45796 \u51020 \u50640 \u45716  \u50500 \u51649  \u44277 \u44277 \u50672 \u54616 \u44172  \u44060 \u54785 \u54028 \u51032  \u54840 \u51032 \u47484  \u48372 \u51060 \u51648  \u50500 \u45768 \u54620  \u49324 \u46988 \u46308 \u51012  \u54801 \u48149 \u54616 \u50688 \u45796 . \u44033  \u51088 \u50976 \u49884 \u51032  \u45824 \u54364 \u46308 \u51008  \u47560 \u52840 \u45236  \u44397 \u54924 \u50640  \u54840 \u52636 \u46104 \u50612  \u44536  \u48277 \u47161 \u51032  \u51312 \u44148 \u46308 \u50640  \u49692 \u51333  \u50668 \u48512 \u47484  \u45208 \u53440 \u45236 \u46972 \u45716  \u50836 \u44396 \u47484  \u48155 \u50520 \u45796 . \u44536 \u46308 \u51008  \u49884 \u44036 \u51032  \u50668 \u50976 \u47484  \u45804 \u46972 \u44256  \u54616 \u50688 \u51004 \u45208  \u54728 \u46973 \u46104 \u51648  \u50506 \u50520 \u45796 . \u44536 \u46308 \u50640 \u44172  \u49884 \u54744 \u51060  \u51228 \u49884 \u46104 \u51088  \u44144 \u51032  \u48152 \u49688  \u44032 \u47049 \u51008  \u44060 \u54785 \u51088 \u51032  \u54200 \u50640  \u44032 \u45812 \u54616 \u50688 \u45796 . \u44536  \u49324 \u46988 \u46308 \u51008  \u50577 \u49900 \u51032  \u51088 \u50976 \u50752  \u44033  \u44060 \u51064 \u51060  \u49828 \u49828 \u47196  \u54032 \u45800 \u54616 \u45716  \u44428 \u47532 \u47484  \u55148 \u49373 \u54616 \u44592 \u47484  \u44144 \u51208 \u54632 \u51004 \u47196  \u51109 \u52264  \u48708 \u45212 \u44284  \u51221 \u51396 \u50752  \u48149 \u54644 \u51032  \u54364 \u51201  (\u27161 \u30340 ) \u51060  \u46112  \u44163 \u51012  \u51096  \u50508 \u44256  \u51080 \u50632 \u45796 . \u45824 \u51032 \u50896  \u51473 \u51032  \u54620  \u49324 \u46988 \u51008  \'93\u50864 \u47532 \u45716  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51012  \u44144 \u51208 \u54616 \u46304 \u51648  \u44536 \u47111 \u51648  \u50506 \u51004 \u47732  \u54868 \u54805 \u51012  \u48155 \u46304 \u51648  \u46168  \u51473  \u54616 \u45208 \u47484  \u52712 \u54616 \u44256 \u50556  \u47568  \u44163 \u51060 \u45796 \'94 (D\'92Aubigne, b.13, ch.5) \u44256  \u47568 \u54616 \u50688 \u45796 .\
\uc0\u54889 \u51228 \u51032  \u45824 \u54364 \u51088 \u47196  \u54924 \u51032 \u50640  \u51076 \u49437 \u54620  \u54168 \u47476 \u46356 \u45212 \u53944  (Ferdinand) \u50773 \u51008  \u51228 \u54980 \u46308 \u51060  \u48277 \u47161 \u51012  \u49849 \u51064 \u54616 \u44256  \u51648 \u51648 \u54616 \u45716  \u45936  \u44032 \u45812 \u54616 \u51648  \u50506 \u45716 \u45796 \u47732  \u49900 \u49345 \u52824  \u50506 \u51008  \u48516 \u50676 \u51060  \u51068 \u50612 \u45216  \u44163 \u51012  \u50508 \u50520 \u45796 . \u44536 \u47084 \u45208  \u54253 \u47141 \u51012  \u49324 \u50857 \u54616 \u47732  \u44536 \u46308 \u51032  \u44208 \u49900 \u51012  \u54620 \u52789  \u45908  \u44403 \u44172  \u54644 \u51460  \u44163 \u51060 \u46972 \u45716  \u44163 \u51012  \u50508 \u50520 \u51004 \u48064 \u47196  \u44536 \u46308 \u51012  \u49444 \u46301 \u49884 \u53412 \u44256 \u51088  \u54616 \u50688 \u45796 . \u44536 \u45716  \'93\u51228 \u54980 \u46308 \u51060  \u48277 \u47161 \u51012  \u49849 \u51064 \u54644  \u51452 \u44592 \u47484  \u48716 \u47732 \u49436  \u54889 \u51228 \u44032  \u44536 \u46308 \u51012  \u52280 \u51004 \u47196  \u44592 \u48848 \u54624  \u44163 \u51060 \u46972 \u44256  \u48372 \u51613 \u54616 \u50688 \u45796 .\'94 \u44536 \u47084 \u45208  \u44536  \u52649 \u49457 \u46108  \u51228 \u54980 \u46308 \u51008  \u49464 \u49345  \u53685 \u52824 \u51088 \u46308 \u51060  \u44032 \u51652  \u44428 \u50948  \u51060 \u49345 \u51032  \u44428 \u50948 \u47484  \u51064 \u51221 \u54616 \u50688 \u45796 . \u44536 \u47084 \u48064 \u47196  \u44536 \u46308 \u51008  \'93\u50864 \u47532 \u45716  \u54616 \u45208 \u45784 \u44760  \u49549 \u54620  \u50689 \u44305 \u44284  \u54217 \u54868 \u47484  \u50976 \u51648 \u54616 \u44172  \u54616 \u45716  \u51068 \u51060 \u46972 \u47732  \u47924 \u50631 \u51060 \u46304 \u51648  \u54889 \u51228 \u51032  \u47749 \u47161 \u50640  \u48373 \u51333 \u54616 \u44192 \u49845 \u45768 \u45796 \'94 (D\'92Aubigne, b.13, ch.5) \u44256  \u51312 \u50857 \u55176  \u45824 \u45813 \u54616 \u50688 \u45796 .\
\uc0\u51032 \u54924 \u50640 \u49436 , \u50773 \u51008  \u47560 \u52840 \u45236  \u49440 \u54980 \u50752  \u44536 \u51032  \u46041 \u47308 \u46308 \u51012  \u54693 \u54616 \u50668  \u51060  \u54252 \u44256 \u45716  \'93\u54889 \u51228 \u51032  \u52825 \u47161 \u51032  \u54805 \u49885 \u51012  \u52712 \u54616 \u50668  \u51089 \u49457 \u46108  \u44163 \u51060 \u48064 \u47196  \u50724 \u51649  \u54620  \u44032 \u51648 \u51032  \u44600 \u51008  \u51473 \u51032  (\u34886 \u35696 ) \u50640  \u48373 \u51333 \u54616 \u45716  \u44163 \u48150 \u50640  \u50630 \u45796 \'94\u44256  \u49440 \u50616 \u54616 \u50688 \u45796 . \u44536 \u45716  \u47568 \u51012  \u47560 \u52824 \u51088  \u44060 \u54785 \u51088 \u46308 \u50640 \u44172  \u44256 \u47140 \u54624  \u44592 \u54924 \u45208  \u45824 \u45813 \u54624  \u44592 \u54924 \u47484  \u51312 \u44552 \u46020  \u51452 \u51648  \u50500 \u45768 \u54616 \u44256  \u53748 \u51109 \u54616 \u50688 \u45796 . \u46907 \u48150 \u51032  \u51068 \u51060 \u50632 \u51004 \u48064 \u47196 , \u44536 \u46308 \u51008  \u47751  \u49324 \u46988 \u51032  \u49324 \u51088 \u47484  \u48372 \u45236 \u50612  \u50773 \u51060  \u45796 \u49884  \u54924 \u51032 \u51109 \u51004 \u47196  \u46028 \u50500 \u50724 \u46020 \u47197  \u44036 \u52397 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51032  \u44036 \u52397 \u50640  \u45824 \u54616 \u50668  \u44536 \u45716  \'93\u44536 \u44163 \u51008  \u51060 \u48120  \u54644 \u44208 \u46108  \u47928 \u51228 \u51060 \u45796 . \u51060 \u51228  \u45224 \u51008  \u44163 \u51008  \u48373 \u51333 \u54616 \u45716  \u44163 \u49104 \u51060 \u45796 \'94 (D\'92Au-bigne, b.13, ch.5) \u44256  \u45824 \u45813 \u54616 \u50688 \u45796 .\
\uc0\u54889 \u51228 \u52769 \u50640 \u49436 \u45716  \u44536 \u47532 \u49828 \u46020 \u51064  \u51228 \u54980 \u46308 \u51060  \u49324 \u46988 \u51032  \u44368 \u47532  (\u25934 \u29702 ) \u50752  \u49324 \u46988 \u51032  \u50836 \u44396 \u48372 \u45796  \u49457 \u44221 \u51012  \u51452 \u51109 \u54616 \u50668  \u44403 \u44172  \u51648 \u53420  \u44163 \u51012  \u50508 \u50520 \u44256 , \u46608 \u54620  \u51060  \u50896 \u52825 \u51060  \u51064 \u51221 \u46104 \u45716  \u44275 \u51008  \u50612 \u46356 \u50640 \u49436 \u45208  \u48277 \u50773 \u44368 \u44032  \u47560 \u52840 \u45236  \u47924 \u45320 \u51648 \u44256  \u47568  \u44163 \u51012  \u50508 \u50520 \u45796 . \u44536 \u47084 \u45208  \u44536  \u49884 \u45824  \u51060 \u54980 \u47196  \u49688 \u47566 \u51008  \u49324 \u46988 \u46308 \u51060  \u44536 \u47084 \u54664 \u45912  \u44163 \u52376 \u47100  \u44536 \u46308 \u51008  \u48372 \u51060 \u45716  \u44163 \u47564 \u51012  \u48148 \u46972 \u48372 \u50520 \u51004 \u48064 \u47196 , \u54889 \u51228 \u50752  \u48277 \u50773 \u51032  \u49324 \u50629 \u51008  \u44053 \u54616 \u44256  \u44060 \u54785 \u51088 \u51032  \u49324 \u50629 \u51008  \u50557 \u54616 \u45796 \u44256  \u49373 \u44033 \u54616 \u44256  \u49828 \u49828 \u47196  \u51088 \u47564 \u54616 \u50688 \u45796 . \u44060 \u54785 \u51088 \u46308 \u51060  \u49324 \u46988 \u46308 \u51032  \u55192 \u47564 \u51012  \u51032 \u51648 \u54616 \u50688 \u45796 \u47732  \u48277 \u50773 \u45817 \u51060  \u49373 \u44033 \u54664 \u45912  \u48148 \u50752  \u44057 \u51060  \u44536 \u46308 \u51008  \u47924 \u47141 \u54616 \u50688 \u51012  \u44163 \u51060 \u45796 . \u44536 \u47084 \u45208  \u48708 \u47197  \u49688 \u45716  \u51201 \u44256  \u47196 \u47560 \u50752 \u46020  \u48520 \u54868 \u54620  \u49324 \u51060 \u50688 \u51012 \u51648 \u46972 \u46020  \u44536 \u46308 \u51008  \u44536 \u46308 \u45824 \u47196 \u51032  \u55192 \u51012  \u44032 \u51648 \u44256  \u51080 \u50632 \u45796 . \u44536 \u46308 \u51008  \'93\u51060  \u51032 \u54924 \u51032  \u44208 \u51032 \u48372 \u45796 \u46020  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51012 , \u52852 \u50508  \u54889 \u51228 \u48372 \u45796 \u46020  \u47564 \u50773 \u51032  \u50773 , \u47564 \u51452 \u51032  \u51452 \u51060 \u49888  \u50696 \u49688  \u44536 \u47532 \u49828 \u46020 \u47484 \'94 (D\'92Aubigne, b.13, ch.6) \u45908 \u50865  \u49888 \u47280 \u54616 \u50688 \u45796 .\
