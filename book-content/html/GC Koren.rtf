\uc0\u46021 \u51068 \u51032  \u51333 \u44368 \u44060 \u54785 \u51032  \u49849 \u47532 \u47484  \u45208 \u53440 \u45256 \u45912  \u49828 \u54028 \u51060 \u50620 \u49828 \u51032  \u54637 \u51032 \u50752  \u50500 \u50864 \u53356 \u49828 \u48512 \u47476 \u53356 \u51032  \u49888 \u50521  \u44256 \u48177 \u50640  \u46244 \u51060 \u50612  \u50668 \u47084  \u54644  \u46041 \u50504  \u53804 \u51137 \u44284  \u50516 \u55121 \u51060  \u44228 \u49549 \u46104 \u50632 \u45796 . \u45236 \u48512 \u51032  \u48516 \u50676 \u47196  \u47568 \u48120 \u50516 \u50500  \u50557 \u54616 \u50668 \u51276 \u51012  \u49104  \u50500 \u45768 \u46972  \u44053 \u47141 \u54620  \u51201 \u51032  \u45128 \u51656 \u44596  \u44277 \u44201 \u50640  \u49884 \u45804 \u47536  \u54532 \u47196 \u53580 \u49828 \u53444 \u53944 \u51452 \u51032 \u45716  \u50756 \u51204 \u55176  \u45336 \u50612 \u51656  \u50868 \u47749 \u50640  \u52376 \u54620  \u46319 \u51060  \u48372 \u50688 \u45796 . \u49688 \u52380  \u47749 \u51032  \u49324 \u46988 \u46308 \u51060  \u54588 \u47196 \u50024  \u44536 \u46308 \u51032  \u51613 \u44144 \u47484  \u51064 \u52452 \u45796 . \u45236 \u46976 \u51060  \u51068 \u50612 \u45208 \u44256 , \u44060 \u54785  \u50868 \u46041 \u51008  \u44536  \u51648 \u46020 \u51088  \u51473  \u54620  \u49324 \u46988 \u51004 \u47196  \u47568 \u48120 \u50516 \u50500  \u48176 \u48152 \u51012  \u45817 \u54616 \u50688 \u45796 . \u44060 \u54785 \u54028 \u52769 \u51032  \u44032 \u51109  \u51316 \u44480 \u54620  \u51228 \u54980 \u46308 \u51060  \u54889 \u51228 \u51032  \u49552 \u50640  \u45336 \u50612 \u44032 \u49436  \u54252 \u47196 \u47196 \u49436  \u51060  \u49457 \u50640 \u49436  \u51200  \u49457 \u51004 \u47196  \u45132 \u47140  \u45796 \u45396 \u45796 . \u44536 \u47084 \u45208  \u49849 \u47532 \u54620  \u46319 \u51060  \u48372 \u50688 \u45912  \u44536  \u49692 \u44036 \u50640  \u54889 \u51228 \u45716  \u54056 \u48176 \u47484  \u45817 \u54616 \u50688 \u45796 . \u44536 \u45716  \u49324 \u47196 \u51105 \u50500  \u45459 \u51008  \u54252 \u47196 \u46308 \u51060  \u44536 \u51032  \u49552 \u50640 \u49436  \u48736 \u51256  \u45208 \u44052 \u45796 \u45716  \u44163 \u51012  \u44648 \u45803 \u44172  \u46104 \u50632 \u44256 , \u44536 \u44032  \u51068 \u49373 \u51032  \u50837 \u47581 \u51004 \u47196  \u49340 \u44256  \u47736 \u51208 \u49884 \u53412 \u44256 \u51088  \u54620  \u44536  \u44368 \u47532 \u47484  \u47560 \u52840 \u45236  \u47925 \u51064 \u54616 \u51648  \u50506 \u51012  \u49688  \u50630 \u44172  \u46104 \u50632 \u45796 . \u44536 \u45716  \u51060 \u47480 \u48148  \u51060 \u45800 \u51012  \u48149 \u47736 \u54616 \u44592  \u50948 \u54616 \u50668  \u51088 \u44592 \u51032  \u45208 \u46972 , \u51116 \u49328 , \u49373 \u47749 \u44620 \u51648 \u46020  \u44152 \u50632 \u50632 \u45796 . \u44536 \u47084 \u45208  \u51060 \u51228  \u44536 \u45716 , \u44400 \u51064 \u46308 \u51008  \u51204 \u51137 \u51004 \u47196  \u54588 \u47196 \u54644 \u51276 \u44256  \u44397 \u44256 \u45716  \u48148 \u45797 \u51060  \u45228 \u44256 , \u44397 \u45236  \u44033 \u52376 \u45716  \u48152 \u46976 \u51004 \u47196  \u50948 \u54801 \u51012  \u48155 \u44256  \u51080 \u45716  \u48152 \u47732 , \u44536 \u44032  \u51652 \u50517 \u54616 \u44256 \u51088  \u54747 \u46104 \u51060  \u45432 \u47141 \u54616 \u44256  \u51080 \u45912  \u44060 \u54785 \u51452 \u51032 \u45716  \u44033 \u52376 \u50640 \u49436  \u49464 \u47141 \u51012  \u54869 \u51109 \u54644  \u44032 \u44256  \u51080 \u45716  \u44163 \u51012  \u48372 \u50520 \u45796 . \u52852 \u50508  5\u49464 \u45716  \u51208 \u45824 \u51088 \u51032  \u44428 \u45733 \u50640  \u45824 \u54637 \u54616 \u50668  \u49912 \u50864 \u44256  \u51080 \u50632 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436  \'93\u48731 \u51060  \u51080 \u51004 \u46972 \'94\u44256  \u47568 \u50432 \u54616 \u49512 \u51020 \u50640 \u46020  \u48520 \u44396 \u54616 \u44256  \u54889 \u51228 \u45716  \u50516 \u55121 \u51012  \u44648 \u46888 \u47532 \u51648  \u50506 \u44256  \u44536 \u45824 \u47196  \u50976 \u51648 \u54616 \u47140 \u44256  \u45432 \u47141 \u54616 \u50688 \u45912  \u44163 \u51060 \u45796 . \u44536 \u51032  \u47785 \u51201 \u51008  \u45804 \u49457 \u46104 \u51648  \u47803 \u54616 \u50688 \u45796 . \u50668 \u47084  \u54644  \u46041 \u50504 \u51032  \u51204 \u51137 \u51004 \u47196  \u54588 \u47196 \u54644 \u51652  \u51312 \u47196  (\u26089 \u32769 ) \u54620  \u54889 \u51228 \u45716  \u53748 \u50948 \u54616 \u50668  \u49688 \u46020 \u50896 \u50640  \u47931 \u54784  \u49332 \u44172  \u46104 \u50632 \u45796 .\
\uc0\u49828 \u50948 \u49828 \u50640 \u46020  \u46021 \u51068 \u50640 \u49436 \u50752  \u44057 \u51060  \u51333 \u44368 \u44060 \u54785 \u50640  \u50516 \u55121  \u49884 \u45824 \u44032  \u50772 \u45796 . \u47566 \u51008  \u51452  (\u24030 ) \u46308 \u51008  \u44060 \u54785 \u51452 \u51032 \u47484  \u48155 \u50500 \u46308 \u50688 \u51004 \u45208 , \u44536 \u47111 \u51648  \u50500 \u45768 \u54620  \u51452 \u46308 \u51008  \u47609 \u47785 \u51201 \u51004 \u47196  \u47196 \u47560 \u44368 \u51032  \u49888 \u51312 \u47484  \u44256 \u49688 \u54616 \u50688 \u45796 . \u44536 \u47532 \u44256  \u44536 \u46308 \u51060  \u51652 \u47532 \u47484  \u48155 \u50500 \u46308 \u51060 \u44592 \u47484  \u44040 \u47581 \u54620  \u49324 \u46988 \u46308 \u50640  \u45824 \u54620  \u54605 \u48149 \u51004 \u47196  \u46300 \u46356 \u50612  \u45236 \u46976 \u51060  \u51068 \u50612 \u45228 \u45796 . \u52768 \u48729 \u44544 \u47532  (Zwingli) \u50752  \u51333 \u44368 \u44060 \u54785 \u50640  \u44536 \u50752  \u54632 \u44760  \u50672 \u54633 \u54664 \u45912  \u47566 \u51008  \u46041 \u51648 \u46308 \u51060  \u52852 \u54176  (Cappel) \u51032  \u54792 \u51204 \u50640 \u49436  \u51204 \u49324 \u54616 \u50688 \u45796 . \u51060  \u46160 \u47140 \u50868  \u51116 \u45212 \u50640  \u50517 \u46020 \u45817 \u54620  \u50640 \u53084 \u46988 \u54028 \u46356 \u50864 \u49828  (Ecolampadius) \u46020  \u50620 \u47560  \u54980 \u50640  \u51453 \u50632 \u45796 . \u47196 \u47560 \u45716  \u49849 \u47532 \u51088 \u44032  \u46104 \u50632 \u45796 . \u44536 \u47000 \u49436  \u50668 \u47084  \u44275 \u50640 \u49436  \u51068 \u52237 \u51060  \u51075 \u50612 \u48260 \u47160 \u45912  \u44163 \u51012  \u54924 \u48373 \u54624  \u44163 \u52376 \u47100  \u48372 \u50688 \u45796 . \u44536 \u47084 \u45208  \u50689 \u50896  \u51204 \u48512 \u53552  \u47785 \u51201 \u51012  \u44032 \u51648 \u44256  \u44228 \u49884 \u45716  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u49324 \u50629 \u44284  \u45817 \u49888 \u51032  \u48177 \u49457 \u51012  \u44208 \u53076  \u48260 \u47532 \u51648  \u50506 \u51004 \u49512 \u45796 . \u44536 \u48516 \u44760 \u49436 \u45716  \u44536 \u46308 \u51012  \u44396 \u50896 \u54616 \u49884 \u44256 \u51088  \u45817 \u49888 \u51032  \u49552 \u51012  \u46300 \u49512 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u45796 \u47480  \u45208 \u46972 \u50640 \u49436  \u44060 \u54785  \u49324 \u50629 \u51012  \u52628 \u51652 \u54624  \u51068 \u44988 \u46308 \u51012  \u51068 \u51004 \u53412 \u49512 \u45796 .\
