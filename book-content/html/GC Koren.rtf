\uc0\u44536  \u47924 \u47157 \u50640  \u44305 \u49888  (\u29378 \u20449 ) \u51060  \u45208 \u53440 \u45208 \u44592  \u49884 \u51089 \u54616 \u50688 \u45796 . \u51068 \u52237 \u51060  \u44592 \u48324 \u51012  \u50676 \u47148 \u54616 \u44172  \u48127 \u50632 \u45912  \u50612 \u46500  \u49324 \u46988 \u46308 \u51008  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51060  \u44536 \u47495 \u46120 \u51060  \u50630 \u45716  \u51648 \u52840 \u51060  \u46108 \u45796 \u45716  \u49324 \u49892 \u51012  \u48512 \u51064 \u54616 \u44256 , \u49828 \u49828 \u47196  \u49457 \u47161 \u51032  \u51648 \u46020 \u47484  \u48155 \u50500 \u50556  \u54620 \u45796 \u44256  \u51452 \u51109 \u54616 \u47732 \u49436  \u51088 \u49888 \u51012  \u44536 \u46308 \u51032  \u44048 \u51221 , \u44592 \u48516 , \u49345 \u49345 \u50640  \u45236 \u50612  \u47585 \u44592 \u44172  \u46104 \u50632 \u45796 . \u46608 \u54620  \u47609 \u47785 \u51201 \u51060 \u50836  \u50756 \u44256 \u54620  \u50676 \u49457 \u51012  \u45208 \u53440 \u45236 \u47732 \u49436  \u44536 \u46308 \u51032  \u54665 \u50948 \u47484  \u51064 \u51221 \u54616 \u51648  \u50506 \u45716  \u49324 \u46988 \u46308 \u51012  \u48708 \u45212 \u54616 \u45716  \u51088 \u46308 \u46020  \u51080 \u50632 \u45796 . \u44536 \u46308 \u51032  \u44305 \u49888 \u51201  \u49324 \u49345 \u44284  \u54665 \u46041 \u51008  \u45824 \u48512 \u48516 \u51032  \u51116 \u47548 \u49888 \u51088 \u46308 \u51032  \u54840 \u51025 \u51012  \u48155 \u51648  \u47803 \u54616 \u50688 \u45796 . \u46608 \u54620  \u44536 \u46308 \u51008  \u51652 \u47532 \u51032  \u49324 \u50629 \u51060  \u48708 \u45212 \u51012  \u48155 \u44172  \u54616 \u50688 \u45796 .\
\uc0\u49324 \u45800 \u51008  \u51060 \u47088  \u48169 \u48277 \u51004 \u47196  \u54616 \u45208 \u45784 \u51032  \u49324 \u50629 \u51012  \u48152 \u45824 \u54616 \u44256  \u54028 \u44340 \u54616 \u44256 \u51088  \u45432 \u47141 \u54616 \u44256  \u51080 \u50632 \u45796 . \u49324 \u46988 \u46308 \u51008  \u51116 \u47548 \u50868 \u46041 \u51004 \u47196  \u47568 \u48120 \u50516 \u50500  \u53356 \u44172  \u44048 \u46041 \u46104 \u50632 \u51004 \u47728  \u48708 \u47197  \u51648 \u52404 \u54616 \u45716  \u49884 \u44592 \u50640 \u46020  \u47924 \u49688 \u54620  \u51396 \u51064 \u46308 \u51060  \u54924 \u44060 \u54616 \u50688 \u44256 , \u52649 \u49457 \u46108  \u49324 \u46988 \u46308 \u51008  \u51652 \u47532 \u47484  \u51204 \u54616 \u45716  \u49324 \u50629 \u50640  \u54732 \u49888 \u54616 \u50688 \u45796 . \u50501 \u51032  \u50773 \u51008  \u51088 \u44592 \u51032  \u48512 \u54616 \u46308 \u51012  \u51075 \u50612 \u48260 \u47532 \u44172  \u46104 \u50632 \u51004 \u48064 \u47196  \u54616 \u45208 \u45784 \u51032  \u49324 \u50629 \u50640  \u48708 \u45212 \u51012  \u52488 \u47000 \u52992  \u54616 \u44592  \u50948 \u54616 \u50668  \u49888 \u50521 \u51012  \u44256 \u48177 \u54620  \u47751  \u49324 \u46988 \u46308 \u51012  \u44592 \u47564 \u54616 \u50668  \u44537 \u45800 \u51004 \u47196  \u45208 \u44032 \u44172  \u54616 \u44256 \u51088  \u45432 \u47141 \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u51088 \u44592 \u51032  \u48512 \u54616 \u46308 \u47196  \u54616 \u50668 \u44552  \u44536 \u46308 \u51032  \u47784 \u46304  \u51096 \u47803 , \u47784 \u46304  \u49892 \u54056 , \u47784 \u46304  \u44148 \u51204 \u52824  \u47803 \u54620  \u54665 \u46041 \u46308 \u51012  \u52286 \u50500 \u45236 \u44172  \u54616 \u50668  \u44536 \u44163 \u46308 \u51012  \u44032 \u51109  \u53356 \u44172  \u44284 \u51109 \u54616 \u50668  \u44536 \u44163 \u51060  \u48148 \u47196  \u51116 \u47548 \u49888 \u46020 \u46308 \u51032  \u48127 \u51020 \u51060  \u51339 \u51648  \u47803 \u54620  \u51613 \u4414