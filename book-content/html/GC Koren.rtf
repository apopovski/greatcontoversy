\uc0\u44536 \u47084 \u45208  \u48276 \u51396 \u54620  \u54980  \u50500 \u45812 \u51060  \'93\u45348 \u44032  \u47673 \u45716  \u45216 \u50640 \u45716  \u51221 \u45397  \u51453 \u51004 \u47532 \u46972 \'94\u44256  \u54620  \u47568 \u50432 \u51032  \u51032 \u48120 \u44032  \u47924 \u50631 \u51076 \u51012  \u44648 \u45804 \u50520 \u51012 \u44620 ? \u44536 \u45716  \u49324 \u45800 \u51060  \u45908 \u50865  \u44256 \u49345 \u54620  \u49345 \u53468 \u47196  \u48148 \u45076  \u44163 \u51060 \u46972 \u44256  \u54869 \u49888 \u52992  \u54664 \u45912  \u44536 \u45824 \u47196  \u46108  \u44163 \u51012  \u48156 \u44204 \u54664 \u45912 \u44032 ? \u47564 \u51068  \u51396 \u47484  \u48276 \u54632 \u51004 \u47196  \u53356 \u44172  \u51339 \u51008  \u51068 \u51060  \u49373 \u44220 \u45796 \u47732  \u49324 \u45800 \u51008  \u51064 \u47448 \u51032  \u51008 \u51064 \u51076 \u51060  \u51077 \u51613 \u46104 \u50632 \u51012  \u44163 \u51060 \u45796 . \u44536 \u47084 \u45208  \u50500 \u45812 \u51008  \u54616 \u45208 \u45784 \u44760 \u49436  \u49440 \u44256 \u54616 \u49884 \u45716  \u47568 \u50432 \u51032  \u51032 \u48120 \u44032  \u44536 \u47088  \u44163 \u51060  \u46112  \u49688  \u50630 \u51020 \u51012  \u48156 \u44204 \u54664 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u44536 \u44032  \u48276 \u54620  \u51396 \u51032  \u54805 \u48268 \u47196  \u44536 \u44032  \u52712 \u54632 \u51012  \u51077 \u50632 \u45912  \u55129 \u51004 \u47196  \u46028 \u50500 \u44040  \u44163 \u51060 \u46972 \u44256  \u49440 \u50616 \u54616 \u49512 \u45796 . \'93\u45320 \u45716  \u55129 \u51060 \u45768  \u55129 \u51004 \u47196  \u46028 \u50500 \u44040  \u44163 \u51060 \u45768 \u46972 \'94 (\u52285  3:19). \'93\u45320 \u55148  \u45576 \u51060  \u48157 \'94\u51004 \u47532 \u46972 \u44256  \u54620  \u49324 \u45800 \u51032  \u47568 \u51008  \u50724 \u51649  \u45796 \u51020 \u44284  \u44057 \u51008  \u51032 \u48120 \u50640 \u49436 \u47564  \u49324 \u49892 \u51076 \u51060  \u51077 \u51613 \u46104 \u50632 \u45796 . \u50500 \u45812 \u44284  \u54616 \u50752 \u44032  \u54616 \u45208 \u45784 \u44760  \u48520 \u49692 \u51333 \u54616 \u51088  \u44536 \u46308 \u51032  \u45576 \u51060  \u48157 \u50500 \u51256  \u44536 \u46308 \u51032  \u50612 \u47532 \u49437 \u51020 \u51012  \u50508 \u44172  \u46104 \u50632 \u45796 . \u44536 \u46308 \u51008  \u50501 \u51060  \u47924 \u50631 \u51076 \u51012  \u50508 \u44256  \u48276 \u51396 \u51032  \u50420  \u50676 \u47588 \u47484  \u47579 \u48372 \u50520 \u45796 .\
\uc0\u50640 \u45940 \u46041 \u49328 \u51032  \u51473 \u50521 \u50640 \u45716  \u49373 \u47749 \u45208 \u47924 \u44032  \u51088 \u46972 \u44256  \u51080 \u50632 \u45716 \u45936  \u44536  \u50676 \u47588 \u45716  \u49373 \u47749 \u51012  \u50689 \u50896 \u55176  \u51648 \u49549 \u49884 \u53412 \u45716  \u45733 \u47141 \u51060  \u51080 \u50632 \u45796 . \u47564 \u51068  \u50500 \u45812 \u51060  \u54616 \u45208 \u45784 \u44760  \u44228 \u49549 \u54644 \u49436  \u49692 \u51333 \u54616 \u50688 \u51012  \u44163  \u44057 \u51004 \u47732  \u44536 \u45716  \u45130 \u51076 \u50630 \u51060  \u51088 \u50976 \u47213 \u44172  \u44536  \u45208 \u47924 \u50640  \u51217 \u44540 \u54616 \u50668  \u50689 \u50896 \u55176  \u49332 \u44172  \u46104 \u50632 \u51012  \u44163 \u51060 \u45796 . \u44536 \u47084 \u45208  \u44536 \u44032  \u51396 \u47484  \u48276 \u54616 \u51088  \u44536 \u45716  \u49373 \u47749 \u45208 \u47924 \u50640  \u45208 \u50500 \u44040  \u44600 \u51060  \u45130 \u50612 \u51256  \u51453 \u51020 \u50640  \u44404 \u48373 \u54616 \u44172  \u46104 \u50632 \u45796 . \'93\u45320 \u45716  \u55129 \u51060 \u45768  \u55129 \u51004 \u47196  \u46028 \u50500 \u44040  \u44163 \u51060 \u45768 \u46972 \'94\u45716  \u54616 \u45208 \u45784 \u51032  \u49440 \u44256 \u45716  \u50756 \u51204 \u54620  \u49373 \u47749 \u51032  \u54028 \u47736 \u51012  \u50508 \u47140  \u51456 \u45796 .\
\uc0\u49692 \u51333 \u51012  \u51312 \u44148 \u51004 \u47196  \u49324 \u46988 \u50640 \u44172  \u50557 \u49549 \u46108  \u48520 \u47736  (\u63847 \u28357 ) \u51008  \u48276 \u51396 \u47196  \u47568 \u48120 \u50516 \u50500  \u51075 \u50612 \u48260 \u47536  \u48148  \u46104 \u50632 \u45796 . \u50500 \u45812 \u51008  \u51088 \u49888 \u51060  \u49548 \u50976 \u54616 \u51648  \u47803 \u54620  \u44163 \u51012  \u44536 \u51032  \u54980 \u49552 \u50640 \u44172  \u51204 \u54644 \u51460  \u49688  \u50630 \u50632 \u45796 . \u44536 \u47084 \u48064 \u47196  \u54616 \u45208 \u45784 \u44760 \u49436  \u45817 \u49888 \u51032  \u50500 \u46308 \u51032  \u55148 \u49373 \u51004 \u47196  \u48520 \u47736 \u51012  \u44536 \u46308 \u51032  \u49552 \u50640  \u45823 \u45716  \u44275 \u50640  \u46160 \u51648  \u50500 \u45768 \u54616 \u49512 \u51012  \u44163  \u44057 \u51004 \u47732  \u53440 \u46973 \u54620  \u51064 \u47448 \u50640 \u44172  \u49548 \u47581 \u51060  \u50630 \u50632 \u51012  \u44163 \u51060 \u45796 . \'93\u47784 \u46304  \u49324 \u46988 \u51060  \u51396 \u47484  \u51648 \u50632 \u51004 \u48064 \u47196  \u49324 \u47581 \u51060  \u47784 \u46304  \u49324 \u46988 \u50640 \u44172  \u51060 \u47476 \u47104 \u45712 \u45768 \u46972 \'94 (\u47212  5:12). \u44536 \u47084 \u45208  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \'93\u49373 \u47749 \u44284  \u50025 \u51648  \u50500 \u45768 \u54632 \u51012  \u48373 \u51020 \u51004 \u47196 \u50024  \u46300 \u47084 \u45236 \'94 (\u46372 \u54980  1:10) \u49512 \u45796 . \u44536 \u47084 \u48064 \u47196  \u50724 \u51649  \u44536 \u47532 \u49828 \u46020 \u47484  \u53685 \u54644 \u49436 \u47564  \u48520 \u47736 \u51012  \u50619 \u51012  \u49688  \u51080 \u45796 . \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \'93\u50500 \u46308 \u51012  \u48127 \u45716  \u51088 \u45716  \u50689 \u49373 \u51060  \u51080 \u44256  \u50500 \u46308 \u51012  \u49692 \u51333 \u52824  \u50500 \u45768 \u54616 \u45716  \u51088 \u45716  \u50689 \u49373 \u51012  \u48372 \u51648  \u47803 \u54616 \'94 (\u50836  3:36) \u47532 \u46972 \u44256  \u47568 \u50432 \u54616 \u49512 \u45796 . \u45572 \u44396 \u46304 \u51648  \u51060  \u51312 \u44148 \u50640  \u48512 \u54633 \u54616 \u45716  \u51088 \u45716  \u51060  \u47924 \u54620 \u55176  \u44480 \u54620  \u52629 \u48373 \u51012  \u49548 \u50976 \u54624  \u49688  \u51080 \u45796 . \'93\u52280 \u44256  \u49440 \u51012  \u54665 \u54616 \u50668  \u50689 \u44305 \u44284  \u51316 \u44480 \u50752  \u50025 \u51648  \u50500 \u45768 \u54632 \u51012  \u44396 \u54616 \u45716 \'94 (\u47212  2:7) \u47784 \u46304  \u49324 \u46988 \u51008  \u50689 \u49373 \u51012  \u50619 \u51012  \u44163 \u51060 \u45796 .\
\uc0\u50500 \u45812 \u50640 \u44172  \u48520 \u49692 \u51333 \u54624 \u51648 \u46972 \u46020  \u49373 \u47749 \u51012  \u51075 \u50612 \u48260 \u47532 \u51648  \u50506 \u51004 \u47532 \u46972 \u44256  \u50557 \u49549 \u54620  \u50976 \u51068 \u51032  \u51316 \u51116 \u45716  \u53360  \u44592 \u47564 \u51088 \u49104 \u51060 \u50632 \u45796 . \u44536 \u47532 \u44256  \u50640 \u45940 \u46041 \u49328 \u50640 \u49436  \'93\u45320 \u55148 \u44032  \u44208 \u53076  \u51453 \u51648  \u50500 \u45768 \u54616 \u47532 \u46972 \'94\u44256  \u54616 \u50752 \u50640 \u44172  \u47568 \u54620  \u48192 \u51032  \u49440 \u50616 \u51008  \u50689 \u54844  \u48520 \u47736 \u50640  \u44288 \u54620  \u52572 \u52488 \u51032  \u49444 \u44368 \u50688 \u45796 . \u44536 \u47084 \u45208  \u50724 \u47196 \u51648  \u49324 \u45800 \u51032  \u44428 \u50948 \u50640  \u44592 \u52488 \u47484  \u46164  \u51060  \u51452 \u51109 \u51060  \u44536 \u47532 \u49828 \u46020 \u44368 \u44228 \u51032  \u44053 \u45800 \u50640 \u49436  \u48152 \u54693 \u46104 \u44256 , \u47560 \u52824  \u50864 \u47532 \u51032  \u52395  \u51312 \u49345 \u51060  \u44536 \u44163 \u51012  \u48155 \u50500 \u46308 \u50688 \u45912  \u44163 \u44284  \u46609 \u44057 \u51060  \u51064 \u47448 \u51032  \u45824 \u45796 \u49688 \u44032  \u44536 \u44163 \u51012  \u51600 \u44200  \u48155 \u50500 \u46308 \u51060 \u44256  \u51080 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \'93\u48276 \u51396 \u54616 \u45716  \u44536  \u50689 \u54844 \u51008  \u51453 \u51012 \u51648 \u46972 \'94 (\u44180  18:20) \u44256  \u49440 \u50616 \u54616 \u49512 \u51648 \u47560 \u45716  \u48276 \u51396 \u54620  \u50689 \u54844 \u51008  \u51453 \u51648  \u50506 \u44256  \u50689 \u50896 \u55176  \u49332 \u47532 \u46972 \u45716  \u46907 \u51004 \u47196  \u54644 \u49437 \u46104 \u44256  \u51080 \u45796 . \u49324 \u45800 \u51032  \u47568 \u51012  \u51060 \u52376 \u47100  \u49789 \u44172  \u48127 \u51004 \u47732 \u49436  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u50640  \u44288 \u54616 \u50668  \u44536 \u52376 \u47100  \u48520 \u49888 \u54616 \u45716  \u49324 \u46988 \u46308 \u51032  \u51060 \u49345 \u54620  \u48152 \u54637 \u50640  \u45824 \u54616 \u50668  \u50864 \u47532 \u45716  \u45440 \u46972 \u51648  \u50506 \u51012  \u49688  \u50630 \u45796 .\
\uc0\u47564 \u51068  \u49324 \u46988 \u51060  \u53440 \u46973 \u54620  \u54980 \u50640 \u46020  \u49373 \u47749 \u45208 \u47924 \u50640  \u51217 \u44540 \u54624  \u49688  \u51080 \u45716  \u51088 \u50976 \u44032  \u54728 \u50857 \u46104 \u50632 \u45796 \u47732  \u50689 \u50896 \u55176  \u49332  \u49688  \u51080 \u44172  \u46108  \u44163 \u51008  \u47932 \u47200  \u46384 \u46972 \u49436  \u51396 \u46020  \u49324 \u46972 \u51648 \u51648  \u50506 \u44256  \u50689 \u49549 \u46104 \u50632 \u51012  \u44163 \u51060 \u45796 . \u44536 \u47084 \u45208  \u44536 \u47353  \u52380 \u49324 \u50752  \u48520 \u44867  \u44160 \u51060  \'93\u49373 \u47749 \u45208 \u47924 \u51032  \u44600 \'94 (\u52285  3:24) \u51012  \u51648 \u53040 \u51004 \u48064 \u47196  \u50500 \u45812 \u51032  \u44032 \u51313  \u51473  \u54620  \u49324 \u46988 \u46020  \u44536  \u51109 \u48317 \u51012  \u53685 \u44284 \u54616 \u50668  \u49373 \u47749 \u51012  \u51452 \u45716  \u50676 \u47588 \u47484  \u47673 \u51012  \u49688  \u51080 \u46020 \u47197  \u54728 \u50857 \u46104 \u51648  \u50506 \u50520 \u45796 . \u44536 \u47084 \u48064 \u47196  \u51453 \u51648  \u50506 \u51012  \u51396 \u51064 \u51008  \u54620  \u49324 \u46988 \u46020  \u50630 \u45796 .\
