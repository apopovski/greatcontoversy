\uc0\u48128 \u47084 \u45716  \u47568 \u54616 \u50688 \u45796 . \'93\u45208 \u45716  \'91\u47784 \u46304  \u49457 \u44221 \u51008  \u54616 \u45208 \u45784 \u51032  \u44048 \u46041 \u51004 \u47196  \u46108  \u44163 \u51004 \u47196 \'85\u44368 \u50977 \u54616 \u44592 \u50640  \u50976 \u51061 \u54616 \'92 (\u46372 \u54980  3:16) \u47728 , \u44536 \u44163 \u51008  \'91\u49324 \u46988 \u51032  \u46907 \u51004 \u47196  \u45240  \u44163 \u51060  \u50500 \u45768 \u50836  \u50724 \u51649  \u49457 \u47161 \u51032  \u44048 \u46041 \u54616 \u49900 \u51012  \u51077 \u51008  \u49324 \u46988 \u46308 \u51060  \u54616 \u45208 \u45784 \u44760  \u48155 \u50500  \u47568 \u54620  \u44163 \'92 (\u48295 \u54980  1:21) \u51060 \u47728 , \'91\u50864 \u47532 \u47196  \u54616 \u50668 \u44552  \u51064 \u45236 \u47196  \u46608 \u45716  \u49457 \u44221 \u51032  \u50504 \u50948 \u47196  \u49548 \u47581 \u51012  \u44032 \u51648 \u44172  \u54632 \'92 (\u47212  15:4) \u51076 \u51012  \u44618 \u51060  \u48127 \u51012  \u46412 , \u45208 \u45716  \u49457 \u44221 \u50640  \u51080 \u45716  \u50672 \u45824 \u51201  \u44592 \u49324 \u46308 \u46020  \u44536 \u44163 \u51060  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51032  \u51068 \u48512 \u48516 \u51064  \u51060 \u49345  \u49457 \u44221 \u51032  \u45796 \u47480  \u48512 \u48516 \u46308 \u44284  \u47560 \u52268 \u44032 \u51648 \u47196  \u49888 \u51473 \u55176  \u49345 \u44256 \u54624  \u44032 \u52824 \u44032  \u51080 \u45716  \u44163 \u51060 \u46972 \u44256  \u49373 \u44033 \u54624  \u49688 \u48150 \u50640  \u50630 \u50632 \u45796 . \u44536 \u47084 \u48064 \u47196  \u45208 \u45716  \u54616 \u45208 \u45784 \u44760 \u49436  \u45817 \u49888 \u51032  \u51088 \u48708 \u47196 \u50024  \u50864 \u47532 \u50640 \u44172  \u48372 \u50668  \u51452 \u49888  \u44163 \u51012  \u44648 \u45803 \u44592  \u50948 \u54616 \u50668  \u45432 \u47141 \u54616 \u45716  \u46041 \u49884 \u50640 , \u44536  \u50696 \u50616 \u51201  \u44592 \u44036 \u46308 \u51012  \u44536 \u45285 