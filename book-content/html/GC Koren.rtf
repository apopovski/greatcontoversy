\f0\b \cf0 \uc0\u51092 \u51064 \u47924 \u46020 \u54620  \u48149 \u54644 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u47196 \u47560  \u52380 \u51452 \u44368 \u45716  \u51060 \u44368 \u50752  \u44536 \u47532 \u49828 \u46020 \u44368 \u51032  \u54805 \u53468 \u47484  \u54844 \u54633 \u54616 \u44256  \u46608 \u54620  \u51060 \u44368 \u52376 \u47100  \u54616 \u45208 \u45784 \u51032  \u54408 \u49457 \u51012  \u51096 \u47803  \u45208 \u53440 \u45236 \u47728 , \u44536 \u50640  \u47803 \u51648 \u50506 \u51008  \u51092 \u51064 \u54616 \u44256  \u50669 \u44200 \u50868  \u49688 \u45800 \u46308 \u51012  \u49324 \u50857 \u54644  \u50772 \u45796 . \u47196 \u47560 \u44368 \u51032  \u51204 \u49457 \u49884 \u45824 \u50640 \u45716  \u44536 \u51032  \u44368 \u47532 \u47484  \u48155 \u50500 \u46308 \u51060 \u46020 \u47197  \u44053 \u50836 \u54616 \u44592  \u50948 \u54616 \u50668  \u44256 \u47928 \u54616 \u45716  \u44592 \u44396 \u46308 \u51060  \u49324 \u50857 \u46104 \u50632 \u45796 . \u44536 \u51032  \u51452 \u51109 \u51012  \u51064 \u51221 \u54616 \u51648  \u50506 \u45716  \u51088 \u46308 \u51012  \u50948 \u54620  \u54868 \u54805 \u51452 \u44032  \u51080 \u50632 \u45796 . \u49900 \u54032  \u46412 \u44620 \u51648 \u45716  \u44208 \u53076  \u50508 \u47140 \u51648 \u51648  \u50506 \u51012  \u50612 \u46500  \u44508 \u47784 \u51032  \u45824 \u47049  \u54617 \u49332 \u46308 \u51060  \u44048 \u54665 \u46104 \u50632 \u45796 . \u44368 \u54924 \u51032  \u51648 \u46020 \u51088 \u46308 \u51008  \u44536 \u46308 \u51032  \u51452 \u51064 \u51060  \u46104 \u45716  \u49324 \u45800 \u51032  \u51648 \u48176  \u50500 \u47000  \u44536 \u46308 \u51032  \u55148 \u49373 \u47932 \u51060  \u46108  \u51088 \u46308 \u50640 \u44172  \u52572 \u45824 \u51032  \u44256 \u47928 \u51012  \u54616 \u47732 \u49436 \u46020  \u44536  \u49373 \u47749 \u51012  \u51333 \u49885 \u49884 \u53412 \u51648  \u50506 \u45716  \u48169 \u48277 \u51012  \u44256 \u50504 \u54616 \u44592  \u50948 \u54616 \u50668  \u50672 \u44396 \u54616 \u50688 \u45796 . \u47566 \u51008  \u44221 \u50864 \u50640  \u49324 \u46988 \u51060  \u45908  \u51060 \u49345  \u4