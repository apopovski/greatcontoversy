\f1\b0 \cf0 \
\uc0\u50696 \u47336 \u49332 \u47128 \u51032  \u51669 \u48268 \u50640  \u45824 \u54620  \u51452 \u45784 \u51032  \u50696 \u50616 \u51008  \u50500 \u51649 \u46020  \u54616 \u45208  \u45908  \u49457 \u52712 \u46104 \u50612 \u50556  \u54620 \u45796 . \u50696 \u47336 \u49332 \u47128 \u51032  \u54028 \u47736 \u51008  \u51109 \u52264  \u50732  \u44163 \u44284  \u48708 \u44368 \u54616 \u47732  \u50500 \u51452  \u55148 \u48120 \u54620  \u44536 \u47548 \u51088 \u50640  \u51648 \u45208 \u51648  \u50506 \u45716 \u45796 . \u50864 \u47532 \u45716  \u53469 \u54632 \u51012  \u48155 \u51008  \u46020 \u49457 \u51032  \u47736 \u47581 \u50640 \u49436  \u54616 \u45208 \u45784 \u51032  \u51008 \u54812 \u47484  \u44144 \u49828 \u47476 \u44256  \u44536 \u48516 \u51032  \u50984 \u48277 \u51012  \u51667 \u48159 \u45716  \u49464 \u49345 \u51032  \u50868 \u47749 \u51012  \u48380  \u49688  \u51080 \u45796 . \u51396 \u50501 \u51004 \u47196  \u51216 \u52384 \u46108  \u47751 \u52380  \u45380 \u44036 \u51032  \u52376 \u52280 \u54620  \u51064 \u47448 \u51032  \u44592 \u47197 \u51008  \u50516 \u45812 \u54620  \u44163 \u49104 \u51060 \u45796 . \u49373 \u44033 \u47564  \u54644 \u46020  \u47560 \u51020  \u50500 \u54532 \u44256  \u44592 \u51208 \u54624  \u51221 \u46020 \u51060 \u45796 . \u46608 \u54620  \u54616 \u45208 \u45784 \u51032  \u44428 \u50948 \u47484  \u44144 \u49828 \u47480  \u44208 \u44284 \u45716  \u46160 \u47140 \u50868  \u51068 \u47196  \u45208 \u53440 \u45228 \u45796 . \u44536 \u47084 \u45208  \u48120 \u47000 \u50640  \u45824 \u54620  \u44228 \u49884 \u50640 \u45716  \u51060 \u48372 \u45796  \u45908 \u50865  \u50516 \u45812 \u54620  \u51068 \u51060  \u45208 \u53440 \u45208  \u51080 \u45796 . \u44284 \u44144 \u51032  \u44592 \u47197 , \u44263  \u49548 \u46976 , \u53804 \u51137 , \u54785 \u47749 , \'93\u50612 \u51648 \u47084 \u51060  \u49912 \u50864 \u45716  \u44400 \u51064 \u51032  \u44049 \u50743 \u44284  \u54588  \u47931 \u51008  \u48373 \u51109 \'94 (\u49324  9:5) \u46321 \u50640  \u44288 \u54620  \u50724 \u47019 \u46041 \u50504 \u51032  \u50669 \u49324 \u46020  \u54616 \u45208 \u45784 \u51032  \u50613 \u51228 \u54616 \u49884 \u45716  \u49888 \u51060  \u50501 \u54620  \u51088 \u47484  \u46496 \u45208 \u44256  \u51064 \u44036 \u51032  \u50837 \u47581 \u44284  \u49324 \u45800 \u51032  \u48516 \u45432 \u47484  \u45908  \u51060 \u49345  \u47561 \u51012  \u49688  \u50630 \u45716  \u45216 \u50640  \u51080 \u51012  \u46160 \u47140 \u50880 \u44284  \u48708 \u44368 \u54644  \u48372 \u47732 , \u50500 \u47924 \u44163 \u46020  \u50500 \u45776  \u44163 \u51060 \u45796 . \u44536 \u45216 \u50640 \u45716  \u49324 \u45800 \u51032  \u53685 \u52824 \u51032  \u44208 \u44284 \u44032  \u49704 \u44608 \u50630 \u51060  \u50756 \u51204 \u55176  \u46300 \u47084 \u45208 \u44172  \u46112  \u44163 \u51060 \u45796 .\
\uc0\u44536 \u47084 \u45208  \u50696 \u47336 \u49332 \u47128 \u51032  \u47736 \u47581 \u51032  \u46412 \u50752  \u44057 \u51060  \u44536  \u46412 \u50640 \u46020  \u54616 \u45208 \u45784 \u51032  \u48177 \u49457  \u44263  \'93\u49373 \u51316 \u54620  \u51088  \u51473  \u45433 \u47749 \u46108  \u47784 \u46304  \u49324 \u46988 \'94 (\u49324  4:3) \u51008  \u44396 \u50896 \u51012  \u48155 \u51012  \u44163 \u51060 \u45796 . \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u52649 \u49457 \u46108  \u48177 \u49457 \u51012  \u47784 \u51004 \u49884 \u44592  \u50948 \u54616 \u50668  \u45796 \u49884  \u50724 \u49884 \u44192 \u45796 \u44256  \u48157 \u55176  \u47568 \u50432 \u54616 \u49512 \u45796 . \'93\u44536  \u46412 \u50640  \u51064 \u51088 \u51032  \u51669 \u51312 \u44032  \u54616 \u45720 \u50640 \u49436  \u48372 \u51060 \u44192 \u44256  \u44536  \u46412 \u51032  \u46405 \u51032  \u47784 \u46304  \u51313 \u49549 \u46308 \u51060  \u53685 \u44257 \u54616 \u47728  \u44536 \u46308 \u51060  \u51064 \u51088 \u44032  \u44396 \u47492 \u51012  \u53440 \u44256  \u45733 \u47141 \u44284  \u53360  \u50689 \u44305 \u51004 \u47196  \u50724 \u45716  \u44163 \u51012  \u48372 \u47532 \u46972  \u51200 \u44032  \u53360  \u45208 \u54036  \u49548 \u47532 \u50752  \u54632 \u44760  \u52380 \u49324 \u46308 \u51012  \u48372 \u45236 \u47532 \u45768  \u51200 \u55148 \u44032  \u44536  \u53469 \u54616 \u49888  \u51088 \u46308 \u51012  \u54616 \u45720  \u51060  \u45149 \u50640 \u49436  \u51200  \u45149 \u44620 \u51648  \u49324 \u48169 \u50640 \u49436  \u47784 \u51004 \u47532 \u46972 \'94 (\u47560  24:30, 31). \u44536  \u46412 \u50640  \u48373 \u51020 \u51012  \u49692 \u51333 \u54616 \u51648  \u50500 \u45768 \u54620  \u51088 \u46308 \u51008  \u44536 \u48516 \u51032  \u51077 \u51032  \u44592 \u50868 \u51004 \u47196  \u51453 \u51076 \u51012  \u45817 \u54616 \u44256  \u44536 \u48516 \u51032  \u44053 \u47548 \u54616 \u49884 \u45716  \u50689 \u44305 \u51004 \u47196  \u47736 \u47581 \u45817 \u54624  \u44163 \u51060 \u45796  (\u49332 \u54980  2:8). \u50715 \u45216 \u51032  \u51060 \u49828 \u46972 \u50648  \u48177 \u49457 \u46308 \u44284  \u44057 \u51060  \u50501 \u54620  \u51088 \u46308 \u51008  \u51088 \u49888 \u46308 \u51032  \u48520 \u51032 \u47196  \u47568 \u48120 \u50516 \u50500  \u45336 \u50612 \u51652 \u45796 . \u51396 \u51032  \u49373 \u50528 \u47196  \u47568 \u48120 \u50516 \u50500  \u44536 \u46308 \u51008  \u54616 \u45208 \u45784 \u44284  \u51312 \u54868 \u46104 \u51648  \u47803 \u54616 \u44256 , \u44536 \u46308 \u51032  \u48376 \u49457 \u51060  \u50501 \u51004 \u47196  \u53440 \u46973 \u46104 \u50612  \u48260 \u47160 \u51004 \u48064 \u47196  \u50696 \u49688 \u45784 \u51032  \u44053 \u47548 \u54616 \u49884 \u45716  \u50689 \u44305 \u51060  \u44536 \u46308 \u50640 \u44172 \u45716  \u49548 \u47736 \u49884 \u53412 \u45716  \u48520 \u51060  \u46112  \u44163 \u51060 \u45796 .\
\uc0\u49324 \u46988 \u46308 \u51008  \u44536 \u47532 \u49828 \u46020 \u51032  \u47568 \u50432 \u51012  \u53685 \u54616 \u50668  \u44536 \u46308 \u50640 \u44172  \u51452 \u50612 \u51652  \u44368 \u54984 \u51012  \u46321 \u54620 \u55176  \u54616 \u51648  \u50506 \u46020 \u47197  \u44221 \u44228 \u54644 \u50556  \u54624  \u44163 \u51060 \u45796 . \u44536 \u48516 \u44760 \u49436 \u45716  \u50696 \u47336 \u49332 \u47128 \u51032  \u47736 \u47581 \u51012  \u51228 \u51088 \u46308 \u50640 \u44172  \u44221 \u44256 \u54616 \u49884 \u44256  \u44536  \u47736 \u47581 \u51060  \u44032 \u44620 \u50892  \u50724 \u45716  \u45936  \u45824 \u54620  \u51669 \u51312 \u47484  \u50508 \u47140  \u51452 \u49900 \u51004 \u47196  \u44536 \u46308 \u51060  \u46020 \u47581 \u54624  \u49688  \u51080 \u46020 \u47197  \u54616 \u49888  \u44163 \u52376 \u47100 , \u44536 \u48516 \u44760 \u49436 \u45716  \u49464 \u49345 \u51032  \u47560 \u51648 \u47561  \u47736 \u47581 \u51012  \u44221 \u44256 \u54616 \u49884 \u44256  \u44536 \u45216 \u51060  \u44032 \u44620 \u50892  \u50740 \u51012  \u50508 \u47140  \u51452 \u45716  \u51669 \u51312 \u47484  \u51452 \u49492 \u49436  \u47784 \u46304  \u49324 \u46988 \u51004 \u47196  \u54616 \u50668 \u44552  \u44536 \u45216 \u50640  \u51076 \u54624  \u51652 \u45432 \u47484  \u54588 \u54624  \u49688  \u51080 \u46020 \u47197  \u54616 \u49512 \u45796 . \u50696 \u49688 \u45784 \u44760 \u49436 \u45716  \'93\u51068 \u50900 \u49457 \u49888 \u50640 \u45716  \u51669 \u51312 \u44032  \u51080 \u44192 \u44256  \u46405 \u50640 \u49436 \u45716  \u48124 \u51313 \u46308 \u51060  \u44260 \u44256 \u54616 \u47532 \u46972 \'94\u44256  \u47568 \u50432 \u54616 \u49888 \u45796  (\u45573  21:25; \u47560  24:29; \u47561  13:24~26; \u44228  6:12~17). \u44536 \u48516 \u51032  \u44053 \u47548 \u51032  \u51204 \u51312 \u47484  \u48372 \u45716  \u49324 \u46988 \u46308 \u51008  \'93\u51064 \u51088 \u44032  \u44032 \u44620 \u51060  \u44263  \u47928  \u50526 \u50640  \u51060 \u47480  \u51460 \'94 (\u47560  24:33) \u51012  \u50508  \u44163 \u51060 \u45796 . \'93\u44536 \u47084 \u48064 \u47196  \u44648 \u50612  \u51080 \u51004 \u46972 \'94 (\u47561  13:35) \u44256  \u44221 \u44256 \u54616 \u49888 \u45796 . \u44536  \u44221 \u44256 \u50640  \u50976 \u51032 \u54616 \u45716  \u49324 \u46988 \u46308 \u51008  \u50612 \u46176  \u44032 \u50868 \u45936  \u48260 \u47140 \u46176 \u51012  \u48155 \u51648  \u50506 \u51012  \u44163 \u51060 \u50836 , \u50508 \u51648  \u47803 \u54616 \u45716  \u46412 \u50640  \u44536 \u45216 \u51060  \u44536 \u46308 \u50640 \u44172  \u51076 \u54616 \u51648  \u50500 \u45768 \u54624  \u44163 \u51060 \u45796 . \u44536 \u47084 \u45208  \u44648 \u50612  \u51080 \u51648  \u50500 \u45768 \u54616 \u45716  \u51088 \u46308 \u50640 \u44172 \u45716  \u51452 \u51032  \u45216 \u51060  \u48164 \u50640  \u46020 \u51201 \u44057 \u51060  \u51060 \u47476 \u44172  \u46112  \u44163 \u51060 \u45796  (\u49332 \u51204  5:2~5 \u52280 \u51312 ).\
