\f0\b \cf0 \uc0\u50920 \u49836 \u47532  \u54805 \u51228 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u44536 \u47196 \u48512 \u53552  \u48177 \u45380  \u54980 , \u44263  \u50689 \u51201  \u50516 \u55121 \u49884 \u45824 \u50640  \u55083 \u54596 \u46300  (Whitefield) \u50752  \u50920 \u49836 \u47532  (Wesley) \u54805 \u51228 \u45716  \u54616 \u45208 \u45784 \u51032  \u48731 \u51012  \u51204 \u54616 \u45716  \u49324 \u46988 \u46308 \u47196  \u45208 \u53440 \u45228 \u45796 . \u45817 \u49884 \u51032  \u50689 \u44397  \u49324 \u46988 \u46308 \u51008  \u44397 \u44368 \u54924  (\u22283 \u25934 \u26371 ) \u51032  \u53685 \u51228  \u50500 \u47000  \u51060 \u44368 \u46020 \u50752  \u44144 \u51032  \u48516 \u48324 \u54624  \u49688  \u50630 \u51012  \u51221 \u46020 \u47196  \u51333 \u44368 \u51201 \u51004 \u47196  \u49632 \u53748 \u54620  \u49345 \u53468 \u50640  \u48736 \u51256  \u51080 \u50632 \u45796 . \u49457 \u51649 \u51088 \u45716  \u51088 \u50672  \u51333 \u44368 \u47484  \u51600 \u44200  \u50672 \u44396 \u54616 \u50688 \u51004 \u48064 \u47196  \u44536 \u46308 \u51032  \u45824 \u48512 \u48516 \u51032  \u49888 \u54617 \u51008  \u44536 \u47088  \u48169 \u54693 \u51004 \u47196  \u44592 \u50872 \u50612 \u51276 \u45796 . \u49345 \u47448  \u44228 \u44553 \u51008  \u54616 \u45208 \u45784 \u51012  \u44277 \u44221 \u54616 \u45716  \u44163 \u51012  \u45257 \u49548 \u54616 \u50688 \u44256 , \u49548 \u50948  \u44536 \u46308 \u51060  \u44305 \u49888 \u51088 \u46972 \u44256  \u48512 \u47476 \u45716  \u49324 \u46988 \u46308  \u50948 \u50640  \u51080 \u45796 \u44256  \u51088 \u46993 \u54616 \u50688 \u45796 . \u54616 \u47448  \u44228 \u44553 \u51008  \u49900 \u54620  \u47924 \u51648  \u49345 \u53468 \u50640 \u49436  \u48512 \u46020 \u45909 \u50640  \u48736 \u51256  \u51080 \u50632 \u45796 . \u44536 \u50752  \u48152 \u47732 \u50640  \u44368 \u54924 \u45716  \u45236 \u47532 \u47561 \u44600 \u51012  \u44151 \u44256  \u51080 \u45716  \u51652 \u47532 \u51032  \u49324 \u50629 \u51012  \u51648 \u53489 \u54624  \u55192 \u51060 \u45208  \u48127 \u51020 \u51012  \u45908  \u51060 \u49345  \u44032 \u51648 \u44256  \u51080 \u51648  \u47803 \u54616 \u50688 \u45796 .\
\uc0\u47336 \u53552 \u44032  \u44536 \u47111 \u44172 \u46020  \u48516 \u47749 \u55176  \u44032 \u47476 \u52828  \u48127 \u51020 \u51004 \u47196  \u47568 \u48120 \u50516 \u45716  \u51032 \u51032  \u44368 \u47532 \u45716  \u51060 \u51228  \u44144 \u51032  \u48380  \u49688  \u50630 \u44172  \u46104 \u50632 \u45796 . \u49440 \u51012  \u54665 \u54632 \u51004 \u47196  \u44396 \u50896 \u51012  \u50619 \u45716 \u45796 \u45716  \u47196 \u47560 \u44368 \u51032  \u44368 \u47532 \u44032  \u44536  \u45824 \u49888  \u51088 \u47532 \u47484  \u52264 \u51648 \u54616 \u50688 \u45796 . \u44397 \u44368 \u54924 \u51032  \u44368 \u51064 \u51060 \u50632 \u45912  \u55083 \u54596 \u46300 \u50752  \u50920 \u49836 \u47532  \u54805 \u51228 \u45716  \u54616 \u45208 \u45784 \u51032  \u51008 \u54812 \u47484  \u51652 \u51221 \u51004 \u47196  \u52286 \u45716  \u49324 \u46988 \u46308 \u51060 \u50632 \u45796 . \u44536 \u46308 \u51008  \u44221 \u44148 \u54620  \u49373 \u54876 \u44284  \u51333 \u44368 \u51201  \u51032 \u49885 \u51012  \u47784 \u46160  \u54665 \u54632 \u51004 \u47196  \u54616 \u45208 \u45784 \u51032  \u51008 \u54812 \u47484  \u50619 \u51012  \u49688  \u51080 \u45796 \u44256  \u44032 \u47476 \u52840 \u51012  \u48155 \u50520 \u45796 .\
\uc0\u54620  \u48264 \u51008  \u52272 \u49828  \u50920 \u49836 \u47532  (Charles Wesley) \u44032  \u48337 \u51060  \u46308 \u50612  \u51453 \u51020 \u51060  \u45796 \u44032 \u50724 \u45716  \u44163 \u52376 \u47100  \u49373 \u44033 \u46104 \u50632 \u51012  \u46412 , \u44536 \u45716  \u50689 \u50896 \u54620  \u49373 \u47749 \u50640  \u45824 \u54620  \u55148 \u47581 \u51012  \u47924 \u50631 \u50640 \u45796  \u46160 \u45712 \u45264 \u45716  \u51656 \u47928 \u51012  \u48155 \u50520 \u45796 . \u44536 \u45716  \'93\u45208 \u45716  \u54616 \u45208 \u45784 \u51012  \u49452 \u44592 \u44592  \u50948 \u54616 \u50668  \u52572 \u49440 \u51032  \u45432 \u47141 \u51012  \u45796 \u54644  \u50772 \u45796 \'94\u44256  \u45824 \u45813 \u54616 \u50688 \u45796 . \u44536  \u51656 \u47928 \u51012  \u54620  \u52828 \u44396 \u44032  \u44536  \u45824 \u45813 \u50640  \u50756 \u51204 \u55176  \u47564 \u51313 \u54616 \u51648  \u50506 \u45716  \u44163 \u52376 \u47100  \u48372 \u51060 \u51088 , \u50920 \u49836 \u47532 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u49373 \u44033 \u54616 \u50688 \u45796 . \'93\u45208 \u51032  \u45432 \u47141 \u51060  \u49548 \u47581 \u50640  \u45824 \u54620  \u52649 \u48516 \u54620  \u44540 \u44144 \u44032  \u47803  \u46108 \u45796 \u45716  \u47568 \u51064 \u44032 ? \u45208 \u51032  \u45432 \u47141 \u51012  \u54616 \u45208 \u45784 \u44760 \u49436  \u51208 \u52712 \u54616 \u49888  \u44163 \u51060  \u50500 \u45776 \u44620 ? \u44536 \u47111 \u45796 \u47732  \u45208 \u45716  \u45804 \u47532  \u49888 \u47280 \u54624  \u47564 \u54620  \u44163 \u51060  \u50630 \u45796 \'94 (John Whitehead, Life of the Rev.John Wesley, p.102). \u44536 \u50752  \u44057 \u51060  \u51673 \u51008  \u50516 \u55121 \u51060  \u44368 \u54924 \u47484  \u45934 \u44256  \u51080 \u50632 \u51004 \u48064 \u47196 , \u49549 \u51396 \u47484  \u44032 \u47140  \u48260 \u47532 \u44256 , \u44536 \u47532 \u49828 \u46020 \u51032  \u50689 \u44305 \u51012  \u48764 \u50519 \u44256 , \u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u51012  \u44396 \u50896 \u51032  \u50976 \u51068 \u54620  \u55148 \u47581 , \u44263  \u49901 \u51088 \u44032 \u50640  \u45804 \u47532 \u49888  \u44396 \u51452 \u51032  \u54588 \u50640 \u49436  \u46496 \u45208 \u44032 \u44172  \u54616 \u50688 \u45796 .\
\uc0\u50920 \u49836 \u47532 \u50752  \u44536 \u51032  \u46041 \u47308 \u46308 \u51008  \u52280 \u46108  \u51333 \u44368 \u45716  \u47560 \u51020 \u50640  \u49100 \u47532 \u47484  \u48149 \u44256  \u51080 \u45796 \u45716  \u44163 \u44284 , \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51008  \u47568 \u44284  \u54665 \u46041 \u50640 \u45716  \u47932 \u47200 \u51060 \u50836 , \u49373 \u44033 \u50640 \u44620 \u51648  \u48120 \u52828 \u45796 \u45716  \u44163 \u51012  \u44648 \u45803 \u44172  \u46104 \u50632 \u45796 . \u44536 \u46308 \u51008  \u50808 \u48512 \u50640  \u45208 \u53440 \u45208 \u45716  \u54665 \u50948 \u51032  \u48148 \u47492 \u49104  \u50500 \u45768 \u46972  \u47560 \u51020 \u51032  \u49457 \u44208 \u51060  \u46608 \u54620  \u54596 \u50836 \u54620  \u44163 \u51012  \u54869 \u49888 \u54616 \u50688 \u51004 \u48064 \u47196  \u49352  \u49373 \u50528 \u50640  \u46308 \u50612 \u44032 \u44592 \u47484  \u55192 \u50044 \u45796 . \u44536 \u46308 \u51008  \u44032 \u51109  \u44540 \u47732 \u54616 \u44256  \u44221 \u44148 \u54620  \u45432 \u47141 \u51004 \u47196  \u44536 \u46308 \u51032  \u50977 \u49888 \u51201  \u47560 \u51020 \u51032  \u49324 \u50501 \u54632 \u51012  \u44537 \u48373 \u54616 \u44256 \u51088  \u50528 \u47484  \u50044 \u45796 . \u44536 \u46308 \u51008  \u44537 \u44592 \u50752  \u48149 \u50528 \u50752  \u44216 \u48708 \u51032  \u49373 \u50528 \u47484  \u49332 \u44256 , \u44536 \u46308 \u47196  \u54616 \u50668 \u44552  \u54616 \u45208 \u45784 \u51032  \u51008 \u52509 \u51012  \u51077 \u51012  \u49688  \u51080 \u44172  \u54644 \u51452 \u45716  \u49457 \u44208 , \u44263  \u44536 \u46308 \u51032  \u44032 \u51109  \u50676 \u47581 \u54616 \u45716  \u44163 \u51012  \u50619 \u45716  \u45936  \u51080 \u50612 \u49436  \u54596 \u50836 \u54620  \u47784 \u46304  \u48169 \u48277 \u51012  \u47588 \u50864  \u50628 \u48128 \u54616 \u44256  \u51221 \u54869 \u54616 \u44172  \u51456 \u54665 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u46308 \u51008  \u44396 \u54616 \u45716  \u48148 \u47484  \u50619 \u51648  \u47803 \u54616 \u50688 \u45796 . \u51221 \u51396 \u51032  \u49345 \u53468 \u50640 \u49436  \u45459 \u50668 \u45208 \u44256  \u51396 \u51032  \u49464 \u47141 \u51012  \u44648 \u46888 \u47532 \u44256 \u51088  \u54616 \u45716  \u44536 \u46308 \u51032  \u45432 \u47141 \u51008  \u54728 \u51648 \u47196  \u46028 \u50500 \u44052 \u45796 . \u44536 \u44163 \u51008  \u48148 \u47196  \u47336 \u53552 \u44032  \u50640 \u47476 \u54392 \u47476 \u53944 \u51032  \u50808 \u47196 \u50868  \u48169 \u50640 \u49436  \u44221 \u54744 \u54620  \u44163 \u44284  \u46609 \u44057 \u51008  \u53804 \u51137 \u51060 \u50632 \u45796 . \u44536 \u44163 \u51008  \u44536 \u51032  \u49900 \u47161 \u51012  \u44340 \u47213 \u44172  \u54664 \u45912  \u47928 \u51228 , \u44263  \'93\u51064 \u49373 \u51060  \u50612 \u52236  \u54616 \u45208 \u45784  \u50526 \u50640  \u51032 \u47196 \u50864 \u47028 \'94 (\u50853  9:2) \u44256  \u54620  \u48148 \u47196  \u44536  \u47928 \u51228 \u50688 \u45796 .\
\uc0\u44060 \u49888 \u44368 \u51032  \u51228 \u45800 \u50640 \u49436  \u44144 \u51032  \u44732 \u51256 \u44036  \u44144 \u47337 \u54620  \u51652 \u47532 \u51032  \u48520 \u44867 \u51008  \u48372 \u54756 \u48120 \u50500 \u51032  \u44536 \u47532 \u49828 \u46020 \u51064 \u46308 \u47196  \u47568 \u48120 \u50516 \u50500  \u50668 \u47084  \u49464 \u45824  \u46041 \u50504  \u51204 \u54616 \u50668  \u45236 \u47140 \u50728  \u44256 \u45824 \u51032  \u54915 \u48520 \u47196 \u48512 \u53552  \u45796 \u49884  \u48157 \u54784 \u51256 \u50556  \u54664 \u45796 . \u51333 \u44368 \u44060 \u54785  \u54980 \u50640  \u48372 \u54756 \u48120 \u50500 \u51032  \u44060 \u49888 \u44368 \u45716  \u47196 \u47560 \u51032  \u49464 \u47141 \u50640  \u50668 \u51648 \u50630 \u51060  \u51667 \u48159 \u54804 \u45796 . \u44536 \u47532 \u54616 \u50668  \u51652 \u47532 \u47484  \u54252 \u44592 \u54616 \u44592 \u47484  \u44144 \u51208 \u54620  \u47784 \u46304  \u49324 \u46988 \u46308 \u51008  \u46020 \u47581 \u54624  \u49688 \u48150 \u50640  \u50630 \u50632 \u45796 . \u44536 \u46308  \u51473 \u51032  \u45908 \u47084 \u45716  \u51089 \u49468 \u50640 \u49436  \u54588 \u45212 \u52376 \u47484  \u52286 \u50520 \u44256 , \u44144 \u44592 \u49436  \u50715 \u45216 \u51032  \u49888 \u50521 \u51012  \u48372 \u51204 \u54616 \u50688 \u45796 . \u50920 \u49836 \u47532 \u50752  \u44536 \u51032  \u46041 \u47308 \u46308 \u51060  \u51652 \u47532 \u51032  \u48731 \u51012  \u48155 \u51008  \u44163 \u51008  \u48148 \u47196  \u51060  \u44536 \u47532 \u49828 \u46020 \u51064 \u46308 \u51032  \u54980 \u49552 \u51004 \u47196 \u48512 \u53552 \u50688 \u45796 .\
