\f1\b0 \cf0 \
\uc0\u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u51228 \u51088 \u46308 \u50640 \u44172  \u45817 \u49888 \u51032  \u51116 \u47548 \u51032  \u51669 \u51312 \u50640  \u50976 \u51032 \u54616 \u46972 \u44256  \u47749 \u47161 \u54632 \u44284  \u46041 \u49884 \u50640  \u44536 \u46308 \u51032  \u50773 \u51060  \u50724 \u49892  \u51669 \u51312 \u47484  \u48380  \u46412 \u50640 \u45716  \u44592 \u48848 \u54644 \u50556  \u54620 \u45796 \u44256  \u47568 \u50432 \u54616 \u49512 \u45796 . \u44536 \u48516 \u44760 \u49436 \u45716  \'93\u51060 \u47088  \u51068 \u51060  \u46104 \u44592 \u47484  \u49884 \u51089 \u54616 \u44144 \u46304  \u51068 \u50612 \u45208  \u47672 \u47532 \u47484  \u46308 \u46972  \u45320 \u55148  \u44396 \u49549 \u51060  \u44032 \u44620 \u50912 \u45712 \u45768 \u46972 \'94\u44256  \u47568 \u50432 \u54616 \u49512 \u45796 . \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u51228 \u51088 \u46308 \u50640 \u44172  \u48388 \u50640  \u45208 \u47924 \u46308 \u51060  \u50880 \u53944 \u45716  \u49324 \u49892 \u51012  \u51648 \u51201 \u54616 \u49884 \u47732 \u49436  \'93\u49913 \u51060  \u45208 \u47732  \u45320 \u55148 \u44032  \u48372 \u44256  \u50668 \u47492 \u51060  \u44032 \u44620 \u50868  \u51460 \u51012  \u51088 \u50672 \u55176  \u50500 \u45208 \u45768  \u51060 \u50752  \u44057 \u51060  \u45320 \u55148 \u44032  \u51060 \u47088  \u51068 \u51060  \u45208 \u45716  \u44163 \u51012  \u48372 \u44144 \u46304  \u54616 \u45208 \u45784 \u51032  \u45208 \u46972 \u44032  \u44032 \u44620 \u50868  \u51460 \u51012  \u50508 \u46972 \'94 (\u45573  21:28, 30, 31) \u44256  \u47568 \u50432 \u54616 \u49512 \u45796 .\
\uc0\u44536 \u47084 \u45208  \u44368 \u54924  \u50504 \u50640 \u49436  \u44216 \u49552 \u44284  \u54732 \u49888 \u51032  \u51221 \u49888 \u51060  \u44368 \u47564 \u44284  \u54805 \u49885 \u51452 \u51032 \u47196  \u48148 \u45068 \u44256  \u51080 \u45716  \u46041 \u50504  \u44536 \u47532 \u49828 \u46020 \u50640  \u45824 \u54620  \u49324 \u46993 \u44284  \u44536 \u48516 \u51032  \u51116 \u47548 \u50640  \u45824 \u54620  \u48127 \u51020 \u51008  \u51216 \u51216  \u49885 \u50612 \u51256  \u48260 \u47160 \u45796 . \u49548 \u50948  \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u51060 \u46972 \u44256  \u51088 \u48512 \u54616 \u45716  \u51088 \u46308 \u51060  \u49464 \u49549 \u51201  \u50837 \u49900 \u44284  \u54693 \u46973 \u51012  \u44396 \u54616 \u45716  \u51068 \u50640  \u47792 \u46160 \u46104 \u50612  \u44396 \u51452 \u51032  \u51116 \u47548 \u51032  \u51669 \u51312 \u46308 \u50640  \u45824 \u54620  \u44368 \u54984 \u50640 \u45716  \u49548 \u44221 \u51060  \u46104 \u50612  \u48260 \u47160 \u45796 . \u51116 \u47548 \u51032  \u44368 \u47532 \u45716  \u46321 \u54620 \u55176  \u50668 \u44200 \u51276 \u44256 , \u51116 \u47548 \u50640  \u44288 \u54620  \u49457 \u44221 \u51208 \u46308 \u51008  \u44257 \u54644 \u47196  \u44032 \u47532 \u50892 \u51256 \u49436  \u47560 \u52840 \u45236  \u44536 \u44163 \u51008  \u44144 \u51032  \u45824 \u48512 \u48516  \u47924 \u49884 \u46104 \u44256  \u51082 \u50612 \u48260 \u47536  \u48148  \u46104 \u50632 \u45796 . \u53945 \u48324 \u55176  \u44536 \u50752  \u44057 \u51008  \u54788 \u49892 \u51008  \u48120 \u44397 \u51032  \u44033  \u44368 \u54924 \u46308 \u50640  \u51080 \u50612 \u49436  \u44536 \u47084 \u54616 \u50688 \u45796 . \u49324 \u54924 \u51032  \u44033  \u44228 \u44553 \u50640 \u49436  \u45572 \u47532 \u45716  \u51088 \u50976 \u50752  \u50504 \u46973 , \u48512 \u50752  \u49324 \u52824 \u50640  \u45824 \u54620  \u50837 \u47581 \u51008  \u49324 \u46988 \u46308 \u47196  \u46024  \u48260 \u45716  \u51068 \u50640  \u47792 \u46160 \u54616 \u44172  \u54616 \u44256 , \u47784 \u46304  \u49324 \u46988 \u51060  \u45796  \u51088 \u44592 \u51032  \u49552 \u50640  \u45347 \u51012  \u49688  \u51080 \u51012  \u44163 \u52376 \u47100  \u48372 \u51060 \u45716  \u47749 \u50696 \u50752  \u44428 \u47141 \u50640  \u45824 \u54620  \u50676 \u47148 \u54620  \u50837 \u47581 \u51008 , \u49324 \u46988 \u46308 \u47196  \u54616 \u50668 \u44552  \u44536 \u46308 \u51032  \u55141 \u48120 \u51032  \u51473 \u49900 \u51012  \u51060  \u49464 \u49345 \u51032  \u49324 \u47932 \u50640  \u46160 \u44172  \u54616 \u44256 , \u54788 \u49464 \u51032  \u47784 \u46304  \u49324 \u47932 \u51012  \u54028 \u44340 \u54644  \u48260 \u47540  \u44536  \u50628 \u49689 \u54620  \u45216 \u51012  \u50500 \u51452  \u47676  \u51109 \u47000 \u51032  \u51068 \u47196  \u51228 \u52432 \u45459 \u44172  \u54616 \u50688 \u45796 .\
\uc0\u44396 \u51452 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u51228 \u51088 \u46308 \u50640 \u44172  \u45817 \u49888 \u51032  \u45796 \u49884  \u50724 \u49900 \u50640  \u45824 \u54620  \u51669 \u51312 \u46308 \u51012  \u47568 \u50432 \u54616 \u49884 \u47732 \u49436  \u51116 \u47548  \u51649 \u51204 \u50640  \u51080 \u51012  \u53440 \u46973  \u49345 \u53468 \u50640  \u45824 \u54616 \u50668  \u50696 \u50616 \u54616 \u49512 \u45796 . \u47560 \u52824  \u45432 \u50500 \u51032  \u46412 \u50752  \u44057 \u51060  \u49464 \u49549 \u51201  \u50629 \u47924 \u50752  \u54693 \u46973 \u51012  \u44396 \u54616 \u45716  \u51068 , \u44263  \u49324 \u44256 , \u54036 \u44256 , \u49900 \u44256 , \u51665 \u51667 \u44256 , \u51109 \u44032 \u44032 \u44256 , \u49884 \u51665 \u44032 \u47732 \u49436  \u54616 \u45208 \u45784 \u44284  \u45236 \u49464 \u45716  \u51082 \u50612 \u48260 \u47532 \u44172  \u46112  \u44163 \u51060 \u45796 . \u51060 \u47088  \u49464 \u45824 \u50640  \u49332  \u49324 \u46988 \u46308 \u51012  \u50948 \u54620  \u44536 \u47532 \u49828 \u46020 \u51032  \u44428 \u44256 \u45716  \u50500 \u47000 \u50752  \u44057 \u45796 . \'93\u45320 \u55148 \u45716  \u49828 \u49828 \u47196  \u51312 \u49900 \u54616 \u46972  \u44536 \u47111 \u51648  \u50506 \u51004 \u47732  \u48169 \u53461 \u54632 \u44284  \u49696 \u52712 \u54632 \u44284  \u49373 \u54876 \u51032  \u50684 \u47140 \u47196  \u47560 \u51020 \u51060  \u46164 \u54616 \u50668 \u51648 \u44256  \u46907 \u48150 \u50640  \u44536 \u45216 \u51060  \u45931 \u44284  \u44057 \u51060  \u45320 \u55148 \u50640 \u44172  \u51076 \u54616 \u47532 \u46972 \'94, \'93\u51060 \u47084 \u48064 \u47196  \u45320 \u55148 \u45716  \u51109 \u52264  \u50732  \u51060  \u47784 \u46304  \u51068 \u51012  \u45733 \u55176  \u54588 \u54616 \u44256  \u51064 \u51088  \u50526 \u50640  \u49436 \u46020 \u47197  \u54637 \u49345  \u44592 \u46020 \u54616 \u47728  \u44648 \u50612  \u51080 \u51004 \u46972 \'94 (\u45573  21:34, 36).\
\uc0\u51060  \u49884 \u45824 \u51032  \u44368 \u54924 \u51032  \u49345 \u53468 \u45716  \u50836 \u54620 \u44228 \u49884 \u47197 \u50640 \u49436  \u44396 \u51452 \u44760 \u49436  \u54616 \u49888  \u47568 \u50432 , \u44263  \'93\u45348 \u44032  \u49332 \u50520 \u45796  \u54616 \u45716  \u51060 \u47492 \u51008  \u44032 \u51276 \u51004 \u45208  \u51453 \u51008  \u51088 \u47196 \u45796 \'94 (\u44228  3:1) \u44256  \u54616 \u49888  \u47568 \u50432 \u50640  \u51648 \u51201 \u46104 \u50612  \u51080 \u45796 . \u46608 \u54620  \u51200 \u55148 \u51032  \u48512 \u51452 \u51032 \u54616 \u44256  \u50504 \u51068 \u54620  \u49345 \u53468 \u50640 \u49436  \u44033 \u49457 \u54616 \u44592 \u47484  \u44144 \u48512 \u54616 \u45716  \u51088 \u46308 \u50640 \u44172  \'93\u47564 \u51068  \u51068 \u44648 \u51648  \u50500 \u45768 \u54616 \u47732  \u45236 \u44032  \u46020 \u51201 \u44057 \u51060  \u51060 \u47476 \u47532 \u45768  \u50612 \u45712  \u49884 \u50640  \u45348 \u44172  \u51076 \u54624 \u45716 \u51648  \u45348 \u44032  \u50508 \u51648  \u47803 \u54616 \u47532 \u46972 \'94 (\u44228  3:3) \u45716  \u50628 \u49689 \u54620  \u44221 \u44256 \u44032  \u51452 \u50612 \u51276 \u45796 .\
\uc0\u49324 \u46988 \u46308 \u51008  \u51088 \u44592 \u46308 \u51032  \u50948 \u54744 \u51012  \u44648 \u45803 \u44256  \u51008 \u54812 \u51032  \u45149 \u44284  \u44288 \u47144 \u46108  \u50628 \u49689 \u54620  \u49324 \u44148 \u46308 \u51012  \u50948 \u54616 \u50668  \u51456 \u48708 \u54616 \u50668 \u50556  \u54624  \u54596 \u50836 \u44032  \u51080 \u45796 . \u54616 \u45208 \u45784 \u51032  \u49440 \u51648 \u51088 \u45716  \'93\u50668 \u54840 \u50752 \u51032  \u45216 \u51060  \u53356 \u44256  \u49900 \u55176  \u46160 \u47157 \u46020 \u45796  \u45817 \u54624  \u51088 \u44032  \u45572 \u44396 \u51060 \u47028 \'94 (\u50844  2:11) \u44256  \u47568 \u54616 \u44256  \u51080 \u45796 . \u45572 \u44032  \u45733 \u55176  \u44536  \'93\u45576 \u51060  \u51221 \u44208 \u54616 \u49884 \u48064 \u47196  \u50501 \u51012  \u52280 \u50500  \u48372 \u51648  \u47803 \u54616 \u49884 \u47728  \u54056 \u50669 \u51012  \u52280 \u50500  \u48372 \u51648  \u47803 \u54616 \u49884 \'94 (\u54633  1:13) \u45716  \u48516 \u44760 \u49436  \u45208 \u53440 \u45208 \u49892  \u46412 \u50640  \u44536  \u50526 \u50640  \u49436 \u44192 \u45716 \u44032 ? \'93\u45208 \u51032  \u54616 \u45208 \u45784 \u51060 \u50668  \u50864 \u47532  (\u44032 ) \'85\u51452 \u47484  \u50500 \u45208 \u51060 \u45796 \'94 (\u54840  8:2) \u44256  \u48512 \u47476 \u51670 \u51004 \u47732 \u49436 \u46020  \u54616 \u45208 \u45784 \u51032  \u50616 \u50557 \u51012  \u48276 \u54616 \u44256  \u45796 \u47480  \u49888 \u50640 \u44172  \u50696 \u47932 \u51012  \u46300 \u47532 \u44256  \u51396 \u47484  \u47560 \u51020 \u50640  \u44048 \u52628 \u47728  \u48520 \u51032 \u54620  \u44600 \u51012  \u49324 \u46993 \u54616 \u45716  \u51088 \u46308 \u50640 \u44172  \u50668 \u54840 \u50752 \u44760 \u49436 \u45716  \u51452 \u51032  \u45216 \u50640  \u44288 \u54616 \u50668  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u50432 \u54616 \u49512 \u45796 . \'93\u50612 \u52236  \u50612 \u46160 \u50892 \u49436  \u48731 \u51060  \u50630 \u51020 \u51060  \u50500 \u45768 \u47728  \u52868 \u52868 \u54616 \u50668  \u48731 \u45224 \u51060  \u50630 \u51020 \u51060  \u50500 \u45768 \u45264 \'94 (\u50516  5:20). \'93\u44536  \u46412 \u50640  \u45236 \u44032  \u46321 \u48520 \u47196  \u50696 \u47336 \u49332 \u47128 \u50640  \u46160 \u47336  \u52286 \u50500  \u47924 \u47495  \u52236 \u45180 \u44057 \u51060  \u44032 \u46972 \u50505 \u50500 \u49436  \u49900 \u51473 \u50640  \u49828 \u49828 \u47196  \u51060 \u47476 \u44592 \u47484  \u50668 \u54840 \u50752 \u44760 \u49436 \u45716  \u48373 \u46020  \u45236 \u47532 \u51648  \u50500 \u45768 \u54616 \u49884 \u47728  \u54868 \u46020  \u45236 \u47532 \u51648  \u50500 \u45768 \u54616 \u49884 \u47532 \u46972 \'94 (\u49845  1:12). \'93\u45236 \u44032  \u49464 \u49345 \u51032  \u50501 \u44284  \u50501 \u51064 \u51032  \u51396 \u47484  \u48268 \u54616 \u47728  \u44368 \u47564 \u54620  \u51088 \u51032  \u50724 \u47564 \u51012  \u45130 \u51004 \u47728  \u44053 \u54252 \u54620  \u51088 \u51032  \u44144 \u47564 \u51012  \u45230 \u52636  \u44163 \u51060 \u47728 \'94 (\u49324  13:11), \'93\u44536 \u46308 \u51032  \u51008 \u44284  \u44552 \u51060  \u50668 \u54840 \u50752 \u51032  \u48516 \u45432 \u51032  \u45216 \u50640  \u45733 \u55176  \u44536 \u46308 \u51012  \u44148 \u51648 \u51648  \u47803 \u54624  \u44163 \u51060 \u47728 \'94, \'93\u44536 \u46308 \u51032  \u51116 \u47932 \u51060  \u45432 \u47029 \u46104 \u47728  \u44536 \u46308 \u51032  \u51665 \u51060  \u54889 \u47924 \u54624  \u44163 \u51060 \u46972 \'94 (\u49845  1:18, 13).\
\uc0\u49440 \u51648 \u51088  \u50696 \u47112 \u48120 \u50556 \u45716  \u44536  \u46160 \u47140 \u50868  \u49884 \u44592 \u47484  \u48148 \u46972 \u48372 \u47732 \u49436  \'93\u45236  \u47560 \u51020 \u49549 \u51060  \u50500 \u54532 \u44256  \u45236  \u47560 \u51020 \u51060  \u45813 \u45813 \u54616 \u50668  \u51104 \u51104 \u54624  \u49688  \u50630 \u51004 \u45768  \u51060 \u45716  \u45208 \u51032  \u49900 \u47161  \u45348 \u44032  \u45208 \u54036  \u49548 \u47532 \u50752  \u51204 \u51137 \u51032  \u44221 \u48372 \u47484  \u46308 \u51020 \u51060 \u47196 \u45796  \u54056 \u47581 \u50640  \u54056 \u47581 \u51060  \u50672 \u49549 \u54616 \u50668 \'94 (\u47128  4:19, 20) \u46972 \u44256  \u48512 \u47476 \u51670 \u50632 \u45796 . \'93\u44536 \u45216 \u51008  \u48516 \u45432 \u51032  \u45216 \u51060 \u50836  \u54872 \u45212 \u44284  \u44256 \u53685 \u51032  \u45216 \u51060 \u50836  \u54889 \u47924 \u50752  \u54056 \u44340 \u51032  \u45216 \u51060 \u50836  \u52868 \u52868 \u54616 \u44256  \u50612 \u46160 \u50868  \u45216 \u51060 \u50836  \u44396 \u47492 \u44284  \u55121 \u50516 \u51032  \u45216 \u51060 \u50836  \u45208 \u54036 \u51012  \u48520 \u50612  \u44221 \u44256 \u54616 \u45716  \u45216 \u51060 \u47196 \u45796 \'94 (\u49845  1:15, 16). \'93\u50668 \u54840 \u50752 \u51032 \'85\u45216 \u51060  \u51076 \u54616 \u50668  \u46405 \u51012  \u54889 \u47924 \u52992  \u54616 \u47728  \u44536  \u51473 \u50640 \u49436  \u51396 \u51064 \u51012  \u47736 \u54616 \u47532 \u45768 \'94 (\u49324  13:9) \u46972 .\
