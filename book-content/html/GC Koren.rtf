\f0\b \cf0 \uc0\u47336 \u53552 \u51032  \u45817 \u45817 \u54620  \u45436 \u51312 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u44536 \u45716  \u54620  \u52828 \u44396 \u50640 \u44172  \u45796 \u51020 \u44284  \u44057 \u51060  \u54200 \u51648 \u54616 \u50688 \u45796 . \'93\u44536 \u47111 \u44172  \u54616 \u48064 \u47196  \u50517 \u48149 \u51012  \u48155 \u45716  \u51088 \u45716  \u51060 \u51473 \u51032  \u51060 \u51061 \u51012  \u50619 \u45716 \u45796 . \u52395 \u51704 \u45716  \u44536  \u44592 \u47197 \u51004 \u47196  \u47568 \u48120 \u50516 \u50500  \u45796 \u47480  \u49324 \u46988 \u51032  \u54032 \u45800 \u50640  \u54840 \u49548 \u54624  \u49688  \u51080 \u44256 , \u46168 \u51704 \u45716  \u51088 \u44592 \u51032  \u44368 \u47564 \u54620  \u47568 \u47196  \u51648 \u45208 \u52824 \u44172  \u50948 \u50517 \u51201 \u51064  \u53468 \u46020 \u47196  \u48169 \u51088 \u54616 \u44172  \u54632 \u48512 \u47196  \u47568 \u54616 \u45716  \u54253 \u44400 \u50640 \u44172 , \u44536  \u50577 \u49900 \u50640 \u45716  \u54840 \u49548 \u54616 \u51648  \u47803 \u54620 \u45796  \u54616 \u45908 \u46972 \u46020  \u44536 \u50640 \u44172  \u44277 \u54252 \u44048 \u51012  \u44054 \u44172  \u54616 \u45716  \u51339 \u51008  \u44592 \u54924 \u47484  \u47564 \u46308  \u49688  \u51080 \u45796 \'94 (Martyn, The Life and Times of Luther, pp.271, 272).\
\uc0\u44536 \u47532 \u44256  \u46168 \u51704  \u48264 \u51032  \u54924 \u44204 \u50640 \u49436 , \u47336 \u53552 \u45716  \u49457 \u44221 \u50640 \u49436  \u51064 \u50857 \u54620  \u47566 \u51008  \u44396 \u51208 \u46308 \u47196  \u51060 \u47336 \u50612 \u51652  \u47749 \u47308 \u54616 \u44256  \u44036 \u44208 \u54616 \u44256  \u55192  \u51080 \u45716  \u51088 \u49888 \u51032  \u51452 \u51109 \u50640  \u45824 \u54620  \u49444 \u47749 \u47928 \u51012  \u51228 \u52636 \u54616 \u50688 \u45796 . \u44536 \u45716  \u44536 \u44163 \u51012  \u53360 \u49548 \u47532 \u47196  \u45229 \u46021 \u54620  \u54980 \u50640  \u52628 \u44592 \u44221 \u50640 \u44172  \u45336 \u44200 \u51452 \u50632 \u45796 . \u44536 \u47084 \u51088  \u44536 \u45716  \u44536 \u44163 \u51012  \u45796 \u47564  \u50424 \u45936 \u50630 \u45716  \u47568 \u51012  \u44592 \u47197 \u54620  \u48520 \u44221 \u54616 \u44592  \u51677 \u51060  \u50630 \u45716  \u51064 \u50857 \u44396  (\u24341 \u29992 \u21477 ) \u51032  \u49688 \u51665 \u50640  \u48520 \u44284 \u54620  \u44163 \u51060 \u46972 \u44256  \u50808 \u52824 \u47732 \u49436  \u47736 \u49884 \u54616 \u45716  \u53468 \u46020 \u47196  \u45236 \u50612 \u45912 \u51256  \u48260 \u47160 \u45796 . \u51060 \u50640  \u47336 \u53552 \u45716  \u45812 \u45824 \u55176  \u51068 \u50612 \u45208 \u49436  \u54945 \u54252  \u47924 \u47168 \u54620  \u48277 \u50773  \u49324 \u51208 \u51032  \u45436 \u48277 \u51012  \u51060 \u50857  (\u63965 \u29992 ) \u54616 \u50668  \u51204 \u49444 \u44284  \u44368 \u54924 \u51032  \u44396 \u51204  (\u21475 \u20659 ) \u44284  \u44032 \u47476 \u52840 \u51012  \u50668 \u51648 \u50630 \u51060  \u51204 \u48373 \u49884 \u53040 \u45796 .\
\uc0\u48277 \u50773 \u51032  \u49324 \u51208 \u51008  \u47336 \u53552 \u51032  \u48320 \u47200 \u50640  \u46020 \u47924 \u51648  \u45824 \u45813 \u54624  \u49688  \u50630 \u51020 \u51012  \u50508 \u51088 , \u51088 \u51228 \u47141  (\u33258 \u21046 \u21147 ) \u51012  \u51075 \u44256  \u47609 \u47148 \u54620  \u48520 \u44284 \u44057 \u51060  \u45432 \u54616 \u50688 \u45796 . \'93\u52712 \u49548 \u54616 \u46972 . \u44536 \u47111 \u51648  \u50506 \u51004 \u47732  \u45320 \u47484  \u47196 \u47560 \u47196  \u48372 \u45236 \u44192 \u45796 . \u44144 \u44592 \u49436  \u45320 \u45716  \u45320 \u51032  \u49548 \u49569  \u49324 \u44148 \u51012  \u45812 \u45817 \u54620  \u51116 \u54032 \u44288 \u46308  \u50526 \u50640  \u49436 \u50556  \u54620 \u45796 . \u45208 \u45716  \u45320 \u50752  \u45320 \u55148  \u51068 \u45817 \u51012  \u54028 \u47928 \u54620 \u45796 . \u46608  \u50612 \u46496 \u54620  \u44221 \u50864 \u50640 \u46304 \u51648  \u45320 \u47484  \u46037 \u45716  \u51088 \u45716  \u45572 \u44396 \u47484  \u47561 \u47200 \u54616 \u44256  \u44368 \u54924 \u50640 \u49436  \u45236 \u50612  \u51923 \u44192 \u45796 \'94\u44256  \u44536 \u45716  \u48512 \u47476 \u51670 \u50632 \u45796 . \u44536 \u47532 \u44256  \u44536 \u45716  \u47560 \u51648 \u47561 \u51004 \u47196  \u44368 \u54876 \u54616 \u44256  \u48516 \u45432 \u54620  \u51020 \u51312 \u47196  \'93\u52712 \u49548 \u54616 \u46972 . \u44536 \u47111 \u51648  \u50500 \u45768 \u54616 \u47732  \u45796 \u49884  \u51060 \u44275 \u50640  \u46028 \u50500 \u50724 \u51648  \u47568 \u46972 \'94 (D\'92Aubigne, London ed., b.4, ch.8) \u44256  \u45800 \u50616 \u54616 \u50688 \u45796 .\
\uc0\u47336 \u53552 \u45716  \u51648 \u52404 \u54616 \u51648  \u50506 \u44256  \u52828 \u44396 \u46308 \u44284  \u54632 \u44760  \u51593 \u49884  \u44536  \u44275 \u50640 \u49436  \u53748 \u51109 \u54632 \u51004 \u47196  \u52712 \u49548 \u54624  \u51032 \u49324 \u44032  \u51204 \u54784  \u50630 \u45796 \u45716  \u44163 \u51012  \u48516 \u47749 \u55176  \u45208 \u53440 \u45236 \u50632 \u45796 . \u44536 \u44163 \u51008  \u48277 \u50773 \u51032  \u49324 \u51208 \u51060  \u51032 \u46020 \u54664 \u45912  \u44163 \u44284 \u45716  \u51204 \u54784  \u48152 \u45824 \u46104 \u45716  \u51068 \u51060 \u50632 \u45796 . \u44536 \u45716  \u50948 \u54801 \u51004 \u47196  \u47336 \u53552 \u50640 \u44172  \u44277 \u54252 \u44048 \u51012  \u51468 \u51004 \u47196  \u44536 \u47484  \u44404 \u48373 \u49884 \u53420  \u49688  \u51080 \u51004 \u47532 \u46972 \u44256  \u48127 \u50632 \u50632 \u45796 . \u44536 \u45716  \u51060 \u51228  \u51088 \u44592 \u51032  \u51648 \u51648 \u51088 \u46308 \u44284 \u47564  \u45224 \u44172  \u46104 \u50632 \u51004 \u48064 \u47196  \u46168 \u47084 \u50505 \u51008  \u49324 \u46988 \u46308 \u51012  \u52264 \u47168 \u47196  \u46028 \u50500 \u48372 \u47728  \u51088 \u44592 \u51032  \u44228 \u52293 \u51060  \u46907 \u48150 \u50640  \u49892 \u54056 \u54620  \u44163 \u51012  \u48516 \u54616 \u44172  \u49373 \u44033 \u54616 \u50688 \u45796 .\
\uc0\u51060 \u46412 \u51032  \u47336 \u53552 \u51032  \u54876 \u50557 \u51008  \u51339 \u51008  \u44208 \u44284 \u47484  \u44144 \u46160 \u50632 \u45796 . \u44536  \u44275 \u50640  \u52280 \u49437 \u54664 \u45912  \u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u44536  \u46160  \u49324 \u46988 \u51012  \u48708 \u44368 \u54644  \u48372 \u44256 , \u44536 \u46308 \u51060  \u45208 \u53440 \u45240  \u51221 \u49888 \u46308 \u51012  \u49828 \u49828 \u47196  \u54032 \u45800 \u54644  \u48380  \u49104 \u47564  \u50500 \u45768 \u46972 , \u44536 \u46308 \u51060  \u51228 \u49884 \u54620  \u51060 \u47200 \u51032  \u49444 \u46301 \u47141 \u44284  \u51652 \u49892 \u49457 \u51012  \u48708 \u44368 \u54644  \u48372 \u44256  \u54032 \u45800 \u54644  \u48380  \u49688  \u51080 \u45716  \u44592 \u54924 \u47484  \u44032 \u51648 \u44172  \u46104 \u50632 \u45796 . \u44536 \u44163 \u46308 \u51008  \u45320 \u47924 \u45208  \u45824 \u51312 \u51201 \u51060 \u50632 \u45796 . \u44060 \u54785 \u51088 \u45716  \u54616 \u45208 \u45784 \u51032  \u45733 \u47141 \u51004 \u47196  \u45800 \u49692 \u54616 \u44256 , \u44216 \u49552 \u54616 \u44256 , \u44403 \u49468  \u53468 \u46020 \u47196  \u51652 \u47532 \u47484  \u51228 \u49884 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u48277 \u50773 \u51032  \u49324 \u51208 \u51008  \u51004 \u49828 \u45824 \u47728 , \u44144 \u47564 \u54616 \u44256 , \u54945 \u54252 \u54616 \u44256 , \u48708 \u54633 \u47532 \u51201 \u51064  \u53468 \u46020 \u47196  \u54620  \u44396 \u51208 \u51032  \u49457 \u44221  \u47568 \u50432 \u46020  \u51064 \u50857 \u54616 \u51648  \u50506 \u51008  \u52292  \u54868 \u47484  \u45236 \u47732 \u49436  \'93\u52712 \u49548 \u54616 \u46972 . \u44536 \u47111 \u51648  \u50500 \u45768 \u54616 \u47732  \u47196 \u47560 \u50640  \u48372 \u45236 \u50612  \u52376 \u48268 \u54616 \u44192 \u45796 \'94\u44256  \u48512 \u47476 \u51670 \u51012  \u49104 \u51060 \u50632 \u45796 .\
