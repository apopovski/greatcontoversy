\f1\b0 \cf0 \
\uc0\u50668 \u54665  \u51473 \u50640  \u44536 \u46308 \u51008  \u48177 \u49457 \u46308 \u51032  \u47560 \u51020 \u51060  \u50864 \u50872 \u54620  \u50696 \u44048 \u51004 \u47196  \u45580 \u47140  \u51080 \u45716  \u44163 \u51012  \u48372 \u50520 \u45796 . \u50612 \u46500  \u46020 \u49884 \u46308 \u50640 \u49436 \u45716  \u44536 \u46308 \u50640 \u44172  \u50500 \u47924 \u47088  \u44221 \u51032 \u46020  \u54364 \u54616 \u51648  \u50506 \u50520 \u45796 . \u44536 \u46308 \u51060  \u48164 \u51012  \u49352 \u50864 \u44592  \u50948 \u54616 \u50668  \u54620  \u44275 \u50640  \u47672 \u47932 \u47104 \u51012  \u46412  \u52828 \u51208 \u54620  \u54620  \u49888 \u48512 \u45716  \u49692 \u44368 \u45817 \u54620  \u54620  \u51060 \u53468 \u47532  \u44060 \u54785 \u51088 \u51032  \u52488 \u49345 \u51012  \u47336 \u53552 \u50640 \u44172  \u45236 \u48372 \u51060 \u47732 \u49436  \u51088 \u44592 \u51032  \u50684 \u47140 \u47484  \u54588 \u47141 \u54616 \u50688 \u45796 . \u44536  \u45796 \u51020 \u45216  \u44536 \u46308 \u51008  \u47336 \u53552 \u51032  \u51200 \u49436 \u44032  \u48372 \u47492 \u49828 \u50640 \u49436  \u51221 \u51396 \u45817 \u54620  \u44163 \u51012  \u50508 \u44172  \u46104 \u50632 \u45796 . \u54889 \u51228 \u51032  \u49324 \u51088 \u46308 \u51008  \u44536  \u52825 \u47161 \u51012  \u54252 \u44256 \u54616 \u44256 , \u48177 \u49457 \u46308 \u50640 \u44172  \u44536  \u44552 \u51648 \u46108  \u49436 \u51201 \u46308 \u51012  \u51648 \u48169  \u51109 \u44288 \u46308 \u50640 \u44172 \u47196  \u44032 \u51256 \u44032 \u46020 \u47197  \u47749 \u47161 \u54616 \u50688 \u45796 . \u46041 \u54665 \u54616 \u45716  \u51204 \u47161 \u44288 \u51008  \u47336 \u53552 \u44032  \u51032 \u54924 \u50640 \u49436  \u50504 \u51204 \u54624  \u44163 \u51064 \u51648  \u50684 \u47140 \u54616 \u45716  \u54620 \u54200 , \u44536 \u51032  \u44208 \u49900 \u50640 \u46020  \u46041 \u50836 \u44032  \u49373 \u44220 \u51012  \u44163 \u51004 \u47196  \u49373 \u44033 \u54616 \u50668 , \u44228 \u49549 \u54616 \u50668  \u50526 \u51004 \u47196  \u51204 \u51652 \u54616 \u44192 \u45712 \u45264 \u44256  \u47932 \u50632 \u45796 . \u44536 \u45716  \'93\u51648 \u45208 \u45716  \u46020 \u49884 \u47560 \u45796  \u48169 \u54644 \u47484  \u54624 \u51648 \u46972 \u46020  \u45208 \u45716  \u44228 \u49549 \u54616 \u50668  \u51204 \u51652 \u54616 \u44192 \u45796 \'94\u44256  \u45824 \u45813 \u54616 \u50688 \u45796 .\
\uc0\u50640 \u47476 \u54392 \u47476 \u53944  (Erfurt) \u50640 \u49436 \u45716  \u47336 \u53552 \u44032  \u51316 \u44221 \u51012  \u48155 \u50520 \u45796 . \u44536 \u47484  \u51316 \u44221 \u54616 \u45716  \u47566 \u51008  \u44400 \u51473 \u50640 \u44172  \u46168 \u47084 \u49912 \u51064  \u52292  \u51088 \u49888 \u51060  \u51204 \u50640  \u53441 \u48156 \u49849 \u51004 \u47196 \u49436  \u46041 \u45285 \u54616 \u47728  \u51648 \u45208 \u45796 \u45396 \u45912  \u44536  \u44600 \u44144 \u47532 \u47484  \u51648 \u45208 \u44052 \u45796 . \u44536 \u45716  \u51088 \u44592 \u44032  \u51080 \u45912  \u49849 \u50896  (\u20711 \u38498 ) \u51012  \u52286 \u50500 \u48372 \u44256 , \u50724 \u45720 \u45216 \u51008  \u46021 \u51068  \u51204 \u50669 \u50640  \u54140 \u51256  \u51080 \u45716  \u48731 \u51060 \u51648 \u47564  \u44536  \u48731 \u51060  \u51068 \u52237 \u51060  \u51088 \u44592 \u50640 \u44172  \u52376 \u51020 \u51004 \u47196  \u48708 \u52824 \u45912  \u46412 \u50640  \u45817 \u54620  \u44256 \u48124 \u51012  \u52628 \u50613 \u54616 \u50688 \u45796 . \u44144 \u44592 \u49436  \u44536 \u45716  \u49444 \u44368 \u54616 \u50668  \u45804 \u46972 \u45716  \u44036 \u52397 \u51012  \u48155 \u50520 \u45796 . \u44536 \u50640 \u44172 \u45716  \u49444 \u44368 \u54616 \u45716  \u51068 \u51060  \u44552 \u51648 \u46104 \u50612  \u51080 \u50632 \u45796 . \u44536 \u47084 \u45208  \u46041 \u54665 \u54616 \u45912  \u51204 \u47161 \u44288 \u51060  \u54728 \u46973 \u54616 \u50688 \u51004 \u48064 \u47196  \u51060  \u49849 \u50896 \u50640 \u49436  \u52380 \u54620  \u51068 \u50640  \u51333 \u49324 \u54664 \u50632 \u45912  \u54620 \u45233  \u53441 \u48156 \u49849 \u51060  \u51060 \u51228  \u49444 \u44368 \u45800 \u51004 \u47196  \u45208 \u50500 \u44052 \u45796 .\
\uc0\u44536 \u45716  \u47784 \u51064  \u47924 \u47532 \u46308 \u51012  \u54693 \u54616 \u50668  \'93\u45320 \u55148 \u50640 \u44172  \u54217 \u44053 \u51060  \u51080 \u51012 \u51648 \u50612 \u45796 \'94\u46972 \u45716  \u44536 \u47532 \u49828 \u46020 \u51032  \u47568 \u50432 \u51004 \u47196  \u47568 \u51012  \u49884 \u51089 \u54616 \u50688 \u45796 . \'93\u52384 \u54617 \u51088 \u46308 , \u48149 \u49324 \u46308 , \u51200 \u49696 \u44032 \u46308 \u51008  \u49324 \u46988 \u46308 \u50640 \u44172  \u50689 \u49373 \u51012  \u50619 \u45716  \u44600 \u51012  \u44032 \u47476 \u52432  \u51452 \u44256 \u51088  \u45432 \u47141 \u54616 \u50688 \u51648 \u47560 \u45716  \u49457 \u44277 \u54616 \u51648  \u47803 \u54616 \u50688 \u49845 \u45768 \u45796 . \u45208 \u45716  \u51060 \u51228  \u50668 \u47084 \u48516 \u50640 \u44172  \u44536 \u44163 \u51012  \u50508 \u47140 \u46300 \u47532 \u44192 \u49845 \u45768 \u45796 . \'85\u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u54620  \u48516 , \u44263  \u51452  \u50696 \u49688  \u44536 \u47532 \u49828 \u46020 \u47484  \u51453 \u51020 \u50640 \u49436  \u51068 \u51004 \u53412 \u49512 \u49845 \u45768 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u48516 \u51004 \u47196  \u54616 \u50668 \u44552  \u51453 \u51020 \u51012  \u47736 \u54616 \u44172  \u54616 \u49884 \u44256 , \u51396 \u47484  \u44540 \u51208 \u49884 \u53412 \u49884 \u44256 , \u51648 \u50725 \u51032  \u47928 \u51012  \u45803 \u50500  \u48260 \u47532 \u44172  \u54616 \u49512 \u49845 \u45768 \u45796 . \u51060 \u44163 \u51060  \u48148 \u47196  \u44396 \u50896 \u51032  \u49324 \u50629 \u51060 \u47728 \'85\u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u51221 \u48373 \u54616 \u49888  \u49324 \u50629 \u51077 \u45768 \u45796 . \u51060 \u44163 \u51008  \u44592 \u49244  \u49548 \u49885 \u51077 \u45768 \u45796 . \u50864 \u47532 \u45716  \u50864 \u47532  \u51088 \u49888 \u51032  \u44277 \u47196 \u47196  \u44396 \u50896 \u51012  \u50619 \u45716  \u44163 \u51060  \u50500 \u45768 \u46972 , \u50864 \u47532  \u51452 \u45784 \u44760 \u49436  \u54665 \u54616 \u49888  \u44277 \u47196 \u47196  \u44396 \u50896 \u51012  \u50619 \u49845 \u45768 \u45796 . \'85\u50864 \u47532  \u51452  \u50696 \u49688  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \'91\u45320 \u55148 \u50640 \u44172  \u54217 \u44053 \u51060  \u51080 \u51012 \u51648 \u50612 \u45796 , \u45236  \u49552 \u51012  \u48372 \u46972 \'92\u44256  \u47568 \u50432 \u54616 \u49512 \u49845 \u45768 \u45796 . \u44536  \u47568 \u50432 \u51008  \u44263  \u49324 \u46988 \u46308 \u51060 \u50668  \u48372 \u46972 , \u45320 \u55148 \u51032  \u51396 \u47484  \u50630 \u51060 \u54616 \u44256  \u45320 \u55148 \u47484  \u49549 \u47049 \u54620  \u49324 \u46988 \u51008  \u45208 , \u44263  \u45208 \u49104 \u51060 \u45796 . \u51060 \u51228  \u45320 \u55148 \u45716  \u54217 \u50504 \u54632 \u51012  \u45572 \u47540 \u51648 \u50612 \u45796 \u46972 \u44256  \u50864 \u47532  \u51452 \u45784 \u44760 \u49436  \u47568 \u50432 \u54616 \u49888 \u45796 \u45716  \u46907 \u51077 \u45768 \u45796 .\'94\
\uc0\u44536 \u45716  \u44228 \u49549 \u54616 \u50668  \u52280 \u46108  \u49888 \u50521 \u51008  \u44144 \u47337 \u54620  \u49373 \u50528 \u47196  \u45208 \u53440 \u45208 \u50556  \u54624  \u44163 \u51060 \u46972 \u44256  \u47568 \u54616 \u50688 \u45796 . \'93\u51060 \u48120  \u54616 \u45208 \u45784 \u44760 \u49436  \u50864 \u47532 \u47484  \u44396 \u50896 \u54616 \u49512 \u51004 \u48064 \u47196  \u50864 \u47532 \u45716  \u44536 \u48516 \u44760 \u49436  \u51339 \u50500 \u54616 \u49884 \u45716  \u54665 \u50948 \u47484  \u54616 \u50668 \u50556  \u54624  \u44163 \u51077 \u45768 \u45796 . \u50668 \u47084 \u48516 \u46308 \u51008  \u48512 \u50836 \u54633 \u45768 \u44620 ? \u44536 \u47084 \u47732  \u50668 \u47084 \u48516 \u46308 \u51032  \u49548 \u50976 \u47484  \u44032 \u45212 \u54620  \u49324 \u46988 \u46308 \u51032  \u54596 \u50836 \u47484  \u50948 \u54616 \u50668  \u44277 \u44553 \u54616 \u49901 \u49884 \u50724 . \u50668 \u47084 \u48516 \u46308 \u51008  \u44032 \u45212 \u54633 \u45768 \u44620 ? \u44536 \u47084 \u47732  \u50668 \u47084 \u48516 \u51008  \u48512 \u50836 \u54620  \u49324 \u46988 \u46308 \u50640 \u44172  \u44032 \u45225 \u46112  \u47564 \u54620  \u48393 \u49324 \u47484  \u54616 \u49901 \u49884 \u50724 . \u47564 \u51068  \u50668 \u47084 \u48516 \u51032  \u49688 \u44256 \u44032  \u50668 \u47084 \u48516  \u51088 \u49888 \u50640 \u44172 \u47564  \u50976 \u51061 \u51012  \u51456 \u45796 \u47732 , \u50668 \u47084 \u48516 \u46308 \u51060  \u54616 \u45208 \u45784 \u51012  \u49452 \u44592 \u45432 \u46972 \u44256  \u44277 \u50616 \u54616 \u51648 \u47564  \u44144 \u51667 \u47568 \u51060  \u46104 \u44256  \u47577 \u45768 \u45796 \'94 (D\'92Aubigne, b.7, ch.7).\
