\uc0\u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u45817 \u49888 \u51032  \u51473 \u48372  \u49324 \u50629 \u51012  \u49457 \u49548 \u50640 \u49436  \u47560 \u52824 \u49892  \u46412 , \u51664 \u49849 \u44284  \u44536  \u50864 \u49345 \u50640 \u44172  \u44221 \u48176 \u54616 \u44256  \u44536  \u54364 \u47484  \u48155 \u45716  \u51088 \u46308 \u50640 \u44172  \u51060 \u48120  \u44221 \u44256 \u54620 , \u51088 \u48708 \u44032  \u49438 \u51060 \u51648  \u50506 \u51008  \u51652 \u45432 \u44032  \u45236 \u47540  \u44163 \u51060 \u45796  (\u44228  14:9, 10 \u52280 \u51312 ). \u54616 \u45208 \u45784 \u44760 \u49436  \u51060 \u49828 \u46972 \u50648 \u51012  \u44396 \u50896 \u54644  \u45236 \u49884 \u47140  \u54616 \u49512 \u51012  \u46412  \u50528 \u44413 \u50640  \u45236 \u47536  \u51116 \u50521 \u51008  \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u51032  \u47560 \u51648 \u47561  \u44396 \u50896  \u51649 \u51204 \u50640  \u51060  \u49464 \u49345 \u50640  \u45236 \u47540  \u45908 \u50865  \u47924 \u49453 \u44256  \u53360  \u44508 \u47784 \u51032  \u54805 \u48268 \u44284  \u49457 \u51656 \u49345  \u50976 \u49324 \u54620  \u44163 \u51060 \u50632 \u45796 . \u44228 \u49884 \u47197 \u51032  \u44592 \u51088 \u45716  \u44536  \u47924 \u49436 \u50868  \u51116 \u50521 \u51012  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u54620 \u45796 . \'93\u50501 \u54616 \u44256  \u46021 \u54620  \u54732 \u45936 \u44032  \u51664 \u49849 \u51032  \u54364 \u47484  \u48155 \u51008  \u49324 \u46988 \u46308 \u44284  \u44536  \u50864 \u49345 \u50640 \u44172  \u44221 \u48176 \u54616 \u45716  \u51088 \u46308 \u50640 \u44172  \u45208 \u45908 \u46972 .\'94 \'93\u48148 \u45796 \u44032  \u44263  \u51453 \u51008  \u51088 \u51032  \u54588 \u44057 \u51060  \u46104 \u45768  \u48148 \u45796  \u44032 \u50868 \u45936  \u47784 \u46304  \u49373 \u47932 \u51060  \u51453 \u45908 \u46972 .\'94 \'93\u44053 \u44284  \u47932  \u44540 \u50896 \u50640  \u50143 \u51004 \u47588  \u54588 \u44032  \u46104 \u45908 \u46972 .\'94 \u51060 \u47084 \u54620  \u46160 \u47140 \u50868  \u51116 \u50521 \u46308 \u51008  \u54616 \u45208 \u45784 \u51032  \u44277 \u51032 \u47484  \u50756 \u51204 \u55176  \u50745 \u54840 \u54624  \u44163 \u51060 \u45796 . \u54616 \u45208 \u45784 \u51032  \u52380 \u49324 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u49440 \u54252 \u54620 \u45796 . \'93\u44144 \u47337 \u54616 \u49888  \u51060 \u50668  \u51060 \u47111 \u44172  \u49900 \u54032 \u54616 \u49884 \u45768  \u51032 \u47196 \u50864 \u49884 \u46020 \u45796  \u51200 \u55148 \u44032  \u49457 \u46020 \u46308 \u44284  \u49440 \u51648 \u51088 \u46308 \u51032  \u54588 \u47484  \u55128 \u47160 \u51004 \u48064 \u47196  \u51200 \u55148 \u47196  \u54588 \u47484  \u47560 \u49884 \u44172  \u54616 \u49888  \u44163 \u51060  \u54633 \u45817 \u54616 \u45768 \u51060 \u45796 \'94 (\u44228  16:2~6). \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u46308 \u50640 \u44172  \u49324 \u54805 \u51012  \u50616 \u46020 \u54632 \u51004 \u47196 \u50024  \u44536 \u46308 \u51008  \u44536 \u46308 \u51032  \u49552 \u51004 \u47196  \u44536  \u49324 \u46988 \u46308 \u51032  \u54588 \u47484  \u55128 \u47536  \u44163 \u44284  \u46609 \u44057 \u51008  \u51396 \u47484  \u48276 \u54620  \u44163 \u51060 \u45796 . \u44057 \u51008  \u48169 \u48277 \u51004 \u47196  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u44536  \u45817 \u49884 \u51032  \u50976 \u45824 \u51064 \u46308 \u51060  \u50500 \u48296 \u49884 \u45824  \u51060 \u54980 \u47196  \u47784 \u46304  \u49457 \u46020 \u46308 \u51032  \u54588 \u47484  \u55128 \u47536  \u51396 \u47484  \u48276 \u54616 \u50688 \u45796 \u44256  \u51452 \u51109 \u54616 \u49512 \u45796 . \u50780 \u45264 \u54616 \u47732  \u44536 \u46308 \u51008  \u49440 \u51648 \u51088 \u46308 \u51012  \u51453 \u51064  \u51088 \u46308 \u44284  \u46609 \u44057 \u51008  \u51221 \u49888 \u51012  \u44032 \u51648 \u44256  \u44057 \u51008  \u51068 \u51012  \u54616 \u44256 \u51088  \u44928 \u54616 \u44256  \u51080 \u5