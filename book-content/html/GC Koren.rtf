\uc0\u50696 \u49688 \u45784 \u44760 \u49436  \u50864 \u47532 \u47484  \u50948 \u54616 \u50668  \u48393 \u49324 \u54616 \u49884 \u45716  \u54616 \u45720 \u50640  \u51080 \u45716  \u49457 \u49548 \u45716  \u53360  \u49892 \u52404  (\u23526 \u39636 ) \u51060 \u47728 , \u47784 \u49464 \u44032  \u51648 \u51008  \u49457 \u49548 \u45716  \u44536 \u44163 \u51012  \u47784 \u48169 \u54620  \u44163 \u51060 \u50632 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u51648 \u49345 \u49457 \u49548 \u47484  \u51667 \u45716  \u51088 \u46308 \u50640 \u44172  \u45817 \u49888 \u51032  \u50689 \u51012  \u48512 \u50612  \u51452 \u49512 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536  \u44396 \u51312 \u50640  \u45208 \u53440 \u45212  \u44277 \u44368 \u54620  \u44592 \u49696 \u51008  \u47784 \u46160  \u54616 \u45208 \u45784 \u51032  \u51648 \u54812 \u47484  \u45208 \u53440 \u45240  \u44163 \u51060 \u50632 \u45796 . \u48317 \u51008  \u54616 \u45208 \u51032  \u53360  \u44552 \u45929 \u51060 \u52376 \u47100  \u48372 \u51060 \u44256  \u54889 \u44552  \u46321 \u45824 \u51032  \u51068 \u44273  \u46321 \u51092 \u50640 \u49436  \u48156 \u54616 \u45716  \u48731 \u51008  \u49457 \u47561 \u51032  \u45236 \u48512 \u47484  \u49324 \u48169 \u51004 \u47196  \u48708 \u52628 \u50632 \u45796 . \u51652 \u49444 \u54620  \u46497 \u49345 \u44284  \u54693 \u45800 \u51008  \u47560 \u52824  \u50672 \u47560 \u54620  \u51221 \u44552 \u52376 \u47100  \u52268 \u46976 \u54616 \u44172  \u48731 \u45228 \u44256  \u52380 \u51109 \u51008  \u52397 \u49353  \u49892 \u44284  \u51088 \u49353  \u49892 \u44284  \u54861 \u49353  \u49892 \u47196  \u52380 \u49324 \u46308 \u51032  \u54805 \u49345 \u51012  \u49688 \u45459 \u51008  \u54868 \u47140 \u54620  \u52380 \u51004 \u47196  \u45934 \u50688 \u50632 \u45796 . \u46168 \u51704  \u55064 \u51109  \u50504 \u50640 \u45716  \u49324 \u46988 \u51032  \u45576 \u51004 \u47196  \u48380  \u49688  \u51080 \u45716  \u54616 \u45208 \u45784 \u51032  \u50689 \u44305 \u51032  \u54364 \u