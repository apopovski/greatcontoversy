\uc0\u50668 \u44592 \u50640  \u44592 \u47197 \u46108  \'93\u47560 \u55124 \u46160  \u45804  \u46041 \u50504 \'94 \u54841 \u51008  \'93\u51068 \u52380 \u51060 \u48177 \u50977 \u49901 \u51068 \'94\u51060 \u46976  \u47568 \u51008  \u44057 \u51008  \u44592 \u44036 \u51012  \u44032 \u47532 \u53412 \u45716  \u47568 \u47196 \u49436 , \u44536 \u47532 \u49828 \u46020 \u51032  \u44368 \u54924 \u44032  \u47196 \u47560 \u44368 \u51032  \u50517 \u48149 \u51012  \u48155 \u51012  \u44592 \u44036 \u51012  \u45208 \u53440 \u45240 \u45796 . \u48277 \u50773 \u44428 \u51060  \u52572 \u49345 \u44428 \u51012  \u51536 \u44172  \u46108  \u51068 \u52380 \u51060 \u48177 \u50977 \u49901  \u45380 \u51008  \u49436 \u44592  538\u45380 \u50640  \u49884 \u51089 \u46104 \u50612  1798\u45380  \u47560 \u52824 \u44172  \u46108 \u45796 . \u44536  \u46412 \u50640  \u54532 \u46993 \u49828  \u44400 \u45824 \u44032  \u47196 \u47560 \u50640  \u52840 \u51077 \u54616 \u50668  \u48277 \u50773 \u51012  \u49324 \u47196 \u51105 \u50520 \u45716 \u45936 , \u44536 \u45716  \u50976 \u48176 \u51473 \u50640  \u51453 \u50632 \u45796 . \u50620 \u47560  \u54980 \u50640  \u49352  \u48277 \u50773 \u51060  \u49440 \u52636 \u46104 \u50632 \u51004 \u45208  \u47196 \u47560 \u51032  \u44368 \u44428  (\u25934 \u27402 ) \u51008  \u51204 \u44284  \u44057 \u51008  \u49464 \u47141 \u51012  \u48156 \u55064 \u54616 \u51648  \u47803 \u54616 \u50688 \u45796 .\
