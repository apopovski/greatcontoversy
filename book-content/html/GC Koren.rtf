\f1\b0 \cf0 \
\uc0\u53084 \u47352 \u48148  (Columba) \u50752  \u44536 \u51032  \u46041 \u50669 \u51088 \u46308 \u47196  \u47568 \u48120 \u50516 \u50500  \u49828 \u53076 \u53952 \u47004 \u46300 \u50640  \u49100 \u47140 \u51652  \u51652 \u47532 \u51032  \u50472 \u45716  \u50756 \u51204 \u55176  \u47736 \u51208 \u46104 \u51648  \u50500 \u45768 \u54616 \u50688 \u45796 . \u50689 \u44397 \u51032  \u44368 \u54924 \u46308 \u51060  \u47196 \u47560  \u48277 \u50773 \u50640 \u44172  \u48373 \u51333 \u54620  \u51060 \u54980 \u50640 \u46020  \u49688 \u48177  \u45380  \u46041 \u50504  \u49828 \u53076 \u53952 \u47004 \u46300  \u49324 \u46988 \u46308 \u51008  \u51088 \u50976 \u47484  \u44032 \u51648 \u44256  \u51080 \u50632 \u45796 . \u44536 \u47088 \u45936  12\u49464 \u44592 \u50640  \u51060 \u47476 \u47084  \u48277 \u50773 \u44368 \u44032  \u51060  \u45208 \u46972 \u50640  \u49464 \u50892 \u51648 \u44172  \u46104 \u51088  \u45796 \u47480  \u50612 \u46500  \u45208 \u46972 \u50640 \u49436  \u48380  \u49688  \u50630 \u51012  \u51221 \u46020 \u47196  \u51208 \u45824 \u44428 \u51012  \u55064 \u46168 \u47104 \u45796 . \u51060 \u44275 \u52376 \u47100  \u50516 \u55121 \u51060  \u49900 \u54620  \u44275 \u51008  \u45796 \u47480  \u50612 \u46500  \u44275 \u50640 \u46020  \u50630 \u50632 \u45796 . \u44536 \u47100 \u50640 \u46020  \u48520 \u44396 \u54616 \u44256  \u44536  \u44275 \u50640 \u46020  \u48731 \u51060  \u48708 \u52824 \u50612  \u44032 \u47140 \u51652  \u50516 \u55121 \u51012  \u46763 \u44256  \u45236 \u51068 \u51012  \u50557 \u49549 \u54644  \u51452 \u50632 \u45796 . \u49457 \u44221 \u44284  \u50948 \u53364 \u47532 \u54532 \u51032  \u44368 \u47532 \u47484  \u44032 \u51648 \u44256  \u50689 \u44397 \u50640 \u49436  \u50728  \u47204 \u46972 \u46300 \u51064 \u46308  (Lollards) \u51008  \u48373 \u51020 \u51032  \u51648 \u49885 \u51012  \u48372 \u51316 \u54616 \u44172  \u54616 \u45716  \u51068 \u50640  \u53360  \u50669 \u54624 \u51012  \u54616 \u50688 \u45796 . \u44536  \u54980  \u50668 \u47084  \u49464 \u44592  \u46041 \u50504  \u48373 \u51020 \u51032  \u51613 \u44144 \u51088 \u50752  \u49692 \u44368 \u51088 \u47484  \u48176 \u52636 \u54644  \u45236 \u44172  \u46104 \u50632 \u45796 .\
\uc0\u45824 \u51333 \u44368  \u44060 \u54785 \u51060  \u49884 \u51089 \u46120 \u44284  \u46041 \u49884 \u50640  \u47336 \u53552 \u51032  \u51200 \u49436 \u44032  \u46308 \u50612 \u50724 \u44256 , \u45796 \u49884  \u54004 \u45916 \u51032  \u50689 \u50612  \u49888 \u50557  \u49457 \u44221 \u51060  \u51204 \u54644 \u51276 \u45796 . \u51060 \u47084 \u54620  \u51200 \u49436 \u46308 \u51008  \u44368 \u44428 \u51032  \u44048 \u49884 \u47484  \u48155 \u51648  \u50506 \u44256  \u51312 \u50857 \u55176  \u49328 \u44284  \u44264 \u51676 \u44592 \u46308 \u51012  \u45336 \u50612 \u49436  \u49828 \u53076 \u53952 \u47004 \u46300 \u50640 \u49436  \u44144 \u51032  \u44732 \u51256 \u44032 \u45912  \u51652 \u47532 \u51032  \u46321 \u48520 \u50640  \u49352 \u47196 \u50868  \u49373 \u44592 \u47484  \u51452 \u50632 \u45796 . \u44536 \u47532 \u54616 \u50668  4\u48177  \u45380 \u44036 \u51032  \u50517 \u48149 \u51060  \u51060 \u47336 \u50612  \u45459 \u51008  \u47196 \u47560 \u51032  \u49324 \u50629 \u51012  \u47924 \u45320 \u46888 \u47160 \u45796 .\
\uc0\u46608 \u54620  \u49692 \u44368 \u51088 \u51032  \u54588 \u44032  \u44536  \u50868 \u46041 \u50640  \u49352 \u47196 \u50868  \u51088 \u44537 \u51012  \u51452 \u50632 \u45796 . \u48277 \u50773 \u44368 \u51032  \u51648 \u46020 \u51088 \u46308 \u51008  \u44536 \u46308 \u51032  \u49324 \u50629 \u51060  \u50948 \u54801 \u51012  \u45817 \u54616 \u44172  \u46108  \u44163 \u51012  \u44648 \u45803 \u51088 , \u51593 \u49884 \u47196  \u49828 \u53076 \u53952 \u47004 \u46300 \u51032  \u44032 \u51109  \u44256 \u44480 \u54616 \u44256  \u47749 \u47581  \u51080 \u45716  \u49324 \u46988  \u51473 \u51032  \u47751 \u51012  \u54868 \u54805 \u50640  \u52376 \u54616 \u50688 \u45796 . \u44536 \u47088 \u45936  \u47196 \u47560 \u44368 \u51032  \u45817 \u44397 \u51088 \u46308 \u51008  \u44536 \u46308 \u50640 \u44172  \u44053 \u45800  (\u35611 \u22727 ) \u51012  \u47564 \u46308 \u50612  \u51452 \u50632 \u51004 \u47728 , \u44144 \u44592 \u49436  \u45208 \u50724 \u45716  \u51453 \u50612 \u44032 \u45716  \u51613 \u51064 \u46308 \u51032  \u51076 \u51333 \u51032  \u47568 \u51060  \u50728  \u45208 \u46972 \u50640  \u50872 \u47140  \u54140 \u51256 \u49436  \u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u50640  \u47196 \u47560 \u51032  \u44404 \u47112 \u47484  \u48279 \u50612 \u45208 \u50556 \u44192 \u45796 \u45716  \u48520 \u47736 \u51032  \u47785 \u51201 \u51012  \u44054 \u44172  \u54644 \u51452 \u50632 \u45796 .\
\uc0\u54644 \u48128 \u53556  (Hamilton) \u44284  \u50948 \u49380 \u53944  (Wishart) \u46160  \u49324 \u46988 \u51008  \u44032 \u47928 \u46020  \u51339 \u44256  \u51064 \u44201 \u46020  \u44256 \u49345 \u54620  \u49324 \u46988 \u46308 \u51060 \u50632 \u45716 \u45936  \u44216 \u49552 \u54620  \u47566 \u51008  \u51228 \u51088 \u46308 \u44284  \u54632 \u44760  \u54868 \u54805 \u51452 \u50640 \u49436  \u44536 \u46308 \u51032  \u49373 \u47749 \u51012  \u47560 \u52452 \u45796 . \u44536 \u47084 \u45208  \u50948 \u49380 \u53944 \u51032  \u54868 \u54805 \u51452 \u47196 \u48512 \u53552  \u48520 \u44867 \u51004 \u47196 \u46020  \u52840 \u47925 \u49884 \u53420  \u49688  \u50630 \u45716  \u49324 \u46988 , \u44263  \u54616 \u45208 \u45784 \u51032  \u45733 \u47141 \u51012  \u55192 \u51077 \u50612  \u49828 \u53076 \u53952 \u47004 \u46300 \u51032  \u48277 \u50773 \u44368 \u47484  \u47792 \u46973 \u49884 \u53420  \u54620  \u51064 \u47932 \u51060  \u45208 \u53440 \u45228 \u45796 .\
\uc0\u51316  \u45433 \u49828  (John Knox) \u45716  \u47196 \u47560 \u44368 \u51032  \u51204 \u49444 \u44284  \u49888 \u48708 \u51452 \u51032 \u47484  \u48260 \u47532 \u44256  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51032  \u51652 \u47532 \u47484  \u48155 \u50500 \u46308 \u51060 \u44172  \u46104 \u50632 \u45796 . \u46041 \u49884 \u50640  \u44536 \u45716  \u50948 \u49380 \u53944 \u51032  \u44032 \u47476 \u52840 \u51012  \u53685 \u54616 \u50668  \u47196 \u47560 \u44368 \u47484  \u48279 \u50612 \u45208 \u44256 \u51088  \u54869 \u44256 \u54616 \u44172  \u44208 \u49900 \u54616 \u44256  \u48149 \u54644 \u47484  \u48155 \u45716  \u44060 \u54785 \u51088 \u46308 \u50640 \u44172  \u44032 \u45812 \u54616 \u44172  \u46104 \u50632 \u45796 .\
