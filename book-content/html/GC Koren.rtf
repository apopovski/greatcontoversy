\uc0\u51109 \u47000 \u51032  \u50976 \u50629 \u51060  \u51648 \u45208 \u52824 \u44172  \u47932 \u51656 \u51201 \u51064  \u44163 \u52376 \u47100  \u49373 \u44033 \u46104 \u45716  \u51068 \u51012  \u50684 \u47140 \u54616 \u50668  \u50864 \u47532 \u51032  \u48376 \u54693 \u51012  \u48148 \u46972 \u48372 \u44172  \u54644 \u51452 \u45716  \u48148 \u47196  \u44536  \u51652 \u47532 \u47484  \u50689 \u51201 \u51004 \u47196 \u47564  \u54644 \u49437 \u54616 \u45716  \u49324 \u46988 \u46308 \u51060  \u47566 \u45796 . \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u51228 \u51088 \u46308 \u50640 \u44172  \u44536 \u46308 \u51012  \u50948 \u54616 \u50668  \u50500 \u48260 \u51648  \u51665 \u50640  \u52376 \u49548 \u47484  \u50696 \u48708 \u54616 \u47084  \u44032 \u49888 \u45796 \u44256  \u48372 \u51613 \u54616 \u49512 \u45796 . \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51060  \u44032 \u47476 \u52824 \u45716  \u48148 \u47484  \u48155 \u50500 \u46308 \u51060 \u45716  \u49324 \u46988 \u46308 \u51008  \u54616 \u45720  \u51665 \u50640  \u44288 \u54616 \u50668  \u51204 \u54784  \u47924 \u51648 \u54616 \u51648 \u45716  \u50506 \u51012  \u44163 \u51060 \u45796 . \u44536 \u47084 \u45208  \'93\u54616 \u45208 \u45784 \u51060  \u51088 \u44592 \u47484  \u49324 \u46993 \u54616 \u45716  \u51088 \u46308 \u51012  \u50948 \u54616 \u50668  \u50696 \u48708 \u54616 \u49888  \u47784 \u46304  \u44163 \u51008  \u45576 \u51004 \u47196  \u48372 \u51648  \u47803 \u54616 \u44256  \u44480 \u47196 \u46020  \u46307 \u51648  \u47803 \u54616 \u44256  \u49324 \u46988 \u51032  \u47560 \u51020 \u51004 \u47196 \u46020  \u49373 \u44033 \u51648  \u47803 \u54616 \u50688 \'94 (\u44256 \u51204  2:9) \u45912  \u44163 \u46308 \u51060 \u45796 . \u49324 \u46988 \u51032  \u50616 \u50612 \u45716  \u51032 \u51064 \u46308 \u51060  \u48155 \u51012  \u49345 \u44553 \u51012  \u47896 \u49324 \u54616 \u44592 \u50640  \u51201 \u54633 \u54616 \u51648  \u50506 \u45796 . \u44536 \u44163 \u51008  \u50724 \u51649  \u48148 \u46972 \u48372 \u45716  \u49324 \u46988 \u46308 \u47564 \u51060  \u44648 \u45803 \u44172  \u46112  \u44163 \u51060 \u45796 . \u50976 \u54620 \u54620  \u49324 \u46988 \u51004 \u47196 \u49436 \u45716  \u50500 \u47924 \u46020  \u54616 \u45208 \u45784 \u51032  \u45209 \u50896 \u51032  \u50689 \u44305 \u51012  \u44648 \u45804 \u51012  \u49688  \u50630 \u45796 .\
\uc0\u49457 \u44221 \u51008  \u44396 \u50896  \u50619 \u51008  \u51088 \u51032  \u50976 \u50629 \u51012  \u48376 \u54693 \u51060 \u46972 \u44256  \u48512 \u47480 \u45796  (\u55176  11:14~16 \u52280 \u51312 ). \u44536  \u44275 \u50640 \u49436  \u54616 \u45720 \u51032  \u47785 \u51088  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u50577  \u47924 \u47532 \u47484  \u49373 \u47749 \u49688  \u49368 \u51004 \u47196  \u51064 \u46020 \u54616 \u49888 \u45796 . \u49373 \u47749 \u45208 \u47924 \u45716  \u45804 \u47560 \u45796  \u44536  \u50676 \u47588 \u47484  \u47610 \u44256 , \u44536  \u51086 \u49324 \u44480 \u45716  \u47564 \u44397 \u51012  \u49548 \u49457 \u54616 \u44592  \u50948 \u54616 \u50668  \u51080 \u45796 . \u55128 \u47084  \u45796 \u54632 \u51060  \u50630 \u45716  \u44053 \u51008  \u49688 \u51221 \u44057 \u51060  \u47569 \u44256 , \u44536  \u44032 \u50640  \u51080 \u45716  \u45208 \u47924 \u46308 \u51008  \u44396 \u49549 \u48155 \u51008  \u51452 \u45784 \u51032  \u48177 \u49457 \u46308 \u51012  \u50948 \u54616 \u50668  \u51456 \u48708 \u46108  \u44600  \u50948 \u50640  \u44536  \u44536 \u47548 \u51088 \u47484  \u45912 \u51648 \u44256  \u51080 \u45796 . \u45331 \u51008  \u54217 \u50896 \u51060  \u50500 \u47492 \u45796 \u50868  \u50616 \u45909 \u51004 \u47196  \u46168 \u47084 \u49912 \u50668  \u51080 \u44256 , \u54616 \u45208 \u45784 \u51032  \u49328 \u46308 \u51008  \u45458 \u51008  \u48393 \u50864 \u47532 \u46308 \u51012  \u48855 \u44256  \u51080 \u45796 . \u51060  \u54217 \u54868 \u47196 \u50868  \u54217 \u50896 \u50640 \u49436 , \u51060  \u49373 \u47749  \u44053 \u44032 \u50640 \u49436 , \u50724 \u47019 \u46041 \u50504  \u49692 \u47168 \u51088 \u50836  \u48169 \u46993 \u51088 \u47196  \u49332 \u50500 \u50728  \u54616 \u45208 \u45784 \u51032  \u49324 \u46993 \u54616 \u45716  \u48177 \u49457 \u46308 \u51008  \u44536 \u46308 \u51060  \u44144 \u54624  \u51665 \u51012  \u48156 \u44204 \u54620 \u45796 .\
\'93\uc0\u45236  \u48177 \u49457 \u51060  \u54868 \u54217 \u54620  \u51665 \u44284  \u50504 \u51204 \u54620  \u44144 \u52376 \u50752  \u51312 \u50857 \u55176  \u49772 \u45716  \u44275 \u50640  \u51080 \u51004 \'94\u47532 \u46972 . \'93\u45796 \u49884 \u45716  \u44053 \u54252 \u54620  \u51068 \u51060  \u45348  \u46405 \u50640  \u46308 \u47532 \u51648  \u50506 \u51012  \u44163 \u51060 \u50836  \u54889 \u54224 \u50752  \u54028 \u47736 \u51060  \u45348  \u44221 \u45236 \u50640  \u45796 \u49884  \u50630 \u51012  \u44163 \u51060 \u47728  \u45348 \u44032  \u45348  \u49457 \u48317 \u51012  \u44396 \u50896 \u51060 \u46972 , \u45348  \u49457 \u47928 \u51012  \u52268 \u49569 \u51060 \u46972  \u52845 \u54624  \u44163 \u51060 \u46972 .\'94 \'93\u44536 \u46308 \u51060  \u44032 \u50725 \u51012  \u44148 \u52629 \u54616 \u44256  \u44536 \u44163 \u50640  \u44144 \u54616 \u44192 \u44256  \u54252 \u46020 \u50896 \u51012  \u51116 \u48176 \u54616 \u44256  \u50676 \u47588 \u47484  \u47673 \u51012  \u44163 \u51060 \u47728  \u44536 \u46308 \u51032  \u44148 \u52629 \u54620  \u45936  \u53440 \u51064 \u51060  \u44144 \u54616 \u51648  \u50500 \u45768 \u54624  \u44163 \u51060 \u47728  \u44536 \u46308 \u51032  \u51116 \u48176 \u54620  \u44163 \u51012  \u53440 \u51064 \u51060  \u47673 \u51648  \u50500 \u45768 \u54616 \u47532 \u45768 \'85\u45208 \u51032  \u53469 \u54620  \u51088 \u44032  \u44536  \u49552 \u51004 \u47196  \u51068 \u54620  \u44163 \u51012  \u44600 \u51060  \u45572 \u47540  \u44163 \u51076 \u51060 \'94 (\u49324  32:18, 60:18, 65:21, 22) \u46972 .\
\'93\uc0\u44305 \u50556 \u50752  \u47700 \u47560 \u47480  \u46405 \u51060  \u44592 \u48848 \u54616 \u47728  \u49324 \u47561 \u51060  \u48177 \u54633 \u54868 \u44057 \u51060  \u54588 \u50612  \u51600 \u44144 \u50892 \u54616 \u47728 \'94, \u51107 \u45208 \u47924 \u45716  \u44032 \u49884 \u45208 \u47924 \u47484  \u45824 \u49888 \u54616 \u50668  \u45208 \u47728  \u54868 \u49437 \u47448 \u45716  \u51656 \u47084 \u47484  \u45824 \u49888 \u54616 \u50668  \u45216  \u44163 \u51060 \u46972 \'94, \'93\u44536  \u46412 \u50640  \u51060 \u47532 \u44032  \u50612 \u47536 \u50577 \u44284  \u54632 \u44760  \u44144 \u54616 \u47728  \u54364 \u48276 \u51060  \u50612 \u47536  \u50684 \u49548 \u50752  \u54632 \u44760  \u45572 \u50864 \u47728  \u49569 \u50500 \u51648 \u50752  \u50612 \u47536  \u49324 \u51088 \u50752  \u49332 \u52240  \u51664 \u49849 \u51060  \u54632 \u44760  \u51080 \u50612  \u50612 \u47536 \u50500 \u51060 \u50640 \u44172  \u45132 \u47532 \u47728 \'94, \'93\u45208 \u51032  \u44144 \u47337 \u54620  \u49328  \u47784 \u46304  \u44275 \u50640 \u49436  \u54644 \u46120 \u46020  \u50630 \u44256  \u49345 \u54632 \u46020  \u50630 \u51012  \u44163 \u51060 \'94 (\u49324  35:1, 55:13, 11:6, 9) \u45796 .\
\uc0\u54616 \u45720 \u51032  \u48516 \u50948 \u44592  \u49549 \u50640 \u45716  \u44256 \u53685 \u51060  \u51316 \u51116 \u54624  \u49688  \u50630 \u45796 . \u44536  \u44275 \u50640 \u45716  \u45576 \u47932 \u51060  \u50630 \u44256 , \u51109 \u47168  \u54665 \u47148 \u51060  \u50630 \u44256 , \u49836 \u54548 \u51032  \u55124 \u51201 \u51060  \u50630 \u45796 . \'93\u45796 \u49884  \u49324 \u47581 \u51060  \u50630 \u44256  \u50528 \u53685 \u54616 \u45716  \u44163 \u51060 \u45208  \u44257 \u54616 \u45716  \u44163 \u51060 \u45208  \u50500 \u54536  \u44163 \u51060  \u45796 \u49884  \u51080 \u51648  \u50500 \u45768 \u54616 \u47532 \u45768  \u52376 \u51020  \u44163 \u46308 \u51060  \u45796  \u51648 \u45208 \u44052 \u51020 \u51060 \u47084 \u46972 \'94, \'93\u44536  \u44144 \u48124 \u51008  \u45236 \u44032  \u48337 \u46308 \u50632 \u45432 \u46972  \u54616 \u51648  \u50500 \u45768 \u54624  \u44163 \u51060 \u46972  \u44144 \u44592  \u44144 \u54616 \u45716  \u48177 \u49457 \u51060  \u49324 \u51396 \u54632 \u51012  \u48155 \u51004 \u47532 \u46972 \'94 (\u44228  21:4; \u49324  33:24).\
\pard\pardeftab720\sa319\partightenfactor0

\f0\b \cf0 \uc0\u49352  \u54616 \u45720 \u44284  \u49352  \u46405 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u44536  \u44275 \u50640 \u49436  \u50689 \u54868 \u47213 \u44172  \u46108  \u49352  \u46405 \u51032  \u49688 \u46020  \u49352  \u50696 \u47336 \u49332 \u47128 \u51008  \'93\u50668 \u54840 \u50752 \u51032  \u49552 \u51032  \u50500 \u47492 \u45796 \u50868  \u47732 \u47448 \u44288 , \u45348  \u54616 \u45208 \u45784 \u51032  \u49552 \u51032  \u50773 \u44288 \u51060  \u46112  \u44163 \u51060 \'94 (\u49324  62:3) \u45796 . \'93\u44536  \u49457 \u51032  \u48731 \u51060  \u51648 \u44537 \u55176  \u44480 \u54620  \u48372 \u49437  \u44057 \u44256  \u48317 \u50725 \u44284  \u49688 \u51221 \u44057 \u51060  \u47569 \u45908 \u46972 \'94 (\u44228  21:11). \'93\u47564 \u44397 \u51060  \u44536  \u48731  \u44032 \u50868 \u45936 \u47196  \u45796 \u45768 \u44256  \u46405 \u51032  \u50773 \u46308 \u51060  \u51088 \u44592  \u50689 \u44305 \u51012  \u44032 \u51648 \u44256  \u44536 \u47532 \u47196  \u46308 \u50612 \u50724 \u47532 \u46972 \'94 (\u44228  21:24). \u51452 \u45784 \u44760 \u49436 \u45716  \'93\u45236 \u44032  \u50696 \u47336 \u49332 \u47128 \u51012  \u51600 \u44144 \u50892 \u54616 \u47728  \u45208 \u51032  \u48177 \u49457 \u51012  \u44592 \u48848 \u54616 \u47532 \'94 (\u49324  65:19) \u46972 \u44256  \u47568 \u50432 \u54616 \u49888 \u45796 . \'93\u54616 \u45208 \u45784 \u51032  \u51109 \u47561 \u51060  \u49324 \u46988 \u46308 \u44284  \u54632 \u44760  \u51080 \u51004 \u47588  \u54616 \u45208 \u45784 \u51060  \u51200 \u55148 \u50752  \u54632 \u44760  \u44144 \u54616 \u49884 \u47532 \u45768  \u51200 \u55148 \u45716  \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u51060  \u46104 \u44256  \u54616 \u45208 \u45784 \u51008  \u52828 \u55176  \u51200 \u55148 \u50752  \u54632 \u44760  \u44228 \u49492 \u49436 \'94 (\u44228  21:3) \u51200 \u55148  \u54616 \u45208 \u45784 \u51060  \u46104 \u47532 \u46972 .\
\uc0\u54616 \u45208 \u45784 \u51032  \u49457 \u50640 \u45716  \'93\u48164 \u51060  \u50630 \'94\u45796 . \u50500 \u47924 \u46020  \u55092 \u49885 \u51012  \u54596 \u50836 \u47196  \u54616 \u44144 \u45208  \u50896 \u54616 \u51648  \u50506 \u51012  \u44163 \u51060 \u45796 . \u44144 \u44592 \u49436 \u45716  \u54616 \u45208 \u45784 \u51032  \u46907 \u51012  \u54665 \u54616 \u44256  \u44536 \u48516 \u51032  \u51060 \u47492 \u51012  \u52268 \u50577 \u54616 \u45716  \u45936  \u54588 \u44260 \u51012  \u45712 \u45180 \u51648  \u50506 \u51012  \u44163 \u51060 \u45796 . \u50864 \u47532 \u45716  \u49888 \u49440 \u54616 \u44256  \u50976 \u53132 \u54620  \u50500 \u52840 \u51032  \u44592 \u48516 \u51012  \u50616 \u51228 \u45208  \u45712 \u45188  \u44163 \u51060 \u45796 . \'93\u46321 \u48520 \u44284  \u54663 \u48731 \u51060  \u50424 \u45936 \u50630 \u51004 \u45768  \u51060 \u45716  \u51452  \u54616 \u45208 \u45784 \u51060  \u51200 \u55148 \u50640 \u44172  \u48708 \u52712 \u49900 \u51060 \u46972 \'94 (\u44228  22:5). \u44256 \u53685 \u49828 \u47084 \u50872  \u51221 \u46020 \u47196  \u45576 \u51060  \u48512 \u49892  \u51221 \u46020 \u45716  \u50500 \u45772  \u52268 \u46976 \u54620  \u48731 \u51060  \u53468 \u50577  \u44305 \u49440 \u51012  \u45824 \u49888 \u54624  \u44163 \u51060 \u45796 . \u44536 \u47084 \u45208  \u44536  \u44305 \u46020  (\u20809 \u24230 ) \u45716  \u50724 \u45720 \u45216 \u51032  \u51221 \u50724 \u51032  \u48157 \u51020 \u46020  \u48120 \u52824 \u51648  \u47803 \u54624  \u44163 \u51060 \u45796 . \u54616 \u45208 \u45784 \u44284  \u50612 \u47536 \u50577 \u51032  \u50689 \u44305 \u51060  \u44144 \u47337 \u54620  \u49457 \u51012  \u45130 \u51076 \u50630 \u51060  \u48708 \u52628 \u50612  \u51456 \u45796 . \u44396 \u49549 \u48155 \u51008  \u51088 \u46308 \u51008  \u53468 \u50577 \u51060  \u50630 \u51012 \u51648 \u46972 \u46020  \u50616 \u51228 \u45208  \u45230 \u51032  \u48731  \u44032 \u50868 \u45936 \u47196  \u45796 \u45776  \u44163 \u51060 \u45796 .\
\'93\uc0\u49457 \u50504 \u50640  \u49457 \u51204 \u51012  \u45236 \u44032  \u48372 \u51648  \u47803 \u54616 \u50688 \u51004 \u45768  \u51060 \u45716  \u51452  \u54616 \u45208 \u45784  \u44263  \u51204 \u45733 \u54616 \u49888  \u51060 \u50752  \u48143  \u50612 \u47536 \u50577 \u51060  \u44536  \u49457 \u51204 \u51060 \u49900 \u51060 \u46972 \'94 (\u44228  21:22). \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u46308 \u51008  \u50500 \u48260 \u51648  \u54616 \u45208 \u45784 \u44284  \u50500 \u46308  \u54616 \u45208 \u45784 \u51004 \u47196  \u45908 \u48520 \u50612  \u51088 \u50976 \u47213 \u44172  \u44368 \u53685 \u54616 \u45716  \u53945 \u44428 \u51012  \u50619 \u45716 \u45796 . \'93\u50864 \u47532 \u44032  \u51060 \u51228 \u45716  \u44144 \u50872 \u47196  \u48372 \u45716  \u44163 \u44057 \u51060  \u55148 \u48120 \u54616 \'94 (\u44256 \u51204  13:12) \u45796 . \u50864 \u47532 \u45716  \u54616 \u45208 \u45784 \u51032  \u54805 \u49345 \u51012  \u47560 \u52824  \u44144 \u50872  \u49549 \u50640  \u48708 \u52828  \u44163 \u52376 \u47100  \u52380 \u50672 \u44228  \u44032 \u50868 \u45936 \u49436 , \u46608 \u54620  \u44536 \u48516 \u44760 \u49436  \u51064 \u47448 \u47484  \u52712 \u44553 \u54616 \u49884 \u45716  \u51068 \u51012  \u53685 \u54616 \u50668  \u48148 \u46972 \u48376 \u45796 . \u44536 \u47084 \u45208  \u44536  \u46412 \u50640 \u45716  \u49324 \u51060 \u47484  \u44032 \u47196 \u47561 \u50500  \u45459 \u50520 \u45912  \u55148 \u48120 \u54620  \u55064 \u51109  \u50630 \u51060  \u54616 \u45208 \u45784 \u51012  \u51649 \u51217  \u45824 \u47732 \u54616 \u50668  \u48372 \u44172  \u46112  \u44163 \u51060 \u45796 . \'85\u50864 \u47532 \u45716  \u44536 \u48516  \u50526 \u50640  \u49436 \u49436  \u44536 \u48516 \u51032  \u50620 \u44404 \u51032  \u50689 \u44305 \u51012  \u51649 \u51217  \u48148 \u46972 \u48380  \u44163 \u51060 \u45796 .\
\uc0\u44144 \u44592 \u49436  \u44396 \u49549 \u48155 \u51008  \u49324 \u46988 \u46308 \u51008  \u51452 \u45784 \u44760 \u49436  \u44536 \u46308 \u51012  \u50500 \u49900 \u44057 \u51060  \u50508 \u44172  \u46112  \u44163 \u51060 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u52828 \u55176  \u49900 \u47161  \u49549 \u50640  \u49900 \u50612  \u51452 \u49888  \u49324 \u46993 \u44284  \u46041 \u51221 \u51008  \u44144 \u44592 \u49436  \u44032 \u51109  \u51652 \u49892 \u54616 \u44256  \u48512 \u46300 \u47101 \u44172  \u54876 \u50857 \u46112  \u44163 \u51060 \u45796 . \u44144 \u47337 \u54620  \u51088 \u46308 \u44284  \u45208 \u45572 \u45716  \u49692 \u44208 \u54620  \u44368 \u51228 , \u52629 \u48373 \u48155 \u51008  \u52380 \u49324 \u46308 \u44284  \u44536  \u50743 \u51012  \u50612 \u47536 \u50577 \u51032  \u54588 \u47196  \u50491 \u50612  \u55148 \u44172  \u54620  \u44033  \u49884 \u45824 \u51032  \u52649 \u49457 \u46108  \u51088 \u46308 \u44284 \u51032  \u51312 \u54868 \u47196 \u50868  \u49373 \u54876 , \'93\u54616 \u45720 \u44284  \u46405 \u50640  \u51080 \u45716  \u44033  \u51313 \u49549 \'94\u51012  \u54632 \u44760  \u44208 \u54633 \u49884 \u53412 \u45716  \u44144 \u47337 \u54620  \u50976 \u45824  \u44288 \u44228 , \u51060 \u44163 \u46308 \u51008  \u44396 \u49549 \u48155 \u51008  \u51088 \u46308 \u51032  \u54665 \u48373 \u51012  \u51060 \u47336 \u45716  \u50836 \u49548 \u46308 \u51060 \u45796 .\
\pard\pardeftab720\sa319\partightenfactor0

\f0\b \cf0 \uc0\u45824 \u51137 \u53804 \u51032  \u51333 \u44208 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u44144 \u44592 \u49436  \u51453 \u51648  \u50506 \u51012  \u53945 \u44428 \u51012  \u50619 \u51008  \u49324 \u46988 \u46308 \u51008  \u52285 \u51312 \u47141 \u51032  \u44221 \u51060 , \u49549 \u51396 \u50528  (\u36118 \u32618 \u24859 ) \u51032  \u50724 \u47896 \u47484  \u44208 \u53076  \u49324 \u46972 \u51648 \u51648  \u50506 \u51012  \u44592 \u49256 \u51004 \u47196  \u47749 \u49345 \u54620 \u45796 . \u54616 \u45208 \u45784 \u51012  \u46321 \u54620 \u55176  \u54616 \u46020 \u47197  \u50976 \u54841 \u54616 \u45912  \u51092 \u51064 \u54616 \u44256  \u44592 \u47564 \u51201 \u51064  \u50896 \u49688 \u45716  \u45908  \u51060 \u49345  \u50630 \u45796 . \u47784 \u46304  \u45733 \u47141 \u44284  \u51116 \u44036 \u51008  \u51613 \u44032 \u46104 \u44256  \u48156 \u45804 \u46108 \u45796 . \u51648 \u49885 \u51012  \u50619 \u45716  \u45936  \u46160 \u45516 \u44032  \u54588 \u47196 \u54644 \u51648 \u44144 \u45208  \u51221 \u47141 \u51060  \u49548 \u47784 \u46104 \u45716  \u51068 \u51060  \u50630 \u45796 . \u44032 \u51109  \u53360  \u44592 \u46020  (\u20225 \u22294 ) \u46020  \u49892 \u54665 \u46104 \u44256 , \u44032 \u51109  \u44256 \u49345 \u54620  \u54252 \u48512 \u46020  \u49457 \u52712 \u46104 \u47728 , \u44032 \u51109  \u45458 \u51008  \u55148 \u47581 \u46020  \u49892 \u54788 \u46112  \u44163 \u51060 \u45796 . \u44536 \u47092 \u51648 \u46972 \u46020  \u44144 \u44592 \u50640 \u45716  \u50668 \u51204 \u55176  \u51221 \u48373 \u54644 \u50556  \u54624  \u49352 \u47196 \u50868  \u45458 \u51008  \u48393 \u50864 \u47532 , \u44221 \u53444 \u54624  \u49688 \u48150 \u50640  \u50630 \u45716  \u49352 \u47196 \u50868  \u44221 \u51060 , \u51060 \u54644 \u54644 \u50556  \u54624  \u49352 \u47196 \u50868  \u51652 \u47532 , \u47560 \u51020 \u44284  \u47800 \u44284  \u50689 \u51032  \u45733 \u47141 \u51012  \u45796  \u44592 \u50872 \u51060 \u44172  \u54616 \u45716  \u49352 \u47196 \u50868  \u50672 \u44396  \u45824 \u49345 \u46308 \u51060  \u51080 \u44172  \u46108 \u45796 .\
\uc0\u50864 \u51452 \u51032  \u47784 \u46304  \u48372 \u54868 \u44032  \u44396 \u50896 \u48155 \u51008  \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u46308 \u51032  \u50672 \u44396  \u45824 \u49345 \u51004 \u47196  \u54204 \u52432 \u51652 \u45796 . \u51453 \u51020 \u51032  \u49549 \u48149 \u50640 \u49436  \u48279 \u50612 \u45212  \u44536 \u46308 \u51008  \u47680 \u47532  \u46504 \u50612 \u51652  \u45796 \u47480  \u49464 \u44228 \u46308 , \u44263  \u51064 \u44036 \u51032  \u48520 \u54665 \u51012  \u48372 \u44256  \u49836 \u54532 \u44172  \u53444 \u49885 \u54616 \u44256 , \u54620  \u50689 \u54844 \u51060  \u44396 \u50896 \u51012  \u48155 \u50520 \u45796 \u45716  \u49548 \u49885 \u51012  \u46307 \u44256 \u49436 \u45716  \u44592 \u49256 \u51032  \u45432 \u47000 \u47484  \u48512 \u47480 , \u45796 \u47480  \u49464 \u44228 \u46308 \u51012  \u54693 \u54616 \u50668  \u54588 \u44260 \u51012  \u47784 \u47476 \u45716  \u45216 \u44060 \u47484  \u54196 \u44256  \u45216 \u50500 \u44036 \u45796 . \u47568 \u47196  \u54364 \u54788 \u54624  \u49688  \u50630 \u45716  \u44592 \u49256 \u51004 \u47196  \u46405  \u50948 \u51032  \u51088 \u45376 \u46308 \u51008  \u53440 \u46973 \u54616 \u51648  \u50506 \u51008  \u45796 \u47480  \u49464 \u44228 \u51032  \u51452 \u48124 \u46308 \u51032  \u51648 \u54812 \u50752  \u44592 \u49256 \u51012  \u44057 \u51060  \u45208 \u45572 \u44172  \u46108 \u45796 . \u44536 \u46308 \u51008  \u50668 \u47084  \u49884 \u45824 \u50640  \u44152 \u52432  \u54616 \u45208 \u45784 \u51032  \u49564 \u50472 \u47484  \u47749 \u49345 \u54632 \u51004 \u47196  \u50619 \u51008  \u51648 \u49885 \u44284  \u51648 \u54812 \u51032  \u48372 \u54868 \u47484  \u44057 \u51060  \u45208 \u45576 \u45796 . \u44536 \u46308 \u51008  \u55120 \u47140 \u51648 \u51648  \u50506 \u51008  \u49884 \u47141 \u51004 \u47196  \u52285 \u51312 \u51032  \u50689 \u44305 , \u44263  \u48324 \u46308 \u44284  \u53468 \u50577 \u44228 \u46308 \u51060  \u47784 \u46160  \u44536 \u46308 \u50640 \u44172  \u51221 \u54644 \u51652  \u51068 \u51221 \u54620  \u44452 \u46020 \u47484  \u46384 \u46972  \u54616 \u45208 \u45784 \u51032  \u48372 \u51340 \u47484  \u46028 \u47532 \u44256  \u51080 \u45716  \u44163 \u51012  \u48372 \u44172  \u46108 \u45796 . \u44032 \u51109  \u51089 \u51008  \u44163 \u50640 \u49436 \u48512 \u53552  \u44032 \u51109  \u53360  \u44163 \u50640  \u51060 \u47476 \u44592 \u44620 \u51648  \u47564 \u47932  \u50948 \u50640 \u45716  \u52285 \u51312 \u51452 \u51032  \u51060 \u47492 \u51060  \u44592 \u47197 \u46104 \u44256 , \u47784 \u46304  \u44163 \u50640 \u45716  \u52285 \u51312 \u51452 \u51032  \u45733 \u47141 \u51060  \u54364 \u54788 \u46104 \u50612  \u51080 \u45796 .\
\uc0\u44536 \u47532 \u44256  \u50689 \u50896 \u54620  \u49464 \u50900 \u51060  \u55128 \u47084 \u44048 \u50640  \u46384 \u46972  \u54616 \u45208 \u45784 \u44284  \u44536 \u47532 \u49828 \u46020 \u50640  \u45824 \u54620  \u45908 \u50865  \u54413 \u49457 \u54616 \u44256  \u45908 \u50865  \u50689 \u44305 \u49828 \u47084 \u50868  \u44228 \u49884 \u44032  \u45208 \u53440 \u45212 \u45796 . \u46608 \u54620  \u51648 \u49885 \u51060  \u48156 \u51204 \u46104 \u50612  \u44048 \u50640  \u46384 \u46972  \u49324 \u46993 \u44284  \u51316 \u44221 \u44284  \u54665 \u48373 \u46020  \u51613 \u44032 \u46112  \u44163 \u51060 \u45796 . \u49324 \u46988 \u46308 \u51060  \u54616 \u45208 \u45784 \u50640  \u45824 \u54616 \u50668  \u48176 \u50864 \u47732  \u48176 \u50872 \u49688 \u47197  \u44536 \u48516 \u51032  \u54408 \u49457 \u50640  \u45824 \u54620  \u44536 \u46308 \u51032  \u44048 \u53444 \u51008  \u45908 \u50865  \u52964 \u51656  \u44163 \u51060 \u45796 . \u50696 \u49688 \u45784 \u44760 \u49436  \u44536 \u46308 \u50640 \u44172  \u49549 \u51396 \u51032  \u54413 \u49457 \u54620  \u48512 \u50752  \u49324 \u45800 \u44284 \u51032  \u45824 \u51137 \u53804 \u50640  \u51080 \u50612 \u49436 \u51032  \u45440 \u46972 \u50868  \u44208 \u44284 \u47484  \u51228 \u49884 \u54644  \u51452 \u49892  \u46412  \u44396 \u49549 \u48155 \u51008  \u51088 \u46308 \u51032  \u47560 \u51020 \u51008  \u45908 \u50865  \u50676 \u47148 \u54620  \u54732 \u49888 \u51032  \u47560 \u51020 \u51004 \u47196  \u44048 \u46041 \u46104 \u44256 , \u44536 \u46308 \u51008  \u45908 \u50865  \u52649 \u47564 \u54620  \u44592 \u49256 \u51004 \u47196  \u44552  \u44144 \u47928 \u44256 \u47484  \u53444 \u45796 . \u44536 \u47532 \u54616 \u50668  \u52380 \u52380 \u47564 \u47564 \u51032  \u47924 \u47532 \u45716  \u51020 \u49457 \u51012  \u54633 \u54616 \u50668  \u52268 \u50577 \u51032  \u45824 \u54633 \u52285 \u51012  \u54620 \u45796 .\
\'93\uc0\u45236 \u44032  \u46608  \u46308 \u51004 \u45768  \u54616 \u45720  \u50948 \u50640 \u50752  \u46405  \u50948 \u50640 \u50752  \u46405  \u50500 \u47000 \u50752  \u48148 \u45796  \u50948 \u50640 \u50752  \u46608  \u44536  \u44032 \u50868 \u45936  \u47784 \u46304  \u47564 \u47932 \u51060  \u44032 \u47196 \u46104  \u48372 \u51340 \u50640  \u50505 \u51004 \u49888  \u51060 \u50752  \u50612 \u47536 \u50577 \u50640 \u44172  \u52268 \u49569 \u44284  \u51316 \u44480 \u50752  \u50689 \u44305 \u44284  \u45733 \u47141 \u51012  \u49464 \u49464 \u53664 \u47197  \u46028 \u47540 \u51648 \u50612 \u45796 \'94 (\u44228  5:13).\
\uc0\u45824 \u51137 \u53804 \u45716  \u45149 \u45228 \u45796 . \u51396 \u50752  \u51396 \u51064 \u46308 \u51008  \u50630 \u50612 \u51276 \u45796 . \u50728  \u50864 \u51452 \u45716  \u44648 \u45143 \u54644 \u51276 \u45796 . \u50724 \u51649  \u51312 \u54868 \u50752  \u44592 \u49256 \u51032  \u47589 \u48149 \u47564 \u51060  \u50728  \u50864 \u51452 \u51032  \u47564 \u47932 \u51012  \u53685 \u54616 \u50668  \u44256 \u46041  (\u40723 \u21205 ) \u54620 \u45796 . \u49373 \u47749 \u44284  \u48731 \u44284  \u54872 \u55148 \u44032  \u47564 \u47932 \u51012  \u52285 \u51312 \u54616 \u49888  \u48516 \u50640 \u44172 \u49436  \u45149 \u50630 \u51060  \u45331 \u51008  \u50864 \u51452 \u47196  \u54140 \u51256 \u45208 \u44036 \u45796 . \u44032 \u51109  \u51089 \u51008  \u50896 \u51088  (\u21407 \u23376 ) \u47196 \u48512 \u53552  \u44032 \u51109  \u53360  \u49464 \u44228 \u50640  \u51060 \u47476 \u44592 \u44620 \u51648 , \u47564 \u47932 \u51008  \u49373 \u47932 \u44228 \u50752  \u47924 \u49373 \u47932 \u44228 \u47484  \u47561 \u47200 \u54616 \u44256  \u51312 \u44552 \u46020  \u55136 \u51060  \u50630 \u45716  \u50500 \u47492 \u45796 \u50880 \u44284  \u50756 \u51204 \u54620  \u44592 \u49256 \u51004 \u47196  \u54616 \u45208 \u45784 \u51008  \u49324 \u46993 \u51060 \u49884 \u46972 \u44256  \u49440 \u54252 \u54620 \u45796 .\
