\f1\b0 \cf0 \
\uc0\u45348 \u45916 \u46976 \u46300 \u50640 \u49436 \u45716  \u47588 \u50864  \u52488 \u44592 \u48512 \u53552  \u48277 \u50773 \u51032  \u54617 \u51221 \u50640  \u45824 \u54616 \u50668  \u45800 \u54840 \u54620  \u54637 \u51032 \u47484  \u54616 \u50688 \u45796 . \u47336 \u53552 \u51032  \u49884 \u45824  7\u48177  \u45380  \u51204 \u50640  \u44048 \u46021  \u46160  \u49324 \u46988 \u51060  \u47196 \u47560 \u50640  \u49324 \u51208 \u47196  \u54028 \u44204 \u46104 \u50612  \u48277 \u50773 \u52397 \u51032  \u45236 \u50857 \u51012  \u50508 \u44172  \u46104 \u51088  \u44536 \u46308 \u51008  \u46160 \u47140 \u50880  \u50630 \u51060  \u45796 \u51020 \u44284  \u44057 \u51060  \u47196 \u47560  \u48277 \u50773 \u51012  \u44508 \u53444 \u54616 \u50688 \u45796 . \'93\u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u44368 \u54924 \u47484  \u45817 \u49888 \u51032  \u50773 \u54980 \u50752  \u48176 \u50864 \u51088 \u47196  \u49340 \u51004 \u49884 \u44256 , \u44368 \u54924 \u51032  \u44032 \u51313 \u51012  \u50948 \u54616 \u50668  \u51316 \u44480 \u54616 \u44256  \u50689 \u50896 \u54620  \u44163 \u51012  \u44054 \u52628 \u50612  \u51452 \u49884 \u46104  \u49632 \u54616 \u51648  \u50506 \u44256  \u50025 \u51648  \u50506 \u45716  \u51116 \u45733 \u44284  \u54632 \u44760  \u50689 \u50896 \u54620  \u47732 \u47448 \u44288 \u44284  \u54848  (\u31503 ) \u51012  \u51452 \u49884 \u50632 \u45796 . \'85\u44536 \u47088 \u45936  \u44536 \u45824 \u45716  \u46020 \u46161 \u44284  \u44057 \u51060  \u44536 \u45824 \u50640 \u44172  \u50976 \u51061 \u51060  \u46104 \u45716  \u44163 \u51008  \u47784 \u46160  \u48764 \u50519 \u50520 \u45796 . \u44536 \u45824 \u45716  \u49828 \u49828 \u47196  \u54616 \u45208 \u45784 \u51060 \u46972  \u54616 \u50668  \u49457 \u51204 \u50640  \u51340 \u51221 \u54616 \u44256 , \u50577 \u51032  \u47785 \u51088 \u44032  \u46104 \u45716  \u45824 \u49888 \u50640  \u51060 \u47532 \u44032  \u46104 \u50632 \u45796 . \'85\u44536 \u45824 \u45716  \u52572 \u44256  \u44048 \u46021 \u51064  \u44163 \u52376 \u47100  \u50864 \u47532 \u50640 \u44172  \u54869 \u49888 \u51012  \u51452 \u44256 \u51088  \u54616 \u45208  \u49892 \u49345 \u51008  \u54253 \u44400 \u44284  \u44057 \u51060  \u54665 \u46041 \u54620 \u45796 . \'85\u44536 \u45824  \u49828 \u49828 \u47196 \u44032  \u47568 \u54616 \u45716  \u48148 \u50752  \u44057 \u51060  \u44536 \u45824 \u45716  \u51333 \u51032  \u51333 \u51060  \u46104 \u50612 \u50556  \u47560 \u46405 \u54620 \u45936  \u46020 \u47532 \u50612  \u51452 \u51032  \u51452 \u44032  \u46104 \u44256 \u51088  \u50528 \u50416 \u44256  \u51080 \u45796 . \'85\u44536 \u45824 \u45716  \u54616 \u45208 \u45784 \u51032  \u47749 \u47161 \u51012  \u47736 \u49884 \u54616 \u44256  \u51080 \u45796 . \u50728  \u49464 \u49345 \u50640  \u55145 \u50612 \u51256  \u51080 \u45716  \u47784 \u46304  \u44368 \u54924 \u51032  \u49444 \u47549 \u51088 \u45716  \u49457 \u47161 \u51060 \u49884 \u45796 . \u50864 \u47532 \u44032  \u49884 \u48124 \u51004 \u47196  \u49549 \u54620  \u54616 \u45208 \u45784 \u51032  \u46020 \u49457 \u51008  \u54616 \u45720 \u51032  \u51204 \u50669  (\u20840 \u22495 ) \u51060  \u45796  \u54252 \u54632 \u46104 \u50612  \u51080 \u45796 . \u44536 \u47532 \u44256  \u44536 \u44163 \u51008  \u44144 \u47337 \u54620  \u49440 \u51648 \u51088 \u46308 \u51060  \u48148 \u48296 \u47200 \u51060 \u46972 \u44256  \u48512 \u47480  \u46020 \u49457 , \u44263  \u51088 \u44592 \u47484  \u54616 \u45208 \u45784 \u51032  \u46020 \u49457 \u51064  \u44163 \u52376 \u47100  \u45208 \u53440 \u45236 \u44256  \u51088 \u44592 \u47196  \u47568 \u48120 \u50516 \u50500  \u52380 \u44397 \u51012  \u50619 \u45716 \u45796  \u54616 \u44256  \u44536  \u51648 \u54812 \u44032  \u50689 \u50896 \u54620  \u44163 \u51060 \u46972 \u44256  \u51088 \u46993 \u54616 \u50688 \u51012  \u49104 \u47564  \u50500 \u45768 \u46972  \u50500 \u47924 \u47088  \u51060 \u50976 \u46020  \u50630 \u51060  \u44144 \u44592 \u50640 \u45716  \u50724 \u47448 \u46020  \u50630 \u44256  \u44284 \u50724 \u46020  \u51080 \u51012  \u49688  \u50630 \u45796 \u44256  \u51452 \u51109 \u54616 \u45716  \u44536  \u48148 \u48296 \u47200 \u48372 \u45796  \u55016 \u50476  \u45908  \u50948 \u45824 \u54620  \u46020 \u49457 \u51060 \u45796 \'94 (Gerard Brandt, History of the Reformation in and About the Low Countries, b.1, p.6).\
\uc0\u44033  \u49884 \u45824 \u47484  \u53685 \u54616 \u50668  \u49324 \u46988 \u46308 \u51060  \u51068 \u50612 \u45208 \u49436  \u44536 \u50752  \u44057 \u51008  \u54637 \u51032 \u47484  \u51228 \u44592 \u54616 \u50688 \u45796 . \u44033  \u51648 \u48169 \u51004 \u47196  \u46028 \u50500 \u45796 \u45768 \u47732 \u49436  \u50668 \u47084  \u44032 \u51648  \u51060 \u47492 \u51004 \u47196  \u50508 \u47140 \u51652  \u44536  \u52488 \u44592 \u51032  \u44368 \u49324 \u46308 \u51008  \u50760 \u45940 \u49828 \u51064 \u51032  \u53945 \u51669 \u51012  \u48156 \u55064 \u54616 \u50688 \u44256 , \u50612 \u46356 \u50640 \u45208  \u51204 \u54028 \u46104 \u50612  \u51080 \u45912  \u48373 \u51020 \u51032  \u51648 \u49885 \u51012  \u45348 \u45916 \u46976 \u46300 \u50640 \u46020  \u48372 \u44553 \u49884 \u53040 \u45796 . \u44536 \u46308 \u51032  \u44368 \u54984 \u51008  \u47588 \u50864  \u49888 \u49549 \u55176  \u54869 \u49328 \u46104 \u50632 \u45796 . \u46608  \u44536 \u46308 \u51008  \u50760 \u45940 \u49828 \u51064 \u51060  \u48264 \u50669 \u54620  \u49457 \u44221 \u51012  \u45348 \u45916 \u46976 \u46300 \u50612 \u47196  \u48264 \u50669 \u54616 \u50688 \u45796 . \u44536 \u47532 \u44256  \u44536 \u46308 \u51008  \'93\u51060  \u49457 \u44221 \u51008  \u47588 \u50864  \u53360  \u50976 \u51061 \u51012  \u51452 \u45716  \u44163 \u51060 \u45796 . \u44144 \u44592 \u50640 \u45716  \u45453 \u45812 \u44284  \u50864 \u54868 \u50752  \u44144 \u51667 \u44284  \u52380 \u48149 \u54620  \u47568  \u46321 \u51008  \u51204 \u54784  \u50630 \u44256  \u45796 \u47564  \u51652 \u47532 \u51032  \u47568 \u50432 \u47564  \u51080 \u45796 . \u47932 \u47200  \u44169 \u51004 \u47196  \u48372 \u47732  \u50668 \u44592 \u51200 \u44592 \u50640  \u50508 \u44592  \u50612 \u47140 \u50868  \u44163 \u46308 \u46020  \u51080 \u51004 \u45208 , \u49440 \u54616 \u44256  \u44144 \u47337 \u54620  \u44536  \u44264 \u51088 \u50752  \u50500 \u47492 \u45796 \u50880 \u51008  \u49789 \u44172  \u48156 \u44204 \u46112  \u44163 \u51060 \u45796 \'94 (Gerard Brandt, History of the Reformation in and About the Low Countries, b.1, p.14) \u46972 \u44256  \u47568 \u54616 \u50688 \u45796 . \u50715 \u45216 \u51032  \u49888 \u50521 \u51032  \u52828 \u44396 \u46308 \u51008  12\u49464 \u44592 \u50640  \u51060 \u47111 \u44172  \u44592 \u47197 \u54616 \u50688 \u45912  \u44163 \u51060 \u45796 .\
\uc0\u51060 \u51228  \u47196 \u47560 \u44368 \u51032  \u48149 \u54644 \u44032  \u49884 \u51089 \u46104 \u50632 \u45796 . \u44536 \u47084 \u45208  \u54868 \u54805 \u44284  \u44256 \u47928 \u51060  \u46104 \u54400 \u51060 \u46104 \u45716  \u51473 \u50640 \u49436  \u49888 \u51088 \u51032  \u49688 \u45716  \u44228 \u49549 \u54644 \u49436  \u51613 \u44032 \u46104 \u50632 \u45796 . \u44536 \u47532 \u44256  \u49888 \u50521 \u50640  \u51080 \u50612 \u49436 \u45716  \u50724 \u51649  \u49457 \u44221 \u47564 \u51060  \u44536 \u47495 \u46120 \u51060  \u50630 \u45716  \u44428 \u50948 \u47484  \u44032 \u51648 \u44256  \u51080 \u45796 \u45716  \u44163 \u44284  \'93\u49324 \u46988 \u51008  \u48127 \u46020 \u47197  \u44053 \u50836 \u48155 \u50500 \u49436 \u45716  \u50504  \u46104 \u47728  \u48373 \u51020  \u51204 \u46020 \u47196  \u50619 \u50612 \u50556  \u54620 \u45796 \'94 (Martyn, vol.2, p.87) \u44256  \u54869 \u44256 \u54616 \u44172  \u51452 \u51109 \u46104 \u50632 \u45796 .\
