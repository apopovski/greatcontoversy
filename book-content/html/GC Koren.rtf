\f0\b \cf0 \uc0\u54889 \u51228  \u50526 \u50640 \u49436  \u49888 \u50521 \u51012  \u44256 \u48177 \u54632 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u44536 \u44032  \u46160  \u48264 \u51704  \u51032 \u54924 \u50640  \u49456 \u51012  \u46412 \u50640  \u44536 \u51032  \u50620 \u44404 \u50640 \u45716  \u50500 \u47924 \u47088  \u44277 \u54252 \u50752  \u45212 \u52376 \u54620  \u44592 \u49353 \u51060  \u48372 \u51060 \u51648  \u50500 \u45768 \u54616 \u50688 \u45796 . \u44536 \u45716  \u51312 \u50857 \u54616 \u44256 , \u54217 \u54868 \u47213 \u44256 , \u44536 \u47084 \u47732 \u49436 \u46020  \u44537 \u55176  \u50857 \u44048 \u54616 \u44256  \u51032 \u44592 \u50577 \u50577 \u54616 \u44172  \u54616 \u45208 \u45784 \u51032  \u51613 \u51064 \u51004 \u47196 \u49436  \u51648 \u49345 \u51032  \u49464 \u46020  \u51080 \u45716  \u44256 \u44288 \u46308  \u50526 \u50640  \u49456 \u45796 . \u44536  \u46412 \u50640  \u54889 \u49892 \u51032  \u44288 \u47532 \u45716  \u44536 \u50640 \u44172  \u51088 \u44592 \u51032  \u51452 \u51109 \u51012  \u52712 \u49548 \u54616 \u44256 \u51088  \u44208 \u51221 \u54664 \u45716 \u51648  \u47932 \u50612  \u48372 \u50520 \u45796 . \u47336 \u53552 \u45716  \u52840 \u52265 \u54616 \u44256 , \u44216 \u49552 \u54616 \u44256 , \u50500 \u47924 \u47088  \u44201 \u47148 \u54620  \u44048 \u51221 \u51060  \u49438 \u51060 \u51648  \u50500 \u45768 \u54620  \u50612 \u51312 \u47196  \u45824 \u45813 \u54616 \u50688 \u45796 . \u44536 \u51032  \u53468 \u46020 \u45716  \u44216 \u49552 \u54616 \u44256  \u51316 \u44221 \u54624  \u47564 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u51032 \u54924 \u44032  \u45440 \u46972 \u51648  \u50506 \u51012  \u49688  \u50630 \u51012  \u47564 \u53372  \u54616 \u45208 \u45784 \u44760  \u45824 \u54620  \u49888 \u47280 \u50752  \u44592 \u49256 \u51012  \u45208 \u53440 \u45256 \u45796 .\
\'93\uc0\u51648 \u44537 \u55176  \u51316 \u50628 \u54616 \u49888  \u54224 \u54616 \u50668 ! \u44256 \u44480 \u54616 \u49888  \u50773 \u54980  (\u29579 \u20399 ) \u46308 \u44284  \u51064 \u51088 \u54616 \u49888  \u50689 \u51452  (\u63924 \u20027 ) \u46308 \u51060 \u50668 ! \u50724 \u45720  \u48376 \u51064 \u51060  \u50668 \u44592  \u52636 \u51221  (\u20986 \u24311 ) \u54616 \u44172  \u46108  \u44163 \u51008  \u50612 \u51228  \u48516 \u48512 \u54616 \u49888  \u47749 \u47161 \u50640  \u46384 \u46972  \u45208 \u50728  \u44163 \u51077 \u45768 \u45796 . \u54616 \u45208 \u45784 \u51032  \u44557 \u55100 \u51012  \u55192 \u51077 \u50612  \u48376 \u51064 \u51008  \u51316 \u50628 \u54616 \u49888  \u54224 \u54616 \u50752  \u50668 \u44592  \u50676 \u49437 \u54616 \u49888  \u51204 \u54616  \u51228 \u50948 \u44760 \u49436  \u48376 \u51064 \u51060  \u51032 \u47213 \u44256  \u51652 \u49892 \u54616 \u45796 \u44256  \u54869 \u49888 \u54616 \u44256  \u51080 \u45716  \u49324 \u50629 \u50640  \u45824 \u54616 \u50668  \u48320 \u54840 \u54616 \u45716  \u47568 \u51012  \u53945 \u48324 \u54616 \u49888  \u49324 \u46993 \u51004 \u47196  \u46308 \u50612 \u51452 \u49884 \u44592 \u47484  \u44036 \u50896 \u54616 \u45208 \u51060 \u45796 . \u44536 \u47532 \u44256  \u48376 \u51064 \u51032  \u47924 \u51648 \u47196  \u51064 \u54616 \u50668  \u44417 \u51221 \u51032  \u44288 \u47168 \u45208  \u50696 \u48277 \u51012  \u48276 \u54616 \u45716  \u51068 \u51060  \u51080 \u51012 \u51648 \u46972 \u46020  \u45320 \u44536 \u47084 \u51060  \u50857 \u49436 \u54616 \u50668  \u51452 \u49884 \u44592 \u47484  \u53444 \u50896 \u54616 \u45716  \u48148 \u51077 \u45768 \u45796 . \u48376 \u51064 \u51008  \u49849 \u50896 \u50640  \u47931 \u55176 \u50612  \u51080 \u50632 \u51012  \u49104 \u51060 \u47728  \u44417 \u51221 \u50640  \u45208 \u50500 \u44032  \u48376  \u51068 \u51060  \u50630 \u44592  \u46412 \u47928 \u51077 \u45768 \u45796 \'94 (D\'92Aubigne, b.7, ch.8).\
\uc0\u51060 \u50752  \u44057 \u51060  \u47568 \u54620  \u45796 \u51020 \u50640  \u44536 \u45716  \u51656 \u47928 \u50640  \u44288 \u54616 \u50668 , \u51088 \u44592 \u51032  \u51200 \u49436 \u46308 \u51008  \u47784 \u46160 \u44032  \u46041 \u51068 \u54620  \u48512 \u47448 \u51032  \u44163 \u51060  \u50500 \u45768 \u46972 \u44256  \u47568 \u54616 \u50688 \u45796 . \u52395 \u51704  \u48512 \u47448 \u45716  \u49888 \u50521 \u44284  \u49440 \u54665 \u50640  \u45824 \u54616 \u50668  \u44592 \u47197 \u54620  \u44163 \u51004 \u47196 , \u51060 \u44163 \u51008  \u44536 \u51032  \u50896 \u49688 \u46308 \u44620 \u51648 \u46020  \u54644 \u47196 \u50868  \u44163 \u51060  \u50500 \u45776  \u49104 \u47564  \u50500 \u45768 \u46972  \u50724 \u55176 \u47140  \u50976 \u51061 \u54620  \u44163 \u46308 \u47196  \u52712 \u44553 \u54616 \u50688 \u45796 . \u51060 \u47088  \u51200 \u49436 \u46308 \u51012  \u52712 \u49548 \u54616 \u45716  \u44163 \u51008  \u47564 \u51064 \u51060  \u51064 \u51221 \u54616 \u45716  \u51652 \u47532 \u47484  \u48512 \u51064 \u54616 \u45716  \u51068 \u51060  \u46112  \u44163 \u51060 \u50632 \u45796 . \u46168 \u51704  \u48512 \u47448 \u51032  \u44163 \u51008  \u48277 \u50773 \u44368 \u51032  \u48512 \u54056 \u50752  \u45208 \u49244  \u54224 \u45800 \u51012  \u54253 \u47196 \u54616 \u45716  \u51200 \u49436 \u46308 \u47196  \u51060 \u47336 \u50612 \u51276 \u45796 . \u51060 \u47088  \u51200 \u49436 \u46308 \u51012  \u54224 \u44592  (\u24290 \u26820 ) \u54616 \u45716  \u44163 \u51008  \u47196 \u47560 \u51032  \u54252 \u50501 \u51012  \u54620 \u52789  \u45908  \u51312 \u51109  (\u21161 \u38263 ) \u54616 \u50668  \u45908 \u50865  \u49900 \u54620  \u48520 \u44221 \u44148 \u51012  \u47582 \u51060 \u54616 \u44592  \u50948 \u54616 \u50668  \u47928 \u51012  \u45331 \u44172  \u50668 \u45716  \u44163 \u51060  \u46112  \u44163 \u51060 \u50632 \u45796 . \u49483 \u51704  \u48512 \u47448 \u51032  \u51200 \u49436 \u50640 \u49436  \u44536 \u45716  \u54788 \u51316 \u54620  \u50501 \u54224  (\u24801 \u24163 ) \u47484  \u50745 \u54840 \u54620  \u44060 \u51064 \u46308 \u51012  \u44277 \u44201 \u54616 \u50688 \u45796 . \u44536 \u47088  \u48512 \u47448 \u51032  \u51200 \u49436 \u50640  \u44288 \u54616 \u50668  \u44536 \u45716  \u44536  \u45236 \u50857 \u51060  \u44284 \u44201 \u54620  \u51216 \u51060  \u51080 \u51004 \u47728 , \u51096 \u47803 \u46108  \u51216 \u51060  \u51204 \u50672  \u50630 \u45796 \u44256  \u45800 \u51221 \u54624  \u49688 \u45716  \u50630 \u51020 \u51012  \u49556 \u51649 \u55176  \u44256 \u48177 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u51060 \u47088  \u51333 \u47448 \u51032  \u51200 \u49436 \u46308 \u46020  \u52712 \u49548 \u54624  \u49688  \u50630 \u50632 \u45796 . \u50780 \u45264 \u54616 \u47732  \u47564 \u51068  \u44536 \u47111 \u44172  \u54616 \u47732 , \u51652 \u47532 \u51032  \u50896 \u49688 \u46308 \u51008  \u54620 \u52789  \u45908  \u50756 \u44053 \u54616 \u44172  \u46104 \u50612  \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u51012  \u45908 \u50865  \u51092 \u51064 \u54616 \u44172  \u52712 \u44553 \u54624  \u50684 \u47140 \u44032  \u51080 \u50632 \u44592  \u46412 \u47928 \u51060 \u50632 \u45796 .\
\uc0\u44536 \u45716  \u44228 \u49549 \u54616 \u50668  \u47568 \u54616 \u50688 \u45796 . \'93\u44536 \u47111 \u51648 \u47564  \u45208 \u45716  \u45796 \u47564  \u54620  \u49324 \u46988 \u51032  \u51064 \u44036 \u51060 \u50836  \u54616 \u45208 \u45784 \u51060  \u50500 \u45785 \u45768 \u45796 . \u44536 \u47084 \u48064 \u47196  \u45208 \u45716  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u54665 \u54616 \u49888  \u44163 \u52376 \u47100  \u45208 \u51032  \u47568 \u51060  \u47564 \u51068  \u50501 \u54616 \u47732  \u44536  \u50501 \u54620  \u49324 \u49892 \u51012  \u51613 \u44144 \u54644  \u45804 \u46972 \u44256  \u45236  \u51088 \u49888 \u51012  \u48320 \u54840 \u54633 \u45768 \u45796 . \'85\u54616 \u45208 \u45784 \u51032  \u51088 \u48708 \u47484  \u55192 \u51077 \u50612  \u45208 \u45716  \u51648 \u51316 \u54616 \u49888  \u54889 \u51228 \u50752  \u51064 \u51088 \u54616 \u49888  \u50773 \u54980  (\u29579 \u20399 ) \u46308 \u44284  \u47784 \u46304  \u44256 \u44288  \u51228 \u50948 \u50640 \u44172  \u49324 \u46020 \u46308 \u44284  \u49440 \u51648 \u51088 \u46308 \u51032  \u44544 \u47196 \u50024  \u48376 \u51064 \u51032  \u51096 \u47803 \u51012  \u51648 \u51201 \u54616 \u50668  \u45804 \u46972 \u44256  \u44036 \u50896 \u54616 \u45716  \u48148 \u51077 \u45768 \u45796 . \u44536 \u50752  \u44057 \u51060  \u54616 \u50668  \u48376 \u51064 \u51032  \u51096 \u47803 \u51012  \u44648 \u45803 \u44172  \u46104 \u47732  \u45208 \u51032  \u47784 \u46304  \u50724 \u47448 \u47484  \u51593 \u49884  \u52712 \u49548 \u54616 \u44192 \u49845 \u45768 \u45796 . \u44536 \u47532 \u44256  \u48376 \u51064 \u51060  \u51088 \u51652 \u54644 \u49436  \u51200 \u51032  \u51200 \u49436 \u46308 \u51012  \u48520  \u44032 \u50868 \u45936  \u45912 \u51256  \u48260 \u47532 \u44192 \u49845 \u45768 \u45796 .\
\uc0\u48376 \u51064 \u51060  \u51648 \u44552  \u47749 \u48177 \u55176  \u51652 \u49696 \u54620  \u44163 \u51008  \u48376 \u51064  \u51088 \u49888 \u51060  \u54788 \u51116  \u45817 \u47732 \u54616 \u44256  \u51080 \u45716  \u50948 \u54744 \u50640  \u45824 \u54616 \u50668  \u51312 \u49900 \u49457  \u51080 \u44172  \u54756 \u50500 \u47140  \u48372 \u44256  \u49373 \u44033 \u54620  \u50672 \u54980 \u50640  \u51652 \u49696 \u54620  \u44163 \u51076 \u51012  \u50508 \u50500 \u51452 \u49884 \u44592  \u48148 \u46989 \u45768 \u45796 . \u44536 \u47084 \u45208  \u48376 \u51064 \u51008  \u50724 \u45720 \u45216  \u48373 \u51020 \u51060  \u50715 \u45216 \u44284  \u47560 \u52268 \u44032 \u51648 \u47196  \u47932 \u51032  (\u29289 \u35696 ) \u50752  \u48516 \u51137 \u51032  \u50896 \u51064 \u51060  \u46104 \u45716  \u44163 \u51012  \u46160 \u47140 \u50892 \u54616 \u51648  \u50500 \u45768 \u54616 \u44256  \u46020 \u47532 \u50612  \u44592 \u49240 \u44172  \u50668 \u44592 \u45716  \u48148 \u51077 \u45768 \u45796 . \u51060 \u44163 \u51008  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51060  \u44032 \u51652  \u53945 \u49457 \u51004 \u47196  \u48380  \u46412  \u54596 \u50672 \u51201 \u51064  \u51068 \u51077 \u45768 \u45796 . \'91\u45236 \u44032  \u49464 \u49345 \u50640  \u54868 \u54217 \u51012  \u51452 \u47084 \u50728  \u51460 \u47196  \u49373 \u44033 \u51648  \u47568 \u46972  \u54868 \u54217 \u51060  \u50500 \u45768 \u46972  \u44160 \u51012  \u51452 \u47084  \u50772 \u45432 \u46972 \'92 (\u47560  10:34) \u44256  \u50696 \u49688  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u47568 \u50432 \u54616 \u49512 \u49845 \u45768 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u45440 \u46989 \u44256 \u46020  \u46160 \u47140 \u50868  \u44428 \u44256 \u47484  \u54616 \u44256  \u44228 \u49901 \u45768 \u45796 . \u50864 \u47532 \u45716  \u48516 \u51137 \u51012  \u47688 \u52628 \u47140 \u44256  \u54632 \u51004 \u47196  \u46020 \u47532 \u50612  \u44144 \u47337 \u54620  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51012  \u54605 \u48149 \u54616 \u44172  \u46104 \u44256 , \u50864 \u47532  \u51088 \u49888 \u50640 \u44172  \u44204 \u46364  \u49688  \u50630 \u45716  \u50948 \u54744 \u44284  \u54788 \u49464 \u51032  \u48520 \u54665 \u44284  \u50689 \u50896 \u54620  \u47736 \u47581 \u51012  \u44032 \u51256 \u50724 \u45716  \u44208 \u44284 \u47484  \u52488 \u47000 \u54624 \u44620  \u44221 \u44228 \u54644 \u50556 \u44192 \u49845 \u45768 \u45796 . \'85\u48376 \u51064 \u51008  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u50640 \u49436  \u47566 \u51008  \u49892 \u47168 \u47484  \u46308  \u49688  \u51080 \u49845 \u45768 \u45796 . \u48148 \u47196 \u50752  \u48148 \u48296 \u47200 \u51032  \u51076 \u44552 \u46308 \u44284  \u51060 \u49828 \u46972 \u50648 \u51032  \u51076 \u44552 \u46308 \u51060  \u44536 \u46308 \u51032  \u45208 \u46972 \u47484  \u50808 \u44288 \u49345 \u51004 \u47196  \u44032 \u51109  \u51648 \u54812 \u47213 \u44256  \u44053 \u54616 \u44172  \u47564 \u46308  \u49688  \u51080 \u51012  \u44163 \u52376 \u47100  \u48372 \u51060 \u45716  \u44428 \u47732 \u51012  \u46384 \u46972  \u45432 \u47141 \u54616 \u50688 \u51012  \u46412 \u48372 \u45796  \u45908 \u50865  \u44536 \u46308  \u51088 \u49888 \u51032  \u47736 \u47581 \u51012  \u54952 \u44284 \u51201 \u51004 \u47196  \u52488 \u47000 \u54664 \u45912  \u51201 \u51008  \u50630 \u50632 \u45796 \u45716  \u44163 \u51012  \u45208 \u45716  \u47568 \u54624  \u49688  \u51080 \u49845 \u45768 \u45796 . \'91\u54616 \u45208 \u45784 \u44760 \u49436  \u49328 \u46308 \u51012  \u50734 \u44592 \u49892 \u51648 \u46972 \u46020  \u49328 \u46308 \u51008  \u44648 \u45803 \u51648  \u47803 \u54616 \u45716  \u44163 \u51077 \u45768 \u45796 \'92\'94 (D\'92Aubigne, b.7, ch.8).\
