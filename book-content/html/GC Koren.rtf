\uc0\u49549 \u51060 \u45716  \u51068 \u50640  \u50724 \u47004  \u44221 \u54744 \u51012  \u44032 \u51652  \u50516 \u55121 \u51032  \u50773 \u51008  \u50728 \u44054  \u48512 \u47448 \u50752  \u49345 \u54889  \u49549 \u50640  \u51080 \u45716  \u49324 \u46988 \u46308 \u51012  \u44368 \u54876 \u54616 \u44172  \u49884 \u54744 \u54620 \u45796 . \u44536 \u45716  \u44368 \u50577  \u51080 \u44256  \u49464 \u47144 \u46108  \u49324 \u46988 \u46308 \u50640 \u44172  \u44053 \u49888 \u49696 \u51012  \u44537 \u55176  \u49464 \u47144 \u46108  \u51648 \u51201  \u48169 \u47732 \u50640 \u49436  \u51228 \u49884 \u54632 \u51004 \u47196  \u47566 \u51008  \u49324 \u46988 \u51012  \u51088 \u49888 \u51032  \u50732 \u47924 \u50640  \u44152 \u47140 \u46308 \u44172  \u54616 \u45716  \u45936  \u49457 \u44277 \u51012  \u44144 \u46164 \u45796 . \u44053 \u49888 \u49696 \u51060  \u51452 \u45716  \u51648 \u54812 \u45716  \u51060 \u48120  \u49324 \u46020  \u50556 \u44256 \u48372 \u47196  \u47568 \u48120 \u50516 \u50500  \u44592 \u47197 \u46104 \u50612  \u51080 \u45796 . \u44536 \u44163 \u51008  \'93\u50948 \u47196 \u48512 \u53552  \u45236 \u47140 \u50728  \u44163 \u51060  \u50500 \u45768 \u50836  \u49464 \u49345 \u51201 \u51060 \u50836  \u51221 \u50837 \u51201 \u51060 \u50836  \u47560 \u44480 \u51201 \u51060 \'94 (\u50557  3:15) \u45796 . \u44536 \u47084 \u45208  \u44536  \u53360  \u44592 \u47564 \u51088 \u45716  \u51060 \u47084 \u54620  \u51008 \u45769  (\u38577 \u21311 ) \u51012  \u51088 \u44592 \u51032  \u47785 \u51201  \u45804 \u49457 \u50640  \u44032 \u51109  \u51096  \u47582 \u46020 \u47197  \u44048 \u52632 \u45796 . \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u44305 \u50556 \u50640 \u49436  \u49884 \u54744 \u48155 \u51004 \u49892  \u46412  \u52268 \u46976 \u54620  \u54616 \u45720  \u52380 \u49324 \u51032  \u47784 \u50577 \u51004 \u47196  \u45208 \u53440 \u45228 \u45912  \u44536 \u45716  \u48731 \u45208 \u45716  \u52380 \u49324 \u52376 \u47100  \u44537 \u55176  \u47588 \u47141 \u51201 \u51064  \u51088 \u53468 \u47196  \u49324 \u46988 \u46308 \u50640 \u44172  \u45208 \u53440 \u45212 \u45796 . \u44536 \u45716  \u44256 \u49345 \u54620  \u51452 \u51228 \u47484  \u51228 \u49884 \u54632 \u51004 \u47196  \u49324 \u46988 \u46308 \u51032  \u51060 \u49457 \u50640  \u54840 \u49548 \u54620 \u45796 . \u44536 \u45716  \u54889 \u54848 \u54620  \u51109 \u47732 \u51012  \u45208 \u53440 \u45236 \u45716  \u54872 \u49345 \u51012  \u51339 \u50500 \u54620 \u45796 . \u44536 \u45716  \u49324 \u46993 \u44284  \u51088 \u48708 \u50640  \u44288 \u54620  \u50885 \u48320 \u51201  \u47896 \u49324 \u47484  \u53685 \u54616 \u50668  \u49324 \u46988 \u46308 \u51032  \u50528 \u51221 \u51012  \u51060 \u45128 \u45796 . \u44536 \u45716  \u49324 \u46988 \u46308 \u51032  \u49345 \u49345 \u47141 \u51012  \u53356 \u44172  \u48708 \u50557 \u49884 \u53412 \u46020 \u47197  \u51088 \u44537 \u54616 \u44256 , \u44536 \u46308 \u51060  \u44032 \u51652  \u51648 \u54812 \u47484  \u51088 \u46993 \u54616 \u44172  \u54616 \u50668  \u44208 \u44397  \u44536 \u46308 \u51032  \u47560 \u51020 \u51004 \u47196  \u50689 \u50896 \u54616 \u49888  \u48516 \u51012  \u47736 \u49884 \u54616 \u44172  \u47564 \u46304 \u45796 . \u44396 \u51452 \u47484  \u49900 \u55176  \u45458 \u51008  \u49328 \u51004 \u47196  \u51064 \u46020 \u54616 \u50668  \u49464 \u49345 \u51032  \u47784 \u46304  \u45208 \u46972 \u50752  \u44536  \u50689 \u54868 \u47484  \u48372 \u50668  \u51460  \u49688  \u51080 \u50632 \u45912  \u44536 \u45716  \u54616 \u45208 \u45784 \u51032  \u45733 \u47141 \u51004 \u47196  \u48372 \u54840 \u47484  \u48155 \u51648  \u50506 \u45716  \u47784 \u46304  \u49324 \u46988 \u46308 \u51032  \u44048 \u44033 \u51012  \u50780 \u44257 \u49884 \u53412 \u45716  \u48169 \u48277 \u51032  \u54616 \u45208 \u47196  \u49324 \u46988 \u46308 \u50640 \u44172  \u51088 \u49888 \u51032  \u49884 \u54744 \u51012  \u51228 \u49884 \u54624  \u44163 \u51060 \u45796 .\
