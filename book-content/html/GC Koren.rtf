\uc0\u50956 \u47532 \u50628  \u48128 \u47084 \u50752  \u44536 \u51032  \u46041 \u50669 \u51088 \u46308 \u51008  \u51116 \u47548  \u44368 \u47532 \u47484  \u51204 \u54028 \u54632 \u51004 \u47196 \u50024  \u49324 \u46988 \u46308 \u47196  \u54616 \u50668 \u44552  \u49900 \u54032 \u51012  \u50948 \u54616 \u50668  \u51456 \u48708 \u54616 \u46020 \u47197  \u44033 \u49457 \u49884 \u53412 \u45716  \u44536  \u54620  \u44032 \u51648  \u47785 \u51201 \u51012  \u54693 \u54616 \u50668  \u51068 \u54644  \u50772 \u45796 . \u44536 \u46308 \u51008  \u49888 \u51088 \u46308 \u50640 \u44172  \u44368 \u54924 \u51032  \u52280 \u46108  \u55148 \u47581 \u44284  \u44618 \u51008  \u44536 \u47532 \u49828 \u46020 \u51064  \u44221 \u54744 \u51032  \u54596 \u50836 \u49457 \u51012  \u51088 \u44033 \u49884 \u53020  \u51452 \u44592  \u50948 \u54616 \u50668  \u45432 \u47141 \u54616 \u50688 \u44256 , \u46608 \u54620  \u50500 \u51649 \u44620 \u51648  \u54924 \u44060 \u54616 \u51648  \u50500 \u45768 \u54620  \u51088 \u46308 \u50640 \u44172  \u51593 \u49884  \u54924 \u44060 \u54616 \u50668  \u54616 \u45208 \u45784 \u44760  \u46028 \u50500 \u44032 \u50556  \u54624  \u51032 \u47924 \u44032  \u51080 \u45796 \u45716  \u44163 \u51012  \u44648 \u50864 \u52432 \u51452 \u44256 \u51088  \u55192 \u50044 \u45796 . \'93\u44536 \u46308 \u51008  \u49324 \u46988 \u46308 \u47196  \u54616 \u50668 \u44552  \u50612 \u46500  \u51333 \u44368  \u45800 \u52404 \u45208  \u51333 \u54028 \u50640  \u44060 \u51333 \u49884 \u53412 \u47140 \u44256  \u49884 \u46020 \u54616 \u51648  \u50500 \u45768 \u54616 \u50688 \u45796 . \u44536 \u47084 \u48064 \u47196  \u44536 \u46308 \u51008  \u47784 \u46304  \u45800 \u52404 \u50752  \u51333 \u54028 \u46308  \u49324 \u51060 \u50640 \u49436  \u44536 \u46308 \u51032  \u51312 \u51649 \u51060 \u45208  \u44508 \u50984 \u50640  \u51200 \u52489 \u46120 \u51060  \u50630 \u51060  \u51068 \u54616 \u50688 \u45796 .\'94\
\uc0\u48128 \u47084 \u45716  \u47568 \u54616 \u50688 \u45796 . \'93\u45208 \u45716  \u44592 \u49457  \u44368 \u54028 \u46308 \u47196 \u48512 \u53552  \u48516 \u47532 \u46108  \u48324 \u44060 \u51032  \u44368 \u54028 \u47484  \u47564 \u46308 \u44144 \u45208  \u50612 \u46500  \u44368 \u54028 \u51032  \u51060 \u51061 \u51012  \u50948 \u54616 \u50668  \u45796 \u47480  \u44368 \u54028 \u50640 \u44172  \u49552 \u54644 \u47484  \u45180 \u52824 \u47140 \u45716  \u50837 \u47581 \u51060 \u45208  \u49373 \u44033 \u51008  \u51204 \u54784  \u50630 \u50632 \u45796 . \u45208 \u45716  \u47784 \u46304  \u44368 \u54028 \u50640 \u44172  \u50976 \u51061 \u51012  \u51452 \u44256 \u51088  \u49373 \u44033 \u54616 \u50688 \u45796 . \u45208 \u45716  \u44536 \u47532 \u49828 \u46020 \u51064  \u45572 \u44396 \u45208  \u44536 \u47532 \u49828 \u46020 \u51032  \u51116 \u47548 \u51032  \u49548 \u47581 \u51012  \u51600 \u44144 \u50892 \u54624  \u44163 \u51060 \u47728  \u48708 \u47197  \u45208 \u52376 \u47100  \u44648 \u45803 \u51648  \u47803 \u54616 \u50688 \u51012 \u51648 \u46972 \u46020  \u44536 \u46308 \u51008  \u51312 \u44552 \u51060 \u46972 \u46020  \u45908  \u47566 \u51008  \u49324 \u46988 \u46308 \u51060  \u44536  \u44368 \u47532 \u47484  \u48155 \u50500 \u46308 \u51060 \u45716  \u44163 \u51012  \u44592 \u48848 \u54616 \u47532 \u46972 \u44256  \u49373 \u44033 \u54616 \u44256  \u50612 \u46500  \u48324 \u44060 \u51032  \u54924 \u51473 \u51012  \u44032 \u51656  \u54596 \u50836 \u44032  \u51080 \u45796 \u44256  \u49373 \u44033 \u54620  \u51201 \u51008  \u50630 \u45796 . \u45208 \u51032  \u47785 \u51201 \u51008  \u50724 \u47196 \u51648  \u49324 \u46988 \u46308 \u51012  \u54616 \u45208 \u45784 \u44760 \u47196  \u46028 \u50500 \u50724 \u44172  \u54616 \u44256 , \u51109 \u52264  \u50732  \u49900 \u54032 \u50640  \u45824 \u54616 \u50668  \u49464 \u49345 \u51032  \u51452 \u51032 \u47484  \u54872 \u44592 \u49884 \u53412 \u44256 , \u45208 \u51032  \u46041 \u51313 \u46308 \u50640 \u44172  \u54616 \u45208 \u45784 \u51012  \u54200 \u50504 \u54616 \u44172  \u48456 \u50732  \u49688  \u51080 \u45716  \u47560 \u51020 \u51032  \u51456 \u48708 \u47484  \u49884 \u53412 \u45716  \u45936  \u51080 \u50632 \u45796 . \u44536 \u47532 \u54616 \u50668  \u45208 \u51032  \u54876 \u46041 \u51004 \u47196  \u54924 \u44060 \u54620  \u45824 \u45796 \u49688 \u51032  \u49324 \u46988 \u46308 \u51008  \u50668 \u47084  \u44592 \u49457  \u44368 \u54924 \u50640  \u49549 \u54616 \u50688 \u45796 \'94 (S.Bliss, Memoirs of Wm.Miller, p.328).\
\uc0\u44536 \u51032  \u49324 \u50629 \u51060  \u44368 \u54924 \u46308 \u51012  \u49464 \u50864 \u45716  \u45936  \u46020 \u50880 \u51060  \u46104 \u45716  \u50620 \u47560  \u46041 \u50504 \u51008  \u51339 \u51008  \u45824 \u51217 \u51012  \u48155 \u50520 \u45796 . \u44536 \u47084 \u45208  \u47785 \u49324 \u46308 \u44284  \u44368 \u54924  \u51648 \u46020 \u51088 \u46308 \u51060  \u51116 \u47548 \u44368 \u47532 \u47484  \u48176 \u52377 \u54616 \u44592 \u47196  \u44208 \u51032 \u54616 \u44256  \u44536  \u47928 \u51228 \u50640  \u44288 \u54616 \u50668  \u51068 \u52404 \u51032  \u53664 \u51032 \u47484  \u54616 \u51648  \u47803 \u54616 \u46020 \u47197  \u54620  \u54980 \u48512 \u53552  \u44536 \u46308 \u51008  \u44053 \u45800 \u50640 \u49436  \u44536  \u47928 \u51228 \u47484  \u48152 \u45824 \u54616 \u50688 \u51012  \u49104 \u47564  \u50500 \u45768 \u46972  \u44536 \u46308 \u51032  \u44368 \u51064 \u46308 \u51060  \u51116 \u47548 \u51012  \u51204 \u54616 \u45716  \u51665 \u54924 \u50640  \u52280 \u49437 \u54616 \u45716  \u51068 \u44620 \u51648 \u46020  \u44552 \u54616 \u44256 , \u49900 \u51648 \u50612  \u44368 \u54924 \u51032  \u44592 \u46020 \u54924  \u44057 \u51008  \u45936 \u49436  \u44536 \u46308 \u51032  \u49548 \u47581 \u51012  \u47568 \u54616 \u45716  \u51068 \u44620 \u51648 \u46020  \u54728 \u46973 \u54616 \u51648  \u50500 \u45768 \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44368 \u51064 \u46308 \u51008  \u44536 \u46308 \u51060  \u53360  \u49884 \u47144 \u44284  \u50612 \u47140 \u50880 \u50640  \u52376 \u54616 \u44172  \u46108  \u44163 \u51012  \u44648 \u45803 \u44172  \u46104 \u50632 \u45796 . \u44536 \u46308 \u51008  \u44536 \u46308 \u51032  \u44368 \u54924 \u47484  \u49324 \u46993 \u54616 \u50688 \u44256 , \u44144 \u44592 \u49436  \u46496 \u45208 \u44592 \u47484  \u50896 \u52824  \u50500 \u45768 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51032  \u51613 \u44144 \u44032  \u50517 \u48149 \