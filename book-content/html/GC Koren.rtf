\f1\b0 \cf0 \
\uc0\u44060 \u54785  \u49324 \u50629 \u51012  \u50948 \u54620  \u44032 \u51109  \u44256 \u44480 \u54620  \u51613 \u50616  \u51473 \u51032  \u54616 \u45208 \u45716  1529\u45380  \u49828 \u54028 \u51060 \u50620 \u49828  (Spires) \u54924 \u51032 \u50640 \u49436  \u46021 \u51068 \u51032  \u44536 \u47532 \u49828 \u46020 \u51064  \u44480 \u51313 \u46308 \u51060  \u51228 \u52636 \u54620  \u54637 \u51032 \u49436 \u50688 \u45796 . \u54616 \u45208 \u45784 \u44760  \u49549 \u54620  \u49324 \u46988 \u46308 \u51032  \u49888 \u50521 \u44284  \u50857 \u44592 \u50752  \u44204 \u51064 \u48520 \u48156 \u51008  \u44536  \u54980  \u50668 \u47084  \u49884 \u45824 \u47484  \u50948 \u54616 \u50668  \u49324 \u49345 \u44284  \u50577 \u49900 \u51032  \u51088 \u50976 \u47484  \u51137 \u52712 \u54664 \u45796 . \u44536 \u46308 \u51032  \u54637 \u51032  \u46412 \u47928 \u50640  \'93\u54532 \u47196 \u53580 \u49828 \u53444 \u53944 \'94 (Protestant) \u46972 \u45716  \u47749 \u52845 \u51060  \u44060 \u54785  \u44368 \u54924 \u50640  \u51452 \u50612 \u51276 \u45796 . \u44536  \u50896 \u52825 \u51060  \'93\u54532 \u47196 \u53580 \u49828 \u53444 \u53944 \u51032  \u48376 \u51656 \'94 (D\'92Aubigne, b.13, ch.6) \u51060 \u45796 .\
\uc0\u49324 \u50629 \u50640  \u50516 \u45812 \u54616 \u44256  \u46160 \u47140 \u50868  \u49884 \u45824 \u44032  \u45796 \u44032 \u50772 \u45796 . \u48372 \u47492 \u49828 \u51032  \u52825 \u47161 \u51004 \u47196  \u47336 \u53552 \u45716  \u48277 \u47456 \u51032  \u48372 \u54840 \u47484  \u48155 \u51648  \u47803 \u54616 \u44172  \u46104 \u50632 \u44256 , \u44536 \u51032  \u44368 \u47532 \u47484  \u44032 \u47476 \u52824 \u44144 \u45208  \u48155 \u50500 \u46308 \u51060 \u51648  \u47803 \u54616 \u46020 \u47197  \u44552 \u51648 \u46104 \u50632 \u51020 \u50640 \u46020  \u48520 \u44396 \u54616 \u44256 , \u46021 \u51068  \u50504 \u50640 \u49436 \u45716  \u51333 \u44368  \u51088 \u50976 \u44032  \u45328 \u47532  \u48372 \u44553 \u46104 \u50612  \u51080 \u50632 \u45796 . \u54616 \u45208 \u45784 \u51032  \u49453 \u47532 \u47196  \u51652 \u47532 \u47484  \u48152 \u45824 \u54616 \u45716  \u49464 \u47141 \u51060  \u50613 \u51228 \u46104 \u50612  \u51080 \u50632 \u45796 . \u52852 \u50508  5\u49464 \u45716  \u51333 \u44368 \u44060 \u54785 \u51012  \u48149 \u47736 \u54616 \u44256 \u51088  \u49552 \u51012  \u54196 \u48372 \u50520 \u51648 \u47564 , \u44536  \u46412 \u47560 \u45796  \u48520 \u44032 \u48520  \u44536  \u49552 \u51012  \u44144 \u46160 \u50612 \u46308 \u51060 \u51648  \u50506 \u51012  \u49688  \u50630 \u50632 \u45796 . \u50668 \u47084  \u48264  \u44144 \u46317 \u54644 \u49436  \u47196 \u47560 \u50640  \u54637 \u44144 \u54616 \u45716  \u51088 \u46308 \u51012  \u47784 \u46160  \u51593 \u49884  \u47736 \u51208 \u49884 \u53420  \u44163 \u52376 \u47100  \u48372 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u47084 \u54620  \u50948 \u44592 \u51068 \u48156 \u51032  \u49692 \u44036 \u51060  \u46112  \u46412 \u47560 \u45796  \u53804 \u47476 \u53356 \u44400 \u51060  \u46041 \u48512 \u51032  \u44397 \u44221 \u50640  \u45208 \u53440 \u45208 \u44144 \u45208  \u54532 \u46993 \u49828  \u50773 \u44284 \u51032  \u48516 \u51137 , \u54841 \u51008  \u48277 \u50773 \u44284  \u54889 \u51228 \u50752 \u51032  \u49464 \u47141  \u45796 \u53820  \u46321 \u51032  \u51068 \u51060  \u49373 \u44220 \u45796 . \u51060 \u50752  \u44057 \u51060  \u45208 \u46972 \u44032  \u50612 \u51648 \u47101 \u44256  \u48516 \u50836  (\u32027 \u25854 ) \u54620  \u51473 \u50640  \u44060 \u54785  \u49324 \u50629 \u51008  \u55192 \u51012  \u50619 \u44256  \u48156 \u51204 \u46104 \u50612  \u45208 \u44052 \u45796 .\
\uc0\u44536 \u47088 \u45936  \u47560 \u52840 \u45236  \u48277 \u50773 \u51032  \u44400 \u51452 \u46308 \u51008  \u45236 \u48512 \u51032  \u48516 \u51137 \u51012  \u44536 \u52824 \u44256 , \u55192 \u51012  \u54633 \u54616 \u50668  \u44060 \u54785 \u51088 \u46308 \u51012  \u45824 \u54637 \u54616 \u44172  \u46104 \u50632 \u45796 . 1526\u45380 \u50640  \u44060 \u52572 \u46108  \u49828 \u54028 \u51060 \u50620 \u49828  \u54924 \u51032 \u45716  \u52509 \u54924 \u47484  \u50676 \u44592  \u51204 \u44620 \u51648 \u45716  \u51333 \u44368 \u51201  \u47928 \u51228 \u46308 \u51012  \u44033  \u51452 \u51032  \u51088 \u50976 \u50640  \u47585 \u44592 \u44592 \u47196  \u44208 \u51032 \u54616 \u50688 \u50632 \u45796 . \u44536 \u47084 \u45208  \u51060 \u50752  \u44057 \u51060  \u50577 \u48372 \u47484  \u54616 \u44172  \u47564 \u46308 \u50632 \u45912  \u50948 \u54744 \u51060  \u51648 \u45208 \u44032 \u51088  \u54889 \u51228 \u45716  \u51060 \u45800 \u51012  \u48149 \u47736 \u54624  \u47785 \u51201 \u51004 \u47196  1529\u45380  \u49828 \u54028 \u51060 \u50620 \u49828 \u50640 \u49436  \u46160  \u48264 \u51704 \u51032  \u54924 \u51032 \u47484  \u49548 \u51665 \u54616 \u50688 \u45796 . \u54889 \u51228 \u45716  \u46112  \u49688  \u51080 \u45716  \u45824 \u47196  \u50728 \u44148 \u54620  \u48169 \u48277 \u51004 \u47196  \u47784 \u46304  \u44480 \u51313 \u46308 \u51012  \u44060 \u54785  \u50868 \u46041 \u51012  \u48152 \u45824 \u54616 \u45716  \u52769 \u51004 \u47196  \u51060 \u45132 \u44256 \u51088  \u54616 \u50688 \u44256 , \u47564 \u51068  \u49892 \u54056 \u54616 \u45716  \u44221 \u50864 \u50640 \u45716  \u47924 \u47141 \u51004 \u47196  \u54644 \u44208 \u54616 \u44256 \u51088  \u44208 \u49900 \u54616 \u50688 \u45796 .\
\uc0\u48277 \u50773 \u45817 \u51008  \u44592 \u48848 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u47924 \u47532 \u47484  \u51648 \u50612  \u49828 \u54028 \u51060 \u50620 \u49828 \u47196  \u47784 \u50668 \u46308 \u50632 \u51004 \u47728  \u45432 \u44264 \u51201 \u51004 \u47196  \u44060 \u54785 \u51088 \u46308 \u44284  \u44536 \u46308 \u50640 \u44172  \u54840 \u44048 \u51012  \u44032 \u51648 \u45716  \u47784 \u46304  \u49324 \u46988 \u46308 \u51012  \u45824 \u51201 \u54624  \u51032 \u49324 \u47484  \u45208 \u53440 \u45236 \u50632 \u45796 . \u47708 \u46976 \u55176 \u53668 \u51008  \'93\u50864 \u47532 \u45716  \u51060 \u51228  \u49464 \u49345 \u51032  \u51200 \u51452 \u50752  \u50424 \u50612 \u48260 \u47548 \u51012  \u48155 \u44592 \u50640  \u54633 \u45817 \u54616 \u44172  \u46104 \u50632 \u51004 \u45208 , \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u44032 \u47144 \u54620  \u45817 \u49888 \u51032  \u48177 \u49457 \u51012  \u46028 \u48372 \u49884 \u44256  \u48372 \u54840 \u54616 \u49892  \u44163 \u51060  \u53952 \u47548 \u50630 \u45796 \'94 (D\'92Aubigne, b.13, ch.5) \u44256  \u47568 \u54616 \u50688 \u45796 . \u44536  \u54924 \u51032 \u50640  \u52280 \u49437 \u54620  \u44060 \u54785 \u51452 \u51032 \u47484  \u48127 \u45716  \u51228 \u54980 \u46308 \u51008  \u51088 \u44592 \u46308 \u51032  \u44144 \u52376 \u50640 \u49436 \u46020  \u48373 \u51020 \u51012  \u51204 \u54616 \u51648  \u47803 \u54616 \u46020 \u47197  \u44552 \u51648 \u46104 \u50612  \u51080 \u50632 \u45796 . \u44536 \u47084 \u45208  \u49828 \u54028 \u51060 \u50620 \u49828 \u51032  \u49884 \u48124 \u46308 \u51008  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51012  \u44040 \u47581 \u54620  \u45208 \u47672 \u51648  \u44552 \u51648 \u45817 \u54620  \u51068 \u51012  \u47924 \u49884 \u54616 \u44256  \u51089 \u49468  \u49440 \u54980 \u51032  \u45824 \u44053 \u45817 \u50640  \u47784 \u50668 \u46308 \u50632 \u45796 .\
\uc0\u51060  \u51068 \u47196  \u51064 \u54616 \u50668  \u50948 \u44592 \u44032  \u54620 \u52789  \u45908  \u48744 \u47532  \u45797 \u52432 \u50772 \u45796 . \u54889 \u51228 \u45716  \u54924 \u51032 \u49437 \u50640 \u49436  \u51333 \u45236 \u50640  \u51333 \u44368  \u51088 \u50976 \u47484  \u54728 \u46973 \u54620  \u44208 \u44284 \u47196  \u53360  \u47924 \u51656 \u49436 \u44032  \u49373 \u44220 \u51004 \u48064 \u47196  \u44536 \u44163 \u51032  \u52384 \u54224 \u47484  \u50836 \u44396 \u54620 \u45796 \u44256  \u44277 \u54252 \u54616 \u50688 \u45796 . \u51060 \u47084 \u54620  \u51204 \u54945 \u51201 \u51064  \u54665 \u50948 \u45716  \u44060 \u54785 \u54028 \u51032  \u51032 \u48516  (\u32681 \u24996 ) \u44284  \u44221 \u50501 \u51012  \u51088 \u50500 \u45256 \u45796 . \u51060 \u50640  \u45824 \u54616 \u50668  \u50612 \u46500  \u49324 \u46988 \u51008  \'93\u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u46160  \u48264 \u51704  \u44032 \u50556 \u48148 \u50752  \u48716 \u46972 \u46020 \u51032  \u49552 \u50640  \u45336 \u50612 \u44052 \u45796 \'94\u44256  \u47568 \u54616 \u50688 \u45796 . \u44536 \u47088 \u45936  \u47196 \u47560 \u44368 \u46020 \u46308 \u51008  \u45908 \u50865  \u47609 \u47148 \u54620  \u50948 \u49464 \u47484  \u45208 \u53440 \u45236 \u50632 \u45796 . \u50756 \u44256 \u54620  \u48277 \u50773 \u45817 \u51032  \u54620  \u49324 \u46988 \u51008  \u45796 \u51020 \u44284  \u44057 \u51060  \u51452 \u51109 \u54616 \u50688 \u45796 . \'93\u53804 \u47476 \u53356 \u51064 \u46308 \u51008  \u47336 \u53552 \u51032  \u47924 \u47532 \u48372 \u45796  \u45227 \u45796 . \u53804 \u47476 \u53356 \u51064 \u46308 \u51008  \u44552 \u49885 \u51068 \u51012  \u51648 \u53412 \u51648 \u47564  \u47336 \u53552 \u51032  \u47924 \u47532 \u46308 \u51008  \u44536 \u44163 \u51012  \u50948 \u48152 \u54620 \u45796 . \u47564 \u51068  \u50864 \u47532 \u44032  \u49457 \u44221 \u44284  \u44368 \u54924 \u51032  \u45217 \u51008  \u50724 \u47448  (\u35492 \u35628 ) \u51473  \u50612 \u45712  \u54616 \u45208 \u47484  \u53469 \u54644 \u50556  \u54620 \u45796 \u47732 , \u50864 \u47532 \u45716  \u52264 \u46972 \u47532  \u47676 \u51200  \u44163 \u51012  \u48260 \u47140 \u50556  \u54620 \u45796 .\'94 \u47708 \u46976 \u55176 \u53668 \u51008  \u47568 \u54616 \u44592 \u47484  \'93\u54028 \u48288 \u47476  (Faber) \u45716  \u51032 \u54924 \u51032  \u47784 \u46304  \u49324 \u46988 \u46308  \u50526 \u50640 \u49436  \u48373 \u51020 \u51012  \u48127 \u45716  \u50864 \u47532 \u46308 \u51012  \u54693 \u54616 \u50668  \u45216 \u47560 \u45796  \u51068 \u51333 \u51032  \u49352  \u46028 \u51012  \u45912 \u51276 \u45796 \'94 (D\'92Aubigne, b.13, ch.5) \u44256  \u54616 \u50688 \u45796 .\
