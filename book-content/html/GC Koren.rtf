\f1\b0 \cf0 \
\uc0\u54532 \u47196 \u53580 \u49828 \u53444 \u53944 \u54028 \u50640 \u44172  \u50948 \u54744 \u51032  \u51669 \u51312 \u44032  \u45208 \u53440 \u45208 \u44172  \u46104 \u51088  \u54616 \u45208 \u45784 \u44760 \u49436  \u49552 \u51012  \u54196 \u49884 \u44256  \u45817 \u49888 \u51032  \u52649 \u49892 \u54620  \u48177 \u49457 \u46308 \u51012  \u48372 \u54840 \u54616 \u49888  \u51613 \u44144 \u44032  \u46608 \u54620  \u45208 \u53440 \u45228 \u45796 . \u48148 \u47196  \u44536  \u47924 \u47157 \u51032  \u51068 \u51060 \u50632 \u45796 . \'93\u47708 \u46976 \u55176 \u53668 \u51008  \u50500 \u51452  \u54889 \u44553 \u54616 \u44172  \u44536 \u51032  \u52828 \u44396  \u49884 \u47788  \u44536 \u47420 \u45236 \u50864 \u49828  (Simon Grynaeus) \u47484  \u45936 \u47532 \u44256  \u49828 \u54028 \u51060 \u50620 \u49828  \u49884 \u44032 \u47484  \u48736 \u51256  \u45208 \u50752  \u46972 \u51064  \u44053 \u44032 \u50640  \u51060 \u47476 \u47084  \u44536 \u50640 \u44172  \u51593 \u49884  \u44053 \u51012  \u44148 \u45320 \u46972 \u44256  \u44053 \u44428 \u54616 \u50688 \u45796 . \u44536  \u46412 \u50640  \u49884 \u47788 \u51008  \u44536 \u47111 \u44172  \u51312 \u44553 \u55176  \u44396 \u45716  \u45936  \u45824 \u54616 \u50668  \u45440 \u46992 \u45796 . \u44536 \u47084 \u51088  \u47708 \u46976 \u55176 \u53668 \u51008  \u45236 \u44032  \u51204 \u54784  \u50508 \u51648  \u47803 \u54616 \u45716  \u51109 \u45824 \u54616 \u44256  \u50948 \u50628 \u51080 \u45716  \u54413 \u52292 \u47484  \u44032 \u51652  \u54620  \u45432 \u51064 \u51060  \u45236 \u44172  \u45208 \u53440 \u45208 \u49436  \'91\u51104 \u49884  \u54980 \u50640  \u51116 \u54032 \u49548 \u51032  \u44288 \u47532 \u44032  \u54168 \u47476 \u46356 \u45212 \u53944  \u50773 \u51004 \u47196 \u48512 \u53552  \u54028 \u44204 \u51012  \u48155 \u50500  \u44536 \u47420 \u45236 \u50864 \u49828 \u47484  \u52404 \u54252 \u54616 \u47084  \u50732  \u44163 \u51060 \u45796 \'92\u44256  \u51068 \u47084  \u51452 \u50632 \u45796 \'94\u46972 \u44256  \u47568 \u54616 \u50688 \u45796 .\
\uc0\u44536 \u45216  \u44536 \u47420 \u45236 \u50864 \u49828 \u45716  \u48277 \u50773 \u45817 \u51032  \u54620  \u51648 \u46020  \u44228 \u44553 \u51032  \u54617 \u51088  \u54028 \u48288 \u47476 \u51032  \u49444 \u44368 \u50640  \u48516 \u44060 \u54616 \u50668  \u47560 \u52840 \u45236  \'93\u52280 \u51004 \u47196  \u44032 \u51613 \u54620  \u50724 \u47448 \'94\u47484  \u48320 \u54840 \u54616 \u45716  \u51088 \u46972 \u44256  \u54637 \u48320  (\u25239 \u36783 ) \u54616 \u50688 \u45796 . \u54028 \u48288 \u47476 \u45716  \u51088 \u44592 \u51032  \u48516 \u45432 \u47484  \u44048 \u52628 \u44592 \u45716  \u54664 \u51648 \u47564  \u51593 \u49884  \u50773 \u50640 \u44172  \u54616 \u51060 \u45944 \u48288 \u47476 \u53356  \u45824 \u54617 \u51032  \u44536  \u45128 \u44592  \u51080 \u45716  \u44368 \u49688 \u50640  \u45824 \u54620  \u52404 \u54252  \u50689 \u51109 \u51012  \u45236 \u47532 \u46020 \u47197  \u50836 \u52397 \u54616 \u50688 \u45796 . \u47708 \u46976 \u55176 \u53668 \u51008  \u54616 \u45208 \u45784 \u44760 \u49436  \u45817 \u49888 \u51032  \u52380 \u49324 \u46308  \u51473 \u51032  \u54616 \u45208 \u47484  \u48372 \u45236 \u49884 \u49324  \u51088 \u44592 \u50640 \u44172  \u48120 \u47532  \u44221 \u44256 \u54644  \u51452 \u49900 \u51004 \u47196  \u44536 \u51032  \u52828 \u44396 \u47484  \u44396 \u50896 \u54644  \u51452 \u49888  \u44163 \u51004 \u47196  \u48127 \u50612  \u51032 \u49900 \u52824  \u50506 \u50520 \u45796 .\
\'93\uc0\u46972 \u51064  \u44053  \u50616 \u45909 \u50640  \u51312 \u50857 \u55176  \u49436 \u49436  \u44536 \u45716  \u44536  \u44053 \u47932 \u51060  \u44536 \u47420 \u45236 \u50864 \u49828 \u47484  \u44536 \u51032  \u54605 \u48149 \u51088 \u46308 \u47196 \u48512 \u53552  \u44396 \u50896 \u54644  \u51452 \u44592 \u47484  \u44592 \u45796 \u47532 \u44256  \u51080 \u50632 \u45796 . \u47708 \u46976 \u55176 \u53668 \u51008  \u44053  \u44148 \u45320 \u54200  \u50616 \u45909 \u50640  \u44536 \u51032  \u52828 \u44396 \u44032  \u46020 \u52265 \u54616 \u45716  \u44163 \u51012  \u48372 \u44256 \u49436 \u50556  \u47560 \u52840 \u45236  \u44536 \u45716  \u47924 \u51396 \u54620  \u49324 \u46988 \u51032  \u54588 \u50640  \u47785 \u47560 \u47480  \u51088 \u46308 \u51032  \u51092 \u51064 \u54620  \u51060 \u48744 \u51012  \u47732 \u54664 \u45796 \u44256  \u48512 \u47476 \u51670 \u50632 \u45796 . \u51665 \u50640  \u46028 \u50500 \u50728  \u47708 \u46976 \u55176 \u53668 \u51008  \u44288 \u47532 \u46308 \u51060  \u44536 \u47420 \u45236 \u50864 \u49828 \u47484  \u52286 \u44592  \u50948 \u54616 \u50668  \u44536 \u51032  \u51665 \u51012  \u49349 \u49349 \u51060  \u49688 \u49353 \u54664 \u45796 \u45716  \u49324 \u49892 \u51012  \u50508 \u44172  \u46104 \u50632 \u45796 \'94 (D\'92Aubigne, b.13, ch.6).\
