\uc0\u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u49324 \u50629 \u51012  \u52628 \u51652 \u54616 \u44592  \u50948 \u54616 \u50668  \u50668 \u51204 \u55176  \u51068 \u44988 \u46308 \u51012  \u51456 \u48708 \u49884 \u53412 \u44256  \u44228 \u49512 \u45796 . \u54028 \u47532 \u51032  \u50612 \u45712  \u54617 \u44368 \u50640  \u49324 \u47140  \u44618 \u44256  \u52840 \u52265 \u54620  \u54620  \u52397 \u45380 \u51060  \u51080 \u50632 \u45796 . \u44536 \u45716  \u51060 \u48120  \u44053 \u47141 \u54616 \u44256  \u50696 \u48124 \u54620  \u51221 \u49888 \u47141 \u51012  \u49548 \u50976 \u54620  \u51613 \u44144 \u47484  \u45208 \u53440 \u45236 \u44256  \u51080 \u50632 \u45796 . \u44536 \u47532 \u44256  \u44536 \u45716  \u51648 \u51201  \u50676 \u49457 \u44284  \u49888 \u50521 \u51201  \u54732 \u49888 \u49104 \u47564  \u50500 \u45768 \u46972  \u44256 \u44208 \u54620  \u49373 \u50528 \u51032  \u53945 \u49457 \u51012  \u48372 \u50668 \u51452 \u44256  \u51080 \u50632 \u45796 . \u44536 \u51032  \u52380 \u51116 \u51201  \u51648 \u45733 \u44284  \u44540 \u47732 \u51008  \u44263  \u44536  \u45824 \u54617 \u51032  \u51088 \u46993 \u44144 \u47532 \u44032  \u46104 \u50632 \u45796 . \u51316  \u52860 \u48712 \u51008  \u44368 \u54924 \u51032  \u44032 \u51109  \u50976 \u47141 \u54616 \u44256  \u51316 \u44221 \u54624  \u47564 \u54620  \u50745 \u54840 \u51088 \u44032  \u46112  \u44163 \u51060  \u54869 \u49892 \u49884 \u46104 \u50632 \u45796 . \u44536 \u47084 \u45208  \u54616 \u45720 \u51032  \u48731 \u51060 , \u52860 \u48712 \u51012  \u46168 \u47084 \u49912 \u44256  \u51080 \u45912  \u49828 \u53084 \u46972  \u52384 \u54617 \u44284  \u48120 \u49888 \u51032  \u51109 \u48317 \u51012  \u46763 \u44256  \u44536 \u51032  \u47560 \u51020 \u49549 \u51004 \u47196  \u46308 \u50612 \u44052 \u45796 . \u44536 \u45716  \u46504 \u47532 \u45716  \u47560 \u51020 \u51004 \u47196  \u44536  \u49352 \u47196 \u50868  \u44368 \u47532 \u50640  \u45824 \u54616 \u50668  \u46307 \u44172  \u46104 \u50632 \u45796 . \u44536 \u47532 \u44256  \u44536 \u45716  \u44536  \u44368 \u47532 \u47484  \u49440 \u54252 \u54616 \u45716  \u51060 \u45800 \u51088 \u46308 \u51060  \u54868 \u54805 \u51012  \u45817 \u54616 \u45716  \u44163 \u51060  \u47560 \u46405 \u54620  \u51068 \u51060 \u46972 \u44256  \u48127 \u50612  \u51032 \u49900 \u52824  \u50506 \u50520 \u45796 . \u44536 \u45716  \u51204 \u54784  \u50696 \u44592 \u52824  \u50506 \u44172  \u44536  \u51060 \u45800 \u49444 \u44284  \u51217 \u54616 \u44172  \u46104 \u50632 \u51004 \u48064 \u47196  \u44060 \u54785 \u54028 \u51032  \u44368 \u47532 \u47484  \u45824 \u54637 \u54616 \u44592  \u50948 \u54616 \u50668 \u49436 \u45716  \u47196 \u47560 \u44368 \u51032  \u49888 \u54617 \u51032  \u45733 \u47141 \u51012  \u49884 \u54744 \u54616 \u51648  \u50506 \u51012  \u49688  \u50630 \u44172  \u46104 \u50632 \u45796 .\
\uc0\u44060 \u54785 \u54028 \u50640  \u44032 \u45812 \u54620  \u52860 \u48712 \u51032  \u49324 \u52492  \u54620  \u49324 \u46988 \u51060  \u54028 \u47532 \u50640  \u49332 \u44256  \u51080 \u50632 \u45796 . \u44536  \u46160  \u49324 \u46988 \u51008  \u46412 \u46412 \u47196  \u47564 \u45208 \u49436  \u45817 \u49884  \u44536 \u47532 \u49828 \u46020 \u44368 \u44397 \u51012  \u54844 \u46976 \u52992  \u54616 \u44256  \u51080 \u45716  \u47928 \u51228 \u46308 \u51012  \u54632 \u44760  \u53664 \u47200 \u54616 \u50688 \u45796 . \u54532 \u47196 \u53580 \u49828 \u53444 \u53944 \u51064  \u50732 \u47532 \u48288 \u53444  (Olivetan) \u51008  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u54616 \u50688 \u45796 . \'93\u51060  \u49464 \u49345 \u50640 \u45716  \u46160  \u44032 \u51648  \u51333 \u44368 \u48150 \u50640  \u50630 \u45796 . \u44536  \u51473 \u51032  \u54620  \u44032 \u51648  \u51333 \u44368 \u45716  \u49324 \u46988 \u51060  \u44256 \u50504 \u54644  \u45240  \u44163 \u51004 \u47196 \u49436 , \u44536 \u44163 \u51008  \u51032 \u49885  (\u20736 \u24335 ) \u44284  \u49440 \u54620  \u54665 \u49892 \u51012  \u53685 \u54616 \u50668  \u49324 \u46988 \u51060  \u51088 \u44592 \u51032  \u55192 \u51004 \u47196  \u44396 \u50896 \u51012  \u50619 \u45716 \u45796 \u45716  \u44163 \u51060 \u45796 . \u46608  \u45796 \u47480  \u51333 \u44368 \u45716  \u49457 \u44221 \u50640  \u48157 \u55176  \u44228 \u49884 \u46108  \u44163 \u51064 \u45936  \u44536 \u44163 \u51008  \u54616 \u45208 \u45784 \u44760 \u49436  \u49324 \u46988 \u50640 \u44172  \u44050 \u50630 \u51060  \u51452 \u49884 \u45716  \u51008 \u54812 \u47484  \u53685 \u54616 \u50668 \u49436 \u47564 \u51060  \u51452 \u50612 \u51648 \u45716  \u44396 \u50896 \u51012  \u48148 \u46972 \u48372 \u46020 \u47197  \u49324 \u46988 \u50640 \u44172  \u44032 \u47476 \u52824 \u44256  \u51080 \u45796 .\'94\
\uc0\u51060 \u50640  \u45824 \u54616 \u50668  \u52860 \u48712 \u51008  \'93\u45208 \u45716  \u44536 \u45824 \u51032  \u49352  \u44368 \u47532 \u47484  \u51312 \u44552 \u46020  \u48155 \u50500 \u46308 \u51060 \u51648  \u50506 \u44192 \u45796 . \u44536 \u45824 \u45716  \u45236 \u44032  \u51648 \u44552 \u44620 \u51648  \u50724 \u47448  \u44032 \u50868 \u45936 \u49436  \u49332 \u50500 \u50772 \u45796 \u44256  \u49373 \u44033 \u54616 \u45716 \u44032 \'94 (Wylie, b.13, ch.7) \u46972 \u44256  \u48512 \u47476 \u51670 \u50632 \u45796 .\
\uc0\u44536 \u47084 \u45208  \u52860 \u48712 \u51032  \u49900 \u51473 \u50640 \u45716  \u50668 \u47084  \u44032 \u51648  \u49373 \u44033 \u51060  \u46496 \u50732 \u46972  \u51088 \u44592 \u51032  \u51032 \u51648 \u47196 \u45716  \u46020 \u51200 \u55176  \u44536 \u44163 \u46308 \u51012  \u47932 \u47532 \u52832  \u49688 \u44032  \u50630 \u50632 \u45796 . \u44536 \u45716  \u54848 \u47196  \u51088 \u44592 \u51032  \u48169 \u50640 \u49436  \u49324 \u52492 \u51032  \u47568 \u51012  \u44618 \u51060  \u49373 \u44033 \u54616 \u44172  \u46104 \u50632 \u45796 . \u51396 \u51032  \u51088 \u44033 \u51060  \u44536 \u50640 \u44172  \u46496 \u45208 \u51648  \u50506 \u50520 \u45796 . \u44536 \u45716  \u51473 \u48372 \u51088  \u50630 \u51060  \u49457 \u44208 \u54616 \u44256  \u51032 \u47196 \u50864 \u49888  \u51116 \u54032 \u51109  \u50526 \u50640  \u49436  \u51080 \u45716  \u51088 \u44592  \u51088 \u49888 \u51012  \u48372 \u50520 \u45796 . \u49457 \u46020 \u51032  \u51473 \u48372 , \u49440 \u54665 , \u44368 \u54924 \u51032  \u51032 \u49885 , \u44536  \u47784 \u46304  \u44163 \u46308 \u51060  \u51396 \u47484  \u49549 \u54616 \u45716  \u45936 \u45716  \u47924 \u47141 \u54616 \u50688 \u45796 . \u50526 \u44600 \u51008  \u50516 \u45812 \u54616 \u50668  \u50724 \u51649  \u50689 \u50896 \u54620  \u51208 \u47581 \u51060  \u51080 \u51012  \u49104 \u51060 \u50632 \u45796 . \u44368 \u54924 \u51032  \u54617 \u51088 \u46308 \u51008  \u44536 \u51032  \u44540 \u49900 \u51012  \u54644 \u44208 \u54644  \u51452 \u44256 \u51088  \u45432 \u47141 \u54616 \u50688 \u51004 \u45208  \u54728 \u49324 \u50688 \u45796 . \u44256 \u54644  \u49457 \u49324 \u50752  \u44256 \u54665 \u46020  \u49888 \u47280 \u54624  \u47564 \u54620  \u44163 \u51060  \u47803 \u46104 \u50632 \u45796 . \u44536 \u44163 \u46308 \u51008  \u49900 \u47161 \u51012  \u54616 \u45208 \u45784 \u44284  \u54868 \u47785 \u49884 \u53020  \u51460  \u49688  \u50630 \u50632 \u45796 .\
\uc0\u51060 \u50752  \u44057 \u51060  \u47924 \u51061 \u54620  \u53804 \u51137 \u51012  \u44228 \u49549 \u54616 \u44256  \u51080 \u51012  \u46041 \u50504 , \u52860 \u48712 \u51008  \u50612 \u45712  \u45216  \u50864 \u50672 \u55176  \u53360  \u44305 \u51109 \u50640  \u45208 \u44032 \u49436  \u49548 \u50948  \u51060 \u45800 \u51088 \u47484  \u54868 \u54805 \u49884 \u53412 \u44256  \u51080 \u45716  \u44305 \u44221 \u51012  \u48372 \u50520 \u45796 . \u44536 \u45716  \u49692 \u44368 \u51088 \u51032  \u50620 \u44404 \u50640  \u54868 \u54217 \u51032  \u48731 \u51060  \u48731 \u45208 \u44256  \u51080 \u45716  \u44163 \u51012  \u48372 \u44256  \u51060 \u49345 \u54620  \u52649 \u44201 \u51012  \u48155 \u50520 \u45796 . \u47924 \u49436 \u50868  \u51453 \u51020 \u51032  \u44256 \u53685  \u49549 \u50640 \u49436 , \u44536 \u48372 \u45796  \u45908 \u50865  \u47924 \u49436 \u50868  \u44368 \u54924 \u51032  \u51221 \u51396 \u51032  \u49440 \u44256 \u47484  \u48155 \u44256 \u49436 \u46020  \u49692 \u44368 \u51088 \u45716  \u48127 \u51020 \u44284  \u50857 \u44592 \u47484  \u45208 \u53440 \u45236 \u50632 \u45796 . \u44536  \u46412 \u50640  \u52397 \u45380  \u52860 \u48712 \u51008  \u44536 \u47084 \u54620  \u48127 \u51020 \u44284  \u50857 \u44592 \u47484  \u44032 \u51652  \u49692 \u44368 \u51088 \u50752 , \u44032 \u51109  \u50628 \u44201 \u54616 \u44172  \u44368 \u54924 \u50640  \u49692 \u51333 \u54616 \u45716  \u49373 \u50528 \u47484  \u54616 \u47732 \u49436 \u46020  \u50724 \u55176 \u47140  \u51208 \u47581 \u44284  \u50516 \u55121  \u49549 \u50640 \u49436  \u54756 \u47588 \u44256  \u51080 \u45716  \u51088 \u44592  \u51088 \u49888 \u51012  \u44340 \u47196 \u50868  \u47560 \u51020 \u51004 \u47196  \u48708 \u44368 \u54644  \u48372 \u51648  \u50506 \u51012  \u49688  \u50630 \u50632 \u45796 . \u44536 \u45716  \u51060 \u45800 \u51088 \u46308 \u51060  \u44536 \u46308 \u51032  \u48127 \u51020 \u51012  \u49457 \u44221 \u50640  \u46160 \u44256  \u51080 \u45796 \u45716  \u49324 \u49892 \u51012  \u50508 \u50520 \u45796 . \u44536 \u45716  \u49457 \u44221 \u51012  \u50672 \u44396 \u54616 \u50668  \u54624  \u49688  \u51080 \u45716  \u45824 \u47196  \u44536 \u46308 \u51032  \u44592 \u49256 \u51032  \u48708 \u48128 \u51012  \u52286 \u50500 \u45236 \u44256 \u51088  \u44208 \u49900 \u54616 \u50688 \u45796 .\
