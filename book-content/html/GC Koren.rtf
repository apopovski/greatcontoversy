\uc0\u52488 \u45824 \u51032  \u51228 \u51088 \u46308 \u52376 \u47100  \u50956 \u47532 \u50628  \u48128 \u47084 \u50752  \u44536 \u51032  \u46041 \u50669 \u51088 \u46308 \u51008  \u44536 \u46308  \u51088 \u49888 \u51060  \u51204 \u54616 \u45716  \u44536  \u44592 \u48324 \u51032  \u51032 \u48120 \u47484  \u52649 \u48516 \u55176  \u51060 \u54644 \u54616 \u51648  \u47803 \u54616 \u50688 \u45796 . \u50724 \u47004  \u49464 \u50900 \u51060  \u51648 \u45208 \u45716  \u46041 \u50504  \u44368 \u54924  \u50504 \u50640  \u54805 \u49457 \u46108  \u50724 \u47448 \u46308  \u46412 \u47928 \u50640  \u44536 \u46308 \u51008  \u50696 \u50616  \u44032 \u50868 \u45936  \u51080 \u45716  \u51473 \u50836 \u54620  \u51216 \u51012  \u51221 \u54869 \u54616 \u44172  \u54644 \u49437 \u54624  \u49688  \u50630 \u44172  \u46104 \u50632 \u45796 . \u44536 \u47084 \u48064 \u47196  \u44536 \u46308 \u51008  \u54616 \u45208 \u45784 \u44760 \u49436  \u49464 \u49345 \u50640  \u51204 \u54616 \u46972 \u44256  \u44536 \u46308 \u50640 \u44172  \u47585 \u44592 \u49888  \u44592 \u48324 \u51012  \u51204 \u54616 \u44592 \u45716  \u54616 \u50688 \u51648 \u47564  \u44536  \u51032 \u48120 \u47484  \u50724 \u54644 \u54632 \u51004 \u47196  \u49828 \u49828 \u47196  \u49892 \u47581 \u51012  \u45817 \u54616 \u44172  \u46104 \u50632 \u45796 .\
