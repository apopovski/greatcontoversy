\uc0\u51060 \u50752  \u44057 \u51060  \u44536  \u47928 \u51228 \u47484  \u50672 \u44396 \u54616 \u44256  \u51080 \u45912  \u49324 \u46988 \u46308 \u51008  \u54616 \u45720 \u50640  \u51080 \u45716  \u49457 \u49548 \u51032  \u51316 \u51116 \u50640  \u45824 \u54616 \u50668  \u46020 \u47924 \u51648  \u48512 \u51064 \u54624  \u49688  \u50630 \u45716  \u51613 \u44144 \u47484  \u48156 \u44204 \u54616 \u44172  \u46104 \u50632 \u45796 . \u47784 \u49464 \u45716  \u51088 \u44592 \u50640 \u44172  \u48372 \u51064  \u49885 \u50577  (\u24335 \u27171 ) \u51012  \u46384 \u46972  \u51648 \u49345  \u49457 \u49548 \u47484  \u51648 \u50632 \u45796 . \u48148 \u50872 \u51008  \u44536  \u49885 \u50577 \u51060  \u54616 \u45720 \u50640  \u51080 \u45716  \u52280  \u49457 \u49548 \u46972 \u44256  \u44032 \u47476 \u52432  \u51456 \u45796 . \u44536 \u47532 \u44256  \u50836 \u54620 \u51008  \u54616 \u45720 \u50640  \u51080 \u45716  \u49457 \u49548 \u47484  \u48372 \u50520 \u45796 \u44256  \u51613 \u44144 \u54620 \u45796 .\
