\uc0\u50956 \u47532 \u50628  \u48128 \u47084 \u45716  \u49324 \u46988 \u51012  \u44305 \u49888 \u51004 \u47196  \u51060 \u45124 \u45716  \u44536 \u47088  \u49464 \u47141 \u50640  \u51312 \u44552 \u46020  \u46041 \u51312 \u54616 \u51648  \u50500 \u45768 \u54616 \u50688 \u45796 . \u44536 \u45716  \u47336 \u53552 \u50752  \u44057 \u51060  \u47784 \u46304  \u50689  (\u63923 ) \u51008  \u48152 \u46300 \u49884  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51004 \u47196  \u44160 \u53664 \u46104 \u50612 \u50556  \u54620 \u45796 \u44256  \u51452 \u51109 \u54616 \u50688 \u45796 . \u48128 \u47084 \u45716  \u47568 \u54616 \u50688 \u45796 . \'93\u47560 \u44480 \u45716  \u50724 \u45720 \u45216  \u50612 \u46500  \u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u51012  \u51648 \u48176 \u54616 \u45716  \u53360  \u49464 \u47141 \u51012  \u44032 \u51648 \u44256  \u51080 \u45796 . \u44536 \u47084 \u47732  \u50864 \u47532 \u45716  \u44536 \u46308 \u51060  \u44032 \u51652  \u50689 \u51060  \u50612 \u46500  \u51333 \u47448 \u51032  \u44163 \u51064 \u51648  \u50612 \u46523 \u44172  \u50508  \u49688  \u51080 \u51012  \u44163 \u51064 \u44032 ? \u49457 \u44221 \u51008  \'91\u44536 \u51032  \u50676 \u47588 \u47196  \u44536 \u46308 \u51012  \u50508 \u47532 \u46972 \'92\u44256  \u45824 \u45813 \u54620 \u45796 . \'85 \u49464 \u49345 \u50640 \u45716  \u47566 \u51008  \u50689 \u46308 \u51060  \u45208 \u53440 \u45228 \u45796 . \u44536 \u47084 \u48064 \u47196  \u50864 \u47532 \u45716  \u44536  \u50689 \u46308 \u51012  \u49884 \u54744 \u54644 \u48372 \u46972 \u45716  \u47749 \u47161 \u51012  \u48155 \u50520 \u45796 . \u49464 \u49345 \u50640 \u49436  \u50864 \u47532 \u47484  \u52280 \u46104 \u44256  \u51032 \u47213 \u44256  \u44221 \u44148 \u54616 \u44172  \u49332 \u46020 \u47197  \u54644 \u51452 \u51648  \u50506 \u45716  \u50689 \u51008  \u44536 \u47532 \u49828 \u46020 \u51032  \u50689 \u51060  \u50500 \u45768 \u45796 . \u45208 \u45716  \u49324 \u45800 \u51060  \u51060 \u47088  \u45212 \u54253 \u54620  \u50868 \u46041 \u51012  \u53685 \u54616 \u50668  \u47566 \u51008  \u51068 \u51012  \u54616 \u44256  \u51080 \u45796 \u44256  \u51216 \u51216  \u45908  \u54869 \u49888 \u54616 \u44172  \u46104 \u50632 \u45796 . \'85\u50864 \u47532  \u51473 \u50640 \u45716  \u50756 \u51204 \u55176  \u49457 \u54868  (\u32854 \u21270 ) \u46108  \u46319 \u51060  \u48372 \u51060 \u47732 \u49436 \u46020  \u49324 \u46988 \u51032  \u50976 \u51204 \u51012  \u46384 \u47476 \u44256  \u44536 \u47088  \u47784 \u50577 \u51012  \u48372 \u51060 \u51648  \u50506 \u45716  \u49324 \u46988 \u46308 \u44284  \u47560 \u52268 \u44032 \u51648 \u47196  \u51652 \u47532 \u50640  \u45824 \u54616 \u50668  \u47924 \u51648 \u54620  \u51088 \u46308 \u51060  \u47566 \u45796 \'94 (S.Bliss, Memoirs of Wm.Miller, pp.236, 237).\
\'93\uc0\u50724 \u47448  (\u35492 \u35628 ) \u51032  \u50689 \u51008  \u50864 \u47532 \u47484  \u51652 \u47532 \u50640 \u49436  \u46496 \u45208 \u44172  \u54616 \u44256  \u54616 \u45208 \u45784 \u51032  \u50689 \u51008  \u50864 \u47532 \u47484  \u51652 \u47532 \u47196  \u51064 \u46020 \u54620 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45824 \u46308 \u51008  \u47568 \u54616 \u47532 \u46972 . \u49324 \u46988 \u51060  \u50724 \u47448  \u44032 \u50868 \u45936  \u51080 \u51004 \u47732 \u49436 \u46020  \u51088 \u44592 \u45716  \u51652 \u47532 \u47484  \u44032 \u51652  \u51460 \u47196  \u49373 \u44033 \u54624  \u49688  \u51080 \u51004 \u47532 \u46972 \u44256 . \u44536 \u47088  \u44221 \u50864 \u50640 \u45716  \u50612 \u52236  \u46112 \u44620 ? \u50864 \u47532 \u45716  \u49457 \u47161 \u44284  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51008  \u51068 \u52824 \u46108 \u45796 \u44256  \u45824 \u45813 \u54616 \u45716  \u48148 \u51060 \u45796 . \u49324 \u46988 \u51060  \u47564 \u51068  \u51088 \u44592  \u51088 \u49888 \u51012  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u50640  \u48708 \u52628 \u50612  \u44160 \u53664 \u54644  \u48372 \u44256  \u44536  \u47784 \u46304  \u47568 \u50432 \u44284  \u50756 \u51204 \u55176  \u48512 \u54633 \u46112  \u44163  \u44057 \u51004 \u47732  \u44536 \u45716  \u44536 \u44032  \u51652 \u47532 \u47484  \u44032 \u51648 \u44256  \u51080 \u45796 \u44256  \u48127 \u50612 \u50556  \u54620 \u45796 . \u47564 \u51068  \u44536 \u47484  \u51064 \u46020 \u54616 \u45716  \u50689 \u51060  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u44284  \u49457 \u44221 \u51032  \u51452 \u51228 \u50752  \u51068 \u52824 \u54616 \u51648  \u50500 \u45768 \u54616 \u47732  \u44536 \u45716  \u47560 \u44480 \u51032  \u50732 \u47924 \u50640  \u44152 \u47532 \u51648  \u50506 \u46020 \u47197  \u51312 \u49900 \u49457  \u51080 \u44172  \u44152 \u50612 \u44032 \u50556  \u54620 \u45796 \'94[The Advent Herald and Signs of the Times Reporter, vol.8, No.23 (Jan.15, 1845) ]. \'93\u45208 \u45716  \u44032 \u45140  \u44536 \u47532 \u49828 \u46020 \u44368 \u44228 \u51032  \u50836 \u46976 \u54620  \u49548 \u47532 \u50640 \u49436 \u48372 \u45796 \u46020  \u48731 \u45208 \u45716  \u45576 , \u45576 \u47932 \u50640  \u51222 \u51008  \u48380 , \u47785 \u47700 \u50612  \u47568 \u51012  \u51060 \u47336 \u51648  \u47803 \u54616 \u45716  \u51020 \u49457 \u50640 \u49436  \u49324 \u46988 \u51032  \u47560 \u51020 \u49549 \u50640  \u44048 \u52628 \u50612 \u51256  \u51080 \u45716  \u44221 \u44148 \u51032  \u51613 \u44144 \u47484  \u48376 \u45796 \'94 (Bliss, p.282).\
