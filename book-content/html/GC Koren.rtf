\f1\b0 \cf0 \
\uc0\u50612 \u46496 \u54620  \u49884 \u45824 \u50640 \u49436 \u45208  \u51652 \u47532 \u51032  \u50745 \u54840 \u51088 \u46308 \u51008  \u51060 \u50752  \u44057 \u51008  \u47924 \u44592 \u50640  \u51032 \u54616 \u50668  \u44277 \u44201 \u51012  \u48155 \u50500 \u50772 \u45796 . \u44536 \u50752  \u46609 \u44057 \u51008  \u45436 \u51312  (\u63809 \u35519 ) \u44032  \u50724 \u45720 \u45216 \u50640 \u46020  \u51060 \u48120  \u54869 \u47549 \u46108  \u50724 \u47448 \u50640  \u48152 \u45824 \u54616 \u50668  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51032  \u47749 \u48177 \u54616 \u44256  \u49556 \u51649 \u54620  \u44368 \u54984 \u51012  \u51228 \u49884 \u54616 \u44256 \u51088  \u54616 \u45716  \u49324 \u46988 \u46308 \u51012  \u45824 \u54637 \u54616 \u50668  \u51228 \u44592 \u46104 \u44256  \u51080 \u45796 . \u51064 \u44592  \u51080 \u45716  \u51333 \u44368 \u47484  \u50896 \u54616 \u45716  \u49324 \u46988 \u46308 \u51008  \'93\u49352  \u44368 \u47532 \u47484  \u51204 \u54028 \u54616 \u45716  \u51088 \u46308 \u51060  \u45572 \u44396 \u51064 \u44032 \'94\u46972 \u44256  \u48512 \u47476 \u51670 \u45716 \u45796 . \u44536 \u46308 \u51008  \u47924 \u49885 \u54616 \u44256  \u44032 \u45212 \u54620  \u49548 \u49688 \u51032  \u47924 \u47532 \u44032  \u50500 \u45772 \u44032 ? \u44536 \u47084 \u47732 \u49436 \u46020  \u44536 \u46308 \u51008  \u51652 \u47532 \u47484  \u44032 \u51276 \u45432 \u46972 \u44256 , \u54616 \u45208 \u45784 \u51032  \u53469 \u54620  \u48177 \u49457 \u51060 \u46972 \u44256  \u51452 \u51109 \u54620 \u45796 . \'93\u44536 \u46308 \u51008  \u47924 \u51648 \u54616 \u44256  \u48120 \u54841 \u54620  \u51088 \u46308 \u51060 \u45796 . \u50864 \u47532  \u44368 \u54924 \u45716  \u49688 \u54952 \u50752  \u50689 \u54693 \u47141 \u50640  \u51080 \u50612 \u49436  \u50620 \u47560 \u45208  \u50864 \u49464 \u54620 \u44032 ! \u50864 \u47532 \u50640 \u44172 \u45716  \u50948 \u45824 \u54616 \u44256  \u50976 \u49885 \u54620  \u49324 \u46988 \u46308 \u51060  \u50620 \u47560 \u45208  \u47566 \u51008 \u44032 ! \u50864 \u47532  \u54200 \u51032  \u49464 \u47141 \u51008  \u44284 \u50672  \u50620 \u47560 \u45208  \u53360 \u44032 !\'94\u46972 \u44256  \u44536 \u46308 \u51008  \u47568 \u54620 \u45796 . \u51060 \u47084 \u54620  \u45436 \u51312 \u45716  \u49464 \u49345 \u50640  \u50976 \u47141 \u54620  \u50689 \u54693 \u51012  \u45180 \u52824 \u44256  \u51080 \u45796 . \u44536 \u44163 \u51008  \u50724 \u45720 \u45216 \u50640  \u51080 \u50612 \u49436 \u46020  \u44536  \u44060 \u54785 \u51088 \u51032  \u45817 \u49884 \u50752  \u47560 \u52268 \u44032 \u51648 \u47196  \u44208 \u51221 \u51201 \u51064  \u50689 \u54693 \u51012  \u45180 \u52824 \u44256  \u51080 \u45796 .\
\uc0\u51333 \u44368 \u44060 \u54785 \u51008  \u47566 \u51008  \u49324 \u46988 \u51060  \u49373 \u44033 \u54616 \u45716  \u48148 \u50752  \u44057 \u51060  \u47336 \u53552 \u51032  \u49884 \u45824 \u50640  \u47560 \u52432 \u51648 \u51648  \u50506 \u50520 \u45796 . \u44536 \u44163 \u51008  \u49464 \u49345  \u50669 \u49324 \u51032  \u51333 \u47568 \u44620 \u51648  \u44228 \u49549 \u46104 \u50612 \u50556  \u54620 \u45796 . \u47336 \u53552 \u45716  \u54616 \u45208 \u45784 \u44760 \u49436  \u44536 \u50640 \u44172  \u48708 \u52628 \u50612  \u51452 \u49888  \u48731 \u51012  \u45796 \u47480  \u49324 \u46988 \u50640 \u44172  \u48152 \u49324 \u54632 \u51004 \u47196  \u53360  \u51068 \u51012  \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u51109 \u52264  \u51060  \u49464 \u49345 \u50640  \u48708 \u52628 \u50612  \u51452 \u50612 \u50556  \u54624  \u48731 \u51012  \u47784 \u46160  \u45796  \u48155 \u51008  \u44163 \u51008  \u50500 \u45768 \u50632 \u45796 . \u44536  \u46412 \u48512 \u53552  \u50724 \u45720 \u45216 \u50640  \u51060 \u47476 \u44592 \u44620 \u51648  \u49352  \u48731 \u51008  \u44228 \u49549 \u51201 \u51004 \u47196  \u49457 \u44221 \u50640 \u49436  \u45208 \u50724 \u44256  \u51080 \u44256 , \u49352  \u51652 \u47532 \u45716  \u45130 \u51076 \u50630 \u51060  \u45208 \u53440 \u45208 \u44256  \u51080 \u45796 .\
\uc0\u48277 \u50773  \u49324 \u51208 \u51032  \u50672 \u49444 \u51008  \u51032 \u54924 \u50640  \u48708 \u49345 \u54620  \u51088 \u44537 \u51012  \u51452 \u50632 \u45796 . \u44144 \u44592 \u50640 \u45716  \u49457 \u44221 \u51032  \u47749 \u47308 \u54616 \u44256  \u44048 \u47749 \u51201 \u51064  \u51652 \u47532 \u47484  \u44032 \u51648 \u44256  \u48277 \u50773 \u51032  \u53804 \u49324 \u47484  \u52432 \u48512 \u49696  \u47336 \u53552 \u46020  \u50630 \u50632 \u44256 , \u44060 \u54785 \u51088 \u47484  \u50745 \u54840 \u54616 \u44256 \u51088  \u54616 \u45716  \u45432 \u47141 \u46020  \u50630 \u50632 \u45796 . \u44144 \u44592 \u50640 \u45716  \u47336 \u53552 \u50752  \u44536 \u44032  \u44032 \u47476 \u52828  \u44368 \u47532 \u47484  \u51221 \u51396 \u54624  \u49104  \u50500 \u45768 \u46972 , \u54624  \u49688  \u51080 \u45716  \u45824 \u47196  \u51060 \u45800 \u51088 \u47484  \u44540 \u51208 \u54644 \u50556  \u54620 \u45796 \u45716  \u51032 \u54693 \u44620 \u51648  \u45824 \u46160 \u46104 \u50632 \u45796 . \u47196 \u47560 \u44368 \u45716  \u51088 \u44592 \u54200 \u51012  \u48320 \u54840 \u54616 \u44592 \u50640  \u44032 \u51109  \u51339 \u51008  \u44592 \u54924 \u47484  \u44032 \u51276 \u45796 . \u44536 \u47084 \u48064 \u47196  \u51088 \u44592 \u47484  \u48320 \u54840 \u54616 \u44592  \u50948 \u54616 \u50668  \u54624  \u49688  \u51080 \u45716  \u47568 \u51008  \u45796 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u50808 \u44288 \u49345 \u51004 \u47196  \u49849 \u47532 \u54620  \u46319 \u54620  \u44536 \u44163 \u51008  \u54056 \u48176 \u51032  \u49888 \u54840 \u50688 \u45796 . \u50780 \u45264 \u54616 \u47732  \u51652 \u47532 \u50752  \u50724 \u47448 \u44032  \u44277 \u44060 \u51201 \u51004 \u47196  \u49892 \u51204  (\u23526 \u25136 ) \u51012  \u54616 \u47732 , \u44536  \u46160  \u44032 \u51648 \u45716  \u45908 \u50865  \u48516 \u47749 \u54616 \u44172  \u45824 \u51312 \u46104 \u50612  \u45208 \u53440 \u45208 \u44592  \u46412 \u47928 \u51060 \u45796 . \u44536  \u51060 \u54980 \u47196  \u47196 \u47560 \u44368 \u45716  \u45796 \u49884  \u54217 \u50504 \u54616 \u44172  \u51648 \u45244  \u49884 \u44592 \u47484  \u50619 \u51012  \u49688  \u50630 \u50632 \u45796 .\
\uc0\u51032 \u50896 \u46308  \u51473 \u51032  \u45824 \u48512 \u48516 \u51008  \u47336 \u53552 \u47484  \u47196 \u47560 \u51032  \u48372 \u48373 \u51032  \u49552 \u50640  \u45336 \u44200 \u51452 \u44592 \u47484  \u51452 \u51200 \u54616 \u51648  \u50506 \u51012  \u51032 \u54693 \u51060 \u50632 \u51004 \u45208 , \u44536  \u51473 \u51032  \u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u44368 \u54924  \u45236 \u50640  \u51080 \u45716  \u48512 \u45817 \u54620  \u54665 \u50948 \u47484  \u50508 \u44256 , \u49457 \u51649  \u51221 \u52824 \u51032  \u48512 \u54056 \u50752  \u53456 \u50837 \u51004 \u47196  \u47568 \u48120 \u50516 \u50500  \u46021 \u51068  \u44397 \u48124 \u51060  \u51077 \u45716  \u54644 \u46021 \u51012  \u51228 \u44144 \u54616 \u44592 \u47484  \u55148 \u47581 \u54616 \u50688 \u45796 . \u48277 \u50773 \u51032  \u49324 \u51208 \u51008  \u48277 \u50773 \u44428 \u51032  \u51228 \u46020  (\u21046 \u24230 ) \u47484  \u44032 \u51109  \u50976 \u47532 \u54616 \u44172  \u51228 \u49884 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u51452 \u45784 \u44760 \u49436 \u45716  \u51032 \u50896  \u51473 \u50640  \u54620  \u49324 \u46988 \u51012  \u44048 \u46041 \u49884 \u53412 \u51088  \u48277 \u50773 \u44368 \u51032  \u54945 \u54252 \u51032  \u44208 \u44284 \u47196  \u49373 \u44596  \u51652 \u49345 \u51012  \u54253 \u47196 \u54616 \u44172  \u54616 \u49512 \u45796 . \u44536  \u46412 \u50640  \u44208 \u45800 \u49457  \u51080 \u45716  \u51089 \u49468 \u51032  \u51424 \u51648  \u44277 \u51089  (Duke George) \u51008  \u46168 \u47084 \u50505 \u51008  \u44480 \u51064 \u46308  \u50526 \u50640  \u51068 \u50612 \u49436 \u49436  \u48277 \u50773 \u44368 \u51032  \u44592 \u47564 \u44284  \u44032 \u51613 \u54620  \u51396 \u50752  \u44536  \u46160 \u47140 \u50868  \u44208 \u44284 \u50640  \u45824 \u54616 \u50668  \u45440 \u46972 \u50872  \u51221 \u46020 \u47196  \u51221 \u54869 \u54616 \u44172  \u51648 \u51201 \u54616 \u50688 \u45796 . \u44536 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u51012  \u47560 \u52824 \u50632 \u45796 .\
\'93\uc0\u51060 \u44163 \u46308 \u51008  \u47196 \u47560 \u44032  \u45180 \u52828  \u54644 \u46021 \u51032  \u51068 \u48512 \u48516 \u51060 \u45796 . \u49688 \u52824 \u45208  \u54217 \u54032 \u51060  \u47928 \u51228 \u44032  \u50500 \u45768 \u45796 . \u44536 \u46308 \u51032  \u50976 \u51068 \u51032  \u47785 \u51201 \u51008  \u46024 , \u46024 , \u46024 \u51060 \u45796 . \u44536 \u47084 \u48064 \u47196  \u51652 \u47532 \u47484  \u44032 \u47476 \u52432 \u50556  \u54624  \u51204 \u46020 \u51088 \u46308 \u51008  \u45796 \u47564  \u44144 \u51667 \u51012  \u47568 \u54616 \u50688 \u44256 , \u44536 \u44163 \u51060  \u46608 \u54620  \u47925 \u51064 \u46112  \u49104 \u47564  \u50500 \u45768 \u46972  \u50724 \u55176 \u47140  \u48372 \u49345 \u51012  \u48155 \u50520 \u45796 . \u50780 \u45264 \u54616 \u47732  \u44536 \u46308 \u51032  \u44144 \u51667 \u51060  \u53356 \u47732  \u53364 \u49688 \u47197  \u44536 \u46308 \u51032  \u51060 \u46301 \u51008  \u45908 \u50865  \u52984 \u44592  \u46412 \u47928 \u51060 \u50632 \u45796 . \u51060 \u52376 \u47100  \u45908 \u47084 \u50868  \u47932 \u51060  \u55128 \u47084 \u45236 \u47532 \u45716  \u44163 \u51008  \u44536  \u49368 \u51032  \u44540 \u50896 \u51060  \u45908 \u47084 \u50892 \u51256  \u51080 \u44592  \u46412 \u47928 \u51060 \u45796 . \u48169 \u53461 \u51008  \u53456 \u50837 \u51012  \u54693 \u54616 \u50668  \u49552 \u51012  \u48855 \u44256  \u51080 \u45796 . \'85\u49836 \u54532 \u45796 . \u51060 \u44163 \u51060 \u50556 \u47568 \u47196  \u49849 \u47140 \u44032  \u44032 \u51256 \u50728  \u50501 \u45909 \u51060 \u47728 , \u44536 \u47196  \u51064 \u54616 \u50668  \u47566 \u51008  \u48520 \u49933 \u54620  \u50689 \u54844 \u46308 \u51060  \u50689 \u50896 \u54620  \u47736 \u47581 \u51004 \u47196  \u48736 \u51256 \u44032 \u44256  \u51080 \u45796 . \u47560 \u46405 \u55176  \u51068 \u45824  \u44060 \u54785 \u51060  \u51068 \u50612 \u45208 \u50556  \u54620 \u45796 \'94 (D\'92Au-bigne, b.7, ch.4).\
