\f1\b0 \cf0 \
\uc0\u48128 \u47084 \u44032  \u44536 \u47532 \u49828 \u46020 \u51032  \u51116 \u47548 \u51060  \u51076 \u48149 \u54664 \u45796 \u45716  \u51613 \u44144 \u47484  \u44277 \u51473  \u50526 \u50640  \u50508 \u47140  \u51452 \u44592  \u49884 \u51089 \u54620  2\u45380  \u54980 \u50640  \u44396 \u51452 \u44760 \u49436  \u51116 \u47548 \u51032  \u51669 \u51312 \u47196  \u50557 \u49549 \u54644  \u51452 \u49888  \u47592  \u47560 \u51648 \u47561  \u51669 \u51312 \u44032  \u45208 \u53440 \u45228 \u45796 . \u50696 \u49688 \u45784 \u44760 \u49436 \u45716  \'93\u48324 \u46308 \u51060  \u54616 \u45720 \u50640 \u49436  \u46504 \u50612 \u51648 \u47532 \u46972 \'94 (\u47560  24:29) \u44256  \u47568 \u50432 \u54616 \u49512 \u45796 . \u46608 \u54620  \u50836 \u54620 \u51008  \u54616 \u45208 \u45784 \u51032  \u45216 \u51012  \u50508 \u47140 \u51452 \u45716  \u44305 \u44221 \u51012  \u51060 \u49345  \u51473 \u50640  \u48372 \u50520 \u51012  \u46412  \u45796 \u51020 \u44284  \u44057 \u51060  \u44536  \u49324 \u49892 \u51012  \u44592 \u47197 \u54616 \u50688 \u45796 . \'93\u54616 \u45720 \u51032  \u48324 \u46308 \u51060  \u47924 \u54868 \u44284 \u45208 \u47924 \u44032  \u45824 \u54413 \u50640  \u55124 \u46308 \u47140  \u49440 \u44284 \u49892 \u51060  \u46504 \u50612 \u51648 \u45716  \u44163 \u44057 \u51060  \u46405 \u50640  \u46504 \u50612 \u51648 \'94 (\u44228  6:13) \u45908 \u46972 . \u51060  \u50696 \u50616 \u51008  1833\u45380  11\u50900  13\u51068 \u51032  \u50976 \u49457  (\u63946 \u26143 ) \u51032  \u53360  \u49548 \u45208 \u44592 \u47196  \u48516 \u47749 \u55176  \u49457 \u52712 \u46104 \u50632 \u45796 . \u44536 \u44163 \u51008  \u51648 \u44552 \u44751  \u44592 \u47197 \u46108  \u44163  \u51473 \u50640 \u49436  \u44032 \u51109  \u44305 \u48276 \u50948 \u54616 \u44256  \u45440 \u46972 \u50868  \u48324 \u51032  \u46504 \u50612 \u51664 \u51060 \u50632 \u45796 . \'93\u51060  \u46412 \u50640  \u50728  \u48120 \u44397 \u51032  \u54616 \u45720 \u51008  \u47751  \u49884 \u44036  \u46041 \u50504  \u52268 \u46976 \u54620  \u44305 \u44221 \u51012  \u45208 \u53440 \u45256 \u45796 . \u51060 \u45716  \u48120 \u44397 \u51060  \u49373 \u44596  \u51060 \u47000  \u51068 \u52237 \u51060  \u50630 \u50632 \u45912  \u54616 \u45720 \u51032  \u54788 \u49345 \u51060 \u50632 \u51004 \u47728  \u44536 \u44163 \u51012  \u47785 \u44201 \u54620  \u51068 \u48512 \u51032  \u49324 \u46988 \u46308 \u51008  \u47588 \u50864  \u44048 \u53444 \u54616 \u50688 \u44256 , \u46608 \u54620  \u45796 \u47480  \u48512 \u47448 \u51032  \u49324 \u46988 \u46308 \u51008  \u49900 \u55176  \u46160 \u47140 \u50892  \u44221 \u50501  (\u39514 \u24853 ) \u54616 \u50688 \u45796 .\'94 \'93\u44536  \u51109 \u50628 \u54616 \u44256  \u52268 \u46976 \u54664 \u45912  \u44305 \u44221 \u51008  \u51648 \u44552 \u46020  \u47566 \u51008  \u49324 \u46988 \u46308 \u51032  \u47672 \u47551 \u49549 \u50640  \u45224 \u50500  \u51080 \u45796 . \'85\u50724 \u45720 \u45216 \u44620 \u51648 \u51032  \u50612 \u46496 \u54620  \u50976 \u49457 \u50864  (\u63946 \u26143 \u38632 ) \u46020  \u44536  \u46412 \u50752  \u44057 \u51060  \u49324 \u47732 \u54036 \u48169 \u51004 \u47196  \u49780  \u49352  \u50630 \u51060  \u50143 \u50500 \u51276 \u45912  \u51201 \u51008  \u50630 \u45796 . \u45796 \u49884  \u47568 \u54616 \u47732  \u50728  \u54616 \u45720 \u51060  \u50880 \u51649 \u51060 \u45716  \u44163  \u44057 \u50520 \u45796 . \'85\u44536  \u44305 \u44221 \u51008  \u49892 \u47532 \u47676  \u44368 \u49688 \u44032  \u51200 \u45328 \u51060 \u46972 \u45716  \u51105 \u51648 \u50640  \u44592 \u47197 \u54620  \u48148 \u50752  \u44057 \u51060 , \u48513 \u48120  \u51204 \u50669  (\u20840 \u22495 ) \u50640 \u49436  \u48380  \u49688  \u51080 \u50632 \u45796 . \'85\u46160  \u49884 \u48512 \u53552  \u49352 \u48317 \u51060  \u46104 \u44592 \u44620 \u51648  \u54616 \u45720 \u51008  \u44396 \u47492  \u54620  \u51216  \u50630 \u51060  \u47569 \u50520 \u45716 \u45936 , \u52268 \u46976 \u54620  \u48731 \u51060  \u48264 \u51789 \u51060 \u47732 \u49436  \u50728  \u54616 \u45720 \u51008  \u44592 \u51060 \u54620  \u44305 \u44221 \u51012  \u51060 \u47336 \u50632 \u45796 \'94 (R.M.Devens, American Progress; or, The Great Events of the Greatest Century, ch.28, pars.1~5).\
\'93\uc0\u49892 \u47196  \u44536  \u51109 \u50628 \u54620  \u44305 \u44221 \u51008  \u47568 \u47196  \u54364 \u54788 \u54624  \u49688  \u50630 \u50632 \u45796 . \'85\u44536 \u44163 \u51012  \u47785 \u44201 \u54616 \u51648  \u50500 \u45768 \u54620  \u49324 \u46988 \u51008  \u50500 \u47924 \u46020  \u44536  \u52268 \u46976 \u54620  \u47784 \u49845 \u51012  \u44648 \u45804 \u51012  \u49688  \u50630 \u50632 \u45796 . \u44536 \u44163 \u51008  \u47560 \u52824  \u50728  \u54616 \u45720 \u51032  \u47784 \u46304  \u48324 \u51060  \u47672 \u47532  \u50948 \u51032  \u50612 \u46500  \u54620  \u51216 \u50640  \u47784 \u50668 \u49436  \u44049 \u51088 \u44592  \u51648 \u49345 \u51012  \u54693 \u54616 \u50668  \u48264 \u44060  \u44057 \u51008  \u49549 \u47141 \u51004 \u47196  \u51068 \u51228 \u55176  \u45236 \u47140 \u50724 \u45716  \u44163 \u44284  \u44057 \u50520 \u45796 . \u44536 \u44163 \u46020  \u45796 \u47564  \u54620  \u49692 \u44036 \u51004 \u47196  \u44536 \u52828  \u44163 \u51060  \u50500 \u45768 \u44256  \u47560 \u52824  \u44536  \u46412 \u47484  \u50948 \u54616 \u50668  \u52285 \u51312 \u46108  \u44163 \u52376 \u47100  \u46244 \u47484  \u51060 \u50612  \u48736 \u47480  \u49549 \u47141 \u51004 \u47196  \u47924 \u49688 \u55176  \u50143 \u50500 \u51256  \u45236 \u47140 \u50772 \u45796 \'94 (F.Reed, in the Christian Advocate and Journal, Dec.13, 1833). \'93\u52264 \u46972 \u47532  \u47924 \u54868 \u44284 \u45208 \u47924 \u44032  \u45824 \u54413 \u50640  \u55124 \u46308 \u47140  \u44536  \u44284 \u49892 \u51060  \u46504 \u50612 \u51648 \u45716  \u44163  \u44057 \u45796 \u44256  \u54632 \u51060  \u45908 \u50865  \u51201 \u51208 \u54620  \u47568 \u51060  \u46112  \u44163 \u51060 \u45796 \'94 (\'93The Old Countryman\'94, in Portland Evening Adver-tiser, Nov.26, 1883).\
1833\uc0\u45380  11\u50900  14\u51068 \u51088 \u51032  \u45684 \u50837  \u49345 \u50629 \u49888 \u48372  (\u21830 \u26989 \u26032 \u22577 ) \u45716  \u44536  \u45440 \u46972 \u50868  \u54788 \u49345 \u50640  \u45824 \u54616 \u50668  \u50500 \u47000 \u50752  \u44057 \u51008  \u44592 \u49324 \u47484  \u44172 \u51116 \u54616 \u50688 \u45796 . \'93\u45208 \u45716  \u50612 \u46500  \u54617 \u51088 \u45208  \u52384 \u54617 \u51088 \u46020  \u50612 \u51228  \u50500 \u52840 \u50640  \u51068 \u50612 \u45212  \u44163 \u44284  \u44057 \u51008  \u49324 \u44148 \u51012  \u50696 \u44256 \u54616 \u44144 \u45208  \u44592 \u47197 \u54620  \u51068 \u51060  \u50630 \u45796 \u44256  \u49373 \u44033 \u54620 \u45796 . \u47564 \u51068  \u48324 \u51060  \u46504 \u50612 \u51652 \u45796 \u45716  \u47568 \u51060  \u50976 \u49457 \u51012  \u51032 \u48120 \u54616 \u45716  \u44163 \u51060 \u46972 \u47732  \u54620  \u50696 \u50616 \u51088 \u45716  \u51060 \u48120  1800\u50668  \u45380  \u51204 \u50640  \u44536  \u51068 \u51060  \u51080 \u51012  \u44163 \u51012  \u51221 \u54869 \u55176  \u50696 \u50616 \u54616 \u50688 \u45796 . \'85\u45796 \u47564  \u44536 \u47088  \u51032 \u48120 \u50640 \u49436 \u47564  \u44536  \u50696 \u50616 \u51008  \u44544 \u51088  \u44536 \u45824 \u47196  \u49457 \u52712 \u46104 \u50632 \u45796 \u44256  \u48380  \u49688  \u51080 \u45796 .\'94\
\uc0\u44536 \u47532 \u54616 \u50668  \u50696 \u49688 \u44760 \u49436  \u45817 \u49888 \u51032  \u51228 \u51088 \u46308 \u50640 \u44172  \'93\u51060 \u50752  \u44057 \u51060  \u45320 \u55148 \u46020  \u51060  \u47784 \u46304  \u51068 \u51012  \u48372 \u44144 \u46304  \u51064 \u51088 \u44032  \u44032 \u44620 \u51060  \u44263  \u47928  \u50526 \u50640  \u51060 \u47480  \u51460  \u50508 \u46972 \'94 (\u47560  24:33) \u44256  \u47568 \u50432 \u54616 \u49888  \u51116 \u47548 \u51032  \u47560 \u51648 \u47561  \u51669 \u51312 \u45716  \u49457 \u52712 \u46104 \u50632 \u45796 . \u44536  \u51669 \u51312 \u46308 \u51060  \u51080 \u51008  \u46244 \u50640  \u50836 \u54620 \u51008  \u54616 \u45720 \u51060  \u51333 \u51060 \u52629 \u51060  \u47568 \u47532 \u45716  \u44163 \u44057 \u51060  \u46496 \u45208 \u44032 \u44256  \u46405 \u51060  \u55124 \u46308 \u47532 \u44256  \u49328 \u44284  \u49452 \u46308 \u51060  \u51228 \u51088 \u47532 \u50640 \u49436  \u50734 \u44200 \u51648 \u44256  \u50501 \u51064 \u46308 \u51060  \u46160 \u47140 \u50892  \u46504 \u47732 \u49436  \u51064 \u51088  \u50526 \u50640 \u49436  \u49704 \u45716  \u44305 \u44221 \u46308 \u51012  \u48372 \u50520 \u45796  (\u44228  6:12~17 \u52280 \u51312 ).\
\uc0\u48324 \u46308 \u51060  \u46504 \u50612 \u51648 \u45716  \u51068 \u51012  \u47785 \u44201 \u54620  \u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u44536 \u44163 \u51012  \u45796 \u44032 \u50724 \u45716  \u49900 \u54032 \u51012  \u50508 \u47140  \u51452 \u45716  \u44163 , \u44263  \'93\u53356 \u44256  \u46160 \u47140 \u50868  \u45216 \u51032  \u47924 \u49436 \u50868  \u47784 \u49845 , \u54869 \u49892 \u54620  \u51204 \u51312  (\u21069 \u20806 ), \u51088 \u48708 \u47196 \u50868  \u51669 \u51312 \'94 (\'93The Old Countryman\'94, in Portland Evening Advertiser, Nov.26, 1883) \u46972 \u44256  \u48372 \u50520 \u45796 . \u44536 \u47532 \u54616 \u50668  \u49324 \u46988 \u46308 \u51008  \u50696 \u50616 \u51032  \u49457 \u52712 \u47484  \u51452 \u47785 \u54616 \u44172  \u46104 \u44256 , \u47566 \u51008  \u49324 \u46988 \u51060  \u44536 \u47532 \u49828 \u46020 \u51032  \u51116 \u47548 \u51032  \u44221 \u44256 \u47484  \u48155 \u50500 \u46308 \u51060 \u44172  \u46104 \u50632 \u45796 .\
