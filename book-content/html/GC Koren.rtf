\uc0\u50773 \u51008  \u49436 \u47196  \u48152 \u45824 \u46104 \u45716  \u53804 \u49324 \u46308  \u44036 \u50640  \u55192 \u44284  \u51648 \u54812 \u47484  \u45824 \u51312 \u51201 \u51004 \u47196  \u45208 \u53440 \u45244  \u44592 \u54924 \u47484  \u54924 \u54588 \u54616 \u51648  \u50506 \u44256 , \u44144 \u47564 \u54620  \u49849 \u47140 \u46308 \u51032  \u51088 \u44256 \u49900 \u51012  \u44734 \u50612  \u51460  \u51339 \u51008  \u44592 \u54924 \u46972 \u44256  \u49373 \u44033 \u54616 \u50668  \u47196 \u47560  \u44368 \u46020 \u46308 \u50640 \u44172  \u45824 \u54616 \u50668  \u49457 \u44221 \u51004 \u47196  \u44536 \u46308 \u51032  \u51452 \u51109 \u51012  \u50745 \u54840 \u54616 \u46972 \u44256  \u47749 \u47161 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u46308 \u51008  \u44536 \u47111 \u44172  \u54616 \u45716  \u44163 \u51060  \u44536 \u46308 \u50640 \u44172  \u48324 \u48152  \u50976 \u51061 \u51060  \u50630 \u51012  \u44163 \u51012  \u50508 \u50520 \u45796 . \u44536 \u46308 \u51008  \u53804 \u50725 , \u44256 \u47928 , \u54868 \u54805 \u44284  \u44057 \u51008  \u51068 \u50640  \u51061 \u49689 \u54644 \u51256  \u51080 \u50632 \u45796 . \u51060 \u51228  \u54805 \u49464 \u44032  \u50669 \u51204 \u46104 \u50612  \u48288 \u47476 \u52901 \u51012  \u48736 \u46888 \u47532 \u44592  \u50948 \u54616 \u50668  \u54032  \u54632 \u51221 \u50640  \u44536 \u46308 \u51060  \u48736 \u51652  \u44163 \u51012  \u44648 \u45803 \u44172  \u46104 \u50632 \u45796 . \u44536 \u46308 \u51008  \u45440 \u46972 \u49436  \u45796 \u47480  \u48169 \u47732 \u51004 \u47196  \u54588 \u54624  \u44600 \u51012  \u52286 \u44256 \u51088  \u54616 \u50688 \u45796 .\
\'93\uc0\u47560 \u52840  \u45817 \u49884 \u50640  \u50612 \u45712  \u44600 \u44144 \u47532 \u50640  \u49464 \u50868  \u49457 \u47784  \u47560 \u47532 \u50500 \u51032  \u49345 \u51060  \u54028 \u49552 \u46104 \u50632 \u45796 .\'94 \u49884 \u51473 \u50640  \u53360  \u49548 \u46041 \u51060  \u51068 \u50612 \u45228 \u45796 . \u49324 \u46988 \u46308 \u51060  \u44536  \u44275 \u50640  \u47784 \u50668 \u49436  \u49836 \u54548 \u44284  \u48516 \u45432 \u51032  \u51020 \u49457 \u51004 \u47196  \u48512 \u47476 \u51670 \u50632 \u45796 . \u50773 \u51032  \u47560 \u51020 \u46020  \u49900 \u55176  \u55124 \u46308 \u47160 \u45796 . \u49849 \u47140 \u46308 \u51008  \u44536 \u46308 \u50640 \u44172  \u50976 \u47532 \u54620  \u51216 \u51060  \u51080 \u51020 \u51012  \u48156 \u44204 \u54616 \u44256  \u44536 \u44163 \u51012  \u51060 \u50857 \u54616 \u50688 \u45796 . \u49849 \u47140 \u46308 \u51008  \'93\u44536 \u44163 \u51060  \u48288 \u47476 \u52901 \u51032  \u44032 \u47476 \u52840 \u51032  \u44208 \u44284 \u51060 \u47728 , \u44536  \u47336 \u53552 \u45817 \u51008  \u47784 \u46304  \u44163 , \u44263  \u51333 \u44368 \u50752  \u48277 \u47456 \u44284  \u50773 \u50948  \u51088 \u52404 \u44620 \u51648  \u51204 \u48373 \u49884 \u53412 \u44256 \u51088  \u54616 \u44256  \u51080 \u45796 \'94 (Wylie, b.13, ch.9) \u44256  \u48512 \u47476 \u51670 \u50632 \u45796 .\
\uc0\u48288 \u47476 \u52901 \u51008  \u45796 \u49884  \u52404 \u54252 \u46104 \u50632 \u45796 . \u44536 \u47084 \u45208  \u50773 \u51008  \u54028 \u47532 \u47484  \u46496 \u45208  \u48512 \u51116 \u51473 \u51060 \u50632 \u51004 \u48064 \u47196  \u49849 \u47140 \u46308 \u51008  \u51200 \u55148 \u46308  \u47560 \u51020 \u45824 \u47196  \u44536 \u47484  \u52376 \u52824 \u54616 \u44172  \u46104 \u50632 \u45796 . \u44060 \u54785 \u51088  \u48288 \u47476 \u52901 \u51008  \u51116 \u54032 \u51012  \u48155 \u44256 , \u49324 \u54805  \u49440 \u44256 \u47484  \u48155 \u50520 \u45796 . \u54532 \u46976 \u49884 \u49828  \u50773 \u51060  \u44536 \u47484  \u44396 \u50896 \u54644  \u45244  \u49688  \u50630 \u46020 \u47197  \u54616 \u44256 \u51088  \u44536  \u49440 \u44256 \u45716  \u50616 \u46020 \u47484  \u48155 \u51008  \u44536 \u45216 \u47196  \u51665 \u54665 \u46104 \u50632 \u45796 . \u51221 \u50724 \u50640  \u48288 \u47476 \u52901 \u51008  \u49324 \u54805 \u51109 \u51004 \u47196  \u45132 \u47140  \u45208 \u44052 \u45796 . \u49324 \u46988 \u46308 \u51008  \u44536  \u49324 \u44148 \u51012  \u47785 \u44201 \u54616 \u44592  \u50948 \u54616 \u50668  \u51064 \u49328 \u51064 \u54644 \u47484  \u51060 \u47336 \u50632 \u45796 . \u44221 \u50501 \u44284  \u51032 \u54841 \u51004 \u47196  \u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u54532 \u46993 \u49828 \u50640 \u49436  \u44032 \u51109  \u50857 \u44048 \u54616 \u44256  \u44256 \u44480 \u54620  \u44480 \u51313  \u52636 \u49888 \u51032  \u44536  \u55148 \u49373 \u51088 \u47484  \u51452 \u47785 \u54616 \u50688 \u45796 . \u44221 \u50501 , \u51032 \u48516 , \u51312 \u49548 , \u44053 \u54620  \u51613 \u50724 \u49900 \u51060  \u44536  \u51452 \u50948 \u50640  \u47792 \u47140 \u46300 \u45716  \u49324 \u46988 \u46308 \u51032  \u50620 \u44404 \u51012  \u50612 \u46177 \u44172  \u54616 \u50688 \u51004 \u45208  \u50724 \u51649  \u54620  \u49324 \u46988 \u51032  \u50620 \u44404 \u50640 \u45716  \u50500 \u47924 \u47088  \u44536 \u45720 \u46020  \u50630 \u50632 \u45796 . \u44536  \u49692 \u44368 \u51088 \u51032  \u49373 \u44033 \u51008  \u51060  \u49548 \u46041 \u50640 \u49436  \u47680 \u47532  \u46496 \u45208  \u51080 \u50632 \u45796 . \u44536 \u45716  \u51088 \u44592 \u51032  \u51452 \u45784 \u44760 \u49436  \u51088 \u44592 \u50752  \u54632 \u44760  \u44228 \u49900 \u51012  \u51032 \u49885 \u54616 \u50688 \u45796 .\
\uc0\u44536 \u47484  \u53468 \u50868  \u48372 \u51096 \u44163 \u50630 \u45716  \u51089 \u51008  \u49688 \u47112 , \u48149 \u54644 \u51088 \u46308 \u51032  \u54744 \u49345 \u44418 \u51008  \u50620 \u44404 , \u44263  \u44536 \u44032  \u45817 \u54644 \u50556  \u54624  \u47924 \u49436 \u50868  \u51453 \u51020 , \u44536  \u47784 \u46304  \u44163 \u46308 \u51012  \u44536 \u45716  \u51204 \u54784  \u44060 \u51032 \u52824  \u50506 \u50520 \u45796 . \u49332 \u50500  \u44228 \u49888  \u44536 \u47532 \u49828 \u46020 , \u46028 \u50500 \u44032 \u49512 \u45796 \u44032  \u49332 \u50500 \u45208 \u49492 \u49436  \u50689 \u50896 \u55176  \u49332 \u50500  \u44228 \u49888  \u44536 \u47532 \u49828 \u46020 , \u49324 \u47581 \u44284  \u51020 \u48512 \u51032  \u50676 \u49632 \u47484  \u44032 \u51648 \u49888  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u44536 \u51032  \u44225 \u50640  \u44228 \u49512 \u45796 . \u48288 \u47476 \u52901 \u51032  \u50857 \u47784 \u45716  \u54616 \u45720 \u51032  \u48731 \u44284  \u54868 \u54217 \u51004 \u47196  \u48731 \u45208 \u44256  \u51080 \u50632 \u45796 . \u48288 \u47476 \u52901 \u51032  \u48373 \u51109 \u51008  \u54988 \u47469 \u54616 \u50688 \u45796 . \u44536 \u45716  \'93\u50864 \u45800  \u50808 \u53804 \u50752  \u44368 \u51649  \u51312 \u45180 \u47484  \u51077 \u44256  \u44552 \u48731  \u50577 \u47568 \'94 (D\'92Aubigne.History of the reformation in the Time of Calvin, b.2, ch.16) \u51012  \u49888 \u44256  \u51080 \u50632 \u45796 . \u44536 \u45716  \u51060 \u51228  \u47564 \u50773 \u51032  \u50773 \u44284  \u50728  \u50864 \u51452 \u44032  \u51648 \u53020 \u48372 \u45716  \u44032 \u50868 \u45936 \u49436  \u44536 \u51032  \u48127 \u51020 \u50640  \u45824 \u54616 \u50668  \u51613 \u44144 \u54624  \u44163 \u51060 \u50632 \u45796 . \u44536 \u51032  \u50620 \u44404 \u51032  \u50612 \u46500  \u49836 \u54536  \u55124 \u51201 \u46020  \u44536 \u51032  \u44592 \u49256 \u51012  \u50612 \u44536 \u47084 \u51648 \u44172  \u54616 \u51648  \u47803 \u54664 \u45796 .\
\uc0\u54665 \u47148 \u51060 , \u44400 \u51473 \u51004 \u47196  \u46308 \u45139 \u45716  \u44144 \u47532 \u47484  \u52380 \u52380 \u55176  \u51648 \u45208 \u44040  \u46412  \u49324 \u46988 \u46308 \u51008  \u44536 \u51032  \u54413 \u52292 \u50752  \u53468 \u46020 \u50752  \u54000 \u45132 \u47564 \u53372 \u46020  \u55120 \u47536  \u51216 \u51060  \u50630 \u45716  \u54868 \u54217 \u44284  \u49849 \u47532 \u51032  \u44592 \u49256 \u51012  \u48372 \u44256  \u45440 \u46992 \u45796 . \'93\u51060  \u49324 \u46988 \u51008  \u49457 \u51204  \u50504 \u50640  \u50505 \u50500 \u49436  \u44144 \u47337 \u54620  \u49324 \u47932 \u51012  \u51312 \u50857 \u55176  \u47749 \u49345 \u54616 \u45716  \u49324 \u46988 \u44284  \u44057 \u45796 \'94 (Wylie, b.13, ch.9) \u44256  \u44536 \u46308 \u51008  \u47568 \u54616 \u50688 \u45796 .\
\uc0\u48288 \u47476 \u52901 \u51008  \u54868 \u54805 \u45824 \u50640 \u49436  \u49324 \u46988 \u46308 \u51012  \u54693 \u54616 \u50668  \u50557 \u44036 \u51032  \u47568 \u51012  \u54616 \u44256 \u51088  \u54664 \u45796 . \u44536 \u47084 \u45208  \u44536  \u44208 \u44284 \u47484  \u46160 \u47140 \u50892 \u54620  \u49849 \u47140 \u46308 \u51032  \u48512 \u47476 \u51670 \u51020 \u44284  \u44400 \u51064 \u46308 \u51060  \u47924 \u44592 \u47484  \u48512 \u46378 \u52824 \u45716  \u49548 \u47532 \u50752  \u46496 \u46300 \u45716  \u49548 \u47532 \u47196  \u51064 \u54616 \u50668  \u49692 \u44368 \u51088 \u51032  \u51020 \u49457 \u51008  \u49324 \u46972 \u51648 \u44256  \u47568 \u50520 \u45796 . \u51060 \u47532 \u54616 \u50668  1529\u45380 \u50640  \u44060 \u54868 \u46108  \u54028 \u47532 \u50640 \u49436  \u54617 \u47928 \u44284  \u49888 \u54617 \u51032  \u52572 \u44256  \u44428 \u50948 \u51088 \u46308 \u51060  \'93\u49324 \u54805 \u51012  \u45817 \u54616 \u45716  \u49324 \u46988 \u46308 \u50640 \u44172  \u52572 \u54980 \u51032  \u47568 \u51012  \u54616 \u51648  \u47803 \u54616 \u46020 \u47197  \u44552 \u51648 \u54632 \u51004 \u47196  1793\u45380 \u51032  \u54785 \u47749  \u49884 \u45824 \u51032  \u48124 \u51473 \u50640 \u44172  \u44032 \u51109  \u50501 \u54620  \u47784 \u48376 \u51012  \u45224 \u44220 \u45796 \'94 (Wylie, b.13, ch.9).\
\uc0\u48288 \u47476 \u52901 \u51008  \u44368 \u49688 \u54805 \u51012  \u45817 \u54616 \u50688 \u44256 , \u44536 \u51032  \u49884 \u52404 \u45716  \u48520 \u53468 \u50892 \u51276 \u45796 . \u44536 \u51032  \u51453 \u51020 \u51032  \u49548 \u49885 \u51008  \u54532 \u46993 \u49828  \u51204 \u44397 \u51032  \u44060 \u54785 \u54028 \u51032  \u46041 \u51648 \u46308 \u51012  \u49836 \u54532 \u44172  \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u51032  \u47784 \u48376 \u51008  \u54728 \u51648 \u47196  \u46028 \u50500 \u44032 \u51648  \u50506 \u50520 \u45796 . \'93\u50864 \u47532 \u46308 \u46020  \u51109 \u52264  \u48155 \u51012  \u48120 \u47000 \u51032  \u49373 \u47749 \u51012  \u48148 \u46972 \u48372 \u47732 \u49436  \u44592 \u49244  \u47560 \u51020 \u51004 \u47196  \u51453 \u51012  \u51456 \u48708 \u44032  \u46104 \u50612  \u51080 \u45796 \'94 (D\'92Aubigne.History of the refo-rmation in the Time of Calvin, b.2, ch.16) \u44256  \u51652 \u47532 \u51032  \u51613 \u51064 \u46308 \u51008  \u47568 \u54616 \u50688 \u45796 .\
