\f1\b0 \cf0 \
\uc0\u51060  \u50668 \u47084  \u54364 \u49345 \u46308 \u50640  \u44288 \u54620  \u50696 \u50616 \u51008  \u50836 \u54620 \u44228 \u49884 \u47197  12\u51109 \u50640 \u49436  \u44536 \u47532 \u49828 \u46020 \u47484  \u53444 \u49373  \u51593 \u49884  \u51453 \u51060 \u47140 \u44256  \u54620  \u50857 \u51004 \u47196 \u48512 \u53552  \u49884 \u51089 \u46108 \u45796 . \u50857 \u51008  \u49324 \u45800 \u51060 \u46972 \u44256  \u48520 \u47532 \u44256  \u51080 \u45796  (\u44228  12:9 \u52280 \u51312 ). \u49324 \u45800 \u51008  \u44396 \u51452 \u47484  \u51453 \u51060 \u44592  \u50948 \u54616 \u50668  \u54756 \u47215 \u51032  \u47560 \u51020 \u51012  \u52649 \u46041 \u54616 \u50688 \u45796 . \u44536 \u47532 \u44256  \u44536 \u47532 \u49828 \u46020 \u44368 \u51032  \u52572 \u52488 \u51032  \u47751  \u49464 \u44592  \u46041 \u50504  \u44536 \u47532 \u49828 \u46020 \u50752  \u44536 \u48516 \u51032  \u48177 \u49457 \u46308 \u50640 \u44172  \u46020 \u51204 \u54620  \u49324 \u45800 \u51032  \u51452 \u46108  \u45824 \u47532 \u51088 \u45716  \u47196 \u47560  \u51228 \u44397 \u51060 \u50632 \u51004 \u47728 , \u51060 \u44368 \u44032  \u44536  \u45208 \u46972 \u50640 \u49436  \u50517 \u46020 \u51201  \u49464 \u47141 \u51012  \u44032 \u51652  \u51333 \u44368 \u50688 \u45796 . \u44536 \u47084 \u48064 \u47196  \u50857 \u51008  \u50896 \u47000  \u49324 \u45800 \u51012  \u45824 \u54364 \u54616 \u51648 \u47564  \u46041 \u49884 \u50640  \u44536 \u44163 \u51008  \u46608 \u54620  2\u52264 \u51201 \u51064  \u51032 \u48120 \u50640 \u49436  \u51060 \u44368  \u47196 \u47560 \u47484  \u49345 \u51669 \u54620 \u45796 .\
13\uc0\u51109  1~10\u51208 \u50640 \u45716  \u46608  \u45796 \u47480  \u51664 \u49849 \u51060  \u47896 \u49324 \u46104 \u50612  \u51080 \u45716 \u45936 , \u44536 \u44163 \u51008  \'93\u54364 \u48276 \u44284  \u48708 \u49847 \u54616 \u44256 \'94 \'93\u50857 \u51060  \u51088 \u44592 \u51032  \u45733 \u47141 \u44284  \u48372 \u51340 \u50752  \u53360  \u44428 \u49464 \u47484  \u44536 \u50640 \u44172  \u51452 \u50632 \u45908 \u46972 .\'94 \u51060  \u54364 \u49345 \u51008  \u47566 \u51008  \u44060 \u49888 \u44368 \u46020 \u46308 \u51060  \u48127 \u45716  \u48148 \u50752  \u44057 \u51060  \u51068 \u52237 \u51060  \u44256 \u45824  \u47196 \u47560  \u51228 \u44397 \u51060  \u51105 \u44256  \u51080 \u45912  \u44536  \u45733 \u47141 \u44284  \u50948 \u50752  \u44428 \u49464 \u47484  \u44228 \u49849 \u54620  \u48277 \u50773 \u44428 \u51012  \u45824 \u54364 \u54620 \u45796 . \u54364 \u48276 \u44284  \u48708 \u49847 \u54620  \u51060  \u51664 \u49849 \u50640  \u45824 \u54616 \u50668  \u45796 \u51020 \u44284  \u44057 \u51060  \u44592 \u47197 \u46104 \u50612  \u51080 \u45796 . \'93\u46608  \u51664 \u49849 \u51060  \u53360  \u47568 \u44284  \u52280 \u46988 \u46108  \u47568 \u54616 \u45716  \u51077 \u51012  \u48155 \u44256 \'85\u51664 \u49849 \u51060  \u51077 \u51012  \u48268 \u47140  \u54616 \u45208 \u45784 \u51012  \u54693 \u54616 \u50668  \u55036 \u48169 \u54616 \u46104  \u44536 \u51032  \u51060 \u47492 \u44284  \u44536 \u51032  \u51109 \u47561  \u44263  \u54616 \u45720 \u50640  \u44144 \u54616 \u45716  \u51088 \u46308 \u51012  \u55036 \u48169 \u54616 \u45908 \u46972  \u46608  \u44428 \u49464 \u47484  \u48155 \u50500  \u49457 \u46020 \u46308 \u44284  \u49912 \u50892  \u51060 \u44592 \u44172  \u46104 \u44256  \u44033  \u51313 \u49549 \u44284  \u48177 \u49457 \u44284  \u48169 \u50616 \u44284  \u45208 \u46972 \u47484  \u45796 \u49828 \u47532 \u45716  \u44428 \u49464 \u47484  \u48155 \u51004 \u45768 \'94\u46972 . \u45796 \u45768 \u50648 \u49436  7\u51109 \u50640  \u44592 \u47197 \u4610