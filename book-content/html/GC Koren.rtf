\uc0\u47566 \u51008  \u49324 \u46988 \u51060  \u47196 \u47560 \u44368 \u51032  \u51452 \u51109 \u51060  \u44536 \u47495 \u46108  \u44163 \u51076 \u51012  \u48708 \u47196 \u49548  \u44648 \u45804 \u50520 \u45796 . \u44536 \u46308 \u51008  \u51396 \u51064 \u51012  \u50948 \u54616 \u50668  \u49324 \u46988 \u51060 \u45208  \u52380 \u49324 \u51032  \u51473 \u48372 \u44032  \u52280 \u51004 \u47196  \u47924 \u51061 \u54616 \u45796 \u45716  \u44163 \u51012  \u50508 \u50520 \u45796 . \u52280  \u48731 \u51060  \u44536 \u46308 \u51032  \u47560 \u51020 \u50640  \u48708 \u52712 \u44172  \u46104 \u51088  \u44536 \u46308 \u51008  \u45320 \u47924 \u45208  \u44592 \u48848 \u49436  \u44536 \u47532 \u49828 \u46020 \u45716  \u45208 \u51032  \u51228 \u49324 \u51109 \u51060 \u49884 \u50836 , \u44536 \u48516 \u51032  \u54588 \u45716  \u45208 \u51032  \u51228 \u47932 \u51060 \u50836 , \u44536 \u48516 \u51032  \u51228 \u45800 \u51008  \u45208 \u51032  \u52280 \u54924 \u49892 \u51060 \u46972 \u44256  \u48512 \u47476 \u51670 \u50632 \u45796 . \u44536 \u46308 \u51008  \u44536 \u47532 \u49828 \u46020 \u51032  \u44277 \u47196 \u50640  \u51088 \u44592  \u51088 \u49888 \u46308 \u51012  \u50728 \u51204 \u55176  \u47585 \u44592 \u44256  \'93\u48127 \u51020 \u51060  \u50630 \u51008 \u51593  \u54616 \u45208 \u45784 \u51012  \u44592 \u49240 \u49884 \u44172  \u47803 \u54616 \u45208 \u45768 \'94 (\u55176  11:6 \u44396 \u50669 ), \'93\u45796 \u47480  \u51060 \u47196 \u49436 \u45716  \u44396 \u50896 \u51012  \u50619 \u51012  \u49688  \u50630 \u45208 \u45768  \u52380 \u54616  \u51064 \u44036 \u50640  \u44396 \u50896 \u51012  \u50619 \u51012  \u47564 \u54620  \u45796 \u47480  \u51060 \u47492 \u51012  \u50864 \u47532 \u50640 \u44172  \u51452 \u49888  \u51068 \u51060  \u50630 \u51020 \u51060 \u45768 \u46972 \'94 (\u54665  4:12) \u45716  \u47568 \u50432 \u51012  \u46104 \u54400 \u51060 \u54616 \u50688 \u45796 .\
\uc0\u44396 \u51452 \u51032  \u49324 \u46993 \u51032  \u48372 \u51613 \u51008  \u51060 \u50752  \u44057 \u51060  \u44032 \u47144 \u54616 \u44256  \u48264 \u48124 \u50640  \u49324 \u47196 \u51105 \u54784  \u51080 \u45716  \u49900 \u47161 \u46308 \u51060  \u44648 \u45804 \u51012  \u49688  \u50630 \u51004 \u47532  \u47564 \u53372  \u54413 \u49457 \u54620  \u44163 \u52376 \u47100  \u48372 \u50688 \u45796 . \u44536 \u44163 \u51060  \u44536 \u46308 \u50640 \u44172  \u44536 \u52376 \u47100  \u53360  \u50504 \u46020 \u44048 \u51012  \u44032 \u51256 \u45796 \u51452 \u44256  \u44536 \u52376 \u47100  \u45336 \u52432 \u55120 \u47476 \u45716  \u48157 \u51008  \u48731 \u51012  \u48155 \u44172  \u46104 \u50632 \u51004 \u48064 \u47196  \u47560 \u52824  \u52380 \u44397 \u51004 \u47196  \u50734 \u44200 \u51652  \u46319 \u51060  \u49373 \u44033 \u46104 \u50632 \u45796 . \u44536 \u46308 \u51032  \u49552 \u51008  \u49888 \u47280 \u54616 \u45716  \u53468 \u46020 \u47196  \u44536 \u47532 \u49828 \u46020 \u51032  \u49552 \u50640  \u48537 \u51105 \u54784  \u51080 \u50632 \u44256 , \u44536 \u46308 \u51032  \u48156 \u51008  \u47564 \u49464  \u48152 \u49437  \u50948 \u50640  \u49436  \u51080 \u50632 \u45796 . \u51453 \u51020 \u50640  \u45824 \u54620  \u47784 \u46304  \u46160 \u47140 \u50880 \u51060  \u50630 \u50612 \u51276 \u45796 . \u44536 \u46308 \u51008  \u51060 \u51228  \u44536 \u46308 \u51032  \u44396 \u51452 \u51032  \u51060 \u47492 \u51012  \u50689 \u54868 \u47213 \u44172  \u54624  \u49688  \u51080 \u45716  \u51068 \u51060 \u46972 \u47732  \u44048 \u50725 \u51060 \u45208  \u54868 \u54805 \u51452 \u46020  \u45804 \u44172  \u48155 \u51012  \u49688  \u51080 \u44172  \u46104 \u50632 \u45796 .\
\uc0\u51060 \u50752  \u44057 \u51008  \u48169 \u48277 \u51004 \u47196  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51008  \u50500 \u47924 \u46020  \u47784 \u47476 \u45716  \u51109 \u49548 \u50640 \u49436  \u50668 \u47084  \u49324 \u46988 \u46308 \u50640 \u44172  \u51069 \u54784 \u51276 \u45796 . \u50612 \u46500  \u46412 \u50640 \u45716  \u50724 \u51649  \u54620  \u49324 \u46988 \u50640 \u44172 , \u46608  \u50612 \u46500  \u46412 \u50640 \u45716  \u48731 \u44284  \u51652 \u47532 \u47484  \u49324 \u47784 \u54616 \u45716  \u51201 \u51008  \u47924 \u47532 \u50640 \u44172  \u51069 \u54784 \u51276 \u45796 . \u46412 \u47196 \u45716  \u48164 \u51012  \u49352 \u50892 \u44032 \u47732 \u49436  \u49457 \u44221 \u51012  \u51069 \u50612  \u51452 \u50632 \u45796 . \u46307 \u45716  \u49324 \u46988 \u46308 \u51008  \u45320 \u47924 \u45208  \u44048 \u53444 \u54616 \u44256  \u45440 \u46992 \u44592  \u46412 \u47928 \u50640  \u44396 \u50896 \u51032  \u44592 \u48324 \u51012  \u44648 \u45804 \u51012  \u46412 \u44620 \u51648  \u51088 \u48708 \u51032  \u49324 \u51088 \u46308 \u51060  \u45229 \u46021 \u54616 \u45716  \u51068 \u51012  \u51473 \u45800 \u54616 \u51648  \u47803 \u54616 \u46020 \u47197  \u44053 \u50836 \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u51333 \u51333  \u54616 \u45208 \u45784 \u44760 \u49436  \u45208 \u51032  \u50696 \u47932 \u51012  \u48155 \u50500  \u51452 \u49892 \u44620 , \u44284 \u50672  \u45236 \u44172  \u45824 \u54616 \u50668  \u48120 \u49548 \u47484  \u51648 \u51004 \u49892 \u44620 , \u44536 \u48516 \u44760 \u49436  \u45208 \u51032  \u51396 \u47484  \u50857 \u49436 \u54616 \u50668  \u51452 \u49892 \u44620  \u54616 \u45716  \u47568 \u46308 \u51012  \u54616 \u50688 \u45796 . \u44536 \u47084 \u47732  \u44536  \u45824 \u45813 \u51004 \u47196  \'93\u49688 \u44256 \u54616 \u44256  \u47924 \u44144 \u50868  \u51664  \u51652  \u51088 \u46308 \u50500  \u45796  \u45236 \u44172 \u47196  \u50724 \u46972  \u45236 \u44032  \u45320 \u55148 \u47484  \u49772