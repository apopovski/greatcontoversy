\f1\b0 \cf0 \
\uc0\u44536 \u47084 \u45208  \u51060 \u50752  \u44057 \u51008  \u51088 \u50976 \u47484  \u50780 \u44257 \u49884 \u53412 \u44592 \u47196  \u51089 \u51221 \u54620  \u51088 \u44032  \u51080 \u50632 \u45796 . \u51396 \u45716  \u44536 \u47532 \u49828 \u46020  \u45796 \u51020 \u51004 \u47196  \u54616 \u45208 \u45784 \u44760  \u44032 \u51109  \u53360  \u53945 \u44428 \u51012  \u48155 \u44256  \u54616 \u45720  \u51452 \u48124 \u46308  \u51473 \u50640 \u49436  \u52572 \u44256 \u51032  \u44428 \u50948 \u50752  \u50689 \u44305 \u51012  \u44032 \u51652  \u51088 \u47196  \u47568 \u48120 \u50516 \u50500  \u49884 \u51089 \u46104 \u50632 \u45796 . \u47336 \u49828 \u48296 \u51008  \u53440 \u46973 \u54616 \u44592  \u51204 \u50640  \u44144 \u47337 \u54616 \u44256  \u49692 \u44208 \u54620  \u45934 \u45716  \'93\u44536 \u47353 \'94\u46308  \u51473  \u51004 \u46904 \u51060 \u50632 \u45796 . \'93\u51452  \u50668 \u54840 \u50752 \u51032  \u47568 \u50432 \u50640  \u45320 \u45716  \u50756 \u51204 \u54620  \u51064 \u51060 \u50632 \u44256  \u51648 \u54812 \u44032  \u52649 \u51313 \u54616 \u47728  \u50728 \u51204 \u55176  \u50500 \u47492 \u45796 \u50912 \u46020 \u45796  \u45348 \u44032  \u50715 \u51201 \u50640  \u54616 \u45208 \u45784 \u51032  \u46041 \u49328  \u50640 \u45940 \u50640  \u51080 \u50612 \u49436  \u44033 \u51333  \u48372 \u49437 \'85\u51004 \u47196  \u45800 \u51109 \u54616 \u50688 \'94\u46020 \u45796 . \'93\u45320 \u45716  \u44592 \u47492  \u48512 \u51020 \u51012  \u48155 \u51008  \u45934 \u45716  \u44536 \u47353 \u51076 \u51060 \u50668  \u45236 \u44032  \u45320 \u47484  \u49464 \u50864 \u47588  \u45348 \u44032  \u54616 \u45208 \u45784 \u51032  \u49457 \u49328 \u50640  \u51080 \u50612 \u49436  \u54868 \u44305 \u49437  \u49324 \u51060 \u50640  \u50773 \u47000 \u54616 \u50688 \u46020 \u45796  \u45348 \u44032  \u51648 \u51020 \u51012  \u48155 \u45912  \u45216 \u47196 \u48512 \u53552  \u45348  \u47784 \u46304  \u44600 \u50640  \u50756 \u51204 \u54616 \u45908 \u45768  \u47560 \u52840 \u