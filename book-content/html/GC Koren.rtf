\f1\b0 \cf0 \
\uc0\u54004 \u45916 \u51032  \u49444 \u44368 \u45716  \u53360  \u55141 \u48120 \u47484  \u51068 \u51004 \u53040 \u45796 . \u47566 \u51008  \u49324 \u46988 \u46308 \u51060  \u51652 \u47532 \u47484  \u48155 \u50500 \u46308 \u50688 \u45796 . \u44536 \u47084 \u45208  \u49888 \u48512 \u46308 \u46020  \u45130 \u51076 \u50630 \u51060  \u44221 \u49457 \u54616 \u50668  \u44536 \u44032  \u51204 \u46020 \u54616 \u45912  \u51109 \u49548 \u47484  \u46496 \u45208 \u44592 \u47564  \u54616 \u47732  \u44263  \u50948 \u54801 \u44284  \u47924 \u44256  (\u35491 \u21578 ) \u47196 \u50024  \u44536 \u51032  \u49324 \u50629 \u51012  \u47924 \u45320 \u46888 \u47160 \u45796 . \u44536 \u47532 \u54616 \u50668  \u50668 \u47084  \u48264  \u44536 \u46308 \u51008  \u44536  \u51068 \u50640  \u49457 \u44277 \u54616 \u50688 \u45796 . \'93\u50612 \u46523 \u44172  \u54616 \u47732  \u51339 \u51012 \u44620 \'94 \u54616 \u44256  \u44536 \u45716  \u48512 \u47476 \u51670 \u50632 \u45796 . \'93\u45236 \u44032  \u54620  \u44275 \u50640 \u49436  \u50472 \u47484  \u49100 \u47532 \u44256  \u51080 \u45716  \u46041 \u50504  \u50896 \u49688 \u45716  \u51060 \u48120  \u50472 \u47484  \u49100 \u47536  \u48173 \u51012  \u47581 \u44032 \u46888 \u47140  \u48260 \u47536 \u45796 . \u45208 \u45716  \u46041 \u49884 \u50640  \u50612 \u45712  \u44275 \u50640 \u45208  \u51080 \u51012  \u49688  \u50630 \u45796 . \u47564 \u51068  \u44536 \u47532 \u49828 \u46020 \u51064 \u46308 \u51060  \u51088 \u44592  \u45208 \u46972 \u51032  \u47568 \u47196  \u46108  \u49457 \u44221 \u51012  \u44032 \u51656  \u49688 \u47564  \u51080 \u45796 \u47732  \u44536 \u46308 \u51008  \u49828 \u49828 \u47196 \u51032  \u55192 \u51004 \u47196  \u44536 \u47088  \u44452 \u48320 \u51088 \u46308 \u51012  \u45824 \u54637 \u54624  \u49688  \u51080 \u51012  \u44163 \u51060 \u45796 . \u49457 \u44221 \u51060  \u50630 \u51060 \u45716  \u51068 \u48152  \u49888 \u51088 \u46308 \u51012  \u51652 \u47532  \u50504 \u50640  \u44403 \u44172  \u49464 \u50872  \u49688  \u50630 \u45796 \'94 (D\'92Aubigne, History of the Reformation of the Sixteenth Century, b.18, ch.4).\
\uc0\u51060 \u51228  \u49352 \u47196 \u50868  \u47785 \u51201 \u51060  \u44536 \u51032  \u47560 \u51020 \u51012  \u51216 \u47161 \u54616 \u44172  \u46104 \u50632 \u45796 . \u44536 \u45716  \u47568 \u54616 \u50688 \u45796 . \'93\u51060 \u49828 \u46972 \u50648  \u49324 \u46988 \u51060  \u50668 \u54840 \u50752 \u51032  \u49457 \u51204 \u50640 \u49436  \u49884 \u54200 \u51012  \u49569 \u50689 \u54620  \u44163 \u51008  \u51060 \u49828 \u46972 \u50648  \u47568 \u51060 \u50632 \u45796 . \u44536 \u47111 \u45796 \u47732  \u50864 \u47532 \u46308 \u51060  \u50689 \u44397  \u47568 \u47196  \u48373 \u51020 \u51012  \u51060 \u50556 \u44592 \u54644 \u49436 \u45716  \u50504  \u46104 \u45716 \u44032 ?\'85\u44368 \u54924 \u45716  \u45824 \u45230 \u50640  \u49352 \u48317 \u48731 \u48372 \u45796  \u45908  \u55148 \u48120 \u54620  \u48731 \u51012  \u44032 \u51256 \u50556  \u54624  \u44163 \u51064 \u44032 ?\'85\u44536 \u47532 \u49828 \u46020 \u51064 \u46308 \u51008  \u49888 \u50557  \u49457 \u44221 \u51012  \u48152 \u46300 \u49884  \u51088 \u44397 \u50612 \u47196  \u51069 \u51648  \u50506 \u51004 \u47732  \u50504  \u46108 \u45796 .\'94 \u44368 \u54924 \u51032  \u48149 \u49324 \u46308 \u44284  \u44368 \u49324 \u46308  \u49324 \u51060 \u50640 \u49436 \u46020  \u49436 \u47196  \u51032 \u44204 \u51032  \u52264 \u51060 \u44032  \u51080 \u50632 \u45796 . \u44536 \u47084 \u45208  \u50724 \u51649  \u49457 \u44221 \u51004 \u47196 \u50024 \u47564  \u49324 \u46988 \u46308 \u51008  \u51652 \u47532 \u50640  \u46020 \u45804 \u54624  \u49688  \u51080 \u45796 . \'93\u50612 \u46500  \u49324 \u46988 \u51008  \u51060  \u48149 \u49324 \u51032  \u51032 \u44204 \u51012 , \u45796 \u47480  \u49324 \u46988 \u51008  \u51200  \u48149 \u49324 \u51032  \u51032 \u44204 \u51012  \u51648 \u51648 \u54620 \u45796 . \'85 \u51200 \u51088  (\u33879 \u32773 ) \u46308 \u51008  \u54588 \u52264 \u50640  \u51032 \u44204 \u51060  \u54633 \u54616 \u51648  \u50506 \u45716 \u45796 . \u44536 \u47084 \u54620  \u44221 \u50864 \u50640  \u50864 \u47532 \u45716  \u45572 \u44032  \u48148 \u47476 \u44256  \u45572 \u44032  \u44536 \u47495 \u46108 \u51648 \u47484  \u50612 \u46523 \u44172  \u54032 \u45800 \u54624  \u49688  \u51080 \u51012  \u44163 \u51064 \u44032 ?\'85 \u44536 \u44163 \u51008  \u50724 \u51649  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51004 \u47196 \u50024 \u51060 \u45796 \'94 (D\'92Aubigne, History of the Reformation of the Sixteenth Century, b.18, ch.4).\
\uc0\u44536  \u51068  \u54980  \u50724 \u47000 \u51648  \u50506 \u50500 \u49436  \u54617 \u49885  \u51080 \u45716  \u47196 \u47560 \u44368 \u51032  \u54620  \u48149 \u49324 \u45716  \u44536 \u47196  \u45908 \u48520 \u50612  \u45436 \u51137 \u54616 \u47732 \u49436  \'93\u50864 \u47532 \u45716  \u48277 \u50773 \u51032  \u50984 \u48277 \u51012  \u48260 \u47532 \u44592 \u48372 \u45796 \u45716  \u52264 \u46972 \u47532  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51012  \u48260 \u47532 \u45716  \u44163 \u51060  \u45227 \u45796 \'94\u44256  \u54616 \u50688 \u45796 . \u51060 \u50640  \u45824 \u54616 \u50668  \u54004 \u45916 \u51008  \'93\u45208 \u45716  \u48277 \u50773 \u44284  \u44536 \u51032  \u47784 \u46304  \u50984 \u48277 \u51012  \u47924 \u49884 \u54620 \u45796 . \'85\u44536 \u47532 \u44256  \u47564 \u51068  \u54616 \u45208 \u45784 \u44760 \u49436  \u45208 \u51032  \u49373 \u47749 \u51012  \u48372 \u51204 \u54616 \u50668  \u51452 \u49888 \u45796 \u47732  \u50724 \u47000 \u51648  \u50500 \u45768 \u54616 \u50668  \u45208 \u45716  \u48173 \u51012  \u44040 \u44256  \u51080 \u45716  \u49548 \u45380 \u51060  \u44536 \u45824 \u48372 \u45796  \u49457 \u44221 \u51012  \u45908  \u47566 \u51060  \u50508 \u46020 \u47197  \u54624  \u44163 \u51060 \u45796 \'94 (Anderson, Annals of the English Bible, p.19) \u44256  \u45824 \u45813 \u54616 \u50688 \u45796 .\
\uc0\u51088 \u44592  \u45208 \u46972 \u51032  \u47568 \u47196  \u46108  \u49888 \u50557  \u49457 \u44221 \u51012  \u49324 \u46988 \u46308 \u50640 \u44172  \u45208 \u45572 \u50612  \u51452 \u44192 \u45796 \u44256  \u47560 \u51020 \u49549 \u50640  \u44036 \u51649 \u54616 \u44592  \u49884 \u51089 \u54664 \u45912  \u54004 \u45916 \u51032  \u47785 \u51201 \u51008  \u54620 \u52789  \u45908  \u44403 \u50612 \u51276 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u45716  \u44263  \u44536  \u49324 \u50629 \u50640  \u47792 \u46160 \u54616 \u50688 \u45796 . \u44536 \u45716  \u48149 \u54644 \u47196  \u51064 \u54616 \u50668  \u51665 \u50640 \u49436  \u51923 \u44200 \u45208 \u49436  \u47088 \u45912 \u51004 \u47196  \u44052 \u45796 . \u44536 \u45716  \u50620 \u47560  \u46041 \u50504  \u44536  \u44275 \u50640 \u49436  \u50500 \u47924 \u47088  \u48169 \u54644  \u50630 \u51060  \u44536 \u51032  \u51068 \u50640  \u47792 \u46160 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u48277 \u50773 \u44368 \u46020 \u46308 \u51032  \u54253 \u46041 \u51004 \u47196  \u45796 \u49884  \u46020 \u47581 \u54624  \u49688 \u48150 \u50640  \u50630 \u50632 \u45796 . \u50728  \u50689 \u44397 \u51060  \u44536 \u50640  \u45824 \u54616 \u50668  \u48393 \u49604 \u46108  \u46319 \u54616 \u50688 \u51004 \u48064 \u47196  \u44536 \u45716  \u46021 \u51068 \u50640 \u49436  \u54588 \u45212 \u52376 \u47484  \u52286 \u44256 \u51088  \u44208 \u49900 \u54616 \u50688 \u45796 . \u44144 \u44592 \u49436  \u44536 \u45716  \u50689 \u50612  \u49888 \u50557  \u49457 \u44221 \u51032  \u51064 \u49604 \u47484  \u49884 \u51089 \u54616 \u50688 \u45796 . \u46160  \u48264 \u51060 \u45208  \u44536 \u51032  \u49324 \u50629 \u51008  \u51221 \u51648 \u47484  \u45817 \u54616 \u50688 \u51004 \u45208  \u51060  \u46020 \u49884 \u50640 \u49436  \u51064 \u49604 \u54624  \u49688  \u50630 \u51004 \u47732  \u51200  \u46020 \u49884 \u47196  \u44032 \u44256 , \u51200  \u46020 \u49884 \u50640 \u49436  \u51064 \u49604 \u54624  \u49688  \u50630 \u51004 \u47732  \u46608  \u45796 \u47480  \u46020 \u49884 \u47196  \u44052 \u45796 . \u47560 \u52840 \u45236  \u44536 \u45716  \u48372 \u47492 \u49828 \u47484  \u54693 \u54616 \u50668  \u44052 \u45716 \u45936 , \u44536  \u44275 \u51008  \u47751  \u45380  \u51204 \u50640  \u44397 \u54924 \u50640 \u49436  \u47336 \u53552 \u44032  \u48373 \u51020 \u51012  \u50745 \u54840 \u54620  \u44275 \u51060 \u50632 \u45796 . \u51060  \u44256 \u45824  \u46020 \u49884 \u50640 \u45716  \u44060 \u54785  \u49324 \u50629 \u51032  \u52828 \u44396 \u46308 \u51060  \u47566 \u51060  \u51080 \u50632 \u51004 \u48064 \u47196  \u54004 \u45916 \u51008  \u45908  \u51060 \u49345 \u51032  \u48169 \u54644 \u47484  \u48155 \u51648  \u50506 \u44256  \u44536 \u51032  \u49324 \u50629 \u51012  \u44228 \u49549 \u54616 \u44172  \u46104 \u50632 \u45796 . \u50724 \u47000 \u51648  \u50506 \u50500  3\u52380 \u48512 \u51032  \u49888 \u50557  \u49457 \u44221 \u51060  \u52636 \u54032 \u46104 \u50632 \u51004 \u47728 , \u44057 \u51008  \u54644 \u50640  \u45796 \u49884  \u51116 \u54032 \u44620 \u51648  \u54616 \u44172  \u46104 \u50632 \u45796 .\
\uc0\u44536 \u45716  \u53360  \u50676 \u49900 \u44284  \u51064 \u45236 \u47196 \u50024  \u49324 \u50629 \u51012  \u44228 \u49549 \u54616 \u50688 \u45796 . \u50689 \u44397  \u45817 \u44397 \u51088 \u46308 \u51060  \u47932 \u49360 \u53960 \u50630 \u51060  \u44033  \u54637 \u44396 \u47484  \u51648 \u53040 \u51020 \u50640 \u46020  \u48520 \u44396 \u54616 \u44256  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51008  \u50668 \u47084  \u44032 \u51648  \u48169 \u48277 \u51004 \u47196  \u47088 \u45912 \u51004 \u47196  \u47792 \u47000  \u44148 \u45320 \u44032 \u44172  \u46104 \u50632 \u44256 , \u44144 \u44592 \u49436  \u45796 \u49884  \u51204 \u44397 \u51004 \u47196  \u51204 \u54644 \u51648 \u44172  \u46104 \u50632 \u45796 . \u48277 \u50773 \u44368 \u46020 \u46308 \u51008  \u51652 \u47532 \u47484  \u50613 \u50517 \u54616 \u47140 \u44256  \u50728 \u44054  \u45432 \u47141 \u51012  \u45796 \u54616 \u50688 \u51648 \u47560 \u45716  \u47784 \u46160  \u54728 \u49324 \u44032  \u46104 \u50632 \u45796 . \u54620  \u48264 \u51008  \u45908 \u54660  (Durham) \u51032  \u44048 \u46021 \u51060  \u49457 \u44221 \u51012  \u54032 \u47588 \u54616 \u45716  \u54004 \u45916 \u51032  \u46041 \u47308 \u47196 \u48512 \u53552  \u49457 \u44221 \u51012  \u51080 \u45716  \u45824 \u47196  \u45796  \u49344 \u45796 . \u44536 \u45716  \u44536  \u49457 \u44221 \u46308 \u51012  \u50630 \u50528  \u48260 \u47548 \u51004 \u47196  \u44060 \u54785  \u49324 \u50629 \u51012  \u53356 \u44172  \u48169 \u54644 \u54624  \u49688  \u51080 \u51004 \u47532 \u46972 \u44256  \u49373 \u44033 \u54616 \u50688 \u44592  \u46412 \u47928 \u51060 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44536 \u50752 \u45716  \u48152 \u45824 \u47196  \u44536  \u44048 \u46021 \u51060  \u45240  \u46024 \u51060  \u50500 \u45768 \u50632 \u45796 \u47732  \u48156 \u54665 \u54624  \u49688  \u50630 \u50632 \u45912  \u49352 \u47213 \u44256  \u45908 \u50865  \u51339 \u51008  \u49888 \u54032 \u51012  \u45244  \u49688  \u51080 \u45716  \u51116 \u47308 \u47484  \u49332  \u49688  \u51080 \u44172  \u46104 \u50632 \u45796 . \u44536  \u54980 \u50640  \u54004 \u45916 \u51060  \u52404 \u54252 \u45817 \u54616 \u50688 \u51012  \u46412 , \u44536 \u45716  \u49457 \u44221  \u51064 \u49604 \u51032  \u48708 \u50857 \u51012  \u45824 \u50612  \u51456  \u49324 \u46988 \u51032  \u51060 \u47492 \u51012  \u50508 \u47140  \u51452 \u47732  \u49437 \u48169 \u49884 \u53020  \u51452 \u44192 \u45796 \u45716  \u47568 \u51012  \u46307 \u44172  \u46104 \u50632 \u45796 . \u44536 \u45716  \u45796 \u47480  \u50612 \u46500  \u49324 \u46988 \u48372 \u45796  \u45908 \u50865  \u47566 \u51008  \u48372 \u51312 \u47484  \u54644 \u51456  \u49324 \u46988 \u51060  \u45908 \u54660 \u51032  \u44048 \u46021 \u51060 \u50632 \u45796 \u44256  \u45824 \u45813 \u54616 \u50688 \u45796 . \u44536  \u44048 \u46021 \u51060  \u47561 \u45824 \u54620  \u44552 \u50529 \u51004 \u47196  \u49457 \u44221 \u51012  \u49324 \u46308 \u51064  \u44620 \u45805 \u50640  \u54004 \u45916 \u51008  \u54620 \u52789  \u50857 \u44592 \u47484  \u50619 \u50612  \u49324 \u50629 \u51012  \u44228 \u49549 \u54624  \u49688  \u51080 \u50632 \u44592  \u46412 \u47928 \u51060 \u50632 \u45796 .\
\uc0\u54004 \u45916 \u51008  \u48176 \u48152 \u51088 \u47196  \u51064 \u54616 \u50668  \u50896 \u49688 \u46308 \u51032  \u49552 \u50640  \u51105 \u55176 \u50612  \u50668 \u47084  \u45804  \u46041 \u50504  \u44048 \u50725 \u50640 \u49436  \u44256 \u49373 \u51012  \u54616 \u50688 \u45796 . \u44536 \u45716  \u47560 \u52840 \u45236  \u49692 \u44368 \u47196  \u51088 \u49888 \u51032  \u49888 \u50521 \u51012  \u51613 \u44144 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u44032  \u47560 \u47144 \u54644 \u51456  \u47924 \u44592 \u45716  \u44536  \u54980  \u50724 \u45720 \u45216 \u50640  \u51060 \u47476 \u44592 \u44620 \u51648  \u44033  \u49884 \u45824 \u47484  \u53685 \u54616 \u50668  \u48373 \u51020 \u51032  \u44400 \u48337 \u46308 \u47196  \u54616 \u50668 \u44552  \u44228 \u49549 \u54644 \u49436  \u51204 \u51137 \u51012  \u54624  \u49688  \u51080 \u44172  \u54644 \u51452 \u50632 \u45796 .\
