\uc0\u51060  \u45436 \u51137 \u51008  \u45796 \u47480  \u44163 \u50640  \u48708 \u54616 \u47732  \u50500 \u51452  \u51089 \u51008  \u44508 \u47784 \u50688 \u51004 \u45208  \u44536 \u44163 \u51008  \'93\u44060 \u54785 \u51088 \u52769 \u50640  \u50612 \u46496 \u54620  \u44228 \u52789 \u44284  \u49324 \u46988 \u51060  \u49549 \u54644  \u51080 \u45796 \u45716  \u44163 \'94\u51012  \u50864 \u47532 \u50640 \u44172  \u48157 \u55176  \u50508 \u47140  \u51452 \u44256  \u51080 \u45796 . \'93\u44536 \u46308 \u51008  \u47924 \u49885 \u54620  \u47924 \u47532 \u46308 \u51060  \u50500 \u45768 \u50632 \u45796 . \u44536 \u47111 \u45796 \u44256  \u44536 \u46308 \u51008  \u51333 \u54028 \u49900 \u51060  \u44053 \u47148 \u54620  \u49324 \u46988 \u46308 \u46020  \u50500 \u45768 \u50632 \u44256 , \u45436 \u51137 \u54616 \u44592 \u47484  \u51339 \u50500 \u54616 \u45716  \u49324 \u46988 \u46308 \u46020  \u50500 \u45768 \u50632 \u45796 . \u44536 \u47088  \u49324 \u46988 \u46308 \u44284 \u45716  \u51204 \u50672  \u45796 \u47480  \u49324 \u46988 \u46308 \u51060 \u50632 \u45796 . \u44536 \u46308 \u51008  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51012  \u50672 \u44396 \u54620  \u49324 \u46988 \u46308 \u51060 \u50632 \u44256 , \u49457 \u44221 \u51060  \u44277 \u44553 \u54644  \u51452 \u45716  \u47924 \u44592 \u47484  \u51096  \u49324 \u50857 \u54624  \u51460  \u50500 \u45716  \u49324 \u46988 \u46308 \u51060 \u50632 \u45796 . \u54617 \u47928 \u51201 \u51064  \u47732 \u50640 \u49436  \u44536 \u46308 \u51008  \u49884 \u45824 \u51032  \u49440 \u46160 \u50640  \u49436  \u51080 \u50632 \u45796 . \u48708 \u53584 \u48288 \u47476 \u53356 , \u52712 \u47532 \u55176  \u46321 \u44284  \u44057 \u51008  \u54988 \u47469 \u54620  \u51473 \u49900 \u51648 , \u54841 \u51008  \u47336 \u53552 , \u47708 \u46976 \u55176 \u53668 , \u52768 \u48729 \u44544 \u47532 , \u50640 \u53084 \u46988 \u54028 \u46356 \u50864 \u49828  \u44057 \u51008  \u51064 \u47932 \u46308 \u50640 \u47564  \u51452 \u51032 \u47484  \u51665 \u51473 \u54616 \u44172  \u46104 \u47732 , \u50864 \u47532 \u45716  \u44536 \u50752  \u44057 \u51060  \u51452 \u46020 \u51201  \u50669 \u54624 \u51012  \u54620  \u51109 \u49548 \u45208  \u51064 \u47932 \u46308 \u50640 \u44172 \u47564  \u53360  \u45733 \u47141 \u44284  \u49688 \u54869 \u51012  \u44592 \u45824 \u54616 \u44256  \u44536  \u50808 \u51032  \u51109 \u49548 \u45208  \u49324 \u46988 \u46308 \u51008  \u48324 \u48152  \u49373 \u44033 \u54616 \u51648  \u50506 \u45716  \u44221 \u54693 \u51060  \u51080 \u45796 . \u44536 \u47111 \u45796 \u47732  \u51060 \u51228  \u49828 \u50920 \u45940 \u51032  \u47924 \u45824 \u47196  \u45576 \u51012  \u46028 \u47140  \u50732 \u46972 \u54532 \u50752  \u46972 \u50864 \u47116 \u54000 \u50864 \u49828  \u44057 \u51008  \u48120 \u48120 \u54620  \u51060 \u47492 , \u44263  \u49828 \u49849 \u46308 \u50640 \u44172 \u49436  \u51228 \u51088 \u46308 \u50640  \u51060 \u47476 \u44592 \u44620 \u51648  \u54620  \u48264  \u54993 \u50612 \u48372 \u51088 . \u44144 \u44592 \u49436  \u50864 \u47532 \u45716  \u47924 \u50631 \u51012  \u48156 \u44204 \u54616 \u45716 \u44032 ?\'85 \u54617 \u51088 \u50752  \u49888 \u54617 \u51088 , \u48373 \u51020 \u51032  \u51652 \u47532 \u51032  \u51204  \u52404 \u44228 \u47484  \u50756 \u51204 \u55176  \u51060 \u54644 \u54620  \u49324 \u46988 , \u44452 \u48320 \u54617 \u54028 \u51032  \u54617 \u51088 \u46308 \u44284  \u47196 \u47560 \u44368 \u51032  \u51452 \u44368 \u46308 \u51012  \u49789 \u44172  \u51221 \u48373 \u54620  \u49324 \u46988 \u46308 \u51012  \u48156 \u44204 \u54616 \u44172  \u46112  \u44163 \u51060 \u45796 \'94 (Wylie, b.10, ch.4).\
\uc0\u44536  \u45436 \u51137 \u51032  \u44208 \u44284 \u47196  \u49828 \u50920 \u45940 \u51032  \u50773 \u51008  \u44060 \u54785 \u51452 \u51032 \u47484  \u48155 \u50500 \u46308 \u51060 \u44172  \u46104 \u50632 \u44256 , \u50620 \u47560  \u54980 \u50640  \u44397 \u54924 \u44032  \u44060 \u54785 \u51452 \u51032 \u50640  \u45824 \u54616 \u50668  \u52268 \u49457 \u51032  \u46907 \u51012  \u49440 \u50616 \u54616 \u50688 \u45796 . \u49888 \u50557  \u49457 \u44221 \u51008  \u50732 \u46972 \u54532  \u54168 \u53944 \u47532 \u50640  \u51032 \u54616 \u50668  \u49828 \u50920 \u45940 \u50612 \u47196  \u48264 \u50669 \u46104 \u50632 \u51004 \u47728 , \u50773 \u51032  \u55148 \u47581 \u50640  \u46384 \u46972  \u44536  \u46160  \u54805 \u51228 \u45716  \u49457 \u44221  \u51204 \u54200 \u51032  \u48264 \u50669 \u50640  \u52265 \u49688 \u54616 \u50688 \u45796 . \u51060 \u47532 \u54616 \u50668  \u49828 \u50920 \u45940 \u51032  \u44397 \u48124 \u46308 \u51008  \u48708 \u47196 \u49548  \u51088 \u44592  \u45208 \u46972 \u51032  \u47568 \u47196  \u46108  \u49457 \u44221 \u51012  \u44032 \u51648 \u44172  \u46104 \u50632 \u45796 . \u46608  \u44397 \u54924 \u45716  \u49457 \u51649 \u50640  \u51080 \u45716  \u49324 \u46988 \u46308 \u51060  \u44397 \u45236 \u51032  \u50612 \u45712  \u44275 \u50640 \u49436 \u45208  \u49457 \u44221 \u51012  \u49444 \u47749 \u54624  \u49104 \u47564  \u50500 \u45768 \u46972  \u54617 \u44368 \u50640 \u49436 \u46020  \u54617 \u49373 \u46308 \u50640 \u44172  \u49457 \u44221  \u51069 \u45716  \u48277 \u51012  \u44032 \u47476 \u52432  \u51452 \u50612 \u50556  \u54620 \u45796 \u44256  \u44508 \u51221 \u54616 \u50688 \u45796 .\
\uc0\u51216 \u52264 \u51201 \u51004 \u47196 , \u44536 \u47084 \u45208  \u54869 \u49892 \u55176  \u47924 \u51648 \u50752  \u48120 \u49888 \u51032  \u50516 \u55121 \u51008  \u48373 \u46108  \u48373 \u51020 \u51032  \u48731 \u51004 \u47196  \u47568 \u48120 \u50516 \u50500  \u49324 \u46972 \u51256  \u44032 \u44256  \u51080 \u50632 \u45796 . \u47196 \u47560 \u44368 \u51032  \u50517 \u48149 \u50640 \u49436  \u54644 \u48169 \u46108  \u44536  \u45208 \u46972 \u45716  \u51648 \u44552 \u44620 \u51648  \u51068 \u52237 \u51060  \u44221 \u54744 \u54616 \u51648  \u47803 \u54620  \u55192 \u44284  \u50948 \u45824 \u49457 \u51012  \u49548 \u50976 \u54616 \u44172  \u46104 \u50632 \u45796 . \u49828 \u50920 \u45940 \u51008  \u44060 \u49888 \u44368 \u51032  \u54620  \u48372 \u47336 \u44032  \u46104 \u50632 \u45796 . 1\u49464 \u44592  \u54980  \u48708 \u49345 \u54620  \u50948 \u54744 \u51060  \u45796 \u44032 \u50772 \u51012  \u46412 , \u49828 \u50920 \u45940 \u51008  \u51068 \u44060 \u51032  \u51089 \u51008  \u45208 \u46972 \u51068 \u51648 \u46972 \u46020  30\u45380  \u51204 \u51137 \u51032  \u52824 \u50676 \u54620  \u49912 \u50880 \u51012  \u52824 \u47476 \u44256  \u51080 \u45716  \u50976 \u47101 \u50640 \u49436  \u46021 \u51068 \u51012  \u44396 \u50896 \u54620  \u50976 \u47101 \u50640 \u49436 \u51032  \u50976 \u51068 \u54620  \u45208 \u46972 \u44032  \u46104 \u50632 \u45796 . \u50728  \u48513 \u50976 \u47101 \u51060  \u45796 \u49884  \u47196 \u47560 \u44368 \u51032  \u54617 \u51221  \u50500 \u47000  \u46308 \u50612 \u44032 \u45716  \u46319 \u54616 \u50688 \u45796 . \u44536 \u47084 \u51088  \u49828 \u50920 \u45940 \u51032  \u44400 \u45824  \u46412 \u47928 \u50640  \u46021 \u51068 \u51008  \u48277 \u50773 \u44368 \u51032  \u54945 \u54252 \u47484  \u47932 \u47532 \u52824 \u44256  \u44060 \u54785 \u51452 \u51032 \u47484  \u49888 \u48393 \u54616 \u45716  \u47336 \u53552 \u44368 \u46020 \u50752  \u52860 \u48712 \u54028 \u47484  \u50948 \u54616 \u50668  \u49888 \u44368 \u51032  \u51088 \u5097