\uc0\u44536 \u47084 \u45208  \u47196 \u47560 \u45716  \u50689 \u44397 \u51012  \u51452 \u49884 \u54616 \u44256 , \u44536 \u44163 \u51012  \u51088 \u44592 \u51032  \u54056 \u44428  \u50500 \u47000  \u45347 \u51004 \u47140 \u44256  \u44208 \u49900 \u54616 \u50688 \u45796 . 6\u49464 \u44592 \u50640  \u48277 \u50773 \u44368 \u51032  \u49440 \u44368 \u49324 \u46308 \u51008  \u51060 \u44368 \u46020 \u51064  \u49353 \u49832 \u51313 \u51012  \u44060 \u51333 \u49884 \u53412 \u44256 \u51088  \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u44368 \u47564 \u54620  \u50556 \u47564 \u51064 \u46308 \u51032  \u54872 \u49900 \u51012  \u49324 \u49436  \u49688 \u52380  \u47749 \u51012  \u47196 \u47560 \u44368 \u51032  \u49888 \u50521 \u51004 \u47196  \u46028 \u50500 \u50724 \u44172  \u54616 \u50688 \u45796 . \u51060 \u52376 \u47100  \u51068 \u51060  \u49692 \u51312 \u47213 \u44172  \u51652 \u54665 \u46104 \u50612  \u45208 \u44040  \u46412  \u48277 \u50773 \u44368 \u51032  \u49849 \u47140 \u46308 \u44284  \u44060 \u51333 \u51088 \u46308 \u51008  \u49692 \u49688 \u54620  \u44536 \u47532 \u49828 \u46020 \u51064 \u46308 \u44284  \u47560 \u51452 \u52824 \u44172  \u46104 \u50632 \u45796 . \u44536  \u50577 \u51088  \u44036 \u50640 \u45716  \u54788 \u51200 \u54620  \u45824 \u51312 \u44032  \u45208 \u53440 \u45228 \u45796 . \u51204 \u51088 \u45716  \u48277 \u50773 \u44368 \u51032  \u48120 \u49888 \u44284  \u54728 \u49464 \u50752  \u44368 \u47564 \u51012  \u45208 \u53440 \u45236 \u45716  \u48152 \u47732 \u50640  \u54980 \u51088 \u45716  \u45800 \u49692 \u54616 \u44256  \u44216 \u49552 \u54616 \u47728 , \u54408 \u49457 \u44284  \u49888 \u51312 \u50752  \u54665 \u46041  \u46321 \u51060  \u47784 \u46160  \u49457 \u44221 \u44284  \u48512 \u54633 \u46120 \u51012  \u48372 \u50668  \u51452 \u50632 \u45796 . \u48277 \u50773 \u51032  \u49324 \u51208 \u46308 \u51008  \u51060  \u44536 \u47532 \u49828 \u46020 \u44368 \u54924 \u46308 \u50640 \u44172  \u48277 \u50773 \u51032  \u52572 \u49345 \u44428 \u51012  \u51064 \u51221 \u54616 \u46972 \u44256  \u44053 \u50836 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u50689 \u44397 \u51032  \u44536 \u47532 \u49828 \u46020 \u51064 \u46308 \u51008  \u50728 \u50976 \u54620  \u53468 \u46020 \u47196 , \u44536 \u46308 \u51008  \u47784 \u46304  \u51064 \u47448 \u47484  \u49324 \u46993 \u54616 \u44592 \u47484  \u50676 \u47581 \u54616 \u44256  \u51080 \u51648 \u47564  \u48277 \u50773 \u51060  \u44368 \u54924 \u50640 \u49436  \u52572 \u49345 \u44428 \u51012  \u44032 \u51656  \u51088 \u44201 \u51060  \u50630 \u51004 \u48064 \u47196  \u44536 \u47532 \u49828 \u46020 \u47484  \u46384 \u47476 \u45716  \u49324 \u46988 \u46308 \u51060  \u54588 \u52264 \u50640  \u45824 \u54616 \u45716  \u44163 \u44284  \u44057 \u51008  \u44216 \u49552 \u51004 \u47196  \u44536 \u50640 \u44172  \u45824 \u54624  \u49104 \u51060 \u46972 \u44256  \u45824 \u45813 \u54616 \u50688 \u45796 . \u49324 \u51208 \u46308 \u51008  \u47196 \u47560 \u51032  \u48277 \u50773 \u50640 \u44172  \u52649 \u49457 \u51012  \u54364 \u49884 \u54616 \u44172  \u54616 \u44256 \u51088  \u44228 \u49549  \u49884 \u46020 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536  \u44216 \u49552 \u54620  \u44536 \u47532 \u49828 \u46020 \u51064 \u46308 \u51008  \u44144 \u47564 \u54620  \u49324 \u51208 \u46308 \u51032  \u53468 \u46020 \u50640  \u45440 \u46972 \u47732 \u49436  \u50864 \u47532 \u45716  \u44536 \u47532 \u49828 \u46020  \u51060 \u50808 \u51032  \u45796 \u47480  \u51452 \u47484  \u51064 \u51221 \u54624  \u49688  \u50630 \u45432 \u46972 \u44256  \u54869 \u44256 \u54616 \u44172  \u45824 \u45813 \u54616 \u50688 \u45796 . \u44536 \u47084 \u51088  \u48277 \u50773 \u44368 \u51032  \u51221 \u52404 \u45716  \u45208 \u53440 \u45228 \u45796 . \u47196 \u47560 \u44368 \u51032  \u51648 \u46020 \u51088 \u45716  \'93\u45320 \u55148 \u44032  \u54217 \u54868 \u47484  \u44032 \u51256 \u50724 \u45716  \u54805 \u51228 \u46308 \u51012  \u48155 \u50500 \u46308 \u51060 \u51648  \u50506 \u45716 \u45796 \u47732 , \u45320 \u55148 \u45716  \u54596 \u44221  \u51204 \u51137 \u51012  \u44032 \u51256 \u50724 \u45716  \u50896 \u49688 \u47484  \u47582 \u51060 \u54616 \u44256 \u50556  \u47568  \u44163 \u51060 \u45796 . \u45320 \u55148 \u44032  \u49353 \u49832 \u51313 \u50640 \u44172  \u49373 \u47749 \u51032  \u44600 \u51012  \u44032 \u47476 \u52824 \u45716  \u51068 \u50640  \u50864 \u47532 \u50752  \u50672 \u54633 \u54616 \u51648  \u50506 \u45716 \u45796 \u47732 , \u45320 \u55148 \u45716  \u44208 \u44397  \u44536 \u46308 \u50640 \u44172 \u49436  \u51453 \u51020 \u51032  \u47588 \u47484  \u47582 \u44256 \u50556  \u47568  \u44163 \u51060 \u45796 \'94 (J.H.Merle D\'92Aubigne, History of the Reformation of the Sixteenth Century, b.17, ch.2) \u46972 \u44256  \u47568 \u54616 \u50688 \u45796 . \u51060 \u44163 \u51008  \u44540 \u44144  \u50630 \u45716  \u50948 \u54801 \u51060  \u50500 \u45768 \u50632 \u45796 . \u51204 \u51137 \u44284  \u51020 \u47784 \u50752  \u44592 \u47564  \u46321 \u51032  \u50728 \u44054  \u49688 \u45800 \u51060  \u49457 \u44221 \u49345  \u49888 \u50521 \u51012  \u44032 \u51652  \u44536  \u51613 \u51064 \u46308 \u50640  \u45824 \u54616 \u50668  \u49324 \u50857 \u46104 \u50632 \u45796 . \u47560 \u52840 \u45236  \u50689 \u44397 \u51032  \u44368 \u54924 \u46308 \u51008  \u54028 \u44340 \u46104 \u44144 \u45208  \u48277 \u50773 \u44428 \u50640  \u44404 \u48373 \u45817 \u54616 \u44256  \u47568 \u50520 \u45796 .\
