\uc0\u50836 \u54620 \u44228 \u49884 \u47197  17\u51109 \u51032  \u50668 \u51088  (\u48148 \u48296 \u47200 ) \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u47896 \u49324 \u46104 \u50612  \u51080 \u45796 . \'93\u44536  \u50668 \u51088 \u45716  \u51088 \u51452 \u48731 \u44284  \u48521 \u51008  \u48731  \u50743 \u51012  \u51077 \u44256  \u44552 \u44284  \u48372 \u49437 \u44284  \u51652 \u51452 \u47196  \u44984 \u48120 \u44256  \u49552 \u50640  \u44552 \u51092 \u51012  \u44032 \u51276 \u45716 \u45936  \u44032 \u51613 \u54620  \u47932 \u44148 \u44284  \u44536 \u51032  \u51020 \u54665 \u51032  \u45908 \u47084 \u50868  \u44163 \u46308 \u51060  \u44032 \u46301 \u54616 \u45908 \u46972  \u44536  \u51060 \u47560 \u50640  \u51060 \u47492 \u51060  \u44592 \u47197 \u46104 \u50632 \u51004 \u45768  \u48708 \u48128 \u51060 \u46972 , \u53360  \u48148 \u48296 \u47200 \u51060 \u46972  \u46405 \u51032  \u51020 \u45376 \u46308 \u44284  \u44032 \u51613 \u54620  \u44163 \u46308 \u51032  \u50612 \u48120 \u46972 .\'94 \u49440 \u51648 \u51088 \u45716  \'93\u46608  \u45236 \u44032  \u48372 \u47588  \u51060  \u50668 \u51088 \u44032  \u49457 \u46020 \u46308 \u51032  \u54588 \u50752  \u50696 \u49688 \u51032  \u51613 \u51064 \u46308 \u51032  \u54588 \u50640  \u52712 \u54620 \u51648 \u46972 \'94\u44256  \u47568 \u54620 \u45796 . \u46608 \u54620  \u48148 \u48296 \u47200 \u51008  \'93\u46405 \u51032  \u51076 \u44552 \u46308 \u51012  \u45796 \u49828 \u47532 \u45716  \u53360  \u49457 \u51060 \u46972 \'94 (\u44228  17:4~6, 18) \u44256  \u49440 \u54252 \u46104 \u50612  \u51080 \u45796 . \u44536 \u47532 \u49828 \u46020 \u44368 \u44397 \u51032  \u47784 \u46304  \u50773 \u46308 \u50640  \u45824 \u54616 \u50668  \u50668 \u47084  \u49464 \u44592  \u46041 \u50504  \u51204 \u51228 \u51201  \u49464 \u47141 \u51012  \u55064 \u46168 \u47084 \u50728  \u49464 \u47141 \u51008  \u47196 \u47560 \u51060 \u45796 . \u44536  \u51088 \u51452 \u48731 \u44284  \u48521 \u51008  \u48731 \u51060 \u47728 , \u44552 \u44284  \u48372 \u49437 \u44284  \u51652 \u51452 \u45716  \u44144 \u47564 \u54620  \u47196 \u47560  \u48277 \u50773 \u50640  \u51032 \u54616 \u50668  \u52712 \u54644 \u51652  \u51316 \u44480 \u50752  \u51068 \u48152  \u51076 \u44552 \u46308 \u48372 \u45796  \u46832 \u50612 \u45212  \u50948 \u49464 \u47484  \u50668 \u49892 \u55176  \u47896 \u49324 \u54644  \u51456 \u45796 . \u46608 \u54620  \'93\u49457 \u46020 \u46308 \u51032 \'85\u54588 \u50640  \u52712 \u54620 \u51648 \u46972 \'94\u44256  \u44592 \u47197 \u46104 \u50612  \u51080 \u45716 \u45936 , \u44536 \u47532 \u49828 \u46020 \u44368 \u47484  \u47588 \u50864  \u51092 \u54841 \u54616 \u44172  \u48149 \u54644 \u54620  \u47196 \u47560 \u44368  \u51060 \u50808 \u50640 \u45716  \u44536 \u47088  \u49464 \u47141 \u51004 \u47196  \u51064 \u51221 \u48155 \u51012  \u47564 \u54620  \u49464 \u47141 \u51060  \u50630 \u45796 . \u48148 \u48296 \u47200 \u51008  \u46608 \u54620  \'93\u46405 \u51032  \u51076 \u44552 \u46308 \'94\u47196  \u45908 \u48520 \u50612  \u48520 \u48277 \u51201  \u44288 \u44228 \u47484  \u47610 \u45716  \u45936  \u45824 \u54616 \u50668  \u48708 \u45212 \u51012  \u48155 \u44256  \u51080 \u45796 . \u51068 \u52237 \u51060  \u50976 \u45824 \u44368 \u45716  \u51452 \u45784 \u51012  \u46496 \u45208  \u51060 \u44368 \u46020 \u47196  \u45908 \u48520 \u50612  \u46041 \u47609 \u51012  \u47610 \u51020 \u51004 \u47196  \u51020 \u45376 \u44032  \u46104 \u50632 \u45716 \u45936 , \u47196 \u47560 \u44368 \u46020  \u44536 \u50752  \u47560 \u52268 \u44032 \u51648 \u47196  \u49464 \u49549 \u51201  \u44428 \u47141 \u51032  \u51648 \u51648 \u47484  \u48155 \u44592  \u50948 \u54616 \u50668  \u49828 \u49828 \u47196  \u53440 \u46973 \u54632 \u51004 \u47196  \u44536 \u50752  \u46041 \u51068 \u54620  \u51396 \u51032  \u49440 \u44256 \u47484  \u48155 \u44172  \u46108  \u44163 \u51060 \u45796 .\
\uc0\u48148 \u48296 \u47200 \u51008  \'93\u51020 \u45376 \u46308 \'85\u51032  \u50612 \u48120 \'94\u46972 \u44256  \u48520 \u47532 \u44256  \u51080 \u45796 . \u44536 \u47084 \u47732  \u44536  \u51020 \u45376 \u51032  \u46392 \u46308 \u51008  \u44536  \u51020 \u45376 \u51032  \u44368 \u47532 \u50752  \u51204 \u53685 \u51012  \u44536 \u45824 \u47196  \u51060 \u50612 \u48155 \u44256 , \u44536  \u51020 \u45376 \u51032  \u47784 \u48376 \u51012  \u46384 \u46972  \u49464 \u49345 \u44284 \u51032  \u48520 \u48277 \u51201  \u51064 \u50672 \u51012  \u47610 \u44592  \u50948 \u54616 \u50668  \u54616 \u45208 \u45784 \u51032  \u51652 \u47532 \u50752  \u44536 \u48516 \u44760 \u49436  \u51064 \u51221 \u54616 \u49884 \u45716  \u48148 \u47484  \u55148 \u49373 \u54616 \u45716  \u44536 \u47084 \u54620  \u47784 \u46304  \u44368 \u54924 \u47484  \u49345 \u51669 \u54616 \u45716  \u44163 \u51060  \u50500 \u45776  \u49688  \u50630 \u45796 . \u44536 \u47532 \u44256  \u48148 \u48296 \u47200 \u51060  \u47924 \u45320 \u51276 \u45796 \u44256  \u49440 \u54252 \u54616 \u45716  \u50836 \u54620 \u44228 \u49884 \u47197  14\u51109 \u51032  \u44592 \u48324 \u51008  \u51204 \u50640 \u45716  \u49692 \u44208 \u54616 \u50688 \u51004 \u45208  \u44536  \u54980 \u50640  \u53440 \u46973 \u54620  \u51333 \u44368  \u45800 \u52404 \u46308 \u50640  \u51201 \u50857 \u46112  \u49688 \u48150 \u50640  \u50630 \u45796 . \u44536  \u44592 \u48324 \u51008  \u49900 \u54032 \u51032  \u44221 \u44256  \u45796 \u51020 \u50640  \u51452 \u50612 \u51648 \u45716  \u44592 \u48324 \u51060 \u48064 \u47196  \u44536 \u44163 \u51008  \u48516 \u47749 \u55176  \u47568 \u49464 \u50640  \u49440 \u54252 \u46104 \u50612 \u50556  \u54624  \u44163 \u51060 \u45796 . \u44536 \u47532 \u44256  \u47196 \u47560 \u44368 \u50640 \u47564  \u51201 \u50857 \u46112  \u44163 \u51060  \u50500 \u45768 \u45796 . \u50780 \u45264 \u54616 \u47732  \u47196 \u47560 \u44368 \u45716  \u51060 \u48120  \u50668 \u47084  \u49464 \u44592  \u46041 \u50504  \u47924 \u45320 \u51652  \u49345 \u53468 \u50640  \u51080 \u44592  \u46412 \u47928 \u51060 \u45796 . \u45908 \u50865 \u51060  \u50836 \u54620 \u44228 \u49884 \u47197  18\u51109 \u50640 \u49436  \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u46308 \u51008  \u48148 \u48296 \u47200 \u50640 \u49436  \u45208 \u50724 \u46972 \u45716  \u54840 \u49548 \u47484  \u46307 \u44256  \u51080 \u45796 . \u51060  \u49457 \u44221 \u51208 \u50640  \u51032 \u54616 \u47732  \u47566 \u51008  \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u46308 \u51060  \u48148 \u48296 \u47200  \u44032 \u50868 \u45936  \u51080 \u45716  \u44163 \u51060  \u48516 \u47749 \u54616 \u45796 . \u44536 \u47084 \u47732  \u50724 \u45720 \u45216  \u44536 \u47532 \u49828 \u46020 \u47484  \u46384 \u47476 \u45716  \u51088 \u46308 \u51032  \u45824 \u48512 \u48516 \u51060  \u50612 \u46496 \u54620  \u51333 \u44368  \u45800 \u52404 \u50640  \u49549 \u54644  \u51080 \u45716 \u44032 ? \u51032 \u49900 \u54624  \u50668 \u51648 \u50630 \u51060  \u44536 \u46308 \u51008  \u44060 \u49888 \u44368 \u51032  \u49888 \u50521 \u51012  \u44032 \u51652  \u50668 \u47084  \u51333 \u47448 \u51032  \u44368 \u54924 \u50640  \u49549 \u54616 \u50668  \u51080 \u45796 . \u44536  \u44368 \u54924 \u46308 \u51060  \u51068 \u50612 \u45208 \u45912  \u45817 \u49884 \u50640 \u45716  \u44536 \u46308 \u51060  \u54616 \u45208 \u45784 \u44284  \u51652 \u47532 \u47484  \u50948 \u54616 \u50668  \u44256 \u49345 \u54620  \u44592 \u52488  \u50948 \u50640  \u49436 \u49436  \u54616 \u45208 \u45784 \u51032  \u52629 \u48373 \u51012  \u48155 \u44256  \u51080 \u50632 \u45796 . \u44536 \u47084 \u48064 \u47196  \u48127 \u51648  \u50506 \u45716  \u49464 \u49345  \u49324 \u46988 \u46308 \u44620 \u51648 \u46020  \u48373 \u51020 \u51032  \u50896 \u52825 \u51012  \u48155 \u50500 \u46308 \u51076 \u51004 \u47196  \u50619 \u45716  \u51008 \u54812 \u47196 \u50868  \u44208 \u44284 \u50640  \u45824 \u54616 \u50668  \u49884 \u51064 \u54616 \u51648  \u50506 \u51012  \u49688  \u50630 \u50632 \u45796 . \u49440 \u51648 \u51088 \u45716  \u51060 \u49828 \u46972 \u50648 \u50640  \u45824 \u54616 \u50668  \'93\u45348  \u54868 \u47140 \u54632 \u51012  \u51064 \u54616 \u50668  \u45348  \u47749 \u49457 \u51060  \u51060 \u48169 \u51064  \u51473 \u50640  \u54140 \u51276 \u51020 \u51008  \u45236 \u44032  \u45348 \u44172  \u51077 \u55180  \u50689 \u54868 \u47196  \u45348  \u54868 \u47140 \u54632 \u51060  \u50728 \u51204 \u54632 \u51060 \u45768 \u46972  \u45208  \u51452  \u50668 \u54840 \u50752 \u51032  \u47568 \u51060 \u45768 \u46972 \'94 (\u44180  16:14, 15) \u44256  \u47568 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u46308 \u51008  \u51060 \u49828 \u46972 \u50648 \u51012  \u51200 \u51452 \u50752  \u47736 \u47581 \u51004 \u47196  \u51064 \u46020 \u54620  \u44536  \u50837 \u47581 , \u44263  \u48520 \u44221 \u44148 \u54620  \u51088 \u46308 \u51032  \u49845 \u44288 \u51012  \u48376 \u48155 \u44256  \u44536 \u46308 \u44284  \u49324 \u44480 \u44256 \u51088  \u54620  \u44536  \u50837 \u47581  \u46412 \u47928 \u50640  \u47924 \u45320 \u51276 \u45796 . \u44536 \u44163 \u50640  \u45824 \u54616 \u50668  \'93\u44536 \u47084 \u45208  \u45348 \u44032  \u45348  \u54868 \u47140 \u54632 \u51012  \u48127 \u44256  \u45348  \u47749 \u49457 \u51012  \u51064 \u54616 \u50668  \u54665 \u51020 \u54616 \u46104 \'94\u46972 \u44256  \u44592 \u47197 \u46104 \u50612  \u51080 \u45796 .\
