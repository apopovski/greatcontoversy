\f1\b0 \cf0 \
\uc0\u51060 \u44368 \u50640  \u50577 \u48372 \u54616 \u45716  \u51221 \u49888 \u51008  \u54616 \u45208 \u45784 \u51032  \u44428 \u50948 \u47484  \u54620 \u52789  \u45908  \u47924 \u49884 \u54616 \u45716  \u44600 \u51012  \u50676 \u50632 \u45796 . \u49324 \u45800 \u51008  \u54732 \u49888 \u54616 \u51648  \u47803 \u54620  \u44368 \u54924 \u51032  \u51648 \u46020 \u51088 \u46308 \u51012  \u53685 \u54616 \u50668  \u45367 \u51704  \u44228 \u47749 \u50640  \u49552 \u51012  \u45824 \u50612  \u54616 \u45208 \u45784 \u51060  \u52629 \u48373 \u54616 \u49884 \u44256  \u44144 \u47337 \u54616 \u44172  \u54616 \u49888 , \u50715 \u51201 \u48512 \u53552  \u45236 \u47140 \u50724 \u45716  \u50504 \u49885 \u51068 \u51012  \u54224 \u54616 \u44256 , \u44536  \u45824 \u49888 \u50640  \u51060 \u44368 \u46020 \u46308 \u51060  \'93\u51316 \u44221 \u54624  \u47564 \u54620  \u53468 \u50577 \u51032  \u45216 \'94\u47196  \u51648 \u53020 \u50728  \u44536 \u45216 \u51012  \u52629 \u51068 \u47196  \u49464 \u50864 \u47140  \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u51060 \u47084 \u54620  \u48320 \u44221 \u51012  \u52488 \u44592 \u50640 \u45716  \u44277 \u44277 \u50672 \u54616 \u44172  \u49884 \u46020 \u54616 \u51648  \u50506 \u50520 \u45796 . \u52376 \u51020  \u47751  \u49464 \u44592  \u46041 \u50504  \u44536 \u47532 \u49828 \u46020 \u51064 \u46308 \u51008  \u47784 \u46160  \u52280  \u50504 \u49885 \u51068 \u51012  \u51648 \u53040 \u45796 . \u44536 \u46308 \u51008  \u54616 \u45208 \u45784 \u51012  \u44277 \u44221 \u54616 \u45716  \u47560 \u51020 \u51060  \u46024 \u46021 \u54616 \u50688 \u44256 , \u44536 \u48516 \u51032  \u50984 \u48277 \u51032  \u48520 \u48320 \u49457 \u51012  \u48127 \u50632 \u51004 \u48064 \u47196  \u50984 \u48277 \u51032  \u49888 \u49457 \u49457 \u51012  \u50676 \u47148 \u54616 \u44172  \u50745 \u54840 \u54616 \u50688 \u45796 . \u44536 \u47088 \u45936  \u49324 \u45800 \u51008  \u51088 \u44592 \u51032  \u47785 \u51201 \u51012  \u45804 \u49457 \u54616 \u44592  \u50948 \u54616 \u50668  \u51088 \u49888 \u51032  \u45824 \u47532 \u51088 \u46308 \u51012  \u53685 \u54616 \u50668  \u45824 \u45800 \u55176  \u44368 \u47896 \u54620  \u48169 \u48277 \u51004 \u47196  \u54876 \u46041 \u54616 \u50688 \u45796 . \u44536 \u45716  \u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u51012  \u51068 \u50836 \u51068 \u50640  \u51665 \u51473 \u49884 \u53412 \u44592  \u50948 \u54616 \u50668  \u44536 \u45216 \u51012  \u44536 \u47532 \u49828 \u46020 \u51032  \u48512 \u54876 \u51032  \u52629 \u51068 \u47196  \u49340 \u50520 \u45796 . \u44536 \u45216 \u50640  \u51333 \u44368 \u51201  \u54665 \u49324 \u46308 \u51060  \u54665 \u54644 \u51276 \u51648 \u47564 , \u44536 \u45216 \u51008  \u45796 \u47564  \u50724 \u46973 \u51068 \u47196  \u50668 \u44200 \u51276 \u51012  \u49104 \u51060 \u47728 , \u50504 \u49885 \u51068 \u51008  \u50668 \u51204 \u55176  \u49888 \u49457 \u54616 \u44172  \u51456 \u49688 \u46104 \u44256  \u51080 \u50632 \u45796 .\
\uc0\u49324 \u45800 \u51008  \u51088 \u44592 \u44032  \u47785 \u51201 \u54620  \u49324 \u50629 \u51012  \u49457 \u52712 \u54624  \u44600 \u51012  \u51456 \u48708 \u54616 \u44592  \u50948 \u54616 \u50668  \u44536 \u47532 \u49828 \u46020 \u51032  \u52488 \u47548  \u51204 \u50640  \u47676 \u51200  \u50976 \u45824 \u51064 \u51004 \u47196  \u54616 \u50668 \u44552  \u50504 \u49885 \u51068 \u51012  \u44032 \u54841 \u54620  \u48512 \u45812 \u51060  \u46104 \u44172  \u54616 \u50668  \u44536 \u45216 \u51012  \u51456 \u49688 \u54616 \u45716  \u51068 \u51060  \u47924 \u44144 \u50868  \u51664 \u51060  \u46104 \u44172  \u47564 \u46308 \u50632 \u45796 . \u44536 \u47088 \u45936  \u51060 \u51228  \u44536 \u45716  \u51060 \u50752  \u44057 \u51060  \u51088 \u44592 \u44032  \u47564 \u46308 \u50612  \u45459 \u51008  \u44536 \u47495 \u46108  \u44163 \u51012  \u51060 \u50857 \u54616 \u50668 , \u44536 \u44163 \u51012  \u50976 \u45824 \u51064 \u51032  \u51228 \u46020 \u46972 \u44256  \u47784 \u50837 \u54616 \u50688 \u45796 . \u51068 \u50836 \u51068 \u51012  \u51600 \u44144 \u50868  \u52629 \u51068 \u47196  \u49340 \u50500  \u44536 \u47532 \u49828 \u46020 \u51064 \u51004 \u47196  \u54616 \u50668 \u44552  \u51648 \u53412 \u46020 \u47197  \u54616 \u45716  \u54620 \u54200  \u44536 \u45716  \u50976 \u45824 \u44368 \u50640  \u45824 \u54620  \u51613 \u50724 \u44048 \u51012  \u48372 \u51060 \u44592  \u50948 \u54616 \u50668  \u50504 \u49885 \u51068 \u51012  \u44552 \u49885 \u54616 \u45716  \u45216 \u51060 \u50836 , \u50864 \u50872 \u54616 \u44256  \u49836 \u54536  \u45216 \u47196  \u49340 \u46020 \u47197  \u44536 \u46308 \u51012  \u51060 \u45132 \u50632 \u45796 .\
4\uc0\u49464 \u44592  \u52488 \u50640  \u53080 \u49828 \u53444 \u54000 \u45572 \u49828  \u54889 \u51228 \u45716  \u52825 \u47161 \u51012  \u45236 \u47140  \u51068 \u50836 \u51068 \u51012  \u47196 \u47560  \u51228 \u44397  \u51204 \u52404 \u51032  \u44277 \u51201 \u51064  \u52629 \u51068 \u47196  \u49340 \u50520 \u45796  (\u48512 \u47197  4 \u52280 \u51312 ). \u53468 \u50577 \u51032  \u45216 \u51008  \u51060 \u44368 \u46020 \u46308 \u51060  \u51316 \u51473 \u54616 \u44256  \u51080 \u45716  \u46041 \u49884 \u50640  \u44536 \u47532 \u49828 \u46020 \u51064 \u46308 \u46020  \u51316 \u51473 \u54616 \u44256  \u51080 \u50632 \u45796 . \u51060 \u44368 \u50752  \u44536 \u47532 \u49828 \u46020 \u44368  \u49324 \u51060 \u51032  \u52649 \u46028 \u54616 \u45716  \u51060 \u54644  (\u21033 \u23475 ) \u47484  \u50672 \u54633 \u49884 \u53412 \u45716  \u44163 \u51060  \u54889 \u51228 \u51032  \u51221 \u52293 \u51060 \u50632 \u45796 . \u44536 \u47532 \u49828 \u46020 \u44368 \u50752  \u51060 \u44368 \u46020 \u44032  \u44057 \u51008  \u45216 \u51012  \u51648 \u53416 \u45796 \u47732  \u51060 \u44368 \u46020 \u46308 \u51060  \u47749 \u47785 \u49345 \u51004 \u47196 \u46972 \u46020  \u44536 \u47532 \u49828 \u46020 \u44368 \u47484  \u52292 \u53469 \u54616 \u45716  \u51068 \u51060  \u52489 \u51652 \u46112  \u44163 \u51060 \u47728  \u44536 \u47111 \u44172  \u46104 \u47732  \u44368 \u54924 \u51032  \u44428 \u49464 \u50752  \u50689 \u44305 \u51060  \u45908 \u54624  \u44163 \u51012  \u44648 \u45804 \u51008 , \u50556 \u47581 \u44284  \u44428 \u47141 \u50837 \u50640  \u44256 \u47924 \u46108  \u44368 \u54924 \u51032  \u44048 \u46021 \u46308 \u51060  \u54889 \u51228 \u50640 \u44172  \u44536 \u47111 \u44172  \u54616 \u46020 \u47197  \u52489 \u44396 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u47566 \u51008  \u44221 \u44148 \u54620  \u44536 \u47532 \u49828 \u46020 \u51064 \u46308 \u51008  \u51068 \u50836 \u51068 \u51060  \u50612 \u45712  \u51221 \u46020  \u49888 \u49457 \u54616 \u45796 \u45716  \u44163 \u51012  \u51064 \u51221 \u54616 \u47732 \u49436 \u46020  \u50668 \u51204 \u55176  \u50504 \u49885 \u51068 \u51012  \u54616 \u45208 \u45784 \u51032  \u44144 \u47337 \u54620  \u45216 \u47196  \u51452 \u51109 \u54616 \u50688 \u44256 , \u45367 \u51704  \u44228 \u47749 \u50640  \u46384 \u46972  \u44536 \u45216 \u51012  \u51648 \u53412 \u44256  \u51080 \u50632 \u45796 .\
\uc0\u45824 \u44592 \u47564 \u51088 \u45716  \u44536 \u51032  \u51068 \u51012  \u44536 \u44163 \u51004 \u47196  \u45149 \u45236 \u51648  \u50506 \u50520 \u45796 . \u44536 \u45716  \u44536 \u47532 \u49828 \u46020 \u44368  \u49464 \u44228 \u47484  \u51088 \u44592 \u51032  \u44611 \u48156  \u50500 \u47000  \u47784 \u51004 \u44256 , \u51088 \u44592 \u51032  \u45824 \u47532 \u51088 , \u44263  \u44536 \u47532 \u49828 \u46020 \u51032  \u45824 \u47532 \u51088 \u46972 \u44256  \u51452 \u51109 \u54616 \u45716  \u44144 \u47564 \u54620  \u45824 \u44048 \u46021 \u51012  \u53685 \u54616 \u50668  \u51088 \u44592 \u51032  \u44428 \u49464 \u47484  \u48156 \u55064 \u54616 \u44256 \u51088  \u44208 \u49900 \u54616 \u50688 \u45796 . \u44536 \u45716  \u50756 \u51204 \u55176  \u54924 \u44060 \u54616 \u51648  \u50506 \u51008  \u51060 \u44368 \u46020 \u46308 \u44284  \u50556 \u49900 \u51060  \u44032 \u46301 \u54620  \u44048 \u46021 \u46308 \u44284  \u49464 \u49549 \u51201  \u50837 \u47581 \u51012  \u44032 \u51652  \u44368 \u51649 \u51088 \u46308 \u51012  \u53685 \u54616 \u50668  \u51088 \u44592 \u51032  \u47785 \u51201 \u51012  \u51060 \u47336 \u50632 \u45796 . \u46412 \u46412 \u47196  \u45824 \u44508 \u47784  \u51333 \u44368  \u54924 \u51032 \u46308 \u51012  \u44221 \u50689 \u54616 \u50668 , \u50728  \u49464 \u44228 \u50640 \u49436  \u44368 \u54924 \u51032  \u44256 \u50948  \u49457 \u51649 \u51088 \u46308 \u51012  \u49548 \u51665 \u54616 \u50688 \u45796 . \u44144 \u51032  \u47784 \u46304  \u54924 \u51032 \u50640 \u49436  \u54616 \u45208 \u45784 \u44760 \u49436  \u51228 \u51221 \u54616 \u49888  \u50504 \u49885 \u51068 \u51008  \u51312 \u44552 \u50473  \u44032 \u52824 \u47484  \u51200 \u54616 \u49884 \u53412 \u45716  \u46041 \u49884 \u50640  \u51068 \u50836 \u51068 \u51008  \u51312 \u44552 \u50473  \u45458 \u51060 \u44172  \u46104 \u50632 \u45796 . \u44536 \u47532 \u54616 \u50668  \u47560 \u52840 \u45236  \u51060 \u44368 \u51032  \u52629 \u51228 \u51068 \u51008  \u49888 \u49457 \u54620  \u51