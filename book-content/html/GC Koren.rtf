\uc0\u54617 \u51088 \u46308 \u51060  \u51060 \u54644 \u54624  \u49688  \u50630 \u45716  \u50724 \u47896 \u46972 \u44256  \u49440 \u44256 \u54644  \u48260 \u47532 \u44144 \u45208  \u48324 \u47196  \u51473 \u50836 \u54616 \u51648  \u50500 \u45768 \u54620  \u44163 \u51004 \u47196  \u51648 \u45208 \u52432  \u48260 \u47532 \u45716  \u49457 \u44221 \u51032  \u47566 \u51008  \u48512 \u48516 \u51060  \u44536 \u47532 \u49828 \u46020 \u51032  \u54617 \u44368 \u50640 \u49436  \u48176 \u50864 \u44256  \u51080 \u45716  \u49324 \u46988 \u46308 \u50640 \u44172 \u45716  \u50948 \u47196 \u50752  \u44368 \u54984 \u51004 \u47196  \u52649 \u47564 \u54644  \u51080 \u45796 . \u47566 \u51008  \u49888 \u54617 \u51088 \u46308 \u51060  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51012  \u45908 \u50865  \u48516 \u47749 \u55176  \u51060 \u54644 \u54616 \u51648  \u47803 \u54616 \u45716  \u54620  \u44032 \u51648  \u51060 \u50976 \u45716  \u44536 \u46308 \u51060  \u49892 \u52380 \u54616 \u44592 \u47484  \u50896 \u52824  \u50506 \u45716  \u51652 \u47532 \u50640  \u45824 \u54616 \u50668  \u44536 \u46308 \u51032  \u45576 \u51012  \u44048 \u50500  \u48260 \u47532 \u44592  \u46412 \u47928 \u51060 \u45796 . \u49457 \u44221 \u51032  \u51652 \u47532 \u47484  \u51060 \u54644 \u54616 \u45716  \u44163 \u51008  \u44536  \u50672 \u44396 \u50640  \u49324 \u50857 \u46104 \u45716  \u51648 \u49457 \u51032  \u45733 \u47141 \u50640  \u51032 \u51316 \u46108 \u45796 \u44592 \u48372 \u45796 \u45716  \u50724 \u55176 \u47140  \u51204 \u49900 \u51204 \u47141 \u54616 \u45716  \u53468 \u46020 , \u44263  \u51032 \u47484  \u50676 \u47148 \u55176  \u49324 \u47784 \u54616 \u45716  \u47560 \u51020 \u50640  \u45804 \u47140  \u51080 \u45796 .\
\uc0\u49457 \u44221 \u51008  \u44592 \u46020  \u50630 \u51060  \u50672 \u44396 \u54644 \u49436 \u45716  \u50504  \u46108 \u45796 . \u50724 \u51649  \u49457 \u47161 \u44760 \u49436 \u47564  \u50864 \u47532 \u47484  \u44536 \u52376 \u47100  \u51473 \u50836 \u54620  \u44163 \u46308 \u51012  \u51060 \u54644 \u54624  \u54596 \u50836 \u47484  \u49789 \u44172  \u45712 \u45180 \u44172  \u54616 \u49884 \u44256  \u51060 \u54644 \u54616 \u44592  \u50612 \u47140 \u50868  \u51652 \u47532 \u47484  \u44257 \u54644 \u54616 \u51648  \u50506 \u46020 \u47197  \u51648 \u46020 \u54644  \u51452 \u49892  \u49688  \u51080 \u45796 . \u49324 \u46988 \u51032  \u47560 \u51020 \u51012  \u51456 \u48708 \u49884 \u53020  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51012  \u51060 \u54644 \u54616 \u44172  \u54616 \u44256  \u50864 \u47532 \u44032  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51032  \u50500 \u47492 \u45796 \u50880 \u50640  \u47560 \u51020 \u51060  \u45132 \u47532 \u44256  \u44536  \u47568 \u50432 \u51032  \u44221 \u44256 \u47196  \u44221 \u44228 \u47484  \u48155 \u44256  \u44536  \u50557 \u49549 \u51004 \u47196  \u49352 \u47196 \u50880 \u44284  \u54876 \u44592 \u47484  \u50619 \u44172  \u54616 \u45716  \u44163 \u51060  \u52380 \u49324 \u46308 \u51032  \u51649 \u47924 \u51060 \u45796 . \u50864 \u47532 \u45716  \u49884 \u54200  \u44592 \u51088 \u51032  \u44592 \u50896  (\u31048 \u39000 ) \u51012  \u50864 \u47532 \u51032  \u44163 \u51060  \u46104 \u44172  \u54644 \u50556  \u54620 \u45796 . \'93\u45236  \u45576 \u51012  \u50676 \u50612 \u49436  \u51452 \u51032  \u48277 \u51032  \u44592 \u51060 \u54620  \u44163 \u51012  \u48372 \u44172  \u54616 \u49548 \u49436 \'94 (\u49884  119:18). \u51060 \u46384 \u44552  \u50976 \u54841 \u51012  \u51200 \u54637 \u54624  \u49688  \u50630 \u45716  \u44163 \u52376 \u47100  \u48372 \u51060 \u45716  \u51060 \u50976 \u45716  \u44592 \u46020 \u50752  \u49457 \u44221  \u50672 \u44396 \u47484  \u44172 \u51012 \u47532 \u54632 \u51004 \u47196  \u5461