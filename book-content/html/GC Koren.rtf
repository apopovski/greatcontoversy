\uc0\u44536 \u51032  \u49352 \u47196 \u50868  \u44048 \u49884 \u51064 \u46308 \u51060  \u44636 \u51677  \u45440 \u46972 \u44172 \u46020  \u44536  \u49849 \u50896 \u50640 \u49436 \u45716  \u47751  \u49324 \u46988 \u51060  \u44060 \u49888 \u44368 \u47196  \u51204 \u54693 \u54664 \u45432 \u46972 \u44256  \u51088 \u48156 \u51201 \u51004 \u47196  \u49440 \u50616 \u54616 \u50688 \u45796 . \u46021 \u48169 \u50640  \u44039 \u54784  \u51080 \u45716  \u53440 \u50864 \u51232 \u51060  \u52285 \u53960 \u51004 \u47196  \u46041 \u47308 \u46308 \u50640 \u44172  \u51652 \u47532 \u51032  \u51648 \u49885 \u51012  \u51204 \u45804 \u54616 \u50688 \u45912  \u44163 \u51060 \u45796 . \u45940 \u47560 \u53356 \u51032  \u51312 \u49345  (\u31062 \u19978 ) \u46308 \u51060  \u51060 \u45800 \u50640  \u45824 \u54620  \u47196 \u47560 \u44368 \u51032  \u52376 \u47532  \u48169 \u48277 \u51012  \u51096  \u50508 \u44256  \u51080 \u50632 \u51012  \u44163  \u44057 \u51004 \u47732  \u53440 \u50864 \u51232 \u51032  \u49548 \u47532 \u45716  \u46160  \u48264  \u45796 \u49884  \u46308 \u51012  \u49688  \u50630 \u44172  \u46104 \u50632 \u51012  \u44163 \u51060 \u45796 . \u44536 \u47084 \u45208  \u44536 \u46308 \u51008  \u44536 \u47484  \u51648 \u54616 \u51032  \u53664 \u50725  (\u22303 \u29508 ) \u49549 \u50640  \u44032 \u46160 \u50612  \u48260 \u47532 \u45716  \u45824 \u49888 \u50640  \u49849 \u50896 \u50640 \u49436  \u52628 \u48169 \u49884 \u53020  \u48260 \u47160 \u45796 . \u51060 \u51228  \u44536 \u46308 \u51008  \u50500 \u47924 \u47088  \u51068 \u46020  \u54624  \u49688 \u44032  \u50630 \u50632 \u45796 . \u44536  \u51060 \u50976 \u45716  \u47560 \u52840  \u44536  \u46412 \u50640  \u44536  \u49352  \u44368 \u47532 \u47484  \u44032 \u47476 \u52824 \u45716  \u44368 \u49324 \u46308 \u51012  \u48372 \u54840 \u54616 \u46972 \u45716  \u50773 \u51032  \u47749 \u47161 \u51060  \u45236 \u47160 \u44592  \u46412 \u47928 \u51060 \u45796 . \u53440 \u50864 \u51232 \u51008  \u49444 \u44368 \u54616 \u44592  \u49884 \u51089 \u54616 \u50688 \u45796 . \u47784 \u46304  \u44368 \u54924 \u45716  \u44536 \u47484  \u54872 \u50689 \u54616 \u50688 \u44256 , \u49324 \u46988 \u46308 \u51008  \u47568 \u50432 \u51012  \u46307 \u44592  \u50948 \u54616 \u50668  \u47784 \u50668 \u46308 \u50632 \u45796 . \u46608 \u54620  \u45796 \u47480  \u49324 \u46988 \u46308 \u46020  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51012  \u51204 \u54616 \u44256  \u51080 \u50632 \u45796 . \u45940 \u47560 \u53356 \u50612 \u47196  \u48264 \u50669 \u46108  \u49888 \u50557  \u49457 \u44221 \u51060  \u45328 \u47532  \u48372 \u44553 \u46104 \u50632 \u45796 . \u48277 \u50773 \u44368 \u46020 \u46308 \u51060  \u44536  \u49324 \u50629 \u51012  \u46244 \u51665 \u50612 \u50638 \u51004 \u47140 \u44256  \u50528 \u47484  \u50416 \u47732  \u50424 \u49688 \u47197  \u44536  \u49324 \u50629 \u51008  \u45908 \u50865  \u54869 \u51109 \u46104 \u50612  \u44052 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44263  \u45940 \u47560 \u53356 \u45716  \u44060 \u54785 \u51452 \u51032 \u47484  \u48155 \u50500 \u46308 \u50688 \u51020 \u51012  \u49440 \u54252 \u54616 \u50688 \u45796 .\
