\uc0\u54532 \u46993 \u49828 \u51032  \u51333 \u44368  \u44060 \u54785 \u51088 \u46308 \u51008  \u51088 \u44592 \u46308 \u51032  \u45208 \u46972 \u44032  \u46021 \u51068 \u51060 \u45208  \u49828 \u50948 \u49828 \u50752  \u48372 \u51312 \u47484  \u47582 \u52628 \u50612  \u45208 \u44032 \u45716  \u44163 \u51012  \u48372 \u44256 \u51088  \u50676 \u47581 \u54620  \u45208 \u47672 \u51648  \u50728  \u44397 \u48124 \u51012  \u44033 \u49457 \u49884 \u53412 \u44592  \u50948 \u54616 \u50668  \u47196 \u47560 \u44368 \u51032  \u48120 \u49888 \u51012  \u44277 \u44201 \u54616 \u50668 \u50556 \u44192 \u45796 \u44256  \u44208 \u49900 \u54616 \u50688 \u45796 . \u44536 \u47000 \u49436  \u48120 \u49324 \u47484  \u44277 \u44201 \u54616 \u45716  \u44201 \u47928 \u51012  \u54616 \u47355 \u48164  \u49324 \u51060 \u50640  \u51204 \u44397 \u50640  \u48537 \u50688 \u45796 . \u44536 \u47084 \u45208  \u48516 \u48324 \u50630 \u51060  \u50676 \u49457 \u47564 \u51004 \u47196  \u54665 \u54620  \u44536  \u51068 \u51008  \u44060 \u54785  \u49324 \u50629 \u51012  \u51204 \u51652 \u49884 \u53412 \u44592 \u45716 \u52964 \u45397  \u50724 \u55176 \u47140  \u44536  \u49440 \u46041 \u51088 \u46308 \u49104 \u47564  \u50500 \u45768 \u46972  \u54532 \u46993 \u49828  \u51204 \u50669 \u51032  \u44060 \u54785  \u49888 \u50521 \u51032  \u46041 \u51648 \u46308 \u50640 \u44172 \u44620 \u51648  \u54028 \u47736 \u51012  \u52488 \u47000 \u54616 \u44256  \u47568 \u50520 \u45796 . \u44536  \u51068 \u51008  \u47196 \u47560 \u44368 \u46020 \u46308 \u51060  \u50724 \u47019 \u46041 \u50504  \u49548 \u50896 \u54616 \u45912  \u44163 , \u44263  \u51060 \u45800 \u51088 \u46308 \u51012  \u44397 \u44032 \u51032  \u50504 \u45397  (\u23433 \u23527 ) \u44284  \u50773 \u50948 \u51032  \u54869 \u47549 \u51012  \u50948 \u53468 \u47213 \u44172  \u54616 \u45716  \u49440 \u46041 \u51088 \u46308 \u47196  \u47792 \u50500  \u44536 \u46308 \u51032  \u50756 \u51204 \u54620  \u48149 \u47736 \u51012  \u50836 \u44396 \u54624  \u49688  \u51080 \u45716  \u44396 \u49892 \u51012  \u47564 \u46308 \u50612  \u51452 \u44172  \u46104 \u50632 \u45796 .\
\uc0\u45572 \u44396 \u51032  \u49548 \u54665 \u51064 \u51648 \u45716  \u47792 \u46972 \u46020 , \u54841  \u48516 \u48324 \u47141  \u50630 \u45716  \u46041 \u51648 \u44032  \u54620  \u51068 \u51064 \u51648 , \u44368 \u54876 \u54620  \u50896 \u49688 \u44032  \u54620  \u51068 \u51064 \u51648  \u51204 \u54784  \u48516 \u47749 \u52824  \u50506 \u50520 \u51004 \u45208 , \u54620  \u51109 \u51032  \u44201 \u47928 \u51060  \u50773 \u51032  \u44144 \u49892  (\u23621 \u23460 ) \u51032  \u52636 \u51077 \u47928 \u50640  \u48537 \u50612  \u51080 \u50632 \u45796 . \u50773 \u51008  \u44277 \u54252 \u50640  \u49324 \u47196 \u51105 \u54804 \u45796 . \u44536  \u54620  \u51109 \u51032  \u51333 \u51060  \u44032 \u50868 \u45936 \u45716  \u45796 \u45380 \u44036  \u51316 \u44221 \u51012  \u48155 \u50500  \u50724 \u45912  \u48120 \u49888 \u51012  \u47924 \u52280 \u54616 \u44172  \u44277 \u44201 \u54616 \u45716  \u45236 \u50857 \u51060  \u45812 \u44200  \u51080 \u50632 \u45796 . \u44536 \u52376 \u47100  \u44592 \u53444 \u50630 \u45716  \u45440 \u46972 \u50868  \u47928 \u44396 \u44032  \u50773 \u51032  \u45576 \u50526 \u50640  \u45208 \u53440 \u45212  \u44163 \u51008  \u44536 \u51032  \u44201 \u45432 \u47484  \u51068 \u51004 \u53412 \u44592 \u50640  \u52649 \u48516 \u54616 \u50688 \u45796 . \u45320 \u47924 \u46020  \u45440 \u46976  \u50773 \u51008  \u50620 \u47560  \u46041 \u50504  \u47568 \u50630 \u51060  \u46504 \u44256  \u51080 \u50632 \u45796 . \u51060 \u51005 \u44256  \u44536 \u45716  \u48516 \u45432 \u50640  \u49324 \u47196 \u51105 \u55180  \u52292  \u47924 \u49436 \u50868  \u47568 \u51012  \u53552 \u46888 \u47160 \u45796 . \'93\u47336 \u53552 \u45817 \u51060 \u46972 \u44256  \u51032 \u49900 \u46104 \u45716  \u51088 \u45716  \u52264 \u48324  \u50630 \u51060  \u52404 \u54252 \u54616 \u46972 . \u45208 \u45716  \u44536 \u46308 \u51012  \u47784 \u46160  \u48149 \u47736 \u54624  \u44163 \u51060 \u45796 \'94 (D\'92Aubigne, b.4, ch.10). \u51452 \u49324 \u50948 \u45716  \u51060 \u48120  \u45912 \u51256 \u51276 \u45796 . \u50773 \u51008  \u47196 \u47560 \u51032  \u54200 \u50640  \u50756 \u51204 \u55176  \u44032 \u45812 \u54616 \u44592 \u47196  \u44208 \u49900 \u54616 \u50688 \u45796 .\
\uc0\u54028 \u47532  \u49884 \u50640 \u49436 \u46020  \u47336 \u53552  \u54028 \u47484  \u47784 \u46160  \u52404 \u54252 \u54616 \u45716  \u51312 \u52824 \u44032  \u51593 \u49884  \u52712 \u54644 \u51276 \u45796 . \u44060 \u54785 \u54028 \u51032  \u54620  \u49324 \u46988 \u51004 \u47196 \u49436  \u48708 \u48128  \u51665 \u54924 \u50640  \u49888 \u51088 \u46308 \u51012  \u47784 \u51004 \u45716  \u51068 \u50640  \u45733 \u49689 \u54664 \u45912  \u48712 \u44260 \u54620  \u54620  \u51649 \u44277 \u51060  \u52404 \u54252 \u46104 \u50632 \u45796 . \u44536 \u45716  \u51593 \u49884  \u54868 \u54805 \u50640  \u52376 \u54620 \u45796 \u45716  \u50948 \u54801  \u54616 \u50640 , \u48277 \u50773 \u52769 \u51032  \u49324 \u51088 \u46308 \u51012  \u49884 \u45236 \u50640  \u51080 \u45716  \u47784 \u46304  \u44060 \u49888 \u44368 \u46020 \u46308 \u51032  \u51665 \u51004 \u47196  \u51064 \u46020 \u54644  \u51452 \u46020 \u47197  \u47749 \u47161 \u51012  \u48155 \u50520 \u45796 . \u44536 \u45716  \u51204 \u50984 \u54616 \u47732 \u49436  \u44536 \u47088  \u48708 \u50676 \u54620  \u54665 \u46041 \u51008  \u54616 \u51648  \u50506 \u44192 \u45796 \u44256  \u54924 \u54588 \u54616 \u50688 \u51648 \u47564  \u47560 \u52840 \u45236  \u53440 \u50724 \u47476 \u45716  \u54868 \u50684 \u51012  \u48372 \u44256  \u44277 \u54252 \u47484  \u45712 \u45184  \u45208 \u47672 \u51648  \u54805 \u51228 \u46308 \u51012  \u48176 \u48152 \u54616 \u50688 \u45796 . \u49457 \u48337  (\u32854 \u39200 ) \u51012  \u44032 \u51652  \u51088 \u44032  \u49440 \u46160 \u50640  \u49436 \u44256 , \u47566 \u51008  \u49888 \u48512 \u46308 , \u54693 \u47196 \u47484  \u46304  \u51088 \u46308 , \u49849 \u47140 \u46308 , \u44400 \u51064 \u46308 \u51060  \u44536 \u47484  \u50640 \u50892 \u49912 \u44256  \u45208 \u44052 \u45716 \u45936  \u50773 \u49892 \u51032  \u48708 \u48128  \u53456 \u51221 \u51064  \u47784 \u47536  (Morin) \u51060  \u44536  \u48176 \u48152 \u51088 \u47484  \u45936 \u47532 \u44256  \u44032 \u47564 \u44032 \u47564 \u55176  \u49884 \u44032 \u47484  \u48736 \u51256 \u45208 \u44052 \u45796 . \u51060  \u54665 \u47148 \u51008  \u48120 \u49324 \u47484  \u45908 \u47101 \u55180  \u44060 \u54785  \u44368 \u46020 \u46308 \u51012  \u50948 \u54616 \u50668  \u51396 \u51032  \u50857 \u49436 \u47484  \u48155 \u44172  \u54616 \u45716  \u44163 \u51060 \u46972 \u44256  \u54632 \u51060  \u54364 \u47732 \u49345  \u51060 \u50976 \u50688 \u45796 . \u44536 \u47084 \u45208  \u49324 \u49892 \u49345  \u44536  \u51060 \u47732 \u50640 \u45716  \u47924 \u49436 \u50868  \u47785 \u51201 \u51060  \u44048 \u52628 \u50612 \u51256  \u51080 \u50632 \u45796 . \u50612 \u46500  \u47336 \u53552 \u44368 \u46020 \u51032  \u51665  \u47582 \u51008 \u54200 \u50640  \u51060 \u47476 \u51088  \u44536  \u48176 \u48152 \u51088 \u45716  \u49548 \u47532  \u45236 \u51648  \u50506 \u44256  \u50612 \u46500  \u50516 \u54840 \u47484  \u54616 \u50688 \u45796 . \u44536 \u47084 \u51088  \u54665 \u47148 \u51008  \u51221 \u51648 \u46104 \u44256  \u49324 \u46988 \u46308 \u51060  \u44536  \u51665 \u51004 \u47196  \u45804 \u47140  \u46308 \u50612 \u44032  \u44032 \u51313 \u51012  \u45132 \u50612 \u45236 \u50612  \u54252 \u48149 \u54616 \u44256  \u45796 \u49884  \u49352 \u47196 \u50868  \u54252 \u54925 \u47932 \u51012  \u52286 \u50500 \u49436  \u44536  \u47924 \u49436 \u50868  \u54665 \u47148 \u51008  \u50880 \u51649 \u50688 \u45796 . \u44536 \u46308 \u51008  \'93\u53360  \u51665 \u51060 \u45208  \u51089 \u51008  \u51665 \u51012  \u47561 \u47200 \u54616 \u44256  \u50612 \u46500  \u51665 \u51060 \u46304 \u51648  \u44536 \u45285  \u51648 \u45208 \u51648  \u50506 \u50520 \u45796 . \u54028 \u47532  \u45824 \u54617 \u44284  \u44057 \u51008  \u44368 \u50977  \u44592 \u44288 \u44620 \u51648 \u46020  \u50628 \u49845 \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u53456 \u51221  \u47784 \u47536 \u51008  \u51204  \u49884 \u51473 \u51012  \u51204 \u50984 \u49884 \u53040 \u45796 . \'85\u44536 \u44163 \u51008  \u44277 \u54252  \u49884 \u45824 \u50688 \u45796 \'94 (D\'92Aubigne, b.4, ch.10).\
