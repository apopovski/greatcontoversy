\uc0\u51060 \u50752  \u44057 \u51060  \u50808 \u54805 \u49345 \u51004 \u47196  \u51109 \u50628 \u54616 \u44256  \u54868 \u47140 \u54620  \u47784 \u49845 \u44284  \u51032 \u49885 \u51008  \u51396 \u50640  \u48736 \u51652  \u50689 \u54844 \u46308 \u51032  \u44040 \u47581 \u51012  \u50864 \u47217  (\u24858 \u24324 ) \u54616 \u45716 \u45936  \u48520 \u44284 \u54616 \u44256  \u44536  \u45236 \u48512 \u51032  \u48512 \u54056 \u47484  \u51613 \u44144 \u54620 \u45796 . \u44536 \u47532 \u49828 \u46020 \u44368 \u45716  \u44536 \u47084 \u54620  \u44163 \u50640  \u47588 \u47141 \u51012  \u44054 \u44172  \u54624  \u54596 \u50836 \u44032  \u50630 \u45796 . \u49901 \u51088 \u44032 \u50640 \u49436  \u48708 \u52432 \u50724 \u45716  \u48731  \u44032 \u50868 \u45936 \u49436  \u52280 \u46108  \u44536 \u47532 \u49828 \u46020 \u44368 \u45716  \u49692 \u44208 \u54616 \u44256  \u50500 \u47492 \u45813 \u44172  \u45208 \u53440 \u45208 \u44592  \u46412 \u47928 \u50640  \u44536  \u52280 \u44032 \u52824 \u47484  \u45458 \u51060 \u44592  \u50948 \u54616 \u50668  \u50808 \u44288 \u49345  \u51109 \u49885 \u51012  \u54624  \u54596 \u50836 \u44032  \u50630 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436  \u44032 \u52824  \u51080 \u44172  \u50668 \u44592 \u49884 \u45716  \u44163 \u51008  \u49457 \u44208 \u51032  \u48120 \u50752  \u44216 \u49552 \u54616 \u44256  \u50504 \u51221 \u46108  \u51221 \u49888 \u51060 \u45796 .\
\uc0\u50808 \u44288 \u49345  \u50500 \u47492 \u45796 \u50880 \u51060  \u48152 \u46300 \u49884  \u49692 \u44208 \u54616 \u44256  \u44256 \u49345 \u54620  \u49324 \u49345 \u51032  \u51648 \u54364 \u45716  \u50500 \u45768 \u45796 . \u44256 \u49345 \u54620  \u50696 \u49696  \u51648 \u44033 \u44284  \u50864 \u50500 \u54616 \u44256  \u49464 \u47144 \u46108  \u52712 \u48120 \u44032  \u49464 \u49549 \u51201 \u51060 \u47728  \u50977 \u50837 \u51201 \u51064  \u49324 \u46988 \u51032  \u49900 \u51473 \u50640 \u46020  \u55124 \u55176  \u51080 \u45796 . \u44536 \u46308 \u51008  \u55124 \u55176  \u49324 \u45800 \u50640 \u44172  \u51060 \u50857 \u46104 \u50612  \u49324 \u46988 \u46308 \u50640 \u44172  \u49900 \u47161 \u51032  \u54596 \u50836 \u47484  \u51082 \u50612 \u48260 \u47532 \u44172  \u54616 \u44256  \u48120 \u47000 \u51032  \u49373 \u50528 \u50752  \u50689 \u49373 \u51012  \u44648 \u45803 \u51648  \u47803 \u54616 \u44172  \u54616 \u44256  \u47924 \u54620 \u54620  \u44396 \u50896 \u51088 \u50640 \u44172 \u49436  \u46028 \u50500 \u49436 \u49436  \u51060  \u49464 \u49345 \u47564 \u51012  \u50948 \u54616 \u50668  \u49332 \u46020 \u47197  \u47564 \u46304 \u45796 .\
\uc0\u50808 \u44288 \u51012  \u52824 \u51109 \u54616 \u45716  \u51333 \u44368 \u45716  \u44144 \u46317 \u45208 \u51648  \u50506 \u51008  \u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u50640  \u47588 \u47141 \u51201 \u51060 \u45796 . \u52380 \u51452 \u44368  \u50696 \u48176 \u51032  \u54868 \u47140 \u54620  \u47784 \u49845 \u44284  \u51032 \u49885 \u50640 \u45716  \u47588 \u54841 \u51201 \u51060 \u47728  \u54889 \u54848 \u52992  \u54616 \u45716  \u51068 \u51333 \u51032  \u55192 \u51060  \u51080 \u45796 . \u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u44144 \u44592 \u50640  \u44592 \u47564 \u45817 \u54616 \u50668  \u47196 \u47560 \u44368 \u47484  \u48148 \u47196  \u54616 \u45720  \u44032 \u45716  \u47928 \u51064  \u44163 \u52376 \u47100  \u52432 \u45796 \u48372 \u44172  \u46108 \u45796 . \u50724 \u51649  \u51652 \u47532 \u51032  \u44592 \u52488  \u50948 \u50640  \u44403 \u44172  \u49436  \u51080 \u45716  \u49324 \u46988 \u46308 \u44284  \u54616 \u45208 \u45784 \u51032  \u49457 \u47161 \u51004 \u47196  \u47560 \u51020 \u51060  \u49352 \u47196 \u50892 \u51652  \u49324 \u46988 \u46308 \u47564 \u51060  \u47196 \u47560 \u44368 \u51032  \u50689 \u54693 \u50640 \u49436  \u48279 \u50612 \u45216  \u49688  \u51080 \u45796 . \u44536 \u47532 \u49828 \u46020 \u44760  \u45824 \u54620  \u52404 \u54744 \u51201  \u51648 \u49885 \u51012  \u44054 \u51648  \u47803 \u54620  \u49688 \u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u45733 \u47141 \u51060  \u50630 \u45716  \u44221 \u44148 \u51032  \u47784 \u50577 \u47564 \u51012  \u48155 \u50500 \u46308 \u51060 \u44172  \u46112  \u44163 \u51060 \u45796 . \u48148 \u47196  \u44536 \u47088  \u51333 \u44368 \u44032  \u47566 \u51008  \u49324 \u46988 \u46308 \u51060  \u44040 \u47581 \u54616 \u45716  \u51333 \u44368 \u51060 \u45796 .\
\uc0\u44368 \u54924 \u44032  \u51396 \u47484  \u49324 \u54616 \u45716  \u44428 \u49464 \u47484  \u44032 \u51648 \u44256  \u51080 \u45796 \u44256  \u54616 \u45716  \u51452 \u51109 \u51008  \u47196 \u47560 \u44368 \u46020 \u46308 \u50640 \u44172  \u47560 \u51020 \u45824 \u47196  \u51396 \u47484  \u48276 \u54624  \u49688  \u51080 \u45796 \u45716  \u49373 \u44033 \u51012  \u44032 \u51648 \u44172  \u54644 \u51456 \u45796 . \u44536 \u47532 \u44256  \u51396 \u47484  \u44256 \u48177 \u54616 \u45716  \u51032 \u49885  (\u20736 \u24335 ), \u44263  \u44536 \u44163 \u51060  \u50630 \u51004 \u47732  \u50857 \u49436 \u47484  \u48155 \u51012  \u49688  \u50630 \u45796 \u44256  \u54616 \u45716  \u44536  \u51032 \u49885  \u46608 \u54620  \u51396 \u47484  \u48276 \u54616 \u46020 \u47197  \u54728 \u50857 \u46104 \u50612  \u51080 \u45716  \u44163 \u52376 \u47100  \u49373 \u44033 \u54616 \u44172  \u54644 \u51452 \u45716  \u44221 \u54693 \u51060  \u51080 \u45796 . \u53440 \u46973 \u54620  \u49324 \u46988  \u50526 \u50640  \u47924 \u47502 \u51012  \u44999 \u44256  \u49900 \u51473 \u51032  \u51008 \u48128 \u54620  \u49324 \u49345 \u44284  \u49373 \u44033 \u51012  \u44256 \u48177 \u54616 \u45716  \u51088 \u45716  \u51088 \u49888 \u51032  \u51064 \u44036 \u49457 \u51012  \u51200 \u54616 \u49884 \u53412 \u44256  \u49900 \u47161  \u49549 \u50640  \u51080 \u45716  \u50728 \u44054  \u44256 \u49345 \u54620  \u45733 \u47141 \u51012  \u51200 \u54616 \u49884 \u53412 \u44256  \u51080 \u45716  \u44163 \u51060 \u45796 . \u54620  \u49324 \u46988 \u51032  \u49324 \u51228  (\u21496 \u31085 ), \u49892 \u49688 \u50752  \u51396 \u44032  \u47566 \u51008  \u51453 \u51012  \u49688 \u48150 \u50640  \u50630 \u45716  \u49324 \u46988 , \u45320 \u47924 \u46020  \u55124 \u55176  \u51020 \u51452 \u50752  \u48169 \u51333 \u51004 \u47196  \u53440 \u46973 \u54620  \u51064 \u44036 \u50640 \u44172  \u51088 \u44592  \u49373 \u50528 \u50640  \u51080 \u45716  \u51396 \u47484  \u44256 \u48177 \u54632 \u51004 \u47196  \u44536 \u51032  \u54408 \u49457 \u51032  \u54364 \u51456 \u51008  \u51200 \u54616 \u46104 \u44256  \u44536 \u47196  \u47568 \u48120 \u50516 \u50500  \u45908 \u47101 \u54784 \u51652 \u45796 . \u44536 \u45716  \u54616 \u45208 \u45784 \u51012  \u53440 \u46973 \u54620  \u51064 \u44036 \u44284  \u44057 \u51008  \u48516 \u51004 \u47196  \u49373 \u44033 \u54620 \u45796 . \u50780 \u45264 \u54616 \u47732  \u49324 \u51228 \u44032  \u54616 \u45208 \u45784 \u51032  \u45824 \u54364 \u51088 \u51032  \u50948 \u52824 \u50640  \u49436 \u44592  \u46412 \u47928 \u51060 \u45796 . \u49324 \u46988 \u51060  \u49324 \u46988 \u50640 \u44172  \u54616 \u45716  \u44536  \u48708 \u50676 \u54620  \u44256 \u48177 \u51008  \u51060  \u49464 \u49345 \u51012  \u45908 \u47101 \u54784 \u49436  \u47560 \u51648 \u47561  \u47736 \u47581 \u51012  \u48155 \u44172  \u54616 \u45716  \u47566 \u51008  \u51396 \u50501 \u51012  \u55128 \u47140  \u45236 \u48372 \u45236 \u45716  \u48372 \u51060 \u51648  \u50506 \u45716  \u50896 \u52380 \u51060 \u45796 . \u44536 \u47084 \u45208  \u48169 \u51333 \u51012  \u51339 \u50500 \u54616 \u45716  \u51088 \u50640 \u44172  \u51080 \u50612 \u49436 \u45716  \u54616 \u45208 \u45784 \u44760  \u47560 \u51020 \u51012  \u54196 \u45459 \u45716  \u44163 \u48372 \u45796  \u51088 \u44592 \u50752  \u46041 \u51068 \u54620  \u51064 \u44036 \u50640 \u44172  \u44256 \u48177 \u54616 \u45716  \u51068 \u51060  \u45908 \u50865  \u51339 \u44172  \u50668 \u44200 \u51652 \u45796 . \u46608 \u54620  \u51064 \u44036 \u49457 \u50640 \u49436  \u48380  \u46412  \u44256 \u54665 \u51012  \u54616 \u45716  \u44163 \u51060  \u51396 \u47484  \u48260 \u47532 \u45716  \u44163 \u48372 \u45796  \u47560 \u51020 \u50640  \u46300 \u45716  \u51068 \u51060 \u47728  \u50977 \u52404 \u47484  \u48288 \u50743 \u44284  \u50192 \u44592 \u54400 \u47196  \u44340 \u47213 \u44172  \u54616 \u44256  \u49632 \u49324 \u49836 \u47196  \u51228 \u50612 \u54616 \u45716  \u54200 \u51060  \u50977 \u49888 \u51032  \u51221 \u50837 \u51012  \u49901 \u51088 \u44032 \u50640  \u47803  \u48149 \u45716  \u44163 \u48372 \u45796  \u45908 \u50865  \u49789 \u45796 . \u50977 \u49888 \u51032  \u47560 \u51020 \u51004 \u47196 \u45716 , \u47924 \u44144 \u50868  \u47693 \u50640 \u47484  \u47700 \u45716  \u44163 \u51060  \u44536 \u47532 \u49828 \u46020 \u51032  \u47693 \u50640 \u47484  \u47700 \u45716  \u44163 \u48372 \u45796  \u45908 \u50865  \u45227 \u45796 .\
