\uc0\u51060 \u50752  \u44057 \u51008  \u51452 \u49440 \u51008  \u47560 \u52840 \u45236  \u54952 \u47141 \u51012  \u44144 \u46160 \u44172  \u46104 \u50612  \u48277 \u50773 \u51032  \u49324 \u51208 \u51060  \u44536  \u49548 \u49569 \u51012  \u49900 \u47532 \u54616 \u44172  \u46104 \u50632 \u45796 . \u48277 \u50773 \u51060  \u44536  \u49324 \u51208 \u50640 \u44172  \u51204 \u45804 \u54620  \u45236 \u50857 \u50640  \u51032 \u54616 \u47732 , \u51060 \u48120  \u47336 \u53552 \u45716  \u51060 \u45800 \u51088 \u47196  \u49440 \u44256 \u47484  \u48155 \u44256  \u51080 \u45796 . \u44536 \u47084 \u48064 \u47196  \u48277 \u50773 \u51032  \u49324 \u51208 \u50640 \u44172 \u45716  \'93\u51648 \u52404 \u54616 \u51648  \u50506 \u44256  \u44396 \u54805 \u54624  \u51032 \u47924 \'94\u44032  \u51452 \u50612 \u51256  \u51080 \u50632 \u45796 . \u44536 \u47088 \u45936  \u47564 \u51068  \u44536 \u44032  \u51088 \u44592 \u51032  \u51452 \u51109 \u51012  \u44256 \u51665 \u54616 \u44256  \u48277 \u50773 \u51032  \u49324 \u51208 \u51060  \u44536 \u47484  \u52404 \u54252 \u54624  \u49688  \u50630 \u51012  \u46412 \u50640 \u45716 , \u49324 \u51208 \u51008  \'93\u46021 \u51068  \u51204 \u44397 \u50640 \u49436  \u44536 \u51032  \u51064 \u44428 \u51012  \u48149 \u53448 \u54616 \u44256 , \u44536 \u47484  \u52628 \u48169 \u54616 \u44256 , \u51200 \u51452 \u54616 \u47728 , \u44536 \u50640 \u44172  \u46041 \u51312 \u54620  \u47784 \u46304  \u49324 \u46988 \u46308 \u51012  \u54028 \u47928 \u54624  \u49688  \u51080 \u45716  \u44428 \u54620 \u51012  \u48512 \u50668  (\u38468 \u33287 ) \u48155 \u44256  \u51080 \u50632 \u45796 \'94 (D\'92Aubigne, b.4, ch.2). \u44536 \u49104 \u47564  \u50500 \u45768 \u46972  \u48277 \u50773 \u51008  \u44536 \u51032  \u49324 \u51208 \u50640 \u44172  \u44536  \u51648 \u46021 \u54620  \u51060 \u45800 \u51012  \u50756 \u51204 \u55176  \u49100 \u47532  \u48977 \u44592  \u50948 \u54616 \u50668  \u54889 \u51228  \u51060 \u50808 \u50640 \u45716  \u44397 \u44032 \u50752  \u44368 \u54924 \u51032  \u50612 \u46500  \u44256 \u44288 \u51060 \u46304 \u51648  \u44036 \u50640  \u47336 \u53552 \u50752  \u44536 \u51032  \u51648 \u51648 \u51088 \u46308 \u51012  \u52404 \u54252 \u54616 \u50668  \u47196 \u47560 \u51032  \u48373 \u49688 \u51032  \u49552 \u50640  \u45336 \u44200 \u51452 \u45716  \u51068 \u51012  \u46321 \u54620 \u55176  \u54616 \u45716  \u51088 \u45716  \u47784 \u46160  \u54028 \u47928 \u54616 \u46972 \u44256  \u51648 \u49884 \u54616 \u50688 \u45796 .\
\uc0\u50668 \u44592 \u50640  \u47196 \u47560 \u44368 \u51032  \u52280  \u51221 \u49888 \u51060  \u45208 \u53440 \u45228 \u45796 . \u44536  \u47928 \u49436  \u51204 \u48512 \u47484  \u48380  \u46412  \u44144 \u44592 \u45716  \u44536 \u47532 \u49828 \u46020 \u51064 \u51032  \u50896 \u52825 \u51008  \u44256 \u49324 \u54616 \u44256  \u53685 \u49549 \u51201 \u51064  \u51221 \u51032  (\u27491 \u32681 ) \u51032  \u55124 \u51201 \u51312 \u52264 \u46020  \u52286 \u50500 \u48380  \u49688  \u50630 \u45796 . \u47336 \u53552 \u45716  \u47196 \u47560 \u50640 \u49436  \u47588 \u50864  \u47676  \u44275 \u50640  \u51080 \u50632 \u51004 \u48064 \u47196  \u44536 \u45716  \u51088 \u44592 \u51032  \u51077 \u51109 \u51012  \u49444 \u47749 \u54616 \u44144 \u45208  \u48320 \u54840 \u54624  \u44592 \u54924 \u47484  \u44054 \u51648  \u47803 \u54616 \u50688 \u45796 . \u45908 \u50865 \u51060  \u49548 \u49569 \u50640  \u45824 \u54616 \u50668  \u49900 \u47928 \u46020  \u48155 \u44592  \u51204 \u50640  \u51593 \u44208  \u52376 \u48516 \u51004 \u47196  \u44536 \u45716  \u51060 \u45800 \u51088 \u46972 \u45716  \u49440 \u44256 \u47484  \u48155 \u50520 \u44256 , \u44536  \u44057 \u51008  \u45216 \u50640  \u44428 \u44256 \u50752  \u44256 \u49548  (\u21578 \u35380 ) \u50752  \u49900 \u54032 \u44284  \u54032 \u44208 \u51012  \u48155 \u44172  \u46104 \u50632 \u45796 . \u51060  \u47784 \u46304  \u51068 \u51060  \u49548 \u50948  \u45208 \u46972 \u50752  \u44368 \u54924 \u51032  \u50976 \u51068 \u54620  \u52572 \u44256 \u51032  \u51208 \u45824  \u44428 \u50948 \u51088 \u50836  \u44144 \u47337 \u54620  \u50500 \u48260 \u51648 \u47196  \u51088 \u52376 \u54616 \u45716  \u51088 \u47196  \u47568 \u48120 \u50516 \u50500  \u51060 \u47336 \u50612 \u51276 \u45796 .\
\uc0\u47336 \u53552 \u50640 \u44172  \u51652 \u49892 \u54620  \u52828 \u44396 \u51032  \u46041 \u51221 \u44284  \u51312 \u50616 \u51060  \u44032 \u51109  \u54596 \u50836 \u54616 \u50688 \u51012  \u46412 , \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u49453 \u47532 \u47196 \u50024  \u47708 \u46976 \u55176 \u53668  (Melanchthon) \u51012  \u48708 \u53584 \u48288 \u47476 \u53356 \u47196  \u48372 \u45236 \u49512 \u45796 . \u45208 \u51060 \u44032  \u51210 \u51648 \u47564  \u44216 \u49552 \u54616 \u44256  \u45236 \u49457 \u51201 \u51064  \u47708 \u46976 \u55176 \u53668 \u51008  \u44148 \u51204 \u54620  \u54032 \u45800 \u47141 \u44284  \u54644 \u48149 \u54620  \u51648 \u49885 \u44284  \u47588 \u47141 \u51201 \u51064  \u50885 \u48320 \u44284  \u49692 \u44208 \u54616 \u44256  \u44256 \u49345 \u54620  \u51064 \u44201 \u51012  \u44054 \u52628 \u44256  \u51080 \u50632 \u51004 \u48064 \u47196  \u51068 \u48152 \u51032  \u52845 \u49569 \u44284  \u51316 \u44221 \u51012  \u48155 \u50520 \u45796 . \u44536 \u51032  \u48512 \u46300 \u47084 \u50868  \u49457 \u44201 \u51008  \u44536 \u51032  \u46832 \u50612 \u45212  \u51116 \u45733 \u48372 \u45796  \u45908 \u50865  \u54988 \u47469 \u54616 \u50688 \u45796 . \u44263  \u44536 \u45716  \u50676 \u47148 \u54620  \u48373 \u51020 \u51032  \u49324 \u46020 \u44032  \u46104 \u44256 , \u47336 \u53552 \u51032  \u44032 \u51109  \u49888 \u51076  \u48155 \u45716  \u52828 \u44396 \u44032  \u46104 \u44256 , \u44536 \u51032  \u44480 \u51473 \u54620  \u46041 \u51648 \u44032  \u46104 \u50632 \u45796 . \u44536 \u51032  \u50728 \u50976 \u54616 \u44256  \u49888 \u51473 \u54616 \u44256  \u51312 \u49900 \u49457  \u51080 \u45716  \u49457 \u51656 \u51008  \u44284 \u44048 \u54616 \u44256  \u50857 \u44048 \u54620  \u47336 \u53552 \u51032  \u49457 \u51656 \u51012  \u48372 \u50756 \u54644  \u51452 \u44592 \u50640  \u52649 \u48516 \u54616 \u50688 \u45796 . \u51060  \u46160  \u49324 \u46988 \u51060  \u50672 \u54633 \u54616 \u48064 \u47196  \u44060 \u54785  \u49324 \u50629 \u51008  \u54620 \u52789  \u45908  \u48372 \u44053 \u46104 \u50632 \u44256  \u51060 \u44163 \u51060  \u47336 \u53552 \u50640 \u44172  \u53360  \u50857 \u44592 \u51032  \u44540 \u50896 \u51060  \u46104 \u50632 \u45796 .\
