\f1\b0 \cf0 \
\uc0\u44536 \u44032  \u50619 \u44256 \u51088  \u54616 \u45716  \u51648 \u49885 \u51012  \u51060  \u50976 \u45824 \u51064 \u51032  \u44032 \u51221 \u50640 \u49436 \u45716  \u51068 \u48512 \u47084  \u44536 \u50640 \u44172 \u49436  \u52264 \u45800 \u49884 \u53040 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u50676 \u54620  \u49332  \u46412 \u50640  \u51088 \u44592  \u50500 \u48260 \u51648 \u51032  \u51665 \u51012  \u46496 \u45208 \u49436  \u49464 \u49345 \u51004 \u47196  \u45208 \u44032  \u49828 \u49828 \u47196 \u51032  \u55192 \u51004 \u47196  \u44368 \u50977 \u51012  \u48155 \u45716  \u54620 \u54200  \u51088 \u44592 \u51032  \u49888 \u50521 \u44284  \u54217 \u49373 \u51032  \u49324 \u50629 \u51012  \u53469 \u54616 \u44172  \u46104 \u50632 \u45796 . \u44536 \u45716  \u54620  \u46412  \u52828 \u52377 \u51032  \u51665 \u50640 \u49436  \u51648 \u45256 \u51004 \u45208  \u50724 \u47000 \u51648  \u50500 \u45768 \u54616 \u50668  \u48176 \u44368 \u51088 \u47196 \u49436  \u52629 \u52636 \u45817 \u54616 \u50688 \u45796 . \u44536 \u45716  \u51452 \u47672 \u45768 \u50640  \u46024  \u54620  \u54396  \u50630 \u45716  \u44256 \u46021 \u54620  \u49888 \u49464 \u47196  \u45231 \u49440  \u49324 \u46988 \u46308  \u49324 \u51060 \u50640 \u49436  \u49332  \u44600 \u51012  \u44060 \u52377 \u54624  \u49688 \u48150 \u50640  \u50630 \u50632 \u45796 . \u44536 \u45716  \u44033 \u52376 \u47196  \u46028 \u50500 \u45796 \u45768 \u47732 \u49436 \u46020  \u48512 \u51648 \u47088 \u55176  \u44277 \u48512 \u47484  \u44228 \u49549 \u54616 \u50688 \u44256 , \u55176 \u48652 \u47532 \u50612 \u47484  \u44032 \u47476 \u52432 \u49436  \u49373 \u44228 \u47484  \u50976 \u51648 \u54616 \u50688 \u45796 . \u44536 \u45716  \u54620  \u44032 \u53672 \u47533  \u44368 \u49324 \u51032  \u44048 \u54868 \u47484  \u48155 \u50500  \u47196 \u47560 \u44368 \u51032  \u49888 \u50521 \u51012  \u48155 \u50500 \u46308 \u51060 \u44172  \u46104 \u50612  \u51088 \u44592 \u51032  \u46041 \u51313 \u51012  \u50948 \u54616 \u50668  \u49440 \u44368 \u49324 \u44032  \u46104 \u44256 \u51088  \u47785 \u51201 \u51012  \u49464 \u50912 \u45796 . \u47751  \u45380  \u54980 \u50640  \u44536 \u45716  \u44536  \u47785 \u51201 \u51012  \u44032 \u51648 \u44256  \u44277 \u48512 \u54616 \u44256 \u51088  \u47196 \u47560 \u50640  \u51080 \u45716  \u54532 \u47196 \u54028 \u44036 \u45796  \u45824 \u54617 \u51004 \u47196  \u44052 \u45796 . \u44144 \u44592 \u49436  \u44536 \u45716  \u46021 \u51088 \u51201 \u51064  \u49324 \u49345 \u44284  \u49556 \u51649 \u54620  \u47568  \u46412 \u47928 \u50640  \u51060 \u45800 \u51088 \u46976  \u48708 \u45212 \u51012  \u48155 \u44172  \u46104 \u50632 \u45796 . \u44536 \u45716  \u44277 \u44277 \u50672 \u54616 \u44172  \u44368 \u54924 \u51032  \u50668 \u47084  \u44032 \u51648  \u51096 \u47803 \u51012  \u44277 \u44201 \u54616 \u44256 , \u44060 \u54785 \u51032  \u54596 \u50836 \u49457 \u51012  \u50669 \u49444 \u54616 \u50688 \u45796 . \u48708 \u47197  \u52376 \u51020 \u50640 \u45716  \u48277 \u50773 \u44368 \u51032  \u44256 \u49849 \u46308 \u50640 \u44172  \u53945 \u48324 \u54620  \u45824 \u50864 \u47484  \u48155 \u50520 \u51004 \u45208  \u50620 \u47560  \u54980 \u50640 \u45716  \u47196 \u47560 \u50640 \u49436  \u53748 \u44144 \u45817 \u54616 \u50688 \u45796 . \u44536 \u45716  \u44368 \u54924 \u51032  \u44048 \u49884  \u50500 \u47000  \u51060 \u44275 \u51200 \u44275 \u51004 \u47196  \u46028 \u50500 \u45796 \u45396 \u45796 . \u47560 \u52840 \u45236 , \u44536 \u47484  \u47196 \u47560 \u51032  \u49549 \u48149  \u48145 \u50640  \u48373 \u51333 \u49884 \u53412 \u45716  \u44163 \u51008  \u51208 \u45824 \u51201 \u51004 \u47196  \u48520 \u44032 \u45733 \u54616 \u45796 \u45716  \u49324 \u49892 \u51060  \u54869 \u50672 \u54644 \u51276 \u45796 . \u44536 \u45716  \u47560 \u52840 \u45236  \u44368 \u51221  \u48520 \u44032 \u45733 \u51088 \u46972 \u45716  \u49440 \u44256 \u47484  \u48155 \u44256  \u51088 \u44592 \u44032  \u50896 \u54616 \u45716  \u45824 \u47196  \u44032 \u46020 \u47197  \u48169 \u51076 \u46104 \u50632 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u45716  \u50689 \u44397 \u51004 \u47196  \u44148 \u45320 \u44032 \u49436  \u44060 \u49888 \u44368 \u51032  \u49888 \u50521 \u51012  \u48155 \u50500 \u46308 \u51060 \u44256 , \u49457 \u44277 \u54924  (\u32854 \u20844 \u26371 ) \u50640  \u44032 \u51077 \u54616 \u50688 \u45796 . 2\u45380 \u44036 \u51032  \u50672 \u44396 \u47484  \u47560 \u52828  \u45796 \u51020  1821\u45380 \u50640  \u44536 \u45716  \u49440 \u44368  \u49324 \u50629 \u51012  \u49884 \u51089 \u54616 \u50688 \u45796 .\
\uc0\u48380 \u54532 \u45716  \'93\u44036 \u44256 \u47484  \u47566 \u51060  \u44202 \u50632 \u51004 \u47728  \u51656 \u44256 \u47484  \u50500 \u45716  \u51088 \'94\u47196 \u49436 \u51032  \u44536 \u47532 \u49828 \u46020 \u51032  \u52488 \u47548 \u51032  \u50948 \u45824 \u54620  \u51652 \u47532 \u47484  \u48155 \u50500 \u46308 \u51064  \u54620 \u54200 , \u50696 \u50616 \u51012  \u53685 \u54616 \u50668  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u50689 \u44305 \u44284  \u44428 \u45733 \u51004 \u47196  \u51116 \u47548 \u54616 \u49892  \u44163 \u46020  \u48516 \u47749 \u55176  \u44648 \u45804 \u50520 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u45716  \u51088 \u44592 \u51032  \u46041 \u51313 \u46308 \u50640 \u44172  \u45208 \u49324 \u47131  \u50696 \u49688 \u45784 \u51060  \u48148 \u47196  \u50557 \u49549 \u46108  \u47700 \u49884 \u50556 \u51060 \u49900 \u51012  \u50508 \u47140  \u51452 \u44256 , \u44536 \u48516 \u51032  \u52488 \u47548 \u51008  \u51064 \u47448 \u51032  \u51396 \u47484  \u45824 \u49549 \u54616 \u44592  \u50948 \u54616 \u50668  \u55148 \u49373 \u51228 \u47932 \u47196 \u49436  \u44216 \u48708 \u54616 \u44172  \u46104 \u49888  \u44163 \u51076 \u51012  \u51648 \u51201 \u54644  \u51452 \u45716  \u54620 \u54200  \u44536 \u48516 \u44760 \u49436  \u50773 \u51004 \u47196 , \u46608 \u54620  \u44396 \u50896 \u51088 \u47196  \u51116 \u47548 \u54616 \u49892  \u44163 \u51012  \u44032 \u47476 \u52452 \u45796 .\
\uc0\u44536 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u54616 \u50688 \u45796 . \'93\u52280 \u46108  \u47700 \u49884 \u50556 \u51060 \u49888  \u45208 \u49324 \u47131  \u50696 \u49688 \u45784 , \u49552 \u44284  \u48156 \u51060  \u52244 \u47532 \u49512 \u44256 , \u49324 \u51648 \u47196  \u45132 \u47140 \u44032 \u45716  \u50612 \u47536 \u50577  \u44057 \u51004 \u49512 \u45912  \u44536 \u48516 , \u49836 \u54548 \u50640  \u52376 \u54620  \u51088 \u50836  \u51656 \u44256 \u47484  \u50500 \u45716  \u51088 \u51060 \u49512 \u45912  \u44536 \u48516 , \u54848 \u51060  \u50976 \u45796 \u47484  \u46496 \u45208 \u44032 \u44256  \u48277 \u51012  \u49464 \u50864 \u45716  \u44428 \u49464 \u44032  \u44536 \u51032  \u48156  \u49324 \u51060 \u50640 \u49436  \u46496 \u45212  \u54980 \u50640  \u52488 \u47548 \u54616 \u49512 \u45912  \u44536 \u48516 \u51008  \u54616 \u45720 \u51032  \u44396 \u47492 \u51012  \u53440 \u44256  \u52380 \u49324 \u51109 \u51032  \u45208 \u54036 \u44284  \u54632 \u44760  \u51116 \u47548 \u54616 \u49892  \u44163 \u51060 \u45796 \'94 (Joseph Wolff, Researches and Missionary Labors, p.62). \'93\u44536 \u47532 \u54616 \u50668  \u50696 \u49688 \u45784 \u44760 \u49436 \u45716  \u44048 \u46988 \u49328 \u50640  \u49436 \u49884 \u44256 , \u52285 \u49464  \u54980 \u50640  \u51068 \u45800  \u50500 \u45812 \u51060  \u47585 \u50520 \u51004 \u45208  \u51075 \u50612 \u48260 \u47536  \u44536  \u53685 \u52824 \u44428 \u51012  (\u52285  1:26, 3:17) \u45796 \u49884  \u48155 \u51004 \u49884 \u44172  \u46112  \u44163 \u51060 \u45796 . \u44536 \u48516 \u44760 \u49436 \u45716  \u50728  \u46405 \u51032  \u50773 \u51060  \u46104 \u49892  \u44163 \u51060 \u45796 . \u54588 \u51312 \u47932 \u51032  \u49836 \u54140 \u54616 \u44256  \u53444 \u49885 \u54616 \u45716  \u49548 \u47532 \u45716  \u44536 \u52824 \u44256 , \u52268 \u48120 \u50752  \u44048 \u49324 \u51032  \u45432 \u47000 \u47564 \u51060  \u46308 \u47532 \u44172  \u46112  \u44163 \u51060 \u45796 . \'85 \u50696 \u49688 \u44760 \u49436  \u54616 \u45720  \u50500 \u48260 \u51648 \u51032  \u50689 \u44305 \u51004 \u47196  \u44144 \u47337 \u54620  \u52380 \u49324 \u46308 \u44284  \u54632 \u44760  \u50724 \u49892  \u46412 \u50640 \'85\u44536 \u47532 \u49828 \u46020  \u50504 \u50640 \u49436  \u51453 \u51008  \u51088 \u46308 \u51060  \u47676 \u51200  \u51068 \u50612 \u45216  \u44163 \u51060 \u45796  (\u49332 \u51204  4:16; \u44256 \u51204  15:23). \u51060 \u44163 \u51060  \u50864 \u47532  \u44536 \u47532 \u49828 \u46020 \u51064 \u46308 \u51060  \u52395 \u51704  \u48512 \u54876 \u51060 \u46972 \u44256  \u48512 \u47476 \u45716  \u44163 \u51060 \u45796 . \u44536  \u46412 \u50640  \u46041 \u47932 \u44228 \u45716  \u44536  \u48376 \u49457 \u51060  \u48320 \u54616 \u44256  (\u49324  2:6~9), \u50696 \u49688 \u45784 \u44760  \u49692 \u48373 \u54624  \u44163 \u51060 \u45796  (\u49884 \u54200  8\u54200 ). \u49464 \u44228 \u51201  \u54217 \u54868 \u44032  \u50724 \u44172  \u46112  \u44163 \u51060 \u45796 \'94 (Journal of the Rev.378, 379). \'93\u51452 \u45784 \u44760 \u49436 \u45716  \u49464 \u49345 \u51012  \u45796 \u49884  \u48372 \u49884 \u44256 , \'91\u49900 \u55176  \u51339 \u45796 \'92\u44256  \u47568 \u50432 \u54616 \u49892  \u44163 \u51060 \u45796 \'94 (Journal of the Rev.Joseph Wolff, p.294).\
