\f0\b \cf0 \uc0\u50696 \u49688 \u45784 \u51032  \u51116 \u47548 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u54616 \u45720 \u50640 \u49436  \u54616 \u45208 \u45784 \u51032  \u51020 \u49457 \u51060  \u46308 \u47532 \u44256 , \u50696 \u49688 \u45784 \u44760 \u49436  \u51116 \u47548 \u54616 \u49892  \u45216 \u51676 \u50752  \u49884 \u44036 \u51060  \u49440 \u54252 \u46104 \u44256 , \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u46308 \u50640 \u44172  \u50689 \u50896 \u54620  \u50616 \u50557 \u51060  \u51452 \u50612 \u51652 \u45796 . \u44032 \u51109  \u53360  \u45516 \u49457 \u52376 \u47100  \u54616 \u45208 \u45784 \u51032  \u51020 \u49457 \u51008  \u50728  \u46405 \u50640  \u46308 \u47536 \u45796 . \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u46308 \u51008  \u49436 \u49436  \u44536 \u46308 \u51032  \u45576 \u51012  \u50948 \u47484  \u54693 \u54616 \u50668  \u51452 \u47785 \u54616 \u44256  \u44480 \u47484  \u44592 \u50872 \u51064 \u45796 . \u44536 \u46308 \u51032  \u50620 \u44404 \u51008  \u54616 \u45208 \u45784 \u51032  \u50689 \u44305 \u51004 \u47196  \u54872 \u54616 \u50668 \u51648 \u44256  \u47560 \u52824  \u47784 \u49464 \u44032  \u49884 \u45236 \u49328 \u50640 \u49436  \u45236 \u47140 \u50728  \u46412 \u50752  \u44057 \u51060  \u48731 \u45212 \u45796 . \u50501 \u51064 \u46308 \u51008  \u44536 \u46308 \u51012  \u52432 \u45796 \u48380  \u49688  \u50630 \u45796 . \u50504 \u49885 \u51068 \u51012  \u44144 \u47337 \u55176  \u51648 \u53428 \u51004 \u47196  \u54616 \u45208 \u45784 \u51012  \u51316 \u44221 \u54644  \u50728  \u49324 \u46988 \u46308 \u50640 \u44172  \u52629 \u48373 \u51060  \u49440 \u44256 \u46112  \u46412  \u53360  \u49849 \u47532 \u51032  \u54632 \u49457 \u51060  \u51068 \u50612 \u45212 \u45796 .\
\uc0\u44263  \u49324 \u46988 \u51032  \u49552 \u48148 \u45797  \u48152 \u47564 \u54620  \u51089 \u44256  \u44160 \u51008  \u44396 \u47492 \u51060  \u46041 \u51901 \u50640 \u49436  \u45208 \u53440 \u45212 \u45796 . \u44536 \u44163 \u51008  \u44536 \u47532 \u49828 \u46020 \u47484  \u46160 \u47476 \u44256  \u51080 \u45716  \u44396 \u47492 \u51064 \u45936  \u47680 \u47532 \u49436 \u45716  \u50612 \u46176 \u50640  \u46168 \u47084 \u49912 \u51064  \u44163 \u52376 \u47100  \u48372 \u51064 \u45796 . \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u46308 \u51008  \u44536 \u44163 \u51060  \u51064 \u51088 \u51032  \u51669 \u51312 \u51076 \u51012  \u44648 \u45803 \u45716 \u45796 . \u44536 \u46308 \u51008  \u50628 \u49689 \u54620  \u52840 \u47925  \u49549 \u50640 \u49436  \u44536  \u44396 \u47492 \u51060  \u46405 \u51004 \u47196  \u51216 \u51216  \u44032 \u44620 \u50892 \u51664 \u51012  \u51452 \u47785 \u54620 \u45796 . \u44536  \u44396 \u47492 \u51008  \u51216 \u51216  \u48157 \u50500 \u51648 \u44256  \u50689 \u44305 \u49828 \u47101 \u44172  \u46104 \u50612  \u47560 \u52840 \u45236  \u52964 \u45796 \u46976  \u55152  \u44396 \u47492 \u51060  \u46104 \u45716 \u45936 , \u44536  \u50500 \u47000 \u45716  \u53440 \u45716  \u48520 \u44284  \u44057 \u51060  \u44305 \u47749 \u54620  \u48731 \u51060  \u51080 \u44256  \u44536  \u50948 \u50640 \u45716  \u50616 \u50557 \u51032  \u47924 \u51648 \u44060 \u44032  \u51080 \u45796 . \u50696 \u49688 \u44760 \u49436 \u45716  \u44053 \u54620  \u51221 \u48373 \u51088 \u52376 \u47100  \u44396 \u47492 \u51012  \u53440 \u44256  \u50724 \u49888 \u45796 . \u44536 \u48516 \u51008  \u51060 \u51228  \u49688 \u52824 \u50752  \u51200 \u51452 \u51032  \u50420  \u51092 \u51012  \u47560 \u49884 \u44592  \u50948 \u54616 \u50668  \'93\u44036 \u44256 \u47484  \u47566 \u51060  \u44202 \'94\u45716  \u48516 \u51004 \u47196 \u49436 \u44032  \u50500 \u45768 \u46972  \u49328  \u51088 \u50752  \u51453 \u51008  \u51088 \u46308 \u51012  \u49900 \u54032 \u54616 \u44592  \u50948 \u54616 \u50668  \u54616 \u45720 \u44284  \u46405 \u51032  \u49849 \u47532 \u51088 \u47196  \u50724 \u49888 \u45796 . \'93\u44536  \u51060 \u47492 \u51008  \u52649 \u49888 \u44284  \u51652 \u49892 \u51060 \u46972  \u44536 \u44032  \u44277 \u51032 \u47196  \u49900 \u54032 \u54616 \u47728  \u49912 \u50864 \u45908 \u46972 \'94, \'93\u54616 \u45720 \u50640  \u51080 \u45716  \u44400 \u45824 \u46308 \u51060 \'85\u44536 \u47484  \u46384 \u47476 \u45908 \u46972 \'94 (\u44228  19:11, 14). \u44144 \u47337 \u54620  \u52380 \u49324 \u46308 , \u49688 \u47484  \u54756 \u50500 \u47540  \u49688  \u50630 \u45716  \u53360  \u47924 \u47532 \u44032  \u54616 \u45720 \u51032  \u45432 \u47000 \u47484  \u48512 \u47476 \u47732 \u49436  \u44536 \u48516 \u51032  \u44600 \u50640  \u49688 \u54665 \u54620 \u45796 . \u54616 \u45720 \u51008  \u52268 \u46976 \u54620  \u52380 \u52380 \u47564 \u47564 \u51032  \u52380 \u49324 \u46308 \u47196  \u52649 \u47564 \u54644 \u51652  \u44163  \u44057 \u45796 . \u44536  \u44305 \u44221 \u51008  \u49324 \u46988 \u51032  \u48531 \u51004 \u47196  \u47896 \u49324 \u54624  \u49688  \u50630 \u44256 , \u49324 \u46988 \u51032  \u47560 \u51020 \u51004 \u47196  \u44536  \u52268 \u46976 \u54620  \u47784 \u49845 \u51012  \u44032 \u55176  \u49345 \u49345 \u54624  \u49688  \u50630 \u45796 . \'93\u44536  \u50689 \u44305 \u51060  \u54616 \u45720 \u51012  \u45934 \u50632 \u44256  \u44536  \u52268 \u49569 \u51060  \u49464 \u44228 \u50640  \u44032 \u46301 \u54616 \u46020 \u45796  \u44536  \u44305 \u47749 \u51060  \u54663 \u48731  \u44057 \'94 (\u54633  3:3, 4) \u46020 \u45796 . \u44536  \u49332 \u50500  \u51080 \u45716  \u44396 \u47492 \u51060  \u51216 \u51216  \u44032 \u44620 \u51060  \u50740 \u50640  \u46384 \u46972  \u44033  \u49324 \u46988 \u51032  \u45576 \u51008  \u49373 \u47749 \u51032  \u50773 \u51012  \u48372 \u44172  \u46108 \u45796 . \u51060 \u51228  \u44536  \u44144 \u47337 \u54620  \u47672 \u47532 \u45716  \u44032 \u49884 \u44288 \u51004 \u47196  \u49345 \u54644  \u51080 \u51648  \u50506 \u44256  \u52268 \u46976 \u54620  \u47732 \u47448 \u44288 \u51060  \u50444 \u50612 \u51256  \u51080 \u45796 . \u44536 \u48516 \u51032  \u50620 \u44404 \u51008  \u51221 \u50724 \u51032  \u53468 \u50577 \u48372 \u45796  \u45908 \u50865  \u52268 \u46976 \u54616 \u44172  \u48731 \u45212 \u45796 . \'93\u44536  \u50743 \u44284  \u44536  \u45796 \u47532 \u50640  \u51060 \u47492  \u50420  \u44163 \u51060  \u51080 \u51004 \u45768  \u47564 \u50773 \u51032  \u50773 \u51060 \u50836  \u47564 \u51452 \u51032  \u51452 \u46972  \u54616 \u50688 \u45908 \u46972 \'94 (\u44228  19:16).\
\uc0\u44536 \u48516  \u50526 \u50640 \u49436  \'93\u44536  \u50620 \u44404 \u48731 \u51060  \u52285 \u48177 \u54616 \u50668  \u48372 \'94 (\u47128  30:6) \u51060 \u47728  \u54616 \u45208 \u45784 \u51032  \u51088 \u48708 \u47484  \u44144 \u51208 \u54620  \u51088 \u46308 \u50640 \u44172 \u45716  \u50689 \u50896 \u54620  \u49892 \u47581 \u51032  \u44277 \u54252 \u44032  \u45934 \u51064 \u45796 . \'93\u45209 \u45812 \u54616 \u50668  \u44536  \u47924 \u47502 \u51060  \u49436 \u47196  \u48512 \u46378 \u52824 \u47728 \'85\u47784 \u46304  \u45231 \u51060  \u48731 \u51012  \u51075 \'94 (\u45208  2:10) \u45716 \u45796 . \u51032 \u51064 \u46308 \u51008  \u46504 \u47732 \u49436  \'93\u45572 \u44032  \u45733 \u55176  \u49436 \u47532 \u50836 \'94 \u54616 \u44256  \u48512 \u47476 \u51670 \u45716 \u45796 . \u52380 \u49324 \u46308 \u51032  \u45432 \u47000 \u45716  \u44536 \u52824 \u44256  \u47924 \u49436 \u50868  \u52840 \u47925 \u51032  \u49884 \u44036 \u51060  \u55120 \u47480 \u45796 . \u44536  \u54980 \u50640  \'93\u45236  \u51008 \u54812 \u44032  \u45348 \u44172  \u51313 \u54616 \u46020 \u45796 \'94\u44256  \u54616 \u49884 \u45716  \u50696 \u49688 \u45784 \u51032  \u51020 \u49457 \u51060  \u46308 \u47536 \u45796 . \u51032 \u51064 \u46308 \u51032  \u50620 \u44404 \u51008  \u48731 \u45208 \u44256  \u44033  \u49324 \u46988 \u51032  \u47560 \u51020 \u51008  \u51600 \u44144 \u50880 \u51004 \u47196  \u52649 \u47564 \u54644 \u51652 \u45796 . \u52380 \u49324 \u46308 \u51008  \u46405 \u51004 \u47196  \u51217 \u44540 \u54644 \u50740 \u50640  \u46384 \u46972  \u45908 \u50865  \u45458 \u51008  \u51020 \u51312 \u47484  \u45236 \u47728  \u45796 \u49884  \u45432 \u47000 \u47484  \u48512 \u47480 \u45796 .\
\uc0\u47564 \u50773 \u51032  \u50773 \u44760 \u49436 \u45716  \u48520 \u44867 \u50640  \u49912 \u50668  \u44396 \u47492 \u51012  \u53440 \u44256  \u45236 \u47140 \u50724 \u49888 \u45796 . \u51452 \u45784  \u50526 \u50640 \u49436  \u54616 \u45720 \u51008  \u46160 \u47336 \u47560 \u47532 \u52376 \u47100  \u54632 \u44760  \u47568 \u47532 \u44256  \u46405 \u51008  \u51652 \u46041 \u54620 \u45796 . \u44536 \u47532 \u44256  \u47784 \u46304  \u49328 \u44284  \u49452 \u46308 \u51008  \u51228 \u51088 \u47532 \u50640 \u49436  \u50734 \u44200 \u51652 \u45796 . \'93\u50864 \u47532  \u54616 \u45208 \u45784 \u51060  \u51076 \u54616 \u49324  \u51104 \u51104 \u52824  \u50500 \u45768 \u54616 \u49884 \u45768 \'85\u44536  \u49324 \u48169 \u50640 \u45716  \u44305 \u54413 \u51060  \u48520 \u47532 \u47196 \u45796  \u54616 \u45208 \u45784 \u51060  \u44536  \u48177 \u49457 \u51012  \u54032 \u45800 \u54616 \u49884 \u47140 \u44256  \u50967  \u54616 \u45720 \u44284  \u50500 \u47000  \u46405 \u50640  \u48152 \u54252 \u54616 \'94 (\u49884  50:3, 4) \u49884 \u46020 \u45796 .\
\'93\uc0\u46405 \u51032  \u51076 \u44552 \u46308 \u44284  \u50773 \u51313 \u46308 \u44284  \u51109 \u44400 \u46308 \u44284  \u48512 \u51088 \u46308 \u44284  \u44053 \u54620  \u51088 \u46308 \u44284  \u44033  \u51333 \u44284  \u51088 \u51452 \u51088 \u44032  \u44404 \u44284  \u49328  \u48148 \u50948  \u53960 \u50640  \u49704 \u50612  \u49328 \u44284  \u48148 \u50948 \u50640 \u44172  \u51060 \u47476 \u46104  \u50864 \u47532  \u50948 \u50640  \u46504 \u50612 \u51256  \u48372 \u51340 \u50640  \u50505 \u51004 \u49888  \u51060 \u51032  \u45231 \u50640 \u49436 \u50752  \u50612 \u47536 \u50577 \u51032  \u51652 \u45432 \u50640 \u49436  \u50864 \u47532 \u47484  \u44032 \u47532 \u50864 \u46972  \u44536 \u46308 \u51032  \u51652 \u45432 \u51032  \u53360  \u45216 \u51060  \u51060 \u47476 \u47104 \u51004 \u45768  \u45572 \u44032  \u45733 \u55176  \u49436 \u47532 \u50836  \u54616 \u45908 \u46972 \'94 (\u44228  6:15~17).\
\uc0\u44221 \u47736 \u51201 \u51064  \u51312 \u47217 \u51008  \u44536 \u52828 \u45796 . \u44144 \u51667  \u51077 \u49696 \u51008  \u52840 \u47925 \u50640  \u48736 \u51652 \u45796 . \'93\u44400 \u51064 \u51032  \u44049 \u50743 \u44284  \u54588 \u47931 \u51008  \u48373 \u51109 \'94 (\u49324  9:5) \u51060  \u46384 \u47476 \u45716  \u47924 \u47141  \u52649 \u46028 \u44284  \u51204 \u51137 \u51032  \u49548 \u46041 \u51008  \u44536 \u52828 \u45796 . \u51060 \u51228 \u45716  \u44592 \u46020 \u51032  \u51020 \u49457 \u44284  \u53685 \u44257 \u44284  \u49836 \u54548 \u51032  \u49548 \u47532  \u50808 \u50640  \u50500 \u47924 \u47088  \u49548 \u47532 \u46020  \u46308 \u47532 \u51648  \u50506 \u45716 \u45796 . \u51312 \u44552  \u51204 \u44620 \u51648  \u51312 \u47217 \u54616 \u45912  \u49324 \u46988 \u46308 \u51032  \u51077 \u49696 \u50640 \u49436  \'93\u51652 \u45432 \u51032  \u53360  \u45216 \u51060  \u51060 \u47476 \u47104 \u51004 \u45768  \u45572 \u44032  \u45733 \u55176  \u49436 \u47532 \u50836 \'94\u46972 \u45716  \u48512 \u47476 \u51670 \u51020 \u51060  \u53552 \u51256  \u45208 \u50728 \u45796 . \u50501 \u54620  \u51088 \u46308 \u51008  \u44536 \u46308 \u51060  \u47736 \u49884 \u54616 \u44256  \u44144 \u51208 \u54644  \u50728  \u51452 \u45784 \u51032  \u50620 \u44404 \u51012  \u48372 \u44592 \u48372 \u45796  \u52264 \u46972 \u47532  \u49328 \u51032  \u48148 \u50948 \u46308  \u50500 \u47000  \u47931 \u54784 \u51648 \u44592 \u47484  \u48148 \u46976 \u45796 .\
\uc0\u51453 \u51008  \u51088 \u51032  \u44480 \u47484  \u45040 \u46763 \u50612  \u46307 \u44172  \u54616 \u49884 \u45716  \u44536 \u51032  \u51020 \u49457 \u51012  \u44536 \u46308 \u51008  \u50504 \u45796 . \u50620 \u47560 \u45208  \u51088 \u51452  \u44536  \u50528 \u49548 \u54616 \u45716  \u46319 \u54620  \u48512 \u46300 \u47084 \u50868  \u51020 \u49457 \u51060  \u44536 \u46308 \u50640 \u44172  \u54924 \u44060 \u47484  \u54840 \u49548 \u54616 \u50688 \u45912 \u44032 ! \u50620 \u47560 \u45208  \u52828 \u44396 \u50752  \u54805 \u51228 \u50752  \u44396 \u51452 \u47196 \u49436 \u51032  \u44048 \u46041 \u51201  \u50528 \u50896 \u51012  \u44536 \u46308 \u51060  \u46308 \u50632 \u45912 \u44032 ! \u51452 \u45784 \u51032  \u51008 \u54812 \u47484  \u44144 \u51208 \u54620  \u51088 \u46308 \u50640 \u44172  \u52280 \u51004 \u47196  \u50724 \u47019 \u46041 \u50504  \u44032 \u51109  \u53360  \u51221 \u51396 \u51032  \u45712 \u45196 \u51012  \u51452 \u50612  \u50724 \u44256  \u51088 \u52293 \u44048 \u51012  \u44054 \u44172  \u54664 \u45912  \u51020 \u49457 \u51008  \u45320 \u47924 \u45208  \u50724 \u47019 \u46041 \u50504  \u53444 \u50896 \u54644  \u50772 \u45796 . \'93\u46028 \u51060 \u53412 \u44256  \u46028 \u51060 \u53412 \u46972  \u45320 \u55148  \u50501 \u54620  \u44600 \u50640 \u49436  \u46496 \u45208 \u46972  \u50612 \u52236  \u51453 \u44256 \u51088  \u54616 \u45712 \u45264 \'94 (\u44180  33:11). \u50500 , \u44536  \u51020 \u49457 \u51008  \u52264 \u46972 \u47532  \u44536 \u46308 \u51060  \u51204 \u54784  \u50508 \u51648  \u47803 \u54616 \u45716  \u48516 \u51032  \u51020 \u49457 \u51060 \u50632 \u45908 \u46972 \u47732  \u50620 \u47560 \u45208  \u51339 \u50520 \u51012 \u44620 ! \u50696 \u49688 \u45784 \u44760 \u49436 \u45716  \u47568 \u50432 \u54616 \u49888 \u45796 . \'93\u45236 \u44032  \u48512 \u47484 \u51648 \u46972 \u46020  \u45320 \u55148 \u44032  \u46307 \u44592  \u49899 \u50612 \u54616 \u50688 \u44256  \u45236 \u44032  \u49552 \u51012  \u54204 \u51648 \u46972 \u46020  \u46028 \u50500 \u48372 \u45716  \u51088 \u44032  \u50630 \u50632 \u44256  \u46020 \u47532 \u50612  \u45208 \u51032  \u47784 \u46304  \u44368 \u54984 \u51012  \u47736 \u49884 \u54616 \u47728  \u45208 \u51032  \u52293 \u47581 \u51012  \u48155 \u51648  \u50500 \u45768 \u54616 \u50688 \'94 (\u51104  1:24, 25) \u45796 . \u44536  \u51020 \u49457 \u51008  \u44536 \u46308 \u51060  \u51082 \u50612 \u48260 \u47532 \u44256 \u51088  \u50528 \u47484  \u50044 \u45912  \u44592 \u50613 \u46308 , \u44263  \u44536 \u46308 \u51060  \u47736 \u49884 \u54620  \u44221 \u44256 , \u44144 \u51208 \u54620  \u52488 \u52397 , \u44221 \u47736 \u54620  \u53945 \u44428 \u46308 \u50640  \u45824 \u54620  \u44592 \u50613 \u51012  \u45796 \u49884  \u51068 \u51004 \u53020  \u51456 \u45796 .\
