\f1\b0 \cf0 \
\uc0\u44536 \u47084 \u45208  \u47196 \u47560 \u51032  \u44368 \u49436 \u44032  \u54952 \u44284 \u44032  \u50630 \u51648 \u45716  \u50506 \u50520 \u45796 . \u44048 \u50725 , \u44256 \u47928 , \u44160  (\u21138 ) \u46321 \u51008  \u48373 \u51333 \u51012  \u44053 \u50836 \u54616 \u45716  \u55192 \u51080 \u45716  \u47924 \u44592 \u46308 \u51060 \u50632 \u45796 . \u50672 \u50557 \u54616 \u44256  \u48120 \u49888 \u51201 \u51064  \u49324 \u46988 \u51008  \u48277 \u50773 \u51032  \u47749 \u47161  \u50526 \u50640 \u49436  \u46504 \u50632 \u45796 . \u47336 \u53552 \u50640  \u45824 \u54620  \u51068 \u48152  \u49324 \u46988 \u46308 \u51032  \u46041 \u51221 \u51008  \u51080 \u50632 \u51648 \u47564 , \u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u44060 \u54785  \u49324 \u50629  \u46412 \u47928 \u50640  \u49373 \u47749 \u51012  \u48260 \u47532 \u45716  \u44163 \u51060  \u45320 \u47924 \u46020  \u53360  \u55148 \u49373 \u51060 \u46972 \u44256  \u49373 \u44033 \u54664 \u45796 . \u47784 \u46304  \u51216 \u51004 \u47196  \u48372 \u50500 \u49436  \u44060 \u54785 \u51088 \u51032  \u49324 \u50629 \u51008  \u45149 \u45208 \u45716  \u44163 \u52376 \u47100  \u48372 \u50688 \u45796 .\
\uc0\u44536 \u47084 \u45208  \u47336 \u53552 \u45716  \u50668 \u51204 \u55176  \u46160 \u47140 \u50892 \u54616 \u51648  \u50500 \u45768 \u54616 \u50688 \u45796 . \u47196 \u47560 \u45716  \u44536 \u50640 \u44172  \u51200 \u51452 \u51032  \u47568 \u51012  \u54140 \u48512 \u50632 \u45796 . \u44536 \u47532 \u44256  \u49464 \u49345  \u49324 \u46988 \u46308 \u51008  \u44536 \u44032  \u51453 \u51076 \u51012  \u45817 \u54616 \u46304 \u51648  \u54637 \u48373 \u54624  \u49688 \u48150 \u50640  \u50630 \u51012  \u44163 \u51060 \u46972 \u44256  \u48127 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u45440 \u46972 \u50868  \u45733 \u47141 \u51004 \u47196  \u51221 \u51396 \u51032  \u49440 \u44256 \u47484  \u47196 \u47560 \u47196  \u46028 \u47140 \u48372 \u45236 \u44256  \u47196 \u47560 \u44368 \u50640 \u49436  \u50689 \u50896 \u55176  \u46496 \u45208 \u44192 \u45796 \u45716  \u44208 \u49900 \u51012  \u44277 \u51473  \u50526 \u50640 \u49436  \u54364 \u47749 \u54616 \u50688 \u45796 . \u54617 \u49373 \u46308 , \u48149 \u49324 \u46308 , \u44033  \u44228 \u44553 \u51032  \u49884 \u48124 \u46308 \u47196  \u51060 \u47336 \u50612 \u51652  \u44400 \u51473  \u50526 \u50640 \u49436  \u47336 \u53552 \u45716  \u44368 \u54924 \u51032  \u48277 \u44508 \u46308 \u44284  \u54984 \u47161 \u46308 \u44284  \u48277 \u50773 \u44428 \u51012  \u51648 \u51648 \u54616 \u45716  \u53945 \u48324 \u54620  \u51200 \u49436 \u46308 \u44284  \u54632 \u44760  \u48277 \u50773 \u51032  \u44368 \u49436 \u47484  \u53468 \u50892 \u48260 \u47160 \u45796 . \u44536 \u47532 \u44256  \u44536 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u54616 \u50688 \u45796 . \'93\u45208 \u51032  \u50896 \u49688 \u46308 \u51008  \u45208 \u51032  \u51200 \u49436 \u46308 \u51012  \u48520 \u53468 \u50880 \u51004 \u47196  \u51068 \u48152  \u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u49549 \u50640  \u51080 \u45716  \u51652 \u47532 \u51032  \u49324 \u50629 \u51012  \u49552 \u49345 \u49884 \u53412 \u44256 , \u44536 \u46308 \u51032  \u50689 \u54844 \u51012  \u54028 \u47736 \u49884 \u53040 \u45796 . \u44536 \u47084 \u48064 \u47196  \u45208 \u45716  \u44144 \u44592 \u50640  \u46384 \u46972  \u44536 \u46308 \u51032  \u52293 \u46308 \u51012  \u48520 \u53468 \u50912 \u45796 . \u48148 \u50556 \u55120 \u47196  \u50628 \u49689 \u54620  \u53804 \u51137 \u51008  \u49884 \u51089 \u46104 \u50632 \u45796 . \u51648 \u44552 \u44620 \u51648  \u45208 \u45716  \u48277 \u50773 \u51004 \u47196  \u45908 \u48520 \u50612  \u44221 \u44592  (\u31478 \u25216 ) \u47484  \u54620  \u45936  \u48520 \u44284 \u54664 \u45796 . \u45208 \u45716  \u54616 \u45208 \u45784 \u51032  \u51060 \u47492 \u51004 \u47196  \u51060  \u49324 \u50629 \u51012  \u52265 \u49688 \u54616 \u50688 \u45796 . \u44536 \u47084 \u48064 \u47196  \u44536  \u49324 \u50629 \u51008  \u45236 \u44032  \u50630 \u51012 \u51648 \u46972 \u46020  \u54616 \u45208 \u45784 \u51032  \u45733 \u47141 \u51004 \u47196  \u47560 \u52432 \u51656  \u44163 \u51060 \u45796 \'94 (D\'92Aubigne, b.6, ch.10).\
\uc0\u47336 \u53552 \u45716  \u44536 \u51032  \u49324 \u50629 \u51060  \u48120 \u50557 \u54616 \u45796 \u44256  \u51312 \u49548 \u54616 \u45716  \u50896 \u49688 \u46308 \u51032  \u48708 \u45212 \u50640  \u45824 \u54616 \u50668  \u45796 \u51020 \u44284  \u44057 \u51060  \u45824 \u45813 \u54616 \u50688 \u45796 . \'93\u54616 \u45208 \u45784 \u44760 \u49436  \u45208 \u47484  \u53469 \u54616 \u49884 \u44256  \u48512 \u47476 \u49884 \u51648  \u50506 \u51004 \u49512 \u45796 \u45716  \u44163 \u51012  \u45572 \u44032  \u50508 \u47728 , \u44536 \u46308 \u51060  \u45208 \u47484  \u47736 \u49884 \u54616 \u48064 \u47196  \u54616 \u45208 \u45784  \u51088 \u49888 \u51012  \u47736 \u49884 \u54616 \u45716  \u51068 \u51060  \u46112 \u44620  \u46160 \u47140 \u50892 \u54616 \u51648  \u50506 \u50500 \u50556  \u54620 \u45796 \u45716  \u44163 \u51012  \u45572 \u44032  \u50508 \u44192 \u45716 \u44032 ? \u47784 \u49464 \u45716  \u50528 \u44413 \u51012  \u46496 \u45216  \u46412 \u50640  \u54848 \u47196  \u51080 \u50632 \u45796 . \u50648 \u47532 \u50556 \u46020  \u50500 \u54633 \u51032  \u53685 \u52824  \u46412 \u50640  \u54848 \u47196  \u51080 \u50632 \u45796 . \u51060 \u49324 \u50556 \u46020  \u50696 \u47336 \u49332 \u47128 \u50640  \u54848 \u47196  \u51080 \u50632 \u44256 , \u50640 \u49828 \u44180 \u46020  \u48148 \u48296 \u47200 \u50640  \u54848 \u47196  \u51080 \u50632 \u45796 . \'85\u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u45824 \u51228 \u49324 \u51109 \u51060 \u45208  \u50612 \u46500  \u50948 \u45824 \u54620  \u49324 \u46988 \u51012  \u49440 \u51648 \u51088 \u47196  \u53469 \u54616 \u51648  \u50506 \u51004 \u49884 \u44256 , \u51068 \u48152 \u51201 \u51004 \u47196  \u51648 \u50948 \u44032  \u45230 \u44256  \u47736 \u49884 \u48155 \u45716  \u49324 \u46988 \u46308  \u51473 \u50640 \u49436  \u53469 \u54616 \u49512 \u45796 . \u44536 \u48516 \u44760 \u49436 \u45716  \u47785 \u51088  \u50500 \u47784 \u49828 \u47484  \u49440 \u51648 \u51088 \u47196  \u53469 \u54616 \u49888  \u51201 \u46020  \u51080 \u50632 \u45796 . \u44033  \u49884 \u45824 \u47484  \u53685 \u54616 \u50668  \u49457 \u46020 \u46308 \u51008  \u49373 \u47749 \u51032  \u50948 \u54744 \u51012  \u47924 \u47493 \u50416 \u44256  \u50948 \u45824 \u54620  \u49324 \u46988 \u46308 \u44284  \u50773 \u46308 \u44284  \u51228 \u54980 \u46308 \u44284  \u51228 \u49324 \u51109 \u46308 \u44284  \u51648 \u54812 \u47196 \u50868  \u49324 \u46988 \u46308 \u51012  \u52293 \u47581 \u54616 \u50688 \u45796 . \'85\u45208 \u45716  \u45236  \u51088 \u49888 \u51012  \u49440 \u51648 \u51088 \u46972 \u44256  \u47568 \u54616 \u51648  \u50506 \u45716 \u45796 . \u44536 \u47084 \u45208  \u45208 \u45716  \u54848 \u47196  \u51080 \u44256  \u44536 \u46308 \u51008  \u45796 \u49688 \u51060 \u44592  \u46412 \u47928 \u50640  \u44536 \u46308 \u51060  \u47560 \u46405 \u55176  \u46160 \u47140 \u50892 \u54644 \u50556  \u54620 \u45796 \u44256  \u45208 \u45716  \u47568 \u54616 \u45716  \u48148 \u51060 \u45796 . \u45208 \u45716  \u45208 \u50640 \u44172 \u45716  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51060  \u51080 \u51648 \u47564  \u44536 \u46308 \u50640 \u44172 \u45716  \u50630 \u45796 \u45716  \u44163 \u51012  \u54869 \u49888 \u54620 \u45796 \'94 (D\'92Aubigne, b.6, ch.10).\
\uc0\u44536 \u47092 \u51648 \u46972 \u46020  \u47336 \u53552 \u44032  \u44368 \u54924 \u50640 \u49436  \u47560 \u51648 \u47561 \u51004 \u47196  \u46496 \u45208 \u44256 \u51088  \u44208 \u49900 \u54616 \u44592 \u44620 \u51648 \u45716  \u47924 \u49436 \u50868  \u44040 \u46321 \u51060  \u50630 \u51648  \u50506 \u50520 \u45796 . \u44536  \u51592 \u51020 \u50640  \u44536 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u44592 \u47197 \u54616 \u50688 \u45796 . \'93\u45208 \u45716  \u49324 \u46988 \u51060  \u50976 \u45380  \u49884 \u45824 \u50640  \u48155 \u50500 \u46308 \u51064  \u44163 \u51012  \u45236 \u50612 \u48260 \u47536 \u45796 \u45716  \u44163 \u51060  \u50620 \u47560 \u45208  \u50612 \u47140 \u50868 \u44032  \u54616 \u45716  \u44163 \u51012  \u45216 \u47560 \u45796  \u45908 \u50865 \u45908  \u45712 \u45180 \u44256  \u51080 \u45796 . \u48708 \u47197  \u45208 \u45716  \u45208 \u47484  \u51648 \u51648 \u54644  \u51452 \u45716  \u49457 \u44221 \u51012  \u44032 \u51648 \u44256  \u45208  \u54844 \u51088 \u49436  \u48277 \u50773 \u51012  \u45824 \u54637 \u54616 \u44256  \u44536 \u47484  \u51201 \u44536 \u47532 \u49828 \u46020 \u46972 \u44256  \u50616 \u47749 \u54616 \u45716  \u44163 \u51060  \u45817 \u50672 \u54616 \u45796 \u45716  \u44163 \u51012  \u45236  \u51088 \u49888 \u51004 \u47196 \u45716  \u49688 \u44557 \u54664 \u51012 \u51648 \u46972 \u46020 , \u44536 \u44163 \u51008  \u45208 \u50640 \u44172  \u45320 \u47924 \u45208  \u53360  \u44256 \u53685 \u51012  \u44032 \u51256 \u45796 \u51452 \u50632 \u45796 . \u45236  \u47560 \u51020 \u49549 \u51032  \u48264 \u48124 \u51008  \u45800 \u49692 \u54616 \u51648  \u50506 \u50520 \u45796 . \u45208 \u45716  \u48277 \u50773 \u44368 \u46020 \u46308 \u51032  \u51077 \u49696 \u50640 \u49436  \u44536 \u52376 \u47100  \u51088 \u51452  \u48152 \u48373 \u46108  \u45796 \u51020 \u51032  \u51656 \u47928 \u50640  \u45824 \u54616 \u50668  \u44340 \u47196 \u50868  \u47560 \u51020 \u51004 \u47196  \u50620 \u47560 \u45208  \u50668 \u47084