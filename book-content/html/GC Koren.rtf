\uc0\u50715 \u45216 \u51032  \u49440 \u51648 \u51088 \u46308 \u51008  \u54616 \u45208 \u45784 \u51032  \u45216 \u50640  \u45824 \u54620  \u44144 \u47337 \u54620  \u44228 \u49884 \u47484  \u48372 \u44256  \u47568 \u54664 \u45796 . \'93\u45320 \u55148 \u45716  \u50528 \u44257 \u54624 \u51648 \u50612 \u45796  \u50668 \u54840 \u50752 \u51032  \u45216 \u51060  \u44032 \u44620 \u50912 \u51004 \u45768  \u51204 \u45733 \u51088 \u50640 \u44172 \u49436  \u47736 \u47581 \u51060  \u51076 \u54624  \u44163 \u51076 \u51060 \u47196 \u45796 \'94 (\u49324  13:6). \'93\u48148 \u50948 \u53960 \u50640  \u46308 \u50612 \u44032 \u47728  \u51652 \u53664 \u50640  \u49704 \u50612  \u50668 \u54840 \u50752 \u51032  \u50948 \u50628 \u44284  \u44536  \u44305 \u45824 \u54616 \u49900 \u51032  \u50689 \u44305 \u51012  \u54588 \u54616 \u46972  \u44536 \u45216 \u50640  \u45576 \u51060  \u45458 \u51008  \u51088 \u44032  \u45230 \u50500 \u51648 \u47728  \u44368 \u47564 \u54620  \u51088 \u44032  \u44404 \u48373 \u46104 \u44256  \u50668 \u54840 \u50752 \u44760 \u49436  \u54848 \u47196  \u45458 \u51076 \u51012  \u48155 \u51004 \u49884 \u47532 \u46972  \u45824 \u51200  \u47564 \u44400 \u51032  \u50668 \u54840 \u50752 \u51032  \u54620  \u45216 \u51060  \u47784 \u46304  \u44368 \u47564 \u51088 \u50752  \u44144 \u47564 \u51088 \u50752  \u51088 \u44256 \u54620  \u51088 \u50640 \u44172  \u51076 \u54616 \u50668  \u44536 \u46308 \u47196  \u45230 \u50500 \u51648 \u44172  \u54616 \u44256 \'94, \'93\u49324 \u46988 \u51060  \u49709 \u48176 \u54616 \u47140 \u44256  \u47564 \u46308 \u50632 \u45912  \u44536  \u51008  \u50864 \u49345 \u44284  \u44552  \u50864 \u49345 \u51012  \u44536 \u45216 \u50640  \u46160 \u45908 \u51536 \u50752  \u48149 \u51536 \u50640 \u44172  \u45912 \u51648 \u44256  \u50516 \u54792 \u44284  \u54744 \u50501 \u54620  \u48148 \u50948 \u53960 \u50640  \u46308 \u50612 \u44032 \u49436  \u50668 \u54840 \u50752 \u44760 \u49436  \u51068 \u50612 \u45208 \u49324  \u46405 \u51012  \u51652 \u46041 \u49884 \u53