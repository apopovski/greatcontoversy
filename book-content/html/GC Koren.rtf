\uc0\u51060 \u51228  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u50896 \u49688 \u46308  \u50526 \u50640  \u45796 \u49884  \u45208 \u53440 \u45208 \u49888 \u45796 . \u44536  \u49457 \u48372 \u45796  \u55016 \u50476  \u45458 \u51008  \u44275 , \u52268 \u46976 \u54620  \u54889 \u44552  \u44592 \u52488  \u50948 \u50640  \u45458 \u51060  \u46308 \u47536  \u48372 \u51340 \u44032  \u51080 \u45796 . \u44536  \u48372 \u51340 \u50640  \u54616 \u45208 \u45784 \u51032  \u50500 \u46308 \u51060  \u51340 \u51221 \u54616 \u49884 \u44256 , \u44536 \u48516 \u51032  \u45208 \u46972 \u51032  \u48177 \u49457 \u46308 \u51060  \u44536  \u51452 \u50948 \u47484  \u46168 \u47084 \u49916 \u45796 . \u44536 \u47532 \u49828 \u46020 \u51032  \u44428 \u45733 \u44284  \u50948 \u50628 \u51008  \u50864 \u47532 \u51032  \u47568 \u47196  \u54364 \u54788 \u54624  \u49688  \u50630 \u44256 , \u48531 \u51004 \u47196  \u47896 \u49324 \u54624  \u49688  \u50630 \u45796 . \u50689 \u50896 \u54620  \u50500 \u48260 \u51648 \u51032  \u50689 \u44305 \u51060  \u44536 \u48516 \u51032  \u50500 \u46308 \u51012  \u46168 \u47084 \u49916 \u45796 . \u54616 \u45208 \u45784 \u51032  \u51076 \u51116 \u51032  \u48731 \u51060  \u54616 \u45208 \u45784 \u51032  \u49457 \u51012  \u52649 \u47564 \u52992  \u54616 \u44256 , \u44536  \u48731 \u51060  \u49457 \u47928  \u48150 \u51004 \u47196  \u55128 \u47084 \u45208 \u50752  \u50728  \u49464 \u49345 \u51012  \u44536  \u48731 \u51004 \u47196  \u45336 \u52824 \u44172  \u54620 \u45796 .\
\uc0\u48372 \u51340  \u44032 \u51109  \u44032 \u44620 \u51060 \u50640 \u45716  \u54620  \u46412  \u49324 \u45800 \u51032  \u49324 \u50629 \u50640  \u50676 \u47148 \u54664 \u51004 \u45208  \u51648 \u44552 \u51008  \u47560 \u52824  \u48520 \u50640 \u49436  \u44732 \u45240  \u53440 \u45796  \u45224 \u51008  \u45208 \u47924 \u50752  \u44057 \u51008  \u52376 \u51648 \u50640 \u49436  \u44618 \u44256  \u50676 \u47148 \u54620  \u54732 \u49888 \u51032  \u47560 \u51020 \u51004 \u47196  \u44396 \u51452 \u47484  \u46384 \u47476 \u45716  \u51088 \u46308 \u51060  \u51080 \u45796 . \u44536  \u45796 \u51020 \u50640 \u45716  \u44144 \u51667 \u44284  \u48520 \u49888  \u44032 \u50868 \u45936 \u49436  \u44536 \u47532 \u49828 \u46020 \u51064  \u54408 \u49457 \u51012  \u50756 \u49457 \u54620  \u49324 \u46988 \u46308 \u44284 , \u44536 \u47532 \u49828 \u46020 \u44368 \u44228 \u50640 \u49436  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51060  \u54224 \u44592 \u46104 \u50632 \u45796 \u44256  \u51452 \u51109 \u54624  \u46412  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51012  \u51316 \u51473 \u54620  \u49324 \u46988 \u46308 \u44284 , \u44033  \u49884 \u45824 \u47484  \u53685 \u54616 \u50668  \u48127 \u51020 \u51012  \u50948 \u54616 \u50668  \u49692 \u44368 \u45817 \u54620  \u49688 \u47566 \u51008  \u49324 \u46988 \u46308 \u51060  \u51080 \u45796 . \u44536  \u50808 \u50640 \u46020  \'93\u44033  \u45208 \u46972 \u50752  \u51313 \u49549 \u44284  \u48177 \u49457 \u44284  \u48169 \u50616 \u50640 \u49436  \u50500 \u47924 \u46972 \u46020  \u45733 \u55176  \u49472  \u49688  \u50630 \u45716  \u53360  \u47924 \u47532 \u44032  \u55152 \u50743 \u51012  \u51077 \u44256  \u49552 \u50640  \u51333 \u47140 \u44032 \u51648 \u47484  \u46308 \u44256  \u48372 \u51340  \u50526 \u44284  \u50612 \u47536 \u50577  \u50526 \u50640  \u49436 \'94 (\u44228  7:9) \u51080 \u45796 . \u44536 \u46308 \u51008  \u51204 \u51137 \u51012  \u47560 \u52824 \u44256  \u49849 \u47532 \u47484  \u50619 \u50632 \u45796 . \u44