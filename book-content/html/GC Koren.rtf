\uc0\u44368 \u54924 \u51032  \u44060 \u54785 \u51012  \u50948 \u54616 \u50668  \u51064 \u47932 \u51012  \u49440 \u53469 \u54616 \u45716  \u45936 \u46020  \u44368 \u54924 \u47484  \u49444 \u47549 \u54624  \u46412 \u50752  \u46609 \u44057 \u51008  \u54616 \u45208 \u45784 \u51032  \u44228 \u54925 \u51060  \u45208 \u53440 \u45208  \u48372 \u51064 \u45796 . \u54616 \u45720 \u51032  \u44368 \u49324 \u51060 \u49888  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u51648 \u50948  \u51080 \u44256  \u48512 \u50836 \u54616 \u44256  \u48177 \u49457 \u51032  \u51648 \u46020 \u51088 \u47196  \u51088 \u44201 \u51012  \u44054 \u52632  \u44536 \u47084 \u54620  \u53360  \u51064 \u47932 \u46308 \u51012  \u49324 \u50857 \u54616 \u51648  \u50500 \u45768 \u54616 \u49512 \u45796 . \u44536 \u46308 \u51008  \u51088 \u44592 \u46308 \u50640 \u44172  \u51080 \u45716  \u50864 \u50900 \u44048  \u46412 \u47928 \u50640  \u44368 \u47564 \u54616 \u44256  \u51088 \u48512 \u49900 \u51060  \u44053 \u54616 \u50688 \u51004 \u48064 \u47196  \u51088 \u44592  \u46041 \u54252 \u46308 \u50640 \u44172  \u46041 \u51221 \u49900 \u51012  \u45208 \u53440 \u45236 \u44144 \u45208  \u44216 \u49552 \u54616 \u49888  \u45208 \u49324 \u47131  \u49324 \u46988 \u44284  \u54632 \u44760  \u54801 \u47141 \u54624  \u49688  \u50630 \u45716  \u49324 \u46988 \u46308 \u51060 \u50632 \u45796 . \u44536 \u47084 \u48064 \u47196  \u47924 \u49885 \u54616 \u44256 , \u49688 \u44256 \u54616 \u44592 \u47484  \u51339 \u50500 \u54616 \u45716  \u44040 \u47540 \u47532 \u51032  \u50612 \u48512 \u46308 \u50640 \u44172  \'93\u45208 \u47484  \u46384 \u46972  \u50724 \u46972  \u45236 \u44032  \u45320 \u55148 \u47196  \u49324 \u46988 \u51012  \u45210 \u45716  \u50612 \u48512 \u44032  \u46104 \u44172  \u54616 \u47532 \u46972 \'94 (\u47560  4:19) \u45716  \u48512 \u47476 \u49900 \u51060  \u51452 \u50612 \u51276 \u45796 . \u44536  \u51228 \u51088 \u46308 \u51008  \u44216 \u49552 \u54616 \u44256  \u44032 \u47476 \u52840 \u51012  \u48155 \u51012  \u49688  \u51080 \u45716  \u49324 \u46988 \u46308 \u51060 \u50632 \u45796 . \u44536  \u49324 \u46988 \u46308 \u51008  \u45817 \u49884 \u50640  \u54945 \u54665 \u54616 \u45912  \u44144 \u51667  \u44368 \u54984 \u51032  \u50689 \u54693 \u51012  \u48708 \u44368 \u51201  \u51201 \u44172  \u48155 \u51008  \u49324 \u46988 \u46308 \u51060 \u50632 \u51004 \u48064 \u47196 , \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u49324 \u50629 \u51012  \u50948 \u54616 \u50668  \u51200 \u46308 \u51012  \u45908 \u50865  \u54952 \u44284 \u51201 \u51004 \u47196  \u44032 \u47476 \u52824 \u44256  \u54984 \u47144 \u49884 \u53420  \u49688  \u51080 \u51004 \u49512 \u45912  \u44163 \u51060 \u45796 . \u44536  \u49324 \u49892 \u51008  \u50948 \u45824 \u54620  \u51333 \u44368 \u44060 \u54785  \u45817 \u49884 \u50640 \u46020  \u50669 \u49884  \u47560 \u52268 \u44032 \u51648 \u50688 \u45796 . \u51648 \u46020 \u51201  \u50669 \u54624 \u51012  \u54620  \u44060 \u54785 \u51088 \u46308 \u51008  \u48708 \u52380 \u54620  \u44032 \u47928 \u51032  \u52636 \u49888 \u46308 \u47196 \u49436 , \u45817 \u49884 \u50640  \u44228 \u44553 \u51032 \u49885 \u50640 \u49436  \u50724 \u45716  \u44368 \u47564 \u44284  \u48120 \u49888 \u51201  \u44048 \u54868 \u50752  \u49457 \u51649 \u51088 \u51032  \u51060 \u44592 \u51201  \u52293 \u47029 \u50640 \u49436  \u50724 \u45716  \u50689 \u54693 \u51012  \u44032 \u51109  \u51201 \u44172  \u48155 \u51008  \u49324 \u46988 \u46308 \u51060 \u50632 \u45796 . \u53360  \u44277 \u51201 \u51012  \u49457 \u52712 \u54616 \u44592  \u50948 \u54616 \u50668  \u48708 \u52380 \u54620  \u51064 \u51116 \u47484  \u50416 \u49884 \u45716  \u44163 \u51060  \u54616 \u45208 \u45784 \u51032  \u44228 \u54925 \u51060 \u45796 . \u44536 \u47084 \u48064 \u47196  \u50689 \u44305 \u51008  \u49324 \u46988 \u46308 \u50640 \u44172  \u46028 \u47540  \u44163 \u51060  \u50500 \u45768 \u44256  \u44536 \u46308 \u51012  \u53685 \u54616 \u50668  \u45817 \u49888 \u51032  \u44592 \u49240 \u49888  \u46907 \u51012  \u54665 \u54616 \u49884 \u45716  \u54616 \u45208 \u45784 \u44760  \u47560 \u46405 \u55176  \u46028 \u47140 \u51656  \u44163 \u51060 \u50632 \u45796 .\
\uc0\u47336 \u53552 \u44032  \u51089 \u49468 \u51032  \u54620  \u44305 \u48512 \u51032  \u51665 \u50640 \u49436  \u53468 \u50612 \u45212  \u51648  \u47751  \u51452 \u51068  \u54980 \u50640 , \u50872 \u47532 \u55176  \u52768 \u48729 \u44544 \u47532  (Ulrich Zwingli) \u44032  \u50508 \u54532 \u49828  \u49328 \u51473 \u50640  \u51080 \u45716  \u54620  \u47785 \u51088 \u51032  \u50724 \u47561 \u49332 \u51060 \u50640 \u49436  \u52636 \u49373 \u54616 \u50688 \u45796 . \u50976 \u45380  \u49884 \u45824 \u51032  \u52768 \u48729 \u44544 \u47532 \u51032  \u54872 \u44221 \u44284  \u44368 \u50977 \u51008  \u44536 \u44032  \u51109 \u47000 \u51032  \u49324 \u47749 \u51012  \u50948 \u54616 \u50668  \u51456 \u48708 \u54616 \u45716  \u45936  \u47588 \u50864  \u51201 \u45817 \u54616 \u50688 \u45796 . \u44536 \u45716  \u50885 \u51109 \u54616 \u44256 , \u50500 \u47492 \u45813 \u44256 , \u49709 \u50628  (\u23815 \u22196 ) \u54620  \u52380 \u50672 \u44228 \u51032  \u54408 \u49549 \u50640 \u49436  \u51088 \u46972 \u45228 \u45796 . \u44536 \u47084 \u48064 \u47196  \u44536 \u51032  \u47560 \u51020 \u51008  \u51068 \u52237 \u48512 \u53552  \u54616 \u45208 \u45784 \u51032  \u50948 \u50628 \u44284  \u44428 \u45733 \u44284  \u50948 \u45824 \u54616 \u49900 \u50640  \u45824 \u54616 \u50668  \u44618 \u51008  \u51064 \u49345 \u51012  \u48155 \u50520 \u45796 . \u53945 \u55176  \u44536 \u51032  \u44256 \u54693 \u51064  \u49328 \u51473 \u50640 \u49436  \u51312 \u49345 \u46308 \u51060  \u49457 \u52712 \u54620  \u50629 \u51201 \u44284  \u50857 \u44048 \u54620  \u54665 \u50948 \u50640  \u45824 \u54620  \u50669 \u49324 \u45716  \u44536 \u51032  \u51210 \u51008  \u50837 \u47581 \u51012  \u48520 \u53440 \u44172  \u54644 \u51452 \u50632 \u45796 . \u44536 \u45716  \u46608 \u54620  \u54616 \u45208 \u45784 \u51012  \u46021 \u49892 \u55176  \u48127 \u45716  \u44536 \u51032  \u51312 \u47784  \u44225 \u50640 \u49436  \u44368 \u54924 \u51032  \u47566 \u51008  \u51204 \u49444 \u44284  \u44256 \u45812  (\u21476 \u35527 ) \u50640  \u44036 \u54841  \u45208 \u53440 \u45208 \u45716  \u44480 \u51473 \u54620  \u49457 \u44221  \u47568 \u50432 \u51012  \u46308 \u50632 \u45796 . \u44536 \u45716  \u55141 \u48120 \u51652 \u51652 \u54620  \u47560 \u51020 \u51004 \u47196 , \u48512 \u51312 \u46308 \u44284  \u49440 \u51648 \u51088 \u46308 \u51032  \u50948 \u45824 \u54620  \u50629 \u51201 , \u54036 \u47112 \u49828 \u54004  \u49328 \u52492 \u50640 \u49436  \u50577 \u47924 \u47532 \u47484  \u51648 \u53412 \u45912  \u47785 \u51088 \u46308 \u50640 \u44172  \u52380 \u49324 \u44032  \u45208 \u53440 \u45208 \u49436  \u51060 \u50556 \u44592 \u54620  \u44163 , \u48288 \u46308 \u47112 \u54772 \u51032  \u50500 \u44592 , \u44040 \u48148 \u47532 \u51032  \u49324 \u46988  \u50696 \u49688 \u45784 \u50640  \u44288 \u54620  \u51060 \u50556 \u44592 \u46308 \u51012  \u46308 \u50632 \u45796 .\
\uc0\u47560 \u54004  \u47336 \u53552 \u50752  \u47560 \u52268 \u44032 \u51648 \u47196  \u52768 \u48729 \u44544 \u47532 \u51032  \u48512 \u52828 \u46020  \u51088 \u49885 \u51032  \u44368 \u50977 \u50640  \u45824 \u54616 \u50668  \u53356 \u44172  \u50976 \u51032 \u54620  \u45208 \u47672 \u51648 , \u51068 \u52237 \u48512 \u53552  \u44536 \u47484  \u44256 \u54693 \u50640 \u49436  \u45236 \u50612 \u48372 \u45256 \u45796 . \u52768 \u48729 \u44544 \u47532 \u51032  \u51648 \u45733 \u51008  \u45320 \u47924  \u48744 \u47532  \u44228 \u48156 \u46104 \u50632 \u44592  \u46412 \u47928 \u50640  \u44536 \u50640 \u44172  \u51201 \u45817 \u54620  \u44368 \u49324 \u47484  \u48156 \u44204 \u54616 \u44592 \u51312 \u52264  \u50612 \u47140 \u50868  \u54805 \u54200 \u51060 \u50632 \u45796 . \u44536 \u45716  13\u49464  \u46412 , \u45817 \u49884  \u49828 \u50948 \u49828 \u50640 \u49436  \u44032 \u51109  \u50864 \u49688 \u54620  \u54617 \u44368 \u44032  \u51080 \u45716  \u48288 \u47480  (Bern) \u51004 \u47196  \u48372 \u45236 \u50612 \u51276 \u45796 . \u44536 \u47088 \u45936  \u44144 \u44592 \u49436  \u44536 \u51032  \u51204 \u46020 \u50976 \u47581 \u54620  \u50526 \u44600 \u51012  \u50948 \u54801 \u54616 \u45716  \u50948 \u54744 \u54620  \u49324 \u44148 \u51060  \u49373 \u44220 \u45796 . \u44536 \u44163 \u51008  \u49849 \u47140 \u46308 \u51060  \u44536 \u47484  \u49849 \u50896 \u51004 \u47196  \u45132 \u50612 \u46308 \u51060 \u44256 \u51088  \u45800 \u54840 \u54620  \u45432 \u47141 \u51012  \u54616 \u50688 \u44592  \u46412 \u47928 \u51060 \u50632 \u45796 . \u45817 \u49884 \u50640  \u46020 \u48120 \u45768 \u53356 \u54924  (Dominican) \u50752  \u54532 \u46976 \u52404 \u49828 \u53076  \u49688 \u46020 \u54924  (Franciscan) \u45716  \u54588 \u52264  \u45908  \u53360  \u51064 \u44592 \u47484  \u50619 \u44256 \u51088  \u44221 \u51137 \u54616 \u44256  \u51080 \u50632 \u45796 . \u44536 \u47196  \u51064 \u54616 \u50668  \u44536 \u46308 \u51008  \u44033 \u44033  \u44536 \u46308 \u51032  \u44368 \u54924 \u46308 \u51012  \u54868 \u47140 \u54616 \u44172  \u51109 \u49885 \u54616 \u44256 , \u54868 \u47140 \u54620  \u51032 \u49885 \u46308 \u51012  \u54665 \u54616 \u44256 , \u50976 \u47749 \u54620  \u50976 \u47932  (\u36986 \u29289 ) \u46308 \u44284  \u49548 \u50948  \u51060 \u51201 \u51012  \u54665 \u54620 \u45796 \u45716  \u51312 \u44033 \u54620  \u54805 \u49345 \u46308 \u47196  \u51064 \u44592 \u47484  \u50619 \u44256 \u51088  \u50528 \u50416 \u44256  \u51080 \u50632 \u45796 .\
