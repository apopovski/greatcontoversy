\f0\b \cf0 \uc0\u54588 \u50640  \u52712 \u54620  \u44397 \u48124  \u51032 \u54924 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u51060 \u49457 \u51032  \u50696 \u48176 \u47484  \u49548 \u44060 \u54620  \u54620  \u48320 \u49324 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u54616 \u50688 \u45796 . \'93\u51077 \u48277  \u51032 \u50896  \u50668 \u47084 \u48516 , \u44305 \u49888 \u51008  \u51060 \u49457  \u50526 \u50640  \u44600 \u51012  \u50577 \u48372 \u54664 \u49845 \u45768 \u45796 . \u44536  \u55120 \u47536  \u45576 \u51004 \u47196 \u45716  \u48731 \u51032  \u44305 \u52292 \u47484  \u48380  \u49688  \u50630 \u50632 \u49845 \u45768 \u45796 . \u50724 \u45720  \u47924 \u49688 \u54620  \u44400 \u51473 \u51060  \u44256 \u46357 \u49885  \u46181 \u44540  \u52380 \u51109  \u50500 \u47000  \u47784 \u50688 \u49845 \u45768 \u45796 . \u44536 \u47532 \u54616 \u50668  \u52376 \u51020 \u51004 \u47196  \u51652 \u47532 \u47484  \u45796 \u49884  \u48152 \u54693  (\u21453 \u38911 ) \u49884 \u53412 \u44256  \u51080 \u49845 \u45768 \u45796 . \u50668 \u44592 \u49436  \u54532 \u46993 \u49828  \u44397 \u48124 \u51008  \u50976 \u51068 \u51032  \u52280  \u50696 \u48176 , \u44263  \u51088 \u50976 \u50752  \u51060 \u49457 \u50640 \u44172  \u50696 \u48176 \u47484  \u46300 \u47160 \u49845 \u45768 \u45796 . \u46608  \u50668 \u44592 \u49436  \u44277 \u54868 \u44397 \u51032  \u44400 \u45824 \u51032  \u49457 \u44277 \u51012  \u50948 \u54616 \u50668  \u44592 \u50896 \u54616 \u50688 \u49845 \u45768 \u45796 . \u50864 \u47532 \u45716  \u49332 \u50500  \u51080 \u45716  \u47932 \u52404  \u44263  \u51088 \u50672 \u51032  \u44152 \u51089 \u54408 \u51064  \u51060 \u49457 \u51032  \u50668 \u49888 \u51012  \u52712 \u54616 \u44592  \u50948 \u54616 \u50668  \u49373 \u44592  \u50630 \u45716  \u50864 \u49345 \u51012  \u48260 \u47160 \u49845 \u45768 \u45796 \'94 (M.A.Thiers, History of the French Revolution, vol.2, pp.370, 371).\
\uc0\u50668 \u49888 \u51060  \u49885 \u51109 \u50640  \u46308 \u50612 \u44032 \u51088 \u47560 \u51088  \u48320 \u49324 \u45716  \u44536 \u51032  \u49552 \u51012  \u51105 \u44256  \u54924 \u51473 \u51012  \u54693 \u54616 \u50668  \u47568 \u54616 \u50688 \u45796 . \'93\u49324 \u46988 \u46308 \u51060 \u50668 , \u44536 \u45824 \u46308 \u51032  \u44277 \u54252 \u49900 \u51060  \u47564 \u46308 \u50612 \u45240  \u47924 \u47141 \u54620  \u54616 \u45208 \u45784 \u51032  \u48516 \u45432  \u50526 \u50640 \u49436  \u45908  \u51060 \u49345  \u46504 \u51648  \u47568 \u46972 . \u44536 \u47084 \u48064 \u47196  \u51060 \u51228 \u48512 \u53552 \u45716  \u51060 \u49457  \u51060 \u50808 \u45716  \u50500 \u47924 \u44163 \u46020  \u49888 \u51004 \u47196  \u51064 \u51221 \u52824  \u47568 \u46972 . \u45208 \u45716  \u50668 \u47084 \u48516 \u50640 \u44172  \u51060 \u49457 \u51032  \u44032 \u51109  \u49709 \u44256 \u54616 \u44256  \u49692 \u44208 \u54620  \u49345  (\u20687 ) \u51012  \u50668 \u44592 \u49436  \u48372 \u50668  \u51456 \u45796 . \u47564 \u51068  \u50668 \u47084 \u48516 \u51060  \u48152 \u46300 \u49884  \u50864 \u49345 \u51012  \u44032 \u51256 \u50556  \u54620 \u45796 \u47732  \u51060 \u50752  \u44057 \u51008  \u50864 \u49345 \u50640 \u44172 \u47564  \u51228 \u49324 \u47484  \u46300 \u47140 \u46972 . \u51088  \u51060 \u49457 \u51032  \u50668 \u49888 \u51032  \u51228 \u47561 \u49885 \u51012  \u51088 \u50976 \u51032  \u51032 \u54924  \u50526 \u50640 \u49436  \u44144 \u54665 \u54620 \u45796 .\'94\
\'93\uc0\u50668 \u49888 \u51008  \u51032 \u54924 \u51109 \u51032  \u54252 \u50745 \u51012  \u48155 \u51008  \u54980  \u54868 \u47140 \u54620  \u49688 \u47112 \u50640  \u53468 \u50892 \u51256 , \u47566 \u51008  \u44400 \u51473 \u46308  \u49324 \u51060 \u47484  \u53685 \u44284 \u54616 \u50668  \u45432 \u53944 \u47476 \u45812  \u49457 \u45817 \u51004 \u47196  \u51064 \u46020 \u46104 \u50632 \u45796 . \u44144 \u44592 \u49436  \u44536 \u45716  \u54616 \u45208 \u45784 \u51032  \u50948 \u52824 \u47484  \u52264 \u51648 \u54616 \u50668  \u45458 \u51008  \u51228 \u45800  \u50948 \u50640  \u50505 \u50500  \u52280 \u49437 \u54620  \u47784 \u46304  \u51088 \u46308 \u51032  \u44221 \u48176 \u47484  \u48155 \u50520 \u45796 \'94 (Alison, vol.1, ch.17).\
\uc0\u51060  \u51068 \u51060  \u51080 \u51008  \u51648  \u50620 \u47560  \u54980 \u50640 , \u44277 \u51473  \u50526 \u50640 \u49436  \u49457 \u44221 \u51012  \u48520 \u53468 \u50892  \u48260 \u47532 \u45716  \u51068 \u51060  \u51080 \u50632 \u45796 . \u50612 \u46500  \u54924 \u54633 \u50640 \u49436 \u45716  \u48149 \u47932 \u44288  \u49436 \u48124  \u54801 \u54924 \u51032  \u49324 \u46988 \u46308 \u51060  \'93\u51060 \u49457  \u47564 \u49464 \'94\u47484  \u48512 \u47476 \u47732 \u49436  \u49884  (\u24066 ) \u51032  \u44277 \u54924 \u45817 \u51004 \u47196  \u46308 \u50612 \u44052 \u45796 . \u44536 \u46308 \u51008  \u47561 \u45824 \u44592  \u45149 \u50640 \u45796 \u44032  \u48152 \u52196  \u48520 \u53440 \u45796  \u45224 \u51008  \u47751  \u44428 \u51032  \u52293 \u46308 \u51012  \u45040 \u46763 \u50612  \u47700 \u44256  \u44052 \u45796 . \u44536  \u52293 \u46308  \u51473 \u50640 \u45716  \u52380 \u51452 \u44368 \u51032  \u49457 \u47924 \u51068 \u44284  (\u32854 \u21209 \u26085 \u35506 ), \u48120 \u49324 \u49436 , \u49888 \u44396 \u50557  \u49457 \u44221  \u46321 \u51060  \u51080 \u50632 \u45716 \u45936 , \u51032 \u51109 \u51008  \u44536  \u52293 \u46308 \u50640  \u45824 \u54616 \u50668  \'93\u51064 \u47448 \u50640 \u44172  \u50728 \u44054  \u50612 \u47532 \u49437 \u51008  \u51068 \u51012  \u54665 \u54616 \u44172  \u54616 \u50688 \u51004 \u48064 \u47196  \u53360  \u48520 \u47196  \u48372 \u51025 \u51012  \u48155 \u50520 \u45796 \'94 (Journal of Paris, 1973, No.381.Quoted in Buchez-Roux, Collection of Parliamentary History, vol.30, pp.200, 201) \u44256  \u47568 \u54616 \u50688 \u45796 .\
\uc0\u44536 \u47088 \u45936  \u47924 \u49888 \u47200 \u51088 \u46308 \u51060  \u50756 \u49457 \u49884 \u53412 \u44256  \u51080 \u50632 \u45912  \u51068 \u51012  \u49884 \u51089 \u54620  \u44163 \u51008  \u48277 \u50773 \u44428 \u51060 \u50632 \u45796 . \u54532 \u46993 \u49828 \u47484  \u44553 \u49549 \u55176  \u47736 \u47581 \u51004 \u47196  \u48128 \u50612 \u45347 \u51008  \u49324 \u54924 \u51201 , \u51221 \u52824 \u51201 , \u51333 \u44368 \u51201 \u51064  \u47784 \u46304  \u49345 \u53468 \u45716  \u47196 \u47560 \u44368 \u51032  \u51221 \u52293 \u51060  \u51060 \u47336 \u50612  \u45459 \u50520 \u45796 . \u54532 \u46993 \u49828  \u54785 \u47749  \u45817 \u49884 \u51032  \u47924 \u49436 \u50868  \u49345 \u53468 \u47484  \u44592 \u49696 \u54620  \u54620  \u51200 \u51088 \u45716  \u50773 \u50948 \u50752  \u44368 \u54924 \u44032  \u44536  \u44537 \u45800 \u51201 \u51064  \u54665 \u46041 \u46308 \u50640  \u45824 \u54620  \u52293 \u51076 \u51012  \u51256 \u50556  \u54624  \u44163 \u51060 \u46972 \u44256  \u47568 \u54616 \u50688 \u45796  (\u48512 \u47197  21 \u52280 \u51312 ). \u50628 \u44201 \u55176  \u48708 \u54032 \u54616 \u47732  \u44536 \u44163 \u46308 \u51008  \u47784 \u46160  \u44368 \u54924 \u50640 \u49436  \u52293 \u51076 \u51012  \u51256 \u50556  \u54620 \u45796 . \u48277 \u50773 \u44368 \u45716  \u51333 \u44368 \u44060 \u54785 \u51012  \u50773 \u50948 \u51032  \u51201 \u51060 \u50836 , \u44397 \u44032 \u51032  \u50504 \u45397 \u44284  \u51656 \u49436 \u47484  \u54028 \u44340 \u54616 \u45716  \u48520 \u54868 \u51032  \u50836 \u49548 \u46972 \u44256  \u47568 \u54632 \u51004 \u47196 \u50024  \u50773 \u46308 \u51032  \u47560 \u51020 \u51012  \u51088 \u44537 \u54616 \u50688 \u45796 . \u50773 \u50948 \u47484  \u53685 \u54616 \u50668  \u44032 \u51109  \u48708 \u52280 \u54616 \u44256  \u51092 \u51064 \u54616 \u47728  \u44032 \u51109  \u44204 \u46364  \u49688  \u50630 \u45716  \u50517 \u51228 \u50752  \u48149 \u54644 \u47484  \u54665 \u54620  \u44163 \u51008  \u44536 \u50752  \u44057 \u51008  \u47784 \u50577 \u51004 \u47196  \u44256 \u52712 \u46108  \u47196 \u47560 \u51032  \u51221 \u49888 \u50640  \u51032 \u54620  \u44163 \u51060 \u50632 \u45796 .\
\uc0\u51088 \u50976 \u51032  \u51221 \u49888 \u51008  \u49457 \u44221 \u44284  \u48337 \u54665 \u54616 \u50688 \u45796 . \u48373 \u51020 \u51012  \u48155 \u50500 \u46308 \u51064  \u44275 \u50640 \u49436 \u45716  \u50612 \u46356 \u49436 \u45208  \u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u51060  \u44033 \u49457 \u46104 \u50632 \u45796 . \u44536 \u46308 \u51008  \u47924 \u51648 \u50752  \u48512 \u46020 \u45909 \u44284  \u48120 \u49888 \u51032  \u45432 \u50696 \u47196  \u49549 \u48149 \u46104 \u50612  \u50728  \u51656 \u44257  (\u26702 \u26767 ) \u51012  \u44648 \u46888 \u47532 \u44592  \u49884 \u51089 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u51088 \u50976 \u51064 \u51004 \u47196  \u49373 \u44033 \u54616 \u44256  \u54665 \u54616 \u44592  \u49884 \u51089 \u54616 \u50688 \u45796 . \u50773 \u46308 \u51008  \u44536 \u47084 \u54620  \u51068 \u46308 \u51012  \u48372 \u44256  \u51200 \u46308 \u51032  \u51204 \u51228  \u51221 \u52824 \u51032  \u51109 \u47000 \u47484  \u50684 \u47140 \u54616 \u50688 \u45796 .\
\uc0\u47196 \u47560 \u45716  \u50773 \u46308 \u51032  \u51656 \u53804 \u51201  \u44277 \u54252 \u49900 \u51012  \u51088 \u44537 \u54616 \u45716  \u45936  \u44172 \u51004 \u47476 \u51648  \u50506 \u50520 \u45796 . 1525\u45380 \u50640  \u48277 \u50773 \u51008  \u54532 \u46993 \u49828 \u51032  \u49453 \u51221  (\u25885 \u25919 ) \u50640 \u44172  \u47568 \u54616 \u50688 \u45796 . \'93\u51060  \u51333 \u44368 \u44305  (\u23447 \u25934 \u29378 -\u54532 \u47196 \u53580 \u49828 \u53444 \u53944 \u47484  \u44032 \u47532 \u53428 ) \u46308 \u51008  \u51333 \u44368 \u44228 \u47484  \u54844 \u46976 \u52992  \u54616 \u44256  \u54028 \u44340 \u54624  \u49104 \u47564  \u50500 \u45768 \u46972  \u45208 \u46972 \u51032  \u53685 \u52824 \u44428 , \u44480 \u51313  \u44228 \u44553 , \u48277 \u47456 , \u51656 \u49436 , \u44228 \u44553  \u46321 \u51012  \u54028 \u44340 \u54616 \u45716  \u51088 \u46308 \u51060 \u45796 \'94 (G.de F\'92elice, History of the Protestants of France, b.1, ch.2, Par.8). \u48520 \u44284  \u47751  \u45380  \u54980 \u50640  \u48277 \u50773  \u49324 \u51208 \u51008  \u54889 \u51228 \u50640 \u44172  \u45796 \u51020 \u44284  \u44057 \u51060  \u44221 \u44256 \u54616 \u50688 \u45796 . \'93\u54224 \u54616 \u50668 , \u49549 \u51648  \u47560 \u49901 \u49884 \u50724 . \u54532 \u47196 \u53580 \u49828 \u53444 \u53944 \u46308 \u51008  \u51333 \u44368 \u51032  \u51656 \u49436 \u45716  \u47932 \u47200 \u51060 \u50836 , \u44397 \u44032 \u51032  \u51656 \u49436 \u46020  \u47784 \u46160  \u51204 \u48373 \u49884 \u53420  \u44163 \u51077 \u45768 \u45796 . \u50773 \u50948 \u45716  \u51228 \u45800  (\u31085 \u22727 ) \u44284  \u47560 \u52268 \u44032 \u51648 \u47196  \u50948 \u54744 \u54633 \u45768 \u45796 . \'85\u49352  \u51333 \u44368 \u44032  \u46308 \u50612 \u50724 \u47732  \u49352  \u51221 \u48512 \u44032  \u54596 \u50672 \u51201 \u51004 \u47196  \u46308 \u50612 \u49444  \u44163 \u51077 \u45768 \u45796 \'94 (D\'92Aubigne, History of the Reformation in Europe in the Time of Calvin, b.2, ch.36). \u46608 \u54620  \u49888 \u54617 \u51088 \u46308 \u51008  \u54532 \u47196 \u53580 \u49828 \u53444 \u53944 \u46308 \u50640  \u45824 \u54616 \u50668  \'93\u49324 \u46988 \u46308 \u51012  \u50976 \u51064 \u54616 \u50668  \u49888 \u44592 \u54620  \u44163 \u44284  \u50612 \u47532 \u49437 \u51008  \u51068 \u51012  \u54616 \u44172 \u54616 \u47728 , \u50773 \u51004 \u47196  \u54616 \u50668 \u44552  \u49888 \u54616 \u46308 \u51032  \u52649 \u49457 \u49900 \u51012  \u51075 \u50612 \u48260 \u47532 \u44172  \u54616 \u50668  \u44368 \u54924 \u50752  \u45208 \u46972 \u47484  \u45796  \u44057 \u51060  \u54028 \u44340 \u49884 \u53412 \u45716  \u51088 \u46308 \u51060 \u45796 \'94\u44256  \u51452 \u51109 \u54632 \u51004 \u47196  \u48177 \u49457 \u46308 \u51032  \u54200 \u44204 \u50640  \u54840 \u49548 \u54616 \u50688 \u45796 .\
\uc0\u51060 \u47532 \u54616 \u50668  \u47196 \u47560 \u44368 \u45716  \u54532 \u46993 \u49828 \u44032  \u51333 \u44368 \u44060 \u54785  \u50868 \u46041 \u51012  \u48152 \u45824 \u54616 \u44172  \u54616 \u45716  \u51068 \u50640  \u49457 \u44277 \u54616 \u50688 \u45796 . \'93\u54532 \u46993 \u49828 \u50640 \u49436  \u48149 \u54644 \u51032  \u52860 \u51012  \u52376 \u51020 \u51004 \u47196  \u46304  \u44163 \u51008  \u50773 \u50948 \u47484  \u51648 \u53489 \u54616 \u44256 , \u44480 \u51313 \u51012  \u48372 \u54840 \u54616 \u44256 , \u48277 \u47456 \u51012  \u50976 \u51648 \u54616 \u44592  \u50948 \u54644 \u49436 \u50688 \u45796 \'94 (Wylie, b.13, ch.4).\
