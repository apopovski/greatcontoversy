\uc0\u54616 \u45208 \u45784 \u51032  \u49453 \u47532 \u45716  \u50668 \u51204 \u55176  \u50668 \u47084  \u49324 \u44148 \u51012  \u51648 \u48176 \u54616 \u50668  \u44060 \u54785  \u49324 \u50629 \u51060  \u48156 \u51204 \u46112  \u49688  \u51080 \u45716  \u44592 \u54924 \u47484  \u51228 \u44277 \u54664 \u45796 . \u44536 \u47112 \u44256 \u47532 \u50864 \u49828  \u48277 \u50773 \u51060  \u51453 \u51008  \u54980 \u50640  \u46160  \u48277 \u50773 \u51060  \u45824 \u47549 \u54616 \u50668  \u49440 \u52636 \u46104 \u50632 \u45716 \u45936 , \u44536 \u46308 \u51008  \u44033 \u44033  \u51088 \u44592 \u44032  \u51208 \u45824 \u47196  \u47924 \u47448 \u54616 \u45796 \u44256  \u44277 \u50616 \u54616 \u44256  \u49324 \u46988 \u46308 \u51032  \u48373 \u51333 \u51012  \u50836 \u44396 \u54616 \u50688 \u45796  (\u48512 \u47197  15 \u52280 \u51312 . \u46608 \u54620  \u48512 \u47197  2\u47484  \u48372 \u46972 ). \u46160  \u49324 \u46988 \u51008  \u44033 \u44033  \u51088 \u44592 \u50640 \u44172  \u52649 \u49457 \u54616 \u45716  \u51088 \u46308 \u51012  \u49548 \u51665 \u54616 \u50668  \u49345 \u45824 \u54200 \u50640 \u44172  \u46020 \u51204 \u54616 \u44172  \u54616 \u44256 , \u51088 \u44592 \u47484  \u45824 \u51201 \u54616 \u45716  \u51088 \u50640 \u44172 \u45716  \u49900 \u54620  \u51200 \u51452 \u47484  \u54616 \u45716  \u54620 \u54200 , \u51088 \u44592 \u47484  \u51648 \u51648 \u54616 \u45716  \u51088 \u50640 \u44172 \u45716  \u54616 \u45720 \u50640 \u49436  \u48372 \u49345 \u51012  \u48155 \u51012  \u44163 \u51012  \u50557 \u49549 \u54632 \u51004 \u47196  \u51088 \u44592 \u47484  \u51648 \u51648 \u54644  \u51452 \u44592 \u47484  \u44053 \u50836 \u54616 \u50688 \u45796 . \u51060 \u47084 \u54620  \u49324 \u53468 \u47196  \u47568 \u48120 \u50516 \u50500  \u48277 \u50773 \u44428 \u51032  \u49464 \u47141 \u51008  \u54788 \u51200 \u54616 \u44172  \u50557 \u54868 \u46104 \u50632 \u45796 . \u46160  \u54028 \u45716  \u44033 \u44033  \u51080 \u45716  \u55192 \u51012  \u45796 \u54616 \u50668  \u49345 \u45824 \u48169 \u51012  \u44277 \u44201 \u54616 \u50688 \u51004 \u48064 \u47196 , \u44536  \u53960 \u51012  \u53440 \u49436  \u50948 \u53364 \u47532 \u54532 \u45716  \u50620 \u47560  \u46041 \u50504  \u55092 \u49885 \u51012  \u52712 \u54624  \u49688  \u51080 \u50632 \u45796 . \u49436 \u47196  \u51200 \u51452 \u54616 \u44256  \u48708 \u45212 \u54616 \u45716  \u53804 \u51137 \u51060  \u46160  \u48277 \u50773  \u49324 \u51060 \u50640  \u51204 \u44060 \u46104 \u50632 \u44256 , \u44033 \u51088 \u51032  \u51452 \u51109 \u51012  \u49464 \u50864 \u44592  \u50948 \u54616 \u50668  \u50976 \u54792  \u52280 \u44537 \u44620 \u51648  \u48268 \u50688 \u45796 . \u44368 \u54924  \u50504 \u50640 \u45716  \u48276 \u51396 \u50752  \u52628 \u47928 \u51060  \u52264 \u44256  \u45336 \u52452 \u45796 . \u51060 \u47084 \u45716  \u49324 \u51060 \u50640  \u44060 \u54785 \u51088  \u50948 \u53364 \u47532 \u54532 \u45716  \u47336 \u53552 \u50892 \u46300 \u50640  \u51008 \u44144 \u54616 \u47732 \u49436  \u49436 \u47196  \u49912 \u50864 \u44256  \u51080 \u45716  \u48277 \u50773 \u46308 \u47196 \u48512 \u53552  \u49324 \u46988 \u46308 \u51032  \u45576 \u51012  \u54217 \u54868 \u51032  \u51076 \u44552 \u51060 \u49888  \u50696 \u49688 \u45784 \u44760 \u47196  \u46028 \u47532 \u44256 \u51088  \u50528 \u47484  \u50044 \u45796 .\
\uc0\u50728 \u44054  \u53804 \u51137 \u44284  \u53440 \u46973 \u51012  \u51088 \u50500 \u45240  \u48516 \u50676 \u51008  \u49324 \u46988 \u46308 \u47196  \u54616 \u50668 \u44552  \u48277 \u50773 \u44428 \u51032  \u51652 \u49345 \u51060  \u47924 \u50631 \u51064 \u51648 \u47484  \u50508 \u47140  \u51452 \u50612  \u46020 \u47532 \u50612  \u44060 \u54785 \u51032  \u44600 \u51012  \u50676 \u50612  \u51452 \u50632 \u45796 . \u50948 \u53364 \u47532 \u54532 \u45716  \u51088 \u44592 \u44032  \u51200 \u49696 \u54620  \'93\u48277 \u50773 \u51032  \u48520 \u48277 \'94\u51060 \u46976  \u49548 \u52293 \u51088 \u50640 \u49436  \u49436 \u47196  \u49345 \u45824 \u54200 \u51012  \u51201 \u44536 \u47532 \u49828 \u46020 \u46972 \u44256  \u51221 \u51396 \u54616 \u44256  \u51080 \u45716  \u46160  \u49849 \u47140 \u51032  \u47568 \u51060  \u52280 \u47568 \u51064 \u51648  \u49373 \u44033 \u54644  \u48372 \u46972 \u44256  \u48177 \u49457 \u46308 \u51032  \u51452 \u51032 \u47484  \u54872 \u44592 \u49884 \u53040 \u45796 . \u44536 \u45716  \'93\u54616 \u45208 \u45784 \u44760 \u49436  \u51060 \u48120  \u50501 \u47560 \u50752  \u44057 \u51008  \u44536 \u46308  \u51473 \u51032  \u54616 \u45208 \u47196 \u47564  \u53685 \u52824 \u46104 \u45716  \u44163 \u51012  \u54728 \u46973 \u51648  \u50500 \u45768 \u54616 \u49884 \u44256 \'85\u49324 \u46988 \u46308 \u51060  \u44536 \u47532 \u49828 \u46020 \u51032  \u51060 \u47492 \u51004 \u47196  \u44536 \u46308 \u51012  \u45908 \u50865  \u49789 \u44172  \u51060 \u44600  \u49688  \u51080 \u46020 \u47197  \u54616 \u44592  \u50948 \u54616 \u50668  \u46168  \u49324 \u51060 \u50640  \u48516 \u50676 \u51012  \u51068 \u51004 \u53412 \u49512 \u45796 \'94 (R.Vaughan, Life and Opinions of John de Wycliffe, vol.2, p.6) \u44256  \u47568 \u54616 \u50688 \u45796 .\
\uc0\u50948 \u53364 \u47532 \u54532 \u45716  \u44536 \u51032  \u51452 \u45784 \u52376 \u47100  \u48712 \u44260 \u54620  \u49324 \u46988 \u46308 \u50640 \u44172  \u48373 \u51020 \u51012  \u51204 \u54616 \u50688 \u45796 . \u44536 \u45716  \u47336 \u53552 \u50892 \u46300 \u51032  \u44368 \u44396  \u50504 \u50640  \u51080 \u45716  \u48708 \u52380 \u54620  \u48177 \u49457 \u46308 \u50640 \u44172 \u47564  \u48731 \u51012  \u51204 \u54616 \u45716  \u44163 \u51004 \u47196  \u55137 \u51313 \u55176  \u50668 \u44592 \u51648  \u50506 \u44256 , \u50689 \u44397 \u51032  \u44033  \u44275 \u50640  \u51204 \u54644 \u50556  \u54616 \u44192 \u45796 \u44256  \u44208 \u49900 \u54616 \u50688 \u45796 . \u44536 \u45716  \u44536  \u47785 \u51201 \u51012  \u50948 \u54616 \u50668  \u51652 \u47532 \u47484  \u49324 \u46993 \u54616 \u47728  \u44536 \u44163 \u51012  \u45328 \u47532  \u51613 \u44144 \u54616 \u44592  \u50948 \u54616 \u50668  \u50500 \u47924 \u44163 \u46020  \u50500 \u45180 \u51648  \u50500 \u45768 \u54616 \u45716  \u45800 \u49692 \u54616 \u44256  \u44221 \u44148 \u54620  \u49440 \u44368 \u49324 \u46308 \u47196  \u44396 \u49457 \u46108  \u54616 \u45208 \u51032  \u51312 \u51649 \u52404 \u47484  \u47564 \u46308 \u50632 \u45796 . \u44536 \u46308 \u51008  \u50612 \u45712  \u44275 \u51060 \u46304 \u51648  \u44032 \u49436  \u49884 \u51109  (\u24066 \u22580 ) \u50640 \u49436 \u45208  \u45824 \u46020 \u49884 \u51032  \u44144 \u47532 \u50640 \u49436 \u45208  \u49884 \u44264 \u51032  \u44600 \u44032 \u50640 \u49436  \u49444 \u44368 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u45721 \u51008 \u51060 \u46308 \u44284  \u48337 \u46304  \u51088 \u46308 \u44284  \u44032 \u45212 \u54620  \u51088 \u46308 \u51012  \u52286 \u50500 \u44032 \u49436  \u54616 \u45208 \u45784 \u51032  \u51008 \u54812 \u51032  \u44592 \u49244  \u49548 \u49885 \u51012  \u51204 \u54616 \u50688 \u45796 .\
\uc0\u50948 \u53364 \u47532 \u54532 \u45716  \u50725 \u49828 \u54252 \u46300  \u45824 \u54617 \u44368 \u51032  \u49888 \u54617  \u44368 \u49688 \u47196 \u49436  \u44536  \u45824 \u54617 \u51032  \u44053 \u45817 \u50640 \u49436  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51012  \u44053 \u51032 \u54616 \u50688 \u45796 . \u44536 \u45716  \u51088 \u44592 \u50640 \u44172  \u44032 \u47476 \u52840 \u51012  \u48155 \u45716  \u54617 \u49373 \u46308 \u50640 \u44172  \u51652 \u47532 \u47484  \u45320 \u47924 \u46020  \u49457 \u49892 \u54616 \u44172  \u49548 \u44060 \u54616 \u50688 \u51004 \u48064 \u47196  \u48373 \u51020  \u48149 \u49324 \u46972 \u45716  \u48324 \u47749 \u51012  \u50619 \u50632 \u45796 . \u44536 \u47084 \u45208  \u50948 \u53364 \u47532 \u54532 \u51032  \u50728  \u49373 \u50528 \u47484  \u53685 \u54616 \u50668  \u52572 \u45824 \u51032  \u49324 \u50629 \u51060 \u46972 \u44256  \u54624  \u47564 \u54620  \u44163 \u51008  \u49457 \u44221 \u51012  \u50689 \u50612 \u47196  \u48264 \u50669 \u54620  \u44163 \u51060 \u50632 \u45796 . \u44536 \u45716  \'93\u49457 \u44221 \u51032  \u51652 \u47532 \u50752  \u51032 \u48120 \'94\u46972 \u45716  \u51200 \u49436 \u50640 \u49436  \u51088 \u44592 \u44032  \u49457 \u44221 \u51012  \u48264 \u50669 \u54616 \u50668  \u50689 \u44397  \u44397 \u48124 \u51004 \u47196  \u54616 \u50668 \u44552  \u47784 \u46160  \u51088 \u44397 \u50612 \u47196  \u54616 \u45208 \u45784 \u51032  \u45440 \u46972 \u50868  \u50629 \u51201 \u51012  \u51069 \u51012  \u49688  \u51080 \u44172  \u54624  \u46907 \u51060  \u51080 \u45796 \u45716  \u44163 \u51012  \u54364 \u47749 \u54616 \u50688 \u45796 .\
