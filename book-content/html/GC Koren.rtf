\f1\b0 \cf0 \
\uc0\u49324 \u45800 \u51008  \u50640 \u45940 \u50640 \u49436  \u50500 \u52392 \u51004 \u47196 , \u44552 \u51648 \u46108  \u51648 \u49885 \u51012  \u50619 \u44256 \u51088  \u54616 \u45716  \u50837 \u47581 \u51012  \u51068 \u51004 \u53428 \u51004 \u47196 , \u49828 \u49828 \u47196  \u45458 \u44256 \u51088  \u54616 \u45716  \u50556 \u47581 \u51012  \u51088 \u44537 \u49884 \u53428 \u51004 \u47196  \u54616 \u50752 \u47484  \u49549 \u51064  \u44163 \u52376 \u47100  \u50724 \u45720 \u45216  \u49324 \u46988 \u46308 \u51012  \u49549 \u51060 \u44256  \u51080 \u45796 . \u44536 \u47088  \u51333 \u47448 \u51032  \u50501 \u51012  \u44036 \u51649 \u54632 \u51004 \u47196  \u49324 \u45800  \u51088 \u49888 \u51060  \u53440 \u46973 \u54616 \u44172  \u46104 \u50632 \u51004 \u48064 \u47196  \u44536 \u45716  \u46608 \u54620  \u44536 \u47088  \u44163 \u46308 \u51012  \u53685 \u54616 \u50668  \u49324 \u46988 \u46308 \u51012  \u47736 \u47581 \u49884 \u53412 \u44256 \u51088  \u47785 \u51201 \u54616 \u44256  \u51080 \u45796 . \u44536 \u45716  \'93\u54616 \u45208 \u45784 \u44284  \u44057 \u51060  \u46104 \u50612 \'85\u49440 \u50501 \u51012  \u50508 \'94 (\u52285  3:5) \u44172  \u46112  \u44163 \u51060 \u46972 \u44256  \u47568 \u54620 \u45796 . \u44053 \u49888 \u49696 \u51008  \'93\u49324 \u46988 \u51060  \u54693 \u49345 \u54616 \u45716  \u46041 \u47932 \u51060 \u48064 \u47196  \u45216  \u46412 \u48512 \u53552  \u54616 \u45208 \u45784 \u51012  \u54693 \u54616 \u50668  \u50689 \u50896 \u55176  \u54693 \u49345 \u54624  \u50868 \u47749 \u51012  \u44032 \u51648 \u44256  \u51080 \u45796 \'94\u44256  \u44032 \u47476 \u52828 \u45796 . \u46608 \u54620  \'93\u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u51008  \u44033 \u44033  \u51088 \u49888 \u51060  \u54032 \u45800 \u54624  \u44163 \u51060 \u50836  \u45796 \u47480  \u49324 \u46988 \u51060  \u54624  \u44163 \u51060  \u50500 \u45768 \u45796 \'94, \'93\u44536  \u54032 \u45800 \u51008  \u49828 \u49828 \u47196 \u51032  \u54032 \u45800 \u51060 \u48064 \u47196  \u51221 \u54869 \u54620  \u44163 \u51060 \u50836  \'85\u44536  \u54032 \u45800 \u51032  \u48372 \u51340 \u45716  \u44536 \u45824  \u49549 \u50640  \u51080 \u45796 \'94\u44256  \u54620 \u45796 . \u54620  \u44053 \u49888 \u49696  \u44368 \u49324 \u45716  \'93\u45208 \u51032  \u46041 \u54252 \u50668  \u50689 \u51201  \u51032 \u49885 \'94\u51060  \u47560 \u51020 \u49549 \u50640 \u49436  \u49373 \u44600  \u46412  \'93\u47784 \u46304  \u49324 \u46988 \u51008  \u53440 \u46973 \u54616 \u51648  \u50500 \u45768 \u54620  \u48152 \u49888 \u48152 \u51064  (\u21322 \u31070 \u21322 \u20154 ) \u46308 \u51060  \u46104 \u50632 \u45796 \'94\u44256  \u47568 \u54616 \u50688 \u45796 . \u46608  \u45796 \u47480  \u49324 \u46988 \u51008  \'93\u45572 \u44396 \u46304 \u51648  \u51032 \u47213 \u44256  \u50756 \u51204 \u54620  \u51088 \u45716  \u44536 \u47532 \u49828 \u46020 \u45796 \'94\u44256  \u47568 \u54620 \u45796 .\
\uc0\u44536 \u47532 \u54616 \u50668  \u49324 \u45800 \u51008  \u52280 \u46108  \u44221 \u48176 \u51032  \u45824 \u49345 \u51060  \u46104 \u45716  \u47924 \u54620 \u54616 \u49888  \u54616 \u45208 \u45784 \u51032  \u51032 \u50752  \u50756 \u51204  \u44536 \u47532 \u44256  \u49324 \u46988 \u51060  \u46020 \u45804 \u54616 \u50668 \u50556  \u54624  \u52280 \u46108  \u54364 \u51456 \u51060  \u46104 \u45716  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51032  \u50756 \u51204 \u54620  \u51032  \u45824 \u49888 \u50640 , \u51396 \u50752  \u44144 \u51667 \u51060  \u47566 \u51008  \u49324 \u46988  \u51088 \u49888 \u51032  \u48376 \u49457 \u51012  \u44221 \u48176 \u51032  \u50976 \u51068 \u54620  \u45824 \u49345 \u51004 \u47196 , \u54032 \u45800 \u51032  \u50976 \u51068 \u54620  \u52377 \u46020  \u54841 \u51008  \u51064 \u44201 \u51032  \u54364 \u51456 \u51004 \u47196  \u45824 \u52404 \u49884 \u53040 \u45796 . \u51060 \u44163 \u51008  \u51652 \u48372 \u44032  \u50500 \u45768 \u46972  \u53748 \u48372 \u51060 \u45796 .\
\uc0\u51648 \u51201 \'b7\u50689 \u51201 \u51064  \u47732  \u47784 \u46160 \u50640 \u49436  \u48148 \u46972 \u48388 \u51004 \u47196  \u48320 \u54868 \u54616 \u44172  \u46108 \u45796 \u45716  \u44163 \u51008  \u54616 \u45208 \u51032  \u48277 \u52825 \u51060 \u45796 . \u49324 \u46988 \u51032  \u47560 \u51020 \u51008  \u49689 \u44256 \u54616 \u46020 \u47197  \u54728 \u46973 \u46108  \u49324 \u47932 \u50640  \u51216 \u52264 \u51201 \u51004 \u47196  \u51201 \u51025 \u46108 \u45796 . \u44536 \u47084 \u48064 \u47196  \u47560 \u51020 \u51008  \u49845 \u44288 \u51201 \u51004 \u47196  \u49324 \u46993 \u54616 \u44256  \u51316 \u44221 \u54616 \u45716  \u44163 \u50640  \u46041 \u54868 \u46108 \u45796 . \u49324 \u46988 \u51008  \u51088 \u49888 \u51060  \u51221 \u54620  \u49692 \u44208 \u44284  \u50577 \u49440 \u44284  \u51652 \u49892 \u51032  \u54364 \u51456  \u51060 \u49345 \u51004 \u47196  \u54693 \u49345 \u54624  \u49688  \u50630 \u45796 . \u47564 \u51068  \u51088 \u50500 \u47484  \u51088 \u49888 \u51032  \u52572 \u44256 \u51032  \u51060 \u49345 \u51004 \u47196  \u49340 \u45716 \u45796 \u47732  \u44536 \u45716  \u51088 \u44592  \u51060 \u49345 \u51032  \u54364 \u51456 \u50640  \u44208 \u53076  \u46020 \u45804 \u54624  \u49688  \u50630 \u45796 . \u50724 \u55176 \u47140  \u44536 \u45716  \u51216 \u51216  \u45908  \u53748 \u48372 \u46104 \u50612  \u44040  \u44163 \u51060 \u45796 . \u44536 \u47084 \u45208  \u54616 \u45208 \u45784 \u51032  \u51008 \u54812 \u47564 \u51008  \u49324 \u46988 \u51012  \u44256 \u49345 \u54616 \u44172  \u54616 \u45716  \u45733 \u47141 \u51012  \u44032 \u51648 \u44256  \u51080 \u45796 . \u51088 \u44592  \u51088 \u49888 \u47564 \u51012  \u49888 \u47280 \u54616 \u47732  \u44536 \u45716  \u54596 \u50672 \u51201 \u51004 \u47196  \u53748 \u48372 \u54624  \u49688 \u48150 \u50640  \u50630 \u45796 .\
