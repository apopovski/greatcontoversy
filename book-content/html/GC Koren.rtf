\uc0\u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u49373 \u50528  \u44032 \u50868 \u45936  \u45224 \u45376 \u46308 \u51060  \u54616 \u45720 \u50640  \u51201 \u54633 \u54620  \u49324 \u46988 \u46308 \u51060  \u46104 \u47140 \u47732  \u49688 \u46020 \u50896 \u50640  \u47931 \u54784 \u50556  \u54620 \u45796 \u45716  \u50500 \u47924 \u47088  \u47784 \u48376 \u46020  \u51452 \u51648  \u50506 \u51004 \u49888 \u45796 . \u44536 \u48516 \u51008  \u49324 \u46993 \u44284  \u46041 \u51221 \u49900 \u51012  \u50613 \u51228 \u54644 \u50556  \u54620 \u45796 \u44256  \u44208 \u53076  \u44032 \u47476 \u52824 \u51648  \u50506 \u51004 \u49512 \u45796 . \u44396 \u51452 \u51032  \u47560 \u51020 \u51008  \u49324 \u46993 \u51004 \u47196  \u45336 \u52432  \u51080 \u50632 \u45796 . \u49324 \u46988 \u51060  \u46020 \u45909 \u51201 \u51004 \u47196  \u50756 \u51204 \u54644 \u51648 \u47732  \u51656 \u49688 \u47197  \u44536 \u51032  \u44048 \u49688 \u49457 \u51008  \u45908 \u50865  \u50696 \u48124 \u54644 \u51648 \u44256  \u51396 \u50640  \u45824 \u54620  \u51648 \u44033 \u51008  \u45908 \u50865  \u48157 \u50500 \u51648 \u47728  \u44256 \u53685 \u54616 \u45716  \u51088 \u46308 \u50640  \u45824 \u54620  \u46041 \u51221 \u49900 \u51008  \u45908 \u50865  \u44618 \u50612 \u51652 \u45796 . \u48277 \u50773 \u51008  \u44536 \u47532 \u49828 \u46020 \u51032  \u45824 \u47532 \u51088 \u46972 \u44256  \u51452 \u51109 \u54620 \u45796 . \u44536 \u47084 \u45208  \u44536 \u51032  \u54408 \u49457 \u51012  \u50864 \u47532  \u44396 \u51452 \u51032  \u54408 \u49457 \u44284  \u50612 \u46523 \u44172  \u48708 \u44368 \u54624  \u49688  \u51080 \u51012 \u44620 ? \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u45817 \u49888 \u51012  \u54616 \u45720 \u51032  \u50773 \u51004 \u47196  \u51316 \u44221 \u54616 \u51648  \u50506 \u50520 \u45796 \u45716  \u51060 \u50976 \u47196  \u49324 \u46988 \u46308 \u51012  \u44048 \u50725 \u51060 \u45208  \u44256 \u47928 \u45824 \u50640  \u45336 \u44200 \u51452 \u49888  \u51068 \u51060  \u51080 \u50632 \u45716 \u44032 ? \u44536 \u48516 \u44760 \u49436  \u45817 \u49888 \u51012  \u48127 \u51648  \u50506 \u51008  \u51088 \u46308 \u50640 \u44172  \u51453 \u51020 \u51012  \u49440 \u44256 \u54616 \u45716  \u47568 \u50432 \u51012  \u54616 \u49888  \u51201 \u51060  \u51080 \u45716 \u44032 ? \u50696 \u49688 \u45784 \u44760 \u49436  \u49324 \u47560 \u47532 \u50500 \u51064 \u51032  \u54620  \u47560 \u51012 \u50640 \u49436  \u49324 \u46988 \u46308 \u50640 \u44172  \u46321 \u54620 \u55176  \u50668 \u44608 \u51012  \u48155 \u51004 \u49884 \u51088  \u49324 \u46020  \u50836 \u54620 \u51008  \u51032 \u48516 \u51012  \u52280 \u51648  \u47803 \u54616 \u50668  \u51656 \u47928 \u54616 \u50688 \u45796 . \'93\u51452 \u50668  \u50864 \u47532 \u44032  \u48520 \u51012  \u47749 \u54616 \u50668  \u54616 \u45720 \u47196  \u51923 \u50500 \u45236 \u47140  \u51200 \u55148 \u47484  \u47736 \u54616 \u46972  \u54616 \u44592 \u47484  \u50896 \u54616 \u49884 \u45208 \u51060 \u44620 \'94 (\u45573  9:54). \u50696 \u49688 \u45784 \u44760 \u49436 \u45716  \u51088 \u48708 \u47196 \u50868  \u45576 \u51004 \u47196  \u45817 \u49888 \u51032  \u51228 \u51088 \u47484  \u48372 \u49884 \u47728  \u44536 \u51032  \u44284 \u44201 \u54620  \u51221 \u49888 \u51012  \u52293 \u47581 \u54616 \u49512 \u45796 . \'93\u51064 \u51088 \u45716  \u49324 \u46988 \u51032  \u49373 \u47749 \u51012  \u47736 \u54616 \u47084  \u50728  \u44163 \u51060  \u50500 \u45768 \u50836  \u44396 \u54616 \u47084  \u50772 \u45432 \u46972 \'94 (\u45573  9:56 \u45212 \u50808  \u51452 ). \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u45208 \u53440 \u45236 \u49888  \u44536  \u51221 \u49888 \u51008  \u44536 \u48516 \u51032  \u45824 \u54364 \u51088 \u46972 \u44256  \u44277 \u50616 \u54616 \u45716  \u49324 \u46988 \u51032  \u51221 \u49888 \u44284  \u50620 \u47560 \u45208  \u53360  \u52264 \u51060 \u44032  \u51080 \u45716 \u44032 .\
\uc0\u50724 \u45720 \u45216  \u47196 \u47560 \u44368 \u45716  \u44536 \u51032  \u47924 \u49436 \u50868  \u51092 \u54617 \u49457 \u51032  \u44592 \u47197 \u51012  \u48320 \u47749 \u51004 \u47196  \u45934 \u50612  \u48260 \u47532 \u44256  \u50500 \u47924  \u51068 \u46020  \u50630 \u45716  \u46319 \u51060  \u49464 \u49345 \u51012  \u45824 \u54620 \u45796 . \u44536 \u45716  \u44536 \u47532 \u49828 \u46020 \u50752  \u44057 \u51008  \u52264 \u47548 \u51004 \u47196  \u45208 \u49436 \u51648 \u47564  \u49892 \u49345 \u51008  \u50500 \u47924 \u47088  \u48320 \u54868 \u44032  \u50630 \u45796 . \u51648 \u45208 \u44036  \u49884 \u45824 \u50640  \u51316 \u51116 \u54664 \u45912  \u48277 \u50773 \u44368 \u51032  \u50896 \u52825 \u46308 \u51008  \u50724 \u45720 \u45216 \u50640 \u46020  \u51316 \u51116 \u54620 \u45796 . \u44032 \u51109  \u50516 \u55121 \u54620  \u49884 \u45824 \u50640  \u44256 \u50504 \u46108  \u44368 \u47532 \u46308 \u51008  \u50724 \u45720 \u45216 \u50640 \u46020  \u50668 \u51204 \u55176  \u49892 \u52380 \u46104 \u44256  \u51080 \u45796 . \u44536 \u47084 \u48064 \u47196  \u50500 \u47924 \u46020  \u50668 \u44592 \u50640  \u49549 \u50500 \u49436 \u45716  \u50504  \u46108 \u45796 . \u50724 \u45720 \u45216  \u44060 \u49888 \u44368 \u46020 \u46308 \u51060  \u51316 \u44221 \u54616 \u44256 \u51088  \u54616 \u45716  \u48277 \u50773 \u44368 \u45716  \u51333 \u44368  \u44060 \u54785  \u45817 \u49884 \u50640  \u49464 \u49345 \u51012  \u51648 \u48176 \u54616 \u50688 \u44256  \u44536  \u45817 \u49884  \u54616 \u45208 \u45784 \u44760  \u49549 \u54620  \u49324 \u46988 \u46308 \u51060  \u44536 \u51032  \u51396 \u47484  \u54253 \u47196 \u54616 \u44592  \u50948 \u54616 \u50668  \u44536 \u46308 \u51032  \u49373 \u47749 \u51012  \u44152 \u44256  \u54637 \u51137 \u54620  \u44536  \u46041 \u51068 \u54620  \u47196 \u47560 \u44368 \u51060 \u45796 . \u44536 \u45716  \u50773 \u46308 \u44284  \u44400 \u51452 \u46308 \u51012  \u45796 \u49828 \u47532 \u44256  \u54616 \u45208 \u45784 \u44760  \