\f1\b0 \cf0 \
\uc0\u50501 \u51060  \u46308 \u50612 \u50724 \u44592  \u51204 \u50640 \u45716  \u50864 \u51452 \u50640  \u54217 \u54868 \u50752  \u44592 \u49256 \u51060  \u51080 \u50632 \u45796 . \u47784 \u46304  \u44163 \u51008  \u52285 \u51312 \u51452 \u51032  \u46907 \u50640  \u50756 \u51204 \u55176  \u51312 \u54868 \u46104 \u50632 \u45796 . \u54616 \u45208 \u45784 \u44760  \u45824 \u54620  \u49324 \u46993 \u51008  \u52572 \u49345 \u51032  \u44163 \u51060 \u50632 \u44256  \u49324 \u46988 \u44284  \u49324 \u46988  \u49324 \u51060 \u51032  \u49324 \u46993 \u46020  \u44277 \u51221 \u54616 \u50688 \u45796 . \u47568 \u50432 \u51060 \u49888  \u44536 \u47532 \u49828 \u46020 , \u54616 \u45208 \u45784 \u51032  \u46021 \u49373 \u51088 \u45716  \u44536  \u48376 \u51656 \u44284  \u54408 \u49457 \u44284  \u47785 \u51201 \u50640  \u51080 \u50612 \u49436  \u50689 \u50896 \u54616 \u49888  \u54616 \u45208 \u45784  \u50500 \u48260 \u51648 \u50752  \u51068 \u52404 \u50688 \u44256 , \u50728  \u50864 \u51452 \u50640 \u49436  \u47924 \u49832  \u51068 \u50640 \u46304 \u51648  \u54616 \u45208 \u45784 \u44284  \u54632 \u44760  \u51032 \u45436 \u54616 \u44256  \u44228 \u54925 \u54616 \u49884 \u45716  \u50976 \u51068 \u51032  \u48516 \u51060 \u49512 \u45796 . \u54616 \u45720  \u50500 \u48260 \u51648 \u44760 \u49436 \u45716  \u44536 \u47532 \u49828 \u46020 \u47484  \u53685 \u54616 \u50668  \u54616 \u45720 \u50640  \u51080 \u45716  \u47784 \u46304  \u44163 \u46308 \u51012  \u52285 \u51312 \u54616 \u49512 \u45796 . \'93\u47564 \u47932 \u51060  \u44536 \u50640 \u44172  \u52285 \u51312 \u46104 \u46104  \u54616 \u45720 \u44284  \u46405 \u50640 \u49436  \u48372 \u51060 \u45716  \u44163 \u46308 \u44284  \u48372 \u51060 \u51648  \u50506 \u45716  \u44163 \u46308 \u44284  \u54841 \u51008  \u48372 \u51340 \u46308 \u51060 \u45208  \u51452 \u44288 \u51088 \u46308 \u51060 \u45208  \u51221 \u49324 \u46308 \u51060 \u45208  \u44428 \u49464 \u46308 \u51060 \u45208  \u47564 \u47932 \u51060  \u45796  \u44536 \u47196  \u47568 \u48120 \u50516 \u44256  \u44536 \u47484  \u50948 \u54616 \u50668  \u52285 \u51312 \u46104 \u50632 \'94 (\u44264  1:16) \u45796 . \u44536 \u47084 \u48064 \u47196  \u50728  \u54616 \u45720 \u51008  \u54616 \u45720  \u50500 \u48260 \u51648 \u44760  \u54616 \u45716  \u44163 \u44284  \u47560 \u52268 \u44032 \u51648 \u47196  \u44536 \u47532 \u49828 \u46020 \u44760  \u52649 \u49457 \u51012  \u45796 \u54620 \u45796 .\
\uc0\u49324 \u46993 \u51032  \u50984 \u48277 \u51060  \u54616 \u45208 \u45784 \u51032  \u51221 \u48512 \u51032  \u44592 \u52488 \u44032  \u46104 \u48064 \u47196  \u47784 \u46304  \u54588 \u51312 \u47932 \u46308 \u51008  \u44536  \u53360  \u50896 \u52825 \u50640  \u50756 \u51204 \u55176  \u51068 \u52824 \u54632 \u51004 \u47196 \u50024  \u54665 \u48373 \u51012  \u45572 \u47532 \u44172  \u46108 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u47784 \u46304  \u54588 \u51312 \u47932 \u51060  \u49324 \u46993 \u51032  \u48393 \u49324 , \u44263  \u51452 \u45784 \u51032  \u49457 \u54408 \u51012  \u51060 \u51648 \u51201  (\u63972 \u26234 \u30340 ) \u51004 \u47196  \u51060 \u54644 \u54616 \u48064 \u47196  \u49373 \u44592 \u45716  \u44221 \u48176 \u47484  \u46300 \u47532 \u44592 \u47484  \u50836 \u44396 \u54616 \u49888 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u44053 \u51228 \u51201 \u51064  \u52649 \u49457 \u51012  \u44592 \u48848 \u54616 \u51648  \u50506 \u51004 \u49888 \u45796 . \u44536 \u48516 \u44760 \u49436 \u45716  \u47784 \u46304  \u49324 \u46988 \u50640 \u44172  \u51032 \u51648 \u51032  \u51088 \u50976 \u47484  \u54728 \u46973 \u54616 \u49492 \u49436  \u44536 \u46308 \u51060  \u51452 \u45784 \u44760  \u51088 \u48156 \u51201  \u48393 \u49324 \u47484  \u54624  \u49688  \u51080 \u44172  \u54616 \u49888 \u45796 .\
