\uc0\u47336 \u53552 \u44032  \u53685 \u54665 \u44428 \u51012  \u49548 \u50976 \u54616 \u44256  \u51080 \u51012 \u51648 \u46972 \u46020 , \u48277 \u50773 \u45817 \u46308 \u51008  \u44536 \u47484  \u52404 \u54252 \u54616 \u50668  \u53804 \u50725 \u49884 \u53420  \u51020 \u47784 \u47484  \u44984 \u47748 \u45796 . \u47336 \u53552 \u51032  \u52828 \u44396 \u46308 \u51008  \u44536 \u44032  \u45908  \u51060 \u49345  \u52404 \u47448 \u54616 \u45716  \u44163 \u51060  \u47924 \u51061 \u54620  \u51068 \u51076 \u51012  \u50508 \u44256  \u44536 \u50640 \u44172  \u51593 \u49884  \u48708 \u53584 \u48288 \u47476 \u53356 \u47196  \u46028 \u50500 \u44040  \u44163 \u44284  \u44536  \u44228 \u54925 \u50640  \u45824 \u54616 \u50668  \u48708 \u48128 \u51012  \u52384 \u51200 \u55176  \u51648 \u53412 \u48064 \u47196  \u45224 \u50640 \u44172  \u45576 \u52824  \u52292 \u51060 \u51648  \u50506 \u44172  \u54616 \u46020 \u47197  \u44428 \u50976 \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u45716  \u51648 \u48169  \u51109 \u44288 \u51060  \u48372 \u45236 \u51456  \u54620  \u49324 \u46988 \u51032  \u50504 \u45236 \u51088 \u47484  \u46384 \u46972  \u49352 \u48317 \u50640  \u47568 \u51012  \u53440 \u44256  \u50500 \u50864 \u53356 \u49828 \u48512 \u47476 \u53356 \u47484  \u46496 \u45228 \u45796 . \u50526 \u44600 \u50640  \u44032 \u47196 \u45459 \u51064  \u50668 \u47084  \u44032 \u51648  \u50612 \u47140 \u50880 \u51012  \u50696 \u49345 \u54616 \u47732 \u49436 , \u44256 \u50836 \u54616 \u44256  \u50612 \u46160 \u50868  \u49884 \u44032 \u51648 \u47484  \u47792 \u47000  \u48736 \u51256 \u45208 \u50772 \u45796 . \u51092 \u51064 \u54620  \u50896 \u49688 \u46308 \u51008  \u48169 \u49900 \u54616 \u51648  \u50506 \u44256  \u44536 \u47484  \u51453 \u51060 \u47140 \u44256  \u51020 \u47784 \u47484  \u44984 \u48120 \u44256  \u51080 \u50632 \u45796 . \u44536 \u47484  \u51105 \u51004 \u47140 \u44256  \u54196  \u45459 \u51008  \u54632 \u51221 \u51012  \u44536 \u44032  \u54588 \u54644 \u45208 \u44040  \u49688  \u51080 \u51012 \u44620 ? \u51652 \u49892 \u47196  \u51060  \u46412 \u50556 \u47568 \u47196  \u47588 \u50864  \u50684 \u47140 \u46104 \u45716  \u46412 \u50836 , \u50676 \u47148 \u54620  \u44592 \u46020 \u44032  \u54596 \u50836 \u54620  \u46412 \u51060 \u50632 \u45796 . \u44536  \u46020 \u49884 \u51032  \u49457 \u48317  (\u22478 \u22721 ) \u50640  \u51080 \u45716  \u51089 \u51008  \u47928 \u50640  \u45817 \u46020 \u54616 \u50688 \u45796 . \u47928 \u51008  \u44536 \u50640 \u44172  \u50676 \u47532 \u50612 \u51648 \u44256 , \u44536 \u45716  \u50500 \u47924 \u47088  \u51109 \u50528  \u50630 \u51060  \u50504 \u45236 \u51088 \u50752  \u54632 \u44760  \u47928 \u48150 \u51004 \u47196  \u48736 \u51256 \u45208 \u50772 \u45796 . \u51068 \u45800  \u47928 \u48150 \u51004 \u47196  \u47924 \u49324 \u55176  \u48736 \u51256  \u45208 \u50724 \u51088  \u44536 \u46308 \u51008  \u44600 \u51012  \u51116 \u52489 \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u47336 \u53552 \u45716  \u48277 \u50773 \u51032  \u49324 \u51208 \u51060  \u44536 \u51032  \u53448 \u52636 \u51012  \u50508 \u44592  \u51204 \u50640  \u48149 \u54644 \u51088 \u51032  \u49552 \u51060  \u48120 \u52824 \u51648  \u47803 \u54624  \u44275 \u44620 \u51648  \u44032 \u48260 \u47160 \u45796 . \u49324 \u45800 \u44284  \u44536 \u51032  \u48512 \u54616 \u46308 \u51008  \u54056 \u48176 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51032  \u49552 \u50500 \u44480 \u50640  \u51105 \u54784  \u51080 \u45716  \u51460 \u47196  \u49373 \u44033 \u54664 \u45912  \u44536  \u49324 \u46988 \u51008  \u47560 \u52824  \u54620  \u47560 \u47532 \u51032  \u49352 \u44032  \u49352  \u49324 \u45285 \u44988 \u51032  \u44536 \u47932 \u51012  \u48279 \u50612 \u45208 \u46319 \u51060  \u44536 \u46308 \u51032  \u49688 \u51473 \u50640 \u49436  \u48279 \u50612 \u45228 \u45796 .\
\uc0\u47336 \u53552 \u44032  \u46020 \u47581 \u54616 \u50688 \u45796 \u45716  \u49548 \u49885 \u51012  \u46307 \u51088  \u48277 \u50773 \u51032  \u49324 \u51208 \u51008  \u47588 \u50864  \u45440 \u46972 \u44256  \u48516 \u44060 \u54616 \u50688 \u45796 . \u44536 \u45716  \u44368 \u54924 \u47484  \u50612 \u51648 \u47101 \u44172  \u54616 \u45716  \u51088 \u47484  \u52376 \u45800 \u54616 \u45716  \u51068 \u50640  \u51080 \u50612 \u49436  \u51088 \u49888 \u51032  \u51648 \u54812 \u50752  \u45800 \u54840 \u54620  \u44208 \u45800 \u47141 \u51012  \u45208 \u53440 \u45236 \u48064 \u47196  \u53360  \u47749 \u50696 \u47484  \u50619 \u51012  \u44163 \u51012  \u51008 \u44540 \u55176  \u48148 \u46972 \u44256  \u51080 \u50632 \u45716 \u45936 , \u51060 \u51228  \u44536  \u55148 \u47581 \u51060  \u49324 \u46972 \u51276 \u45796 . \u44536 \u45716  \u51088 \u49888 \u51032  \u48516 \u45432 \u47484  \u51089 \u49468  (Saxony) \u51032  \u49440 \u54980  (\u36984 \u20399 ) \u54532 \u47532 \u46300 \u47532 \u55176  (Frederick) \u50640 \u44172  \u48372 \u45236 \u45716  \u54200 \u51648 \u50640  \u45208 \u53440 \u45256 \u45796 . \u44536 \u45716  \u44536  \u54200 \u51648 \u50640 \u49436  \u47336 \u53552 \u47484  \u49888 \u46980 \u55176  \u48708 \u45212 \u54616 \u44256  \u54532 \u47532 \u46300 \u47532 \u55176 \u47196  \u54616 \u50668 \u44552  \u44536 \u47484  \u47196 \u47560 \u47196  \u48372 \u45236 \u46304 \u44032  \u51089 \u49468 \u50640 \u49436  \u52628 \u48169 \u54616 \u46304 \u44032  \u54644 \u51452 \u44592 \u47484  \u50836 \u44396 \u54616 \u50688 \u45796 .\
\uc0\u47336 \u53552 \u45716  \u51088 \u49888 \u51032  \u51452 \u51109 \u51012  \u48320 \u54840 \u54616 \u47732 \u49436  \u48277 \u50773 \u51060 \u45208  \u48277 \u50773 \u51032  \u49324 \u51208 \u50640 \u44172  \u49457 \u44221 \u49345 \u51004 \u47196  \u51088 \u44592 \u51032  \u50724 \u47448  (\u35492 \u35628 ) \u47484  \u51648 \u51201 \u54644  \u51452 \u44592 \u47484  \u50836 \u44396 \u54616 \u50688 \u45796 . \u44536 \u47532 \u44256  \u44536 \u45716  \u47564 \u51068  \u44536 \u46308 \u51060  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51004 \u47196  \u51088 \u44592 \u51032  \u51096 \u47803 \u51012  \u51648 \u51201 \u54644  \u51456 \u45796 \u47732  \u45800 \u50672 \u55176  \u51088 \u44592 \u51032  \u51452 \u51109 \u51012  \u52712 \u49548 \u54616 \u44192 \u45432 \u46972 \u44256  \u44032 \u51109  \u50628 \u49689 \u54620  \u53468 \u46020 \u47196  \u47609 \u49464 \u54616 \u50688 \u45796 . \u44536 \u47532 \u44256  \u44536 \u45716  \u51088 \u44592 \u47484  \u51060 \u52376 \u47100  \u44144 \u47337 \u54620  \u49324 \u50629 \u51012  \u50948 \u54616 \u50668  \u44256 \u45212  \u48155 \u45716  \u51068 \u50640  \u54633 \u45817 \u54620  \u51088 \u47196  \u54756 \u50500 \u47140  \u51452 \u49888  \u54616 \u45208 \u45784 \u44760  \u44048 \u49324 \u54616 \u50688 \u45796 .\
\uc0\u44536  \u45817 \u49884  \u49440 \u54980  (\u36984 \u20399 ) \u45716  \u50500 \u51649  \u44060 \u54785 \u49444 \u50640  \u45824 \u54616 \u50668  \u52649 \u48516 \u54620  \u51648 \u49885 \u51012  \u44032 \u51648 \u44256  \u51080 \u51648  \u47803 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u47336 \u53552 \u51032  \u44277 \u51221 \u54616 \u44256 , \u48516 \u47749 \u54616 \u44256 , \u55192  \u51080 \u45716  \u47568 \u50640  \u44618 \u51008  \u44048 \u46041 \u51012  \u48155 \u50520 \u45796 . \u44060 \u54785 \u51088 \u51032  \u50724 \u47448 \u44032  \u51077 \u51613 \u46104 \u51648  \u50506 \u45716  \u54620 , \u54532 \u47532 \u46300 \u47532 \u55176 \u45716  \u44536 \u51032  \u50745 \u54840 \u51088 \u44032  \u46104 \u44592 \u47196  \u44208 \u49900 \u54616 \u50688 \u45796 . \u44536 \u45716  \u48277 \u50773 \u51032  \u49324 \u51208 \u50640 \u44172  \u48372 \u45236 \u45716  \u54924 \u45813 \u50640 \u49436  \u45796 \u51020 \u44284  \u44057 \u51060  \u54200 \u51648 \u54616 \u50688 \u45796 . \'93\'91\u44480 \u54616 \u45716  \u50500 \u50864 \u53356 \u49828 \u48512 \u47476 \u53356 \u50640 \u49436  \u47560 \u54004  \u48149 \u49324 \u50752  \u54924 \u44204 \u54616 \u50688 \u51004 \u48064 \u47196  \u47564 \u51313 \u54616 \u50688 \u51020 \u50640  \u53952 \u47548 \u50630 \u51012  \u44163 \u51077 \u45768 \u45796 . \u50864 \u47532 \u45716  \u44480 \u54616 \u44032  \u44536 \u51032  \u50724 \u47448 \u47484  \u54869 \u49888 \u49884 \u53020  \u51452 \u51648  \u50506 \u44256  \u49888 \u50521 \u51012  \u52712 \u49548 \u54616 \u44172  \u54616 \u44256 \u51088  \u45432 \u47141 \u54664 \u51012  \u44163 \u51004 \u47196 \u45716  \u49373 \u44033 \u54616 \u51648  \u50506 \u49845 \u45768 \u45796 . \u45208 \u45716  \u50500 \u51649  \u47560 \u54004  \u48149 \u49324 \u51032  \u44368 \u47532 \u44032  \u48520 \u44221 \u54616 \u44256 , \u48708 \u44536 \u47532 \u49828 \u46020 \u51064 \u51201 \u51060 \u47728 , \u51060 \u45800 \u51201 \u51060 \u46972 \u44256  \u47568 \u54644  \u51452 \u45716  \u51060  \u45208 \u46972 \u51032  \u54617 \u51088 \u46308 \u51012  \u47564 \u45208 \u51648  \u47803 \u54616 \u50688 \u49845 \u45768 \u45796 .\'92 \u49440 \u54980 \u45716  \u47336 \u53552 \u47484  \u47196 \u47560 \u47196  \u48372 \u45236 \u44144 \u45208  \u51088 \u44592  \u45208 \u46972 \u50640 \u49436  \u52628 \u48169 \u54616 \u44592 \u47484  \u44144 \u51208 \u54616 \u50688 \u45796 \'94 (D\'92Aubigne, b.4, ch.10).\
\uc0\u49440 \u54980  (\u36984 \u20399 ) \u45716  \u49324 \u54924 \u51032  \u46020 \u45909 \u51201  \u50613 \u51228 \u47141 \u51060  \u51204 \u52404 \u51201 \u51004 \u47196  \u47924 \u45320 \u51256  \u51080 \u45716  \u44163 \u51012  \u50508 \u50520 \u45796 . \u50948 \u45824 \u54620  \u44060 \u54785  \u49324 \u50629 \u51060  \u54596 \u50836 \u54616 \u50688 \u45796 . \u49324 \u46988 \u51060  \u54616 \u45208 \u45784 \u51032  \u50836 \u44396 \u50752  \u44228 \u48156 \u46108  \u50577 \u49900 \u51032  \u47749 \u47161 \u51012  \u51064 \u51221 \u54616 \u44256  \u49692 \u51333 \u54616 \u44592 \u47564  \u54616 \u47732  \u48276 \u51396 \u47484  \u50613 \u51228 \u54616 \u44256  \u52376 \u48268 \u54616 \u44592  \u50948 \u54616 \u50668  \u48373 \u51105 \u54616 \u44256  \u48708 \u50857 \u51060  \u47566 \u51060  \u46300 \u45716  \u51228 \u46020 \u47484  \u47560 \u47144 \u54624  \u54596 \u50836 \u44032  \u50630 \u51012  \u44163 \u51060 \u50632 \u45796 . \u44536 \u45716  \u47336 \u53552 \u44032  \u48148 \u47196  \u51060  \u47785 \u51201 \u51012  \u50948 \u54616 \u50668  \u51068 \u54616 \u44256  \u51080 \u51020 \u51012  \u50508 \u44256 , \u44536  \u49324 \u50629 \u51060  \u44368 \u54924  \u50504 \u50640  \u51339 \u51008  \u44048 \u54868 \u47484  \u45180 \u52824 \u44256  \u51080 \u45716  \u44163 \u51012  \u51008 \u44540 \u55176  \u44592 \u48848 \u54616 \u50688 \u45796 .\
\pard\pardeftab720\sa319\partightenfactor0

\f0\b \cf0 \uc0\u48520 \u48277 \u51201 \u51064  \u54801 \u48149 \u44284  \u45572 \u47749 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u44536 \u45716  \u46608  \u47336 \u53552 \u44032  \u45824 \u54617  \u44368 \u49688 \u47196 \u49436  \u45440 \u46980  \u47564 \u54620  \u44277 \u51201 \u51012  \u45224 \u44596  \u49324 \u49892 \u51012  \u50508 \u50520 \u45796 . \u44060 \u54785 \u51088 \u44032  \u44368 \u54924 \u51032  \u47928 \u50640  \u44536 \u51032  \u45436 \u51228 \u47484  \u51228 \u49884 \u54620  \u51648  \u44200 \u50864  1\u45380 \u48150 \u50640  \u46104 \u51648  \u50500 \u45768 \u54616 \u50688 \u51648 \u47564  \u51228 \u49457 \u51228  (\u35576 \u32854 \u31085 ) \u52629 \u51228  \u46412  \u44368 \u54924 \u50640  \u52286 \u50500 \u50724 \u45716  \u49324 \u46988 \u46308 \u51032  \u49688 \u45716  \u54788 \u51200 \u55176  \u44048 \u49548 \u46104 \u50632 \u45796 . \u47196 \u47560 \u51032  \u50696 \u48176 \u51088 \u46308 \u44284  \u50672 \u44552  \u50529 \u49688 \u46020  \u51460 \u50612 \u46308 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44536 \u46308 \u51032  \u51088 \u47532 \u45716  \u48708 \u53584 \u48288 \u47476 \u53356 \u47484  \u52286 \u50500 \u50728  \u45796 \u47480  \u44228 \u44553 \u51032  \u49324 \u46988 \u46308 \u47196  \u52292 \u50892 \u51276 \u45716 \u45936 , \u44536 \u46308 \u51008  \u50976 \u47932  \u50696 \u48176  (\u36986 \u29289 \u63926 \u25308 ) \u47484  \u50948 \u54616 \u50668  \u50728  \u49692 \u47168 \u51088 \u46308 \u51060  \u50500 \u45768 \u44256 , \u45824 \u54617 \u51032  \u44368 \u49892 \u51012  \u52292 \u50864 \u45716  \u54617 \u49373 \u46308 \u51060 \u50632 \u45796 . \u47336 \u53552 \u51032  \u51200 \u49436 \u45716  \u44033 \u52376 \u50640 \u49436  \u49457 \u44221 \u50640  \u45824 \u54620  \u49352 \u47196 \u50868  \u55141 \u48120 \u47484  \u51068 \u51004 \u53020  \u51452 \u50632 \u51004 \u48064 \u47196  \u46021 \u51068  \u44397 \u45236 \u49104  \u50500 \u45768 \u46972  \u50808 \u44397 \u50640 \u49436 \u44620 \u51648  \u49688 \u47566 \u51008  \u54617 \u49373 \u46308 \u51060  \u47792 \u47140 \u50772 \u45796 . \u48708 \u53584 \u48288 \u47476 \u53356 \u47484  \u52376 \u51020 \u51004 \u47196  \u48148 \u46972 \u48372 \u45716  \u52397 \u45380 \u46308 \u51008  \'93\u49552 \u51012  \u46308 \u44256  \u47560 \u52824  \u50715 \u45216 \u50640  \u49884 \u50728 \u50640 \u49436  \u54664 \u45912  \u44163 \u52376 \u47100  \u51060  \u49457 \u50640 \u49436  \u51652 \u47532 \u51032  \u48731 \u51060  \u48708 \u52824 \u44172  \u54616 \u49884 \u44256 , \u47680 \u47532  \u46504 \u50612 \u51256  \u51080 \u45716  \u45208 \u46972 \u50640 \u44620 \u51648  \u44536  \u48731 \u51012  \u51204 \u54616 \u44172  \u54644 \u51452 \u49888  \u54616 \u45208 \u45784 \u51012  \u52268 \u50577 \u54616 \u50688 \u45796 \'94 (D\'92Aubigne, b.4, ch.10).\
\uc0\u47336 \u53552 \u45716  \u50500 \u51649 \u46020  \u47196 \u47560 \u51032  \u50724 \u47448 \u50640 \u49436  \u48512 \u48516 \u51201 \u51004 \u47196  \u46028 \u50500 \u49440  \u45936  \u48520 \u44284 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u44032  \u54616 \u45208 \u45784 \u51032  \u49457 \u44221 \u51012  \u48277 \u50773 \u51032  \u44368 \u49436 \u50752  \u48277 \u51204  (\u27861 \u20856 ) \u50640  \u48708 \u44368 \u54644  \u48380  \u46412  \u44536 \u51032  \u47560 \u51020 \u51008  \u45440 \u46972 \u50880 \u51004 \u47196  \u52649 \u47564 \u54644 \u51276 \u45796 . \u44536 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u44592 \u47197 \u54616 \u50688 \u45796 . \'93\u45208 \u45716  \u48277 \u50773 \u51032  \u44368 \u49436 \u47484  \u51069 \u44256  \u51080 \u45796 . \u44536 \u47084 \u45208 \'85\u45208 \u45716  \u48277 \u50773 \u51060  \u51201 \u44536 \u47532 \u49828 \u46020 \u51064 \u51648  \u44536 \u48516 \u51032  \u49324 \u46020 \u51064 \u51648 \u45716  \u47784 \u47480 \u45796 . \u44536 \u47084 \u45208  \u44536 \u51032  \u44368 \u49436 \u50640 \u49436  \u44536 \u47532 \u49828 \u46020 \u47484  \u45320 \u47924 \u46020  \u51096 \u47803  \u45208 \u53440 \u45236 \u44256 , \u44536 \u48516 \u51012  \u49901 \u51088 \u44032 \u50640  \u47803  \u48149 \u44256  \u51080 \u45796 \'94 (D\'92Aubigne, b.5, ch.1). \u44536  \u45817 \u49884 \u50640  \u47336 \u53552 \u45716  \u50668 \u51204 \u55176  \u47196 \u47560 \u44368 \u51032  \u51648 \u51648 \u51088 \u50688 \u51004 \u47728 , \u44368 \u54924 \u50752  \u44288 \u44228 \u47484  \u45130 \u45716 \u45796 \u45716  \u44163 \u51008  \u49373 \u44033 \u51312 \u52264  \u50500 \u45768 \u54616 \u50688 \u45796 .\
\uc0\u47336 \u53552 \u51032  \u51200 \u49436 \u50752  \u44368 \u47532 \u45716  \u47784 \u46304  \u44536 \u47532 \u49828 \u46020 \u44368 \u44397 \u51004 \u47196  \u54140 \u51256 \u44052 \u45796 . \u44060 \u54785 \u51032  \u49324 \u50629 \u51008  \u49828 \u50948 \u49828 \u50752  \u45348 \u45916 \u46976 \u46300 \u50640 \u49436 \u46020  \u51068 \u50612 \u45228 \u45796 . \u44536 \u51032  \u51200 \u49436 \u46308 \u51008  \u54532 \u46993 \u49828 \u50752  \u49828 \u54168 \u51064 \u50640 \u46020  \u51204 \u54644 \u51276 \u45796 . \u50689 \u44397 \u50640 \u49436 \u45716  \u44536 \u51032  \u44368 \u54984 \u51060  \u49373 \u47749 \u51032  \u47568 \u50432 \u51004 \u47196  \u48155 \u50500 \u46308 \u50668 \u51276 \u45796 . \u48296 \u44592 \u50640 \u50752  \u51060 \u53448 \u47532 \u50500 \u50640 \u46020  \u51652 \u47532 \u44032  \u51204 \u54028 \u46104 \u50632 \u45796 . \u49688 \u47564  \u47749 \u51032  \u49324 \u46988 \u46308 \u51060  \u51453 \u51008  \u46319 \u54620  \u54844 \u49688 \u49345 \u53468 \u50640 \u49436  \u44648 \u50612 \u45208 \u49436  \u49888 \u50521 \u49373 \u54876 \u51032  \u55148 \u47581 \u44284  \u44592 \u49256 \u51012  \u45572 \u47532 \u44256  \u51080 \u50632 \u45796 .\
\uc0\u47336 \u53552 \u51032  \u44277 \u44201 \u51004 \u47196  \u47196 \u47560 \u45716  \u45908 \u50865 \u45908  \u44201 \u45432 \u54616 \u44172  \u46104 \u50632 \u51004 \u47728 , \u44536 \u47484  \u48152 \u45824 \u54616 \u45716  \u44305 \u49888 \u51201 \u51064  \u50612 \u46500  \u49324 \u46988 \u46308 , \u49900 \u51648 \u50612  \u44032 \u53672 \u47533  \u45824 \u54617 \u44368 \u51032  \u48149 \u49324 \u46308 \u44620 \u51648 \u46020  \u44536  \u48152 \u50669 \u51201 \u51064  \u49849 \u47140 \u47484  \u51453 \u51060 \u45716  \u51088 \u45716  \u48276 \u51396 \u54616 \u45716  \u51088 \u44032  \u50500 \u45768 \u46972 \u44256  \u51452 \u51109 \u54616 \u50688 \u45796 . \u54616 \u47336 \u45716  \u50612 \u46500  \u49688 \u49345 \u54620  \u51088 \u44032  \u44428 \u52509 \u51012  \u50808 \u53804  \u49549 \u50640  \u44048 \u52628 \u44256  \u44536  \u44060 \u54785 \u51088 \u50640 \u44172  \u44032 \u44620 \u51060  \u50752 \u49436 , \u50612 \u52236 \u54616 \u50668  \u44536 \u45824 \u45716  \u54844 \u51088  \u45796 \u45768 \u45712 \u45264 \u44256  \u47932 \u50632 \u45796 . \u47336 \u53552 \u45716  \'93\u45208 \u45716  \u54616 \u45208 \u45784 \u51032  \u48372 \u54840  \u50500 \u47000  \u51080 \u45796 . \u44536 \u48516 \u51008  \u45208 \u51032  \u55192 \u51060 \u50836  \u48169 \u54056 \u49884 \u45796 . \u49324 \u46988 \u51060  \u45236 \u44172  \u50612 \u52236 \u54616 \u44192 \u45712 \u45264 \'94\u44256  \u45824 \u45813 \u54616 \u50688 \u45796  (D\'92Au-bigne, b.6, ch.2). \u51060  \u47568 \u51012  \u46307 \u44256  \u44536  \u49688 \u49345 \u54620  \u51088 \u45716  \u50620 \u44404 \u48731 \u51060  \u52285 \u48177 \u54616 \u44172  \u46104 \u50632 \u51004 \u47728  \u54616 \u45720 \u51032  \u52380 \u49324 \u46308  \u50526 \u50640 \u49436  \u54588 \u54616 \u46319 \u51060  \u46020 \u47581 \u54616 \u50668  \u48260 \u47160 \u45796 .\
\uc0\u47196 \u47560 \u45716  \u47336 \u53552 \u47484  \u50630 \u50528  \u48260 \u47532 \u44592  \u50948 \u54616 \u50668  \u50528 \u47484  \u50044 \u51004 \u45208  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u44536 \u51032  \u48169 \u54056 \u44032  \u46104 \u49512 \u45796 . \u44536 \u51032  \u44368 \u47532 \u45716  \'93\u48124 \u44032 \u50752  \u49688 \u46020 \u50896 \u44284 \'85\u44480 \u51313 \u51032  \u51200 \u53469 \u44284  \u45824 \u54617 \u44284  \u50773 \u51032  \u44417 \u51204  \u46321 \u51004 \u47196  \u51204 \u54616 \u50668 \u51256 \u49436  \u46020 \u52376 \u47196  \u54140 \u51276 \u45796 \'94 (D\'92Au-bigne, b.6, ch.2). \u44480 \u51313 \u46308 \u51008  \u44536 \u51032  \u50868 \u46041 \u51012  \u50896 \u51312 \u54616 \u44592  \u50948 \u54616 \u50668  \u49324 \u48169 \u50640 \u49436  \u51068 \u50612 \u45208 \u44256  \u51080 \u50632 \u45796 .\
\uc0\u48148 \u47196  \u44536  \u51592 \u51020  \u47336 \u53552 \u45716  \u54980 \u49828 \u51032  \u51200 \u49436 \u47484  \u51069 \u44256 , \u51088 \u49888 \u51060  \u51452 \u51109 \u54616 \u44256  \u44032 \u47476 \u52824 \u44256 \u51088  \u54616 \u45912  \u48127 \u51020 \u51004 \u47196  \u47568 \u48120 \u50516 \u45716  \u51032 \u50640  \u45824 \u54620  \u53360  \u51652 \u47532 \u44032  \u48268 \u50024  \u48372 \u54756 \u48120 \u50500 \u51032  \u44060 \u54785 \u51088 \u47196  \u47568 \u48120 \u50516 \u50500  \u51452 \u51109 \u46104 \u50632 \u45796 \u45716  \u49324 \u49892 \u51012  \u48156 \u44204 \u54616 \u44172  \u46104 \u50632 \u45796 . \u47336 \u53552 \u45716  \'93\u48148 \u50872 \u44284  \u50500 \u50864 \u44396 \u49828 \u54000 \u45572 \u49828 \u50752  \u45208  \u51088 \u49888 \u51008  \u50508 \u51648  \u47803 \u54616 \u45716  \u49324 \u51060 \u50640  \u47784 \u46160  \u54980 \u49828 \u51032  \u49888 \u48393 \u51088 \u44032  \u46104 \u50632 \u45796 \'94\u44256  \u47568 \u54616 \u50688 \u45796 . \u44536 \u45716  \u46608  \u44228 \u49549 \u54644 \u49436  \'93\u51068 \u49464 \u44592  \u51204 \u50640  \u51204 \u54028 \u46108  \u51652 \u47532 \u47484  \u48520 \u53468 \u50892  \u48260 \u47536  \u51060  \u49464 \u49345 \u51008  \u54616 \u45208 \u45784 \u51032  \u49900 \u54032 \u51012  \u48516 \u47749 \u55176  \u48155 \u44256 \u50556  \u47568  \u44163 \u51060 \u45796 \'94 (Wylie, b.6, ch.1) \u44256  \u47568 \u54616 \u50688 \u45796 .\
\pard\pardeftab720\sa319\partightenfactor0

\f0\b \cf0 \uc0\u44060 \u54785  \u50868 \u46041 \u51032  \u50948 \u44592 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u47336 \u53552 \u45716  \u44536 \u47532 \u49828 \u46020 \u44368 \u51032  \u44060 \u54785 \u51012  \u50948 \u54616 \u50668  \u46021 \u51068 \u51032  \u54889 \u51228 \u50752  \u44480 \u51313 \u46308 \u50640 \u44172  \u48372 \u45236 \u45716  \u54840 \u49548 \u51032  \u54200 \u51648 \u50640 \u49436  \u48277 \u50773 \u50640  \u44288 \u54616 \u50668  \u44592 \u47197 \u54616 \u50688 \u45796 . \'93\u49828 \u49828 \u47196  \u44536 \u47532 \u49828 \u46020 \u51032  \u45824 \u47532 \u51088 \u46972 \u44256  \u51088 \u52376 \u54616 \u45716  \u49324 \u46988 \u51060  \u50612 \u46496 \u54620  \u54889 \u51228 \u46020  \u48120 \u52824 \u51648  \u47803 \u54624  \u47564 \u53372  \u54840 \u54868 \u47196 \u50868  \u49373 \u54876 \u51012  \u45572 \u47532 \u45716  \u44163 \u51008  \u45440 \u46980  \u47564 \u54620  \u51068 \u51077 \u45768 \u45796 . \u44284 \u50672  \u44536 \u44163 \u51060  \u44032 \u45212 \u54620  \u50696 \u49688 \u45784 \u44284  \u48708 \u52380 \u54620  \u48288 \u46300 \u47196 \u51032  \u49373 \u54876 \u44284  \u50976 \u49324 \u54616 \u44192 \u49845 \u45768 \u44620 ? \u44536 \u47484  \u44032 \u47532 \u53020  \u49464 \u44228 \u51032  \u51452 \u46972 \u44256 \u44620 \u51648  \u47568 \u54616 \u44256  \u51080 \u49845 \u45768 \u45796 . \u48277 \u50773 \u51060  \u44536 \u48516 \u51032  \u45824 \u47532 \u51088  \u46120 \u51012  \u51088 \u46993 \u54616 \u45716  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u45236  \u45208 \u46972 \u45716  \u51060  \u49464 \u49345  \u45208 \u46972 \u44032  \u50500 \u45768 \u46972 \u44256  \u47568 \u50432 \u54616 \u49512 \u45716 \u45936 , \u44536 \u48516 \u51032  \u45824 \u47532 \u51088 \u51032  \u50689 \u53664 \u44032  \u51088 \u44592  \u51452 \u51064 \u51032  \u44163 \u48372 \u45796  \u45908  \u52964 \u49436 \u50556  \u46104 \u44192 \u49845 \u45768 \u44620 ?\'94 (D\'92Aubigne, b.6, ch.3).\
\uc0\u46608  \u44536 \u45716  \u44033  \u45824 \u54617 \u50640  \u45824 \u54616 \u50668  \u45796 \u51020 \u44284  \u44057 \u51060  \u44592 \u47197 \u54616 \u50688 \u45796 . \'93\u45208 \u45716  \u44033  \u45824 \u54617 \u51060  \u47564 \u51068  \u50676 \u47148 \u55176  \u49457 \u44221 \u51012  \u49444 \u47749 \u54616 \u44256 , \u44536 \u44163 \u51012  \u52397 \u45380 \u46308 \u51032  \u47560 \u51020  \u44032 \u50868 \u45936  \u51064 \u49345 \u49884 \u53020  \u51452 \u51648  \u47803 \u54620 \u45796 \u47732 , \u51648 \u50725 \u51032  \u47928 \u51060  \u46112 \u44620  \u46160 \u47140 \u50892 \u54616 \u45716  \u48148 \u51060 \u45796 . \u45208 \u45716  \u45572 \u44396 \u46304 \u51648  \u49457 \u44221 \u51012  \u51004 \u46904 \u51004 \u47196  \u49340 \u51648  \u50506 \u45716  \u54617 \u44368 \u50640  \u51088 \u45376 \u47484  \u48372 \u45236 \u51648  \u47568 \u46020 \u47197  \u44428 \u47732 \u54620 \u45796 . \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51012  \u44228 \u49549 \u51201 \u51004 \u47196  \u50672 \u44396 \u54616 \u45716  \u49324 \u46988 \u46308 \u51060  \u50630 \u45716  \u44368 \u50977  \u44592 \u44288 \u51008  \u47784 \u46160  \u53952 \u47548 \u50630 \u51060  \u53440 \u46973 \u54616 \u44256 \u50556  \u47564 \u45796 \'94 (D\'92Aubigne, b.6, ch.3).\
\uc0\u51060  \u54840 \u49548 \u45716  \u46021 \u51068  \u51204 \u44397 \u50640  \u49888 \u49549 \u55176  \u51204 \u45804 \u46104 \u50612  \u44033  \u49324 \u46988 \u46308 \u50640 \u44172  \u44053 \u47141 \u54620  \u44048 \u54868 \u47484  \u45180 \u52452 \u45796 . \u50728  \u45208 \u46972 \u45716  \u48516 \u48156 \u54616 \u44256 , \u44400 \u51473 \u46308 \u51008  \u44432 \u44592 \u54616 \u50668  \u44060 \u54785 \u51032  \u44611 \u48156  \u50500 \u47000 \u47196  \u47784 \u50668 \u46308 \u50632 \u45796 . \u47336 \u53552 \u47484  \u48152 \u45824 \u54616 \u45716  \u51088 \u46308 \u51008  \u48372 \u48373 \u54624  \u49373 \u44033 \u51060  \u48520  \u51068 \u46319  \u51068 \u50612 \u45208 \u49436 , \u44536 \u50640 \u44172  \u45824 \u54616 \u50668  \u45800 \u54840 \u54620  \u53468 \u46020 \u47484  \u52712 \u54644  \u51452 \u44592 \u47484  \u48277 \u50773 \u50640 \u44172  \u44036 \u52397 \u54616 \u50688 \u45796 . \u44536 \u51032  \u44368 \u47532 \u46308 \u51008  \u51593 \u49884  \u51221 \u51396 \u51032  \u49440 \u44256 \u47484  \u48155 \u50500 \u50556  \u54620 \u45796 \u44256  \u44277 \u44256 \u46104 \u50632 \u45796 . \u44536  \u44060 \u54785 \u51088 \u50752  \u44536 \u51032  \u51648 \u51648 \u51088 \u46308 \u50640 \u44172 \u45716  60 \u51068 \u44036 \u51032  \u50976 \u50696  \u44592 \u44036 \u51060  \u54728 \u46973 \u46104 \u50632 \u51004 \u47728 , \u44536  \u44592 \u44036  \u50504 \u50640  \u49888 \u50521 \u51012  \u52712 \u49548 \u54616 \u51648  \u50506 \u51004 \u47732  \u47784 \u46160  \u54028 \u47928 \u45817 \u54616 \u46020 \u47197  \u46104 \u50612  \u51080 \u50632 \u45796 .\
\uc0\u44536 \u44163 \u51008  \u51333 \u44368 \u44060 \u54785 \u50640  \u51080 \u50612 \u49436  \u47924 \u49436 \u50868  \u50948 \u44592 \u50688 \u45796 . \u51648 \u45208 \u44036  \u49688 \u49464 \u44592  \u46041 \u50504  \u47196 \u47560 \u51032  \u54028 \u47928 \u51008  \u44053 \u47141 \u54620  \u54889 \u51228 \u46308 \u50640 \u44172  \u44277 \u54252 \u44048 \u51012  \u50504 \u44200  \u51452 \u50632 \u45796 . \u44536 \u44163 \u51008  \u47561 \u44053 \u54620  \u51228 \u44397  (\u24093 \u22283 ) \u50640  \u48520 \u54665 \u44284  \u54889 \u54224 \u47484  \u44032 \u51256 \u45796 \u51452 \u50632 \u45796 . \u51068 \u45800  \u54028 \u47928 \u51032  \u49440 \u44256 \u47484  \u48155 \u51008  \u49324 \u46988 \u46308 \u51008  \u51068 \u48152 \u50640 \u44172  \u46160 \u47140 \u50880 \u44284  \u44277 \u54252 \u51032  \u45824 \u49345 \u51060  \u46104 \u50632 \u51004 \u47728 , \u44536 \u51032  \u46041 \u47308 \u46308 \u44284 \u51032  \u44368 \u51228 \u46020  \u45130 \u50612 \u51648 \u44256 , \u48277 \u47456 \u51032  \u48372 \u54840 \u47484  \u48155 \u51648  \u47803 \u54616 \u44256 , \u49688 \u49353 \u45817 \u54616 \u50668  \u51453 \u51076 \u51012  \u45817 \u54616 \u44172  \u46104 \u50612  \u51080 \u50632 \u45796 . \u47336 \u53552 \u45716  \u51088 \u44592 \u50640 \u44172  \u50628 \u49845 \u54644  \u50724 \u44256  \u51080 \u45716  \u54253 \u54413 \u51012  \u50508 \u51648  \u47803 \u54620  \u44163 \u51060  \u50500 \u45768 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u44403 \u44172  \u49436 \u49436  \u51088 \u44592 \u47484  \u51648 \u53489 \u54644  \u51452 \u44256  \u48169 \u54056 \u51032  \u50669 \u54624 \u51012  \u54644 \u51452 \u49892  \u44536 \u47532 \u49828 \u46020 \u47484  \u49888 \u47280 \u54616 \u50688 \u45796 . \u49692 \u44368 \u51088 \u51032  \u48127 \u51020 \u44284  \u50857 \u44592 \u47196 \u50024  \u44536 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u44592 \u47197 \u54616 \u50688 \u45796 . \'93\u51060 \u51228  \u50612 \u46496 \u54620  \u51068 \u51060  \u51068 \u50612 \u45216 \u45716 \u51648  \u45208 \u45716  \u50508 \u51648  \u47803 \u54616 \u47728  \u44396 \u53468 \u50668  \u50508 \u47140 \u44256 \u46020  \u54616 \u51648  \u50506 \u45716 \u45796 . \'85\u44053 \u54413 \u51060  \u47792 \u50500 \u52824 \u47140 \u47732  \u52432 \u48372 \u46972 . \u45208 \u45716  \u46160 \u47140 \u50892 \u54616 \u51648  \u50506 \u45716 \u45796 . \u54616 \u45208 \u51032  \u45208 \u47943 \u51086 \u46020  \u50864 \u47532  \u50500 \u48260 \u51648 \u51032  \u54728 \u46973  \u50630 \u51060 \u45716  \u46504 \u50612 \u51648 \u51648  \u50506 \u45716 \u45796 . \u54616 \u47932 \u47728  \u44536 \u48516 \u51032  \u51333 \u46108  \u50864 \u47532 \u47484  \u54616 \u45208 \u45784 \u44760 \u49436  \u48372 \u54840 \u54644  \u51452 \u49884 \u51648  \u50506 \u51012  \u44163 \u51064 \u44032 ? \u50977 \u49888 \u51004 \u47196  \u45208 \u53440 \u45208 \u49512 \u45912  \u47568 \u50432 \u46020  \u46028 \u50500 \u44032 \u49512 \u44144 \u46304  \u44536  \u47568 \u50432 \u51012  \u50948 \u54616 \u50668  \u51453 \u45716  \u44163 \u51008  \u48324 \u47196  \u51473 \u45824 \u54620  \u51068 \u51060  \u50500 \u45768 \u45796 . \u50864 \u47532 \u44032  \u44536 \u48516 \u44284  \u54632 \u44760  \u51453 \u51004 \u47732  \u46608 \u54620  \u44536 \u48516 \u44284  \u54632 \u44760  \u49332 \u44172  \u46112  \u44163 \u51060 \u45796 . \u44536 \u48516 \u44760 \u49436  \u50864 \u47532 \u48372 \u45796  \u50526 \u49436  \u44032 \u49888  \u44536  \u44600 \u51012  \u46384 \u46972 \u44048 \u51004 \u47196  \u50864 \u47532 \u45716  \u44536 \u48516 \u51060  \u44228 \u49888  \u44275 \u51004 \u47196  \u44032 \u49436  \u44536 \u48516 \u44284  \u54632 \u44760  \u50689 \u50896 \u55176  \u49332 \u44172  \u46112  \u44163 \u51060 \u45796 \'94[D\'92Aubigne, (3rd London ed., Walth-er, 1840) b.6, ch.9].\
\uc0\u47560 \u52840 \u45236  \u48277 \u50773 \u51032  \u44368 \u49436 \u44032  \u47336 \u53552 \u50640 \u44172  \u51204 \u45804 \u46104 \u51088  \u44536 \u45716  \u51060 \u47111 \u44172  \u47568 \u54616 \u50688 \u45796 . \'93\u45208 \u45716  \u44536 \u44163 \u51012  \u48520 \u44221 \u54616 \u44256  \u44144 \u51667 \u46108  \u44163 \u51004 \u47196  \u47736 \u49884 \u54616 \u44256  \u48176 \u44201 \u54620 \u45796 . \'85\u44536 \u44163 \u51004 \u47196  \u51221 \u51396 \u48155 \u51004 \u49888  \u48516 \u51008  \u44536 \u47532 \u49828 \u46020  \u51088 \u49888 \u51060 \u49884 \u45796 . \u44536  \u49324 \u50629 \u51012  \u50948 \u54616 \u50668  \u51060 \u50752  \u44057 \u51060  \u44256 \u49373 \u45817 \u54616 \u45716  \u44163 \u51012  \u45208 \u45716  \u44592 \u48848 \u54620 \u45796 . \u45208 \u45716  \u51060 \u48120  \u47560 \u51020 \u49549 \u51004 \u47196  \u45908 \u50865  \u53360  \u51088 \u50976 \u47484  \u45712 \u45180 \u44256  \u51080 \u45796 . \u45208 \u45716  \u48277 \u50773 \u51060  \u51201 \u44536 \u47532 \u49828 \u46020 \u51060 \u47728 , \u44536 \u51032  \u48372 \u51340 \u45716  \u44263  \u49324 \u45800 \u51032  \u50948  (\u20301 ) \u51064  \u44163 \u51012  \u46300 \u46356 \u50612  \u50508 \u44172  \u46104 \u50632 \u44592  \u46412 \u47928 \u51060 \u45796 \'94 (D\'92Aubigne, b.6, ch.9).\
