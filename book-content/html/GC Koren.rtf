\f0\b \cf0 \uc0\u44060 \u54785 \u51088 \u50752  \u51116 \u47548 \u49888 \u50521 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u54744 \u51456 \u54620  \u48148 \u50948 \u46308 \u47196  \u51060 \u47336 \u50612 \u51652  \u48167 \u47784 \u49452 \u50640  \u44480 \u50577 \u51012  \u44036  \u49324 \u46993 \u54616 \u45716  \u51228 \u51088  \u50836 \u54620 \u51008  \'93\u45236 \u44032  \u51652 \u49892 \u47196  \u49549 \u55176  \u50724 \u47532 \u46972 \'94\u45716  \u51452 \u45784 \u51032  \u50557 \u49549 \u51012  \u48155 \u50520 \u45796 . \u44536 \u45716  \u44536  \u47568 \u51012  \u46307 \u51088  \'93\u51452  \u50696 \u49688 \u50668  \u50724 \u49884 \u50741 \u49548 \u49436 \'94 (\u44228  22:20) \u46972 \u44256  \u45824 \u45813 \u54616 \u50688 \u45716 \u45936 , \u44536  \u47568 \u51008  \u50724 \u47019 \u46041 \u50504  \u49692 \u47168  \u49373 \u54876 \u51012  \u54644 \u50728  \u44368 \u54924 \u51032  \u44036 \u51208 \u54620  \u44592 \u46020 \u51060 \u44592 \u46020  \u54616 \u45796 .\
\uc0\u50725 \u51473 \u50640 \u49436 , \u54868 \u54805 \u51452 \u50640 \u49436 , \u44368 \u49688 \u45824 \u50640 \u49436 , \u49457 \u46020 \u46308 \u44284  \u49692 \u44368 \u51088 \u46308 \u51060  \u51652 \u47532 \u47484  \u51613 \u44144 \u54620  \u44275 \u50640 \u49436 , \u44536 \u46308 \u51032  \u48127 \u51020 \u44284  \u49548 \u47581 \u51032  \u47568 \u46308 \u51008  \u50668 \u47084  \u49464 \u44592 \u50640  \u44152 \u52432  \u51204 \u54644 \u51648 \u44256  \u51080 \u45796 . \u44536 \u46308 \u51008  \u44536 \u46308  \u51473 \u51032  \u50612 \u46500  \u44536 \u47532 \u49828 \u46020 \u51064 \u51032  \u47568 \u44284  \u44057 \u51060  \'93\u44536 \u47532 \u49828 \u46020 \u51032  \u48512 \u54876 \u51012  \u54869 \u49888 \u54616 \u50688 \u44256 , \u46384 \u46972 \u49436  \u51116 \u47548  \u49884 \u50640  \u51088 \u44592 \u46308 \u46020  \u48512 \u54876 \u54624  \u44163 \u51012  \u54869 \u49888 \u54616 \u50688 \u51004 \u48064 \u47196 , \u51453 \u51020 \u51012  \u45824 \u49688 \u47213 \u51648  \u50506 \u44172  \u50668 \u44592 \u44256 , \u51060 \u44163 \u51012  \u52488 \u50900 \u54616 \u44172  \u46104 \u50632 \u45796 \'94 (Daniel T.Taylor, The Reign of Christ on Earth:or, The Voice of the Church in All Ages, p.33). \u44536 \u46308 \u51008  \'93\u48512 \u54876 \u54624  \u44163 \u51060 \u50632 \u51004 \u48064 \u47196 \'94 (Daniel T.Taylor, The Reign of Christ on Earth:or, The Voice of the Church in All Ages, p.54). \u51600 \u44144 \u50868  \u47560 \u51020 \u51004 \u47196  \u47924 \u45924 \u50640  \u46308 \u50612 \u44052 \u45796 . \u44536 \u46308 \u51008  \'93\u51452 \u44760 \u49436  \u50500 \u48260 \u51648 \u51032  \u50689 \u44305 \u51004 \u47196  \u54616 \u45720  \u44396 \u47492 \u51012  \u53440 \u44256  \u50724 \u49324 \'94, \'93\u44144 \u47337 \u54620  \u45208 \u46972 \u50640  \u51064 \u46020 \u54616 \u50668  \u46308 \u51060 \u49892  \u46412 \'94\u47484  \u48148 \u46972 \u48372 \u50520 \u45796 . \u50760 \u45940 \u49828  \u44368 \u46020 \u46308 \u51008  \u46609 \u44057 \u51008  \u49888 \u50521 \u51012  \u44032 \u51648 \u44256  \u51080 \u50632 \u45796  (Daniel T.Taylor, The Reign of Christ on Earth:or, The Voice of the Church in All Ages, pp.129~132). \u50948 \u53364 \u47532 \u54532 \u45716  \u44396 \u51452 \u51032  \u45208 \u53440 \u45208 \u49900 \u51012  \u44368 \u54924 \u51032  \u55148 \u47581 \u51004 \u47196  \u48148 \u46972 \u44256  \u49324 \u47784 \u54616 \u50688 \u45796  (Daniel T.Taylor, The Reign of Christ on Earth:or, The Voice of the Church in All Ages, pp.132~134).\
\uc0\u47336 \u53552 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u51452 \u51109 \u54616 \u50688 \u45796 . \'93\u45208 \u45716  \u49900 \u54032 \u51032  \u45216 \u51060  \u50526 \u51004 \u47196  3\u48177 \u45380 \u51060  \u47803 \u46104 \u50612 \u49436  \u50732  \u44163 \u51004 \u47196  \u54869 \u49888 \u54620 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u51060  \u49324 \u50501 \u54620  \u49464 \u49345 \u51012  \u45908  \u51060 \u49345  \u50724 \u47000  \u52280 \u51648  \u50506 \u51004 \u49892  \u44163 \u51060 \u47728 , \u52280 \u51012  \u49688 \u46020  \u50630 \u51004 \u49892  \u44163 \u51060 \u45796 .\'94 \'93\u51060  \u44032 \u51613 \u54620  \u45208 \u46972 \u44032  \u51204 \u48373 \u46112  \u53360  \u45216 \u51060  \u45796 \u44032 \u50724 \u44256  \u51080 \u45796 \'94 (Daniel T.Taylor, The Reign of Christ on Earth:or, The Voice of the Church in All Ages, pp.158, 134).\
\uc0\u47708 \u46976 \u55176 \u53668 \u51008  \'93\u51060  \u45217 \u51008  \u49464 \u49345 \u51008  \u44536  \u45149 \u51060  \u47680 \u51648  \u50506 \u50520 \u45796 \'94\u44256  \u47568 \u54616 \u50688 \u45796 . \u52860 \u48712 \u51008  \u44536 \u47532 \u49828 \u46020 \u51064 \u46308 \u50640 \u44172  \'93\u44536 \u47532 \u49828 \u46020 \u51032  \u50724 \u49884 \u45716  \u45216 \u51012  \u47784 \u46304  \u49324 \u44148 \u46308  \u51473 \u50640 \u49436  \u44032 \u51109  \u44592 \u49244  \u49324 \u44148 \u51004 \u47196  \u51452 \u51200 \u54616 \u51648  \u47568 \u44256  \u44256 \u45824 \u54616 \u46972 \'94\u44256  \u44428 \u47732 \u54616 \u44256 , \'93\u47784 \u46304  \u52649 \u49892 \u54620  \u44032 \u51313 \u46308 \u51008  \u44536 \u45216 \u51012  \u44256 \u45824 \u54624  \u44163 \u51060 \u45796 \'94\u46972 \u44256  \u50669 \u49444 \u54616 \u50688 \u45796 . \u44536 \u47532 \u44256  \'93\u50864 \u47532 \u45716  \u50864 \u47532  \u51452 \u45784 \u44760 \u49436  \u45817 \u49888 \u51032  \u45208 \u46972 \u51032  \u50689 \u44305 \u51012  \u50756 \u51204 \u55176  \u45208 \u53440 \u45236 \u49884 \u45716  \u44536  \u53360  \u45216 \u51060  \u48157 \u50500 \u50724 \u45716  \u44163 \u51012  \u48380  \u46412 \u44620 \u51648  \u44536 \u47532 \u49828 \u46020 \u47484  \u49324 \u47784 \u54616 \u44256  \u47749 \u49345 \u54616 \u44592 \u47484  \u51452 \u47536  \u44163 \u52376 \u47100  \u54644 \u50556  \u54620 \u45796 \'94 (Daniel T.Taylor, The Reign of Christ on Earth:or, The Voice of the Church in All Ages, pp.158, 134) \u44256  \u47568 \u54616 \u50688 \u45796 .\
\uc0\u49828 \u53076 \u53952 \u47004 \u46300 \u51032  \u44060 \u54785 \u51088  \u45433 \u49828 \u45716  \u47568 \u54616 \u50688 \u45796 . \'93\u50864 \u47532  \u51452  \u50696 \u49688 \u45784 \u44760 \u49436 \u45716  \u50864 \u47532 \u50752  \u44057 \u51008  \u50977 \u49888 \u51012  \u51077 \u51004 \u49884 \u44256  \u54616 \u45720 \u47196  \u44032 \u51648  \u50506 \u51004 \u49512 \u45716 \u44032 ? \u44536 \u47532 \u44256  \u45796 \u49884  \u50724 \u49892  \u44163 \u51060  \u50500 \u45772 \u44032 ! \u50864 \u47532 \u45716  \u44536 \u48516 \u44760 \u49436  \u46028 \u50500 \u50724 \u49884 \u46104  \u49549 \u55176  \u46028 \u50500 \u50724 \u49892  \u44163 \u51012  \u48127 \u45716 \u45796 .\'94 \u51652 \u47532 \u47484  \u50948 \u54616 \u50668  \u49373 \u47749 \u51012  \u48260 \u47536  \u47532 \u46308 \u47532  (Ridley) \u50752  \u47000 \u54000 \u47672  (Latimer) \u46020  \u51452 \u45784 \u51032  \u45796 \u49884  \u50724 \u49900 \u51012  \u48127 \u51020 \u51004 \u47196  \u44592 \u45796 \u47160 \u45796 . \u47532 \u46308 \u47532 \u45716  \u44592 \u47197 \u54616 \u50688 \u45796 . \'93\u45208 \u45716  \u44536  \u49324 \u49892 \u51012  \u48127 \u44256  \u51080 \u51004 \u48064 \u47196  \u47568 \u54620 \u45796 . \u49464 \u49345 \u51008  \u54869 \u49892 \u55176  \u51333 \u47568 \u50640  \u44032 \u44620 \u50892 \u51648 \u44256  \u51080 \u45796 . \u50864 \u47532 \u45716  \u54616 \u45208 \u45784 \u51032  \u51333  \u50836 \u54620 \u52376 \u47100  \u52649 \u49900 \u51004 \u47196  \u50864 \u47532  \u44396 \u51452  \u44536 \u47532 \u49828 \u46020 \u47484  \u54693 \u54616 \u50668 , \'91\u50724 \u49884 \u50741 \u49548 \u49436 , \u51452  \u50696 \u49688 \u50668  \u50724 \u49884 \u50741 \u49548 \u49436 \'92\u46972 \u44256  \u48512 \u47476 \u51670 \u50612 \u50556  \u54620 \u45796 \'94 (Daniel T.Taylor, The Reign of Christ on Earth:or, The Voice of the Church in All Ages, pp.151, 145).\
\uc0\u48149 \u49828 \u53552  (Baxter) \u45716  \u47568 \u54616 \u50688 \u45796 . \'93\u51452 \u45784 \u44760 \u49436  \u45796 \u49884  \u50724 \u49888 \u45796 \u45716  \u49373 \u44033 \u51008  \u45208 \u50640 \u44172  \u44032 \u51109  \u53360  \u44592 \u49256 \u51060 \u50836  \u51600 \u44144 \u50880 \u51060 \u45796 \'94 (Richard Baxter, Works, vol.17, p.555). \'93\u44536 \u48516 \u51032  \u45208 \u53440 \u45208 \u49900 \u51012  \u49324 \u47784 \u54616 \u44256 , \u44536  \u48373 \u46108  \u49548 \u47581 \u51012  \u48148 \u46972 \u48372 \u45716  \u44163 \u51060  \u49457 \u46020 \u46308 \u51032  \u53945 \u49457 \u51060 \u50836  \u48127 \u51020 \u51060 \u45796 .\'94 \'93\u48512 \u54876 \u54624  \u46412 \u50640  \u47736 \u47581 \u46104 \u50612 \u50556  \u54624  \u52572 \u54980 \u51032  \u50896 \u49688 \u44032  \u49324 \u47581 \u51060  \u46104 \u50612 \u50556  \u54620 \u45796 \u47732 , \u50864 \u47532 \u45716  \u49324 \u47581 \u51060  \u50756 \u51204 \u55176  \u51221 \u48373 \u45817 \u54616 \u44172  \u46112  \u44536 \u47532 \u49828 \u46020 \u51032  \u51116 \u47548 \u51012  \u52280 \u51004 \u47196  \u50676 \u47148 \u54616 \u44172  \u48148 \u46972 \u44256  \u44536  \u51068 \u51012  \u50948 \u54616 \u50668  \u44592 \u46020 \u54644 \u50556  \u54624  \u44163 \u51012  \u44648 \u45803 \u44172  \u46112  \u44163 \u51060 \u45796 \'94 (Richard Baxter, Works, vol.17, p.500). \'93\u51060 \u45216 \u51008  \u47560 \u46405 \u55176  \u47784 \u46304  \u49888 \u51088 \u46308 \u51060  \u49324 \u47784 \u54616 \u44256  \u48148 \u46972 \u44256  \u44592 \u45796 \u47140 \u50556  \u54624  \u45216 \u51060 \u45796 . \u50780 \u45264 \u54616 \u47732  \u44536 \u45216 \u51008  \u44536 \u46308 \u51032  \u44396 \u49549 \u51012  \u50948 \u54620  \u47784 \u46304  \u49324 \u50629 \u44284  \u44536 \u46308 \u51032  \u50689 \u54844 \u51032  \u47784 \u46304  \u49548 \u50896 \u44284  \u45432 \u47141 \u51060  \u49457 \u52712 \u46104 \u45716  \u45216 \u51060 \u44592  \u46412 \u47928 \u51060 \u45796 .\'94 \'93\u50724 ! \u51452 \u50668  \u44536  \u48373 \u46108  \u45216 \u51060  \u49549 \u55176  \u51060 \u47476 \u44172  \u54616 \u49548 \u49436 \'94 (Richard Baxter, Works, vol.17, pp.182, 183). \u44536  \u47568 \u51008  \u49324 \u46020  \u49884 \u45824 \u51032  \u44368 \u54924 \u50752  \u44305 \u50556 \u51032  \u44368 \u54924 \u50752  \u51333 \u44368  \u44060 \u54785 \u51088 \u46308 \u51032  \u54620 \u44208 \u44057 \u51008  \u49548 \u47581 \u51060 \u50632 \u45796 .\
