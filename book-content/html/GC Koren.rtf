\uc0\u48277 \u50773 \u44368 \u51032  \u50516 \u55121 \u50640 \u49436  \u44368 \u54924 \u47484  \u49692 \u49688 \u54620  \u49888 \u50521 \u51032  \u48731  \u44032 \u50868 \u45936 \u47196  \u51064 \u46020 \u54616 \u44592  \u50948 \u54620  \u49324 \u47749 \u51012  \u48155 \u51008  \u49324 \u46988 \u46308  \u51473 \u50640 \u49436  \u44032 \u51109  \u49440 \u48393 \u50640  \u49456 \u45912  \u49324 \u46988 \u51008  \u47560 \u54004  \u47336 \u53552  (Martin Luther) \u50688 \u45796 . \u44536 \u45716  \u50676 \u49457  \u51080 \u44256  \u44221 \u44148 \u54616 \u47728  \u54616 \u45208 \u45784 \u51012  \u44221 \u50808 \u54616 \u45716  \u44163  \u50808 \u50640  \u50500 \u47924 \u44163 \u46020  \u46160 \u47140 \u50892 \u54616 \u51648  \u50506 \u51012  \u49104  \u50500 \u45768 \u46972  \u49457 \u44221  \u51060 \u50808 \u50640 \u45716  \u50500 \u47924 \u44163 \u46020  \u49888 \u50521 \u51032  \u44592 \u52488 \u47196  \u49340 \u51648  \u50500 \u45768 \u54620  \u44536  \u45817 \u49884 \u51032  \u49884 \u45824 \u51201  \u51064 \u47932 \u51060 \u50632 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u44536 \u47484  \u53685 \u54616 \u50668  \u44368 \u54924 \u51032  \u44060 \u54785 \u44284  \u49464 \u49345 \u51032  \u44228 \u47805 \u51012  \u50948 \u54620  \u50948 \u45824 \u54620  \u49324 \u50629 \u51012  \u49457 \u52712 \u49884 \u53412 \u49512 \u45796 .\
\uc0\u52488 \u52285 \u44592 \u51032  \u48373 \u51020  \u49324 \u51088 \u46308 \u52376 \u47100  \u47336 \u53552 \u45716  \u48712 \u44417 \u54620  \u44228 \u52789 \u50640 \u49436  \u53468 \u50612 \u45228 \u45796 . \u44536 \u45716  \u50976 \u45380  \u49884 \u45824 \u47484  \u46021 \u51068 \u51032  \u54620  \u48712 \u52380 \u54620  \u45432 \u46041 \u51088 \u51032  \u44032 \u51221 \u50640 \u49436  \u48372 \u45256 \u45796 . \u44305 \u48512 \u51064  \u44536 \u51032  \u50500 \u48260 \u51648 \u45716  \u47588 \u51068  \u44256 \u46108  \u45432 \u46041 \u51004 \u47196  \u44536 \u51032  \u44368 \u50977 \u51012  \u50948 \u54620  \u51088 \u44552 \u51012  \u47560 \u47144 \u54616 \u50688 \u45796 . \u44536 \u51032  \u50500 \u48260 \u51648 \u45716  \u47336 \u53552 \u47484  \u48277 \u47456 \u44032 \u47196  \u47564 \u46308  \u49373 \u44033 \u51060 \u50632 \u45796 . \u44536 \u47084 \u45208  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u44536 \u47196  \u54616 \u50668 \u44552  \u51648 \u45208 \u44036  \u50668 \u47084  \u49464 \u44592  \u46041 \u50504 \u50640  \u51648 \u50672 \u46104 \u44256  \u51080 \u45716  \u50948 \u45824 \u54620  \u49457 \u51204 \u51012  \u49464 \u50864 \u45716  \u44148 \u52629 \u51088 \u47196  \u49340 \u44256 \u51088  \u44228 \u54925 \u54616 \u49512 \u45796 . \u44536 \u47532 \u54616 \u50668  \u47924 \u54620 \u55176  \u51648 \u54812 \u47196 \u50864 \u49888  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u47676 \u51200  \u44256 \u45212 \u44284  \u44417 \u54605 \u44284  \u50628 \u44201 \u54620  \u54984 \u47144 \u51012  \u53685 \u54616 \u50668  \u47336 \u53552 \u47196  \u54616 \u50668 \u44552  \u44536 \u51032  \u54217 \u49373 \u51032  \u51473 \u45824 \u54620  \u49324 \u50629 \u51012  \u50948 \u54616 \u50668  \u51456 \u48708 \u54616 \u44172  \u54616 \u49512 \u45796 .\
\uc0\u47336 \u53552 \u51032  \u50500 \u48260 \u51648 \u45716  \u44053 \u51649 \u54616 \u44256  \u51201 \u44537 \u51201 \u51064  \u47560 \u51020 \u44284  \u54988 \u47469 \u54620  \u54408 \u49457 \u51012  \u51648 \u45768 \u44256  \u51221 \u51649 \u54616 \u44256  \u44284 \u45800 \u49457  \u51080 \u44256  \u49556 \u51649 \u54620  \u49324 \u46988 \u51060 \u50632 \u45796 . \u44536 \u45716  \u52293 \u51076 \u44048 \u51060  \u44053 \u54616 \u50688 \u51004 \u48064 \u47196  \u44208 \u44284 \u51032  \u50668 \u54616 \u47484  \u47561 \u47200 \u54616 \u44256  \u51088 \u44592 \u51032  \u49548 \u49888 \u51012  \u44288 \u52384 \u49884 \u53412 \u45716  \u49324 \u46988 \u51060 \u50632 \u45796 . \u44536 \u45716  \u44148 \u51204 \u54620  \u54032 \u45800 \u47141 \u51012  \u44032 \u51648 \u44256  \u51080 \u50632 \u51004 \u48064 \u47196  \u49849 \u50896  \u51228 \u46020  (\u20711 \u38498 \u21046 \u24230 ) \u47484  \u48520 \u49888 \u54616 \u44172  \u46104 \u50632 \u45796 . \u47336 \u53552 \u44032  \u50500 \u48260 \u51648 \u51032  \u54728 \u46973 \u51012  \u48155 \u51648  \u50506 \u44256  \u49849 \u50896 \u50640  \u46308 \u50612 \u44032 \u44172  \u46104 \u51088  \u44536 \u45716  \u47588 \u50864  \u50616 \u51682 \u44172  \u49373 \u44033 \u54616 \u50688 \u45796 . \u44536  \u54980  \u51060 \u53468 \u44032  \u51648 \u45208 \u49436 \u50556  \u48512 \u51088 \u44036 \u50640  \u54868 \u54644 \u44032  \u51060 \u47336 \u50612 \u51276 \u45796 . \u44536 \u47084 \u45208  \u44536 \u51032  \u50500 \u48260 \u51648 \u51032  \u51032 \u44204 \u51008  \u50668 \u51204 \u55176  \u48320 \u54632 \u51060  \u50630 \u50632 \u45796 .\
\uc0\u47336 \u53552 \u51032  \u48512 \u47784 \u45716  \u51088 \u45376 \u46308 \u51032  \u44368 \u50977 \u50640  \u45824 \u54616 \u50668  \u47588 \u50864  \u49464 \u49900 \u54616 \u44172  \u51452 \u51032 \u47484  \u44592 \u50872 \u50688 \u45796 . \u44536 \u46308 \u51008  \u54616 \u45208 \u45784 \u44760  \u45824 \u54620  \u51648 \u49885 \u51012  \u51088 \u45376 \u46308 \u50640 \u44172  \u44032 \u47476 \u52824 \u44256  \u44536 \u47532 \u49828 \u46020 \u51064 \u51032  \u45909 \u49457 \u51012  \u44600 \u47084  \u51452 \u44592 \u50640  \u55192 \u50044 \u45796 . \u51088 \u51452  \u44536 \u51032  \u50500 \u48260 \u51648 \u45716  \u47336 \u53552 \u44032  \u46307 \u45716  \u45936 \u49436  \u51088 \u44592 \u51032  \u50500 \u46308 \u51060  \u51452 \u51032  \u51060 \u47492 \u51012  \u44592 \u50613 \u54616 \u44256  \u51109 \u52264  \u51652 \u47532 \u47484  \u51204 \u54028 \u54616 \u45716  \u49324 \u50629 \u50640  \u50976 \u50857 \u54620  \u51064 \u47932 \u51060  \u46112  \u49688  \u51080 \u44172  \u54644  \u45804 \u46972 \u44256  \u44592 \u46020 \u46300 \u47160 \u45796 . \u44536  \u48512 \u47784 \u45716  \u51088 \u45376 \u46308 \u51032  \u46020 \u45909 \u51201 \'b7\u51648 \u51201  \u48156 \u45804 \u51012  \u50948 \u54616 \u50668 \u49436 \u45716  \u50612 \u46496 \u54620  \u44256 \u49373 \u46020  \u45804 \u44172  \u48155 \u50520 \u45796 . \u44536 \u46308 \u51008  \u51088 \u45376 \u46308 \u50640 \u44172  \u44221 \u44148 \u54616 \u44256  \u50976 \u50857 \u54620  \u49373 \u50528 \u47484  \u51456 \u48708 \u49884 \u53020  \u51452 \u44592  \u50948 \u54616 \u50668  \u50676 \u47148 \u55176  \u44536 \u47532 \u44256  \u44984 \u51456 \u55176  \u45432 \u47141 \u54616 \u50688 \u45796 . \u44536  \u48512 \u47784 \u45716  \u54869 \u44256 \u54616 \u44256  \u44053 \u51649 \u54620  \u54408 \u49457  \u46412 \u47928 \u50640  \u46412 \u46412 \u47196  \u45320 \u47924 \u45208  \u44032 \u54841 \u54620  \u47732 \u51012  \u46300 \u47084 \u45256 \u45796 . \u44536 \u47084 \u45208  \u47336 \u53552 \u45716  \u44536  \u48512 \u47784 \u51032  \u51096 \u47803 \u51012  \u44060 \u51032 \u52824  \u50500 \u45768 \u54616 \u44256  \u51060 \u47084 \u54620  \u54984 \u44228 \u50640  \u45824 \u54616 \u50668  \u48520 \u54217 \u54616 \u44592 \u48372 \u45796 \u45716  \u45804 \u44172  \u48155 \u45716  \u44163 \u51060  \u47560 \u46405 \u54616 \u45796 \u44256  \u49373 \u44033 \u54616 \u50688 \u45796 .\
\uc0\u47336 \u53552 \u45716  \u50612 \u47536  \u49884 \u51208 \u50640  \u45796 \u45768 \u45912  \u54617 \u44368 \u50640 \u49436  \u47588 \u50864  \u50628 \u44201 \u54616 \u45796 \u44592 \u48372 \u45796 \u45716  \u50724 \u55176 \u47140  \u45212 \u54253 \u54616 \u45796 \u44256  \u54624  \u47564 \u54620  \u52712 \u44553 \u51012  \u48155 \u50520 \u45796 . \u51665 \u50504 \u51060  \u45320 \u47924  \u44032 \u45212 \u54616 \u50688 \u51004 \u48064 \u47196  \u51060 \u50883  \u47560 \u51012 \u50640  \u51080 \u45716  \u54617 \u44368 \u50640  \u45796 \u45768 \u47732 \u49436  \u54620  \u46412 \u45716  \u51665 \u51665 \u51012  \u52286 \u50500 \u45796 \u45768 \u47728  \u45432 \u47000 \u47484  \u48520 \u47084  \u51452 \u44256  \u51020 \u49885 \u51012  \u50619 \u44592 \u46020  \u54616 \u44256 , \u46412 \u47196 \u45716  \u44406 \u44592 \u46020  \u54616 \u50688 \u45796 . \u45817 \u49884 \u50640  \u51068 \u48152 \u51201 \u51004 \u47196  \u44032 \u51648 \u44256  \u51080 \u45912  \u51020 \u52840 \u54616 \u44256  \u48120 \u49888 \u51201 \u51064  \u51333 \u44368  \u44288 \u45392  \u46412 \u47928 \u50640  \u44536 \u51032  \u47560 \u51020 \u51008  \u46160 \u47140 \u50880 \u51004 \u47196  \u52264  \u51080 \u50632 \u45796 . \u44536 \u45716  \u49836 \u54548 \u51004 \u47196  \u48164 \u51012  \u51648 \u45236 \u44256 , \u50516 \u45812 \u54620  \u51109 \u47000 \u50640  \u45824 \u54616 \u50668  \u44277 \u54252 \u47484  \u45712 \u44808 \u45796 . \u44536 \u50640 \u44172 \u45716  \u54616 \u45208 \u45784 \u51060  \u51064 \u51088 \u54616 \u49888  \u50500 \u48260 \u51648 \u46972 \u44592 \u48372 \u45796 \u45716  \u45257 \u54841 \u54616 \u44256  \u47924 \u51221 \u54620  \u49900 \u54032 \u44288 \u51060 \u45208  \u51092 \u54617 \u54616 \u44256  \u47924 \u51088 \u48708 \u54620  \u54253 \u44400 \u44284  \u44057 \u51060  \u49373 \u44033 \u46104 \u50632 \u45796 .\
\uc0\u47336 \u53552 \u45716  \u50668 \u47084  \u44032 \u51648 \u47196  \u44537 \u49900 \u54620  \u49892 \u47581 \u51012  \u45817 \u54616 \u47732 \u49436 \u46020  \u44536  \u47560 \u51020 \u50640  \u47588 \u47141 \u51012  \u51452 \u44256  \u51080 \u45716  \u51648 \u51201 , \u46020 \u45909 \u51201  \u46160  \u44032 \u51648  \u47732 \u51032  \u45458 \u51008  \u54364 \u51456 \u51012  \u54693 \u54616 \u50668  \u45804 \u47140  \u45208 \u50500 \u44052 \u45796 . \u44536 \u45716  \u51648 \u49885 \u51012  \u44040 \u47581 \u54616 \u44256  \u51080 \u50632 \u45796 . \u50676 \u49457 \u51201 \u51060 \u44256  \u49892 \u51228 \u51201 \u51064  \u44536 \u51032  \u47560 \u51020 \u51008  \u50808 \u54805 \u51201 \u51060 \u44144 \u45208  \u52380 \u48149 \u54620  \u44163 \u48372 \u45796 \u45716  \u44160 \u49548 \u54616 \u44256  \u49892 \u49549  \u51080 \u45716  \u44163 \u51012  \u51339 \u50500 \u54616 \u50688 \u45796 .\
