\uc0\u48373 \u51020 \u51452 \u51032 \u51088 \u46308 \u51032  \u54801 \u51032 \u54924 \u44032  \u50676 \u47532 \u44172  \u46104 \u51088  \u44536 \u46308 \u51008  \u45212 \u52376 \u54620  \u50620 \u44404 \u48731 \u51004 \u47196  \u49436 \u47196  \u52432 \u45796 \u48372 \u44592 \u47564  \u54664 \u45796 . \u44536 \u46308 \u51008  \'93\u50612 \u52236 \u54616 \u47732  \u51339 \u51012 \u44620 \'94 \u54616 \u45716  \u51060 \u50556 \u44592 \u47484  \u51452 \u44256 \u48155 \u50520 \u45796 . \u49464 \u44228 \u51032  \u51473 \u45824 \u54620  \u47928 \u51228 \u44032  \u50948 \u44592 \u50640  \u45459 \u50668 \u51080 \u50632 \u45796 . \'93\u44060 \u54785 \u54028 \u51032  \u51648 \u46020 \u51088 \u46308 \u51060  \u52825 \u47161 \u51012  \u48155 \u50500 \u46308 \u51060 \u44592  \u50948 \u54616 \u50668  \u48373 \u51333 \u54624  \u44163 \u51064 \u44032 ?\'94 \u44060 \u54785 \u51088 \u46308 \u51008  \u51060 \u52376 \u47100  \u51221 \u47568 \u47196  \u45440 \u46972 \u50868  \u50948 \u44592 \u47484  \u45817 \u54616 \u50668  \u45436 \u51137 \u54616 \u45796 \u44032  \u49828 \u49828 \u47196  \u44536 \u47495 \u46108  \u44600 \u47196  \u48736 \u51648 \u44592 \u44032  \u50620 \u47560 \u45208  \u49772 \u50912 \u50632 \u45912 \u44032 ! \u44536 \u46308 \u51008  \u54637 \u48373 \u54616 \u44592 \u50640  \u51201 \u45817 \u54620  \u44396 \u49892 \u44284  \u51060 \u50976 \u47484  \u52280 \u51004 \u47196  \u47566 \u51060  \u48156 \u44204 \u54624  \u49688 \u44032  \u51080 \u50632 \u45796 . \u47336 \u53552 \u54028 \u51032  \u51228 \u54980 \u46308 \u50640 \u44172 \u45716  \u49888 \u44368 \u51032  \u51088 \u50976 \u44032  \u48372 \u51109 \u46104 \u50612  \u51080 \u50632 \u45796 . \u46609 \u44057 \u51008  \u53945 \u51204 \u51060  \u44536 \u46308 \u51032  \u49884 \u48124  \u51473 \u50640 \u49436  \u51060  \u48277 \u50504 \u51060  \u53685 \u44284 \u46104 \u44592  \u51204 \u48512 \u53552  \u51060 \u48120  \u44536  \u44060 \u54785 \u54028 \u51032  \u49888 \u50521 \u51012  \u44032 \u51648 \u44256  \u51080 \u45716  \u51088 \u46308 \u50640 \u44172 \u45716  \u51452 \u50612 \u51256  \u51080 \u50632 \u45796 . \u50864 \u47532 \u45716  \u51060  \u50504  (\u26696 ) \u50640  \u47564 \u51313 \u54644 \u50556  \u54624  \u44163 \u51060  \u50500 \u45772 \u44032 ? \u48373 \u51333 \u54616 \u44592 \u47484  \u44144 \u48512 \u54624  \u46412  \u50620 \u47560 \u45208  \u47566 \u51008  \u50948 \u54744 \u51060  \u46384 \u47484  \u44163 \u51064 \u44032 ? \u48152 \u45824 \u54616 \u47732  \u51109 \u52264  \u50620 \u47560 \u45208  \u53360  \u50948 \u54744 \u44284  \u53804 \u51137 \u51060  \u50732 \u45716 \u51648  \u50500 \u47924 \u46020  \u50508  \u49688  \u50630 \u45796 . \u51109 \u52264  \u50612 \u46500  \u51339 \u51008  \u44592 \u54924 \u44032  \u50732 \u51648  \u45572 \u44032  \u50508 \u44192 \u45716 \u44032 ? \u54217 \u54868 \u47484  \u48155 \u50500 \u46308 \u51060 \u51088 . \u47196 \u47560 \u44032  \u45236 \u48120 \u45716  \u44048 \u46988 \u45208 \u47924 \u51032  \u44032 \u51648 \u47484  \u48537 \u51105 \u44256  \u46021 \u51068 \u51032  \u49345 \u52376 \u47484  \u49912 \u47588 \u46020 \u47197  \u54616 \u51088 . \u51060 \u50752  \u44057 \u51008  \u45436 \u51613 \u51004 \u47196  \u44060 \u54785 \u51088 \u46308 \u51008  \u50724 \u47000 \u51648  \u50506 \u50500 \u49436  \u44536 \u46308 \u51032  \u49324 \u50629 \u51012  \u48516 \u47749 \u55176  \u54028 \u47736 \u49884 \u53020  \u48260 \u47540  \u44208 \u44284 \u47484  \u44032 \u51256 \u50732  \u44600 \u51012  \u53469 \u54616 \u45716  \u51068 \u50640  \u51080 \u50612 \u49436  \u44536 \u46308 \u51032  \u53468 \u46020 \u47484  \u51221 \u45817 \u54868 \u49884 \u53420  \u49688 \u46020  \u51080 \u50632 \u51012  \u44163 \u51060 \u45796 .\
\'93\uc0\u45796 \u54665 \u55176  \u44536 \u46308 \u51008  \u51060 \u47084 \u54620  \u53440 \u54801 \u50504 \u51032  \u51200 \u48320 \u50640  \u47924 \u50631 \u51060  \u44628 \u47140  \u51080 \u45716 \u51648 \u47484  \u44036 \u54028 \u54616 \u44256  \u48127 \u51020 \u51012  \u46384 \u46972  \u54665 \u46041 \u54616 \u50688 \u45796 . \u44536  \u51200 \u48320 \u50640  \u44032 \u47196 \u45459 \u51064  \u50896 \u52825 \u51060 \u46976  \u47924 \u50631 \u51060 \u50632 \u45912 \u44032 ? \u44536 \u44163 \u51008  \u47196 \u47560 \u44032  \u49324 \u46988 \u46308 \u51032  \u50577 \u49900 \u51012  \u50613 \u51228 \u54616 \u44256  \u51088 \u50976 \u47196 \u50868  \u50672 \u44396 \u47484  \u44552 \u51648 \u54624  \u44428 \u47532 \u47484  \u44032 \u51276 \u45796 \u45716  \u44163 \u51060 \u50632 \u45796 . \u44536 \u47111 \u45796 \u47732  \u44536 \u46308  \u51088 \u49888 \u44284  \u44060 \u54785 \u51452 \u51032 \u51032  \u49888 \u50521 \u51012  \u44032 \u51652  \u49324 \u46988 \u46308 \u51008  \u49888 \u50521 \u51032  \u51088 \u50976 \u47484  \u45572 \u47540  \u49688  \u50630 \u45800  \u47568 \u51064 \u44032 ? \u44284 \u50672  \u44536 \u47084 \u54664 \u45796 . \u44536 \u46308 \u51008  \u51221 \u45817 \u54620  \u44428 \u47532 \u44032  \u50500 \u45768 \u44256 , \u45796 \u47564  \u53945 \u48324 \u55176  \u54624 \u50528 \u46104 \u45716  \u51008 \u54812 \u47196 \u49436 \u51032  \u51088 \u50976 \u44032  \u44256 \u51089 \u51060 \u50632 \u45796 . \u51060 \u47084 \u54620  \u53945 \u48324  \u51312 \u52824 \u47484  \u48155 \u51648  \u47803 \u54616 \u45716  \u49324 \u46988 \u46308 \u51008  \u49548 \u50948  \u50948 \u45824 \u54620  \u44428 \u50948 \u51032  \u50896 \u52825 \u51004 \u47196  \u51648 \u48176 \u47484  \u48155 \u50500 \u50556 \u47564  \u54616 \u50688 \u45796 . \u44536 \u47084 \u54620  \u44221 \u50864 \u50640  \u50577 \u49900 \u51008  \u51204 \u50672  \u47924 \u49884 \u46104 \u44256 , \u47196 \u47560 \u45716  \u50668 \u51204 \u55176  \u44536 \u47495 \u46120 \u51060  \u50630 \u45716  \u49900 \u54032 \u51088 \u44032  \u46104 \u44256 , \u44144 \u44592 \u50640  \u48373 \u51333 \u54616 \u51648  \u50506 \u51004 \u47732  \u50504  \u46104 \u50632 \u45796 . \u51060  \u53440 \u54801 \u50504 \u51012  \u48155 \u50500 \u46308 \u51060 \u45716  \u44163 \u51008  \u49888 \u50521 \u51032  \u51088 \u50976 \u44032  \u51060 \u48120  \u44060 \u54785 \u51452 \u51032 \u47484  \u50857 \u51064 \u54620  \u51089 \u49468 \u50640 \u47564  \u51201 \u50857 \u46104 \u50612 \u50556  \u54616 \u44256  \u44536  \u48150 \u51032  \u45796 \u47480  \u44536 \u47532 \u49828 \u46020 \u44368 \u44397 \u50640 \u49436 \u45716  \u51088 \u50976 \u47213 \u44172  \u50672 \u44396 \u54616 \u44144 \u45208  \u44060 \u54785 \u51452 \u51032 \u51032  \u49888 \u50521 \u51012  \u44256 \u48177 \u54616 \u45716  \u44163 \u51060  \u51396 \u44032  \u46104 \u47728 , \u48152 \u46300 \u49884  \u50725 \u50640  \u44039 \u55176 \u44144 \u45208  \u54868 \u54805 \u51012  \u45817 \u54616 \u51648  \u50506 \u51004 \u47732  \u50504  \u46108 \u45796 \u45716  \u44163 \u51012  \u49324 \u49892 \u49345  \u49849 \u51064 \u54616 \u45716  \u44163 \u51060 \u50632 \u45796 . \u44536 \u46308 \u51008  \u51333 \u44368 \u51032  \u51088 \u50976 \u47484  \u51228 \u54620 \u49884 \u53412 \u45716  \u51068 \u50640  \u46041 \u51032 \u54624  \u49688  \u51080 \u51012 \u44620 ? \u44536 \u44163 \u51012  \u49688 \u46973 \u54632 \u51004 \u47196  \u44060 \u54785  \u49324 \u50629 \u51008  \u45908  \u51060 \u49345  \u49888 \u51088 \u47484  \u50619 \u51648  \u47803 \u54616 \u44256  \u51228 \u54620 \u46108  \u48276 \u50948  \u50504 \u50640 \u49436  \u45908  \u45208 \u50500 \u44032 \u51648  \u47803 \u54616 \u46020 \u47197  \u49440 \u54252 \u46104 \u44172  \u54624  \u49688  \u51080 \u51012 \u44620 ? \u44536 \u47532 \u54616 \u50668  \u47196 \u47560 \u44032  \u51648 \u48176 \u54616 \u44256  \u51080 \u45716  \u44275 \u51008  \u50612 \u46356 \u50640 \u45208  \u44536  \u53685 \u52824 \u44428 \u51060  \u50689 \u49549 \u46112  \u49688 \u48150 \u50640  \u50630 \u44172  \u54644 \u50556  \u54624 \u44620 ? \u44060 \u54785 \u51088 \u46308 \u51060  \u51060  \u54801 \u51221 \u51012  \u51060 \u54665 \u54632 \u51004 \u47196  \u48277 \u50773 \u44428  \u50500 \u47000  \u49549 \u54620  \u51648 \u48169 \u50640 \u49436  \u49373 \u47749 \u51012  \u48148 \u52824 \u51648  \u50506 \u51004 \u47732  \u50504  \u46112  \u47924 \u49688 \u54620  \u49324 \u46988 \u46308 \u51032  \u54588 \u50640  \u45824 \u54616 \u50668  \u47924 \u51396 \u54616 \u45796 \u44256  \u48320 \u47749 \u54624  \u49688  \u51080 \u51012 \u44620 ? \u51060 \u47084 \u54620  \u54665 \u46041 \u51012  \u52712 \u54616 \u45716  \u44163 \u51008  \u44536 \u52376 \u47100  \u51473 \u45824 \u54620  \u49884 \u44592 \u50640  \u44536 \u47532 \u49828 \u46020 \u44368 \u44397 \u51032  \u48373 \u51020 \u44284  \u51088 \u50976 \u51032  \u49324 \u50629 \u51012  \u48152 \u50669 \u54616 \u45716  \u51068 \u51060  \u46112  \u49688 \u48150 \u50640  \u50630 \u50632 \u45796 \'94 (Wylie, b.9, ch.15). \u44536 \u47084 \u48064 \u47196  \u44536 \u46308 \u51008  \u52264 \u46972 \u47532  \u51600 \u44200  \'93\u47784 \u46304  \u44163 \u51012  \u55148 \u49373 \u54616 \u46104  \u51088 \u44592 \u46308 \u51032  \u50689 \u53664 \u50752  \u51648 \u50948 \u50752  \u49373 \u47749 \u44620 \u51648 \u46020  \u55148 \u49373 \u54616 \u44256 \u51088  \u54616 \u50688 \u45796 \'94 (D\'92Au-bigne, b.13, ch.5).\
