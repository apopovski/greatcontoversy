\uc0\u50689 \u50896 \u54620  \u44396 \u50896 \u51032  \u44032 \u52824 \u47484  \u50500 \u45716  \u47784 \u46304  \u49324 \u46988 \u46308 \u51008  \u54924 \u51032 \u47200  (\u25079 \u30097 \u35542 ) \u51032  \u52840 \u51077 \u51012  \u48155 \u51648  \u50506 \u46020 \u47197  \u49828 \u49828 \u47196  \u44221 \u44228 \u54644 \u50556  \u54620 \u45796 . \u48148 \u47196  \u51652 \u47532 \u51032  \u44592 \u46181 \u46308 \u51060  \u44277 \u44201 \u51012  \u48155 \u51012  \u44163 \u51060 \u45796 . \u50724 \u45720 \u45216 \u51032  \u48520 \u49888 \u50640  \u49549 \u54620  \u54413 \u51088  (\u35575 \u21050 ) \u50752  \u44452 \u48320  (\u35437 \u36783 ), \u44368 \u54876 \u54616 \u44256  \u52824 \u47749 \u51201 \u51064  \u44368 \u54984 \u51032  \u44277 \u44201 \u44428 \u50640 \u49436  \u48279 \u50612 \u45216  \u49688 \u45716  \u50630 \u45796 . \u49324 \u45800 \u51008  \u47784 \u46304  \u44228 \u52789 \u51032  \u49324 \u46988 \u46308 \u50640 \u44172  \u44536 \u51032  \u49884 \u54744 \u51012  \u51201 \u50857 \u54620 \u45796 . \u44536 \u45716  \u44368 \u50977 \u48155 \u51008  \u51088 \u46308 \u50640 \u44172 \u45716  \u44284 \u54617 \u51201  \u48152 \u45824  \u51060 \u47200 \u44284  \u52384 \u54617 \u51201  \u51060 \u47200 \u51004 \u47196  \u45824 \u44208 \u54616 \u45716  \u54620 \u54200  \u47924 \u49885 \u54620  \u51088 \u46308 \u50640 \u44172 \u45716  \u55148 \u47217 \u44284  \u51312 \u47217 \u51004 \u47196  \u49457 \u44221 \u51012  \u48520 \u49888 \u52992  \u54616 \u44144 \u45208  \u44221 \u47736 \u54616 \u46020 \u47197  \u44277 \u44201 \u54616 \u44256 \u51088  \u44228 \u54925 \u51012  \u49464 \u50912 \u45796 . \u49900 \u51648 \u50612  \u44221 \u54744 \u51060  \u48324 \u47196  \u50630 \u45716  \u51210 \u51008 \u51060 \u46308 \u46020  \u44536 \u47532 \u49828 \u46020 \u44368 \u51032  \u44592 \u48376  \u50896 \u47532 \u50640  \u45824 \u54616 \u50668  \u51032 \u54841 \u51012  \u54408 \u44172  \u46108 \u45796 . \u51060 \u50752  \u44057 \u51008  \u52397 \u45380 \u44592 \u51032  \u48520 \u49888 \u51008  \u44536 \u44163 \u51060  \u48708 \u47197  \u48120 \u50557 \u54624 \u51648 \u46972 \u46020  \u44536  \u50689 \u54693 \u47141 \u51012  \u48156 \u55064 \u54616 \u44172  \u46108 \u45796 . \u44536 \u47532 \u54616 \u50668  \u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u44536 \u46308 \u51032  \u51312 \u49345 \u46308 \u51032  \u49888 \u50521 \u51012  \u51312 \u49548 \u54616 \u44256  \u51008 \u54812 \u51032  \u49457 \u47161 \u51012  \u47736 \u49884 \u54616 \u44172  \u46104 \u50632 \u45796  (\u55176  10:29 \u52280 \u44256 ). \u54616 \u45208 \u45784 \u44760  \u50689 \u44305 \u51060  \u46104 \u44256  \u49464 \u49345 \u50640  \u52629 \u48373 \u51060  \u46112  \u49688  \u51080 \u50632 \u45912  \u51204 \u46020 \u50976 \u47581 \u54620  \u47566 \u51008  \u49324 \u46988 \u46308 \u51032  \u49373 \u50528 \u44032  \u45908 \u47084 \u50868  \u48520 \u49888 \u51032  \u44592 \u50868 \u51004 \u47196  \u49884 \u46308 \u50612  \u48260 \u47160 \u45796 . \u51064 \u44036  \u51060 \u49457 \u51032  \u51088 \u46993 \u49828 \u47088  \u44208 \u51221 \u47141 \u51012  \u51032 \u51648 \u54620  \u45208 \u47672 \u51648  \u44536 \u46308 \u51060  \u54616 \u45208 \u45784 \u51032  \u50724 \u47896 \u47484  \u49444 \u47749 \u54616 \u44256  \u54616 \u45208 \u45784 \u51032  \u51648 \u54812 \u51032  \u46020 \u50880 \u51060  \u50630 \u50612 \u46020  \u51652 \u47532 \u50640  \u51060 \u47484  \u49688  \u51080 \u45796 \u44256  \u49373 \u44033 \u54616 \u45716  \u47784 \u46304  \u51088 \u46308 \u51008  \u49324 \u45800 \u51032  \u50732 \u47924 \u50640  \u44152 \u47140  \u51080 \u45796 .\
\uc0\u50864 \u47532 \u45716  \u51060  \u49464 \u49345  \u50669 \u49324 \u51032  \u44032 \u51109  \u50628 \u49689 \u54620  \u49884 \u44592 \u50640  \u49332 \u44256  \u51080 \u45796 . \u51648 \u49345 \u51032  \u47924 \u49688 \u54620  \u49324 \u46988 \u46308 \u51032  \u50868 \u47749 \u51008  \u48148 \u50556 \u55120 \u47196  \u44208 \u51221 \u46104 \u47140  \u54616 \u44256  \u51080 \u45796 . \u50864 \u47532 \u51032  \u48120 \u47000 \u51032  \u54665 \u48373 \u44284  \u45796 \u47480  \u50689 \u54844 \u46308 \u51032  \u44396 \u50896 \u51008  \u50864 \u47532 \u44032  \u51648 \u44552  \u44152 \u50612 \u44032 \u44256  \u51080 \u45716  \u44600 \u50640  \u51032 \u54616 \u50668  \u51340 \u50864 \u46108 \u45796 . \u50864 \u47532 \u45716  \u51652 \u47532 \u51032  \u50689 \u51004 \u47196  \u51648 \u46020  \u48155 \u51012  \u54596 \u50836 \u44032  \u51080 \u45796 . \u44536 \u47532 \u49828 \u46020 \u47484  \u46384 \u47476 \u45716  \u47784 \u46304  \u49324 \u46988 \u46308 \u51008  \'93\u51452 \u50668  \u45236 \u44032  \u47924 \u50631 \u51012  \u54616 \u44592 \u47484  \u50896 \u54616 \u49901 \u45768 \u44620 \'94\u46972 \u44256  \u44036 \u51208 \u54620  \u47560 \u51020 \u51004 \u47196  \u47932 \u50612 \u50556  \u54620 \u45796 . \u50864 \u47532 \u45716  \u44552 \u49885 \u44284  \u44592 \u46020 \u47196 \u50024  \u51452 \u45784  \u50526 \u50640  \u50864 \u47532  \u51088 \u49888 \u51012  \u44216 \u48708 \u54616 \u44172  \u54616 \u44256  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 , \u53945 \u48324 \u55176  \u49900 \u54032 \u51032  \u44305 \u44221 \u50640  \u45824 \u54616 \u50668  \u47566 \u51060  \u49373 \u44033 \u54644 \u50556  \u54620 \u45796 . \u50864 \u47532 \u45716  \u51648 \u44552  \u54616 \u45208 \u45784 \u51032  \u49324 \u47932 \u50640  \u45824 \u54616 \u50668  \u44618 \u44256 , \u49328  \u44221 \u54744 \u51012  \u50619 \u44592  \u50948 \u54616 \u50668  \u45432 \u47141 \u54644 \u50556  \u54620 \u45796 . \u50864 \u47532 \u45716  \u54620 \u49692 \u44036 \u46020  \u54728 \u48708 \u54616 \u51648  \u47568 \u50500 \u50556  \u54620 \u45796 . \u52280 \u51004 \u47196  \u51473 \u45824 \u54620  \u49324 \u44148 \u46308 \u51060  \u50864 \u47532  \u51452 \u50948 \u50640 \u49436  \u51068 \u50612 \u45208 \u44256  \u51080 \u45796 . \u50864 \u47532 \u45716  \u49324 \u45800 \u51032  \u50836 \u49696 \u50640  \u44152 \u47140  \u51080 \u45716  \u46405 \u50640  \u52376 \u54644  \u51080 \u45796 . \u54616 \u45208 \u45784 \u51032  \u54028 \u49688 \u44988 \u46308 \u50500 , \u51320 \u51648  \u47568 \u46972 . \u50896 \u49688 \u45716  \u47792 \u47000  \u44032 \u44620 \u51060  \u51217 \u44540 \u54616 \u44256  \u51080 \u45796 . \u44536 \u45716  \u44536 \u45824 \u46308 \u51032  \u47560 \u51020 \u51060  \u54644 \u51060 \u54644 \u51256 \u49436  \u51320 \u44256  \u51080 \u51012  \u46412  \u50612 \u46500  \u49692 \u44036 \u51060 \u46304 \u51648  \u45924 \u48316 \u46308 \u50612  \u44536 \u45824 \u46308 \u51012  \u49324 \u47196 \u51105 \u51004 \u47140 \u44256  \u51456 \u48708 \u54616 \u44256  \u51080 \u45796 .\
\uc0\u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u54616 \u45208 \u45784  \u50526 \u50640 \u49436 \u51032  \u44536 \u46308 \u51032  \u51652 \u51221 \u54620  \u49345 \u53468 \u44032  \u50612 \u46496 \u54620 \u51648 \u50640  \u45824 \u54616 \u50668  \u49549 \u44256  \u51080 \u45796 . \u44536 \u46308 \u51008  \u44536 \u46308 \u51060  \u50501 \u54620  \u51068 \u51012  \u48276 \u54616 \u51648  \u50500 \u45768 \u54620  \u44163 \u51012  \u51088 \u46993 \u54616 \u45716  \u54620 \u54200  \u54616 \u45208 \u45784 \u44760 \u49436  \u50836 \u44396 \u54616 \u49884 \u45716  \u49440 \u54616 \u44256  \u44256 \u49345 \u54620  \u54665 \u50948 \u47484  \u54665 \u52824  \u50500 \u45768 \u54620  \u44163 \u51012  \u51082 \u50612 \u48260 \u47160 \u45796 . \u44536 \u46308 \u51060  \u54616 \u45208 \u45784 \u51032  \u51221 \u50896 \u50640  \u51080 \u45716  \u45208 \u47924 \u44032  \u46104 \u45716  \u44163 \u47564 \u51004 \u47196 \u45716  \u45321 \u45321 \u51648  \u47803 \u54616 \u45796 . \u44536 \u46308 \u51008  \u44284 \u49892 \u51012  \u47610 \u51020 \u51004 \u47196 \u50024  \u54616 \u45208 \u45784 \u51032  \u44592 \u45824 \u50640  \u48512 \u51025 \u54644 \u50556  \u54620 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u44536 \u46308 \u51012  \u44053 \u54616 \u44172  \u54644 \u51452 \u45716  \u54616 \u45208 \u45784 \u51032  \u51008 \u54812 \u47484  \u53685 \u54616 \u50668  \u49457 \u52712 \u54624  \u49688  \u51080 \u50632 \u45912  \u47784 \u46304  \u49440 \u51012  \u54665 \u52824  \u47803 \u54620  \u44163 \u50640  \u45824 \u54620  \u52293 \u51076 \u51012  \u44536 \u46308 \u50640 \u44172  \u51648 \u50864 \u49888 \u45796 . \u44536 \u46308 \u51008  \u54616 \u45720  \u52293 \u50640  \u46405 \u51012  \u48260 \u47532 \u44172  \u54616 \u45716  \u51088 \u46308 \u47196  \u44592 \u47197 \u46108 \u45796 . \u44536 \u47084 \u45208  \u51060 \u47088  \u48512 \u47448 \u51032  \u49324 \u46988 \u46308 \u51032  \u44221 \u50864 \u51068 \u51648 \u46972 \u46020  \u51204 \u54784  \u49548 \u47581 \u51060  \u50630 \u45716  \u44163 \u51008  \u50500 \u45768 \u45796 . \u54616 \u45208 \u45784 \u51032  \u51088 \u48708 \u47484  \u44144 \u51208 \u54616 \u44256  \u44536 \u48516 \u51032  \u51008 \u54812 \u47484  \u45224 \u50857 \u54620  \u51088 \u46308 \u50640  \u45824 \u54616 \u50668  \u50724 \u47019 \u46041 \u50504  \u52280 \u51004 \u49884 \u45716  \u49324 \u46993 \u51032  \u47560 \u51020 \u51008  \u50668 \u51204 \u55176  \u53444 \u50896 \u54616 \u49888 \u45796 . \'93\u44536 \u47084 \u48064 \u47196  \u51060 \u47476 \u49884 \u44592 \u47484  \u51104 \u51088 \u45716  \u51088 \u50668  \u44648 \u50612 \u49436  \u51453 \u51008  \u51088 \u46308  \u44032 \u50868 \u45936 \u49436  \u51068 \u50612 \u45208 \u46972  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u45348 \u44172  \u48708 \u52712 \u49884 \u47532 \u46972  \u54616 \u49512 \u45712 \u45768 \u46972  \u44536 \u47088 \u51593  \u45320 \u55148 \u44032  \u50612 \u46523 \u44172  \u54665 \u54624  \u44163 \u51012  \u51088 \u49464 \u55176  \u51452 \u51032 \u54616 \u50668 \'85\u49464 \u50900 \u51012  \u50500 \u45180 \u46972  \u46412 \u44032  \u50501 \u54616 \u45768 \u46972 \'94 (\u50657  5:14~16).\
\uc0\u49884 \u47144 \u51032  \u45216 \u51060  \u51060 \u47484  \u46412 \u50640  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51012  \u44536 \u46308 \u51032  \u49373 \u50528 \u51032  \u48277 \u52825 \u51004 \u47196  \u49340 \u51008  \u51088 \u46308 \u51060  \u45208 \u53440 \u45216  \u44163 \u51060 \u45796 . \u50668 \u47492 \u50640 \u45716  \u49345 \u47197 \u49688 \u50752  \u45796 \u47480  \u45208 \u47924 \u47484  \u46748 \u47159 \u54616 \u44172  \u44396 \u48516 \u54624  \u49688  \u50630 \u45796 . \u44536 \u47084 \u45208  \u44200 \u50872 \u48148 \u46988 \u51060  \u48520 \u50612 \u50724 \u47732  \u49345 \u47197 \u49688 \u45716  \u48320 \u54632 \u50630 \u51060  \u45224 \u50500  \u51080 \u51648 \u47564  \u45796 \u47480  \u45208 \u47924 \u46308 \u51008  \u51086 \u51060  \u46504 \u50612 \u51256  \u44536  \u44032 \u51648 \u44032  \u48268 \u44144 \u49709 \u51060 \u44032  \u46108 \u45796 . \u51060 \u50752  \u44057 \u51060  \u51648 \u44552 \u51008  \u47560 \u51020 \u51060  \u44144 \u51667 \u46108  \u49888 \u50521  \u44256 \u48177 \u51088 \u46308 \u51012  \u51652 \u51221 \u54620  \u44536 \u47532 \u49828 \u46020 \u51064 \u44284  \u44396 \u48324 \u54624  \u49688  \u50630 \u45796 . \u44536 \u47084 \u45208  \u44536  \u44396 \u48324 \u51060  \u48516 \u47749 \u55176  \u51648 \u50612 \u51656  \u46412 \u44032  \u51060 \u48120  \u51208 \u48149 \u54644  \u51080 \u45796 . \u48152 \u45824 \u44032  \u51068 \u50612 \u45208 \u44172  \u46104 \u47732 , \u50756 \u44256 \u50752  \u50613 \u50517 \u51060  \u45796 \u49884  \u44592 \u49464 \u47484  \u46504 \u52824 \u44172  \u46104 \u47732 , \u48149 \u54644 \u51032  \u48520 \u44600 \u51060  \u51068 \u50612 \u45208 \u44172  \u46104 \u47732 , \u48152 \u49888 \u48152 \u51032 \u51032  \u50948 \u49440 \u51201 \u51064  \u51088 \u46308 \u51008  \u55124 \u46308 \u47532 \u44256  \u48127 \u51020 \u51012  \u48260 \u47540  \u44163 \u51060 \u45796 . \u44536 \u47084 \u45208  \u51652 \u51221 \u54620  \u44536 \u47532 \u49828 \u46020 \u51064 \u46308 \u51008  \u48152 \u49437 \u44284  \u44057 \u51060  \u44403 \u44172  \u49444  \u44163 \u51060 \u47728 , \u44536 \u46308 \u51032  \u48127 \u51020 \u44284  \u49548 \u47581 \u51008  \u48264 \u50689 \u51032  \u46412 \u48372 \u45796  \u45908 \u50865  \u44053 \u54616 \u44256  \u45908 \u50865  \u48157 \u50500 \u51656  \u44163 \u51060 \u45796 .\
\uc0\u49884 \u54200  \u44592 \u51088 \u45716  \'93\u51452 \u51032  \u51613 \u44144 \u47484  \u47925 \u49345 \u54632 \u51004 \u47196 \'94, \'93\u51452 \u51032  \u48277 \u46020 \u47196  \u51064 \u54616 \u50668  \u45236 \u44032  \u47749 \u52384 \u52992  \u46104 \u50632 \u51004 \u48064 \u47196  \u47784 \u46304  \u44144 \u51667  \u54665 \u50948 \u47484  \u48120 \u50892 \u54616 \u45208 \u51060 \u45796 \'94 (\u49884  119:99, 104) \u44256  \u47568 \u54620 \u45796 .\
\'93\uc0\u51648 \u54812 \u47484  \u50619 \u51008  \u51088 \u50752  \u47749 \u52384 \u51012  \u50619 \u51008  \u51088 \u45716  \u48373 \u51060  \u51080 \u45208 \u45768 \'94 (\u51104  3:13), \'93\u44536 \u45716  \u47932 \u44032 \u50640  \u49900 \u44592 \u50868  \u45208 \u47924 \u44032  \u44536  \u49100 \u47532 \u47484  \u44053 \u48320 \u50640  \u48855 \u52824 \u44256  \u45908 \u50948 \u44032  \u50732 \u51648 \u46972 \u46020  \u46160 \u47140 \u50892  \u50500 \u45768 \u54616 \u47728  \u44536  \u51086 \u51060  \u52397 \u52397 \u54616 \u47728  \u44032 \u47924 \u45716  \u54644 \u50640 \u46020  \u44145 \u51221 \u51060  \u50630 \u44256  \u44208 \u49892 \u51060  \u44536 \u52824 \u51648  \u50500 \u45768 \u54632  \u44057 \u51004 \u47532 \u46972 \'94 (\u47128  17:8).\
