\uc0\u44536 \u47532 \u49828 \u46020 \u51032  \u51473 \u48372  \u49324 \u50629 \u44284  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51032  \u50689 \u50896 \u49457 \u50640  \u44288 \u54620  \u48731 \u51012  \u48155 \u50500 \u46308 \u51064  \u49324 \u46988 \u46308 \u51008  \u44536 \u44163 \u46308 \u51060  \u50836 \u54620 \u44228 \u49884 \u47197  14\u51109 \u50640  \u51228 \u49884 \u46108  \u51652 \u47532 \u51076 \u51012  \u48156 \u44204 \u54616 \u50688 \u45796 . \u44536  \u51109  (\u31456 ) \u51032  \u44592 \u48324 \u51008  \u51452 \u45784 \u51032  \u51116 \u47548 \u51012  \u50948 \u54616 \u50668  \u51648 \u49345 \u51032  \u44144 \u48124 \u46308 \u51012  \u51456 \u48708 \u49884 \u53412 \u44172  \u46112  \u49340 \u51473 \u51004 \u47196  \u46108  \u44221 \u44256 \u51032  \u44592 \u48324 \u51060 \u45796  (\u48512 \u47197  32 \u52280 \u51312 ). \'93\u44536 \u51032  \u49900 \u54032 \u54616 \u49892  \u49884 \u44036 \u51060  \u51060 \u47476 \u47104 \'94\u45796 \u45716  \u44592 \u48324 \u51008  \u51064 \u47448 \u51032  \u44396 \u50896 \u51012  \u50948 \u54620  \u44536 \u47532 \u49828 \u46020 \u51032  \u47560 \u51648 \u47561  \u48393 \u49324 \u47484  \u44032 \u47476 \u52432  \u51456 \u45796 . \u44536 \u44163 \u51008  \u44396 \u51452 \u51032  \u51473 \u48372  \u49324 \u50629 \u51060  \u47560 \u52824 \u44256  \u51452 \u45784 \u44760 \u49436  \u45817 \u49888 \u51032  \u48177 \u49457 \u51012  \u45936 \u47532 \u47084  \u49464 \u49345 \u51004 \u47196  \u46028 \u50500 \u50724 \u49884 \u44592 \u44620 \u51648  \u49440 \u54252 \u46104 \u50612 \u50556  \u54624  \u51652 \u47532 \u47484  \u47568 \u54644  \u51456 \u45796 . 1844\u45380 \u50640  \u49884 \u51089 \u46108  \u49900 \u54032 \u51008  \u47784 \u46304  \u49324 \u46988 , \u44263  \u49328  \u51088 \u50752  \u51453 \u51008  \u51088 \u51032  \u54032 \u44208 \u51060  \u45149 \u45216  \u46412 \u44620 \u51648  \u51064 \u47448 \u50640 \u44172  \u51452 \u50612 \u51652  \u51008 \u54812 \u51032  \u49884 \u44592 \u44032  \u47560 \u52832  \u46412 \u44620 \u51648  \u44228 \u49549 \u46112  \u44163 \u51060 \u45796 . \u44536 \u47084 \u48064 \u47196  \u49324 \u46988 \u46308 \u51012  \u49900 \u54032 \u50640  \u49444  \u49688  \u51080 \u46020 \u47197  \u51456 \u48708 \u49884 \u53412 \u44592  \u50948 \u54616 \u50668  \u51060  \u44592 \u48324 \u51008  \'93\u54616 \u45208 \u45784 \u51012  \u46160 \u47140 \u50892 \u54616 \u47728  \u44536 \u50640 \u44172  \u50689 \u44305 \u51012  \u46028 \u47532 \u46972 \'85\u54616 \u45720 \u44284  \u46405 \u44284  \u48148 \u45796 \u50752  \u47932 \u46308 \u51032  \u44540 \u50896 \u51012  \u47564 \u46300 \u49888  \u51060 \u47484  \u44221 \u48176 \u54616 \u46972 \'94\u44256  \u44536 \u46308 \u50640 \u44172  \u47749 \u54620 \u45796 . \u51060  \u44592 \u48324 \u51012  \u48155 \u50500 \u46308 \u51064  \u44208 \u44284 \u44032  \u45796 \u51020 \u51032  \u47568 \u50432 \u50640  \u51452 \u50612 \u51256  \u51080 \u45796 . \'93\u54616 \u45208 \u45784 \u51032  \u44228 \u47749 \u44284  \u50696 \u49688  \u48127 \u51020 \u51012  \u51648 \u53412 \u45716  \u51088 \'94\u46308 \u51060  \u50668 \u44592  \u51080 \u45208 \u45768 . \u49900 \u54032 \u50640  \u49444  \u51456 \u48708 \u47484  \u54616 \u44592  \u50948 \u54616 \u50668  \u49324 \u46988 \u46308 \u51008  \u54616 \u45208 \u45784 \u51032  \u44228 \u47749 \u51012  \u51648 \u53020 \u50556  \u54624  \u54596 \u50836 \u44032  \u51080 \u45796 . \u44536  \u44228 \u47749 \u51008  \u49900 \u54032 \u51032  \u46412 \u50640  \u54408 \u49457 \u51032  \u54364 \u51456 \u51060  \u46112  \u44163 \u51060 \u45796 . \u49324 \u46020  \u48148 \u50872 \u51008  \'93\u47924 \u47495  \u50984 \u48277 \u51060  \u51080 \u44256  \u48276 \u51396 \u54620  \u51088 \u45716  \u50984 \u48277 \u51004 \u47196  \u47568 \u48120 \u50516 \u50500  \u49900 \u54032 \u51012  \u48155 \u51004 \u47532 \u46972 \'85\u44263 \'85\u54616 \u45208 \u45784 \u51060  \u50696 \u49688  \u44536 \u47532 \u49828 \u46020 \u47196  \u47568 \u48120 \u50516 \u50500  \u49324 \u46988 \u46308 \u51032  \u51008 \u48128 \u54620  \u44163 \u51012  \u49900 \u54032 \u54616 \u49884 \u45716  \u44536 \u45216 \u51060 \u46972 \'94\u44256  \u47568 \u54620 \u45796 . \u44536 \u47532 \u44256  \u44536 \u45716  \'93\u50984 \u48277 \u51012  \u54665 \u54616 \u45716  \u51088 \u46972 \u50556  \u51032 \u47213 \u45796  \u54616 \u49900 \u51012  \u50619 \u51004 \u47532 \'94 (\u47212  2:12~16) \u46972 \u44256  \u47568 \u54620 \u45796 . \u44536 \u47088 \u45936  \u54616 \u45208 \u45784 \u51032  \u44228 \u47749 \u51012  \u51648 \u53412 \u47140 \u47732  \u48127 \u51020 \u51060  \u54596 \u50836 \u54616 \u45796 . \u50780 \u45264 \u54616 \u47732  \'93\u48127 \u51020 \u51060  \u50630 \u51060 \u45716  \u44592 \u49240 \u49884 \u44172  \u47803 \u54616 \u45208 \u45768 \'94 (\u55176  11:6), \'93\u48276 \u49324 \u50640  \u48127 \u51020 \u51004 \u47196  \u50500 \u45768 \u54616 \u45716  \u44163 \u51008  \u51396 \'94 (\u47212  14:23) \u51060 \u44592  \u46412 \u47928 \u51060 \u45796 .\
\uc0\u51064 \u47448 \u45716  \u52395 \u51704  \u52380 \u49324 \u47484  \u53685 \u54616 \u50668  \'93\u54616 \u45208 \u45784 \u51012  \u46160 \u47140 \u50892 \u54616 \u47728  \u44536 \u50640 \u44172  \u50689 \u44305 \u51012  \u46028 \u47532 \'94\u44256  \u51452 \u45784 \u51012  \u52380 \u51648 \u51032  \u52285 \u51312 \u51452 \u47196  \u44221 \u48176 \u54616 \u46972 \u45716  \u47749 \u47161 \u51012  \u48155 \u50520 \u45796 . \u49324 \u46988 \u51060  \u51060  \u51068 \u51012  \u54616 \u47140 \u47732  \u54616 \u45208 \u45784 \u51032  \u44228 \u47749 \u51012  \u51648 \u53020 \u50556  \u54620 \u45796 . \u54788 \u51064 \u51008  \'93\u54616 \u45208 \u45784 \u51012  \u44221 \u50808 \u54616 \u44256  \u44536  \u47749 \u47161 \u51012  \u51648 \u53420 \u51648 \u50612 \u45796  \u51060 \u44163 \u51060  \u49324 \u46988 \u51032  \u48376 \u48516 \u51060 \u45768 \u46972 \'94 (\u51204  12:13) \u44256  \u47568 \u54620 \u45796 . \u54616 \u45208 \u45784 \u51032  \u44228 \u47749 \u51012  \u51648 \u53412 \u51648  \u50500 \u45768 \u54616 \u47732  \u50612 \u46500  \u50696 \u48176 \u47196 \u46020  \u54616 \u45208 \u45784 \u51012  \u44592 \u49240 \u49884 \u44172  \u54624  \u49688  \u50630 \u45796 . \'93\u54616 \u45208 \u45784 \u51012  \u49324 \u46993 \u54616 \u45716  \u44163 \u51008  \u51060 \u44163 \u51060 \u45768  \u50864 \u47532 \u44032  \u44536 \u51032  \u44228 \u47749 \u46308 \u51012  \u51648 \u53412 \u45716  \u44163 \u51060 \u46972 \'94 (\u50836 \u51068  5:3), \'93\u44480 \u47484  \u46028 \u51060 \u53412 \u44256  \u50984 \u48277 \u51012  \u46307 \u51648  \u50500 \u45768 \u54616 \u47732  \u44536 \u51032  \u44592 \u46020 \u46020  \u44032 \u51613 \u54616 \u45768 \u46972 \'94 (\u51104  28:9).\
\uc0\u54616 \u45208 \u45784 \u51012  \u44221 \u48176 \u54624  \u51032 \u47924 \u45716  \u44536 \u48516 \u44760 \u49436  \u52285 \u51312 \u51452 \u44032  \u46104 \u49884 \u47728  \u47564 \u47932 \u51060  \u44536 \u48516  \u46412 \u47928 \u50640  \u51316 \u51116 \u54616 \u44172  \u46104 \u50632 \u45796 \u45716  \u49324 \u49892 \u50640  \u44540 \u44144 \u47484  \u46164 \u45796 . \u49457 \u44221 \u51060  \u54616 \u45208 \u45784 \u44760 \u49436  \u51060 \u48169 \u51032  \u49888 \u46308 \u48372 \u45796  \u45208 \u51004 \u47728  \u51316 \u44221 \u44284  \u50696 \u48176 \u47484  \u48155 \u51004 \u49884 \u44592 \u50640  \u54633 \u45817 \u54620  \u48516 \u51060 \u49900 \u51012  \u44592 \u47197 \u54624  \u46412 \u47560 \u45796  \u48152 \u46300 \u49884  \u44536 \u48516 \u51032  \u52285 \u51312 \u47141 \u51032  \u51613 \u44144 \u47484  \u46308 \u50612  \u47568 \u54620 \u45796 . \'93\u47564 \u48169 \u51032  \u47784 \u46304  \u49888 \u51008  \u54747 \u44163 \u51060 \u50836  \u50668 \u54840 \u50752 \u44760 \u49436 \u45716  \u54616 \u45720 \u51012  \u51648 \u51004 \u49512 \u51020 \u51060 \u47196 \u45796 \'94 (\u49884  96:5). \'93\u44536 \u47088 \u51593  \u45320 \u55148 \u44032  \u45208 \u47484  \u45572 \u44396 \u50640 \u44172  \u48708 \u44592 \u47728  \u45208 \u47196  \u44536 \u50752  \u46041 \u46321 \u51060  \u46104 \u44172  \u54616 \u44192 \u45712 \u45264 \'85\u45320 \u55148 \u45716  \u45576 \u51012  \u45458 \u51060  \u46308 \u50612  \u45572 \u44032  \u51060  \u47784 \u46304  \u44163 \u51012  \u52285 \u51312 \u54616 \u50688 \u45208  \u48372 \u46972 \'94 (\u49324  40:25, 26), \'93\u50668 \u54840 \u50752 \u45716  \u54616 \u45720 \u51012  \u52285 \u51312 \u54616 \u49888  \u54616 \u45208 \u45784 \u51060 \u49884 \u47728 \'85\u45208 \u45716  \u50668 \u54840 \u50752 \u46972  \u45208  \u50808 \u50640  \u45796 \u47480  \u51060 \u44032  \u50630 \u45712 \u45768 \u46972 \'94 (\u49324  45:18). \u46608 \u54620  \u49884 \u54200  \u44592 \u51088 \u45716  \'93\u50668 \u54840 \u50752 \u44032  \u50864 \u47532  \u54616 \u45208 \u45784 \u51060 \u49888  \u51460  \u45320 \u55148 \u45716  \u50508 \u51648 \u50612 \u45796  \u44536 \u45716  \u50864 \u47532 \u47484  \u51648 \u51004 \u49888  \u51088 \u49884 \u50836  \u50864 \u47532 \u45716  \u44536 \u51032  \u44163 \u51060 \u45768 \'94 (\u49884  100:3), \'93\u50724 \u46972  \u50864 \u47532 \u44032  \u44413 \u54784  \u44221 \u48176 \u54616 \u47728  \u50864 \u47532 \u47484  \u51648 \u51004 \u49888  \u50668 \u54840 \u50752  \u50526 \u50640  \u47924 \u47502 \u51012  \u44999 \u51088 \'94 (\u49884  95:6) \u44256  \u47568 \u54620 \u45796 . \u44536 \u47532 \u44256  \u54616 \u45720 \u50640 \u49436  \u54616 \u45208 \u45784 \u51012  \u44221 \u48176 \u54616 \u45716  \u44144 \u47337 \u54620  \u47924 \u47532 \u46308 \u46020  \u54616 \u45208 \u45784 \u44760  \u51316 \u44221 \u51012  \u54364 \u54644 \u50556  \u54624  \u45817 \u50672 \u54620  \u51060 \u50976 \u50640  \u45824 \u54616 \u50668  \'93\u50864 \u47532  \u51452  \u54616 \u45208 \u45784 \u51060 \u50668  \u50689 \u44305 \u44284  \u51316 \u44480 \u50752  \u45733 \u47141 \u51012  \u48155 \u51004 \u49884 \u45716  \u44163 \u51060  \u54633 \u45817 \u54616 \u50724 \u45768  \u51452 \u44760 \u49436  \u47564 \u47932 \u51012  \u51648 \u51004 \u49888 \u51648 \u46972  \u47564 \u47932 \u51060  \u51452 \u51032  \u46907 \u45824 \u47196  \u51080 \u50632 \u44256  \u46608  \u51648 \u51004 \u49900 \u51012  \u48155 \u50520 \u45208 \u51060 \u45796 \'94 (\u44228  4:11) \u44256  \u47568 \u54620 \u45796 .\
