\f1\b0 \cf0 \
16\uc0\u49464 \u44592 \u50640  \u51060 \u47476 \u47084  \u51333 \u44368  \u44060 \u54785 \u51088 \u46308 \u51008  \u50676 \u47536  \u49457 \u44221 \u51012  \u48177 \u49457 \u46308 \u50640 \u44172  \u44277 \u44060 \u54616 \u47728  \u51060 \u47484  \u50976 \u47101  \u44033 \u44397 \u50640  \u48372 \u44553 \u49884 \u53412 \u44592 \u47484  \u55148 \u47581 \u54616 \u50688 \u45796 . \u50612 \u46500  \u45208 \u46972 \u46308 \u51008  \u44536 \u44163 \u51012  \u54616 \u45720 \u50640 \u49436  \u50728  \u49324 \u51088 \u47196  \u44592 \u49244  \u47560 \u51020 \u51004 \u47196  \u54872 \u50689 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u50612 \u46500  \u45208 \u46972 \u46308 \u50640 \u49436 \u45716  \u47196 \u47560 \u44368 \u44032  \u49457 \u44221 \u51060  \u46308 \u50612 \u50724 \u51648  \u47803 \u54616 \u46020 \u47197  \u48169 \u51648 \u54616 \u45716  \u51068 \u50640  \u53360  \u49457 \u44277 \u51012  \u44144 \u46160 \u50632 \u51004 \u48064 \u47196  \u49457 \u44221 \u51032  \u51648 \u49885 \u50640  \u49549 \u54620  \u48731 \u44284  \u44536  \u44256 \u44480 \u54620  \u44048 \u54868 \u47484  \u44144 \u51032  \u48155 \u51648  \u47803 \u54616 \u50688 \u45796 . \u54620  \u45208 \u46972 \u50640 \u45716  \u48731 \u51060  \u46308 \u50612 \u50772 \u51648 \u47564  \u50516 \u55121 \u51004 \u47196  \u51064 \u54616 \u50668  \u44536 \u44163 \u51012  \u44648 \u45803 \u51648  \u47803 \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u50668 \u47084  \u49464 \u44592 \u50640  \u44152 \u52432  \u51652 \u47532 \u50752  \u50724 \u47448 \u44032  \u49436 \u47196  \u51648 \u48176 \u44428 \u51012  \u44054 \u44256 \u51088  \u45796 \u53804 \u50632 \u45796 . \u47560 \u52840 \u45236  \u50501 \u51060  \u49849 \u47532 \u47484  \u50619 \u44256 , \u54616 \u45720 \u51032  \u51652 \u47532 \u45716  \u47932 \u47084 \u45208 \u44172  \u46104 \u50632 \u45796 . \'93\u44536  \u51221 \u51396 \u45716  \u51060 \u44163 \u51060 \u45768  \u44263  \u48731 \u51060  \u49464 \u49345 \u50640  \u50772 \u51004 \u46104  \u49324 \u46988 \u46308 \u51060  \u51088 \u44592  \u54665 \u50948 \u44032  \u50501 \u54616 \u48064 \u47196  \u48731 \u48372 \u45796  \u50612 \u46176 \u51012  \u45908  \u49324 \u46993 \u54620  \u44163 \u51060 \u45768 \u46972 \'94 (\u50836  3:19). \u44536 \u47084 \u48064 \u47196  \u44536  \u45208 \u46972 \u45716  \u51088 \u49888 \u51060  \u53469 \u54620  \u54665 \u50948 \u51032  \u44208 \u44284 \u47484  \u44144 \u46168  \u49688 \u48150 \u50640  \u50630 \u50632 \u45796 . \u50501 \u51012  \u51228 \u51116 \u54616 \u49884 \u45716  \u54616 \u45208 \u45784 \u51032  \u49457 \u47161 \u51008  \u54616 \u45208 \u45784 \u51032  \u51008 \u54812 \u51032  \u49440 \u47932 \u51012  \u47736 \u49884 \u54620  \u48177 \u49457 \u46308 \u47196 \u48512 \u53552  \u46496 \u45208 \u44032  \u48260 \u47160 \u45796 . \u44536 \u47532 \u54616 \u50668  \u50501 \u51008  \u49457 \u49689 \u54644 \u51648 \u44592 \u44620 \u51648  \u48169 \u51076 \u46104 \u50632 \u45796 . \u46300 \u46356 \u50612  \u50728  \u49464 \u44228 \u45716  \u44256 \u51032 \u51201 \u51004 \u47196  \u48731 \u51012  \u44144 \u51208 \u54620  \u44208 \u44284 \u44032  \u50612 \u46496 \u54632 \u51012  \u48372 \u44172  \u46104 \u50632 \u45796 .\
\uc0\u50668 \u47084  \u49464 \u44592  \u46041 \u50504  \u54532 \u46993 \u49828 \u50640 \u49436  \u44228 \u49549 \u54616 \u50668  \u50728  \u49457 \u44221 \u50640  \u45824 \u54620  \u53804 \u51137 \u51008  \u54532 \u46993 \u49828  \u54785 \u47749 \u51004 \u47196  \u44536  \u51208 \u51221 \u51012  \u51060 \u47336 \u50632 \u45796 . \u44536 \u52376 \u47100  \u47924 \u49436 \u50868  \u54785 \u47749 \u51060  \u51068 \u50612 \u45212  \u44163 \u51008  \u47196 \u47560 \u44368 \u44032  \u49457 \u44221 \u51012  \u50613 \u50517 \u54632 \u51004 \u47196  \u52488 \u47000 \u46108  \u45817 \u50672 \u54620  \u44208 \u44284 \u50640  \u48520 \u44284 \u54664 \u45796  (\u48512 \u47197  19 \u52280 \u51312 ). \u44536  \u54785 \u47749 \u51008  \u48277 \u50773 \u44428 \u51032  \u49884 \u52293 \u51060  \u49892 \u52380 \u46108  \u44208 \u44284 \u47484  \u48372 \u50668  \u51452 \u45716  \u44032 \u51109  \u54788 \u51200 \u54620  \u49892 \u47168 \u51060 \u47728 , \u51068 \u52380 \u50668  \u45380  \u51060 \u49345  \u47196 \u47560 \u44368 \u51032  \u44368 \u54984 \u51032  \u44221 \u54693 \u51060  \u47924 \u50631 \u51060 \u50632 \u51020 \u51012  \u48372 \u50668  \u51452 \u45716  \u50696 \u51613 \u51060 \u50632 \u45796 .\
\uc0\u48277 \u50773 \u51060  \u52572 \u49345 \u44428 \u51012  \u51536 \u44256  \u51080 \u45716  \u46041 \u50504 \u50640  \u49457 \u44221 \u51060  \u44552 \u51648 \u46112  \u44163 \u50640  \u44288 \u54616 \u50668  \u49440 \u51648 \u51088 \u46308 \u51008  \u51060 \u48120  \u50696 \u50616 \u54616 \u50688 \u45796 . \u50836 \u54620 \u44228 \u49884 \u47197 \u51032  \u44592 \u51088 \u45716  \'93\u51396 \u50501 \u51032  \u49324 \u46988 \'94\u51032  \u53685 \u52824 \u47196  \u47568 \u48120 \u50516 \u50500  \u53945 \u55176  \u54532 \u46993 \u49828 \u50640 \u49436  \u51068 \u50612 \u45216  \u47924 \u49436 \u50868  \u44208 \u44284 \u47484  \u46608 \u54620  \u51648 \u51201 \u54616 \u44256  \u51080 \u45796 .\
\uc0\u51452 \u45784 \u51032  \u52380 \u49324 \u45716  \u47568 \u54616 \u50688 \u45796 . \'93\u51200 \u55148 \u44032  \u44144 \u47337 \u54620  \u49457 \u51012  \u47560 \u55124 \u46160  \u45804  \u46041 \u50504  \u51667 \u48159 \u51004 \u47532 \u46972  \u45236 \u44032  \u45208 \u51032  \u46160  \u51613 \u51064 \u50640 \u44172  \u44428 \u49464 \u47484  \u51452 \u47532 \u45768  \u51200 \u55148 \u44032  \u44405 \u51008  \u48288 \u50743 \u51012  \u51077 \u44256  \u51068 \u52380 \u51060 \u48177 \u50977 \u49901 \u51068 \u51012  \u50696 \u50616 \u54616 \u47532 \u46972 \'85\u51200 \u55148 \u44032  \u44536  \u51613 \u44144 \u47484  \u47560 \u52832  \u46412 \u50640  \u47924 \u51200 \u44081 \u51004 \u47196 \u48512 \u53552  \u50732 \u46972 \u50724 \u45716  \u51664 \u49849 \u51060  \u51200 \u55148 \u47196  \u45908 \u48520 \u50612  \u51204 \u51137 \u51012  \u51068 \u51004 \u53020  \u51200 \u55148 \u47484  \u51060 \u44592 \u44256  \u51200 \u55148 \u47484  \u51453 \u51068  \u53552 \u51064 \u51593  \u51200 \u55148  \u49884 \u52404 \u44032  \u53360  \u49457  \u44600 \u50640  \u51080 \u51004 \u47532 \u45768  \u44536  \u49457 \u51008  \u50689 \u51201 \u51004 \u47196  \u54616 \u47732  \u49548 \u46036 \u51060 \u46972 \u44256 \u46020  \u54616 \u44256  \u50528 \u44413 \u51060 \u46972 \u44256 \u46020  \u54616 \u45768  \u44263  \u51200 \u55148  \u51452 \u44760 \u49436  \u49901 \u51088 \u44032 \u50640 \u49436  \u47803  \u48149 \u55176 \u49888  \u44275 \u51060 \u45768 \u46972 \'85\u51060  \u46160  \u49440 \u51648 \u51088 \u44032  \u46405 \u50640  \u44144 \u54616 \u45716  \u51088 \u46308 \u51012  \u44340 \u47213 \u44172  \u54620 \u44256 \u47196  \u46405 \u50640  \u44144 \u54616 \u45716  \u51088 \u46308 \u51060  \u51200 \u55148 \u51032  \u51453 \u51020 \u51012  \u51600 \u44144 \u50892 \u54616 \u44256  \u44592 \u48848 \u54616 \u50668  \u49436 \u47196  \u50696 \u47932 \u51012  \u48372 \u45236 \u47532 \u46972  \u54616 \u45908 \u46972  \u49340 \u51068  \u48152  \u54980 \u50640  \u54616 \u45208 \u45784