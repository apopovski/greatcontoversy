\uc0\u44536 \u47084 \u47732  \'93\u51664 \u49849 \u51032  \u50864 \u49345 \'94\u51008  \u47924 \u50631 \u51060 \u47728 , \u44536 \u44163 \u51008  \u50612 \u46523 \u44172  \u47564 \u46308 \u50612 \u51656  \u44163 \u51064 \u44032 ? \u44536 \u44163 \u51008  \u46160  \u49108  \u44032 \u51652  \u51664 \u49849 \u51060  \u47564 \u46308 \u44172  \u46104 \u47728 , \u52376 \u51020  \u51664 \u49849 \u50640  \u45824 \u54620  \u50864 \u49345 \u51060  \u46108 \u45796 . \u44536 \u44163 \u51008  \u46608 \u54620  \'93\u51664 \u49849 \u51032  \u50864 \u49345 \'94\u51060 \u46972 \u44256  \u48520 \u47536 \u45796 . \u44536 \u47088 \u45936  \u51060  \u50864 \u49345 \u51060  \u47924 \u50631 \u51060 \u47728 , \u44536 \u44163 \u51060  \u50612 \u46523 \u44172  \u47564 \u46308 \u50612 \u51648 \u45716 \u51648  \u50508 \u44592  \u50948 \u54616 \u50668  \u50864 \u47532 \u45716  \u47676 \u51200  \u44536  \u51664 \u49849  \u51088 \u52404 , \u44263  \u48277 \u50773 \u44428 \u51032  \u53945 \u51669 \u50640  \u45824 \u54616 \u50668  \u50672 \u44396 \u54616 \u50668 \u50556  \u54620 \u45796 .\
\uc0\u52488 \u45824  \u44368 \u54924 \u44032  \u48373 \u51020 \u51032  \u45800 \u49692 \u54632 \u50640 \u49436  \u46496 \u45208  \u51060 \u44368 \u51032  \u51032 \u49885 \u44284  \u54413 \u49845 \u51012  \u48155 \u50500 \u46308 \u51076 \u51004 \u47196  \u48512 \u54056 \u54616 \u50668 \u51648 \u51088  \u44536  \u44368 \u54924 \u45716  \u49457 \u47161 \u44284  \u54616 \u45208 \u45784 \u51032  \u45733 \u47141 \u51012  \u51075 \u50612 \u48260 \u47160 \u45796 . \u44536 \u47111 \u44172  \u46104 \u51088  \u44536  \u44368 \u54924 \u45716  \u49324 \u46988 \u51032  \u50577 \u49900 \u51012  \u51648 \u48176 \u54616 \u44592  \u50948 \u54616 \u50668  \u49464 \u49549 \u51201  \u44428 \u47141 \u51032  \u46020 \u50880 \u51012  \u44396 \u54616 \u50688 \u45796 . \u44536  \u44208 \u44284 \u47196  \u44397 \u44428 \u51012  \u51648 \u48176 \u54632 \u44284  \u46041 \u49884 \u50640  \u44536  \u44428 \u47141 \u51012  \u51088 \u44592 \u51032  \u47785 \u51201 , \u44263  \u51060 \u47480 \u48148  \u51060 \u45800  \u48149 \u47736 \u51012  \u50948 \u54616 \u50668  \u49324 \u50857 \u54620  \u44368 \u54924 \u51064  \u48277 \u50773 \u44428 \u51060  \u49444 \u47549 \u46104 \u50632 \u45796 . \u54633 \u51473 \u44397 \u51060  \u51664 \u49849 \u51012  \u50948 \u54616 \u50668  \u50864 \u49345 \u51012  \u47564 \u46308 \u47140 \u47732  \u48152 \u46300 \u49884  \u51333 \u44368 \u51201  \u49464 \u47141 \u51060  \u51221 \u48512 \u47484  \u51648 \u48176 \u54616 \u44256  \u44368 \u54924 \u44032  \u44536  \u51088 \u52404 \u51032  \u47785 \u51201 \u51012  \u51060 \u47336 \u44592  \u50948 \u54616 \u50668  \u44397 \u44032 \u51032  \u44428 \u47141 \u51012  \u46608 \u54620  \u49324 \u50857 \u54616 \u44172  \u46104 \u50612 \u50556  \u54620 \u45796 .\
\uc0\u44368 \u54924 \u44032  \u49464 \u49549 \u51201  \u44428 \u49464 \u47484  \u51105 \u51012  \u46412 \u50640 \u45716  \u50616 \u51228 \u45208  \u44536  \u44428 \u49464 \u47484  \u51088 \u44592  \u44368 \u47532 \u47484  \u48152 \u45824 \u54616 \u45716  \u51088 \u47484  \u52376 \u48268 \u54616 \u45716  \u45936  \u49324 \u50857 \u54616 \u50688 \u45796 . \u49464 \u49345 \u51032  \u44428 \u47141 \u44284  \u50556 \u54633 \u54616 \u50668  \u47196 \u47560 \u44368 \u44032  \u44036  \u44600 \u51012  \u46384 \u46972 \u44036  \u44060 \u49888 \u44368 \u54924 \u46308 \u51008  \u50577 \u49900 \u51032  \u51088 \u50976 \u47484  \u51228 \u54620 \u54616 \u47140 \u45716  \u50976 \u49324 \u54620  \u50837 \u47581 \u51012  \u45208 \u53440 \u45236  \u50772 \u45796 . \u50689 \u44397  \u44397 \u44368 \u54924 \u44032  \u50724 \u47019 \u46041 \u50504  \u44228 \u49549 \u54616 \u50668  \u51088 \u44592  \u44368 \u54924 \u47484  \u48152 \u45824 \u54616 \u45716  \u51088 \u46308 \u51012  \u48149 \u54644 \u54620  \u44163 \u51008  \u44536 \u44163 \u50640  \u45824 \u54620  \u54620  \u44032 \u51648  \u49892 \u47168 \u44032  \u46108 \u45796 . \u49892 \u47196  16, 17\u49464 \u44592  \u46041 \u50504 \u50640  \u44397 \u44368 \u46020 \u44032  \u50500 \u45772  \u47924 \u49688 \u54620  \u51204 \u46020 \u51088 \u46308 \u51008  \u44536 \u46308 \u51032  \u49548 \u49549  \u44368 \u54924 \u47484  \u46496 \u45208 \u51648  \u50506 \u51012  \u49688  \u50630 \u44172  \u46104 \u50632 \u51004 \u47728 , \u47785 \u49324 \u45208  \u51068 \u48152  \u49888 \u46020 \u47484  \u47561 \u47200 \u54616 \u44256  \u44284 \u47308 , \u53804 \u50725 , \u44256 \u47928 , \u49692 \u44368 \u47484  \u45817 \u54616 \u44172  \u46104 \u50632 \u45796 .\
\uc0\u52488 \u45824  \u44368 \u54924 \u44032  \u49464 \u49345  \u51221 \u48512 \u51032  \u46020 \u50880 \u51012  \u44396 \u54620  \u44163 \u51008  \u48176 \u44368 \u50688 \u51004 \u47728  \u44536 \u44163 \u51060  \u51664 \u49849 , \u44263  \u48277 \u50773 \u44428 \u51060  \u48156 \u51204 \u46104 \u45716  \u44600 \u51012  \u47560 \u47144 \u54616 \u50688 \u45796 . \u48148 \u50872 \u51008  \'93\u47676 \u51200  \u48176 \u46020 \u54616 \u45716  \u51068 \u51060  \u51080 \u44256  \u51200  \u48520 \u48277 \u51032  \u49324 \u46988  \u44263  \u47736 \u47581 \u51032  \u50500 \u46308 \u51060  \u45208 \u53440 \u45208 \u44592  \u51204 \u50640 \u45716  \u51060 \u47476 \u51648  \u50500 \u45768 \u54616 \u47532 \'94 (\u49332 \u54980  2:3) \u46972 \u44256  \u47568 \u54616 \u50688 \u45796 . \u44536 \u50752  \u44057 \u51060  \u44368 \u54924  \u50504 \u50640 \u49436  \u51068 \u50612 \u45208 \u45716  \u48176 \u46020 \u44032  \u51664 \u49849 \u51032  \u50864 \u49345 \u51012  \u47564 \u46300 \u45716  \u44600 \u51012  \u51456 \u48708 \u54616 \u44172  \u46112  \u44163 \u51060 \u45796 .\
