\uc0\u44536 \u50752  \u44057 \u51008  \u51068 \u46308 \u51060  \u49457 \u44221 \u49345  \u54924 \u44060 \u50752  \u49457 \u54868 \u51032  \u50676 \u47588 \u51060 \u45796 . \u44536 \u47084 \u45208  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277  \u44032 \u50868 \u45936  \u48157 \u54784 \u51652  \u51032 \u51032  \u53360  \u50896 \u52825 \u51012  \u51068 \u48152  \u44536 \u47532 \u49828 \u46020 \u44368 \u44228 \u50640 \u49436  \u47588 \u50864  \u46321 \u54620 \u55176  \u50668 \u44592 \u44172  \u46104 \u50632 \u51004 \u48064 \u47196  \u51060 \u47084 \u54620  \u44208 \u44284 \u45716  \u50500 \u51452  \u46300 \u47932 \u44172  \u48380  \u49688 \u48150 \u50640  \u50630 \u45796 . \u51060 \u44163 \u51060  \u48148 \u47196  \u51068 \u52237 \u51060  \u49888 \u50521  \u48512 \u55141 \u51032  \u53945 \u51669 \u51060  \u46104 \u50632 \u45912  \u54616 \u45208 \u45784 \u51032  \u49457 \u47161 \u51032  \u49900 \u50724 \u54616 \u44256  \u50689 \u49549 \u51201 \u51064  \u50669 \u49324 \u47484  \u44144 \u51032  \u48380  \u49688  \u50630 \u45716  \u51060 \u50976 \u51060 \u45796 .\
\uc0\u50864 \u47532 \u45716  \u48148 \u46972 \u48388 \u51004 \u47196 \u50024  \u48320 \u54868 \u46108 \u45796 . \u49324 \u46988 \u46308 \u51060  \u54616 \u45208 \u45784 \u44760 \u49436  \u44536 \u48516 \u51032  \u54408 \u49457 \u51032  \u50756 \u51204 \u54616 \u49900 \u44284  \u44144 \u47337 \u54616 \u49900 \u51012  \u49324 \u46988 \u46308 \u50640 \u44172  \u48157 \u55176  \u48372 \u50668 \u51452 \u49888  \u44144 \u47337 \u54620  \u50896 \u52825 \u46308 \u51012  \u47924 \u49884 \u54616 \u44256  \u49324 \u46988 \u46308 \u51032  \u44368 \u54984 \u44284  \u51060 \u47200 \u50640  \u51665 \u52265 \u54624  \u46412  \u44368 \u54924  \u50504 \u50640 \u49436  \u49328  \u44221 \u44148 \u49457 \u51012  \u51075 \u50612 \u48260 \u47532 \u45716  \u44208 \u44284 \u44032  \u52488 \u47000 \u46104 \u45716  \u51068 \u51008  \u52280 \u51004 \u47196  \u45440 \u46972 \u50868  \u51068 \u51060 \u45796 . \u51452 \u45784 \u44760 \u49436 \u45716  \'93\u45236  \u48177 \u49457 \u51060 \'85\u49373 \u49688 \u51032  \u44540 \u50896 \u46104 \u45716  \u45208 \u47484  \u48260 \u47536  \u44163 \u44284  \u49828 \u49828 \u47196  \u50885 \u45929 \u51060 \u47484  \u54032  \u44163 \u51064 \u45936  \u44536 \u44163 \u51008  \u47932 \u51012  \u51200 \u52629 \u52824  \u47803 \u54624  \u53552 \u51652  \u50885 \u45929 \u51060 \u45768 \u46972 \'94 (\u47128  2:13) \u44256  \u47568 \u50432 \u54616 \u49512 \u45796 .\
\'93\uc0\u48373  \u51080 \u45716  \u49324 \u46988 \u51008  \u50501 \u51064 \u51032  \u44928 \u47484  \u51335 \u51648  \u50500 \u45768 \u54616 \u47728 \'85\u50724 \u51649  \u50668 \u54840 \u50752 \u51032  \u50984 \u48277 \u51012  \u51600 \u44144 \u50892 \u54616 \u50668  \u44536  \u50984 \u48277 \u51012  \u51452 \u50556 \u47196  \u47925 \u49345 \u54616 \u45716  \u51088 \u47196 \u45796  \u51200 \u45716  \u49884 \u45255 \u44032 \u50640  \u49900 \u51008  \u45208 \u47924 \u44032  \u49884 \u51208 \u51012  \u51335 \u50500  \u44284 \u49892 \u51012  \u47610 \u51004 \u47728  \u44536  \u51086 \u49324 \u44480 \u44032  \u47560 \u47476 \u51648  \u50500 \u45768 \u54632 \u44057 \u51004 \u45768  \u44536  \u54665 \u49324 \u44032  \u45796  \u54805 \u53685 \u54616 \u47532 \u47196 \u45796 \'94 (\u49884  1:1~3). \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51060  \u45796 \u49884  \u44536  \u51221 \u45817 \u54620  \u50948 \u52824 \u47484  \u54924 \u48373 \u54624  \u46412 \u50640 \u47564  \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u51060 \u46972 \u44256  \u44277 \u50616 \u54616 \u45716  \u49324 \u46988 \u46308  \u49324 \u51060 \u50640 \u49436  \u52488 \u45824  \u44368 \u54924 \u44032  \u44032 \u51276 \u45912  \u48127 \u51020 \u44284  \u44221 \u44148 \u51032  \u48512 \u55141 \u51060  \u51068 \u50612 \u45216  \u49688  \u51080 \u45796 . \'93\u50668 \u54840 \u50752 \u44760 \u49436  \u51060 \u44057 \u51060  \u47568 \u50432 \u54616 \u49884 \u46104  \u45320 \u55148 \u45716  \u44600 \u50640  \u49436 \u49436  \u48372 \u47728  \u50715 \u51201  \u44600  \u44263  \u49440 \u54620  \u44600 \u51060  \u50612 \u46356 \u51064 \u51648  \u50508 \u50500 \u48372 \u44256  \u44536 \u47532 \u47196  \u54665 \u54616 \u46972  \u45320 \u55148  \u49900 \u47161 \u51060  \u54217 \u44053 \u51012  \u50619 \u51004 \u47532 \u46972 \'94 (\u47128  6:16).\
