\f0\b \cf0 \uc0\u51228 \u45348 \u48148 \u51032  \u52860 \u48712 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u44536  \u45796 \u51020 \u50640  \u53469 \u54632 \u51012  \u51077 \u51008  \u49324 \u46988 \u51008  \u45908 \u50865  \u48708 \u52380 \u54620  \u49324 \u46988 \u51060 \u50632 \u45796 . \u44536  \u51210 \u51008 \u51060 \u45716  \u45320 \u47924 \u46020  \u48380 \u54408 \u51060  \u50630 \u50632 \u44592  \u46412 \u47928 \u50640  \u44060 \u54785  \u49324 \u50629 \u51032  \u46041 \u47308 \u46308 \u51060 \u46972 \u44256  \u44277 \u50616 \u54616 \u45716  \u49324 \u46988 \u46308 \u50640 \u44172 \u47560 \u51200 \u46020  \u45257 \u45812 \u54620  \u52712 \u44553 \u51012  \u48155 \u50520 \u45796 . \u54028 \u47120 \u46020  \u44144 \u51208 \u51012  \u45817 \u54620  \u44536  \u49457 \u51021 \u50640 \u49436  \u44536 \u47088  \u51064 \u47932 \u51060  \u47924 \u50631 \u51012  \u54624  \u49688  \u51080 \u50632 \u51012 \u44620 ? \u44032 \u51109  \u44053 \u54616 \u44256  \u44032 \u51109  \u50857 \u44048 \u54620  \u49324 \u46988 \u46020  \u54588 \u54644  \u44040  \u49688 \u48150 \u50640  \u50630 \u50632 \u45912  \u44536  \u49457 \u51021 \u50640 \u49436  \u50857 \u44592 \u47196 \u45208  \u44221 \u54744 \u51004 \u47196 \u45208  \u48712 \u50557 \u54620  \u44536 \u50752  \u44057 \u51008  \u51064 \u47932 \u51060  \u50612 \u46523 \u44172  \u44204 \u46364  \u49688  \u51080 \u50632 \u51012 \u44620 ? \'93\u51060 \u45716  \u55192 \u51004 \u47196  \u46104 \u51648  \u50500 \u45768 \u54616 \u47728  \u45733 \u51004 \u47196  \u46104 \u51648  \u50500 \u45768 \u54616 \u44256  \u50724 \u51649  \u45208 \u51032  \u49888 \u51004 \u47196  \u46104 \u45712 \u45768 \u46972 \'94 (\u49829  4:6). \'93\u54616 \u45208 \u45784 \u44760 \u49436  \u49464 \u49345 \u51032  \u48120 \u47144 \u54620  \u44163 \u46308 \u51012  \u53469 \u54616 \u49324  \u51648 \u54812  \u51080 \u45716  \u51088 \u46308 \u51012  \u48512 \u45124 \u47101 \u44172  \u54616 \u47140  \u54616 \u49884 \u44256  \u49464 \u49345 \u51032  \u50557 \u54620  \u44163 \u46308 \u51012  \u53469 \u54616 \u49324  \u44053 \u54620  \u44163 \u46308 \u51012  \u48512 \u45124 \u47101 \u44172  \u54616 \u47140  \u54616 \u49884 \u47728 \'94, \'93\u54616 \u45208 \u45784 \u51032  \u48120 \u47144 \u54620  \u44163 \u51060  \u49324 \u46988 \u48372 \u45796  \u51648 \u54812  \u51080 \u44256  \u54616 \u45208 \u45784 \u51032  \u50557 \u54620  \u44163 \u51060  \u49324 \u46988 \u48372 \u45796  \u44053 \u54616 \u45768 \u46972 \'94 (\u44256 \u51204  1:27, 25).\
\uc0\u54532 \u47196 \u47704 \u53944  (Froment) \u45716  \u44368 \u49324 \u47196 \u49436  \u51068 \u51012  \u49884 \u51089 \u54616 \u50688 \u45796 . \u44536 \u44032  \u54617 \u44368 \u50640 \u49436  \u50500 \u51060 \u46308 \u50640 \u44172  \u44032 \u47476 \u52828  \u51652 \u47532 \u47484  \u50500 \u51060 \u46308 \u51008  \u51665 \u50640 \u49436  \u45796 \u49884  \u51060 \u50556 \u44592 \u54616 \u50688 \u45796 . \u50620 \u47560  \u54980  \u54617 \u48512 \u54805 \u46308 \u51060  \u49457 \u44221 \u51032  \u44053 \u54644  (\u35611 \u35299 ) \u47484  \u46308 \u51004 \u47084  \u50724 \u44172  \u46104 \u50632 \u45716 \u45936  \u50676 \u49900 \u51004 \u47196  \u44480 \u47484  \u44592 \u50872 \u51060 \u45716  \u49324 \u46988 \u46308 \u47196  \u44368 \u49892 \u51060  \u47560 \u52840 \u45236  \u52264 \u44256  \u45336 \u52452 \u45796 . \u49888 \u50557  \u49457 \u44221 \u44284  \u51204 \u46020 \u50857  \u49548 \u52293 \u51088 \u46308 \u51060  \u47566 \u51060  \u48176 \u48512 \u46104 \u50632 \u51004 \u47728 , \u44536 \u44163 \u46308 \u51008  \u49352  \u44368 \u47532 \u47484  \u44277 \u44277 \u50672 \u54616 \u44172  \u46308 \u51004 \u47084  \u50724 \u51648  \u47803 \u54620  \u47566 \u51008  \u49324 \u46988 \u46308 \u51032  \u49552 \u50640  \u46308 \u50612 \u44052 \u45796 . \u50620 \u47560  \u54980 \u50640  \u44536  \u51204 \u46020 \u51088  \u50669 \u49884  \u54588 \u54644  \u44032 \u51648  \u50506 \u51012  \u49688  \u50630 \u44172  \u46104 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44536 \u44032  \u44032 \u47476 \u52828  \u51652 \u47532 \u45716  \u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u50640  \u44618 \u51060  \u48149 \u54784  \u51080 \u50632 \u45796 . \u44060 \u54785  \u49324 \u50629 \u51032  \u50472 \u45716  \u49100 \u47140 \u51276 \u44256 , \u44228 \u49549 \u54644 \u49436  \u53948 \u53948 \u54616 \u44172  \u54869 \u51109 \u46104 \u50612  \u44052 \u45796 . \u51204 \u46020 \u51088 \u46308 \u51008  \u46028 \u50500 \u50772 \u51004 \u47728 , \u44536 \u46308 \u51032  \u45432 \u47141 \u51012  \u53685 \u54616 \u50668  \u44060 \u49888 \u44368 \u51032  \u49324 \u50629 \u51008  \u47560 \u52840 \u45236  \u51228 \u45348 \u48148 \u50640 \u49436  \u44204 \u44256 \u54644 \u51276 \u45796 .\
\uc0\u51228 \u45348 \u48148 \u44032  \u51060 \u48120  \u44060 \u54785  \u49324 \u50629 \u51012  \u49440 \u50616 \u54620  \u54980 \u50640 \u50556  \u52860 \u48712 \u51008  \u44033 \u52376 \u47196  \u50976 \u46993 \u54616 \u50668  \u50668 \u47084  \u44032 \u51648  \u44221 \u54744 \u51012  \u44202 \u44256  \u44536  \u49457 \u51021 \u50640  \u46308 \u50612 \u50772 \u45796 . \u44536 \u45716  \u51088 \u44592 \u44032  \u52636 \u49373 \u54620  \u44256 \u54693 \u51012  \u47560 \u51648 \u47561 \u51004 \u47196  \u48169 \u47928 \u54616 \u44256  \u48148 \u51236  (Basel) \u47196  \u44032 \u45716  \u46020 \u51473 \u51060 \u50632 \u45796 . \u44536 \u47088 \u45936  \u44256 \u54693 \u51004 \u47196  \u44032 \u45716  \u51649 \u47196 \u44032  \u52852 \u50508  5\u49464 \u51032  \u44400 \u45824 \u50640 \u44172  \u51216 \u47161 \u45817 \u54616 \u44256  \u51080 \u45716  \u44163 \u51012  \u50508 \u44172  \u46108  \u44536 \u45716  \u48520 \u44032 \u48520  \u51228 \u45348 \u48148 \u47484  \u44144 \u52432 \u49436  \u46028 \u50500 \u44032 \u45716  \u44600 \u51012  \u53469 \u54624  \u49688 \u48150 \u50640  \u50630 \u50632 \u45796 .\
\uc0\u44536 \u51032  \u48169 \u47928 \u51008  \u54616 \u45208 \u45784 \u51032  \u49453 \u47532 \u50688 \u45796 \u44256  \u54028 \u47120 \u51008  \u51064 \u51221 \u54616 \u50688 \u45796 . \u48708 \u47197  \u51228 \u45348 \u48148 \u44032  \u44060 \u54785 \u51452 \u51032 \u51032  \u49888 \u50521 \u51012  \u48155 \u50500 \u46308 \u51060 \u44592 \u45716  \u54616 \u50688 \u51648 \u47564  \u44536  \u44275 \u50640 \u45716  \u50500 \u51649 \u46020  \u49457 \u52712 \u46104 \u50612 \u50556  \u54624  \u53360  \u49324 \u50629 \u51060  \u45224 \u50500  \u51080 \u50632 \u45796 . \u49324 \u46988 \u51060  \u54924 \u44060 \u54616 \u50668  \u54616 \u45208 \u45784 \u44760 \u47196  \u46028 \u50500 \u50724 \u45716  \u44163 \u51008  \u44060 \u51064 \u51201 \u51064  \u51068 \u51060 \u47728  \u45800 \u52404 \u51201 \u51004 \u47196  \u46104 \u45716  \u51068 \u51008  \u50500 \u45768 \u45796 . \u51473 \u49373  (\u37325 \u29983 ) \u51032  \u49324 \u50629 \u51008  \u54924 \u51032 \u51032  \u47749 \u47161 \u51004 \u47196  \u46104 \u45716  \u44163 \u51060  \u50500 \u45768 \u46972  \u49457 \u47161 \u51032  \u44428 \u45733 \u51004 \u47196  \u47560 \u51020 \u44284  \u50577 \u49900  \u49549 \u50640 \u49436  \u51060 \u47336 \u50612 \u51256 \u50556  \u54620 \u45796 . \u51228 \u45348 \u48148 \u51032  \u51452 \u48124 \u46308 \u51008  \u47196 \u47560 \u44368 \u51032  \u44428 \u47141 \u50640 \u49436 \u45716  \u48279 \u50612 \u45228 \u51648 \u47564  \u47196 \u47560 \u44368 \u51032  \u53685 \u52824  \u54616 \u50640  \u47564 \u50672 \u46104 \u50612  \u51080 \u45716  \u50501 \u51008  \u49789 \u49324 \u47532  \u48260 \u47532 \u51648  \u47803 \u54616 \u50688 \u45796 . \u44536 \u47084 \u48064 \u47196  \u44536 \u44275 \u50640  \u48373 \u51020 \u51032  \u49692 \u44208 \u54620  \u50896 \u52825 \u51012  \u54869 \u47549 \u54616 \u44256  \u49324 \u46988 \u46308 \u47196  \u54616 \u50668 \u44552  \u54616 \u45208 \u45784 \u51032  \u48512 \u47476 \u49884 \u45716  \u51649 \u50948 \u47484  \u54988 \u47469 \u54616 \u44172  \u44048 \u45817 \u54616 \u45716  \u51068 \u51008  \u44208 \u53076  \u50857 \u51060 \u54620  \u51068 \u51060  \u50500 \u45768 \u50632 \u45796 .\
\uc0\u54028 \u47120 \u51008  \u52860 \u48712 \u51060  \u44536  \u49324 \u50629 \u51012  \u50948 \u54616 \u50668  \u51088 \u44592 \u50752  \u54801 \u47141 \u54624  \u49688  \u51080 \u45716  \u49324 \u46988 \u51076 \u51012  \u54869 \u49888 \u54616 \u50688 \u45796 . \u44536 \u45716  \u54616 \u45208 \u45784 \u51032  \u51060 \u47492 \u51004 \u47196  \u44536  \u52397 \u45380  \u51204 \u46020 \u51088 \u50640 \u44172  \u44536  \u44275 \u50640  \u47672 \u47932 \u47084  \u51068 \u54616 \u46972 \u44256  \u51221 \u51473 \u55176  \u44036 \u52397 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u52860 \u48712 \u51008  \u46160 \u47140 \u50868  \u47560 \u51020 \u51004 \u47196  \u44536  \u51068 \u51012  \u49324 \u50577 \u54616 \u50688 \u45796 . \u44161 \u51060  \u47566 \u44256  \u54217 \u54868 \u47484  \u49324 \u46993 \u54616 \u45716  \u44536 \u45716  \u50857 \u44048 \u54616 \u44256  \u46021 \u47549 \u49900 \u51060  \u44053 \u54616 \u44256  \u44284 \u44201 \u54620  \u49457 \u51656 \u51012  \u44032 \u51652  \u51228 \u45348 \u48148  \u49324 \u46988 \u46308 \u44284  \u51217 \u52489 \u54616 \u44592 \u47484  \u46160 \u47140 \u50892 \u54616 \u50688 \u45796 . \u52380 \u49457 \u51201 \u51004 \u47196  \u50672 \u44396 \u50640  \u47792 \u46160 \u54616 \u44592 \u47484  \u51339 \u50500 \u54616 \u50688 \u51012  \u49104 \u47564  \u50500 \u45768 \u46972  \u44148 \u44053 \u46020  \u51339 \u51648  \u47803 \u54616 \u50688 \u51004 \u48064 \u47196  \u44536 \u45716  \u51312 \u50857 \u54620  \u44275 \u51012  \u52286 \u50500 \u44032 \u44172  \u46104 \u50632 \u45796 . \u44536 \u45716  \u44544 \u47196 \u50024  \u44060 \u54785  \u49324 \u50629 \u50640  \u52572 \u49440 \u44751  \u48393 \u49324 \u54624  \u49688  \u51080 \u51004 \u47532 \u46972 \u44256  \u48127 \u51008  \u45208 \u47672 \u51648  \u50672 \u44396 \u50640  \u47792 \u46160 \u54624  \u49688  \u51080 \u45716  \u54620 \u51201 \u54620  \u44275 \u51004 \u47196  \u47932 \u47084 \u44032 \u49436  \u51064 \u49604 \u47932 \u51012  \u53685 \u54616 \u50668  \u44368 \u54924 \u47484  \u44032 \u47476 \u52824 \u44256  \u49464 \u50892  \u45208 \u44032 \u44256 \u51088  \u55148 \u47581 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u54028 \u47120 \u51032  \u50628 \u49689 \u54620  \u44428 \u44256 \u45716  \u54616 \u45720 \u50640 \u49436  \u50728  \u49548 \u47749 \u52376 \u47100  \u45712 \u44788 \u51276 \u51004 \u48064 \u47196  \u44536 \u45716  \u44048 \u55176  \u44536 \u44163 \u51012  \u44144 \u51208 \u54616 \u51648  \u47803 \u54616 \u50688 \u45796 . \u44536 \u45716  \'93\u54616 \u45208 \u45784 \u51032  \u49552 \u51060  \u54616 \u45720 \u50640 \u49436  \u45236 \u47140 \u50752 \u49436  \u51088 \u44592 \u47484  \u48537 \u46308 \u44256  \u51088 \u44592 \u44032  \u54588 \u54616 \u50668  \u44032 \u47140 \u45716  \u44536  \u51109 \u49548 \u50640  \u50613 \u51648 \u47196  \u51452 \u51200 \u50505 \u44172  \u54620  \u44163 \'94 (D\'92Aubigne, b.9, ch.17) \u52376 \u47100  \u45712 \u44808 \u45796 \u44256  \u47568 \u54616 \u50688 \u45796 .\
