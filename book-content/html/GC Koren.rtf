\uc0\u51068 \u48152 \u51201 \u51004 \u47196  \u44368 \u54924  \u50504 \u50640  \u51080 \u45716  \u44216 \u49552 \u54616 \u44256  \u54732 \u49888 \u51201 \u51064  \u49324 \u46988 \u46308 \u51060  \u47676 \u51200  \u44592 \u48324 \u51012  \u48155 \u50520 \u45796 . \u49457 \u44221 \u51012  \u49828 \u49828 \u47196  \u50672 \u44396 \u54620  \u49324 \u46988 \u46308 \u51008  \u50696 \u50616 \u50640  \u45824 \u54620  \u51068 \u48152 \u51201 \u51064  \u44204 \u54644 \u44032  \u49457 \u44221 \u51201 \u51060  \u50500 \u45768 \u46972 \u45716  \u49324 \u49892 \u51012  \u44648 \u45804 \u51012  \u49688 \u48150 \u50640  \u50630 \u50632 \u45796 . \u50612 \u46356 \u49436 \u45208  \u51068 \u48152  \u49457 \u51649 \u51088 \u46308 \u51032  \u50689 \u54693 \u51012  \u48155 \u51648  \u50506 \u51008  \u44275 \u50640 \u49436 \u45716 , \u44536 \u47532 \u44256  \u50612 \u46356 \u50640 \u49436 \u45208  \u49457 \u44221  \u47568 \u50432 \u51012  \u49828 \u49828 \u47196 \u51032  \u55192 \u51004 \u47196  \u50672 \u44396 \u54620  \u44275 \u50640 \u49436 \u45716  \u51116 \u47548 \u51032  \u44368 \u47532 \u44032  \u54616 \u45208 \u45784 \u51032  \u44428 \u50948  \u50948 \u50640  \u49464 \u50892 \u51652  \u44368 \u47532 \u51076 \u51012  \u49457 \u44221 \u51208 \u46308 \u51012  \u48708 \u44368  \u44160 \u53664 \u54632 \u51004 \u47196  \u50508 \u44172  \u46104 \u50632 \u45796 .\
\uc0\u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u49888 \u50521  \u50630 \u45716  \u54805 \u51228 \u46308 \u50640 \u44172  \u48149 \u54644 \u47484  \u48155 \u50520 \u45796 . \u50612 \u46500  \u49324 \u46988 \u46308 \u51008  \u44368 \u54924 \u50640 \u49436 \u51032  \u51648 \u50948 \u47484  \u48372 \u51204 \u54616 \u44592  \u50948 \u54616 \u50668  \u44536 \u46308 \u51032  \u49888 \u50521 \u51012  \u47568 \u54616 \u51648  \u50506 \u51008  \u51088 \u46020  \u51080 \u50632 \u45796 . \u44536 \u47084 \u45208  \u54616 \u45208 \u45784 \u44760  \u52649 \u49457 \u46108  \u49324 \u46988 \u46308 \u51008  \u44536 \u46308 \u50640 \u44172  \u47585 \u44200 \u51652  \u51652 \u47532 \u47484  \u49704 \u44200 \u49436 \u45716  \u50504  \u46108 \u45796 \u44256  \u49373 \u44033 \u54664 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u47532 \u49828 \u46020 \u51032  \u51116 \u47548 \u51012  \u48127 \u45716 \u45796 \u44256  \u44256 \u48177 \u54620  \u51060 \u50976 \u47564 \u51004 \u47196  \u44368 \u54924 \u50640 \u49436  \u51228 \u47749  \u52376 \u48516 \u51012  \u48155 \u51008  \u49324 \u46988 \u46308 \u51060  \u51201 \u51648  \u50500 \u45768 \u54616 \u50688 \u45796 . \u51088 \u44592 \u51032  \u49888 \u50521 \u51012  \u50948 \u54616 \u50668  \u49884 \u47144 \u51012  \u48155 \u45716  \u49324 \u46988 \u46308 \u50640 \u44172  \'93\u45320 \u55148 \u47484  \u48120 \u50892 \u54616 \u47728  \u45236  \u51060 \u47492 \u51012  \u51064 \u54616 \u50668  \u45320 \u55148 \u47484  \u51923 \u50500 \u45236 \u47728  \u51060 \u47476 \u44592 \u47484  \u50668 \u54840 \u50752 \u44760 \u49436 \u45716  \u50689 \u44305 \u51012  \u45208 \u53440 \u45236 \u49324  \u45320 \u55148  \u44592 \u49256 \u51012  \u50864 \u47532 \u50640 \u44172  \u48372 \u51060 \u49884 \u44592 \u47484  \u50896 \u54616 \u45432 \u46972  \u54616 \u50688 \u51004 \u45208  \u44536 \u46308 \u51008  \u49688 \u52824 \u47484  \u45817 \u54616 \u47532 \u46972 \'94 (\u49324  66:5) \u44256  \u54620  \u49440 \u51648 \u51088 \u51032  \u47568 \u50432 \u51008  \u47588 \u50864  \u44480 \u51473 \u54620  \u44163 \u51060 \u50632 \u45796 .\
\uc0\u54616 \u45208 \u45784 \u51032  \u52380 \u49324 \u46308 \u51008  \u44032 \u51109  \u44618 \u51008  \u44288 \u49900 \u51012  \u44032 \u51648 \u44256  \u44536  \u44221 \u44256 \u51032  \u44208 \u44284 \u47484  \u51452 \u47785 \u54616 \u44256  \u51080 \u50632 \u45796 . \u52380 \u49324 \u46308 \u51008  \u44536  \u44592 \u48324 \u51060  \u47784 \u46304  \u44368 \u54924 \u47196 \u48512 \u53552  \u51068 \u48152 \u51201 \u51004 \u47196  \u44144 \u51208 \u51012  \u45817 \u54624  \u46412 \u50640  \u49836 \u54536  \u47560 \u51020 \u51004 \u47196  \u47932 \u47084 \u44052 \u45796 . \u44536 \u47084 \u45208  \u51116 \u47548 \u51032  \u51652 \u47532 \u47484  \u50500 \u51649  \u47579 \u48372 \u51648  \u47803 \u54620  \u51088 \u46308 \u51060  \u47566 \u51060  \u51080 \u50632 \u45796 . \u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u45224 \u54200 , \u50500 \u45236 , \u48512 \u47784 , \u54841 \u51008  \u51088 \u45376 \u46308 \u50640 \u44172  \u48120 \u54841 \u46104 \u50612  \u51116 \u47548 \u49888 \u46020 \u46308 \u51032  \u44032 \u47476 \u52840 , \u49548 \u50948  \u51060 \u45800 \u50640  \u44480 \u47484  \u44592 \u50872 \u51060 \u45716  \u44163 \u47564 \u46020  \u48268 \u50024  \u51396 \u47484  \u48276 \u54616 \u45716  \u51068 \u51064  \u44163 \u52376 \u47100  \u48127 \u44172  \u46104 \u50632 \u45796 . \u52380 \u49324 \u46308 \u51008  \u44536 \u47088  \u49324 \u46988 \u46308 \u51012  \u49457 \u49892 \u54616 \u44172  \u51452 \u47785 \u54616 \u46972 \u45716  \u47749 \u47161 \u51012  \u48155 \u50520 \u45796 . \u50780 \u45264 \u54616 \u47732  \u54616 \u45208 \u45784 \u51032  \u48372 \u51340 \u47196 \u48512 \u53552  \u46608  \u45796 \u47480  \u48731 \u51060  \u45208 \u50752 \u49436  \u44536 \u46308 \u51012  \u48708 \u52628 \u51068  \u44163 \u51060 \u50632 \u44592  \u46412 \u47928 \u51060 \u45796 .\
