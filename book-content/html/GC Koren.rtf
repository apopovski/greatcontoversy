\f1\b0 \cf0 \
\uc0\u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u48520 \u49888 \u44284  \u48152 \u50669 \u51004 \u47196  \u47560 \u51020 \u51060  \u50756 \u50501 \u54616 \u50668 \u51256 \u49436  \u54616 \u45208 \u45784 \u51032  \u48372 \u51025 \u51032  \u54805 \u48268 \u51012  \u51116 \u52489 \u54616 \u44256  \u51080 \u45716  \u51060  \u49464 \u49345 \u51012  \u50696 \u47336 \u49332 \u47128 \u51060  \u49345 \u51669 \u54616 \u44256  \u51080 \u51020 \u51012  \u48372 \u49512 \u45796 . \u53440 \u46973 \u54620  \u51064 \u47448 \u51032  \u49888 \u51020  \u49548 \u47532 \u45716  \u44536 \u48516 \u51032  \u47560 \u51020 \u51012  \u50500 \u54532 \u44172  \u54616 \u50668  \u44256 \u48124 \u51032  \u48512 \u47476 \u51670 \u51020 \u51060  \u44536 \u48516 \u51032  \u51077 \u50640 \u49436  \u49352 \u50612 \u45208 \u50724 \u44172  \u54616 \u50688 \u45796 . \u44536 \u48516 \u44760 \u49436 \u45716  \u51064 \u47448 \u51032  \u48520 \u54665 \u44284  \u45576 \u47932 \u44284  \u54588  \u55128 \u47532 \u45716  \u51068 \u50640 \u49436  \u51396 \u51032  \u44592 \u47197 \u51012  \u48372 \u49512 \u44256 , \u49464 \u49345 \u50640 \u49436  \u44340 \u47196 \u50892 \u54616 \u44256  \u44256 \u53685 \u45817 \u54616 \u45716  \u51088 \u46308 \u51012  \u47924 \u54620 \u55176  \u46041 \u51221 \u54616 \u49512 \u45796 . \u44536 \u48516 \u44760 \u49436 \u45716  \u51060  \u47784 \u46304  \u49324 \u46988 \u46308 \u51012  \u44396 \u50896 \u54616 \u49884 \u44256 \u51088  \u44040 \u47581 \u54616 \u49512 \u45796 . \u44536 \u47084 \u45208  \u44536 \u48516 \u51032  \u49552 \u51004 \u47196 \u46020  \u51064 \u47448 \u51032  \u51200 \u51452 \u51032  \u47932 \u44208 \u51012  \u47932 \u47532 \u52832  \u49688  \u50630 \u50632 \u45796 . \u50780 \u45264 \u54616 \u47732  \u44263  \u51064 \u47448 \u51032  \u50976 \u51068 \u54620  \u46020 \u50880 \u51032  \u44540 \u50896 \u51060 \u49888  \u44536 \u48516 \u51012  \u52286 \u50500  \u44396 \u54616 \u45716  \u51088 \u44032  \u51201 \u50632 \u44592  \u46412 \u47928 \u51060 \u50632 \u45796 . \u44536 \u48516 \u44760 \u49436 \u45716  \u49324 \u46988 \u46308 \u50640 \u44172  \u44396 \u50896 \u51012  \u51452 \u49884 \u47140 \u44256  \u45817 \u49888 \u51032  \u50689 \u54844 \u51012  \u51600 \u44144 \u50868  \u47560 \u51020 \u51004 \u47196  \u51453 \u51020 \u50640  \u45236 \u50612  \u51452 \u44256 \u51088  \u54616 \u49512 \u51648 \u47564  \u49373 \u47749 \u51012  \u50619 \u44592  \u50948 \u54616 \u50668  \u44536 \u48516 \u44760 \u47196  \u45208 \u50724 \u45716  \u51088 \u46308 \u51008  \u48324 \u47196  \u50630 \u50632 \u45796 .\
\uc0\u54616 \u45720 \u51032  \u45824 \u51452 \u51116 \u44760 \u49436  \u45576 \u47932 \u51012  \u55128 \u47532 \u49884 \u45796 \u45768 ! \u47924 \u54620 \u54616 \u49888  \u54616 \u45208 \u45784 \u51032  \u50500 \u46308 \u44760 \u49436  \u47560 \u51020 \u50640  \u44540 \u49900 \u54616 \u49884 \u44256  \u44256 \u45516 \u50640  \u45580 \u47532 \u49884 \u45796 \u45768 ! \u44536  \u44305 \u44221 \u51012  \u48372 \u44256  \u50728  \u54616 \u45720 \u51008  \u45440 \u46992 \u45796 . \u44536  \u44305 \u44221 \u51008  \u51396 \u44032  \u50620 \u47560 \u45208  \u49324 \u50501 \u54620  \u44163 \u51076 \u51012  \u50864 \u47532 \u50640 \u44172  \u48372 \u50668  \u51452 \u44256 , \u51204 \u45733 \u54616 \u49888  \u48516 \u50640 \u44172  \u51080 \u50612 \u49436 \u46020  \u51396 \u51064 \u51012  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51012  \u44648 \u46888 \u47536  \u44208 \u44284 \u50640 \u49436  \u44396 \u50896 \u54644 \u45236 \u44592 \u44032  \u50620 \u47560 \u45208  \u50612 \u47140 \u50868  \u51068 \u51064 \u51648  \u45208 \u53440 \u45236  \u51456 \u45796 . \u50696 \u49688 \u45784 \u44760 \u49436 \u45716  \u47560 \u51648 \u47561  \u49884 \u45824 \u47484  \u45236 \u45796 \u48372 \u49884 \u44256  \u50696 \u47336 \u49332 \u47128 \u51012  \u47736 \u47581 \u51004 \u47196  \u51060 \u45132 \u50612  \u44036  \u44536  \u44057 \u51008  \u49549 \u51076 \u49688 \u50640  \u50728  \u49464 \u44228 \u44032  \u49549 \u50500  \u45336 \u50612 \u44032 \u44256  \u51080 \u45716  \u44163 \u51012  \u48372 \u49512 \u45796 . \u50976 \u45824 \u51064 \u51032  \u53360  \u51396 \u45716  \u44536 \u47532 \u49828 \u46020 \u47484  \u48176 \u52377 \u54616 \u45716  \u44163 \u51060 \u50632 \u44256 , \u44536 \u47532 \u49828 \u46020 \u44368 \u44228 \u51032  \u53360  \u51396 \u45716  \u52380 \u51648 \u47484  \u45796 \u49828 \u47532 \u45716  \u54616 \u45208 \u45784  \u51221 \u48512 \u51032  \u44592 \u52488 \u44032  \u46104 \u45716  \u50984 \u48277 \u51012  \u48176 \u52377 \u54616 \u45716  \u44163 \u51060  \u46112  \u44163 \u51060 \u45796 . \u50668 \u54840 \u50752 \u51032  \u44228 \u47749 \u51008  \u47736 \u49884 \u48155 \u44256  \u47924 \u49884 \u45817 \u54624  \u44163 \u51060 \u45796 . \u51396 \u50640  \u49549 \u48149 \u46104 \u50612  \u49324 \u45800 \u51032  \u51333 \u51060  \u46108  \u47924 \u49688 \u54620  \u51088 \u46308 \u51060  \u46168 \u51704  \u49324 \u47581 \u51012  \u48155 \u51012  \u50868 \u47749 \u50640  \u45459 \u50668  \u51080 \u51004 \u47732 \u49436 \u46020  \u44428 \u44256  (\u30519 \u39015 ) \u54616 \u49884 \u45716  \u45216 \u50640  \u51652 \u47532 \u51032  \u47568 \u50432 \u50640  \u44480 \u47484  \u44592 \u50872 \u51060 \u47140 \u44256  \u54616 \u51648  \u50506 \u51012  \u44163 \u51060 \u45796 . \u52280 \u51004 \u47196  \u45440 \u46972 \u50868  \u47609 \u47785  (\u30450 \u30446 ) \u51060 \u50836 , \u51060 \u54644 \u54624  \u49688  \u50630 \u45716  \u51068 \u51060 \u45796 .\
\uc0\u50976 \u50900 \u51208  \u51060 \u53952  \u51204  \u50976 \u45824  \u44288 \u50896 \u46308 \u51032  \u50948 \u49440 \u51012  \u51656 \u52293 \u54616 \u49888  \u54980  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u47560 \u51648 \u47561 \u51004 \u47196  \u49457 \u51204 \u51012  \u46496 \u45208 \u49884 \u44256  \u45796 \u49884  \u51228 \u51088 \u46308 \u44284  \u54632 \u44760  \u44048 \u46988 \u49328 \u50640  \u50732 \u46972  \u50696 \u47336 \u49332 \u47128 \u51060  \u45236 \u47140 \u45796 \u48372 \u51060 \u45716  \u54400 \u48173 \u50640  \u50505 \u51004 \u49512 \u45796 . \u44536 \u48516 \u44760 \u49436 \u45716  \u45796 \u49884  \u54620  \u48264  \u44536  \u49457 \u51032  \u49457 \u48317 \u44284  \u53457 \u46308 \u44284  \u44417 \u51204 \u46308 \u51012  \u45236 \u47140 \u45796 \u48372 \u49512 \u45796 . \u44536 \u47532 \u44256  \u45796 \u49884  \u54620  \u48264  \u44144 \u47337 \u54620  \u49328  \u50948 \u50640  \u50500 \u47492 \u45813 \u44172  \u50864 \u46749  \u49440 , \u45576 \u48512 \u49884 \u44172  \u52268 \u46976 \u54620 , \u48120 \u51032  \u50773 \u44288 \u51064  \u44536  \u49457 \u51204 \u51012  \u48148 \u46972 \u48372 \u49512 \u45796 .\
