\uc0\u44144 \u44592 \u45716  \u46608 \u54620  \u44536 \u47532 \u49828 \u46020 \u51032  \u45824 \u49324 \u46308 \u51060 \u46972 \u44256  \u44277 \u50616 \u54616 \u47732 \u49436  \u54616 \u45208 \u45784  \u48177 \u49457 \u46308 \u51032  \u50577 \u49900 \u51012  \u51648 \u48176 \u54616 \u44592  \u50948 \u54616 \u50668  \u44256 \u47928 \u45824 , \u53804 \u50725 , \u54868 \u54805 \u51452  \u46321 \u51012  \u49324 \u50857 \u54620  \u48277 \u50773 \u44368 \u51032  \u49849 \u47140 \u46308 \u44284  \u51452 \u44368 \u46308 \u51060  \u51080 \u45796 . \u54616 \u45208 \u45784 \u48372 \u45796  \u51088 \u49888 \u51012  \u45458 \u51060 \u44256  \u51648 \u44537 \u55176  \u45458 \u51004 \u49888  \u48516 \u51032  \u50984 \u48277 \u51012  \u48320 \u44060 \u54616 \u44256 \u51088  \u54620  \u44368 \u47564 \u54620  \u48277 \u50773 \u46308 \u46020  \u44144 \u44592 \u50640  \u51080 \u45796 . \u51060  \u44144 \u51667 \u46108  \u44368 \u54924 \u51032  \u44368 \u48512 \u46308 \u51008  \u54616 \u45208 \u45784  \u50526 \u50640  \u48520 \u44032 \u48520  \u52397 \u49328 \u54644 \u50556  \u54624  \u51068 \u51060  \u51080 \u45796 . \u44536 \u46308 \u51008  \u51204 \u51648 \u54616 \u49888  \u54616 \u45208 \u45784 \u44760 \u49436  \u45817 \u49888 \u51032  \u50984 \u48277 \u50640  \u52280 \u51004 \u47196  \u47560 \u51020 \u51012  \u47566 \u51060  \u50416 \u49884 \u44256  \u44536  \u50984 \u48277 \u51012  \u48276 \u54620  \u51088 \u47484  \u44208 \u53076  \u47924 \u51396 \u54620  \u44163 \u51004 \u47196  \u44036 \u51452 \u54616 \u51648  \u50506 \u51004 \u49888 \u45796 \u45716  \u49324 \u49892 \u51012  \u45320 \u47924  \u45734 \u44172  \u44648 \u45803 \u45716 \u45796 . \u44536 \u46308 \u51008  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u45817 \u49888 \u51032  \u44256 \u45212 \u45817 \u54616 \u49888  \u48177 \u49457 \u46308 \u44284  \u47560 \u51020 \u51012  \u44057 \u51060  \u54616 \u49888 \u45796 \u45716  \u44163 \u51012  \u44648 \u45803 \u45716 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \