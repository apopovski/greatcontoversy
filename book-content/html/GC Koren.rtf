\uc0\u48513 \u48120  \u54633 \u51473 \u44397 \u51032  \u54732 \u48277 \u51008  \u50577 \u49900 \u51032  \u51088 \u50976 \u47484  \u48372 \u51109 \u54620 \u45796 . \u44536 \u48372 \u45796  \u45908  \u44480 \u51473 \u54616 \u44256  \u44540 \u48376 \u51201 \u51064  \u44163 \u51008  \u50630 \u45796 . \u44536 \u47088 \u45936  \u48277 \u50773  \u54588 \u50864 \u49828  9\u49464 \u45716  1854\u45380  8\u50900  15\u51068 \u51088 \u51032  \u46041 \u47928  \u53685 \u45804  (\u21516 \u25991 \u36890 \u36948 ) \u50640 \u49436  \'91\u50577 \u49900 \u51032  \u51088 \u50976 \u47484  \u50745 \u54840 \u54620 \u45796 \u45716  \u48520 \u54633 \u47532 \u54616 \u44256  \u44536 \u47495 \u46108  \u44368 \u47532 \u45208  \u54747 \u49548 \u47532 \u45716  \u44032 \u51109  \u50976 \u54644 \u54620  \u50724 \u47448 \u47196 \u49436  \u54620  \u44397 \u44032 \u50640  \u51080 \u50612 \u49436  \u50612 \u46500  \u45796 \u47480  \u44163 \u48372 \u45796  \u44032 \u51109  \u46160 \u47140 \u50868  \u54644 \u47484  \u45180 \u52824 \u45716  \u44163 \u51060 \u45796 \'92\u44256  \u47568 \u54616 \u50688 \u45796 . \u46608 \u54620  \u44536  \u48277 \u50773 \u51008  1864\u45380  12\u50900  8\u51068 \u48512 \u51032  \u46041 \u47928  \u53685 \u45804 \u50640 \u49436  \'91\u50577 \u49900 \u44284  \u50696 \u48176 \u51032  \u51088 \u50976 \u47484  \u51452 \u51109 \u54616 \u45716  \u51088 \'92\u50752  \u46608 \u54620  \'91\u44368 \u54924 \u44032  \u54253 \u47141 \u51012  \u50416 \u51648  \u47568  \u44163 \u51060 \u46972 \u44256  \u51452 \u51109 \u54616 \u45716  \u47784 \u46304  \u51088 \u46308 \'92\u51012  \u51200 \u51452 \u54616 \u50688 \u45796 .\
