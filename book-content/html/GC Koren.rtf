\uc0\u50501 \u51064 \u51032  \u49900 \u54032 \u51008  \u52395 \u51704 \u50752  \u46168 \u51704  \u48512 \u54876  \u49324 \u51060 \u50640  \u51080 \u45716  \u51068 \u52380  \u45380 \u44036 \u50640  \u51060 \u47336 \u50612 \u51652 \u45796 . \u49324 \u46020  \u48148 \u50872 \u51008  \u51060  \u49900 \u54032 \u51060  \u51116 \u47548  \u46244 \u50640  \u51080 \u51012  \u49324 \u44148 \u51076 \u51012  \u51648 \u51201 \u54620 \u45796 . \'93\u44536 \u47084 \u48064 \u47196  \u46412 \u44032  \u51060 \u47476 \u44592  \u51204  \u44263  \u51452 \u44760 \u49436  \u50724 \u49884 \u44592 \u44620 \u51648  \u50500 \u47924 \u44163 \u46020  \u54032 \u45800 \u54616 \u51648  \u47568 \u46972  \u44536 \u44032  \u50612 \u46176 \u50640  \u44048 \u52628 \u51064  \u44163 \u46308 \u51012  \u46300 \u47084 \u45236 \u44256  \u47560 \u51020 \u51032  \u46907 \u51012  \u45208 \u53440 \u45236 \u49884 \u47532 \'94 (\u44256 \u51204  4:5) \u46972 . \u45796 \u45768 \u50648 \u51008  \u50715 \u51201 \u48512 \u53552  \u54637 \u49345  \u44228 \u49888  \u48516 \u51060  \u50724 \u49492 \u49436  \'93\u51648 \u44537 \u55176  \u45458 \u51004 \u49888  \u51088 \u51032  \u49457 \u46020 \u47484  \u50948 \u54616 \u50668  \u49888 \u50896 \u54616 \u49512 \'94 (\u45800  7:22) \u45796 \u44256  \u47568 \u54620 \u45796 . \u51060 \u46412 \u50640  \u51032 \u51064 \u46308 \u51008  \u50773 \u51060  \u46104 \u44256 , \u54616 \u45208 \u45784 \u51032  \u51228 \u49324 \u51109 \u51060  \u46108 \u45796 . \u50836 \u54620 \u44228 \u49884 \u47197 \u50640 \u49436  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u54620 \u45796 . \'93\u46608  \u45236 \u44032  \u48372 \u51340 \u46308 \u51012  \u48372 \u45768  \u44144 \u44592  \u50505 \u51008  \u51088 \u46308 \u51060  \u51080 \u50612  \u49900 \u54032 \u54616 \u45716  \u44428 \u49464 \u47484  \u48155 \u50520 \u45908 \u46972 \'94, \'93\u44536 \u46308 \u51060  \u54616 \u45208 \u45784 \u44284  \u44536 \u47532 \u49828 \u46020 \u51032  \u51228 \u49324 \u51109 \u51060  \u46104 \u50612  \u52380  \u45380  \u46041 \u50504  \u44536 \u47532 \u49828 \u46020 \u47196  \u45908 \u48520 \u50612  \u50773 \u45432 \u47495  \u54616 \u47532 \u46972 \'94 (\u44228  20:4, 6). \u48148 \u50872 \u51060  \'93\u49457 \u46020 \u44032  \u49464 \u49345 \u51012  \u54032 \u45800 \u54624  \u44163 \u51012  \u45320 \u55148 \u44032  \u50508 \u51648  \u47803 \u54616 \u45712 \u45264 \'94 (\u44256 \u51204  6:2) \u44256  \u50696 \u50616 \u54620  \u47568 \u51008  \u51060 \u46412 \u47484  \u51648 \u51201 \u54620 \u45796 . \u44536 \u46308 \u51008  \u44536 \u47532 \u49828 \u46020 \u50752  \u54632 \u44760  \u50501 \u54620  \u51088 \u46308 \u51012  \u49900 \u54032 \u54616 \u44256 , \u50984 \u48277 \u51204  (\u63960 \u27861 \u20856 ) \u44263  \u49457 \u44221 \u50640  \u48708 \u52628 \u50612  \u44536 \u46308 \u51032  \u54665 \u50948 \u47484  \u51312 \u49324 \u54616 \u50668  \u50977 \u49888 \u51032  \u54665 \u50948 \u50640  \u46384 \u46972  \u47784 \u46304  \u49324 \u44148 \u51012  \u44208 \u51221 \u54624  \u44163 \u51060 \u45796 . \u44536 \u47532 \u44256  \u44536  \u54665 \u50948 \u47484  \u46384 \u46972  \u50501 \u54620  \u51088 \u44032  \u48155 \u50500 \u50556  \u54624  \u54805 \u48268 \u51060  \u51221 \u54644 \u51256 \u49436  \u49324 \u47581 \u52293 \u50640  \u51080 \u45716  \u44536 \u46308 \u51032  \u51060 \u47492  \u50500 \u47000  \u44592 \u47197 \u46108 \u45796 .\
\uc0\u46608 \u54620  \u49324 \u45800 \u44284  \u50501 \u54620  \u52380 \u49324 \u46308  \u50669 \u49884  \u44536 \u47532 \u49828 \u46020 \u50752  \u44536 \u48516 \u51032  \u48177 \u49457 \u46308 \u50640 \u44172  \u49900 \u54032 \u51012  \u48155 \u45716 \u45796 . \u48148 \u50872 \u51008  \'93\u50864 \u47532 \u44032  \u52380 \u49324 \u47484  \u54032 \u45800 \u54624  \u44163 \u51012  \u45320 \u55148 \u44032  \u50508 \u51648  \u47803 \u54616 \u45712 \u45264 \'94 (\u44256 \u51204  6:3) \u44256  \u47568 \u54620 \u45796 . \u44536 \u47532 \u44256  \u50976 \u45796 \u45716  \'93\u51088 \u44592  \u51648 \u50948 \u47484  \u51648 \u53412 \u51648  \u50500 \u45768 \u54616 \u44256  \u51088 \u44592  \u52376 \u49548 \u47484  \u46496 \u45212  \u52380 \u49324 \u46308 \u51012  \u53360  \u45216 \u51032  \u49900 \u54032 \u44620 \u51648  \u50689 \u50896 \u54620  \u44208 \u48149 \u51004 \u47196  \u55121 \u50516 \u50640  \u44032 \u46160 \u49512 \'94 (\u50976  6) \u45796 \u44256  \u51452 \u51109 \u54620 \u45796 .\
\uc0\u51068 \u52380  \u45380 \u51060  \u45149 \u45208 \u47732  \u46168 \u51704  \u48512 \u54876 \u51060  \u51080 \u51012  \u44163 \u51060 \u45796 . \u44536  \u46412 \u50640  \u50501 \u51064 \u46308 \u51008  \u49324 \u47581 \u50640 \u49436  \u51068 \u50612 \u45208  \u54616 \u45208 \u45784  \u50526 \u50640  \u45208 \u53440 \u45208 \u49436  \u44592 \u47197 \u46108  \u54032 \u44208 \u45824 \u47196  \u54805 \u48268 \u51012  \u48155 \u44172  \u46112  \u44163 \u51060 \u45796 . \u44536 \u47084 \u48064 \u47196  \u50836 \u54620 \u44228 \u49884 \u47197 \u51032  \u44592 \u51088 \u45716  \u51032 \u51064 \u51032  \u48512 \u54876 \u50640  \u45824 \u54620  \u44592 \u47197 \u51012  \u47560 \u52828  \u54980 , \'93\u44536  \u45208 \u47672 \u51648  \u51453 \u51008  \u51088 \u46308 \u51008  \u44536  \u52380  \u45380 \u51060  \u52264 \u44592 \u44620 \u51648  \u49332 \u51648  \u47803 \u54616 \u45908 \u46972 \'94 (\u44228  20:5) \u44256  \u47568 \u54620 \u45796 . \u51060 \u49324 \u50556 \u45716  \u50501 \u51064 \u46308 \u50640 \u44172  \u44288 \u54616 \u50668 , \'93\u44536 \u46308 \u51060  \u51396 \u49688 \u44032  \u44618 \u51008  \u50725 \u50640  \u47784 \u51020 \u44057 \u51060  \u47784 \u51020 \u51012  \u51077 \u44256  \u50725 \u50640  \u44039 \u54804 \u45796 \u44032  \u50668 \u47084  \u45216  \u54980 \u50640  \u54805 \u48268 \u51012  \u48155 \u51012  \u44163 \u51060 \u46972 \'94 (\u49324  24:22) \u44256  \u51452 \u51109 \u54620 \u45796 .\
