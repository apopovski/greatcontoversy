\f1\b0 \cf0 \
\uc0\u54532 \u46993 \u49828 \u50640 \u49436  \u44144 \u51208 \u54620  \u54217 \u54868 \u51032  \u48373 \u51020 \u51008  \u48516 \u47749 \u55176  \u49100 \u47532 \u44620 \u51648  \u48977 \u54804 \u51648 \u47560 \u45716  \u44536  \u44208 \u44284 \u45716  \u46608 \u54620  \u47924 \u49436 \u50868  \u44163 \u51060  \u46112  \u44163 \u51060 \u50632 \u45796 . \u54532 \u46993 \u49828 \u44032  \u44060 \u54785 \u51088 \u46308 \u51012  \u50756 \u51204 \u55176  \u48149 \u54644 \u54616 \u44592 \u47196  \u54620  \u48148 \u47196  \u44536 \u45216 \u48512 \u53552  258\u45380 \u51060  \u51648 \u45212  1793\u45380  1\u50900  21\u51068 \u50640 \u45716  \u51204 \u50672  \u45796 \u47480  \u47785 \u51201 \u51004 \u47196  \u46608  \u54616 \u45208 \u51032  \u45796 \u47480  \u54665 \u47148 \u51060  \u54028 \u47532  \u49884 \u47484  \u53685 \u44284 \u54616 \u50688 \u45796 . \'93\u45796 \u49884  \u50773 \u51060  \u51452 \u50836 \u54620  \u51064 \u47932 \u47196  \u46321 \u51109 \u54616 \u50688 \u44256 , \u45796 \u49884  \u49548 \u46041 \u44284  \u48512 \u47476 \u51670 \u51020 \u51060  \u51068 \u50612 \u45228 \u44256 , \u45796 \u49884  \u45908 \u50865  \u47566 \u51008  \u55148 \u49373 \u51088 \u46308 \u51012  \u50836 \u44396 \u54616 \u45716  \u49548 \u47532 \u44032  \u46308 \u47160 \u44256 , \u45796 \u49884  \u44160 \u51008  \u45800 \u46160 \u45824 \u44032  \u49436 \u44172  \u46104 \u50632 \u45796 . \u45796 \u49884 \u44552  \u44536 \u45216 \u51032  \u54876 \u44537 \u51008  \u47924 \u49436 \u50868  \u49324 \u54805  \u51665 \u54665 \u51004 \u47196  \u45149 \u51012  \u47610 \u50632 \u45796 . \u47336 \u51060  16\u49464 \u45716  \u44036 \u49688 \u50752  \u49324 \u54805  \u51665 \u54665 \u51088 \u46308  \u49324 \u51060 \u50640 \u49436  \u47800 \u48512 \u47548 \u51012  \u52824 \u47732 \u49436  \u45800 \u46160 \u45824  \u50526 \u51004 \u47196  \u45132 \u47140 \u44032 \u49436  \u46020 \u45180 \u44032  \u45236 \u47140 \u50724 \u44592 \u44620 \u51648  \u48537 \u46308 \u47140  \u51080 \u50632 \u45796 . \u47560 \u52840 \u45236  \u51096 \u47140 \u51652  \u44536 \u51032  \u47672 \u47532 \u45716  \u45800 \u46160 \u45824  \u50948 \u50640 \u49436  \u44404 \u47104 \u45796 \'94 (Wylie, b.13, ch.21). \u54588 \u51032  \u55148 \u49373  \u51228 \u47932 \u51060  \u46108  \u44163 \u51008  \u50773 \u47564 \u51060  \u50500 \u45768 \u50632 \u45796 . \u54588 \u48708 \u47536 \u45236 \u45208 \u45716  \u44277 \u54252  \u49884 \u45824  \u46041 \u50504 \u50640  \u48148 \u47196  \u44536  \u44540 \u48169 \u50640 \u49436  \u45800 \u46160 \u45824 \u50640  \u51032 \u54616 \u50668  \u52376 \u54805 \u46108  \u49324 \u46988 \u51008  2\u52380 8\u48177  \u47749 \u51060 \u45208  \u46104 \u50632 \u45796 .\
\uc0\u51333 \u44368 \u44060 \u54785 \u51008  \u49464 \u49345  \u49324 \u46988 \u46308 \u50640 \u44172  \u49457 \u44221 \u51012  \u54196 \u49436  \u48372 \u50668  \u51452 \u44256 , \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51012  \u44277 \u44060 \u54616 \u44256 , \u44536  \u50836 \u44396 \u47484  \u49324 \u46988 \u46308 \u51032  \u50577 \u49900 \u50640  \u54840 \u49548 \u54616 \u50688 \u45796 . \u47924 \u54620 \u54620  \u49324 \u46993 \u51012  \u44032 \u51648 \u49888  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u49324 \u46988 \u46308 \u50640 \u44172  \u54616 \u45720 \u51032  \u48277 \u44508 \u50752  \u50896 \u52825 \u51012  \u44277 \u44060 \u54616 \u50668  \u51452 \u49512 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \'93\u45320 \u55148 \u45716  \u51648 \u53020  \u54665 \u54616 \u46972  \u44536 \u47532 \u54632 \u51008  \u50676 \u44397  \u50526 \u50640  \u45320 \u55148 \u51032  \u51648 \u54812 \u50836  \u45320 \u55148 \u51032  \u51648 \u49885 \u51060 \u46972  \u44536 \u46308 \u51060  \u51060  \u47784 \u46304  \u44508 \u47168 \u47484  \u46307 \u44256  \u51060 \u47476 \u44592 \u47484  \u51060  \u53360  \u45208 \u46972  \u49324 \u46988 \u51008  \u44284 \u50672  \u51648 \u54812 \u50752  \u51648 \u49885 \u51060  \u51080 \u45716  \u48177 \u49457 \u51060 \u47196 \u45796  \u54616 \u47532 \u46972 \'94 (\u49888  4:6) \u44256  \u47568 \u50432 \u54616 \u49512 \u45796 . \u54532 \u46993 \u49828 \u45716  \u54616 \u45720 \u47196 \u48512 \u53552  \u50728  \u49440 \u47932 \u51012  \u44144 \u51208 \u54632 \u51004 \u47196  \u47924 \u51221 \u48512  \u49345 \u53468 \u50752  \u47736 \u47581 \u51032  \u50472 \u47484  \u49100 \u47160 \u44256 , \u44536  \u54596 \u50672 \u51201 \u51064  \u44208 \u44284 \u47196  \u54785 \u47749 \u44284  \u44277 \u54252  \u49884 \u45824 \u47484  \u44144 \u46160 \u50632 \u45796 .\
