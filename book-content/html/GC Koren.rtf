\uc0\u51652 \u47532 \u44032  \u51204 \u54644 \u51664 \u51004 \u47196  \u51088 \u50976 \u47484  \u44221 \u54744 \u54616 \u44172  \u46112  \u46412 , \u49324 \u46988 \u46308 \u51008  \u54616 \u45208 \u45784 \u44760 \u49436  \u50724 \u47448 \u50752  \u48120 \u49888 \u51032  \u49632 \u49324 \u49836 \u51012  \u45130 \u50612  \u48260 \u47532 \u44592  \u50948 \u54616 \u50668  \u49324 \u50857 \u54616 \u49888  \u44536  \u51064 \u47932 \u46308 \u51012  \u52268 \u53444 \u54616 \u45716  \u44221 \u54693 \u51012  \u44032 \u51648 \u44592  \u49789 \u45796 . \u49324 \u45800 \u51008  \u49324 \u46988 \u46308 \u51032  \u49324 \u49345 \u44284  \u50528 \u51221 \u51012  \u54616 \u45208 \u45784 \u44760 \u47196 \u48512 \u53552  \u48516 \u47532 \u49884 \u53020 , \u49324 \u46988 \u51012  \u48148 \u46972 \u48372 \u44172  \u54632 \u51004 \u47196  \u46020 \u44396 \u50640  \u48520 \u44284 \u54620  \u49324 \u46988 \u46308 \u51012  \u45458 \u51060  \u50864 \u47084 \u47084 \u48372 \u46020 \u47197  \u50976 \u54841 \u54620 \u45796 . \u44536 \u47532 \u44256  \u50728 \u44054  \u49324 \u44148 \u51032  \u48176 \u54980 \u50640 \u49436  \u51648 \u46020 \u54616 \u49884 \u45716  \u54616 \u45208 \u45784 \u51032  \u49453 \u47532 \u51032  \u49552 \u44600 \u51012  \u47924 \u49884 \u54644  \u48260 \u47532 \u46020 \u47197  \u54620 \u45796 . \u51060 \u47088  \u44221 \u50864 \u50640  \u55124 \u55176  \u52845 \u52268 \u44284  \u51316 \u44221 \u51012  \u48155 \u45716  \u44536  \u51333 \u44368  \u51648 \u46020 \u51088 \u46308 \u51008  \u54616 \u45208 \u45784 \u51012  \u51032 \u51648 \u54644 \u50556  \u54624  \u44163 \u51012  \u51082 \u50612 \u48260 \u47532 \u44256  \u51088 \u49888 \u51012  \u51032 \u51648 \u54616 \u44172  \u46108 \u45796 . \u44536  \u44208 \u44284 \u47196  \u49324 \u46988 \u46308 \u51008  \u51648 \u46020 \u47484  \u48155 \u44592  \u50948 \u54616 \u50668  \u49457 \u44221  \u47568 \u50432 \u51012  \u53456 \u44396 \u54616 \u51648  \u50506 \u44256 , \u51648 \u46020 \u51088 \u46308 \u51012  \u48148 \u46972 \u