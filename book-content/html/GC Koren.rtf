\f0\b \cf0 \uc0\u47336 \u53552 \u50640  \u45824 \u54620  \u49324 \u46988 \u46308 \u51032  \u54980 \u50896 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u47336 \u53552 \u47484  \u54644 \u52824 \u44592  \u50948 \u54620  \u44228 \u54925 \u51060  \u49464 \u50892 \u51256  \u51080 \u45796 \u45716  \u49548 \u47928 \u51060  \u45328 \u47532  \u54140 \u51648 \u44172  \u46104 \u51088  \u50728  \u49884 \u51473 \u50640 \u45716  \u53360  \u55141 \u48516 \u51060  \u51068 \u50612 \u45228 \u45796 . \u44060 \u54785 \u51088 \u50640 \u44172 \u45716  \u47566 \u51008  \u52828 \u44396 \u46308 \u51060  \u51080 \u50632 \u45716 \u45936 , \u44536 \u46308 \u51008  \u47196 \u47560 \u44368 \u44032  \u44536 \u51032  \u48512 \u54056 \u54620  \u54805 \u54200 \u51012  \u54253 \u47196 \u49884 \u53412 \u45716  \u51068 \u50640  \u50857 \u44048 \u54620  \u47784 \u46304  \u49324 \u46988 \u46308 \u50640 \u44172  \u54665 \u54620  \u51092 \u51064 \u47924 \u46020 \u54620  \u51068 \u46308 \u51012  \u50508 \u44256  \u51080 \u51004 \u48064 \u47196  \u44536 \u47484  \u55148 \u49373 \u49884 \u53420  \u49688  \u50630 \u46020 \u47197  \u54644 \u50556  \u54620 \u45796 \u44256  \u51089 \u51221 \u54616 \u50688 \u45796 . \u49688 \u48177  \u47749 \u51032  \u44480 \u51313 \u46308 \u51060  \u44536 \u47484  \u48372 \u54840 \u54616 \u44192 \u45796 \u44256  \u47609 \u49464 \u54616 \u50688 \u45796 . \u51201 \u51648  \u50506 \u51008  \u49324 \u46988 \u46308 \u51060  \u47196 \u47560 \u51032  \u44428 \u47141 \u50640  \u44404 \u48373 \u54624  \u51032 \u49324 \u47484  \u54364 \u49884 \u54620  \u54889 \u51228 \u51032  \u54252 \u44256 \u47484  \u44277 \u44277 \u50672 \u54616 \u44172  \u48708 \u45212 \u54616 \u50688 \u45796 . \u49324 \u44032  (\u31169 \u23478 ) \u51032  \u45824 \u47928 \u46308 \u44284  \u44277 \u51201 \u51064  \u51109 \u49548 \u46308 \u50640 \u45716  \u47336 \u53552 \u47484  \u51221 \u51396 \u54616 \u44144 \u45208  \u44536 \u47484  \u50745 \u54840 \u54616 \u45716  \u44305 \u44256 \u46308 \u51060  \u48537 \u44172  \u46104 \u50632 \u45796 . \u44536 \u51473 \u50640 \u45716  \u49556 \u47196 \u47788 \u51032  \u51032 \u48120 \u49900 \u51109 \u54620  \u47568 , \'93\u50773 \u51008  \u50612 \u47532 \u44256  \u45824 \u49888 \u46308 \u51008  \u50500 \u52840 \u50640  \u50672 \u46973 \u54616 \u45716  \u51060  \u45208 \u46972 \u50668  \u54868 \u44032  \u51080 \u46020 \u45796 \'94 (\u51204  10:16) \u45716  \u47928 \u44396 \u44032  \u50416 \u50668  \u51080 \u44592 \u46020  \u54616 \u50688 \u45796 . \u46021 \u51068  \u51204 \u44397 \u51012  \u53685 \u54616 \u50668  \u51068 \u48152 \u51201 \u51004 \u47196  \u48372 \u44553 \u46104 \u50612  \u51080 \u45716  \u47336 \u53552 \u50640  \u45824 \u54620  \u54840 \u44048 \u51008 , \u47564 \u51068  \u44536 \u50640 \u44172  \u50612 \u46500  \u48520 \u44277 \u54217 \u54620  \u52376 \u49324 \u44032  \u51060 \u47336 \u50612 \u51652 \u45796 \u47732  \u46021 \u51068  \u51228 \u44397 \u51032  \u54217 \u54868 \u45716  \u47932 \u47200 \u51060 \u50836 , \u44536  \u48372 \u51340 \u51032  \u50504 \u51204 \u44620 \u51648 \u46020  \u50948 \u53468 \u47196 \u50892 \u51656  \u44163 \u51060 \u46972 \u45716  \u49324 \u49892 \u51012  \u54889 \u51228 \u50752  \u51032 \u54924 \u45716  \u44648 \u45803 \u44172  \u46104 \u50632 \u45796 .\
\uc0\u51089 \u49468 \u51032  \u54532 \u47532 \u46300 \u47532 \u55176  \u49440 \u54980 \u45716  \u45257 \u51221 \u54620  \u53468 \u46020 \u47196  \u44060 \u54785 \u51088 \u50640 \u44172  \u45824 \u54620  \u51088 \u44592 \u51032  \u51652 \u51221 \u54620  \u44048 \u51221 \u51012  \u51312 \u49900 \u49457  \u51080 \u44172  \u44048 \u52628 \u44256  \u51080 \u50632 \u51004 \u45208 , \u44536 \u45716  \u46041 \u49884 \u50640  \u45128 \u44592  \u51080 \u45716  \u44221 \u44228 \u47196  \u44536 \u47484  \u51648 \u53412 \u44256  \u44536 \u51032  \u47784 \u46304  \u54665 \u46041 \u44284  \u44536 \u51032  \u50896 \u49688 \u46308 \u51032  \u47784 \u46304  \u51068 \u51012  \u51452 \u47785 \u54616 \u44256  \u51080 \u50632 \u45796 . \u44536 \u47084 \u45208  \u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u47336 \u53552 \u50640  \u45824 \u54620  \u44536 \u51032  \u46041 \u51221 \u49900 \u51012  \u44048 \u52628 \u47140 \u44256  \u54616 \u51648  \u50500 \u45768 \u54616 \u50688 \u45796 . \u47336 \u53552 \u45716  \u51228 \u54980 \u46308 \u44284 , \u48177 \u51089  (\u20271 \u29237 ), \u45224 \u51089  (\u30007 \u29237 ) \u46308 \u44284 , \u49457 \u51649 \u51088 \u50752  \u54217 \u49888 \u51088 \u46308  \u51473 \u51032  \u47566 \u51008  \u51316 \u44480 \u54620  \u49324 \u46988 \u46308 \u51032  \u48169 \u47928 \u51012  \u48155 \u50520 \u45796 . \u49828 \u54036 \u46972 \u54004  (Spalatin) \u51008  \'93\u48149 \u49324 \u51032  \u51089 \u51008  \u48169 \u51008  \u52286 \u50500 \u50724 \u45716  \u49552 \u45784 \u46308 \u51012  \u47784 \u46160  \u49688 \u50857 \u54624  \u49688  \u50630 \u50632 \u45796 \'94 (Martyn, vol.1, p.404) \u44256  \u44592 \u47197 \u54616 \u50688 \u45796 .\
\uc0\u49324 \u46988 \u46308 \u51008  \u44536 \u47484  \u47560 \u52824  \u51064 \u44036 \u51012  \u52488 \u50900 \u54620  \u51316 \u51116 \u51064  \u44163 \u52376 \u47100  \u48148 \u46972 \u48372 \u50520 \u45796 . \u48708 \u47197  \u44536 \u51032  \u44368 \u47532 \u47484  \u48127 \u51648  \u50506 \u45716  \u49324 \u46988 \u51068 \u51648 \u46972 \u46020  \u51088 \u44592 \u51032  \u50577 \u49900 \u51012  \u44144 \u49828 \u47476 \u44592 \u48372 \u45796 \u45716  \u52264 \u46972 \u47532  \u51453 \u51020 \u51012  \u45804 \u44172  \u48155 \u44256 \u51088  \u54616 \u45716  \u44536  \u44256 \u44208 \u54620  \u51221 \u49888 \u50640  \u44048 \u53444 \u54616 \u51648  \u50506 \u51012  \u49688  \u50630 \u50632 \u45796 .\
\uc0\u47336 \u53552 \u47196  \u54616 \u50668 \u44552  \u47196 \u47560 \u50752  \u53440 \u54801 \u54616 \u45716  \u51068 \u50640  \u46041 \u51032 \u54616 \u44172  \u54616 \u47140 \u45716  \u47588 \u50864  \u50676 \u47148 \u54620  \u50868 \u46041 \u51060  \u51068 \u50612 \u45228 \u45796 . \u44480 \u51313 \u46308 \u44284  \u49440 \u54980 \u46308 \u51008  \u44536 \u44032  \u51060  \u51060 \u49345  \u45908  \u51088 \u44592  \u51088 \u49888 \u51032  \u44204 \u54644 \u47484  \u44256 \u51665 \u54616 \u44256  \u44368 \u47532 \u50752  \u51032 \u54924 \u47484  \u45824 \u54637 \u54620 \u45796 \u47732  \u44208 \u44397 \u51008  \u51060  \u45208 \u46972 \u50640 \u49436  \u52628 \u48169 \u46112  \u44163 \u51060 \u47728 , \u50500 \u47924 \u47088  \u48372 \u54840 \u46020  \u48155 \u51012  \u49688  \u50630 \u51012  \u44163 \u51060 \u46972 \u44256  \u47568 \u54616 \u50688 \u45796 . \u51060 \u50752  \u44057 \u51008  \u54840 \u49548 \u50640  \u45824 \u54616 \u50668  \u47336 \u53552 \u45716  \u45824 \u45813 \u54616 \u50688 \u45796 . \'93\u44536 \u47532 \u49828 \u46020 \u51032  \u48373 \u51020 \u51008  \u44277 \u44201 \u51012  \u48155 \u51648  \u50506 \u44256  \u51204 \u54028 \u46112  \u49688  \u50630 \u45796 . \'85\u44536 \u47092 \u51652 \u45824  \u50612 \u46523 \u44172  \u44536 \u50752  \u44057 \u51008  \u50948 \u54744 \u50640  \u45824 \u54620  \u46160 \u47140 \u50880 \u51060 \u45208  \u48520 \u50504  \u46412 \u47928 \u50640  \u45236 \u44032  \u50612 \u52236  \u51452 \u45784 \u44760 \u47196 \u48512 \u53552 , \u46608 \u54620  \u50976 \u51068 \u51032  \u51652 \u47532 \u51064  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51004 \u47196 \u48512 \u53552  \u46496 \u45216  \u49688  \u51080 \u44192 \u45716 \u44032 ? \u50500 \u45768 \u45796 . \u45208 \u45716  \u52264 \u46972 \u47532  \u45236  \u50977 \u52404 , \u45236  \u54588 , \u45236  \u49373 \u47749 \u51012  \u48260 \u47540  \u44163 \u51060 \u45796 \'94 (D\'92Aubigne, b.7, ch.10).\
\uc0\u44536 \u45716  \u45796 \u49884  \u54889 \u51228 \u51032  \u51032 \u44204 \u50640  \u48373 \u51333 \u54616 \u46972 \u45716  \u50836 \u52397 \u51012  \u48155 \u50520 \u45716 \u45936 , \u44536 \u47111 \u44172  \u54616 \u47732  \u44536 \u45716  \u50684 \u47140 \u54624  \u44163 \u51060  \u50500 \u47924 \u44163 \u46020  \u50630 \u51012  \u44163 \u51060 \u50632 \u45796 . \u44536 \u47084 \u51088  \u44536 \u45716  \u45824 \u45813 \u54616 \u50688 \u45796 . \'93\u54889 \u51228 \u50752  \u51228 \u54980 \u46308 \u44284 , \u50500 \u45768  \u44032 \u51109  \u50672 \u50557 \u54620  \u44536 \u47532 \u49828 \u46020 \u51064 \u51068 \u51648 \u46972 \u46020 , \u44536 \u46308 \u51060  \u45208 \u51032  \u51200 \u49436 \u46308 \u51012  \u49884 \u54744 \u54616 \u44256  \u44160 \u53664 \u54644  \u48372 \u45716  \u45936  \u45824 \u54616 \u50668  \u45208 \u45716  \u52649 \u49900 \u51004 \u47196  \u54872 \u50689 \u54620 \u45796 . \u44536 \u47084 \u45208  \u44536 \u47088  \u44221 \u50864 \u50640  \u54596 \u50836 \u54620  \u54620  \u44032 \u51648  \u51312 \u44148 \u51008  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51012  \u54032 \u45800 \u51032  \u44592 \u51456 \u51004 \u47196  \u49340 \u45716  \u51068 \u51060 \u45796 . \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u50640  \u45824 \u54616 \u50668  \u49324 \u46988 \u51060  \u54624  \u49688  \u51080 \u45716  \u51068 \u51008  \u50724 \u51649  \u49692 \u51333 \u54616 \u45716  \u51068 \u51060 \u45796 . \u49457 \u44221  \u47568 \u50432 \u51004 \u47196  \u47588 \u50668 \u51648 \u44256  \u50621 \u54784 \u51256  \u51080 \u45716  \u45208 \u51032  \u50577 \u49900 \u51012  \u44648 \u46888 \u47532 \u44256 \u51088  \u54616 \u51648  \u47568 \u46972 \'94 (D\'92Aubigne, b.7, ch.10).\
\uc0\u46608  \u45796 \u47480  \u44428 \u44256 \u47484  \u48155 \u44256  \u44536 \u45716  \u47568 \u54616 \u50688 \u45796 . \'93\u45208 \u45716  \u45208 \u51032  \u53685 \u54665 \u44428 \u51012  \u54252 \u44592 \u54616 \u45716  \u45936  \u46041 \u51032 \u54620 \u45796 . \u45208 \u45716  \u45208 \u51032  \u47800 \u44284  \u45208 \u51032  \u49373 \u47749 \u51012  \u54889 \u51228 \u51032  \u49552 \u50640  \u47585 \u44596 \u45796 . \u44536 \u47084 \u45208  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51008  \u44536 \u50640 \u44172  \u47585 \u44600  \u49688  \u50630 \u45796 . \u44208 \u45800 \u53076  \u47585 \u44600  \u49688  \u50630 \u45796 \'94 (D\'92Aubigne, b.7, ch.10). \u44536 \u45716  \u51032 \u54924 \u51032  \u44208 \u51221 \u50640  \u53132 \u55176  \u49692 \u51333 \u54616 \u44592 \u47196  \u46907 \u51012  \u45208 \u53440 \u45256 \u51004 \u45208  \u51032 \u54924 \u44032  \u49457 \u44221 \u50640  \u51032 \u44144 \u54616 \u50668  \u44208 \u51221 \u54620 \u45796 \u45716  \u51312 \u44148  \u54616 \u50640 \u49436 \u50688 \u45796 . \u44536 \u45716  \u44228 \u49549 \u54616 \u50668  \'93\u48708 \u47197  \u48277 \u50773 \u51060  \u48177 \u47564 \u51032  \u51032 \u50896 \u46308 \u50640 \u44172  \u51648 \u51648 \u47484  \u48155 \u44256  \u51080 \u51012 \u51648 \u46972 \u46020 , \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u44284  \u49888 \u50521 \u50640  \u44288 \u54644 \u49436 \u45716  \u47784 \u46304  \u44536 \u47532 \u49828 \u46020 \u51064 \u51008  \u48277 \u50773 \u51060  \u44032 \u51652  \u44163 \u44284  \u46041 \u51068 \u54620  \u54032 \u45800 \u47141 \u51012  \u44032 \u51648 \u44256  \u51080 \u45796 \'94 (Martyn, vol.1, p.410) \u44256  \u47568 \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u51032  \u52828 \u44396 \u50752  \u50896 \u49688 \u46308 \u51008  \u51060  \u51060 \u49345  \u54868 \u54644 \u47484  \u50948 \u54616 \u50668  \u45432 \u47141 \u54624 \u51648 \u46972 \u46020  \u50424 \u45936 \u50630 \u45716  \u51068 \u51060 \u46972 \u45716  \u44163 \u51012  \u47560 \u52840 \u45236  \u44648 \u45804 \u50520 \u45796 .\
\pard\pardeftab720\sa319\partightenfactor0

\f0\b \cf0 \uc0\u50577 \u49900 \u51032  \u49849 \u47532 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u47564 \u51068  \u44060 \u54785 \u51088 \u44032  \u45800  \u54620  \u44032 \u51648  \u51216 \u50640 \u49436 \u46972 \u46020  \u53440 \u54801 \u54616 \u50688 \u45908 \u46972 \u47732  \u49324 \u45800 \u44284  \u44536 \u51032  \u48512 \u54616 \u46308 \u51008  \u49849 \u47532 \u47484  \u50619 \u50632 \u51012  \u44163 \u51060 \u45796 . \u44536 \u47084 \u45208  \u44536 \u51032  \u54869 \u44256 \u48512 \u46041 \u54620  \u53468 \u46020 \u45716  \u44368 \u54924 \u47484  \u54644 \u48169 \u54616 \u45716  \u48169 \u54200 \u51060  \u46104 \u50632 \u44256  \u49352 \u47213 \u44256  \u45908 \u50865  \u51339 \u51008  \u54616 \u45208 \u51032  \u44592 \u50896  (\u32000 \u20803 ) \u51012  \u51060 \u47336 \u50612  \u45459 \u50520 \u45796 . \u49888 \u50521  \u47928 \u51228 \u50640  \u44288 \u54616 \u50668  \u51088 \u44592  \u51088 \u49888 \u51060  \u49373 \u44033 \u54616 \u44256  \u48127 \u45716  \u48148 \u47484  \u44732 \u47548 \u51060  \u50630 \u51060  \u44536 \u45824 \u47196  \u49892 \u52380 \u54620  \u51060  \u54620  \u49324 \u46988 \u51032  \u44048 \u54868 \u45716  \u44536  \u49884 \u45824 \u51032  \u44368 \u54924 \u50752  \u49464 \u44228 \u50640  \u50689 \u54693 \u51012  \u45180 \u52452 \u51012  \u49104 \u47564  \u50500 \u45768 \u46972 , \u54980 \u51068 \u51032  \u47784 \u46304  \u49464 \u45824 \u50640 \u44620 \u51648  \u50689 \u54693 \u51012  \u48120 \u52452 \u45796 . \u44536 \u51032  \u54869 \u44256 \u54616 \u44256  \u52649 \u49457 \u46108  \u53468 \u46020 \u45716  \u47560 \u51648 \u47561  \u49884 \u45824 \u50640  \u51060 \u47476 \u44592 \u44620 \u51648  \u44536 \u50752  \u46041 \u51068 \u54620  \u44221 \u54744 \u51012  \u44054 \u44172  \u46112  \u47784 \u46304  \u49324 \u46988 \u50640 \u44172  \u55192 \u51060  \u46112  \u44163 \u51060 \u45796 . \u54616 \u45208 \u45784 \u51032  \u45733 \u47141 \u44284  \u50948 \u50628 \u51008  \u49324 \u46988 \u51032  \u51032 \u44204 \u51060 \u45208  \u49324 \u45800 \u51032  \u50948 \u47141 \u51012  \u55016 \u50476  \u52488 \u50900 \u54620 \u45796 .\
\uc0\u50620 \u47560  \u54980  \u47336 \u53552 \u45716  \u54889 \u51228 \u51032  \u44428 \u50948 \u50640  \u51032 \u54616 \u50668  \u51665 \u51004 \u47196  \u46028 \u50500 \u44032 \u46972 \u45716  \u47749 \u47161 \u51012  \u48155 \u50520 \u45796 . \u44536 \u45716  \u51060 \u47084 \u54620  \u53685 \u44256 \u44032  \u51080 \u51008  \u54980  \u51593 \u49884  \u51221 \u51396 \u51032  \u49440 \u44256 \u44032  \u45236 \u47540  \u44163 \u51012  \u48120 \u47532  \u50508 \u50520 \u45796 . \u44536 \u51032  \u50526 \u44600 \u50640  \u52868 \u52868 \u54620  \u44396 \u47492 \u51060  \u45934 \u50668  \u51080 \u50632 \u51004 \u45208 , \u44536 \u45716  \u48372 \u47492 \u49828 \u47484  \u52636 \u48156 \u54624  \u46412  \u52268 \u48120 \u50752  \u44592 \u49256 \u51004 \u47196  \u47560 \u51020 \u51060  \u52649 \u47564 \u54644 \u51276 \u45796 . \u44536 \u45716  \'93\u50501 \u47560  \u51088 \u49888 \u51060  \u48277 \u50773 \u51032  \u49457 \u52292  (\u22478 \u30758 ) \u47484  \u48372 \u54840 \u54616 \u50688 \u51648 \u47564  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u44144 \u44592 \u50640  \u54620  \u46028 \u54028 \u44396  (\u31361 \u30772 \u21475 ) \u47484  \u47564 \u46308 \u50612  \u51452 \u49512 \u51004 \u48064 \u47196 , \u49324 \u45800 \u51008  \u51452 \u44760 \u49436  \u51088 \u44592 \u48372 \u45796  \u45908 \u50865  \u50948 \u47141 \u51060  \u51080 \u51020 \u51012  \u47560 \u52840 \u45236  \u44256 \u48177 \u54616 \u51648  \u50506 \u51012  \u49688  \u50630 \u50632 \u45796 \'94 (D\'92Aubigne, b.7, ch.11) \u44256  \u47568 \u54616 \u50688 \u45796 .\
\uc0\u47336 \u53552 \u45716  \u48372 \u47492 \u49828 \u47484  \u46496 \u45212  \u54980 \u50640 , \u51088 \u44592 \u51032  \u54869 \u44256 \u54620  \u53468 \u46020 \u44032  \u48152 \u50669 \u51004 \u47196  \u50724 \u54644 \u46104 \u51648  \u50506 \u46020 \u47197  \u54616 \u44592  \u50948 \u54616 \u50668  \u54889 \u51228 \u50640 \u44172  \u45796 \u51020 \u44284  \u44057 \u51008  \u44544 \u51012  \u50732 \u47160 \u45796 . \'93\u51060  \u51333 \u51008  \u49324 \u46988 \u51060  \u51032 \u51648 \u54616 \u50668  \u49332 \u50500 \u50556  \u54624  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432  \u51060 \u50808 \u50640 \u45716  \u49373 \u49324 \u50752  \u50689 \u50837  (\u27054 \u36785 ) \u51012  \u47932 \u47200 \u54616 \u44256  \u50728 \u44054  \u51068 \u50640  \u44032 \u51109  \u50676 \u49900 \u51004 \u47196  \u54224 \u54616 \u47484  \u49692 \u51333 \u54616 \u45716  \u49324 \u46988 \u51064  \u44163 \u51008  \u49324 \u46988 \u51032  \u47560 \u51020 \u51012  \u49332 \u54196 \u48372 \u49884 \u45716  \u54616 \u45208 \u45784 \u44760 \u49436  \u48516 \u47749 \u55176  \u51613 \u44144 \u54616 \u49892  \u44163 \u51077 \u45768 \u45796 . \u54788 \u49464 \u51032  \u47784 \u46304  \u51068 \u50640  \u51080 \u50612 \u49436 \u45716  \u51333 \u51032  \u52649 \u49457 \u50640  \u50500 \u47924 \u47088  \u46041 \u50836 \u44032  \u50630 \u49845 \u45768 \u45796 . \u50780 \u45264 \u54616 \u47732  \u51060  \u49464 \u49345 \u50640 \u49436  \u50619 \u45716  \u44163 \u44284  \u51075 \u50612 \u48260 \u47532 \u45716  \u44163 \u51008  \u44396 \u50896 \u50640  \u50500 \u47924 \u47088  \u49345 \u44288 \u51060  \u50630 \u44592  \u46412 \u47928 \u51077 \u45768 \u45796 . \u44536 \u47084 \u45208  \u50689 \u50896 \u54620  \u47928 \u51228 \u50640  \u44288 \u54616 \u50668 \u49436 \u45716  \u49324 \u46988 \u51060  \u49324 \u46988 \u50640 \u44172  \u44404 \u51333 \u54616 \u46020 \u47197  \u54616 \u45208 \u45784 \u44760 \u49436  \u51032 \u46020 \u54616 \u51648  \u50506 \u51004 \u49512 \u49845 \u45768 \u45796 . \u50689 \u51201  \u47928 \u51228 \u50640  \u51080 \u50612 \u49436  \u44404 \u51333 \u54616 \u45716  \u44163 \u51008  \u49324 \u49892 \u49345  \u50696 \u48176  \u54665 \u50948 \u51060 \u48064 \u47196 , \u44536 \u44163 \u51008  \u50728 \u51204 \u55176  \u52285 \u51312 \u51452 \u50640 \u44172 \u47564  \u46028 \u47140 \u50556  \u54624  \u44163 \u51077 \u45768 \u45796 \'94 (D\'92Aubigne, b.7, ch.11).\
\uc0\u48372 \u47492 \u49828 \u50640 \u49436  \u46028 \u50500 \u44040  \u46412  \u47336 \u53552 \u50640 \u44172  \u45208 \u53440 \u45240  \u51068 \u48152  \u49324 \u46988 \u46308 \u51032  \u51316 \u44221 \u51008  \u44536 \u44032  \u50732  \u46412 \u48372 \u45796  \u55016 \u50476  \u45908  \u51648 \u45824 \u54616 \u50688 \u45796 . \u44256 \u44480 \u54620  \u49457 \u51649 \u51088 \u46308 \u51060  \u54028 \u47928 \u45817 \u54620  \u44536  \u49849 \u47140 \u47484  \u54872 \u50689 \u54616 \u44256 , \u45458 \u51008  \u44288 \u51649 \u50640  \u51080 \u45716  \u44288 \u47532 \u46308 \u51060  \u54889 \u51228 \u51032  \u44204 \u52293 \u51012  \u48155 \u51008  \u44536 \u50640 \u44172  \u44221 \u51032 \u47484  \u54364 \u54616 \u50688 \u45796 . \u44536 \u45716  \u49444 \u44368 \u54616 \u51648  \u47803 \u54616 \u46020 \u47197  \u44552 \u51648 \u46104 \u50612  \u51080 \u50632 \u51004 \u45208  \u49324 \u46988 \u46308 \u51032  \u44036 \u52397 \u50640  \u47803  \u51060 \u44200  \u49444 \u44368 \u45800 \u50640  \u50732 \u46972 \u44052 \u45796 . \u44536 \u45716  \'93\u45208 \u45716  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51012  \u44032 \u46160 \u50612  \u46160 \u44192 \u45796 \u44256  \u47609 \u49464 \u54620  \u51201 \u51060  \u44208 \u53076  \u50630 \u51004 \u47728 , \u50526 \u51004 \u47196 \u46020  \u44208 \u53076  \u44536 \u47111 \u44172  \u54616 \u51648  \u50506 \u51012  \u44163 \u51060 \u45796 \'94 (Martyn, vol.1, p.420) \u46972 \u44256  \u47568 \u54616 \u50688 \u45796 .\
\uc0\u44536 \u44032  \u48372 \u47492 \u49828 \u47484  \u46496 \u45208 \u44036  \u51648  \u50620 \u47560  \u51080 \u51648  \u50500 \u45768 \u54616 \u50668  \u48277 \u50773 \u44368 \u46020 \u46308 \u51008  \u54889 \u51228 \u47484  \u49444 \u46301 \u49884 \u53020  \u47336 \u53552 \u47484  \u48152 \u45824 \u54616 \u45716  \u54252 \u44256 \u47484  \u45236 \u47532 \u46020 \u47197  \u54616 \u50688 \u45796 . \u44536  \u54252 \u44256 \u45716  \u47336 \u53552 \u47484  \u44032 \u47532 \u53020 , \'93\u49324 \u45800 \u51060  \u49849 \u47140 \u51032  \u48373 \u51109 \u51012  \u54616 \u44256  \u49324 \u46988 \u51032  \u47784 \u50577 \u51004 \u47196  \u45208 \u53440 \u45228 \u45796 \'94 (D\'92Aubigne, b.7, ch.11) \u44256 \u44620 \u51648  \u48708 \u45212 \u54616 \u50688 \u45796 . \u44536 \u47532 \u44256  \u44536 \u51032  \u53685 \u54665 \u44428 \u51032  \u44592 \u54620 \u51060  \u47564 \u47308 \u46104 \u45716  \u51593 \u49884 \u47196  \u44536 \u51032  \u49324 \u50629 \u51012  \u51333 \u49885 \u49884 \u53420  \u51312 \u52376 \u47484  \u52712 \u54616 \u46020 \u47197  \u47749 \u47161 \u51060  \u54616 \u45804 \u46104 \u50612  \u51080 \u50632 \u45796 . \u50612 \u46500  \u49324 \u46988 \u46020  \u44536 \u47484  \u48372 \u54840 \u54616 \u44144 \u45208 , \u51020 \u49885 \u47932 \u51012  \u51452 \u44144 \u45208 , \u44277 \u49324  (\u20844 \u31169 ) \u47484  \u48520 \u47928 \u54616 \u44256  \u47568 \u47196 \u45208  \u54665 \u46041 \u51004 \u47196  \u44536 \u47484  \u51025 \u50896 \u54616 \u44144 \u45208  \u46020 \u50752 \u51452 \u51648  \u47803 \u54616 \u46020 \u47197  \u44552 \u51648 \u46104 \u50612  \u51080 \u50632 \u45796 . \u44536 \u47484  \u48156 \u44204 \u54616 \u45716  \u45824 \u47196  \u52404 \u54252 \u54616 \u50668  \u44288 \u54732 \u51032  \u49552 \u50640  \u45336 \u44200 \u51452 \u46020 \u47197  \u46104 \u50612  \u51080 \u50632 \u45796 . \u46608 \u54620  \u44536 \u47484  \u51648 \u51648 \u54616 \u45716  \u49324 \u46988 \u46308 \u46020  \u50725 \u50640  \u44032 \u46160 \u44256 , \u44536 \u46308 \u51032  \u51116 \u49328 \u51008  \u47792 \u49688 \u45817 \u54616 \u46020 \u47197  \u46104 \u50612  \u51080 \u50632 \u45796 . \u44536 \u47532 \u44256  \u44536 \u51032  \u51200 \u49436 \u46308 \u51008  \u50630 \u50528  \u48260 \u47532 \u46020 \u47197  \u46104 \u50612  \u51080 \u50632 \u51004 \u47728 , \u47560 \u51648 \u47561 \u51004 \u47196  \u51060  \u54252 \u44256 \u47484  \u50948 \u48152 \u54616 \u45716  \u51088 \u45716  \u47784 \u46160  \u50948 \u50640  \u44592 \u47197 \u54620  \u48148 \u50752  \u46041 \u51068 \u54620  \u52376 \u48268 \u51012  \u48155 \u51012  \u44163 \u51060 \u46972 \u44256  \u44256 \u49884  (\u21578 \u31034 ) \u46104 \u50632 \u45796 . \u51089 \u49468 \u51032  \u49440 \u54980 \u50752  \u47336 \u53552 \u50640 \u44172  \u54840 \u44048 \u51012  \u44032 \u51652  \u50668 \u47084  \u51228 \u54980 \u46308 \u51008  \u44536 \u44032  \u52636 \u48156 \u54620  \u54980 \u50640  \u44263  \u48372 \u47492 \u49828 \u47484  \u46496 \u45228 \u51004 \u48064 \u47196 , \u54889 \u51228 \u51032  \u51060  \u44256 \u49884 \u45716  \u51032 \u54924 \u51032  \u52268 \u46041 \u51012  \u50619 \u50632 \u45796 . \u48277 \u50773 \u44368 \u46020 \u46308 \u51008  \u44060 \u44032 \u47484  \u48520 \u47104 \u45796 . \u44536 \u46308 \u51008  \u44060 \u54785  \u49324 \u50629 \u51032  \u50868 \u47749 \u51060  \u51060 \u51228  \u45149 \u45228 \u45796 \u44256  \u49373 \u44033 \u54616 \u50688 \u45796 .\
\pard\pardeftab720\sa319\partightenfactor0

\f0\b \cf0 \uc0\u44060 \u54785  \u49324 \u50629 \u44284  \u54616 \u45208 \u45784 \u51032  \u46020 \u50880 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u51060 \u50752  \u44057 \u51060  \u50948 \u44553 \u54620  \u49884 \u44592 \u50640  \u45817 \u49888 \u51032  \u51333 \u50640 \u44172  \u54588 \u54624  \u44600 \u51012  \u50676 \u50612 \u51452 \u49512 \u45796 . \u47336 \u53552 \u51032  \u50868 \u46041 \u50640  \u45824 \u54616 \u50668  \u51068 \u44033 \u46020  \u48169 \u49900 \u54616 \u51648  \u50506 \u44256 , \u44536 \u47484  \u44396 \u50896 \u54616 \u47140 \u44256  \u44208 \u49900 \u54620  \u51652 \u49892 \u54616 \u44256  \u44256 \u44208 \u54620  \u51032 \u51648 \u47484  \u44032 \u51652  \u49324 \u46988 \u51060  \u51080 \u50632 \u45796 . \u47196 \u47560 \u45716  \u47336 \u53552 \u47484  \u51453 \u51060 \u44592  \u51204 \u50640 \u45716  \u44208 \u53076  \u47564 \u51313 \u54616 \u51648  \u50506 \u51012  \u44163 \u51060  \u48516 \u47749 \u54616 \u50688 \u51004 \u48064 \u47196  \u44536 \u47484  \u49324 \u51088 \u51032  \u48165 \u51060  \u46104 \u51648  \u50506 \u44172  \u54616 \u47140 \u47732  \u49704 \u44600  \u49688 \u48150 \u50640  \u48324 \u46020 \u47532 \u44032  \u50630 \u50632 \u45796 . \u44536 \u47084 \u48064 \u47196  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u51089 \u49468 \u51032  \u54532 \u47532 \u46300 \u47532 \u55176  \u54980 \u50640 \u44172  \u44060 \u54785 \u51088 \u47484  \u48372 \u54840 \u54624  \u44228 \u54925 \u51012  \u49464 \u50864 \u46020 \u47197  \u51648 \u54812 \u47484  \u51452 \u49512 \u45796 . \u49457 \u49892 \u54620  \u52828 \u44396 \u46308 \u51032  \u54801 \u47141  \u50500 \u47000 , \u49440 \u54980  (\u36984 \u20399 ) \u51032  \u44228 \u54925 \u51008  \u49892 \u54665 \u46104 \u50632 \u45796 . \u44536 \u47532 \u54616 \u50668  \u47588 \u50864  \u54952 \u44284 \u51201 \u51064  \u48169 \u48277 \u51004 \u47196  \u47336 \u53552 \u45716  \u50896 \u49688 \u46308 \u44284  \u52828 \u44396 \u46308 \u47196 \u48512 \u53552  \u49704 \u44200 \u51256  \u48260 \u47160 \u45796 . \u51665 \u51004 \u47196  \u46028 \u50500 \u44032 \u45716  \u44600 \u50640  \u44536 \u45716  \u52404 \u54252 \u46104 \u50612 , \u46041 \u54665 \u51088 \u46308 \u44284  \u48516 \u47532 \u46104 \u50632 \u44256 , \u44553 \u55176  \u49328 \u47548 \u51012  \u53685 \u44284 \u54616 \u50668  \u51064 \u44032 \u50640 \u49436  \u46504 \u50612 \u51256  \u51080 \u45716  \u49328 \u49457  \u48148 \u47476 \u53944 \u48512 \u47476 \u53356  (Wartburg) \u47196  \u45132 \u47140 \u44052 \u45796 . \u44536 \u51032  \u52404 \u54252 \u50752  \u51008 \u45769  (\u38577 \u21311 ) \u51008  \u45320 \u47924 \u46020  \u48708 \u48128 \u47532 \u50640  \u49892 \u54665 \u46104 \u50632 \u51004 \u48064 \u47196 , \u54532 \u47532 \u46300 \u47532 \u55176  \u54980 \u44620 \u51648 \u46020  \u50724 \u47019 \u46041 \u50504  \u44536  \u51068 \u51060  \u50612 \u46523 \u44172  \u52376 \u47532 \u46104 \u50632 \u45716 \u51648  \u50508 \u51648  \u47803 \u54616 \u44256  \u51080 \u50632 \u45796 . \u51060 \u50752  \u44057 \u51060  \u49440 \u54980  (\u36984 \u20399 ) \u51088 \u49888 \u44620 \u51648 \u46020  \u50508 \u51648  \u47803 \u54616 \u46020 \u47197  \u46108  \u44163 \u51008  \u44228 \u54925 \u51201 \u51004 \u47196  \u51060 \u47336 \u50612 \u51652  \u51068 \u51060 \u50632 \u45796 . \u49440 \u54980 \u44032  \u47336 \u53552 \u51032  \u49548 \u51116 \u47484  \u50508 \u51648  \u47803 \u54616 \u45716  \u54620  \u44536  \u51068 \u51012  \u45572 \u49444 \u54624  \u49688  \u50630 \u45716  \u51068 \u51060 \u50632 \u44592  \u46412 \u47928 \u51060 \u50632 \u45796 . \u49440 \u54980 \u45716  \u44060 \u54785 \u51088 \u44032  \u48152 \u46300 \u49884  \u50504 \u51204 \u55176  \u49704 \u44200  \u51080 \u51012  \u51460 \u47564  \u50508 \u44256  \u44536 \u44163 \u51004 \u47196  \u47564 \u51313 \u54616 \u50688 \u45796 .\
\uc0\u48388 , \u50668 \u47492 , \u44032 \u51012 \u51060  \u51648 \u45208 \u44032 \u44256  \u46300 \u46356 \u50612  \u44200 \u50872 \u51060  \u50772 \u45796 . \u44536 \u47084 \u45208  \u47336 \u53552 \u45716  \u50668 \u51204 \u55176  \u49324 \u47196 \u51105 \u55180  \u47800 \u51004 \u47196  \u45224 \u50500  \u51080 \u50632 \u45796 . \u50508 \u47532 \u50504 \u45908 \u50752  \u44536  \u51068 \u45817 \u51008  \u48373 \u51020 \u51032  \u48731 \u51060  \u48268 \u50024  \u44144 \u51032  \u49548 \u47736 \u46104 \u50632 \u45796 \u44256  \u44592 \u48848 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u49324 \u49892 \u51008  \u44536 \u50752  \u48152 \u45824 \u47196  \u44060 \u54785 \u51088 \u45716  \u51652 \u47532 \u51032  \u52285 \u44256 \u50640 \u49436  \u46321 \u50640  \u44592 \u47492 \u51012  \u52292 \u50864 \u44256  \u51080 \u50632 \u45796 . \u44536 \u47084 \u48064 \u47196  \u46321 \u48520 \u51008  \u45908 \u50865 \u45908  \u48157 \u55176  \u48708 \u52628 \u50612 \u51656  \u44163 \u51060 \u50632 \u45796 .\
\uc0\u47336 \u53552 \u45716  \u48148 \u47476 \u53944 \u48512 \u47476 \u53356 \u51032  \u51312 \u50857 \u54616 \u44256  \u50504 \u51204 \u54620  \u48516 \u50948 \u44592  \u49549 \u50640 \u49436 , \u51104 \u49884  \u46041 \u50504  \u49912 \u50880 \u51032  \u49548 \u50836 \u50752  \u50676 \u54868  (\u29105 \u28779 ) \u50640 \u49436  \u48279 \u50612 \u45208  \u55092 \u49885 \u51012  \u51600 \u44600  \u49688  \u51080 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u51060 \u47084 \u54620  \u51312 \u50857 \u54616 \u44256  \u54217 \u50504 \u54620  \u52376 \u51648 \u50640 \u49436  \u50724 \u47019 \u46041 \u50504  \u47564 \u51313 \u54624  \u49688  \u50630 \u50632 \u45796 . \u44536 \u45716  \u54876 \u46041 \u51201  \u49373 \u50528 \u50752  \u44201 \u47148 \u54620  \u53804 \u51137  (\u39722 \u29229 ) \u51032  \u49373 \u54876 \u50640  \u51061 \u49689 \u54644 \u51256  \u51080 \u50632 \u51004 \u48064 \u47196  \u54876 \u46041 \u54616 \u51648  \u50506 \u44256  \u51648 \u45236 \u44592 \u46976  \u44204 \u46356 \u44592  \u50612 \u47140 \u50868  \u51068 \u51060 \u50632 \u45796 . \u51060 \u52376 \u47100  \u44256 \u46021 \u54620  \u49464 \u50900 \u51012  \u51648 \u45236 \u45716  \u46041 \u50504 \u50640  \u44368 \u54924 \u51032  \u54805 \u54200 \u51060  \u44536 \u51032  \u50526 \u50640  \u45208 \u53440 \u45228 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u45716  \'93\u50500 \u50500 ! \u54616 \u45208 \u45784 \u51032  \u51652 \u45432 \u44032  \u51076 \u54624  \u45149  \u45216 \u50640  \u45572 \u44032  \u51060 \u49828 \u46972 \u50648 \u51012  \u44396 \u50896 \u54616 \u44592  \u50948 \u54616 \u50668  \u51452 \u45784  \u50526 \u50640  \u49457 \u48317 \u51060  \u46104 \u50612  \u51460  \u44163 \u51064 \u44032 !\'94 (D\'92Aubigne, b.9, ch.2) \u46972 \u44256  \u53444 \u49885 \u54616 \u50688 \u45796 . \u44536 \u47532 \u44256  \u53804 \u51137 \u51032  \u51109 \u49548 \u50640 \u49436  \u47800 \u51012  \u54588 \u54616 \u50668  \u51080 \u45716  \u51088 \u49888 \u51012  \u48152 \u49457 \u54644  \u48372 \u44256 , \u48708 \u44161 \u54620  \u51088 \u46972 \u45716  \u48708 \u45212 \u51012  \u48155 \u51012  \u44163 \u51012  \u46160 \u47140 \u50892 \u54616 \u50688 \u45796 . \u44536 \u45716  \u51088 \u44592  \u51088 \u49888 \u51060  \u54616 \u45716  \u51068  \u50630 \u51060  \u44172 \u51004 \u47480  \u49345 \u53468 \u50640  \u48736 \u51256  \u51080 \u45716  \u44163 \u51012  \u48372 \u44256  \u49828 \u49828 \u47196 \u47484  \u52293 \u47581 \u54616 \u50688 \u45796 . \u44536 \u47111 \u51648 \u47564  \u44536 \u45716  \u54620  \u49324 \u46988 \u51060  \u54624  \u49688  \u51080 \u51004 \u47532 \u46972 \u44256  \u49373 \u44033 \u54616 \u45716  \u44163 \u48372 \u45796  \u45908  \u47566 \u51008  \u48516 \u47049 \u51032  \u51068 \u51012  \u45216 \u47560 \u45796  \u54616 \u44256  \u51080 \u50632 \u45796 . \u44536 \u51032  \u48531 \u51008  \u45130 \u51076 \u50630 \u51060  \u50880 \u51649 \u51060 \u44256  \u51080 \u50632 \u45796 . \u54620 \u46041 \u50504  \u44536 \u51032  \u50896 \u49688 \u46308 \u51008  \u47336 \u53552 \u47484  \u52840 \u47925 \u52992  \u54616 \u50688 \u45796 \u44256  \u44592 \u48848 \u54616 \u50688 \u51004 \u45208 , \u44536 \u44032  \u50500 \u51649 \u46020  \u54876 \u46041 \u54616 \u44256  \u51080 \u45716  \u54869 \u49892 \u54620  \u51613 \u44144 \u47484  \u48372 \u44256  \u44536 \u46308 \u51008  \u45440 \u46972 \u51648  \u50506 \u51012  \u49688  \u50630 \u50632 \u45796 . \u47566 \u51008  \u49548 \u52293 \u51088 \u44032  \u44536 \u47196  \u47568 \u48120 \u50516 \u50500  \u51200 \u49696 \u46104 \u50612  \u46021 \u51068  \u51204 \u44397 \u50640  \u49332 \u54252 \u46104 \u50632 \u45796 . \u44536 \u47532 \u44256  \u44536 \u45716  \u46021 \u51068 \u50612 \u47196  \u49888 \u50557  \u49457 \u44221 \u51012  \u48264 \u50669 \u54632 \u51004 \u47196  \u51088 \u44592  \u45208 \u46972 \u51032  \u44397 \u48124 \u46308 \u50640 \u44172  \u44032 \u51109  \u51473 \u50836 \u54620  \u48393 \u49324 \u47484  \u54616 \u50688 \u45796 . \u44536 \u45716  \u44144 \u51032  1\u45380  \u46041 \u50504  \u48148 \u50948 \u53804 \u49457 \u51060 \u51064  \u44536 \u51032  \'93\u48167 \u47784 \u49452 \'94\u50640  \u47672 \u47932 \u47084  \u51080 \u51004 \u47732 \u49436 , \u48373 \u51020 \u51012  \u49440 \u54252 \u54632 \u44284  \u46041 \u49884 \u50640  \u44536  \u49884 \u45824 \u51032  \u50724 \u47448 \u50752  \u51396 \u50501 \u51012  \u44204 \u52293 \u54616 \u50688 \u45796 .\
\uc0\u54616 \u45208 \u45784 \u44760 \u49436  \u45817 \u49888 \u51032  \u51333 \u51012  \u44277 \u49373 \u50528 \u51032  \u47924 \u45824 \u50640 \u49436  \u47932 \u47084 \u45208 \u44172  \u54616 \u49888  \u44163 \u51008  \u47336 \u53552 \u47196  \u54616 \u50668 \u44552  \u50896 \u49688 \u46308 \u51032  \u48516 \u45432 \u47484  \u54588 \u54616 \u44172  \u54616 \u49884 \u44592  \u50948 \u54620  \u44163 \u47564 \u51060  \u50500 \u45768 \u50632 \u51004 \u47728 , \u46608 \u54620  \u44536 \u50640 \u44172  \u44536 \u52376 \u47100  \u51473 \u45824 \u54620  \u49324 \u50629 \u51012  \u47585 \u44592 \u49884 \u44592  \u50948 \u54616 \u50668  \u51312 \u50857 \u54620  \u49884 \u44036 \u51012  \u44054 \u44172  \u54616 \u44592  \u50948 \u54620  \u44163 \u47564 \u46020  \u50500 \u45768 \u50632 \u45796 . \u44144 \u44592 \u50640 \u45716  \u44144 \u46160 \u50612 \u50556  \u54624  \u45908 \u50865  \u44480 \u51473 \u54620  \u44208 \u44284 \u44032  \u51080 \u50632 \u45796 . \u54620 \u51201 \u54616 \u44256  \u44201 \u47532 \u46108  \u49328 \u51109  (\u23665 \u33674 ) \u50640  \u51080 \u51004 \u48064 \u47196  \u47336 \u53552 \u45716  \u49464 \u49345 \u51032  \u51648 \u51648 \u47484  \u48155 \u51648  \u47803 \u54616 \u44172  \u46104 \u50632 \u44256  \u49324 \u46988 \u46308 \u51032  \u52845 \u52268 \u50640 \u49436  \u45130 \u50612 \u51648 \u44172  \u46104 \u50632 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u45716  \u49457 \u44277 \u50640  \u55124 \u55176  \u46384 \u47476 \u45716  \u51088 \u48512 \u49900 \u44284  \u44368 \u47564 \u51004 \u47196 \u48512 \u53552  \u44396 \u51228 \u46104 \u50632 \u45796 . \u51060 \u47532 \u54616 \u50668  \u44536 \u45716  \u44256 \u45212 \u44284  \u44216 \u48708 \u47484  \u53685 \u54616 \u50668 , \u44536 \u44032  \u44049 \u51088 \u44592  \u45458 \u51076 \u51012  \u48155 \u51004 \u48064 \u47196  \u54788 \u44592 \u51613 \u51060  \u45216  \u47564 \u53372  \u45458 \u51008  \u44275 \u50640 \u49436  \u50504 \u51204 \u54616 \u44172  \u44152 \u50612  \u45796 \u4577