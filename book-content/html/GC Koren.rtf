\uc0\u44536 \u47532 \u49828 \u46020 \u51032  \u51453 \u51020 \u51004 \u47196  \u51032 \u47928 \u51032  \u50984 \u48277 \u44284  \u54632 \u44760  \u49901 \u44228 \u47749 \u51060  \u54224 \u51648 \u46104 \u50632 \u45796 \u44256  \u51452 \u51109 \u54616 \u45716  \u51088 \u46308 \u50640  \u45824 \u54616 \u50668  \u50920 \u49836 \u47532 \u45716  \u47568 \u54616 \u50688 \u45796 . \'93\u49901 \u44228 \u47749 \u51060  \u54252 \u54632 \u46104 \u50612  \u51080 \u44256  \u49440 \u51648 \u51088 \u46308 \u47196  \u47568 \u48120 \u50516 \u50500  \u44204 \u44256 \u54616 \u50668 \u51652  \u46020 \u45909 \u51201  \u50984 \u48277 \u51008  \u51452 \u45784 \u44760 \u49436  \u44208 \u53076  \u54224 \u51648 \u54616 \u51648  \u50500 \u45768 \u54616 \u49512 \u45796 . \u44536 \u48516 \u44760 \u49436  \u50724 \u49888  \u44163 \u51008  \u44536  \u50984 \u48277 \u51032  \u50612 \u46500  \u48512 \u48516 \u51012  \u49325 \u51228 \u54616 \u44256 \u51088  \u54632 \u51060  \u44208 \u53076  \u50500 \u45768 \u45796 . \u51060  \u50984 \u48277 \u51008  \u44208 \u53076  \u54224 \u54624  \u49688  \u50630 \u45716  \u44163 \u51060 \u47728 , \'91\u52649 \u49892 \u54620  \u51613 \u44144 \u51088 \u47196 \u49436  \u54616 \u45720 \u50640  \u44403 \u44172  \u49444  \u44163 \'92\u51060 \u45796 . \'85\u44536  \u50984 \u48277 \u51008  \u53468 \u52488 \u48512 \u53552  \u51080 \u50632 \u45716 \u45936 , \u44536 \u44163 \u51008  \'91\u49437 \u54032 \u50640  \u49352 \u44592 \u51648  \u50500 \u45768 \u54616 \u50688 \u51004 \u45208 \'92 \u47784 \u46304  \u51064 \u47448 \u51032  \u51088 \u45376 \u46308 \u51060  \u52285 \u51312 \u51088 \u51032  \u49552 \u50640 \u49436  \u45208 \u50732  \u46412  \u44536 \u46308 \u51032  \u47560 \u51020 \u50640  \u47784 \u46160  \u49352 \u44200 \u51276 \u45796 . \u44536 \u47532 \u44256  \u54620  \u46412 \u45716  \u54616 \u45208 \u45784 \u51032  \u49552 \u50640  \u51032 \u54616 \u50668  \u47928 \u51088 \u47196  \u44592 \u47197 \u46104 \u44592 \u44620 \u51648  \u54616 \u50688 \u51648 \u47560 \u45716  \u50724 \u45720 \u45216 \u50640 \u45716  \u51396 \u47196  \u47568 \u48120 \u50516 \u50500  \u44536 \u44163 \u51060  \u53356 \u44172  \u55036 \u49552 \u46104 \u50632 \u45796 . \u44536 \u47084 \u45208  \u49440 \u50501 \u50640  \u45824 \u54620  \u51032 \u49885 \u51060  \u45796 \u49548 \u45208 \u47560  \u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u49549 \u50640  \u45224 \u50500  \u51080 \u45716  \u54620  \u44536  \u50984 \u48277 \u51008  \u50756 \u51204 \u55176  \u54224 \u51648 \u46112  \u49688  \u50630 \u45716  \u44163 \u51060 \u45796 . \u51060  \u50984 \u48277 \u51032  \u47784 \u46304  \u48512 \u48516 \u51008  \u44033  \u49884 \u45824 \u51032  \u50728  \u51064 \u47448 \u44032  \u51648 \u53020 \u50556  \u54624  \u51032 \u47924 \u47196  \u45224 \u50500  \u51080 \u50612 \u50556  \u54620 \u45796 . \u44536 \u44163 \u51008  \u49884 \u44036 \u44284  \u51109 \u49548 \u50752  \u54872 \u44221 \u50640  \u46384 \u46972  \u51340 \u50864 \u46112  \u44163 \u51060  \u50500 \u45768 \u44256  \u50724 \u55176 \u47140  \u54616 \u45208 \u45784 \u51032  \u48376 \u49457 \u44284  \u49324 \u46988 \u51032  \u48376 \u49457 , \u44536 \u47532 \u44256  \u44536  \u49345 \u54840 \u44036 \u51032  \u48320 \u44221 \u46112  \u49688  \u50630 \u45716  \u44288 \u44228 \u50640  \u51032 \u54616 \u50668  \u51340 \u50864 \u46104 \u50612 \u50556  \u54620 \u45796 .\'94\
\'93\'91\uc0\u54224 \u54616 \u47084  \u50728  \u44163 \u51060  \u50500 \u45768 \u50836  \u50756 \u51204 \u52992  \u54632 \u51060 \u47196 \u45796 .\'92 \u44536  \u47568 \u51032  \u46907 \u51008  \u51032 \u49900 \u54624  \u50668 \u51648 \u50630 \u51060  \u45796 \u51020 \u44284  \u44057 \u45796 . \u45208 \u45716  \u49324 \u46988 \u51032  \u50728 \u44054  \u44257 \u54644 \u50640 \u46020  \u48520 \u44396 \u54616 \u44256  \u50724 \u51649  \u44536 \u44163 \u51012  \u50756 \u51204 \u52992  \u54616 \u47084  \u50772 \u45796 . \u44536  \u49549 \u50640  \u51080 \u45716  \u47784 \u46304  \u50528 \u47588 \u54616 \u44256  \u48516 \u47749 \u52824  \u50506 \u51008  \u51216 \u46308 \u51012  \u50756 \u51204 \u55176  \u52380 \u47749 \u54616 \u47084  \u50772 \u45796 . \u44536  \u47784 \u46304  \u48512 \u48516 \u51032  \u51652 \u51221 \u54616 \u44256  \u50756 \u51204 \u54620  \u51032 \u48120 \u47484  \u49440 \u54252 \u54616 \u44256 , \u44144 \u44592 \u50640  \u54252 \u54632 \u46104 \u50612  \u51080 \u45716  \u44033  \u51312 \u47785 \u51032  \u48276 \u50948 , \u44263  \u44536  \u44600 \u51060 \u50752  \u45331 \u51060 \u50752  \u44618 \u51060 \u50752  \u44033  \u54637 \u47785 \u50640  \u46308 \u50612 \u51080 \u45716  \u49345 \u49345 \u51312 \u52264  \u54624  \u49688  \u50630 \u45716  \u49692 \u44208 \u44284  \u50689 \u51201  \u49457 \u51656  \u46321 \u51012  \u45208 \u53440 \u45236 \u44592  \u50948 \u54616 \u50668  \u50772 \u45796 \'94 (Wes-ley\'92s Sermon 25).\
\uc0\u50920 \u49836 \u47532 \u45716  \u50984 \u48277 \u44284  \u48373 \u51020 \u51032  \u50756 \u51204 \u54620  \u51312 \u54868 \u47484  \u50500 \u47000 \u50752  \u44057 \u51060  \u47568 \u54616 \u50688 \u45796 . \'93\u44536 \u47084 \u48064 \u47196  \u50984 \u48277 \u44284  \u48373 \u51020 \u51008  \u44032 \u51109  \u48128 \u51217 \u54620  \u44288 \u44228 \u44032  \u51080 \u45796 \u45716  \u44163 \u51012  \u50508  \u49688  \u51080 \u45796 . \u54620 \u54200 \u51004 \u47196  \u50984 \u48277 \u51008  \u45130 \u51076 \u50630 \u51060  \u48373 \u51020 \u51012  \u50948 \u54620  \u44600 \u51012  \u47564 \u46308 \u50612 \u49436  \u49324 \u46988 \u46308 \u47196  \u54616 \u50668 \u44552  \u44536 \u47532 \u47196  \u44032 \u46020 \u47197  \u51648 \u49884 \u54620 \u45796 . \u44536 \u47532 \u44256  \u45796 \u47480  \u54620 \u54200 \u51004 \u47196  \u48373 \u51020 \u51008  \u54637 \u49345  \u50864 \u47532 \u47484  \u51064 \u46020 \u54616 \u50668  \u50984 \u48277 \u51012  \u45908 \u50865  \u51221 \u54869 \u55176  \u49457 \u52712 \u49884 \u53412 \u46020 \u47197  \u54620 \u45796 . \u50696 \u52968 \u45824  \u50984 \u48277 \u51008  \u54616 \u45208 \u45784 \u51012  \u49324 \u46993 \u54616 \u44256  \u51060 \u50883 \u51012  \u49324 \u46993 \u54616 \u44256  \u50728 \u50976 \u54616 \u44256  \u44216 \u49552 \u54616 \u44256  \u49457 \u44208 \u54616 \u44592 \u47484  \u50864 \u47532 \u50640 \u44172  \u50836 \u44396 \u54620 \u45796 . \u50864 \u47532 \u45716  \u44536 \u50752  \u44057 \u51008  \u47784 \u46304  \u50836 \u44396 \u50640  \u45824 \u54616 \u50668  \u48512 \u51313 \u54632 \u51012  \u44648 \u45803 \u45716 \u45796 . \u44536 \u47084 \u45208  \u50864 \u47532 \u45716  \u49324 \u46988 \u51004 \u47196 \u45716  \u48520 \u44032 \u45733 \u54616 \u51648 \u47560 \u45716  \u51060 \u52376 \u47100  \u49324 \u46993 \u51012  \u51452 \u44256 , \u44216 \u49552 \u54616 \u44256  \u49457 \u44208 \u52992  \u54616 \u45716  \u54616 \u45208 \u45784 \u51032  \u50616 \u50557 \u51012  \u48372 \u44172  \u46108 \u45796 . \u50864 \u47532 \u45716  \u48373 \u51020 , \u44263  \u44592 \u49244  \u49548 \u49885 \u51012  \u48537 \u46308 \u44172  \u46108 \u45796 . \u44536 \u47088 \u45936  \u44536 \u44163 \u51008  \u48127 \u51020 \u51004 \u47196  \u47568 \u48120 \u50516 \u50500  \u50864 \u47532 \u50640 \u44172  \u51060 \u47336 \u50612 \u51652 \u45796 . \u44263  \'91\u50984 \u48277 \u51032  \u51032 \'92\u44032  \u44536 \u47532 \u49828 \u46020  \u50696 \u49688  \u50504 \u50640  \u51080 \u45716  \u48127 \u51020 \u51004 \u47196  \u47568 \u48120 \u50516 \u50500  \u50864 \u47532  \u50504 \u50640 \u49436  \u50756 \u51204 \u55176  \u51060 \u47336 \u50612 \u51648 \u44172  \u46108 \u45796 .\'94\
\uc0\u46608  \u50920 \u49836 \u47532 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u54616 \u50688 \u45796 . \'93\u44536 \u47532 \u49828 \u46020 \u51032  \u48373 \u51020 \u51032  \u44032 \u51109  \u53360  \u50896 \u49688  \u44032 \u50868 \u45936 \u45716  \'91\u50984 \u48277 \u51012  \u44592 \u53444 \u50630 \u51060  \u44277 \u44201 \u54616 \u44256 \'92, \'91\u50984 \u48277 \u51012  \u50501 \u54620  \u44163 \u51004 \u47196  \u47568 \u54616 \u45716 \'92 \u51088 \u46308 \u51060  \u51080 \u45796 . \u44536 \u46308 \u51008  \u49324 \u46988 \u46308 \u50640 \u44172  \u50984 \u48277 \u51012  \u44648 \u46888 \u47532 \u46020 \u47197  (\u50984 \u48277 \u50640  \u45824 \u54620  \u51032 \u47924 \u47484  \u54224 \u44592 \u54616 \u45716  \u44163 ) \u44032 \u47476 \u52824 \u46104 , \u50984 \u48277 \u51032  \u44032 \u51109  \u53360  \u51312 \u54637 \u51060 \u45208  \u44032 \u51109  \u51089 \u51008  \u51312 \u54637 \u49104  \u50500 \u45768 \u46972  \u50984 \u48277  \u51204 \u52404 \u47484  \u50728 \u51204 \u55176  \u44648 \u46888 \u47532 \u46020 \u47197  \u44032 \u47476 \u52828 \u45796 . \'85\u44536 \u47084 \u45208  \u51060 \u47084 \u54620  \u54728 \u47581 \u54620  \u51068  \u44032 \u50868 \u45936 \u46020  \u44032 \u51109  \u45440 \u46972 \u50868  \u51068 \u51008  \u44536 \u46308 \u51060  \u44536 \u47532 \u49828 \u46020 \u51032  \u50984 \u48277 \u51012  \u51204 \u48373 \u54616 \u47732 \u49436 \u46020  \u44536 \u44163 \u51012  \u45458 \u51060 \u45716  \u51460 \u47196  \u48127 \u44256 , \u44536 \u48516 \u51032  \u44368 \u54984 \u51012  \u54224 \u54616 \u50668  \u48260 \u47532 \u47732 \u49436 \u46020  \u44536 \u48516 \u51032  \u49324 \u50629 \u51012  \u54869 \u51109 \u49884 \u53412 \u44256  \u51080 \u45716  \u51460 \u47196  \u50668 \u44592 \u45716  \u51068 \u51060 \u45796 . \'91\u51452 \u50668  \u54217 \u50504 \u54616 \u45768 \u51060 \u44620 \'92\u46972 \u44256  \u47568 \u54616 \u47732 \u49436  \u51077 \u51012  \u47582 \u52632  \u50976 \u45796 \u50752  \u44057 \u51060  \u54665 \u46041 \u54620  \u44536 \u46308 \u51060  \u50696 \u49688 \u45784 \u51012  \u44284 \u50672  \u45458 \u51060 \u44256  \u51080 \u45716 \u44032 . \u44536 \u47084 \u45208  \u44536 \u47084 \u54620  \u49324 \u46988 \u46308 \u50640 \u44172  \u51452 \u45784 \u44760 \u49436 \u45716  \'91\u45348 \u44032  \u51077 \u47582 \u52644 \u51004 \u47196 \u50024  \u51064 \u51088 \u47484  \u54028 \u45712 \u45264 \'92\u44256  \u47568 \u50432 \u54616 \u49892  \u44163 \u51060 \u45796 . \u51452 \u45784 \u51032  \u48372 \u54792 \u50640  \u45824 \u54616 \u50668  \u47568 \u54616 \u47732 \u49436  \u44536 \u48516 \u51032  \u47732 \u47448 \u44288 \u51012  \u48279 \u44592 \u45716  \u51068 \u44284  \u44536 \u48516 \u51032  \u48373 \u51020  \u49324 \u50629 \u51012  \u48156 \u51204 \u49884 \u53412 \u45716  \u52404  \u54616 \u47732 \u49436  \u44536 \u48516 \u51032  \u50984 \u48277 \u51032  \u50612 \u45712  \u48512 \u48516 \u51012  \u49325 \u51228 \u54644  \u48260 \u47532 \u45716  \u51068 \u51008  \u51077 \u47582 \u52644 \u51004 \u47196  \u44536 \u48516 \u51012  \u48176 \u49888 \u54616 \u45716  \u44163 \u44284  \u45796 \u47484  \u48148 \u44032  \u50630 \u45796 . \u48127 \u51020 \u51012  \u51204 \u54616 \u45716  \u51088 \u47196 \u49436  \u51649 \u51217 \u51201 \u51060 \u44144 \u45208  \u44036 \u51217 \u51201 \u51004 \u47196  \u49692 \u51333 \u54616 \u50668 \u50556  \u54624  \u50612 \u46500  \u51201 \u51008  \u48512 \u48516 \u51060 \u46972 \u46020  \u51228 \u54644  \u48260 \u47532 \u47140 \u45716  \u53468 \u46020 \u47484  \u52712 \u54616 \u44144 \u45208 , \u44536 \u47532 \u49828 \u46020 \u47484  \u51204 \u54616 \u45716  \u51088 \u47196 \u49436  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51032  \u51648 \u44537 \u55176  \u51089 \u51008  \u44163 \u51012  \u51312 \u44552 \u51060 \u46972 \u46020  \u50557 \u54616 \u44172  \u54616 \u44144 \u45208  \u47924 \u54952 \u47196  \u47564 \u46300 \u45716  \u51088 \u45716  \u50976 \u45796 \u50640 \u44172  \u54620  \u51221 \u51396 \u51032  \u48708 \u45212 \u51012  \u47732 \u54624  \u49688  \u50630 \u45796 \'94 (Wesley\'92s Sermon 35).\
\'93\uc0\u48373 \u51020 \u51012  \u51204 \u54616 \u47732  \u50984 \u48277 \u51032  \u47784 \u46304  \u47785 \u51201 \u51012  \u45796 \u54616 \u45716  \u44163 \u51060 \u45796 \'94\u44256  \u51452 \u51109 \u54616 \u45716  \u49324 \u46988 \u46308 \u50640  \u45824 \u54616 \u50668  \u50920 \u49836 \u47532 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u45824 \u45813 \u54616 \u50688 \u45796 . \'93\u50864 \u47532 \u45716  \u44536 \u44163 \u51012  \u51204 \u50672  \u48512 \u51064 \u54620 \u45796 . \u48373 \u51020 \u51008  \u49548 \u50948  \u50984 \u48277 \u51032  \u52395 \u51704  \u47785 \u51201 , \u44263  \u49324 \u46988 \u46308 \u50640 \u44172  \u51396 \u47484  \u44648 \u45803 \u44172  \u54616 \u44256  \u50500 \u51649 \u46020  \u51020 \u48512 \u51032  \u44396 \u45929 \u51060 \u50640 \u49436  \u44536 \u45285  \u51104 \u51088 \u44256  \u51080 \u45716  \u51088 \u46308 \u51012  \u44648 \u50864 \u45716  \u51068 \u51012  \u54624  \u49688  \u50630 \u45796 . \u49324 \u46020  \u48148 \u50872 \u51008  \'91\u50984 \u48277 \u51004 \u47196  \u51396 \u47484  \u44648 \u45803 \u44172  \u54620 \u45796 \'92\u44256  \u47568 \u54620 \u45796 . \u49324 \u46988 \u51060  \u51396 \u47484  \u44648 \u45803 \u44592  \u51204 \u50640 \u45716  \u44536 \u47532 \u49828 \u46020 \u51032  \u48372 \u54792 \u47196  \u47568 \u48120 \u50516 \u50500  \u49549 \u47049 \u51012  \u48155 \u50500 \u50556  \u54624  \u54596 \u50836 \u49457 \u51012  \u51652 \u51221 \u51004 \u47196  \u45712 \u45180 \u51648  \u50500 \u45768 \u54620 \u45796 . \'85\'91\u44148 \u44053 \u54620  \u51088 \u50640 \u44172 \u45716  \u51032 \u50896 \u51060  \u50424 \u45936 \u50630 \u44256  \u48337 \u46304  \u51088 \u50640 \u44172 \u46972 \u50556  \u50424 \u45936  \u51080 \u45712 \u45768 \u46972 .\'92 \u44148 \u44053 \u54620  \u51088 , \u54841 \u51008  \u49828 \u49828 \u47196  \u44148 \u44053 \u54620  \u51460 \u47196  \u49373 \u44033 \u54616 \u45716  \u51088 \u47484  \u50948 \u54616 \u50668  \u51032 \u50896 \u51012  \u48512 \u47476 \u45716  \u44163 \u51008  \u50612 \u47532 \u49437 \u51008  \u51068 \u51060 \u45796 . \u44536 \u45824 \u46308 \u51008  \u47676 \u51200  \u44536 \u46308 \u50640 \u44172  \u44536 \u46308 \u51060  \u48337 \u46304  \u49324 \u46988 \u51064  \u44163 \u51012  \u44648 \u45803 \u44172  \u54616 \u50668 \u50556  \u54624  \u44163 \u51060 \u45796 . \u44536 \u47111 \u44172  \u54616 \u51648  \u50500 \u45768 \u54616 \u47732  \u44536 \u45824 \u46308 \u51032  \u49688 \u44256 \u50640  \u45824 \u54616 \u50668  \u44536 \u46308 \u51008  \u44048 \u49324 \u55176  \u50668 \u44592 \u51648  \u50500 \u45768 \u54624  \u44163 \u51060 \u45796 . \u51060 \u50752  \u44057 \u51060  \u51088 \u44592 \u44032  \u50756 \u51204 \u54616 \u45796 \u44256  \u49373 \u44033 \u54616 \u44256  \u50500 \u51649  \u44536  \u47560 \u51020 \u51012  \u44648 \u46888 \u47532 \u51648  \u50500 \u45768 \u54620  \u51088 \u50640 \u44172  \u44536 \u47532 \u49828 \u46020 \u47484  \u44032 \u47476 \u52824 \u45716  \u44163 \u51008  \u50612 \u47532 \u49437 \u51008  \u51068 \u51060 \u45796 \'94 (Wesley\'92s Sermon 35).\
