\u44273 \u51032  \u51068 \u54665 \u46308 \u51008  \u48148 \u50556 \u55120 \u47196  \u54253 \u47141 \u44284  \u49332 \u50977 \u51004 \u47196  \u49549 \u51208 \u50630 \u51060  \u55148 \u49373 \u45817 \u54624  \u49688 \u48150 \u50640  \u50630 \u51012  \u44163 \u52376 \u47100  \u48372 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u48520 \u50504 \u44284  \u44277 \u54252 \u51032  \u47924 \u44144 \u50868  \u51664 \u50640  \u51088 \u52293 \u51032  \u51664 \u51060  \u46608 \u54620  \u52392 \u44032 \u46104 \u50632 \u45796 . \u50780 \u45264 \u54616 \u47732  \u44536  \u50948 \u44592 \u45716  \u51088 \u44592  \u51088 \u49888 \u51032  \u51396  \u46412 \u47928 \u50640  \u52488 \u47000 \u46108  \u44163 \u51060 \u50632 \u44592  \u46412 \u47928 \u51060 \u45796 . \u44536 \u51032  \u50976 \u51068 \u54620  \u55148 \u47581 \u51008  \u50724 \u51649  \u54616 \u45208 \u45784 \u51032  \u51008 \u54812 \u50640  \u47588 \u45804 \u47532 \u45716  \u44163 \u51060 \u50632 \u45796 . \u44536 \u51032  \u50976 \u51068 \u54620  \u48169 \u50612 \u52293 \u51008  \u44592 \u46020 \u54616 \u45716  \u44600 \u49104 \u51060 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u51088 \u44592  \u54805 \u50640 \u44172  \u51096 \u47803 \u51012  \u44058 \u44256  \u46608 \u54620  \u50948 \u54801 \u45817 \u54616 \u44256  \u51080 \u45716  \u50948 \u54744 \u50640 \u49436  \u48279 \u50612 \u45208 \u44592  \u50948 \u54616 \u50668  \u51088 \u44592 \u47196 \u49436  \u54644 \u50556  \u54624  \u51068 \u51008  \u54616 \u45208 \u46020  \u45224 \u44608 \u50630 \u51060  \u45796 \u54664 \u45796 . \u51060 \u50752  \u44057 \u51060  \u44536 \u47532 \u49828 \u46020 \u47484  \u46384 \u47476 \u45716  \u51088 \u46308 \u51008  \u54872 \u45212 \u51032  \u49884 \u44592 \u44032  \u44032 \u44620 \u50892  \u50740 \u50640  \u46384 \u46972  \u49324 \u46988 \u46308  \u50526 \u50640 \u49436  \u51088 \u49888 \u46308 \u51012  \u50732 \u48148 \u47480  \u50948 \u52824 \u50640  \u45459 \u44256  \u54200 \u44204 \u51012  \u51228 \u44144 \u5