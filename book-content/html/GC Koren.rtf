\uc0\u49457 \u44221 \u50640  \u44228 \u49884 \u46108  \u44032 \u51109  \u50628 \u49689 \u54616 \u44256  \u50689 \u44305 \u49828 \u47084 \u50868  \u51652 \u47532  \u44032 \u50868 \u45936  \u54616 \u45208 \u45716  \u44396 \u50896 \u51032  \u50948 \u45824 \u54620  \u49324 \u50629 \u51012  \u50756 \u49457 \u54616 \u44592  \u50948 \u54620  \u44536 \u47532 \u49828 \u46020 \u51032  \u51116 \u47548 \u50640  \u44288 \u54620  \u51652 \u47532 \u51060 \u45796 . \u50724 \u47019 \u46041 \u50504  \'93\u49324 \u47581 \u51032  \u51020 \u52840 \u54620  \u44264 \u51676 \u44592 \'94\u50640 \u49436  \u48169 \u54889 \u54616 \u46020 \u47197  \u48260 \u47140 \u51276 \u45912  \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u46308 \u50640 \u44172  \u48512 \u54876 \u51060 \u50836  \u49373 \u47749 \u51060 \u49888  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u45817 \u49888 \u51032  \u48260 \u47548 \u48155 \u51008  \u48177 \u49457 \u46308 \u51012  \u48376 \u54693 \u51004 \u47196  \u45936 \u47140 \u44032 \u44592  \u50948 \u54616 \u50668  \u45796 \u49884  \u50724 \u49888 \u45796 \u45716  \u50557 \u49549 \u51008  \u44480 \u51473 \u54616 \u44256  \u44592 \u49256 \u50640  \u45336 \u52824 \u45716  \u49548 \u47581 \u51012  \u51452 \u44256  \u51080 \u45796 . \u51116 \u47548 \u51032  \u44368 \u47532 \u45716  \u48148 \u47196  \u49457 \u44221 \u51032  \u44540 \u48376 \u51201  \u51452 \u51228 \u51060 \u45796 . \u51064 \u47448 \u51032  \u49884 \u51312  \u50500 \u45812 \u44284  \u54616 \u50752 \u44032  \u50640 \u45940 \u46041 \u49328 \u50640 \u49436  \u49836 \u54536  \u48156 \u44152 \u51020 \u51012  \u46028 \u51060 \u53416  \u54980 \u48512 \u53552  \u48127 \u51020 \u51032  \u51088 \u45376 \u46308 \u51008  \u54028 \u44340 \u51088 \u51032  \u49464 \u47141 \u51012  \u44648 \u46888 \u47532 \u44256  \u51075 \u50612 \u48260 \u47536  \u45209 \u50896 \u51012  \u45796 \u49884  \u54924 \u48373 \u49884 \u53020  \u51460  \u50616 \u50557 \u51032  \u44396 \u51452 \u44032  \u45208 \u53440 \u45208 \u44592 \u47484  \u44256 \u45824 \u54644  \u50772 \u45796 . \u50715 \u45216 \u51032  \u49457 \u46020 \u46308 \u46020  \u44536 \u46308 \u51032  \u55148 \u47581 \u51032  \u49457 \u52712 \u47196 \u49436  \u50689 \u44305 \u51032  \u47700 \u49884 \u50556 \u44032  \u45208 \u53440 \u45208 \u44592 \u47484  \u44256 \u45824 \u54644  \u50772 \u45796 . \u50640 \u45940  \u45209 \u50896 \u50640  \u44144 \u54616 \u45912  \u49884 \u51312 \u47196 \u48512 \u53552  \u48520 \u44284  7\u45824  \u51088 \u49552 \u50640  \u54644 \u45817 \u54616 \u47728  3\u48177  \u45380  \u46041 \u50504  \u54616 \u45208 \u45784 \u44284  \u46041 \u54665 \u54664 \u45912  \u50640 \u45433 \u51008  \u50724 \u47004  \u54980 \u50640  \u51080 \u51012  \u44396 \u51452 \u51032  \u51116 \u47548 \u51012  \u48148 \u46972 \u48380  \u49688  \u51080 \u45716  \u53945 \u44428 \u51012  \u48155 \u50520 \u45796 . \u44536 \u45716  \'93\u48372 \u46972  \u51452 \u44760 \u49436  \u44536  \u49688 \u47564 \u51032  \u44144 \u47337 \u54620  \u51088 \u50752  \u54632 \u44760  \u51076 \u54616 \u49512 \u45208 \u45768  \u51060 \u45716  \u47943 \u49324 \u46988 \u51012  \u49900 \u54032 \u54616 \u49324 \'94 (\u50976  1:14, 15) \u46972 \u44256  \u47568 \u54616 \u50688 \u45796 . \u46608  \u51313 \u51109  \u50853 \u51008  \u44536 \u44032  \u44256 \u53685 \u51012  \u45817 \u54616 \u45912  \u48164 \u50640  \u51088 \u49888 \u51032  \u54869 \u44256 \u54620  \u49888 \u50521 \u51012  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u54616 \u50688 \u45796 . \'93\u45236 \u44032  \u50508 \u44592 \u50640 \u45716  \u45208 \u51032  \u44396 \u49549 \u51088 \u44032  \u49332 \u50500  \u44228 \u49884 \u45768  \u54980 \u51068 \u50640  \u44536 \u44032  \u46405  \u50948 \u50640  \u49436 \u49892  \u44163 \u51060 \u46972 \'85\u45236 \u44032  \u52828 \u55176  \u44536 \u47484  \u48372 \u47532 \u45768  \u45236  \u45576 \u51004 \u47196  \u44536 \u47484  \u48372 \u44592 \u47484  \u50808 \u51064 \u52376 \u47100  \u54616 \u51648  \u50506 \u51012  \u44163 \u51060 \u46972 \'94 (\u50853  19:25~27).\
\uc0\u51032 \u51032  \u49884 \u45824 \u47484  \u46020 \u47000 \u52992  \u54624  \u44536 \u47532 \u49828 \u46020 \u51032  \u51116 \u47548 \u51008  \u49457 \u44221 \u51032  \u44592 \u51088 \u46308 \u51060  \u44032 \u51109  \u51109 \u50628 \u54616 \u44256  \u49709 \u44256 \u54620  \u47568 \u47196 \u50024  \u44536  \u49324 \u44148 \u51012  \u54364 \u54788 \u54616 \u46020 \u47197  \u44048 \u46041 \u51012  \u51452 \u50632 \u45796 . \u49457 \u44221 \u50640  \u45208 \u50724 \u45716  \u49884 \u51064 \u46308 \u44284  \u49440 \u51648 \u51088 \u46308 \u51008  \u54616 \u45720 \u51032  \u46888 \u44144 \u50868  \u48520 \u47196  \u44536  \u47560 \u51020 \u46308 \u51060  \u44048 \u46041 \u46104 \u50612  \u51116 \u47548 \u51012  \u45432 \u47000 \u54616 \u44256  \u47568 \u54616 \u50688 \u45796 . \u49884 \u54200  \u44592 \u51088 \u45716  \u51060 \u49828 \u46972 \u50648 \u51032  \u50773 \u51004 \u47196  \u50724 \u49884 \u45716  \u51060 \u51032  \u44428 \u45733 \u44284  \u50948 \u50628 \u51012  \u45432 \u47000 \u54616 \u50688 \u45796 . \'93\u50728 \u51204 \u55176  \u50500 \u47492 \u45796 \u50868  \u49884 \u50728 \u50640 \u49436  \u54616 \u45208 \u45784 \u51060  \u48731 \u51012  \u48156 \u54616 \u49512 \u46020 \u45796  \u50864 \u47532  \u54616 \u45208 \u45784 \u51060  \u51076 \u54616 \u49324  \u51104 \u51104 \u52824  \u50500 \u45768 \u54616 \u49884 \u45768 \'85\u54616 \u45208 \u45784 \u51060  \u44536  \u48177 \u49457 \u51012  \u54032 \u45800 \u54616 \u49884 \u47140 \u44256  \u50948  \u54616 \u45720 \u44284  \u50500 \u47000  \u46405 \u50640  \u48152 \u54252 \u54616 \u50668 \'94 \'93\u54616 \u45720 \u51008  \u44592 \u48848 \u54616 \u44256  \u46405 \u51008  \u51600 \u44144 \u50892 \u54616 \u47728 \'85\u51200 \u44032  \u51076 \u54616 \u49884 \u46104  \u46405 \u51012  \u54032 \u45800 \u54616 \u47140  \u51076 \u54616 \u49892  \u44163 \u51076 \u51060 \u46972  \u51200 \u44032  \u51032 \u47196  \u49464 \u44228 \u47484  \u54032 \u45800 \u54616 \u49884 \u47728  \u44536 \u51032  \u51652 \u49892 \u54616 \u49900 \u51004 \u47196  \u48177 \u49457 \u51012  \u54032 \u45800 \u54616 \u49884 \u47532 \u47196 \u45796 \'94 (\u49884  50:2~4, 96:11, 13).\
\uc0\u49440 \u51648 \u51088  \u51060 \u49324 \u50556 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u54616 \u50688 \u45796 . \'93\u54000 \u45132 \u50640  \u44144 \u54616 \u45716  \u51088 \u46308 \u50500  \u45320 \u55148 \u45716  \u44648 \u50612  \u45432 \u47000 \u54616 \u46972  \u51452 \u51032  \u51060 \u49836 \u51008  \u48731 \u45212  \u51060 \u49836 \u51060 \u45768  \u46405 \u51060  \u51453 \u51008  \u51088 \u47484  \u45236 \u50612  \u45459 \u51004 \u47532 \u47196 \u45796 \'94, \'93\u51452 \u51032  \u51453 \u51008  \u51088 \u46308 \u51008  \u49332 \u50500 \u45208 \u44256  \u50864 \u47532 \u51032  \u49884 \u52404 \u46308 \u51008  \u51068 \u50612 \u45208 \u47532 \u51060 \u45796 \'94, \'93\u49324 \u47581 \u51012  \u50689 \u50896 \u55176  \u47736 \u54616 \u49892  \u44163 \u51060 \u46972  \u51452  \u50668 \u54840 \u50752 \u44760 \u49436  \u47784 \u46304  \u50620 \u44404 \u50640 \u49436  \u45576 \u47932 \u51012  \u50491 \u44592 \u49884 \u47728  \u44536  \u48177 \u49457 \u51032  \u49688 \u52824 \u47484  \u50728  \u52380 \u54616 \u50640 \u49436  \u51228 \u54616 \u49884 \u47532 \u46972  \u50668 \u54840 \u50752 \u44760 \u49436  \u51060 \u44057 \u51060  \u47568 \u50432 \u54616 \u49512 \u45712 \u45768 \u46972  \u44536 \u45216 \u50640  \u47568 \u54616 \u44592 \u47484  \u51060 \u45716  \u50864 \u47532 \u51032  \u54616 \u45208 \u45784 \u51060 \u49884 \u46972  \u50864 \u47532 \u44032  \u44536 \u47484  \u44592 \u45796 \u47160 \u51004 \u45768  \u44536 \u44032  \u50864 \u47532 \u47484  \u44396 \u50896 \u54616 \u49884 \u47532 \u47196 \u45796  \u51060 \u45716  \u50668 \u54840 \u50752 \u49884 \u46972  \u50864 \u47532 \u44032  \u44536 \u47484  \u44592 \u45796 \u47160 \u51004 \u45768  \u50864 \u47532 \u45716  \u44536  \u44396 \u50896 \u51012  \u44592 \u48848 \u54616 \u47728  \u51600 \u44144 \u50892 \u54616 \u47532 \u46972 \'94 (\u49324  26:19, 25:8, 9).\
\uc0\u54616 \u48149 \u44397 \u46020  \u44144 \u47337 \u54620  \u44228 \u49884 \u47484  \u53685 \u54616 \u50668  \u44536 \u48516 \u51032  \u45208 \u53440 \u45208 \u49900 \u51012  \u48372 \u50520 \u45796 . \'93\u54616 \u45208 \u45784 \u51060  \u45936 \u47564 \u50640 \u49436 \u48512 \u53552  \u50724 \u49884 \u47728  \u44144 \u47337 \u54620  \u51088 \u44032  \u48148 \u46976 \u49328 \u50640 \u49436 \u48512 \u53552  \u50724 \u49884 \u46020 \u45796  \u44536  \u50689 \u44305 \u51060  \u54616 \u45720 \u51012  \u45934 \u50632 \u44256  \u44536  \u52268 \u49569 \u51060  \u49464 \u44228 \u50640  \u44032 \u46301 \u54616 \u46020 \u45796  \u44536  \u44305 \u47749 \u51060  \u54663 \u48731  \u44057 \u44256 \'94, \'93\u44536 \u44032  \u49436 \u49888 \u51593  \u46405 \u51060  \u51652 \u46041 \u54616 \u47728  \u44536 \u44032  \u48372 \u49888 \u51593  \u50676 \u44397 \u51060  \u51204 \u50984 \u54616 \u47728  \u50689 \u50896 \u54620  \u49328 \u51060  \u47924 \u45320 \u51648 \u47728  \u47924 \u44417 \u54620  \u51089 \u51008  \u49328 \u51060  \u50638 \u46300 \u47084 \u51648 \u45208 \u45768  \u44536  \u54665 \u54616 \u49900 \u51060  \u50696 \u47196 \u48512 \u53552  \u44536 \u47084 \u54616 \u49884 \u46020 \u45796 \'94, \'93\u50668 \u54840 \u50752 \u50668  \u51452 \u44760 \u49436  \u47568 \u51012  \u53440 \u49884 \u47728  \u44396 \u50896 \u51032  \u48337 \u44144 \u47484  \u47784 \u49884 \u50724 \u45768 \'85\u49328 \u46308 \u51060  \u51452 \u47484  \u48372 \u44256  \u55124 \u46308 \u47532 \u47728 \'94, \'93\u48148 \u45796 \u44032  \u49548 \u47532 \u47484  \u51648 \u47476 \u47728  \u49552 \u51012  \u45458 \u51060  \u46308 \u50632 \u45208 \u51060 \u45796  \u51452 \u51032  \u45216 \u51004 \u45716  \u49332 \u51032  \u48731 \u44284  \u51452 \u51032  \u48264 \u51789 \u51060 \u45716  \u52285 \u51032  \u44305 \u52292 \u47196  \u51064 \u54616 \u50668  \u54644 \u50752  \u45804 \u51060  \u44536  \u52376 \u49548 \u50640  \u47688 \u52628 \u50632 \u45208 \u51060 \u45796 \'85\u51452 \u44760 \u49436  \u51452 \u51032  \u48177 \u49457 \u51012  \u44396 \u50896 \u54616 \u49884 \u47140 \u44256  \u44592 \u47492 \u48155 \u51008  \u51088 \u47484  \u44396 \u50896 \u54616 \u49884 \u47140 \u44256  \u45208 \u50724 \'85\u49512 \u45208 \u51060 \u45796 \'94 (\u54633  3:3~13).\
