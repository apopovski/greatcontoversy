\uc0\u44060 \u54785  \u49324 \u50629 \u51008  \u49464 \u49345 \u51032  \u44256 \u44288 \u46308  \u50526 \u50640  \u45908 \u50865  \u46160 \u46300 \u47084 \u51648 \u44172  \u46300 \u47084 \u45208 \u44172  \u46112  \u44163 \u51060 \u50632 \u45796 . \u48373 \u51020 \u51452 \u51032  \u51228 \u54980 \u46308 \u51032  \u54840 \u49548 \u44032  \u54168 \u47476 \u46356 \u45212 \u53944  \u50773 \u51004 \u47196  \u47568 \u48120 \u50516 \u50500  \u44284 \u44144 \u50640 \u45716  \u44144 \u48512 \u46104 \u50632 \u51648 \u47560 \u45716  \u51648 \u44552 \u51008  \u54889 \u51228 \u47484  \u48708 \u47215 \u54616 \u50668  \u44397 \u44032 \u50752  \u44368 \u54924 \u51032  \u44256 \u44288 \u46308 \u51060  \u50676 \u49437 \u54620  \u51088 \u47532 \u50640 \u49436  \u44536 \u46308 \u51032  \u49324 \u50629 \u51012  \u51652 \u49696 \u54624  \u44592 \u54924 \u47484  \u44054 \u44172  \u46104 \u50632 \u45796 . \u51228 \u44397 \u51012  \u44340 \u47213 \u55180  \u48516 \u51137 \u51012  \u51652 \u51221 \u49884 \u53412 \u44592  \u50948 \u54616 \u50668  \u49828 \u54028 \u51060 \u50620 \u49828 \u51032  \u54637 \u51032 \u44032  \u51080 \u50632 \u45912  \u51060 \u46316 \u54644 \u50640  \u52852 \u50508  5\u49464 \u45716  \u50500 \u50864 \u53356 \u49828 \u48512 \u47476 \u53356 \u50640 \u49436  \u51032 \u54924 \u47484  \u49548 \u51665 \u54616 \u50688 \u45796 . \u46608 \u54620  \u44536 \u44032  \u52828 \u55176  \u44536  \u51032 \u54924 \u47484  \u51452 \u51116 \u54624  \u44163 \u51060 \u46972 \u45716  \u44536 \u51032  \u51032 \u54693 \u46020  \u48156 \u54364 \u46104 \u50632 \u45796 . \u44144 \u44592 \u50640  \u44060 \u54785 \u54028 \u51032  \u51648 \u46020 \u51088 \u46308 \u46020  \u49548 \u51665 \u46104 \u50632 \u45796 .\
\uc0\u53360  \u50948 \u54744 \u46308 \u51060  \u44060 \u54785  \u49324 \u50629 \u51012  \u50948 \u54801 \u54616 \u50688 \u51004 \u45208  \u44536  \u49324 \u50629 \u51032  \u50745 \u54840 \u51088 \u46308 \u51008  \u44536 \u46308 \u51032  \u49324 \u50629 \u51012  \u50668 \u51204 \u55176  \u54616 \u45208 \u45784 \u44760  \u51032 \u53441 \u54616 \u44256  \u48373 \u51020 \u50640  \u45824 \u54620  \u51200 \u46308 \u51032  \u53468 \u46020 \u47484  \u44403 \u44172  \u54624  \u44163 \u51012  \u49828 \u49828 \u47196  \u47609 \u49464 \u54616 \u50688 \u45796 . \u51089 \u49468 \u51032  \u49440 \u54980 \u45716  \u44536 \u51032  \u44256 \u47928 \u44288 \u46308 \u47196 \u48512 \u53552  \u51032 \u54924 \u50640  \u45208 \u44032 \u51648  \u47568 \u46972 \u45716  \u44036 \u44257 \u54620  \u48512 \u53441 \u51012  \u48155 \u50520 \u45796 . \u44536 \u46308 \u51008  \u54889 \u51228 \u44032  \u51228 \u54980 \u46308 \u51012  \u54632 \u51221 \u50640  \u48736 \u46888 \u47532 \u44592  \u50948 \u54616 \u50668  \u52280 \u49437 \u54616 \u44592 \u47484  \u50836 \u44396 \u54616 \u50688 \u45796 \u44256  \u47568 \u54616 \u50688 \u45796 . \'93\u44053 \u47141 \u54620  \u50896 \u49688 \u51032  \u49548 \u44404 \u47196  \u51068 \u48512 \u47084  \u46308 \u50612 \u44032 \u45716  \u44163 \u51008  \u50948 \u54744 \u54616 \u44592  \u51677 \u51060  \u50630 \u45716  \u51068 \u51060  \u50500 \u45772 \u44032 ?\'94 \u44536 \u47084 \u45208  \u50612 \u46500  \u49324 \u46988 \u46308 \u51008  \'93\u51228 \u54980 \u46308 \u47196  \u54616 \u50668 \u44552  \u50724 \u47196 \u51648  \u50857 \u44592 \u47484  \u44032 \u51648 \u44256  \u52376 \u49888 \u54616 \u44172  \u54616 \u46972 . \u44536 \u47532 \u54616 \u47732  \u54616 \u45208 \u45784 \u51032  \u49324 \u50629 \u51008  \u48152 \u46300 \u49884  \u44396 \u51312 \u46112  \u44163 \u51060 \u45796 \'94\u46972 \u44256  \u54616 \u50688 \u45796 . \'93\u54616 \u45208 \u45784 \u51008  \u49888 \u49892 \u54616 \u49884 \u48064 \u47196  \u50864 \u47532 \u47484  \u44208 \u45800 \u53076  \u48260 \u47532 \u51648  \u50500 \u45768 \u54616 \u49892  \u44163 \u51060 \u45796 \'94 (D\'92Aubigne, b.14, ch.2) \u44256  \u47336 \u53552 \u45716  \u47568 \u54616 \u50688 \u45796 . \u49440 \u54980 \u45716  \u44536 \u51032  \u49688 \u54665 \u50896 \u51012  \u45936 \u47532 \u44256  \u50500 \u50864 \u53356 \u49828 \u48512 \u47476 \u53356 \u47196  \u46496 \u45228 \u45796 . \u47784 \u46304  \u49324 \u46988 \u46308 \u51060  \u44536 \u47484  \u50948 \u54801 \u54616 \u44256  \u51080 \u45716  \u50948 \u54744 \u51012  \u51096  \u50508 \u44256  \u51080 \u50632 \u51004 \u48064 \u47196 , \u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u52840 \u50872 \u54620  \u50620 \u44404 \u44284  \u44540 \u49900 \u49828 \u47084 \u50868  \u47560 \u51020 \u51004 \u47196  \u44032 \u46301  \u52264  \u51080 \u50632 \u45796 . \u44536 \u47084 \u45208  \u53076 \u48288 \u47476 \u53356 \u44620 \u51648  \u46041 \u54665 \u54664 \u45912  \u47336 \u53552 \u45716  \u44536  \u50668 \u54665 \u50640 \u49436  \u51648 \u51008  \'93\u45236  \u51452 \u45716  \u44053 \u54620  \u49457 \u51060 \u50836 \'94\u46972 \u45716  \u45432 \u47000 \u47196  \u44536 \u46308 \u51032  \u52840 \u52404 \u46104 \u50612  \u44032 \u45716  \u48127 \u51020 \u50640  \u54876 \u44592 \u47484  \u48513 \u46027 \u50500  \u51452 \u50632 \u45796 . \u50689 \u44048 \u51201 \u51064  \u44536  \u45432 \u47019 \u49548 \u47532 \u50640  \u51109 \u52264  \u45796 \u44032 \u50732  \u51068 \u50640  \u45824 \u54620  \u50668 \u47084  \u44032 \u51648  \u50684 \u47140 \u45716  \u49324 \u46972 \u51648 \u44256 , \u47924 \u44161 \u45912  \u47560 \u51020 \u51060  \u44032 \u48316 \u50892 \u51276 \u45796 .\
\uc0\u44060 \u54785 \u54028 \u51032  \u51228 \u54980 \u46308 \u51008  \u44536 \u46308 \u51032  \u44204 \u54644 \u47484  \u49457 \u44221 \u51004 \u47196  \u51077 \u51613 \u54616 \u50668  \u52404 \u44228 \u51201 \u51064  \u51652 \u49696 \u49436 \u47484  \u51032 \u54924 \u50640  \u51228 \u52636 \u54616 \u44592 \u47196  \u44208 \u51221 \u54616 \u44256 , \u44536 \u44163 \u51032  \u51089 \u49457 \u51012  \u47336 \u53552 \u50752  \u47708 \u46976 \u55176 \u53668 \u44284  \u44536 \u51032  \u46041 \u47308 \u46308 \u50640 \u44172  \u50948 \u53441 \u54616 \u50688 \u45796 . \u44060 \u54785 \u54028 \u51032  \u49324 \u46988 \u46308 \u51008  \u51060  \u49888 \u50521  \u44256 \u48177 \u49436 \u47484  \u44536 \u46308 \u51032  \u48127 \u51020 \u51032  \u54644 \u47749 \u49436 \u47196  \u49688 \u46973 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u47784 \u50668 \u49436  \u44536  \u51473 \u50836 \u54620  \u49436 \u47448 \u50640  \u44033 \u44592  \u49436 \u47749 \u54616 \u50688 \u45796 . \u52280 \u51004 \u47196  \u44536 \u44163 \u51008  \u50628 \u49689 \u54616 \u44256 \u46020  \u49888 \u51473 \u54620  \u49692 \u44036 \u51060 \u50632 \u45796 . \u44060 \u54785 \u51088 \u46308 \u51008  \u44536 \u46308 \u51032  \u50868 \u46041 \u51060  \u51221 \u52824  \u47928 \u51228 \u50752  \u54844 \u46041 \u46104 \u51648 \u45208  \u50506 \u51012 \u44620  \u50684 \u47140 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u51333 \u44368 \u44060 \u54785 \u51060  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u50640 \u49436  \u45208 \u50724 \u45716  \u44048 \u54868  \u51060 \u50808 \u50640 \u45716  \u50612 \u46496 \u54620  \u49464 \u47141 \u50640 \u46020  \u46041 \u50836 \u46104 \u51648  \u50506 \u50500 \u50556  \u54620 \u45796 \u44256  \u49373 \u44033 \u54664 \u45796 . \u44536 \u47084 \u48064 \u47196  \u44060 \u54785 \u54028 \u51032  \u51228 \u54980 \u46308 \u51060  \u51060  \u49888 \u50521  \u44256 \u48177 \u49436 \u50640  \u49436 \u47749 \u54616 \u47140 \u44256  \u45208 \u50724 \u51088  \u47708 \u46976 \u55176 \u53668 \u51008  \u44536  \u51068 \u51012  \u51200 \u51648 \u49884 \u53412 \u47732 \u49436  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u54616 \u50688 \u45796 . \'93\u51060 \u44163 \u51008  \u49888 \u54617 \u51088 \u50752  \u47785 \u49324 \u46308 \u51060  \u51228 \u51032 \u54644 \u50556  \u54624  \u47928 \u51228 \u51077 \u45768 \u45796 . \u51060  \u49464 \u49345 \u51032  \u44428 \u49464  \u51080 \u45716  \u49324 \u46988 \u46308 \u51032  \u44428 \u47141 \u51008  \u45796 \u47480  \u51068 \u51012  \u50948 \u54616 \u50668  \u48372 \u47448 \u54616 \u50668  \u46160 \u44256  \u49910 \u49845 \u45768 \u45796 .\'94 \u44536 \u47084 \u45208  \u51089 \u49468 \u51032  \u50836 \u54620  \u54980 \u45716  \u44536  \u47568 \u50640  \u45824 \u45813 \u54616 \u50688 \u45796 . \'93\u45236 \u44032  \u44144 \u44592 \u50640  \u52280 \u44032 \u54616 \u51648  \u47803 \u54620 \u45796 \u45716  \u44163 \u51008  \u47568 \u51060  \u50504  \u46108 \u45796 . \u45208 \u45716  \u45208 \u51032  \u51648 \u50948 \u50640  \u49345 \u44288 \u50630 \u51060  \u51221 \u45817 \u54620  \u51068 \u51060 \u46972 \u47732  \u54644 \u50556  \u54620 \u45796 \u44256  \u44208 \u49900 \u54616 \u44256  \u51080 \u45796 . \u45208 \u46020  \u51452  \u50668 \u54840 \u50752 \u47484  \u48127 \u45716  \u47560 \u51020 \u51012  \u44256 \u48177 \u54616 \u44256 \u51088  \u54620 \u45796 . \u49440 \u54980 \u47196 \u49436 \u51032  \u45208 \u51032  \u51648 \u50948 \u47484  \u45208 \u53440 \u45236 \u45716  \u47784 \u51088 \u50752  \u51032 \u48373 \u51008  \u45208 \u50640 \u44172  \u51080 \u50612 \u49436  \u50696 \u49688  \u44536 \u47532 \u49828 \u46020 \u51032  \u49901 \u51088 \u44032 \u47564 \u53372  \u44480 \u51473 \u54620  \u44163 \u51060  \u50500 \u45768 \u45796 .\'94 \u51060 \u50752  \u44057 \u51060  \u47568 \u51012  \u47560 \u52824 \u44256 , \u44536 \u45716  \u49436 \u47749 \u54616 \u50688 \u45796 . \u46608  \u45796 \u47480  \u51228 \u54980  \u54620  \u49324 \u46988 \u51008  \u48531 \u51012  \u46308 \u44256  \'93\u50696 \u49688  \u44536 \u47532 \u49828 \u46020 \u51032  \u50689 \u44305 \u51012  \u50948 \u54616 \u50668  \u54596 \u50836 \u54620  \u51068 \u51060 \u46972 \u47732  \u45208 \u45716  \u45208 \u51032  \u51116 \u49328 \u44284  \u49373 \u47749 \u44620 \u51648  \u48148 \u52832  \u51456 \u48708 \u44032  \u46104 \u50612  \u51080 \u45796 \'94\u44256  \u47568 \u54616 \u50688 \u45796 . \u46608  \u44228 \u49549 \u54616 \u50668  \'93\u45208 \u45716  \u51060  \u44256 \u48177 \u49436 \u50640  \u45208 \u53440 \u45208  \u51080 \u45716  \u44368 \u47532  \u51060 \u50808 \u51032  \u44163 \u51012  \u48155 \u50500 \u46308 \u51060 \u45716  \u44163 \u48372 \u45796 \u45716  \u52264 \u46972 \u47532  \u44397 \u48124 \u51004 \u47196 \u49436 \u51032  \u44428 \u47532 \u50752  \u49888 \u48516 \u51012  \u54252 \u44592 \u54616 \u44256  \u49440 \u51312 \u47196 \u48512 \u53552  \u47932 \u47140 \u48155 \u51008  \u44397 \u53664 \u46020  \u48260 \u47532 \u44256  \u49552 \u50640  \u51648 \u54049 \u51060 \u47484  \u46308 \u44256  \u51312 \u44397 \u50640 \u49436  \u51923 \u44200 \u45208 \u45716  \u44600 \u51012  \u53469 \u54616 \u44192 \u45796 \'94 (D\'92Aubigne, b.14, ch.6) \u44256  \u47568 \u54616 \u50688 \u45796 . \u44536  \u45817 \u49884 \u50640  \u54616 \u45208 \u45784 \u51032  \u49324 \u46988 \u46308 \u51008  \u51060 \u50752  \u44057 \u51008  \u48127 \u51020 \u44284  \u50857 \u44592 \u47484  \u45208 \u53440 \u45236 \u50632 \u45796 .\
