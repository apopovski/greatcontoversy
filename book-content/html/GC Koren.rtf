1840\uc0\u45380 \u50640 \u45716  \u46608  \u54616 \u45208 \u51032  \u54788 \u51200 \u54620  \u45796 \u47480  \u50696 \u50616 \u51060  \u49457 \u52712 \u46104 \u50612  \u51068 \u48152 \u51032  \u55141 \u48120 \u47484  \u51068 \u51004 \u53040 \u45796 . \u44536  \u49324 \u44148 \u51060  \u51080 \u44592  2\u45380  \u51204 \u50640  \u44536 \u47532 \u49828 \u46020 \u51032  \u51116 \u47548 \u51012  \u51204 \u54616 \u45716  \u54620  \u50976 \u47141 \u54620  \u47785 \u49324 \u51064  \u51312 \u49884 \u50500  \u47532 \u52824 \u45716  \u50724 \u53664 \u47564  \u51228 \u44397 \u51032  \u47792 \u46973 \u51012  \u50696 \u50616 \u54620  \u50836 \u54620 \u44228 \u49884 \u47197  9\u51109 \u51032  \u54644 \u49437 \u51012  \u52293 \u51004 \u47196  \u54196 \u45256 \u45796 . \u44536 \u51032  \u44228 \u49328 \u50640  \u51032 \u54616 \u47732 , \u44536  \u51228 \u44397 \u51008  \'93\u49436 \u44592  1840\u45380  8\u50900 \u51032  \u50612 \u45712  \u46412 \'94\u50640  \u47792 \u46973 \u46112  \u44163 \u51060 \u50632 \u45796 . \u46608 \u54620  \u44536 \u45716  \u44536  \u51068 \u51060  \u49457 \u52712 \u46104 \u44592  \u49688 \u51068  \u51204 \u50640  \u45796 \u51020 \u44284  \u44057 \u51060  \u44592 \u47197 \u54616 \u50688 \u45796 . \'93\u52376 \u51020  \u44592 \u44036  \u44263  150\u45380 \u51060  \u53804 \u47476 \u53356 \u51032  \u49849 \u51064  \u54616 \u50640  \u51060 \u47336 \u50612 \u51652  \u45936 \u50500 \u44256 \u51228 \u49828 \u51032  \u51593 \u50948  \u51204 \u50640  \u48516 \u47749 \u55176  \u49457 \u52712 \u46104 \u44256 , 391\u45380 \u44284  15\u51068 \u51060  \u52376 \u51020  \u44592 \u44036 \u51060  \u47560 \u52824 \u45716  \u46041 \u49884 \u50640  \u49884 \u51089 \u46104 \u50632 \u45796 \u44256  \u54616 \u47732 , \u44536 \u44163 \u51008  1840\u45380  8\u50900  11\u51068 \u51060  \u46108 \u45796 . \u44536 \u46412 \u50640  \u53080 \u49828 \u53444 \u54000 \u45432 \u54540 \u50640  \u51080 \u45716  \u50724 \u53664 \u47564  \u51228 \u44397 \u51032  \u44397 \u50948  (\u22283 \u23041 ) \u44032  \u47792 \u46973 \u46112  \u44163 \u51004 \u47196  \u49373 \u44033 \u54624  \u49688  \u51080 \u45796 . \u45208 \u45716  \u44536  \u51068 \u51060  \u48516 \u47749 \u55176  \u44536 \u47111 \u44172  \u46104 \u47532 \u46972 \u44256  \u48127 \u45716 \u45796 \'94 (Josiah Litch, in Signs of the Times, and Expositor of Prophecy, Aug 1, 1840).\
\uc0\u44284 \u50672  \u44508 \u47749 \u54620  \u48148 \u50752  \u51312 \u44552 \u46020  \u50612 \u44608 \u51060  \u50630 \u51060  \u48148 \u47196  \u44536  \u46412 \u50640  \u53804 \u47476 \u53356 \u45716  \u44536  \u49324 \u51208 \u46308 \u51012  \u53685 \u54616 \u50668  \u50976 \u47101 \u51032  \u46041 \u47609  \u44397 \u44032 \u46308 \u51032  \u48372 \u54840 \u47484  \u48155 \u44592 \u47196  \u49849 \u51064 \u54632 \u51004 \u47196  \u44592 \u46021 \u44368  \u50676 \u44053 \u46308 \u51032  \u51648 \u48176  \u50500 \u47000  \u46308 \u50612 \u44032 \u44172  \u46104 \u50632 \u45796 . \u44536  \u49324 \u44148 \u51008  \u50696 \u50616 \u54620  \u44536 \u45824 \u47196  \u51221 \u54869 \u55176  \u49457 \u52712 \u46104 \u50632 \u45796  (\u48512 \u47197  28 \u52280 \u51312 ). \u51060  \u51068 \u51060  \u51068 \u48152 \u50640 \u44172  \u50508 \u47140 \u51648 \u51088  \u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u48128 \u47084 \u50752  \u44536  \u46041 \u50669 \u51088 \u46308 \u51060  \u51064 \u50857 \u54620  \u50696 \u50616 \u51201  \u54644 \u49437 \u51032  \u50896 \u47532 \u44032  \u51221 \u54869 \u54616 \u45796 \u45716  \u44163 \u51012  \u48127 \u44172  \u46108  \u46041 \u49884 \u50640 , \u51116 \u47548  \u50868 \u46041 \u50640 \u45716  \u45440 \u46972 \u50868  \u48149 \u52264 \u44032  \u44032 \u54644 \u51276 \u45796 . \u44536 \u47532 \u54616 \u50668  \u54617 \u49885 \u51060  \u51080 \u44256  \u51648 \u50948 \u44032  \u45458 \u51008  \u49324 \u46988 \u46308 \u51060  \u48128 \u47084 \u51032  \u51452 \u51109 \u51012  \u48127 \u44256  \u44536 \u51032  \u50868 \u46041 \u50640  \u44032 \u45812 \u54616 \u50668  \u44536 \u51032  \u44204 \u54644 \u47484  \u44053 \u50672 \u44284  \u51200 \u49696 \u47196  \u45328 \u47532  \u51204 \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  1840\u45380 \u50640 \u49436  1844\u45380 \u50640  \u51060 \u47476 \u44592 \u44620 \u51648  \u44536  \u50868 \u46041 \u51008  \u49888 \u49549 \u55176  \u54869 \u51109 \u46104 \u50632 \u45796 .\
