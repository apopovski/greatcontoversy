\'93\uc0\u44536  \u51396 \u45716  \u54616 \u45720 \u50640  \u49324 \u47924 \u52452 \u51004 \u47728  \u54616 \u45208 \u45784 \u51008  \u44536 \u51032  \u48520 \u51032 \u54620  \u51068 \u51012  \u44592 \u50613 \u54616 \u49888 \u51648 \u46972  \u44536 \u44032  \u51456  \u44536 \u45824 \u47196  \u44536 \u50640 \u44172  \u51452 \u44256  \u44536 \u51032  \u54665 \u50948 \u45824 \u47196  \u44049 \u51208 \u51012  \u44058 \u50500  \u51452 \u44256  \u44536 \u51032  \u49438 \u51008  \u51092 \u50640 \u46020  \u44049 \u51208 \u51060 \u45208  \u49438 \u50612  \u44536 \u50640 \u44172  \u51452 \u46972  \u44536 \u44032  \u50612 \u46523 \u44172  \u51088 \u44592 \u47484  \u50689 \u54868 \u47213 \u44172  \u54616 \u50688 \u51004 \u47728  \u49324 \u52824 \u54616 \u50688 \u46304 \u51648  \u44536 \u47564 \u53372  \u44256 \u45212 \u44284  \u50528 \u53685 \u51004 \u47196  \u44058 \u50500  \u51452 \u46972  \u44536 \u44032  \u47560 \u51020 \u50640  \u47568 \u54616 \u44592 \u47484  \u45208 \u45716  \u50668 \u54889 \u51004 \u47196  \u50505 \u51008  \u51088 \u50836  \u44284 \u48512 \u44032  \u50500 \u45768 \u46972  \u44208 \u45800 \u53076  \u50528 \u53685 \u51012  \u45817 \u54616 \u51648  \u50500 \u45768 \u54616 \u47532 \u46972  \u54616 \u45768  \u44536 \u47084 \u48064 \u47196  \u54616 \u47336  \u46041 \u50504 \u50640  \u44536  \u51116 \u50521 \u46308 \u51060  \u51060 \u47476 \u47532 \u45768  \u44263  \u49324 \u47581 \u44284  \u50528 \u53685 \u44284  \u55113 \u45380 \u51060 \u46972  \u44536 \u44032  \u46608 \u54620  \u48520 \u50640  \u49332 \u46972 \u51648 \u47532 \u45768  \u44536 \u47484  \u49900 \u54032 \u54616 \u49888  \u51452  \u54616 \u45208 \u45784 \u51008  \u44053 \u54616 \u49888  \u51088 \u51060 \u49900 \u51060 \u46972  \u44536 \u50752  \u54632 \u44760  \u51020 \u54665 \u54616 \u44256  \u49324 \u52824 \u54616 \u45912  \u46405 \u51032  \u50773 \u46308 \u51060  \u44536  \u48520 \u48537 \u45716  \u50672 \u44592 \u47484  \u48372 \u44256  \u50948 \u54616 \u50668  \u50872 \u44256  \u44032 \u498