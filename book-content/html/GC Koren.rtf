\uc0\u47560 \u51648 \u47561  \u49884 \u45824 \u50640  \u49457 \u52712 \u46112  \u50504 \u49885 \u51068  \u44060 \u54785  \u49324 \u50629 \u51060  \u51060 \u49324 \u50556 \u49436 \u50640  \u45796 \u51020 \u44284  \u44057 \u51060  \u50696 \u50616 \u46104 \u50612  \u51080 \u45796 . \'93\u50668 \u54840 \u50752 \u44760 \u49436  \u51060 \u44057 \u51060  \u47568 \u50432 \u54616 \u49884 \u46104  \u45320 \u55148 \u45716  \u44277 \u54217 \u51012  \u51648 \u53412 \u47728  \u51032 \u47484  \u54665 \u54616 \u46972  \u45208 \u51032  \u44396 \u50896 \u51060  \u44032 \u44620 \u51060  \u50772 \u44256  \u45208 \u51032  \u51032 \u44032  \u49772  \u45208 \u53440 \u45216  \u44163 \u51076 \u51060 \u46972  \u54616 \u50688 \u51008 \u51593  \u50504 \u49885 \u51068 \u51012  \u51648 \u53020  \u45908 \u47101 \u55176 \u51648  \u50500 \u45768 \u54616 \u47728  \u44536  \u49552 \u51012  \u44552 \u54616 \u50668  \u47784 \u46304  \u50501 \u51012  \u54665 \u52824  \u50500 \u45768 \u54616 \u50668 \u50556  \u54616 \u45208 \u45768  \u51060 \u44057 \u51060  \u54665 \u54616 \u45716  \u49324 \u46988 , \u51060 \u44057 \u51060  \u44403 \u51060  \u51105 \u45716  \u51064 \u49373 \u51008  \u48373 \u51060  \u51080 \u45712 \u45768 \u46972 \'94, \'93\u46608  \u45208  \u50668 \u54840 \u50752 \u50640 \u44172  \u50672 \u54633 \u54616 \u50668  \u49452 \u44592 \u47728  \u45208  \u50668 \u54840 \u50752 \u51032  \u51060 \u47492 \u51012  \u49324 \u46993 \u54616 \u47728  \u45208 \u51032  \u51333 \u51060  \u46104 \u47728  \u50504 \u49885 \u51068 \u51012  \u51648 \u53020  \u45908 \u47101 \u55176 \u51648  \u50500 \u45768 \u54616 \u47728  \u45208 \u51032  \u50616 \u50557 \u51012  \u44403 \u44172  \u51648 \u53412 \u45716  \u51060 \u48169 \u51064 \u47560 \u45796  \u45236 \u44032  \u44536 \u47484  \u45208 \u51032  \u49457 \u49328 \u51004 \u47196  \u51064 \u46020 \u54616 \u50668  \u44592 \u46020 \u54616 \u45716  \u45236  \u51665 \u50640 \u49436  \u44536 \u46308 \u51012  \u44592 \u49240 \u44172  \u54624  \u44163 \u51060 \'94 (\u493