\uc0\u51210 \u51008 \u51060 \u46308 \u51008  \u51088 \u44592 \u46308 \u51032  \u47785 \u49324 \u50640 \u44172 \u49436  \u44368 \u50977 \u51012  \u48155 \u50520 \u45796 . \u44536 \u46308 \u51008  \u51068 \u48152 \u51201 \u51064  \u54617 \u47928 \u51012  \u48176 \u50912 \u51012  \u49104 \u47564  \u50500 \u45768 \u46972  \u49457 \u44221 \u51012  \u51473 \u50836 \u54620  \u44284 \u47785 \u51004 \u47196  \u48176 \u50912 \u45796 . \u47560 \u53468 \u48373 \u51020 \u44284  \u50836 \u54620 \u48373 \u51020 \u51012  \u45824 \u48512 \u48516 \u51032  \u49324 \u46020 \u46308 \u51032  \u54200 \u51648 \u49436 \u46308 \u44284  \u54632 \u44760  \u50516 \u44592 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u46608 \u54620  \u49457 \u44221 \u51012  \u48373 \u49324 \u54616 \u50668  \u44592 \u47197 \u54616 \u45716  \u51068 \u46020  \u54616 \u50688 \u45796 . \u50612 \u46500  \u51060 \u46308 \u51008  \u51204 \u48512 \u47484  \u48288 \u45180 \u44256 , \u50612 \u46500  \u51060 \u46308 \u51008  \u44536  \u51068 \u48512 \u48516 \u51012  \u48977 \u50500 \u45240  \u44163 \u50640  \u49457 \u44221  \u54644 \u49437 \u51088 \u51032  \u44036 \u45800 \u54620  \u49444 \u47749 \u51060  \u52392 \u44032 \u46104 \u50612  \u51080 \u45716  \u44163 \u51012  \u48288 \u44808 \u45796 . \u44536 \u44057 \u51060  \u54616 \u50668  \u54616 \u45208 \u45784 \u48372 \u45796 \u45716  \u51088 \u44592 \u47484  \u45458 \u51060 \u44256 \u51088  \u54616 \u45716  \u51088 \u47196  \u47568 \u48120 \u50516 \u50500  \u50724 \u47000  \u49704 \u44592 \u50892 \u51276 \u45912  \u51652 \u47532 \u51032  \u48372 \u48176 \u44032  \u46300 \u46356 \u50612  \u46300 \u47084 \u45208 \u44172  \u46104 \u50632 \u45796 .\
\uc0\u44536 \u46308 \u51008  \u48520 \u44404 \u51032  \u45432 \u47141 \u51004 \u47196 , \u46412 \u47196 \u45716  \u50612 \u46177 \u44256  \u44618 \u51008  \u46041 \u44404  \u49549 \u50640 \u49436  \u54915 \u48520 \u51032  \u55148 \u48120 \u54620  \u48520 \u48731  \u50500 \u47000  \u54620  \u51208  \u46160  \u51208 , \u46608  \u54620  \u51109  \u46160  \u51109  \u49457 \u44221 \u51012  \u48288 \u45180 \u50612  \u45208 \u50500 \u44052 \u45796 . \u51060 \u50752  \u44057 \u51008  \u48169 \u48277 \u51004 \u47196  \u49324 \u50629 \u51008  \u51652 \u54665 \u46104 \u50632 \u44256 , \u54616 \u45208 \u45784 \u51032  \u44228 \u49884 \u46108  \u46907 \u51008  \u49692 \u44552 \u44284  \u44057 \u51060  \u48731 \u45228 \u45796 . \u49884 \u47144 \u51012  \u44204 \u46356 \u50632 \u44592  \u46412 \u47928 \u50640  \u54616 \u45208 \u45784 \u51032  \u46907 \u51060  \u50620 \u47560 \u47564 \u53372 \u51060 \u45208  \u48157 \u44256  \u48516 \u47749 \u54616 \u44256  \u45733 \u47141  \u51080 \u44172  \u46104 \u50632 \u45716 \u51648  \u49892 \u51228 \u47196  \u44536  \u49324 \u50629 \u50640  \u52280 \u44032 \u54620  \u49324 \u46988  \u51060 \u50808 \u50640 \u45716  \u50508  \u49688  \u50630 \u45716  \u51068 \u51060 \u45796 . \u52380 \u49324 \u46308 \u51008  \u51060 \u52376 \u47100  \u52649 \u49457 \u46108  \u51068 \u44988 \u46308  \u51452 \u50948 \u47484  \u50640 \u50892 \u49912 \u44256  \u51080 \u50632 \u45796 .\
