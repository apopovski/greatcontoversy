\uc0\u54532 \u46993 \u49828  \u44397 \u48124 \u46308 \u51060  \u51060 \u50752  \u44057 \u51060  \u52824 \u47749 \u51201 \u51064  \u51096 \u47803 \u51012  \u48276 \u54620  \u44163 \u51008  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277  \u50504 \u50640  \u51652 \u51221 \u54620  \u51088 \u50976 \u44032  \u51080 \u45796 \u45716  \u50948 \u45824 \u54620  \u51652 \u47532 \u47484  \u44648 \u45803 \u51648  \u47803 \u54664 \u44592  \u46412 \u47928 \u51060 \u50632 \u45796 . \'93\u49836 \u54532 \u45796  \u45348 \u44032  \u45208 \u51032  \u47749 \u47161 \u51012  \u46307 \u51648  \u50500 \u45768 \u54616 \u50688 \u46020 \u45796  \u47564 \u51068  \u46308 \u50632 \u45796 \u47732  \u45348  \u54217 \u50504 \u51060  \u44053 \u44284  \u44057 \u50520 \u44192 \u44256  \u45348  \u51032 \u44032  \u48148 \u45796  \u47932 \u44208  \u44057 \u50520 \u51012  \u44163 \u51060 \u47728 \'94, \'93\u50501 \u51064 \u50640 \u44172  \u54217 \u44053 \u51060  \u50630 \u45796 \'94, \'93\u50724 \u51649  \u45208 \u47484  \u46307 \u45716  \u51088 \u45716  \u50504 \u50672 \u55176  \u49332 \u47728  \u51116 \u50521 \u51032  \u46160 \u47140 \u50880 \u51060  \u50630 \u51060  \u54217 \u50504 \u54616 \u47532 \u46972 \'94 (\u49324  48:18, 22; \u51104  1:33).\
\uc0\u47924 \u49888 \u47200 \u51088 \u46308 \u44284  \u48520 \u49888 \u51088 \u46308 \u44284  \u48176 \u44368 \u51088 \u46308 \u51008  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51012  \u48152 \u45824 \u54616 \u44256  \u48512 \u51064 \u54620 \u45796 . \u44536 \u47084 \u45208  \u44536 \u46308 \u51032  \u50689 \u54693 \u51032  \u44208 \u44284 \u45716  \u51064 \u47448 \u51032  \u48373 \u47532 \u45716  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u50640  \u49692 \u51333 \u54616 \u45716  \u50668 \u48512 \u50640  \u45804 \u47140  \u51080 \u45796 \u45716  \u44163 \u51012  \u51077 \u51613 \u54620 \u45796 . \u51060  \u49324 \u49892 \u51012  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51064  \u49457 \u44221 \u50640 \u49436  \u48176 \u50864 \u51648  \u50506 \u51004 \u47140 \u45716  \u49324 \u46988 \u46308 \u51008  \u44033  \u45208 \u46972 \u51032  \u50669 \u49324 \u50640 \u49436  \u48176 \u50864 \u44172  \u46104 \u50612  \u51080 \u45796 .\
\uc0\u49324 \u45800 \u51060  \u47196 \u47560 \u44368 \u47484  \u53685 \u54616 \u50668  \u49324 \u46988 \u46308 \u51012  \u54616 \u45208 \u45784 \u44760  \u48520 \u49692 \u51333 \u54616 \u46020 \u47197  \u54616 \u50688 \u51012  \u46412 \u50640 \u46020  \u44536 \u45716  \u44536 \u51032  \u51068 \u51012  \u44048 \u52628 \u50632 \u45796 . \u44536 \u47084 \u48064 \u47196  \u44536 \u45716  \u48512 \u54056 \u50752  \u48520 \u54665 \u51060  \u48148 \u47196  \u48276 \u51396 \u51032  \u44208 \u44284 \u51064  \u44163 \u51012  \u49324 \u46988 \u46308 \u51060  \u44648 \u45803 \u51648  \u47803 \u54616 \u46020 \u47197  \u44536 \u51032  \u51068 \u51012  \u50500 \u51452  \u44368 \u47896 \u54616 \u44172  \u44032 \u51109 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u51032  \u49464 \u47141 \u51008  \u49457 \u47161 \u51032  \u50669 \u49324 \u50752  \u45320 \u47924 \u45208  \u48152 \u45824 \u46104 \u50632 \u44592  \u46412 \u47928 \u50640  \u44536 \u51032  \u47785 \u51201 \u51060  \u50756 \u51204 \u55176  \u49457 \u52712 \u46104 \u45716  \u51068 \u51060  \u48169 \u51648 \u46104 \u50632 \u45796 . \u49324 \u46988 \u46308 \u51008  \u50896 \u51064 \u50640 \u49436  \u44208 \u44284 \u47484  \u52286 \u44256 \u51088  \u54616 \u51648  \u50500 \u45768 \u54616 \u50688 \u44592  \u46412 \u47928 \u50640  \u44536 \u46308 \u51060  \u45817 \u54616 \u45716  \u48520 \u54665 \u51032  \u50896 \u51064 \u51012  \u52286 \u51648  \u47803 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u54532 \u46993 \u49828  \u54785 \u47749  \u45817 \u49884 \u50640  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51008  \u44397 \u48124  \u51032 \u54924 \u50640 \u49436  \u44277 \u44277 \u50672 \u54616 \u44172  \u48176 \u52377 \u46104 \u50632 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536  \u54980 \u50640  \u44228 \u49549 \u46108  \u44277 \u54252  \u49884 \u45824 \u47484  \u53685 \u54616 \u50668  \u50896 \u51064 \u50640 \u49436  \u44208 \u44284 \u44032  \u45208 \u50728 \u45796 \u45716  \u49324 \u49892 \u51