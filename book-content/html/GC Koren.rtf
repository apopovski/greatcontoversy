\uc0\u51452 \u50948 \u51032  \u50516 \u55121 \u50640  \u48708 \u54616 \u50668  4\u48176 \u45208  \u48157 \u51008  \u48324 \u48731 \u51060  \u44396 \u47492  \u49324 \u51060 \u50640 \u49436  \u48708 \u52828 \u45796 . \u44536 \u44163 \u51008  \u52649 \u49457 \u46108  \u51088 \u46308 \u50640 \u44172 \u45716  \u55148 \u47581 \u44284  \u44592 \u49256 \u51012  \u47568 \u54644  \u51452 \u51648 \u47560 \u45716  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51012  \u48276 \u54620  \u51088 \u46308 \u50640 \u44172 \u45716  \u50416 \u46972 \u47548 \u44284  \u51652 \u45432 \u47484  \u50508 \u47140  \u51456 \u45796 . \u44536 \u47532 \u49828 \u46020 \u47484  \u50948 \u54616 \u50668  \u47784 \u46304  \u44163 \u51012  \u55148 \u49373 \u54620  \u49324 \u46988 \u46308 \u51008  \u51060 \u51228  \u50504 \u51204 \u54616 \u44172  \u46104 \u50612  \u50668 \u54840 \u50752 \u51032  \u51008 \u48128 \u54620  \u51109 \u47561 \u50640  \u49704 \u51008  \u44163 \u44284  \u44057 \u45796 . \u44536 \u46308 \u51008  \u48268 \u50024  \u49884 \u54744 \u51012  \u48155 \u44256  \u49464 \u49345 \u44284  \u51652 \u47532 \u47484  \u47736 \u49884 \u54616 \u45716  \u51088 \u46308  \u50526 \u50640 \u49436  \u44536 \u46308 \u51012  \u50948 \u54616 \u50668  \u46028 \u50500 \u44032 \u49888  \u44536 \u47532 \u49828 \u46020 \u44760  \u45824 \u54620  \u52649 \u49457 \u51012  \u51077 \u51613 \u54616 \u50688 \u45796 . \u48148 \u47196  \u51453 \u51020 \u51012  \u50526 \u50640  \u46160 \u44256  \u52649 \u49457 \u51012  \u44403 \u44172  \u51648 \u53416  \u51088 \u46308 \u50640 \u44172 \u45716  \u45440 \u46972 \u50868  \u48320 \u54868 \u44032  \u49373 \u44220 \u45796 . \u44536 \u46308 \u51008  \u50501 \u47560 \u47196  \u48320 \u54620  \u49324 \u46988 \u46308 \u51032  \u50612 \u46177 \u44256  \u47924 \u49436 \u50868  \u54252 \u54617 \u50640 \u49436  \u44049 \u51088 \u44592  \u44396 \u50896 \u51012  \u48155 \u50520 \u45796 . \u51312 \u44552  \u51204 \u44620 \u51648  \u52285 \u48177 \u54616 \u44256  \u48520 \u50504 \u54616 \u44256  \u47568 \u46972 \u48736 \u51256  \u51080 \u45912  \u44536 \u46308 \u51032  \u50620 \u44404 \u51008  \u51060 \u51228  \u44221 \u51060 \u50752  \u48127 \u51020 \u44284  \u49324 \u46993 \u51004 \u47196  \u48731 \u45212 \u45796 . \u44536 \u46308 \u51008  \u49849 \u47532 \u51032  \u45432 \u47000 \u47484  \u48512 \u47480 \u45796 . \'93\u54616 \u45208 \u45784 \u51008  \u50864 \u47532 \u51032  \u54588 \u45212 \u52376 \u49884 \u50836  \u55192 \u51060 \u49884 \u45768  \u54872 \u45212  \u51473 \u50640  \u47564 \u45216  \u53360  \u46020 \u50880 \u51060 \u49884 \u46972  \u44536 \u47084 \u48064 \u47196  \u46405 \u51060  \u48320 \u54616 \u46304 \u51648  \u49328 \u51060  \u55124 \u46308 \u47140  \u48148 \u45796  \u44032 \u50868 \u45936  \u48736 \u51648 \u46304 \u51648  \u48148 \u45815 \u47932 \u51060  \u55113 \u50857 \u54616 \u44256  \u46832 \u45440 \u46304 \u51648  \u44536 \u44163 \u51060  \u45336 \u52840 \u51004 \u47196  \u49328 \u51060  \u50836 \u46041 \u54624 \u51648 \u46972 \u46020  \u50864 \u47532 \u45716  \u46160 \u47140 \u50892  \u50500 \u45768 \u54616 \u47532 \u47196 \u45796 \'94 (\u49884  46:1~3).\
\uc0\u51060  \u44144 \u47337 \u54620  \u49888 \u47280 \u51032  \u47568 \u50432 \u51060  \u54616 \u45208 \u45784 \u44760 \u47196  \u50732 \u46972 \u44040  \u46412  \u44396 \u47492 \u51008  \u55145 \u50612 \u51648 \u44256  \u48324 \u48731 \u51060  \u52268 \u46976 \u54620  \u54616 \u45720 \u51060  \u45208 \u53440 \u45208 \u45716 \u45936  \u44536 \u44163 \u51008  \u51340 \u50864 \u54200 \u50640  \u51080 \u45716  \u50612 \u46177 \u44256  \u54744 \u50501 \u54620  \u54616 \u45720 \u50640  \u48708 \u54616 \u50668  \u47568 \u54624  \u49688  \u50630 \u51060  \u50689 \u44305 \u49828 \u47101 \u45796 . \u54616 \u45720  \u46020 \u49457 \u51032  \u50689 \u44305 \u51060  \u44536  \u50676 \u47536  \u47928 \u50640 \u49436  \u55128 \u47084 \u45208 \u50728 \u45796 . \u44536  \u46412 \u50640  \u44277 \u51473 \u50640 \u45716  \u51217 \u52432 \u51652  \u46160  \u46028 \u48708 \u47484  \u51540  \u49552 \u51060  \u45208 \u53440 \u45212 \u45796 . \u49440 \u51648 \u51088 \u45716  \u47568 \u54620 \u45796  \'93\u54616 \u45720 \u51060  \u44536  \u44277 \u51032 \u47484  \u49440 \u54252 \u54616 \u47532 \u45768  \u54616 \u45208 \u45784  \u44536 \u45716  \u49900 \u54032 \u51109 \u51060 \u49900 \u51060 \u47196 \u45796 \'94 (\u49884  50:6). \u49884 \u45236 \u49328 \u50640 \u49436  \u48520 \u44867 \u44284  \u50864 \u47112  \u44032 \u50868 \u45936  \u49373 \u50528 \u51032  \u51648 \u46020  \u50896 \u47532 \u47196  \u49440 \u54252 \u46108  \u44144 \u47337 \u54620  \u50984 \u48277 , \u44263  \u54616 \u45208 \u45784 \u51032  \u51032 \u45716  \u51060 \u51228  \u49900 \u54032 \u51032  \u54364 \u51456 \u51004 \u47196  \u49324 \u46988 \u46308 \u50640 \u44172  \u45208 \u53440 \u45212 \u45796 . \u44536  \u49552 \u51060  \u46028 \u48708 \u47484  \u54196 \u51088  \u48520 \u44284  \u44057 \u51008  \u44544 \u51088 \u47196  \u44592 \u47197 \u46108  \u49901 \u44228 \u47749 \u51060  \u45208 \u53440 \u45212 \u45796 . \u44536  \u50612 \u44396 \u46308 \u51008  \u45320 \u47924 \u46020  \u48516 \u47749 \u54616 \u44592  \u46412 \u47928 \u50640  \u47784 \u46304  \u49324 \u46988 \u51060  \u51069 \u51012  \u49688  \u51080 \u45796 . \u49324 \u46988 \u51032  \u44592 \u50613 \u47141 \u51008  \u51068 \u44648 \u50892 \u51648 \u44256 , \u44033  \u49324 \u46988 \u51032  \u47560 \u51020 \u50640 \u49436  \u48120 \u49888 \u44284  \u51060 \u45800 \u51032  \u50516 \u55121 \u51008  \u49324 \u46972 \u51652 \u45796 . \u44036 \u45800 \u54616 \u47732 \u49436 \u46020  \u54252 \u44292 \u51201 \u51060 \u47728  \u44428 \u50948  \u51080 \u45716  \u54616 \u45208 \u45784 \u51032  \u49901 \u44228 \u47749 \u51060  \u51060  \u46405 \u51032  \u47784 \u46304  \u44144 \u48124 \u46308 \u50640 \u44172  \u48380  \u49688  \u51080 \u44172  \u51228 \u49884 \u46108 \u45796 .\
\uc0\u54616 \u45208 \u45784 \u51032  \u44144 \u47337 \u54620  \u50984 \u48277 \u51012  \u50976 \u47536 \u54620  \u51088 \u46308 \u51032  \u44277 \u54252 \u50752  \u49892 \u47581 \u51008  \u51060 \u47336  \u47568 \u54624  \u49688  \u50630 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436  \u49324 \u46988 \u46308 \u50640 \u44172  \u50984 \u48277 \u51012  \u51452 \u49888  \u44163 \u51008  \u44536 \u46308 \u50640 \u44172  \u54924 \u44060 \u54616 \u44256  \u44060 \u49440 \u54624  \u44592 \u54924 \u44032  \u51080 \u45716  \u46041 \u50504  \u44536 \u46308 \u51032  \u54408 \u49457 \u51012  \u50984 \u48277 \u50640  \u48708 \u52628 \u50612  \u48372 \u44256  \u44536 \u46308 \u51032  \u44208 \u51216 \u51012  \u44648 \u45804 \u51012  \u49688  \u51080 \u44172  \u54616 \u44592  \u50948 \u54632 \u51060 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44536 \u46308 \u51008  \u49464 \u49345 \u51032  \u54840 \u44048 \u51012  \u49324 \u44592  \u50948 \u54616 \u50668  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51012  \u50629 \u49888 \u50668 \u44592 \u44256  \u45796 \u47480  \u49324 \u46988 \u46308 \u44620 \u51648  \u50984 \u48277 \u51012  \u48276 \u54616 \u46020 \u47197  \u44032 \u47476 \u52452 \u45796 . \u44536 \u46308 \u51008  \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u46308 \u50640 \u44172  \u54616 \u45208 \u45784 \u51032  \u50504 \u49885 \u51068 \u51012  \u45908 \u47101 \u55176 \u46020 \u47197  \u44053 \u50836 \u54644  \u50772 \u45796 . \u44536 \u47084 \u45208  \u51060 \u51228  \u44536 \u46308 \u51008  \u44536 \u46308 \u51060  \u47736 \u49884 \u54644  \u50728  \u44536  \u50984 \u48277 \u51004 \u47196  \u51221 \u51396 \u47484  \u48155 \u45716 \u45796 . \u44536 \u46308 \u51008  \u50500 \u47924 \u47088  \u48320 \u47749 \u54624  \u44163 \u51060  \u50630 \u51020 \u51012  \u45320 \u47924 \u46020  \u48516 \u47749 \u55176  \u44648 \u45803 \u45716 \u45796 . \u44536 \u46308 \u51008  \u44536 \u46308 \u51060  \u44221 \u48176 \u54616 \u44256  \u49452 \u44600  \u45824 \u49345 \u51012  \u51060 \u48120  \u53469 \u54616 \u50688 \u45796 . \'93\u44536  \u46412 \u50640  \u45320 \u55148 \u44032  \u46028 \u50500 \u50752 \u49436  \u51032 \u51064 \u44284  \u50501 \u51064 \u51060 \u47728  \u54616 \u45208 \u45784 \u51012  \u49452 \u44592 \u45716  \u51088 \u50752  \u49452 \u44592 \u51648  \u50500 \u45768 \u54616 \u45716  \u51088 \u47484  \u48516 \u48324 \u54616 \u47532 \u46972 \'94 (\u47568  3:18).\
\uc0\u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51012  \u45824 \u51201 \u54616 \u45912  \u51088 \u46308 \u51008  \u47785 \u49324 \u46308 \u47196 \u48512 \u53552  \u44032 \u51109  \u51089 \u51008  \u51088 \u50640  \u51060 \u47476 \u44592 \u44620 \u51648  \u51652 \u47532 \u50752  \u51032 \u47924 \u50640  \u45824 \u54616 \u50668  \u49352 \u47196 \u50868  \u44204 \u54644 \u47484  \u44032 \u51652 \u45796 . \u44536 \u46308 \u51008  \u45367 \u51704  \u44228 \u47749 \u51032  \u50504 \u49885 \u51068 \u51060  \u49332 \u50500  \u44228 \u49888  \u54616 \u45208 \u45784 \u51032  \u51064 \u51060  \u46120 \u51012  \u45320 \u47924  \u45734 \u44172  \u44648 \u45803 \u45716 \u45796 . \u44536 \u46308 \u51008  \u44144 \u51667  \u50504 \u49885 \u51068 \u51032  \u52280  \u49457 \u51656 \u44284 , \u44536 \u46308 \u51060  \u44148 \u52629 \u54644 \u50728  \u47784 \u47000 \u47196  \u46108  \u44592 \u52488 \u47484  \u45320 \u47924  \u45734 \u44172  \u44648 \u45803 \u45716 \u45796 . \u44536 \u46308 \u51008  \u44536 \u46308 \u51060  \u54616 \u45208 \u45784 \u51012  \u45824 \u51201 \u54616 \u50668  \u49912 \u50892 \u50728  \u49324 \u49892 \u51012  \u48156 \u44204 \u54620 \u45796 . \u51333 \u44368  \u51648 \u46020 \u51088 \u46308 \u51008  \u49324 \u46988 \u46308 \u51012  \u52380 \u44397 \u51032  \u47928 \u51004 \u47196  \u51064 \u46020 \u54616 \u44256  \u51080 \u45432 \u46972 \u44256  \u44277 \u50616 \u54616 \u47732 \u49436 \u46020  \u50689 \u54844 \u46308 \u51012  \u47736 \u47581 \u51004 \u47196  \u51064 \u46020 \u54644  \u50772 \u45796 . \u49457 \u51649 \u50640  \u51080 \u45716  \u51088 \u46308 \u51032  \u52293 \u51076 \u51060  \u50620 \u47560 \u45208  \u51473 \u45824 \u54616 \u47728  \u44536 \u46308 \u51032  \u48520 \u49457 \u49892 \u51032  \u49892 \u44284 \u44032  \u50620 \u47560 \u45208  \u47924 \u49436 \u50868  \u44163 \u51064 \u51648 \u45716  \u47560 \u51648 \u47561  \u49900 \u54032 \u45216 \u50640  \u44032 \u49436 \u50556  \u48708 \u47196 \u49548  \u50508 \u47140 \u51656  \u44163 \u51060 \u45796 . \u50864 \u47532 \u45716  \u50724 \u51649  \u52380 \u44397 \u50640  \u44032 \u49436 \u50556  \u54620  \u50689 \u54844 \u51012  \u51075 \u50612 \u48260 \u47532 \u45716  \u44163 \u51060  \u47924 \u50631 \u51076 \u51012  \u50732 \u48148 \u47476 \u44172  \u54217 \u44032 \u54624  \u44163 \u51060 \u45796 . \u54616 \u45208 \u45784 \u44760 \u47196 \u48512 \u53552  \u50501 \u54620  \u51333 \u50500  \u45208 \u47484  \u46496 \u45208 \u44032 \u46972 \u45716  \u49440 \u44256 \u47484  \u48155 \u45716  \u51088 \u51032  \u50868 \u47749 \u51008  \u46160 \u47140 \u50868  \u44163 \u51060  \u46112  \u44163 \u51060 \u45796 .\
