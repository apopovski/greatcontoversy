\uc0\u44536 \u47532 \u49828 \u46020 \u51032  \u52488 \u47548  \u45817 \u49884 \u50640  \u44144 \u47337 \u54620  \u49457  \u50696 \u47336 \u49332 \u47128 \u51032  \u51228 \u49324 \u51109 \u46308 \u44284  \u49436 \u44592 \u44288 \u46308 \u51008  \u51060 \u48120  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51012  \u50948 \u53441 \u48155 \u44256  \u51080 \u50632 \u51004 \u48064 \u47196  \u49884 \u45824 \u51032  \u51669 \u51312 \u47484  \u48516 \u48324 \u54616 \u44256  \u54728 \u46973 \u54616 \u49888  \u48516 \u51032  \u50724 \u49900 \u51012  \u49440 \u54252 \u54624  \u49688  \u51080 \u50632 \u51012  \u44163 \u51060 \u45796 . \u48120 \u44032 \u51032  \u50696 \u50616 \u51008  \u44536 \u48516 \u51032  \u52636 \u49373 \u51648 \u47484  \u50508 \u47140  \u51452 \u50632 \u44256  (\u48120  5:2), \u45796 \u45768 \u50648 \u51008  \u44536 \u48516 \u51032  \u52488 \u47548 \u51032  \u49884 \u44592 \u47484  \u48516 \u47749 \u54616 \u44172  \u48157 \u54784  \u51452 \u50632 \u45796  (\u45800  9:25). \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u51060 \u48120  \u44536 \u47088  \u50696 \u50616 \u46308 \u51012  \u50976 \u45824 \u51032  \u51648 \u46020 \u51088 \u46308 \u50640 \u44172  \u51452 \u49512 \u51004 \u48064 \u47196  \u44536 \u46308 \u51060  \u47700 \u49884 \u50556 \u51032  \u50724 \u49900 \u51060  \u51076 \u48149 \u54616 \u50688 \u45796 \u45716  \u49324 \u49892 \u51012  \u44648 \u45803 \u51648  \u47803 \u54616 \u44256  \u44536  \u49324 \u49892 \u51012  \u48177 \u49457 \u46308 \u50640 \u44172  \u51204 \u54616 \u51648  \u47803 \u54616 \u50688 \u45796 \u44256  \u54624 \u51648 \u46972 \u46020  \u44536  \u51068 \u51012  \u54609 \u44228 \u54624  \u49688 \u45716  \u50630 \u50632 \u45796 . \u44536 \u46308 \u51032  \u47924 \u51648 \u45716  \u51396 \u49828 \u47084 \u50868  \u53468 \u47564 \u51032  \u44208 \u44284 \u50688 \u45796 . \u50976 \u45824 \u51064 \u46308 \u51008  \u49464 \u49345 \u51032  \u50948 \u45824 \u54620  \u51064 \u47932 \u46308 \u50640 \u44172  \u44221 \u51032 \u47484  \u54364 \u54632 \u51004 \u47196  \u49324 \u45800 \u51032  \u51333 \u46308 \u50640 \u44172  \u48373 \u51333 \u54616 \u45716  \u54620 \u54200  \u49692 \u44368 \u45817 \u54620  \u54616 \u45208 \u45784 \u51032  \u49440 \u51648 \u51088 \u46308 \u51012  \u50948 \u54616 \u50668  \u44592 \u45392 \u48708 \u47484  \u49464 \u50864 \u44256  \u51080 \u50632 \u45796 . \u44536 \u46308 \u51008  \u49464 \u49549 \u51201  \u51648 \u50948 \u50752  \u44428 \u47141 \u51012  \u51137 \u53448 \u54616 \u44592  \u50948 \u54620  \u53804 \u51137 \u50640  \u47792 \u46160 \u54616 \u50688 \u51004 \u48064 \u47196  \u54616 \u45720 \u51032  \u51076 \u44552 \u44760 \u49436  \u51452 \u49884 \u45716  \u44144 \u47337 \u54620  \u50689 \u44305 \u51012  \u51082 \u50612 \u48260 \u47160 \u45796 .\
\uc0\u51060 \u49828 \u46972 \u50648 \u51032  \u51648 \u46020 \u51088 \u46308 \u51008  \u49900 \u50724 \u54616 \u44256  \u44221 \u44148 \u54620  \u53468 \u46020 \u47196  \u49464 \u44228  \u50669 \u49324 \u49345  \u52572 \u45824 \u51032  \u49324 \u44148 , \u44263  \u51064 \u47448 \u51032  \u44396 \u49549  \u49324 \u50629 \u51012  \u50756 \u49457 \u54616 \u44592  \u50948 \u54616 \u50668  \u54616 \u45208 \u45784 \u51032  \u50500 \u46308 \u51060  \u50724 \u49884 \u45716  \u51109 \u49548 , \u49884 \u44592 , \u54872 \u44221  \u46321 \u50640  \u44288 \u54616 \u50668  \u50672 \u44396 \u47484  \u54616 \u44256  \u51080 \u50632 \u50612 \u50556  \u54664 \u45796 . \u47784 \u46304  \u49324 \u46988 \u46308 \u51008  \u49464 \u49345 \u51032  \u44396 \u49549 \u51088 \u47484  \u50689 \u51217 \u54616 \u45716  \u52572 \u52488 \u51032  \u47924 \u47532 \u46308  \u44032 \u50868 \u45936  \u54620  \u49324 \u46988 \u51060  \u46104 \u44592  \u50948 \u54616 \u50668  \u44256 \u45824 \u54616 \u44256  \u51080 \u50612 \u50556  \u54624  \u44163 \u51060 \u50632 \u45796 . \u44536 \u47084 \u45208  \u47676  \u45208 \u49324 \u47131 \u51032  \u49328 \u44264 \u47196 \u48512 \u53552  \u48288 \u46308 \u47112 \u54772 \u44620 \u51648  \u52286 \u50500 \u44036  \u46160  \u49324 \u46988 \u51032  \u54588 \u44260 \u54620  \u50668 \u54665 \u51088 \u45716  \u44536  \u47560 \u51012 \u51032  \u51329 \u51008  \u44600 \u51012  \u46041 \u51901  \u45149 \u44620 \u51648  \u44152 \u50612 \u44032 \u47732 \u49436  \u48164  \u46041 \u50504 \u50640  \u49780  \u44275 \u44284  \u51096  \u44275 \u51012  \u52286 \u50520 \u51004 \u45208  \u45149 \u45236  \u54728 \u49324 \u44032  \u46104 \u44256  \u47568 \u50520 \u45796 . \u44536 \u46308 \u51012  \u47582 \u50500 \u46308 \u51060 \u44592  \u50948 \u54616 \u50668  \u47928 \u51012  \u50676 \u50612  \u51452 \u45716  \u51665 \u51008  \u54616 \u45208 \u46020  \u50630 \u50632 \u45796 . \u47560 \u52840 \u45236  \u44536 \u46308 \u51008  \u48708 \u52380 \u54620  \u54620  \u50808 \u50577 \u44036 \u50640  \u49689 \u49548 \u47484  \u51221 \u54616 \u50688 \u45716 \u45936 , \u44144 \u44592 \u49436  \u49464 \u49345 \u51032  \u44396 \u51452 \u44760 \u49436  \u53444 \u49373 \u54616 \u49512 \u45796 .\
\uc0\u49464 \u49345 \u51060  \u52285 \u51312 \u46104 \u44592  \u51204 \u50640  \u54616 \u45208 \u45784 \u51032  \u50500 \u46308 \u44760 \u49436  \u45817 \u49888 \u51032  \u50500 \u48260 \u51648 \u50752  \u54632 \u44760  \u45572 \u47532 \u49512 \u45912  \u50689 \u44305 \u51012  \u47785 \u44201 \u54664 \u45912  \u52380 \u49324 \u46308 \u51008  \u44536 \u48516 \u44760 \u49436  \u49464 \u49345 \u50640  \u45208 \u53440 \u45208 \u49884 \u45716  \u51068 \u51060  \u47784 \u46304  \u48177 \u49457 \u50640 \u44172  \u52572 \u45824 \u51032  \u44592 \u49256 \u51012  \u51452 \u45716  \u49324 \u44148 \u51060  \u46112  \u44163 \u51004 \u47196  \u48127 \u44256  \u50676 \u47148 \u54620  \u44288 \u49900 \u51004 \u47196  \u48148 \u46972 \u48372 \u50520 \u45796 . \u52380 \u49324 \u46308 \u51008  \u44536  \u44592 \u49244  \u49548 \u49885 \u51012  \u48155 \u50500 \u46308 \u51060 \u44592  \u50948 \u54616 \u50668  \u51456 \u48708 \u54616 \u44256  \u51080 \u45716  \u49324 \u46988 \u46308 \u44284  \u44536  \u49548 \u49885 \u51012  \u46405 \u50640  \u49324 \u45716  \u49324 \u46988 \u46308 \u50640 \u44172  \u44592 \u49256 \u51004 \u47196  \u50508 \u47140  \u51460  \u49324 \u46988 \u46308 \u50640 \u44172  \u44536  \u49548 \u49885 \u51012  \u44032 \u51256 \u44032 \u46972 \u45716  \u47749 \u47161 \u51012  \u48155 \u50520 \u45796 . \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u52828 \u55176  \u51064 \u49457 \u51012  \u50416 \u44256  \u50724 \u49492 \u49436  \u54620 \u50630 \u51060  \u47924 \u44144 \u50868  \u51200 \u51452 \u51032  \u51664 \u51012  \u51648 \u44256  \u45817 \u49888 \u51032  \u50689 \u54844 \u51012  \u51396 \u47484  \u50948 \u54620  \u55148 \u49373  \u51228 \u47932 \u47196  \u46300 \u47540  \u44163 \u51060 \u50632 \u45796 . \u44536 \u47084 \u45208  \u52380 \u49324 \u46308 \u51008  \u48708 \u47197  \u44536 \u48516 \u44760 \u49436  \u44404 \u50837 \u51012  \u45817 \u54616 \u49892 \u51648 \u46972 \u46020  \u44536 \u48516 \u44760 \u49436 \u45716  \u51648 \u44537 \u55176  \u45458 \u51004 \u49888  \u54616 \u45208 \u45784 \u51032  \u50500 \u46308 \u51060 \u49884 \u48064 \u47196  \u44536 \u48516 \u51032  \u49549 \u49457 \u50640  \u50508 \u47582 \u51008  \u50948 \u50628 \u44284  \u50689 \u44305 \u51004 \u47196  \u49324 \u46988 \u46308  \u50526 \u50640  \u45208 \u53440 \u45208 \u49892  \u44163 \u51004 \u47196  \u44592 \u45824 \u54616 \u50688 \u45796 . \u49464 \u49345 \u51032  \u50948 \u45824 \u54620  \u51064 \u47932 \u46308 \u51060  \u51060 \u49828 \u46972 \u50648 \u51032  \u49688 \u46020 \u50640  \u47784 \u50668 \u49436  \u44536 \u48516 \u51032  \u50724 \u49900 \u51012  \u50689 \u51217 \u54624  \u44163 \u51064 \u44032 ? \u52380 \u49324 \u46308 \u51032  \u47924 \u47532 \u44032  \u44592 \u45796 \u47532 \u45716  \u49324 \u46988 \u46308 \u50640 \u44172  \u44536 \u48516 \u51012  \u49548 \u44060 \u54624  \u49688  \u51080 \u51012  \u44163 \u51064 \u44032 ?\
\uc0\u54620  \u52380 \u49324 \u45716  \u51648 \u49345 \u51004 \u47196  \u45236 \u47140 \u50752 \u49436  \u50696 \u49688 \u45784 \u51012  \u50689 \u51217 \u54616 \u44592  \u50948 \u54616 \u50668  \u51456 \u48708 \u54616 \u44256  \u51080 \u45716  \u49324 \u46988 \u51012  \u52286 \u50500 \u48372 \u50520 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u44592 \u45796 \u47532 \u44256  \u51080 \u45716  \u51613 \u44144 \u47484  \u52286 \u51648  \u47803 \u54616 \u50688 \u45796 . \u44536 \u45716  \u47700 \u49884 \u50556 \u44032  \u50724 \u49892  \u49884 \u44592 \u44032  \u51208 \u48149 \u54616 \u45796 \u45716  \u44163 \u51012  \u50508 \u47140  \u51452 \u45716  \u52268 \u48120 \u50752  \u49849 \u47532 \u51032  \u49548 \u47532 \u47484  \u46307 \u51648  \u47803 \u54616 \u50688 \u45796 . \u44536  \u52380 \u49324 \u45716  \u50620 \u47560  \u46041 \u50504  \u53469 \u54632 \u51012  \u51077 \u51008  \u46020 \u49457 \u44284  \u50668 \u47084  \u49884 \u45824 \u47484  \u53685 \u54616 \u50668  \u44144 \u47337 \u54620  \u54616 \u45208 \u45784 \u51032  \u51076 \u51116 \u44032  \u45208 \u53440 \u45208  \u51080 \u45912  \u49457 \u51204  \u50948 \u47484  \u48176 \u54924 \u54616 \u50688 \u51004 \u45208  \u44144 \u44592 \u50640 \u46020  \u46609 \u44057 \u51008  \u47924 \u44288 \u49900 \u51060  \u51080 \u51012  \u49104 \u51060 \u50632 \u45796 . \u54728 \u49885 \u44284  \u44368 \u47564 \u51004 \u47196  \u44032 \u46301  \u52268  \u51228 \u49324 \u51109 \u46308 \u51008  \u49457 \u51204 \u50640 \u49436  \u45908 \u47101 \u54784 \u51652  \u51228 \u47932 \u51012  \u46300 \u47532 \u44256  \u51080 \u50632 \u45796 . \u48148 \u47532 \u49352 \u51064 \u46308 \u51008  \u53360 \u49548 \u47532 \u47196  \u48177 \u49457 \u46308 \u51012  \u44032 \u47476 \u52824 \u44144 \u45208  \u44600 \u44144 \u47532 \u50640 \u49436  \u51088 \u46993 \u49828 \u47101 \u44172  \u44592 \u46020 \u54616 \u44256  \u51080 \u50632 \u45796 . \u50773 \u44417 \u50640 \u49436 , \u52384 \u54617 \u51088 \u46308 \u51032  \u51665 \u54924 \u50640 \u49436 , \u46989 \u48708 \u46308 \u51032  \u54617 \u44368 \u50640 \u49436 , \u50612 \u46356 \u50640 \u49436 \u45208  \u50728  \u54616 \u45720 \u51032  \u44592 \u49256 \u44284  \u52268 \u50577 \u51004 \u47196  \u44032 \u46301  \u52292 \u50868  \u45440 \u46972 \u50868  \u49324 \u44148 , \u44263  \u51064 \u47448 \u51032  \u44396 \u49549 \u51088 \u44032  \u48148 \u50556 \u55120 \u47196  \u49464 \u49345 \u50640  \u45208 \u53440 \u45208 \u49888 \u45796 \u45716  \u45440 \u46972 \u50868  \u49324 \u44148 \u50640  \u45824 \u54616 \u50668  \u54620 \u44208 \u44057 \u51060  \u47924 \u44288 \u49900 \u54620  \u49345 \u53468 \u44032  \u46104 \u50612  \u51080 \u50632 \u45796 .\
