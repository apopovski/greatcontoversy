\uc0\u51652 \u47532 \u51032  \u48731 \u51012  \u44144 \u48512 \u54620  \u44536  \u45208 \u46972 \u51032  \u50516 \u55121 \u51008  \u46160 \u47140 \u50868  \u54805 \u54200 \u50640 \u44620 \u51648  \u51060 \u47476 \u47104 \u45796 . \'93\u44396 \u50896 \u50640  \u51060 \u47476 \u44172  \u54616 \u45716  \u51008 \u54812 \'94\u44032  \u51060 \u48120  \u45208 \u53440 \u45228 \u50632 \u51648 \u47564  \u54532 \u46993 \u49828 \u45716  \u44536  \u51008 \u54812 \u51032  \u44428 \u45733 \u44284  \u44144 \u47337 \u54632 \u51012  \u48372 \u47732 \u49436 \u46020 , \u47566 \u51008  \u49324 \u46988 \u46308 \u51060  \u54616 \u45720 \u50640 \u49436  \u50728  \u48120 \u45909 \u50640  \u51060 \u45132 \u47532 \u44256  \u44033  \u46020 \u49884 \u50752  \u52492 \u46973 \u51060  \u44536  \u48731 \u51004 \u47196  \u44368 \u54868 \u46108  \u44163 \u51012  \u47785 \u44201 \u54616 \u47732 \u49436 \u46020  \u44536 \u44163 \u51012  \u44144 \u51208 \u54616 \u44256  \u48731 \u48372 \u45796  \u50612 \u46176 \u51012  \u53469 \u54616 \u50688 \u45796 . \u54616 \u45720 \u50640 \u49436  \u50728  \u49440 \u47932 \u51060  \u51228 \u44277 \u46104 \u50632 \u51648 \u47564  \u44536 \u46308 \u51008  \u44536 \u44163 \u51012  \u44144 \u51208 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u50501 \u51012  \u49440 \u51060 \u46972  \u54616 \u44256 , \u49440 \u51012  \u50501 \u51060 \u46972  \u54616 \u50668  \u47560 \u52840 \u45236  \u49828 \u49828 \u47196  \u51088 \u50500 \u44592 \u47564 \u51032  \u54252 \u47196 \u44032  \u46104 \u50612  \u48260 \u47532 \u44256  \u47568 \u50520 \u45796 . \u44536 \u47084 \u48064 \u47196  \u51648 \u44552 \u51008  \u48708 \u47197  \u44536 \u46308 \u51060  \u54616 \u45208 \u45784 \u51012  \u50948 \u54616 \u50668  \u44536 \u48516 \u51032  \u48177 \u49457 \u51012  \u48149 \u54644 \u54616 \u44256  \u51080 \u45796 \u44256  \u48127 \u44256  \u51080 \u51012 \u51648 \u46972 \u46020 , \u44536 \u47084 \u54620  \u49892 \u51221 \u51060  \u44536 \u46308 \u51012  \u47924 \u51396 \u54616 \u45796 \u44256  \u54644 \u51460  \u49688 \u45716  \u50630 \u50632 \u45796 . \u44536 \u46308 \u51008  \u44592 \u47564 \u51004 \u47196 \u48512 \u53552  \u44396 \u50896 \u54644  \u51460  \u49688  \u51080 \u44256 , \u44536 \u46308 \u51032  \u50689 \u54844 \u51012  \u54588 \u55128 \u47536  \u51396 \u50640 \u49436  \u44396 \u50896 \u54644  \u51460  \u49688  \u51080 \u45716  \u48731 \u51012  \u44256 \u51032 \u47196  \u44144 \u51208 \u54616 \u50688 \u45796 .\
\uc0\u51060 \u45800 \u51012  \u48149 \u47736 \u54616 \u44192 \u45796 \u45716  \u50628 \u49689 \u54620  \u47609 \u49464 \u44032  \u53360  \u51204 \u45817 \u50640 \u49436  \u51060 \u47336 \u50612 \u51276 \u45716 \u45936 , \u48148 \u47196  \u44536  \u51109 \u49548 \u50640 \u49436  \u50557  \u49340 \u48177 \u45380  \u54980 \u50640  \u49332 \u50500  \u44228 \u49888  \u54616 \u45208 \u45784 \u51012  \u51082 \u50612 \u48260 \u47536  \u49324 \u46988 \u46308 \u50640  \u51032 \u54616 \u50668  \'93\u51060 \u49457  (\u63972 \u24615 ) \u51032  \u50668 \u49888 \'94\u51060  \u44221 \u48176 \u47484  \u48155 \u51012  \u44163 \u51060 \u50632 \u45796 . \u44536 \u47532 \u44256  \u51060 \u51228 \u45716  \u54665 \u47148 \u51060  \u51221 \u46024 \u46104 \u50632 \u51004 \u48064 \u47196  \u54532 \u46993 \u49828 \u47484  \u45824 \u54364 \u54616 \u45716  \u50668 \u47084  \u49324 \u46988 \u46308 \u51008  \u44536 \u46308 \u51060  \u47609 \u49464 \u54620  \u44536  \u51068 \u50640  \u52265 \u49688 \u54616 \u50688 \u45796 . \'93\u44032 \u44620 \u50868  \u44144 \u47532 \u50640  \u47751  \u49324 \u46988 \u51032  \u54532 \u47196 \u53580 \u49828 \u53444 \u53944 \u46308 \u51012  \u49328  \u52292 \u47196  \u54868 \u54805 \u49884 \u53420  \u54868 \u54805 \u51452 \u46308 \u51060  \u49464 \u50892 \u51256  \u51080 \u50632 \u45796 . \u50773 \u51060  \u44032 \u44620 \u51060  \u51217 \u44540 \u54616 \u45716  \u49692 \u44036  \u51109 \u51089 \u45908 \u48120 \u50640  \u48520 \u51012  \u48537 \u51060 \u44256  \u54665 \u47148 \u51060  \u51221 \u51648 \u46104 \u50612  \u44536  \u52376 \u54805 \u51032  \u47784 \u49845 \u51012  \u52432 \u45796 \u48372 \u46020 \u47197  \u51456 \u48708 \u44032  \u46104 \u50612  \u51080 \u50632 \u45796 \'94 (Wylie, b.13, ch.21). \u44536  \u46412 \u50640  \u44536 \u47532 \u49828 \u46020 \u51032  \u51613 \u51064 \u46308 \u51060  \u45817 \u54620  \u44256 \u53685 \u51008  \u51060 \u47336  \u47568 \u54624  \u49688  \u50630 \u51060  \u45140 \u52237 \u54620  \u44163 \u51060 \u50632 \u51004 \u45208  \u44536 \u46308 \u51008  \u51312 \u44552 \u46020  \u50836 \u46041 \u54616 \u51648  \u50506 \u50520 \u45796 . \u49888 \u50521 \u51012  \u52712 \u49548 \u54616 \u46972 \u45716  \u44428 \u47732 \u51012  \u48155 \u44172  \u46104 \u51088 , \u44536  \u51473 \u51032  \u54620  \u49324 \u46988 \u51008  \'93\u45208 \u45716  \u49440 \u51648 \u51088 \u46308 \u44284  \u49324 \u46020 \u46308 \u51060  \u51060 \u48120  \u51204 \u54620  \u44163 \u44284  \u47784 \u46304  \u49457 \u46020 \u46308 \u51060  \u48127 \u45716  \u44163 \u47564 \u51012  \u48127 \u45716 \u45796 . \u45208 \u51032  \u48127 \u51020 \u51008  \u51020 \u48512 \u51032  \u47784 \u46304  \u44428 \u49464 \u47484  \u51060 \u44592 \u49884 \u45716  \u54616 \u45208 \u45784 \u51012  \u48127 \u45716  \u48127 \u51020 \u51060 \u45796 \'94 (D\'92Aubigne, b.4, ch.12) \u44256  \u45824 \u45813 \u54616 \u50688 \u45796 .\
\uc0\u50668 \u47084  \u48264  \u54665 \u47148 \u51008  \u52376 \u54805 \u45817 \u54616 \u45716  \u51109 \u49548 \u46308 \u50640 \u49436  \u47688 \u52628 \u50632 \u45796 . \u44536 \u46308 \u51060  \u52376 \u51020  \u52636 \u48156 \u54664 \u45912  \u50773 \u44417 \u50640  \u46020 \u52265 \u54616 \u51088  \u44400 \u51473 \u51008  \u54644 \u49328 \u46104 \u44256 , \u50773 \u44284  \u51452 \u44368 \u46308 \u51008  \u44536 \u45216 \u51032  \u54665 \u49324 \u50640  \u47588 \u50864  \u47564 \u51313 \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u46308 \u51008  \u54588 \u52264 \u50640  \u52629 \u54616 \u47484  \u45208 \u45572 \u47728  \u51648 \u44552  \u49884 \u51089 \u54620  \u51060 \u45800  \u48149 \u47736  \u51089 \u50629 \u51012  \u45149 \u44620 \u51648  \u44228 \u49549 \u54616 \u44592 \u47196  \u54616 \u50688 \u45796 .\
