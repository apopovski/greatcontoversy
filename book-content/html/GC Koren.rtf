\f1\b0 \cf0 \
\uc0\u54168 \u47476 \u46356 \u45212 \u53944  \u50773 \u51060  \u44536 \u46308 \u51032  \u50577 \u49900 \u50640 \u49436  \u48708 \u47215 \u46108  \u54869 \u49888 \u51012  \u47924 \u49884 \u54616 \u50688 \u51004 \u48064 \u47196 , \u51228 \u54980 \u46308 \u51008  \u44536 \u51032  \u53748 \u51109 \u51012  \u44060 \u51032 \u52824  \u50506 \u44256  \u54637 \u51032 \u49436 \u47484  \u44397 \u54924 \u50640  \u51593 \u49884  \u51228 \u52636 \u54616 \u44592 \u47196  \u44208 \u51221 \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u45796 \u51020 \u44284  \u44057 \u51008  \u50628 \u49689 \u54620  \u49440 \u50616 \u49436 \u47484  \u51089 \u49457 \u54616 \u50668  \u51032 \u54924 \u50640  \u51228 \u52636 \u54616 \u50688 \u45796 .\
\'93\uc0\u50864 \u47532 \u45716  \u50976 \u51068 \u54620  \u52285 \u51312 \u51452 \u49884 \u50836  \u50976 \u51648  (\u32173 \u25345 ) \u51088 \u49884 \u47728  \u49549 \u51396 \u51452 \u49884 \u50836  \u44396 \u51452 \u49884 \u47728  \u50724 \u47000 \u51648  \u50506 \u50500  \u50864 \u47532 \u51032  \u49900 \u54032 \u51088 \u44032  \u46104 \u49892  \u54616 \u45208 \u45784  \u50526 \u44284  \u50728  \u51064 \u47448 \u50752  \u50728  \u54588 \u51312 \u47932  \u50526 \u50640 \u49436  \u54637 \u51032 \u49436 \u47484  \u51228 \u52636 \u54616 \u45208 \u51060 \u45796 . \u50864 \u47532 \u45716  \u44060 \u51064 \u51004 \u47196 \u49436  \u46608 \u45716  \u44397 \u48124 \u51032  \u45824 \u54364 \u51088 \u47196 \u49436  \u51109 \u52264  \u48152 \u54252 \u46112  \u52825 \u47161 \u50640  \u51080 \u50612 \u49436  \u54616 \u45208 \u45784 \u51012  \u44144 \u49828 \u47476 \u44256  \u44536 \u48516 \u51032  \u44144 \u47337 \u54620  \u47568 \u50432 \u44284  \u50864 \u47532 \u51032  \u51221 \u45817 \u54620  \u50577 \u49900 \u44284  \u50864 \u47532 \u51032  \u50689 \u54844 \u51032  \u44396 \u50896 \u50640  \u50948 \u48176 \u46104 \u45716  \u51216 \u51008  \u51208 \u45824 \u47196  \u49849 \u51064 \u54624  \u49688  \u50630 \u45208 \u51060 \u45796 .\'94\
\'93\uc0\u50612 \u52236  \u50864 \u47532 \u44032  \u51060 \u47084 \u54620  \u52825 \u47161 \u51012  \u50857 \u51064 \u54624  \u49688  \u51080 \u44192 \u49845 \u45768 \u44620 ? \u51204 \u45733 \u54616 \u49888  \u54616 \u45208 \u45784 \u44760 \u49436  \u45817 \u49888 \u51032  \u51648 \u49885 \u51012  \u49324 \u46988 \u50640 \u44172  \u44228 \u49884 \u54616 \u50668  \u51452 \u49900 \u50640 \u46020  \u48520 \u44396 \u54616 \u44256  \u44536 \u47084 \u54620  \u51648 \u49885 \u51012  \u48155 \u51012  \u49688  \u50630 \u45796 \u44256  \u54616 \u45716  \u44163 \u51008  \u50620 \u47560 \u45208  \u54633 \u45817 \u52824  \u47803 \u54620  \u51068 \u51077 \u45768 \u44620 ? \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u50640  \u51068 \u52824 \u46104 \u45716  \u44368 \u47532 \u48372 \u45796  \u45908 \u50865  \u54869 \u49892 \u54620  \u44368 \u47532 \u45716  \u51080 \u51012  \u49688  \u50630 \u49845 \u45768 \u45796 . \'85\u51452 \u45784 \u44760 \u49436 \u45716  \u45796 \u47480  \u44368 \u47532 \u47484  \u44032 \u47476 \u52824 \u45716  \u44163 \u51012  \u44552 \u54616 \u49901 \u45768 \u45796 . \'85\u49457 \u44221  \u44396 \u51208 \u51008  \u49457 \u44221  \u44396 \u51208 \u47196 \u50024  \u54644 \u49437 \u54616 \u50668  \u48157 \u54784 \u50556  \u54633 \u45768 \u45796 . \'85\u51060  \u44144 \u47337 \u54620  \u52293 \u51008  \u44536 \u47532 \u49828 \u46020 \u51064 \u50640 \u44172  \u51080 \u50612 \u49436  \u47784 \u46304  \u51216 \u50640  \u54596 \u50836 \u54616 \u44256  \u51060 \u54644 \u54616 \u44592  \u49789 \u44256  \u50612 \u46176 \u51012  \u47932 \u47532 \u52824 \u44592 \u50640  \u51201 \u54633 \u54620  \u44163 \u51077 \u45768 \u45796 . \u50864 \u47532 \u45716  \u54616 \u45208 \u45784 \u51032  \u51008 \u52509  \u50500 \u47000 \u49436  \u51204 \u54784  \u49692 \u49688 \u54620  \u49457 \u44221 , \u44263  \u49888 \u44396 \u50557  \u49457 \u44221 \u50640  \u44592 \u47197 \u46108  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u47564 \u51012  \u51204 \u54616 \u44256  \u50668 \u44592 \u50640  \u50948 \u48176 \u46104 \u45716  \u44163 \u51008  \u50612 \u46496 \u54620  \u44163 \u51060 \u46304 \u51648  \u45908 \u54616 \u51648  \u50500 \u45768 \u54624  \u44208 \u49900 \u51077 \u45768 \u45796 . \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51008  \u52280 \u51004 \u47196  \u50976 \u51068 \u54620  \u51652 \u47532 \u51060 \u47728  \u44536 \u44163 \u51008  \u52280 \u51004 \u47196  \u47784 \u46304  \u44368 \u47532 \u50752  \u54665 \u50948 \u51032  \u54869 \u49892 \u54620  \u54364 \u51456 \u51004 \u47196 \u49436  \u44208 \u53076  \u49892 \u54056 \u54616 \u44144 \u45208  \u50864 \u47532 \u47484  \u49549 \u51060 \u51648  \u50500 \u45768 \u54633 \u45768 \u45796 . \u44536 \u47084 \u48064 \u47196  \u51060 \u47084 \u54620  \u44592 \u52488  \u50948 \u50640  \u49436 \u45716  \u49324 \u46988 \u51008  \u50612 \u46496 \u54620  \u51020 \u48512 \u51032  \u49464 \u47141 \u44284  \u51109 \u52264  \u50630 \u50612 \u51656  \u49324 \u46988 \u51032  \u50689 \u54868 \u50640  \u45824 \u54616 \u50668 \u49436 \u46020  \u51200 \u54637 \u54624  \u49688  \u51080 \u49845 \u45768 \u45796 .\'94\
\'93\uc0\u51060 \u50752  \u44057 \u51008  \u51060 \u50976 \u50640 \u49436  \u50864 \u47532 \u45716  \u50864 \u47532 \u50640 \u44172  \u51648 \u50892 \u51652  \u47693 \u50640 \u47484  \u51060 \u51228  \u44144 \u48512 \u54616 \u45716  \u48148 \u51077 \u45768 \u45796 .\'94 \'93\u46041 \u49884 \u50640  \u54889 \u51228  \u54224 \u54616 \u44760 \u49436 \u45716  \u47924 \u50631 \u48372 \u45796 \u46020  \u54616 \u45208 \u45784 \u51012  \u45908 \u50865  \u49324 \u46993 \u54616 \u45716  \u44536 \u47532 \u49828 \u46020 \u51064  \u51076 \u44552 \u52376 \u47100  \u50864 \u47532 \u47484  \u45824 \u50864 \u54644  \u51452 \u49884 \u44592 \u47484  \u44592 \u45824 \u54633 \u45768 \u45796 . \u44536 \u47532 \u44256  \u50864 \u47532 \u45716  \u54889 \u51228  \u54224 \u54616 \u50752  \u50773 \u44277  \u51228 \u50948 \u50640 \u44172  \u47784 \u46304  \u51316 \u44221 \u44284  \u49692 \u51333 \u51004 \u47196 \u50024  \u50864 \u47532 \u51032  \u45817 \u50672 \u54620  \u51032 \u47924 \u47484  \u51060 \u54665 \u54624  \u44163 \u51012  \u50616 \u47749 \u54616 \u45716  \u48148 \u51077 \u45768 \u45796 \'94 (D\'92Aubigne, b.13, ch.6).\
\uc0\u51032 \u54924 \u45716  \u44618 \u51008  \u44048 \u47749 \u51012  \u48155 \u50520 \u45796 . \u45824 \u48512 \u48516 \u51032  \u49324 \u46988 \u46308 \u51008  \u54637 \u51032 \u51088 \u52769 \u51032  \u45812 \u45824 \u54632 \u50640  \u45440 \u46972 \u44172  \u46104 \u50632 \u45796 . \u44536 \u46308 \u51032  \u48120 \u47000 \u50640 \u45716  \u54028 \u46976 \u44284  \u48520 \u50504 \u51060  \u51080 \u50632 \u45796 . \u48516 \u50676 \u44284  \u54588  \u55128 \u47548 \u44284  \u53804 \u51137 \u51060  \u48520 \u44032 \u54588 \u54616 \u44172  \u48372 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44060 \u54785 \u51088 \u46308 \u51008  \u44536 \u46308 \u51032  \u44600 \u51060  \u51221 \u45817 \u54632 \u51012  \u54869 \u49888 \u54616 \u50688 \u51004 \u47728  \u51204 \u45733 \u54616 \u49888  \u48516 \u51032  \u44144 \u47337 \u54620  \u54036 \u51012  \u51032 \u51648 \u54616 \u47732 \u49436  \'93\u45728 \u47492 \u54620  \u44592 \u49345 \u51004 \u47196  \u54869 \u44256 \u48512 \u46041 \u54616 \u44172 \'94 \u45208 \u50500 \u44052 \u45796 .\
