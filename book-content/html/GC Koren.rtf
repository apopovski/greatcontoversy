\f1\b0 \cf0 \
\uc0\u44144 \u44592 \u50640 \u45716  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u44256 \u45212 \u51012  \u45817 \u54616 \u49892  \u46412  \u44536 \u48516 \u51012  \u51312 \u47217 \u54620  \u51088 \u46308 \u51060  \u51080 \u45796 . \u45824 \u51228 \u49324 \u51109 \u51060  \u47609 \u49464 \u54616 \u47732 \u49436  \u45824 \u45813 \u51012  \u50836 \u44396 \u54664 \u51012  \u46412  \u51452 \u45784 \u44760 \u49436  \u50628 \u49689 \u54616 \u44172 , \'93\u51060 \u54980 \u50640  \u51064 \u51088 \u44032  \u44428 \u45733 \u51032  \u50864 \u54200 \u50640  \u50505 \u51008  \u44163 \u44284  \u54616 \u45720  \u44396 \u47492 \u51012  \u53440 \u44256  \u50724 \u45716  \u44163 \u51012  \u45320 \u55148 \u44032  \u48372 \u47532 \u46972 \'94 (\u47560  26:64) \u44256  \u49440 \u50616 \u54616 \u49888  \u44256 \u45212 \u51032  \u51452 \u45784 \u51032  \u47568 \u50432 \u51060  \u44048 \u46041 \u51201 \u51064  \u47568 \u50432 \u51004 \u47196  \u44536 \u46308 \u51032  \u47560 \u51020 \u51012  \u52236 \u47480 \u45796 . \u51060 \u51228  \u44536 \u46308 \u51008  \u50689 \u44305  \u51473 \u50640  \u44228 \u49884 \u45716  \u44536 \u48516 \u51012  \u48148 \u46972 \u48372 \u44256 , \u44536 \u48516 \u44760 \u49436  \u44428 \u45733 \u51032  \u50864 \u54200 \u50640  \u50505 \u51004 \u49888  \u44163 \u51012  \u48376 \u45796 .\
\uc0\u51452 \u45784 \u44760 \u49436  \u54616 \u45208 \u45784 \u51032  \u50500 \u46308 \u51060 \u46972 \u44256  \u51452 \u51109 \u54616 \u49888  \u47568 \u50432 \u51012  \u51312 \u47217 \u54620  \u51088 \u46308 \u46020  \u51060 \u51228 \u45716  \u47568 \u51060  \u50630 \u45796 . \u44144 \u44592 \u50640 \u45716  \u50773 \u51060 \u46972 \u45716  \u51452 \u45784 \u51032  \u52845 \u54840 \u47484  \u51312 \u47217 \u54632 \u51004 \u47196  \u44400 \u51064 \u46308 \u50640 \u44172  \u47749 \u47161 \u54616 \u50668  \u51452 \u45784 \u44760  \u50773 \u51004 \u47196  \u44288 \u51012  \u50444 \u50864 \u44172  \u54620  \u44368 \u47564 \u54620  \u54756 \u47215 \u46020  \u51080 \u45796 . \u48520 \u44221 \u44148 \u54620  \u49552 \u51004 \u47196  \u51452 \u45784 \u44760  \u51088 \u49353  \u50743 \u51012  \u51077 \u55176 \u44256 , \u51452 \u45784 \u51032  \u44144 \u47337 \u54620  \u51060 \u47560 \u50640  \u44032 \u49884 \u44288 \u51012  \u50444 \u50864 \u44256  \u51200 \u54637 \u54616 \u51648  \u50506 \u45716  \u49552 \u50640  \u44032 \u51676  \u54848 \u51012  \u46308 \u47532 \u44256 , \u52280 \u46988 \u46108  \u51312 \u47217 \u51004 \u47196  \u44536 \u48516  \u50526 \u50640 \u49436  \u51208 \u51012  \u54620  \u48148 \u47196  \u44536  \u49324 \u46988 \u46308 \u46020  \u51080 \u45796 . \u49373 \u47749 \u51032  \u50773 \u51012  \u46412 \u47532 \u44256  \u52840 \u51012  \u48201 \u45912  \u51088 \u46308 \u51060  \u51060 \u51228 \u45716  \u45040 \u46763 \u50612  \u48372 \u49884 \u45716  \u51452 \u45784 \u51032  \u49884 \u49440 \u51012  \u54588 \u54616 \u44256 , \u51452 \u45784 \u44760 \u49436  \u51076 \u54616 \u49884 \u48064 \u47196  \u45208 \u53440 \u45208 \u45716  \u51200 \u54637 \u54624  \u49688  \u50630 \u45716  \u50689 \u44305 \u50640 \u49436  \u49704 \u44256 \u51088  \u50528 \u47484  \u50420 \u45796 . \u51452 \u45784 \u51032  \u49552 \u44284  \u48156 \u50640  \u47803 \u51012  \u48149 \u51008  \u51088 \u46308 \u44284  \u51452 \u45784 \u51032  \u50694 \u44396 \u47532 \u47484  \u52236 \u47480  \u44400 \u51064 \u46020  \u46160 \u47140 \u50880 \u44284  \u54980 \u54924 \u47196  \u44536  \u49345 \u52376 \u51032  \u55124 \u51201 \u51012  \u48148 \u46972 \u48376 \u45796 .\
\uc0\u51228 \u49324 \u51109 \u46308 \u44284  \u51109 \u47196 \u46308 \u51008  \u44040 \u48148 \u47532 \u51032  \u49324 \u44148 \u51012  \u45440 \u46972 \u50872  \u51221 \u46020 \u47196  \u54872 \u54616 \u44172  \u54924 \u49345 \u54620 \u45796 . \u44536 \u46308 \u51008  \u47672 \u47532 \u47484  \u55124 \u46308 \u47732 \u49436  \u50501 \u47560 \u51201  \u44592 \u49256 \u50640  \u49324 \u47196 \u51105 \u54784  \u48512 \u47476 \u51670 \u45912  \u51068 \u51012  \u44277 \u54252 \u44048 \u50640  \u49324 \u47196 \u51105 \u55180  \u52292  \u44592 \u50613 \u54620 \u45796 . \'93\u51200 \u44032  \u45224 \u51008  \u44396 \u50896 \u54616 \u50688 \u51004 \u46104  \u51088 \u44592 \u45716  \u44396 \u50896 \u54624  \u49688  \u50630 \u46020 \u45796  \u51200 \u44032  \u51060 \u49828 \u46972 \u50648 \u51032  \u50773 \u51060 \u47196 \u45796  \u51648 \u44552  \u49901 \u51088 \u44032 \u50640 \u49436  \u45236 \u47140 \u50732 \u51648 \u50612 \u45796  \u44536 \u47084 \u47732  \u50864 \u47532 \u44032  \u48127 \u44192 \u45432 \u46972  \u51200 \u44032  \u54616 \u45208 \u45784 \u51012  \u49888 \u47280 \u54616 \u45768  \u54616 \u45208 \u45784 \u51060  \u51200 \u47484  \u44592 \u48848 \u54616 \u49884 \u47732  \u51060 \u51228  \u44396 \u50896 \u54616 \u49892 \u51648 \u46972  \u51228  \u47568 \u51060  \u45208 \u45716  \u54616 \u45208 \u45784 \u51032  \u50500 \u46308 \u51060 \u46972  \u54616 \u50688 \u46020 \u45796 \'94 (\u47560  27:42, 43).\
\uc0\u44536 \u46308 \u51008  \u44396 \u51452 \u44760 \u49436  \u47568 \u50432 \u54616 \u49888  \u48708 \u50976 , \u44263  \u54252 \u46020 \u50896 \u51032  \u49688 \u54869 \u51012  \u51452 \u51064 \u50640 \u44172  \u48148 \u52824 \u44592 \u47484  \u44144 \u51208 \u54616 \u44256  \u44536 \u51032  \u51333 \u46308 \u51012  \u46412 \u47532 \u44256  \u51452 \u51064 \u51032  \u50500 \u46308 \u51012  \u51453 \u51064  \u45453 \u48512 \u51032  \u48708 \u50976 \u47484  \u49373 \u49373 \u54616 \u44172  \u54924 \u49345 \u54620 \u45796 . \u44536 \u46308 \u51008  \u46608 \u54620  \u44536 \u46308  \u51088 \u49888 \u50640 \u44172  \u49440 \u44256 \u46108  \u47568 \u50432 \u51012  \u44592 \u50613 \u54620 \u45796 . \u54252 \u46020 \u50896 \u51032  \u51452 \u51064 \u51008  \'93\u51060  \u50501 \u54620  \u51088 \u46308 \u51012  \u51652 \u47736 \'94\u54624  \u44163 \u51060 \u45796 . \u44536  \u48520 \u49457 \u49892 \u54620  \u51088 \u46308 \u51032  \u51396 \u50752  \u44536 \u46308 \u51060  \u48155 \u51012  \u54805 \u48268 \u50640 \u49436  \u51228 \u49324 \u51109 \u46308 \u44284  \u51109 \u47196 \u46308 \u51008  \u44536 \u46308  \u51088 \u49888 \u51060  \u52712 \u54620  \u54665 \u46041 \u44284  \u48148 \u47196  \u44536 \u46308 \u51032  \u50868 \u47749  \u51088 \u52404 \u47484  \u48376 \u45796 . \u51060 \u51228 \u45716  \u51064 \u44036 \u51201  \u44256 \u48124 \u51032  \u51208 \u44508 \u44032  \u45208 \u53440 \u45212 \u45796 . \'93\u51200 \u47484  \u49901 \u51088 \u44032 \u50640  \u47803  \u48149 \u44172  \u54616 \u49548 \u49436  \u49901 \u51088 \u44032 \u50640  \u47803  \u48149 \u44172  \u54616 \u49548 \u49436 \'94 \u54616 \u44256  \u50696 \u47336 \u49332 \u47128  \u44144 \u47532 \u50640  \u50872 \u47140  \u54140 \u51276 \u45912  \u44163 \u48372 \u45796 \u46020  \u54620 \u52789  \u45908  \u53360  \u49548 \u47532 \u47196  \'93\u44536 \u45716  \u54616 \u45208 \u45784 \u51032  \u50500 \u46308 \u51060 \u45796 ! \u44536 \u45716  \u51652 \u49892 \u47196  \u47700 \u49884 \u50556 \u45796 !\'94 \u