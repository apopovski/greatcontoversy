\f1\b0 \cf0 \
\uc0\u54616 \u50892 \u46300  \u53356 \u47196 \u49828 \u48708 \u45716  \u51060 \u47111 \u44172  \u47568 \u54616 \u50688 \u45796 . \'93\u50724 \u45720 \u45216  \u44536 \u47532 \u49828 \u46020  \u44368 \u54924 \u44032  \u44368 \u54924 \u51032  \u51452 \u51064  \u46104 \u49884 \u45716  \u44536 \u47532 \u49828 \u46020 \u51032  \u44228 \u54925 \u51012  \u44144 \u51032  \u49457 \u52712 \u54616 \u51648  \u47803 \u54616 \u44256  \u51080 \u45716  \u49324 \u49892 \u51012  \u50864 \u47532 \u44032  \u48156 \u44204 \u54616 \u45716 \u48148  \u51060 \u44163 \u51008  \u44618 \u51060  \u50864 \u47140 \u54644 \u50556  \u54624  \u47928 \u51228 \u51060 \u45796 . \u47560 \u52824  \u50715 \u51201  \u50976 \u45824 \u51064 \u46308 \u51060  \u50864 \u49345 \u49709 \u48176 \u51088 \u46308 \u44284  \u44368 \u51228 \u54632 \u51004 \u47196  \u47560 \u51020 \u51060  \u54616 \u45208 \u45784 \u50640 \u44172 \u49436  \u46496 \u45228 \u45912  \u44163 \u52376 \u47100 \'85\u50724 \u45720 \u45216 \u51032  \u50696 \u49688 \u45784 \u51032  \u44368 \u54924 \u45716  \u48127 \u51648  \u50506 \u45716  \u49464 \u49345 \u44284  \u44144 \u51667 \u46108  \u44368 \u51228 \u47484  \u54632 \u51004 \u47196  \u54616 \u45208 \u45784 \u44760 \u49436  \u51452 \u49888  \u52280 \u46108  \u49373 \u54876  \u48169 \u48277 \u51012  \u48260 \u47532 \u44256 , \u44536 \u47532 \u49828 \u46020 \u44032  \u50630 \u45716  \u49324 \u54924 \u51032  \u44536 \u47092  \u46319 \u54616 \u44172  \u48372 \u51060 \u47732 \u49436 \u46020  \u54644 \u47196 \u50868  \u49845 \u44288 \u51012  \u46384 \u47476 \u44256 , \u54616 \u45208 \u45784 \u51032  \u44228 \u49884 \u50752 \u45716  \u44288 \u44228 \u44032  \u50630 \u51012  \u49104  \u50500 \u45768 \u46972  \u51008 \u54812  \u44032 \u50868 \u45936  \u51088 \u46972 \u45208 \u45716  \u51068 \u44284 \u45716  \u51204 \u54784  \u48152 \u45824 \u46104 \u45716  \u45436 \u51613 \u51012  \u49324 \u50857 \u54616 \u44256  \u44536 \u47088  \u44208 \u47200 \u50640  \u46020 \u45804 \u54616 \u44256  \u51080 \u45796 \'94 (The Healthy Christian : An Appeal to the Church, pp.141, 142).\
\uc0\u49464 \u49549 \u51201 \u51064  \u44163 \u44284  \u54693 \u46973  \u52628 \u44396 \u51032  \u54413 \u51312  \u49549 \u50640 \u49436  \u44536 \u47532 \u49828 \u46020 \u47484  \u50948 \u54620  \u44537 \u44592 \u50752  \u51088 \u50500 \u55148 \u49373 \u51008  \u44144 \u51032  \u50756 \u51204 \u55176  \u49345 \u49892 \u46104 \u44256  \u51080 \u45796 . \'93\u50724 \u45720 \u45216  \u50864 \u47532 \u46308 \u51032  \u44368 \u54924 \u50640 \u49436  \u54876 \u46041 \u54616 \u44256  \u51080 \u45716  \u45224 \u45376 \u46308  \u51473  \u45908 \u47084 \u45716  \u50612 \u47536  \u49884 \u51208 \u50640  \u44536 \u47532 \u49828 \u46020 \u47484  \u50948 \u54616 \u50668  \u50612 \u46500  \u49324 \u50629 \u51012  \u54616 \u44592  \u50948 \u54644  \u55148 \u49373 \u54616 \u50668 \u50556  \u54624  \u44163 \u51012  \u48176 \u50868  \u49324 \u46988 \u46308 \u51060 \u45796 . \u44536 \u47084 \u45208  \u50724 \u45720 \u45216 \u50640 \u45716 \'85\u51088 \u44552 \u51060  \u54596 \u50836 \u54616 \u44172  \u46104 \u47732  \u50500 \u47924 \u46020  \u48148 \u52824 \u44256 \u51088  \u54616 \u51648  \u50506 \u45716 \u45796 . \u44536  \u45824 \u49888  \u44536 \u46308 \u51008  \u51088 \u49440 \u49884  (\u24904 \u21892 \u24066 ), \u50672 \u44537 , \u47784 \u51032 \u51116 \u54032  (\u27169 \u25836 \u35009 \u21028 ), \u44264 \u46041 \u54408  \u44048 \u49345 \u54924  (\u39592 \u33891 \u21697 \u37969 \u36062 \u26371 ), \u47924 \u49832  \u49884 \u49885 \u54924  (\u35430 \u39135 \u26371 ) \u46321 \u44284  \u44057 \u51060  \u49324 \u46988 \u46308 \u51012  \u44592 \u49240 \u44172  \u54616 \u45716  \u54924 \u51665 \u51012  \u50676 \u44172  \u46108 \u45796 .\'94\
\uc0\u50948 \u49828 \u53080 \u49888  \u51452 \u51032  \u50892 \u49884 \u48264  \u51648 \u49324 \u45716  1873\u45380  1\u50900  9\u51068  \u44536 \u51032  \u50672 \u46160  \u44368 \u49436 \u50640 \u49436  \u45796 \u51020 \u44284  \u44057 \u51060  \u50616 \u47749 \u54616 \u50688 \u45796 . \'93\u45432 \u47492 \u44988 \u51012  \u47564 \u46300 \u45716  \u54617 \u44368 \u45716  \u54224 \u49604 \u54644 \u50556  \u54620 \u45796 \u45716  \u50612 \u46500  \u48277 \u47456 \u51060  \u54596 \u50836 \u54620  \u44163  \u44057 \u45796 . \u51060 \u47088  \u51068 \u51008  \u46020 \u52376 \u50640  \u51080 \u45796 . \u44368 \u54924 \u50640 \u49436 \u46020  (\u47784 \u47476 \u45716  \u51473 \u50640  \u54616 \u45716  \u51068 \u51060 \u44192 \u51648 \u47564 ) \u46412 \u47196 \u45716  \u47560 \u44480 \u51032  \u51068 \u51012  \u54616 \u44256  \u51080 \u45796 . \u49548 \u50948  \u51088 \u49440  \u51020 \u50501 \u54924 , \u51088 \u49440 \u55141 \u54665 , \u52628 \u52392 \u54616 \u45716  \u44163 \u46308 \u51060  \u51333 \u44368  \u54841 \u51008  \u51088 \u49440 \u49324 \u50629 \u51012  \u47785 \u51201 \u51004 \u47196  \u44060 \u52572 \u46104 \u45716  \u49688 \u46020  \u51080 \u45796 . \u44536 \u47084 \u45208  \u48373 \u44428  (\u31119 \u21048 ) \u51060 \u46972 \u46304 \u51648  \u54788 \u49345  \u52628 \u52392  \u44057 \u51008  \u44163 \u46308 \u51060  \u50424 \u45936 \u50630 \u45716  \u47785 \u51201 \u51012  \u50948 \u54616 \u50668  \u54665 \u54616 \u50668 \u51652 \u45796 . \u44536 \u44163 \u46308 \u51008  \u50500 \u47924  \u50976 \u51061 \u46020  \u50630 \u44256  \u45796 \u47564  \u46024 \u51012  \u48268 \u47140 \u45716  \u44228 \u52293 \u50640  \u48520 \u44284 \u54616 \u45796 . \u51068 \u54616 \u51648  \u50500 \u45768 \u54616 \u44256  \u46024 \u51060 \u45208  \u51116 \u49328 \u51012  \u50619 \u45716  \u44163 \u52376 \u47100  \u53945 \u55176  \u52397 \u45380 \u46308 \u51012  \u53440 \u46973 \u49884 \u53412 \u44256  \u47560 \u48708 \u49884 \u53412 \u45716  \u44163 \u51008  \u50630 \u45796 . \u51316 \u44221 \u48155 \u51012  \u47564 \u54620  \u49324 \u46988 \u46308 \u51060  \u44536 \u47088  \u53804 \u44592 \u51201 \u51064  \u49324 \u50629 \u50640  \u48736 \u51256 \u46308 \u47732 \u49436  \u46024 \u51012  \u51339 \u51008  \u47785 \u51201 \u50640  \u49324 \u50857 \u54620 \u45796 \u45716  \u44396 \u49892 \u47196  \u44536 \u46308 \u51032  \u50577 \u49900 \u51012  \u49828 \u49828 \u47196  \u45804 \u47000 \u44256  \u51080 \u45716  \u44163 \u51012  \u48380  \u46412  \u48120 \u44397 \u51032  \u52397 \u45380 \u46308 \u51060  \u45320 \u47924 \u46020  \u55124 \u55176  \u46020 \u48149 \u49457 \u51012  \u51088 \u44537 \u54616 \u45716  \u49845 \u44288 \u50640  \u48736 \u51256  \u46308 \u50612 \u44032 \u45716  \u44163 \u51060  \u51060 \u49345 \u54620  \u51068 \u51060  \u50500 \u45768 \u45796 .\'94\
\uc0\u49464 \u49345 \u44284  \u53440 \u54801 \u54616 \u45716  \u51221 \u49888 \u51060  \u50728  \u44536 \u47532 \u49828 \u46020 \u44368 \u44228 \u47484  \u53685 \u54616 \u50668  \u44368 \u54924 \u46308  \u50504 \u51004 \u47196  \u52840 \u51077 \u54616 \u44256  \u51080 \u45796 . \u47196 \u48260 \u53944  \u50528 \u53944 \u53416 \u51592  \u50472 \u45716  \u47088 \u45912 \u50640 \u49436  \u54620  \u44536 \u51032  \u49444 \u44368 \u50640 \u49436  \u50689 \u44397 \u50640  \u54200 \u47564 \u54620  \u50689 \u51201  \u49632 \u53748 \u51032  \u50612 \u46160 \u50868  \u47732 \u51012  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u54616 \u50688 \u45796 . \'93\u52280 \u46108  \u44277 \u51032 \u45716  \u49464 \u49345 \u50640 \u49436  \u49324 \u46972 \u51276 \u44256 , \u51060 \u47484  \u47560 \u51020 \u50640  \u44036 \u51649 \u54620  \u49324 \u46988 \u51008  \u52286 \u50500 \u48380  \u49688  \u50630 \u45796 . \u50724 \u45720 \u45216  \u44033  \u44368 \u54924 \u51032  \u49888 \u51088 \u46972 \u44256  \u51088 \u52845 \u54616 \u45716  \u51088 \u46308 \u51008  \u49464 \u49345 \u51012  \u49324 \u46993 \u54616 \u44256 , \u49464 \u49345 \u44284  \u53440 \u54801 \u54616 \u44256 , \u50977 \u49888 \u51032  \u54200 \u50504 \u51012  \u44396 \u54616 \u44256 , \u45796 \u47480  \u49324 \u46988 \u46308 \u50640 \u44172  \u51316 \u44221 \u48155 \u44592 \u47484  \u44040 \u47581 \u54620 \u45796 . \u44536 \u46308 \u51008  \u44536 \u47532 \u49828 \u46020 \u51032  \u44256 \u45212 \u50640  \u46041 \u52280 \u54616 \u44592  \u50948 \u54616 \u50668  \u48512 \u47492 \u51012  \u48155 \u50520 \u51648 \u47560 \u45716  \u48708 \u45212 \u51012  \u48155 \u45716  \u51068 \u50640 \u45716  \u44865 \u47924 \u45768 \u47484  \u48764 \u44256  \u51080 \u45796 \'85\u48176 \u44368 , \u48176 \u44368 , \u48176 \u44368 \u44032  \u44033  \u44368 \u54924 \u51032  \u48148 \u47196  \u51221 \u47732 \u50640  \u49352 \u44200 \u51256  \u51080 \u45796 . \u44536 \u47084 \u45208  \u44536 \u46308 \u51060  \u44536 \u44163 \u51012  \u50508 \u44256  \u45712 \u45184 \u45796 \u47732  \u44536 \u46308 \u50640 \u44172 \u45716  \u55148 \u47581 \u51060  \u51080 \u51012  \u44163 \u51060 \u45796 . \u44536 \u47084 \u45208  \u49836 \u54532 \u44172 \u46020  \u44536 \u46308 \u50640 \u44172 \u45716  \u55148 \u47581 \u51060  \u50630 \u45796 . \u44536 \u46308 \u51008  \'91\u50864 \u47532 \u45716  \u48512 \u51088 \u46972  \u48512 \u50836 \u54616 \u50668  \u48512 \u51313 \u54620  \u44163 \u51060  \u50630 \u45796 \'92\u44256  \u50808 \u52828 \u45796 \'94 (Second Advent Library tract No.39).\
