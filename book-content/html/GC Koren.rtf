\uc0\u50612 \u46500  \u49884 \u45824 \u47484  \u47561 \u47200 \u54616 \u44256  \u54616 \u45208 \u45784 \u44760 \u49436  \u45817 \u49888 \u51032  \u51333 \u46308 \u51012  \u53685 \u54616 \u50668  \u49464 \u49345 \u50640  \u48372 \u45236 \u49888  \u44221 \u44256 \u45716  \u51060 \u50752  \u44057 \u51008  \u51312 \u49548 \u50752  \u48520 \u49888 \u51004 \u47196  \u52712 \u44553 \u46104 \u50632 \u45796 . \u54861 \u49688  \u51204 \u50640  \u49464 \u49345 \u51032  \u51396 \u50501  \u46412 \u47928 \u50640  \u49464 \u49345 \u51012  \u54861 \u49688 \u47196  \u47736 \u54624  \u49688 \u48150 \u50640  \u50630 \u44172  \u46104 \u50632 \u51012  \u46412 \u50640 \u46020  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u47676 \u51200  \u44536 \u46308 \u51060  \u50501 \u54620  \u44600 \u50640 \u49436  \u46028 \u51060 \u53420  \u49688  \u51080 \u45716  \u44592 \u54924 \u47484  \u44032 \u51656  \u49688  \u51080 \u46020 \u47197  \u44536 \u46308 \u50640 \u44172  \u45817 \u49888 \u51032  \u47785 \u51201 \u51012  \u50508 \u47140  \u51452 \u49512 \u45796 . \u54616 \u45208 \u45784 \u51032  \u51652 \u45432 \u47196  \u44536 \u46308 \u51060  \u47736 \u47581 \u46104 \u51648  \u50506 \u46020 \u47197  120\u45380 \u44036  \u54924 \u44060 \u51032  \u44221 \u44256 \u44032  \u44536 \u46308 \u51032  \u44256 \u47561 \u51012  \u50872 \u47160 \u45796 . \u44536 \u47084 \u45208  \u49324 \u46988 \u46308 \u51008  \u44536  \u44221 \u44256 \u47484  \u54728 \u54889 \u46108  \u51060 \u50556 \u44592 \u52376 \u47100  \u49373 \u44033 \u54616 \u44256  \u48127 \u51648  \u50506 \u50520 \u45796 . \u44536 \u46308 \u51008  \u51396 \u50501 \u51004 \u47196  \u45824 \u45812 \u54616 \u50668 \u51256 \u49436  \u54616 \u45208 \u45784 \u44760 \u49436  \u48372 \u45236 \u49888  \u49324 \u51088 \u47484  \u51312 \u47217 \u54616 \u44256 , \u44536 \u51032  \u50528 \u50896 \u51012  \u47736 \u49884 \u54616 \u44256 , \u44536 \u47484  \u49900 \u55176  \u52280 \u46988  (\u20717 \u28651 ) \u46108  \u51088 \u46972 \u44256  \u48708 \u45212 \