\uc0\u44536 \u45716  \u44148 \u44053 \u54620  \u50977 \u52404 \u47484  \u44032 \u51276 \u44256 , \u50612 \u47536  \u49884 \u51208 \u50640  \u48268 \u50024  \u48708 \u48276 \u54620  \u51648 \u47141 \u51012  \u44032 \u51276 \u45796 \u45716  \u51613 \u44144 \u47484  \u45208 \u53440 \u45256 \u45796 . \u44536 \u44032  \u52264 \u52264  \u45208 \u51060 \u47484  \u47673 \u50612 \u44048 \u50640  \u46384 \u46972 \u49436  \u44536  \u49324 \u49892 \u51008  \u45908 \u50865  \u54788 \u51200 \u54644 \u51276 \u45796 . \u44536 \u45716  \u48708 \u47197  \u44256 \u46321  \u44368 \u50977 \u51012  \u48155 \u51012  \u49688  \u51080 \u45716  \u54812 \u53469 \u51008  \u45572 \u47532 \u51648  \u47803 \u54616 \u50688 \u51004 \u45208  \u48176 \u50864 \u44592  \u51339 \u50500 \u54616 \u45716  \u44536 \u51032  \u47560 \u51020 \u44284  \u51452 \u51032 \u44618 \u51060  \u49324 \u49353 \u54616 \u45716  \u49845 \u44288 \u44284  \u48712 \u53960 \u50630 \u45716  \u48708 \u54032 \u47141  \u46321 \u51008  \u44536 \u47196  \u54616 \u50668 \u44552  \u44148 \u51204 \u54620  \u54032 \u45800 \u47141 \u44284  \u54413 \u48512 \u54620  \u51060 \u54644 \u47141 \u51012  \u44054 \u52632  \u51064 \u47932 \u51060  \u46104 \u44172  \u54616 \u50688 \u45796 . \u44536 \u45716  \u48708 \u45212 \u54624  \u50668 \u51648 \u50630 \u45716  \u46020 \u45909 \u51201  \u54408 \u49457 \u51012  \u49548 \u50976 \u54616 \u44256  \u51080 \u50632 \u51004 \u48064 \u47196  \u51068 \u48152 \u51201 \u51004 \u47196  \u52397 \u47156 \u54616 \u44256  \u44160 \u49548 \u54616 \u44256  \u44288 \u45824 \u54620  \u51064 \u47932 \u47196  \u51316 \u44221 \u48155 \u44256  \u51080 \u50632 \u45796 . \u44536 \u45716  \u46608 \u54620  \u48512 \u51648 \u47088 \u55176  \u45432 \u47141 \u54616 \u44256  \u50528 \u50420  \u44208 \u44284 \u47196  \u51068 \u52237 \u48512 \u53552  \u49345 \u45817 \u54620  \u51116 \u49328 \u51012  \u49548 \u50976 \u54616 \u44172  \u46104 \u50632 \u45796 . \u44536 \u47092 \u51648 \u46972 \u46020  \u44536 \u45716  \u50672 \u44396 \u54616 \u45716  \u49845 \u44288 \u51012  \u44228 \u49549  \u44032 \u51648 \u44256  \u51080 \u50632 \u45796 . \u44536 \u45716  \u51221 \u52824 \u50752  \u44400 \u49324  \u47732 \u50640 \u49436 \u46020  \u49345 \u45817 \u54620  \u49688 \u50756 \u51012  \u44054 \u52628 \u44256  \u51080 \u50632 \u51004 \u48064 \u47196  \u44536 \u50640 \u44172 \u45716  \u47749 \u50696 \u50752  \u51116 \u49328 \u51012  \u50619 \u51012  \u44600 \u51060  \u45331 \u44172  \u50676 \u47140  \u51080 \u50632 \u45796 .\
