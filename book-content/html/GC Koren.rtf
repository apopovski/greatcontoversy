\uc0\u51060  \u47568 \u50432 \u51060  \u49888 \u50557  \u49884 \u45824 \u50640  \u51201 \u50857 \u46108 \u45796 \u45716  \u44163 \u51008  \u44536  \u44544 \u51032  \u51204 \u54980  \u44288 \u44228 \u47484  \u48372 \u47732  \u48516 \u47749 \u54616 \u45796 . \'93\u51060 \u49828 \u46972 \u50648 \u51032  \u51923 \u44200 \u45212  \u51088 \u47484  \u47784 \u51004 \u45716  \u51452  \u50668 \u54840 \u50752 \u44032  \u47568 \u54616 \u45432 \u45768  \u45236 \u44032  \u51060 \u48120  \u47784 \u51008  \u48376  \u48177 \u49457  \u50808 \u50640  \u46608  \u47784 \u50500  \u44536 \u50640 \u44172  \u49549 \u54616 \u44172  \u54616 \u47532 \u46972 \'94 (\u49324  56:8). \u50668 \u44592 \u50640  \u48373 \u51020 \u51004 \u47196  \u47568 \u48120 \u50516 \u50500  \u51060 \u48169 \u51064 \u51060  \u47784 \u51060 \u44172  \u46112  \u44163 \u51060  \u50696 \u49884 \u46104 \u50612  \u51080 \u45796 . \u44536 \u47532 \u44256  \u50504 \u49885 \u51068 \u51012  \u51316 \u51473 \u55176  \u50668 \u44592 \u45716  \u49324 \u46988 \u46308 \u50640 \u44172  \u52629 \u48373 \u51060  \u49440 \u54252 \u46104 \u50612  \u51080 \u45796 . \u44536 \u50752  \u44057 \u51060  \u45367 \u51704  \u44228 \u47749 \u51012  \u51648 \u53420  \u51032 \u47924 \u45716  \u44536 \u47532 \u49828 \u46020 \u51032  \u51453 \u51004 \u49900 \u44284  \u48512 \u54876 \u44284  \u49849 \u52380 \u51004 \u47196  \u45149 \u45208 \u45716  \u44163 \u51060  \u50500 \u45768 \u46972  \u54616 \u45208 \u45784 \u51032  \u51333 \u46308 \u51060  \u47564 \u48124 \u50640 \u44172  \u48373 \u51020 \u51032  \u44592 \u48324 \u51012  \u51204 \u54616 \u45716  \u46412 \u50640 \u46020  \u50668 \u51204 \u55176  \u51080 \u51012  \u44163 \u51060 \u45796 .\
