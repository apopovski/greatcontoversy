\uc0\u50689 \u44397 \u50640 \u45716  \u47588 \u50864  \u51068 \u52237 \u48512 \u53552  \u49692 \u49688 \u54620  \u44536 \u47532 \u49828 \u46020 \u44368 \u44032  \u49100 \u47532 \u47484  \u45236 \u47160 \u45796 . \u52572 \u52488 \u51032  \u49688 \u49464 \u44592  \u46041 \u50504 \u50640  \u50689 \u44397 \u51064 \u46308 \u51060  \u48155 \u50500 \u46308 \u51064  \u48373 \u51020 \u51008  \u47196 \u47560 \u44368 \u51032  \u48176 \u44368 \u47196  \u48512 \u54056 \u46104 \u51648  \u50506 \u51008  \u48373 \u51020 \u51060 \u50632 \u45796 . \u50689 \u44397 \u51032  \u52572 \u52488 \u51032  \u44368 \u54924 \u46308 \u51060  \u47196 \u47560 \u47196 \u48512 \u53552  \u48155 \u51008  \u50976 \u51068 \u51032  \u49440 \u47932 \u51008  \u47680 \u47532  \u46504 \u50612 \u51652  \u54644 \u50504 \u50640 \u44620 \u51648  \u48120 \u52828  \u51060 \u44368  \u54889 \u51228 \u46308 \u51032  \u48149 \u54644 \u49104 \u51060 \u50632 \u45796 . \u47566 \u51008  \u44536 \u47532 \u49828 \u46020 \u51064 \u46308 \u51008  \u50689 \u44397 \u50640 \u49436 \u51032  \u54605 \u48149 \u51012  \u54588 \u54616 \u50668  \u49828 \u53076 \u53952 \u47004 \u46300 \u47196  \u44052 \u45796 . \u44536 \u47532 \u44256  \u44144 \u44592 \u49436  \u51652 \u47532 \u45716  \u47560 \u52840 \u45236  \u50500 \u51068 \u47004 \u46300 \u50640 \u44620 \u51648  \u54140 \u51256 \u44052 \u45716 \u45936 , \u44536  \u45208 \u46972 \u46308 \u51008  \u47784 \u46160  \u51060  \u51652 \u47532 \u47484  \u54872 \u50689 \u54616 \u50688 \u45796 .\
\uc0\u49353 \u49832 \u51313 \u51060  \u50689 \u44397 \u51012  \u52840 \u47029 \u54616 \u44172  \u46104 \u51088 , \u51060 \u44368 \u46020 \u46308 \u51060  \u51648 \u48176 \u44428 \u51012  \u54665 \u49324 \u54616 \u44172  \u46104 \u50632 \u45796 . \u51221 \u48373 \u51088 \u46308 \u51008  \u44536 \u46308 \u51060  \u51221 \u48373 \u54620  \u54588 \u51221 \u48373 \u48124 \u50640 \u44172 \u49436  \u48176 \u50864 \u44592 \u47484  \u51339 \u50500 \u54616 \u51648  \u50500 \u45768 \u54616 \u50688 \u51004 \u48064 \u47196 , \u44536 \u47532 \u49828 \u46020 \u51064 \u46308 \u51008  \u49328 \u44284  \u44305 \u50556 \u47196  \u54588 \u45212 \u54616 \u51648  \u50506 \u51012  \u49688  \u50630 \u50632 \u45796 . \u48731 \u51008  \u54620 \u46041 \u50504  \u44032 \u47140 \u51276 \u51004 \u45208 , \u44228 \u49549  \u53440 \u44256  \u51080 \u50632 \u45796 . \u51068 \u49464 \u44592  \u54980 \u50640  \u47680 \u47532  \u46504 \u50612 \u51256  \u51080 \u45716  \u50668 \u47084  \u45208 \u46972 \u50640 \u44620 \u51648  \u54140 \u51256 \u44036  \u48731 \u51008  \u49828 \u53076 \u53952 \u47004 \u46300 \u50640 \u49436  \u48157 \u55176  \u48731 \u45228 \u45796 . \u50500 \u51068 \u47004 \u46300 \u47196 \u48512 \u53552  \u44221 \u44148 \u54620  \u53084 \u47352 \u48148  (Columba) \u50752  \u44536 \u51032  \u46041 \u50669 \u51088 \u46308 \u51060  \u50752 \u49436  \u44033 \u52376 \u50640  \u55145 \u50612 \u51256  \u51080 \u45716  \u49888 \u46020 \u46308 \u51012  \u51201 \u47561 \u54620  \u50500 \u51060 \u50724 \u45208  \u49452 \u51004 \u47196  \u47784 \u50520 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536  \u49452 \u51008  \u44536 \u46308 \u51032  \u49440 \u44368  \u49324 \u50629 \u51032  \u51473 \u49900 \u51648 \u44032  \u46104 \u50632 \u45796 . \u44536  \u51204 \u46020 \u51088 \u46308  \u51473 \u50640  \u49457 \u44221 \u49345  \u50504 \u49885 \u51068 \u51012  \u51456 \u49688 \u54616 \u45716  \u54620  \u49324 \u46988 \u51060  \u51080 \u50632 \u45796 . \u44536 \u47532 \u54616 \u50668  \u51060  \u5165