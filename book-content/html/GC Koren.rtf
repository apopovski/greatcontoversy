\f1\b0 \cf0 \
\uc0\u44536 \u45716  \u49457 \u44221 \u50640 \u49436  \u44536 \u47532 \u49828 \u46020 \u47484  \u48156 \u44204 \u54616 \u50688 \u45796 . \u44536 \u47532 \u44256  \u44536 \u45716  \u48512 \u47476 \u51670 \u50632 \u45796 . \'93\u50724 , \u50500 \u48260 \u51648 ! \u44536 \u48516 \u51032  \u55148 \u49373 \u51008  \u45817 \u49888 \u51032  \u51652 \u45432 \u47484  \u44536 \u52824 \u44172  \u54616 \u50688 \u44256 , \u44536 \u48516 \u51032  \u54588 \u45716  \u45208 \u51032  \u47566 \u51008  \u54728 \u47932 \u51012  \u50491 \u50612  \u48260 \u47160 \u49845 \u45768 \u45796 . \u44536 \u48516 \u51032  \u49901 \u51088 \u44032 \u45716  \u45208 \u51032  \u51200 \u51452 \u47484  \u45824 \u49888  \u51276 \u44256 , \u44536 \u48516 \u51032  \u51453 \u51020 \u51008  \u45208 \u47484  \u49549 \u47049 \u54616 \u50688 \u49845 \u45768 \u45796 . \u50864 \u47532 \u45716  \u50864 \u47532  \u51088 \u49888 \u46308 \u50640 \u44172  \u50500 \u47924  \u49548 \u50857 \u50630 \u45716  \u50612 \u47532 \u49437 \u51008  \u44163 \u46308 \u51012  \u47566 \u51060  \u44256 \u50504 \u54664 \u49845 \u45768 \u45796 . \u44536 \u47084 \u45208  \u45817 \u49888 \u51008  \u45817 \u49888 \u51032  \u47568 \u50432 \u51012  \u54915 \u48520 \u52376 \u47100  \u45236  \u50526 \u50640  \u46160 \u49512 \u49845 \u45768 \u45796 . \u44536 \u47532 \u44256  \u45817 \u49888 \u51008  \u45208 \u51032  \u47560 \u51020 \u51012  \u44048 \u46041 \u54616 \u49324 , \u45208 \u47196  \u54616 \u50668 \u44552  \u50696 \u49688 \u45784 \u51032  \u44277 \u47196  \u51060 \u50808 \u50640 \u45716  \u50500 \u47924 \u44163 \u51060 \u45208  \u45796  \u49899 \u50612 \u54616 \u44172 \u45140  \u54616 \u49512 \u49845 \u45768 \u45796 \'94 (Martyn, vol.3, ch.13).\
\uc0\u52860 \u48712 \u51008  \u49457 \u51649 \u51088 \u44032  \u46104 \u44592  \u50948 \u54616 \u50668  \u44368 \u50977 \u51012  \u48155 \u50500  \u50772 \u45796 . \u44536 \u45716  \u44200 \u50864  \u50676 \u46160  \u49332 \u51060  \u46104 \u50632 \u51012  \u46412 , \u50612 \u46500  \u51089 \u51008  \u44368 \u54924 \u51032  \u49444 \u44368 \u51088 \u47196  \u51076 \u47749 \u46104 \u50632 \u51004 \u47728 , \u44536 \u51032  \u47672 \u47532 \u45716  \u44368 \u54924 \u51032  \u44508 \u51221 \u50640  \u46384 \u46972  \u44048 \u46021 \u51032  \u49552 \u51004 \u47196  \u51687 \u44172  \u44622 \u50668  \u51080 \u50632 \u45796 . \u44536 \u45716  \u50500 \u51649  \u50504 \u49688 \u47484  \u48155 \u51648  \u50506 \u50520 \u44256 , \u49888 \u48512 \u47196 \u49436 \u51032  \u51649 \u47924 \u46020  \u51060 \u54665 \u54616 \u51648  \u50506 \u50520 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u49457 \u51649 \u51088 \u51032  \u54620  \u49324 \u46988 \u51004 \u47196 \u49436  \u51088 \u44592 \u51032  \u51649 \u48516 \u50640  \u45824 \u54620  \u52845 \u54840 \u47484  \u44032 \u51648 \u44256  \u51080 \u50632 \u44256 , \u44536  \u51649 \u47924 \u50640  \u45824 \u54620  \u48372 \u49688 \u46020  \u48155 \u44256  \u51080 \u50632 \u45796 .\
\uc0\u51060 \u51228  \u44536 \u45716  \u49888 \u48512 \u44032  \u46112  \u49688  \u50630 \u51020 \u51012  \u44648 \u45803 \u44256 , \u50620 \u47560  \u46041 \u50504  \u48277 \u47456  \u44277 \u48512 \u47196  \u48169 \u54693 \u51012  \u46028 \u47160 \u45796 . \u44536 \u47084 \u45208  \u47560 \u52840 \u45236  \u44536 \u45716  \u51060  \u47785 \u51201 \u46020  \u48260 \u47532 \u44256  \u51088 \u44592 \u51032  \u49373 \u50528 \u47484  \u48373 \u51020 \u51012  \u50948 \u54616 \u50668  \u48148 \u52824 \u44592 \u47196  \u44208 \u49900 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u44277 \u44277 \u50672 \u54616 \u44172  \u44032 \u47476 \u52824 \u45716  \u49324 \u46988 \u51060  \u46104 \u45716  \u51068 \u51012  \u51452 \u51200 \u54616 \u50688 \u45796 . \u49440 \u52380 \u51201 \u51004 \u47196  \u49688 \u51469 \u51020 \u51060  \u47566 \u51008  \u44536 \u45716  \u44536  \u51648 \u50948 \u50640  \u46384 \u47476 \u45716  \u47924 \u44144 \u50868  \u52293 \u51076 \u51012  \u45712 \u45180 \u44256 , \u50668 \u51204 \u55176  \u50672 \u44396 \u50640  \u51204 \u45392 \u54616 \u44592 \u47484  \u50896 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u52828 \u44396 \u46308 \u51032  \u45128 \u45909 \u51652  \u44428 \u50976 \u45716  \u47560 \u52840 \u45236  \u44536 \u51032  \u46041 \u51032 \u47484  \u50619 \u50632 \u45796 . \'93\u51060 \u52376 \u47100  \u48120 \u52380 \u54620  \u52636 \u49888 \u51032  \u49324 \u46988 \u51060  \u44536 \u47111 \u44172  \u54988 \u47469 \u54620  \u51649 \u48516 \u51012  \u48155 \u50500  \u45458 \u51076 \u51012  \u48155 \u44172  \u46104 \u45716  \u44163 \u51008  \u52280 \u51004 \u47196  \u45440 \u46972 \u50868  \u51068 \u51060 \u45796 \'94 (Wylie, b.13, ch.9) \u44256  \u44536 \u45716  \u47568 \u54616 \u50688 \u45796 .\
\uc0\u52860 \u48712 \u51008  \u44536 \u51032  \u49324 \u50629 \u51012  \u51312 \u50857 \u55176  \u52265 \u49688 \u54616 \u50688 \u45796 . \u44536 \u51032  \u47568 \u51008  \u47560 \u52824  \u46405 \u51012  \u51201 \u49884 \u45716  \u51060 \u49836 \u44284  \u44057 \u50520 \u45796 . \u44536 \u45716  \u54028 \u47532 \u47484  \u46496 \u45208 \u49436  \u48373 \u51020 \u51012  \u49324 \u46993 \u54616 \u44256  \u48373 \u51020 \u51032  \u50669 \u44400 \u46308 \u51012  \u48372 \u54840 \u54616 \u44592  \u50948 \u54616 \u50668  \u55192 \u51012  \u45796 \u54616 \u44256  \u51080 \u45912  \u47560 \u44032 \u47112 \u53944  \u50668 \u50773 \u51032  \u48372 \u54840  \u50500 \u47000  \u51080 \u45716  \u51648 \u48169 \u51032  \u54620  \u51089 \u51008  \u46020 \u49884 \u50640  \u51060 \u51228  \u44144 \u54616 \u44172  \u46104 \u50632 \u45796 . \u52860 \u48712 \u51008  \u50668 \u51204 \u55176  \u50728 \u50976 \u54616 \u44256  \u51088 \u44557 \u54624  \u51460  \u47784 \u47476 \u45716  \u52397 \u45380 \u51060 \u50632 \u45796 . \u44536 \u51032  \u49324 \u50629 \u51008  \u44032 \u51221 \u50640  \u51080 \u45716  \u49324 \u46988 \u46308 \u51012  \u51473 \u49900 \u51004 \u47196  \u49884 \u51089 \u46104 \u50632 \u45796 . \u44536 \u45716  \u44032 \u51313 \u46308 \u51012  \u47784 \u50500  \u45459 \u44256  \u49457 \u44221 \u51012  \u51069 \u44256 , \u44396 \u50896 \u51032  \u51652 \u47532 \u47484  \u44648 \u50864 \u52432  \u51452 \u50632 \u45796 . \u48373 \u51020 \u51032  \u44592 \u48324 \u51012  \u46308 \u51008  \u49324 \u46988 \u46308 \u51008  \u44536  \u44592 \u49244  \u49548 \u49885 \u51012  \u45796 \u47480  \u49324 \u46988 \u46308 \u50640 \u44172  \u51204 \u54616 \u50668  \u51452 \u50632 \u51004 \u48064 \u47196  \u44536 \u45716  \u50724 \u47000 \u51648  \u50506 \u50500  \u44536  \u44275 \u51012  \u46496 \u45208  \u47680 \u47532  \u51080 \u45716  \u52492 \u46973 \u44284  \u46020 \u49884 \u47484  \u52286 \u50500 \u44052 \u45796 . \u44536 \u45716  \u44480 \u51313 \u46308 \u51032  \u53360  \u51665 \u44284  \u44032 \u45212 \u54620  \u49324 \u46988 \u51032  \u50724 \u47561 \u49332 \u51060 \u47484  \u44032 \u47532 \u51648  \u50506 \u44256  \u46308 \u50612 \u44032 \u49436  \u50857 \u44048 \u54620  \u51652 \u47532 \u51032  \u51613 \u51064 \u46308 \u51012  \u47564 \u46308 \u50612  \u45244  \u44368 \u54924 \u51032  \u44592 \u52488 \u47484  \u45459 \u51004 \u47732 \u49436  \u51204 \u51652 \u54616 \u50688 \u45796 .\
\uc0\u47751  \u45804  \u54980 \u50640  \u44536 \u45716  \u45796 \u49884  \u54028 \u47532 \u50640  \u50772 \u45796 . \u54028 \u47532 \u50640 \u45716  \u55124 \u55176  \u48380  \u49688  \u50630 \u45716  \u46041 \u50836 \u44032  \u50976 \u49885 \u54620  \u48512 \u51088 \u46308  \u49324 \u51060 \u50640 \u49436  \u51068 \u50612 \u45228 \u45796 . \u44256 \u45824 \u51032  \u50616 \u50612 \u47484  \u50672 \u44396 \u54632 \u51004 \u47196  \u49324 \u46988 \u46308 \u51008  \u49457 \u44221 \u51012  \u51452 \u47785 \u54616 \u44172  \u46104 \u50632 \u44256 , \u49457 \u44221 \u51032  \u51652 \u47532 \u47196  \u47560 \u51020 \u51060  \u50500 \u51649  \u49324 \u47196 \u51105 \u55176 \u51648  \u50506 \u51008  \u47566 \u51008  \u49324 \u46988 \u46308 \u51060  \u51652 \u47532 \u50640  \u45824 \u54616 \u50668  \u50676 \u47148 \u55176  \u53664 \u47200 \u54616 \u44256 , \u47196 \u47560 \u44368 \u51032  \u51648 \u51648 \u51088 \u46308 \u51012  \u45824 \u54637 \u54616 \u50668  \u53804 \u51137 \u44620 \u51648  \u51204 \u44060 \u54616 \u44256  \u51080 \u50632 \u45796 . \u52860 \u48712 \u51008  \u48708 \u47197  \u49888 \u54617 \u51201  \u45436 \u51137 \u50640 \u49436 \u45716  \u50976 \u45733 \u54620  \u53804 \u49324 \u50688 \u51648 \u47560 \u45716 , \u44536  \u54617 \u51088 \u46308 \u44284  \u49548 \u46976 \u49828 \u47088  \u45436 \u51137 \u51012  \u54616 \u45716  \u44163  \u51060 \u49345 \u51032  \u49324 \u47749 \u51012  \u44032 \u51648 \u44256  \u51080 \u50632 \u45796 . \u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u51008  \u55141 \u48516  \u49345 \u53468 \u50640  \u45459 \u50668  \u51080 \u50632 \u44256 , \u51060 \u51228 \u45716  \u44536 \u46308 \u51032  \u47560 \u51020 \u50640  \u51652 \u47532 \u47484  \u48372 \u50668  \u51452 \u50612 \u50556  \u54624  \u46412 \u44032  \u46104 \u50632 \u45796 . \u45824 \u54617 \u51032  \u44053 \u45817 \u51060  \u49888 \u54617 \u51201 \u51064  \u45436 \u51137 \u51004 \u47196  \u49884 \u45124 \u47084 \u50872  \u46041 \u50504 , \u52860 \u48712 \u51008  \u51665 \u51665 \u51012  \u48169 \u47928 \u54616 \u50668  \u49324 \u46988 \u46308 \u50640 \u44172  \u49457 \u44221 \u51012  \u51069 \u50612  \u51452 \u44256 , \u44536 \u46308 \u50640 \u44172  \u44536 \u47532 \u49828 \u46020 \u50752  \u44536 \u48516 \u51032  \u49901 \u51088 \u44032 \u51032  \u51453 \u51020 \u50640  \u45824 \u54616 \u50668  \u47568 \u54644  \u51452 \u50632 \u45796 .\
