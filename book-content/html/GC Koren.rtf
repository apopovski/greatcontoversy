\uc0\u50696 \u49688 \u45784 \u51032  \u47749 \u47161 \u51004 \u47196  \u49324 \u44480 \u46308 \u51008  \u44536 \u46308 \u51032  \u54252 \u47196 \u46308 \u50640 \u44172 \u49436  \u46496 \u45208 \u44032 \u44256  \u44536  \u49324 \u46988 \u46308 \u51008  \u51312 \u50857 \u54616 \u44256  \u50728 \u49692 \u54616 \u44256  \u51221 \u49888 \u51060  \u46609 \u46609 \u54616 \u44172  \u46104 \u50612  \u44396 \u51452 \u51032  \u48156 \u50500 \u47000  \u50505 \u50520 \u45796 . \u44536 \u47084 \u45208  \u44536  \u49324 \u44480 \u46308 \u51008  \u46076 \u51648  \u46524 \u46308 \u51012  \u47792 \u50500  \u48148 \u45796  \u44032 \u50868 \u45936 \u47196  \u46308 \u50612 \u44032 \u46020 \u47197  \u50836 \u52397 \u54616 \u50668  \u54728 \u46973 \u51012  \u48155 \u50520 \u45796 . \u44536 \u47084 \u51088  \u44144 \u46972 \u49324  \u49324 \u46988 \u46308 \u51008  \u50696 \u49688 \u45784 \u44760 \u49436  \u51452 \u49888  \u52629 \u48373 \u48372 \u45796  \u44536  \u49552 \u49892 \u51060  \u45908  \u53356 \u45796  \u54616 \u50668  \u44144 \u47337 \u54620  \u52824 \u47308 \u51088  \u46104 \u49888  \u50696 \u49688 \u45784 \u51012  \u46496 \u45208 \u44032 \u46020 \u47197  \u44053 \u50836 \u54664 \u45796 . \u51060 \u44163 \u51060  \u49324 \u45800 \u51060  \u50619 \u44256 \u51088  \u54664 \u45912  \u44208 \u44284 \u50688 \u45796 . \u44536 \u46308 \u51032  \u49552 \u49892 \u50640  \u45824 \u54620  \u52293 \u51076 \u51012  \u50696 \u49688 \u45784 \u44760  \u46028 \u47548 \u51004 \u47196  \u49324 \u45800 \u51008  \u49324 \u46988 \u46308 \u50640 \u44172  \u51060 \u44592 \u51201  \u44277 \u54252 \u49900 \u51012  \u51068 \u51004 \u53020 \u49436  \u44536 \u46308 \u51060  \u44536 \u48516 \u51032  \u47568 \u50432 \u51012  \u46307 \u51648  \u47803 \u54616 \u46020 \u47197  \u48169 \u54644 \u54664 \u45796 . \u49324 \u45800 \u51008  \u49552 \u49892 , \u48520 \u54665 , \u44256 \u45212 \u51032  \u50896 \u51064 \u51012  \u44536 \u50752  \u44536 \u51032  \u48512 \u54616 \u46308 \u50640 \u44172  \u46028 \u47532 \u