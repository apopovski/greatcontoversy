\uc0\u50501 \u51032  \u50773 \u51088 \u45716  \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u46308 \u51060  \u54616 \u45720  \u46020 \u49457 \u51012  \u54693 \u54616 \u50668  \u50668 \u54665 \u51012  \u44228 \u49549 \u54616 \u45716  \u46041 \u50504  \u52384 \u46160 \u52384 \u48120 \u54616 \u44172  \u49912 \u50880 \u51012  \u44148 \u45796 . \u51204 \u48152 \u51201 \u51064  \u44368 \u54924  \u50669 \u49324 \u47484  \u53685 \u54616 \u50668  \u44060 \u54785  \u50868 \u46041 \u51060  \u44201 \u47148 \u54620  \u51109 \u50528 \u47484  \u47564 \u45208 \u51648  \u50506 \u44256  \u51652 \u54665 \u46108  \u51068 \u51060  \u50630 \u45796 . \u48148 \u50872 \u51032  \u49884 \u45824 \u50640 \u46020  \u50669 \u49884  \u44536 \u47084 \u54616 \u50688 \u45796 . \u44536 \u44032  \u44368 \u54924 \u47484  \u49464 \u50868  \u44275 \u50640 \u45716  \u50612 \u46356 \u50640 \u45208  \u48127 \u45432 \u46972 \u44256  \u44277 \u50616 \u54616 \u47732 \u49436 \u46020  \u51060 \u45800 \u49444 \u51012  \u51452 \u51109 \u54620  \u49324 \u46988 \u46308 \u51060  \u51080 \u50632 \u45716 \u45936 , \u47564 \u51068  \u44536 \u44163 \u51012  \u48155 \u50500 \u46308 \u51060 \u44172  \u46104 \u47732  \u54596 \u50672 \u51201 \u51004 \u47196  \u51652 \u47532 \u50640  \u45824 \u54620  \u49324 \u46993 \u51012  \u48260 \u47540  \u49688 \u48150 \u50640  \u50630 \u50632 \u45796 . \u47336 \u53552  \u50669 \u49884  \u54616 \u45208 \u45784 \u44760 \u49436  \u44536 \u46308 \u50640 \u44172  \u51649 \u51217  \u47568 \u50432 \u54616 \u49512 \u45796 \u44256  \u51452 \u51109 \u54616 \u47732 \u49436  \u51088 \u44592 \u46308 \u51032  \u49324 \u49345 \u51060 \u45208  \u51032 \u44204 \u51012  \u49457 \u44221 \u51032  \u51613 \u50616 \u48372 \u45796  \u45908  \u45458 \u51060 \u45716  \u44305 \u49888 \u51201 \u51064  \u49324 \u46988 \u46308  \u46412 \u47928 \u50640  \u53360  \u44256 \u53685 \u44284  \u50612 \u47140 \u50880 \u51012  \u45817 \u54616 \u50688 \u45796 . \u49888 \u50521 \u44284  \u44221 \u54744 \u51060  \u48512 \u5