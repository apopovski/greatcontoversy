\f1\b0 \cf0 \
\uc0\u44417 \u51221 \u51008  \u49324 \u52824 \u50752  \u48169 \u53461 \u50640  \u51104 \u44220 \u44256 , \u48177 \u49457 \u46308 \u44284  \u50948 \u51221 \u51088 \u46308  \u49324 \u51060 \u50640 \u45716  \u49888 \u51076 \u51060  \u44144 \u51032  \u50630 \u50632 \u45796 . \u51221 \u48512 \u51032  \u47784 \u46304  \u52376 \u49324 \u45716  \u50616 \u51228 \u45208  \u47784 \u47029 \u51201 \u51060 \u44256  \u51060 \u44592 \u51201 \u51064  \u44163 \u51004 \u47196  \u51032 \u49900 \u51012  \u48155 \u50520 \u45796 . \u54785 \u47749 \u51060  \u51068 \u50612 \u45208 \u44592  \u51204  \u48152 \u49464 \u44592  \u51060 \u49345 \u51032  \u44592 \u44036 \u50640  \u44152 \u52432 \u49436  \u47336 \u51060  15\u49464 \u44032  \u50773 \u50948 \u47484  \u52264 \u51648 \u54616 \u44256  \u51080 \u50632 \u45716 \u45936 , \u44536 \u45716  \u44536 \u52376 \u47100  \u50501 \u54620  \u49884 \u45824 \u50640  \u51080 \u50612 \u49436 \u46020 , \u45208 \u53468 \u54616 \u44256  \u44221 \u48149 \u54616 \u44256  \u51020 \u46976 \u54620  \u51076 \u44552 \u51004 \u47196  \u50976 \u47749 \u54616 \u50688 \u45796 . \u48512 \u54056 \u54616 \u44256  \u51092 \u50501 \u54620  \u44480 \u51313  \u51221 \u52824 , \u44032 \u45212 \u54616 \u44256  \u47924 \u51648 \u54620  \u54616 \u47448  \u44228 \u44553 , \u44397 \u44032 \u51032  \u51116 \u51221 \u51201  \u44260 \u46976 \u44284  \u48177 \u49457 \u46308 \u51032  \u44201 \u48516 , \u51060  \u47784 \u46304  \u44163 \u46308 \u51008  \u49440 \u51648 \u51088 \u51032  \u50504 \u47785 \u51060  \u50500 \u45776 \u51648 \u46972 \u46020  \u47924 \u49436 \u50868  \u49324 \u48320 \u51060  \u45796 \u44032 \u50724 \u44256  \u51080 \u51020 \u51012  \u50696 \u52769 \u54624  \u49688  \u51080 \u50632 \u45796 . \u50773 \u51008  \u44536 \u51032  \u49888 \u54616 \u46308 \u51032  \u44221 \u44256 \u50640  \u45824 \u54616 \u50668  \'93\u45236 \u44032  \u49332 \u50500  \u51080 \u45716  \u46041 \u50504 \u51008  \u51060 \u45824 \u47196  \u48260 \u54000 \u44256  \u45208 \u44032  \u48372 \u51088 . \u45236 \u44032  \u51453 \u51008  \u54980 \u50640  \u50612 \u46523 \u44172  \u46104 \u44192 \u51648 \'94\u46972 \u44256  \u50616 \u51228 \u45208  \u45824 \u45813 \u54616 \u50688 \u45796 . \u44060 \u54785 \u51032  \u54596 \u50836 \u47484  \u50500 \u47924 \u47532  \u50669 \u49444 \u54616 \u50668 \u46020  \u49548 \u50857 \u50630 \u45716  \u51068 \u51060 \u50632 \u45796 . \u50773 \u51008  \u51396 \u50501 \u51012  \u51064 \u51221 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u50640 \u44172 \u45716  \u51060 \u44163 \u51012  \u54785 \u49888 \u49884 \u53420  \u47564 \u54620  \u50857 \u44592 \u46020  \u45733 \u47141 \u46020  \u50630 \u50632 \u45796 . \u44536 \u51032  \u45208 \u53468 \u54616 \u44256  \u51060 \u44592 \u51201 \u51064  \u45824 \u45813 , \u44263  \'93\u51116 \u50521 \u51008  \u45208 \u51032  \u51453 \u51008  \u46244 \u50640 \'94\u46972 \u45716  \u47568 \u51008  \u48148 \u50556 \u55120 \u47196  \u45796 \u44032 \u50724 \u44256  \u51080 \u45716  \u54532 \u46993 \u49828 \u51032  \u50868 \u47749 \u51012  \u50668 \u49892 \u55176  \u54364 \u54788 \u54620  \u44163 \u51060 \u50632 \u45796 .\
\uc0\u47196 \u47560 \u44368 \u45716  \u50773 \u46308 \u44284  \u51648 \u48176  \u44228 \u44553 \u51032  \u51656 \u53804 \u49900 \u51012  \u51060 \u50857 \u54616 \u50668  \u48177 \u49457 \u46308 \u51012  \u45432 \u50696  \u49345 \u53468 \u47196  \u47926 \u50612  \u46160 \u46020 \u47197  \u50689 \u54693 \u51012  \u48120 \u52452 \u45796 . \u47196 \u47560 \u44368 \u45716  \u51060 \u50752  \u44057 \u51060  \u54616 \u50668  \u45208 \u46972 \u44032  \u50557 \u54868 \u46104 \u47732  \u48177 \u49457 \u46308 \u44284  \u53685 \u52824 \u51088 \u46308 \u51060  \u47784 \u46160  \u51088 \u44592 \u51032  \u51648 \u48176  \u50500 \u47000  \u46308 \u50612  \u50732  \u44163 \u51060 \u46972 \u45716  \u49324 \u49892 \u51012  \u51096  \u50508 \u44256  \u51080 \u50632 \u45796 . \u51060 \u50752  \u44057 \u51008  \u49440 \u44204 \u51201  \u51221 \u52293 \u50640  \u51032 \u54616 \u50668  \u47196 \u47560 \u44368 \u45716  \u49324 \u46988 \u46308 \u51012  \u54952 \u44284 \u51201 \u51004 \u47196  \u45432 \u50696  \u49345 \u53468 \u44032  \u46104 \u44172  \u54616 \u47140 \u47732  \u44536 \u46308 \u51032  \u49900 \u47161 \u51012  \u52264 \u44844 \u47196  \u52292 \u50892 \u50556  \u54620 \u45796 \u45716  \u44163 \u44284  \u44536 \u46308 \u51060  \u45432 \u50696 \u51032  \u49345 \u53468 \u50640 \u49436  \u48279 \u50612 \u45208 \u51648  \u47803 \u54616 \u46020 \u47197  \u50613 \u51228 \u54616 \u47140 \u47732  \u51088 \u50976 \u47484  \u45572 \u47540  \u49688  \u50630 \u45716  \u49345 \u53468 \u50640  \u45459 \u50500 \u46160 \u45716  \u44163 \u51060  \u44032 \u51109  \u54869 \u49892 \u54620  \u48169 \u48277 \u51076 \u51012  \u50508 \u44256  \u51080 \u50632 \u45796 . \u51060  \u51221 \u52293 \u51032  \u44208 \u44284 \u47196  \u52488 \u47000 \u46108  \u50977 \u52404 \u51201  \u44256 \u53685 \u48372 \u45796  \u52380  \u48176  \u51060 \u49345  \u47924 \u49436 \u50868  \u44163 \u51008  \u46020 \u45909 \u51201  \u53440 \u46973 \u51060 \u50632 \u45796 . \u49457 \u44221 \u51008  \u48149 \u53448 \u46104 \u50632 \u44256 , \u44256 \u51665 \u44284  \u51060 \u44592 \u51201 \u51064  \u44368 \u54984 \u51004 \u47196  \u50621 \u55180  \u48177 \u49457 \u46308 \u51008  \u47924 \u51648 \u50752  \u48120 \u49888 \u50640  \u44032 \u47140 \u51276 \u44256 , \u50501 \u49845 \u50640  \u48736 \u51256  \u48260 \u47160 \u51004 \u48064 \u47196  \u51088 \u51228 \u54616 \u44592 \u50640  \u51204 \u50672  \u48512 \u51201 \u45817 \u54616 \u44172  \u46104 \u50632 \u45796 .\
\uc0\u44536 \u47084 \u45208  \u44536  \u47784 \u46304  \u44208 \u44284 \u47196  \u49373 \u44596  \u51068 \u51008  \u47196 \u47560 \u44368 \u44032  \u49373 \u44033 \u54664 \u45912  \u44163 \u44284  \u45320 \u47924 \u45208  \u45804 \u46992 \u45796 . \u47196 \u47560 \u44368 \u45716  \u51088 \u44592 \u51032  \u44368 \u47532 \u47484  \u47609 \u51333 \u54616 \u45716  \u45824 \u51473 \u51012  \u47564 \u46308 \u44592 \u45716 \u52964 \u45397  \u44536 \u46308 \u51012  \u51060 \u44368 \u46020 \u50752  \u54785 \u47749 \u44032 \u46308 \u47196  \u47564 \u46308 \u50612  \u48260 \u47160 \u45796 . \u44536 \u46308 \u51008  \u47196 \u47560 \u44368 \u47484  \u49457 \u51649 \u51088 \u51032  \u51221 \u52293 \u51060 \u46972 \u44256  \u47736 \u49884 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u49457 \u51649 \u51088 \u46308 \u51012  \u44536 \u46308 \u51012  \u50517 \u51228 \u54616 \u45716  \u45817 \u54028 \u47196  \u48372 \u50520 \u45796 . \u44536 \u46308 \u51060  \u50508 \u50520 \u45912  \u50976 \u51068 \u54620  \u49888 \u51008  \u47196 \u47560 \u44368 \u51032  \u54616 \u45208 \u45784 \u51060 \u50632 \u44256 , \u44536 \u46308 \u51060  \u50508 \u50520 \u45912  \u50976 \u51068 \u51032  \u51333 \u44368 \u46020  \u47196 \u47560 \u44368 \u51032  \u44368 \u47532 \u50688 \u45796 . \u44536 \u46308 \u51008  \u47196 \u47560 \u44368 \u51032  \u53456 \u50837 \u44284  \u51092 \u51064 \u49457 \u51012  \u48148 \u47196  \u49457 \u44221 \u50640 \u49436  \u45208 \u50728  \u44163 \u51004 \u47196  \u50508 \u50520 \u44592  \u46412 \u47928 \u50640  \u49457 \u44221 \u51012  \u51204 \u50672  \u47924 \u50857 \u54620  \u44163 \u51004 \u47196  \u51064 \u51221 \u54616 \u50688 \u45796 .\
\uc0\u47196 \u47560 \u44368 \u44032  \u54616 \u45208 \u45784 \u51032  \u54408 \u49457 \u51012  \u44536 \u47495 \u46104 \u44172  \u45208 \u53440 \u45236 \u44256  \u44536 \u48516 \u51032  \u50984 \u48277 \u51012  \u50780 \u44257 \u49884 \u53020  \u48260 \u47160 \u51004 \u48064 \u47196  \u51060 \u51228  \u49324 \u46988 \u46308 \u51008  \u49457 \u44221 \u44284  \u49457 \u44221 \u51032  \u51200 \u51088 \u47484  \u46041 \u49884 \u50640  \u44144 \u51208 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u44536 \u46308 \u51032  \u44368 \u47532 \u44032  \u49457 \u44221 \u51060  \u51064 \u51221 \u54616 \u45716  \u44163 \u51060 \u46972 \u44256  \u51452 \u51109 \u54616 \u47732 \u49436  \u44144 \u44592 \u50640  \u47609 \u51333 \u54616 \u44592 \u47484  \u50836 \u44396 \u54616 \u50688 \u45796 . \u44144 \u44592 \u50640  \u48152 \u51025 \u54616 \u50668  \u48380 \u53580 \u47476  (Voltaire) \u50752  \u44536 \u51032  \u46041 \u47308 \u46308 \u51008  \u49457 \u44221 \u51012  \u48176 \u52377 \u54616 \u44256  \u47924 \u49888 \u47200 \u51032  \u54644 \u46021 \u51012  \u46020 \u52376 \u50640  \u50976 \u54252 \u49884 \u53040 \u45796 . \u47196 \u47560 \u44368 \u45716  \u44536  \u49632 \u48156 \u44413 \u51004 \u47196  \u48177 \u49457 \u46308 \u51012  \u51667 \u48159 \u50520 \u45796 . \u44536 \u47088 \u45936  \u51060 \u51228 \u45716  \u45824 \u51473 \u51060  \u53440 \u46973 \u54616 \u44256  \u49324 \u45208 \u50892 \u51256 \u49436  \u47196 \u47560 \u44368 \u51032  \u54617 \u51221 \u50640  \u45824 \u54616 \u50668  \u48152 \u48156 \u51012  \u51068 \u51004 \u53020  \u47784 \u46304  \u49549 \u48149 \u51012  \u45130 \u50612 \u48260 \u47160 \u45796 . \u44536 \u46308 \u51060  \u44536 \u52376 \u47100  \u50724 \u47019 \u46041 \u50504  \u44277 \u44221 \u54616 \u50668  \u50772 \u45912  \u44163 \u51060  \u52268 \u46976 \u54616 \u44172  \u48372 \u51060 \u45716  \u49549 \u51076 \u49688 \u50640  \u48520 \u44284 \u54664 \u45796 \u45716  \u44163 \u51012  \u44648 \u45803 \u44256  \u44536 \u46308 \u51008  \u48516 \u45432 \u54620  \u45208 \u47672 \u51648  \u52280  \u44163 \u44284  \u44144 \u51667  \u44163 \u51012  \u46168  \u45796  \u44144 \u51208 \u54616 \u44172  \u46104 \u50632 \u45796 . \u44536 \u47495 \u46108  \u48169 \u51333 \u51012  \u51088 \u50976 \u47196  \u50724 \u54644 \u54616 \u50668  \u44536 \u46308 \u51008  \u44536 \u46308 \u51060  \u49373 \u44033 \u54620  \u51088 \u50976  \u50504 \u50640 \u49436  \u51396 \u50501 \u51032  \u45432 \u50696 \u44032  \u46108  \u44163 \u51012  \u44592 \u48848 \u54616 \u50688 \u45796 .\
