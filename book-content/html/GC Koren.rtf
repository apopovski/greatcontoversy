\uc0\u52628 \u50613 \u51008  \u54728 \u47932 \u50630 \u44256  \u49692 \u44208 \u54616 \u45912  \u50715 \u45216 , \u54616 \u45208 \u45784 \u44760  \u48520 \u54217 \u54616 \u51648  \u50506 \u44256  \u44536 \u47532 \u49828 \u46020 \u50640  \u45824 \u54616 \u50668  \u49884 \u44592 \u54616 \u51648  \u50506 \u50520 \u51012  \u46412 \u50640  \u49548 \u50976 \u54616 \u50688 \u45912  \u54217 \u50504 \u44284  \u47564 \u51313 \u51012  \u54924 \u49345 \u52992  \u54620 \u45796 . \u44536 \u51032  \u48708 \u45212 \u44284  \u48152 \u50669 , \u52380 \u49324 \u46308 \u51032  \u46041 \u51221 \u44284  \u51648 \u51648 \u47484  \u50619 \u44592  \u50948 \u54620  \u44536 \u51032  \u44592 \u47564 , \u54616 \u45208 \u45784 \u44760 \u49436  \u50857 \u49436 \u54644  \u51452 \u49884 \u44192 \u45796 \u44256  \u54616 \u49512 \u51012  \u46412  \u51088 \u49888 \u51032  \u54924 \u48373 \u51012  \u50948 \u54616 \u50668  \u50500 \u47924 \u47088  \u45432 \u47141 \u46020  \u54616 \u51648  \u50500 \u45768 \u54632 \u51004 \u47196  \u45208 \u53440 \u45240  \u44536 \u51032  \u44256 \u51665  \u46321 , \u51060  \u47784 \u46304  \u51068 \u46308 \u51060  \u47560 \u51020  \u44032 \u50868 \u45936  \u49373 \u49373 \u54616 \u44172  \u46496 \u50724 \u47480 \u45796 . \u44536 \u45716  \u49324 \u46988 \u46308 \u51012  \u45824 \u49345 \u51004 \u47196  \u51204 \u44060 \u54620  \u51088 \u44592 \u51032  \u49324 \u50629 \u44284  \u44536  \u44208 \u44284 , \u44263  \u49324 \u46988 \u46308  \u49345 \u54840 \u44036 \u51032  \u50896 \u54620 , \u47924 \u49436 \u50868  \u49373 \u47749 \u51032  \u54028 \u47736 , \u45208 \u46972 \u46308 \u51032  \u55141 \u47581 \u49457 \u49632 , \u50773 \u50948 \u51032  \u51204 \u48373 , \u51109 \u44592 \u44036  \u44228 \u49549 \u46108  \u49548 \u46976 \u44284  \u53804 \u51137 \u44284  \u54785 \u47749  \u46321 \u51012  \u46104 \u46028 \u50500 \u48376 \u45796 . \u44536 \u45716  \u44536 \u47532 \u49828 \u46020 \u51032  \u49324 \u50629 \u51012  \u48152 \u45824 \u54616 \u44256  \u51064 \u47448 \u47484  \u53440 \u46973 \u49884 \u53412 \u44592  \u50948 \u54616 \u50668  \u45130 \u51076 \u50630 \u51060  \u50528 \u50024  \u50728  \u44163 \u51012  \u49373 \u44033 \u54620 \u45796 . \u44536 \u45716  \u55113 \u50501 \u54620  \u51088 \u44592 \u51032  \u44036 \u44228 \u44032  \u50696 \u49688 \u45784 \u51012  \u49888 \u47280 \u54616 \u45716  \u49324 \u46988 \u46308 \u51012  \u47736 \u47581 \u49884 \u53412 \u45716  \u45936 \u50640  \u50500 \u47924 \u47088  \u55192 \u51060  \u50630 \u50632 \u51020 \u51012  \u44648 \u45803 \u45716 \u45796 . \u49324 \u45800 \u51060  \u51088 \u44592 \u51032  \u49688 \u44256 \u51032  \u50676 \u47588 \u51064  \u44536 \u51032  \u45208 \u46972 \u47484  \u48148 \u46972 \u48380  \u46412 , \u44536 \u45716  \u50724 \u51649  \u49892 \u54056 \u50752  \u54028 \u47736 \u47564 \u51012  \u44648 \u45803 \u44172  \u46108 \u45796 . \u44536 \u45716  \u47924 \u47532 \u46308 \u50640 \u44172  \u54616 \u45208 \u45784 \u51032  \u49457 \u51012  \u49789 \u44172  \u54632 \u46973 \u49884 \u53420  \u49688  \u51080 \u45716  \u44163 \u51004 \u47196  \u48127 \u44172  \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u44536 \u44163 \u51060  \u44144 \u51667 \u51076 \u51012  \u50508 \u44256  \u51080 \u45796 . \u44536 \u45716  \u44536  \u45824 \u51137 \u53804 \u44032  \u44228 \u49549 \u46104 \u45716  \u46041 \u50504  \u44144 \u46317 \u44144 \u46317  \u49892 \u54056 \u54616 \u44256  \u44404 \u48373 \u45817 \u54624  \u49688 \u48150 \u50640  \u50630 \u50632 \u45796 . \u44536 \u45716  \u50689 \u50896 \u54616 \u49888  \u54616 \u45208 \u45784 \u51032  \u45733 \u47141 \u44284  \u50948 \u50628 \u51012  \u45320 \u47924 \u46020  \u51096  \u50508 \u44256  \u51080 \u45796 .\
\uc0\u44536  \u53360  \u47784 \u48152 \u51088 \u51032  \u47785 \u51201 \u51008  \u50616 \u51228 \u45208  \u51088 \u44592 \u47484  \u51221 \u45817 \u54868 \u49884 \u53412 \u44256  \u48152 \u50669 \u51032  \u52293 \u51076 \u51060  \u54616 \u45208 \u45784 \u51032  \u51221 \u48512 \u50640  \u51080 \u45796 \u45716  \u44163 \u51012  \u51077 \u51613 \u54616 \u44592  \u50948 \u54620  \u44163 \u51060 \u50632 \u45796 . \u44536 \u45716  \u51060  \u47785 \u51201 \u51012  \u45804 \u49457 \u54616 \u44592  \u50948 \u54616 \u50668  \u44536 \u51032  \u53441 \u50900 \u54620  \u51648 \u47141 \u51012  \u47784 \u46160  \u44592 \u50872 \u50668  \u50772 \u45796 . \u44536 \u45716  \u49888 \u51473 \u54616 \u44256  \u51312 \u51649 \u51201 \u51004 \u47196  \u51068 \u51012  \u54616 \u50668  \u44536  \u53360  \u47924 \u47532 \u46308 \u51060  \u44536 \u52376 \u47100  \u50724 \u47019 \u46041 \u50504  \u44228 \u49549 \u54644  \u50728  \u45824 \u51137 \u53804 \u50640  \u45824 \u54620  \u44536 \u51032  \u51452 \u51109 \u51012  \u49688 \u46973 \u54616 \u46020 \u47197  \u51060 \u45124 \u45716  \u45936  \u45440 \u46972 \u50868  \u49457 \u44277 \u51012  \u44144 \u46160 \u50612  \u50772 \u45796 . \u49688 \u52380  \u45380  \u46041 \u50504  \u51060  \u48152 \u50669 \u51032  \u44340 \u49688 \u45716  \u50724 \u47448 \u47484  \u51652 \u47532 \u46972 \u44256  \u49549 \u50668  \u50772 \u45796 . \u44536 \u47084 \u45208  \u51060 \u51228  \u44536  \u48152 \u50669 \u51060  \u47560 \u52840 \u45236  \u49892 \u54056 \u47196  \u45149 \u45208 \u44256  \u49324 \u45800 \u51032  \u44221 \u47141 \u44284  \u54408 \u49457 \u51060  \u46300 \u47084 \u45216  \u46412 \u44032  \u50772 \u45796 . \u53360  \u44592 \u47564 \u51088  \u49324 \u45800 \u51008  \u44536 \u47532 \u49828 \u46020 \u47484  \u54224 \u50948 \u49884 \u53412 \u44256 , \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u51012  \u47736 \u47581 \u49884 \u53412 \u44256 , \u44144 \u47337 \u54620  \u49457 \u51012  \u53448 \u52712 \u54616 \u44592  \u50948 \u54620  \u47560 \u51648 \u47561  \u53360  \u49912 \u50880 \u50640 \u49436  \u44536 \u51032  \u51221 \u52404 \u45716  \u50756 \u51204 \u55176  \u54253 \u47196 \u46104 \u50632 \u45796 . \u44536 \u50752  \u50672 \u54633 \u54644  \u50728  \u51088 \u46308 \u51008  \u47560 \u52840 \u45236  \u44536 \u51032  \u49324 \u50629 \u51060  \u50756 \u51204 \u55176  \u49892 \u54056 \u47196  \u46028 \u50500 \u44036  \u44163 \u51012  \u50508 \u44172  \u46108 \u45796 . \u44536 \u47532 \u49828 \u46020 \u47484  \u46384 \u47476 \u45716  \u51088 \u46308 \u44284  \u52649 \u49457 \u46108  \u52380 \u49324 \u46308 \u46020  \u54616 \u45208 \u45784  \u51221 \u48512 \u50640  \u45824 \u54620  \u49324 \u45800 \u51032  \u51020 \u47784 \u51032  \u51204 \u47784 \u47484  \u48372 \u44172  \u46108 \u45796 . \u49324 \u45800 \u51008  \u50728  \u50864 \u51452 \u51032  \u51613 \u50724 \u51032  \u45824 \u49345 \u51060  \u46108 \u45796 .\
\uc0\u49324 \u45800 \u51008  \u44536 \u51032  \u44256 \u51032 \u51201 \u51064  \u48152 \u50669 \u51060  \u44536 \u47196  \u54616 \u50668 \u44552  \u54616 \u45720 \u50640  \u51201 \u54633 \u54616 \u51648  \u47803 \u54616 \u44172  \u47564 \u46308 \u50632 \u51020 \u51012  \u50504 \u45796 . \u44536 \u45716  \u51204 \u47141 \u51012  \u45796 \u54616 \u50668  \u54616 \u45208 \u45784 \u51012  \u45824 \u51201 \u54616 \u50668  \u49912 \u50892 \u50772 \u45796 . \u54616 \u45720 \u51032  \u49692 \u44208 \u44284  \u54217 \u54868 \u50752  \u51312 \u54868 \u45716  \u44536 \u50640 \u44172  \u44537 \u49900 \u54620  \u44256 \u53685 \u51060  \u46112  \u44163 \u51060 \u45796 . \u54616 \u45208 \u45784 \u51032  \u51088 \u48708 \u50752  \u44277 \u51032 \u50640  \u45824 \u54620  \u44536 \u51032  \u48708 \u45212 \u51008  \u51060 \u51228  \u51104 \u51104 \u54644 \u51276 \u45796 . \u44536 \u44032  \u50668 \u54840 \u50752 \u44760  \u46028 \u47532 \u47140 \u44256  \u45432 \u47141 \u54644  \u50728  \u48708 \u45212 \u51060  \u51088 \u44592 \u50640 \u44172 \u47196  \u45224 \u44608 \u50630 \u51060  \u46028 \u50500 \u50728 \u45796 . \u51060 \u51228  \u49324 \u45800 \u51008  \u50638 \u46300 \u47140  \u51088 \u44592 \u50640 \u44172  \u45236 \u47532 \u45716  \u54032 \u44208 \u51032  \u44277 \u51032 \u47196 \u50880 \u51012  \u44256 \u48177 \u54620 \u45796 .\
