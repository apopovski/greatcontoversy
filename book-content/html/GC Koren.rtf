\uc0\u48120 \u44396 \u50640  \u54616 \u45720 \u50640 \u45716  \u51060 \u51201 \u51012  \u54665 \u54616 \u45716  \u47560 \u44480 \u51032  \u45733 \u47141 \u51012  \u50508 \u47140  \u51452 \u45716  \u51613 \u44144 \u47196 \u49436  \u52488 \u51088 \u50672 \u51201 \u51064  \u47924 \u49436 \u50868  \u44305 \u44221 \u51060  \u45208 \u53440 \u45216  \u44163 \u51060 \u45796 . \u47560 \u44480 \u51032  \u50689 \u51008  \u46405 \u51032  \u50773 \u46308 \u44284  \u50728  \u49464 \u49345  \u49324 \u46988 \u46308 \u50640 \u44172  \u45208 \u50500 \u44032 \u49436  \u49549 \u51076 \u49688 \u47196  \u44536 \u46308 \u51012  \u50621 \u50612 \u47588 \u50612  \u54616 \u45720  \u51221 \u48512 \u47484  \u45824 \u51201 \u54616 \u45716  \u44536 \u51032  \u47560 \u51648 \u47561  \u53804 \u51137 \u50640  \u49324 \u45800 \u44284  \u50672 \u54633 \u54616 \u46020 \u47197  \u44536 \u46308 \u51012  \u44053 \u50836 \u54624  \u44163 \u51060 \u45796 . \u44536  \u50501 \u54620  \u50689 \u46308 \u47196  \u47568 \u48120 \u50516 \u50500  \u53685 \u52824 \u51088 \u46308 \u44284  \u48177 \u49457 \u46308 \u51008  \u45796  \u44057 \u51060  \u49549 \u51012  \u44163 \u51060 \u45796 . \u49324 \u46988 \u46308 \u51060  \u51068 \u50612 \u45208 \u49436  \u44536 \u47532 \u49828 \u46020 \u46972 \u44256  \u51088 \u52845 \u54624  \u44163 \u51060 \u47728  \u44396 \u51452 \u44760  \u49549 \u54620  \u52845 \u54840 \u50752  \u50696 \u48176 \u47484  \u50836 \u44396 \u54624  \u44163 \u51060 \u45796 . \u44536 \u46308 \u51008  \u48337 \u51012  \u44256 \u52824 \u45716  \u45440 \u46972 \u50868  \u51060 \u51201 \u51012  \u54665 \u54616 \u44256  \u49457 \u44221 \u51032  \u51613 \u44144 \u50752  \u48152 \u45824 \u46104 \u45716  \u44228 \u49884 \u47484  \u54616 \u45720 \u47196 \u48512 \u53552  \u48155 \u50520 \u45432 \u46972 \u44256  \u44277 \u50616 \u54624  \u44163 \u51060 \u45796 .\
\uc0\u53360  \u44592 \u47564 \u51201  \u50672 \u44537 \u51032  \u51452 \u50669 \u51004 \u47196 \u49436  \u49324 \u45800 \u51008  \u51088 \u44592  \u51088 \u49888 \u51012  \u44536 \u47532 \u49828 \u46020 \u47196  \u44032 \u51109 \u54624  \u44163 \u51060 \u45796 . \u44368 \u54924 \u45716  \u44536 \u47532 \u49828 \u46020 \u51032  \u51116 \u47548 \u51012  \u55148 \u47581 \u51032  \u49457 \u52712 \u47196  \u50724 \u47019 \u46041 \u50504  \u44256 \u45824 \u54616 \u44256  \u51080 \u45432 \u46972 \u44256  \u44277 \u50616 \u54644  \u50772 \u45796 . \u51060 \u51228  \u44536  \u53360  \u44592 \u47564 \u51088 \u45716  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u51060 \u48120  \u50724 \u49888  \u44163 \u52376 \u47100  \u48372 \u51060 \u44172  \u54624  \u44163 \u51060 \u45796 . \u49324 \u45800 \u51008  \u49464 \u44228  \u44033 \u52376 \u50640 \u49436  \u50836 \u54620 \u51060  \u54616 \u45208 \u45784 \u51032  \u50500 \u46308 \u50640  \u44288 \u54616 \u50668  \u44228 \u49884 \u47197 \u50640  \u47896 \u49324 \u54620  \u48148 \u50752  \u44057 \u51060  \u49892 \u47196  \u50948 \u50628  \u51080 \u44256  \u44305 \u55064  \u52268 \u46976 \u54620  \u47784 \u49845 \u51004 \u47196  \u51088 \u49888 \u51012  \u49324 \u46988 \u46308  \u50526 \u50640  \u45208 \u53440 \u45244  \u44163 \u51060 \u45796 . \u44536 \u47484  \u46160 \u47476 \u44256  \u51080 \u45716  \u50689 \u44305 \u51008  \u49324 \u46988 \u51060  \u51068 \u52237 \u51060  \u47785 \u44201 \u54620  \u51068 \u51060  \u50630 \u45716  \u52268 \u46976 \u54620  \u44305 \u44221 \u51060 \u45796  (\u44228  1:13~15 \u52280 \u51312 ). \'93\u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u50724 \u49512 \u45796 ! \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u50724 \u49512 \u45796 !\'94\u44256  \u48512 \u47476 \u51670 \u45716  \u49849 \u47532 \u51032  \u54632 \u49457 \u51060  \u44277 \u51473 \u50640  \u50872 \u47140  \u54140 \u51652 \u45796 . \u49324 \u46988 \u46308 \u51060  \u44536  \u50526 \u50640  \u48512 \u48373 \u54616 \u50668  \u44536 \u50640 \u44172  \u44221 \u48176 \u54620 \u45796 . \u44536 \u47111 \u44172  \u54616 \u45716  \u46041 \u50504  \u44536 \u45716  \u49552 \u51012  \u46308 \u50612  \u47560 \u52824  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u49464 \u49345 \u50640  \u44228 \u49512 \u51012  \u46412  \u45817 \u49888 \u51032  \u51228 \u51088 \u46308 \u51012  \u52629 \u48373 \u54616 \u49512 \u45912  \u44163 \u52376 \u47100  \u44536 \u46308 \u51012  \u52629 \u48373 \u54624  \u44163 \u51060 \u45796 . \u44536 \u51032  \u51020 \u49457 \u51008  \u48512 \u46300 \u47101 \u44256  \u50728 \u54868 \u54616 \u44256  \u50500 \u47492 \u45813 \u45796 . \u50864 \u50500 \u54616 \u44256  \u46041 \u51221 \u50612 \u47536  \u51020 \u51312 \u47196  \u44536 \u45716  \u51068 \u52237 \u51060  \u44396 \u51452 \u44760 \u49436  \u47568 \u50432 \u54616 \u49888  \u51008 \u54812 \u47196 \u50868  \u54616 \u45720  \u51652 \u47532  \u51473  \u50612 \u46500  \u44163 \u46308 \u51012  \u50508 \u47140 \u51456 \u45796 . \u44536 \u45716  \u49324 \u46988 \u46308 \u51032  \u48337 \u51012  \u44256 \u52828 \u45796 . \u44536 \u47088  \u45796 \u51020 \u50640  \u44536 \u45716  \u44536 \u47532 \u49828 \u46020 \u50752  \u44057 \u51008  \u53945 \u49457 \u51004 \u47196  \u44032 \u51109 \u54616 \u50668  \u50504 \u49885 \u51068 \u51012  \u51068 \u50836 \u51068 \u47196  \u48148 \u44984 \u50632 \u45796 \u45716  \u44163 \u51012  \u51452 \u51109 \u54616 \u44256  \u47784 \u46304  \u49324 \u46988 \u50640 \u44172  \u44536 \u44032  \u52629 \u48373 \u54620  \u44536 \u45216 \u51012  \u44144 \u47337 \u55176  \u51648 \u53412 \u46020 \u47197  \u47749 \u47161 \u54620 \u45796 . \u44536 \u45716  \u51228 \u52832 \u51068 \u51012  \u44144 \u47337 \u55176  \u51648 \u53412 \u44592 \u47196  \u44256 \u51665 \u54616 \u45716  \u51088 \u46308 \u51008  \u48731 \u44284  \u51652 \u47532 \u47484  \u44032 \u51648 \u44256  \u44536 \u46308 \u50640 \u44172  \u48372 \u45240  \u44536 \u51032  \u49324 \u51088 \u46308 \u51032  \u47568 \u51012  \u46307 \u51648  \u50506 \u51020 \u51004 \u47196 \u50024  \u44536 \u51032  \u51060 \u47492 \u51012  \u45908 \u47101 \u55176 \u44256  \u51080 \u45796 \u44256  \u51452 \u51109 \u54620 \u45796 . \u51060 \u44163 \u51008  \u44053 \u47141 \u54616 \u44256  \u44144 \u51032  \u50517 \u46020 \u51201 \u51064  \u44592 \u47564 \u51060 \u45796 . \u47560 \u52824  \u47560 \u49696 \u51137 \u51060  \u49884 \u47788 \u50640 \u44172  \u49549 \u51008  \u49324 \u47560 \u47532 \u50500  \u49324 \u46988 \u46308 \u52376 \u47100  \u47924 \u47532 \u46308 \u51008  \u44032 \u51109  \u51089 \u51008  \u51088 \u47196 \u48512 \u53552  \u44032 \u51109  \u53360  \u51088 \u50640  \u51060 \u47476 \u44592 \u44620 \u51648  \'93\u51060  \u49324 \u46988 \u51008  \u53356 \u45796  \u51068 \u52971 \u45716  \u54616 \u45208 \u45784 \u51032  \u44428 \u45733 \u51060 \u46972 \'94 (\u54665  8:10) \u44256  \u47568 \u54632 \u51004 \u47196 \u50024  \u44536  \u47560 \u49696 \u49324 \u51032  \u47568 \u50640  \u44480 \u47484  \u44592 \u50872 \u51060 \u44172  \u46108 \u45796 .\
\uc0\u44536 \u47084 \u45208  \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u51008  \u44592 \u47564 \u45817 \u54616 \u51648  \u50500 \u45768 \u54624  \u44163 \u51060 \u45796 . \u44536  \u44144 \u51667  \u44536 \u47532 \u49828 \u46020 \u51032  \u44032 \u47476 \u52840 \u51008  \u49457 \u44221 \u44284  \u51068 \u52824 \u46104 \u51648  \u50506 \u45716 \u45796 . \u44536 \u51032  \u52629 \u48373 \u51008  \u51664 \u49849 \u44284  \u44536  \u50864 \u49345 \u50640 \u44172  \u44221 \u48176 \u54616 \u45716  \u51088 \u46308 , \u44263  \u49457 \u44221 \u51060  \u54616 \u45208 \u45784 \u51032  \u51088 \u48708 \u44032  \u49438 \u51060 \u51648  \u50506 \u51008  \u51652 \u45432 \u44032  \u50143 \u50500 \u51648 \u47532 \u46972 \u44256  \u54620  \u48148 \u47196  \u44536  \u48512 \u47448 \u51032  \u49324 \u46988 \u46308 \u50640 \u44172  \u49440 \u50616 \u46108 \u45796 .\
\uc0\u44536 \u47532 \u44256  \u45908 \u50865 \u51060  \u49324 \u45800 \u51008  \u44536 \u47532 \u49828 \u46020 \u51032  \u51116 \u47548 \u51032  \u44305 \u44221 \u51012  \u47784 \u51312 \u54616 \u46020 \u47197  \u54728 \u46973 \u46104 \u50612  \u51080 \u51648  \u50506 \u45796 . \u44396 \u51452 \u44760 \u49436 \u45716  \u51060  \u51216 \u50640  \u49549 \u51648  \u50506 \u46020 \u47197  \u49324 \u46988 \u46308 \u50640 \u44172  \u44221 \u44256 \u54616 \u49884 \u44256  \u51116 \u47548 \u51032  \u44305 \u44221 \u50640  \u45824 \u54616 \u50668  \u45796 \u51020 \u44284  \u44057 \u51060  \u48516 \u47749 \u55176  \u50696 \u50616 \u54616 \u49512 \u45796 . \'93\u44144 \u51667  \u44536 \u47532 \u49828 \u46020 \u46308 \u44284  \u44144 \u51667  \u49440 \u51648 \u51088 \u46308 \u51060  \u51068 \u50612 \u45208  \u53360  \u54364 \u51201 \u44284  \u44592 \u49324 \u47484  \u48372 \u51060 \u50612  \u54624  \u49688 \u47564  \u51080 \u51004 \u47732  \u53469 \u54616 \u49888  \u51088 \u46308 \u46020  \u48120 \u54841 \u54616 \u44172  \u54616 \u47532 \u46972 \'85\u48372 \u46972  \u44536 \u47532 \u49828 \u46020 \u44032  \u44305 \u50556 \u50640  \u51080 \u45796  \u54616 \u50668 \u46020  \u45208 \u44032 \u51648  \u47568 \u44256  \u48372 \u46972  \u44264 \u48169 \u50640  \u51080 \u45796  \u54616 \u50668 \u46020  \u48127 \u51648  \u47568 \u46972  \u48264 \u44060 \u44032  \u46041 \u54200 \u50640 \u49436  \u45208 \u49436  \u49436 \u54200 \u44620 \u51648  \u48264 \u51789 \u51076 \u44057 \u51060  \u51064 \u51088 \u51032  \u51076 \u54632 \u46020  \u44536 \u47084 \u54616 \u47532 \u46972 \'94 (\u47560  24:24~27). \u51060 \u47084 \u54620  \u51116 \u47548 \u51008  \u50948 \u51312 \u54624  \u49688  \u50630 \u45796 . \u50728  \u50864 \u51452 \u44032  \u44536  \u49324 \u44148 \u51012  \u50508 \u44256  \u50728  \u49464 \u44228 \u44032  \u44536  \u51068 \u51012  \u47785 \u44201 \u54624  \u44163 \u51060 \u45796 .\
\uc0\u50724 \u51649  \u49457 \u44221 \u51012  \u48512 \u51648 \u47088 \u55176  \u50672 \u44396 \u54616 \u44256  \u51652 \u47532 \u50640  \u45824 \u54620  \u49324 \u46993 \u51012  \u48155 \u50500 \u46308 \u51064  \u51088 \u46308 \u47564 \u51060  \u50728  \u49464 \u44228 \u47484  \u49324 \u47196 \u51105 \u45716  \u44536  \u44053 \u47141 \u54620  \u48120 \u54841 \u50640 \u49436  \u48372 \u54840 \u47484  \u48155 \u44172  \u46112  \u44163 \u51060 \u45796 . \u49457 \u44221 \u51032  \u51613 \u50616 \u50640  \u51032 \u54616 \u50668  \u44536 \u46308 \u51008  \u44536  \u44592 \u47564 \u51088 \u51032  \u48320 \u51109 \u51012  \u50508 \u50500 \u45236 \u44172  \u46112  \u44163 \u51060 \u45796 . \u44536  \u49884 \u47144 \u51032  \u46412 \u45716  \u47784 \u46304  \u49324 \u46988 \u50640 \u44172  \u51060 \u47484  \u44163 \u51060 \u45796 . \u49884 \u54744 \u51032  \u52404 \u51656 \u47196  \u47568 \u48120 \u50516 \u50500  \u52280  \u44536 \u47532 \u49828 \u46020 \u51064 \u51060  \u45208 \u53440 \u45216  \u44163 \u51060 \u45796 . \u50724 \u45720 \u45216  \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u46308 \u51008  \u44048 \u51221 \u51201  \u51613 \u44144 \u50640  \u51032 \u54616 \u50668  \u55124 \u46308 \u47532 \u51648  \u50506 \u51012  \u47564 \u53372  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432  \u50948 \u50640  \u44403 \u44172  \u49436  \u51080 \u45716 \u44032 ? \u44536 \u46308 \u51008  \u51060 \u50752  \u44057 \u51008  \u50948 \u44592 \u47484  \u45817 \u54616 \u50668  \u49457 \u44221 , \u50724 \u51649  \u49457 \u44221 \u47564 \u51012  \u48537 \u46308 \u44256  \u45459 \u51648  \u50506 \u51012  \u44163 \u51064 \u44032 ? \u49324 \u45800 \u51008  \u54624  \u49688 \u47564  \u51080 \u51004 \u47732  \u44536 \u45216 \u50640  \u49444  \u51456 \u48708 \u47484  \u54616 \u51648  \u47803 \u54616 \u46020 \u47197  \u44536 \u46308 \u51012  \u48169 \u54644 \u54624  \u44163 \u51060 \u45796 . \u44536 \u45716  \u44536 \u46308 \u51032  \u44600 \u51012  \u44032 \u47196 \u47561 \u44256  \u49464 \u49345  \u51116 \u47932 \u50640  \u50621 \u55176 \u46020 \u47197  \u51068 \u51012  \u51452 \u49440 \u54616 \u44256  \u44536 \u46308 \u51060  \u47924 \u44161 \u44256  \u50612 \u47140 \u50868  \u51664 \u51012  \u51648 \u44172  \u54632 \u51004 \u47196  \u51060  \u49464 \u49345  \u44145 \u51221  \u46412 \u47928 \u50640  \u44536 \u46308 \u51032  \u47560 \u51020 \u51060  \u45580 \u47532 \u44172  \u54616 \u50668  \u47560 \u52824  \u46020 \u51201 \u44284  \u44057 \u51060  \u49884 \u47144 \u51032  \u45216 \u51060  \u44536 \u46308 \u50640 \u44172  \u51060 \u47476 \u44172  \u54624  \u44163 \u51060 \u45796 .\
