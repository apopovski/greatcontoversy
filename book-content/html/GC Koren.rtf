\uc0\u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u51068 \u52380 \u45380  \u45149 \u50640  \u45796 \u49884  \u51648 \u49345 \u51004 \u47196  \u46028 \u50500 \u50724 \u49888 \u45796 . \u44536 \u48516 \u51008  \u44396 \u49549 \u48155 \u51008  \u47924 \u47532 \u46308 \u44284  \u49688 \u54665 \u54616 \u45716  \u52380 \u49324 \u46308 \u44284  \u54632 \u44760  \u50724 \u49888 \u45796 . \u45440 \u46972 \u50868  \u50948 \u50628 \u51004 \u47196  \u45236 \u47140 \u50724 \u49892  \u46412  \u44536 \u48516 \u44760 \u49436 \u45716  \u51453 \u51008  \u50501 \u51064 \u46308 \u50640 \u44172 , \u54805 \u48268 \u51012  \u48155 \u44592  \u50948 \u54616 \u50668  \u51068 \u50612 \u45208 \u46972 \u44256  \u47749 \u47161 \u54616 \u49888 \u45796 . \u44536 \u46308 \u51008  \u48148 \u45796 \u51032  \u47784 \u47000 \u50752  \u44057 \u51060  \u49472  \u49688  \u50630 \u45716  \u53360  \u47924 \u47532 \u44032  \u46104 \u50612  \u51068 \u50612 \u45212 \u45796 . \u52395 \u51704  \u48512 \u54876  \u46412  \u51068 \u50612 \u45228 \u45912  \u51088 \u46308 \u44284  \u50620 \u47560 \u45208  \u45824 \u51312 \u51201 \u51064 \u44032 ! \u51032 \u51064 \u46308 \u51008  \u51453 \u51648  \u50506 \u51012  \u51210 \u51020 \u44284  \u50500 \u47492 \u45796 \u50880 \u51012  \u51077 \u44256  \u51080 \u50632 \u45796 . \u44536 \u47084 \u45208  \u50501 \u51064 \u46308 \u51008  \u49324 \u47581 \u44284  \u51656 \u48337 \u51032  \u55124 \u51201 \u51012  \u44536 \u45824 \u47196  \u51648 \u45768 \u44256  \u51080 \u45796 .\
\uc0\u44536  \u53360  \u47924 \u47532 \u50640  \u49549 \u54620  \u47784 \u46304  \u49324 \u46988 \u51032  \u45576 \u51008  \u54616 \u45208 \u45784 \u51032  \u50500 \u46308 \u51032  \u50689 \u44305 \u51012  \u51452 \u47785 \u54616 \u44172  \u46108 \u45796 . \u50501 \u51064 \u46308 \u51008  \u47785 \u49548 \u47532 \u47484  \u54633 \u54616 \u50668  \'93\u51452 \u51032  \u51060 \u47492 \u51004 \u47196  \u50724 \u49884 \u45716  \u51060 \u47484  \u52268 \u49569 \u54616 \u47532 \u47196 \u45796 \'94\u44256  \u48512 \u47476 \u51670 \u45716 \u45796 . \u44536 \u46308 \u51060  \u51060 \u47111 \u44172  \u48512 \u47476 \u51670 \u45716  \u44163 \u51008  \u50696 \u49688 \u45784 \u51012  \u49324 \u46993 \u54616 \u44592  \u46412 \u47928 \u50640 \u49436 \u44032  \u50500 \u45768 \u45796 . \u51652 \u47532 \u51032  \u55192 \u51060  \u48376 \u51032  \u50500 \u45768 \u44172  \u51077 \u49696 \u50640 \u49436  \u44536 \u47088  \u47568 \u51012  \u45208 \u50724 \u44172  \u54620 \u45796 . \u44536 \u46308 \u51008  \u47924 \u45924 \u50640  \u45236 \u47140 \u44040  \u46412 \u50752  \u46609 \u44057 \u51060  \u44536 \u47532 \u49828 \u46020 \u44760  \u45824 \u54620  \u51201 \u51032  (\u25973 \u24847 ) \u50752  \u48152 \u50669  \u51221 \u49888 \u51012  \u44032 \u51648 \u44256  \u51068 \u50612 \u45212 \u45796 . \u44536 \u46308 \u51008  \u44284 \u44144 \u51032  \u49373 \u50528 \u50640  \u51080 \u50632 \u45912  \u50724 \u51216 \u51012  \u51228 \u44144 \u54624  \u49688  \u51080 \u45716  \u49352 \u47196 \u50868  \u51008 \u54812 \u51032  \u49884 \u44592 \u47484  \u50619 \u45716  \u44163 \u51060  \u50500 \u45768 \u45796 . \u44536 \u47088  \u44592 \u54924 \u44032  \u44536 \u46308 \u50640 \u44172  \u50500 \u47924 \u47088  \u50976 \u51061 \u51012  \u51452 \u51648  \u47803 \u54624  \u44163 \u51060 \u45796 . \u51068 \u49373  \u46041 \u50504 \u51032  \u49373 \u54876 \u51008  \u44536 \u46308 \u51032  \u47560 \u51020 \u51012  \u48512 \u46300 \u47101 \u44172  \u47564 \u46308 \u51648  \u47803 \u54664 \u45796 . \u46160  \u48264 \u51704 \u51032  \u51008 \u54812 \u51032  \u49884 \u44592 \u44032  \u44536 \u46308 \u50640 \u44172  \u51452 \u50612 \u51656 \u51648 \u46972 \u46020  \u44536 \u44163 \u51008  \u52395  \u48264 \u51704  \u44221 \u50864 \u50752  \u47560 \u52268 \u44032 \u51648 \u47196  \u54616 \u45208 \u45784 \u51032  \u50836 \u44396 \u47484  \u44592 \u54588 \u54616 \u44256  \u54616 \u45208 \u45784 \u44760  \u48152 \u50669 \u51012  \u51068 \u51004 \u53412 \u45716  \u44592 \u54924 \u44032  \u46112  \u44163 \u51060 \u45796 .\
\uc0\u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u48512 \u54876 \u54616 \u49888  \u54980  \u49849 \u52380 \u54616 \u49888  \u44275 \u51060 \u47728 , \u52380 \u49324 \u46308 \u51060  \u51116 \u47548 \u51032  \u50557 \u49549 \u51012  \u46104 \u54400 \u51060 \u54620  \u51109 \u49548 , \u44263  \u44048 \u46988 \u49328  \u50948 \u50640  \u45236 \u47140 \u50724 \u49888 \u45796 . \u49440 \u51648 \u51088 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u54620 \u45796 . \'93\u45208 \u51032  \u54616 \u45208 \u45784  \u50668 \u54840 \u50752 \u44760 \u49436  \u51076 \u54616 \u49892  \u44163 \u51060 \u50836  \u47784 \u46304  \u44144 \u47337 \u54620  \u51088 \u44032  \u51452 \u50752  \u54632 \u44760 \u54616 \u47532 \u46972 \'94, \'93\u44536 \u45216 \u50640  \u44536 \u51032  \u48156 \u51060  \u50696 \u47336 \u49332 \u47128  \u50526  \u44263  \u46041 \u54200  \u44048 \u46988 \u49328 \u50640  \u49436 \u49892  \u44163 \u51060 \u50836  \u44048 \u46988 \u49328 \u51008  \u44536  \u54620  \u44032 \u50868 \u45936 \u44032  \u46041 \u49436 \u47196  \u44040 \u46972 \u51256  \u47588 \u50864  \u53360  \u44264 \u51676 \u44592 \u44032  \u46104 \u50612 \u49436 \'85\'94, \'93\u50668 \u54840 \u50752 \u44760 \u49436  \u52380 \u54616 \u51032  \u50773 \u51060  \u46104 \u49884 \u47532 \u45768  \u44536 \u45216 \u50640 \u45716  \u50668 \u54840 \u50752 \u44760 \u49436  \u54848 \u47196  \u54616 \u45208 \u51060 \u49892  \u44163 \u51060 \u50836  \u44536  \u51060 \u47492 \u51060  \u54848 \u47196  \u54616 \u45208 \u51060 \u49892  \u44163 \u51060 \'94 (\u49829  14:5, 4, 9) \u46972 . \u54868 \u47140  \u52268 \u46976 \u54620  \u49352  \u50696 \u47336 \u49332 \u47128  \u49457 \u51060  \u54616 \u45720 \u50640 \u49436  \u45236 \u47140 \u50732  \u46412  \u44536  \u49457 \u51008  \u50689 \u51217 \u54624  \u51456 \u48708 \u44032  \u46108  \u49457 \u44208 \u54620  \u44275 \u50640  \u51221 \u52265 \u54616 \u44172  \u46108 \u45796 . \u44536 \u47532 \u44256  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u48177 \u49457 \u46308 \u44284  \u52380 \u49324 \u46308 \u44284  \u54632 \u44760  \u44536  \u44144 \u47337 \u54620  \u49457 \u51004 \u47196  \u46308 \u50612 \u44032 \u49888 \u45796 .\
