\f1\b0 \cf0 \
\uc0\u50864 \u47532 \u51032  \u51312 \u49345 \u46308 \u51060  \u44536 \u46308 \u51032  \u44428 \u47532 \u51109 \u51204  (\u27402 \u21033 \u31456 \u20856 ) \u51004 \u47196  \u48157 \u55180  \u50948 \u45824 \u54620  \u46021 \u47549  \u49440 \u50616 \u49436 \u50640 \u45716  \u45796 \u51020 \u44284  \u44057 \u51008  \u51452 \u51109 \u51012  \u52380 \u47749 \u54616 \u50688 \u45796 . \'93\u50864 \u47532 \u45716  \u47784 \u46304  \u49324 \u46988 \u51060  \u54217 \u46321 \u54616 \u44172  \u52285 \u51312 \u46104 \u50632 \u44256 , \u44536 \u46308 \u50640 \u44172 \u45716  \u51312 \u47932 \u51452 \u44760 \u47196 \u48512 \u53552  \u45224 \u50640 \u44172  \u50577 \u46020 \u54624  \u49688  \u50630 \u45716  \u51068 \u51221 \u54620  \u44428 \u47532 \u44032  \u48512 \u50668 \u46104 \u50632 \u51004 \u47728 , \u44536  \u44428 \u47532  \u44032 \u50868 \u45936 \u45716  \u49373 \u47749 , \u51088 \u50976 , \u54665 \u48373 \u51032  \u52628 \u44396  \u46321 \u51060  \u54252 \u54632 \u46104 \u50612  \u51080 \u45796 \u45716  \u44163 \u51012  \u51088 \u47749 \u54620  \u51652 \u47532 \u47196  \u51452 \u51109 \u54620 \u45796 .\'94 \u46608 \u54620  \u54732 \u48277 \u50640 \u46020  \u44537 \u55176  \u47749 \u48177 \u54620  \u47568 \u47196 \u50024  \u50577 \u49900 \u51008  \u52840 \u48276 \u54624  \u49688  \u50630 \u45796 \u45716  \u44163 \u51060  \u48372 \u51613 \u46104 \u50612  \u51080 \u45796 . \'93\u54633 \u51473 \u44397 \u51008  \u50612 \u46500  \u44277 \u51649  (\u20844 \u32887 ) \u50640  \u45824 \u54620  \u51088 \u44201 \u51004 \u47196 \u49436  \u51333 \u44368 \u51201 \u51064  \u49884 \u54744 \u51012  \u50836 \u44396 \u54616 \u51648  \u50506 \u45716 \u45796 .\'94 \'93\u48120 \u51032 \u54924 \u45716  \u51333 \u44368 \u51032  \u49444 \u47549 \u50640  \u44288 \u50668 \u54616 \u44144 \u45208  \u51333 \u44368 \u51032  \u51088 \u50976 \u47196 \u50868  \u54876 \u46041 \u51012  \u44552 \u51648 \u54616 \u45716  \u50612 \u46496 \u54620  \u51077 \u48277 \u46020  \u54616 \u51648  \u50506 \u51012  \u44163 \u51060 \u45796 .\'94\
\'93\uc0\u54732 \u48277 \u51012  \u44592 \u52488 \u54620  \u49324 \u46988 \u46308 \u51008  \u49324 \u46988 \u44284  \u54616 \u45208 \u45784  \u49324 \u51060 \u51032  \u44288 \u44228 \u44032  \u51064 \u44036 \u51032  \u48277 \u47456  \u50948 \u50640  \u51080 \u45796 \u45716  \u44163 \u44284  \u50577 \u49900 \u51032  \u44428 \u47532 \u45716  \u50577 \u46020 \u54624  \u49688  \u50630 \u45716  \u44163 \u51060 \u46972 \u45716  \u50689 \u50896 \u54620  \u50896 \u52825 \u51012  \u51064 \u51221 \u54616 \u50688 \u45796 . \u51060 \u47084 \u54620  \u51652 \u47532 \u47484  \u54869 \u47549 \u54616 \u44592  \u50948 \u54616 \u50668  \u51060 \u47200 \u51012  \u51204 \u44060 \u54624  \u54596 \u50836 \u44032  \u50630 \u45796 . \u50864 \u47532 \u45716  \u44536 \u44163 \u51012  \u47560 \u51020 \u49549 \u50640  \u44648 \u45803 \u44256  \u51080 \u45796 . \u44536  \u49324 \u49892 \u51012  \u50508 \u44256  \u51080 \u50632 \u44592  \u46412 \u47928 \u50640  \u47566 \u51008  \u49692 \u44368 \u51088 \u46308 \u51008  \u51064 \u44036 \u51032  \u48277 \u47456 \u51012  \u45824 \u54637 \u54624  \u46412  \u44256 \u45212 \u44284  \u54868 \u54805 \u51012  \u44204 \u46364  \u49688  \u51080 \u50632 \u45796 . \u44536 \u46308 \u51008  \u54616 \u45208 \u45784 \u44760  \u45824 \u54620  \u51032 \u47924 \u44032  \u49324 \u46988 \u51032  \u48277 \u47161 \u48372 \u45796  \u45908 \u50865  \u50864 \u50900 \u54616 \u45796 \u45716  \u44163 \u51012  \u50508 \u50520 \u45796 . \u44536 \u46308 \u51008  \u49324 \u46988 \u51060  \u51088 \u44592 \u46308 \u51032  \u50577 \u49900 \u51012  \u51648 \u48176 \u54624  \u44428 \u47532 \u44032  \u51204 \u54784  \u50630 \u45796 \u45716  \u44163 \u51012  \u45712 \u45180 \u50632 \u45796 . \u44536 \u44163 \u51008  \u50612 \u46500  \u44163 \u51004 \u47196 \u46020  \u49100 \u47532  \u48977 \u51012  \u49688  \u50630 \u45716  \u52380 \u48512  (\u22825 \u36070 ) \u51032  \u50896 \u52825 \u51060 \u45796 \'94[Congressional Documents (U.S.A.), Serial No.200, Docu-ment No.271].\
\uc0\u49324 \u46988 \u51060  \u51088 \u44592 \u51032  \u49688 \u44256 \u51032  \u45824 \u44032 \u47484  \u48155 \u44256  \u51088 \u44592 \u51032  \u50577 \u49900 \u51032  \u51648 \u49884 \u45824 \u47196  \u49373 \u54876 \u54624  \u49688  \u51080 \u45716  \u45208 \u46972 \u44032  \u51080 \u45796 \u45716  \u49548 \u49885 \u51060  \u50976 \u47101 \u51032  \u50668 \u47084  \u45208 \u46972 \u50640  \u51204 \u54616 \u50668 \u51648 \u51088  \u47924 \u49688 \u54620  \u49324 \u46988 \u51060  \u48513 \u48120  \u45824 \u47449 \u51004 \u47196  \u47784 \u50668 \u46308 \u50632 \u45796 . \u49885 \u48124 \u51648 \u51032  \u51064 \u44396 \u45716  \u44049 \u51088 \u44592  \u45720 \u50612 \u45228 \u45796 . \'93\u47588 \u49324 \u52628 \u49464 \u52768  \u51452 \u45716  \u53945 \u48324 \u54620  \u48277 \u47456 \u51012  \u51228 \u51221 \u54616 \u50668  \u51204 \u46976 \u44284  \u44592 \u44540 \u44284  \u48149 \u54644 \u51088 \u46308 \u51032  \u54605 \u48149 \u51012  \u54588 \u54616 \u44592  \u50948 \u54616 \u50668  \u45824 \u49436 \u50577 \u51012  \u44148 \u45320 \u50724 \u44256 \u51088  \u54616 \u45716  \u44536 \u47532 \u49828 \u46020 \u51064 \u50640 \u44172  \u45824 \u54616 \u50668 \u45716  \u50612 \u45712  \u45208 \u46972  \u49324 \u46988 \u51060 \u46304 \u51648  \u54872 \u50689 \u54616 \u44256  \u44277 \u44552  (\u20844 \u63754 ) \u51004 \u47196  \u44536  \u51068 \u51012  \u50896 \u51312 \u54616 \u50688 \u45796 .\'94 \u44536 \u47532 \u54616 \u50668  \u47581 \u47749 \u51088 \u50752  \u50517 \u48149 \u45817 \u54616 \u45716  \u51088 \u46308 \u51060  \u48277 \u51201 \u51004 \u47196  \u44277 \u54868 \u44397 \u51032  \u49552 \u45784 \u51060  \u46104 \u50632 \u45796  (Martyn, vol.5, p.417).\
\uc0\u54540 \u47532 \u47672 \u46300  (Plymouth) \u50640  \u52376 \u51020 \u51004 \u47196  \u49345 \u47449 \u54620  \u46412 \u47196 \u48512 \u53552  20\u45380  \u54980 \u50640 \u45716  \u49688 \u52380  \u47749 \u51032  \u54596 \u44536 \u47548 \u46308  (Pilgrims \'97 \u49692 \u47168 \u51088  \u51593  \u49888 \u50521 \u51032  \u51088 \u50976 \u47484  \u52286 \u50500  \u48148 \u45796 \u47484  \u44148 \u45320 \u50728  \u51088 \u46308 ) \u51060  \u45684 \u51081 \u44544 \u47004 \u46300 \u50640  \u51221 \u52265 \u54616 \u50688 \u45796 .\
\uc0\u44536 \u46308 \u51008  \u44536 \u46308 \u51060  \u50896 \u54616 \u45716  \u47785 \u54364 \u50640  \u46020 \u45804 \u54616 \u44592  \u50948 \u54616 \u50668 , \'93\u44160 \u49548 \u54616 \u44172  \u45432 \u47141 \u54616 \u50668  \u49373 \u50528 \u54632 \u51004 \u47196  \u44200 \u50864  \u54840 \u44396 \u54624  \u49688  \u51080 \u45716  \u44163 \u50640  \u47564 \u51313 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u48173 \u50640 \u49436 \u46020  \u44536 \u46308 \u51060  \u55192 \u46308 \u51064  \u45432 \u47141 \u50640  \u54644 \u45817 \u46104 \u45716  \u47564 \u53372 \u51032  \u49688 \u54869 \u51012  \u44396 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u51109 \u52264  \u51068 \u54869 \u52380 \u44552 \u51012  \u50619 \u44192 \u45796 \u45716  \u45000 \u51012  \u44054 \u51648  \u50506 \u50520 \u45796 . \'85\u44536 \u46308 \u51008  \u48708 \u47197  \u49549 \u46020 \u45716  \u45712 \u47532 \u51648 \u47560 \u45716  \u44536 \u46308 \u51032  \u49324 \u54924  \u51228 \u46020 \u51032  \u52265 \u49892 \u54620  \u48156 \u51204 \u50640  \u47564 \u51313 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u51064 \u45236 \u49457  \u51080 \u44172  \u44305 \u50556 \u51032  \u44417 \u54605 \u51012  \u44204 \u46356 \u44256 , \u45576 \u47932 \u47196 \u50024  \u51088 \u50976 \u51032  \u45208 \u47924 \u50640  \u47932 \u51012  \u51452 \u44256 , \u51060 \u47560 \u50640  \u46400 \u51012  \u55128 \u47532 \u47732 \u49436  \u44536 \u44163 \u51012  \u44032 \u44984 \u50612  \u47560 \u52840 \u45236  \u44536  \u45208 \u47924 \u44032  \u46405 \u49549  \u44618 \u51060  \u49100 \u47532 \u47484  \u45236 \u47532 \u44172  \u54616 \u50688 \u45796 .\'94\
\uc0\u49457 \u44221 \u51008  \u49888 \u50521 \u51032  \u44592 \u52488 \u50836 , \u51648 \u54812 \u51032  \u44540 \u50896 \u51060 \u47728 , \u51088 \u50976 \u51032  \u54732 \u51109  (\u25010 \u31456 ) \u51004 \u47196  \u51316 \u51473 \u55176  \u50668 \u44608 \u51012  \u48155 \u50520 \u45796 . \u49457 \u44221 \u51032  \u50896 \u52825 \u51012  \u51665 \u50640 \u49436 \u45208  \u54617 \u44368 \u50640 \u49436 \u45208  \u44368 \u54924 \u50640 \u49436  \u50676 \u49900 \u55176  \u44032 \u47476 \u52452 \u44256 , \u44536  \u44208 \u44284 \u47196  \u44160 \u49548 , \u47749 \u52384 , \u49692 \u44208 , \u51208 \u51228  \u46321 \u51060  \u45208 \u53440 \u45228 \u45796 . \u50612 \u46500  \u49324 \u46988 \u51060  \u52397 \u44368 \u46020 \u46308 \u51060  \u44144 \u51452 \u54616 \u45716  \u44275 \u50640  \u50668 \u47084  \u54644  \u46041 \u50504  \u49332 \u51648 \u46972 \u46020  \'93\u54620  \u49324 \u46988 \u51032  \u49696 \u51452 \u51221 \u48197 \u51060 \u47484  \u48372 \u44144 \u45208  \u54620  \u47560 \u46356 \u51032  \u50837 \u49444 \u51012  \u46307 \u44144 \u45208  \u54620  \u49324 \u46988 \u51032  \u44144 \u51648 \u46020  \u47564 \u45216  \u49688  \u50630 \u50632 \u45796 \'94 (Bancroft, pt.1, ch.19, par.25). \u44536 \u47532 \u54616 \u50668  \u49457 \u44221 \u51032  \u50896 \u52825 \u51008  \u44397 \u44032 \u47484  \u50948 \u45824 \u54616 \u44172  \u47564 \u46300 \u45716  \u44032 \u51109  \u54869 \u49892 \u54620  \u50504 \u51204 \u52293 \u51060  \u46108 \u45796 \u45716  \u44163 \u51060  \u48516 \u47749 \u55176  \u49892 \u51613 \u46104 \u50632 \u45796 . \u48120 \u50557 \u54616 \u44256  \u50808 \u47196 \u50912 \u45912  \u49885 \u48124 \u51648 \u45716  \u44053 \u45824 \u54620  \u54633 \u51473 \u44397 \u51004 \u47196  \u51088 \u46972 \u45228 \u44256 , \u49464 \u44228 \u45716  \'93\u48277 \u50773  \u50630 \u45716  \u44368 \u54924 , \u50773  \u50630 \u45716  \u45208 \u46972 \'94\u51032  \u54217 \u54868 \u50752  \u48264 \u50689 \u51012  \u45440 \u46972 \u50868  \u45576 \u51004 \u47196  \u48372 \u44172  \u46104 \u50632 \u45796 .\
