\'93\uc0\u44536  \u49324 \u52824 \u51032  \u49464 \u47141 \u51012  \u51064 \u54616 \u50668  \u52824 \u48512 \'94\u54620  \'93\u46405 \u51032  \u49345 \u44256 \u46308 \u51060 \'94, \'93\u44536  \u44256 \u45212 \u51012  \u47924 \u49436 \u50892 \u54616 \u50668  \u47680 \u47532  \u49436 \u49436  \u50872 \u44256  \u50528 \u53685 \u54616 \u50668  \u44032 \u47196 \u46104  \u54868  \u51080 \u46020 \u45796  \u54868  \u51080 \u46020 \u45796  \u53360  \u49457 \u51060 \u50668  \u49464 \u47560 \u54252 \u50752  \u51088 \u51452 \u50752  \u48521 \u51008  \u50743 \u51012  \u51077 \u44256  \u44552 \u44284  \u48372 \u49437 \u44284  \u51652 \u51452 \u47196  \u44984 \u48124  \u44163 \u51064 \u45936  \u44536 \u47084 \u54620  \u48512 \u44032  \u51068 \u49884 \u44036 \u50640  \u47581 \u54616 \u50688 \u46020 \u45796 \'94 (\u44228  18:3, 11, 15~17).\
\uc0\u54616 \u45208 \u45784 \u51032  \u51652 \u45432 \u44032  \u45236 \u47532 \u45716  \u45216 \u50640  \u48148 \u48296 \u47200 \u51060  \u45817 \u54624  \u54805 \u48268 \u51060  \u51060 \u50752  \u44057 \u45796 . \u48148 \u48296 \u47200 \u51008  \u44536  \u51396 \u51032  \u48516 \u47049 \u51012  \u45796  \u52292 \u50912 \u45796 . \u44536 \u51032  \u46412 \u44032  \u51060 \u47476 \u47104 \u44256 , \u47736 \u47581 \u51032  \u49884 \u44592 \u45716  \u47924 \u47476 \u51061 \u50612  \u51080 \u45796 .\
\uc0\u54616 \u45208 \u45784 \u51032  \u47785 \u49548 \u47532 \u44032  \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u51012  \u49324 \u47196 \u51105 \u55192 \u50640 \u49436  \u46028 \u51060 \u53412 \u49892  \u46412  \u51064 \u49373 \u51032  \u53360  \u49912 \u50880 \u50640 \u49436  \u47784 \u46304  \u44163 \u51012  \u51075 \u50612 \u48260 \u47536  \u51088 \u46308 \u51008  \u47924 \u49436 \u50868  \u44033 \u49457 \u51012  \u54624  \u44163 \u51060 \u45796 . \u51008 \u54812 \u51032  \u49884 \u44592 \u44032  \u44228 \u49549 \u46104 \u45716  \u46041 \u50504 , \u44536 \u46308 \u51008  \u49324 \u45800 \u51032  \u49549 \u51076 \u49688 \u50640  \u45576 \u51060  \u47680 \u50632 \u51004 \u47728 , \u44536 \u46308 \u51008  \u51396 \u50501 \u51032  \u44600 \u51012  \u51221 \u45817 \u54868 \u54664 \u45796 . \u48512 \u54620  \u51088 \u46308 \u51008  \u44032 \u45212 \u54620  \u51088 \u46308 \u50640 \u44172  \u45824 \u54616 \u50668  \u44536 \u46308 \u51032  \u50864 \u50900 \u49457 \u51012  \u51088 \u46993 \u54664 \u45796 . \u44536 \u47084 \u45208  \u44536 \u46308 \u51032  \u48512 \u45716  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51012  \u48276 \u54632 \u51004 \u47196 \u50024  \u50619 \u51008  \u44163 \u51060 \u50632 \u45796 . \u44536 \u46308 \u51008  \u51452 \u47536  \u51088 \u47484  \u47673 \u51060 \u44256 , \u48279 \u51008  \u51088 \u47484  \u51077 \u55176 \u44256 , \u44277 \u51032 \u47484  \u54665 \u54616 \u44256  \u44557 \u55100 \u51012  \u48288 \u54400 \u44592 \u47484  \u46321 \u54620 \u55176  \u54664 \u45796 . \u44536 \u46308 \u51008  \u49828 \u49828 \u47196 \u47484  \u45458 \u51060 \u44256  \u46041 \u47308  \u51064 \u44036 \u46308 \u51032  \u51316 \u44221 \u51012  \u50619 \u44256 \u51088  \u45432 \u47141 \u54664 \u45796 . \u51060 \u51228  \u44536 \u46308 \u51008  \u44536 \u46308 \u51012  \u50948 \u45824 \u54616 \u44172  \u54644 \u51452 \u50632 \u45912  \u47784 \u46304  \u44163 \u51012  \u48149 \u53448 \u45817 \u54616 \u44256 , \u44417 \u54605 \u54644 \u51648 \u442