\'93\uc0\u44536 \u47084 \u48064 \u47196  \u44648 \u50612  \u51080 \u51004 \u46972 . \'85\u44536 \u44032  \u54848 \u50672 \u55176  \u50752 \u49436  \u45320 \u55148 \u51032  \u51088 \u45716  \u44163 \u51012  \u48372 \u51648  \u50506 \u46020 \u47197  \u54616 \u46972 \'94 (\u47561  13:35, 36). \u44648 \u50612  \u51080 \u44592 \u47484  \u49548 \u54848 \u55176  \u54616 \u44256  \u49464 \u49345 \u51032  \u47588 \u47141 \u51012  \u54693 \u54616 \u50668  \u47560 \u51020 \u51012  \u46028 \u47532 \u45716  \u51088 \u46308 \u51032  \u49345 \u53468 \u45716  \u52280 \u51004 \u47196  \u50948 \u54744 \u54616 \u45796 . \u49324 \u50629 \u44032 \u44032  \u51060 \u46301 \u50640  \u47560 \u51020 \u51012  \u48764 \u50519 \u44592 \u44256 , \u54693 \u46973 \u51012  \u51600 \u44592 \u45716  \u51088 \u44032  \u48169 \u51333 \u51012  \u44396 \u54616 \u44256 , \u50976 \u54665 \u51012  \u46384 \u47476 \u45716  \u51088 \u44032  \u47800 \u51012  \u45800 \u51109 \u54616 \u44592 \u50640  \u44200 \u47484 \u51060  \u50630 \u51012  \u48148 \u47196  \u44536 \u46412 , \u50728  \u49464 \u49345 \u51032  \u49900 \u54032 \u44288  \u46104 \u49888  \u50696 \u49688 \u45784 \u44760 \u49436  \'93\u51200 \u50872 \u50640  \u45804 \u47140 \u49436  \u48512 \u51313 \u54632 \u51060  \u48456 \u50632 \u45796 \'94 (\u45800  5:27) \u46972 \u44256  \u49440 \u44256 \u54616 \u49892  \u44163 \u51060 \u45796 .\
