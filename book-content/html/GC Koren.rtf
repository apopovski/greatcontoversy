\uc0\u44536  \u49892 \u47581 \u51008  \u44536 \u46308 \u51060  \u51204 \u54620  \u44592 \u48324 \u50640  \u45824 \u54620  \u50724 \u54644 \u47196  \u49373 \u44596  \u44163 \u51060 \u50632 \u51004 \u45208  \u51060 \u44163 \u51060  \u50724 \u55176 \u47140  \u44536 \u46308 \u51032  \u50976 \u51061 \u51060  \u46112  \u44163 \u51060 \u50632 \u45796 . \u44536 \u44163 \u51008  \u44536  \u44221 \u44256 \u47484  \u48155 \u50500 \u46308 \u51060 \u45432 \u46972 \u44256  \u44277 \u50616 \u54616 \u45716  \u51088 \u46308 \u51032  \u47560 \u51020 \u51012  \u49884 \u54744 \u54616 \u45716  \u44163 \u51060  \u46112  \u44163 \u51060 \u50632 \u45796 . \u44536 \u46308 \u51008  \u49892 \u47581 \u51012  \u45817 \u54616 \u48064 \u47196  \u44536 \u46308 \u51032  \u44221 \u54744 \u51012  \u48260 \u47532 \u44256  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u50640  \u45824 \u54620  \u54869 \u49888 \u51012  \u48260 \u47140 \u50556  \u54624  \u44163 \u51060 \u50632 \u45716 \u44032 ? \u44536 \u47111 \u51648  \u50506 \u51004 \u47732  \u44536 \u46308 \u51008  \u44216 \u49552 \u54620  \u47560 \u51020 \u51004 \u47196  \u44592 \u46020 \u54616 \u44256  \u44536  \u50696 \u50616 \u51032  \u46907 \u51012  \u51060 \u54644 \u54616 \u51648  \u47803 \u54620  \u44275 \u51012  \u52286 \u50500 \u45236 \u44592  \u50948 \u54616 \u50668  \u45432 \u47141 \u54624  \u44163 \u51060 \u50632 \u45716 \u44032 ? \u50620 \u47560 \u45208  \u47566 \u51008  \u49324 \u46988 \u46308 \u51060  \u46160 \u47140 \u50868  \u49373 \u44033 \u51004 \u47196 , \u54841 \u51008  \u51068 \u49884 \u51201  \u52649 \u46041 \u44284  \u51088 \u44537 \u51004 \u47196  \u46041 \u50836 \u46104 \u50632 \u45912 \u44032 ! \u48152 \u49888 \u48152 \u51032 \u51032  \u49324 \u46988 \u46308 \u44284  \u48127 \u51648  \u50506 \u45716  \u49324 \u46988 \u46308 \u51060  \u50620 \u47560 \u45208  \u47566 \u50520 \u45912 \u44032 ? \u47566 \u51008  \u49324 \u46988 \u46308 \u51060  \u51452 \u45784 \u51032  \u45208 \u53440 \u45208 \u49900 \u51012  \u44592 \u48848 \u54616 \u45432 \u46972 \u44256  \u44277 \u50616 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u46308 \u51060  \u49464 \u49345 \u51032  \u51312 \u49548 \u50752  \u48708 \u45212 \u51012  \u44204 \u46356 \u50612 \u50556  \u54616 \u44256 , \u49884 \u44592 \u44032  \u51648 \u50672 \u46104 \u44256  \u49892 \u47581 \u50640  \u48736 \u51648 \u45716  \u49884 \u54744 \u51012  \u45817 \u54616 \u44172  \u46112  \u46412  \u48127 \u51020 \u51012  \u48260 \u47532 \u51648  \u50500 \u45768 \u54624  \u44163 \u51064 \u44032 ? \u54616 \u45208 \u45784 \u44760 \u49436  \u44536 \u46308 \u50640 \u44172  \u54665 \u54616 \u49884 \u45716  \u51068 \u51012  \u51593 \u49884  \u44648 \u45804 \u51012  \u49688  \u50630 \u51004 \u48064 \u47196  \u49457 \u44221  \u47568 \u50432 \u50640  \u51032 \u54616 \u50668  \u47749 \u48177 \u55176  \u51613 \u47749 \u46108  \u51652 \u47532 \u46972 \u46020  \u44536 \u46308 \u51060  \u48260 \u47532 \u51648  \u50506 \u51012  \u44163 \u51064 \u44032 ?\
\uc0\u51060 \u50752  \u44057 \u51008  \u49884 \u54744 \u51008  \u52280 \u46108  \u48127 \u51020 \u51012  \u44032 \u51648 \u44256  \u47568 \u50432 \u51032  \u44368 \u54984 \u44284  \u54616 \u45208 \u45784 \u51032  \u50689 \u51032  \u51648 \u49884 \u46972 \u44256  \u48127 \u45716  \u48148 \u47484  \u44536 \u45824 \u47196  \u49692 \u51333 \u54644  \u50728  \u49324 \u46988 \u46308 \u51032  \u55192 \u51012  \u45208 \u53440 \u45244  \u44163 \u51060 \u50632 \u45796 . \u44536 \u44163 \u51008  \u44536 \u46308 \u51060  \u49457 \u44221 \u51012  \u49457 \u44221  \u51088 \u52404 \u51032  \u54644 \u49437 \u51088 \u47196  \u49340 \u51648  \u50500 \u45768 \u54616 \u44256  \u49324 \u46988 \u51032  \u44204 \u54644 \u45208  \u54644 \u49437 \u51012  \u48155 \u50500 \u46308 \u51060 \u45716  \u51068 \u51060  \u50620 \u47560 \u45208  \u50948 \u54744 \u54620  \u44163 \u51076 \u51012  \u44221 \u54744 \u51012  \u53685 \u54616 \u50668  \u44032 \u47476 \u52432  \u51460  \u44163 \u51060 \u50632 \u45796 . \u44536 \u46308 \u51032  \u51096 \u47803 \u51004 \u47196  \u47568 \u48120 \u50516 \u50500  \u49373 \u44596  \u54844 \u46976 \u44284  \u49836 \u54548 \u51008  \u48127 \u51020 \u51032  \u51088 \u45376 \u46308 \u51012  \u44368 \u51221 \u49884 \u53020  \u51460  \u44163 \u51060 \u50632 \u45796 . \u44536 \u46308 \u51008  \u50696 \u50616 \u51032  \u47568 \u50432 \u51012  \u45908 \u50865  \u49464 \u48128 \u55176  \u50672 \u44396 \u54624  \u44163 \u51060 \u50632 \u44256 , \u44536 \u46308 \u51060  \u44032 \u51652  \u48127 \u51020 \u51032  \u44592 \u52488 \u47484  \u45908 \u50865  \u50628 \u48128 \u55176  \u44160 \u53664 \u54644  \u48388 \u51004 \u47196  \u48708 \u47197  \u51068 \u48152  \u44536 \u47532 \u49828 \u46020  \u44368 \u54924 \u44032  \u45328 \u47532  \u51064 \u51221 \u54616 \u45716  \u48148 \u51068 \u51648 \u46972 \u46020  \u44536 \u44163 \u51060  \u49457 \u44221 \u51032  \u51652 \u47532 \u50640  \u44592 \u52488 \u47484  \u46164  \u44163 \u51060  \u50500 \u45768 \u47732  \u44144 \u48512 \u54624  \u44163 \u51060 \u46972 \u45716  \u49324 \u49892 \u51012  \u48176 \u50864 \u44172  \u46112  \u44163 \u51060 \u50632 \u45796 .\
\uc0\u44536 \u46308 \u50640 \u44172 \u45716  \u52488 \u44592 \u51032  \u51228 \u51088 \u46308 \u44284  \u47560 \u52268 \u44032 \u51648 \u47196  \u44536  \u49884 \u47144 \u51032  \u49884 \u44036 \u51060  \u51060 \u54644 \u54624  \u49688  \u50630 \u45716  \u46319 \u51060  \u48372 \u50688 \u51012 \u51648 \u46972 \u46020  \u54980 \u50640  \u44032 \u49436 \u45716  \u47749 \u48177 \u54616 \u44172  \u48157 \u54784 \u51656  \u44163 \u51060 \u50632 \u45796 . \u44536 \u46308 \u51060  \u47564 \u51068  \'93\u51452 \u44760 \u49436  \u45208 \u51473 \u50640  \u50612 \u46523 \u44172  \u54665 \u54616 \u49888  \u44163 \'94\u51012  \u48372 \u44172  \u46108 \u45796 \u47732 , \u44536  \u49884 \u47144 \u51060  \u51200 \u46308 \u51032  \u51096 \u47803 \u50640  \u44592 \u51064 \u46108  \u44163 \u51060 \u50632 \u51012 \u51648 \u46972 \u46020  \u44536 \u46308 \u51012  \u54693 \u54616 \u49888  \u54616 \u45208 \u45784 \u51032  \u49324 \u46993 \u51032  \u44228 \u54925 \u51008  \u54869 \u49892 \u54616 \u44172  \u49457 \u52712 \u46104 \u44256  \u51080 \u50632 \u45796 \u45716  \u44163 \u51012  \u44648 \u45804 \u51012  \u44163 \u51060 \u45796 . \u44536 \u46308 \u51008  \'93\u51452 \u45716  \u44032 \u51109  \u51088 \u48708 \u54616 \u49884 \u44256  \u44557 \u55100 \u55176  \u50668 \u44592 \u45716  \u51088 \u49884 \'94\u47728 , \'93\u50668 \u54840 \u50752 \u51032  \u47784 \u46304  \u44600 \u51008  \u44536  \u50616 \u50557 \u44284  \u51613 \u44144 \u47484  \u51648 \u53412 \u45716  \u51088 \u50640 \u44172  \u51064 \u51088 \u50752  \u51652 \u47532 \u47196 \u45796 \'94\u46972 \u44256  \u54620  \u49457 \u44221 \u51032  \u47568 \u50432 \u51012  \u44480 \u51473 \u54620  \u44221 \u54744 \u51012  \u53685 \u54616 \u50668  \u48176 \u50864 \u44172  \u46112  \u44163 \u51060 \u45796 .\
