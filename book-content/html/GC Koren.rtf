\uc0\u50836 \u54620 \u44228 \u49884 \u47197  13\u51109 \u51032  \u50696 \u50616 \u51008  \u49352 \u45180  \u50577 \u44057 \u51060  \u46160  \u49108 \u51060  \u51080 \u45716  \u51664 \u49849 \u51004 \u47196  \u47896 \u49324 \u46108  \u49464 \u47141 \u51060  \'93\u46405 \u44284  \u46405 \u50640  \u44144 \u54616 \u45716  \u51088 \u46308 \'94\u47196  \u54364 \u48276 \u44284  \u48708 \u49847 \u54620  \u51664 \u49849 \u51004 \u47196  \u54364 \u49345 \u46108  \u48277 \u50773 \u44428 \u51012  \u44221 \u48176 \u54616 \u44172  \u54624  \u44163 \u51060 \u46972 \u44256  \u47568 \u54620 \u45796 . \u44536  \u46160  \u49108  \u44032 \u51652  \u51664 \u49849 \u51008  \u46608 \u54620  \'93\u46405 \u50640  \u44144 \u54616 \u45716  \u51088 \u46308 \u50640 \u44172 \'85\u51664 \u49849 \u51012  \u50948 \u54616 \u50668  \u50864 \u49345 \u51012  \u47564 \u46308 \u46972 \'94 \u54624  \u44163 \u51060 \u47728 , \u45908 \u50865 \u51060  \'93\u51200 \u44032  \u47784 \u46304  \u51088  \u44263  \u51089 \u51008  \u51088 \u45208  \u53360  \u51088 \u45208  \u48512 \u51088 \u45208  \u48712 \u44417 \u54620  \u51088 \u45208  \u51088 \u50976 \u54620  \u51088 \u45208  \u51333 \u46308 \u47196  \u44536  \u50724 \u47480 \u49552 \u50640 \u45208  \u51060 \u47560 \u50640  \u54364 \u47484  \u48155 \u44172 \'94 (\u44228  13:11~16) \u54616 \u46972 \u44256  \u47749 \u47161 \u54624  \u44163 \u51060 \u45796 . \u49352 \u45180 \u50577 \u44057 \u51060  \u46160  \u49108 \u51060  \u51080 \u45716  \u51664 \u49849 \u51004 \u47196  \u54364 \u49345 \u46108  \u49464 \u47141 \u51008  \u48513 \u48120  \u54633 \u51473 \u44397 \u51076 \u51060  \u51060 \u48120  \u50508 \u47140 \u51256  \u51080 \u45796 . \u44536 \u47532 \u44256  \u51060  \u50696 \u50616 \u51008  \u47196 \u47560 \u44368 \u44032  \u44536 \u51032  \u52572 \u49345 \u44428 \u50640  \u45824 \u54620  \u53945 \u48324 \u54620  \u51064 \u51221 \u51032  \u54364 \u47196  \u51452 \u51109 \u54616 \u45716  \u51068 \u50836 \u51068  \u51456 \u49688 \u47484  \u48120 \u44397 \u51060  \u44053 \u50836 \u54616 \u44172  \u46112  \u46412  \u49457 \u52712 \u46112  \u44163 \u51060 \u45796 . \u44536 \u47084 \u45208  \u48120 \u44397 \u47564 \u51060  \u48277 \u50773 \u44428 \u50640 \u44172  \u51060 \u47084 \u54620  \u44221 \u51032 \u47484  \u54364 \u54616 \u51648 \u45716  \u50506 \u51012  \u44163 \u51060 \u45796 . \u54620  \u46412  \u47196 \u47560 \u51032  \u51648 \u48176 \u44428 \u51012  \u51064 \u51221 \u54620  \u47784 \u46304  \u45208 \u46972 \u50640  \u51080 \u50632 \u45912  \u44536 \u51032  \u50689 \u54693 \u47141 \u51008  \u50500 \u51649 \u46020  \u50630 \u50612 \u51648 \u51648  \u50506 \u44256  \u51080 \u45796 . \u44536 \u47532 \u44256  \u50696 \u50616 \u51008  \u44536  \u49464 \u47141 \u51060  \u45796 \u49884  \u54924 \u48373 \u46112  \u44163 \u51012  \u50508 \u47140  \u51456 \u45796 . \'93\u44536 \u51032  \u47672 \u47532  \u54616 \u45208 \u44032  \u49345 \u54616 \u50668  \u51453 \u44172  \u46108  \u44163  \u44057 \u45908 \u45768  \u44536  \u51453 \u44172  \u46104 \u50632 \u45912  \u49345 \u52376 \u44032  \u45208 \u51004 \u47588  \u50728  \u46405 \u51060  \u51060 \u49345 \u55176  \u50668 \u44200  \u51664 \u49849 \u51012  \u46384 \u47476 \'94 (\u44228  13:3) \u47532 \u46972 \u44256  \u54620 \u45796 . \u52824 \u47749 \u51201  \u49345 \u52376 \u47484  \u48155 \u51008  \u53440 \u44201 \u51008  1798\u45380 \u50640  \u48156 \u49373 \u54620  \u48277 \u50773 \u44428 \u51032  \u47792 \u46973 \u51012  \u44032 \u47532 \u53416 \u45796 . \u44536  \u51068 \u51060  \u51080 \u51008  \u54980  \u49440 \u51648 \u51088 \u45716  \'93\u44536  \u51453 \u44172  \u46104 \u50632 \u45912  \u49345 \u52376 \u44032  \u45208 \u51004 \u47588  \u50728  \u46405 \u51060  \u51060 \u49345 \u55176  \u50668 \u44200  \u51664 \u49849 \u51012  \u46384 \u47476 \'94\u45908 \u46972 \u44256  \u47568 \u54620 \u45796 . \u48148 \u50872 \u51008  \u44536  \'93\u48520 \u48277 \u54620  \u51088 \'94 (\u49332 \u54980  2:8) \u44032  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u51116 \u47548 \u54