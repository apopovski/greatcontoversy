\f0\b \cf0 \uc0\u53356 \u44172  \u54872 \u50689 \u48155 \u51008  \u47336 \u53552 \u51032  \u51200 \u49436 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u47336 \u53552 \u51032  \u51200 \u49436 \u45716  \u46020 \u49884 \u50752  \u49884 \u44264 \u50640 \u49436  \u47784 \u46160  \u53360  \u54872 \u50689 \u51012  \u48155 \u50520 \u45796 . \'93\u47336 \u53552 \u50752  \u44536 \u51032  \u52828 \u44396 \u46308 \u51060  \u51200 \u51089 \u54620  \u44163 \u51012  \u45796 \u47480  \u49324 \u46988 \u46308 \u51008  \u45328 \u47532  \u48372 \u44553 \u54616 \u50688 \u45796 . \u49849 \u50896  \u51228 \u46020 \u51032  \u48520 \u54633 \u47532 \u54632 \u51012  \u44648 \u45804 \u51008  \u49849 \u47140 \u46308 \u51008  \u51060 \u51204 \u44284  \u44057 \u51060  \u54616 \u45716  \u51068  \u50630 \u51060  \u44172 \u51004 \u47476 \u44172  \u51648 \u45236 \u45912  \u49373 \u54876 \u51012  \u48148 \u44984 \u50612 \u49436  \u54876 \u46041 \u51201 \u51064  \u49373 \u54876 \u51012  \u54616 \u44256 \u51088  \u55148 \u47581 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u46308 \u51008  \u49457 \u44221 \u51012  \u54644 \u49437 \u54616 \u44592 \u50640  \u45320 \u47924 \u45208  \u47924 \u51648 \u54616 \u50688 \u44592  \u46412 \u47928 \u50640  \u44033  \u51648 \u48169 \u51032  \u52492 \u46973 \u46308 \u51012  \u52286 \u50500 \u45796 \u45768 \u47732 \u49436  \u47336 \u53552 \u50752  \u44536 \u51032  \u46041 \u47308 \u46308 \u51060  \u51200 \u49696 \u54620  \u49436 \u51201 \u46308 \u51012  \u54032 \u47588 \u54616 \u45716  \u51068 \u51012  \u54616 \u50688 \u45796 . \u49692 \u49885 \u44036 \u50640  \u46021 \u51068 \u51008  \u51060 \u50752  \u44057 \u51060  \u50857 \u44048 \u54620  \u44428 \u49436 \u50896 \u46308 \u51032  \u47784 \u49845 \u51012  \u50612 \u46356 \u50640 \u49436 \u45208  \u48380  \u49688  \u51080 \u44172  \u46104 \u50632 \u45796 \'94 (D\'92Aubigne, b.9, ch.11).\
\uc0\u51060 \u47084 \u54620  \u51200 \u49436 \u46308 \u51012  \u44032 \u45212 \u54620  \u49324 \u46988 \u51060 \u45208  \u48512 \u50976 \u54620  \u49324 \u46988 \u51060 \u45208  \u50976 \u49885 \u54620  \u49324 \u46988 \u51060 \u45208  \u47924 \u49885 \u54620  \u49324 \u46988 \u51012  \u47561 \u47200 \u54616 \u44256  \u47784 \u46304  \u49324 \u46988 \u46308 \u51060  \u44053 \u54620  \u55141 \u48120 \u47484  \u44032 \u51648 \u44256  \u50672 \u44396 \u54616 \u44172  \u46104 \u50632 \u45796 . \u49884 \u44264  \u54617 \u44368 \u51032  \u44368 \u49324 \u46308 \u51008  \u48164 \u50640  \u45212 \u47215 \u44032 \u50640  \u47784 \u50668  \u50505 \u51008  \u51201 \u51008  \u49688 \u51032  \u49324 \u46988 \u46308 \u50640 \u44172  \u53360  \u49548 \u47532 \u47196  \u49457 \u44221 \u51012  \u51069 \u50612  \u51452 \u50632 \u45796 . \u44536 \u47532 \u44256  \u51652 \u47532 \u47484  \u44648 \u45803 \u44256  \u44536  \u47568 \u50432 \u51012  \u48155 \u50500 \u46308 \u51064  \u49324 \u46988 \u46308 \u51008  \u47784 \u46304  \u45432 \u47141 \u51012  \u45796  \u44592 \u50872 \u50668  \u45796 \u47480  \u49324 \u46988 \u46308 \u50640 \u44172  \u44536  \u44592 \u49244  \u49548 \u49885 \u51012  \u51204 \u54616 \u50688 \u45796 .\
\'93\uc0\u51452 \u51032  \u47568 \u50432 \u51012  \u50676 \u48064 \u47196  \u50864 \u46164 \u54620  \u51088 \u50640 \u44172  \u48708 \u52712 \u50612  \u44648 \u45803 \u44172  \u54616 \u45208 \u51060 \u45796 \'94 (\u49884  119:130) \u44256  \u54620  \u49457 \u44221  \u47568 \u50432 \u51060  \u51077 \u51613 \u46104 \u50632 \u45796 . \u49457 \u44221  \u50672 \u44396 \u47196  \u51064 \u54616 \u50668  \u48177 \u49457 \u46308 \u51032  \u47560 \u51020 \u44284  \u49900 \u47161 \u50640  \u53360  \u48320 \u54868 \u44032  \u51068 \u50612 \u45208 \u44256  \u51080 \u50632 \u45796 . \u48277 \u50773 \u44368 \u51032  \u44508 \u52825 \u51008  \u44536  \u51648 \u48176 \u54616 \u50640  \u51080 \u45716  \u49324 \u46988 \u46308 \u50640 \u44172  \u49632 \u47693 \u50640 \u47484  \u47700 \u50612 \u49436  \u47924 \u51648 \u50752  \u53440 \u46973 \u51004 \u47196  \u48736 \u46888 \u47160 \u45796 . \u44536 \u47532 \u44256  \u48120 \u49888 \u51201 \u51064  \u51032 \u49885 \u51012  \u50628 \u44201 \u54616 \u44172  \u51648 \u53412 \u44172  \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536  \u47784 \u46304  \u51032 \u49885 \u50640  \u51080 \u50612 \u49436  \u47560 \u51020 \u44284  \u51221 \u49888 \u51008  \u44144 \u51032  \u44048 \u46041 \u46104 \u51648  \u50500 \u45768 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u49457 \u44221 \u51032  \u47749 \u48177 \u54620  \u51652 \u47532 \u47484  \u54644 \u49437 \u54616 \u45716  \u47336 \u53552 \u51032  \u49444 \u44368 \u50752  \u51068 \u48152  \u49324 \u46988 \u46308 \u51032  \u49552 \u50640  \u46308 \u50612 \u44032  \u51080 \u45716  \u49457 \u44221  \u44536  \u51088 \u52404 \u45716  \u44536 \u46308 \u51032  \u51104 \u51088 \u45716  \u44592 \u45733 \u51012  \u51068 \u44648 \u50892  \u51452 \u50632 \u44256 , \u50689 \u49457  (\u63923 \u24615 ) \u51012  \u51221 \u54868 \u49884 \u53412 \u44256  \u54693 \u49345 \u49884 \u53020  \u51452 \u50632 \u51012  \u49104  \u50500 \u45768 \u46972 , \u51648 \u45733 \u50640 \u46020  \u49352 \u47196 \u50868  \u54876 \u44592 \u50752  \u49373 \u44592 \u47484  \u51452 \u50632 \u45796 .\
