\uc0\u44536  \u51116 \u50521 \u46308 \u51008  \u51204  \u49464 \u44228 \u51201 \u51064  \u44163 \u51060  \u50500 \u45768 \u45796 . \u47564 \u51068  \u44536 \u47111 \u44172  \u46104 \u47732  \u51648 \u49345 \u51032  \u44144 \u48124 \u46308 \u51008  \u50756 \u51204 \u55176  \u51204 \u47736 \u46112  \u44163 \u51060 \u45796 . \u44536 \u47084 \u45208  \u44536 \u44163 \u46308 \u51008  \u49324 \u46988 \u46308 \u50640 \u44172  \u51648 \u44552 \u44751  \u50508 \u47140 \u51652  \u44163 \u46308  \u51473  \u44032 \u51109  \u47924 \u49436 \u50868  \u51116 \u50521 \u51060  \u46112  \u44163 \u51060 \u45796 . \u51008 \u54812 \u51032  \u49884 \u44592 \u44032  \u47560 \u52824 \u44592  \u51204 \u50640  \u49324 \u46988 \u46308 \u50640 \u44172  \u45236 \u47532 \u45716  \u47784 \u46304  \u51116 \u50521 \u50640 \u45716  \u51088 \u48708 \u44032  \u49438 \u50668  \u51080 \u50632 \u45796 . \u44536 \u47532 \u49828 \u46020 \u51032  \u51473 \u48372 \u51032  \u54588 \u44032  \u51396 \u51064 \u51060  \u48276 \u54620  \u51396 \u51032  \u48516 \u47049 \u45824 \u47196  \u51116 \u50521 \u51012  \u48155 \u51648  \u50506 \u46020 \u47197  \u48372 \u54840 \u54644  \u51452 \u50632 \u45796 . \u44536 \u47084 \u45208  \u47560 \u51648 \u47561  \u49900 \u54032 \u50640 \u45716  \u51088 \u48708 \u44032  \u49438 \u51060 \u51648  \u50506 \u51008  \u51652 \u45432 \u44032  \u50143 \u50500 \u51652 \u45796 .\
\uc0\u44536 \u45216 \u50640  \u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u44536 \u46308 \u51060  \u50724 \u47019 \u46041 \u50504  \u47736 \u49884 \u54644  \u50728  \u54616 \u45208 \u45784 \u51032  \u51088 \u48708 \u51032  \u48372 \u54840 \u47484  \u48155 \u44256 \u51088  \u54624  \u44163 \u51060 \u45796 . \'93\u51452  \u50668 \u54840 \u50752 \u44760 \u49436  \u44032 \u46972 \u49324 \u45824  \u48372 \u46972  \u45216 \u51060  \u51060 \u47484 \u51648 \u46972  \u45236 \u44032  \u44592 \u44540 \u51012  \u46405 \u50640  \u48372 \u45236 \u47532 \u45768  \u50577 \u49885 \u51060  \u50630 \u50612  \u51452 \u47548 \u51060  \u50500 \u45768 \u47728  \u47932 \u51060  \u50630 \u50612  \u44040 \u54632 \u51060  \u50500 \u45768 \u50836  \u50668 \u54840 \u50752 \u51032  \u47568 \u50432 \u51012  \u46307 \u51648  \u47803 \u54620  \u44592 \u44040 \u51060 \u46972  \u49324 \u46988 \u51060  \u51060  \u48148 \u45796 \u50640 \u49436  \u51200  \u48148 \u45796 \u44620 \u51648  \u48513 \u50640 \u49436  \u46041 \u44620 \u51648  \u48708 \u53952 \u44144 \u47532 \u47728  \u50668 \u54840 \u50752 \u51032  \u47568 \u50432 \u51012  \u44396 \u54616 \u47140 \u44256  \u45804 \u47140  \u50773 \u47000 \u54616 \u46104  \u50619 \u51648  \u47803 \u54616 \u47532 \'94 (\u50516  8:11, 12) \u46972 .\
