\uc0\u49457 \u44221 \u51008  1\u49464 \u44592 \u50640  \u45208 \u53440 \u45228 \u45912  \u44163 \u44284  \u46609 \u44057 \u51008  \u44368 \u54924 \u51032  \u53440 \u46973  \u49345 \u53468 \u44032  \u51452 \u45784 \u51032  \u51116 \u47548  \u51204 \u50640  \u45208 \u53440 \u45216  \u44163 \u51012  \u47568 \u54620 \u45796 . \'93\u47568 \u49464 \u50640  \u44256 \u53685 \u54616 \u45716  \u46412 \u44032  \u51060 \u47476 \u47532 \u45768  \u49324 \u46988 \u46308 \u51008  \u51088 \u44592 \u47484  \u49324 \u46993 \u54616 \u47728  \u46024 \u51012  \u49324 \u46993 \u54616 \u47728  \u51088 \u44557 \u54616 \u47728  \u44368 \u47564 \u54616 \u47728  \u55036 \u48169 \u54616 \u47728  \u48512 \u47784 \u47484  \u44144 \u50669 \u54616 \u47728  \u44048 \u49324 \u54616 \u51648  \u50500 \u45768 \u54616 \u47728  \u44144 \u47337 \u54616 \u51648  \u50500 \u45768 \u54616 \u47728  \u47924 \u51221 \u54616 \u47728  \u50896 \u53685 \u54632 \u51012  \u54400 \u51648  \u50500 \u45768 \u54616 \u47728  \u52280 \u49548 \u54616 \u47728  \u51208 \u51228 \u54616 \u51648  \u47803 \u54616 \u47728  \u49324 \u45208 \u50864 \u47728  \u49440 \u54620  \u44163 \u51012  \u51339 \u50500  \u50500 \u45768 \u54616 \u47728  \u48176 \u48152 \u54616 \u50668  \u54036 \u47728  \u51312 \u44553 \u54616 \u47728  \u51088 \u44256 \u54616 \u47728  \u53132 \u46973 \u51012  \u49324 \u46993 \u54616 \u44592 \u47484  \u54616 \u45208 \u45784  \u49324 \u46993 \u54616 \u45716  \u44163 \u48372 \u45796  \u45908 \u54616 \u47728  \u44221 \u44148 \u51032  \u47784 \u50577 \u51008  \u51080 \u51004 \u45208  \u44221 \u44148 \u51032  \u45733 \u47141 \u51008  \u48512 \u51064 \u54616 \u45716  \u51088 \'94 (\u46372 \u54980  3:1~5) \u46972 . \'93\u49457 \u47161 \u51060  \u48157 \u55176  \u47568 \u50432 \u54616 \u49884 \u44592 \u47484  \u54980 \u51068 \u50640  \u50612 \u46500  \u49324 \u46988 \u46308 \u51060  \u48127 \u51020 \u50640 \u49436  \u46496 \u45208  \u48120 \u54841 \u54616 \u44172  \u54616 \u45716  \u50689 \u44284  \u44480 \u49888 \u51032  \u