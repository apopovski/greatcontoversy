\f0\b \cf0 \uc0\u45940 \u47560 \u53356 \u51032  \u44060 \u54785 \u51088  \u53440 \u50864 \u51232 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u54588 \u50640 \u47805 \u51032  \u49328 \u44036 , \u54532 \u46993 \u49828 \u51032  \u54217 \u50896 , \u45348 \u45916 \u46976 \u46300 \u51032  \u54644 \u48320  \u46321 \u51648 \u50640 \u49436 \u45716  \u48373 \u51020  \u49324 \u50629 \u51060  \u49888 \u51088 \u46308 \u51032  \u54588 \u47196 \u50024  \u51060 \u47336 \u50612 \u51276 \u45796 . \u44536 \u47084 \u45208  \u48513 \u50976 \u47101 \u51032  \u50668 \u47084  \u45208 \u46972 \u50640 \u45716  \u54217 \u54868 \u47213 \u44172  \u48373 \u51020  \u49324 \u50629 \u51060  \u49884 \u51089 \u46104 \u50632 \u45796 . \u48708 \u53584 \u48288 \u47476 \u53356 \u51032  \u54617 \u49373 \u46308 \u51060  \u48376 \u44397 \u51004 \u47196  \u46028 \u50500 \u44032 \u49436  \u44060 \u54785 \u51452 \u51032 \u47484  \u49828 \u52856 \u46356 \u45208 \u48708 \u50500 \u50640  \u51204 \u54616 \u50688 \u45796 . \u47336 \u53552 \u51032  \u51200 \u49436 \u44032  \u48156 \u54665 \u46104 \u51088  \u51652 \u47532 \u51032  \u48731 \u51012  \u51204 \u54616 \u45716  \u45936  \u53360  \u55192 \u51060  \u46104 \u50632 \u45796 . \u49692 \u48149 \u54616 \u44256  \u45812 \u45824 \u54620  \u48513 \u50976 \u47101 \u51032  \u49324 \u46988 \u46308 \u51008  \u47196 \u47560 \u44368 \u51032  \u48120 \u49888 \u44284  \u49324 \u52824 \u50752  \u48512 \u54056 \u50640 \u49436  \u48279 \u50612 \u45208 \u49436  \u49692 \u44208 \u54616 \u44256 , \u45800 \u49692 \u54616 \u44256  \u49373 \u47749 \u51012  \u51452 \u45716  \u49457 \u44221 \u51032  \u51652 \u47532 \u47484  \u54872 \u50689 \u54616 \u50688 \u45796 .\
\'93\uc0\u45940 \u47560 \u53356 \u51032  \u44060 \u54785 \u51088 \'94 \u53440 \u50864 \u51232  (Tausen) \u51008  \u45453 \u48512 \u51032  \u50500 \u46308 \u51060 \u50632 \u45796 . \u44536 \u45716  \u50612 \u47140 \u49436 \u48512 \u53552  \u44053 \u54620  \u51648 \u47141 \u51032  \u49548 \u50976 \u51088 \u51076 \u51060  \u51077 \u51613 \u46104 \u50632 \u44256 , \u44368 \u50977 \u51012  \u48155 \u44256 \u51088  \u44040 \u44553 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u48512 \u47784 \u51032  \u54872 \u44221  \u46412 \u47928 \u50640  \u44536  \u51068 \u51060  \u50857 \u45225 \u46104 \u51648  \u47803 \u54616 \u50688 \u51004 \u48064 \u47196  \u44536 \u45716  \u49849 \u50896  (\u20711 \u38498 ) \u51004 \u47196  \u46308 \u50612 \u44052 \u45796 . \u44144 \u44592 \u49436  \u44536 \u45716  \u48512 \u51648 \u47088 \u54616 \u44256 , \u49457 \u49892 \u54616 \u44256  \u49692 \u44208 \u54620  \u49373 \u50528 \u47484  \u54616 \u50688 \u44592  \u46412 \u47928 \u50640  \u49849 \u50896 \u51109 \u51032  \u52509 \u50528 \u47484  \u51077 \u44172  \u46104 \u50632 \u45796 . \u49884 \u54744 \u54644  \u48376  \u44208 \u44284  \u44536 \u50640 \u44172 \u45716  \u51109 \u52264  \u44368 \u54924 \u47484  \u50948 \u54616 \u50668  \u50976 \u47141 \u54620  \u48393 \u49324 \u47484  \u54624  \u49688  \u51080 \u45716  \u51116 \u45733 \u51060  \u51080 \u45796 \u45716  \u44163 \u51060  \u45208 \u53440 \u45228 \u45796 . \u44536 \u47084 \u48064 \u47196  \u44536 \u47484  \u46021 \u51068 \u51060 \u45208  \u45348 \u45916 \u46976 \u46300 \u51032  \u50612 \u45712  \u45824 \u54617 \u50640  \u50976 \u54617 \u49884 \u53412 \u44592 \u47196  \u44208 \u51221 \u46104 \u50632 \u45796 . \u44536  \u52397 \u45380  \u54617 \u46020 \u45716  \u48708 \u53584 \u48288 \u47476 \u53356  \u45824 \u54617 \u50640 \u47564  \u44032 \u51648  \u47803 \u54620 \u45796 \u45716  \u51312 \u44148  \u54616 \u50640  \u51088 \u49888 \u51060  \u54617 \u44368 \u47484  \u49440 \u53469 \u54624  \u54728 \u46973 \u51012  \u48155 \u50520 \u45796 . \u44368 \u54924 \u51032  \u54617 \u51088 \u44032  \u46112  \u49324 \u46988 \u51060  \u51060 \u45800 \u51032  \u46021 \u49548 \u50640  \u52840 \u54644 \u47484  \u48155 \u50500 \u49436 \u45716  \u50504  \u46108 \u45796 \u45716  \u44163 \u51060  \u49849 \u47140 \u46308 \u51032  \u51452 \u51109 \u51060 \u50632 \u45796 .\
\uc0\u53440 \u50864 \u51232 \u51008  \u53168 \u47480  (Ko..ln) \u45824 \u54617 \u50640  \u51077 \u54617 \u54616 \u50688 \u45796 . \u44536  \u44275 \u51008  \u51648 \u44552 \u46020  \u47560 \u52268 \u44032 \u51648 \u51060 \u51648 \u47564 , \u45817 \u49884 \u50640 \u45716  \u47196 \u47560 \u44368 \u51032  \u53360  \u50836 \u49352  \u51473 \u51032  \u54616 \u45208 \u50688 \u45796 . \u44536 \u47088 \u45936  \u44536 \u45716  \u44144 \u44592 \u49436  \u50620 \u47560  \u46104 \u51648  \u50500 \u45768 \u54616 \u50668  \u54617 \u49373 \u46308 \u51032  \u49888 \u48708 \u49444 \u50640  \u50684 \u51613 \u51012  \u45712 \u45180 \u44172  \u46104 \u50632 \u45796 . \u44144 \u51032  \u44057 \u51008  \u49884 \u44592 \u50640  \u44536 \u45716  \u47336 \u53552 \u51032  \u51200 \u49436 \u46308 \u51012  \u50619 \u44172  \u46104 \u50632 \u45796 . \u44536 \u45716  \u45440 \u46988 \u44284  \u44592 \u49256 \u51004 \u47196  \u44536  \u51200 \u49436 \u46308 \u51012  \u51069 \u44256 , \u44536  \u44060 \u54785 \u51088 \u51032  \u44032 \u47476 \u52840 \u51012  \u51649 \u51217  \u48155 \u44256  \u49910 \u51008  \u50837 \u47581 \u51012  \u51208 \u44048 \u54616 \u44172  \u46104 \u50632 \u45796 . \u44536 \u47084 \u45208  \u51060 \u50752  \u44057 \u51060  \u54616 \u44172  \u46104 \u47732  \u44536 \u45716  \u49849 \u50896 \u51032  \u50896 \u51109 \u51012  \u48176 \u48152 \u54616 \u44172  \u46104 \u44256 , \u51088 \u44592 \u51032  \u49373 \u54876 \u48708 \u46020  \u45130 \u50612 \u51648 \u45716  \u50948 \u54744 \u51012  \u47732 \u54624  \u49688  \u50630 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u51593 \u49884  \u44208 \u49900 \u54616 \u44256 , \u50620 \u47560  \u54980 \u50640  \u48708 \u53584 \u48288 \u47476 \u53356  \u45824 \u54617 \u50640  \u46321 \u47197 \u54616 \u44172  \u46104 \u50632 \u45796 .\
\uc0\u45940 \u47560 \u53356 \u50640  \u46028 \u50500 \u44032 \u51088 \u47560 \u51088  \u44536 \u45716  \u45796 \u49884  \u49849 \u50896 \u50640  \u46308 \u50612 \u44052 \u45796 . \u50500 \u47924 \u46020  \u44536 \u44032  \u47336 \u53552 \u54028 \u44032  \u46104 \u50632 \u45796 \u45716  \u44163 \u51012  \u51032 \u49900 \u54616 \u51648  \u50506 \u50520 \u45796 . \u44536 \u45716  \u51088 \u44592 \u51032  \u48708 \u48128 \u51012  \u46300 \u47084 \u45236 \u51648  \u50506 \u44256 , \u46041 \u47308 \u46308 \u51032  \u54200 \u44204 \u51012  \u51068 \u51004 \u53412 \u51648  \u50506 \u51004 \u47732 \u49436  \u44536 \u46308 \u51012  \u48372 \u45796  \u49692 \u44208 \u54620  \u49888 \u50521 \u44284  \u44256 \u49345 \u54620  \u49373 \u50528 \u47196  \u51064 \u46020 \u54616 \u44256 \u51088  \u45432 \u47141 \u54616 \u50688 \u45796 . \u44536 \u45716  \u49457 \u44221 \u51012  \u54196 \u49436  \u44536  \u52280 \u46907 \u51012  \u48157 \u55176  \u54644 \u49437 \u54616 \u44256 , \u47560 \u52840 \u45236 \u45716  \u51396 \u51064 \u51032  \u51032 \u50752  \u44396 \u50896 \u51032  \u50976 \u51068 \u54620  \u49548 \u47581 \u51060  \u46104 \u49884 \u45716  \u44536 \u47532 \u49828 \u46020 \u47484  \u51204 \u54616 \u50688 \u45796 . \u47196 \u47560 \u44368 \u51032  \u50976 \u47141 \u54620  \u50745 \u54840 \u51088 \u44032  \u46112  \u44163 \u51012  \u44536 \u50640 \u44172  \u44592 \u45824 \u54644  \u50728  \u49849 \u50896 \u51109 \u51008  \u49900 \u55176  \u45432 \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u45716  \u44263  \u44536  \u49849 \u50896 \u50640 \u49436  \u45796 \u47480  \u49849 \u50896 \u51004 \u47196  \u50734 \u44200 \u51276 \u44256 , \u44144 \u44592 \u49436  \u50628 \u51473 \u54620  \u44048 \u49884  \u54616 \u50640  \u54848 \u47196  \u51088 \u44592  \u48169 \u50640 \u47564  \u44039 \u54784  \u51080 \u44172  \u46104 \u50632 \u45796 .\
