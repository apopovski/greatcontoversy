\f1\b0 \cf0 \
\uc0\u50760 \u45940 \u49828 \u51064 \u46308 \u51008  \u50976 \u47101 \u51032  \u50668 \u47084  \u48177 \u49457 \u46308  \u51473 \u50640 \u49436  \u52572 \u52488 \u47196  \u49457 \u44221 \u51012  \u48264 \u50669 \u54620  \u49324 \u46988 \u46308  \u51473 \u51032  \u54616 \u45208 \u50688 \u45796  (\u48512 \u47197  11 \u52280 \u51312 ). \u44536 \u46308 \u51008  \u51333 \u44368 \u44060 \u54785 \u51060  \u51068 \u50612 \u45208 \u44592  \u49688 \u48177 \u45380  \u51204 \u50640  \u48268 \u50024  \u51088 \u44397 \u50612 \u47196  \u54596 \u49324  (\u31558 \u23531 ) \u54620  \u49457 \u44221 \u51012  \u44032 \u51648 \u44256  \u51080 \u50632 \u51004 \u48064 \u47196  \u45908 \u50865  \u51613 \u50724 \u50752  \u48149 \u54644 \u51032  \u54364 \u51201 \u51060  \u46104 \u50632 \u45796 . \u44536 \u46308 \u51008  \u47196 \u47560 \u44368 \u54924 \u47484  \u50836 \u54620 \u44228 \u49884 \u47197 \u50640  \u51080 \u45716  \u53440 \u46973 \u54620  \u48148 \u48296 \u47200 \u51060 \u46972 \u44256  \u49440 \u50616 \u54616 \u50688 \u45796 . \u44536 \u47532 \u44256  \u44536 \u46308 \u51008  \u49373 \u47749 \u51032  \u50948 \u54744 \u51012  \u47924 \u47493 \u50416 \u44256  \u44208 \u51221 \u51201 \u51064  \u53468 \u46020 \u47196  \u47196 \u47560 \u44368 \u51032  \u53440 \u46973 \u50640  \u51200 \u54637 \u54616 \u50688 \u45796 . \u50724 \u47019 \u46041 \u50504  \u44228 \u49549 \u46108  \u48149 \u54644 \u47196  \u51064 \u54616 \u50668  \u45908 \u47084 \u45716  \u49888 \u50521 \u51201 \u51064  \u53440 \u54801 \u51012  \u54616 \u50668  \u44536  \u48516 \u47749 \u54620  \u50896 \u52825 \u51012  \u52264 \u52784  \u48260 \u47160 \u51648 \u47564 , \u50612 \u46500  \u49324 \u46988 \u46308 \u51008  \u51652 \u47532 \u50640  \u45908 \u50865  \u44403 \u44172  \u49456 \u45796 . \u50516 \u55121 \u44284  \u48176 \u44368 \u51032  \u51204  \u44592 \u44036 \u51012  \u53685 \u54616 \u50668  \u47196 \u47560 \u44368 \u51032  \u52572 \u49345 \u44428 \u51012  \u48512 \u51064 \u54616 \u44256  \u49457 \u49345  (\u32854 \u20687 ) \u49709 \u48176 \u47484  \u50864 \u49345  \u49709 \u48176 \u47196  \u48372 \u44256  \u44144 \u48512 \u54616 \u44256  \u52280  \u50504 \u49885 \u51068 \u51012  \u51648 \u53416  \u50760 \u45940 \u49828 \u51064 \u46308 \u51060  \u51080 \u50632 \u45796  (\u48512 \u47197  12 \u52280 \u51312 ). \u44536 \u46308 \u51008  \u44032 \u51109  \u44537 \u49900 \u54620  \u48149 \u54644  \u49549 \u50640 \u49436 \u46020  \u44536 \u46308 \u51032  \u48127 \u51020 \u51012  \u50976 \u51648 \u54616 \u50688 \u45796 . \u48708 \u47197  \u49324 \u48372 \u51060  (Savoyard) \u49324 \u46988 \u46308 \u51032  \u52285 \u50640  \u52244 \u47532 \u44256  \u47196 \u47560 \u51032  \u54868 \u54805 \u51452  (\u28779 \u21009 \u26609 ) \u50640  \u53440 \u51453 \u51012 \u51648 \u46972 \u46020  \u44536 \u46308 \u51008  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u44284  \u44536 \u48516 \u51032  \u50689 \u44305 \u51012  \u50948 \u54616 \u50668  \u46160 \u47140 \u50880  \u50630 \u51060  \u44403 \u44172  \u49456 \u45796 .\
\uc0\u52393 \u52393 \u51060  \u49912 \u51064  \u49328 \u50501 \u46308 \u51032  \u45458 \u51008  \u49457 \u52292 \u46308 \u51008  \u50668 \u47084  \u49464 \u44592 \u47484  \u53685 \u54616 \u50668  \u48149 \u54644 \u47484  \u48155 \u44256  \u50517 \u48149 \u51012  \u48155 \u45716  \u49324 \u46988 \u46308 \u51032  \u54588 \u45212 \u52376 \u44032  \u46104 \u50632 \u45796 . \u50760 \u45940 \u49828 \u51064 \u46308 \u51008  \u44144 \u44592 \u49436  \u51008 \u49888 \u52376 \u47484  \u50619 \u50632 \u45796 . \u51060 \u44275 \u50640 \u49436  \u51473 \u49464 \u44592 \u51032  \u50516 \u55121 \u51012  \u46763 \u44256  \u51652 \u47532 \u51032  \u54915 \u48520 \u51060  \u44228 \u49549 \u54616 \u50668  \u53440 \u50732 \u46992 \u45796 . \u51060 \u44275 \u50640 \u49436  \u52380 \u50668  \u45380  \u46041 \u50504  \u51652 \u47532 \u51032  \u51613 \u51064 \u46308 \u51008  \u50715 \u51201 \u48512 \u53552  \u47932 \u47140 \u48155 \u51008  \u48127 \u51020 \u51012  \u51648 \u53020 \u50772 \u45796 .\
\uc0\u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u48177 \u49457 \u46308 \u50640 \u44172  \u50948 \u53441 \u54616 \u49888  \u50948 \u45824 \u54620  \u51652 \u47532 \u50640  \u44152 \u47582 \u51008  \u51109 \u50628 \u54620  \u54620  \u49457 \u49548 \u47484  \u47560 \u47144 \u54644  \u51452 \u49512 \u45796 . \u44536  \u49888 \u49892 \u54620  \u50976 \u46993 \u51064 \u46308 \u50640 \u44172 \u45716  \u49328 \u46308 \u51060  \u50668 \u54840 \u50752 \u51032  \u48320 \u54616 \u51648  \u50500 \u45768 \u54616 \u45716  \u51032 \u50640  \u45824 \u54620  \u54364 \u49345 \u51060  \u46104 \u50632 \u45796 . \u44536 \u46308 \u51008  \u44536 \u46308  \u47672 \u47532  \u50948 \u50640  \u45458 \u51060  \u49567 \u50500  \u48520 \u48320 \u51032  \u50948 \u50628 \u51012  \u51648 \u45768 \u44256  \u51080 \u45716  \u49328 \u46308 \u51012  \u51088 \u45376 \u46308 \u50640 \u44172  \u44032 \u47532 \u53412 \u47732 \u49436  \u50616 \u51228 \u45208  \u48320 \u54632 \u46020  \u50630 \u44256  \u54924 \u51204 \u54616 \u45716  \u44536 \u47548 \u51088 \u46020  \u50630 \u51004 \u49888  \u54616 \u45208 \u45784 \u50640  \u45824 \u54616 \u50668  \u46608 \u45716  \u44536  \u47568 \u50432 \u51060  \u50689 \u44396 \u55176  \u49436  \u51080 \u45716  \u47719 \u48512 \u47532 \u52376 \u47100  \u50689 \u50896 \u54616 \u49888  \u51060 \u50640  \u45824 \u54616 \u50668  \u51060 \u50556 \u44592 \u54644  \u51452 \u50632 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u47784 \u46304  \u49328 \u46308 \u51012  \u51228 \u51088 \u47532 \u50640  \u49464 \u50864 \u49884 \u44256  \u50948 \u45824 \u54620  \u45733 \u47141 \u51004 \u47196  \u44536 \u44163 \u46308 \u51012  \u48537 \u46300 \u49512 \u45796 . \u47924 \u54620 \u54620  \u45733 \u47141  \u48150 \u50640 \u45716  \u50612 \u46500  \u55192 \u46020  \u45733 \u55176  \u44536 \u44163 \u46308 \u51012  \u44536  \u51088 \u47532 \u50640 \u49436  \u50734 \u44600  \u49688  \u50630 \u45796 . \u46609 \u44057 \u51008  \u48169 \u48277 \u51004 \u47196  \u44536 \u48516 \u44760 \u49436 \u45716  \u52380 \u51648 \u47484  \u53685 \u52824 \u54616 \u49884 \u45716  \u45936  \u51080 \u50612 \u49436  \u44592 \u52488 \u44032  \u46104 \u45716  \u45817 \u49888 \u51032  \u50984 \u48277 \u46020  \u44403 \u44172  \u49464 \u50864 \u49512 \u45796 . \u49324 \u46988 \u51032  \u55192 \u51008  \u49324 \u46988 \u46308  \u49324 \u51060 \u50640 \u49436  \u50689 \u54693 \u51012  \u48120 \u52824 \u44256  \u44536 \u46308 \u51032  \u49373 \u47749 \u51012  \u48764 \u50519 \u51012  \u49688 \u46020  \u51080 \u45796 . \u44536 \u47084 \u45208  \u49328 \u46308 \u51012  \u44536  \u49100 \u47532 \u51704  \u48977 \u50500 \u49436  \u48148 \u45796 \u50640  \u45912 \u51648 \u45716  \u51068 \u51008  \u49789 \u44172  \u54624  \u49688  \u50630 \u45796 . \u44536 \u50752  \u47560 \u52268 \u44032 \u51648 \u47196  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51008  \u51068 \u51216 \u51068 \u54925 \u51060 \u46972 \u46020  \u48320 \u54624  \u49688  \u50630 \u51004 \u47728  \u44536 \u48516 \u51032  \u46907 \u51012  \u54665 \u54616 \u45716  \u51088 \u46308 \u50640 \u44172  \u54616 \u49888  \u44536 \u48516 \u51032  \u54728 \u46973 \u51008  \u54616 \u45208 \u46020  \u54728 \u51648 \u47196  \u46028 \u50500 \u44032 \u51648  \u50506 \u45716 \u45796 . \u54616 \u45208 \u45784 \u51032  \u51333 \u46308 \u51008  \u44536 \u48516 \u51032  \u50984 \u48277 \u50640  \u49457 \u49892 \u54616 \u44592 \u47484  \u47560 \u52824  \u48320 \u54632 \u51060  \u50630 \u45716  \u49328 \u46308 \u44284  \u44057 \u51060  \u54869 \u44256 \u54644 \u50556  \u54620 \u45796 .\
\uc0\u44536 \u46308 \u51060  \u49324 \u45716  \u45230 \u51008  \u44264 \u51676 \u44592 \u47484  \u46160 \u47476 \u44256  \u51080 \u45716  \u49328 \u46308 \u51008  \u54616 \u45208 \u45784 \u51032  \u52285 \u51312 \u51032  \u45733 \u47141 \u44284  \u44536 \u48516 \u51032  \u48372 \u54840 \u50640  \u45824 \u54620  \u45130 \u51076 \u50630 \u45716  \u51613 \u44144 \u50688 \u45796 . \u44536  \u49692 \u47168 \u51088 \u46308 \u51008  \u50668 \u54840 \u50752 \u51032  \u51076 \u51116 \u50640  \u45824 \u54620  \u44536  \u47924 \u50616 \u51032  \u49345 \u51669 \u46308 \u51012  \u49324 \u46993 \u54616 \u44172  \u46104 \u50632 \u45796 . \u44536 \u46308 \u51008  \u44256 \u49373 \u49828 \u47084 \u50868  \u44536 \u46308 \u51032  \u50868 \u47749 \u50640  \u45824 \u54616 \u50668  \u48520 \u54217 \u54616 \u51648  \u50506 \u50520 \u44256 , \u44417 \u48317 \u54620  \u49328 \u51473 \u50640  \u50808 \u47196 \u51060  \u51080 \u51004 \u47732 \u49436 \u46020  \u44208 \u53076  \u50808 \u47213 \u51648  \u50506 \u50520 \u45796 . \u44536 \u46308 \u51008  \u49324 \u46988 \u46308 \u51032  \u48516 \u45432 \u50752  \u44053 \u54252 \u47484  \u54588 \u54624  \u49688  \u51080 \u45716  \u54620  \u54588 \u45212 \u52376 \u47484  \u51452 \u49888  \u54616 \u45208 \u45784 \u44760  \u44048 \u49324 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u54616 \u45208 \u45784 \u44760  \u51088 \u50976 \u47213 \u44172  \u44221 \u48176 \u54624  \u49688  \u51080 \u45716  \u44163 \u51012  \u44592 \u48848 \u54616 \u50688 \u45796 . \u46412 \u46412 \u47196  \u50896 \u49688 \u46308 \u51032  \u52628 \u44201 \u51012  \u48155 \u50520 \u51648 \u47564  \u54744 \u51456 \u54620  \u44536  \u49328 \u46308 \u51060  \u44204 \u44256 \u54620  \u49328 \u49457 \u51060  \u46104 \u50632 \u45796 . \u44536 \u46308 \u51008  \u45458 \u51008  \u51208 \u48317  \u50948 \u50640 \u49436  \u54616 \u45208 \u45784 \u51012  \u52268 \u50577 \u54616 \u45716  \u45432 \u47000 \u47484  \u48520 \u47104 \u51004 \u45208  \u47196 \u47560 \u51032  \u44400 \u45824 \u46308 \u51008  \u44536 \u46308 \u51032  \u44048 \u49324 \u51032  \u52268 \u48120 \u47484  \u52840 \u47925 \u49884 \u53420  \u49688  \u50630 \u50632 \u45796 .\
\uc0\u49692 \u44208 , \u45800 \u49692 , \u50676 \u49457 \u51060  \u44536 \u47532 \u49828 \u46020 \u47484  \u46384 \u47476 \u45716  \u51060  \u49324 \u46988 \u46308 \u51032  \u44221 \u44148 \u54620  \u49373 \u50528 \u50640  \u45208 \u53440 \u45228 \u45796 . \u44536 \u46308 \u51008  \u51652 \u47532 \u51032  \u50896 \u52825 \u51012  \u51665 \u51060 \u45208  \u53664 \u51648 \u45208  \u52828 \u44396 \u45208  \u52828 \u52377 \u51060 \u45208 , \u49900 \u51648 \u50612  \u51088 \u49888 \u51032  \u49373 \u47749 \u48372 \u45796  \u45908  \u44480 \u54616 \u44172  \u50668 \u44220 \u45796 . \u44536 \u49104 \u47564  \u50500 \u45768 \u46972  \u44536  \u50896 \u52825 \u46308 \u51012  \u51210 \u51008 \u51060 \u51032  \u47560 \u51020 \u50640  \u52384 \u51200 \u55176  \u49352 \u44200  \u51452 \u44592  \u50948 \u54616 \u50668  \u50676 \u49457 \u51012  \u45796 \u54616 \u50688 \u45796 . \u51210 \u51008 \u51060 \u46308 \u51008  \u50612 \u47540  \u46412 \u48512 \u53552  \u49457 \u44221 \u51004 \u47196  \u44368 \u54984 \u51012  \u48155 \u44256 , \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51032  \u47749 \u47161 \u51012  \u49888 \u49457 \u54616 \u44172  \u50668 \u44592 \u46020 \u47197  \u44368 \u50977 \u51012  \u48155 \u50520 \u45796 . \u45817 \u49884 \u50640 \u45716  \u49457 \u44221 \u51032  \u49324 \u48376 \u51060  \u47588 \u50864  \u44480 \u54616 \u50688 \u51004 \u48064 \u47196  \u44536 \u46308 \u51008  \u44536  \u44032 \u50868 \u45936  \u51080 \u45716  \u44480 \u51473 \u54620  \u47568 \u50432 \u46308 \u51012  \u50808 \u50864 \u46020 \u47197  \u46104 \u50612  \u51080 \u50632 \u45796 . \u44536 \u47532 \u54616 \u50668  \u47566 \u51008  \u49324 \u46988 \u46308 \u51060  \u49888 \u44396 \u50557  \u49457 \u44221 \u51032  \u50668 \u47084  \u44275 \u51012  \u48152 \u48373 \u54616 \u50668  \u50516 \u49569 \u54624  \u49688  \u51080 \u50632 \u45796 . \u54616 \u45208 \u45784 \u44760  \u45824 \u54620  \u44256 \u49345 \u54620  \u49373 \u44033 \u51008  \u52380 \u50672 \u44228 \u51032  \u50500 \u47492 \u45796 \u50868  \u44221 \u52824 \u50752  \u54632 \u44760  \u45800 \u49692 \u54616 \u44256 \u46020  \u52629 \u48373  \u48155 \u51008  \u44536 \u46308 \u51032  \u51068 \u49345 \u49373 \u54876 \u50640  \u44288 \u47144 \u46104 \u50612  \u51080 \u50632 \u45796 . \u50612 \u47536 \u50500 \u51060 \u46308 \u51008  \u50728 \u44054  \u51008 \u52509 \u44284  \u47784 \u46304  \u50504 \u50948 \u44032  \u45796  \u54616 \u45208 \u45784 \u44760 \u47196 \u48512 \u53552  \u50724 \u45716  \u44163 \u51076 \u51012  \u48127 \u44256  \u44048 \u49324 \u54616 \u45716  \u47560 \u51020 \u51004 \u47196  \u44536 \u48516 \u51012  \u48148 \u46972 \u48372 \u46020 \u47197  \u44032 \u47476 \u52840 \u51012  \u48155 \u50520 \u45796 .\
