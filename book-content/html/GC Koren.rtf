\f0\b \cf0 \uc0\u51208 \u48149 \u54620  \u50696 \u47336 \u49332 \u47128 \u51032  \u50868 \u47749 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u44536 \u48516 \u44760 \u49436 \u45716  \u49440 \u50640  \u45824 \u54616 \u50668  \u50501 \u51004 \u47196 , \u45817 \u49888 \u51032  \u49324 \u46993 \u50640  \u45824 \u54616 \u50668  \u48120 \u50880 \u51004 \u47196  \u48372 \u45813 \u51012  \u48155 \u51004 \u49512 \u51648 \u47564  \u45817 \u49888 \u51032  \u51088 \u48708 \u51032  \u49324 \u47749 \u51012  \u45003 \u45003 \u51060  \u54665 \u54616 \u49512 \u45796  (\u49884  109:5 \u52280 \u51312 ). \u44536 \u48516 \u44760  \u51008 \u54812 \u47484  \u44396 \u54620  \u49324 \u46988  \u51473 \u50640  \u44144 \u51208 \u51012  \u45817 \u54620  \u49324 \u46988 \u51008  \u54616 \u45208 \u46020  \u50630 \u50632 \u45796 . \u44536 \u48516 \u44760 \u49436 \u45716  \u51665  \u50630 \u45716  \u48169 \u46993 \u51088 \u47196 \u49436  \u48708 \u45212 \u51012  \u48155 \u44256  \u45216 \u47560 \u45796  \u44417 \u54605 \u54616 \u44172  \u49332 \u47732 \u49436 \u46020  \u44032 \u45212 \u54620  \u51088 \u46308 \u51012  \u50948 \u54616 \u50668  \u48393 \u49324 \u54616 \u44256  \u49324 \u46988 \u46308 \u51032  \u51116 \u45212 \u51012  \u45916 \u50612  \u51452 \u44256  \u44536 \u46308 \u47196  \u54616 \u50668 \u44552  \u49373 \u47749 \u51032  \u49440 \u47932 \u51012  \u48155 \u50500 \u46308 \u51060 \u44172  \u54616 \u49884 \u44256 \u51088  \u53444 \u50896 \u54616 \u45716  \u49373 \u50528 \u47484  \u49324 \u49512 \u45796 . \u50756 \u44256 \u54620  \u51088 \u51032  \u47560 \u51020 \u51032  \u48317 \u50640  \u48512 \u46378 \u54784  \u51008 \u54812 \u51032  \u47932 \u44208 \u51060  \u46104 \u46028 \u50500 \u50732 \u51648 \u46972 \u46020  \u54756 \u50500 \u47540  \u49688  \u50630 \u51060  \u44618 \u51008  \u49324 \u46993 \u51008  \u45796 \u49884  \u44557 \u55100 \u51032  \u51312 \u49688 \u44032  \u46104 \u50612  \u45908  \u55192  \u51080 \u44172  \u47792 \u47140 \u44032 \u45716  \u44163 \u51060 \u50632 \u45796 . \u44536 \u47084 \u45208  \u51060 \u49828 \u46972 \u50648 \u51008  \u44032 \u51109  \u51339 \u51008  \u48279 \u51060 \u50836 , \u51088 \u44592 \u46308 \u51012  \u46020 \u50752 \u51452 \u49892  \u49688  \u51080 \u45716  \u50976 \u51068 \u54616 \u49888  \u48516 \u51012  \u48260 \u47160 \u45796 . \u44536 \u48516 \u51032  \u49324 \u46993 \u51032  \u44036 \u52397 \u51008  \u47736 \u49884 \u45817 \u54616 \u44256 , \u44536 \u48516 \u51032  \u44428 \u44256 \u45716  \u48176 \u52377 \u45817 \u54616 \u44256 , \u44536 \u48516 \u51032  \u44221 \u44256 \u45716  \u51312 \u49548 \u47484  \u48155 \u50520 \u45796 .\
\uc0\u55148 \u47581 \u44284  \u49324 \u50976 \u51032  \u49884 \u44036 \u51008  \u49888 \u49549 \u55176  \u51648 \u45208 \u44032 \u44256  \u50724 \u47019 \u46041 \u50504  \u51648 \u52404 \u46104 \u50612  \u50728  \u54616 \u45208 \u45784 \u51032  \u51652 \u45432 \u51032  \u51092 \u51008  \u44144 \u51032  \u52284 \u45796 . \u48176 \u44368 \u50752  \u48152 \u50669 \u51032  \u44033  \u49884 \u45824 \u47484  \u53685 \u54616 \u50668  \u49939 \u50668  \u50728  \u51200 \u51452 \u51032  \u44160 \u51008  \u44396 \u47492 \u51008  \u54805 \u48268  \u48155 \u51012  \u48177 \u49457 \u50640 \u44172  \u48148 \u50556 \u55120 \u47196  \u45236 \u47140  \u45934 \u51060 \u47140  \u54616 \u44256  \u51080 \u50632 \u45796 . \u44536 \u47088 \u45936  \u51076 \u48149 \u54620  \u47736 \u47581 \u50640 \u49436  \u44536 \u46308 \u51012  \u44396 \u50896 \u54624  \u49688  \u51080 \u45716  \u50976 \u51068 \u54616 \u49888  \u44536 \u48516 \u51008  \u47736 \u49884 \u50752  \u47784 \u50837 \u44284  \u44144 \u51208 \u51012  \u45817 \u54616 \u49512 \u51004 \u47728 , \u50620 \u47560  \u50504  \u51080 \u50612  \u49901 \u51088 \u44032 \u50640  \u47803  \u48149 \u55192 \u51012  \u45817 \u54616 \u44172  \u46104 \u49892  \u44163 \u51060 \u50632 \u45796 . \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u49901 \u51088 \u44032 \u50640  \u45804 \u47532 \u49884 \u44172  \u46104 \u47732 , \u44536  \u46412 \u47196 \u48512 \u53552  \u54616 \u45208 \u45784 \u51032  \u51008 \u52509 \u44284  \u52629 \u48373  \u48155 \u45716  \u45208 \u46972 \u47196 \u49436 \u51032  \u51060 \u49828 \u46972 \u50648  \u49884 \u45824 \u45716  \u45149 \u45208 \u44172  \u46112  \u44163 \u51060 \u50632 \u45796 . \u45800  \u54620  \u49324 \u46988 \u51032  \u50689 \u54844 \u51068 \u51648 \u46972 \u46020  \u51075 \u50612 \u48260 \u47532 \u45716  \u44163 \u51008  \u50728  \u49464 \u44228 \u51032  \u51060 \u46301 \u44284  \u48372 \u54868 \u47484  \u51075 \u50612 \u48260 \u47532 \u45716  \u44163 \u48372 \u45796  \u45908  \u53360  \u48520 \u54665 \u51060 \u45796 . \u44536 \u47088 \u45936  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u50696 \u47336 \u49332 \u47128 \u51012  \u45236 \u47140 \u45796 \u48372 \u49892  \u46412  \u54620  \u46412  \u54616 \u45208 \u45784 \u51032  \u53469 \u54616 \u49888  \u44275 \u51060 \u50836 , \u53945 \u48324 \u54620  \u48372 \u48176 \u44032  \u46104 \u50632 \u45912  \u44536  \u49457 \u44284  \u44536  \u50728  \u48177 \u49457 \u51032  \u47736 \u47581 \u51060  \u44536 \u48516 \u51032  \u50526 \u50640  \u45208 \u53440 \u45208  \u48372 \u50688 \u45796 .\
\uc0\u49440 \u51648 \u51088 \u46308 \u51008  \u51060 \u49828 \u46972 \u50648 \u51032  \u48176 \u44368 \u50752  \u51396 \u47196  \u47568 \u48120 \u50516 \u50500  \u52488 \u47000 \u46108  \u47924 \u49436 \u50868  \u54028 \u47736  \u46412 \u47928 \u50640  \u50872 \u50632 \u45796 . \u50696 \u47112 \u48120 \u50556 \u45716  \u51088 \u44592  \u48177 \u49457 \u51032  \u46392 \u46308 \u51060  \u51453 \u51076 \u51012  \u45817 \u54616 \u44256  \u50668 \u54840 \u50752 \u51032  \u50577  \u47924 \u47532 \u44032  \u49324 \u47196 \u51105 \u55192 \u51012  \u51064 \u54616 \u50668  \u51452 \u50556 \u47196  \u50872 \u50632 \u51004 \u47728 , \u51088 \u44592 \u51032  \u45576 \u51060  \u45576 \u47932 \u51032  \u49368 \u51060  \u46104 \u44592 \u47484  \u50896 \u54616 \u50688 \u45796  (\u47128  9:1, 13:17 \u52280 \u51312 ). \u54616 \u47932 \u47728  \u50696 \u50616 \u51201  \u50504 \u47785 \u51004 \u47196  \u47751  \u45380 \u49104  \u50500 \u45768 \u46972  \u50668 \u47084  \u49464 \u44592 \u51032  \u48120 \u47000 \u47484  \u45236 \u45796 \u48372 \u49884 \u45716  \u51060 \u51032  \u49836 \u54548 \u51060  \u50612 \u46496 \u54616 \u50688 \u51004 \u47028 ! \u44536 \u48516 \u44760 \u49436 \u45716  \u47736 \u47581 \u49884 \u53412 \u45716  \u52380 \u49324 \u44032  \u44160 \u51012  \u46308 \u44256  \u52280 \u51004 \u47196  \u50724 \u47019 \u46041 \u50504  \u50668 \u54840 \u50752 \u51032  \u44144 \u52376 \u44032  \u46104 \u50632 \u45912  \u49457 \u51012  \u54693 \u54616 \u50668  \u49436  \u51080 \u45716  \u44163 \u51012  \u48372 \u49512 \u45796 . \u44048 \u46988 \u49328  \u50948 \u50640 \u49436 , \u44536 \u48516 \u44760 \u49436 \u45716  \u44048 \u46988 \u49328  \u44264 \u51676 \u44592  \u51200 \u54200 \u50640  \u51080 \u45716  \u49457 \u51204 \u44284  \u51452 \u46993  (\u26609 \u24266 ) \u46308 \u51060  \u54000 \u53804 \u49828  (Titus) \u50752  \u44536 \u51032  \u44400 \u45824 \u50640 \u44172  \u51216 \u47161 \u45817 \u54616 \u45716  \u44163 \u51012  \u48372 \u49512 \u44256 , \u44536  \u49457 \u48317 \u46308 \u51060  \u50808 \u44397 \u51032  \u44400 \u45824 \u50640 \u44172  \u54252 \u50948 \u45817 \u54616 \u45716  \u47924 \u49436 \u50868  \u44305 \u44221 \u51012  \u45576 \u47932  \u50612 \u47536  \u45576 \u51004 \u47196  \u45236 \u45796 \u48372 \u49512 \u45796 . \u44536 \u48516 \u44760 \u49436 \u45716  \u49912 \u50880 \u51012  \u50948 \u54616 \u50668  \u54665 \u51652 \u54616 \u45716  \u44400 \u45824 \u51032  \u48156 \u51088 \u44397  \u49548 \u47532 \u47484  \u46308 \u51004 \u49512 \u45796 . \u44536 \u48516 \u44760 \u49436 \u45716  \u54252 \u50948 \u45817 \u54620  \u49457  \u51473 \u50640 \u49436  \u50612 \u47672 \u45768 \u46308 \u44284  \u50500 \u51060 \u46308 \u51060  \u47673 \u51012  \u44163 \u51012  \u45804 \u46972 \u44256  \u48512 \u47476 \u51670 \u45716  \u49548 \u47532 \u47484  \u46308 \u51004 \u49512 \u45796 . \u44536 \u48516 \u44760 \u49436 \u45716  \u44536  \u50500 \u47492 \u45796 \u50868  \u49457 \u51204 \u44284  \u44417 \u51204 \u46308 \u44284  \u53457 \u46308 \u51060  \u48520 \u44867 \u50640  \u49912 \u51060 \u44256  \u54620  \u46412  \u44536 \u44163 \u46308 \u51060  \u49436  \u51080 \u45912  \u44536  \u51109 \u49548 \u50640 \u49436  \u47560 \u52840 \u45236  \u50672 \u44592  \u45208 \u45716  \u54224 \u54728 \u51032  \u47924 \u45908 \u44592 \u44032  \u46104 \u50612  \u48260 \u47532 \u45716  \u44163 \u51012  \u48372 \u49512 \u45796 .\
\uc0\u47676  \u51109 \u47000 \u47484  \u45236 \u45796 \u48372 \u49892  \u46412 , \u44536 \u48516 \u44760 \u49436 \u45716  \u50616 \u50557 \u51032  \u48177 \u49457 \u51060  \u44144 \u52832 \u44256  \u50424 \u50424 \u54620  \u48148 \u45815 \u44032 \u50640  \u44648 \u50612 \u51652  \u48176  \u51312 \u44033 \u46308 \u52376 \u47100  \u44033 \u51648 \u50640  \u55145 \u50612 \u51256  \u51080 \u45716  \u44305 \u44221 \u51012  \u48372 \u49512 \u45796 . \u44536 \u47532 \u44256  \u44536 \u46308 \u50640 \u44172  \u45236 \u47540  \u54788 \u49464 \u51032  \u48372 \u51025 \u51008 , \u44536 \u46308 \u51060  \u47560 \u51648 \u47561  \u49900 \u54032 \u51032  \u46412 \u50640  \u54620  \u48169 \u50872 \u46020  \u45224 \u44608 \u50630 \u51060  \u45796  \u47560 \u49492 \u50556  \u54624  \u51652 \u45432 \u51032  \u51092 \u50640  \u48708 \u44368 \u54616 \u47732  \u44200 \u50864  \u54620  \u47784 \u44552 \u50640  \u51648 \u45208 \u51648  \u50506 \u45716  \u44163 \u51076 \u51012  \u48372 \u49512 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44144 \u47337 \u54620  \u46041 \u51221 \u44284  \u50528 \u45139 \u45716  \u49324 \u46993 \u51008  \u46300 \u46356 \u50612  \u48708 \u53685 \u54620  \u50612 \u51312 \u44032  \u46104 \u50612  \u44536 \u48516 \u51032  \u51077 \u50640 \u49436  \u49352 \u50612 \u45208 \u50772 \u45796 . \'93\u50696 \u47336 \u49332 \u47128 \u50500  \u50696 \u47336 \u49332 \u47128 \u50500  \u49440 \u51648 \u51088 \u46308 \u51012  \u51453 \u51060 \u44256  \u45348 \u44172  \u54028 \u49569 \u46108  \u51088 \u46308 \u51012  \u46028 \u47196  \u52824 \u45716  \u51088 \u50668  \u50516 \u53449 \u51060  \u44536  \u49352 \u45180 \u47484  \u45216 \u44060  \u50500 \u47000  \u47784 \u51020 \u44057 \u51060  \u45236 \u44032  \u45348  \u51088 \u45376 \u47484  \u47784 \u51004 \u47140  \u54620  \u51068 \u51060  \u47751  \u48264 \u51060 \u45264  \u44536 \u47084 \u45208  \u45320 \u55148 \u44032  \u50896 \u52824  \u50500 \u45768 \u54616 \u50688 \u46020 \u45796 \'94 (\u47560  23:37). \u50724 , \u50612 \u46500  \u45208 \u46972 \u48372 \u45796  \u45908 \u50865  \u47566 \u51008  \u51008 \u54812 \u47484  \u48155 \u51008  \u45208 \u46972 \u50668 , \u45348 \u44032  \u44428 \u44256 \u54616 \u49884 \u45716  \u45216 \u44284  \u54217 \u54868 \u50640  \u44288 \u54620  \u51068 \u51012  \u50508 \u50520 \u45796 \u47732  \u45796 \u54665 \u51060 \u50632 \u51012  \u44163 \u51012 ! \u45208 \u45716  \u51032 \u51032  \u49324 \u51088 \u47196 \u49436  \u45320 \u55148  \u44032 \u50868 \u45936  \u47672 \u47932 \u47084  \u51080 \u50632 \u44256 , \u45320 \u55148 \u44032  \u54924 \u44060 \u54616 \u46020 \u47197  \u54840 \u49548 \u54616 \u50688 \u51648 \u47564  \u54728 \u49324 \u44032  \u46104 \u50632 \u44396 \u45208 . \u45320 \u55148 \u44032  \u44144 \u51208 \u54616 \u44256  \u48176 \u52377 \u54620  \u51060 \u45716  \u45800 \u49692 \u55176  \u51333 \u51060 \u45208  \u45824 \u47532 \u51088 \u45208  \u49440 \u51648 \u51088 \u44032  \u50500 \u45768 \u50836 , \u51652 \u49892 \u47196  \u51060 \u49828 \u46972 \u50648 \u51032  \u44144 \u47337 \u54620  \u48516 , \u44263  \u45320 \u55148 \u51032  \u44396 \u49549 \u51452  (\u25937 \u36118 \u20027 ) \u49884 \u45796 . \u47564 \u51068  \u45320 \u55148 \u44032  \u47736 \u47581 \u45817 \u54620 \u45796 \u47732 , \u44536  \u52293 \u51076 \u51008  \u45796 \u47564  \u45320 \u55148 \u50640 \u44172  \u51080 \u45796 . \'93\u45320 \u55148 \u44032  \u50689 \u49373 \u51012  \u50619 \u44592  \u50948 \u54616 \u50668  \u45236 \u44172  \u50724 \u44592 \u47484  \u50896 \u54616 \u51648  \u50500 \u45768 \u54616 \u45716 \u46020 \u45796 \'94 (\u50836  5:40).\
