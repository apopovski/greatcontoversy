\uc0\u54980 \u50640  \u54980 \u49828 \u51032  \u51208 \u52828 \u54620  \u52828 \u50864 \u44032  \u46108  \u54532 \u46972 \u54616  \u52636 \u49888 \u51032  \u51228 \u47212  (Jerome) \u51060  \u50689 \u44397 \u51004 \u47196 \u48512 \u53552  \u44480 \u44397 \u54616 \u47732 \u49436  \u50948 \u53364 \u47532 \u54532 \u51032  \u51200 \u49436 \u47484  \u44032 \u51648 \u44256  \u46028 \u50500 \u50772 \u45796 . \u50948 \u53364 \u47532 \u54532 \u51032  \u44032 \u47476 \u52840 \u51004 \u47196  \u44060 \u51333 \u54620  \u50689 \u44397  \u50773 \u54980 \u45716  \u50896 \u47000  \u48372 \u54756 \u48120 \u50500 \u51032  \u44277 \u51452 \u50688 \u51004 \u48064 \u47196 , \u44536 \u51032  \u44048 \u54868 \u47196  \u47568 \u48120 \u50516 \u50500  \u48372 \u54756 \u48120 \u50500 \u50640 \u45716  \u44060 \u54785 \u51088 \u51032  \u51200 \u49696 \u51060  \u45328 \u47532  \u50976 \u54252 \u46104 \u50632 \u45796 . \u54980 \u49828 \u45716  \u44536 \u47084 \u54620  \u51200 \u49696 \u46308 \u51012  \u55141 \u48120  \u51080 \u44172  \u51069 \u50632 \u45796 . \u44536 \u45716  \u44536  \u51200 \u51088 \u44032  \u51652 \u49892 \u54620  \u44536 \u47532 \u49828 \u46020 \u51064 \u51060 \u46972 \u44256  \u48127 \u50632 \u51004 \u47728  \u50948 \u53364 \u47532 \u54532 \u44032  \u51452 \u51109 \u54616 \u45716  \u44060 \u54785 \u51452 \u51032 \u50640  \u52268 \u46041 \u54616 \u44172  \u46104 \u50632 \u45796 . \u48708 \u47197  \u54980 \u49828  \u51088 \u49888 \u51008  \u44648 \u45803 \u51648  \u47803 \u54616 \u50688 \u51004 \u45208  \u51060 \u46412 \u50640  \u44536 \u45716  \u44536 \u47484  \u47196 \u47560 \u47196 \u48512 \u53552  \u47680 \u47532  \u46504 \u50612 \u51648 \u46020 \u47197  \u51064 \u46020 \u54624  \u44600 \u50640  \u46308 \u50612 \u49456 \u45912  \u44163 \u51060 \u45796 .\
\uc0\u44536  \u46412 \u50640  \u54532 \u46972 \u54616 \u50640  \u50689 \u44397 \u51004 \u47196 \u48512 \u53552  \u54617 \u49885  \u51080 \u45716  \u46160  \u49324 \u46988 \u51060  \u50772 \u45796 . \u44536 \u46308 \u51008  \u51652 \u47532 \u51032  \u48157 \u51008  \u48731 \u51012  \u48155 \u50520 \u45716 \u45936 , \u44536  \u51652 \u47532 \u47484  \u51204 \u54616 \u44592  \u50948 \u54616 \u50668  \u51060 \u47111 \u44172  \u47676  \u51648 \u48169 \u44620 \u51648  \u52286 \u50500 \u50772 \u45912  \u44163 \u51060 \u45796 . \u44536 \u46308 \u51008  \u52376 \u51020 \u48512 \u53552  \u48277 \u50773 \u51032  \u52572 \u49345 \u44428 \u51012  \u44277 \u44277 \u50672 \u54616 \u44172  \u44277 \u44201 \u54616 \u50688 \u51004 \u48064 \u47196  \u51593 \u49884  \u45817 \u44397 \u51004 \u47196 \u48512 \u53552  \u48156 \u50616 \u51012  \u44552 \u51648 \u45817 \u54664 \u45796 . \u44536 \u47084 \u45208  \u44536 \u46308 \u51008  \u52376 \u51020 \u51032  \u47785 \u51201 \u51012  \u48260 \u47540  \u49688  \u50630 \u50632 \u51004 \u48064 \u47196  \u54620  \u44032 \u51648 \u51032  \u44228 \u52293 \u51012  \u49464 \u50912 \u45796 . \u44536 \u46308 \u51008  \u48376 \u47000  \u49444 \u44368 \u51088 \u51064  \u46041 \u49884 \u50640  \u54868 \u44032 \u50688 \u51004 \u48064 \u47196  \u44536 \u46308 \u51032  \u44592 \u49696 \u51012  \u48156 \u55064 \u54616 \u44172  \u46104 \u50632 \u45796 . \u44536 \u46308 \u51008  \u50668 \u47084  \u49324 \u46988 \u46308 \u51060  \u48380  \u49688  \u51080 \u45716  \u44275 \u50640 \u49436  \u46160  \u51109 \u51032  \u44536 \u47548 \u51012  \u44536 \u47160 \u45796 . \u54616 \u45208 \u45716  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u50696 \u47336 \u49332 \u47128 \u51004 \u47196  \u51077 \u49457 \u54616 \u49884 \u45716  \u44305 \u44221 \u51060 \u50632 \u45716 \u45936 , \u44536 \u48516 \u44760 \u49436 \u45716  \'93\u44216 \u49552 \u54616 \u50668  \u45208 \u44480  \u44263  \u47693 \u50640  \u47700 \u45716  \u51664 \u49849 \u51032  \u49352 \u45180 \u47484 \'94 (\u47560  21:5) \u53440 \u49512 \u45796 . \u51228 \u51088 \u46308 \u51008  \u50668 \u54665 \u51004 \u47196  \u45908 \u47084 \u50892 \u51652  \u54732  \u50743 \u51012  \u51077 \u44256  \u47592 \u48156 \u47196  \u44536  \u46244 \u47484  \u46384 \u47476 \u44256  \u51080 \u50632 \u45796 . \u44536 \u47532 \u44256  \u45796 \u47480  \u54620  \u51109 \u51008  \u48277 \u50773 \u51032  \u54665 \u47148 \u51012  \u44536 \u47536  \u44163 \u51064 \u45936 , \u48277 \u50773 \u51008  \u54868 \u47140 \u54620  \u50743 \u51012  \u51077 \u44256  \u47672 \u47532 \u50640  \u49340 \u52789  \u47732 \u47448 \u44288 \u51012  \u50416 \u44256  \u50500 \u47492 \u45813 \u44172  \u51109 \u49885 \u54620  \u47568 \u51012  \u53440 \u44256  \u51080 \u51004 \u47728 , \u44536  \u50526 \u50640 \u45716  \u45208 \u54036 \u49688 \u46308 \u51060  \u44032 \u44256  \u51080 \u50632 \u44256 , \u46244 \u50640 \u45716  \u52628 \u44592 \u44221 \u46308 \u44284  \u51452 \u44368 \u46308 \u51060  \u46384 \u46972 \u44032 \u44256  \u51080 \u50632 \u45796 .\
\uc0\u44536 \u44163 \u51008  \u52280 \u51004 \u47196  \u47784 \u46304  \u44228 \u52789 \u51032  \u49324 \u46988 \u46308 \u51032  \u51452 \u47785 \u51012  \u45128  \u47924 \u50616 \u51032  \u49444 \u44368 \u50688 \u45796 . \u44400 \u51473 \u46308 \u51060  \u47792 \u47140 \u50752 \u49436  \u44536  \u46160  \u51109 \u51032  \u44536 \u47548 \u51012  \u51452 \u47785 \u54616 \u50668  \u48372 \u50520 \u45796 . \u44536  \u44536 \u47548 \u51032  \u46907 \u51012  \u50508 \u50500 \u48372 \u51648  \u47803 \u54616 \u45716  \u49324 \u46988 \u51008  \u50630 \u50632 \u45796 . \u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u51452 \u46104 \u49884 \u45716  \u44536 \u47532 \u49828 \u46020 \u51032  \u50728 \u50976 \u50752  \u44216 \u49552 , \u44536 \u47532 \u44256  \u44536 \u48516 \u51032  \u51333 \u51060 \u46972 \u44256  \u51088 \u52845 \u54616 \u45716  \u48277 \u50773 \u51032  \u51088 \u44256 \u50752  \u44368 \u47564  \u49324 \u51060 \u50640 \u45716  \u53360  \u52264 \u51060 \u44032  \u51080 \u45716  \u44163 \u51012  \u48372 \u44256  \u44618 \u51008  \u44048 \u46041 \u51012  \u48155 \u50520 \u45796 . \u54532 \u46972 \u54616 \u50640 \u45716  \u53360  \u46041 \u50836 \u44032  \u49373 \u44220 \u45796 . \u44536 \u47084 \u51088  \u44536  \u46160  \u49324 \u46988 \u51008  \u49888 \u48320 \u51032  \u50504 \u51204 \u51012  \u50948 \u54616 \u50668  \u50620 \u47560  \u54980 \u50640  \u44536  \u44275 \u51012  \u46496 \u45208 \u44052 \u45796 . \u44536 \u47084 \u45208  \u44536 \u46308 \u51060  \u44032 \u47476 \u52828  \u44368 \u54984 \u51008  \u51082 \u55176 \u51648  \u50506 \u50520 \u45796 . \u53945 \u48324 \u55176  \u44536  \u44536 \u47548 \u51008  \u54980 \u49828 \u51032  \u47560 \u51020 \u50640  \u52964 \u45796 \u46976  \u44048 \u46041 \u44284  \u51064 \u49345 \u51012  \u51452 \u50632 \u51004 \u48064 \u47196  \u44536 \u45716  \u49457 \u44221 \u44284  \u50948 \u53364 \u47532 \u54532 \u51032  \u51200 \u49436 \u47484  \u45908 \u50865  \u49464 \u48128 \u55176  \u50672 \u44396 \u54616 \u44172  \u46104 \u50632 \u45796 . \u44536 \u45716  \u50500 \u51649  \u50948 \u53364 \u47532 \u54532 \u51032  \u44060 \u54785 \u49444 \u51012  \u47784 \u46160  \u48155 \u50500 \u46308 \u51068  \u45800 \u44228 \u44620 \u51648 \u45716  \u51060 \u47476 \u51648  \u50506 \u50520 \u51648 \u47564  \u48277 \u50773 \u44368 \u51032  \u51652 \u49345 \u51012  \u45908 \u50865  \u48516 \u47749 \u54616 \u44172  \u44648 \u45803 \u44172  \u46104 \u50632 \u51004 \u48064 \u47196  \u53440 \u45716  \u46319 \u54620  \u50676 \u49457 \u51004 \u47196  \u44368 \u44428 \u51032  \u48512 \u54056 \u50752  \u44368 \u47564 \u44284  \u50556 \u49900 \u51012  \u44508 \u53444 \u54616 \u50688 \u45796 .\
