\'93\uc0\u47924 \u51200 \u44081 \u51004 \u47196 \u48512 \u53552  \u50732 \u46972 \u50724 \u45716  \u51664 \u49849 \'94\u51032  \u52280 \u46988 \u46108  \u44428 \u47141 \u51004 \u47196  \u47568 \u48120 \u50516 \u50500  \u49332 \u54644 \u46108  \u54616 \u45208 \u45784 \u51032  \u52649 \u49457 \u46108  \u46160  \u51613 \u51064 \u51008  \u50724 \u47019 \u46041 \u50504  \u51104 \u51104 \u54616 \u51648 \u45716  \u50506 \u51012  \u44163 \u51060 \u50632 \u45796 . \'93\u49340 \u51068  \u48152  \u54980 \u50640  \u54616 \u45208 \u45784 \u44760 \u47196 \u48512 \u53552  \u49373 \u44592 \u44032  \u51200 \u55148  \u49549 \u50640  \u46308 \u50612 \u44032 \u47588  \u51200 \u55148 \u44032  \u48156 \u47196  \u51068 \u50612 \u49436 \u45768  \u44396 \u44221 \u54616 \u45716  \u51088 \u46308 \u51060  \u53356 \u44172  \u46160 \u47140 \u50892 \u54616 \u45908 \u46972 \'94 (\u44228  11:11). \u44536 \u47532 \u49828 \u46020 \u44368 \u47484  \u54224 \u54616 \u50668  \u48260 \u47532 \u44256  \u49457 \u44221 \u51012  \u44552 \u51648 \u54620 \u45796 \u45716  \u48277 \u47161 \u51060  \u54532 \u46993 \u49828  \u44397 \u48124  \u51032 \u54924 \u47484  \u53685 \u44284 \u54620  \u44163 \u51008  1793\u45380 \u51060 \u50632 \u45796 . \u44536 \u47084 \u45208  3\u45380  \u48152 \u51060  \u51648 \u45212  \u54980  \u44536  \u44208 \u51032 \u47484  \u47924 \u54952 \u47196  \u47564 \u46308 \u44256  \u49457 \u44221 \u51012  \u50857 \u45225 \u54616 \u45716  \u51032 \u50504 \u51012  \u46041 \u51068 \u54620  \u44536  \u51032 \u54924 \u50640 \u49436  \u53685 \u44284 \u49884 \u53040 \u45796 . \u49464 \u44228 \u45716  \u49457 \u44221 \u51012  \u44144 \u51208 \u54620  \u44208 \u44284 \u47196  \u49373 \u44596  \u44032 \u51613 \u54620  \u48276 \u51396 \u50640  \u45824 \u54616 \u50668  \u45440 \u46972 \u50880 \u51012  \u44552 \u52824  \u47803 \u54616 \u50688 \u51004 \u47728 , \u49324 \u46988 \u46308 \u51008  \u45909 \u54665 \u44284  \u46020 \u45909 \u51032  \u44592 \u52488 \u47196 \u49436  \u54616 \u45208 \u45784 \u44284  \u44536 \u48516 \u51032  \u47568 \u50432 \u51012  \u48127 \u45716  \u44163 \u51060  \u52280 \u51004 \u47196  \u54596 \u50836 \u54620  \u51068 \u51076 \u51012  \u51064 \u51221 \u54616 \u50688 \u45796 . \u50668 \u54840 \u50752 \u44760 \u49436 \u45716  \'93\u45348 \u44032  \u55036 \u48169 \u54616 \u47728  \u45733 \u50837 \u54620  \u44163 \u51008  \u45572 \u44396 \u50640 \u44172 \u45264  \u45348 \u44032  \u49548 \u47532 \u47484  \u45458 \u51060 \u47728  \u45576 \u51012  \u45458 \u51060  \u46308 \u50612  \u54693 \u54620  \u44163 \u51008  \u45572 \u44396 \u50640 \u44172 \u45264  \u44263  \u51060 \u49828 \u46972 \u50648 \u51032  \u44144 \u47337 \u54620  \u51088 \u50640 \u44172 \u45768 \u46972 \'94 (\u49324  37:23). \'93\u51060 \u48264 \u50640  \u44536 \u46308 \u50640 \u44172  \u45236  \u49552 \u44284  \u45236  \u45733 \u51012  \u50508 \u47140 \u49436  \u44536 \u46308 \u47196  \u45236  \u51060 \u47492 \u51060  \u50668 \u54840 \u50752 \u51064  \u51460  \u50508 \u44172  \u54616 \u47532 \u46972 \'94 (\u47128  16:21) \u44256  \u47568 \u50432 \u54616 \u49512 \u45796 .\
\uc0\u44536  \u46160  \u51613 \u51064 \u50640  \u45824 \u54616 \u50668  \u49440 \u51648 \u51088 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u54620 \u45796 . \'93\u54616 \u45720 \u47196 \u48512 \u53552  \u53360  \u51020 \u49457 \u51060  \u51080 \u50612  \u51060 \u47532 \u47196  \u50732 \u46972 \u50724 \u46972  \u54632 \u51012  \u51200 \u55148 \u44032  \u46307 \u44256  \u44396 \u47492 \u51012  \u53440 \u44256  \u54616 \u45720 \u47196  \u50732 \u46972 \u44032 \u45768  \u51200 \u55148  \u50896 \u49688 \u46308 \u46020  \u44396 \u44221 \u54616 \u45908 \u46972 \'94 (\u44228  11:12). \u54532 \u46993 \u49828 \u44032  \u54616 \u45208 \u45784 \u51032  \u46160  \u51613 \u51064 \u50640  \u45824 \u54616 \u50668  \u46020 \u51204 \u54616 \u50688 \u51004 \u48064 \u47196 , \u44536  \u46160  \u51613 \u51064 \u51008  \u50724 \u55176 \u47140  \u51204 \u50640  \u50630 \u51060  \u45458 \u51076 \u51012  \u48155 \u50520 \u45796 . 1804\u45380 \u50640  \u50689 \u44397  \u49457 \u49436  \u44277 \u54924 \u44032  \u51312 \u51649 \u46104 \u50632 \u45796 . \u44536  \u54980 \u47196  \u50976 \u47101  \u45824 \u47449 \u50640  \u51060 \u50752  \u50976 \u49324 \u54620  \u51312 \u51649 \u52404 \u46308 \u44284  \u51648 \u48512 \u46308 \u51060  \u54805 \u49457 \u46104 \u50632 \u45796 . \u46608 \u54620  1816\u45380 \u50640 \u45716  \u48120 \u44397  \u49457 \u49436  \u44277 \u54924 \u44032  \u52285 \u49444 \u46104 \u50632 \u45796 . \u50689 \u44397  \u49457 \u49436  \u44277 \u54924 \u44032  \u52285 \u49444 \u46104 \u50632 \u51012  \u46412 \u50640  \u49457 \u44221 \u51008  50\u44060 \u51032  \u44397 \u50612 \u47196  \u51064 \u49604 \u46104 \u50612  \u48176 \u48512 \u46104 \u50632 \u45796 . \u44536  \u54980  \u49457 \u44221 \u51008  \u49688 \u48177  \u44032 \u51648 \u51032  \u50616 \u50612 \u50752  \u48169 \u50616 \u51004 \u47196  \u48264 \u50669 \u46104 \u50632 \u45796  (\u48512 \u47197  25 \u52280 \u51312 ).\
1792\uc0\u45380  \u51060 \u51204 \u51032  50\u45380 \u44036 \u51008  \u50808 \u44397  \u49440 \u44368  \u49324 \u50629 \u50640  \u45824 \u54616 \u50668  \u44144 \u51032  \u50976 \u51032 \u54616 \u51648  \u50506 \u50520 \u45796 . \u49352 \u47196 \u50868  \u49440 \u44368 \u54924 \u51032  \u51312 \u51649 \u51060  \u44144 \u51032  \u50630 \u50632 \u44256 , \u51060 \u48169  \u45208 \u46972 \u50640  \u44536 \u47532 \u49828 \u46020 \u44368 \u47484  \u51204 \u54028 \u54616 \u44592  \u50948 \u54616 \u50668  \u45432 \u47141 \u54620  \u44368 \u54924 \u46308 \u51008  \u49548 \u49688 \u50640  \u48520 \u44284 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  18\u49464 \u44592 \u51032  \u47568 \u50685 \u51060  \u46104 \u51088  \u44049 \u51089 \u49828 \u47088  \u48320 \u54868 \u44032  \u49373 \u44220 \u45796 . \u49324 \u46988 \u46308 \u51008  \u54633 \u47532 \u51452 \u51032 \u51032  \u44208 \u44284 \u50640  \u45824 \u54616 \u50668  \u48520 \u47564 \u51012  \u54408 \u44256  \u54616 \u45208 \u45784 \u51032  \u44228 \u49884 \u50752  \u52404 \u54744  \u51333 \u44368 \u51032  \u54596 \u50836 \u49457 \u51012  \u44648 \u45803 \u44172  \u46104 \u50632 \u45796 . \u44536  \u46412 \u48512 \u53552  \u50808 \u48169 \u49440 \u44368  \u49324 \u50629 \u51060  \u48708 \u49345 \u54620  \u48156 \u51204 \u51012  \u54616 \u50688 \u45796  (\u48512 \u47197  26 \u52280 \u51312 ).\
\uc0\u51064 \u49604  \u44592 \u49696 \u51032  \u48156 \u45804 \u51008  \u49457 \u44221 \u51012  \u48372 \u44553 \u49884 \u53412 \u45716  \u49324 \u50629 \u50640  \u54876 \u44592 \u47484  \u51452 \u50632 \u45796 . \u45796 \u47480  \u45208 \u46972 \u46308 \u44284 \u51032  \u44368 \u53685 \u49688 \u45800 \u51032  \u48156 \u45804 \u51008  \u50715 \u45216 \u48512 \u53552 \u51032  \u54200 \u44204 \u44284  \u49604 \u44397 \u51452 \u51032  (\u37782 \u22283 \u20027 \u32681 ) \u51032  \u45812 \u51012  \u54736 \u50612  \u48260 \u47160 \u45796 . \u44536 \u47532 \u44256  \u47196 \u47560 \u51032  \u48277 \u50773 \u51060  \u49464 \u49549 \u51201  \u44428 \u47141 \u51012  \u51075 \u50612 \u48260 \u47532 \u44172  \u46104 \u51088  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51060  \u46308 \u50612 \u44040  \u49688  \u51080 \u45716  \u47928 \u54840 \u44032  \u44060 \u48169 \u46104 \u50632 \u45796 . \u44536 \u47532 \u54616 \u50668  \u50668 \u47084  \u54644 \u50640  \u44152 \u52432 \u49436  \u47196 \u47560 \u51032  \u44144 \u47532 \u50640 \u49436 \u46020  \u50500 \u47924 \u47088  \u44396 \u49549 \u51012  \u48155 \u51648  \u50506 \u44256  \u49457 \u44221 \u51060  \u54032 \u47588 \u46104 \u50632 \u51004 \u47728 , \u50724 \u45720 \u45216 \u51008  \u49324 \u46988 \u51060  \u49332 \u44256  \u51080 \u45716  \u44275 \u50640 \u45716  \u50612 \u46356 \u46304 \u51648  \u49457 \u44221 \u51060  \u48372 \u44553 \u46104 \u44256  \u51080 \u45796 .\
