\uc0\u51060 \u49345 \u51008  \u49457 \u44221 \u51060  \u47568 \u54644  \u51452 \u45716  \u51648 \u49345 \u50640  \u51316 \u51116 \u54620  \u50976 \u51068 \u51032  \u49457 \u49548 \u51060 \u45796 . \u44536 \u44163 \u51012  \u48148 \u50872 \u51008  \u52395  \u50616 \u50557 \u51032  \u49457 \u49548 \u46972 \u44256  \u47568 \u54616 \u50688 \u45796 . \u44536 \u47084 \u47732  \u49352  \u50616 \u50557 \u51032  \u49457 \u49548 \u45716  \u50612 \u46496 \u54620  \u44163 \u51064 \u44032 ?\
\uc0\u51652 \u47532 \u47484  \u50672 \u44396 \u54616 \u45716  \u51088 \u46308 \u51060  \u55176 \u48652 \u47532 \u49436 \u47484  \u45796 \u49884  \u54196 \u48372 \u50520 \u51012  \u46412  \u44536 \u46308 \u51008  \u46168 \u51704  \u50616 \u50557  \u44263  \u49352  \u50616 \u50557 \u51032  \u49457 \u49548 \u44032  \u50516 \u49884 \u46104 \u50612  \u51080 \u45796 \u45716  \u44163 \u51012  \u48156 \u44204 \u54616 \u44172  \u46104 \u50632 \u45796 . \'93\u52395  \u50616 \u50557 \u50640 \u46020  \u49452 \u44592 \u45716  \u50696 \u48277 \u44284  \u49464 \u49345 \u50640  \u49549 \u54620  \u49457 \u49548 \u44032  \u51080 \u45908 \u46972 .\'94 \'93\u50640 \u46020 \'94\u46972 \u45716  \u47568 \u51012  \u50420  \u44163 \u51008  \u48148 \u50872 \u51060  \u51060  \u49457 \u49548 \u50640  \u45824 \u54616 \u50668  \u51060 \u48120  \u47568 \u54664 \u51020 \u51012  \u50516 \u49884 \u54644  \u51456 \u45796 . \u44536  \u51204 \u51109  (\u21069 \u31456 ) \u51008  \u45796 \u51020 \u44284  \u44057 \u51060  \u44592 \u47197 \u46104 \u50612  \u51080 \u45796 . \'93\u51060 \u51228  \u54616 \u45716  \u47568 \u51032  \u51473 \u50836 \u54620  \u44163 \u51008  \u51060 \u47084 \u54620  \u45824 \u51228 \u49324 \u51109 \u51060  \u50864 \u47532 \u50640 \u44172  \u51080 \u45716  \u44163 \u51060 \u46972  \u44536 \u44032  \u54616 \u45720 \u50640 \u49436  \u50948 \u50628 \u51032  \u48372 \u51340  \u50864 \u54200 \u50640  \u50505 \u51004 \u49512 \u51004 \u45768  \u49457 \u49548 \u50752  \u52280  \u51109 \u47561 \u50640  \u48512 \u47532 \u45716  \u51088 \u46972  \u51060  \u51109 \u47561 \u51008  \u51452 \u44760 \u49436  \u48288 \u54392 \u49888  \u44163 \u51060 \u50836  \u49324 \u46988 \u51060  \u54620  \u44163 \u51060  \u50500 \u45768 \u45768 \u46972 \'94 (\u55176  8:1, 2).\
\uc0\u50668 \u44592  \u49352  \u50616 \u50557 \u51032  \u49457 \u49548 \u44032  \u45208 \u53440 \u45208  \u51080 \u45796 . \u52395  \u50616 \u50557 \u51032  \u49457 \u49548 \u45716  \u49324 \u46988 \u51060  \u52824 \u44256  \u47784 \u49464 \u44032  \u49464 \u50868  \u44163 \u51060 \u50632 \u51004 \u45208  \u51060  \u49457 \u49548 \u45716  \u49324 \u46988 \u51060  \u52828  \u44163 \u51060  \u50500 \u45768 \u50836  \u54616 \u45208 \u45784 \u44760 \u49436  \u52824 \u49888  \u44163 \u51060 \u45796 . \u47676 \u51200  \u51080 \u45912  \u49457 \u49548 \u50640 \u49436 \u45716  \u51060  \u49464 \u49345 \u51032  \u51228 \u49324 \u51109 \u46308 \u51060  \u48393 \u49324 \u54616 \u50688 \u51004 \u45208  \u45208 \u51473  \u49457 \u49548 \u50640 \u49436 \u45716  \u54616 \u45208 \u45784 \u51032  \u50864 \u54200 \u50640  \u50505 \u51004 \u49888  \u50864 \u47532 \u51032  \u45824 \u51228 \u49324 \u51109  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u48393 \u49324 \u54616 \u44256  \u44228 \u49888 \u45796 . \u47676 \u51200  \u44163 \u51008  \u49464 \u49345 \u50640  \u51080 \u50632 \u44256 , \u45208 \u51473  \u44163 \u51008  \u54616 \u45720 \u50640  \u51080 \u45796 .\
\uc0\u45908 \u50865 \u51060  \u47784 \u49464 \u44032  \u49464 \u50868  \u51109 \u47561 \u51008  \u49885 \u50577  (\u24335 \u27171 ) \u51012  \u46384 \u46972  \u51648 \u51008  \u44163 \u51060 \u50632 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u47784 \u49464 \u50640 \u44172  \'93\u47924 \u47495  \u45236 \u44032  \u45348 \u44172  \u48372 \u51060 \u45716  \u45824 \u47196  \u51109 \u47561 \u51032  \u49885 \u50577 \u44284  \u44536  \u44592 \u44396 \u51032  \u49885 \u50577 \u51012  \u46384 \u46972  \u51648 \u51012 \u51648 \u45768 \u46972 \'94 (\u52636  25:9, 40) \u44256  \u51648 \u49884 \u54616 \u49512 \u45796 . \u44536 \u47532 \u44256  \u45796 \u49884  \'93\u45320 \u45716  \u49340 \u44032  \u51060  \u49328 \u50640 \u49436  \u45348 \u44172  \u48372 \u51064  \u49885 \u50577 \u45824 \u47196  \u54624 \u51648 \u45768 \u46972 \'94\u44256  \u47749 \u47161 \u54616 \u49512 \u45796 . \u48148 \u50872 \u51008  \u51060  \u51109 \u47561 \u51008  \u54788 \u51116 \u44620 \u51648 \u51032  \u48708 \u50976 \u45768  \u51060 \u50640  \u51032 \u51648 \u54616 \u50668  \u46300 \u47532 \u45716  \u50696 \u47932 \u44284  \u51228 \u49324 \u44032  \'93\u54616 \u45720 \u50640  \u51080 \u45716  \u44163 \u46308 \u51032  \u47784 \u54805 \'94\u51060 \u46972 . \'93\u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u52280  \u44163 \u51032  \u44536 \u47548 \u51088 \u51064  \u49552 \u51004 \u47196  \u47564 \u46304  \u49457 \u49548 \u50640  \u46308 \u50612 \u44032 \u51648  \u50500 \u45768 \u54616 \u49884 \u44256  \u50724 \u51649  \u52280  \u54616 \u45720 \u50640  \u46308 \u50612 \u44032 \u49324  \u51060 \u51228  \u50864 \u47532 \u47484  \u50948 \u54616 \u50668  \u54616 \u45208 \u45784  \u50526 \u50640  \u45208 \u53440 \u45208 \'94\u49888 \u45796 \u44256  \u54616 \u50688 \u45796 \'94 (\u55176  9:9, 23, 8:5, 9:24).\
