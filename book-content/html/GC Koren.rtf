\uc0\u50501 \u51064 \u46308 \u50640 \u44172  \u54616 \u45208 \u45784 \u51032  \u49900 \u54032 \u51012  \u48155 \u51648  \u50506 \u44256  \u50504 \u51204 \u54624  \u49688  \u51080 \u45796 \u45716  \u49373 \u44033 \u51012  \u51452 \u44256 \u51088  \u54616 \u45716  \u47924 \u49436 \u50868  \u44592 \u47564 \u50640  \u45824 \u54616 \u50668  \u49440 \u51648 \u51088  \u51060 \u49324 \u50556 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u54620 \u45796 . \'93\u50864 \u47532 \u45716  \u49324 \u47581 \u44284  \u50616 \u50557 \u54616 \u50688 \u44256  \u51020 \u48512 \u50752  \u47609 \u50557 \u54616 \u50688 \u51008 \u51593  \u45336 \u52824 \u45716  \u51116 \u50521 \u51060  \u50976 \u54665 \u54624 \u51648 \u46972 \u46020  \u50864 \u47532 \u50640 \u44172  \u48120 \u52824 \u51648  \u47803 \u54616 \u47532 \u45768  \u50864 \u47532 \u45716  \u44144 \u51667 \u51004 \u47196  \u50864 \u47532  \u54588 \u45212 \u52376 \u47484  \u49340 \u50520 \u44256  \u54728 \u50948  \u50500 \u47000  \u50864 \u47532 \u47484  \u49704 \u44220 \u51020 \u51060 \u46972 \'94 (\u49324  28:15). \u50668 \u44592 \u50640  \u47896 \u49324 \u46108  \u48512 \u47448 \u51032  \u49324 \u46988 \u46308  \u44032 \u50868 \u45936 \u45716  \u50756 \u44256 \u54616 \u44256  \u54924 \u44060 \u54616 \u51648  \u50500 \u45768 \u54632 \u51004 \u47196 \u50024  \u51396 \u51064 \u50640 \u44172  \u54805 \u48268 \u51060  \u50630 \u51004 \u47728  \u49324 \u46988 \u51060  \u50500 \u47924 \u47532  \u53440 \u46973 \u54624 \u51648 \u46972 \u46020  \u47784 \u46160  \u52380 \u44397 \u50640  \u44032 \u49436  \u54616 \u45208 \u45784 \u51032  \u52380 \u49324 \u46308 \u44284  \u44057 \u51060  \u46108 \u45796 \u44256  \u49828 \u49828 \u47196 \u47484  \u50948 \u47196 \u54616 \u45716  \u49324 \u46988 \u46308 \u46020  \u54252 \u54632 \u46104 \u50612  \u51080 \u45796 . \u53945 \u48324 \u55176  \u49324 \u47581 \u44284  \u50616 \u50557 \u54616 \u50688 \u44256  \u51020 \u48512 \u50752  \u47609 \u50557 \u54620  \u51088 \u46972 \u45716  \u47568 \