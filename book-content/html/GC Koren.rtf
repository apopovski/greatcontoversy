\uc0\u47784 \u46304  \u49324 \u46988 \u46308 \u51008  \u44536 \u46308 \u51060  \u47924 \u45924 \u51004 \u47196  \u46308 \u50612 \u44040  \u46412 \u50752  \u46609 \u44057 \u51008  \u53412 \u47196  \u45208 \u50728 \u45796 . \u48512 \u54876 \u54620  \u47924 \u47532  \u44032 \u50868 \u45936  \u49440  \u50500 \u45812 \u51008  \u53412 \u44032  \u53356 \u44256  \u50948 \u50628  \u51080 \u45716  \u47784 \u49845 \u51012  \u51648 \u45768 \u44256  \u51080 \u51648 \u47564  \u54616 \u45208 \u45784 \u51032  \u50500 \u46308 \u48372 \u45796 \u45716  \u51312 \u44552  \u53412 \u44032  \u51089 \u45796 . \u50500 \u45812 \u44284  \u44536  \u54980 \u49464 \u51032  \u48177 \u49457 \u46308 \u51012  \u48708 \u44368 \u54644  \u48372 \u47732  \u54788 \u51200 \u54620  \u52264 \u51060 \u44032  \u45208 \u53440 \u45212 \u45796 . \u44536  \u54620  \u44032 \u51648  \u51216 \u51004 \u47196 \u46020  \u51064 \u47448 \u44032  \u53356 \u44172  \u53748 \u54868  (\u36864 \u21270 ) \u46108  \u44163 \u51012  \u50508  \u49688  \u51080 \u45796 . \u44536 \u47084 \u45208  \u47784 \u46304  \u49324 \u46988 \u51008  \u45796  \u50689 \u50896 \u54620  \u54876 \u47141 \u44284  \u50896 \u44592 \u47484  \u49548 \u50976 \u54616 \u44256  \u48512 \u54876 \u54620 \u45796 . \u49324 \u46988 \u51008  \u53468 \u52488 \u50640  \u54408 \u49457 \u49104 \u47564  \u50500 \u45768 \u46972  \u50857 \u47784 \u50752  \u51088 \u49464 \u50640  \u51080 \u50612 \u49436 \u46020  \u54616 \u45208 \u45784 \u51032  \u54805 \u49345 \u45824 \u47196  \u52285 \u51312 \u46104 \u50632 \u45796 . \u44536 \u47084 \u45208  \u51396 \u45716  \u54616 \u45208 \u45784 \u51032  \u54805 \u49345 \u51012  \u49552 \u49345 \u49884 \u53412 \u44256  \u44144 \u51032  \u51648 \u50892  \u48260 \u47160 \u45796 . \u44536 \u47084 \u48064 \u47196  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u51075 \u50612 \u48260 \u47536  \u44163 \u51012  \u54924 \u48373 \u54616 \u44592  \u50948 \u54616 \u50668  \u50724 \u49512 \u45796 . \u51452 \u45784 \u44760 \u49436 \u45716  \u50864 \u47532 \u51032  \u52380 \u54620  \u47800 \u51012  \u48320 \u54868 \u49884 \u53020  \u51452 \u45784 \u51032  \u50689 \u44305 \u49828 \u47088  \u47800 \u44284  \u44057 \u51060  \u47564 \u46308 \u50612  \u51452 \u49892  \u44163 \u51060 \u45796 . \u54620  \u46412  \u51396 \u47196  \u45908 \u47084 \u50892 \u51256 \u49436  \u50500 \u47492 \u45796 \u50868  \u47784 \u49845 \u51012  \u51075 \u50612 \u48260 \u47532 \u44256  \u51453 \u51012  \u49688 \u48150 \u50640  \u50630 \u51060  \u46104 \u50632 \u45912  \u50025 \u51012  \u47800 \u51060  \u50756 \u51204 \u54616 \u44256 , \u50500 \u47492 \u45813 \u44256 , \u51453 \u51648  \u50500 \u45768 \u54624  \u47800 \u51004 \u47196  \u48320 \u54620 \u45796 . \u47784 \u46304  \u55136 \u44284  \u44208 \u54632 \u51008  \u47924 \u45924  \u49549 \u50640  \u48260 \u47140 \u51652 \u45796 . \u50724 \u47019 \u46041 \u50504  \u51075 \u50612 \u48260 \u47160 \u45912  \u50640 \u45940 \u51032  \u49373 \u47749 \u45208 \u47924 \u47196  \u45208 \u50500 \u44032 \u45716  \u44600 \u51008  \u54924 \u48373 \u46104 \u44256  \u44396 \u49549 \u48155 \u51008  \u51088 \u46308 \u51008  \u52376 \u51020  \u50689 \u44305 \u51473 \u50640  \u51080 \u51012  \u45817 \u49884 \u51032  \u51064 \u47448 \u51032  \u50756 \u51204 \u54620  \u53412 \u47564 \u53372  \'93\u51088 \u46972 \u45212 \u45796 \'94 (\u47568  4:2 \u55136 \u51221 \u50669  \u50689 \u50612  \u49457 \u44221 ). \u47560 \u51648 \u47561 \u44620 \u51648  \u45224 \u50500  \u51080 \u45912  \u51200 \u51452 \u48155 \u51008  \u51396 \u51032  \u55124 \u51201 \u51008  \u49324 \u46972 \u51648 \u44256 , \u44536 \u47532 \u49828 \u46020 \u51032  \u52649 \u49457 \u46108  \u48177 \u49457 \u46308 \u51008  \'93\u51452  \u50864 \u47532  \u54616 \u45208 \u45784 \u51032  \u50500 \u47492 \u45796 \u50880 \'94\u51012  \u45208 \u53440 \u45236 \u44256 , \u51221 \u49888 \u44284  \u50977 \u52404 \u50640  \u51452 \u45784 \u51032  \u50756 \u51204 \u54620  \u54805 \u49345 \u51012  \u48152 \u49324 \u54624  \u44163 \u51060 \u45796 . \