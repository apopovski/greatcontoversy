\uc0\u44536 \u47532 \u49828 \u46020 \u51032  \u49901 \u51088 \u44032 \u45716  \u50689 \u50896 \u53664 \u47197  \u44396 \u49549 \u48155 \u51008  \u51088 \u46308 \u51032  \u50672 \u44396 \u50752  \u52268 \u50577 \u51032  \u45824 \u49345 \u51060  \u46112  \u44163 \u51060 \u45796 . \u44536 \u46308 \u51008  \u50689 \u44305 \u51012  \u51077 \u51004 \u49888  \u44536 \u47532 \u49828 \u46020 \u47484  \u53685 \u54616 \u50668  \u49901 \u51088 \u44032 \u50640  \u45804 \u47532 \u49888  \u44536 \u47532 \u49828 \u46020 \u47484  \u48380  \u44163 \u51060 \u45796 . \u44305 \u45824 \u54620  \u50864 \u51452 \u51032  \u47924 \u49688 \u54620  \u49464 \u44228 \u46308 \u51012  \u52285 \u51312 \u54616 \u49884 \u44256  \u50976 \u51648 \u54616 \u49884 \u45716  \u44536 \u48516 , \u44536 \u47353 \u44284  \u50689 \u44305 \u51032  \u49828 \u46989 \u46308 \u51060  \u51600 \u44200  \u44221 \u48176 \u54616 \u45716  \u49324 \u46993 \u48155 \u45716  \u54616 \u45208 \u45784 \u51032  \u50500 \u46308 , \u54616 \u45720 \u51032  \u50773 \u44760 \u49436  \u53440 \u46973 \u54620  \u51064 \u47448 \u47484  \u44396 \u50896 \u54616 \u49884 \u44256 \u51088  \u51088 \u49888 \u51012  \u45230 \u52628 \u49884 \u44256  \u51396 \u51032  \u52824 \u50837 \u44284  \u49836 \u54548 \u51012  \u51648 \u49884 \u44256  \u50500 \u48260 \u51648 \u51032  \u50620 \u44404 \u50640 \u49436  \u49704 \u44200 \u51652  \u52292  \u47560 \u52840 \u45236  \u51075 \u50612 \u48260 \u47536  \u49464 \u49345 \u51032  \u51396  \u46412 \u47928 \u50640  \u44040 \u48148 \u47532 \u51032  \u49901 \u51088 \u44032  \u50948 \u50640 \u49436  \u45817 \u49888 \u51032  \u49900 \u51109 \u51060  \u53552 \u51648 \u44256  \u49373 \u47749 \u51060  \u46496 \u45208 \u44036  \u49324 \u49892 \u51008  \u44208 \u53076  \u51082 \u54784 \u51648 \u51648  \u50506 \u51012  \u44163 \u51060 \u45796 . \u50728  \u50864 \u51452 \u51032  \u52285 \u51312 \u51088 \u49884 \u47728  \u47784 \u46304  \u50868 \u47749 \u51032  \u44208 \u51221 \u51088 \u44760 \u49436  \u51064 \u47448 \u47484  \u50948 \u54620  \u49324 \u46993  \u46412 \u47928 \u50640  \u45817 \u49888 \u51032  \u50689 \u44305 \u51012  \u48260 \u47532 \u49884 \u44256  \u49828 \u49828 \u47196 \u47484  \u45230 \u52628 \u49512 \u45796 \u45716  \u44163 \u51008  \u50689 \u50896 \u55176  \u50864 \u51452 \u51032  \u44221 \u51060 \u50752  \u51316 \u44221 \u51012  \u51088 \u50500 \u45244  \u44163 \u51060 \u45796 . \u44396 \u50896 \u51012  \u48155 \u51008  \u47784 \u46304  \u48124 \u51313 \u46308 \u51060  \u44536 \u46308 \u51032  \u44396 \u51452 \u47484  \u52432 \u45796 \u48372 \u44256  \u44536 \u48516 \u51032  \u50620 \u44404 \u50640 \u49436  \u50500 \u48260 \u51648  \u54616 \u45208 \u45784 \u51032  \u50689 \u50896 \u54620  \u50689 \u44305 \u51060  \u48731 \u45208 \u44256  \u51080 \u45716  \u44163 \u51012  \u48380  \u46412 , \u46608 \u54620  \u44536 \u46308 \u51060  \u50689 \u50896 \u48512 \u53552  \u50689 \u50896 \u44620 \u51648  \u51316 \u49549 \u54616 \u45716  \u44536 \u48516 \u51032  \u48372 \u51340 \u47484  \u48372 \u44256 , \u44536 \u48516 \u51032  \u45208 \u46972 \u44032  \u45149 \u51060  \u50630 \u51012  \u44163 \u51012  \u50508 \u44172  \u46112  \u46412  \u44536 \u46308 \u51008  \u54872 \u55148 \u50640  \u49324 \u47196 \u51105 \u54784  \u45432 \u47000 \u47484  \u48512 \u47484  \u44163 \u51060 \u45796 . \'93\u50864 \u47532 \u47484  \u44536  \u44480 \u54616 \u49888  \u48372 \u54792 \u47196  \u54616 \u45208 \u45784 \u44760  \u44396 \u49549 \u54616 \u49884 \u44256 \u51088  \u51453 \u51076 \u51012  \u45817 \u54616 \u49888  \u50612 \u47536 \u50577 \u51060  \u50689 \u44305 \u44284  \u52268 \u49569 \u51012  \u48155 \u51004 \u49884 \u44592 \u50640  \u54633 \u45817 \u54616 \u46020 \u45796 .\'94\
\uc0\u49901 \u51088 \u44032 \u51032  \u50724 \u47896 \u45716  \u47784 \u46304  \u45796 \u47480  \u50724 \u47896 \u46308 \u51012  \u49444 \u47749 \u54644  \u51456 \u45796 . \u50864 \u47532 \u47484  \u46160 \u47140 \u50880 \u44284  \u44221 \u51060 \u44048 \u51004 \u47196  \u52649 \u47564 \u54616 \u44172  \u54644 \u51452 \u45716  \u54616 \u45208 \u45784 \u51032  \u49549 \u49457 \u51008  \u44040 \u48148 \u47532 \u50640 \u49436  \u55128 \u47084 \u45208 \u50724 \u45716  \u48731 \u51012  \u53685 \u54616 \u50668  \u50500 \u47492 \u45813 \u44256  \u47588 \u47141  \u51080 \u44172  \u45208 \u53440 \u45212 \u45796 . \u49457 \u44208 \u44284  \u44277 \u51032 \u50752  \u44428 \u45733 \u51060  \u51088 \u48708 \u50752  \u50728 \u50976 \u50752  \u48512 \u47784 \u50752  \u44057 \u51008  \u49324 \u46993 \u50640  \u54844 \u54633 \u46104 \u50612  \u45208 \u53440 \u45212 \u45796 . \u50864 \u47532 \u45716  \u45458 \u44256 , \u46608 \u54620  \u45458 \u51060  \u46308 \u47536  \u54616 \u45208 \u45784 \u51032  \u48372 \u51340 \u51032  \u50948 \u50628 \u51012  \u48380  \u46412 , \u51008 \u54812 \u47213 \u44172  \u45208 \u53440 \u45212  \u44536 \u48516 \u51032  \u54408 \u49457 \u51012  \u48372 \u44256 , \'93\u50864 \u47532  \u50500 \u48260 \u51648 \'94\u46972 \u45716  \u49324 \u46993 \u49828 \u47088  \u44536  \u52845 \u54840 \u51032  \u51652 \u51221 \u54620  \u51032 \u48120 \u47484  \u51060 \u51204  \u50612 \u45712  \u46412 \u48372 \u45796  \u49352 \u47213 \u44172  \u51060 \u54644 \u54616 \u44172  \u46108 \u45796 .\
