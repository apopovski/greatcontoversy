\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u48373 \u51020 \u51060  \u48372 \u54756 \u48120 \u50500 \u50640  \u51204 \u54028 \u46104 \u44592 \u45716  \u51060 \u48120  9\u49464 \u44592 \u51032  \u51068 \u51060 \u50632 \u45796 . \u49457 \u44221 \u51060  \u48264 \u50669 \u46104 \u44256  \u48177 \u49457 \u46308 \u51008  \u51088 \u44397 \u50612 \u47196  \u50696 \u48176 \u47484  \u46300 \u47532 \u44172  \u46104 \u50632 \u45796 . \u44536 \u47084 \u45208  \u48277 \u50773 \u44428 \u51032  \u49464 \u47141 \u51060  \u54869 \u51109 \u46120 \u50640  \u46384 \u46972  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51008  \u44032 \u47532 \u50892 \u51276 \u45796 . \u54217 \u49548 \u50640  \u50773 \u46308 \u51032  \u44428 \u49464 \u47484  \u44734 \u50612  \u48260 \u47540  \u49104  \u50500 \u45768 \u46972  \u48177 \u49457 \u46308 \u51012  \u45432 \u50696 \u51032  \u49345 \u53468 \u47196  \u47564 \u46308 \u44256 \u51088  \u44928 \u54644  \u50724 \u45912  \u44536 \u47112 \u44256 \u47532 \u50864 \u49828  7\u49464 \u45716  \u50696 \u50808  \u50630 \u51060  \u48372 \u54756 \u48120 \u50500 \u50612 \u47196  \u44277 \u51473  \u50696 \u48176 \u47484  \u46300 \u47532 \u51648  \u47803 \u54616 \u46020 \u47197  \u44552 \u51648 \u54616 \u45716  \u44368 \u49436 \u47484  \u45236 \u47160 \u45796 . \'93\u51204 \u45733 \u54616 \u49888  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u50508 \u50500 \u46307 \u51648  \u47803 \u54616 \u45716  \u48169 \u50616 \u51004 \u47196  \u50696 \u48176 \u47484  \u46300 \u47532 \u44592 \u47484  \u50896 \u54616 \u49888 \u45796 . \u51060  \u48277 \u52825 \u51012  \u46384 \u47476 \u51648  \u50506 \u44592  \u46412 \u47928 \u50640  \u47566 \u51008  \u50501 \u44284  \u51060 \u45800 \u51060  \u49373 \u44592 \u44172  \u46104 \u50632 \u45796 \'94 (Wylie, b.3, ch.1) \u44256  \u48277 \u50773 \u51008  \u49440 \u50616 \u54616 \u50688 \u45796 . \u44536 \u50752  \u44057 \u51060  \u47196 \u47560 \u45716  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51032  \u48731 \u51012  \u44732 \u48260 \u47532 \u44256  \u48177 \u49457 \u46308 \u51012  \u50516 \u55121  \u44032 \u50868 \u45936  \u44032 \u46160 \u50612  \u46160 \u46020 \u47197  \u47749 \u47161 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u45796 \u47480  \u44592 \u44396 \u47484  \u53685 \u54616 \u50668  \u44368 \u54924 \u47484  \u48372 \u51316 \u54616 \u49884 \u44256 \u51088  \u44228 \u54925 \u54616 \u49512 \u45796 . \u54532 \u46993 \u49828 \u50752  \u51060 \u53448 \u47532 \u50500 \u50640 \u49436  \u48149 \u54644 \u47484  \u47564 \u45208  \u51923 \u44200 \u45212  \u47566 \u51008  \u50760 \u45940 \u49828 \u50752  \u50508 \u48708 \u51232 \u49828  (Albigenses) \u51064 \u46308 \u51060  \u48372 \u54756 \u48120 \u50500 \u47196  \u54588 \u45212 \u54616 \u50688 \u45796 . \u48708 \u47197  \u44536 \u46308 \u51008  \u44536  \u44275 \u50640 \u49436  \u44277 \u44277 \u50672 \u54616 \u44172  \u51204 \u46020 \u54616 \u51648  \u47803 \u54616 \u50688 \u51004 \u45208  \u51008 \u48128 \u54620  \u44032 \u50868 \u45936 \u49436  \u50676 \u49900 \u55176  \u54876 \u46041 \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u52280 \u46108  \u49888 \u50521 \u51060  \u50668 \u47084  \u49464 \u44592 \u47484  \u53685 \u54616 \u50668  \u48372 \u51316 \u46104 \u50612  \u50772 \u45796 .\
\uc0\u54980 \u49828 \u44032  \u53468 \u50612 \u45208 \u44592  \u51204 \u50640  \u48372 \u54756 \u48120 \u50500 \u50640 \u45716  \u51060 \u48120  \u44368 \u54924 \u51032  \u48512 \u54056 \u50752  \u48177 \u49457 \u46308 \u51032  \u48708 \u54665 \u51012  \u44277 \u44277 \u50672 \u54616 \u44172  \u44508 \u53444 \u54616 \u45716  \u49324 \u46988 \u46308 \u51060  \u51080 \u50632 \u45796 . \u44536 \u46308 \u51032  \u54876 \u46041 \u51008  \u47566 \u51008  \u49324 \u46988 \u46308 \u51032  \u51452 \u51032 \u50752  \u44288 \u49900 \u51012  \u45132 \u50632 \u45796 . \u44536 \u47084 \u48064 \u47196  \u49849 \u47140  \u44228 \u44553 \u51008  \u46160 \u47140 \u50880 \u51012  \u45712 \u45180 \u44256  \u48373 \u51020  \u49324 \u46020 \u46308 \u50640 \u44172  \u48149 \u54644 \u47484  \u44032 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u49714  \u49549 \u44284  \u49328 \u51004 \u47196  \u51923 \u44200  \u44032 \u49436  \u50696 \u48176 \u47484  \u46300 \u47532 \u44172  \u46104 \u50632 \u44256 , \u44400 \u49324 \u46308 \u51008  \u44536 \u46308 \u51012  \u52286 \u50500 \u45236 \u50612  \u47566 \u51008  \u49324 \u46988 \u46308 \u51012  \u49332 \u50977 \u54616 \u50688 \u45796 . \u50620 \u47560  \u54980 \u50640  \u47196 \u47560 \u44368 \u51032  \u50696 \u48176 \u50640 \u49436  \u48279 \u50612 \u45208 \u45716  \u51088 \u45716  \u54868 \u54805 \u50640  \u52376 \u54620 \u45796 \u45716  \u47749 \u47161 \u51060  \u45236 \u47160 \u45796 . \u44536 \u47084 \u45208  \u44536 \u47532 \u49828 \u46020 \u51064 \u46308 \u51008  \u49692 \u44368 \u47484  \u45817 \u54616 \u47732 \u49436 \u46020  \u44536 \u46308 \u51032  \u49324 \u50629 \u51032  \u49849 \u47532 \u47484  \u54869 \u49888 \u54616 \u44256  \u45576 \u51012  \u44048 \u50520 \u45796 . \u50724 \u51649  \u49901 \u51088 \u44032 \u50640  \u47803  \u48149 \u55176 \u49888  \u44396 \u51452 \u47484  \u48127 \u51020 \u51004 \u47196 \u50024 \u47564  \u44396 \u50896 \u51012  \u50619 \u45716 \u45796 \u45716  \u51652 \u47532 \u47484  \u44032 \u47476 \u52828  \u49324 \u46988 \u46308  \u51473 \u51032  \u54620  \u49324 \u46988 \u51008  \u45796 \u51020 \u44284  \u44057 \u51008  \u47568 \u51012  \u45224 \u44592 \u44256  \u51453 \u50632 \u45796 . \'93\u51652 \u47532 \u51032  \u50896 \u49688 \u51032  \u48516 \u45432 \u45716  \u50724 \u45720 \u45216  \u50864 \u47532 \u46308 \u51012  \u51060 \u44592 \u44256  \u51080 \u51648 \u47564  \u50689 \u50896 \u55176  \u44536 \u47111 \u51648 \u45716  \u50506 \u51012  \u44163 \u51060 \u45796 . \u51060 \u51228  \u54217 \u48124  \u44032 \u50868 \u45936 \u49436  \u54620  \u49324 \u46988 \u51060  \u44428 \u49464 \u50752  \u44160 \u51012  \u51536 \u51648  \u50506 \u44256  \u51068 \u50612 \u45216  \u44163 \u51064 \u45936 , \u44536 \u46308 \u51008  \u44536 \u47484  \u51060 \u44600  \u49688  \u50630 \u51012  \u44163 \u51060 \u45796 .\'94 (Wylie, b.3, ch.1) \u47336 \u53552 \u51032  \u49884 \u45824 \u45716  \u50500 \u51649  \u47676  \u48120 \u47000 \u50640  \u49549 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u51060 \u51228  \u47196 \u47560 \u47484  \u44277 \u44201 \u54616 \u45716  \u44536 \u51032  \u51613 \u50616 \u51004 \u47196  \u47784 \u46304  \u45208 \u46972 \u47484  \u51068 \u44648 \u50864 \u44172  \u54624  \u54620  \u49324 \u46988 \u51060  \u51068 \u50612 \u45208 \u45716  \u51473 \u50640  \u51080 \u50632 \u45796 .\
\uc0\u54980 \u49828 \u51032  \u50612 \u47536  \u49884 \u51208 \u48512 \u53552  \u45824 \u54617  \u52509 \u51109 \u51060  \u46104 \u44592 \u44620 \u51648  \u50560  \u54980 \u49828  (John Huss) \u45716  \u48708 \u52380 \u54620  \u44228 \u44553 \u50640 \u49436  \u53468 \u50612 \u45228 \u51004 \u47728 , \u50612 \u47160 \u51012  \u46412 \u50640  \u44536 \u51032  \u50500 \u48260 \u51648 \u47484  \u50668 \u51032 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44536 \u51032  \u44221 \u44148 \u54620  \u50612 \u47672 \u45768 \u45716  \u44368 \u50977 \u49884 \u53412 \u45716  \u44163 \u44284  \u54616 \u45208 \u45784 \u51012  \u44221 \u50808 \u54616 \u45716  \u44163 \u51060  \u44032 \u51109  \u44480 \u51473 \u54620  \u51116 \u49328 \u51060 \u46972 \u44256  \u49373 \u44033 \u54616 \u50688 \u51004 \u48064 \u47196  \u44536 \u47084 \u54620  \u50976 \u50629 \u51012  \u44536  \u51088 \u49885 \u50640 \u44172  \u45224 \u44200  \u51452 \u44256 \u51088  \u50528 \u47484  \u50044 \u45796 . \u54980 \u49828 \u45716  \u52376 \u51020 \u50640  \u49884 \u44264 \u50640  \u51080 \u45716  \u54617 \u44368 \u50640 \u49436  \u44277 \u48512 \u54616 \u50688 \u51004 \u45208  \u44536  \u54980 \u50640  \u54532 \u46972 \u54616  \u45824 \u54617 \u51032  \u51088 \u49440  \u51109 \u54617 \u44552 \u51004 \u47196  \u44277 \u48512 \u54616 \u46020 \u47197  \u54728 \u46973 \u51012  \u48155 \u50520 \u45796 . \u44536 \u45716  \u50612 \u47672 \u45768 \u50752  \u54632 \u44760  \u54532 \u46972 \u54616 \u47484  \u54693 \u54620  \u50668 \u47196 \u50640  \u50732 \u46992 \u45796 . \u44284 \u48512 \u47196 \u49436  \u44032 \u45212 \u50640  \u49884 \u45804 \u47532 \u45716  \u44536 \u51032  \u50612 \u47672 \u45768 \u45716  \u44536  \u50500 \u46308 \u50640 \u44172  \u51460  \u47564 \u54620  \u49464 \u49345  \u51116 \u47932 \u51060  \u50630 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u44536  \u53360  \u46020 \u49884 \u50640  \u44032 \u44620 \u51060  \u51060 \u47476 \u47104 \u51012  \u46412 \u50640  \u50500 \u48260 \u51648  \u50630 \u45716  \u51088 \u44592 \u51032  \u50500 \u46308  \u50526 \u50640 \u49436  \u47924 \u47502 \u51012  \u44999 \u44256  \u44536 \u47484  \u50948 \u54616 \u50668  \u54616 \u45720  \u50500 \u48260 \u51648 \u44760  \u48373 \u51012  \u48716 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44536  \u50612 \u47672 \u45768 \u45716  \u51088 \u44592 \u51032  \u44592 \u46020 \u44032  \u50612 \u46523 \u44172  \u51025 \u45813 \u46112  \u44163 \u51064 \u51648 \u50640  \u45824 \u54616 \u50668  \u44144 \u51032  \u44648 \u45803 \u51648  \u47803 \u54616 \u50688 \u45796 .\
\uc0\u45824 \u54617 \u50640 \u49436  \u44277 \u48512 \u54616 \u45716  \u46041 \u50504 , \u54980 \u49828 \u45716  \u48512 \u51648 \u47088 \u54620  \u44277 \u48512 \u50752  \u49888 \u49549 \u54620  \u54617 \u50629 \u51032  \u54693 \u49345 \u51004 \u47196  \u51060 \u47492 \u51012  \u46504 \u52452 \u51004 \u47728 , \u44536 \u51032  \u44648 \u45143 \u54620  \u49373 \u50528 \u50752  \u50728 \u50976 \u54616 \u44256  \u53132 \u54876 \u54620  \u49457 \u44201  \u46412 \u47928 \u50640  \u50668 \u47084  \u49324 \u46988 \u46308 \u51032  \u51316 \u44221 \u51012  \u48155 \u44172  \u46104 \u50632 \u45796 . \u44536 \u45716  \u46608 \u54620  \u47196 \u47560 \u44368 \u47484  \u50676 \u47148 \u55176  \u49888 \u48393 \u54616 \u45716  \u49324 \u46988 \u51060 \u50632 \u51004 \u48064 \u47196 , \u44368 \u54924 \u44032  \u49688 \u50668 \u54620 \u45796 \u44256  \u44277 \u50616 \u54616 \u45716  \u50689 \u51201  \u52629 \u48373 \u51012  \u47588 \u50864  \u44040 \u47581 \u54616 \u50688 \u45796 . \u44536 \u45716  \u50612 \u46500  \u53360  \u49457 \u54924 \u50640  \u52280 \u49437 \u54616 \u50688 \u51012  \u46412  \u52280 \u54924 \u54616 \u47084  \u45208 \u50500 \u44032  \u54840 \u51452 \u47672 \u45768  \u49549 \u50640  \u45224 \u50500  \u51080 \u45716  \u46024 \u51012  \u45796  \u53560 \u50612  \u48148 \u52824 \u44256  \u49324 \u47732  (\u36198 \u20813 ) \u51012  \u50619 \u44592  \u50948 \u54616 \u50668  \u54665 \u47148  \u44032 \u50868 \u45936  \u52280 \u47168 \u54620  \u51068 \u46020  \u51080 \u50632 \u45796 . \u45824 \u54617 \u51012  \u51320 \u50629 \u54616 \u51088  \u44536 \u45716  \u49888 \u48512 \u51032  \u51649 \u48516 \u51012  \u50619 \u50632 \u51004 \u47728 , \u44536  \u54980  \u49888 \u49549 \u55176  \u49849 \u51652 \u54616 \u50668  \u50773 \u49892  \u51204 \u49549 \u51032  \u49849 \u51221 \u51060  \u46104 \u50632 \u45796 . \u44536 \u47532 \u44256  \u44536 \u45716  \u47784 \u44368 \u51032  \u44368 \u49688 \u44032  \u46104 \u44256 , \u44536  \u54980 \u50640  \u44536  \u45824 \u54617 \u51032  \u52509 \u51109 \u44620 \u51648  \u46104 \u50632 \u45796 . \u44536 \u47532 \u54616 \u50668  \u48520 \u44284  \u49688 \u45380  \u47564 \u50640  \u44396 \u54840 \u44552 \u51032  \u51109 \u54617 \u44552 \u51012  \u48155 \u45912  \u48708 \u52380 \u54620  \u51068 \u44060  \u54617 \u49373 \u51060  \u48372 \u54756 \u48120 \u50500 \u51032  \u51088 \u46993 \u51060  \u46104 \u44256 , \u44536  \u47749 \u49457 \u51012  \u50728  \u44396 \u46972 \u54028 \u50640  \u46504 \u52824 \u44172  \u46104 \u50632 \u45796 .\
\uc0\u44536 \u47084 \u45208  \u44536 \u45716  \u45796 \u47480  \u54620  \u48516 \u50556 \u50640 \u49436  \u44060 \u54785  \u49324 \u50629 \u51012  \u52265 \u49688 \u54616 \u50688 \u45796 . \u49457 \u51649 \u50640  \u45208 \u44036  \u51648  \u49688 \u45380  \u54980 \u50640  \u44536 \u45716  \u48288 \u46308 \u47112 \u54772  \u54924 \u45817 \u51032  \u49444 \u44368 \u51088 \u47196  \u51076 \u47749 \u46104 \u50632 \u45796 . \u44536 \u47088 \u45936  \u44536  \u54924 \u45817 \u51032  \u49444 \u47549 \u51088 \u45716  \u49457 \u44221 \u51012  \u51088 \u44397 \u50612 \u47196  \u49444 \u44368 \u54616 \u45716  \u51068 \u51012  \u52280 \u51004 \u47196  \u51473 \u50836 \u54620  \u51068 \u47196  \u51452 \u51109 \u54616 \u45716  \u49324 \u46988 \u51060 \u50632 \u45796 . \u44536  \u51068 \u51008  \u47196 \u47560 \u50640 \u49436  \u48152 \u45824 \u54616 \u45716  \u51068 \u51060 \u50632 \u51004 \u45208  \u48372 \u54756 \u48120 \u50500 \u50640  \u51080 \u50612 \u49436 \u45716  \u50756 \u51204 \u55176  \u51473 \u51648 \u46104 \u51648 \u45716  \u50506 \u50520 \u45796 . \u44536  \u45817 \u49884 \u50640  \u49457 \u44221 \u50640  \u45824 \u54620  \u51068 \u48152  \u49324 \u46988 \u46308 \u51032  \u47924 \u51648 \u45716  \u49892 \u47196  \u52984 \u51004 \u47728 , \u47784 \u46304  \u44228 \u44553 \u51032  \u49324 \u46988 \u46308 \u50640 \u44172  \u44032 \u51109  \u50501 \u54620  \u51068 \u46308 \u51060  \u54200 \u47564 \u54644  \u51080 \u50632 \u45796 . \u54980 \u49828 \u45716  \u51060 \u47084 \u54620  \u51396 \u50501 \u46308 \u51012  \u44592 \u53444 \u50630 \u51060  \u44204 \u52293 \u54616 \u44256 , \u51088 \u44592 \u44032  \u49444 \u47749 \u54620  \u51652 \u47532 \u51032  \u50896 \u52825 \u44284  \u49692 \u44208 \u51012  \u50669 \u49444 \u54616 \u44592  \u50948 \u54616 \u50668  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51004 \u47196  \u44036 \u44257 \u55176  \u54840 \u49548 \u54616 \u50688 \u45796 .\
