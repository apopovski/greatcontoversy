\uc0\u44536 \u47532 \u49828 \u46020 \u51032  \u51116 \u47548 \u51012  \u49440 \u54252 \u54616 \u45716  \u51068 \u51012  \u51648 \u46020 \u54616 \u46020 \u47197  \u54616 \u45208 \u45784 \u51032  \u53469 \u54616 \u49900 \u51012  \u51077 \u51008  \u50956 \u47532 \u50628  \u48128 \u47084  (William Miller) \u45716  \u49457 \u44221 \u51032  \u44428 \u50948 \u47484  \u51032 \u49900 \u54616 \u47732 \u49436 \u46020  \u51652 \u49900 \u51004 \u47196  \u51652 \u47532 \u47484  \u50508 \u44256 \u51088  \u44040 \u47581 \u54620  \u52265 \u49892 \u54616 \u44256  \u51221 \u51649 \u54620  \u45453 \u48512 \u50688 \u45796 . \u44536 \u45716  \u45796 \u47480  \u51333 \u44368  \u44060 \u54785 \u51088 \u46308 \u52376 \u47100  \u50612 \u47536  \u49884 \u51208 \u50640  \u44032 \u45212 \u44284  \u49912 \u50912 \u51004 \u47728 , \u44536 \u47196  \u51064 \u54616 \u50668  \u49828 \u49828 \u47196  \u55192 \u50416 \u44256  \u44537 \u44592 \u54616 \u45716  \u53360  \u44368 \u54984 \u51012  \u48176 \u50912 \u45796 . \u44536 \u44032  \u52636 \u49373 \u54620  \u44032 \u47928 \u51008  \u51088 \u47549 \u51221 \u49888 \u44284  \u51088 \u50976 \u47484  \u49324 \u46993 \u54616 \u45716  \u47560 \u51020 \u51060  \u47566 \u44256 , \u50676 \u47148 \u54620  \u50528 \u44397 \u49900 \u44284  \u51064 \u45236 \u47141 \u51060  \u44053 \u54620  \u44163  \u46321 \u51004 \u47196  \u53945 \u51669 \u51060  \u51648 \u50612 \u51652  \u51665 \u50504 \u51060 \u50632 \u45716 \u45936 , \u44536  \u44057 \u51008  \u53945 \u49457 \u46308 \u51008  \u46608 \u54620  \u44536 \u51032  \u49457 \u44201 \u50640 \u46020  \u54788 \u51200 \u55176  \u45208 \u53440 \u45228 \u45796 . \u44536 \u51032  \u50500 \u48260 \u51648 \u45716  \u48120 \u44397  \u46021 \u47549 \u51204 \u51137  \u45817 \u49884 \u50640  \u54620  \u48512 \u45824 \u51109  (\u37096 \u38538 \u38263 ) \u51004 \u47196  \u51080 \u50632 \u45716 \u45936 , \u44536  \u44201 \u47148 \u54620  \u51204 \u51137  \u46041 \u50504 \u51032  \u53804 \u51137 \u44284  \u44256 \u45212  \u46412 \u47