\f0\b \cf0 \uc0\u50836 \u49481  \u48380 \u54532 \u51032  \u49548 \u45380  \u49884 \u45824 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
1821\uc0\u45380 , \u48128 \u47084 \u44032  \u49900 \u54032 \u51032  \u46412 \u47484  \u44032 \u47532 \u53412 \u45716  \u50696 \u50616 \u51032  \u54644 \u49437 \u51012  \u54620  \u51648  3\u45380  \u54980 \u50640  \'93\u49464 \u44228 \u51032  \u49440 \u44368 \u49324 \'94\u46972 \u44256  \u48520 \u47532 \u45716  \u50836 \u49481  \u48380 \u54532 \u44032  \u51452 \u45784 \u51032  \u51116 \u47548 \u51060  \u51208 \u48149 \u54632 \u51012  \u49440 \u54252 \u54616 \u44592  \u49884 \u51089 \u54616 \u50688 \u45796 . \u48380 \u54532 \u45716  \u55176 \u48652 \u47532 \u51064 \u51032  \u54792 \u53685 \u51012  \u48155 \u51008  \u49324 \u46988 \u51004 \u47196 \u49436  \u46021 \u51068 \u50640 \u49436  \u52636 \u49373 \u54616 \u50688 \u45796 . \u44536 \u51032  \u50500 \u48260 \u51648 \u45716  \u50976 \u45824 \u51064 \u51032  \u46989 \u48708 \u50688 \u45796 . \u44536 \u45716  \u50612 \u47140 \u49436 \u48512 \u53552  \u44536 \u47532 \u49828 \u46020 \u44368 \u51032  \u51652 \u47532 \u47484  \u48155 \u50500 \u46308 \u50688 \u45796 . \u44536 \u45716  \u47588 \u50864  \u50612 \u47160 \u51012  \u46412 \u50640 , \u44536 \u51032  \u51665 \u50640  \u44221 \u44148 \u54620  \u55176 \u48652 \u47532  \u49324 \u46988 \u46308 \u51060  \u47784 \u50668 \u49436  \u50976 \u45824  \u48124 \u51313 \u51032  \u55148 \u47581 \u44284  \u44592 \u45824 \u50752  \u50724 \u49892  \u47700 \u49884 \u50556 \u51032  \u50689 \u44305 \u44284  \u51060 \u49828 \u46972 \u50648 \u51032  \u54924 \u48373 \u50640  \u45824 \u54616 \u50668  \u51088 \u49464 \u55176  \u51060 \u50556 \u44592 \u54616 \u45716  \u45824 \u54868 \u46308 \u51012  \u48512 \u51648 \u47088 \u55176 , \u44536 \u47532 \u44256  \u50676 \u47148 \u54620  \u47560 \u51020 \u51004 \u47196  \u46307 \u44172  \u46104 \u50632 \u45796 . \u50612 \u45712  \u45216  \u45208 \u49324 \u47131  \u50696 \u49688 \u45784 \u51032  \u51060 \u50556 \u44592 \u47484  \u46307 \u44256 , \u44536 \u48516 \u51060  \u45572 \u44396 \u51064 \u51648  \u47932 \u50632 \u45796 . \u44536 \u45716  \'93\u47588 \u50864  \u51116 \u44036  \u51080 \u45716  \u54620  \u50976 \u45824 \u51064 \u51060 \u50632 \u45716 \u45936 , \u51088 \u52845  \u47700 \u49884 \u50556 \u46972 \u44256  \u51452 \u51109 \u54616 \u50688 \u44592  \u46412 \u47928 \u50640  \u50976 \u45824 \u51032  \u48277 \u51221 \u51008  \u44536 \u50640 \u44172  \u49324 \u54805 \u51012  \u49440 \u44256 \u54616 \u50688 \u45796 \'94\u45716  \u45824 \u45813 \u51012  \u46307 \u44172  \u46104 \u50632 \u45796 . \u44536 \u45716  \u45796 \u49884  \'93\u50696 \u47336 \u49332 \u47128 \u51060  \u47736 \u47581 \u54620  \u51060 \u50976 \u44032  \u47924 \u50631 \u51060 \u47728 , \u50864 \u47532 \u44032  \u51088 \u50976 \u47484  \u51075 \u51008  \u48177 \u49457 \u51060  \u46108  \u44163 \u51008  \u47924 \u50631  \u46412 \u47928 \u51060 \u45264 \'94\u44256  \u47932 \u50632 \u45796 . \u44536 \u47084 \u51088  \u44536 \u51032  \u50500 \u48260 \u51648 \u45716  \'93\u49836 \u54532 \u45796 , \u49836 \u54532 \u45796 , \u44536 \u44163 \u51008  \u50976 \u45824 \u51064 \u46308 \u51060  \u49440 \u51648 \u51088 \u47484  \u51453 \u50688 \u44592  \u46412 \u47928 \u51060 \u45796 \'94\u44256  \u45824 \u45813 \u54616 \u50688 \u45796 . \u44536  \u47568 \u51012  \u46307 \u51088  \u44536  \u49548 \u45380 \u51032  \u47560 \u51020 \u50640 \u45716  \u44049 \u51088 \u44592  \'93\u50500 \u47560  \u50696 \u49688 \u45784 \u46020  \u54620  \u49440 \u51648 \u51088 \u50688 \u45716 \u45936  \u50976 \u45824 \u51064 \u46308 \u51060  \u51396  \u50630 \u45716  \u44536 \u48516 \u51012  \u51453 \u50688 \u45208 \u48372 \u45796 \'94 (Travels and Adventures of the Rev.Joseph Wolff, vol.1, p.6) \u54616 \u45716  \u49373 \u44033 \u51060  \u46496 \u50732 \u46992 \u45796 . \u44536  \u49373 \u44033 \u51060  \u45320 \u47924 \u45208  \u44618 \u50632 \u44592  \u46412 \u47928 \u50640  \u44536 \u45716  \u44536 \u47532 \u49828 \u46020  \u44368 \u54924 \u50640  \u52636 \u51077 \u54616 \u45716  \u51068 \u51060  \u44552 \u51648 \u46104 \u50612  \u51080 \u50632 \u51020 \u50640 \u46020  \u48520 \u44396 \u54616 \u44256  \u46412 \u46412 \u47196  \u44368 \u54924 \u51032  \u51452 \u50948 \u47484  \u48176 \u54924 \u54616 \u47732 \u49436  \u49444 \u44368 \u47484  \u46307 \u44256 \u51088  \u54616 \u50688 \u45796 .\
\uc0\u44536 \u44032  \u44200 \u50864  \u51068 \u44273  \u49332 \u51060 \u50632 \u51012  \u46412  \u51088 \u44592 \u51032  \u51060 \u50883 \u50640  \u49324 \u45716  \u50672 \u47196 \u54620  \u44536 \u47532 \u49828 \u46020 \u51064 \u50640 \u44172  \u51109 \u52264  \u47700 \u49884 \u50556 \u44032  \u45208 \u53440 \u45208 \u44172  \u46104 \u47732  \u51060 \u49828 \u46972 \u50648 \u51060  \u49849 \u47532 \u47484  \u50619 \u51012  \u44163 \u51060 \u46972 \u44256  \u51088 \u46993 \u51012  \u54616 \u50688 \u45796 . \u44536 \u47084 \u51088  \u44536  \u45721 \u51008 \u51060 \u45716  \u52828 \u51208 \u54616 \u44172  \u47568 \u54616 \u50688 \u45796 . \'93\u49324 \u46993 \u54616 \u45716  \u50500 \u51060 \u50556 , \u45572 \u44032  \u52280  \u47700 \u49884 \u50556 \u51064 \u51648  \u45236 \u44032  \u51068 \u47084  \u51452 \u47560 . \u45320 \u55148  \u51312 \u49345 \u46308 \u51060  \u50715 \u51201 \u51032  \u49440 \u51648 \u51088 \u46308 \u50640 \u44172  \u54620  \u44163 \u52376 \u47100  \u49901 \u51088 \u44032 \u50640  \u47803  \u48149 \u51008  \u45208 \u49324 \u47131  \u50696 \u49688 \u45784 \u51060  \u48148 \u47196  \u47700 \u49884 \u50556 \u49884 \u45796 . \'85\u51665 \u50640  \u46028 \u50500 \u44032 \u49436  \u51060 \u49324 \u50556 \u49436  53\u51109 \u51012  \u51069 \u50612  \u48372 \u50500 \u46972 . \u44536 \u47532 \u54616 \u47732  \u50696 \u49688  \u44536 \u47532 \u49828 \u46020 \u44032  \u54616 \u45208 \u45784 \u51032  \u50500 \u46308 \u51060 \u49900 \u51012  \u44648 \u45803 \u44172  \u46112  \u44163 \u51060 \u45796 \'94 (Travels and Adventures of the Rev.Joseph Wolff, vol.1, p.7). \u51593 \u49884  \u44536 \u50640 \u44172  \u44053 \u54620  \u54869 \u49888 \u51060  \u49373 \u44220 \u45796 . \u44536 \u45716  \u51665 \u51004 \u47196  \u46028 \u50500 \u44032 \u49436  \u44536  \u49457 \u44221  \u47568 \u50432 \u51012  \u51069 \u50612  \u48372 \u44256 , \u44536 \u44163 \u51060  \u45320 \u47924 \u46020  \u51221 \u54869 \u54616 \u44172  \u45208 \u49324 \u47131  \u50696 \u49688 \u45784 \u50640 \u44172 \u49436  \u49457 \u52712 \u46108  \u44163 \u51012  \u48372 \u44256  \u45440 \u46992 \u45796 . \u44536 \u45716  \u44536 \u47532 \u49828 \u46020 \u51064 \u51032  \u47568 \u51060  \u52280 \u47568 \u51060 \u46972 \u44256  \u48127 \u50632 \u45796 . \u44536 \u45716  \u50500 \u48260 \u51648 \u44760  \u44536  \u50696 \u50616 \u51012  \u49444 \u47749 \u54644 \u45804 \u46972 \u44256  \u50836 \u52397 \u54616 \u50688 \u45796 . \u44536 \u47084 \u51088  \u50500 \u48260 \u51648 \u45716  \u50500 \u51452  \u47924 \u49436 \u50868  \u54364 \u51221 \u51004 \u47196  \u51104 \u51088 \u53076  \u51080 \u50632 \u51004 \u48064 \u47196  \u45796 \u49884 \u45716  \u44536  \u47928 \u51228 \u47484  \u44144 \u47200 \u54616 \u51648  \u47803 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536  \u51068 \u51008  \u44536 \u47532 \u49828 \u46020 \u44368 \u50640  \u45824 \u54616 \u50668  \u45908 \u50865 \u45908  \u50508 \u50500 \u48372 \u44256  \u49910 \u51008  \u50837 \u47581 \u51012  \u51068 \u51004 \u53040 \u51012  \u49104 \u51060 \u50632 \u45796 .\
