\uc0\u49464 \u49345 \u51008  \u51088 \u50500  \u48169 \u51333 \u50640  \u48736 \u51256  \u51080 \u45796 . \'93\u50977 \u49888 \u51032  \u51221 \u50837 \u44284  \u50504 \u47785 \u51032  \u51221 \u50837 \u44284  \u51060 \u49373 \u51032  \u51088 \u46993 \'94\u51060  \u47566 \u51008  \u49324 \u46988 \u46308 \u51012  \u51648 \u48176 \u54616 \u44256  \u51080 \u45796 . \u44536 \u47084 \u45208  \u44536 \u47532 \u49828 \u46020 \u47484  \u46384 \u47476 \u45716  \u49324 \u46988 \u46308 \u51008  \u44256 \u49345 \u54620  \u48512 \u47476 \u49900 \u51012  \u48155 \u44256  \u51080 \u45796 . \'93\u45320 \u55148 \u45716  \u51200 \u55148  \u51473 \u50640 \u49436  \u45208 \u50752 \u49436  \u46384 \u47196  \u51080 \u44256  \u48512 \u51221 \u54620  \u44163 \u51012  \u47564 \u51648 \u51648  \u47568 \u46972 .\'94 \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51032  \u48731 \u50640  \u51032 \u54616 \u47732 , \u49464 \u49549 \u51201  \u47564 \u51313 \u44284  \u51396 \u50501 \u51201  \u49845 \u44288 \u51012  \u50756 \u51204 \u55176  \u45236 \u50612  \u48260 \u47532 \u51648  \u50506 \u51004 \u47732  \u49457 \u54868 \u44032  \u51652 \u49892 \u54620  \u44163 \u51060  \u46112  \u49688  \u50630 \u45796 \u45716  \u50864 \u47532 \u51032  \u51452 \u51109 \u51060  \u51221 \u45817 \u54632 \u51060  \u51077 \u51613 \u46108 \u45796 . \'93\u51200 \u55148  \u51473 \u50640 \u49436  \u45208 \u50752 \u49436  \u46384 \u47196  \u51080 \u44256  \u48512 \u51221 \u54620  \u44163 \u51012  \u47564 \u51648 \u51648  \u47568 \u46972 \'94\u45716  \u51312 \u44148 \u50640  \u51025 \u54616 \u45716  \u49324 \u46988 \u46308 \u50640 \u44172  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \'93\u45236 \u44032  \u45320 \u55148 \u47484  \u50689 \u51217 \u54616 \u50668  \u45320 \u55148 \u50640 \u44172  \u50500 \u48260 \u51648 \u44032  \u46104 \u44256  \u45320 \u55148 \u45716  \u45236 \u44172  \u51088 \u45376 \u44032  \u46104 \u47532 \u46972 \'94 (\u44256 \u54980  6:17, 18) \u44256  \u50557 \u49549 \u54616 \u49888 \u45796 . \u54616 \u45208 \u45784 \u44760  \u49549 \u54620  \u51068 \u50640  \u54413 \u48512 \u54616 \u44256  \u54413 \u49457 \u54620  \u44221 \u54744 \u51012  \u44032 \u51648 \u45716  \u44163 \u51060  \u47784 \u46304  \u44536 \u47532 \u49828 \u46020 \u51064 \u51032  \u53945 \u44428 \u51060 \u50836  \u51032 \u47924 \u51060 \u45796 . \u50696 \u49688 \u44760 \u49436 \u45716  \'93\u45208 \u45716  \u49464 \u49345 \u51032  \u48731 \u51060 \u45768  \u45208 \u47484  \u46384 \u47476 \u45716  \u51088 \u45716  \u50612 \u46176 \u50640  \u45796 \u45768 \u51648  \u50500 \u45768 \u54616 \u44256  \u49373 \u47749 \u51032  \u48731 \u51012  \u50619 \u51004 \u47532 \u46972 \'94 (\u50836  8:12) \u44256  \u47568 \u50432 \u54616 \u49512 \u45796 . \'93\u51032 \u51064 \u51032  \u44600 \u51008  \u46027 \u45716  \u54663 \u48341  \u44057 \u50500 \u49436  \u51216 \u51216  \u48731 \u45208 \u49436  \u50896 \u47564 \u54620  \u44305 \u47749 \u50640  \u51060 \'94 (\u51104  4:18) \u47480 \u45796 . \u48127 \u51020 \u44284  \u49692 \u51333 \u51032  \u44600 \u51008  \u47588  \u44152 \u51020 \u47560 \u45796  \'93\u50612 \u46176 \u51060  \u51312 \u44552 \u46020  \u50630 \u51004 \u49888 \'94 \u49464 \u49345 \u51032  \u48731 \u44284  \u45908 \u50865  \u48128 \u51217 \u54620  \u44288 \u44228 \u47484  \u44032 \u51648 \u44172  \u54644 \u51456 \u45796 . \u51032 \u51032  \u53468 \u50577  \u46104 \u49884 \u45716  \u44536 \u47532 \u49828 \u46020 \u51032  \u48157 \u51008  \u48731 \u51060  \u54616 \u45208 \u45784 \u51032  \u51333 \u46308 \u50640 \u44172  \u48708 \u52832  \u46412  \u44536 \u46308 \u51008  \u44536 \u48516 \u51032  \u48731 \u51012  \u48152 \u49324 \u54616 \u44172  \u46108 \u45796 . \u47560 \u52824  \u48324 \u46308 \u51060  \u54616 \u45720 \u50640  \u53360  \u48731 \u51060  \u51080 \u50612 \u49436  \u44536  \u50689 \u44305 \u51004 \u47196  \u51200 \u46308 \u51060  \u48731 \u45208 \u44256  \u51080 \u45796 \u45716  \u44163 \u51012  \u47568 \u54644  \u51452 \u45716  \u44163 \u52376 \u47100  \u44536 \u47532 \u49828 \