\uc0\u47784 \u50724 \u50640 \u49436  \u48149 \u54644 \u44032  \u51068 \u50612 \u45208 \u51088  \u44060 \u54785 \u54028 \u51032  \u44368 \u49324 \u46308 \u51008  \u48373 \u51020 \u51012  \u51204 \u54624  \u49688  \u51080 \u45716  \u51088 \u44201 \u51613 \u51012  \u48149 \u53448 \u45817 \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u46308 \u51008  \u45796 \u47480  \u51648 \u48169 \u51012  \u54693 \u54616 \u50668  \u46496 \u45208 \u44052 \u45796 . \u47084 \u54168 \u48652 \u47476 \u45716  \u50620 \u47560  \u54980 \u50640  \u46021 \u51068 \u47196  \u44052 \u44256 , \u54028 \u47120 \u51008  \u46041 \u54532 \u46993 \u49828 \u51032  \u44256 \u54693 \u51004 \u47196  \u46028 \u50500 \u44032 \u49436  \u51088 \u44592 \u51032  \u44256 \u54693 \u50640 \u49436  \u48731 \u51012  \u51204 \u54616 \u50688 \u45796 . \u49324 \u46988 \u46308 \u51008  \u51060 \u48120  \u47784 \u50724 \u50640 \u49436  \u51068 \u50612 \u45228 \u45912  \u49324 \u44148 \u50640  \u45824 \u54616 \u50668  \u49548 \u49885 \u51012  \u46308 \u50632 \u51004 \u48064 \u47196  \u44536 \u44032  \u46160 \u47140 \u50880  \u50630 \u51060  \u50676 \u49900 \u51004 \u47196  \u51652 \u47532 \u47484  \u49444 \u47749 \u54624  \u46412  \u44480 \u47484  \u44592 \u50872 \u51060 \u45716  \u49324 \u46988 \u46308 \u51060  \u51080 \u50632 \u45796 . \u44536 \u47084 \u45208  \u45817 \u44397 \u51088 \u46308 \u51008  \u44263  \u44536 \u47484  \u52840 \u47925 \u49884 \u53412 \u44592  \u50948 \u54616 \u50668  \u51068 \u50612 \u45208 \u49436  \u44536 \u47484  \u51021 \u50640 \u49436  \u52628 \u48169 \u49884 \u53040 \u45796 . \u48708 \u47197  \u44536 \u45716  \u44277 \u44277 \u50672 \u54616 \u44172  \u51204 \u46020 \u54624  \u49688  \u50630 \u50632 \u51004 \u45208  \u52492 \u46973 \u51012  \u46160 \u47336  \u45796 \u45768 \u47732 \u49436  \u48124 \u44032  (\u27665 \u23478 ) \u50752 , \u44201 \u47532 \u46108  \u47785 \u51109 \u50640 \u49436  \u44368 \u47532 \u47484  \u49444 \u47749 \u54616 \u44256  \u49714  \u49549 \u44284  \u49548 \u45380  \u49884 \u51208 \u50640  \u51088 \u51452  \u45796 \u45768 \u45912  \u48148 \u50948 \u47196  \u46108  \u46041 \u44404 \u50640 \u49436  \u54588 \u45212 \u52376 \u47484  \u52286 \u50520 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u45908  \u53360  \u54872 \u45212 \u51012  \u50948 \u54616 \u50668  \u44536 \u47484  \u51456 \u48708 \u49884 \u53040 \u45796 . \u44536 \u45716  \u47568 \u54616 \u50688 \u45796 . \'93\u45236 \u44032  \u48120 \u47532  \u44221 \u44256 \u47484  \u48155 \u51008  \u49901 \u51088 \u44032 \u50752  \u48149 \u54644 \u50752  \u49324 \u45800 \u51032  \u51020 \u47784  \u46321 \u51008  \u45236  \u55192 \u50640  \u47564 \u47564 \u52824  \u50506 \u51008  \u44163 \u46308 \u51060 \u50632 \u45796 . \u44536 \u44163 \u46308 \u51008  \u55192 \u51004 \u47196  \u44204 \u46356 \u44592 \u50640 \u45716  \u45320 \u47924  \u49900 \u54620  \u44163 \u46308 \u51060 \u50632 \u45796 . \u44536 \u47084 \u45208  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u45208 \u51032  \u50500 \u48260 \u51648 \u49884 \u45796 . \u44536 \u48516 \u44760 \u49436 \u45716  \u45236 \u44032  \u54596 \u50836 \u54620  \u55192 \u51012  \u51648 \u44552 \u44620 \u51648  \u51452 \u49512 \u44256 , \u51109 \u47000 \u50640 \u46020  \u50616 \u51228 \u45208  \u51452 \u49892  \u44163 \u51060 \u45796 \'94 (D\'92Aubigne.b.12, ch.9).\
\uc0\u49324 \u46020  \u49884 \u45824 \u50752  \u47560 \u52268 \u44032 \u51648 \u47196  \u48149 \u54644 \u45716  \'93\u46020 \u47532 \u50612  \u48373 \u51020 \u51032  \u51652 \u48372 \'94 (\u48716  1:12) \u47484  \u44032 \u51256 \u50772 \u45796 . \u54028 \u47532 \u50752  \u47784 \u50724 \u50640 \u49436  \u51923 \u44200 \u45212  \u49324 \u46988 \u46308 \u51008  \'93\u46160 \u47336  \u45796 \u45768 \u47728  \u48373 \u51020 \u51032  \u47568 \u50432 \u51012  \u51204 \'94 (\u54665  8:4) \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u48731 \u51008  \u54532 \u46993 \u49828 \u51032  \u44417 \u48317 \u54620  \u47676  \u51648 \u48169 \u50640 \u44620 \u51648  \u54140 \u51648 \u44172  \u46104 \u50632 \u45796 .\
