\uc0\u44536 \u50752  \u47560 \u52268 \u44032 \u51648 \u47196  \u50689 \u44305 \u51032  \u48372 \u51340 \u46976  \u50689 \u44305 \u51032  \u50773 \u44397 \u51012  \u45208 \u53440 \u45236 \u45716  \u44163 \u51064 \u45936 , \u44536  \u45208 \u46972 \u45716  \u44536 \u47532 \u49828 \u46020 \u51032  \u47568 \u50432 \u50640  \u45796 \u51020 \u44284  \u44057 \u51060  \u51064 \u50857 \u46104 \u50632 \u45796 . \'93\u51064 \u51088 \u44032  \u51088 \u44592  \u50689 \u44305 \u51004 \u47196  \u47784 \u46304  \u52380 \u49324 \u50752  \u54632 \u44760  \u50732  \u46412 \u50640  \u51088 \u44592  \u50689 \u44305 \u51032  \u48372 \u51340 \u50640  \u50505 \u51004 \u47532 \u45768  \u47784 \u46304  \u48124 \u51313 \u51012  \u44536  \u50526 \u50640 \'94 (\u47560  25:31, 32) \u47784 \u51004 \u47532 \u46972 . \u44536  \u45208 \u46972 \u45716  \u50500 \u51649  \u51109 \u47000 \u50640  \u49549 \u54620  \u45208 \u46972 \u51060 \u45796 . \u44536  \u45208 \u46972 \u45716  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u51116 \u47548 \u54616 \u49892  \u46412 \u50640  \u48708 \u47196 \u49548  \u44148 \u49444 \u46112  \u44163 \u51060 \u45796 .\
\uc0\u51008 \u54812 \u51032  \u50773 \u44397 \u51008  \u49324 \u46988 \u51060  \u53440 \u46973 \u54620  \u51060 \u54980 , \u48276 \u51396 \u54620  \u51064 \u47448 \u51032  \u44396 \u49549 \u51012  \u50948 \u54616 \u50668  \u44228 \u54925 \u51060  \u49464 \u50892 \u51652  \u51649 \u54980 \u50640  \u44148 \u49444 \u46104 \u50632 \u45796 . \u44536  \u54980 \u47196  \u44536  \u45208 \u46972 \u45716  \u54616 \u45208 \u45784 \u51032  \u46907 \u51012  \u46384 \u46972  \u44536 \u48516 \u51032  \u54728 \u46973 \u50640  \u51032 \u54616 \u50668  \u51316 \u51116 \u54616 \u44172  \u46104 \u50632 \u51004 \u48064 \u47196  \u49324 \u46988 \u46308 \u51008  \u48127 \u51020 \u51004 \u47196  \u44536  \u45208 \u46972 \u51032  \u48177 \u49457 \u51060  \u46112  \u49688  \u51080 \u44172  \u46104 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44536  \u45208 \u46972 \u45716  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u46028 \u50500 \u44032 \u49888  \u54980 \u50640  \u48708 \u47196 \u49548  \u54869 \u47549 \u46104 \u50632 \u45796 . \u44396 \u51452 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u51648 \u49345 \u49373 \u50528 \u47484  \u49884 \u51089 \u54616 \u49888  \u54980 \u51068 \u51648 \u46972 \u46020  \u49324 \u46988 \u46308 \u51032  \u44256 \u51665 \u49828 \u47101 \u44256  \u47924 \u51221 \u54620  \u45936  \u50684 \u51613 \u51060  \u45208 \u49436  \u44040 \u48148 \u47532 \u51032  \u55148 \u49373 \u51012  \u52384 \u54924 \u54624  \u49688 \u46020  \u51080 \u51004 \u49512 \u45796 . \u44191 \u49464 \u47560 \u45348  \u46041 \u49328 \u50640 \u49436  \u44536  \u51200 \u51452 \u51032  \u51092 \u51008  \u44536 \u48516 \u51032  \u49552 \u50640 \u49436  \u46504 \u44256  \u51080 \u50632 \u45796 . \u44536  \u46412 \u50640 \u46972 \u46020  \u44536 \u48516 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u51060 \u47560 \u50640 \u49436  \u55128 \u47084 \u45236 \u47532 \u45716  \u54588 \u46400 \u51012  \u50491 \u50612  \u48260 \u47532 \u44256  \u53440 \u46973 \u54620  \u51064 \u47448 \u47484  \u44536 \u46308 \u51032  \u51396  \u44032 \u50868 \u45936 \u49436  \u47736 \u47581 \u54616 \u46020 \u47197  \u48260 \u47140 \u46168  \u49688 \u46020  \u51080 \u50632 \u45796 . \u44536 \u48516 \u44760 \u49436  \u47564 \u51068  \u44536 \u47111 \u44172  \u54616 \u49512 \u45908 \u46972 \u47732 , \u53440 \u46973 \u54620  \u51064 \u47448 \u47484  \u44396 \u49549 \u54624  \u49688 \u45716  \u50630 \u50632 \u51012  \u44163 \u51060 \u45796 . \u44536 \u47084 \u45208  \u44396 \u51452 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u49373 \u47749 \u51012  \u48260 \u47532 \u49884 \u44256  \'93\u45796  \u51060 \u47336 \u50632 \u45796 \'94\u44256  \u48512 \u47476 \u51670 \u51004 \u47732 \u49436  \u50868 \u47749 \u54616 \u49900 \u51004 \u47196  \u44396 \u49549 \u51032  \u44221 \u47452 \u51012  \u50756 \u51204 \u55176  \u49457 \u52712 \u54616 \u49512 \u45796 . \u50640 \u45940 \u46041 \u49328 \u50640 \u49436  \u48276 \u51396 \u54620  \u48512 \u48512 \u50640 \u44172  \u54728 \u46973 \u46108  \u44396 \u49549 \u51032  \u50557 \u49549 \u51008  \u51060 \u51228  \u54869 \u51613 \u46104 \u50632 \u45796 . \u54616 \u45208 \u45784 \u51032  \u54728 \u46973 \u51004 \u47196  \u50724 \u47000  \u51204 \u48512 \u53552  \u51316 \u51116 \u54644  \u50728  \u51008 \u54812 \u51032  \u50773 \u44397 \u51060  \u44536 \u46412 \u50640  \u49464 \u50892 \u51276 \u45796 .\
\uc0\u51060 \u50752  \u44057 \u51060  \u44536 \u47532 \u49828 \u46020 \u51032  \u51453 \u51020 , \u44263  \u51228 \u51088 \u46308 \u51060  \u51200 \u46308 \u51032  \u55148 \u47581 \u51032  \u52572 \u51333 \u51201  \u54028 \u47736 \u47196  \u49373 \u44033 \u54664 \u45912  \u48148 \u47196  \u44536  \u49324 \u44148 \u51008  \u46020 \u47532 \u50612  \u51200 \u55148 \u51032  \u55148 \u47581 \u51012  \u50689 \u50896 \u55176  \u54869 \u51613 \u54644  \u51452 \u50632 \u45796 . \u44536  \u49324 \u44148 \u51008  \u54620 \u54200 \u51004 \u47196  \u44536 \u46308 \u51012  \u48708 \u52280 \u54620  \u49892 \u47581  \u44032 \u50868 \u45936  \u48736 \u46888 \u47160 \u51004 \u45208  \u44536 \u44163 \u51008  \u46608 \u54620  \u44536 \u46308 \u51032  \u48127 \u51020 \u51060  \u50739 \u50520 \u45796 \u45716  \u44163 \u51012  \u51077 \u51613 \u54644 \u51452 \u45716  \u52572 \u44256 \u51032  \u49324 \u44148 \u51060 \u50632 \u45796 . \u44536 \u46308 \u50640 \u44172  \u48708 \u53444 \u44284  \u49892 \u47581 \u51012  \u44032 \u46301  \u50504 \u44200 \u51456  \u44536  \u49324 \u44148 \u51008  \u50500 \u45812 \u51032  \u54980 \u49552 \u50640 \u44172  \u55148 \u47581 \u51032  \u47928 \u51012  \u50676 \u50612 \u51452 \u50632 \u44256 , \u44033  \u49884 \u45824 \u47484  \u53685 \u54616 \u50668  \u54616 \u45208 \u45784 \u51032  \u52649 \u49457 \u46108  \u48177 \u49457 \u46308 \u50640 \u44172  \u48120 \u47000 \u51032  \u49373 \u50528 \u50752  \u50689 \u50896 \u54620  \u54665 \u48373 \u51032  \u51473 \u49900 \u51060  \u46104 \u50632 \u45796 .\
\uc0\u49900 \u51648 \u50612  \u51228 \u51088 \u46308 \u51032  \u49892 \u47581 \u51012  \u53685 \u54616 \u50668 \u49436 \u44620 \u51648 \u46972 \u46020  \u47924 \u54620 \u54620  \u51088 \u48708 \u51032  \u47785 \u51201 \u51008  \u49457 \u52712 \u46104 \u50612  \u44032 \u44256  \u51080 \u50632 \u45796 . \u44536 \u47084 \u45208  \u51200 \u46308 \u51032  \u47560 \u51020 \u51008  \u54616 \u45208 \u45784 \u51032  \u51008 \u54812 \u50752  \'93\u44536  \u49324 \u46988 \u51032  \u47568 \u54620  \u44163 \u52376 \u47100  \u47568 \u54620  \u49324 \u46988 \u51008  \u51060  \u46412 \u44620 \u51648  \u54620  \u49324 \u46988 \u46020  \u50630 \u50632 \u45208 \u51060 \u45796 \'94\u46972 \u44256  \u49324 \u46988 \u46308 \u51060  \u47568 \u54620  \u44536 \u48516 \u51032  \u44368 \u54984 \u51032  \u45733 \u47141 \u51012  \u53685 \u54616 \u50668  \u51221 \u48373 \u46104 \u50612  \u44032 \u47732 \u49436 \u46020  \u50696 \u49688 \u44760  \u45824 \u54620  \u44536 \u46308 \u51032  \u49324 \u46993 \u51032  \u49692 \u44552 \u50640 \u45716  \u49464 \u49549 \u51201  \u51088 \u46993 \u44284  \u51060 \u44592 \u51201  \u50556 \u49900 \u51004 \u47196  \u46108  \u48708 \u52380 \u54620  \u54633 \u44552 \u51060  \u49438 \u51060 \u44172  \u46104 \u50632 \u45796 . \u44536 \u46308 \u51032  \u51452 \u45784 \u44760 \u49436  \u44191 \u49464 \u47560 \u45348 \u51032  \u51453 \u51020 \u51032  \u44536 \u45720  \u50500 \u47000 \u47196  \u46308 \u50612 \u44032 \u49884 \u47140 \u44256  \u54616 \u45716  \u50628 \u49689 \u54620  \u49692 \u44036 \u51060 \u50632 \u45912  \u50976 \u50900 \u51208 \u51032  \u45796 \u46973 \u48169 \u50640 \u49436 \u44620 \u51648 \u46020  \u51200 \u46308 \u51008  \'93\u45572 \u44032  \u53356 \u45264 \'94 (\u45573  22:24) \u54616 \u45716  \u45796 \u53820 \u51032  \u51221 \u49888 \u51012  \u44032 \u51648 \u44256  \u51080 \u50632 \u45796 . \u48148 \u47196  \u52840 \u47925 \u44284  \u44191 \u49464 \u47560 \u45348  \u46041 \u49328 \u51032  \u44256 \u48124 \u44284  \u49900 \u54032 \u51221 \u44284  \u44040 \u48148 \u47532 \u51032  \u49901 \u51088 \u44032 \u44032  \u44536 \u46308 \u51032  \u47785 \u51204 \u50640  \u51208 \u48149 \u54644  \u51080 \u51012  \u44536  \u46412 \u50640 \u46020  \u44536 \u46308 \u51032  \u45576 \u51008  \u48372 \u51340 \u50752  \u47732 \u47448 \u44288 \u44284  \u50689 \u44305  \u46321 \u51004 \u47196  \u44032 \u46301  \u52264  \u51080 \u50632 \u45796 . \u44536 \u46308 \u47196  \u54616 \u50668 \u44552  \u45817 \u49884 \u51032  \u44144 \u51667  \u44368 \u54984 \u51012  \u44256 \u49688 \u54616 \u44256 , \u54616 \u45208 \u45784 \u51032  \u45208 \u46972 \u51032  \u52280  \u49457 \u44201 \u51012  \u45208 \u53440 \u45236  \u51452 \u44256  \u45817 \u49888 \u51032  \u44256 \u48124 \u44284  \u51453 \u51020 \u51012  \u48120 \u47532  \u44032 \u47476 \u52432 \u51452 \u45716  \u44396 \u51452 \u51032  \u47568 \u50432 \u50640  \u50976 \u51032 \u54616 \u51648  \u47803 \u54616 \u46020 \u47197  \u47564 \u46304  \u44163 \u51008  \u44536 \u46308 \u51032  \u47560 \u51020 \u51032  \u44368 \u47564 \u44284  \u49464 \u49549 \u51201  \u50689 \u54868 \u50640  \u45824 \u54620  \u44040 \u47581  \u46412 \u47928 \u51060 \u50632 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u50752  \u44057 \u51008  \u51096 \u47803 \u51008  \u49884 \u47144 , \u44263  \u44032 \u54841 \u54616 \u44592 \u45716  \u54616 \u45208  \u50836 \u44596 \u54620  \u49884 \u47144 \u51012  \u44032 \u51256 \u45796 \u51452 \u50632 \u51004 \u47728 , \u44536 \u44163 \u51008  \u44536 \u46308 \u51012  \u48148 \u47196 \u51105 \u44592  \u50948 \u54616 \u50668  \u54728 \u46973 \u46108  \u44163 \u51060 \u50632 \u45796 . \u48708 \u47197  \u51228 \u51088 \u46308 \u51008  \u44536 \u46308 \u51060  \u51204 \u54616 \u45716  \u44592 \u48324 \u51032  \u51032 \u48120 \u47484  \u50724 \u54644 \u54616 \u44256 , \u44536 \u46308 \u51032  \u44592 \u45824 \u45716  \u51060 \u47336 \u50612 \u51648 \u51648  \u50506 \u50520 \u51004 \u45208  \u44536 \u46308 \u51008  \u54616 \u45208 \u45784 \u44760 \u49436  \u51452 \u49888  