\'93\uc0\u44536  \u46412 \u50640  \u45348  \u48124 \u51313 \u51012  \u54840 \u50948 \u54616 \u45716  \u45824 \u44400  \u48120 \u44032 \u50648 \u51060  \u51068 \u50612 \u45216  \u44163 \u51060 \u50836  \u46608  \u54872 \u45212 \u51060  \u51080 \u51004 \u47532 \u45768  \u51060 \u45716  \u44060 \u44397  \u51060 \u47000 \u47196  \u44536  \u46412 \u44620 \u51648  \u50630 \u45912  \u54872 \u45212 \u51068  \u44163 \u51060 \u47728  \u44536  \u46412 \u50640  \u45348  \u48177 \u49457  \u51473  \u47924 \u47495  \u52293 \u50640  \u44592 \u47197 \u46108  \u47784 \u46304  \u51088 \u44032  \u44396 \u50896 \u51012  \u50619 \u51012  \u44163 \u51060 \u46972 \'94 (\u45800  12:1).\
\uc0\u49483 \u51704  \u52380 \u49324 \u51032  \u44592 \u48324 \u51060  \u47560 \u52432 \u51648 \u47732  \u49464 \u49345 \u51032  \u51396 \u51064 \u46308 \u51012  \u50948 \u54620  \u51088 \u48708 \u51032  \u53444 \u50896 \u51008  \u45908  \u51060 \u49345  \u50630 \u45796 . \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u46308 \u51008  \u44536 \u46308 \u51032  \u49324 \u50629 \u51012  \u45796  \u51060 \u47336 \u50632 \u45796 . \u44536 \u46308 \u51008  \'93\u50976 \u53132 \u54616 \u44172  \u46104 \u45716  \u45216 \u51060  \u51452  \u50526 \u51004 \u47196 \u48512 \u53552  \u51060 \'94 (\u54665  3:19) \u47476 \u45716  \'93\u45734 \u51008 \u48708 \'94 (\u54840  6:3) \u47484  \u48155 \u50520 \u51004 \u48064 \u47196  \u44536 \u46308  \u50526 \u50640  \u51080 \u45716  \u49884 \u47144 \u51032  \u46412 \u47484  \u50948 \u54616 \u50668  \u51456 \u48708 \u47484  \u44054 \u52628 \u50632 \u45796 . \u52380 \u49324 \u46308 \u51008  \u54616 \u45720 \u50640 \u49436  \u48516 \u51452 \u55176  \u50773 \u47000 \u54616 \u44256  \u51080 \u45796 . \u51648 \u49345 \u50640 \u49436  \u46028 \u50500 \u50728  \u54620  \u52380 \u49324 \u45716  \u44536 \u51032  \u51068 \u51060  \u47560 \u52432 \u51652  \u44163 \u51012  \u48372 \u44256 \u54620 \u45796 . \u47560 \u51648 \u47561  \u49884 \u54744 \u51060  \u51060 \u48120  \u49464 \u49345 \u50640  \u51452 \u50612 \u51276 \u44256  \u54616 \u45208 \u45784 \u51032  \u44228 \u47749 \u50640  \u52649 \u49457 \u54620  \u44163 \u51060  \u51077 \u51613 \u46108  \u49324 \u46988 \u46308 \u51008  \u47784 \u46160  \'93\u49332 \u50500  \u44228 \u49888  \u54616 \u45208 \u45784 \u51032  \u51064 \'94 (\u44228  7:2) \u51012  \u48155 \u50520 \u45796 . \u44536  \u46412 \u50640  \u50696 \u49688 \u44760 \u49436 \u45716  \u54616 \u45720  \u49457 \u49548 \u50640 \u49436  \u45817 \u49888 \u51032  \u51473 \u48372  \u49324 \u50629 \u51012  \u44536 \u52824 \u49888 \u45796 . \u44536 \u48516 \u44760 \u49436 \u45716  \u49552 \u51012  \u46308 \u50612  \u53360  \u51020 \u49457 \u51004 \u47196  \'93\u46104 \u50632 \u45796 \'94 (\u44228  16:17) \u44256  \u47568 \u50432 \u54616 \u49888 \u45796 . \u44536 \u47532 \u44256  \u44536 \u48516 \u44760 \u49436  \'93\u48520 \u51032 \u47484  \u54616 \u45716  \u51088 \u45716  \u44536 \u45824 \u47196  \u48520 \u51032 \u47484  \u54616 \u44256  \u45908 \u47084 \u50868  \u51088 \u45716  \u44536 \u45824 \u47196  \u45908 \u47101 \u44256  \u51032 \u47196 \u50868  \u51088 \u45716  \u44536 \u45824 \u47196  \u51032 \u47484  \u54665 \u54616 \u44256  \u44144 \u47337 \u54620  \u51088 \u45716  \u44536 \u45824 \u47196  \u44144 \u47337 \u46104 \u44172  \u54616 \u46972 \'94 (\u44228  22:11) \u44256  \u50628 \u49689 \u55176  \u49440 \u50616 \u54616 \u49884 \u51088  \u50728  \u54616 \u45720 \u51032  \u52380 \u49324 \u46308 \u51008  \u44536 \u46308 \u51032  \u47732 \u47448 \u44288 \u51012  \u48279 \u45716 \u45796 . \u49373 \u49324 \u44036 \u50640  \u47784 \u46304  \u49324 \u46988 \u51032  \u50868 \u47749 \u51060  \u44208 \u51221 \u46108 \u45796 . \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u48177 \u49457 \u46308 \u51012  \u50948 \u54616 \u50668  \u49549 \u51396  \u49324 \u50629 \u51012  \u47560 \u52824 \u49884 \u44256  \u44536 \u46308 \u51032  \u51396 \u47484  \u46020 \u47568 \u54616 \u49512 \u45796 . \u51452 \u45784 \u51032  \u48177 \u49457 \u51032  \u49688 \u54952 \u45716  \u52284 \u45796 . \'93\u45208 \u46972 \u50752  \u44428 \u49464 \u50752  \u50728  \u52380 \u54616  \u50676 \u44397 \u51032  \u50948 \u49464 \'94\u45716  \u48148 \u50556 \u55120 \u47196  \u44396 \u50896 \u51032  \u54980 \u49324 \u46308 \u50640 \u44172  \u51452 \u50612 \u51648 \u44256  \u50696 \u49688 \u44760 \u49436 \u45716  \u47564 \u50773 \u51032  \u50773 , \u47564 \u51452 \u51032  \u51452 \u47196  \u53685 \u52824 \u54616 \u49884 \u44172  \u46108 \u45796 .\
\uc0\u51452 \u45784 \u44760 \u49436  \u49457 \u49548 \u47484  \u46496 \u45208 \u49892  \u46412  \u51060  \u46405 \u51032  \u44144 \u48124 \u46308 \u50640 \u44172 \u45716  \u50516 \u55121 \u51060  \u45934 \u51064 \u45796 . \u51060 \u52376 \u47100  \u46160 \u47140 \u50868  \u49884 \u44592 \u50640  \u51032 \u51064 \u46308 \u51008  \u51473 \u48372 \u51088  \u50630 \u51060  \u44144 \u47337 \u54616 \u49888  \u54616 \u45208 \u45784  \u50526 \u50640 \u49436  \u49332 \u50500 \u50556  \u54620 \u45796 . \u50501 \u51064 \u46308 \u51012  \u45572 \u47476 \u44256  \u51080 \u45912  \u50613 \u51228 \u45716  \u51228 \u44144 \u46104 \u44256  \u49324 \u45800 \u51060  \u47560 \u52840 \u45236  \u54924 \u44060 \u54616 \u51648  \u50506 \u51008  \u51088 \u46308 \u51012  \u50756 \u51204 \u55176  \u51648 \u48176 \u54616 \u44172  \u46108 \u45796 . \u54616 \u45208 \u45784 \u51032  \u50724 \u47000  \u52280 \u51004 \u49900 \u51008  \u45149 \u45228 \u45796 . \u49464 \u49345 \u51008  \u54616 \u45208 \u45784 \u51032  \u51008 \u54812 \u47484  \u44144 \u51208 \u54616 \u44256 , \u44536 \u48516 \u51032  \u49324 \u46993 \u51012  \u47736 \u49884 \u54616 \u44256  \u44536 \u48516 \u51032  \u50984 \u48277 \u51012  \u50976 \u47536 \u54616 \u50688 \u45796 . \u50501 \u51064 \u46308 \u51008  \u44536  \u51008 \u54812  \u49884 \u45824 \u50640  \u51452 \u50612 \u51652  \u44592 \u54924 \u47484  \u51075 \u50612 \u48260 \u47160 \u44256  \u44228 \u49549 \u51201 \u51004 \u47196  \u44144 \u51208 \u45817 \u54620  \u54616 \u45208 \u45784 \u51032  \u50689 \u51008  \u47560 \u52840 \u45236  \u44144 \u46160 \u50612 \u51276 \u45796 . \u54616 \u45208 \u45784 \u51032  \u51008 \u54812 \u47196  \u48372 \u54840 \u47484  \u48155 \u51648  \u47803 \u54616 \u44592  \u46412 \u47928 \u50640  \u44536 \u46308 \u51008  \u50501 \u54620  \u51088  \u47560 \u44480 \u50640 \u44172 \u49436  \u48169 \u50612 \u46104 \u51648  \u47803 \u54620 \u45796 . \u49324 \u45800 \u51008  \u51060  \u46405 \u51032  \u44144 \u48124 \u46308 \u51012  \u52572 \u54980 \u51032  \u53360  \u54872 \u45212  \u44032 \u50868 \u45936  \u48736 \u46888 \u47540  \u44163 \u51060 \u45796 . \u54616 \u45208 \u45784 \u51032  \u52380 \u49324 \u46308 \u51060  \u51064 \u44036 \u51032  \u44048 \u51221 \u51032  \u44144 \u49468  \u48148 \u46988 \u51012  \u47561 \u50500  \u51452 \u51648  \u50506 \u51004 \u47732  \u44033 \u51333  \u53804 \u51137 \u51032  \u50836 \u49548 \u46308 \u51060  \u50143 \u50500 \u51256  \u45208 \u50732  \u44163 \u51060 \u45796 . \u50728  \u49464 \u44228 \u45716  \u50715 \u45216  \u50696 \u47336 \u49332 \u47128 \u51012  \u55081 \u50424 \u50632 \u45912  \u44163 \u48372 \u45796  \u45908  \u47924 \u49436 \u50868  \u54224 \u54728 \u47484  \u45208 \u53440 \u45244  \u44163 \u51060 \u45796 .\
