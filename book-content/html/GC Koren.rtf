19\uc0\u49464 \u44592  \u51204 \u48152  (\u21069 \u21322 ) \u50640  \u49457 \u44221 \u51060  \u45328 \u47532  \u48152 \u54252 \u46104 \u50612  \u49464 \u44228 \u45716  \u53360  \u48731 \u51012  \u48155 \u50520 \u51004 \u45208  \u49324 \u46988 \u46308 \u51008  \u44228 \u49884 \u46108  \u51652 \u47532 \u51032  \u51648 \u49885 \u51012  \u46384 \u46972  \u51204 \u51652 \u54616 \u44144 \u45208  \u52404 \u54744 \u51201  \u49888 \u50521 \u51012  \u49548 \u50976 \u54616 \u51648  \u50506 \u50520 \u45796 . \u51204  \u49884 \u45824 \u52376 \u47100  \u49324 \u45800 \u51060  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51012  \u49324 \u46988 \u46308 \u50640 \u44172  \u44048 \u52636  \u49688  \u50630 \u50632 \u51004 \u48064 \u47196  \u47784 \u46304  \u49324 \u46988 \u51060  \u44536 \u44163 \u51012  \u44032 \u51656  \u49688  \u51080 \u44172  \u46104 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u50668 \u51204 \u55176  \u51088 \u44592 \u51032  \u47785 \u51201 \u51012  \u45804 \u49457 \u54616 \u44592  \u50948 \u54616 \u50668  \u47566 \u51008  \u49324 \u46988 \u46308 \u51060  \u49457 \u44221 \u51032  \u51652 \u47532 \u47484  \u44221 \u54616 \u44172  \u50668 \u44592 \u44172 \u45140  \u51060 \u45132 \u50632 \u45796 . \u49324 \u46988 \u46308 \u51008  \u49457 \u44221  \u50672 \u44396 \u47484  \u44172 \u51012 \u47532  \u54616 \u44172  \u46104 \u50632 \u51004 \u48064 \u47196 , \u44228 \u49549 \u54644 \u49436  \u44144 \u51667  \u54644 \u49444 \u51012  \u48155 \u50500 \u46308 \u51060 \u44172  \u46104 \u50632 \u44256 , \u49457 \u44221 \u50640  \u50500 \u47924  \u44540 \u44144 \u46020  \u50630 \u45716  \u44368 \u47532 \u47484  \u44036 \u51649 \u54616 \u44172  \u46104 \u50632 \u45796 .\
\uc0\u54605 \u48149 \u51004 \u47196  \u51652 \u47532 \u47484  \u44648 \u46888 \u47140  \u48260 \u47532 \u44256 \u51088  \u54664 \u45912  \u51088 \u44592 \u51032  \u45432 \u47141 \u51060  \u49892 \u54056 \u47196  \u45149 \u45212  \u44163 \u51012  \u48372 \u44256 , \u49324 \u45800 \u51008  \u51068 \u52237 \u51060  \u47196 \u47560 \u44368 \u47484  \u54805 \u49457 \u49884 \u53020  \u53360  \u48176 \u44368 \u47484  \u51068 \u51004 \u53040 \u45912  \u53440 \u54801 \u51201  \u48169 \u52840 \u51012  \u45796 \u49884  \u49324 \u50857 \u54616 \u44172  \u46104 \u50632 \u45796 . \u44536 \u45716  \u44536 \u47532 \u49828 \u46020 \u51064 \u46308 \u51012  \u50976 \u54841 \u54616 \u50668  \u44536 \u46308 \u47196  \u54616 \u50668 \u44552  \u45796 \u49888 \u44368 \u46020 \u45716  \u50500 \u45768 \u51648 \u47564  \u49352 \u44200 \u49436  \u47564 \u46304  \u50864 \u49345 \u51012  \u49452 \u44592 \u45716  \u44163 \u44284  \u45796 \u47492 \u50630 \u51060  \u51060  \u49464 \u49345  \u49324 \u47932 \u50640  \u47792 \u46160 \u46108  \u51088 \u46308 \u44284  \u50672 \u54633 \u54616 \u46020 \u47197  \u47564 \u46308 \u50632 \u45796 . \u51060 \u50752  \u44057 \u51008  \u50672 \u54633 \u51004 \u47196  \u50715  \u49884 \u45824 \u48372 \u45796  \u45908 \u50865  \u49900 \u54620  \u54644 \u46021 \u51012  \u45180 \u52824 \u45716  \u44208 \u44284 \u47484  \u48730 \u50612 \u45236 \u50632 \u44256 , \u51333 \u44368 \u46972 \u45716  \u44032 \u47732  \u50500 \u47000  \u44368 \u47564 \u44284  \u49324 \u52824 \u47484  \u47560 \u51020 \u45824 \u47196  \u51088 \u46993 \u54616 \u48064 \u47196  \u44368 \u54924 \u46308 \u51008  \u48512 \u54056 \u54616 \u50668 \u51276 \u45796 . \u49324 \u45800 \u51008  \u44228 \u49549 \u54616 \u50668  \u49457 \u44221 \u51032  \u44368 \u47532 \u47484  \u50780 \u44257 \u49884 \u53040 \u44256 , \u47924 \u49688 \u54620  \u49324 \u46988 \u46308 \u51012  \u47736 \u47581 \u51004 \u47196  \u51064 \u46020 \u54620  \u50976 \u51204 \u46308 \u51060  \u44618 \u51060  \u49100 \u47532 \u47484  \u48149 \u44172  \u54616 \u50688 \u45796 . \u44368 \u54924 \u45716  \'93\u49457 \u46020 \u50640 \u44172  \u45800 \u48264 \u50640  \u51452 \u49888  \u48127 \u51020 \'94\u51012  \u50948 \u54616 \u50668  \u53804 \u51137 \u54616 \u45716  \u45824 \u49888 \u50640  \u44536  \u50976 \u51204 \u46308 \u51012  \u51648 \u51648 \u54616 \u44256  \u48320 \u54840 \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44060 \u54785 \u51088 \u46308 \u51060  \u47566 \u51008  \u44256 \u45212 \u51012  \u45817 \u54616 \u47732 \u49436  \u49464 \u50868  \u50896 \u52825 \u46308 \u51012  \u51204 \u46973 \u49884 \u53040 \u45796 .\
