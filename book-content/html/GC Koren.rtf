\uc0\u52395 \u51704  \u52380 \u49324 \u51032  \u44592 \u48324 \u50640  \u51032 \u54616 \u50668  \u49440 \u54252 \u46108  \u44536 \u47532 \u49828 \u46020 \u51032  \u51116 \u47548 \u51008  \u49888 \u46993 \u51060  \u50724 \u45716  \u44163 \u51004 \u47196  \u45208 \u53440 \u45208  \u51080 \u45796 \u44256  \u51060 \u54644 \u46104 \u50632 \u45796 . \u44536 \u47532 \u49828 \u46020 \u51032  \u51116 \u47548 \u51060  \u44032 \u44637 \u45796 \u45716  \u49440 \u54252  \u50500 \u47000  \u45328 \u47532  \u48372 \u44553 \u46108  \u44060 \u54785  \u50868 \u46041 \u51008  \u52376 \u45376 \u46308 \u51060  \u47560 \u51473  \u45208 \u44032 \u45716  \u44163 \u51004 \u47196  \u54644 \u49437 \u46104 \u50632 \u45796 . \u51060  \u48708 \u50976 \u50640 \u45716  \u47560 \u53468 \u48373 \u51020  24\u51109 \u50640 \u49436 \u52376 \u47100  \u46160  \u48512 \u47448 \u44032  \u51228 \u49884 \u46104 \u50612  \u51080 \u45796 . \u46160  \u48512 \u47448 \u45716  \u47784 \u46160  \u46321 , \u44263  \u49457 \u44221 \u51012  \u44032 \u51648 \u44256  \u44536  \u48731 \u51012  \u51032 \u51648 \u54616 \u50668  \u49888 \u46993 \u51012  \u47582 \u51004 \u47084  \u45208 \u50500 \u44052 \u45796 . \u44536 \u47088 \u45936  \u48120 \u47144 \u54620  \u51088 \u46308 \u51008  \'93\u46321 \u51012  \u44032 \u51648 \u46104  \u44592 \u47492 \u51012  \u44032 \u51648 \u51648  \u50500 \u45768 \u54616 \'94\u50688 \u51004 \u45208  \u49836 \u44592  \u51080 \u45716  \u51088 \u46308 \u51008  \'93\u44536 \u47495 \u50640  \u44592 \u47492 \u51012  \u45812 \u50500  \u46321 \u44284  \u54632 \u44760  \u44032 \u51256 \u44052 \'94\u45796 . \u54980 \u51088 \u51032  \u48512 \u47448 \u50640  \u49549 \u54620  \u49324 \u46988 \u46308 \u51008  \u54616 \u45208 \u45784 \u51032  \u51008 \u54812 , \u44263  \u44144 \u46317 \u45208 \u44172  \u54644 \u51452 \u44256  \u49900 \u47161 \u51012  \u44648 \u50864 \u52432  \u51452 \u45716  \u49457 \u47161 \u51032  \u45733 \u47141 \u51012  \u48155 \u50520 \u45716 \u45936 , \u44536  \u45733 \u47141 \u51060  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51012  \u48156 \u50640  \u46321 \u51060  \u46104 \u44172  \u54616 \u44256  \u44600 \u50640  \u48731 \u51060  \u46104 \u44172  \u54644 \u51456 \u45796 . \u54616 \u45208 \u45784 \u51012  \u46160 \u47140 \u50892 \u54616 \u45716  \u51473 \u50640  \u44536 \u46308 \u51008  \u51652 \u47532 \u47484  \u48176 \u50864 \u44592  \u50948 \u54616 \u50668  \u49457 \u44221 \u51012  \u50672 \u44396 \u54616 \u50688 \u44256 , \u49373 \u50528 \u50752  \u49900 \u47161 \u51032  \u49692 \u44208 \u51012  \u50619 \u44592  \u50948 \u54616 \u50668  \u50676 \u47148 \u54616 \u44172  \u45432 \u47141 \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u46308 \u51008  \u49892 \u47581 \u51060 \u45208  \u51648 \u52404 \u47196  \u50517 \u46020 \u45817 \u54616 \u45716  \u51068 \u51060  \u50630 \u51060  \u54616 \u45208 \u45784 \u44284  \u44536 \u48516 \u51032  \u47568 \u50432 \u51012  \u48127 \u45716  \u48127 \u51020 \u51012  \u44060 \u51064 \u51032  \u49373 \u50528 \u50640 \u49436  \u52404 \u54744 \u54616 \u44172  \u46104 \u50632 \u45796 . \u44536 \u47084 \u45208  \u45796 \u47480  \u48512 \u47448 \u51032  \u49324 \u46988 \u46308 \u51008  \'93\u46321 \u51012  \u44032 \u51648 \u46104  \u44592 \u47492 \u51012  \u44032 \u51648 \u51648  \u50500 \u45768 \u54616 \'94\u50688 \u45796 . \u44536 \u46308 \u51008  \u45796 \u47564  \u52649 \u46041 \u50640  \u51032 \u54616 \u50668  \u50880 \u51649 \u50688 \u45796 . \u44536 \u46308 \u51008  \u44536  \u50628 \u49689 \u54620  \u44592 \u48324 \u51012  \u46307 \u44256  \u46160 \u47140 \u50892 \u54616 \u45716  \u47560 \u51020 \u51012  \u44032 \u51276 \u45796 . \u44536 \u47084 \u45208  \u44536 \u46308 \u51008  \u54805 \u51228 \u46308 \u51032  \u49888 \u50521 \u50640  \u51032 \u51316 \u54616 \u50688 \u44256 , \u51652 \u47532 \u50640  \u45824 \u54620  \u52649 \u48516 \u54620  \u51060 \u54644 \u45208  \u47560 \u51020 \u49549 \u50640  \u51008 \u54812 \u51032  \u51652 \u49892 \u54620  \u50669 \u49324 \u44032  \u5