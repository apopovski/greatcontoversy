\uc0\u44396 \u51452 \u44760 \u49436  \u51648 \u49345 \u50640 \u49436  \u48393 \u49324  \u49373 \u50528 \u47484  \u54616 \u49884 \u45716  \u46041 \u50504  \u44536 \u47532 \u49828 \u46020 \u50752  \u49324 \u45800  \u49324 \u51060 \u50640  \u51204 \u44060 \u46108  \u53804 \u51137 \u51060  \u45824 \u44592 \u47564 \u51088 \u51032  \u54408 \u49457 \u51012  \u46300 \u47084 \u45256 \u45796 . \u44536 \u44032  \u49464 \u49345 \u51032  \u44396 \u51452 \u44760  \u51088 \u54665 \u54620  \u51092 \u51064 \u54620  \u44277 \u44201 \u47564 \u53372  \u52380 \u49324 \u46308 \u44284  \u52649 \u49457 \u46108  \u50728  \u50864 \u51452  \u44144 \u48124 \u46308 \u51032  \u50528 \u51221 \u51012  \u49324 \u45800 \u50640 \u44172 \u49436  \u54952 \u44284 \u51201 \u51004 \u47196  \u44540 \u51208 \u49884 \u53416  \u44163 \u51008  \u50630 \u51012  \u44163 \u51060 \u45796 . \u44536 \u47532 \u49828 \u46020 \u44760  \u51088 \u44592 \u50640 \u44172  \u44221 \u48176 \u54616 \u46020 \u47197  \u50836 \u44396 \u54620  \u46020 \u51204 \u51201 \u51064  \u47784 \u46021 , \u44536 \u47484  \u49328 \u44845 \u45824 \u44592 \u50752  \u49457 \u51204  \u44845 \u45824 \u44592 \u47196  \u45936 \u47532 \u44256  \u44036  \u52280 \u46988 \u46104 \u44256  \u50724 \u47564 \u54620  \u51068 , \u50501 \u51032 \u47484  \u54408 \u44256  \u54788 \u44592 \u51613 \u51060  \u45216  \u51221 \u46020 \u47196  \u45458 \u51008  \u44275 \u50640 \u49436  \u46832 \u50612 \u45236 \u47532 \u46972 \u44256  \u44428 \u50976 \u54620  \u51068 , \u45130 \u51076 \u50630 \u45716  \u47784 \u47029 \u51004 \u47196  \u51452 \u45784 \u51012  \u50668 \u44592 \u51200 \u44592  \u46384 \u46972 \u45796 \u45768 \u47732 \u49436  \u52293 \u51105 \u44256 \u51088  \u54620  \u51068 , \u51228 \u49324 \u51109 \u44284  \u48177 \u49457 \u46308 \u51012  \u49440 \u46041 \u54616 \u50668  \u44536 \u48516 \u51032  \u49324 \u46993 \u51012  \u44144 \u51208 \u54616 \u44172  \u54616 \u44256  \u47560 \u52840 \u45236  \'93\u49901 \u51088 \u44032 \u50640  \u47803  \u48149 \u44172