\uc0\u49324 \u45800 \u51008  \u44053 \u49888 \u49696 \u51012  \u53685 \u54616 \u50668  \u51064 \u47448 \u50640 \u44172  \u51008 \u54812 \u47484  \u48288 \u54392 \u45716  \u51088 \u52376 \u47100  \u45208 \u53440 \u45208 \u49436  \u49324 \u46988 \u46308 \u51032  \u51656 \u48337 \u51012  \u44256 \u52432  \u51452 \u44256  \u49352 \u47213 \u44256  \u45908 \u50865  \u44256 \u49345 \u54620  \u51333 \u44368 \u51201  \u49888 \u50521 \u51012  \u51228 \u49884 \u54644  \u51452 \u45716  \u44163 \u52376 \u47100  \u44277 \u50616 \u54620 \u45796 . \u44536 \u47084 \u45208  \u46041 \u49884 \u50640  \u44536 \u45716  \u54028 \u44340 \u51088 \u47196 \u49436  \u54876 \u46041 \u54616 \u44172  \u46108 \u45796 . \u44536 \u51032  \u50976 \u54841 \u51008  \u47924 \u49688 \u54620  \u47924 \u47532 \u47484  \u47736 \u47581 \u51004 \u47196  \u51060 \u45132 \u50612 \u44032 \u44256  \u51080 \u45796 . \u48512 \u51208 \u51228 \u45716  \u49324 \u46988 \u51032  \u51060 \u49457 \u51012  \u47560 \u48708 \u49884 \u53020  \u48260 \u47532 \u44256  \u48169 \u51333 \u44284  \u53804 \u51137 \u44284  \u50976 \u54792 \u51060  \u46384 \u47476 \u44172  \u46108 \u45796 . \u49324 \u45800 \u51008  \u51204 \u51137 \u51012  \u51339 \u50500 \u54620 \u45796 . \u50780 \u45264 \u54616 \u47732  \u51204 \u51137 \u51008  \u49324 \u46988 \u51032  \u44032 \u51109  \u50501 \u54620  \u44048 \u51221 \u51012  \u51088 \u44537 \u54616 \u47728  \u51204 \u51137 \u51032  \u55148 \u49373 \u51088 \u46308 \u51012  \u51396 \u50501 \u44284  \u50976 \u54792  \u49549 \u51004 \u47196  \u50689 \u50896 \u55176  \u50424 \u50612 \u45347 \u50612  \u48260 \u47532 \u44592  \u46412 \u47928 \u51060 \u45796 . \u45208 \u46972 \u44032  \u45796 \u47480  \u45208 \u46972 \u47484  \u45824 \u51201 \u54616 \u50668  \u49912 \u50864 \u46020 \u47197  \u51088 \u44537 \u54616 \u45716  \u44163 \u51060  \u49324 \u45800 \u51032  \u47785 \u51201 \u51060 \u45796 . \u44536 \u47111 \u44172  \u54632 \u51004 \u47196  \u44536 \u45716  \u49324 \u46988 \u46308 \u51032  \u47560 \