\uc0\u54616 \u45208 \u45784 \u44760  \u45824 \u54620  \u48520 \u49888 \u51008  \u54616 \u45208 \u45784 \u44284  \u50896 \u49688  \u44288 \u44228 \u50640  \u45459 \u50668  \u51080 \u45716  \u51473 \u49373 \u54616 \u51648  \u47803 \u54620  \u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u50640 \u49436  \u54596 \u50672 \u51201 \u51004 \u47196  \u49373 \u44592 \u45716  \u44208 \u44284 \u51060 \u45796 . \u44536 \u47084 \u45208  \u48127 \u51020 \u51008  \u49457 \u47161 \u51004 \u47196  \u47568 \u48120 \u50516 \u50500  \u44256 \u52712 \u46104 \u47728 , \u44536 \u44163 \u51012  \u47560 \u51020 \u50640  \u44036 \u51649 \u54632 \u51004 \u47196 \u50024 \u47564  \u50773 \u49457 \u54644 \u51656  \u44163 \u51060 \u45796 . \u50612 \u46500  \u49324 \u46988 \u51060 \u46304 \u51648  \u45130 \u51076 \u50630 \u51060  \u45432 \u47141 \u54616 \u51648  \u50506 \u44256 \u49436 \u45716  \u48127 \u51020 \u51012  \u44053 \u54616 \u44172  \u54624  \u49688  \u50630 \u45796 . \u48520 \u49888  \u50669 \u49884  \u51312 \u51109 \u54632 \u51004 \u47196 \u50024  \u44053 \u54644 \u51652 \u45796 . \u44536 \u47084 \u48064 \u47196  \u47564 \u51068  \u49324 \u46988 \u46308 \u51060  \u44536 \u46308 \u51032  \u48127 \u51020 \u51012  \u51648 \u53489 \u54616 \u46020 \u47197  \u54616 \u45208 \u45784 \u44760 \u49436  \u51452 \u49888  \u51613 \u44144 \u47484  \u47560 \u51020 \u50640  \u44036 \u51649 \u54616 \u45716  \u45824 \u49888 \u50640  \u44536 \u46308  \u49828 \u49828 \u47196 \u47484  \u51032 \u49900 \u54616 \u44256  \u53944 \u51665  \u51105 \u45716  \u51068 \u50640  \u47792 \u46160 \u54624  \u44163  \u44057 \u51004 \u47732  \u44536 \u46308 \u51032  \u51032 \u49900 \u51008  \u44228 \u49549 \u54616 \u50668  \u45908 \u50865  \u44403 \u50612 \u51256 \u44048 \u51012  \u44648 \u45803 \u44172  \u46112  \u44163 \u51060 \u45796 .\
\uc0\u44536 \u47084 \u45208  \u54616 \u45208 \u45784 \u51032  \u54728 \u46973 \u51012  \u51032 \u49900 \u54616 \u44256  \u44536 \u48516 \u51032  \u51008 \u54812 \u51032  \u48372 \u51613 \u51012  \u48127 \u51648  \u50506 \u45716  \u51088 \u46308 \u51008  \u54616 \u45208 \u45784 \u44760  \u50837 \u51012  \u46028 \u47532 \u44256  \u51080 \u45796 . \u44536 \u47084 \u48064 \u47196  \u44536 \u46308 \u51032  \u44048 \u54868 \u45716  \u45796 \u47480  \u49324 \u46988 \u46308 \u51012  \u44536 \u47532 \u49828 \u46020 \u44760 \u47196  \u51060 \u45132 \u50612  \u51452 \u45716  \u45824 \u49888 \u50640  \u46020 \u47532 \u50612  \u44536 \u48516 \u50640 \u44172 \u49436  \u46496 \u45208 \u44032 \u44172  \u54616 \u45716  \u44221 \u54693 \u51060  \u51080 \u45796 . \u44536 \u46308 \u51008  \u47680 \u47532  \u44536 \u47532 \u44256  \u45331 \u51008  \u48276 \u50948 \u44620 \u51648  \u50612 \u46160 \u50868  \u44032 \u51648 \u46308 \u51012  \u48855 \u44256 , \u45796 \u47480  \u45208 \u47924 \u50640  \u48708 \u52832  \u54663 \u48731 \u51012  \u47561 \u50500  \u48260 \u47532 \u48064 \u47196  \u44536  \u45208 \u47924 \u46308 \u51012  \u52268  \u44536 \u45720  \u50500 \u47000 \u49436  \u49884 \u46308 \u50612  \u47568 \u46972 \u51453 \u44172  \u54616 \u45716  \u50676 \u47588  \u50630 \u45716  \u45208 \u47924 \u46308 \u51060 \u45796 . \u51060 \u47088  \u49324 \u46988 \u46308 \u51032  \u54217 \u49373  \u50629 \u51201 \u51008  \u44536 \u46308 \u50640  \u45824 \u54620  \u44208 \u53076  \u51648 \u50892 \u48260 \u47540  \u49688  \u50630 \u45716  \u51613 \u44144 \u47196 \u50024  \u45208 \u53440 \u45216  \u44163 \u51060 \u45796 . \u44536 \u46308 \u51008  \u53952 \u47548 \u50630 \u51060  \u49688 \u54869 \u54616 \u44256 \u50556  \u47568  \u51032 \u54841 \u44284  \u48520 \u49888 \u51032  \u50472 \u47484  \u49100 \u47532 \u44256  \u51080 \u45796 .\
\uc0\u51032 \u49900 \u50640 \u49436  \u48279 \u50612 \u45208 \u44592 \u47484  \u51652 \u51221 \u51004 \u47196  \u55148 \u47581 \u54616 \u45716  \u49324 \u46988 \u46308 \u51060  \u52712 \u54624  \u50976 \u51068 \u51032  \u44600 \u51060  \u51080 \u45796 . \u44536 \u46308 \u51008  \u44536 \u46308 \u51060  \u51060 \u54644 \u54624  \u49688  \u50630 \u45716  \u44163 \u50640  \u44288 \u54616 \u50668  \u51032 \u49900 \u54616 \u44256  \u53944 \u51665  \u51105 \u45716  \u45824 \u49888 \u50640  \u51060 \u48120  \u44536 \u46308 \u50640 \u44172  \u48708 \u52628 \u50612 \u51652  \u48731 \u50640  \u50976 \u51032 \u54644 \u50556  \u54620 \u45796 . \u44536 \u47532 \u54616 \u47732  \u44536 \u46308 \u51008  \u45908 \u50865  \u53360  \u48731 \u51012  \u48155 \u44172  \u46112  \u44163 \u51060 \u45796 . \u44536 \u46308 \u51008  \u44536 \u46308 \u51060  \u48516 \u47749 \u55176  \u44648 \u45804 \u51008  \u47784 \u46304  \u51032 \u47924 \u47484  \u51060 \u54665 \u54644 \u50556  \u54620 \u45796 . \u44536 \u47532 \u54616 \u47732  \u44536 \u46308 \u51008  \u54788 \u51116  \u51032 \u47928 \u51012  \u54408 \u44256  \u51080 \u45716  \u47784 \u46304  \u44163 \u46308 \u51012  \u51060 \u54644 \u54616 \u44256  \u51060 \u54665 \u54624  \u49688  \u51080 \u44172  \u46112  \u44163 \u51060 \u45796 .\
\uc0\u49324 \u45800 \u51008  \u51652 \u47532 \u50752  \u45320 \u47924 \u45208  \u55137 \u49324 \u54620  \u47784 \u51312 \u47932 \u51012  \u51228 \u49884 \u54616 \u48064 \u47196  \u51652 \u47532 \u44032  \u50836 \u44396 \u54616 \u45716  \u44537 \u44592 \u50752  \u55148 \u49373 \u51012  \u51339 \u50500 \u54616 \u51648  \u50506 \u44256  \u49549 \u51076 \u49688 \u50640  \u48736 \u51648 \u44592 \u47484  \u51339 \u50500 \u54616 \u45716  \u51088 \u46308 \u51012  \u49549 \u51064 \u45796 . \u44536 \u47084 \u45208  \u48708 \u47197  \u50612 \u46496 \u54620  \u55148 \u49373 \u51012  \u52824 \u47476 \u44256 \u49436 \u46972 \u46020  \u51652 \u47532 \u47484  \u50508 \u44256 \u51088  \u51221 \u51649 \u54616 \u44172  \u48148 \u46972 \u45716  \u49324 \u46988 \u51008  \u54620  \u49324 \u46988 \u46020  \u49324 \u45800 \u51060  \u51088 \u49888 \u51032  \u44428 \u49464  \u50500 \u47000  \u48537 \u46308 \u50612  \u46168  \u49688  \u50630 \u45796 . \u44536 \u47532 \u49828 \u46020 \u45716  \u51652 \u47532 \u51060 \u47728 , \'93\u49464 \u49345 \u50640  \u50752 \u49436  \u44033  \u49324 \u46988 \u50640 \u44172  \u48708 \u52712 \u45716  \u48731 \'94 (\u50836  1:9) \u51060 \u49884 \u45796 . \u51652 \u47532 \u51032  \u50689 \u51008  \u49324 \u46988 \u46308 \u51012  \u47784 \u46304  \u51652 \u47532  \u44032 \u50868 \u45936 \u47196  \u51064 \u46020 \u54616 \u44592  \u50948 \u54616 \u50668  \u48372 \u45236 \u49888  \u48148  \u46104 \u50632 \u45796 . \u44536 \u47532 \u44256  \u54616 \u45208 \u45784 \u51032  \u50500 \u46308 \u51032  \u44428 \u50948 \u47196  \'93\u44396 \u54616 \u46972  \u44536 \u47084 \u47732  \u45320 \u55148 \u50640 \u44172  \u51452 \u49892  \u44163 \u51060 \u50836 \'94 (\u47560  7:7), \'93\u49324 \u46988 \u51060  \u54616 \u45208 \u45784 \u51032  \u46907 \u51012  \u54665 \u54616 \u47140  \u54616 \u47732  \u51060  \u44368 \u54984 \u51060  \u54616 \u45208 \u45784 \u44760 \u47196 \u49436  \u50772 \u45716 \u51648  \u45236 \u44032  \u49828 \u49828 \u47196  \u47568 \u54632 \u51064 \u51648