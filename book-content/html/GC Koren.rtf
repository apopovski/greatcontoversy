\uc0\u48277 \u50773 \u44368 \u46020 \u46308 \u51008  \u50948 \u53364 \u47532 \u54532 \u44032  \u49332 \u50500  \u51080 \u51012  \u46041 \u50504 \u50640  \u44536 \u46308 \u51032  \u46907 \u51012  \u51060 \u47336 \u51648  \u47803 \u54616 \u50688 \u45796 . \u44536 \u47084 \u48064 \u47196  \u44536 \u51032  \u47800 \u51060  \u47924 \u45924 \u50640 \u49436  \u51312 \u50857 \u55176  \u49772 \u44256  \u51080 \u51012  \u46041 \u50504 \u50640 \u46020  \u44536 \u46308 \u51032  \u51613 \u50724 \u49900 \u51008  \u52649 \u51313 \u46104 \u51648  \u47803 \u54616 \u50688 \u45796 . \u44536 \u44032  \u51453 \u51008  \u51648  40\u50668  \u45380  \u54980 \u50640  \u50676 \u47536  \u53080 \u49828 \u53444 \u49828  \u54924 \u51032 \u51032  \u44208 \u51032 \u50640  \u51032 \u54616 \u50668 , \u44536 \u51032  \u50976 \u44264 \u51012  \u45796 \u49884  \u54028 \u45236 \u50612  \u44277 \u51473  \u50526 \u50640 \u49436  \u48520 \u53468 \u50864 \u44256 , \u44536  \u51116 \u47484  \u44536  \u44540 \u52376 \u50640  \u55120 \u47476 \u44256  \u51080 \u45716  \u49884 \u45255 \u47932 \u50640  \u45912 \u51256  \u48260 \u47160 \u45796 . \u44536  \u49324 \u49892 \u50640  \u45824 \u54616 \u50668  \u50715 \u45216 \u51032  \u54620  \u51200 \u49696 \u44032 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u54664 \u45796 . \'93\u51060  \u49884 \u45255 \u47932 \u51008  \u44536  \u51116 \u47484  \u50500 \u48376  \u49884 \u45236 \u47196 , \u50500 \u48376  \u49884 \u45236 \u45716  \u49464 \u48260 \u50616  \u44053 \u51004 \u47196 , \u49464 \u48260 \u50616  \u44053 \u51008  \u50689 \u44397  \u54644 \u54801 \u51004 \u47196 , \u50689 \u44397  \u54644 \u54801 \u51008  \u45824 \u50577 \u51004 \u47196  \u50734 \u44200  \u51452 \u50632 \u45796 . \u44536 \u47532 \u54616 \u50668  \u50948 \u53364 \u47532 \u54532 \u51032  \u51116 \u45716  \u50724 \u45720 \u45216  \u50728  \u49464 \u49345 \u50640  \u54140 \u51256  \u51080 \u45716  \u44536 \u51032  \u44368 \u47532 \u47484  \u49345 \u51669 \u54616 \u44256  \u51080 \u45796 \'94 (T.Fuller, Church History of Britain, b.4, sec.2, par.54). \u44536 \u51032  \u50896 \u49688 \u46308 \u51008  \u51088 \u49888 \u46308 \u51032  \u50501 \u51032 \u50640  \u52268  \u54665 \u46041 \u51060  \u47924 \u50631 \u51012  \u51032 \u48120 \u54616 \u44256  \u51080 \u45716 \u51648  \u44144 \u51032  \u44648 \u45803 \u51648  \u47803 \u54616 \u50688 \u45796 . \u48372 \u54756 \u48120 \u50500 \u51032  \u50560  \u54980 \u49828  (John Huss) \u44032  \u47196 \u47560 \u44368 \u51032  \u47566 \u51008  \u50724 \u47448 \u47484  \u48260 \u47532 \u44256  \u44060 \u54785  \u49324 \u50629 \u51012  \u52265 \u49688 \u54620  \u44163 \u51008  \u50948 \u53364 \u47532 \u54532 \u51032  \u51200 \u49436 \u47484  \u53685 \u54644 \u49436 \u50688 \u45796 . \u44536  \u46160  \u45208 \u46972 \u45716  \u47680 \u47532  \u46504 \u50612 \u51256  \u51080 \u50632 \u51648 \u47564 , \u51652 \u47532 \u51032  \u50472 \u45716  \u44536 \u50752  \u44057 \u51008  \u48169 \u48277 \u51004 \u47196  \u49100 \u47140 \u51276 \u45796 . \u44536  \u49324 \u50629 \u51008  \u48372 \u54756 \u48120 \u50500 \u50640 \u49436  \u45796 \u47480  \u45208 \u46972 \u47196  \u54869 \u51109 \u46104 \u50612  \u45208 \u44052 \u45796 . \u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u51008  \u50724 \u47019 \u46041 \u50504  \u51082 \u50612 \u48260 \u47160 \u45912  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51004 \u47196  \u46028 \u50500 \u44032 \u44172  \u46104 \u50632 \u45796 . \u54616 \u45208 \u45784 \u51032  \u49552 \u51060  \u50948 \u45824 \u54620  \u51333 \u44368 \u44060 \u54785 \u51032  \u44600 \u51012  \u51456 \u48708 \u54616 \u44256  \u51080 \u50632 \u45796 .\
