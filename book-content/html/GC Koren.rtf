\uc0\u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u48152 \u50669 \u51032  \u51221 \u49888 \u50640  \u45824 \u54616 \u50668  \u54800 \u50724 \u44048 \u51012  \u45208 \u53440 \u45236 \u49512 \u45796 . \u50728  \u54616 \u45720 \u51008  \u54616 \u45208 \u45784 \u51032  \u44277 \u51032 \u44032  \u49324 \u45800 \u51012  \u51221 \u51396 \u54616 \u44256  \u51064 \u47448 \u47484  \u44396 \u50896 \u54616 \u45716  \u51068 \u50640  \u45796  \u44057 \u51060  \u45208 \u53440 \u45228 \u51020 \u51012  \u48372 \u50520 \u45796 . \u47336 \u49828 \u48296 \u51008  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51060  \u48320 \u44221 \u46112  \u49688  \u50630 \u44256  \u44536  \u54805 \u48268 \u51060  \u44221 \u44048 \u46112  \u49688  \u50630 \u45796 \u47732  \u50984 \u48277 \u51012  \u48276 \u54616 \u45716  \u47784 \u46304  \u51088 \u44032  \u52285 \u51312 \u51452 \u51032  \u51008 \u52509 \u50640 \u49436  \u50689 \u50896 \u55176  \u51228 \u50808 \u46104 \u50612 \u50556  \u54620 \u45796 \u44256  \u51452 \u51109 \u54644  \u50772 \u50632 \u45796 . \u44536 \u45716  \u51396 \u50640  \u48736 \u51652  \u51064 \u47448 \u44032  \u54616 \u45208 \u45784 \u51032  \u44396 \u50896 \u51032  \u48276 \u50948  \u48150 \u50640  \u51080 \u51004 \u48064 \u47196  \u51088 \u44592 \u51032  \u51221 \u45817 \u54620  \u54252 \u47196 \u44032  \u46104 \u50632 \u45796 \u44256  \u51452 \u51109 \u54644  \u50772 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u51064 \u47448 \u47484  \u50948 \u54616 \u50668  \u46028 \u50500 \u44032 \u49888  \u49324 \u49892 \u51008  \u46020 \u47924 \u51648  \u44734 \u51012  \u49688  \u50630 \u45716  \u45436 \u51613 \u51060  \u46104 \u50632 \u45796 . \u54616 \u45208 \u45784 \u44284  \u46041 \u46321 \u46104 \u45716  \u44536 \u48516 \u44760 \u49436  \u50984 \u48277 \u51032  \u54805 \u48268 \u51012  \u48155 \u51004 \u49884 \u48064 \u47196  \u51064 \u47448 \u45716  \u44536 \u47532 \u49828 \u46020 \u51032  \u51032 \u47484  \u48155 \u50500 \u46308 \u51068  \u49688  \u51080 \u45716  \u51088 \u50976 \u51032  \u47800 \u51060  \u46104 \u44256  \u44216 \u49552 \u44284  \u54924 \u44060 \u51032  \u49373 \u50528 \u47196 \u50024  \u47560 \u52824  \u54616 \u45208 \u45784 \u51032  \u50500 \u46308 \u51060  \u49849 \u47532 \u54616 \u49888  \u44163 \u52376 \u47100 , \u51060 \u44200 \u49436  \u49324 \u45800 \u51032  \u44428 \u49464 \u47484  \u44648 \u46888 \u47540  \u49688  \u51080 \u44172  \u46104 \u50632 \u45796 . \u51060 \u50752  \u44057 \u51060  \u54616 \u45208 \u45784 \u51008  \u44277 \u51032 \u47196 \u50864 \u49884 \u47728  \u46608 \u54620  \u50696 \u49688 \u45784 \u51012  \u48127 \u45716  \u47784 \u46304  \u49324 \u46988 \u51012  \u51032 \u47213 \u45796 \u44256  \u54616 \u49884 \u45716  \u48516 \u51060 \u49884 \u45796 .\
\uc0\u44536 \u47084 \u45208  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u49464 \u49345 \u50640  \u50724 \u49492 \u49436  \u44256 \u45212 \u51012  \u45817 \u54616 \u49884 \u44256  \u49324 \u47581 \u51012  \u47579 \u48372 \u49888  \u44163 \u51008  \u51064 \u47448 \u51032  \u44396 \u49549 \u51012  \u50756 \u49457 \u54616 \u44592  \u50948 \u54644 \u49436 \u47564 \u51060  \u50500 \u45768 \u50632 \u45796 . \u51452 \u45784 \u44760 \u49436 \u45716  \u46608 \u54620  \u50984 \u48277 \u51012  \u53356 \u44172  \u54616 \u44256  \u51316 \u44480 \u52992  \u54616 \u44592  \u50948 \u54616 \u50668  \u50724 \u49512 \u45796 . \u50984 \u48277 \u51008  \u47560 \u46405 \u55176  \u51316 \u51473 \u51012  \u48155 \u50500 \u50556  \u54616 \u45716 \u48148  \u44536 \u48516 \u44760 \u49436  \u50724 \u49888  \u44163 \u51008  \u51060  \u49464 \u49345 \u51032  \u44144 \u48124 \u46308 \u51060  \u50984 \u48277 \u51012  \u44536 \u52376 \u47100  \u51316 \u51473 \u55176  \u50668 \u44592 \u46020 \u47197  \u54616 \u44592  \u50948 \u54644 \u49436 \u49104 \u47564  \u50500 \u45768 \u46972  \u50864 \u51452 \u51032  \u47784 \u46304  \u49464 \u44228 \u50640  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51060  \u48320 \u44221 \u46112  \u49688  \u50630 \u45796 \u45716  \u44163 \u51012  \u51077 \u51613 \u54616 \u44592  \u50948 \u54632 \u51060 \u50632 \u45796 . \u47564 \u51068  \u50984 \u48277 \u51032  \u50836 \u44396 \u44032  \u52712 \u49548 \u46112  \u49688  \u51080 \u50632 \u45796 \u47732  \u54616 \u45208 \u45784 \u51032  \u50500 \u46308 \u51060  \u50984 \u48277 \u51012  \u48276 \u54620  \u51396 \u47484  \u49549 \u54616 \u44592  \u50948 \u54616 \u50668  \u45817 \u49888 \u51032  \u49373 \u47749 \u51012  \u48148 \u52832  \u54596 \u50836 \u44032  \u50630 \u50632 \u51012  \u44163 \u51060 \u45796 . \u44536 \u47532 \u49828 \u46020 \u51032  \u51453 \u51020 \u51008  \u50984 \u48277 \u51032  \u48520 \u48320 \u49457 \u51012  \u51077 \u51613 \u54620 \u45796 . \u47924 \u54620 \u54620  \u49324 \u46993 \u51060  \u50500 \u48260 \u51648  \u54616 \u45208 \u45784 \u44284  \u50500 \u46308 \u51012  \u44053 \u44428 \u54616 \u50668  \u51396 \u51064 \u46308 \u51012  \u44396 \u50896 \u54616 \u44256 \u51088  \u52824 \u47476 \u44172  \u54620  \u55148 \u49373 , \u44263  \u51060  \u49549 \u51396 \u51032  \u44228 \u54925  \u51060 \u50808 \u51032  \u45796 \u47480  \u48169 \u48277 \u51004 \u47196 \u45716  \u54624  \u49688  \u50630 \u50632 \u45912  \u44536  \u55148 \u49373 \u51008  \u44277 \u51032 \u50752  \u51088 \u48708 \u44032  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u44284  \u44536 \u48516 \u51032  \u51221 \u48512 \u51032  \u44592 \u52488 \u44032  \u46108 \u45796 \u45716  \u49324 \u49892 \u51012  \u50728  \u50864 \u51452 \u50640  \u49892 \u51613 \u54644  \u51456 \u45796 .\
\uc0\u47560 \u51648 \u47561  \u49900 \u54032 \u51060  \u51665 \u54665 \u46112  \u46412  \u51396 \u44032  \u51316 \u51116 \u54624  \u50500 \u47924 \u47088  \u51060 \u50976 \u44032  \u50630 \u50632 \u45796 \u45716  \u44163 \u51060  \u48516 \u47749 \u54644 \u51656  \u44163 \u51060 \u45796 . \u50728  \u49464 \u49345 \u51032  \u49900 \u54032 \u51109 \u44760 \u49436  \u49324 \u45800 \u51012  \u54693 \u54616 \u50668  \'93\u45348 \u44032  \u50612 \u52236 \u54616 \u50668  \u45236 \u44172  \u48152 \u50669 \u54616 \u44256  \u45236  \u45208 \u46972 \u51032  \u48177 \u49457 \u46308 \u51012  \u45236 \u44172 \u49436  \u48764 \u50519 \u50500  \u44052 \u45712 \u45264 ?\'94\u44256  \u49900 \u47928 \u54616 \u49892  \u46412  \u51396 \u51032  \u52285 \u49884 \u51088 \u45716  \u50500 \u47924 \u47088  \u48320 \u47749 \u51012  \u54624  \u49688  \u50630 \u51012  \u44163 \u51060 \u45796 . \u47784 \u46304  \u51077 \u51008  \u45803 \u55184  \u44163 \u51060 \u44256  \u47784 \u46304  \u48152 \u50669 \u51032  \u44400 \u49324 \u46308 \u51008  \u50724 \u51649  \u50976 \u44396  \u47924 \u50616 \u54644 \u51656  \u44163 \u51060 \u45796 .\
