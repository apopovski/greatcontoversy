\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u44536 \u45716  \u51312 \u44536 \u47564  \u53960 \u51060 \u46972 \u46020  \u51080 \u51004 \u47732  \u50672 \u44396 \u47484  \u44172 \u51012 \u47532  \u54616 \u51648  \u50500 \u45768 \u54616 \u50688 \u51004 \u47728 , \u51104 \u51088 \u45716  \u49884 \u44036 \u44284  \u49885 \u49324 \u54616 \u45716  \u49884 \u44036 \u44620 \u51648 \u46020  \u47588 \u50864  \u50500 \u45180 \u50632 \u45796 . \u44536 \u45716  \u47924 \u50631 \u48372 \u45796 \u46020  \u49457 \u44221  \u47568 \u50432 \u51012  \u50672 \u44396 \u54616 \u45716  \u45936 \u49436  \u44592 \u49256 \u51012  \u45572 \u47160 \u45796 . \u44536 \u45716  \u49457 \u44221  \u54620  \u44428 \u51060  \u49688 \u46020 \u50896  \u54620  \u51901  \u48317  \u49632 \u49324 \u49836 \u50640  \u47588 \u45804 \u47140  \u51080 \u45716  \u44163 \u51012  \u48156 \u44204 \u54616 \u44256  \u51088 \u51452  \u44536  \u44275 \u51004 \u47196  \u45208 \u50500 \u44052 \u45796 . \u46608 \u54620  \u51396 \u50640  \u45824 \u54620  \u51088 \u44033 \u51060  \u45908 \u50865  \u44618 \u50612 \u51664 \u50640  \u46384 \u46972  \u44536 \u45716  \u51088 \u44592 \u51032  \u54665 \u50948 \u47196  \u50857 \u49436 \u50752  \u54217 \u50504 \u51012  \u50619 \u44256 \u51088  \u50528 \u50044 \u45796 . \u44536 \u45716  \u44032 \u51109  \u50628 \u44201 \u54620  \u49373 \u54876 \u51012  \u54616 \u44256 , \u44552 \u49885 \u44284  \u52384 \u50556 \u47484  \u54616 \u44256 , \u47784 \u46304  \u50501 \u54620  \u49457 \u44201 \u51012  \u44537 \u48373 \u54616 \u47140 \u44256  \u51088 \u44592  \u51088 \u49888 \u51012  \u52292 \u52237 \u51004 \u47196  \u46412 \u47140  \u48372 \u50520 \u51004 \u45208 , \u51060 \u47084 \u54620  \u49688 \u46020 \u50896  \u49373 \u54876 \u51060  \u44536 \u47484  \u51396 \u50640 \u49436  \u54644 \u48169 \u49884 \u53020  \u51452 \u51648  \u47803 \u54616 \u50688 \u45796 . \u44536 \u45716  \u54616 \u45208 \u45784 \u51032  \u51064 \u51221 \u51012  \u48155 \u44592 \u50640  \u54633 \u45817 \u54620  \u47560 \u51020 \u51032  \u49692 \u44208 \u51012  \u50619 \u44592  \u50948 \u54616 \u50668  \u50612 \u46496 \u54620  \u55148 \u49373 \u46020  \u44161 \u45236 \u51648  \u50500 \u45768 \u54616 \u50688 \u45796 . \u54980 \u51068 \u50640  \u44536 \u45716  \u45817 \u49884 \u51032  \u51068 \u51012  \u45796 \u51020 \u44284  \u44057 \u51060  \u49696 \u54924 \u54616 \u50688 \u45796 . \'93\u49892 \u47196  \u45208 \u45716  \u44221 \u44148 \u54620  \u49688 \u46020 \u49849 \u51060 \u50632 \u45796 . \u45208 \u45716  \u51648 \u44552  \u45236 \u44032  \u51077 \u51004 \u47196  \u45796  \u54364 \u54788 \u54616 \u44592  \u50612 \u47140 \u50868  \u50668 \u47084  \u44032 \u51648  \u50628 \u44201 \u54620  \u44508 \u52825 \u46308 \u51012  \u51648 \u53040 \u45796 . \u47564 \u51068  \u49688 \u46020 \u49849 \u51060  \u51060 \u47084 \u54620  \u49688 \u46020 \u47196 \u50024  \u52380 \u44397 \u51012  \u50619 \u51012  \u49688  \u51080 \u45796 \u44256  \u54616 \u47732  \u45208 \u45716  \u48516 \u47749 \u55176  \u44536 \u47084 \u54620  \u51088 \u44201 \u51012  \u50619 \u50632 \u51012  \u44163 \u51060 \u45796 . \u44536  \u51068 \u51012  \u51312 \u44552  \u45908  \u44228 \u49549  \u54616 \u50688 \u45796 \u47732 , \u45208 \u45716  \u48152 \u46300 \u49884  \u44256 \u54665 \u51032  \u44208 \u44284 \u47196  \u51453 \u44256  \u47568 \u50520 \u51012  \u44163 \u51060 \u45796 \'94 (D\'92Au-bigne, b.2, ch.3). \u51060 \u47084 \u54620  \u44256 \u53685 \u49828 \u47084 \u50868  \u54984 \u47144 \u51032  \u44208 \u44284 \u47196  \u44536 \u45716  \u44592 \u47141 \u51012  \u51075 \u44256 , \u44221 \u47144 \u51004 \u47196  \u44256 \u49373 \u54616 \u44172  \u46104 \u50632 \u45716 \u45936  \u54980 \u51068 \u50640  \u44032 \u49436 \u46020  \u44536  \u49345 \u53468 \u50640 \u49436  \u50756 \u51204 \u55176  \u54924 \u48373 \u46104 \u51648  \u47803 \u54616 \u50688 \u45796 . \u44536 \u51032  \u50728 \u44054  \u45432 \u47141 \u50640 \u46020  \u48520 \u44396 \u54616 \u44256  \u44536 \u51032  \u50689 \u54844 \u51032  \u51664 \u51008  \u51312 \u44552 \u46020  \u44221 \u44048 \u46104 \u51648  \u50506 \u50520 \u45796 . \u44536 \u45716  \u47560 \u52840 \u45236  \u51208 \u47581  \u51649 \u51204 \u50640  \u51060 \u47476 \u47104 \u45796 .\
\uc0\u47784 \u46304  \u44163 \u51012  \u51075 \u50612 \u48260 \u47536  \u44163 \u52376 \u47100  \u48372 \u50688 \u51012  \u46412  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u44536 \u51032  \u52828 \u44396 \u51064  \u54620  \u49324 \u46988 \u51032  \u51312 \u47141 \u51088 \u47484  \u44536 \u50640 \u44172  \u48372 \u45236  \u51452 \u49512 \u45796 . \u44221 \u44148 \u54620  \u49800 \u53440 \u50864 \u54588 \u52768  (Staupitz) \u45716  \u47336 \u53552 \u50640 \u44172  \u49457 \u44221  \u47568 \u50432 \u51012  \u48372 \u50668  \u51452 \u47728 , \u51088 \u44592  \u51088 \u49888 \u51012  \u48372 \u51648  \u47568 \u44256 , \u46608  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51012  \u48276 \u54616 \u48064 \u47196  \u48155 \u45716  \u50689 \u50896 \u54620  \u54805 \u48268 \u51012  \u49373 \u44033 \u51648  \u47568 \u44256 , \u50724 \u51649  \u44536 \u51032  \u51396 \u47484  \u50857 \u49436 \u54644  \u51452 \u49884 \u45716  \u44396 \u51452  \u50696 \u49688 \u45784 \u51012  \u48148 \u46972 \u48372 \u46972 \u44256  \u54616 \u50688 \u45796 . \'93\u44536 \u45824 \u51032  \u51396 \u47196  \u51064 \u54616 \u50668  \u49828 \u49828 \u47196 \u47484  \u44340 \u47213 \u44172  \u54616 \u45716  \u45824 \u49888 \u50640  \u44396 \u51452 \u51032  \u54036 \u50640  \u44536 \u45824  \u51088 \u49888 \u51012  \u47585 \u44592 \u46972 . \u44536 \u47532 \u44256  \u44536 \u48516 \u51012  \u49888 \u47280 \u54616 \u46972 . \u44536 \u48516 \u51032  \u49373 \u50528 \u50640  \u45208 \u53440 \u45212  \u51032 \u50752  \u44536 \u48516 \u51032  \u51453 \u51004 \u49900 \u51004 \u47196  \u47568 \u48120 \u50516 \u51008  \u49549 \u51396 \u47484  \u49888 \u47280 \u54616 \u46972 . \'85\u54616 \u45208 \u45784 \u51032  \u50500 \u46308 \u51032  \u47568 \u50432 \u51012  \u46308 \u51004 \u46972 . \'85\u44536 \u48516 \u44760 \u49436 \u45716  \u54616 \u45208 \u45784 \u51032  \u51008 \u52509 \u51012  \u44536 \u45824 \u50640 \u44172  \u48372 \u51613 \u54644  \u51452 \u44592  \u50948 \u54616 \u50668  \u49324 \u46988 \u51060  \u46104 \u49512 \u45796 \'94, \'93\u44536 \u45824 \u47484  \u47676 \u51200  \u49324 \u46993 \u54644  \u51452 \u49888  \u44536 \u48516 \u51012  \u49324 \u46993 \u54616 \u46972 \'94 (D\'92Aubigne, b.2, ch.4) \u44256  \u44557 \u55100 \u51032  \u49324 \u51088 \u45716  \u47568 \u54616 \u50688 \u45796 . \u44536 \u51032  \u47568 \u51008  \u47336 \u53552 \u51032  \u47560 \u51020 \u50640  \u44618 \u51008  \u44048 \u47749 \u51012  \u51452 \u50632 \u45796 . \u50724 \u47019 \u46041 \u50504  \u50724 \u47448 \u50640  \u48537 \u51105 \u54784 \u49436  \u53804 \u51137 \u54616 \u44256  \u51080 \u45912  \u44536 \u45716  \u51652 \u47532 \u47484  \u44648 \u45803 \u44172  \u46104 \u50632 \u44256 , \u48264 \u48124 \u54616 \u45912  \u44536 \u51032  \u47560 \u51020 \u50640  \u54217 \u54868 \u44032  \u52286 \u50500 \u50772 \u45796 .\
\uc0\u47336 \u53552 \u45716  \u49888 \u48512 \u47196  \u51076 \u47749 \u46104 \u50612  \u49688 \u46020 \u50896 \u50640 \u49436  \u45208 \u50752  \u48708 \u53584 \u48288 \u47476 \u53356  \u45824 \u54617 \u51032  \u44368 \u49688 \u47196  \u48512 \u47492 \u51012  \u51077 \u50632 \u45796 . \u44536 \u45716  \u50668 \u44592 \u49436  \u50896 \u50612  (\u21407 \u35486 ) \u47196  \u46108  \u49457 \u44221 \u51012  \u50672 \u44396 \u54616 \u50688 \u45796 . \u44536 \u45716  \u49457 \u44221 \u51032  \u44053 \u51032 \u47484  \u49884 \u51089 \u54616 \u50688 \u45796 . \u49884 \u54200 \u44284  \u48373 \u51020 \u49436 \u50752  \u54200 \u51648 \u49436 \u46308 \u50640  \u44288 \u54620  \u44277 \u44060  \u44053 \u51032 \u47484  \u54632 \u51004 \u47196  \u47566 \u51008  \u49324 \u46988 \u46308 \u51060  \u50752 \u49436  \u46307 \u44256  \u44648 \u45803 \u44172  \u46104 \u50632 \u45796 . \u44536 \u51032  \u52828 \u44396 \u50836  \u49688 \u46020 \u50896 \u51109 \u51064  \u49828 \u53440 \u50864 \u54588 \u52768 \u45716  \u44536 \u50640 \u44172  \u44053 \u45800 \u50640 \u49436  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51012  \u44053 \u47200 \u54616 \u46972 \u44256  \u44428 \u50976 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u47336 \u53552 \u45716  \u51088 \u44592 \u44032  \u44536 \u47532 \u49828 \u46020 \u47484  \u45824 \u49888 \u54616 \u50668  \u48177 \u49457 \u51012  \u44032 \u47476 \u52832  \u51088 \u44201 \u51060  \u50630 \u51020 \u51012  \u51088 \u44033 \u54616 \u44256 , \u44536  \u51068 \u51012  \u51452 \u51200 \u54616 \u50688 \u45796 . \u44536 \u45716  \u50724 \u47019 \u46041 \u50504  \u44256 \u49900 \u54620  \u45149 \u50640  \u44536  \u52828 \u44396 \u46308 \u51032  \u44036 \u52397 \u51012  \u48155 \u50500 \u46308 \u50688 \u45796 . \u44536 \u45716  \u51060 \u48120  \u49457 \u44221  \u51648 \u49885 \u50640  \u45733 \u54620  \u49324 \u46988 \u51060  \u46104 \u50612  \u51080 \u50632 \u51004 \u47728 , \u54616 \u45208 \u45784 \u51032  \u51008 \u54812 \u44032  \u44536 \u51032  \u50948 \u50640  \u51076 \u54644  \u51080 \u50632 \u45796 . \u44536 \u51032  \u50885 \u48320 \u51008  \u52397 \u51473 \u46308 \u51012  \u49324 \u47196 \u51105 \u50520 \u45796 . \u44536 \u45716  \u51652 \u47532 \u47484  \u50500 \u51452  \u47749 \u47308 \u54616 \u44256  \u55192  \u51080 \u44172  \u51228 \u49884 \u54616 \u50688 \u51004 \u48064 \u47196  \u46307 \u45716  \u51088 \u50640 \u44172  \u54869 \u49888 \u51012  \u51452 \u50632 \u51004 \u47728 , \u46608  \u44536 \u51032  \u50676 \u51221 \u51008  \u49324 \u46988 \u46308 \u51012  \u44048 \u46041 \u49884 \u53040 \u45796 .\
