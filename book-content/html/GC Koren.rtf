\u51008  \u54616 \u45208 \u45784 \u51032  \u50724 \u47000  \u52280 \u51004 \u49900 \u51012  \u50629 \u49888 \u50668 \u44596  \u44163 \u51060  \u50620 \u47560 \u45208  \u46160 \u47140 \u50868  \u51068 \u51060 \u50632 \u51020 \u51012  \u45734 \u50612 \u49436 \u50556  \u44648 \u45803 \u44172  \u46112  \u44163 \u51060 \u45796 . \u44536  \u46412 \u50640 \u45716  \u51092 \u51064 \u54620  \u49324 \u45800 \u51032  \u49464 \u47141 \u51012  \u50613 \u51228 \u54616 \u44256  \u47924 \u45320 \u46888 \u47532 \u45912  \u54616 \u45208 \u45784 \u51032  \u50689 \u51060  \u44144 \u51032  \u46496 \u45208 \u44032 \u44256  \u49324 \u46988 \u51032  \u48520 \u54665 \u47564 \u51012  \u51600 \u44200  \u50728  \u49324 \u45800 \u51060  \u54616 \u44256 \u51088  \u54616 \u45716  \u45824 \u47196  \u48169 \u52824 \u46108 \u45796 . \u51060 \u47084 \u54620  \u48152 \u50669 \u51012  \u49440 \u53469 \u54620  \u51088 \u46308 \u51008  \u44544 \u47196 \u50024  \u46020 \u51200 \u55176  \u47896 \u49324 \u54624  \u49688  \u50630 \u51012  \u51221 \u46020 \u47196  \u47924 \u49436 \u50868  \u51396 \u50501 \u51060  \u46405 \u50640  \u52649 \u47564 \u54616 \u50668 \u51656  \u46412 \u44620 \u51648  \u44536  \u48152 \u50669 \u51004 \u47196  \u47568 \u48120 \u50516 \u50500  \u49373 \u44596  \u44208 \u49892 \u51012  \u44144 \u46160 \u51648  \u50506 \u51004 \u47732  \u50504  \u46104 \u50632 \u45796 . \u54889 \u54224 \u46108  \u51648 \u48169 \u44284  \u54224 \u54728 \u44032  \u46108  \u46020 \u49884 \u46308 \u47196 \u48512 \u53552  \u47924 \u49436 \u50868  \u48512 \u47476 \u51670 \u51020 , \u44263  \u44032 \u51109  \u50416 \u46972 \u47536  \u44256 \u53685 \u51032  \u48512 \u47476 \u51670 \u51020 \u51060  \u46308 \u47160 \u45796 . \u54532 \u46993 \u49828 \u45716  \u47560 \u52824  \u51648 \u51652 \u51060  \u51068 \u50612 \u45212  \u44163 \u52376 \u47100  \u55124 \u46308 \u47160 \u45796 . \u51333 \u44368 , \u48277 \u47456 , \u49324 \u54924 \u51201  \u51656 \u49436 , \u44032 \u51221 \u51228 \u46020 , \u44397 \u44032 , \u4