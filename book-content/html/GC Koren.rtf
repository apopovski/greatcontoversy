\uc0\u50640 \u49436 \u47484  \u52649 \u46041 \u54616 \u50668  \u50556 \u44273 \u51012  \u54693 \u54616 \u50668  \u44400 \u45824 \u47484  \u51652 \u44400 \u49884 \u53416  \u44163 \u44284  \u46609 \u44057 \u51060  \u49324 \u45800 \u51008  \u54872 \u45212 \u51032  \u46412 \u50640  \u50501 \u54620  \u51088 \u46308 \u51012  \u49440 \u46041 \u54616 \u50668  \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u51012  \u51453 \u51060 \u44256 \u51088  \u54624  \u44163 \u51060 \u45796 . \u50556 \u44273 \u51012  \u48708 \u45212 \u54664 \u45912  \u44163 \u44284  \u46609 \u44057 \u51060  \u44536 \u45716  \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u51012  \u52280 \u49548 \u54616 \u45716  \u51068 \u50640  \u51652 \u47141 \u54624  \u44163 \u51060 \u45796 . \u44536 \u45716  \u49464 \u49345 \u51012  \u44536 \u51032  \u44163 \u51004 \u47196  \u44036 \u51452 \u54620 \u45796 . \u44536 \u47084 \u45208  \u54616 \u45208 \u45784 \u51032  \u44228 \u47749 \u51012  \u51648 \u53412 \u45716  \u51201 \u51008  \u47924 \u47532 \u45716  \u44536 \u51032  \u52572 \u49345 \u44428 \u51012  \u44144 \u48512 \u54616 \u44256  \u51080 \u45796 . \u47564 \u51068  \u44536 \u44032  \u44536 \u46308 \u51012  \u49464 \u49345 \u50640 \u49436  \u51228 \u44144 \u54644  \u48260 \u47540  \u49688 \u47564  \u51080 \u51004 \u47732  \u44536 \u51032  \u49849 \u47532 \u45716  \u50756 \u49457 \u46112  \u44163 \u51060 \u45796 . \u49324 \u45800 \u51008  \u44144 \u47337 \u54620  \u52380 \u49324 \u46308 \u51060  \u44536 \u46308 \u51012  \u48372 \u54840 \u54616 \u44256  \u51080 \u45796 \u45716  \u44163 \u51012  \u50508 \u47728 , \u44536 \u46308 \u51032  \u51396 \u44032  \u50857 \u49436 \u46108  \u44163 \u46020  \u51664 \u51089 \u54620 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u44536 \u46308 \u51032  \u47928 \u51228 \u44032  \u54616 \u45720  \u49457 \u49548 \u50640 \u49436  \u44208 \u51221 \u46108  \u44163 \u51008  \u47784 \u47480 \u45796 . \u49324 \u45800 \u51008  \u44536 \u46308 \u51012  \u50976 \u54841 \u54616 \u50668  \u48276 \u51396 \u52992  \u54620  \u51396 \u47484  \u51221 \u54869 \u54616 \u44172  \u44592 \u50613 \u54616 \u44256  \u51080 \u51004 \u48064 \u47196  \u44536  \u51396 \u47484  \u54616 \u45208 \u45784  \u50526 \u50640  \u44032 \u51109  \u53356 \u44172  \u44284 \u51109 \u54616 \u50668  \u51228 \u49884 \u54616 \u44256 , \u44536  \u51088 \u49888 \u51060  \u54616 \u45208 \u45784 \u51032  \u51008 \u52509 \u51012  \u48155 \u51648  \u47803 \u54616 \u46020 \u47197  \u51228 \u44144 \u46108  \u44163 \u52376 \u47100  \u44536 \u46308 \u46020  \u46609 \u44057 \u51060  \u51228 \u44144 \u46104 \u50612 \u50556  \u47560 \u46405 \u54616 \u45796 \u44256  \u51452 \u51109 \u54620 \u45796 . \u44536 \u47532 \u44256  \u51452 \u45784 \u44760 \u49436  \u44536 \u46308 \u51032  \u51396 \u45716  \u50857 \u49436 \u54644  \u51452 \u49884 \u47732 \u49436  \u51088 \u44592 \u50752  \u51088 \u44592 \u51032  \u48512 \u54616 \u46308 \u51012  \u47736 \u47581 \u49884 \u53412 \u45716  \u44163 \u51060  \u48520 \u44277 \u54217 \u54620  \u51068 \u51060  \u50500 \u45776  \u49688  \u50630 \u45796 \u44256  \u51452 \u51109 \u54620 \u45796 . \u49324 \u45800 \u51008  \u44536 \u46308 \u51060  \u51088 \u44592 \u50640 \u44172  \u49324 \u47196 \u51105 \u55180  \u51088 \u46308 \u51060 \u46972 \u44256  \u51452 \u51109 \u54616 \u44256  \u44536 \u46308 \u51012  \u44536 \u51032  \u49552 \u50640  \u45336 \u44200 \u51452 \u50612  \u47736 \u47581 \u49884 \u53420  \u49688  \u51080 \u44172  \u54644  \u45804 \u46972 \u44256  \u50836 \u44396 \u54620 \u45796 .\
\uc0\u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u46308 \u51060  \u48276 \u51396 \u54620  \u44163 \u50640  \u45824 \u54616 \u50668  \u49324 \u45800 \u51060  \u48708 \u45212 \u54632 \u51004 \u47196  \u51452 \u45784 \u44760 \u49436 \u45716  \u44536 \u46308 \u51012  \u45149 \u44620 \u51648  \u49884 \u54744 \u54616 \u46020 \u47197  \u49324 \u45800 \u50640 \u44172  \u54728 \u46973 \u54616 \u49888 \u45796 . \u54616 \u45208 \u45784 \u51012  \u51032 \u51648 \u54616 \u45716  \u44536 \u46308 \u51032  \u54869 \u49888 \u44284  \u48127 \u51020 \u44284  \u44204 \u51064 \u48520 \u48156 \u51032  \u51221 \u49888 \u51008  \u44201 \u47148 \u54616 \u44172  \u49884 \u54744 \u51012  \u48155 \u51012  \u44163 \u51060 \u45796 . \u44284 \u44144 \u47484  \u54924 \u44256 \u54624  \u46412  \u44536 \u46308 \u51032  \u55148 \u47581 \u51008  \u49324 \u46972 \u51652 \u45796 . \u50780 \u45264 \u54616 \u47732  \u44536 \u46308 \u51032  \u50728  \u49373 \u50528 \u50640 \u49436  \u49440 \u51012  \u44144 \u51032  \u52286 \u50500 \u48380  \u49688  \u50630 \u44592  \u46412 \u47928 \u51060 \u45796 . \u44536 \u46308 \u51008  \u44536 \u46308 \u51032  \u50672 \u50557 \u54632 \u44284  \u47924 \u44032 \u52824 \u54632 \u51012  \u50756 \u51204 \u55176  \u44648 \u45803 \u45716 \u45796 . \u49324 \u45800 \u51008  \u44536 \u46308 \u51032  \u49345 \u53468 \u44032  \u51208 \u47581 \u51201 \u51060 \u47728  \u44536 \u46308 \u51032  \u50724 \u51216 \u51008  \u50689 \u50896 \u55176  \u50491 \u50612  \u48260 \u47540  \u49688  \u50630 \u45796 \u45716  \u49373 \u44033 \u51012  \u44054 \u44172  \u54632 \u51004 \u47196  \u44536 \u46308 \u51012  \u50948 \u54801 \u54616 \u44256 \u51088  \u45432 \u47141 \u54620 \u45796 . \u44536 \u45716  \u44536 \u46308 \u51032  \u48127 \u51020 \u51012  \u54028 \u44340 \u49884 \u53428 \u51004 \u47196  \u44536 \u46308 \u51060  \u44536 \u51032  \u50976 \u54841 \u50640  \u44404 \u48373 \u54616 \u44256  \u54616 \u45208 \u45784 \u44760  \u45824 \u54620  \u52649 \u49457 \u51012  \u48260 \u47532 \u44