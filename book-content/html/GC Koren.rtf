1798\uc0\u45380 \u50640  \u50612 \u46496 \u54620  \u45208 \u46972 \u44032  \u49888 \u45824 \u47449 \u50640 \u49436  \u50948 \u45824 \u54620  \u48120 \u47000 \u47484  \u50696 \u49345 \u49884 \u53412 \u47732 \u49436  \u51204 \u49464 \u44228 \u51032  \u51060 \u47785 \u51012  \u51665 \u51473 \u49884 \u53412 \u45716  \u44032 \u50868 \u45936  \u51068 \u50612 \u45228 \u45716 \u44032 ? \u51060  \u54364 \u49345 \u51060  \u47924 \u50631 \u51012  \u47568 \u54616 \u45716 \u51648 \u45716  \u47588 \u50864  \u47749 \u48177 \u54616 \u45796 . \u51060  \u50696 \u50616 \u44284  \u47784 \u46304  \u51216 \u50640  \u51080 \u50612 \u49436  \u48512 \u54633 \u46104 \u45716  \u54620  \u45208 \u46972 , \u50724 \u51649  \u54620  \u45208 \u46972 \u44032  \u51080 \u45716 \u45936 , \u44536 \u44163 \u51008  \u44263  \u48513 \u48120  \u54633 \u51473 \u44397 \u51060 \u45796 . \u50669 \u49324 \u44032 \u50752  \u54217 \u47200 \u44032 \u46308 \u51008  \u51060  \u45208 \u46972 \u51032  \u44592 \u50896 \u44284  \u49457 \u51109 \u51012  \u47896 \u49324 \u54624  \u46412  \u47924 \u51032 \u49885 \u51473 \u50640  \u51060  \u49457 \u44221  \u44592 \u51088 \u51032  \u49324 \u49345 \u51012  \u44144 \u51032  \u44536 \u45824 \u47196  \u46104 \u54400 \u51060 \u54644 \u49436  \u49324 \u50857 \u54616 \u50688 \u45796 . \u51060  \u51664 \u49849 \u51008  \'93\u46405 \u50640 \u49436  \u50732 \u46972 \'94\u50728 \u45796 \u44256  \u46104 \u50612  \u51080 \u45716 \u45936 , \u54644 \u49437 \u51088 \u46308 \u51060  \u50668 \u44592 \u50640 \u49436  \u49324 \u50857 \u54620  \u47568 \u51012  \u54400 \u51060 \u54620  \u45936  \u51032 \u54616 \u47732  \u51060  \'93\u50732 \u46972 \u50728 \u45796 \'94\u45716  \u47568 \u51008  \u44544 \u51088  \u44536 \u45824 \u47196  \'93\u49885 \u47932 \u51060  \u51088 \u46972 \u45208 \u44144 \u45208  \u50880 \u53552  \u50732 \u46972 \u50724 \u45716  \u44163 \'94\u51012  \u51032 \u48120 \u54616 \u44256  \u51080 \u45796 \u44256  \u47568 \u54620 \u45796 . \u44536 \u47532 \u44256  \u50864 \u47532 \u