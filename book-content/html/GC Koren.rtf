\uc0\u51396 \u51032  \u49327 \u51008  \u44256 \u49345 \u54620  \u51088 \u47549 \u44284  \u50689 \u50896 \u54620  \u49373 \u47749 \u51060  \u50500 \u45768 \u44256  \u45432 \u50696 \u50752  \u54028 \u47736 \u44284  \u49324 \u47581 \u51076 \u51060  \u51060 \u51228  \u47784 \u46304  \u49324 \u46988 \u50640 \u44172  \u51077 \u51613 \u46108 \u45796 . \u50501 \u51064 \u46308 \u51008  \u44536 \u46308 \u51032  \u48152 \u50669 \u51032  \u49373 \u50528 \u47484  \u53685 \u54616 \u50668  \u47924 \u50631 \u51012  \u51075 \u50612 \u48260 \u47532 \u44172  \u46104 \u50632 \u45716 \u51648  \u44648 \u45803 \u45716 \u45796 . \u50689 \u50896 \u54620  \u50689 \u44305 \u51032  \u49900 \u55176  \u51473 \u54620  \u44163 \u51060  \u51068 \u52237 \u51060  \u44536 \u46308 \u50640 \u44172  \u51452 \u50612 \u51276 \u51648 \u47564  \u44536 \u46308 \u51008  \u44536 \u44163 \u51012  \u44144 \u51208 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u51060 \u51228 \u45716  \u44536 \u44163 \u51060  \u50620 \u47560 \u45208  \u48512 \u47084 \u50892 \u54624  \u47564 \u54620  \u44163 \u51060  \u46104 \u50612  \u51080 \u45716 \u44032 ? \u51075 \u50612 \u48260 \u47536  \u51088 \u46308 \u51008  \u48512 \u47476 \u51670 \u45716 \u45796 . \'93\u51060  \u47784 \u46304  \u44163 \u51012  \u50864 \u47532 \u45716  \u50619 \u51012  \u49688  \u51080 \u50632 \u45796 . \u44536 \u47084 \u45208  \u50864 \u47532 \u45716  \u51088 \u51652 \u54616 \u50668  \u44536 \u44163 \u46308 \u51012  \u47680 \u47532 \u54616 \u44256 \u51088  \u54664 \u45796 . \u50500 , \u50620 \u47560 \u45208  \u51060 \u49345 \u54620  \u44163 \u50640  \u50676 \u51473 \u54664 \u45912 \u44032 ! \u50864 \u47532 \u45716  \u54217 \u50504 \u44284  \u54665 \u48373 \u44284  \u50689 \u44305 \u51012  \u48520 \u54665 \u44284  \u49688 \u52824 \u50752  \u51208 \u47581 \u44284  \u48148 \u44984 \u50632 \u45796 .\'94 \u47784 \u46304  \u49324 \u46988 \u51008  \u44536 \u46308 \u51060  \u54616 \u45720 \u50640 \u49436  \u51923 \u44200 \u45212  \u44163 \u51060  \u51221 \u45