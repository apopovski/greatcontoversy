\uc0\u51312 \u47217 \u54616 \u45716  \u51088 \u46308 \u51008  \u52380 \u50672 \u44228 \u51032  \u54788 \u49345 , \u44263  \u48320 \u54632 \u50630 \u51060  \u49692 \u54872 \u54616 \u45716  \u44228 \u51208 , \u51068 \u52237 \u51060  \u54620 \u48264 \u46020  \u48708 \u47484  \u45236 \u47140 \u48376  \u51068 \u51060  \u50630 \u45716  \u54392 \u47480  \u54616 \u45720 , \u48164 \u50640  \u45236 \u47536  \u48512 \u46300 \u47084 \u50868  \u51060 \u49836 \u47196  \u52397 \u52397 \u54616 \u44172  \u54392 \u47480  \u46308 \u51012  \u44032 \u47532 \u53412 \u47732 \u49436  \'93\u44536 \u45716  \u48708 \u50976 \u47484  \u47568 \u54620  \u44163 \u51060  \u50500 \u45776 \u44620 \'94\u46972 \u44256  \u48512 \u47476 \u51670 \u50632 \u45796 . \u44536 \u46308 \u51008  \u51032 \u51032  \u51204 \u46020 \u51088 \u47484  \u44305 \u49888 \u51088 \u47196  \u49440 \u44256 \u54616 \u44256 , \u51204 \u48372 \u45796  \u45908 \u50865  \u54693 \u46973 \u51012  \u52628 \u44396 \u54616 \u47728 , \u45908 \u50865  \u49900 \u54620  \u51396 \u50501 \u51032  \u44600 \u47196  \u44152 \u50612 \u44052 \u45796 . \u44536 \u47084 \u45208  \u44536 \u46308 \u51032  \u48520 \u49888 \u51060  \u44536  \u50696 \u44256 \u46108  \u49324 \u44148 \u51060  \u45797 \u52824 \u51648  \u47803 \u54616 \u46020 \u47197  \u48169 \u51648 \u54616 \u51648  \u47803 \u54616 \u50688 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u44536 \u46308 \u51032  \u51396 \u50501 \u51012  \u50724 \u47000  \u52280 \u51004 \u49884 \u44256 , \u44536 \u46308 \u50640 \u44172  \u54924 \u44060 \u54624  \u44592 \u54924 \u47484  \u52649 \u48516 \u55176  \u51452 \u49512 \u45796 . \u44536 \u47084 \u45208  \u44536  \u51221 \u54620  \u46412 \u44032  \u46104 \u51088  \u54616 \u45208 \u45784 \u51032  \u49900 \u54032 \u51008  \u44536 \u48516 \u51032  \u51088 \u48708 \u47484  \u44144 \u51208 \u54620  \u51088 \u46308  \u50948 \u50640  \u45236 \u47160 \u45796 .\
\uc0\u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u51116 \u47548 \u51032  \u46412 \u50640 \u46020  \u46041 \u51068 \u54620  \u48520 \u49888 \u51060  \u51080 \u51012  \u44163 \u51012  \u47568 \u50432 \u54616 \u49512 \u45796 . \u44396 \u51452 \u44760 \u49436 \u45716  \u45432 \u50500  \u49884 \u45824 \u51032  \u49324 \u46988 \u46308 \u51060  \'93\u54861 \u49688 \u44032  \u45208 \u49436  \u51200 \u55148 \u47484  \u45796  \u47736 \u54616 \u44592 \u44620 \u51648  \u44648 \u45803 \u51648  \u47803 \'94\u54620  \u44163 \u44284  \u44057 \u51060  \'93\u51064 \u51088 \u51032  \u51076 \u54632 \u46020  \u51060 \u50752  \u44057 \u51004 \u47532 \u46972 \'94 (\u47560  24:39) \u44256  \u54616 \u49512 \u45796 . \u49548 \u50948  \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u51060 \u46972 \u44256  \u44277 \u50616 \u54616 \u45716  \u49324 \u46988 \u46308 \u51060  \u49464 \u49345 \u44284  \u53440 \u54801 \u54616 \u44256 , \u49464 \u49345  \u49324 \u46988 \u46308 \u52376 \u47100  \u49373 \u54876 \u54616 \u44256 , \u44536 \u46308 \u44284  \u50612 \u50872 \u47140 \u49436  \u44552 \u51648 \u46108  \u54693 \u46973 \u50640  \u48736 \u51648 \u44256 , \u49464 \u49345 \u51032  \u49324 \u52824 \u44032  \u44368 \u54924 \u51032  \u49324 \u52824 \u47196  \u48148 \u45068 \u50612 \u51648 \u44256 , \u44208 \u54844  \u50696 \u49885 \u51012  \u50508 \u47532 \u45716  \u51333 \u49548 \u47532 \u44032  \u50872 \u47140  \u54140 \u51648 \u44256 , \u47784 \u46304  \u49324 \u46988 \u46308 \u51060  \u50724 \u47019 \u46041 \u50504 \u51032  \u49464 \u49549 \u51201  \u48264 \u50689 \u51012  \u45000 \u44984 \u44256  \u51080 \u45716  \u46412 \u50640  \u47560 \u52824  \u54616 \u45720 \u50640 \u49436  \u48264 \u44060 \u44032  \u48264 \u51789 \u51076 \u44057 \u51060  \u44536 \u46308 \u51032  \u48157 \u51008  \u51204 \u47581 \u44284  \u44144 \u51667 \u46108  \u55148 \u47581 \u46308 \u51060  \u44648 \u50612 \u51656  \u44163 \u51060 \u45796 .\
\uc0\u54616 \u45208 \u45784 \u44760 \u49436  \u54861 \u49688 \u44032  \u51080 \u51012  \u44163 \u51012  \u49464 \u49345 \u50640  \u44221 \u44256 \u54616 \u44592  \u50948 \u54616 \u50668  \u45817 \u49888 \u51032  \u51333 \u51012  \u48372 \u45236 \u49512 \u45912  \u44163 \u52376 \u47100  \u44536 \u48516 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u53469 \u54616 \u49888  \u49324 \u51088 \u46308 \u51012  \u53685 \u54616 \u50668  \u52572 \u54980 \u51032  \u49900 \u54032 \u51060  \u44032 \u44620 \u50912 \u51020 \u51012  \u50508 \u47140  \u51452 \u49512 \u45796 . \u44536 \u47084 \u45208  \u47560 \u52824  \u45432 \u50500  \u49884 \u45824 \u51032  \u49324 \u46988 \u46308 \u51060  \u44536  \u51032 \u51032  \u51204 \u46020 \u51088 \u44032  \u51204 \u54616 \u45716  \u44221 \u44256 \u47484  \u45257 \u49548 \u54664 \u45912  \u44163 \u52376 \u47100  \u48128 \u47084 \u51032  \u49884 \u45824 \u50640 \u46020  \u47566 \u51008  \u49324 \u46988 \u46308 , \u49900 \u51648 \u50612  \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u51060 \u46972 \u44256  \u44277 \u50616 \u54616 \u45716  \u49324 \u46988 \u46308 \u44620 \u51648 \u46020  \u44221 \u44256 \u51032  \u44592 \u48324 \u51012  \u45257 \u49548 \u54616 \u50688 \u45796 .\
