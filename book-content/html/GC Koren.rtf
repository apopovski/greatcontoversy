\uc0\u53440 \u46973 \u54620  \u50500 \u45812 \u51032  \u51088 \u49552 \u46308 \u51060  \u50696 \u49688 \u45784 \u51012  \u53685 \u54616 \u50668  \'93\u54616 \u45208 \u45784 \u51032  \u50500 \u46308 \u46308 \'94\u51060  \u46108 \u45796 . \'93\u44144 \u47337 \u54616 \u44172  \u54616 \u49884 \u45716  \u51088 \u50752  \u44144 \u47337 \u54616 \u44172  \u54632 \u51012  \u51077 \u51008  \u51088 \u46308 \u51060  \u45796  \u54616 \u45208 \u50640 \u49436  \u45212 \u51648 \u46972  \u44536 \u47084 \u48064 \u47196  \u54805 \u51228 \u46972  \u48512 \u47476 \u49884 \u44592 \u47484  \u48512 \u45124 \u47084 \u50892  \u50500 \u45768 \'94 (\u55176  2:11) \u54616 \u49888 \u45796 . \u44536 \u47532 \u49828 \u46020 \u51064  \u49373 \u50528 \u45716  \u54616 \u45208 \u45784 \u51012  \u48127 \u45716  \u48127 \u51020 \u44284  \u49849 \u47532 \u50752  \u44592 \u49256 \u51032  \u49373 \u50528 \u44032  \u46104 \u50612 \u50556  \u54620 \u45796 . \'93\u45824 \u51200  \u54616 \u45208 \u45784 \u44760 \u47196 \u49436  \u45212  \u51088 \u47560 \u45796  \u49464 \u49345 \u51012  \u51060 \u44592 \u45712 \u45768 \u46972  \u49464 \u49345 \u51012  \u51060 \u44596  \u51060 \u44608 \u51008 \'85\u48127 \u51020 \u51060 \u45768 \u46972 \'94 (\u50836 \u51068  5:4). \u54616 \u45208 \u45784 \u51032  \u51333  \u45712 \u54756 \u48120 \u50556 \u44032  \'93\u50668 \u54840 \u50752 \u47484  \u44592 \u48848 \u54616 \u45716  \u44163 \u51060  \u45320 \u55148 \u51032  \u55192 \u51060 \u45768 \u46972 \'94 (\u45712  8:10) \u44256  \u54620  \u47568 \u51008  \u51652 \u49892 \u54620  \u47568 \u51060 \u45796 . \u48148 \u50872 \u51008  \u47568 \u54620 \u45796 . \'93\u51452  \u50504 \u50640 \u49436  \u54637 \u49345  \u44592 \u48848 \u54616 \u46972  \u45236 \u44032  \u45796 \u49884  \u47568 \u54616 \u45432 \u45768  \u44592 \u48848 \u54616 \u46972 \'94 (\u48716  4:4), \'93\u54637 \u49345  \u44592 \u48848 \u54616 \u46972  \u49772 \u51648  \u47568 \u44256  \u44592 \u46020 \u54616 \u46972  \u48276 \u49324 \u50640  \u44048 \u49324 \u54616