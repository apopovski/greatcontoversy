\uc0\u48128 \u47084 \u45716  \u47928 \u51088  \u44536 \u45824 \u47196  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u51649 \u51217  \u51116 \u47548 \u54616 \u49888 \u45796 \u45716  \u49324 \u49892 \u51012  \u49457 \u44221 \u51060  \u47749 \u54869 \u54616 \u44172  \u44032 \u47476 \u52824 \u44256  \u51080 \u45716  \u44163 \u51012  \u48156 \u44204 \u54616 \u50688 \u45796 . \u48148 \u50872 \u51008  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u54616 \u44256  \u51080 \u45796 . \'93\u51452 \u44760 \u49436  \u54840 \u47161 \u44284  \u52380 \u49324 \u51109 \u51032  \u49548 \u47532 \u50752  \u54616 \u45208 \u45784 \u51032  \u45208 \u54036 \u47196  \u52828 \u55176  \u54616 \u45720 \u47196  \u51335 \u50500  \u44053 \u47548 \u54616 \u49884 \u47532 \'94 (\u49332 \u51204  4:16, 17) \u46972 . \u46608 \u54620  \u51452 \u45784 \u44760 \u49436 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u50432 \u54616 \u49888 \u45796 . \'93\u51064 \u51088 \u44032  \u44396 \u47492 \u51012  \u53440 \u44256  \u45733 \u47141 \u44284  \u53360  \u50689 \u44305 \u51004 \u47196  \u50724 \u45716  \u44163 \u51012  \u48372 \u47532 \u46972 \'94, \'93\u48264 \u44060 \u44032  \u46041 \u54200 \u50640 \u49436  \u45208 \u49436  \u49436 \u54200 \u44620 \u51648  \u48264 \u51789 \u51076 \u44057 \u51060  \u51064 \u51088 \u51032  \u51076 \u54632 \u46020  \u44536 \u47084 \u54616 \u47532 \u46972 \'94 (\u47560  24:30, 27). \u44536 \u48516 \u44760 \u49436 \u45716  \u54616 \u45720 \u51032  \u47784 \u46304  \u52380 \u49324 \u46308 \u44284  \u54632 \u44760  \u50724 \u49884 \u45716  \u44163 \u51060 \u45796 . \'93\u51064 \u51088 \u44032  \u51088 \u44592  \u50689 \u44305 \u51004 \u47196  \u47784 \u46304  \u52380 \u49324 \u50752  \u54632 \u44760  \u50732  \u46412 \u50640 \'94 (\u47560  25:31), \'93\u51200 \u44032  \u53360  \u45208 \u54036  \u49548 \u47532 \u50752  \u54632 \u44760  \u52380 \u49324 \u46308 \u51012  \u48372 \u45236 \u47532 \u45768  \u51200 \u55148 \u44032  \u44536  \u53469 \u54616 \u49888  \u51088 \u46308 \u51012  \u54616 \u45720  \u51060  \u45149 \u50640 \u49436  \u51200  \u45149 \u44620 \u51648  \u49324 \u48169 \u50640 \u49436  \u47784 \u51004 \u47532 \u46972 \'94 (\u47560  24:31).\
\uc0\u51452 \u45784 \u44760 \u49436  \u51116 \u47548 \u54616 \u49892  \u46412 \u50640  \u51453 \u51008  \u51032 \u51064 \u46308 \u51008  \u48512 \u54876 \u54616 \u44256 , \u49332 \u50500  \u51080 \u45716  \u51032 \u51064 \u46308 \u51008  \u48320 \u54868 \u46108 \u45796 . \u48148 \u50872 \u51008  \'93\u50864 \u47532 \u44032  \u45796  \u51104 \u51096  \u44163 \u51060  \u50500 \u45768 \u50836  \u47560 \u51648 \u47561  \u45208 \u54036 \u50640  \u49692 \u49885 \u44036 \u50640  \u54848 \u50672 \u55176  \u45796  \u48320 \u54868 \u54616 \u47532 \u45768  \u45208 \u54036  \u49548 \u47532 \u44032  \u45208 \u47588  \u51453 \u51008  \u51088 \u46308 \u51060  \u50025 \u51648  \u50500 \u45768 \u54624  \u44163 \u51004 \u47196  \u45796 \u49884  \u49332 \u44256  \u50864 \u47532 \u46020  \u48320 \u54868 \u54616 \u47532 \u46972  \u51060  \u50025 \u51012  \u44163 \u51060  \u48520 \u44032 \u48520  \u50025 \u51648  \u50500 \u45768 \u54624  \u44163 \u51012  \u51077 \u44192 \u44256  \u51060  \u51453 \u51012  \u44163 \u51060  \u51453 \u51648  \u50500 \u45768 \u54632 \u51012  \u51077 \u51004 \u47532 \u47196 \u45796 \'94 (\u44256 \u51204  15:51~53) \u44256  \u47568 \u54620 \u45796 . \u44536 \u45716  \u46608 \u54620  \u45936 \u49332 \u47196 \u45768 \u44032 \u51064 \u46308 \u50640 \u44172  \u48372 \u45236 \u45716  \u54200 \u51648 \u50640 \u49436  \u44536 \u47532 \u49828 \u46020 \u51032  \u51116 \u47548 \u50640  \u45824 \u54616 \u50668  \u47568 \u54620  \u54980 \u50640  \u45796 \u51020 \u44284  \u44057 \u51060  \u44592 \u47197 \u54616 \u50688 \u45796 . \'93\u44536 \u47532 \u49828 \u46020  \u50504 \u50640 \u49436  \u51453 \u51008  \u51088 \u46308 \u51060  \u47676 \u51200  \u51068 \u50612 \u45208 \u44256  \u44536  \u54980 \u50640  \u50864 \u47532  \u49332 \u50500 \u45224 \u51008  \u51088 \u46020  \u51200 \u55148 \u50752  \u54632 \u44760  \u44396 \u47492  \u49549 \u51004 \u47196  \u45132 \u50612 \u50732 \u47140  \u44277 \u51473 \u50640 \u49436  \u51452 \u47484  \u50689 \u51217 \u54616 \u44172  \u54616 \u49884 \u47532 \u45768  \u44536 \u47532 \u54616 \u50668  \u50864 \u47532 \u44032  \u54637 \u49345  \u51452 \u50752  \u54632 \u44760  \u51080 \u51004 \u47532 \u46972 \'94 (\u49332 \u51204  4:16, 17).\
\uc0\u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u49892 \u51228 \u47196  \u51116 \u47548 \u54616 \u49884 \u44592  \u51204 \u50640 \u45716  \u44536 \u48516 \u51032  \u48177 \u49457 \u46308 \u51060  \u44536  \u45208 \u46972 \u47484  \u48155 \u51012  \u49688  \u50630 \u45796 . \u44396 \u51452 \u44760 \u49436 \u45716  \u44536  \u49324 \u49892 \u50640  \u45824 \u54616 \u50668  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u50432 \u54616 \u49512 \u45796 . \'93\u51064 \u51088 \u44032  \u51088 \u44592  \u50689 \u44305 \u51004 \u47196  \u47784 \u46304  \u52380 \u49324 \u50752  \u54632 \u44760  \u50732  \u46412 \u50640  \u51088 \u44592  \u50689 \u44305 \u51032  \u48372 \u51340 \u50640  \u50505 \u51004 \u47532 \u45768  \u47784 \u46304  \u48124 \u51313 \u51012  \u44536  \u50526 \u50640  \u47784 \u51004 \u44256  \u44033 \u44033  \u48516 \u48324 \u54616 \u44592 \u47484  \u47785 \u51088 \u44032  \u50577 \u44284  \u50684 \u49548 \u47484  \u48516 \u48324 \u54616 \u45716  \u44163 \u44057 \u51060  \u54616 \u50668  \u50577 \u51008  \u44536  \u50724 \u47480 \u54200 \u50640 , \u50684 \u49548 \u45716  \u50812 \u54200 \u50640  \u46160 \u47532 \u46972  \u44536  \u46412 \u50640  \u51076 \u44552 \u51060  \u44536  \u50724 \u47480 \u54200 \u50640  \u51080 \u45716  \u51088 \u46308 \u50640 \u44172  \u51060 \u47476 \u49884 \u46104  \u45236  \u50500 \u48260 \u51648 \u44760  \u48373  \u48155 \u51012  \u51088 \u46308 \u51060 \u50668  \u45208 \u50500 \u50752  \u52285 \u49464 \u47196 \u48512 \u53552  \u45320 \u55148 \u47484  \u50948 \u54616 \u50668  \u50696 \u48708 \u46108  \u45208 \u46972 \u47484  \u49345 \u49549 \u54616 \u46972 \'94 (\u47560  25:31~34). \u50864 \u47532 \u45716  \u51064 \u51088 \u44032  \u50724 \u49892  \u46412 \u50640  \u51453 \u51008  \u49324 \u46988 \u46308 \u51008  \u50025 \u51648  \u50500 \u45768 \u54624  \u44163 \u51004 \u47196  \u48512 \u54876 \u54616 \u44256  \u49332 \u50500  \u51080 \u45716  \u49324 \u46988 \u46308 \u51008  \u48320 \u54868 \u54624  \u44163 \u51060 \u46972 \u45716  \u49324 \u49892 \u51012  \u50948 \u51032  \u49457 \u44221 \u51208 \u46308 \u51012  \u53685 \u54616 \u50668  \u50508 \u44172  \u46104 \u50632 \u45796 . \u44536  \u53360  \u48320 \u54868 \u50640  \u51032 \u54616 \u50668  \u44536 \u46308 \u51008  \u44536  \u45208 \u46972 \u47484  \u48155 \u51012  \u51456 \u48708 \u44032  \u51060 \u47336 \u50612 \u51652 \u45796 . \u48148 \u50872 \u51008  \'93\u54792 \u44284  \u50977 \u51008  \u54616 \u45208 \u45784  \u45208 \u46972 \u47484  \u50976 \u50629 \u51004 \u47196  \u48155 \u51012  \u49688  \u50630 \u44256  \u46608 \u54620  \u50025 \u51008  \u44163 \u51008  \u50025 \u51648  \u50500 \u45768 \u54620  \u44163 \u51012  \u50976 \u50629 \u51004 \u47196  \u48155 \u51648  \u47803 \u54616 \u45712 \u45768 \u46972 \'94 (\u44256 \u51204  15:50) \u44256  \u47568 \u54620 \u45796 . \u54788  \u49345 \u53468 \u51032  \u51064 \u47448 \u45716  \u51453 \u51012  \u49688 \u48150 \u50640  \u50630 \u44256 , \u50025 \u51012  \u49688 \u48150 \u50640  \u50630 \u45796 . \u54616 \u45208 \u45784 \u51032  \u45208 \u46972 \u45716  \u50025 \u51648  \u50500 \u45768 \u54616 \u44256  \u50689 \u50896 \u55176  \u44228 \u49549 \u46112  \u44163 \u51060 \u45796 . \u44536 \u47084 \u48064 \u47196  \u49324 \u46988 \u51060  \u54788 \u51116 \u51032  \u49345 \u53468 \u47196 \u45716  \u54616 \u45208 \u45784  \u45208 \u46972 \u50640  \u46308 \u50612 \u44040  \u49688  \u50630 \u45796 . \u44536 \u47084 \u45208  \u50696 \u49688 \u45784 \u44760 \u49436  \u50724 \u49892  \u46412 , \u44536 \u48516 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u48177 \u49457 \u46308 \u50640 \u44172  \u48520 \u47736  (\u63847 \u28357 ) \u51012  \u51452 \u49888 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u48516 \u44760 \u49436 \u45716  \u50724 \u51649  \u44536 \u46308 \u47564 \u51060  \u49345 \u49549 \u51088 \u46308 \u51060  \u46112  \u49688  \u51080 \u45716  \u44536  \u45208 \u46972 \u47484  \u50976 \u50629 \u51004 \u47196  \u48155 \u46020 \u47197  \u44536 \u46308 \u51012 