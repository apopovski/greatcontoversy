\f1\b0 \cf0 \
\uc0\u51116 \u47548 \u51060  \u44032 \u44620 \u50912 \u45796 \u45716  \u49440 \u54252 \u50752  \u54632 \u44760  \u51333 \u44368 \u51201  \u45824 \u44033 \u49457 \u51060  \u51068 \u50612 \u45216  \u44163 \u51060 \u46972 \u45716  \u49324 \u49892 \u51060  \u50836 \u54620 \u44228 \u49884 \u47197  14\u51109 \u51032  \u52395 \u51704  \u52380 \u49324 \u51032  \u44592 \u48324 \u50640  \u50696 \u50616 \u46104 \u50612  \u51080 \u45796 . \'93\u46608  \u48372 \u45768  \u45796 \u47480  \u52380 \u49324 \u44032  \u44277 \u51473 \u50640  \u45216 \u50500 \u44032 \u45716 \u45936  \u46405 \u50640  \u44144 \u54616 \u45716  \u51088 \u46308  \u44263  \u50668 \u47084  \u45208 \u46972 \u50752  \u51313 \u49549 \u44284  \u48169 \u50616 \u44284  \u48177 \u49457 \u50640 \u44172  \u51204 \u54624  \u50689 \u50896 \u54620  \u48373 \u51020 \u51012  \u44032 \u51276 \u45908 \u46972  \u44536 \u44032  \u53360  \u51020 \u49457 \u51004 \u47196  \u44032 \u47196 \u46104  \u54616 \u45208 \u45784 \u51012  \u46160 \u47140 \u50892 \u54616 \u47728  \u44536 \u50640 \u44172  \u50689 \u44305 \u51012  \u46028 \u47532 \u46972  \u51060 \u45716  \u44536 \u51032  \u49900 \u54032 \u54616 \u49892  \u49884 \u44036 \u51060  \u51060 \u47476 \u47104 \u51020 \u51060 \u45768  \u54616 \u45720 \u44284  \u46405 \u44284  \u48148 \u45796 \u50752  \u47932 \u46308 \u51032  \u44540 \u50896 \u51012  \u47564 \u46300 \u49888  \u51060 \u47484  \u44221 \u48176 \u54616 \u46972  \u54616 \u45908 \u46972 \'94 (\u44228  14:6, 7).\
\uc0\u54620  \u52380 \u49324 \u44032  \u51060 \u50752  \u44057 \u51008  \u44221 \u44256 \u47484  \u51204 \u45804 \u54616 \u45716  \u51088 \u44032  \u46108 \u45796 \u45716  \u49324 \u49892 \u51008  \u52280 \u51004 \u47196  \u44536  \u51032 \u48120 \u44032  \u44618 \u45796 . \u51648 \u54812 \u47196 \u50864 \u49888  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u44536  \u54616 \u45720 \u51032  \u49324 \u51088 \u51032  \u49692 \u44208 \u44284  \u50689 \u44305 \u44284  \u45733 \u47141 \u51012  \u53685 \u54616 \u50668  \u44536  \u44592 \u48324 \u47196  \u47568 \u48120 \u50516 \u50500  \u49457 \u52712 \u46108  \u49324 \u50629 \u51032  \u44256 \u49345 \u54620  \u53945 \u49457 \u44284  \u44536  \u49324 \u50629 \u50640  \u49688 \u48152 \u46112  \u45733 \u47141 \u44284  \u50689 \u44305 \u51012  \u45208 \u53440 \u45236 \u49884 \u44256 \u51088  \u54616 \u49512 \u45796 . \u46608  \u54620  \u52380 \u49324 \u44032  \u44277 \u51473 \u50640  \u45216 \u47728  \'93\u53360  \u51020 \u49457 \u51004 \u47196 \'94 \u44221 \u44256 \u54616 \u46104 , \'93\u46405 \u50640  \u44144 \u54616 \u45716  \u51088 \u46308 \'94 \u44263  \'93\u50668 \u47084  \u45208 \u46972 \u50752  \u51313 \u49549 \u44284  \u48169 \u50616 \u44284  \u48177 \u49457 \'94\u50640 \u44172  \u51204 \u54028 \u54616 \u45716  \u44163 \u51008  \u51060  \u50868 \u46041 \u51032  \u49888 \u49549 \u49457 \u44284  \u49464 \u44228 \u51201 \u51064  \u48276 \u50948 \u47484  \u48516 \u47749 \u55176  \u50508 \u47140 \u51456 \u45796 .\
\uc0\u44536  \u44592 \u48324  \u51088 \u52404 \u45716  \u44536  \u50868 \u46041 \u51060  \u51068 \u50612 \u45216  \u49884 \u44592 \u50640  \u45824 \u54616 \u50668  \u48731 \u51012  \u48708 \u52628 \u50612 \u51456 \u45796 . \u44536  \u44592 \u48324 \u51008  \'93\u50689 \u50896 \u54620  \u48373 \u51020 \'94\u51032  \u51068 \u48512 \u48516 \u51060 \u47728 , \u44536 \u44163 \u51008  \u49900 \u54032 \u51032  \u49884 \u51089 \u51012  \u50508 \u47140 \u51456 \u45796 . \u44033  \u49884 \u45824 \u50640  \u44396 \u50896 \u51032  \u44592 \u48324 \u51008  \u51204 \u54028 \u46104 \u50612  \u50772 \u45796 . \u44536 \u47084 \u45208  \u51060  \u44592 \u48324 \u51008  \u50724 \u51649  \u47568 \u49464 \u50640 \u47564  \u51204 \u54644 \u51656  \u48373 \u51020  \u44592 \u48324 \u51032  \u51068 \u48512 \u48516 \u51060 \u45796 . \u50780 \u45264 \u54616 \u47732  \u49900 \u54032 \u51032  \u46412 \u45716  \u47568 \u49464 \u44032  \u46104 \u50612 \u50556  \u49884 \u51089 \u46104 \u44592  \u46412 \u47928 \u51060 \u45796 . \u50696 \u50616 \u51008  \u49900 \u54032 \u51032  \u46412 \u44032  \u51060 \u47476 \u44592 \u44620 \u51648  \u50668 \u47084  \u44032 \u51648  \u49324 \u44148 \u46308 \u51060  \u44228 \u49549 \u51201 \u51004 \u47196  \u51068 \u50612 \u45216  \u44163 \u51012  \u47568 \u54616 \u44256  \u51080 \u45796 . \u53945 \u48324 \u55176  \u45796 \u45768 \u50648 \u49436 \u44032  \u44536  \u49324 \u49892 \u51012  \u47568 \u54644  \u51456 \u45796 . \u44536 \u47084 \u45208  \u47568 \u49464 \u50640  \u44288 \u47144 \u46108  \u50696 \u50616 \u51032  \u51068 \u48512 \u47196 \u49436  \u45796 \u45768 \u50648 \u51008  \u44536 \u44163 \u51012  \u44036 \u49688 \u54616 \u44256  \'93\u47560 \u51648 \u47561  \u46412 \u44620 \u51648 \'94 (\u45800  12:4) \u48393 \u54632 \u54616 \u50668  \u46160 \u46972 \u45716  \u47749 \u47161 \u51012  \u48155 \u50520 \u45796 . \u44536  \u46412 \u44032  \u51060 \u47476 \u44592  \u51204 \u50640 \u45716  \u44536  \u47784 \u46304  \u50696 \u50616 \u51032  \u49457 \u52712 \u50640  \u44592 \u52488 \u47484  \u46164  \u49900 \u54032 \u50640  \u44288 \u54620  \u44592 \u48324 \u51008  \u54616 \u45208 \u46020  \u49440 \u54252 \u46112  \u49688  \u50630 \u50632 \u45796 . \u44536 \u47084 \u45208  \u49440 \u51648 \u51088  \u45796 \u45768 \u50648 \u51008  \u47560 \u51648 \u47561  \u46412 \u44032  \u46104 \u47732  \'93\u47566 \u51008  \u49324 \u46988 \u51060  \u48744 \u47532  \u50773 \u47000 \u54616 \u47728  \u51648 \u49885 \u51060  \u45908 \u54616 \u47532 \u46972 \'94\u44256  \u44592 \u47197 \u54616 \u50688 \u45796 .\
\uc0\u49324 \u46020  \u48148 \u50872 \u51008  \u44536  \u45817 \u49884 \u50640  \u44536 \u47532 \u49828 \u46020 \u51032  \u51116 \u47548 \u51060  \u51080 \u51012  \u44163 \u51004 \u47196  \u44592 \u45824 \u54616 \u51648  \u47568 \u46972 \u44256  \u44368 \u54924 \u50640  \u44221 \u44256 \u54616 \u50688 \u45796 . \u44536 \u45716  \'93\u47676 \u51200  \u48176 \u46020 \u54616 \u45716  \u51068 \u51060  \u51080 \u44256  \u51200  \u48520 \u48277 \u51032  \u49324 \u46988  \u44263  \u47736 \u47581 \u51032  \u50500 \u46308 \u51060  \u45208 \u53440 \u45208 \u44592  \u51204 \u50640 \u45716  \u51060 \u47476 \u51648  \u50500 \u45768 \u54616 \u47532 \'94 (\u49332 \u54980  2:3) \u46972 \u44256  \u47568 \u54616 \u50688 \u45796 . \u53360  \u48176 \u46020 \u50752  \u51109 \u44592 \u44036 \u50640  \u44152 \u52828  \'93\u48520 \u48277 \u51032  \u49324 \u46988 \'94\u51032  \u51204 \u49457 \u49884 \u45824 \u44032  \u44536 \u52828  \u45796 \u51020 \u50640 \u50556  \u48708 \u47196 \u49548  \u51452 \u45784 \u51032  \u51116 \u47548 \u51012  \u44592 \u45824 \u54624  \u49688  \u51080 \u51012  \u44163 \u51060 \u50632 \u45796 . \u44536 \u47088 \u45936  \'93\u48520 \u48277 \u51032  \u48708 \u48128 \'94, \u47736 \u47581 \u51032  \u50500 \u46308 , \'93\u48520 \u48277 \u54620  \u51088 \'94\u46972 \u45716  \u52845 \u54840 \u47484  \u44032 \u51652  \'93\u48520 \u48277 \u51032  \u49324 \u46988 \'94\u51008  \u50696 \u50616 \u50640  \u44592 \u47197 \u46108  \u48148 \u50752  \u44057 \u51060  1260\u45380  \u46041 \u50504  \u52572 \u49345 \u44428  (\u26368 \u19978 \u27402 ) \u51012  \u51105 \u51008  \u48277 \u50773 \u44428 \u51012  \u44032 \u47532 \u53412 \u44256  \u51080 \u45796 . \u44536 \u47532 \u44256  1260\u45380 \u51032  \u44592 \u44036 \u51008  \u49436 \u44592  1798\u45380 \u50640  \u47560 \u52452 \u45796 . \u44536 \u47084 \u48064 \u47196  \u44536 \u47532 \u49828 \u46020 \u51032  \u51116 \u47548 \u51008  \u44536  \u44592 \u44036  \u51060 \u51204 \u50640  \u51080 \u51012  \u49688  \u50630 \u50632 \u45796 . \u48148 \u50872 \u51008  1798\u45380 \u44620 \u51648 \u51032  \u49888 \u50557 \u49884 \u45824  \u51204 \u52404 \u47484  \u44536 \u51032  \u44221 \u44256 \u50640  \u54252 \u54632 \u49884 \u53412 \u44256  \u51080 \u45796 . \u44536 \u47532 \u49828 \u46020 \u51032  \u51116 \u47548 \u51032  \u44592 \u48324 \u51008  \u44536  \u51060 \u54980 \u50640  \u49440 \u54252 \u46112  \u44163 \u51060 \u50632 \u45796 .\
\uc0\u51060 \u47088  \u44592 \u48324 \u51008  \u44284 \u44144 \u50640  \u51204 \u54028 \u46108  \u51068 \u51060  \u51204 \u54784  \u50630 \u45796 . \u46608 \u54620  \u48148 \u50872 \u46020  \u44536 \u47088  \u44592 \u48324 \u51012  \u51204 \u54620  \u51068 \u51060  \u50630 \u50632 \u51020 \u51012  \u50864 \u47532 \u45716  \u50508 \u44256  \u51080 \u45796 . \u44536 \u45716  \u54805 \u51228 \u46308 \u50640 \u44172  \u51452 \u45784 \u51032  \u51116 \u47548 \u51060  \u47676  \u48120 \u47000 \u50640  \u51080 \u51012  \u44163 \u51060 \u46972 \u44256  \u44032 \u47476 \u52452 \u45796 . \u44060 \u54785 \u51088 \u46308 \u46020  \u44536  \u44592 \u48324 \u51012  \u51204 \u54616 \u51648  \u50500 \u45768 \u54616 \u50688 \u45796 . \u47560 \u54004  \u47336 \u53552 \u46020  \u49900 \u54032 \u51008  \u44536  \u45817 \u49884 \u48512 \u53552  \u50557  300\u45380  \u54980 \u50640  \u51080 \u51012  \u51068 \u51060 \u46972 \u44256  \u54616 \u50688 \u45796 . \u44536 \u47088 \u45936  1798\u45380  \u51060 \u54980 \u47196  \u45796 \u45768 \u50648 \u49436 \u44032  \u44060 \u48393 \u46104 \u44256 , \u50696 \u50616 \u51032  \u51648 \u49885 \u51008  \u51613 \u44032 \u46104 \u50632 \u51004 \u47728 , \u47566 \u51008  \u49324 \u46988 \u51060  \u49900 \u54032 \u51060  \u44032 \u44620 \u50912 \u45796 \u45716  \u50628 \u49689 \u54620  \u44592 \u48324 \u51012  \u51204 \u54616 \u44592  \u49884 \u51089 \u54616 \u50688 \u45796 .\
16\uc0\u49464 \u44592 \u51032  \u50948 \u45824 \u54620  \u51333 \u44368  \u44060 \u54785 \u52376 \u47100  \u51116 \u47548 \u50868 \u46041 \u46020  \u44033  \u44536 \u47532 \u49828 \u46020 \u44368 \u44397 \u50640 \u49436  \u46041 \u49884 \u50640  \u51068 \u50612 \u45228 \u45796 . \u50976 \u47101 \u44284  \u50500 \u47700 \u47532 \u52852 \u50640 \u49436  \u48127 \u51020 \u51060  \u46021 \u49892 \u54616 \u44256  \u44592 \u46020 \u51032  \u49373 \u50528 \u47484  \u49324 \u45716  \u49324 \u46988 \u46308 \u51060  \u50696 \u50616 \u51012  \u50672 \u44396 \u54616 \u44256 , \u49457 \u44221 \u51012  \u51452 \u51032  \u44618 \u44172  \u50672 \u44396 \u54616 \u45716  \u51473 \u50640  \u47564 \u47932 \u51032  \u47560 \u51648 \u47561 \u51060  \u44032 \u44620 \u50912 \u45796 \u45716  \u54869 \u49888 \u51012  \u50619 \u44172  \u46104 \u50632 \u45796 . \u49464 \u44228  \u44033 \u52376 \u50640  \u51080 \u45716  \u44060 \u48324 \u51201 \u51064  \u44536 \u47532 \u49828 \u46020 \u44368  \u45800 \u52404 \u46308 \u51060  \u51228 \u44033 \u44592  \u49457 \u44221  \u50672 \u44396 \u47564 \u51012  \u53685 \u54644 \u49436  \u44536 \u47532 \u49828 \u46020 \u51032  \u51116 \u47548 \u51060  \u44032 \u44620 \u50912 \u45796 \u45716  \u53360  \u51652 \u47532 \u47484  \u44648 \u45803 \u44172  \u46104 \u50632 \u45796 .\
