\uc0\u49900 \u47928  \u51109 \u49548 \u44032  \u50500 \u50864 \u53356 \u49828 \u48512 \u47476 \u53356  (Augsburg) \u47196  \u51648 \u51221 \u46104 \u50632 \u51004 \u48064 \u47196  \u47336 \u53552 \u45716  \u46020 \u48372 \u47196  \u44536  \u44275 \u51012  \u54693 \u54616 \u50668  \u52636 \u48156 \u54616 \u50688 \u45796 . \u46160 \u47140 \u50868  \u50948 \u54744 \u51060  \u44536 \u47484  \u44592 \u45796 \u47532 \u44256  \u51080 \u50632 \u45796 . \u46020 \u51473 \u50640 \u49436  \u44536 \u47484  \u52404 \u54252 \u54616 \u50668  \u49332 \u54644 \u54616 \u47532 \u46972 \u45716  \u54413 \u47928 \u44620 \u51648  \u46028 \u50520 \u51004 \u48064 \u47196  \u44536 \u51032  \u52828 \u44396 \u46308 \u51008  \u51060 \u50752  \u44057 \u51008  \u50948 \u54744 \u54620  \u47784 \u54744 \u51012  \u54616 \u51648  \u47803 \u54616 \u46020 \u47197  \u44536 \u50640 \u44172  \u44036 \u52397 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u44536 \u47196  \u54616 \u50668 \u44552  \u51104 \u49884  \u46041 \u50504  \u48708 \u53584 \u48288 \u47476 \u53356 \u47484  \u46496 \u45208 \u49436  \u44536 \u47484  \u44592 \u44732 \u51060  \u50689 \u51217 \u54616 \u50668  \u48372 \u54840 \u54644  \u51460  \u49324 \u46988 \u51012  \u52286 \u50500 \u44032 \u49436  \u47800 \u51012  \u54588 \u54616 \u46972 \u44256 \u44620 \u51648  \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u54616 \u45208 \u45784 \u44760 \u49436  \u51648 \u51221 \u54644 \u51452 \u49888  \u44536  \u51088 \u47532 \u50640 \u49436  \u46496 \u45208 \u44032 \u44256 \u51088  \u54616 \u51648  \u50506 \u50520 \u45796 . \u50612 \u46496 \u54620  \u54253 \u54413 \u51060  \u44536 \u50640 \u44172  \u48520 \u50612 \u50732 \u51648 \u46972 \u46020  \u44536 \u45716  \u51652 \u47532 \u47484  \u44256 \u49688 \u54616 \u44592  \u50948 \u54616 \u50668  \u44228 \u49549 \u51201 \u51004 \u47196  \u52649 \u49457 \u54644 \u50556  \u54664 \u45796 . \u44536 \u45716  \u47568 \u54616 \u50688 \u45796 . \'93\u45208 \u45716  \u50696 \u47112 \u48120 \u50556  \u44057 \u51060  \u53804 \u51137 \u44284  \u49912 \u50880 \u51032  \u49324 \u46988 \u51060 \u45796 . \u44536 \u46308 \u51032  \u54801 \u48149 \u51060  \u45908 \u54616 \u47732  \u45908 \u54624 \u49688 \u47197  \u45208 \u51032  \u44592 \u49256 \u46020  \u51613 \u44032 \u46112  \u44163 \u51060 \u45796 . \u44536 \u46308 \u51008  \u51060 \u48120  \u45208 \u51032  \u47749 \u50696 \u50752  \u47749 \u47581 \u51012  \u44734 \u50612  \u48260 \u47160 \u45796 . \u54620  \u44032 \u51648  \u45224 \u51008  \u44163 \u51060  \u51080 \u45796 \u47732 , \u44536 \u44163 \u51008  \u51060  \u44032 \u47144 \u54620  \u45208 \u51032  \u50977 \u52404 \u49104 \u51060 \u45796 . \u51060 \u44163 \u47560 \u51200  \u48764 \u50519 \u50500  \u44036 \u45796  \u54644 \u46020  \u46160 \u47157 \u51648  \u50506 \u45796 . \u44536 \u46308 \u51008  \u45236  \u49373 \u47749 \u51012  \u48520 \u44284  \u47751  \u49884 \u44036 \u51004 \u47196  \u45800 \u52629 \u49884 \u53420  \u49688  \u51080 \u51012  \u44163 \u51060 \u45796 . \u44536 \u47084 \u45208  \u45208 \u51032  \u50689 \u54844 \u47564 \u51008  \u44536 \u46308 \u51060  \u48764 \u50519 \u51012  \u49688  \u50630 \u45796 . \u44536 \u47532 \u49828 \u46020 \u51032  \u47568 \u50432 \u51012  \u49464 \u49345 \u50640  \u51204 \u54028 \u54616 \u44256 \u51088  \u54616 \u45716  \u49324 \u46988 \u51008  \u50612 \u45712  \u49692 \u44036 \u51060 \u46304 \u51648  \u51453 \u51020 \u51012  \u44033 \u50724 \u54616 \u50668 \u50556  \u54620 \u45796 \'94 (D\'92Aubigne, b.4, ch.4).\
\uc0\u47336 \u53552 \u44032  \u50500 \u50864 \u53356 \u49828 \u48512 \u47476 \u53356 \u50640  \u46020 \u52265 \u54616 \u50688 \u45796 \u45716  \u49548 \u49885 \u51008  \u48277 \u50773 \u51032  \u49324 \u51208 \u51012  \u47588 \u50864  \u44592 \u49240 \u44172  \u54616 \u50688 \u45796 . \u49464 \u44228 \u51032  \u51060 \u47785 \u51012  \u51665 \u51473 \u49884 \u53416  \u54056 \u50669 \u47924 \u46020 \u54620  \u51060 \u45800 \u51088 \u44032  \u51060 \u51228  \u47196 \u47560 \u51032  \u44428 \u49464  \u50500 \u47000  \u46308 \u50612 \u50728  \u44163 \u52376 \u47100  \u45712 \u44788 \u51276 \u45796 . \u44536 \u47084 \u48064 \u47196  \u48277 \u50773 \u51032  \u49324 \u51208 \u51008  \u44536 \u47484  \u45459 \u52824 \u51648  \u50506 \u44192 \u45796 \u44256  \u44208 \u49900 \u54616 \u50688 \u45796 . \u44060 \u54785 \u51088 \u45716  \u53685 \u54665 \u44428 \u51012  \u44032 \u51648 \u51648  \u50506 \u44256  \u50772 \u45796 . \u44536 \u51032  \u52828 \u44396 \u46308 \u51008  \u44536 \u44163 \u51060  \u50630 \u51060  \u48277 \u50773 \u51032  \u49324 \u51208  \u50526 \u50640  \u45208 \u53440 \u45208 \u51648  \u47568 \u46020 \u47197  \u44036 \u52397 \u54616 \u45716  \u54620 \u54200  \u44536 \u46308  \u51088 \u49888 \u51060  \u54889 \u51228 \u47196 \u48512 \u53552  \u44536 \u44163 \u51012  \u50619 \u44256 \u51088  \u44368 \u49453 \u54616 \u50688 \u45796 . \u48277 \u50773 \u51032  \u49324 \u51208 \u51008  \u47336 \u53552 \u47196  \u54616 \u50668 \u44552  \u51088 \u49888 \u51032  \u51452 \u51109 \u51012  \u52712 \u49548 \u54616 \u44172  \u54616 \u46304 \u51648 , \u44536 \u44163 \u51060  \u50504  \u46104 \u47732  \u44536 \u47484  \u47196 \u47560 \u47196  \u48372 \u45236 \u50612  \u54980 \u49828 \u50752  \u51228 \u47212 \u51060  \u45817 \u54620  \u44163 \u44284  \u46609 \u44057 \u51008  \u50868 \u47749 \u50640  \u48736 \u46888 \u47532 \u44256 \u51088  \u44228 \u54925 \u54616 \u50688 \u45796 . \u44536 \u47084 \u48064 \u47196  \u44536 \u45716  \u48512 \u54616 \u46308 \u51012  \u49884 \u53020 \u49436  \u47336 \u53552 \u47196  \u54616 \u50668 \u44552  \u51088 \u44592 \u51032  \u51088 \u48708 \u47484  \u48127 \u44256  \u53685 \u54665 \u44428  \u50630 \u51060  \u52636 \u46160 \u54616 \u44172  \u54616 \u44256 \u51088  \u45432 \u47141 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44060 \u54785 \u51088 \u45716  \u44536 \u47111 \u44172  \u54616 \u45716  \u51068 \u51012  \u45800 \u50672 \u53076  \u44144 \u51208 \u54616 \u50688 \u45796 . \u44536 \u45716  \u54889 \u51228 \u44032  \u48372 \u54840 \u47484  \u50557 \u49549 \u54616 \u45716  \u47928 \u49436 \u47484  \u51452 \u44592 \u44620 \u51648  \u48277 \u50773 \u51032  \u49324 \u51208  \u50526 \u50640  \u45208 \u53440 \u45208 \u51648  \u50506 \u50520 \u45796 .\
\uc0\u48277 \u50773  \u52769 \u50640 \u49436 \u45716  \u47336 \u53552 \u47484  \u49444 \u48373 \u49884 \u53412 \u44592  \u50948 \u54620  \u54616 \u45208 \u51032  \u49696 \u52293 \u51004 \u47196  \u48512 \u46300 \u47084 \u50868  \u53468 \u46020 \u47484  \u52712 \u54616 \u44256 \u51088  \u51089 \u51221 \u54616 \u50688 \u45796 . \u48277 \u50773 \u51032  \u49324 \u51208 \u51008  \u44536 \u50752  \u54924 \u44204 \u54616 \u47732 \u49436  \u47588 \u50864  \u50864 \u54840 \u51201 \u51064  \u53468 \u46020 \u47484  \u45208 \u53440 \u45256 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u47336 \u53552 \u50640 \u44172  \u47924 \u51312 \u44148  \u44368 \u54924 \u51032  \u44428 \u50948 \u50640  \u48373 \u51333 \u54616 \u44256  \u50612 \u46500  \u51216 \u50640 \u49436 \u46304 \u51648  \u51060 \u47200 \u44284  \u51032 \u47928 \u51012  \u51228 \u44592 \u54616 \u51648  \u47568 \u44256  \u44404 \u48373 \u54616 \u44592 \u47484  \u50836 \u44396 \u54616 \u50688 \u45796 . \u44536 \u45716  \u51088 \u44592 \u44032  \u52712 \u44553 \u54616 \u44256  \u51080 \u45716  \u49324 \u46988 \u51032  \u49457 \u44201 \u51012  \u50732 \u48148 \u47476 \u44172  \u54032 \u45800 \u54616 \u51648  \u47803 \u54616 \u50688 \u45796 . \u51060 \u50640  \u45824 \u54616 \u50668  \u47336 \u53552 \u45716  \u44368 \u54924 \u50640  \u45824 \u54620  \u51088 \u44592 \u51032  \u44288 \u49900 \u44284  \u51652 \u47532 \u50640  \u45824 \u54620  \u50837 \u47581 \u44284  \u51088 \u44592 \u51032  \u44032 \u47476 \u52840 \u50640  \u45824 \u54616 \u50668  \u51228 \u44592 \u54616 \u45716  \u50728 \u44054  \u48152 \u45824 \u50640  \u51600 \u44144 \u51060  \u45813 \u48320 \u54624  \u47560 \u51020 \u44284  \u50612 \u46500  \u53945 \u48324 \u54620  \u45824 \u54617 \u50640 \u49436  \u51088 \u44592 \u51032  \u44368 \u47532 \u47484  \u44160 \u53664 \u54616 \u44192 \u45796 \u47732  \u53132 \u55176  \u51025 \u54624  \u51032 \u49324 \u44032  \u51080 \u45796 \u45716  \u44163  \u46321 \u51012  \u54364 \u47749 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u50724 \u47448 \u50640  \u45824 \u54620  \u54032 \u47749 \u51060  \u45208 \u44592 \u46020  \u51204 \u50640  \u49888 \u50521 \u51032  \u52712 \u49548 \u47564 \u51012  \u50836 \u44396 \u54616 \u45716  \u48277 \u50773 \u51032  \u49324 \u51208 \u51032  \u53468 \u46020 \u50640 \u45716  \u48152 \u45824 \u54616 \u50688 \u45796 .\
\uc0\u48277 \u50773  \u52769 \u51032  \u48152 \u51025 \u51008  \u50724 \u47196 \u51648  \'93\u52712 \u49548 \u54616 \u46972 , \u52712 \u49548 \u54616 \u46972 \'94\u45716  \u47568 \u49104 \u51060 \u50632 \u45796 . \u47336 \u53552 \u45716  \u51088 \u44592 \u51032  \u51452 \u51109 \u51060  \u49457 \u44221 \u50640 \u49436  \u45208 \u50728  \u44163 \u51060 \u48064 \u47196  \u51652 \u47532 \u47484  \u48512 \u51064 \u54624  \u49688  \u50630 \u45796 \u44256  \u45800 \u54840 \u54616 \u44172  \u50616 \u47749 \u54616 \u50688 \u45796 . \u47336 \u53552 \u51032  \u51060 \u47200 \u50640  \u45824 \u45813 \u54624  \u49688  \u50630 \u44172  \u46108  \u48277 \u50773 \u51032  \u49324 \u51208 \u51008  \u48708 \u45212 \u44284  \u50837 \u49444 \u44284  \u52293 \u47581 \u51012  \u50143 \u50500  \u45459 \u51020 \u51004 \u47196  \u50948 \u50517 \u54616 \u44256 , \u44368 \u48512  (\u25934 \u29238 ) \u46308 \u51032  \u47568 \u44284  \u51204 \u49444 \u51012  \u50668 \u44592 \u51200 \u44592 \u49436  \u51064 \u50857 \u54616 \u50668  \u45720 \u50612 \u45459 \u51020 \u51004 \u47196 \u50024  \u47336 \u53552 \u50640 \u44172  \u45908  \u51060 \u49345  \u47568 \u54624  \u44592 \u54924 \u47484  \u51452 \u51648  \u50500 \u45768 \u54616 \u50688 \u45796 . \u44536 \u47088  \u49345 \u53468 \u47196  \u54924 \u51032 \u47484  \u44228 \u49549 \u54616 \u47732  \u44208 \u44397  \u54747 \u49688 \u44256 \u47564  \u54616 \u44172  \u46112  \u44163 \u51012  \u50504  \u47336 \u53552 \u45716  \u46300 \u46356 \u50612  \u44536 \u51032  \u45813 \u48320 \u51012  \u47928 \u49436 \u47196 \u50024  \u51228 \u52636 \u54616 \u46972 \u45716 , \u47560 \u51648 \u47803 \u54620  \u54728 \u46973 \u51012  \u48155 \u50500 \u45256 \u45796 .\
