\f1\b0 \cf0 \
\uc0\u52768 \u48729 \u44544 \u47532 \u45716  \u52712 \u47532 \u55176 \u50640 \u49436  \u47732 \u51396 \u48512 \u51032  \u54032 \u47588 \u51064 \u51012  \u48152 \u45824 \u54616 \u50668  \u50676 \u47148 \u54616 \u44172  \u49444 \u44368 \u54616 \u50688 \u45796 . \u49340 \u49552 \u51060  \u51021  \u44032 \u44620 \u50868  \u44275 \u44620 \u51648  \u50772 \u51012  \u46412 \u50640  \u51032 \u54924 \u50640 \u49436  \u54620  \u49324 \u51088 \u47484  \u48372 \u45236 \u50612  \u44536 \u44032  \u47932 \u47084 \u44032 \u44592 \u47484  \u48148 \u46976 \u45796 \u45716  \u46907 \u51012  \u51204 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u47784 \u47029 \u51012  \u50024 \u49436  \u47560 \u52840 \u45236  \u44536  \u44275 \u50640  \u46308 \u50612 \u50724 \u44592 \u45716  \u54616 \u50688 \u51004 \u45208  \u54620  \u51109 \u51032  \u47732 \u51396 \u48512 \u46020  \u54036 \u51648  \u47803 \u54616 \u44256  \u53748 \u44144 \u45817 \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u45716  \u44263  \u49828 \u50948 \u49828 \u47484  \u46496 \u45208 \u44052 \u45796 .\
1519\uc0\u45380 \u50640  \u49828 \u50948 \u49828 \u51032  \u51204 \u44397 \u51012  \u55081 \u50420  \u53360  \u50669 \u48337 \u51008  \u44060 \u54785  \u49324 \u50629 \u51012  \u52489 \u51652  (\u20419 \u36914 ) \u49884 \u53412 \u45716  \u45936  \u53360  \u50669 \u54624 \u51012  \u54664 \u45796 . \u49324 \u46988 \u46308 \u51060  \u51060 \u47084 \u54620  \u46160 \u47140 \u50868  \u51656 \u48337 \u50640  \u51649 \u47732 \u54616 \u44172  \u46104 \u51088 , \u44536 \u46308 \u51008  \u50620 \u47560  \u51204 \u50640  \u51200 \u46308 \u51060  \u49324  \u46164  \u47732 \u51396 \u48512 \u44032  \u50620 \u47560 \u45208  \u47924 \u47141 \u54620  \u44163 \u51064 \u51648  \u49892 \u51228 \u47196  \u44648 \u45803 \u44172  \u46104 \u50632 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u46308 \u51008  \u45908 \u50865  \u54869 \u49892 \u54620  \u49888 \u50521 \u51032  \u53664 \u45824 \u47484  \u44040 \u47581 \u54616 \u44172  \u46104 \u50632 \u45796 . \u52712 \u47532 \u55176 \u50640 \u49436  \u52768 \u48729 \u44544 \u47532 \u45716  \u48337 \u50640  \u44152 \u47140  \u44144 \u51032  \u54924 \u48373 \u46112  \u44032 \u47581 \u51060  \u50630 \u51012  \u47564 \u53372  \u50948 \u46021 \u54616 \u44172  \u46104 \u50632 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u44032  \u51453 \u50632 \u45796 \u45716  \u49548 \u47928 \u44620 \u51648  \u54140 \u51648 \u44172  \u46104 \u50632 \u45796 . \u51060 \u47084 \u54620  \u49884 \u47144  \u49549 \u50640 \u49436 \u46020  \u52768 \u48729 \u44544 \u47532 \u45716  \u55148 \u47581 \u44284  \u50857 \u44592 \u47484  \u51312 \u44552 \u46020  \u51075 \u50612 \u48260 \u47532 \u51648  \u50506 \u50520 \u45796 . \u44536 \u45716  \u48127 \u51020 \u51004 \u47196  \u44040 \u48148 \u47532 \u51032  \u49901 \u51088 \u44032 \u47484  \u48148 \u46972 \u48372 \u50520 \u51004 \u47728 , \u51396 \u51032  \u44050 \u51012  \u50756 \u51204 \u55176  \u44058 \u50500  \u51452 \u49892  \u44163 \u51012  \u49888 \u47280 \u54616 \u50688 \u45796 . \u49324 \u44221  (\u27515 \u22659 ) \u50640 \u49436  \u54924 \u48373 \u46104 \u51088  \u44536 \u45716  \u51204 \u50640  \u50630 \u45912  \u50676 \u49457 \u51004 \u47196  \u48373 \u51020 \u51012  \u51204 \u54616 \u50688 \u45716 \u45936 , \u44536 \u51032  \u47568 \u50640 \u45716  \u48708 \u49345 \u54620  \u45733 \u47141 \u51060  \u51080 \u50632 \u45796 . \u51316 \u44221 \u54616 \u45716  \u47785 \u51088 \u44032  \u44144 \u51032  \u51453 \u51012  \u48852 \u54616 \u50688 \u45796 \u44032  \u54924 \u48373 \u46104 \u50632 \u51004 \u48064 \u47196  \u49324 \u46988 \u46308 \u51008  \u44536 \u47484  \u44592 \u49256 \u51004 \u47196  \u47582 \u51060 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u48337 \u51088 \u46308 \u51012  \u44036 \u54840 \u54616 \u44144 \u45208  \u51453 \u51008  \u51088 \u46308 \u51032  \u44225 \u50640  \u49436  \u51080 \u44592 \u46020  \u54616 \u50688 \u51004 \u48064 \u47196 , \u51060 \u51204 \u48372 \u45796  \u48373 \u51020 \u51032  \u44032 \u52824 \u47484  \u45908 \u50865  \u44618 \u51060  \u44648 \u45803 \u44172  \u46104 \u50632 \u45796 .\
\uc0\u51060 \u48120  \u52768 \u48729 \u44544 \u47532 \u45716  \u48373 \u51020 \u51032  \u51652 \u47532 \u47484  \u54620 \u52789  \u45908  \u48516 \u47749 \u55176  \u51060 \u54644 \u54616 \u44256 , \u49352 \u47213 \u44172  \u54616 \u50668  \u51452 \u49884 \u45716  \u44536  \u45733 \u47141 \u51012  \u49828 \u49828 \u47196  \u50756 \u51204 \u55176  \u52404 \u54744 \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u51064 \u47448 \u51032  \u53440 \u46973 \u44284  \u44396 \u49549 \u51032  \u44228 \u54925 \u51008  \u44536 \u44032  \u47792 \u46160 \u54616 \u50668  \u50672 \u44396 \u54616 \u45716  \u51228 \u47785 \u51060  \u46104 \u50632 \u45796 . \u44536 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u51452 \u51109 \u54616 \u50688 \u45796 . \'93\u50500 \u45812  \u50504 \u50640 \u49436  \u50864 \u47532 \u45716  \u47784 \u46160  \u51453 \u50632 \u44256 , \u53440 \u46973 \u44284  \u51221 \u51396 \u51032  \u44396 \u47105 \u53573 \u51060 \u50640  \u48736 \u51648 \u44172  \u46104 \u50632 \u45796 \'94 (Wylie, b.8, ch.9). \'93\u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u44536  \u50689 \u50896 \u54620  \u49549 \u47049 \u51004 \u47196  \u50864 \u47532 \u47484  \u49324 \u49512 \u45796 . \'85\u44536 \u48516 \u51032  \u49688 \u45212 \u51008 \'85\u50689 \u50896 \u54620  \u55148 \u49373 \u51060 \u50836 \'85\u46608 \u54620  \u50864 \u47532 \u47484  \u44256 \u52432  \u51452 \u49884 \u44592 \u50640  \u52649 \u48516 \u54616 \u45796 . \u44536 \u47084 \u48064 \u47196  \u44536 \u44163 \u51008  \u44403 \u44172  \u49436 \u49436  \u50880 \u51649 \u51060 \u51648  \u50506 \u45716  \u48127 \u51020 \u51004 \u47196  \u44536 \u48516 \u51012  \u51032 \u47280 \u54616 \u45716  \u47784 \u46304  \u49324 \u46988 \u46308 \u51012  \u50948 \u54616 \u50668  \u54616 \u45208 \u45784 \u51032  \u44277 \u51032 \u47484  \u50689 \u50896 \u55176  \u52649 \u51313 \u49884 \u53020  \u51456 \u45796 .\'94 \u44536 \u47084 \u45208  \u44536 \u45716  \u49324 \u46988 \u51060  \u44536 \u47532 \u49828 \u46020 \u51032  \u51008 \u54812  \u46412 \u47928 \u50640  \u51396 \u47484  \u44228 \u49549 \u51201 \u51004 \u47196  \u48276 \u54644 \u49436 \u45716  \u50504  \u46108 \u45796 \u44256  \u48157 \u55176  \u44032 \u47476 \u52452 \u45796 . \'93\u54616 \u45208 \u45784 \u44760  \u45824 \u54620  \u48127 \u51020 \u51060  \u51080 \u45716  \u44275 \u50640 \u45716  \u54616 \u45208 \u45784 \u44760 \u49436  \u48152 \u46300 \u49884  \u44228 \u49888 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436  \u44228 \u49888  \u44275 \u50640 \u45716  \u48152 \u46300 \u49884  \u49324 \u46988 \u46308 \u47196  \u54616 \u50668 \u44552  \u49440 \u54620  \u51068 \u51012  \u54665 \u54616 \u46020 \u47197  \u44053 \u44428 \u54616 \u44256  \u44053 \u50836 \u54616 \u45716  \u50676 \u49900 \u51060  \u51080 \u45796 \'94 (D\'92Aubigne, b.8, ch.9).\
\uc0\u52768 \u48729 \u44544 \u47532 \u51032  \u49444 \u44368 \u45716  \u47588 \u50864  \u55141 \u48120 \u47196 \u50912 \u51004 \u48064 \u47196  \u44536 \u51032  \u49444 \u44368 \u47484  \u46308 \u51004 \u47084  \u50724 \u45716  \u47924 \u47532 \u46308 \u47196  \u44536  \u53360  \u49457 \u45817 \u51008  \u50616 \u51228 \u45208  \u44032 \u46301 \u54616 \u50688 \u45796 . \u44536 \u45716  \u52397 \u51473 \u46308 \u51060  \u44048 \u45817 \u54624  \u49688  \u51080 \u51012  \u47564 \u53372  \u51312 \u44552 \u50473  \u51312 \u44552 \u50473  \u51652 \u47532 \u47484  \u44032 \u47476 \u52432  \u51452 \u50632 \u45796 . \u44536 \u45716  \u52376 \u51020 \u48512 \u53552  \u44536 \u46308 \u51012  \u45440 \u46972 \u44172  \u54616 \u44144 \u45208  \u54200 \u44204 \u51012  \u51068 \u51004 \u53420  \u51216 \u51012  \u44032 \u47476 \u52824 \u51648  \u50506 \u44592  \u50948 \u54616 \u50668  \u51312 \u49900 \u54616 \u50688 \u45796 . \u44536 \u51032  \u51068 \u51008  \u44536 \u46308 \u51032  \u47560 \u51020 \u51012  \u44536 \u47532 \u49828 \u46020 \u51032  \u44368 \u54984  \u44032 \u50868 \u45936 \u47196  \u51060 \u45132 \u44256 , \u44536 \u47532 \u49828 \u46020 \u51032  \u49324 \u46993 \u51004 \u47196  \u51200 \u46308 \u51032  \u47560 \u51020 \u51012  \u48512 \u46300 \u47101 \u44172  \u54644 \u51452 \u44256 , \u44536 \u47532 \u49828 \u46020 \u51032  \u47784 \u48376 \u51012  \u51200 \u46308  \u50526 \u50640  \u48372 \u50668  \u51452 \u45716  \u44163 \u51060 \u50632 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u46308 \u51060  \u48373 \u51020 \u51032  \u50896 \u52825 \u51012  \u48155 \u50500 \u46308 \u51060 \u44256 , \u44536 \u46308 \u51060  \u44032 \u51276 \u45912  \u48120 \u49888 \u51201 \u51064  \u49888 \u50521 \u51012  \u51088 \u50672 \u55176  \u45236 \u50612  \u48260 \u47532 \u46020 \u47197  \u54644 \u51452 \u45716  \u51068 \u51060 \u50632 \u45796 .\
