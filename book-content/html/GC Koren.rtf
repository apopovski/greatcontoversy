\uc0\u48512 \u47784 \u46308 \u51008  \u51064 \u51221  \u51080 \u44256  \u51088 \u50528 \u47196 \u50864 \u47732 \u49436 \u46020  \u47588 \u50864  \u51648 \u54812 \u47196 \u50912 \u44592  \u46412 \u47928 \u50640  \u44536 \u46308 \u51032  \u51088 \u45376 \u46308 \u51012  \u51648 \u45208 \u52824 \u44172  \u49324 \u46993 \u54632 \u51004 \u47196  \u44536 \u46308 \u51060  \u48169 \u51333 \u51032  \u45208 \u49244  \u48260 \u47495 \u51012  \u44032 \u51648 \u51648  \u50506 \u44172 \u45140  \u54616 \u50688 \u45796 . \u44536 \u46308 \u51032  \u50526 \u44600 \u50640 \u45716  \u49884 \u47144 \u44284  \u44256 \u45212 , \u49900 \u51648 \u50612 \u45716  \u49692 \u44368 \u51088 \u51032  \u51453 \u51020 \u51060  \u44032 \u47196 \u45459 \u50668  \u51080 \u50632 \u45796 . \u44536 \u46308 \u51008  \u50612 \u47140 \u49436 \u48512 \u53552  \u54872 \u45212 \u51012  \u44204 \u46356 \u44256 , \u53685 \u51228 \u50640  \u48373 \u51333 \u54616 \u44256 , \u49828 \u49828 \u47196  \u49373 \u44033 \u54616 \u50668  \u54665 \u46041 \u54616 \u46020 \u47197  \u44368 \u50977 \u51012  \u48155 \u50520 \u45796 . \u50500 \u51452  \u50612 \u47140 \u49436 \u48512 \u53552  \u44536 \u46308 \u51008  \u52293 \u51076 \u51012  \u51648 \u45716  \u44163 \u44284  \u47568 \u51012  \u49340 \u44032 \u45716  \u44163 \u44284  \u52840 \u47925 \u51032  \u51648 \u54812 \u47484  \u51060 \u54644 \u54616 \u45716  \u44163 \u51012  \u48176 \u50912 \u45796 . \u54620  \u47560 \u46356 \u51032  \u44221 \u49556 \u54620  \u47568 \u51060 \u46972 \u46020  \u50896 \u49688 \u51032  \u44480 \u50640  \u46308 \u50612 \u44032 \u44172  \u46104 \u47732  \u44536  \u47568 \u51012  \u54620  \u44060 \u51064 \u51032  \u49373 \u47749 \u49104 \u47564  \u50500 \u45768 \u46972  \u47566 \u51008  \u46041 \u47308 \u46308 \u51032  \u49373 \u47749  \u46608 \u54620  \u50948 \u54744 \u54616 \u44172  \u46112  \u44163 \u51060 \u50632 \u45796 . \u50780 \u45264 \u54616 \u47732  \u51652 \u47532 \u51032  \u50896 \u49688 \u44032  \u47560 \u52824  \u51060 \u47532 \u44032  \u47673 \u51060 \u47484  \u49324 \u45285 \u54616 \u46319 \u51060  \u49888 \u50521 \u51032  \u51088 \u50976 \u47484  \u51452 \u51109 \u54616 \u45716  \u49324 \u46988 \u46308 \u51012  \u51923 \u50500 \u45796 \u45768 \u47728  \u52286 \u44256  \u51080 \u50632 \u44592  \u46412 \u47928 \u51060 \u50632 \u45796 .\
\uc0\u50760 \u45940 \u49828 \u51064 \u46308 \u51008  \u51652 \u47532 \u47484  \u50948 \u54616 \u50668  \u49464 \u49549 \u51201  \u48264 \u50689 \u44284  \u50976 \u51061 \u51012  \u45796  \u48260 \u47532 \u44256  \u44984 \u51456 \u54620  \u51064 \u45236 \u47196 \u50024  \u51088 \u44592 \u51032  \u50577 \u49885 \u51012  \u50619 \u44592 \u50640  \u49688 \u44256 \u54616 \u50688 \u45796 . \u44618 \u51008  \u49328 \u44264 \u51676 \u44592 \u50640 \u49436 \u46020  \u44221 \u51089 \u54624  \u47564 \u54620  \u53664 \u51648 \u47484  \u48156 \u44204 \u54616 \u47732  \u51593 \u49884  \u44536 \u44163 \u51012  \u51096  \u44060 \u44036 \u54616 \u50688 \u51004 \u48064 \u47196  \u46300 \u46356 \u50612  \u44264 \u51676 \u44592 \u50752  \u50616 \u45909 \u51032  \u49324 \u47732  (\u26012 \u38754 ) \u46308 \u51008  \u47566 \u51008  \u49688 \u54869 \u51012  \u45236 \u45716  \u45453 \u53664 \u47196  \u48320 \u54664 \u45796 . \u44160 \u49548 \u50752  \u50628 \u44201 \u54620  \u44537 \u44592 \u51032  \u51221 \u49888 \u51008  \u44536  \u51088 \u45376 \u46308 \u50640 \u44172  \u50976 \u51068 \u54620  \u50976 \u49328 \u51004 \u47196 \u50024  \u44368 \u50977 \u51032  \u51068 \u48512 \u44032  \u46104 \u50632 \u45796 . \u44536 \u46308 \u51008  \u54616 \u45208 \u45784 \u44760 \u49436  \u44536 \u46308 \u51032  \u49373 \u50528 \u47484  \u54984 \u47144 \u49884 \u53412 \u47140 \u45716  \u46907 \u51060  \u47924 \u50631 \u51060 \u46972 \u45716  \u44163 \u44284  \u44536 \u46308 \u51032  \u44417 \u54605 \u51008  \u47784 \u46160  \u44033 \u51088 \u51032  \u49688 \u44256 \u50752  \u49373 \u44033 \u44284  \u51452 \u51032 \u50752  \u49888 \u50521 \u51004 \u47196 \u47564  \u48372 \u52649 \u54624  \u49688  \u51080 \u45796 \u45716  \u44163 \u51012  \u48176 \u50912 \u45796 . \u44536 \u46308 \u51032  \u49373 \u50528 \u45716  \u49892 \u47196  \u49688 \u44256 \u47213 \u44256  \u44256 \u45804 \u54536  \u44163 \u51060 \u50632 \u51004 \u45208  \u44536 \u44163 \u51008  \u44148 \u51204 \u54620  \u44163 \u51060 \u50632 \u4