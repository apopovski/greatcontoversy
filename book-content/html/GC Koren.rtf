\uc0\u50728  \u54616 \u45720 \u51008  \u52285 \u51312 \u51452 \u51032  \u50689 \u44305 \u51012  \u48152 \u50689 \u54616 \u44256  \u54616 \u45208 \u45784 \u44760  \u52268 \u50577 \u54616 \u44592 \u47484  \u44592 \u48848 \u54616 \u50688 \u45796 . \u44536 \u47532 \u44256  \u54616 \u45208 \u45784 \u44760 \u49436  \u51060 \u52376 \u47100  \u51316 \u44221 \u51012  \u48155 \u51004 \u49884 \u45716  \u46041 \u50504  \u47784 \u46304  \u44163 \u51060  \u54217 \u50504 \u54616 \u44256  \u44592 \u48868 \u45796 . \u44536 \u47088 \u45936  \u51060 \u51228  \u54620  \u48516 \u51137 \u51032  \u51020 \u49457 \u51060  \u45208 \u53440 \u45208 \u49436  \u54616 \u45720 \u51032  \u51312 \u54868 \u47484  \u44648 \u46888 \u47160 \u45796 . \u52285 \u51312 \u51452 \u51032  \u44228 \u54925 \u50640  \u48152 \u45824 \u46104 \u45716  \u51088 \u44592  \u52268 \u50577 , \u51088 \u44592  \u48393 \u49324 \u45716  \u54616 \u45208 \u45784 \u51032  \u50689 \u44305 \u51012  \u52572 \u44256 \u47196  \u50668 \u44592 \u45716  \u51088 \u46308 \u51032  \u47560 \u51020 \u50640  \u48520 \u54665 \u50640  \u45824 \u54620  \u50696 \u44048 \u51012  \u48520 \u47084 \u51068 \u51004 \u53040 \u45796 . \u54616 \u45720 \u51032  \u54924 \u51032 \u45716  \u47336 \u49828 \u48296 \u50640 \u44172  \u44036 \u52397 \u54664 \u45796 . \u54616 \u45208 \u45784 \u51032  \u50500 \u46308 \u51008  \u44536 \u50640 \u44172  \u52285 \u51312 \u51452 \u51032  \u50948 \u45824 \u54616 \u49884 \u44256  \u49440 \u54616 \u49884 \u44256  \u44277 \u51032 \u47196 \u50864 \u49900 \u51012  \u50508 \u47140  \u51452 \u44256 , \u44536 \u48516 \u51032  \u50984 \u48277 \u51032  \u49888 \u49457 \u54616 \u44256  \u48320 \u52824  \u50506 \u45716  \u53945 \u49457 \u51012  \u51228 \u49884 \u54644  \u51452 \u49512 \u45796 . \u54616 \u45720 \u51032  \u51656 \u49436 \u45716  \u54616 \u45208 \u45784 \u44760 \u49436  \u52828 \u55176  \u49464 \u50864 \u49512 \u45796 . \u44536 \u47084 \u48064 \u47196  \u47336 \u49828 \u48296 \u51060  \u44536  \u51656 \u49436 \u50640 \u