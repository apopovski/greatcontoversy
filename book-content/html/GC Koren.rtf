71 \u45208 \u45768  \u44552 \u54693 \u47196 \u50752  \u49324 \u47732 \u51012  \u44552 \u51004 \u47196  \u49916  \u50616 \u50557 \u44452 \u44032  \u51080 \u44256  \u44536  \u50504 \u50640  \u47564 \u45208 \u47484  \u45812 \u51008  \u44552 \u54637 \u50500 \u47532 \u50752  \u50500 \u47200 \u51032  \u49913  \u45212  \u51648 \u54049 \u51060 \u50752  \u50616 \u50557 \u51032  \u48708 \u49437 \u46308 \u51060  \u51080 \u44256  \u44536  \u50948 \u50640  \u49549 \u51396 \u49548 \u47484  \u45934 \u45716  \u50689 \u44305 \u51032  \u44536 \u47353 \u46308 \u51060  \u51080 \u51004 \u45768 \'94 (\u55176  9:1~5).\
\uc0\u48148 \u50872 \u51060  \u50668 \u44592  \u47568 \u54620  \u49457 \u49548 \u45716  \u47784 \u49464 \u44032  \u54616 \u45208 \u45784 \u51032  \u47749 \u47161 \u51012  \u46384 \u46972  \u51648 \u44537 \u55176  \u45458 \u51004 \u49888  \u48516 \u51032  \u44144 \u54616 \u49892  \u44275 \u51004 \u47196  \u51060  \u49464 \u49345 \u50640  \u51648 \u51008  \u49457 \u47561 \u51060 \u50632 \u45796 . \'93\u45236 \u44032  \u44536 \u46308  \u51473 \u50640  \u44144 \u54624  \u49457 \u49548 \u47484  \u44536 \u46308 \u51012  \u49884 \u53020  \u45208 \u47484  \u50948 \u54616 \u50668 \'94 (\u52636  25:8) \u51648 \u51004 \u46972 \u45716  \u47568 \u51008  \u47784 \u49464 \u44032  \u54616 \u45208 \u45784 \u44284  \u54632 \u44760  \u49328 \u50640  \u51080 \u51012  \u46412 \u50640  \u48155 \u51008  \u47749 \u47161 \u51060 \u50632 \u45796 . \u44536  \u45817 \u49884  \u51060 \u49828 \u46972 \u50648  \u49324 \u46988 \u46308 \u51008  \u44305 \u50556 \u47484  \u50668 \u54665 \u54616 \u44256  \u51080 \u50632 \u51004 \u48064 \u47196  \u49457 \u49548 \u45716  \u51060  \u51109 \u49548 \u50640 \u49436  \u51200  \u51109 \u49548 \u47196  \u51060 \u46041 \u54624  \u49688  \u51080 \u44172  \u51648 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44536 \u44163 \u51008  \u47588 \u50864  \u51109 \u50628 \u54616 \u44256  \u54868 \u47140 \u54620  \u44396 \u51312 \u47932 \u51060 \u50632 \u45796 . \u44536  \u48317 \u51008  \u44552 \u51004 \u47196  \u46160 \u44749 \u44172  \u49916  \u44204 \u44256 \u54620  \u54032 \u47785 \u51004 \u47196  \u47564 \u46308 \u50612  \u51008 \u48155 \u52840  \u50948 \u50640  \u49464 \u50912 \u45796 . \u44536  \u51648 \u48533 \u51008  \u51109 \u47561 , \u44263  \u54252 \u51109 \u46308 \u47196  \u46104 \u50632 \u45716 \u45936 , \u44169 \u51008  \u51664 \u49849 \u51032  \u44032 \u51453 \u51004 \u47196  \u47564 \u46308 \u44256  \u50504 \u51032  \u52380 \u51109 \u51008  \u44536 \u47353 \u51032  \u54805 \u49345 \u51012  \u50500 \u47492 \u45813 \u44172  \u49688 \u45459 \u50500  \u51680  \u48288 \u47196  \u47564 \u46308 \u50632 \u45796 . \u48264 \u51228 \u45800 \u51060  \u51080 \u45716  \u48148 \u44645  \u46896  \u51060 \u50808 \u50640 , \u49457 \u47561 \u51008  \u54868 \u47140 \u54620  \u55064 \u51109 \u51004 \u47196  \u52856 \u51012  \u47561 \u50500 , \u50526 \u52856 \u51012  \u49457 \u49548 , \u46244 \u52856 \u51012  \u51648 \u49457 \u49548 \u46972 \u44256  \u48512 \u47476 \u45716  \u46160  \u52856 \u51004 \u47196  \u46104 \u50612  \u51080 \u50632 \u45796 . \u49457 \u49548 \u47196  \u46308 \u50612 \u44032 \u45716  \u51077 \u44396 \u46020  \u44536 \u50752  \u44057 \u51008  \u55064 \u51109 \u51004 \u47196  \u44032 \u47532 \u50612 \u51256  \u51080 \u50632 \u45796 .\
\uc0\u49457 \u49548 \u51032  \u45224 \u51901 \u50640  \u52507 \u45824 \u44032  \u51080 \u50632 \u45716 \u45936 , \u44536  \u51068 \u44273  \u46321 \u45824 \u50640  \u51452 \u50556 \u47196  \u48520 \u51012  \u53020 \u49436  \u49457 \u49548 \u47484  \u48157 \u54804 \u45796 . \u46608  \u48513 \u51901 \u50640 \u45716  \u46497 \u51012  \u51652 \u49444 \u54616 \u45716  \u49345 \u51060  \u51080 \u50632 \u45796 . \u49457 \u49548 \u50752  \u51648 \u49457 \u49548 \u47484  \u44032 \u47196 \u47561 \u51008  \u55064 \u51109  \u50526 \u50640 \u45716  \u44552 \u54693 \u45800 \u51060  \u51080 \u50632 \u45716 \u45936 , \u44144 \u44592 \u50640 \u49436 \u45716  \u47588 \u51068  \u51060 \u49828 \u46972 \u50648  \u49324 \u46988 \u46308 \u51032  \u44592 \u46020 \u50752  \u54632 \u44760  \u54693 \u50672 \u51060  \u54616 \u45208 \u45784  \u50526 \u51004 \u47196  \u49345 \u45804 \u46104 \u44256  \u51080 \u50632 \u45796 .\
\uc0\u51648 \u49457 \u49548 \u50640 \u45716  \u44050 \u51652  \u47785 \u51116 \u47196  \u51228 \u51312 \u54616 \u44256  \u44536  \u50504 \u54030 \u51012  \u44552 \u51004 \u47196  \u49916  \u48277 \u44452 \u44032  \u51080 \u50632 \u44256 , \u44536  \u50504 \u50640 \u45716  \u54616 \u45208 \u45784 \u51032  \u49901 \u44228 \u47749 \u51012  \u44592 \u47197 \u54620  \u46160  \u46028 \u48708 \u44032  \u46308 \u50612  \u51080 \u50632 \u45796 . \u44536  \u48277 \u44452  \u50948 \u50640 \u45716  \u48277 \u44452 \u51032  \u46748 \u44753 \u51060  \u46104 \u45716  \u49549 \u51396 \u49548 \u44032  \u51080 \u44256 , \u49692 \u44552 \u51004 \u47196  \u51221 \u44368 \u54616 \u44172  \u47564 \u46304  \u46160  \u44536 \u47353 \u51060  \u47560 \u51452  \u49436  \u51080 \u50632 \u45796 . \u51060  \u51648 \u49457 \u49548 \u50640 \u49436  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u44536  \u44536 \u47353  \u49324 \u51060 \u51032  \u50689 \u44305 \u51032  \u44396 \u47492  \u44032 \u50868 \u45936  \u45208 \u53440 \u45208 \u49512 \u45796 .\
\uc0\u55176 \u48652 \u47532 \u51064 \u46308 \u51060  \u44032 \u45208 \u50504 \u50640  \u51221 \u52265 \u54616 \u44172  \u46104 \u51088 , \u49556 \u47196 \u47788 \u51032  \u49457 \u51204 \u51060  \u49457 \u47561 \u51012  \u45824 \u49888 \u54616 \u44172  \u46104 \u50632 \u45796 . \u44536  \u44148 \u52629 \u51008  \u50689 \u44396 \u51201 \u51060 \u44256  \u44536  \u44508 \u47784 \u46020  \u44361 \u51109 \u54616 \u50688 \u51004 \u45208  \u44033  \u48512 \u48516 \u51008  \u49457 \u47561 \u44284  \u44057 \u51008  \u48708 \u47168 \u47196  \u51648 \u50632 \u44256 , \u44536  \u50504 \u50640 \u45716  \u44057 \u51008  \u44592 \u44396 \u46308 \u51012  \u46160 \u50632 \u45796 . \u44536 \u47532 \u54616 \u50668  \u49457 \u49548 \u45716  \u45796 \u45768 \u50648 \u51032  \u49884 \u45824 \u50640  \u54620  \u48264  \u54028 \u44340 \u46108  \u51068  \u50808 \u50640  \u49436 \u44592  70\u45380 \u50640  \u47196 \u47560 \u44400 \u50640 \u44172  \u54028 \u44340 \u46104 \u44592 \u44620 \u51648  \u44536 \u45824 \u47196  \u45224 \u50500  \u51080 \u50632 \u45796 .\
