\uc0\u50500 \u45812 \u51032  \u49884 \u45824 \u48512 \u53552  \u50724 \u45720 \u45216 \u50640  \u51060 \u47476 \u44592 \u44620 \u51648  \u50864 \u47532 \u51032  \u53360  \u50896 \u49688 \u45716  \u50613 \u50517 \u54616 \u44256  \u54028 \u44340 \u54616 \u45716  \u45936  \u51204 \u47141 \u51012  \u44592 \u50872 \u50668  \u50772 \u45796 . \u44536 \u45716  \u51060 \u51228  \u44368 \u54924 \u47484  \u45824 \u54637 \u54616 \u44592  \u50948 \u54620  \u47560 \u51648 \u47561  \u49912 \u50880 \u51012  \u51456 \u48708 \u54616 \u44256  \u51080 \u45796 . \u50696 \u49688 \u45784 \u51012  \u46384 \u47476 \u44256 \u51088  \u54616 \u45716  \u47784 \u46304  \u49324 \u46988 \u51008  \u51060  \u51092 \u51064 \u54620  \u50896 \u49688 \u50752  \u49912 \u50892 \u50556  \u54624  \u44163 \u51060 \u45796 . \u44536 \u47532 \u49828 \u46020 \u51064 \u51060  \u44144 \u47337 \u54620  \u47784 \u48376 \u51088 \u47484  \u50976 \u49324 \u54616 \u44172  \u45806 \u50500 \u44032 \u47732  \u44040 \u49688 \u47197  \u44536 \u45716  \u45908 \u50865  \u48516 \u47749 \u55176  \u49324 \u45800 \u51032  \u44277 \u44201  \u47785 \u54364 \u44032  \u46112  \u44163 \u51060 \u45796 . \u54616 \u45208 \u45784 \u51032  \u49324 \u50629 \u50640  \u51201 \u44537 \u51201 \u51004 \u47196  \u52280 \u44032 \u54616 \u44256  \u50501 \u54620  \u51088 \u51032  \u44592 \u47564 \u51012  \u54253 \u47196 \u54616 \u44256  \u44536 \u47532 \u49828 \u46020 \u47484  \u49324 \u46988 \u46308 \u50640 \u44172  \u51228 \u49884 \u54616 \u44256 \u51088  \u50528 \u50416 \u45716  \u47784 \u46304  \u49324 \u46988 \u51008 , \u47566 \u51008  \u45576 \u47932 \u44284  \u49884 \u47144  \u49549 \u50640 \u49436  \u44216 \u49552 \u54620  \u47560 \u51020 \u51004 \u47196  \u51452 \u45784 \u44760  \u48393 \u49324 \u54664 \u45432 \u46972 \u44256  \u47568 \u54616 \u45716  \u48148 \u50872 \u51032  \u44036 \u51613 \u50640  \u46041 \u52280 \u54624  \u49688  \u51080 \u45796 .\
\uc0\u49324 \u45800 \u51008  \u44032 \u51109  \u47609 \u47148 \u54616 \u44256  \u44368 \u47896 \u54620  \u49884 \u54744 \u51004 \u47196  \u44536 \u47532 \u49828 \u46020 \u47484  \u44277 \u44201 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u47784 \u46304  \u49912 \u50880 \u51012  \u47932 \u47532 \u52824 \u49512 \u45796 . \u51452 \u45784 \u44760 \u49436 \u45716  \u50864 \u47532 \u47484  \u50948 \u54616 \u50668  \u44536  \u49912 \u50880 \u46308 \u51012  \u49912 \u50864 \u49512 \u45796 . \u44536 \u47532 \u49828 \u46020 \u51032  \u49849 \u47532 \u46308 \u51008  \u50864 \u47532 \u44032  \u49849 \u47532 \u54616 \u45716  \u44163 \u51012  \u44032 \u45733 \u52992  \u54644 \u51456 \u45796 . \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u44396 \u54616 \u45716  \u47784 \u46304  \u51088 \u50640 \u44172  \u45733 \u47141 \u51012  \u51452 \u49888 \u45796 . \u51088 \u49888 \u51060  \u46041 \u51032 \u54616 \u51648  \u50506 \u51004 \u47732  \u49324 \u45800 \u50640 \u44172  \u51221 \u48373 \u45817 \u54624  \u49688  \u50630 \u45796 . \u50976 \u54841 \u51088 \u45716  \u49324 \u46988 \u51032  \u51032 \u51648 \u47484  \u51648 \u48176 \u54616 \u44144 \u45208  \u51396 \u47484  \u48276 \u54616 \u46020 \u47197  \u44053 \u51228 \u54624  \u45733 \u47141 \u51060  \u51312 \u44552 \u46020  \u50630 \u45796 . \u44536 \u45716  \u49324 \u46988 \u51012  \u44340 \u47213 \u55184  \u49688 \u45716  \u51080 \u50612 \u46020  \u45908 \u47101 \u55184  \u49688 \u45716  \u50630 \u45796 . \u44536 \u45716  \u48264 \u48124 \u52992  \u54624  \u49688 \u45716  \u51080 \u51004 \u45208  \u51396 \u50640  \u47932 \u46308 \u44172  \u54624  \u49688 \u45716  \u50630 \u45796 . \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u49849 \u47532 \u54616 \u49512 \u45796 \u45716  \u49324 \u49892 \u51008  \u44536 \u48516 \u51012  \u46384 \u47476 \u45716  \u49324 \u46988 \u46308 \u50640 \u44172  \u51396 \u50752  \u49324 \u45800 \u51012  \u45824 \u54637 \u54616 \