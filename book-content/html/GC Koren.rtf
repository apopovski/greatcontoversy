\uc0\u50948 \u53364 \u47532 \u54532 \u45716  \u54980 \u49464 \u51032  \u45796 \u47480  \u44060 \u54785 \u51088 \u46308 \u52376 \u47100  \u44536 \u51032  \u49324 \u50629 \u51032  \u52488 \u44592 \u50640 \u45716  \u51088 \u44592 \u44032  \u50612 \u46356 \u47196  \u51064 \u46020 \u46112  \u44163 \u51064 \u51648  \u50508 \u51648  \u47803 \u54616 \u50688 \u45796 . \u44536 \u45716  \u44256 \u51032 \u51201 \u51004 \u47196  \u47196 \u47560 \u44368 \u50640  \u48152 \u45824 \u54616 \u44256 \u51088  \u54616 \u51648  \u50506 \u50520 \u45796 . \u44536 \u47084 \u45208  \u51652 \u47532 \u50640  \u53804 \u49888 \u54616 \u44172  \u46104 \u51088  \u44536 \u45716  \u54596 \u50672 \u51201 \u51004 \u47196  \u44144 \u51667 \u44284  \u49912 \u50864 \u51648  \u50506 \u51012  \u49688  \u50630 \u50632 \u45796 . \u44536 \u45716  \u48277 \u50773 \u44428 \u51032  \u50724 \u47448 \u44032  \u48516 \u47749 \u54644 \u51648 \u47732  \u51656 \u49688 \u47197  \u45908 \u50865  \u50676 \u47148 \u54616 \u44172  \u49457 \u44221 \u51032  \u44368 \u54984 \u51012  \u49444 \u47749 \u54616 \u50688 \u45796 . \u44536 \u45716  \u47196 \u47560 \u44368 \u44032  \u49324 \u46988 \u51032  \u50976 \u51204 \u51012  \u48155 \u50500 \u46308 \u51060 \u44592  \u50948 \u54616 \u50668  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51012  \u48260 \u47532 \u45716  \u44163 \u51012  \u48372 \u44256  \u49457 \u44221 \u51012  \u51200 \u48260 \u47536  \u49888 \u48512 \u46308 \u51012  \u45812 \u45824 \u54616 \u44172  \u51656 \u52293 \u54616 \u44256  \u49457 \u44221 \u51012  \u48177 \u49457 \u46308 \u50640 \u44172  \u46028 \u47140 \u51460  \u44163 \u44284  \u49457 \u44221 \u51032  \u44428 \u50948 \u47484  \u44368 \u54924  \u50504 \u50640 \u49436  \u45796 \u49884  \u54620  \u48264  \u54869 \u47549 \u49884 \u53420  \u44163 \u51012  \u50836 \u44396 \u54616 \u50688 \u45796 . \u44536 \u45716  \u51116 \u44036  \u51080 \u44256  \u50676 \u49457  \u51080 \u45716  \u44368 \u49324 \u50836  \u50885 \u48320 \u51201 \u51064  \u49444 \u44368 \u