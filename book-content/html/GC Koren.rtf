\f1\b0 \cf0 \
\uc0\u51316  \u50920 \u49836 \u47532 \u50752  \u52272 \u49828  \u50920 \u49836 \u47532 \u45716  \u47785 \u49324  \u50504 \u49688 \u47484  \u48155 \u51008  \u54980  \u49440 \u44368  \u49324 \u50629 \u51012  \u50948 \u54616 \u50668  \u48120 \u44397 \u51004 \u47196  \u54028 \u44204 \u46104 \u50632 \u45796 . \u44536 \u46308 \u51008  \u47784 \u46972 \u48708 \u50500  \u44368 \u46020 \u46308 \u44284  \u51068 \u54665 \u51060  \u46104 \u50612  \u48176 \u47484  \u53440 \u44172  \u46104 \u50632 \u45796 . \u44536 \u46308 \u51008  \u54637 \u54644  \u51473 \u50640  \u49900 \u54620  \u54253 \u54413 \u50864 \u47484  \u47564 \u45208  \u51453 \u51012  \u51648 \u44221 \u51060  \u46104 \u50632 \u45716 \u45936 , \u50920 \u49836 \u47532 \u45716  \u44536  \u46412 \u50640  \u50500 \u51649  \u51088 \u44592 \u44032  \u54616 \u45208 \u45784 \u51004 \u47196  \u45908 \u48520 \u50612  \u54868 \u54217 \u51032  \u48372 \u51613 \u51012  \u44032 \u51648 \u44256  \u51080 \u51648  \u47803 \u54632 \u51012  \u44648 \u45804 \u50520 \u45796 . \u44536 \u44163 \u44284 \u45716  \u45824 \u51312 \u51201 \u51004 \u47196  \u51088 \u44592 \u44032  \u47579 \u48372 \u51648  \u47803 \u54620  \u49888 \u47280 \u50752  \u54217 \u50504 \u51012  \u44536  \u46021 \u51068 \u51064 \u46308 \u51008  \u45208 \u53440 \u45256 \u45796 .\
\uc0\u44536 \u45716  \u47568 \u54616 \u50688 \u45796 . \'93\u45208 \u45716  \u50724 \u47000  \u51204 \u48512 \u53552  \u44536 \u46308 \u51032  \u51652 \u49892 \u54620  \u53468 \u46020 \u47484  \u44288 \u52272 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u45796 \u47480  \u50668 \u44061 \u46308 \u51012  \u50948 \u54616 \u50668  \u50689 \u44397  \u49324 \u46988 \u51008  \u50500 \u47924 \u46020  \u54616 \u47140 \u44256  \u54616 \u51648  \u50500 \u45768 \u54624  \u48708 \u52380 \u54620  \u51068 \u46308 \u51012  \u54632 \u51004 \u47196  \u54637 \u49345  \u44216 \u49552 \u51032  \u51613 \u44144 \u47484  \u48372 \u50668  \u51452 \u50632 \u45796 . \u44536 \u47532 \u44256  \u44536 \u46308 \u51008  \u44536 \u47088  \u51068 \u50640  \u45824 \u54616 \u50668  \u50500 \u47924 \u47088  \u48372 \u49688 \u46020  \u50896 \u52824  \u50500 \u45768 \u54616 \u50688 \u44256 , \u44536 \u44163 \u51008  \u51088 \u44592 \u46308 \u51032  \u44368 \u47564 \u54620  \u47560 \u51020 \u51012  \u50948 \u54616 \u50668  \u50976 \u51061 \u54620  \u44163 \u51060 \u46972 \u44256  \u54616 \u47728  \u44536 \u46308 \u51032  \u49324 \u46993 \u54616 \u45716  \u44396 \u51452 \u44760 \u49436  \u51088 \u44592 \u46308 \u51012  \u50948 \u54616 \u50668  \u45908 \u50865  \u53360  \u51068 \u51012  \u54665 \u54616 \u49512 \u45796 \u44256  \u54616 \u50688 \u45796 . \u44536 \u47532 \u44256  \u44536 \u46308 \u51008  \u47588 \u51068  \u50612 \u46496 \u54620  \u51109 \u50528 \u47484  \u47564 \u45216 \u51648 \u46972 \u46020  \u44144 \u44592 \u50640  \u46041 \u50836 \u46104 \u51648  \u50506 \u45716  \u50976 \u49692 \u54620  \u53468 \u46020 \u47484  \u48372 \u50668  \u51452 \u44256  \u51080 \u50632 \u45796 . \u47564 \u51068  \u48128 \u52840 \u51012  \u45817 \u54616 \u46304 \u51648 , \u47588 \u47484  \u47582 \u46304 \u51648 , \u45336 \u50612 \u46888 \u47548 \u51012  \u45817 \u54616 \u44172  \u46104 \u47732  \u44536 \u46308 \u51008  \u45796 \u49884  \u51068 \u50612 \u45208 \u49436  \u44032  \u48260 \u47540  \u49104 \u51060 \u50836 , \u54620  \u47560 \u46356 \u51032  \u48520 \u54217 \u46020  \u51077  \u48150 \u50640  \u45236 \u51648  \u50506 \u50520 \u45796 . \u44536 \u47088 \u45936  \u51060 \u51228  \u44536 \u46308 \u51060  \u44368 \u47564 \u44284  \u48516 \u45432 \u50752  \u48373 \u49688 \u51032  \u51221 \u49888 \u50640 \u49436 \u45716  \u47932 \u47200 \u51060 \u50836  \u44277 \u54252 \u49900 \u50640 \u49436  \u45459 \u50668 \u45228 \u45716 \u51648 \u51032  \u50668 \u48512 \u47484  \u49884 \u54744 \u54644  \u48380  \u44592 \u54924 \u44032  \u50772 \u45796 . \u44536 \u46308 \u51060  \u50616 \u51228 \u46304 \u51648  \u50696 \u48176 \u47484  \u49884 \u51089 \u54624  \u46412 \u50640  \u49884 \u54200 \u51012  \u49569 \u50689 \u54616 \u45912  \u44536 \u45824 \u47196  \u49884 \u54200 \u51012  \u51069 \u44256  \u51080 \u51012  \u46412  \u48148 \u45796 \u44032  \u44144 \u52832 \u50612 \u51648 \u44256 , \u53360  \u46043 \u51060  \u52258 \u50612 \u51648 \u44256 , \u54028 \u46020 \u45716  \u48176 \u47484  \u49340 \u53412 \u47140 \u45716  \u46319 \u51060  \u44036 \u54032  \u50948 \u47484  \u55081 \u50424 \u50632 \u45796 . \u51060 \u46412 \u50640  \u50689 \u44397 \u51064 \u46308  \u49324 \u51060 \u50640 \u49436 \u45716  \u46496 \u46308 \u44256  \u48512 \u47476 \u51670 \u45716  \u49548 \u47532 \u44032  \u51068 \u50612 \u45228 \u45796 . \u44536 \u47084 \u45208  \u44536  \u46021 \u51068 \u51064 \u46308 \u51008  \u51312 \u50857 \u55176  \u49569 \u50689 \u51012  \u44228 \u49549 \u54616 \u44256  \u51080 \u50632 \u45796 . \u54980 \u50640  \u45208 \u45716  \u44536  \u51473 \u51032  \u54620  \u49324 \u46988 \u50640 \u44172  \'91\u45817 \u49888 \u46308 \u51008  \u47924 \u49453 \u51648  \u50506 \u50520 \u49845 \u45768 \u44620 ?\'92\u46972 \u44256  \u47932 \u50612  \u48372 \u50520 \u45796 . \'91\u54616 \u45208 \u45784 \u51032  \u51008 \u54812 \u47196  \u51312 \u44552 \u46020  \u47924 \u49453 \u51648  \u50506 \u50520 \u49845 \u45768 \u45796 \'92\u44256  \u45824 \u45813 \u54616 \u50688 \u45796 . \u45208 \u45716  \u46608  \'91\u44536 \u47084 \u45208  \u48512 \u51064 \u46308 \u44284  \u50500 \u51060 \u46308 \u51008  \u47924 \u49436 \u50892 \u54616 \u51648  \u50506 \u49845 \u45768 \u44620 ?\'92\u46972 \u44256  \u47932 \u50632 \u45796 . \u44536 \u45716  \u48512 \u46300 \u47084 \u50868  \u50612 \u51312 \u47196  \'91\u50500 \u45768 \u50836 , \u50864 \u47532 \u51032  \u48512 \u45376 \u46308 \u44284  \u50500 \u51060 \u46308 \u51008  \u51453 \u45716  \u44163 \u51012  \u46160 \u47140 \u50892 \u54616 \u51648  \u50506 \u49845 \u45768 \u45796 \'92\u44256  \u45824 \u45813 \u54616 \u50688 \u45796 \'94 (John Whit-ehead, Life of the Rev.John Wesley, p.10).\
\uc0\u49324 \u48152 \u45208  (Savannah) \u50640  \u46020 \u52265 \u54620  \u54980 , \u50920 \u49836 \u47532 \u45716  \u50620 \u47560  \u46041 \u50504  \u44536  \u47784 \u46972 \u48708 \u50500  \u44368 \u46020 \u46308 \u44284  \u54632 \u44760  \u51648 \u45256 \u45716 \u45936 , \u44536 \u46308 \u51032  \u44536 \u47532 \u49828 \u46020 \u51064 \u51201  \u54665 \u46041 \u50640  \u44618 \u51008  \u44048 \u46041 \u51012  \u48155 \u50520 \u45796 . \u44536 \u45716  \u49373 \u47749 \u51060  \u50630 \u45716  \u54805 \u49885 \u51201 \u51064  \u50689 \u44397  \u44368 \u54924 \u50752 \u45716  \u54788 \u51200 \u54616 \u44172  \u45796 \u47480  \u44536 \u46308 \u51032  \u50696 \u48176 \u50640  \u45824 \u54616 \u50668  \u45796 \u51020 \u44284  \u44057 \u51060  \u44592 \u47197 \u54616 \u50688 \u45796 . \'93\u47588 \u50864  \u45800 \u49692 \u54616 \u47732 \u49436  \u50628 \u49689 \u54620  \u44536  \u50696 \u48176 \u45716  \u47784 \u46160  \u45208 \u47196  \u54616 \u50668 \u44552  1700\u45380 \u51032  \u49884 \u44036 \u51201  \u44144 \u47532 \u47484  \u51082 \u50612 \u48260 \u47532 \u44172  \u54616 \u44256  \u54805 \u49885 \u44284  \u51032 \u49885 \u51008  \u50630 \u51012 \u51648 \u46972 \u46020  \u52380 \u47561  \u51228 \u51312 \u51088  \u48148 \u50872 \u44284  \u50612 \u48512  \u48288 \u46300 \u47196 \u44032  \u51648 \u46020 \u54616 \u50688 \u51648 \u47560 \u45716  \u49457 \u47161 \u44284  \u45733 \u47141 \u51060  \u45208 \u53440 \u45228 \u45912  \u45817 \u49884 \u51032  \u50612 \u46500  \u54924 \u51665 \u50640  \u52280 \u49437 \u54620  \u46319 \u54620  \u45712 \u45196 \u51012  \u44032 \u51648 \u44172  \u54616 \u50688 \u45796 \'94 (John Whitehead, Life of the Rev.John Wesley, pp.11, 12).\
