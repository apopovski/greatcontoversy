\f1\b0 \cf0 \
\uc0\u50696 \u50616 \u51201  \u44592 \u44036 \u50640  \u44288 \u54616 \u50668 \u45716  \u46020 \u51200 \u55176  \u48152 \u48149 \u54624  \u50668 \u51648 \u44032  \u50630 \u51020 \u51012  \u50508 \u44172  \u46108  \u48152 \u45824 \u51088 \u46308 \u51008  \u50696 \u50616 \u51060  \u51064 \u48393 \u46108  \u44163 \u51060 \u46972 \u44256  \u44032 \u47476 \u52840 \u51004 \u47196 \u50024  \u44536  \u47928 \u51228 \u47484  \u50672 \u44396 \u54616 \u45716  \u44163 \u51312 \u52264  \u47803 \u54616 \u44172  \u54616 \u44256 \u51088  \u45432 \u47141 \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44060 \u49888 \u44368 \u45716  \u47196 \u47560 \u44368 \u51032  \u48156 \u51088 \u52712 \u47484  \u46384 \u46972 \u44032 \u44172  \u46104 \u50632 \u45796 . \u48277 \u50773  \u44368 \u54924 \u44032  \u49324 \u46988 \u46308 \u51032  \u49552 \u50640 \u49436  \u49457 \u44221 \u51012  \u48764 \u50519 \u44256  \u51080 \u45716  \u54620 \u54200  (\u48512 \u47197  29 \u52280 \u51312 ) \u44060 \u49888 \u44368 \u45716  \u49457 \u44221 \u51032  \u51473 \u50836 \u54620  \u48512 \u48516 , \u44263  \u50864 \u47532 \u51032  \u49884 \u45824 \u47484  \u50948 \u54620  \u53945 \u48324 \u55176  \u51473 \u50836 \u54620  \u48512 \u48516 \u51012  \u44648 \u45804 \u51012  \u49688  \u50630 \u45716  \u44163 \u51060 \u46972 \u44256  \u51452 \u51109 \u54616 \u50688 \u45796 .\
\uc0\u47785 \u49324 \u46308 \u44284  \u51068 \u48152  \u49888 \u46020 \u46308 \u51008  \u45796 \u45768 \u50648 \u49436 \u50752  \u50836 \u54620 \u44228 \u49884 \u47197 \u51032  \u50696 \u50616 \u51008  \u51060 \u54644 \u54624  \u49688  \u50630 \u45716  \u49888 \u48708 \u54620  \u44163 \u51060 \u46972 \u44256  \u51452 \u51109 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u51228 \u51088 \u46308 \u50640 \u44172  \u44536 \u46308 \u51032  \u49884 \u45824 \u50640  \u49457 \u52712 \u46112  \u49324 \u44148 \u50640  \u44288 \u54616 \u50668  \u49440 \u51648 \u51088  \u45796 \u45768 \u50648 \u51032  \u47568 \u51012  \u51648 \u51201 \u54616 \u49884 \u47732 \u49436  \u51060 \u47484  \'93\u51069 \u45716  \u51088 \u45716  \u44648 \u45804 \u51012 \u51652 \u51200 \'94 (\u47560  24:15) \u46972 \u44256  \u47568 \u50432 \u54616 \u49512 \u45796 . \u46608 \u54620  \u50836 \u54620 \u44228 \u49884 \u47197 \u51012  \u51060 \u54644 \u54624  \u49688  \u50630 \u45716  \u49888 \u48708 \u46972 \u44256  \u54616 \u45716  \u51452 \u51109 \u51008  \u44228 \u49884 \u47197 \u51060 \u46972 \u45716  \u44536  \u52293 \u51032  \u51228 \u54840 \u50752  \u48152 \u45824 \u46104 \u45716  \u51452 \u51109 \u51060 \u45796 . \'93\u50696 \u49688  \u44536 \u47532 \u49828 \u46020 \u51032  \u44228 \u49884 \u46972  \u51060 \u45716  \u54616 \u45208 \u45784 \u51060  \u44536 \u50640 \u44172  \u51452 \u49324  \u48152 \u46300 \u49884  \u49549 \u55176  \u46112  \u51068 \u51012  \u44536  \u51333 \u46308 \u50640 \u44172  \u48372 \u51060 \u49884 \u47140 \u44256 \'85\u51648 \u49884 \u54616 \u49888  \u44163 \u51060 \u46972 \'85\u51060  \u50696 \u50616 \u51032  \u47568 \u50432 \u51012  \u51069 \u45716  \u51088 \u50752  \u46307 \u45716  \u51088 \u50752  \u44536  \u44032 \u50868 \u45936  \u44592 \u47197 \u54620  \u44163 \u51012  \u51648 \u53412 \u45716  \u51088 \u46308 \u51060  \u48373 \u51060  \u51080 \u45208 \u45768  \u46412 \u44032  \u44032 \u44620 \u50880 \u51060 \u46972 \'94 (\u44228  1:1~3).\
\uc0\u49440 \u51648 \u51088 \u45716  \'93\u51069 \u45716 \'85\u51088 \u46308 \u51060  \u48373 \u51060  \u51080 \u45208 \u45768 \'94\u46972 \u44256  \u47568 \u54616 \u50688 \u45716 \u45936  \u44536 \u44163 \u51008  \u44536  \u47568 \u50432 \u51012  \u51069 \u51648  \u50506 \u45716  \u51088 \u46020  \u51080 \u51012  \u44163 \u51012  \u51032 \u48120 \u54632 \u51060 \u47728  \u44536 \u47088  \u49324 \u46988 \u46308 \u51008  \u48373 \u51012  \u48155 \u51012  \u49688  \u50630 \u45796 \u45716  \u44163 \u51012  \u47568 \u54620 \u45796 . \u46608 \u54620  \'93\u46307 \u45716  \u51088 \u46308 \u44284 \'94\u46972 \u44256  \u47568 \u50432 \u54616 \u50688 \u45716 \u45936 , \u50696 \u50616 \u50640  \u44288 \u54616 \u50668  \u51068 \u52404  \u46307 \u44592 \u47484  \u44144 \u51208 \u54616 \u45716  \u51088 \u46308 \u51008  \u48373 \u51012  \u48155 \u51012  \u49688  \u50630 \u45796 \u45716  \u44163 \u51012  \u47568 \u54620 \u45796 . \u46608 \u54620  \'93\u44536  \u44032 \u50868 \u45936  \u44592 \u47197 \u54620  \u44163 \u51012  \u51648 \u53412 \u45716  \u51088 \u46308 \u51060 \'94\u46972 \u44256  \u54616 \u50688 \u45716 \u45936 , \u47566 \u51008  \u49324 \u46988 \u46308 \u51060  \u50836 \u54620 \u44228 \u49884 \u47197 \u50640  \u51080 \u45716  \u44221 \u44256 \u50752  \u44368 \u54984 \u50640  \u51452 \u51032 \u54616 \u51648  \u50500 \u45768 \u54616 \u44256  \u51080 \u45796 . \u44536 \u46308 \u51008  \u50668 \u44592  \u54728 \u46973 \u46108  \u52629 \u48373 \u51012  \u48155 \u51012  \u49688  \u50630 \u45796 . \u50696 \u50616 \u51032  \u47928 \u51228 \u46308 \u51012  \u47736 \u49884 \u54616 \u44256 , \u50628 \u49689 \u54616 \u44172  \u51452 \u50612 \u51652  \u44536  \u54364 \u49345 \u46308 \u51012  \u45257 \u49548 \u54616 \u44256 , \u44536 \u46308 \u51032  \u49373 \u50528 \u47484  \u44060 \u54785 \u54616 \u51648  \u50500 \u45768 \u54616 \u44256  \u51064 \u51088 \u51032  \u50724 \u49900 \u51012  \u50948 \u54616 \u50668  \u51456 \u48708 \u54616 \u51648  \u50500 \u45768 \u54616 \u45716  \u51088 \u46308 \u51008  \u46020 \u51200 \u55176  \u52629 \u48373 \u51012  \u48155 \u51012  \u49688  \u50630 \u45796 .\
\uc0\u50689 \u44048 \u51032  \u51613 \u50616 \u50640  \u48708 \u52628 \u50612 \u48380  \u46412 , \u49324 \u46988 \u51060  \u50612 \u52236  \u44048 \u55176  \u50836 \u54620 \u44228 \u49884 \u47197 \u51012  \u54620 \u45233  \u49888 \u48708 \u54620  \u44163 \u51060 \u50836  \u51064 \u44036 \u51060  \u51060 \u54644 \u54624  \u49688  \u50630 \u45716  \u44163 \u51060 \u46972 \u44256  \u51452 \u51109 \u54624  \u49688  \u51080 \u44192 \u45716 \u44032 ? \u44536 \u44163 \u51060 \u50556 \u47568 \u47196  \u44228 \u49884 \u46108  \u49888 \u48708 \u50836 , \u44277 \u44060 \u46108  \u44544 \u51060 \u45796 . \u50836 \u54620 \u44228 \u49884 \u47197 \u51032  \u50672 \u44396 \u45716  \u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u51012  \u45796 \u45768 \u50648 \u49436 \u51032  \u50668 \u47084  \u44032 \u51648  \u50696 \u50616 \u51004 \u47196  \u51060 \u45132 \u47532 \u44172  \u54620 \u45796 . \u44536 \u47084 \u48064 \u47196  \u51060  \u46160  \u52293 \u51008  \u45796  \u44057 \u51060  \u49464 \u49345  \u50669 \u49324 \u51032  \u51333 \u47568 \u50640  \u51068 \u50612 \u45216  \u50668 \u47084  \u44032 \u51648  \u49324 \u44148 \u50640  \u44288 \u54616 \u50668  \u54616 \u45208 \u45784 \u44760 \u49436  \u49324 \u46988 \u46308 \u50640 \u44172  \u51452 \u49888  \u44032 \u51109  \u51473 \u50836 \u54620  \u44368 \u54984 \u51012  \u45208 \u53440 \u45236 \u51456 \u45796 .\
