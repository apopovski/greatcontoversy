\uc0\u50696 \u49688 \u45784 \u44760 \u49436 \u45716  \u44048 \u46988 \u49328  \u44845 \u45824 \u44592 \u50640 \u49436  \u50696 \u47336 \u49332 \u47128 \u51012  \u45236 \u47140 \u45796 \u48372 \u49512 \u45796 . \u44536  \u46412 \u50640  \u44536 \u48516 \u51032  \u45576 \u50526 \u50640 \u45716  \u50500 \u47492 \u45813 \u44256  \u54217 \u54868 \u47196 \u50868  \u44305 \u44221 \u51060  \u45149 \u50630 \u51060  \u54204 \u52432 \u51256  \u51080 \u50632 \u45796 . \u46412 \u47560 \u52840  \u50976 \u50900 \u51208 \u51012  \u47582 \u51060 \u54616 \u50668  \u51060  \u53360  \u51208 \u44592 \u47484  \u51648 \u53412 \u47140 \u44256  \u50556 \u44273 \u51032  \u51088 \u49552 \u46308 \u51060  \u44033  \u51648 \u48169 \u51004 \u47196 \u48512 \u53552  \u47784 \u50668  \u50752  \u51080 \u50632 \u45796 . \u49692 \u47168 \u51088 \u46308 \u51032  \u52380 \u47561 \u51060  \u51221 \u50896 \u44284  \u54252 \u46020 \u50896 \u44284  \u50616 \u45909  \u50948 \u51032  \u50668 \u47084  \u44275 \u50640  \u55145 \u50612 \u51256  \u51080 \u50632 \u45796 . \u44536 \u47532 \u44256  \u52789 \u52789 \u45824 \u52376 \u47100  \u49373 \u44596  \u49328 \u46308 \u44284  \u50948 \u50628  \u51080 \u45716  \u44417 \u51204 \u46308 \u44284  \u51060 \u49828 \u46972 \u50648  \u46020 \u49457 \u51032  \u44144 \u45824 \u54620  \u49457 \u44285 \u46308 \u51060  \u50864 \u46749 \u50864 \u46749  \u49436  \u51080 \u50632 \u45796 . \u49884 \u50728 \u51032  \u46392 \u51060  \'93\u45208 \u45716  \u50668 \u54889 \u51004 \u47196  \u50505 \u51008  \u51088 \u50836  \u44284 \u48512 \u44032  \u50500 \u45768 \u46972  \u44208 \u45800 \u53076  \u50528 \u53685 \u51012  \u45817 \u54616 \u51648  \u50500 \u45768 \u54616 \u47532 \u46972 \'94 (\u44228  18:7) \u44256  \u51088 \u46993 \u54616 \u45716  \u46319 \u54616 \u50688 \u45796 . \u50715 \u45216 \u50640  \u54620  \u50773 \u51060  \'93\u50728  \u49464 \u44228 \u44032  \u51600 \u44144 \u50892 \u54632 \u51060 \u50668  \u53360  \u50773 \u51032  \u49457  \u44263  \u48513 \u48169 \u50640  \u51080 \u45716  \u49884 \u50728 \u49328 \u51060  \u44536 \u47084 \u54616 \u46020 \u45796 \'94 (\u49884  48:2) \u44256  \u45432 \u47000 \u54616 \u45912  \u46412 \u50752  \u44057 \u51060  \u51648 \u44552 \u46020  \u50668 \u51204 \u55176  \u44536  \u49457 \u51008  \u50500 \u47492 \u45813 \u44256  \u54616 \u45208 \u45784 \u51032  \u51008 \u52509 \u51012  \u45572 \u47532 \u45716  \u46319 \u54616 \u50688 \u45796 . \u51109 \u50628 \u54620  \u49457 \u51204 \u51032  \u44148 \u47932 \u51008  \u50756 \u51204 \u55176  \u44536  \u47784 \u49845 \u51012  \u46300 \u47084 \u45236 \u50632 \u45796 . \u48148 \u50556 \u55120 \u47196  \u49436 \u49328 \u50640  \u51648 \u45716  \u54663 \u49332 \u51008  \u45576 \u44284  \u44057 \u51060  \u55152  \u45824 \u47532 \u49437 \u50640  \u48708 \u52824 \u50612  \u54889 \u44552 \u48731 \u51032  \u47928 \u44284  \u49457 \u51204 \u51032  \u52392 \u53457  (\u23574 \u22612 ) \u50640  \u48152 \u49324 \u46104 \u50612  \u51080 \u50632 \u45796 . \u44536  \u49457 \u51204 \u51008  \u49892 \u47196  \u50728 \u51204 \u55176  \u50500 \u47492 \u45796 \u50892  \u51060 \u49828 \u46972 \u50648 \u51032  \u51088 \u46993 \u51060 \u50632 \u45796 . \u51060 \u47084 \u54620  \u44305 \u44221 \u51012  \u45576 \u51004 \u47196  \u48376  \u51060 \u49828 \u46972 \u50648  \u49324 \u46988 \u51004 \u47196 \u49436  \u44536  \u45572 \u44032  \u44592 \u49256 \u44284  \u52268 \u53444 \u51032  \u45712 \u45196 \u51012  \u44054 \u51648  \u50506 \u51012  \u49688  \u51080 \u50632 \u51004 \u47028 ! \u44536 \u47084 \u45208  \u50696 \u49688 \u45784 \u51032  \u47560 \u51020 \u51008  \u51060 \u47084 \u54620  \u44163 \u44284 \u45716  \u51204 \u54784  \u45796 \u47480  \u49373 \u44033 \u50640  \u51104 \u44200  \u51080 \u50632 \u45796 . \'93\u44032 \u44620 \u51060  \u50724 \u49324  \u49457 \u51012  \u48372 \u49884 \u44256  \u50864 \'94 (\u45573  19:41) \u49512 \u45796 . \u47566 \u51008  \u47924 \u47532 \u46308 \u51008  \u49552 \u50640  \u51333 \u47140 \u45208 \u47924  \u44032 \u51648 \u47484  \u46308 \u44256  \u55124 \u46308 \u47728  \u44592 \u49256 \u51032  \'93\u54840 \u49328 \u45208 \'94\u47484  \u48520 \u47084  \u49328 \u51012  \u51652 \u46041 \u49884 \u53412 \u44256  \u44536 \u48516 \u51012  \u44032 \u47532 \u53020  \u50773 \u51060 \u46972 \u44256  \u48520 \u47104 \u45796 . \u44536 \u47084 \u45208  \u51060 \u47084 \u54620  \u44060 \u49440 \u51032  \u51077 \u49457 \u51012  \u47784 \u46304  \u49324 \u46988 \u51060  \u54872 \u54840 \u49457 \u51004 \u47196  \u52629 \u54616 \u54616 \u45716  \u44536  \u46412 \u50640  \u44396 \u51452 \u51032  \u47560 \u51020 \u51008  \u44049 \u51088 \u44592  \u51060 \u54644 \u54624  \u49688  \u50630 \u45716  \u49836 \u54548 \u51004 \u47196  \u44032 \u46301 \u54616 \u50668 \u51276 \u45796 . \u54616 \u45208 \u45784 \u51032  \u50500 \u46308 \u51060 \u49884 \u50836 , \u51060 \u49828 \u46972 \u50648 \u51032  \u50616 \u50557 \u46108  \u48516 \u51060 \u49884 \u47728  \u49324 \u47581 \u51012  \u51060 \u44592 \u49884 \u44256  \u47924 \u45924 \u50640 \u49436  \u49324 \u47196 \u51105 \u55180  \u51088 \u47484  \u48520 \u47084 \u45240  \u45733 \u47141 \u51012  \u44032 \u51648 \u49888  \u44536 \u48516 \u44760 \u49436 \u45716  \u54620 \u45233  \u48372 \u53685 \u51032  \u49836 \u54548 \u51004 \u47196 \u44032  \u50500 \u45768 \u46972  \u50613 \u45572 \u47484  \u49688  \u50630 \u45716  \u44053 \u47148 \u54620  \u44256 \u45516  \u46412 \u47928 \u50640  \u45576 \u47932 \u51012  \u55128 \u47532 \u49512 \u45796 .\
