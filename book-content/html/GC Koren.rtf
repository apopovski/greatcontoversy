\f1\b0 \cf0 \
\uc0\u48277 \u50773 \u45817 \u51032  \u49324 \u46988 \u46308 \u51008  \u50696 \u49345 \u46108  \u49849 \u47532 \u50640  \u46308 \u46496 \u49436  \u52268 \u46976 \u54620  \u48372 \u49437 \u44284  \u51452 \u50725  (\u29664 \u29577 ) \u51004 \u47196  \u51109 \u49885 \u54620  \u50500 \u47492 \u45796 \u50868  \u50743 \u51012  \u51077 \u44256  \u51032 \u44592 \u50577 \u50577 \u54616 \u44172  \u48148 \u45940 \u51004 \u47196  \u50772 \u45796 . \u44536 \u46308 \u51032  \u49885 \u53441  \u50948 \u50640 \u45716  \u44537 \u55176  \u44050 \u51652  \u49696 \u44284  \u50728 \u44054  \u51652 \u48120 \u44032  \u52264 \u47140 \u51256  \u51080 \u50632 \u45796 . \u44536 \u46308 \u51008  \u51060 \u47084 \u54620  \u51452 \u50672 \u44284  \u54872 \u46973 \u51004 \u47196  \u49457 \u51649 \u50640  \u45824 \u54620  \u44536 \u46308 \u51032  \u51032 \u47924 \u47484  \u44221 \u54616 \u44172  \u54616 \u50688 \u45796 . \u44536 \u47088 \u45936  \u44536 \u44163 \u44284 \u45716  \u45320 \u47924 \u45208  \u45824 \u51312 \u51201 \u51004 \u47196  \u44060 \u54785 \u54028 \u46308 \u51008  \u49324 \u46988 \u46308 \u50640 \u44172  \u44152 \u51064 \u51032  \u47924 \u47532 \u50752 \u46020  \u45796 \u47484  \u48148 \u44032  \u50630 \u51012  \u51221 \u46020 \u47196  \u48372 \u50688 \u51004 \u47728 , \u44536  \u49885 \u49324 \u46020  \u45320 \u47924 \u45208  \u48372 \u51096 \u44163 \u50630 \u50632 \u51004 \u48064 \u47196  \u49885 \u53441 \u50640  \u50724 \u47000  \u47672 \u47932 \u47084  \u51080 \u51012  \u54596 \u50836 \u44032  \u50630 \u50632 \u45796 . \u50640 \u53084 \u46988 \u54028 \u46356 \u50864 \u49828 \u51032  \u50668 \u44288 \u51665  \u51452 \u51064 \u51008  \u50616 \u51228  \u48372 \u46304 \u51648  \u44536 \u44032  \u51088 \u44592  \u48169 \u50640 \u49436  \u50672 \u44396 \u47484  \u54616 \u46304 \u44032  \u44536 \u47111 \u51648  \u50506 \u51004 \u47732  \u44592 \u46020 \u54616 \u45716  \u44163 \u51012  \u48156 \u44204 \u54616 \u44256 , \u52280 \u51004 \u47196  \u51060 \u49345 \u54616 \u44172  \u50668 \u44220 \u51004 \u47728 , \u47924 \u51032 \u49885 \u51473 \u50640  \u44536  \u51060 \u45800 \u51088 \u45716  \u47588 \u50864  \'93\u44540 \u50628 \u54616 \u44256  \u44221 \u44148 \u54616 \u45796 \'94\u44256  \u47568 \u54616 \u44172  \u46104 \u50632 \u45796 .\
\uc0\u54924 \u51032 \u51109 \u50640 \u49436  \'93\u50640 \u53356 \u45716  \u44144 \u47564 \u54616 \u44172  \u44053 \u45800 \u51004 \u47196  \u50732 \u46972 \u44052 \u51004 \u45208 , \u44216 \u49552 \u54620  \u50640 \u53084 \u46988 \u54028 \u46356 \u50864 \u49828 \u45716  \u44160 \u49548 \u54620  \u51032 \u48373 \u51012  \u51077 \u44256  \u50640 \u53356 \u51032  \u50526 \u50640  \u51080 \u45716  \u48320 \u48320 \u52824  \u50506 \u51008  \u44152 \u49345 \u50640  \u50505 \u50520 \u45796 .\'94 (D\'92Aubigne, b.11, ch.13). \u50640 \u53356 \u45716  \u49548 \u47532 \u47484  \u51648 \u47476 \u47732 \u49436  \u50724 \u47564  \u48520 \u49552 \u54620  \u53468 \u46020 \u47484  \u44228 \u49549 \u54616 \u50688 \u45796 . \u50640 \u53356 \u45716  \u47196 \u47560 \u51032  \u49888 \u50521 \u51012  \u50745 \u54840 \u54616 \u45716  \u45936  \u49457 \u44277 \u54616 \u47732  \u47561 \u45824 \u54620  \u49345 \u51012  \u48155 \u44592 \u47196  \u50557 \u49549 \u46104 \u50612  \u51080 \u50632 \u51004 \u48064 \u47196 , \u44536 \u51032  \u50676 \u49457 \u51008  \u44536  \u47749 \u50696 \u50837 \u44284  \u44552 \u51204 \u50837 \u50640  \u51088 \u44537 \u46108  \u44163 \u51060 \u50632 \u45796 . \u44536 \u47084 \u48064 \u47196  \u53664 \u47200 \u50640  \u49892 \u54056 \u54616 \u44172  \u46104 \u47732 , \u44536 \u45716  \u51312 \u47217 \u44284  \u47784 \u47736  (\u20398 \u34065 ) \u51012  \u54140 \u48531 \u44256  \u51200 \u51452 \u44620 \u51648  \u54616 \u50688 \u45796 .\
\uc0\u50640 \u53084 \u46988 \u54028 \u46356 \u50864 \u49828 \u45716  \u49888 \u51473 \u54620  \u53468 \u46020 \u47196  \u51088 \u49888 \u51012  \u49888 \u47280 \u54616 \u51648  \u50506 \u44256  \u45436 \u51137 \u51012  \u54588 \u54616 \u50688 \u45796 . \u44536 \u47532 \u44256  \u44536 \u45716  \'93\u45208 \u45716  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432  \u51060 \u50808 \u50640 \u45716  \u50612 \u46496 \u54620  \u49900 \u54032 \u51032  \u54364 \u51456 \u46020  \u49884 \u51064 \u54624  \u49688  \u50630 \u45796 \'94 (D\'92Aubigne, b.11, ch.13) \u45716  \u50628 \u49689 \u54620  \u47568 \u47196  \u53664 \u47200 \u50640  \u46308 \u50612 \u44052 \u45796 . \u48708 \u47197  \u50640 \u53084 \u46988 \u54028 \u46356 \u50864 \u49828 \u45716  \u44216 \u49552 \u54616 \u44256  \u50728 \u50976 \u54620  \u53468 \u46020 \u47484  \u44032 \u51276 \u51648 \u47564 , \u44536 \u45716  \u50976 \u45733 \u54616 \u44256  \u44404 \u54616 \u51648  \u50506 \u45716 \u45796 \u45716  \u44163 \u51060  \u49828 \u49828 \u47196  \u51077 \u51613 \u46104 \u50632 \u45796 . \u47196 \u47560  \u44368 \u46020 \u46308 \u51008  \u44536 \u46308 \u51032  \u49345 \u53804  \u49688 \u45800 \u51004 \u47196  \u44368 \u54924 \u51032  \u44428 \u50948 \u50752  \u44288 \u47144 \u50640  \u51032 \u54616 \u50668  \u54840 \u49548 \u54616 \u50688 \u51004 \u45208  \u44060 \u54785 \u51088 \u45716  \u49457 \u44221 \u51012  \u44403 \u44172  \u44256 \u49688 \u54616 \u50688 \u45796 . \'93\u50864 \u47532  \u49828 \u50948 \u49828 \u50640 \u49436 \u45716  \u54732 \u48277 \u50640  \u51068 \u52824 \u46104 \u51648  \u50506 \u45716  \u54620  \u44288 \u49845 \u51008  \u50500 \u47924 \u47088  \u55192 \u51060  \u50630 \u45796 . \u44536 \u47088 \u45936  \u49888 \u50521 \u50640  \u51080 \u50612 \u49436 \u45716  \u49457 \u44221 \u51060  \u50864 \u47532 \u51032  \u54732 \u48277 \u51060 \u45796 \'94 (D\'92Aubigne, b.11, ch.13) \u46972 \u44256  \u44536 \u45716  \u47568 \u54616 \u50688 \u45796 .\
\uc0\u46160  \u53664 \u47200 \u51088 \u51032  \u45824 \u51312 \u51201 \u51064  \u47784 \u49845 \u51008  \u54952 \u44284 \u44032  \u50630 \u51648 \u45716  \u50506 \u50520 \u45796 . \u49888 \u51473 \u54616 \u44256  \u50728 \u50976 \u54620  \u53468 \u46020 \u47196  \u49692 \u49692 \u55176  \u47568 \u54616 \u45716  \u44060 \u54785 \u51088 \u51032  \u48516 \u47749 \u54616 \u44256  \u51312 \u50857 \u54620  \u45436 \u51312 \u45716  \u50640 \u53356 \u51032  \u44144 \u47564 \u54616 \u44256  \u49884 \u45124 \u47084 \u50868  \u50613 \u49444 \u50640  \u54800 \u50724 \u44048 \u51012  \u44032 \u51276 \u45912  \u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u51012  \u51060 \u45132 \u50632 \u45796 .\
\uc0\u44536  \u53664 \u47200 \u51008  18 \u51068 \u44036  \u44228 \u49549 \u46104 \u50632 \u45796 . \u44536  \u53664 \u47200 \u51060  \u47560 \u52832  \u46412  \u48277 \u50773 \u45817 \u51008  \u44536 \u46308 \u51060  \u49849 \u47532 \u54620  \u44163 \u51004 \u47196  \u54869 \u49888 \u54616 \u44256  \u44536  \u49324 \u49892 \u51012  \u51452 \u51109 \u54664 \u45796 . \u53664 \u47200 \u51088 \u46308 \u51032  \u45824 \u48512 \u48516 \u51008  \u47196 \u47560  \u54200 \u51060 \u50632 \u45796 . \u51032 \u54924 \u45716  \u44060 \u54785 \u54028 \u51032  \u54056 \u48176 \u47484  \u49440 \u50616 \u54632 \u44284  \u46041 \u49884 \u50640  \u44060 \u54785 \u54028 \u51032  \u47924 \u47532 \u45716  \u44536 \u46308 \u51032  \u51648 \u46020 \u51088  \u52768 \u48729 \u44544 \u47532 \u50752  \u54632 \u44760  \u44368 \u54924 \u50640 \u49436  \u45130 \u50612 \u51276 \u45796 \u44256  \u54252 \u44256 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u54924 \u51032 \u51032  \u44208 \u44284 \u45716  \u50612 \u45712  \u54200 \u51060  \u50976 \u47532 \u54616 \u50688 \u45716 \u51648  \u48372 \u50668  \u51452 \u50632 \u45796 . \u44536  \u53664 \u47200 \u51032  \u44208 \u44284 \u47196  \u44060 \u49888 \u44368 \u51032  \u49324 \u50629 \u51060  \u45908 \u50865  \u44053 \u54644 \u51256 \u49436  \u48120 \u44396 \u50640  \u48288 \u47480 \u44284  \u48148 \u51236  \u46160  \u51452 \u50836 \u54620  \u46020 \u49884 \u44032  \u44060 \u54785  \u49324 \u50629 \u51012  \u51648 \u51648 \u54620 \u45796 \u44256  \u49440 \u50616 \u54616 \u50688 \u45796 .\
