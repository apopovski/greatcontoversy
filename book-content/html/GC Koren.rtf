\uc0\u48277 \u50773 \u51008  \u48372 \u54200  \u44368 \u54924  (Universal Church) \u51032  \u44032 \u49884 \u51201  \u47672 \u47532 \u51060 \u47728 , \u49464 \u44228  \u44033 \u52376 \u50640  \u51080 \u45716  \u44048 \u46021 \u46308 \u44284  \u47785 \u49324 \u46308 \u50640  \u45824 \u54620  \u52572 \u49345 \u44428 \u51012  \u48512 \u50668 \u48155 \u50520 \u45796 \u45716  \u44163 \u51008  \u47196 \u47560 \u44368 \u51032  \u51452 \u50836  \u44368 \u47532 \u51032  \u54616 \u45208 \u51060 \u45796 . \u45908 \u50865 \u51060  \u48277 \u50773 \u50640 \u44172 \u45716  \u54616 \u45208 \u45784 \u51032  \u51649 \u54632 \u46308 \u51060  \u51452 \u50612 \u51652  \u48148  \u46104 \u50632 \u45796 . \u44536 \u45716  \'93\u51452  \u54616 \u45208 \u45784 \u51060 \u49888  \u48277 \u50773 \'94\u51060 \u46972 \u44256  \u48520 \u47532 \u50892  \u50724 \u44256  \u51080 \u51004 \u47728  \u51208 \u45824  \u47924 \u50724 \u51032  \u51316 \u51116 \u47196  \u49440 \u54252 \u46104 \u50612  \u50772 \u45796  (\u48512 \u47197  1, 2 \u52280 \u51312 ). \u44536 \u45716  \u51204  \u51064 \u47448 \u51032  \u49709 \u48176 \u47484  \u50836 \u44396 \u54620 \u45796 . \u49324 \u45800 \u51060  \u49884 \u54744 \u51032  \u44305 \u50556 \u50640 \u49436  \u51452 \u51109 \u54620  \u44163 \u44284  \u46609 \u44057 \u51008  \u51452 \u51109 \u51012  \u44536 \u45716  \u50724 \u45720 \u45216 \u46020  \u47196 \u47560 \u44368 \u47484  \u53685 \u54616 \u50668  \u54616 \u44256  \u51080 \u51004 \u47728 , \u49688 \u47566 \u51008  \u49324 \u46988 \u46308 \u51060  \u44536 \u47484  \u49709 \u48176 \u54624  \u51456 \u48708 \u44032  \u46104 \u50612  \u51080 \u45796 .\
\uc0\u44536 \u47084 \u45208  \u54616 \u45208 \u45784 \u51012  \u46160 \u47140 \u50892 \u54616 \u44256  \u44277 \u44221 \u54616 \u45716  \u49324 \u46988 \u46308 \u51008  \u50696 \u49688 \u45784 \u44760 \u49436  \u44368 \u54876 \u54620  \u50896 \u49688 \u51032  \u50976 \u54841 \u51012  \'93\u51452  \u45320 \u51032  \u54616 \u45208 \u45784 \u44760  \u44221 \u48176 \u54616 \u44256  \u45796 \u47564  \u44536 \u47484  \u49452 \u44592 \u46972 \'94 (\u45573  4:8) \u44256  \u47568 \u50432 \u54616 \u49900 \u51004 \u47196  \u47932 \u47532 \u52824 \u49512 \u46319 \u51060  \u51060  \u44057 \u51008  \u54616 \u45720 \u51012  \u47924 \u49436 \u50892 \u54616 \u51648  \u50506 \u45716  \u44536  \u52280 \u46988 \u46108  \u51088 \u47484  \u45824 \u51201 \u54624  \u44163 \u51060 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u47568 \u50432  \u44032 \u50868 \u45936  \u50612 \u46500  \u49324 \u46988 \u51012  \u44368 \u54924 \u51032  \u47672 \u47532 \u47196  \u49340 \u51004 \u49512 \u45796 \u45716  \u50516 \u49884 \u51312 \u52264  \u54616 \u49888  \u51068 \u51060  \u50630 \u45796 . \u44536 \u47084 \u48064 \u47196  \u48277 \u50773 \u51032  \u52572 \u49345 \u44428 \u50640  \u45824 \u54620  \u44368 \u47532 \u45716  \u49457 \u44221 \u51032  \u44368 \u54984 \u44284  \u51204 \u51201 \u51004 \u47196  \u48176 \u52824 \u46108 \u45796 . \u48277 \u50773 \u51008  \u52268 \u53448 \u51060  \u50500 \u45768 \u44256 \u49436 \u45716  \u44536 \u47532 \u49828 \u46020 \u51032  \u44368 \u54924 \u47484  \u51648 \u48176 \u54624  \u44428 \u49464 \u47484  \u44032 \u51656  \u49688  \u50630 \u45796 .\
\uc0\u47196 \u47560 \u44368 \u46308 \u51008  \u49888 \u44368 \u46020 \u46308 \u50640 \u44172  \u51060 \u45800 \u51060 \u46972 \u45716  \u51396 \u47785 \u51012  \u50444 \u50864 \u44256 , \u44256 \u51665 \u49828 \u47101 \u44172  \u52280  \u44368 \u54924 \u50640 \u49436  \u46496 \u45212  \u51088 \u46308 \u51060 \u46972 \u44256  \u51452 \u51109 \u54644  \u50772 \u45796 . \u44536 \u47084 \u45208  \u51060 \u47088  \u48708 \u45212 \u51008  \u50724 \u55176 \u47140  \u44536 \u46308  \u51088 \u49888 \u46308 \u50640 \u44172  \u54644 \u45817 \u46108 \u45796 . \u44536 \u46308 \u51060 \u50556 \u47568 \u47196  \u44536 \u47532 \u49828 \u46020 \u51032  \u44400 \u44592  (\u36557 \u26071 ) \u47484  \u48260 \u47532 \u44256  \'93\u49457 \u46020 \u46308 \u50640 \u44172  \u45800 \u48264 \u50640  \u51452 \u49888  \u48127 \u51020 \u51032  \u46020 \'94 (\u50976  3) \u50640 \u49436  \u46496 \u45212  \u51088 \u46308 \u51060 \u45796 .\
\uc0\u49324 \u45800 \u51008  \u49457 \u44221 \u51060  \u49324 \u46988 \u46308 \u47196  \u54616 \u50668 \u44552  \u51088 \u44592 \u51032  \u44592 \u47564 \u51012  \u44036 \u54028 \u54616 \u44172  \u54644 \u51460  \u49688  \u51080 \u51012  \u49104 \u47564  \u50500 \u45768 \u46972 , \u51088 \u44592 \u51032  \u44428 \u49464 \u50640  \u45824 \u54637 \u54616 \u44172  \u54644 \u51460  \u49688  \u51080 \u45796 \u45716  \u44163 \u51012  \u51096  \u50508 \u44256  \u51080 \u50632 \u45796 . \u49464 \u49345 \u51032  \u44396 \u51452 \u51060 \u49888  \u51452 \u45784 \u51312 \u52264 \u46020  \u49324 \u45800 \u51032  \u44277 \u44201 \u51012  \u47932 \u47532 \u52824 \u49892  \u46412 \u50640 \u45716  \u49457 \u44221  \u47568 \u50432 \u51004 \u47196  \u54616 \u49512 \u45796 . \u44536 \u48516 \u44760 \u49436 \u45716  \u49324 \u45800 \u51060  \u46020 \u51204 \u54644  \u50732  \u46412 \u47560 \u45796  \'93\u44592 \u47197 \u46104 \u50632 \u51004 \u46104 \'94\u46972 \u45716  \u50689 \u50896 \u54620  \u51652 \u47532 \u47484  \u48169 \u54056 \u47196  \u49340 \u50500  \u45824 \u51025 \u54616 \u49512 \u45796 . \u49324 \u45800 \u51032  \u47784 \u46304  \u50516 \u49884 \u47484  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u49457 \u44221  \u47568 \u50432 \u51032  \u51648 \u54812 \u50752  \u45733 \u47141 \u51004 \u47196  \u45824 \u54637 \u54616 \u49512 \u45796 . \u44536 \u47084 \u48064 \u47196  \u49324 \u45800 \u51060  \u49324 \u46988 \u46308 \u51012  \u47560 \u51020 \u45824 \u47196  \u51648 \u48176 \u54616 \u44256 , \u52268 \u53448 \u51201 \u51064  \u48277 \u50773 \u44428 \u51012  \u49464 \u50864 \u47140 \u47732  \u48152 \u46300 \u49884  \u49324 \u46988 \u46308 \u51012  \u49457 \u44221 \u50640  \u45824 \u54616 \u50668  \u47924 \u51648 \u54616 \u44172  \u47564 \u46308 \u50612 \u50556  \u54624  \u44163 \u51060 \u50632 \u45796 . \u49457 \u44221 \u51008  \u54616 \u45208 \u45784 \u51012  \u45458 \u51060 \u45716  \u46041 \u49884 \u50640  \u50976 \u54620 \u54620  \u49324 \u46988 \u51032  \u50948 \u52824 \u47484  \u45208 \u53440 \u45236  \u51452 \u45716  \u44163 \u51060 \u48064 \u47196 , \u49457 \u44221 \u51032  \u51652 \u47532 \u47484  \u44032 \u47140  \u48260 \u47532 \u44144 \u45208  \u50630 \u50528  \u48260 \u47532 \u51648  \u50506 \u51004 \u47732  \u50504  \u46104 \u50632 \u45796 . \u44536 \u47532 \u54616 \u50668  \u47196 \u47560 \u44368 \u45716  \u51060 \u50752  \u44057 \u51008  \u45436 \u47532 \u47484  \u52292 \u53469 \u54616 \u50688 \u45796 . \u49688 \u48177  \u45380  \u46041 \u50504  \u49457 \u44221 \u51032  \u48372 \u44553 \u51008  \u44552 \u51648 \u46104 \u50632 \u44256 , \u49324 \u46988 \u46308 \u51008  \u44536 \u44163 \u51012  \u51069 \u44144 \u45208  \u51665 \u50640  \u44036 \u51649 \u54644  \u46168  \u49688 \u46020  \u50630 \u50632 \u45796 . \u51208 \u51312  \u50630 \u45716  \u49888 \u48512 \u46308 \u44284  \u51452 \u44368 \u46308 \u51060  \u44536 \u46308 \u51032  \u51652 \u50948 \u44032  \u47784 \u54840 \u54620  \u51452 \u51109 \u46308 \u51012  \u46263 \u48155 \u52840 \u54616 \u44592  \u50948 \u54616 \u50668  \u49457 \u44221 \u51032  \u44032 \u47476 \u52840 \u51012  \u54644 \u49437 \u54616 \u50688 \u45796 . \u44536 \u44057 \u51060  \u54616 \u50668  \u48277 \u50773 \u51008  \u49464 \u49345 \u50640  \u51080 \u45716  \u54616 \u45208 \u45784 \u51032  \u45824 \u47532 \u51088 \u47196 \u49436  \u44368 \u54924 \u50752  \u44397 \u44032 \u47484  \u51648 \u48176 \u54624  \u49688  \u51080 \u45716  \u44428 \u50948 \u47484  \u44032 \u51652  \u44163 \u51004 \u47196  \u51068 \u48152  \u49324 \u46988 \u46308 \u51008  \u49884 \u51064 \u54616 \u44592 \u50640  \u51060 \u47476 \u47104 \u45796 .\
\uc0\u50724 \u47448  (\u35492 \u35628 ) \u53456 \u51648 \u44592 \u51064  \u49457 \u44221 \u51060  \u51228 \u44144 \u46104 \u51088  \u49324 \u45800 \u51008  \u47560 \u51020  \u45459 \u44256  \u54876 \u50557 \u54616 \u50688 \u45796 . \u50696 \u50616 \u51008  \u48277 \u50773 \u44428 \u51060  \'93\u46412 \u50752  \u48277 \u51012  \u48320 \u44060 \u53076 \u51088  \u54624  \u44163 \u51060 \'94 (\u45800  7:25) \u46972 \u44256  \u54616 \u50688 \u45796 . \u44536  \u51068 \u51032  \u49892 \u54665 \u51008  \u51648 \u52404 \u46104 \u51648  \u50506 \u50520 \u45796 . \u51060 \u44368 \u50640 \u49436  \u44060 \u51333 \u54620  \u49324 \u46988 \u46308 \u50640 \u44172  \u50864 \u49345  \u49709 \u48176 \u47484  \u45824 \u49888 \u54624  \u50612 \u46500  \u44163 \u51012  \u47560 \u47144 \u54644  \u51452 \u50612  \u44536 \u46308 \u51032  \u47749 \u47785 \u51201 \u51064  \u44536 \u47532 \u49828 \u46020 \u44368 \u51032  \u49888 \u50521 \u51012  \u48155 \u50500 \u46308 \u51060 \u45716  \u51068 \u51012  \u52489 \u51652 \u49884 \u53412 \u44592  \u50948 \u54616 \u50668  \u49457 \u49345  (\u32854 \u20687 ) \u44284  \u50976 \u47932  \u49709 \u48176 \u44032  \u44536 \u47532 \u49828 \u46020 \u51064  \u50696 \u48176 \u50640  \u51216 \u51652 \u51201 \u51004 \u47196  \u46020 \u51077 \u46104 \u50632 \u45796 . \u52509 \u54924 \u51032  \u44368 \u47161  (\u25934 \u20196 ) \u51008  \u47560 \u52840 \u45236  \u50864 \u49345  \u49709 \u48176 \u51032  \u51228 \u46020 \u47484  \u54869 \u47549 \u49884 \u53040 \u45796  (\u48512 \u47197  3 \u52280 \u51312 ). \u47196 \u47560 \u44368 \u45716  \u49888 \u49457  \u47784 \u46021 \u51201  \u49324 \u50629 \u51012  \u50756 \u49457 \u54616 \u44592  \u50948 \u54616 \u50668  \u45824 \u45812 \u54616 \u44172 \u46020  \u50864 \u49345  \u49709 \u48176 \u47484  \u44552 \u51648 \u54620  \u54616 \u45208 \u45784 \u51032  \u46168 \u51704  \u44228 \u47749 \u51012  \u49325 \u51228 \u54616 \u44256  \u44228 \u47749 \u51032  \u49688 \u54952 \u47484  \u47582 \u52628 \u44592  \u50948 \u54616 \u50668  \u50676 \u51704  \u44228 \u47749 \u51012  \u46168 \u47196  \u45208 \u45572 \u50632 \u45796 .\
