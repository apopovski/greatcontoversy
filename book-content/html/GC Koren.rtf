\uc0\u54253 \u47141 \u51004 \u47196  \u44536 \u47532 \u49828 \u46020  \u44368 \u54924 \u47484  \u47736 \u54616 \u47140 \u45912  \u49324 \u45800 \u51032  \u45432 \u47141 \u51008  \u54728 \u51648 \u47196  \u46028 \u50500 \u44052 \u45796 . \u50696 \u49688 \u45784 \u51032  \u51228 \u51088 \u46308 \u51060  \u49373 \u47749 \u51012  \u48148 \u52828  \u45824 \u51137 \u53804 \u45716 , \u44536  \u52649 \u49892 \u54620  \u44592 \u49688  (\u26071 \u25163 ) \u46308 \u51060  \u51088 \u44592 \u51032  \u45812 \u45817  \u44396 \u50669 \u50640 \u49436  \u49912 \u50864 \u45796  \u50416 \u47084 \u51276 \u51012  \u46412  \u45149 \u45208 \u51648  \u50506 \u50520 \u45796 . \u44536 \u46308 \u51008  \u54056 \u48176 \u47196  \u51221 \u48373 \u54616 \u50688 \u45796 . \u54616 \u45208 \u45784 \u51032  \u51068 \u44988 \u46308 \u51008  \u51453 \u51076 \u51012  \u45817 \u54664 \u51648 \u47564  \u44536 \u48516 \u51032  \u49324 \u50629 \u51008  \u44984 \u51456 \u55176  \u48156 \u51204 \u46104 \u50632 \u45796 . \u48373 \u51020 \u51008  \u45130 \u51076 \u50630 \u51060  \u51204 \u54028 \u46104 \u50632 \u44256 , \u48127 \u45716  \u51088 \u51032  \u49688 \u54952 \u45716  \u45908 \u50865 \u45908  \u51613 \u44032 \u46104 \u50632 \u45796 . \u48373 \u51020 \u51008  \u47196 \u47560 \u51032  \u49688 \u47532 \u54364 \u51032  \u44400 \u44592  (eagles of Rome) \u51312 \u52264 \u46020  \u51217 \u44540 \u54616 \u44592  \u50612 \u47140 \u50868  \u51648 \u50669 \u44620 \u51648  \u52840 \u53804 \u54644  \u46308 \u50612 \u44052 \u45796 . \u44228 \u49549 \u54616 \u50668  \u48149 \u54644 \u54616 \u44592 \u47484  \u51452 \u51109 \u54616 \u45716  \u51060 \u48169 \u51064  \u53685 \u52824 \u51088 \u46308 \u50640 \u44172  \u50612 \u46500  \u44536 \u47532 \u49828 \u46020 \u51064 \u51008  \u45796 \u51020 \u44284  \u44057 \u51060  \u44036 \u50616 \u54616 \u50688 \u45796 . \'93\u45817 \u49888 \u46308 \u51008  \u50864 \u47532 \u47484  \u51453 \u51060 \u44256  \u44256 \u47928 \u54616 \u44256  \u51221 \u51396 \u54624  \u49688  \u51080 \u51012  \u44163 \u51060 \u45796 . \u44536 \u47084 \u45208  \u44277 \u51032 \u47213 \u51648  \u47803 \u54620  \u45817 \u49888 \u51032  \u52376 \u49324 \u45716  \u50864 \u47532 \u44032  \u47924 \u51396 \u54616 \u45796 \u45716  \u51613 \u44144 \u51060 \u45796 . \'85 \u45817 \u49888 \u46308 \u51032  \u51092 \u51064 \u49457 \u51060  \u45817 \u49888 \u46308 \u51012  \u51060 \u47213 \u44172  \u54616 \u51648 \u46020  \u47803 \u54624  \u44163 \u51060 \u45796 .\'94 \u48149 \u54644 \u45716  \u49324 \u46988 \u46308 \u51012  \u49888 \u50521 \u51004 \u47196  \u51060 \u45132 \u50612  \u46308 \u51060 \u45716  \u45908 \u50865  \u44053 \u54620  \u52488 \u52397 \u51060  \u46112  \u49104 \u51060 \u50632 \u45796 . \'93\u50864 \u47532 \u44032  \u45817 \u49888 \u46308 \u50640 \u44172  \u47785  \u48288 \u51076 \u51012  \u48155 \u51004 \u47732  \u48155 \u51012 \u49688 \u47197  \u50864 \u47532 \u51032  \u49688 \u54952 \u45716  \u45908 \u50865  \u51613 \u44032 \u54624  \u44163 \u51060 \u45796 . \u44536 \u47532 \u49828 \u46020 \u51064 \u51032  \u54588 \u45716  \u50472 \u45796 \'94 (Tertullian, Apology, paragraph 50).\
\uc0\u47924 \u49688 \u54620  \u49324 \u46988 \u46308 \u51060  \u50725 \u50640  \u44039 \u55176 \u44144 \u45208  \u49332 \u50977 \u51012  \u45817 \u54664 \u51648 \u47564  \u45796 \u47480  \u49324 \u46988 \u46308 \u51060  \u51068 \u50612 \u45208 \u49436  \u44536 \u46308 \u51032  \u51088 \u47532 \u47484  \u52292 \u50912 \u45796 . \u51060 \u50752  \u44057 \u51060  \u49888 \u50521 \u51032  \u51060 \u50976 \u47196  \u49692 \u44368 \u54620  \u49324 \u46988 \u46308 \u51008  \u44536 \u47532 \u49828 \u46020 \u44760  \u49549 \u54620  \u49324 \u46988 \u51004 \u47196  \u48372 \u51613 \u51012  \u48155 \u44256 , \u49849 \u47532 \u51088 \u47196  \u44036 \u51452 \u46104 \u50632 \u45796 . \u44536 \u46308 \u51008  \u49440 \u54620  \u49912 \u50880 \u51012  \u49912 \u50912 \u51004 \u48064 \u47196  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u44053 \u47548 \u54616 \u49892  \u46412 \u50640  \u50689 \u44305 \u51032  \u47732 \u47448 \u44288 \u51012  \u48155 \u44172  \u46112  \u44163 \u51060 \u45796 . \u46608 \u54620  \u44536 \u46308 \u51060  \u45817 \u54620  \u44256 \u45212 \u51008  \u44536 \u47532 \u49828 \u46020 \u51064 \u46308  \u49345 \u54840 \u44036 \u50640  \u44536 \u47532 \u44256  \u44536 \u46308 \u51032  \u44396 \u49549 \u51452 \u44760  \u45908 \u50865  \u52828 \u48128 \u54616 \u44172  \u47564 \u46308 \u50632 \u45796 . \u46608 \u54620  \u44536 \u46308 \u51032  \u51068 \u49345  \u49373 \u54876 \u51032  \u47784 \u48376 \u44284  \u51076 \u51333 \u49884 \u51032  \u51613 \u50616 \u51008  \u51652 \u47532 \u50640  \u45824 \u54620  \u45130 \u51076 \u50630 \u45716  \u51613 \u51064 \u51060 \u50632 \u45796 . \u51204 \u54784  \u44032 \u47581 \u51060  \u50630 \u50632 \u45912  \u49324 \u45800 \u51032  \u48512 \u54616 \u46308 \u51060  \u49324 \u45800 \u51012  \u49452 \u44592 \u45716  \u51068 \u51012  \u48260 \u47532 \u44256  \u44536 \u47532 \u49828 \u46020 \u51032  \u44611 \u48156  \u50500 \u47000  \u47784 \u51060 \u44172  \u46104 \u50632 \u45796 .\
\uc0\u44536 \u47084 \u48064 \u47196  \u49324 \u45800 \u51008  \u50500 \u51452  \u44368 \u47896 \u54620  \u48169 \u48277 \u51004 \u47196  \u54616 \u45208 \u45784 \u51032  \u51221 \u48512 \u47484  \u45824 \u51201 \u54624  \u44228 \u54925 \u51012  \u49464 \u50864 \u44256 , \u51088 \u44592 \u51032  \u44611 \u48156 \u51012  \u44536 \u47532 \u49828 \u46020  \u44368 \u54924  \u50504 \u50640  \u44866 \u50520 \u45796 . \u49324 \u45800 \u51008  \u44536 \u47532 \u49828 \u46020 \u51064 \u46308 \u51012  \u49549 \u50668 \u49436  \u54616 \u45208 \u45784 \u51032  \u46907 \u51012  \u50612 \u44592 \u46020 \u47197 \u47564  \u54620 \u45796 \u47732 , \u44536 \u46308 \u51060  \u55192 \u44284  \u44204 \u51064 \u48520 \u48156  (\u22533 \u24525 \u63847 \u25300 ) \u51032  \u51221 \u49888 \u51012  \u51075 \u50612 \u48260 \u47532 \u44256  \u49789 \u49324 \u47532  \u51088 \u44592 \u51032  \u48165 \u51060  \u46112  \u44163 \u51060 \u46972 \u44256  \u49373 \u44033 \u54616 \u50688 \u45796 .\
\uc0\u53360  \u50896 \u49688 \u45716  \u54253 \u47141 \u51012  \u50432 \u51004 \u47196  \u49552 \u54644 \u47484  \u48376  \u44163 \u51012  \u44228 \u44368 \u47484  \u50024 \u49436  \u52286 \u51004 \u47140 \u44256  \u50528 \u47484  \u50044 \u45796 . \u48149 \u54644 \u45716  \u44536 \u52824 \u44256 , \u44536  \u45824 \u49888 \u50640  \u49464 \u49549 \u51201  \u48264 \u50689 \u44284  \u49464 \u49549 \u51201  \u47749 \u50696 \u46972 \u45716  \u50948 \u54744 \u54620  \u48120 \u45180 \u44032  \u45459 \u51060 \u44172  \u46104 \u50632 \u45796 . \u50864 \u49345  \u49709 \u48176 \u51088 \u46308 \u51008  \u44536 \u47532 \u49828 \u46020 \u44368  \u49888 \u50521 \u51032  \u51068 \u48512 \u48516 \u51008  \u48155 \u50500 \u46308 \u51060 \u44256  \u51473 \u50836 \u54620  \u45796 \u47480  \u51652 \u47532 \u46308 \u51008  \u44144 \u51208 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u50696 \u49688 \u45784 \u51012  \u54616 \u45208 \u45784 \u51032  \u50500 \u46308 \u47196  \u51064 \u51221 \u54616 \u44256  \u44536 \u48516 \u51032  \u51453 \u51004 \u49900 \u44284  \u48512 \u54876 \u51012  \u48127 \u45432 \u46972 \u44256  \u44277 \u50616 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u46308 \u51008  \u51396 \u47484  \u51088 \u44033 \u54616 \u44144 \u45208  \u54924 \u44060  \u54841 \u51008  \u47560 \u51020 \u51032  \u48320 \u54868 \u51032  \u54596 \u50836 \u47484  \u51204 \u54784  \u45712 \u45180 \u51648  \u47803 \u54664 \u45796 . \u44536 \u46308 \u51008  \u51088 \u44592 \u46308 \u51060  \u44536 \u47532 \u49828 \u46020 \u47484  \u48127 \u45716  \u48127 \u51020 \u50640  \u51068 \u52824 \u54616 \u44592  \u50948 \u54616 \u50668  \u47676 \u51200  \u50577 \u48372 \u54616 \u50688 \u51008 \u51593  \u44536 \u47532 \u49828 \u46020 \u44368  \u52769 \u50640 \u49436 \u46020  \u44536 \u47564 \u53372  \u50577 \u48372 \u54616 \u50668 \u50556  \u54624  \u44163 \u51060 \u46972 \u44256  \u51452 \u51109 \u54616 \u50688 \u45796 .\
