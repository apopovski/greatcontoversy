\uc0\u49324 \u45800 \u51008  \u49324 \u46988 \u46308 \u50640 \u44172  \u44536 \u46308 \u51032  \u47784 \u46304  \u51656 \u48337 \u51012  \u44256 \u52432  \u51460  \u49688  \u51080 \u45716  \u50948 \u45824 \u54620  \u51032 \u49324 \u51064  \u44163 \u52376 \u47100  \u44032 \u51109 \u54616 \u51648 \u47564  \u51656 \u48337 \u44284  \u51116 \u45212 \u51012  \u44032 \u51256 \u50752 \u49436  \u47560 \u52840 \u45236  \u51064 \u44396 \u44032  \u47566 \u51008  \u46020 \u49884 \u46308 \u51012  \u54028 \u47736 \u44284  \u54889 \u54224  \u49345 \u53468 \u47196  \u48148 \u45068 \u44172  \u54620 \u45796 . \u44536 \u45716  \u51648 \u44552 \u46020  \u50669 \u49884  \u54876 \u46041 \u54616 \u44256  \u51080 \u45796 . \u49324 \u45800 \u51008  \u46907 \u54616 \u51648  \u50506 \u51008  \u49324 \u44256 , \u48148 \u45796 \u50752  \u50977 \u51648 \u50640 \u49436  \u51068 \u50612 \u45208 \u45716  \u51116 \u45212 , \u53360  \u54868 \u51116 , \u49324 \u45208 \u50868  \u54413 \u46993 , \u49900 \u54620  \u50864 \u48149 , \u54253 \u54413 \u50864 , \u54861 \u49688 , \u54924 \u50724 \u47532 \u48148 \u46988 , \u54644 \u51068 , \u51648 \u51652  \u46321  \u49688 \u47566 \u51008  \u48169 \u48277 \u51004 \u47196  \u44033  \u51648 \u50669 \u50640 \u49436  \u44536 \u51032  \u45733 \u47141 \u51012  \u45208 \u53440 \u45236 \u44256  \u51080 \u45796 . \u44536 \u45716  \u45796  \u51061 \u51008  \u49688 \u54869 \u47932 \u51012  \u50424 \u50612 \u48260 \u47548 \u51004 \u47196  \u44592 \u44540 \u44284  \u48520 \u54665 \u51060  \u46244 \u46384 \u47476 \u44172  \u54620 \u45796 . \u44536 \u45716  \u52824 \u47749 \u51201  \u48337 \u46021 \u51012  \u44277 \u51473 \u50640  \u49100 \u47548 \u51004 \u47196  \u49688 \u47566 \u51008  \u49324 \u46988 \u46308 \u51012  \u51656 \u48337 \u51004 \u47196  \u51453 \u44172  \u54620 \u45796 . \u51060 \u47084 \u54620  \u51068 \u51008  \u51216 \u51216  \u45908  \u48712 \u48264 \u54616 \u44256  \u48708 \u52280 \u54644 \u51256  \u44036 \u45796 . \u47736 \u47581 \u51060  \u49324 \u46988 \u44284  \u51664 \u49849 \u50640 \u44172  \u46609 \u44057 \u51060  \u50628 \u49845 \u54620 \u45796 . \'93\u46405 \u51060  \u49836 \u54140 \u54616 \u44256  \u49632 \u51092 \u54616 \u47728 \'94, \'93\u49464 \u49345  \u48177 \u49457  \u51473 \u50640  \u45458 \u51008  \u51088 \u44032  \u49632 \u50557 \u54616 \u47728  \u46405 \u51060  \u46608 \u54620  \u44536  \u44144 \u48124  \u50500 \u47000 \u49436  \u45908 \u47101 \u44172  \u46104 \u50632 \u51004 \u45768  \u51060 \u45716  \u44536 \u46308 \u51060  \u50984 \u48277 \u51012  \u48276 \u54616 \u47728  \u50984 \u47168 \u47484  \u50612 \u44592 \u47728  \u50689 \u50896 \u54620  \u50616 \u50557 \u51012  \u54028 \u54616 \u50688 \u51020 \u51060 \u45768 \u46972 \'94 (\u49324  24:4, 5).\
\uc0\u44536  \u46412 \u50640  \u53360  \u44592 \u47564 \u51088 \u45716  \u49324 \u46988 \u46308 \u50640 \u44172  \u51060 \u47088  \u51116 \u45212 \u46308 \u51060  \u54616 \u45208 \u45784 \u51012  \u49452 \u44592 \u45716  \u49324 \u46988 \u46308  \u46412 \u47928 \u50640  \u51068 \u50612 \u45208 \u44256  \u51080 \u45796 \u44256  \u50669 \u49444 \u54624  \u44163 \u51060 \u45796 . \u54616 \u45208 \u45784 \u51032  \u48520 \u53132 \u55176  \u50668 \u44592 \u49900 \u51012  \u51088 \u44537 \u54620  \u48512 \u47448 \u50640  \u49549 \u54620  \u51088 \u46308 \u51008  \u48276 \u51396 \u51088 \u46308 \u50640 \u44172  \u50616 \u51228 \u45208  \u47924 \u50616 \u51032  \u44204 \u52293 \u51012  \u54616 \u44256  \u51080 \u45716  \u54616 \u45208 \u45784 \u51032  \u44228 \u47749 \u51012  \u49692 \u51333 \u54616 \u45716  \u51088 \u46308 \u51060  \u44536 \u46308 \u51060  \u45817 \u54616 \u45716  \u47784 \u46304  \u51116 \u45212 \u51032  \u50896 \u51064 \u51060  \u46108 \u45796 \u44256  \u48708 \u45212 \u54624  \u44163 \u51060 \u45796 . \u49324 \u46988 \u46308 \u51060  \u51068 \u50836 \u51068  \u50504 \u49885 \u51068 \u51012  \u48276 \u54664 \u51004 \u48064 \u47196  \u54616 \u45208 \u45784 \u51032  \u51652 \u45432 \u47484  \u48155 \u44256  \u51080 \u45796 \u45716  \u44163 \u44284 , \u44536  \u51396 \u44032  \u51116 \u45212 \u51012  \u51068 \u51004 \u53040 \u51004 \u48064 \u47196  \u51068 \u50836 \u51068  \u51456 \u49688 \u47484  \u50628 \u44201 \u54616 \u44172  \u44053 \u50836 \u54616 \u44592  \u51204 \u50640 \u45716  \u51116 \u45212 \u51060  \u44536 \u52824 \u51648  \u50506 \u51012  \u44163 \u51060 \u46972 \u44256  \u51452 \u51109 \u54624  \u44163 \u51060 \u45796 . \u44536 \u47532 \u44256  \u45367 \u51704  \u44228 \u47749 \u51032  \u50836 \u44396 \u47484  \u44032 \u47476 \u52840 \u51004 \u47196  \u51068 \u50836 \u51068 \u50640  \u45824 \u54620  \u51316 \u51473 \u49900 \u51012  \u50630 \u50528  \u48260 \u47532 \u45716  \u51088 \u46308 \u51008  \u49324 \u46988 \u46308 \u51012  \u44340 \u47