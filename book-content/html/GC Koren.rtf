\f0\b \cf0 \uc0\u47196 \u47560 \u44368 \u50752  \u52488 \u44592 \u51032  \u50976 \u45824 \u44368 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u47196 \u47560 \u44368 \u54924 \u50752  \u44536 \u47532 \u49828 \u46020  \u52488 \u47548  \u45817 \u49884 \u51032  \u50976 \u45824 \u44368 \u50752 \u45716  \u54788 \u51200 \u54620  \u50976 \u49324 \u51216 \u51060  \u51080 \u45796 . \u50976 \u45824 \u51064 \u46308 \u51008  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51032  \u47784 \u46304  \u50896 \u52825 \u46308 \u51012  \u48708 \u48128 \u47532 \u50640  \u50976 \u47536 \u54616 \u47732 \u49436  \u54364 \u47732 \u49345 \u51004 \u47196 \u45716  \u44536  \u51312 \u47928 \u46308 \u51012  \u50628 \u44201 \u55176  \u51648 \u53040 \u45796 . \u44536 \u47532 \u44256  \u44620 \u45796 \u47196 \u50868  \u50836 \u44396 \u50752  \u50976 \u51204 \u51012  \u52392 \u44032 \u49884 \u53020  \u44536 \u44163 \u51012  \u51456 \u49688 \u54616 \u45716  \u51068 \u51060  \u44256 \u53685 \u49828 \u47101 \u44256  \u44340 \u47213 \u44172  \u47564 \u46308 \u50632 \u45796 . \u47560 \u52824  \u50976 \u45824 \u51064 \u46308 \u51060  \u50984 \u48277 \u51012  \u51316 \u51473 \u54616 \u45432 \u46972 \u44256  \u44277 \u50616 \u54664 \u45912  \u44163 \u52376 \u47100  \u47196 \u47560 \u44368 \u46020 \u46308 \u51008  \u49901 \u51088 \u44032 \u47484  \u51316 \u51473 \u54616 \u45432 \u46972 \u44256  \u51452 \u51109 \u54620 \u45796 . \u44536 \u46308 \u51008  \u44536 \u47532 \u49828 \u46020 \u51032  \u44256 \u45212 \u51032  \u49345 \u51669 \u51012  \u45458 \u51060 \u47732 \u49436 \u46020  \u44536 \u46308 \u51032  \u49373 \u50528 \u50640  \u51080 \u50612 \u49436 \u45716  \u44536 \u44163 \u51060  \u45824 \u54364 \u54616 \u45716  \u44536 \u48516 \u51012  \u48512 \u51064 \u54620 \u45796 .\
\uc0\u47196 \u47560 \u44368 \u46020 \u46308 \u51008  \u49901 \u51088 \u44032 \u47484  \u44368 \u54924 \u50640 , \u44053 \u45800 \u50640  \u44536 \u47532 \u44256  \u44536 \u46308 \u51032  \u51032 \u48373 \u50640  \u48537 \u51064 \u45796 . \u50612 \u46356 \u50640 \u49436 \u45208  \u49901 \u51088 \u44032 \u51032  \u55064 \u51109 \u51012  \u48372 \u44172  \u46108 \u45796 . \u50808 \u44288 \u49345 \u51004 \u47196 \u45716  \u50612 \u46356 \u49436 \u45208  \u44536 \u44163 \u51060  \u51316 \u44221 \u44284  \u45458 \u51076 \u51012  \u48155 \u45716 \u45796 . \u44536 \u47084 \u45208  \u44536 \u47532 \u49828 \u46020 \u51032  \u44368 \u54984 \u46308 \u51008  \u47924 \u51032 \u48120 \u54620  \u50976 \u51204 \u44284  \u44144 \u51667 \u46108  \u54644 \u49437 \u44284  \u50628 \u44201 \u54620  \u44508 \u52825 \u46308 \u51032  \u47924 \u45908 \u44592  \u50500 \u47000  \u47931 \u54784  \u48260 \u47536 \u45796 . \u50756 \u44256 \u54620  \u50976 \u45824 \u51064 \u46308 \u50640  \u44288 \u54620  \u44396 \u51452 \u51032  \u47568 \u50432 \u51008  \u50724 \u55176 \u47140  \u47196 \u47560  \u52380 \u51452 \u44368 \u51032  \u51648 \u46020 \u51088 \u46308 \u50640 \u44172  \u45908 \u50865  \u51221 \u54869 \u55176  \u51201 \u50857 \u46108 \u45796 . \'93\u47924 \u44144 \u50868  \u51664 \u51012  \u47926 \u50612  \u49324 \u46988 \u51032  \u50612 \u44648 \u50640  \u51648 \u50864 \u46104  \u51088 \u44592 \u45716  \u51060 \u44163 \u51012  \u54620  \u49552 \u44032 \u46973 \u51004 \u47196 \u46020  \u50880 \u51649 \u51060 \u47140  \u54616 \u51648  \u50500 \u45768 \'94 (\u47560  23:4) \u54620 \u45796 . \u50577 \u49900 \u51201 \u51064  \u49324 \u46988 \u46308 \u51008  \u50616 \u51228 \u45208  \u54616 \u45208 \u45784 \u51012  \u44144 \u49828 \u47492 \u51004 \u47196  \u48155 \u45716  \u51652 \u45432 \u47484  \u46160 \u47140 \u50892 \u54616 \u44256  \u51080 \u45716  \u54620 \u54200  \u44368 \u54924 \u51032  \u47566 \u51008  \u51648 \u46020 \u51088 \u46308 \u51008  \u49324 \u52824 \u50752  \u53132 \u46973 \u51012  \u51600 \u44592 \u45716  \u49373 \u54876 \u51012  \u54616 \u44256  \u51080 \u45796 .\
\uc0\u49457 \u49345  (\u32854 \u20687 ) \u44284  \u50976 \u47932  \u50696 \u48176 , \u49457 \u51088  (\u32854 \u32773 ) \u46308 \u50640 \u44172  \u46300 \u47532 \u45716  \u44592 \u46020 , \u48277 \u50773  \u49709 \u48176  \u46321 \u51008  \u49324 \u46988 \u51032  \u47560 \u51020 \u51012  \u54616 \u45208 \u45784 \u44284  \u44536 \u48516 \u51032  \u50500 \u46308 \u50640 \u44172 \u49436  \u46496 \u45208 \u44032 \u44172  \u54616 \u47140 \u45716  \u49324 \u45800 \u51032  \u44036 \u44228 \u51060 \u45796 . \u49324 \u45800 \u51008  \u44536 \u46308 \u51012  \u47736 \u47581 \u49884 \u53412 \u44592  \u50948 \u54616 \u50668  \u50724 \u51649  \u44536 \u46308 \u51060  \u44396 \u50896 \u51012  \u50619 \u51012  \u49688  \u51080 \u45716  \u50976 \u51068 \u51032  \u48516 \u50640 \u44172 \u49436  \u44536 \u46308 \u51032  \u51452 \u51032 \u47484  \u51060 \u53448 \u49884 \u53412 \u44256 \u51088  \u45432 \u47141 \u54616 \u44256  \u51080 \u45796 . \u49324 \u45800 \u51008  \'93\u49688 \u44256 \u54616 \u44256  \u47924 \u44144 \u50868  \u51664  \u51652  \u51088 \u46308 \u50500  \u45796  \u45236 \u44172 \u47196  \u50724 \u46972  \u45236 \u44032  \u45320 \u55148 \u47484  \u49772 \u44172  \u54616 \u47532 \u46972 \'94 (\u47560  11:28) \u44256  \u47568 \u50432 \u54616 \u49888  \u48516 \u51012  \u45824 \u49888 \u54624  \u50612 \u46500  \u45824 \u49345 \u50640 \u44172 \u47196  \u44536 \u46308 \u51012  \u51060 \u45132  \u44163 \u51060 \u45796 .\
\uc0\u49324 \u45800 \u51008  \u54616 \u45208 \u45784 \u51032  \u54408 \u49457 \u44284  \u51396 \u51032  \u49457 \u51656 \u44284  \u45824 \u51137 \u53804 \u50640  \u44152 \u47140  \u51080 \u45716  \u51652 \u51221 \u54620  \u47928 \u51228 \u47484  \u51096 \u47803 \u46104 \u44172  \u45208 \u53440 \u45236 \u44592  \u50948 \u54616 \u50668  \u45130 \u51076 \u50630 \u51060  \u45432 \u47141 \u54616 \u44256  \u51080 \u45796 . \u44536 \u51032  \u44452 \u48320 \u51008  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u50640  \u45824 \u54620  \u51032 \u47924  \u44288 \u45392 \u51012  \u48149 \u50557 \u54616 \u44172  \u54616 \u50668  \u49324 \u46988 \u46308 \u50640 \u44172  \u51396 \u47484  \u48276 \u54616 \u44172  \u47564 \u46304 \u45796 . \u46041 \u49884 \u50640  \u44536 \u45716  \u49324 \u46988 \u46308 \u51060  \u54616 \u45208 \u45784 \u44760  \u45824 \u54616 \u50668  \u44536 \u47495 \u46108  \u44288 \u45392 \u51012  \u44054 \u44172  \u54632 \u51004 \u47196  \u54616 \u45208 \u45784 \u51012  \u49324 \u46993 \u54616 \u44592 \u48372 \u45796  \u44536 \u48516 \u51012  \u49899 \u50612 \u54616 \u44256  \u46160 \u47140 \u50892 \u54616 \u44172  \u47564 \u46304 \u45796 .\
\uc0\u49324 \u45800 \u51008  \u44536 \u51032  \u54408 \u49457  \u49549 \u50640  \u48376 \u47000 \u48512 \u53552  \u51080 \u45716  \u51092 \u51064 \u49457 \u51012  \u52285 \u51312 \u51452 \u44760  \u46028 \u47532 \u44256  \u44536 \u44163 \u51012  \u51333 \u44368  \u51228 \u46020 \u50640  \u44396 \u54788 \u49884 \u53412 \u44256 , \u50696 \u48176 \u51032  \u54805 \u49885 \u50640  \u45208 \u53440 \u45236 \u50632 \u45796 . \u44536 \u50752  \u44057 \u51060  \u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u51060  \u50612 \u46160 \u50892 \u51648 \u51088  \u49324 \u45800 \u51008  \u44536 \u46308 \u51012  \u54616 \u45208 \u45784 \u51012  \u45824 \u51201 \u54616 \u50668  \u49912 \u50864 \u45716  \u51068 \u50640  \u51088 \u49888 \u51032  \u45824 \u47532 \u51088 \u47196  \u49340 \u45716 \u45796 . \u54616 \u45208 \u45784 \u51032  \u49549 \u49457 \u50640  \u45824 \u54620  \u44288 \u45392 \u51060  \u44257 \u54644 \u46120 \u51004 \u47196 \u50024  \u51060 \u44368 \u44397 \u51032  \u48177 \u49457 \u46308 \u51008  \u54616 \u45208 \u45784 \u51032  \u51008 \u52509 \u51012  \u50619 \u44592  \u50948 \u54616 \u50668  \u49324 \u46988 \u51012  \u55148 \u49373  \u51228 \u47932 \u47196  \u46300 \u47532 \u45716  \u51068 \u51060  \u54596 \u50836 \u54616 \u45796 \u44256  \u48127 \u44172  \u46104 \u50632 \u45796 . \u44536 \u47532 \u54616 \u50668  \u50668 \u47084  \u44032 \u51648  \u50864 \u49345  \u49709 \u48176 \u51032  \u54805 \u53468  \u54616 \u50640 \u49436  \u47924 \u49453 \u44256 \u46020  \u51092 \u51064 \u54620  \u51068 \u46308 \u51060  \u51088 \u54665 \u46104 \u50612  \u50772 \u45796 .\
