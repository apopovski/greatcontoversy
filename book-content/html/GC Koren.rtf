\uc0\u44256 \u45212 \u44284  \u51312 \u47217 \u51012  \u48155 \u51004 \u47732 \u49436 \u46020  \u45812 \u45824 \u54616 \u44172  \u44536 \u47532 \u49828 \u46020 \u47484  \u51613 \u44144 \u54620  \u49324 \u46988 \u46308 \u51008  \u48708 \u52380 \u54616 \u44256  \u44032 \u45212 \u54620  \u44228 \u44553 \u51032  \u49324 \u46988 \u46308 \u49104 \u47564 \u51060  \u50500 \u45768 \u50632 \u45796 . \u50773 \u44417 \u44284  \u54988 \u47469 \u54620  \u51200 \u53469  \u44032 \u50868 \u45936 \u46020  \u51116 \u47932 \u44284  \u51648 \u50948 \u50752  \u49900 \u51648 \u50612 \u45716  \u49373 \u47749 \u44620 \u51648 \u46972 \u46020  \u51652 \u47532 \u50640  \u48708 \u54616 \u47732  \u44221 \u54616 \u45796 \u44256  \u49373 \u44033 \u54616 \u45716  \u54988 \u47469 \u54620  \u49324 \u46988 \u46308 \u51060  \u51080 \u50632 \u45796 . \u44048 \u46021 \u51032  \u50696 \u48373 \u51012  \u51077 \u44256  \u44048 \u46021 \u51032  \u44288 \u51012  \u50420  \u51088 \u48372 \u45796 \u46020  \u50773 \u51032  \u44049 \u50743 \u51012  \u51077 \u51008  \u51088 \u46308 \u51060  \u54620 \u52789  \u45908  \u44256 \u49345 \u54616 \u44256  \u44256 \u44208 \u54616 \u44256  \u54869 \u44256 \u54620  \u51221 \u49888 \u51012  \u44032 \u51648 \u44256  \u51080 \u50632 \u45796 . \u47336 \u51060  \u46300  \u48288 \u47476 \u52901  (Louis de Berquin) \u51008  \u44480 \u51313  \u52636 \u49888 \u51060 \u50632 \u45796 . \u44536 \u45716  \u50857 \u44048 \u54616 \u44256  \u50696 \u51032 \u48148 \u47480  \u44592 \u49324 \u50688 \u44256 , \u54617 \u44396 \u50676 \u51060  \u53804 \u52384 \u54616 \u44256 , \u49464 \u47144 \u46108  \u54665 \u46041 \u44284  \u55136 \u51060  \u50630 \u45716  \u46020 \u45909 \u51201  \u54364 \u51456 \u51012  \u44256 \u49688 \u54616 \u45716  \u49324 \u46988 \u51060 \u50632 \u45796 . \'93\u44536 \u45716  \u48277 \u50773  \u51228 \u46020 \u51032  \u49888 \u48393 \u51088 \u50836  \u48120 \u49324 \u50640  \u52280 \u49437 \u54616 \u44256  \u49444 \u44368 \u47484  \u50676 \u49900 \u51004 \u47196  \u46307 \u45716  \u51088 \u50688 \u51004 \u47728 ,\'85\u44536 \u50640 \u44172 \u45716  \u47924 \u50631 \u48372 \u45796 \u46020  \u47336 \u53552 \u54028 \u47484  \u48120 \u50892 \u54616 \u45716  \u49373 \u44033 \u51060  \u45908 \u50865  \u47566 \u50520 \u45796 \'94\u44256  \u54620  \u51200 \u51088 \u45716  \u44592 \u47197 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u46020  \u47566 \u51008  \u49324 \u46988 \u46308 \u44284  \u47560 \u52268 \u44032 \u51648 \u47196  \u54616 \u45208 \u45784 \u51032  \u49453 \u47532  \u50500 \u47000  \u49457 \u44221 \u51012  \u50672 \u44396 \u54616 \u44172  \u46104 \u50632 \u45796 . \u44536 \u45716  \u49457 \u44221 \u50640  \u44592 \u47197 \u46104 \u50612  \u51080 \u45716  \u44163 \u51060  \'93\u47196 \u47560 \u44368 \u51032  \u44368 \u47532 \u44032  \u50500 \u45768 \u46972  \u47336 \u53552 \u51032  \u44368 \u47532 \u51064  \u44163 \u51012  \u44648 \u45803 \u44256 \'94 (Wylie, b.13, ch.9) \u45440 \u46992 \u45796 . \u44536 \u45716  \u44536  \u46244 \u47196 \u48512 \u53552  \u50728 \u51204 \u55176  \u48373 \u51020  \u49324 \u50629 \u50640  \u54732 \u49888 \u54616 \u44172  \u46104 \u50632 \u45796 .\
\'93\uc0\u54532 \u46993 \u49828  \u44480 \u51313  \u44032 \u50868 \u45936 \u49436  \u52572 \u45824 \u51032  \u54617 \u51088 \'94\u51064  \u44536 \u45716  \u44536 \u51032  \u52380 \u54408  (\u22825 \u31263 ) \u44284  \u50885 \u48320 \u51201  \u51116 \u45733 , \u48177 \u51208 \u48520 \u44404 \u51032  \u50857 \u44592 \u50752  \u50676 \u49900 , \u51076 \u44552 \u50640 \u44172  \u52509 \u50528 \u47484  \u48155 \u45716  \u49324 \u46988 \u51004 \u47196 \u49436  \u44417 \u51204 \u50640 \u49436 \u51032  \u50689 \u54693 \u47141  \u46321 \u51004 \u47196  \u48372 \u50500 \u49436  \u52380 \u49457 \u51201 \u51004 \u47196  \u54532 \u46993 \u49828  \u44060 \u54785 \u51088 \u47196  \u53468 \u50612 \u45212  \u44163 \u51004 \u47196  \u47566 \u51008  \u49324 \u46988 \u46308 \u50640 \u44172  \u51064 \u51221 \u51012  \u48155 \u50520 \u45796 . \u48288 \u51088  (Beza) \u45716  \'93\u47564 \u51068  \u54532 \u46976 \u49884 \u49828  1\u49464 \u44032  \u51228 2\u51032  \u49440 \u54980  (\u36984 \u20399 ) \u50688 \u50632 \u45908 \u46972 \u47732  \u48288 \u47476 \u52901 \u51008  \u48516 \u47749 \u55176  \u51228 2\u51032  \u47336 \u53552 \u44032  \u46104 \u50632 \u51012  \u44163 \u51060 \u45796 \'94\u44256  \u47568 \u54616 \u50688 \u45796 . \u48277 \u50773 \u44368 \u46020 \u46308 \u51008  \u44536 \u47484  \'93\u47336 \u53552 \u48372 \u45796  \u45908 \u50865  \u45208 \u49244  \u49324 \u46988 \u51060 \u45796 \'94 (Wylie, b.13, ch.9) \u44256  \u48512 \u47476 \u51670 \u50632 \u45796 . \u44536 \u45716  \u54532 \u46993 \u49828 \u51032  \u47196 \u47560 \u44368 \u46020 \u46308 \u50640 \u44172 \u45716  \u51221 \u47568 \u47196  \u47336 \u53552 \u48372 \u45796  \u45908 \u50865  \u46160 \u47140 \u50868  \u51316 \u51116 \u44032  \u46104 \u50632 \u45796 . \u44536 \u46308 \u51008  \u44536 \u47484  \u51060 \u45800 \u51088 \u47196  \u53804 \u50725 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u54532 \u46976 \u49884 \u49828  \u50773 \u51008  \u44536 \u47484  \u49437 \u48169 \u49884 \u53020  \u51452 \u50632 \u45796 . \u44536  \u54980 \u47196  \u50668 \u47084  \u54644  \u46041 \u50504  \u53804 \u51137 \u51060  \u44228 \u49549 \u46104 \u50632 \u45796 . \u47196 \u47560 \u44368 \u50752  \u44060 \u54785 \u54028  \u49324 \u51060 \u50640 \u49436  \u48169 \u54889 \u54616 \u44256  \u51080 \u45716  \u54532 \u46976 \u49884 \u49828  \u50773 \u51008  \u49849 \u47140  \u52769 \u51032  \u44032 \u54841 \u54620  \u50676 \u49457 \u51012  \u47925 \u51064 \u54616 \u45716  \u46319 \u54616 \u45796 \u44032 \u46020  \u46412 \u47196 \u45716  \u44536 \u44163 \u51012  \u44204 \u51228 \u54616 \u50688 \u45796 . \u48288 \u47476 \u52901 \u51008  \u48277 \u50773 \u44368 \u51032  \u45817 \u44397 \u51088 \u46308 \u50640  \u51032 \u54616 \u50668  \u49464  \u48264 \u51060 \u45208  \u53804 \u50725 \u45817 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u50616 \u51228 \u45208  \u44536 \u51032  \u52380 \u51116 \u51201  \u51116 \u51656 \u44284  \u44256 \u44208 \u54620  \u51064 \u44201 \u51012  \u52268 \u53444 \u54644  \u50724 \u45912  \u50773 \u51008  \u44536 \u47484  \u44368 \u44428 \u51032  \u49696 \u52293 \u50640  \u55148 \u49373 \u45817 \u54616 \u51648  \u50506 \u46020 \u47197  \u54616 \u44592  \u50948 \u54616 \u50668  \u44536  \u46412 \u47560 \u45796  \u44536 \u47484  \u49437 \u48169 \u49884 \u53020  \u51452 \u50632 \u45796 .\
\uc0\u48288 \u47476 \u52901 \u51008  \u54532 \u46993 \u49828 \u50640 \u49436  \u44536 \u47484  \u50948 \u54801 \u54616 \u45716  \u50948 \u54744 \u50640  \u45824 \u54644 \u49436  \u50668 \u47084  \u48264  \u44221 \u44256 \u47484  \u48155 \u44256 , \u46608 \u45716  \u51088 \u51652 \u54644 \u49436  \u47581 \u47749 \u54616 \u48064 \u47196  \u50504 \u51204 \u54616 \u44172  \u46108  \u49324 \u46988 \u46308 \u51032  \u48376 \u51012  \u46384 \u47476 \u46972 \u45716  \u44428 \u44256 \u47484  \u51088 \u51452  \u46308 \u50632 \u45796 . \u47784 \u46304  \u54617 \u47928 \u51032  \u45458 \u51008  \u44221 \u51648 \u50640  \u51060 \u47476 \u44256 \u49436 \u46020  \u51652 \u47532 \u47484  \u50948 \u54616 \u50668  \u49373 \u47749 \u44284  \u47749 \u50696 \u47484  \u48260 \u47540  \u44592 \u48177 \u51060  \u50630 \u45716  \u48708 \u44161 \u54620  \u44592 \u54924 \u51452 \u51032 \u51088 \u51064  \u50640 \u46972 \u49828 \u47924 \u49828  (Erasmus) \u45716  \u48288 \u47476 \u52901 \u50640 \u44172  \u45796 \u51020 \u44284  \u44057 \u51008  \u54200 \u51648 \u47484  \u48372 \u45256 \u45796 . \'93\u50612 \u46500  \u50808 \u44397 \u51032  \u45824 \u49324 \u47196  \u54028 \u44204 \u46104 \u44592 \u47484  \u50836 \u52397 \u54616 \u50668  \u46021 \u51068 \u47196  \u44032 \u46020 \u47197  \u54616 \u49901 \u49884 \u50724 . \u44536 \u45824 \u45716  \u48288 \u45796  (Beda) \u47484  \u50508  \u44163 \u51077 \u45768 \u45796 . \u44536 \u45716  \u45328 \u47532  \u49324 \u48169 \u51004 \u47196  \u46021 \u49548  (\u27602 \u32032 ) \u47484  \u54140 \u46888 \u47532 \u45716  \u49688 \u52380 \u51032  \u47672 \u47532 \u47484  \u44032 \u51652  \u44340 \u47932 \u51077 \u45768 \u45796 . \u44536 \u45824 \u51032  \u50896 \u49688 \u45716  \u52280 \u51004 \u47196  \u47566 \u49548 \u51060 \u45796 . \u44536 \u45824 \u51032  \u49324 \u50629 \u51060  \u44536 \u47532 \u49828 \u46020 \u51032  \u49324 \u50629 \u48372 \u45796  \u45908 \u50865  \u54988 \u47469 \u54624 \u51648 \u46972 \u46020  \u44536 \u46308 \u51008  \u44536 \u45824 \u47484  \u51092 \u54841 \u54620  \u51453 \u51020 \u50640  \u52376 \u54616 \u44592  \u51204 \u50640 \u45716  \u44208 \u53076  \u44032 \u47564 \u51080 \u51648  \u50506 \u51012  \u44163 \u51077 \u45768 \u45796 . \u50773 \u51032  \u48372 \u54840 \u50640  \u51648 \u45208 \u52824 \u44172  \u51032 \u47280 \u54616 \u51648  \u47560 \u49901 \u49884 \u50724 . \u54616 \u50668 \u44036  \u49888 \u54617 \u48512 \u51032  \u44368 \u49324 \u46308 \u44284  \u45208 \u50640 \u44172  \u45572 \u44032  \u48120 \u52824 \u51648  \u50506 \u46020 \u47197  \u54644 \u51452 \u49901 \u49884 \u50724 \'94 (Wylie, b.13, ch.9).\
\uc0\u44536 \u47084 \u45208  \u50948 \u54744 \u51060  \u51613 \u44032 \u46112 \u49688 \u47197  \u48288 \u47476 \u52901 \u51032  \u50676 \u49900 \u51008  \u45908 \u50865  \u45908  \u44053 \u54644 \u51276 \u45796 . \u44536 \u45716  \u50640 \u46972 \u49828 \u47924 \u49828 \u51032  \u51221 \u52293 \u51201 \u51060 \u50836 , \u44592 \u54924 \u51452 \u51032 \u51201 \u51064  \u44428 \u44256 \u50640  \u48373 \u51333 \u54616 \u44592 \u45716 \u52964 \u45397  \u46020 \u47532 \u50612  \u54620 \u52789  \u45908  \u45824 \u45812 \u54620  \u49688 \u45800 \u51012  \u50416 \u44592 \u47196  \u44208 \u49900 \u54616 \u50688 \u45796 . \u44536 \u45716  \u51652 \u47532 \u47484  \u50745 \u54840 \u54624  \u49104 \u47564  \u50500 \u45768 \u46972  \u50724 \u47448 \u47484  \u44277 \u44201 \u54624  \u44163 \u51060 \u50632 \u45796 . \u44536 \u45716  \u47196 \u47560 \u44368 \u44032  \u51088 \u44592 \u50640 \u44172  \u50444 \u50864 \u44256 \u51088  \u54616 \u45716  \u51060 \u45800 \u51060 \u46972 \u45716  \u48708 \u45212 \u51012  \u46020 \u47532 \u50612  \u44536 \u46308 \u50640 \u44172  \u46028 \u47140 \u51452 \u44256 \u51088  \u54616 \u50688 \u45796 . \u44536 \u50640 \u44172  \u51080 \u50612 \u49436  \u44032 \u51109  \u51201 \u44537 \u51201 \u51060 \u50836 , \u47924 \u49436 \u50868  \u48152 \u45824 \u51088 \u45716  \u54028 \u47532  \u49884 \u50752  \u48520 \u46976 \u49436  \u51204 \u44397 \u51012  \u53685 \u54616 \u50668  \u51333 \u44368 \u49345  \u52572 \u44256 \u51032  \u44428 \u50948 \u47196  \u51064 \u51221 \u48155 \u44256  \u51080 \u45716  \u54028 \u47532  \u45824 \u54617  \u49888 \u54617 \u48512 \u51032  \u48149 \u49324 \u46308 \u44284  \u49849 \u47140 \u46308 \u51060 \u50632 \u45796 . \u44536 \u47088 \u45936  \u48288 \u47476 \u52901 \u51008  \u44536  \u48149 \u49324 \u46308 \u51032  \u51200 \u49436  \u51473 \u50640 \u49436  12\u44060 \u51032  \u51312 \u47785 \u51012  \u48977 \u50500 \u49436  \'93\u49457 \u44221 \u50640  \u50948 \u48176 \u46104 \u44256  \u51060 \u45800 \u51201 \u51064  \u44163 \'94\u51060 \u46972 \u44256  \u44277 \u44277 \u50672 \u54616 \u44172  \u51452 \u51109 \u54616 \u50688 \u45796 . \u44536 \u45716  \u50773 \u50640 \u44172  \u44536  \u45436 \u51137 \u51032  \u49900 \u54032 \u51088 \u44032  \u46104 \u50612  \u51452 \u44592 \u47484  \u54840 \u49548 \u54616 \u50688 \u45796 .\
