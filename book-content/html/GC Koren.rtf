\uc0\u44033  \u49884 \u45824 \u47484  \u53685 \u54616 \u50668  \u44396 \u51452 \u51032  \u53469 \u54616 \u49900 \u51012  \u48155 \u51008  \u49324 \u46988 \u46308 \u51008  \u49884 \u47144 \u51032  \u54617 \u44368 \u50640 \u49436  \u44368 \u50977 \u44284  \u54984 \u47144 \u51012  \u48155 \u50500  \u50772 \u45796 . \u44536 \u46308 \u51008  \u49464 \u49345 \u50640 \u49436  \u51329 \u51008  \u44600 \u51012  \u44152 \u50612 \u44032 \u44256 , \u44256 \u45212 \u51032  \u54400 \u47924 \u50640 \u49436  \u51221 \u44208 \u54632 \u51012  \u48155 \u50520 \u45796 . \u44536 \u46308 \u51008  \u50696 \u49688 \u45784 \u51012  \u50948 \u54616 \u50668  \u48152 \u45824 \u50752  \u51613 \u50724 \u50752  \u51473 \u49345 \u51012  \u44204 \u46356 \u50632 \u45796 . \u44536 \u46308 \u51008  \u44340 \u47196 \u50868  \u53804 \u51137 \u51012  \u53685 \u54616 \u50668  \u51452 \u45784 \u51012  \u46384 \u47476 \u44256 , \u44537 \u44592 \u54616 \u44256 , \u49892 \u47581 \u51032  \u50420 \u47579 \u51012  \u48372 \u50520 \u45796 . \u44536 \u46308 \u51008  \u44536 \u46308  \u51088 \u49888 \u46308 \u51032  \u44340 \u47196 \u50868  \u44221 \u54744 \u51012  \u53685 \u54616 \u50668  \u51396 \u51032  \u49324 \u50501 \u54632 , \u44536  \u45733 \u47141 , \u44536  \u54644 \u46021 , \u44536  \u52280 \u49345 \u51012  \u44648 \u45803 \u44256 , \u51396 \u47484  \u48120 \u50892 \u54616 \u44172  \u46108 \u45796 . \u47924 \u54620 \u54620  \u55148 \u49373 \u51004 \u47196  \u51396 \u50640 \u49436  \u52824 \u47308 \u48155 \u44172  \u46104 \u44256  \u44536 \u46308 \u51060  \u44216 \u49552 \u54644 \u51652  \u44163 \u51012  \u44648 \u45803 \u44256  \u44536 \u46308 \u51032  \u47560 \u51020 \u51008  \u53440 \u46973 \u54620  \u51068 \u51060  \u44208 \u53076  \u50630 \u45716  \u45796 \u47480  \u49464 \u44228 \u51032  \u44144 \u48124 \u46308 \u51060  \u47579 \u48380  \u49688  \u50630 \u45716  \u44048 \u49324 \u50752  \u52268 \u50577 \u51032  \u47560 \u51020 \u51004 \u47196  \u52649 \u47564 \u54644 \u51652 \u45796 . \u44536 \u46308 \u51008  \u50857 \u49436 \u47484  \u47566 \u51060  \u48155 \u50520 \u44592  \u46412 \u47928 \u50640  \u45908 \u50865  \u47566 \u51060  \u49324 \u46993 \u54620 \u45796 . \u44536 \u46308 \u51008  \u44536 \u47532 \u49828 \u46020 \u51032  \u44256 \u45212 \u50640  \u46041 \u52280 \u54616 \u50688 \u51004 \u48064 \u47196  \u51452 \u45784 \u44284  \u54632 \u44760  \u44536 \u48516 \u51032  \u50689 \u44305 \u50640  \u52280 \u50668 \u54616 \u44592 \u50640  \u54633 \u45817 \u54616 \u45796 .\
\uc0\u54616 \u45208 \u45784 \u51032  \u54980 \u49324 \u46308 \u51008  \u45796 \u46973 \u48169 , \u50724 \u47561 \u49332 \u51060 , \u44048 \u50725 , \u45800 \u46160 \u45824 , \u49328 , \u49324 \u47561 , \u51648 \u54616  \u46041 \u44404 , \u54644 \u51200  \u46041 \u44404  \u46321 \u50640 \u49436  \u45208 \u50728  \u51088 \u46308 \u51060 \u45796 . \u44536 \u46308 \u51008  \u46405 \u50640 \u49436  \'93\u44417 \u54605 \u44284  \u54872 \u45212 \u44284  \u54617 \u45824 \'94 \u47484  \u48155 \u51008  \u51088 \u46308 \u51060 \u45796 . \u49688 \u48177 \u47564  \u47749 \u51032  \u49324 \u46988 \u46308 \u51060  \u49324 \u45800 \u51032  \u44592 \u47564 \u51201  \u50836 \u44396 \u47484  \u44053 \u44221 \u55176  \u44144 \u51208 \u54632 \u51004 \u47196  \u45572 \u47749 \u51012  \u50416 \u44256  \u47924 \u45924 \u51004 \u47196  \u45236 \u47140 \u44052 \u45796 . \u44536 \u46308 \u51008  \u51064 \u44036  \u48277 \u51221 \u50640 \u49436  \u44032 \u51109  \u44537 \u50501 \u54620  \u51396 \u51064 \u51004 \u47196  \u54032 \u44208 \u51012  \u48155 \u50520 \u45796 . \u44536 \u47084 \u45208  \u51060 \u51228  \'93\u54616 \u45208 \u45784  \u44536 \u45716  \u49900 \u54032 \u51109 \'94 (\u49884  50:6) \u51060  \u46104 \u49888 \u45796 . \u51060 \u51228  \u49464 \u49345 \u51032  \u54032 \u44208 \u51060  \u46244 \u51665 \u54784 \u51652 \u45796 . \'93\u50668 \u54840 \u50752 \u44760 \u49436 \'85\u44536  \u48177 \u49457 \u51032  \u49688 \u52824 \u47484  \u50728  \u52380 \u54616 \u50640 \u49436  \u51228 \u54616 \u49884 \u47532 \u46972 \'94 (\u49324  25:8). \'93\u45320 \u47484  \u51068 \u52972 \u50612  \u44144 \u47337 \u54620  \u48177 \u49457 \u51060 \u46972  \u50668 \u54840 \u50752 \u51032  \u44396 \u49549 \u54616 \u49888  \u51088 \u46972  \u54616 \'94\u47532 \u46972 . \u51452 \u45784 \u44760 \u49436 \u45716  \u44536 \u46308 \u50640 \u44172  \'93\u54868 \u44288 \u51012  \u51452 \u50612  \u44536  \u51116 \u47484  \u45824 \u49888 \u54616 \u47728  \u55148 \u46973 \u51032  \u44592 \u47492 \u51004 \u47196  \u44536  \u49836 \u54548 \u51012  \u45824 \u49888 \u54616 \u47728  \u52268 \u49569 \u51032  \u50743 \u51004 \u47196  \u44536  \u44540 \u49900 \u51012  \u45824 \u49888 \u54616 \'94 (\u49324  62:12, 61:3) \u44172  \u54616 \u49888 \u45796 . \u44536 \u46308 \u51008  \u45908  \u51060 \u49345  \u54728 \u50557 \u54620  \u51088 , \u44256 \u53685 \u48155 \u45716  \u51088 , \u55145 \u50612 \u51652  \u51088 , \u50517 \u48149 \u48155 \u45716  \u51088 \u46308 \u51060  \u50500 \u45768 \u45796 . \u51060 \u51228 \u48512 \u53552  \u44536 \u46308 \u51008  \u50616 \u51228 \u45208  \u51452 \u45784 \u44284  \u54632 \u44760  \u51080 \u51012  \u44163 \u51060 \u45796 . \u44536 \u46308 \u51008  \u46405  \u50948 \u50640 \u49436  \u44032 \u51109  \u50689 \u44305 \u49828 \u47088  \u49324 \u46988 \u51060  \u51068 \u52237 \u51060  \u51077 \u50612 \u48376  \u50612 \u46500  \u51032 \u48373 \u48372 \u45796 \u46020  \u45908 \u50865  \u44480 \u54620  \u50743 \u51012  \u51077 \u44256  \u48372 \u51340  \u50526 \u50640  \u49440 \u45796 . \u44536 \u46308 \u51008  \u51648 \u49345 \u51032  \u50773 \u46308 \u51060  \u51648 \u44552 \u44751  \u50024  \u48376  \u50612 \u46500  \u50773 \u44288 \u48372 \u45796  \u45908 \u50865  \u50689 \u44305 \u49828 \u47088  \u47732 \u47448 \u44288 \u51012  \u50420 \u45796 . \u44256 \u53685 \u44284  \u50528 \u44257 \u51032  \u45216 \u51008  \u50689 \u50896 \u55176  \u45149 \u45228 \u45796 . \u50689 \u44305 \u51032  \u50773 \u44760 \u49436 \u45716  \u47784 \u46304  \u49324 \u46988 \u51032  \u50620 \u44404 \u50640 \u49436  \u45576 \u47932 \u51012  \u50491 \u44592 \u49884 \u44256 , \u47784 \u46304  \u49836 \u54548 \u51032  \u50896 \u51064 \u51012  \u51228 \u44144 \u54616 \u49512 \u45796 . \u44536 \u46308 \u51008  \u51333 \u47140 \u44032 \u51648 \u47484  \u55124 \u46308 \u47728  \u47749 \u46993 \u54616 \u44256  \u50500 \u47492 \u45813 \u44256  \u51312 \u54868 \u47196 \u50868  \u52268 \u50577 \u51032  \u45432 \u47000 \u47484  \u48512 \u47480 \u45796 . \u44536 \u46308 \u51008  \u47784 \u46160  \u49548 \u47532 \u47484  \u54633 \u54616 \u50668  \u52380 \u51648 \u44032  \u55124 \u46308 \u47540  \u47564 \u53372  \u45432 \u47000 \u47484  \u48512 \u47480 \u45796 . \'93\u44396 \u50896 \u54616 \u49900 \u51060  \u48372 \u51340 \u50640  \u50505 \u51004 \u49888  \u50864 \u47532  \u54616 \u45208 \u45784 \u44284  \u50612 \u47536 \u50577 \u50640 \u44172  \u51080 \u46020 \u45796 .\'94 \u44536 \u47084 \u51088  \u50728  \u54616 \u45720 \u51032  \u44144 \u48124 \u46308 \u51008  \u45796 \u51020 \u44284  \u44057 \u51008  \u52268 \u49569 \u51004 \u47196  \u54868 \u45813 \u54620 \u45796 . \'93\u50500 \u47704  \u52268 \u49569 \u44284  \u50689 \u44305 \u44284  \u51648 \u54812 \u50752  \u44048 \u49324 \u50752  \u51316 \u44480 \u50752  \u45733 \u47141 \u44284  \u55192 \u51060  \u50864 \u47532  \u54616 \u45208 \u45784 \u44760  \u49464 \u49464 \u53664 \u47197  \u51080 \u51012 \u51648 \u50612 \u45796  \u50500 \u47704 \'94 (\u44228  7:10, 12).\
\uc0\u50864 \u47532 \u45716  \u51060  \u49464 \u49345 \u50640 \u49436  \u45440 \u46972 \u50868  \u49549 \u51396  \u47928 \u51228 \u47484  \u44648 \u45803 \u44592  \u49884 \u51089 \u54624  \u49104 \u51060 \u45796 . \u50864 \u47532 \u45716  \u50864 \u47532 \u51032  \u50976 \u54620 \u54620  \u51060 \u54644 \u47141 \u51004 \u47196  \u52824 \u50837 \u44284  \u50689 \u44305 , \u49373 \u47749 \u44284  \u51453 \u51020 , \u49901 \u51088 \u44032 \u50640 \u49436  \u47564 \u45212  \u44277 \u51032 \u50752  \u51088 \u48708 \u47484  \u47588 \u50864  \u50676 \u47148 \u54616 \u44172  \u49689 \u44256 \u54624  \u49688  \u51080 \u45796 . \u44536 \u47084 \u45208  \u50864 \u47532 \u51032  \u51648 \u47141 \u51012  \u52572 \u45824 \u54620 \u51004 \u47196  \u48156 \u55064 \u54624 \u51648 \u46972 \u46020  \u50864 \u47532 \u45716  \u44536  \u51032 \u48120 \u47484  \u50756 \u51204 \u55176  \u54028 \u50501 \u54624  \u49688  \u50630 \u45796 . \u44396 \u49549 \u51032  \u49324 \u46993 \u51032  \u44600 \u51060 \u50752  \u45331 \u51060 , \u44618 \u51060 \u50752  \u45458 \u51060 \u45716  \u45796 \u47564  \u50612 \u47156 \u54411 \u54616 \u44172  \u51060 \u54644 \u46112  \u49104 \u51060 \u45796 . \u44396 \u49549 \u51032  \u44221 \u47452 \u51008  \u48708 \u47197  \u44396 \u49549 \u48155 \u51008  \u51088 \u46308 \u51060  \u51452 \u44760 \u49436  \u44536 \u46308 \u51012  \u48372 \u49884 \u45716  \u45824 \u47196  \u48372 \u44256 , \u50500 \u49884 \u45716  \u45824 \u47196  \u50508 \u44172  \u46112  \u46412 \u46020  \u50756 \u51204 \u55176  \u51060 \u54644 \u46112  \u49688  \u50630 \u45796 . \u44536 \u47084 \u45208  \u50689 \u50896 \u54620  \u49884 \u45824 \u47484  \u53685 \u54616 \u50668  \u49352 \u47196 \u50868  \u51652 \u47532 \u44032  \u44221 \u51060 \u50752  \u55148 \u50676 \u50640  \u45336 \u52824 \u45716  \u47560 \u51020 \u49549 \u50640  \u51204 \u44060 \u46112  \u44163 \u51060 \u45796 . \u48708 \u47197  \u46405  \u50948 \u51032  \u49836 \u54548 \u44284  \u44256 \u53685 \u44284  \u49884 \u47144 \u51060  \u44536 \u52824 \u44256  \u44536  \u50896 \u51064 \u51060  \u51228 \u44144 \u46104 \u50632 \u51012 \u51648 \u46972 \u46020  \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u46308 \u51008  \u44536 \u46308 \u51032  \u44396 \u50896 \u51012  \u50948 \u54616 \u50668  \u51648 \u48520 \u46108  \u45824 \u44032 \u47484  \u50616 \u51228 \u45208  \u48516 \u47749 \u54616 \u44256  \u54869 \u49892 \u54616 \u44172  \u50508 \u44172  \u46112  \u44163 \u51060 \u45796 .\
