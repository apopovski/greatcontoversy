\uc0\u48277 \u50773 \u44368 \u44032  \u51109 \u44592 \u44036 \u50640  \u44152 \u52432 \u49436  \u52572 \u49345 \u44428 \u51012  \u51105 \u44256  \u51080 \u45716  \u46041 \u50504  \u51060  \u49464 \u49345 \u51008  \u50516 \u55121 \u51004 \u47196  \u45934 \u50668  \u51080 \u50632 \u51648 \u47564 , \u51652 \u47532 \u51032  \u48731 \u51008  \u50500 \u51452  \u49548 \u47736 \u46104 \u51648  \u50500 \u45768 \u54616 \u50688 \u45796 . \u50612 \u45712  \u49884 \u45824 \u46304 \u51648  \u54616 \u45208 \u45784 \u51032  \u51613 \u51064 \u46308 , \u44263  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u54616 \u45208 \u45784 \u44284  \u49324 \u46988  \u49324 \u51060 \u51032  \u50976 \u51068 \u51032  \u51473 \u48372 \u51088 \u51060 \u49900 \u51012  \u54869 \u49892 \u55176  \u48127 \u44256 , \u49457 \u44221 \u51012  \u51064 \u49373 \u51032  \u50976 \u51068 \u54620  \u51648 \u52840 \u51004 \u47196  \u49340 \u44256 , \u52280  \u50504 \u49885 \u51068 \u51012  \u44144 \u47337 \u55176  \u44396 \u48324 \u54616 \u50668  \u51648 \u53412 \u45716  \u51613 \u51064 \u46308 \u51060  \u51080 \u50632 \u45796 . \u49464 \u49345 \u51060  \u44536 \u46308 \u50640 \u44172  \u50620 \u47560 \u47564 \u53372 \u51032  \u51008 \u54812 \u47484  \u51077 \u50632 \u45716 \u51648 \u50640  \u45824 \u54616 \u50668  \u54980 \u49464 \u51032  \u49324 \u46988 \u46308 \u51008  \u44208 \u53076  \u50508 \u51648  \u47803 \u54624  \u44163 \u51060 \u45796 . \u44536 \u46308 \u51008  \u51060 \u45800 \u51088 \u47196  \u45209 \u51064 \u51060  \u52237 \u55176 \u44256 , \u44536 \u46308 \u51032  \u46041 \u44592 \u45716  \u48708 \u45212 \u51012  \u48155 \u44256 , \u44536 \u46308 \u51032  \u54408 \u49457 \u51008  \u51473 \u49345 \u51012  \u48155 \u44256 , \u44536 \u46308 \u51032  \u51200 \u49436 \u46308 \u51008  \u50517 \u49688 \u45817 \u54616 \u44256  \u50724 \u51204  (\u35492 \u20659 ) \u46104 \u44256  \u49325 \u51228 \u45817 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u46308 \u51008  \u44403 \u44172  \u49436 \u49436  \u50724 \u45716  \u49464 \u45824 \u47484  \u50948 \u54620  \u49888 \u49457 \u54620  \u50976 \u50629 \u51004 \u47196 \u50024  \u44536 \u46308 \u51032  \u49692 \u44208 \u54620  \u48127 \u51020 \u51012  \u45824 \u45824 \u47196  \u47932 \u47140 \u44032 \u47728  \u44036 \u51649 \u54616 \u50688 \u45796 .\
\uc0\u47196 \u47560 \u44368 \u44032  \u52572 \u49345 \u44428 \u51012  \u51536 \u44256  \u51080 \u45912  \u50516 \u55121 \u49884 \u45824 \u50640  \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u51060  \u45817 \u54620  \u50669 \u49324 \u45716  \u47784 \u46160  \u54616 \u45720 \u50640  \u44592 \u47197 \u46104 \u50612  \u51080 \u51648 \u47564  \u49324 \u46988 \u51032  \u49552 \u51004 \u47196  \u44592 \u47197 \u46108  \u44163 \u51008  \u45320 \u47924 \u46020  \u51201 \u45796 . \u44536 \u46308 \u51012  \u48149 \u54644 \u54620  \u51088 \u46308 \u51032  \u48708 \u45212  \u51060 \u50808 \u50640 \u45716  \u44536  \u49324 \u51201 \u50640  \u45824 \u54616 \u50668  \u44592 \u47197 \u46108  \u44163 \u51060  \u50630 \u45796 . \u48277 \u50773 \u44368 \u51032  \u44368 \u47532 \u50752  \u47749 \u47161 \u50640  \u48152 \u45824 \u54616 \u45716  \u51088 \u46308 \u51032  \u55124 \u51201 \u44284  \u50689 \u54693 \u51012  \u50756 \u51204 \u55176  \u50630 \u50528 \u45716  \u44163 \u51060  \u47196 \u47560 \u44368 \u51032  \u51221 \u52293 \u51060 \u50632 \u45796 . \u47196 \u47560 \u44368 \u45716  \u51060 \u45800 \u51201 \u51064  \u44163 \u51008  \u49324 \u46988 \u51060 \u46304 \u51648  \u49436 \u51201 \u51060 \u46304 \u51648  \u44036 \u50640  \u48149 \u47736 \u54616 \u44256 \u51088  \u54616 \u50688 \u45796 . \u48277 \u50773 \u44368 \u51032  \u44368 \u47532 \u51032  \u44428 \u50948 \u50640  \u45824 \u54616 \u50668  \u51032 \u54841 \u51060 \u45208  \u51032 \u47928 \u51012  \u54408 \u45716  \u49324 \u46988 \u51008  \u48712 \u48512 \u44480 \u52380 \u51012  \u47561 \u47200 \u54616 \u44256  \u49373 \u47749 \u51012  \u48764 \u50519 \u44592 \u44592 \u50640  \u52649 \u48516 \u54620  \u51312 \u44148 \u51060 \u50632 \u45796 . \u47196 \u47560 \u44368 \u45716  \u46608 \u54620  \u44536 \u46308 \u51032  \u44368 \u54924 \u50640  \u48152 \u45824 \u54616 \u45716  \u49324 \u46988 \u46308 \u50640 \u44172  \u54665 \u54620  \u51092 \u51064 \u54620  \u54665 \u46041 \u50640  \u45824 \u54620  \u47784 \u46304  \u44