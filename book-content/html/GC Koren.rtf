\uc0\u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51008  \u49900 \u54032  \u46412 \u50640  \u49324 \u46988 \u51032  \u54408 \u49457 \u44284  \u49373 \u50528 \u47484  \u52769 \u51221 \u54616 \u45716  \u54364 \u51456 \u51060 \u45796 . \u54788 \u51064  \u49556 \u47196 \u47788 \u51008  \'93\u54616 \u45208 \u45784 \u51012  \u44221 \u50808 \u54616 \u44256  \u44536  \u47749 \u47161 \u51012  \u51648 \u53420 \u51648 \u50612 \u45796  \u51060 \u44163 \u51060  \u49324 \u46988 \u51032  \u48376 \u48516 \u51060 \u45768 \u46972  \u54616 \u45208 \u45784 \u51008  \u47784 \u46304  \u54665 \u50948 \u50752  \u47784 \u46304  \u51008 \u48128 \u54620  \u51068 \u51012  \u49440 \u50501  \u44036 \u50640  \u49900 \u54032 \u54616 \u49884 \u47532 \u46972 \'94 (\u51204  12:13, 14) \u44256  \u47568 \u54620 \u45796 . \u50556 \u44256 \u48372 \u45716  \u44536 \u51032  \u54805 \u51228 \u46308 \u50640 \u44172  \'93\u45320 \u55148 \u45716  \u51088 \u50976 \u51032  \u50984 \u48277 \u45824 \u47196  \u49900 \u54032 \u48155 \u51012  \u51088 \u52376 \u47100  \u47568 \u46020  \u54616 \u44256  \u54665 \u54616 \u44592 \u46020  \u54616 \u46972 \'94 (\u50557  2:12) \u44256  \u44428 \u47732 \u54620 \u45796 .\
\uc0\u49900 \u54032 \u50640 \u49436  \'93\u54633 \u45817 \u55176  \u50668 \u44608 \u51012  \u51077 \u51008 \'94 \u49324 \u46988 \u46308 \u51008  \u51032 \u51064 \u51032  \u48512 \u54876 \u50640  \u52280 \u50668 \u54624  \u44163 \u51060 \u45796 . \u50696 \u49688 \u45784 \u44760 \u49436 \u45716  \'93\u51200  \u49464 \u49345 \u44284  \u48143  \u51453 \u51008  \u51088  \u44032 \u50868 \u45936 \u49436  \u48512 \u54876 \u54632 \u51012  \u50619 \u44592 \u50640  \u54633 \u45817 \u55176  \u50668 \u44608 \u51012  \u51077 \u51008  \u51088 \u46308 \u51008 \'85\u52380 \u49324 \u50752  \u46041 \u46321 \u51060 \u50836  \u48512 \u54876 \u51032  \u51088 \u45376 \u47196 \u49436  \u54616 \u45208 \u45784 \u51032  \u51088 \u45376 \u51076 \u51060 \u45768 \u46972 \'94 (\u45573  20:35, 36) \u44256  \u47568 \u50432 \u54616 \u49512 \u45796 . \u44536 \u48516 \u44760 \u49436 \u45716  \u46608 \u54620  \'93\u49440 \u54620  \u51068 \u51012  \u54665 \u54620  \u51088 \u45716  \u49373 \u47749 \u51032  \u48512 \u54876 \u47196 \'85\u45208 \u50724 \u47532 \u46972 \'94 (\u50836  5:29) \u44256  \u47568 \u50432 \u54616 \u49888 \u45796 . \u44263  \u51453 \u51008  \u51032 \u51064 \u46308 \u51008  \u49900 \u54032  \u46412 \u50640  \u49373 \u47749 \u51032  \u48512 \u54876 \u50640  \u54633 \u45817 \u54620  \u51088 \u46972 \u45716  \u49440 \u44256 \u47484  \u48155 \u44256 \u49436 \u50556  \u48708 \u47196 \u49548  \u48512 \u54876 \u54616 \u44172  \u46112  \u44163 \u51060 \u45796 . \u44536 \u47084 \u48064 \u47196  \u44536 \u46308 \u51008  \u44536 \u46308 \u50640  \u45824 \u54620  \u44592 \u47197 \u51060  \u49900 \u54032 \u51221 \u50640  \u51228 \u52636 \u46104 \u50612  \u51312 \u49324 \u47484  \u48155 \u50500  \u44208 \u51221 \u46112  \u46412 \u50640  \u44060 \u51064 \u51201 \u51004 \u47196  \u44536  \u51088 \u47532 \u50640  \u52636 \u46160 \u54616 \u45716  \u44163 \u51060  \u50500 \u45768 \u45796 .\
\uc0\u50696 \u49688 \u45784 \u44760 \u49436 \u45716  \u51473 \u48372 \u51088 \u47196 \u49436  \u44536 \u46308 \u51012  \u50948 \u54616 \u50668  \u53444 \u50896 \u54616 \u44256 \u51088  \u54616 \u45208 \u45784  \u50526 \u50640  \u45208 \u53440 \u45208 \u49892  \u44163 \u51060 \u45796 . \'93\u47564 \u51068  \u45572 \u44032  \u51396 \u47484  \u48276 \u54616 \u47732  \u50500 \u48260 \u51648  \u50526 \u50640 \u49436  \u50864 \u47532 \u50640 \u44172  \u45824 \u50616 \u51088 \u44032  \u51080 \u51004 \u45768  \u44263  \u51032 \u47196 \u50864 \u49888  \u50696 \u49688  \u44536 \u47532 \u49828 \u46020 \u49884 \u46972 \'94 (\u50836 \u51068  2:1). \'93\u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u52280  \u44163 \u51032  \u44536 \u47548 \u51088 \u51064  \u49552 \u51004 \u47196  \u47564 \u46304  \u49457 \u49548 \u50640  \u46308 \u50612 \u44032 \u51648  \u50500 \u45768 \u54616 \u49884 \u44256  \u50724 \u51649  \u52280  \u54616 \u45720 \u50640  \u46308 \u50612 \u44032 \u49324  \u51060 \u51228  \u50864 \u47532 \u47484  \u50948 \u54616 \u50668  \u54616 \u45208 \u45784  \u50526 \u50640  \u45208 \u53440 \u45208 \u49884 \u44256 \'94, \'93\u51088 \u44592 \u47484  \u55192 \u51077 \u50612  \u54616 \u45208 \u45784 \u44760  \u45208 \u50500 \u44032 \u45716  \u51088 \u46308 \u51012  \u50728 \u51204 \u55176  \u44396 \u50896 \u54616 \u49892  \u49688  \u51080 \u51004 \u45768  \u51060 \u45716  \u44536 \u44032  \u54637 \u49345  \u49332 \u50500 \u49436  \u51200 \u55148 \u47484  \u50948 \u54616 \u50668  \u44036 \u44396 \u54616 \u49900 \u51060 \u45768 \u46972 \'94 (\u55176  9:24, 7:25).\
\uc0\u49900 \u54032  \u46412 \u50640  \u44592 \u47197 \u54620  \u52293 \u46308 \u51012  \u54204 \u52824 \u47732  \u50696 \u49688 \u45784 \u51012  \u48127 \u51008  \u47784 \u46304  \u49324 \u46988 \u46308 \u51032  \u49373 \u50528 \u44032  \u54616 \u45208 \u45784  \u50526 \u50640  \u45208 \u53440 \u45212 \u45796 . \u50864 \u47532 \u51032  \u45824 \u50616 \u51088 \u46104 \u49888  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u51060  \u49464 \u49345 \u50640  \u52376 \u51020  \u49373 \u51316 \u54620  \u49324 \u46988 \u46308 \u47196 \u48512 \u53552  \u49884 \u51089 \u54616 \u50668  \u51648 \u44552  \u49332 \u50500  \u51080 \u45716  \u49324 \u46988 \u46308 \u50640  \u51060 \u47476 \u44592 \u44620 \u51648  \u44033  \u49884 \u45824 \u51032  \u47784 \u46304  \u49324 \u46988 \u46308 \u51032  \u49324 \u44148 \u51012  \u51228 \u49884 \u54616 \u49888 \u45796 . \u44033  \u49324 \u46988 \u51032  \u51060 \u47492 \u51060  \u48520 \u47532 \u50892 \u51648 \u44256 , \u47784 \u46304  \u49324 \u44148 \u51060  \u49464 \u48128 \u55176  \u44160 \u53664 \u46108 \u45796 . \u50612 \u46500  \u51060 \u47492 \u46308 \u51008  \u44032 \u45225 \u46104 \u44256 , \u50612 \u46500  \u51060 \u47492 \u46308 \u51008  \u44144 \u51208 \u46108 \u45796 . \u45572 \u44396 \u46304 \u51648  \u54924 \u44060 \u54616 \u51648  \u50506 \u44256  \u50857 \u49436 \u48155 \u51648  \u47803 \u54620  \u52292  \u44592 \u47197 \u52293 \u50640  \u51396 \u47484  \u45224 \u44200 \u46160 \u44256  \u51080 \u51004 \u47732  \u44536 \u46308 \u51032  \u51060 \u47492 \u51008  \u49373 \u47749 \u52293 \u50640 \u49436  \u51648 \u50892 \u51648 \u44256  \u44536 \u46308 \u51032  \u49440 \u54665 \u51032  \u44592 \u47197 \u46020  \u54616 \u45208 \u45784 \u51032  \u44592 \u45392 \u52293 \u50640 \u49436  \u51648 \u50892 \u51656  \u44163 \u51060 \u45796 . \u50668 \u54840 \u50752 \u44760 \u49436 \u45716  \u47784 \u49464 \u50640 \u44172  \'93\u45572 \u44396 \u46304 \u51648  \u45236 \u44172  \u48276 \u51396 \u54616 \u47732  \u44536 \u45716  \u45236 \u44032  \u45236  \u52293 \u50640 \u49436  \u51648 \u50892 \u48260 \u47532 \u47532 \u46972 \'94 (\u52636  32:33) \u44256  \u49440 \u50616 \u54616 \u49512 \u45796 . \u49440 \u51648 \u51088  \u50640 \u49828 \u44180 \u51008  \'93\u47564 \u51068  \u51032 \u51064 \u51060  \u46028 \u51060 \u53020  \u44536  \u51032 \u50640 \u49436  \u46496 \u45208 \u49436  \u48276 \u51396 \u54616 \u47732 \'85\u44536  \u54665 \u54620  \u51032 \u47196 \u50868  \u51068 \u51008  \u54616 \u45208 \u46020  \u44592 \u50613 \u54632 \u51060  \u46104 \u51648  \u50500 \u45768 \u54616 \u47532 \'94 (\u44180  18:24) \u46972 \u44256  \u47568 \u54620 \u45796 .\
