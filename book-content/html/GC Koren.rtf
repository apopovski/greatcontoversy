\f1\b0 \cf0 \
\uc0\u44060 \u49888 \u44368 \u54924 \u46972 \u44256  \u51088 \u52845 \u54616 \u45716  \u44144 \u51032  \u47784 \u46304  \u44368 \u54924 \u50640 \u49436 \u46020  \u46609 \u44057 \u51008  \u44284 \u51221 \u51060  \u48152 \u48373 \u46104 \u44256  \u51080 \u51648  \u50506 \u45716 \u44032 ? \u51652 \u51221 \u54620  \u44060 \u54785  \u51221 \u49888 \u51012  \u44032 \u51276 \u45912  \u44060 \u49888 \u44368 \u51032  \u52285 \u49444 \u51088 \u46308 \u51060  \u51453 \u51008  \u54980 \u50640  \u44536  \u54980 \u44228 \u51088 \u46308 \u51060  \u45208 \u50752 \u49436  \'93\u44536  \u49324 \u50629 \u51012  \u49352  \u54805 \u53468 \u51032  \u44163 \u51004 \u47196  \u48148 \u44984 \u50612  \u48260 \u47160 \u45796 .\'94 \u44536 \u46308 \u51008  \u49440 \u51312 \u46308 \u51032  \u49888 \u51312 \u46308 \u51012  \u44256 \u51665 \u54616 \u47732 \u49436 \u46020  \u49892 \u49345 \u51008  \u44060 \u54785 \u51088 \u46308 \u51060  \u44648 \u45804 \u51008  \u51652 \u47532 \u50640 \u49436  \u51312 \u44552 \u46020  \u51652 \u48372 \u54616 \u51648  \u50500 \u45768 \u54616 \u44256 , \u50724 \u55176 \u47140  \u44536  \u49440 \u51312 \u46308 \u51060  \u45224 \u44596  \u44216 \u49552 , \u44537 \u44592 , \u49464 \u49345 \u51012  \u54252 \u44592 \u54616 \u45716  \u51068 \u50640  \u45824 \u54620  \u47784 \u48376 \u50640 \u49436 \u45716  \u47680 \u47532  \u46496 \u45208  \u51080 \u45796 . \u44536 \u47532 \u54616 \u50668  \'93\u52488 \u44592 \u51032  \u49692 \u49688 \u49457 \u51012  \u51075 \u50612 \u48260 \u47532 \'94\u44256  \u49464 \u49549 \u51201 \u51064  \u54861 \u49688 \u44032  \u48276 \u46988 \u54616 \u50668  \'93\u44536  \u49845 \u44288 , \u54665 \u46041 , \u50864 \u49345 \u51060  \u44368 \u54924  \u50504 \u51004 \u47196  \u46308 \u50612 \u50724 \u44172  \u46104 \u50632 \u45796 .\'94\
\'93\uc0\u54616 \u45208 \u45784 \u51032  \u50896 \u49688 \'94\u44032  \u46104 \u45716  \u49464 \u49345 \u44284  \u44368 \u51228 \u54616 \u45716  \u51221 \u49888 \u51060  \u50724 \u45720 \u45216  \u50620 \u47560 \u45208  \u45440 \u46972 \u50872  \u51221 \u46020 \u47196  \u44536 \u47532 \u49828 \u46020 \u47484  \u46384 \u47476 \u45716  \u51088 \u46308 \u47196  \u51088 \u52845 \u54616 \u45716  \u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u51012  \u52292 \u50864 \u44256  \u51080 \u45716 \u44032 ! \u44536 \u47532 \u49828 \u46020 \u44368 \u44397 \u51032  \u51068 \u48152  \u44368 \u54924 \u46308 \u51060  \u44216 \u49552 , \u44537 \u44592 , \u45800 \u49692 , \u44221 \u44148  \u46321 \u50640  \u45824 \u54620  \u49457 \u44221 \u49345  \u54364 \u51456 \u50640 \u49436  \u50620 \u47560 \u45208  \u47680 \u47532  \u46496 \u45208 \u44032  \u51080 \u45716 \u44032 ! \u51316  \u50920 \u49836 \u47532 \u45716  \u46024 \u51012  \u50732 \u48148 \u47476 \u44172  \u49324 \u50857 \u54624  \u44163 \u50640  \u45824 \u54616 \u50668  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u54616 \u50688 \u45796 . \'93\u51648 \u45208 \u52824 \u44172  \u44050 \u51060  \u48708 \u49916  \u51032 \u48373 \u51060 \u45208  \u50424 \u45936 \u50630 \u45716  \u51109 \u49888 \u44396  \u46321 \u51004 \u47196  \u45800 \u49692 \u55176  \u45576 \u51032  \u50837 \u47581 \u51012  \u47564 \u51313 \u49884 \u53412 \u44592  \u50948 \u54616 \u50668  \u47588 \u50864  \u44480 \u51473 \u54620  \u45804 \u46976 \u53944 \u51032  \u50612 \u46500  \u48512 \u48516 \u51060 \u46972 \u46020  \u45229 \u48708 \u54616 \u51648  \u47568 \u46972 . \u51088 \u44592 \u51032  \u51452 \u53469 \u46308 \u51012  \u52824 \u51109 \u54616 \u44592  \u50948 \u54616 \u50668  \u51648 \u45208 \u52824 \u44172  \u44050 \u51060  \u48708 \u49916  \u44032 \u44396 \u47484  \u49324 \u46308 \u51060 \u44144 \u45208  \u44256 \u44032 \u51032  \u49436 \u54868 \u47484  \u44152 \u44144 \u45208  \u46020 \u44552 \u54616 \u45716  \u51068  \u46321 \u50640  \u44552 \u51204 \u51032  \u51068 \u48512 \u47484  \u45229 \u48708 \u54616 \u51648  \u47568 \u46972 . \'85\u49324 \u46988 \u51032  \u51088 \u48512 \u49900 \u51012  \u47564 \u51313 \u49884 \u53412 \u44144 \u45208  \u49324 \u46988 \u46308 \u51032  \u52268 \u53444 \u51012  \u50619 \u44592  \u50948 \u54644 \u49436 \u45716  \u54620  \u54396 \u46020  \u50416 \u51648  \u47568  \u44163 \u51060 \u45796 . \'85\'91\u44536 \u45824 \u44032  \u51088 \u49888 \u51012  \u50948 \u54616 \u50668  \u51339 \u51008  \u51068 \u51012  \u54624  \u46412  \u49324 \u46988 \u46308 \u51008  \u51339 \u51008  \u49324 \u46988 \u51004 \u47196  \u47568 \u54624  \u44163 \u51060 \u45796 .\'92 \'91\u54861 \u54252 \u50752  \u44256 \u50868  \u48288 \u50743 \u51012  \u51077 \u44256  \u45216 \u47560 \u45796  \u54840 \u54868 \u47196 \u50868  \u49373 \u54876 \u51012  \u54616 \u45716 \'92 \u46041 \u50504  \u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u44536 \u45824 \u51032  \u52712 \u48120 \u44032  \u44256 \u49345 \u54616 \u44256  \u44536 \u45824 \u51032  \u54665 \u50948 \u44032  \u44288 \u45824 \u54616 \u44256  \u52828 \u51208 \u54616 \u45796 \u44256  \u52845 \u52268 \u54624  \u44163 \u51060  \u48516 \u47749 \u54616 \u45796 . \u44536 \u47084 \u45208  \u44536 \u47088  \u44050 \u48708 \u49916  \u52845 \u52268 \u51012  \u46024 \u51004 \u47196  \u49332  \u44163 \u51060  \u50500 \u45768 \u45796 . \u50724 \u55176 \u47140  \u54616 \u45208 \u45784 \u44760 \u47196 \u48512 \u53552  \u50724 \u45716  \u50689 \u44305 \u51004 \u47196  \u47564 \u51313 \u54624  \u44163 \u51060 \u45796 \'94 (Wesley, Works, Sermon 50). \u44536 \u47084 \u45208  \u50724 \u45720 \u45216  \u47566 \u51008  \u44368 \u54924 \u46308 \u51008  \u51060 \u47088  \u51333 \u47448 \u51032  \u44368 \u54984 \u51012  \u47924 \u49884 \u54616 \u44256  \u51080 \u45796 .\
\uc0\u49888 \u50521 \u51012  \u44256 \u48177 \u54616 \u45716  \u51068 \u51008  \u49464 \u49345 \u50640 \u49436  \u51064 \u44592 \u47484  \u50619 \u45716  \u51068 \u47196  \u48148 \u45068 \u50612 \u51276 \u45796 . \u50948 \u51221 \u51088 , \u51221 \u52824 \u44032 , \u48277 \u47456 \u44032 , \u54617 \u51088 , \u49892 \u50629 \u44032 \u46308 \u51008  \u49324 \u54924 \u51032  \u51316 \u44221 \u44284  \u49888 \u47280 \u47484  \u50619 \u44256  \u51088 \u44592 \u51032  \u49464 \u49549 \u51201  \u49324 \u50629 \u51032  \u48264 \u50689 \u51012  \u44928 \u54616 \u45716  \u54620  \u44032 \u51648  \u49688 \u45800 \u51004 \u47196  \u44368 \u54924 \u50640  \u46308 \u50612 \u50728 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u46308 \u51008  \u44536 \u47532 \u49828 \u46020 \u44368 \u47484  \u48127 \u45716 \u45796 \u45716  \u49888 \u50521 \u51012  \u44256 \u48177 \u54632 \u51004 \u47196  \u44536 \u46308 \u51032  \u48512 \u51221 \u54620  \u44144 \u47000 \u46308 \u51012  \u44032 \u47140  \u48260 \u47532 \u44256 \u51088  \u45432 \u47141 \u54620 \u45796 . \u49548 \u50948  \u49464 \u47168 \u47484  \u48155 \u51008  \u49549 \u51064 \u46308 \u51032  \u48512 \u47141  (\u23500 \u21147 ) \u44284  \u49464 \u47141 \u51032  \u54980 \u50896 \u51012  \u48155 \u45716  \u50668 \u47084  \u51333 \u44368  \u45800 \u52404 \u46308 \u51008  \u51064 \u44592 \u50752  \u54980 \u50896 \u51012  \u45908  \u47566 \u51060  \u50619 \u44256 \u51088  \u45432 \u47141 \u54620 \u45796 . \u44032 \u51109  \u49324 \u52824 \u54620  \u48169 \u48277 \u51004 \u47196  \u44984 \u47728 \u51652  \u54988 \u47469 \u54620  \u44368 \u54924 \u46308 \u51060  \u48264 \u54868 \u54620  \u53360  \u44600 \u44144 \u47532 \u50640  \u49464 \u50892 \u51652 \u45796 . \u50696 \u48176 \u51088 \u46308 \u51008  \u48708 \u49912 \u44256  \u50976 \u54665 \u50640  \u47582 \u45716  \u50743 \u51012  \u51077 \u44256  \u47784 \u50668 \u46304 \u45796 . \u49324 \u46988 \u46308 \u51012  \u51096  \u45796 \u47336 \u44256  \u51060 \u45124 \u45716  \u51116 \u44036  \u51080 \u45716  \u47785 \u49324 \u50640 \u44172 \u45716  \u45458 \u51008  \u50529 \u49688 \u51032  \u48393 \u44553 \u51060  \u51648 \u48520 \u46108 \u45796 . \u44536 \u51032  \u49444 \u44368 \u45716  \u48372 \u54200 \u54868 \u46108  \u51396 \u47484  \u51648 \u51201 \u54616 \u45716  \u44163 \u51060  \u50500 \u45768 \u46972  \u50976 \u54665 \u51012  \u46384 \u47476 \u45716  \u49324 \u46988 \u46308 \u51032  \u44480 \u47484  \u51600 \u44161 \u44172  \u54616 \u45716  \u44163 \u51060 \u50612 \u50556  \u54620 \u45796 . \u44536 \u47532 \u54616 \u50668  \u50976 \u54665 \u51012  \u46384 \u47476 \u45716  \u51396 \u51064 \u46308 \u51008  \u44368 \u54924 \u47749 \u48512 \u50640  \u46321 \u47197 \u46104 \u44256 , \u50976 \u54665 \u51012  \u46384 \u46972  \u49373 \u44592 \u45716  \u51396 \u46308 \u51008  \u48127 \u45716 \u45796 \u45716  \u44032 \u47732  \u50500 \u47000  \u44048 \u52628 \u50612 \u51652 \u45796 .\
\uc0\u49464 \u49345 \u51012  \u54693 \u54616 \u50668  \u44536 \u47532 \u49828 \u46020 \u51064 \u51060 \u46972 \u44256  \u51088 \u52845 \u54616 \u45716  \u51088 \u46308 \u51032  \u54788 \u49892 \u51201 \u51064  \u53468 \u46020 \u50640  \u45824 \u54616 \u50668  \u54620  \u50976 \u47141 \u54620  \u51105 \u51648 \u45716  \'93\u44368 \u54924 \u44032  \u50508 \u51648  \u47803 \u54616 \u45716  \u49324 \u51060 \u50640  \u49884 \u45824 \u51032  \u51221 \u49888 \u51012  \u46384 \u47476 \u44172  \u46104 \u44256 , \u44536  \u50696 \u48176  \u54805 \u49885 \u46020  \u49884 \u45824 \u51032  \u50836 \u44396 \u50640  \u49692 \u51025 \u54616 \u44172  \u46104 \u50632 \u45796 \'94\u44256  \u45436 \u54217 \u54616 \u44256  \u51080 \u45796 . \u46608 \u54620  \'93\u44368 \u54924 \u45716  \u51333 \u44368 \u47484  \u47588 \u47141  \u51080 \u44172  \u47564 \u46300 \u45716  \u44163 \u51060 \u47732  \u47924 \u50631 \u51060 \u46304 \u51648  \u51060 \u51228 \u45716  \u44536  \u48169 \u54200 \u51004 \u47196  \u49324 \u50857 \u54616 \u44256  \u51080 \u45796 \'94\u44256  \u47568 \u54620 \u45796 . \u45684 \u50837 \u51032  \u51064 \u46356 \u54172 \u45912 \u53944 \u51648 \u51032  \u54620  \u44592 \u51088 \u45716  \u44048 \u47532 \u44368 \u54924 \u50640  \u45824 \u54616 \u50668  \u50500 \u47000 \u50752  \u44057 \u51060  \u47568 \u54616 \u50688 \u45796 . \'93\u44221 \u44148 \u54620  \u51088 \u50752  \u48520 \u44221 \u44148 \u54620  \u51088 \u47484  \u45208 \u45572 \u45716  \u44221 \u44228 \u49440 \u51008  \u47560 \u52824  \u44536 \u47548 \u51088  \u49549 \u50640  \u46308 \u50612 \u44036  \u44163 \u52376 \u47100  \u50528 \u47588 \u54616 \u47728  \u50577 \u54200 \u51032  \u50676 \u49457 \u51088 \u46308 \u51008  \u44033 \u44033  \u51088 \u44592 \u46308 \u51032  \u54665 \u50948 \u50752  \u54693 \u46973 \u51032  \u49345 \u53468 \u50640  \u51316 \u51116 \u54616 \u45716  \u50728 \u44054  \u52264 \u51060 \u51216 \u51012  \u50630 \u50528 \u47140 \u44256  \u45432 \u47141 \u54616 \u44256  \u51080 \u45796 .\'94 \'93\u51333 \u44368 \u51032  \u51068 \u48152 \u54868 \u45716  \u51333 \u44368 \u51201  \u51032 \u47924 \u45716  \u51060 \u54665 \u54616 \u51648  \u50500 \u45768 \u54616 \u44256  \u44536  \u51060 \u51061 \u47564  \u52628 \u44396 \u54616 \u45716  \u51088 \u46308 \u51032  \u49688 \u54952 \u47484  \u45908 \u50865  \u51613 \u44032 \u49884 \u53040 \u45796 .\'94\
