\uc0\u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u47568 \u50432 \u51012  \u53685 \u54616 \u50668  \u44536  \u47568 \u50432 \u51032  \u44144 \u47337 \u54620  \u53945 \u49457 \u50640  \u45824 \u54620  \u52649 \u48516 \u54620  \u51613 \u44144 \u47484  \u51452 \u49512 \u45796 . \u50864 \u47532 \u51032  \u44396 \u50896 \u50640  \u44288 \u54620  \u50948 \u45824 \u54620  \u51652 \u47532 \u45716  \u48157 \u55176  \u51228 \u49884 \u46104 \u50612  \u51080 \u45796 . \u51652 \u51221 \u51004 \u47196  \u44396 \u54616 \u45716  \u47784 \u46304  \u49324 \u46988 \u50640 \u44172  \u51452 \u49884 \u44592 \u47196  \u50557 \u49549 \u46104 \u50612  \u51080 \u45716  \u49457 \u47161 \u51032  \u46020 \u50864 \u49900 \u51004 \u47196  \u44033  \u49324 \u46988 \u51008  \u49828 \u49828 \u47196  \u44536  \u51652 \u47532 \u47484  \u44648 \u45804 \u51012  \u49688 \u44032  \u51080 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u51064 \u47448 \u50640 \u44172  \u44536 \u46308 \u51032  \u49888 \u50521 \u51032  \u53552 \u44032  \u46112  \u54869 \u44256 \u54620  \u44592 \u52488 \u47484  \u51452 \u49512 \u45796 .\
