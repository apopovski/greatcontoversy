\f0\b \cf0 \uc0\u46160  \u44032 \u51648  \u49324 \u47581 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u50500 \u45812 \u51060  \u48276 \u51396 \u54632 \u51004 \u47196  \u49324 \u47581 \u51060  \u50728  \u51064 \u47448 \u50640 \u44172  \u51060 \u47476 \u47104 \u45796 . \u47784 \u46304  \u49324 \u46988 \u51008  \u48736 \u51664 \u50630 \u51060  \u47924 \u45924 \u51004 \u47196  \u45236 \u47140 \u44036 \u45796 . \u44536 \u47084 \u45208  \u44396 \u50896 \u51032  \u44228 \u54925 \u51004 \u47196  \u47784 \u46304  \u49324 \u46988 \u51008  \u44536 \u46308 \u51032  \u47924 \u45924 \u50640 \u49436  \u45208 \u50724 \u44172  \u46104 \u50612  \u51080 \u45796 . \'93\u51032 \u51064 \u44284  \u50501 \u51064 \u51032  \u48512 \u54876 \u51060  \u51080 \u51004 \u47532 \u46972 \'94 (\u54665  24:15). \'93\u50500 \u45812  \u50504 \u50640 \u49436  \u47784 \u46304  \u49324 \u46988 \u51060  \u51453 \u51008  \u44163 \u44057 \u51060  \u44536 \u47532 \u49828 \u46020  \u50504 \u50640 \u49436  \u47784 \u46304  \u49324 \u46988 \u51060  \u49334 \u51012  \u50619 \u51004 \u47532 \u46972 \'94 (\u44256 \u51204  15:22). \u44536 \u47084 \u45208  \u51060 \u47111 \u44172  \u48512 \u54876 \u54616 \u45716  \u51088 \u46308  \u51473 \u50640 \u45716  \u46748 \u47159 \u51060  \u44396 \u48324 \u46104 \u45716  \u46160  \u48512 \u47448 \u44032  \u51080 \u45796 . \'93\u47924 \u45924  \u49549 \u50640  \u51080 \u45716  \u51088 \u44032  \u45796  \u44536 \u51032  \u51020 \u49457 \u51012  \u46308 \u51012  \u46412 \u44032  \u50724 \u45208 \u45768  \u49440 \u54620  \u51068 \u51012  \u54665 \u54620  \u51088 \u45716  \u49373 \u47749 \u51032  \u48512 \u54876 \u47196  \u50501 \u54620  \u51068 \u51012  \u54665 \u54620  \u51088 \u45716  \u49900 \u54032 \u51032  \u48512 \u54876 \u47196  \u45208 \u50724 \u47532 \u46972 \'94 (\u50836  5:28, 29). \u49373 \u47749 \u51032  \u48512 \u54876 \u51012  \u50619 \u44592 \u50640  \'93\u54633 \u45817 \u55176  \u50668 \u44608 \u51012  \u51077 \u51008  \u51088 \u46308 \'94\u51008  \'93\u48373 \u51060  \u51080 \u44256  \u44144 \u47337 \u54616 \u46020 \u45796 \'94, \'93\u46168 \u51704  \u49324 \u47581 \u51060  \u44536 \u46308 \u51012  \u45796 \u49828 \u47532 \u45716  \u44428 \u49464 \u44032  \u50630 \'94 (\u44228  20:6) \u45796 . \u44536 \u47084 \u45208  \u54924 \u44060 \u50752  \u48127 \u51020 \u51004 \u47196  \u51396 \u51032  \u50857 \u49436 \u47484  \u48155 \u51648  \u47803 \u54620  \u51088 \u46308 \u51008  \u48276 \u51396 \u51032  \u54805 \u48268 , \u44263  \'93\u51396 \u51032  \u49327 \'94\u51012  \u48155 \u50500 \u50556  \u54620 \u45796 . \u44536 \u46308 \u51008  \'93\u51088 \u44592  \u54665 \u50948 \u47484  \u46384 \u46972 \'94 \u54805 \u48268 \u51012  \u48155 \u46104 , \u44536  \u44592 \u44036 \u44284  \u51221 \u46020 \u45716  \u45796 \u47476 \u45208  \u52572 \u51333 \u51201 \u51004 \u47196  \u46168 \u51704  \u49324 \u47581 \u51012  \u45817 \u54616 \u44172  \u46108 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436  \u45817 \u49888 \u51032  \u44277 \u51032 \u50752  \u51088 \u48708 \u50640  \u47784 \u49692 \u46104 \u46020 \u47197  \u51396 \u51064 \u51012  \u51396  \u51080 \u45716  \u44536 \u45824 \u47196  \u44396 \u50896 \u54616 \u49892  \u49688  \u50630 \u44592  \u46412 \u47928 \u50640  \u51396 \u51064 \u51060  \u51396 \u47484  \u48276 \u54632 \u51004 \u47196  \u49828 \u49828 \u47196  \u44036 \u51649 \u54624  \u51088 \u44201 \u51060  \u50630 \u51020 \u51012  \u51077 \u51613 \u54620  \u44536  \u49373 \u47749 \u51012  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u44536 \u50640 \u44172 \u49436  \u52712 \u54616 \u49888 \u45796 . \u54620  \u50689 \u44048 \u51032  \u44592 \u51088 \u45716  \'93\u51104 \u49884  \u54980 \u50640  \u50501 \u51064 \u51060  \u50630 \u50612 \u51648 \u47532 \u45768  \u45348 \u44032  \u44536  \u44275 \u51012  \u51088 \u49464 \u55176  \u49332 \u54596 \u51648 \u46972 \u46020  \u50630 \u51004 \u47532 \u47196 \u45796 \'94 (\u49884  37:10) \u44256  \u47568 \u54620 \u45796 . \u46608 \u54620  \u49324 \u46988 \u51008  \'93\u48376 \u47000  \u50630 \u45912  \u44163 \u44057 \u51060  \u46104 \u47532 \u46972 \'94 (\u50853  1:16). \u44536 \u46308 \u51008  \u50724 \u47749  (\u27738 \u21517 ) \u51004 \u47196  \u45934 \u51064  \u52292  \u49548 \u47581  \u50630 \u45716  \u50689 \u50896 \u54620  \u47736 \u47581 \u51004 \u47196  \u48736 \u51256 \u46308 \u50612  \u44036 \u45796 .\
\uc0\u51060 \u47532 \u54616 \u50668  \u51396 \u50752  \u44536  \u44208 \u44284 \u47196  \u52488 \u47000 \u46108  \u48520 \u54665 \u44284  \u54028 \u47736 \u51008  \u47784 \u46160  \u51333 \u49885 \u46108 \u45796 . \u49884 \u54200  \u44592 \u51088 \u45716  \'93\u50501 \u51064 \u51012  \u47736 \u54616 \u49884 \u47728  \u51200 \u55148  \u51060 \u47492 \u51012  \u50689 \u50689 \u55176  \u46020 \u47568 \u54616 \u49512 \u45208 \u51060 \u45796  \u50896 \u49688 \u44032  \u45130 \u50612 \u51256  \u50689 \u50689 \u55176  \u47736 \u47581 \u54616 \u50688 \'85\u45208 \u51060 \u45796 \'94 (\u49884  9:5, 6) \u44256  \u47568 \u54620 \u45796 . \u50836 \u54620 \u51008  \u44228 \u49884 \u47484  \u53685 \u54616 \u50668  \u50689 \u50896 \u54620  \u45208 \u46972 \u47484  \u48148 \u46972 \u48372 \u44256  \u51312 \u44552 \u46020  \u51020 \u51312 \u44032  \u53952 \u47532 \u51648  \u50506 \u45716  \u50756 \u51204 \u55176  \u51312 \u54868 \u46108  \u54988 \u47469 \u54620  \u52268 \u50577 \u51032  \u45432 \u47000 \u47484  \u46307 \u45716 \u45796 . \u44536 \u45716  \u54616 \u45720 \u44284  \u46405 \u50640  \u51080 \u45716  \u47784 \u46304  \u54588 \u51312 \u47932 \u46308 \u51060  \u54616 \u45208 \u45784 \u44760  \u50689 \u44305 \u51012  \u46028 \u47532 \u45716  \u52268 \u50577 \u51012  \u46308 \u50632 \u45796  (\u44228  5:13 \u52280 \u51312 ). \u44144 \u44592 \u50640 \u45716  \u51075 \u50612 \u48260 \u47536  \u49324 \u46988 \u46308 \u51060  \u50689 \u50896 \u54620  \u44256 \u53685  \u51473 \u50640  \u47800 \u48512 \u47548 \u52824 \u47732 \u49436  \u54616 \u45208 \u45784 \u44760  \u52280 \u46988 \u46108  \u47568 \u51012  \u54616 \u45716  \u51068 \u51060  \u44208 \u53076  \u50630 \u51012  \u44163 \u51060 \u45796 . \u44144 \u44592 \u50640 \u45716  \u44396 \u50896  \u50619 \u51008  \u51088 \u51032  \u52268 \u48120  \u49548 \u47532 \u50752  \u54632 \u44760  \u51648 \u50725 \u50640  \u51080 \u45716  \u48520 \u49933 \u54620  \u49324 \u46988 \u46308 \u51060  \u48512 \u47476 \u51670 \u45716  \u49548 \u47532 \u44032  \u54844 \u54633 \u46104 \u50612  \u46308 \u47140 \u50724 \u51648  \u50506 \u51012  \u44163 \u51060 \u45796 .\
\pard\pardeftab720\sa319\partightenfactor0

\f0\b \cf0 \uc0\u51453 \u51008  \u54980 \u51032  \u49345 \u53468 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u50689 \u54844  \u48520 \u47736 \u49444 \u51032  \u44540 \u48376 \u51201  \u50724 \u47448 \u45716  \u51453 \u51008  \u54980 \u50640  \u51032 \u49885 \u51060  \u51080 \u45796 \u45716  \u44368 \u47532 \u50640  \u44536  \u44592 \u52488 \u47484  \u46160 \u44256  \u51080 \u45796 . \u51060  \u44368 \u47532 \u45716  \u50689 \u50896  \u51648 \u50725 \u50640  \u44288 \u54620  \u44368 \u47532 \u50752  \u47560 \u52268 \u44032 \u51648 \u47196  \u49457 \u44221 \u51032  \u44032 \u47476 \u52840 \u44284  \u48152 \u45824 \u46104 \u47728  \u51064 \u44036 \u51032  \u51060 \u49457 \u44284  \u44048 \u51221 \u50640 \u46020  \u48152 \u45824 \u46108 \u45796 . \u51068 \u48152 \u51201  \u49888 \u50521 \u50640  \u51032 \u54616 \u47732  \u44396 \u49549 \u54632 \u51012  \u48155 \u50500  \u54616 \u45720 \u50640  \u51080 \u45716  \u51088 \u46308 \u51008  \u51648 \u49345 \u50640 \u49436  \u51060 \u47336 \u50612 \u51648 \u45716  \u47784 \u46304  \u51068 , \u53945 \u48324 \u55176  \u44536 \u46308 \u51060  \u45224 \u44200  \u46160 \u44256  \u44036  \u52828 \u44396 \u46308 \u51032  \u49373 \u50528 \u47484  \u51096  \u50504 \u45796 \u45716  \u44163 \u51060 \u45796 . \u44536 \u47084 \u45208  \u51453 \u51008  \u51088 \u44032  \u49328  \u51088 \u44032  \u45817 \u54616 \u45716  \u50612 \u47140 \u50880 \u51012  \u50500 \u45716  \u44163 , \u44536 \u51032  \u49324 \u46993 \u54616 \u45716  \u51088 \u44032  \u51396 \u47484  \u48276 \u54616 \u45716  \u44163 \u51012  \u48372 \u45716  \u44163 \u44284 , \u44536 \u46308 \u51060  \u45817 \u54616 \u45716  \u49373 \u50528 \u51032  \u47784 \u46304  \u49836 \u54548 , \u49892 \u47581 , \u44256 \u53685  \u46321 \u51012  \u48372 \u45716  \u44163 \u51060  \u50612 \u52236  \u54665 \u48373 \u51060  \u46112  \u49688  \u51080 \u44192 \u45716 \u44032 ? \u51648 \u49345 \u50640  \u51080 \u45716  \u44536 \u46308 \u51032  \u52828 \u44396 \u46308  \u50948 \u47484  \u48176 \u54924 \u54616 \u45716  \u51088 \u46308 \u51060  \u45572 \u47532 \u45716  \u54616 \u45720 \u51032  \u52629 \u48373 \u51060  \u50612 \u45712  \u51221 \u46020 \u47196  \u51600 \u44144 \u50880 \u51060  \u46104 \u44192 \u45716 \u44032 ? \u54924 \u44060 \u54616 \u51648  \u50506 \u51008  \u51088 \u51032  \u50689 \u54844 \u51008  \u44536  \u49704 \u51060  \u45130 \u50612 \u51648 \u51088 \u47560 \u51088  \u51648 \u50725 \u48520 \u50640  \u45912 \u51664 \u51012  \u48155 \u45716 \u45796 \u45716  \u48127 \u51020 \u51008  \u50620 \u47560 \u45208  \u50669 \u44200 \u50868  \u44163 \u51064 \u44032 ? \u44536 \u46308 \u51032  \u52828 \u44396 \u46308 \u51060  \u51456 \u48708 \u46104 \u51648  \u47803 \u54620  \u52292  \u51453 \u50612 \u49436  \u50689 \u50896 \u55176  \u51396 \u50752  \u51200 \u51452 \u47484  \u48155 \u45716  \u51648 \u50725 \u51004 \u47196  \u44032 \u45716  \u44163 \u51012  \u48376 \u45796 \u45716  \u44163 \u51008  \u50620 \u47560 \u45208  \u44256 \u53685 \u49828 \u47084 \u50868  \u51068 \u51060  \u46112  \u44163 \u51064 \u44032 ! \u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u51060 \u52376 \u47100  \u47924 \u49436 \u50868  \u49373 \u44033 \u51004 \u47196  \u48156 \u44305 \u54616 \u45716  \u51648 \u44221 \u50640  \u51060 \u47476 \u47104 \u45796 .\
\uc0\u49457 \u44221 \u51008  \u51060 \u50640  \u45824 \u54616 \u50668  \u47924 \u50631 \u51060 \u46972 \u44256  \u47568 \u54616 \u45716 \u44032 ? \u45796 \u50967 \u51008  \u49324 \u46988 \u51060  \u51453 \u51004 \u47732  \u51032 \u49885 \u51060  \u50630 \u45796 \u44256  \u47568 \u54620 \u45796 . \'93\u44536  \u54840 \u55137 \u51060  \u45130 \u50612 \u51648 \u47732  \u55129 \u51004 \u47196  \u46028 \u50500 \u44032 \u49436  \u45817 \u51068 \u50640  \u44536  \u46020 \u47784 \u44032  \u49548 \u47736 \u54616 \u47532 \u47196 \u45796  (\u49884  146:4). \u49556 \u47196 \u47788  \u50669 \u49884  \u46609 \u44057 \u51008  \u51613 \u50616 \u51012  \u54620 \u45796 . \'93\u47924 \u47495  \u49328  \u51088 \u45716  \u51453 \u51012  \u51460 \u51012  \u50508 \u46104  \u51453 \u51008  \u51088 \u45716  \u50500 \u47924 \u44163 \u46020  \u47784 \u47476 \u47728 \'94, \'93\u44536  \u49324 \u46993 \u54632 \u44284  \u48120 \u50892 \u54632 \u44284  \u49884 \u44592 \u54632 \u51060  \u50630 \u50612 \u51652  \u51648  \u50724 \u47000 \u45768  \u54644  \u50500 \u47000 \u49436  \u54665 \u54616 \u45716  \u47784 \u46304  \u51068 \u50640  \u51200 \u55148 \u44032  \u45796 \u49884 \u45716  \u50689 \u50689 \u55176  \u48516 \u48373 \u51060  \u50630 \u45712 \u45768 \u46972  \u45348 \u44032  \u51109 \u52264  \u46308 \u50612 \u44040  \u51020 \u48512 \u50640 \u45716  \u51068 \u46020  \u50630 \u44256  \u44228 \u54925 \u46020  \u50630 \u44256  \u51648 \u49885 \u46020  \u50630 \u44256  \u51648 \u54812 \u46020  \u50630 \u51020 \u51060 \u45768 \u46972 \'94 (\u51204  9:5, 6, 10).\
\uc0\u55176 \u49828 \u44592 \u50556 \u50773 \u51060  \u54616 \u45208 \u45784 \u44760  \u44592 \u46020 \u54620  \u44208 \u44284  \u44536 \u51032  \u49373 \u47749 \u51060  15\u45380 \u44036  \u45908  \u50672 \u51109 \u46104 \u47532 \u46972 \u45716  \u51025 \u45813 \u51012  \u48155 \u50520 \u51012  \u46412 , \u50773 \u51008  \u44048 \u49324 \u54620  \u47560 \u51020 \u51060  \u52649 \u47564 \u54616 \u50668  \u54616 \u45208 \u45784 \u51032  \u51088 \u48708 \u47484  \u52268 \u50577 \u54616 \u50688 \u45796 . \u44536  \u45432 \u47000 \u50640 \u49436  \u44536 \u45716  \u44536 \u44032  \u44592 \u48848 \u54616 \u45716  \u51060 \u50976 \u47484  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u54620 \u45796 . \'93\u51020 \u48512 \u44032  \u51452 \u44760  \u49324 \u47168 \u54616 \u51648  \u47803 \u54616 \u47728  \u49324 \u47581 \u51060  \u51452 \u47484  \u52268 \u50577 \u54616 \u51648  \u47803 \u54616 \u47728  \u44396 \u45929 \u51060 \u50640  \u46308 \u50612 \u44036  \u51088 \u44032  \u51452 \u51032  \u49888 \u49892 \u51012  \u48148 \u46972 \u51648  \u47803 \u54616 \u46104  \u50724 \u51649  \u49328  \u51088 , \u44263  \u49328  \u51088 \u45716  \u50724 \u45720 \u45216  \u45236 \u44032  \u54616 \u45716  \u44163 \u44284  \u44057 \u51060  \u51452 \u44760  \u44048 \u49324 \'85\u54616 \u47532 \u51060 \u45796 \'94 (\u49324  38:18, 19). \u49464 \u49345 \u50640  \u48372 \u54200 \u51201 \u51004 \u47196  \u48155 \u50500 \u46308 \u50668 \u51648 \u44256  \u51080 \u45716  \u49888 \u54617 \u51008  \u51453 \u51008  \u51032 \u51064 \u51060  \u54616 \u45720 \u50640 \u49436  \u50689 \u50896 \u54620  \u48373 \u46973 \u50640  \u46308 \u50612 \u44032  \u48520 \u47736 \u51032  \u54784 \u47196  \u54616 \u45208 \u45784 \u51012  \u52268 \u50577 \u54620 \u45796 \u44256  \u54620 \u45796 . \u44536 \u47084 \u45208  \u55176 \u49828 \u44592 \u50556 \u45716  \u51453 \u51020  \u44032 \u50868 \u45936 \u49436  \u44536 \u50752  \u44057 \u51008  \u50689 \u44305 \u49828 \u47084 \u50868  \u49548 \u47581 \u51012  \u48148 \u46980  \u49688  \u50630 \u50632 \u45796 . \u44536 \u51032  \u47568 \u51008  \u49884 \u54200  \u44592 \u51088 \u51032  \u47568 \u44284  \u51068 \u52824 \u54620 \u45796 . \'93\u49324 \u47581  \u51473 \u50640 \u49436 \u45716  \u51452 \u47484  \u44592 \u50613 \u54632 \u51060  \u50630 \u49324 \u50724 \u45768  \u51020 \u48512 \u50640 \u49436  \u51452 \u44760  \u44048 \u49324 \u54624  \u51088  \u45572 \u44396 \u47532 \u51060 \u44620 \'94 (\u49884  6:5), \'93\u51453 \u51008  \u51088 \u44032  \u50668 \u54840 \u50752 \u47484  \u52268 \u50577 \u54616 \u51648  \u47803 \u54616 \u45208 \u45768  \u51201 \u47561 \u54620  \u45936  \u45236 \u47140 \u44032 \u45716  \u50500 \u47924 \u46020  \u47803 \u54616 \u47532 \u47196 \u45796 \'94 (\u49884  115:17).\
\uc0\u50724 \u49692 \u51208 \u50640  \u48288 \u46300 \u47196 \u45716  \u48512 \u51312  \u45796 \u50967 \u51060  \'93\u51453 \u50612  \u51109 \u49324 \u46104 \u50612  \u44536  \u47896 \u44032  \u50724 \u45720 \u44620 \u51648  \u50864 \u47532  \u51473 \u50640  \u51080 \u46020 \u45796 \'94 (\u54665  2:29). \'93\u45796 \u50967 \u51008  \u54616 \u45720 \u50640  \u50732 \u46972 \u44032 \u51648  \u47803 \u54616 \u50688 \'94 (\u54665  2:34) \u45796 \u44256  \u51452 \u51109 \u54664 \u45796 . \u45796 \u50967 \u51060  \u48512 \u54876 \u54624  \u46412 \u44620 \u51648  \u44536  \u47924 \u45924 \u50640  \u47672 \u47932 \u47084  \u51080 \u45796 \u45716  \u49324 \u49892 \u51008  \u51032 \u51064 \u51060  \u51453 \u51012  \u46412  \u49849 \u52380 \u54616 \u45716  \u44163 \u51060  \u50500 \u45784 \u51012  \u51613 \u44144 \u54620 \u45796 . \u45796 \u50967 \u51060  \u47560 \u52840 \u45236  \u54616 \u45208 \u45784 \u51032  \u50724 \u47480 \u54200 \u50640  \u50505 \u44172  \u46104 \u45716  \u44163 \u51008  \u45796 \u47564  \u48512 \u54876 \u51012  \u53685 \u54616 \u50668 , \u44536 \u47532 \u44256  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u48512 \u54876 \u54616 \u49888  \u49324 \u49892 \u51012  \u55192 \u51077 \u50612  \u49457 \u52712 \u46108 \u45796 .\
\uc0\u44536 \u47532 \u44256  \u48148 \u50872 \u51008  \'93\u47564 \u51068  \u51453 \u51008  \u51088 \u44032  \u45796 \u49884  \u49324 \u45716  \u44163 \u51060  \u50630 \u51004 \u47732  \u44536 \u47532 \u49828 \u46020 \u46020  \u45796 \u49884  \u49324 \u49888  \u44163 \u51060  \u50630 \u50632 \u51012  \u53552 \u51060 \u50836  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u45796 \u49884  \u49324 \u49888  \u44163 \u51060  \u50630 \u51004 \u47732  \u45320 \u55148 \u51032  \u48127 \u51020 \u46020  \u54747 \u46104 \u44256  \u45320 \u55148 \u44032  \u50668 \u51204 \u55176  \u51396  \u44032 \u50868 \u45936  \u51080 \u51012  \u44163 \u51060 \u50836  \u46608 \u54620  \u44536 \u47532 \u49828 \u46020  \u50504 \u50640 \u49436  \u51104 \u51088 \u45716  \u51088 \u46020  \u47581 \u54616 \u50688 \u51004 \u47532 \'94 (\u44256 \u51204  15:16~18) \u46972 \u44256  \u47568 \u54616 \u50688 \u45796 . \u47564 \u51068  4\u52380  \u45380  \u46041 \u50504  \u51032 \u51064 \u51060  \u51453 \u51012  \u46412 \u50640  \u51593 \u49884  \u49849 \u52380 \u54616 \u50688 \u51012  \u44163  \u44057 \u51004 \u47732 , \u48148 \u50872 \u51060  \u50612 \u46523 \u44172  \u48512 \u54876 \u51060  \u50630 \u51004 \u47732  \'93\u44536 \u47532 \u49828 \u46020  \u50504 \u50640 \u49436  \u51104 \u51088 \u45716  \u51088 \u46020  \u47581 \u54616 \u50688 \u51004 \u47532 \'94\u46972 \u44256  \u47568 \u54624  \u49688  \u51080 \u50632 \u44192 \u45716 \u44032 ? \u47564 \u51068  \u44536 \u47111 \u45796 \u47732  \u48512 \u54876 \u51008  \u51204 \u54784  \u54596 \u50836  \u50630 \u51012  \u44163 \u51060 \u45796 .\
