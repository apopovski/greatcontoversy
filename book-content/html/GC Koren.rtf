\f1\b0 \cf0 \
\uc0\u44144 \u51032  6\u52380  \u45380 \u44036 \u50640  \u44152 \u52432  \u44228 \u49549 \u46104 \u50612  \u50728  \u44536 \u47532 \u49828 \u46020 \u50752  \u49324 \u45800  \u49324 \u51060 \u51032  \u45824 \u51137 \u53804 \u45716  \u48120 \u44396 \u50640  \u45149 \u45208 \u44172  \u46108 \u45796 . \u44536 \u47084 \u48064 \u47196  \u50501 \u54620  \u51088 \u45716  \u51064 \u47448 \u47484  \u50948 \u54620  \u44536 \u47532 \u49828 \u46020 \u51032  \u49324 \u50629 \u51012  \u49892 \u54056 \u47196  \u46028 \u50500 \u44032 \u44172  \u54616 \u44256  \u49324 \u46988 \u46308 \u51012  \u44536 \u51032  \u49324 \u49836 \u50640  \u44403 \u44172  \u47588 \u50612  \u46160 \u44592  \u50948 \u54616 \u50668  \u45432 \u47141 \u51012  \u48176 \u44032 \u54616 \u44256  \u51080 \u45796 . \u44396 \u51452 \u51032  \u51473 \u48372  \u49324 \u50629 \u51060  \u45149 \u45208 \u44256  \u51396 \u47484  \u50948 \u54620  \u55148 \u49373  \u51228 \u47932 \u51060  \u45908  \u51060 \u49345  \u54952 \u47141 \u51012  \u45208 \u53440 \u45236 \u51648  \u50506 \u44172  \u46112  \u46412 \u44620 \u51648  \u49324 \u46988 \u46308 \u51012  \u50516 \u55121 \u44284  \u50756 \u44256 \u54620  \u49345 \u53468 \u50640  \u48537 \u46308 \u50612  \u46160 \u45716  \u44163 \u51060  \u44536 \u44032  \u51060 \u47336 \u44256 \u51088  \u54616 \u45716  \u47785 \u51201 \u51060 \u45796 .\
\uc0\u49324 \u45800 \u51008  \u51088 \u44592 \u51032  \u44428 \u49464 \u47484  \u44144 \u51208 \u54616 \u44592  \u50948 \u54620  \u53945 \u48324 \u54620  \u45432 \u47141 \u51060  \u50630 \u51012  \u46412 , \u49464 \u49345 \u44284  \u44368 \u54924 \u50640  \u45257 \u45812 \u54620  \u49345 \u53468 \u44032  \u54077 \u48176 \u54644  \u51080 \u51012  \u46412  \u48324 \u48152  \u51452 \u51032 \u54616 \u51648  \u50506 \u45716 \u45796 . \u50780 \u45264 \u54616 \u47732  \u44536 \u46308 \u51060  \u44536 \u50752  \u44057 \u51008  \u49345 \u53468 \u50640  \u51080 \u51012  \u46412 \u50640 \u45716  \u44536 \u46308 \u51012  \u51088 \u44592  \u49552 \u50640 \u49436  \u51075 \u50612 \u48260 \u47540  \u50684 \u47140 \u44032  \u50630 \u44592  \u46412 \u47928 \u51060 \u45796 . \u44536 \u47084 \u45208  \u49324 \u46988 \u51032  \u47560 \u51020 \u51060  \u50689 \u50896 \u54620  \u49324 \u47932 \u51012  \u49373 \u44033 \u54616 \u44256  \'93\u45236 \u44032  \u50612 \u46523 \u44172  \u54616 \u50668 \u50556  \u44396 \u50896 \u51012  \u50619 \u51004 \u47532 \u51060 \u44620 \'94\u46972 \u44256  \u48512 \u47476 \u51670 \u51012  \u46412 \u50640 \u45716  \u49324 \u45800 \u51060  \u48268 \u50024  \u50752 \u49436  \u44536 \u47532 \u49828 \u46020 \u51032  \u44428 \u49464 \u50752  \u45796 \u53804 \u44256  \u49457 \u47161 \u51032  \u44048 \u54868 \u47484  \u49548 \u47736 \u49884 \u53412 \u44256 \u51088  \u45432 \u47141 \u54620 \u45796 .\
\uc0\u49457 \u44221 \u51008  \u50612 \u46500  \u45216  \u54616 \u45208 \u45784 \u51032  \u50500 \u46308 \u46308 \u51060  \u50668 \u54840 \u50752  \u50526 \u50640  \u49456 \u45716 \u45936  \u49324 \u45800 \u46020  \u44536  \u44032 \u50868 \u45936  \u50752 \u49436  \u52280 \u49437 \u54664 \u45796 \u44256  \u47568 \u54620 \u45796  (\u50853  1:6 \u52280 \u51312 ). \u49324 \u45800 \u51008  \u50689 \u50896 \u54616 \u49888  \u50773  \u50526 \u50640  \u44221 \u48176 \u54616 \u44592  \u50948 \u54644 \u49436 \u44032  \u50500 \u45768 \u44256 , \u51032 \u47196 \u50868  \u51088 \u46308 \u50640  \u45824 \u54616 \u50668  \u51088 \u49888 \u51032  \u50501 \u54620  \u49696 \u52293 \u51012  \u50416 \u44592  \u50948 \u54644 \u49436  \u52280 \u49437 \u54664 \u45796 . \u49324 \u45800 \u51008  \u46609 \u44057 \u51008  \u47785 \u51201 \u51004 \u47196  \u49324 \u46988 \u46308 \u51060  \u54616 \u45208 \u45784 \u51012  \u44221 \u48176 \u54616 \u44592  \u50948 \u54616 \u50668  \u47784 \u51060 \u45716  \u44275 \u50640  \u52280 \u49437 \u54620 \u45796 . \u48708 \u47197  \u49324 \u46988 \u51032  \u45576 \u50640 \u45716  \u48372 \u51060 \u51648  \u50506 \u51012 \u51648 \u46972 \u46020  \u44536 \u45716  \u50696 \u48176 \u50640  \u52280 \u49437 \u54620  \u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u51012  \u51648 \u48176 \u54616 \u44592  \u50948 \u54616 \u50668  \u45130 \u51076 \u50630 \u51060  \u45432 \u47141 \u54620 \u45796 . \u44536 \u45716  \u45432 \u47144 \u54620  \u51109 \u44400 \u52376 \u47100  \u48120 \u47532  \u44228 \u54925 \u51012  \u49464 \u50868 \u45796 . \u54616 \u45208 \u45784 \u51032  \u51333 \u46308 \u51060  \u49457 \u44221 \u51012  \u49345 \u44256 \u54624  \u46412  \u44536 \u45716  \u49324 \u46988 \u46308  \u50526 \u50640  \u51228 \u49884 \u46112  \u47928 \u51228 \u50640  \u44288 \u54616 \u50668  \u51452 \u47785 \u54620 \u45796 . \u44536 \u47084 \u44256 \u45716  \u44536 \u44032  \u49549 \u51060 \u44256  \u51080 \u45716  \u51088 \u46308 \u51060  \u54616 \u45208 \u45784 \u51032  \u44592 \u48324 \u51012  \u46307 \u51648  \u47803 \u54624  \u54872 \u44221 \u51012  \u47564 \u46308 \u44256 \u51088  \u50728 \u44054  \u44228 \u52293 \u44284  \u49688 \u45800 \u51012  \u50420 \u45796 . \u44221 \u44256 \u44032  \u44032 \u51109  \u54596 \u50836 \u54620  \u51088 \u45716  \u44845  \u52280 \u49437 \u54644 \u50556  \u54624  \u50612 \u46500  \u51473 \u45824 \u54620  \u51068 \u51012  \u48372 \u46020 \u47197  \u47564 \u46308 \u44256  \u46608 \u54620  \u44536  \u51060 \u50808 \u51032  \u50612 \u46500  \u48169 \u48277 \u51004 \u47196  \u49373 \u47749 \u50640 \u49436  \u49373 \u47749 \u50640  \u51060 \u47476 \u45716  \u54693 \u44592 \u44032  \u46112  \u47568 \u50432 \u51012  \u46307 \u51648  \u47803 \u54616 \u44172  \u47564 \u46304 \u45796 .\
\uc0\u49324 \u45800 \u51008  \u45796 \u49884  \u54616 \u45208 \u45784 \u51032  \u51333 \u46308 \u51060  \u50689 \u51201  \u50516 \u55121 \u50640  \u49912 \u50668  \u51080 \u45716  \u49324 \u46988 \u46308  \u46412 \u47928 \u50640  \u47588 \u50864  \u44540 \u49900 \u54616 \u45716  \u44163 \u51012  \u48376 \u45796 . \u44536 \u45716  \u45257 \u45812 \u44284  \u48512 \u51452 \u51032 \u50752  \u53468 \u47564 \u51032  \u44208 \u48149 \u51012  \u54400 \u50612  \u51460  \u54616 \u45208 \u45784 \u51032  \u51008 \u54812 \u50752  \u45733 \u47141 \u51012  \u45804 \u46972 \u44256  \u44536 \u46308 \u51060  \u50676 \u47148 \u54616 \u44172  \u44592 \u46020 \u54616 \u45716  \u49548 \u47532 \u47484  \u46307 \u45716 \u45796 . \u44536 \u47084 \u47732  \u44536 \u45716  \u45908 \u50865  \u49352 \u47196 \u50868  \u50676 \u49457 \u51004 \u47196  \u51088 \u49888 \u51032  \u49696 \u52293 \u51012  \u51201 \u50857 \u54620 \u45796 . \u49324 \u45800 \u51008  \u49324 \u46988 \u46308 \u51060  \u49885 \u50837 \u44284  \u44536 \u48150 \u50640  \u51088 \u47564 \u51032  \u49345 \u53468 \u50640 \u49436  \u48169 \u51333 \u54616 \u46020 \u47197  \u50976 \u54841 \u54620 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u45716  \u44536 \u46308 \u51032  \u51648 \u44033 \u51012  \u47560 \u48708 \u49884 \u53020  \u44536 \u46308 \u51060  \u48152 \u46300 \u49884  \u48176 \u50892 \u50556  \u54624  \u48148 \u47196  \u44536  \u49324 \u49892 \u51012  \u46307 \u51648  \u47803 \u54616 \u44172  \u54620 \u45796 .\
\uc0\u49324 \u45800 \u51008  \u44536 \u44032  \u49457 \u44221  \u50672 \u44396 \u47484  \u44172 \u51012 \u47532  \u54616 \u44256  \u44592 \u46020 \u47484  \u46321 \u54620 \u55176  \u54616 \u46020 \u47197  \u50976 \u54841 \u54624  \u49688  \u51080 \u45716  \u51088 \u45716  \u47784 \u46160  \u51088 \u44592 \u51032  \u44277 \u44201 \u51004 \u47196  \u51221 \u48373 \u54624  \u49688  \u51080 \u45796 \u45716  \u44163 \u51012  \u51096  \u50504 \u45796 . \u44536 \u47084 \u48064 \u47196  \u44536 \u45716  \u49324 \u46988 \u51032  \u47560 \u51020 \u51012  \u48764 \u50519 \u44592  \u50948 \u54616 \u50668  \u50728 \u44054  \u49696 \u52293 \u51012  \u45796  \u50420 \u45796 . \u44221 \u44148 \u54620  \u52404 \u54616 \u47732 \u49436  \u51652 \u47532 \u47484  \u50508 \u44256 \u51088  \u54616 \u51648  \u50506 \u44256  \u51088 \u44592 \u50752  \u51032 \u44204 \u51060  \u47582 \u51648  \u50506 \u45716  \u49324 \u46988 \u51032  \u54408 \u49457 \u51032  \u44208 \u54632 \u51060 \u45208  \u48127 \u51020 \u51032  \u51096 \u47803 \u51012  \u52286 \u50500 \u45236 \u45716  \u44163 \u51012  \u48127 \u51020 \u51064  \u44163 \u52376 \u47100  \u49373 \u44033 \u54616 \u45716  \u48512 \u47448 \u51032  \u49324 \u46988 \u46308 \u51060  \u50616 \u51228 \u45208  \u51316 \u51116 \u54644  \u50772 \u45796 . \u44536 \u47088  \u51088 \u46308 \u51008  \u49324 \u45800 \u51032  \u50724 \u47480 \u54036 \u50640  \u54644 \u45817 \u46104 \u45716  \u51312 \u49688 \u46308 \u51060 \u45796 . \u54805 \u51228 \u46308 \u51012  \u52280 \u49548 \u54616 \u45716  \u51088 \u46308 \u51060  \u51201 \u51648  \u50506 \u45796 . \u44536 \u46308 \u51008  \u54616 \u45208 \u45784 \u44760 \u49436  \u51068 \u54616 \u49892  \u46412 , \u54616 \u45208 \u45784 \u51032  \u51333 \u46308 \u51060  \u44536 \u48516 \u50640 \u44172  \u51652 \u51221 \u54620  \u44221 \u48176 \u47484  \u46300 \u47540  \u46412  \u50616 \u51228 \u45208  \u51201 \u44537 \u51201 \u51004 \u47196  \u54876 \u46041 \u54620 \u45796 . \u44536 \u46308 \u51008  \u51652 \u47532 \u