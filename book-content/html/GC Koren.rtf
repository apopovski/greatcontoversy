\uc0\u44536 \u47084 \u45208  \u50500 \u47924 \u46020  \u44536 \u46308 \u50640 \u44172  \u49549 \u51012  \u54596 \u50836 \u45716  \u50630 \u45796 . \u44536 \u46308 \u51060  \u45572 \u44396 \u51032  \u51088 \u49885 \u51060 \u47728  \u45572 \u44396 \u51032  \u48376 \u51012  \u46384 \u47476 \u44256  \u51080 \u51004 \u47728  \u45572 \u44396 \u51032  \u51068 \u51012  \u54616 \u44256  \u51080 \u45716 \u51648  \u49789 \u44172  \u50508 \u44172  \u46112  \u44163 \u51060 \u45796 . \'93\u44536 \u51032  \u50676 \u47588 \u47196  \u44536 \u46308 \u51012  \u50508 \u51648 \u45768 \'94 (\u47560  7:16) \u46972 . \u44536 \u46308 \u51032  \u54665 \u46041 \u51008  \u50501 \u46021 \u54620  \u47924 \u44256 \u51088  (\u35491 \u21578 \u32773 ), \'93\u54805 \u51228 \u46308 \u51012  \u52280 \u49548 \u54616 \u45912  \u51088 \'94 (\u44228  12:10) \u51064  \u49324 \u45800 \u51032  \u54665 \u46041 \u44284  \u50976 \u49324 \u54616 \u45796 .\
\uc0\u45824 \u44592 \u47564 \u51088 \u45716  \u49324 \u46988 \u46308 \u51012  \u54632 \u51221 \u50640  \u48736 \u46888 \u47532 \u44592  \u50948 \u54616 \u50668  \u50668 \u47084  \u44032 \u51648  \u50724 \u47448 , \u44263  \u44536 \u44032  \u47736 \u54616 \u44256 \u51088  \u54616 \u45716  \u49324 \u46988 \u46308 \u51032  \u52712 \u48120 \u50752  \u51201 \u49457 \u50640  \u47582 \u46020 \u47197  \u51456 \u48708 \u54620  \u50668 \u47084  \u44032 \u51648  \u51060 \u45800 \u49444 \u51012  \u51204 \u54616 \u45716  \u47566 \u51008  \u48512 \u54616 \u46308 \u51012  \u44032 \u51648 \u44256  \u51080 \u45796 . \u49324 \u45800 \u51008  \u44368 \u54924  \u50504 \u50640  \u48520 \u49457 \u49892 \u54616 \u44256  \u44144 \u46317 \u45208 \u51648  \u50506 \u51008  \u51088 \u46308 \u51012  \u46308 \u50668 \u48372 \u45236 \u50612  \u44536 \u46308 \u50640 \u44172  \u51032 \u49900 \u44284  \u48520 \u49888 \u51012  \u44428 \u50976 \u54616 \u45716  \u54620 \u54200 , \u54616 \u45208 \u45784 \u51032  \u49324 \u50629 \u51060  \u48156 \u51204 \u46104 \u44592 \u47484  \u50896 \u54616 \u47728  \u44536  \u49324 \u50629 \u44284  \u54632 \u44760  \u51204 \u51652 \u54616 \u44256 \u51088  \u54616 \u45716  \u51088 \u46308 \u51012  \u48169 \u54644 \u54616 \u44592  \u50948 \u54620  \u44228 \u54925 \u51012  \u49464 \u50864 \u44256  \u51080 \u45796 . \u54616 \u45208 \u45784 \u44284  \u44536 \u48516 \u51032  \u47568 \u50432 \u51012  \u48127 \u45716  \u51652 \u49892 \u54620  \u48127 \u51020 \u51012  \u44032 \u51648 \u44256  \u51080 \u51648  \u50506 \u45716  \u47566 \u51008  \u49324 \u46988 \u46308 \u51060  \u51652 \u47532 \u51032  \u50612 \u46500  \u50896 \u52825 \u46308 \u47564  \u49884 \u51064 \u54616 \u47732 \u49436  \u44536 \u47532 \u49828 \u46020 \u51064 \u51004 \u47196  \u51064 \u51221 \u46104 \u44256  \u51080 \u45716 \u45936  \u44536 \u46308 \u51008  \u51088 \u49888 \u46308 \u51032  \u44536 \u47495 \u46108  \u49373 \u44033 \u51012  \u49457 \u44221 \u51032  \u44368 \u47532 \u52376 \u47100  \u49548 \u4