\uc0\u50864 \u47532  \u50526 \u50640  \u51080 \u45716  \u44256 \u45212 \u44284  \u44256 \u53685 \u51032  \u49884 \u44592 \u45716  \u50864 \u47532 \u50640 \u44172  \u54588 \u47196 \u50752  \u51648 \u50672  (\u36978 \u24310 ) \u44284  \u51452 \u47548 \u50640  \u44204 \u46364  \u49688  \u51080 \u45716  \u48127 \u51020 , \u44263  \u44201 \u47148 \u54616 \u44172  \u49884 \u47144 \u51012  \u48155 \u51012 \u51648 \u46972 \u46020  \u49632 \u50557 \u54644 \u51648 \u51648  \u50500 \u45768 \u54624  \u48127 \u51020 \u51060  \u54596 \u50836 \u54616 \u45796 . \u44536 \u46412 \u47484  \u50948 \u54616 \u50668  \u51456 \u48708 \u54624  \u49688  \u51080 \u45716  \u51008 \u54812 \u51032  \u49884 \u44592 \u44032  \u47784 \u46304  \u49324 \u46988 \u46308 \u50640 \u44172  \u51452 \u50612 \u51256  \u51080 \u45796 . \u50556 \u44273 \u51008  \u45128 \u44592  \u51080 \u44256  \u54869 \u44256 \u54616 \u50688 \u44592  \u46412 \u47928 \u50640  \u49849 \u47532 \u54616 \u50688 \u45796 . \u44536 \u51032  \u49849 \u47532 \u45716  \u51460 \u44592 \u52268  \u44592 \u46020 \u51032  \u45733 \u47141 \u51060  \u50612 \u46500  \u44163 \u51076 \u51012  \u48372 \u50668  \u51452 \u45716  \u54616 \u45208 \u51032  \u49892 \u51613 \u51060 \u45796 . \u50556 \u44273 \u52376 \u47100  \u54616 \u45208 \u45784 \u51032  \u50557 \u49549 \u51012  \u44403 \u44172  \u51105 \u44256  \u50676 \u47148 \u54616 \u44256  \u44984 \u51456 \u54616 \u44172  \u45208 \u50500 \u44032 \u45716  \u47784 \u46304  \u49324 \u46988 \u51008  \u44536 \u44032  \u49457 \u44277 \u54620  \u44163 \u52376 \u47100  \u49457 \u44277 \u54624  \u44163 \u51060 \u45796 . \u51088 \u50500 \u47484  \u44592 \u44732 \u51060  \u48512 \u51064 \u54616 \u51648  \u50506 \u44256 , \u54616 \u45208 \u45784  \u50526 \u50640 \u49436  \u44256 \u48124 \u54616 \u47728  \u54616 \u45208 \u45784 \u51032  \u52629 \u48373 \u51012  \u48155 \u44256 \u51088  \u44984 \u51456 \u54616 \u44256  \u50676 \u47148 \u54616 \u44172  \u44592 \u46020 \u54616 \u44592 \u47484  \u50896 \u52824  \u50506 \u45716  \u51088 \u46308 \u51008  \u44536 \u44163 \u51012  \u50619 \u51648  \u47803 \u54624  \u44163 \u51060 \u45796 . \u54616 \u45208 \u45784 \u44284  \u44592 \u46020 \u47196  \u50472 \u47492 \u54616 \u45716  \u44163 \u51060  \u47924 \u50631 \u51076 \u51012  \u44648 \u45803 \u44256  \u51080 \u45716  \u51088 \u46308 \u51060  \u50620 \u47560 \u45208  \u51201 \u51008 \u44032 ! \u47784 \u46304  \u55192 \u51060  \u45796 \u54624  \u46412 \u44620 \u51648  \u44053 \u47148 \u54620  \u50676 \u47581 \u51012  \u44032 \u51648 \u44256  \u50728  \u49900 \u47161 \u51012  \u45796  \u44592 \u50872 \u50668  \u54616 \u45208 \u45784 \u51012  \u52286 \u45716  \u51088 \u46308 \u51060  \u50620 \u47560 \u45208  \u51201 \u51008 \u44032 . \u47568 \u47196  \u54364 \u54788 \u54624  \u49688  \u50630 \u45716  \u51208 \u47581 \u51032  \u47932 \u44208 \u51060  \u44036 \u44396 \u54616 \u45716  \u51088 \u46308  \u50948 \u50640  \u48128 \u47140 \u50732  \u46412  \u54869 \u44256 \u54620  \u48127 \u51020 \u51004 \u47196  \u54616 \u45208 \u45784 \u51032  \u50557 \u49549 \u51012  \u44403 \u44172  \u48537 \u51105 \u45716  \u51088 \u46308 \u51060  \u50612 \u52236  \u44536 \u47532  \u51201 \u51008 \u44032 !\
\uc0\u50724 \u45720 \u45216  \u48127 \u51020 \u51012  \u51312 \u44552 \u48150 \u50640  \u54876 \u50857 \u54616 \u51648  \u50506 \u45716  \u51088 \u46308 \u51008  \u49324 \u45800 \u51032  \u44592 \u47564 \u51201  \u44428 \u49464 \u50752  \u50577 \u49900 \u51012  \u50613 \u50517 \u54616 \u45716  \u48277 \u47161 \u50640  \u44404 \u48373 \u46112  \u50948 \u54744 \u51060  \u44032 \u51109  \u53356 \u45796 . \u48708 \u47197  \u44536 \u46308 \u51060  \u44536  \u49884 \u47144 \u51012  \u44204 \u46356 \u50612  \u45244 \u51648 \u46972 \u46020  \u44536 \u46308 \u51008  \u54872 \u45212 \u51032  \u46412 \u50640  \u45908 \u50865  \u49900 \u54620  \u45212 \u44288 \u44284  \u44256 \u53685  \u49549 \u50640  \u48736 \u51648 \u44172  \u46112  \u44163 \u51060 \u45796 . \u50780 \u45264 \u54616 \u47732  \u44536 \u46308 \u51008  \u54217 \u49548 \u50640  \u54616 \u45208 \u45784 \u51012  \u49888 \u47280 \u54616 \u45716  \u49845 \u44288 \u51012  \u44592 \u47476 \u51648  \u50500 \u45768 \u54616 \u50688 \u44592  \u46412 \u47928 \u51060 \u45796 . \u44536 \u46308 \u51008  \u44536 \u46308 \u51060  \u46321 \u54620 \u55176  \u54620  \u48127 \u51020 \u51032  \u44368 \u54984 \u51012  \u47924 \u49436 \u50868  \u51208 \u47581  \u44032 \u50868 \u45936 \u49436  \u48176 \u50864 \u51648  \u50506 \u51004 \u47732  \u50504  \u46112  \u44163 \u51060 \u45796 .\
\uc0\u50864 \u47532 \u45716  \u50724 \u45720 \u45216  \u51452 \u45784 \u51032  \u50557 \u49549 \u51012  \u49892 \u51613 \u54632 \u51004 \u47196 \u50024  \u54616 \u45208 \u45784 \u44284  \u52828 \u49689 \u54644 \u51256 \u50556  \u54620 \u45796 . \u52380 \u49324 \u46308 \u51008  \u50676 \u47148 \u54616 \u44256  \u51652 \u49892 \u54620  \u47784 \u46304  \u44592 \u46020 \u47484  \u44592 \u47197 \u54620 \u45796 . \u50864 \u47532 \u45716  \u54616 \u45208 \u45784 \u44284  \u45208 \u45572 \u45716  \u44368 \u53685 \u51012  \u46321 \u54620 \u55176  \u54616 \u44592 \u48372 \u45796  \u52264 \u46972 \u47532  \u51060 \u44592 \u51201  \u47564 \u51313 \u51012  \u48260 \u47140 \u50556  \u54620 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436  \u51064 \u51221 \u54616 \u49884 \u45716  \u44537 \u49900 \u54620  \u48712 \u44417 \u44284  \u44032 \u51109  \u53360  \u44537 \u44592 \u45716  \u44536 \u48516 \u44760 \u49436  \u51064 \u51221 \u54616 \u51648  \u50506 \u51004 \u49884 \u45716  \u48512 \u44480 \u50752  \u47749 \u50696 \u50752  \u50504 \u51068 \u44284  \u50864 \u51221 \u48372 \u45796  \u45908  \u45227 \u45796 . \u50864 \u47532 \u45716  \u44592 \u46020 \u54616 \u45716  \u49884 \u44036 \u51012  \u44032 \u51256 \u50556  \u54624  \u44163 \u51060 \u45796 . \u47564 \u51068  \u50864 \u47532 \u44032  \u49464 \u49345 \u51068 \u50640  \u47792 \u46160 \u45817 \u54616 \u46020 \u47197  \u50864 \u47532 \u51032  \u47560 \u51020 \u51012  \u54728 \u50857 \u54616 \u47732  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u50864 \u47532 \u51032  \u50864 \u49345 \u51060  \u46104 \u50612  \u51080 \u45716  \u51116 \u49328 \u44284  \u44032 \u50725 \u44284  \u48708 \u50725 \u54620  \u53664 \u51648 \u47484  \u50864 \u47532 \u50640 \u44172 \u49436  \u48764 \u50519 \u50500  \u44032 \u49900 \u51004 \u47196 \u50024  \u50864 \u47532 \u50640 \u44172  \u44592 \u46020 \u54624  \u49884 \u44036 \u51012  \u51452 \u49892 \u51648 \u46020  \u47784 \u47480 \u45796 .\
\uc0\u51210 \u51008 \u51060 \u46308 \u51060  \u54616 \u45208 \u45784 \u51032  \u52629 \u48373 \u51012  \u44396 \u54624  \u49688  \u50630 \u45716  \u50612 \u46500  \u44600 \u50640  \u48156 \u51012  \u46308 \u50668  \u45459 \u44592 \u47484  \u44144 \u51208 \u54624  \u44163  \u44057 \u51004 \u47732  \u44536 \u46308 \u51008  \u51396 \u50640  \u50976 \u54841 \u45817 \u54616 \u51648  \u50500 \u45768 \u54624  \u44163 \u51060 \u45796 . \u49464 \u49345 \u51012  \u44221 \u44256 \u54624  \u47560 \u51648 \u47561  \u50628 \u49689 \u54620  \u49324 \u47749 \u51012  \u51204 \u45804 \u54616 \u45716  \u49324 \u51088 \u46308 \u51060  \u45257 \u45812 \u54616 \u44256  \u47924 \u44288 \u49900 \u54616 \u44256  \u44172 \u51004 \u47480  \u53468 \u46020 \u44032  \u50630 \u51060  \u50676 \u47148 \u54620  \u49888 \u50521 \u51012  \u44032 \u51648 \u44256  \u54616 \u45208 \u45784 \u51032  \u52629 \u48373 \u51012  \u44396 \u54624  \u44163  \u44057 \u51004 \u47732 , \u44536 \u46308 \u51008  \u47566 \u51008  \u44275 \u50640 \u49436  \u47560 \u52824  \u50556 \u44273 \u52376 \u47100  \'93\u54616 \u45208 \u45784 \u44284  \u45824 \u47732 \u54616 \u50668  \u48372 \u50520 \u51004 \u45208  \u45236  \u49373 \u47749 \u51060  \u48372 \u51204 \u46104 \u50632 \u45796 \'94 (\u52285  32:30) \u44256  \u47568 \u54616 \u44172  \u46112  \u44163 \u51060 \u45796 . \u44536 \u46308 \u51008  \u54616 \u45208 \u45784 \u44284  \u49324 \u46988 \u51004 \u47196  \u45908 \u48520 \u50612  \u44200 \u47336 \u50612  \u51060 \u44592 \u50632 \u51004 \u48064 \u47196  \u50773 \u51088 \u46972 \u45716  \u54616 \u45720 \u51032  \u51064 \u51221 \u51012  \u48155 \u44172  \u46112  \u44163 \u51060 \u45796 .\
