\uc0\u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u44060 \u49888 \u44368  \u44033  \u44368 \u54924  \u44036 \u50640  \u51316 \u51116 \u54616 \u45716  \u49888 \u51312 \u51032  \u53360  \u52264 \u51060 \u50556 \u47568 \u47196  \u44053 \u50836 \u46108  \u53685 \u51068 \u49457 \u51012  \u51060 \u47337 \u54616 \u47140 \u45716  \u45432 \u47141 \u51060  \u44208 \u53076  \u44221 \u51452 \u46112  \u49688  \u50630 \u51004 \u47532 \u46972 \u45716  \u44208 \u51221 \u51201 \u51064  \u51613 \u44144 \u46972 \u44256  \u48372 \u50520 \u45796 . \u44536 \u47084 \u45208  \u51648 \u45208 \u44036  \u50668 \u47084  \u54644  \u46041 \u50504  \u44060 \u49888 \u44368  \u44033  \u44368 \u54924 \u50640 \u49436 \u45716  \u44277 \u53685 \u51201 \u51064  \u44368 \u47532 \u47484  \u44540 \u44144 \u47196  \u54620  \u51068 \u52824  \u50672 \u54633 \u51012  \u50896 \u54616 \u45716  \u50668 \u47200 \u51060  \u44053 \u54616 \u44172  \u51088 \u46972 \u45228 \u45796 . \u44536 \u50752  \u44057 \u51008  \u50672 \u54633 \u51012  \u51060 \u47336 \u47140 \u47732 , \u44536 \u44163 \u51060  \u49444 \u54841  \u49457 \u44221 \u49345  \u44288 \u51216 \u50640 \u49436  \u50500 \u47924 \u47532  \u51473 \u50836 \u54624 \u51648 \u46972 \u46020  \u47784 \u46304  \u49324 \u46988 \u51060  \u54633 \u51032 \u54616 \u51648  \u50500 \u45768 \u54620  \u47928 \u51228 \u46308 \u50640  \u44288 \u54620  \u53664 \u51032 \u45716  \u54596 \u50672 \u51201 \u51004 \u47196  \u54252 \u44592 \u54616 \u51648  \u50506 \u51004 \u47732  \u50504  \u46108 \u45796 .\
\uc0\u52272 \u49828  \u48708 \u52376 \u45716  1846\u45380 \u50640  \u54620  \u49444 \u44368 \u50640 \u49436  \u45796 \u51020 \u44284  \u44057 \u51008  \u47568 \u51012  \u54616 \u50688 \u45796 . \'93\u49888 \u44368  \u44033  \u44368 \u54028 \u51032  \u49457 \u51649 \u51088 \u46308 \u51008  \u51064 \u44036 \u51201  \u46160 \u47140 \u50880 \u50640  \u49549 \u54620  \u49900 \u54620  \u50517 \u47141 \u50640  \u45580 \u47140  \u51080 \u51012  \u49104  \u50500 \u45768 \u46972  \u50756 \u51204 \u55176  \u48512 \u54056 \u54620  \u49345 \u53468 \u50640 \u49436  \u49332 \u50500 \u44032 \u44256 , \u50880 \u51649 \u51060 \u44256 , \u49704  \u49772 \u44256  \u51080 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u46308 \u51008  \u50616 \u51228 \u45208  \u44536 \u46308 \u51032  \u50728 \u44054  \u48708 \u50676 \u54620  \u49457 \u51656 \u50640  \u45132 \u47140 \u49436  \u51652 \u47532 \u50640  \u45824 \u54616 \u50668 \u45716  \u52840 \u47925 \u54616 \u44256 , \u48176 \u44368 \u51032  \u49464 \u47141 \u50640 \u44172 \u45716  \u47924 \u47502 \u51012  \u44999 \u50612  \u51208 \u54616 \u44256  \u51080 \u45796 . \u51060 \u44163 \u51060  \u47196 \u47560 \u44368 \u54924 \u44032  \u44036  \u44600 \u51060  \u50500 \u45768 \u50632 \u45912 \u44032 ? \u50864 \u47532 \u45716  \u44536 \u51032  \u44036  \u44600 \u51012  \u45796 \u49884  \u44151 \u44256  \u51080 \u51648  \u50506 \u45716 \u44032 ? \u50864 \u47532 \u45716  \u48148 \u47196  \u50526 \u50640 \u49436  \u47924 \u50631 \u51012  \u48372 \u44256  \u51080 \u45716 \u44032 ? \u44536 \u44163 \u51008  \u51204 \u52404 \u51201  \u54924 \u51032 \u50836 , \u49464 \u44228 \u51201  \u45824 \u54924 \u51032  \u44060 \u52572 \u51060 \u45796 ! \u49440 \u44368  \u46041 \u47609 \u51060 \u50836 , \u51068 \u48152 \u51201 \u51064  \u49888 \u51312 \u51032  \u51228 \u51221 \u51060 \u45796 \'94 (Sermon on \'93The Bibble a Sufficient Creed\'94, delivered at Fort Wayne, Indiana, Feb.22, 1846). \u51060  \u51068 \u51060  \u49457 \u52712 \u46104 \u47732 , \u50756 \u51204 \u54620  \u50672 \u54633 \u51012  \u51060 \u47336 \u44592  \u50948 \u54620  \u45800 \u44228 \u47196 \u49436  \u52712 \u54624  \u50976 \u51068 \u54620  \u48169 \u48277 \u51008  \u44053 \u51228  \u49688 \u45800 \u51060 \u45796 .\
\uc0\u54633 \u51473 \u44397 \u51032  \u51452 \u50836 \u54620  \u44368 \u54924 \u46308 \u51060  \u44277 \u53685 \u51201 \u51004 \u47196  \u51452 \u51109 \u54616 \u45716  \u44368 \u47532 \u50640  \u51032 \u54616 \u50668  \u49436 \u47196  \u50672 \u54633 \u54616 \u50668  \u44536  \u44397 \u44032 \u47196  \u54616 \u50668 \u44552  \u51088 \u44592 \u46308 \u51032  \u44368 \u47161  (\u25934 \u20196 ) \u51012  \u44053 \u51228 \u47196  \u49892 \u49884 \u54616 \u44172  \u54616 \u44256 , \u44536 \u46308 \u51032  \u51228 \u46020 \u47484  \u44053 \u50517 \u51201 \u51004 \u47196  \u50976 \u51648 \u54616 \u47140 \u45716  \u46412 \u44032  \u51060 \u47476 \u47732 , \u44536  \u46412 \u50640  \u44060 \u49888 \u44368  \u48120 \u44397 \u51008  \u47196 \u47560 \u44368 \u51201  \u44368 \u44428  \u51221 \u52824 \u51032  \u50864 \u49345 \u51012  \u47564 \u46308 \u44172  \u46104 \u44256 , \u44536  \u54596 \u50672 \u51201  \u44208 \u44284 \u47196 \u49436  \u51060 \u50640  \u48152 \u45824 \u54616 \u45716  \u51088 \u46308 \u50640 \u44172 \u45716  \u48277 \u47456 \u51201  \u54805 \u48268 \u51012  \u44284 \u54616 \u44172  \u46112  \u44163 \u51060 \u45796 .\
\uc0\u44536  \u46160  \u49108  \u44032 \u51652  \u51664 \u49849 \u51008  \'93\u47784 \u46304  \u51088  \u44263  \u51089 \u51008  \u51088 \u45208  \u53360  \u51088 \u45208  \u48512 \u51088 \u45208  \u48712 \u44417 \u54620  \u51088 \u45208  \u51088 \u50976 \u54620  \u51088 \u45208  \u51333 \u46308 \u47196  \u44536  \u50724 \u47480 \u49552 \u50640 \u45208  \u51060 \u47560 \u50640  \u54364 \u47484  \u48155 \u44172  \u54616 \u44256  \u45572 \u44396 \u46304 \u51648  \u51060  \u54364 \u47484  \u44032 \u51652  \u51088  \u50808 \u50640 \u45716  \u47588 \u47588 \u47484  \u47803 \u54616 \u44172 \'94 (\u44228  13:16, 17) \u54620 \u45796 . \u44536 \u47088 \u45936  \u49483 \u51704  \u52380 \u49324 \u51032  \u44592 \u48324 \u51008  \'93\u47564 \u51068  \u45572 \u44396 \u46304 \u51648  \u51664 \u49849 \u44284  \u44536 \u51032  \u50864 \u49345 \u50640 \u44172  \u44221 \u48176 \u54616 \u44256  \u51060 \u47560 \u50640 \u45208  \u49552 \u50640  \u54364 \u47484  \u48155 \u51004 \u47732  \u44536 \u46020  \u54616 \u45208 \u45784 \u51032  \u51652 \u45432 \u51032  \u54252 \u46020 \u51452 \u47484  \u47560 \u49884 \u47532 \'94\u46972 \u44256  \u44221 \u44256 \u54616 \u44256  \u51080 \u45796 . \u51060  \u44592 \u48324 \u50640 \u49436  \u47568 \u54620  \u51664 \u49849 , \u44263  \u46160  \u49108  \u44032 \u51652  \u51664 \u49849 \u51060  \u44221 \u48176 \u54616 \u46972 \u44256  \u44053 \u50836 \u54616 \u45716  \u44536  \u51664 \u49849 \u51008  \u50836 \u54620 \u44228 \u49884 \u47197  13\u51109 \u51032  \u52395 \u51704  \u51664 \u49849 , \u44263  \u54364 \u48276 \u44057 \u51008  \u51664 \u49849 \u51064  \u48277 \u50773 \u44428 \u51060 \u45796 . \u44536 \u47084 \u48064 \u47196  \'93\u51664 \u49849 \u51032  \u50864 \u49345 \'94\u51008  \u51088 \u44592 \u51032  \u44368 \u47532 \u47484  \u44053 \u50836 \u54616 \u44592  \u50948 \u54616 \u50668  \u44397 \u44428 \u51032  \u46020 \u50880 \u51012  \u44396 \u54632 \u51004 \u47196  \u49373 \u44200 \u45208 \u44172  \u46112  \u48176 \u44368 \u54620  \u44060 \u49888 \u44368 \u46020 \u46308 \u51032  \u45800 \u52404 \u47484  \u45208 \u53440 \u45240 \u45796 . \'93\u51664 \u49849 \u51032  \u54364 \'94\u45716  \u54644 \u47749 \u46104 \u50612 \u50556  \u54624  \u50668 \u51648 \u44032  \u50668 \u51204 \u55176  \u51080 \u45796 .\
