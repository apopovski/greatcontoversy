\uc0\u44536  \u47784 \u46304  \u51032 \u49885 \u51008  \u51060 \u49828 \u46972 \u50648  \u51088 \u49552 \u46308 \u47196  \u54616 \u50668 \u44552  \u54616 \u45208 \u45784 \u51032  \u44144 \u47337 \u54616 \u49900 \u44284  \u51452 \u45784 \u44760 \u49436  \u51396 \u47484  \u44032 \u51613 \u55176  \u50668 \u44592 \u49900 \u51012  \u44618 \u51060  \u44648 \u45803 \u44172  \u54644 \u51460  \u49104  \u50500 \u45768 \u46972  \u46608 \u54620  \u51396 \u50752  \u51217 \u52489 \u54616 \u47732  \u48152 \u46300 \u49884  \u48512 \u51221 \u54616 \u44172  \u46108 \u45796 \u45716  \u44163 \u51012  \u45208 \u53440 \u45236  \u48372 \u51060 \u44592  \u50948 \u54620  \u44163 \u51060 \u50632 \u45796 . \u51060  \u49549 \u51396 \u51032  \u49324 \u50629 \u51060  \u51652 \u54665 \u46104 \u45716  \u46041 \u50504 \u50640  \u44033  \u49324 \u46988 \u51008  \u53685 \u54924 \u54616 \u44256  \u47560 \u51020 \u51012  \u44340 \u47213 \u44172  \u54616 \u50668 \u50556  \u54616 \u50688 \u45796 . \u44536 \u45216 \u50640  \u47784 \u46304  \u49324 \u46988 \u51008  \u51068 \u51012  \u51204 \u54224 \u54616 \u44256 , \u51060 \u49828 \u46972 \u50648 \u51032  \u50728  \u54924 \u51473 \u51060  \u50628 \u49689 \u54616 \u44172  \u54616 \u45208 \u45784  \u50526 \u50640  \u51088 \u49888 \u51012  \u44216 \u48708 \u54616 \u44172  \u54616 \u44256 , \u44592 \u46020 \u54616 \u44256 , \u44552 \u49885 \u54616 \u44256 , \u47560 \u51020 \u51012  \u44618 \u51060  \u49332 \u54588 \u45716  \u44032 \u50868 \u45936  \u51648 \u45236 \u51648  \u50506 \u51004 \u47732  \u50504  \u46104 \u50632 \u45796 .\
\uc0\u49549 \u51396 \u50640  \u44288 \u54620  \u51473 \u50836 \u54620  \u51652 \u47532 \u44032  \u51060  \u47784 \u54805 \u51201  \u51032 \u49885 \u51012  \u53685 \u54616 \u50668  \u50508 \u47140 \u51276 \u45796 . \u51396 \u51064 \u51032  \u45824 \u49549 \u47932 \u51060  \u51396 \u51064 \u51012  \u45824 \u49888 \u54616 \u50668  \u50676 \u45225 \u46104 \u50632 \u51004 \u45208  \u51396 \u45716  \u44536  \u55148 \u49373  \u51228 \u47932 \u51032  \u54588 \u47196  \u50630 \u50612 \u51648 \u51648  \u50506 \u50520 \u45796 . \u45796 \u47564  \u50612 \u46500  \u49688 \u45800 \u50640  \u51032 \u54616 \u50668  \u51396 \u44032  \u49457 \u49548 \u47196  \u50734 \u44200 \u51276 \u51012  \u49104 \u51060 \u50632 \u45796 . \u51396 \u51064 \u51008  \u54588 \u47484  \u46300 \u47548 \u51004 \u47196 \u50024  \u44536 \u44032  \u50984 \u48277 \u51032  \u44428 \u50948 \u47484  \u49884 \u51064 \u54616 \u44256  \u51088 \u44592 \u44032  \u48276 \u54620  \u51396 \u47484  \u44256 \u48177 \u54616 \u44256  \u51109 \u52264  \u50724 \u49892  \u44396 \u49549 \u51452 \u47484  \u48127 \u45716  \u48127 \u51020 \u51012  \u53685 \u54616 \u50668  \u50857 \u49436 \u47484  \u48148 \u46972 \u44256  \u51080 \u45796 \u45716  \u51088 \u49888 \u51032  \u49548 \u50896 \u51012  \u54364 \u49884 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u44163 \u51004 \u47196  \u44536 \u44032  \u50984 \u48277 \u51032  \u49440 \u44256 \u50640 \u49436  \u50756 \u51204 \u55176  \u54644 \u48169 \u46108  \u44163 \u51008  \u50500 \u45768 \u50632 \u45796 . \u45824 \u49549 \u51396 \u51068 \u50640  \u45824 \u51228 \u49324 \u51109 \u51008  \u54924 \u51473 \u50640 \u44172 \u49436  \u48155 \u51008  \u51228 \u47932 \u51012  \u52712 \u54616 \u50668  \u44536  \u51228 \u47932 \u51032  \u54588 \u47484  \u44032 \u51648 \u44256  \u51648 \u49457 \u49548 \u50640  \u46308 \u50612 \u44032  \u48148 \u47196  \u50984 \u48277 \u51012  \u45347 \u50612 \u46164  \u48277 \u44452 \u51032  \u46748 \u44753 \u50640  \u54644 \u45817 \u46104 \u45716  \u49549 \u51396 \u49548  \u50948 \u50640  \u44536  \u54588 \u47484  \u49100 \u47140  \u44536  \u50984 \u48277 \u51032  \u50836 \u44396 \u47484  \u52649 \u51313 \u49884 \u53040 \u45796 . \u44536 \u47532 \u44256  \u45824 \u51228 \u49324 \u51109 \u51008  \u51473 \u48372 \u51088 \u51032  \u51088 \u44201 \u51004 \u47196  \u47784 \u46304  \u51396 \u47484  \u51088 \u44592 \u44032  \u51648 \u44256  \u49457 \u49548 \u50640 \u49436  \u44536  \u51396 \u47484  \u50734 \u44220 \u45796 . \u44536 \u45716  \u44536 \u51032  \u49552 \u51012  \u50684 \u49548 \u51032  \u47672 \u47532  \u50948 \u50640  \u50617 \u50612  \u44536  \u47784 \u46304  \u51396 \u47484  \u44256 \u48177 \u54632 \u51004 \u47196  \u49345 \u51669 \u51201 \u51064  \u51032 \u48120 \u50640 \u49436  \u44536  \u51396 \u47484  \u51088 \u44592  \u51088 \u49888 \u50640 \u44172 \u49436  \u50684 \u49548 \u50640 \u44172 \u47196  \u50734 \u44220 \u45796 . \u44536  \u54980 \u50640  \u44536  \u50684 \u49548 \u45716  \u51923 \u44200 \u45208 \u44172  \u46104 \u50632 \u45716 \u45936 , \u44536 \u44163 \u51004 \u47196 \u50024  \u51396 \u44032  \u50689 \u50896 \u55176  \u48177 \u49457 \u50640 \u44172 \u49436  \u48516 \u47532 \u46104 \u45716  \u44163 \u51004 \u47196  \u44036 \u51452 \u46104 \u50632 \u45796 .\
\uc0\u51060 \u49345 \u51008  \'93\u54616 \u45720 \u50640  \u51080 \u45716  \u44163 \u51032  \u47784 \u54805 \'94\u51004 \u47196  \u54665 \u54620  \u51032 \u49885 \u51060 \u50632 \u45796 . \u44536 \u47088 \u45936  \u51648 \u49345  \u49457 \u49548 \u50640 \u49436  \u47784 \u54805 \u51004 \u47196  \u54665 \u54620  \u51068 \u51008  \u54616 \u45720  \u49457 \u49548 \u51032  \u48393 \u49324 \u50640 \u49436  \u49892 \u51228 \u51201 \u51004 \u47196  \u54665 \u54644 \u51652 \u45796 . \u50864 \u47532  \u51452 \u45784 \u44760 \u49436 \u45716  \u49849 \u52380 \u54616 \u49888  \u54980  \u50864 \u47532 \u51032  \u45824 \u51228 \u49324 \u51109 \u51004 \u47196  \u45817 \u49888 \u51032  \u49324 \u50629 \u51012  \u49884 \u51089 \u54616 \u49512 \u45796 . \u48148 \u50872 \u51008  \'93\u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u52280  \u44163 \u51032  \u44536 \u47548 \u51088 \u51064  \u49552 \u51004 \u47196  \u47564 \u46304  \u49457 \u49548 \u50640  \u46308 \u50612 \u44032 \u51648  \u50500 \u45768 \u54616 \u49884 \u44256  \u50724 \u51649  \u52280  \u54616 \u45720 \u50640  \u46308 \u50612 \u44032 \u49324  \u51060 \u51228  \u50864 \u47532 \u47484  \u50948 \u54616 \u50668  \u54616 \u45208 \u45784  \u50526 \u50640  \u45208 \u53440 \u45208 \u49884 \u44256 \'94 (\u55176  9:24) \u46972  \u47568 \u54620 \u45796 .\
