\'93\uc0\u49888 \u46993 \u51060  \u45908 \u46356  \u50724 \u48064 \u47196  \u45796  \u51320 \u47728 \'94 \u51108 \u45796 . \u49888 \u46993 \u51060  \u45908 \u46356  \u50728 \u45796 \u45716  \u44163 \u51008  \u51452 \u45784 \u44760 \u49436  \u50724 \u49892  \u44163 \u51004 \u47196  \u50696 \u44592 \u54664 \u45912  \u49884 \u51068 \u51060  \u51648 \u45208 \u44040  \u46412  \u49892 \u47581 \u44284  \u51648 \u52404 \u46104 \u45716  \u46319 \u51060  \u48372 \u51060 \u45716  \u51068 \u51060  \u51080 \u51012  \u44163 \u51012  \u45208 \u53440 \u45240 \u45796 . \u51060  \u48520 \u50504 \u54620  \u49884 \u44592 \u50640  \u54588 \u49345 \u51201 \u51060 \u44256  \u48152 \u49888 \u48152 \u51032 \u51032  \u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u51008  \u44263  \u46041 \u50836 \u46104 \u44592  \u49884 \u51089 \u54616 \u44256  \u44536 \u46308 \u51032  \u54876 \u46041 \u51008  \u55192 \u51012  \u51075 \u50632 \u45796 . \u44536 \u47084 \u45208  \u49457 \u44221 \u50640  \u45824 \u54620  \u44060 \u51064 \u51201  \u51648 \u49885 \u51012  \u44592 \u52488 \u47196  \u54620  \u48127 \u51020 \u51012  \u44032 \u51652  \u49324 \u46988 \u46308 \u51008  \u49892 \u47581 \u51032  \u54028 \u46020 \u44032  \u55081 \u50424 \u50612  \u44040  \u49688  \u50630 \u45716  \u48152 \u49437  \u50948 \u50640  \u49436  \u51080 \u50632 \u45796 . \'93\u45796  \u51320 \u47728 \'94 \u51108 \u45796 . \u54620  \u54200 \u51032  \u49324 \u46988 \u46308 \u51008  \u44536 \u46308 \u51032  \u48127 \u51020 \u50640  \u45824 \u54616 \u50668  \u47924 \u44288 \u49900 \u54616 \u44256  \u45800 \u45392 \u54616 \u45716  \u53468 \u46020 \u47484  \u44032 \u51648 \u45716  \u48152 \u47732 \u50640 , \u45796 \u47480  \u54200 \u51032  \u49324 \u46988 \u46308 \u51008  \u51064 \u45236 \u54632 \u51004 \u47196  \u45908 \u50865  \u48157 \u51008  \u48731 \u51060  \u50724 \u44592 \u47484  \u44592 \u45796 \u47532 \u44256  \u51080 \u50632 \u45796 . \u44536 \u47084 \u45208  \u49884 \u47144 \u51032  \u48164 \u51060  \u44618 \u50612 \u51664