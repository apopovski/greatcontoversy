\f1\b0 \cf0 \
\uc0\u47336 \u53552 \u44032  \u51032 \u54924 \u50640  \u52636 \u46160 \u54620 \u45796 \u45716  \u49548 \u49885 \u51060  \u48372 \u47492 \u49828 \u50640  \u51204 \u54644 \u51648 \u51088 , \u51068 \u48152  \u49324 \u46988 \u46308 \u51008  \u55141 \u48516 \u54616 \u44172  \u46104 \u50632 \u45796 . \u51060 \u48264  \u49324 \u44148 \u51012  \u53945 \u48324 \u55176  \u50948 \u51076 \u48155 \u51008  \u48277 \u50773 \u51032  \u49324 \u51208  \u50508 \u47532 \u50504 \u45908  (Aleander) \u45716  \u45440 \u46972 \u44256  \u48516 \u45432 \u54616 \u50688 \u45796 . \u44536 \u45716  \u44536  \u44208 \u44284 \u44032  \u48277 \u50773  \u52769 \u50640  \u48520 \u47532 \u54624  \u44163 \u51012  \u50508 \u50520 \u45796 . \u48277 \u50773 \u51060  \u51060 \u48120  \u51221 \u51396 \u51032  \u49440 \u44256 \u47484  \u45236 \u47536  \u49324 \u44148 \u51012  \u49900 \u47532 \u54620 \u45796 \u45716  \u44163 \u51008  \u44032 \u51109  \u45458 \u51008  \u48277 \u50773 \u51032  \u44428 \u50948 \u47484  \u47784 \u50837 \u54616 \u45716  \u51068 \u51060 \u50632 \u45796 . \u45908 \u50865 \u51060  \u44536 \u45716  \u51060  \u49324 \u46988 \u51032  \u50885 \u48320 \u44284  \u50976 \u47141 \u54620  \u51060 \u47200 \u51060  \u47566 \u51008  \u50689 \u51452 \u46308 \u51012  \u48277 \u50773 \u51032  \u49324 \u50629 \u51004 \u47196 \u48512 \u53552  \u46496 \u45208 \u44032 \u44172  \u54624  \u44163 \u51012  \u50684 \u47140 \u54616 \u50688 \u45796 . \u44536 \u47084 \u48064 \u47196  \u44536 \u45716  \u44032 \u51109  \u49888 \u49549 \u54620  \u48169 \u48277 \u51004 \u47196 , \u47336 \u53552 \u44032  \u48372 \u47492 \u49828 \u50640  \u45208 \u53440 \u45208 \u51648  \u47803 \u54616 \u44172  \u54644 \u45804 \u46972 \u44256  \u52852 \u50508 \u50640 \u44172  \u54840 \u49548 \u54616 \u50688 \u45796 . \u46412 \u47560 \u52840  \u47336 \u53552 \u51032  \u54028 \u47928 \u51012  \u49440 \u44256 \u54616 \u45716  \u51312 \u49436 \u44032  \u44277 \u54252 \u46104 \u50632 \u44256 , \u48277 \u50773 \u51032  \u49324 \u51208 \u51032  \u51228 \u50504 \u46020  \u51080 \u50632 \u51004 \u48064 \u47196  \u54889 \u51228 \u45716  \u51652 \u49900 \u51004 \u47196  \u44536  \u51068 \u51012  \u49688 \u46973 \u54616 \u50688 \u45796 . \u54889 \u51228 \u45716  \u49440 \u54980 \u50640 \u44172  \u47336 \u53552 \u44032  \u49888 \u50521 \u51032  \u52712 \u49548 \u47484  \u50896 \u54616 \u51648  \u50506 \u45716 \u45796 \u47732  \u48708 \u53584 \u48288 \u47476 \u53356 \u50640  \u47672 \u47932 \u47084  \u51080 \u50612 \u50556  \u54620 \u45796 \u44256  \u54200 \u51648 \u54616 \u50688 \u45796 .\
\uc0\u50508 \u47532 \u50504 \u45908 \u45716  \u51060  \u49849 \u47532 \u47196 \u50024  \u47564 \u51313 \u54616 \u51648  \u50506 \u44256  \u54624  \u49688  \u51080 \u45716  \u45824 \u47196  \u50728  \u55192 \u44284  \u44036 \u44228 \u47484  \u45796 \u54616 \u50668  \u47336 \u53552 \u47484  \u51221 \u51396 \u54616 \u44256 \u51088  \u50528 \u47484  \u50044 \u45796 . \u44536 \u45716  \u48708 \u49345 \u54620  \u51665 \u45392  \u50500 \u47000  \u51228 \u54980 \u46308 \u44284  \u51452 \u44368 \u46308 \u44284  \u44536  \u48150 \u51032  \u45796 \u47480  \u51032 \u50896 \u46308 \u50640 \u44172  \u44536  \u47928 \u51228 \u50640  \u45824 \u54616 \u50668  \u51452 \u51032 \u47484  \u54872 \u44592 \u49884 \u53412 \u44256 , \u44060 \u54785 \u51088 \u47484  \'93\u49440 \u46041 , \u48152 \u50669 , \u48520 \u44221 \u44148 , \u52280 \u46988 \'94 \u46321 \u51032  \u51396 \u47196  \u44256 \u49548 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u48277 \u50773 \u51032  \u49324 \u51208 \u51060  \u45208 \u53440 \u45240  \u44201 \u51221 \u44284  \u48516 \u45432 \u45716  \u44536 \u44032  \u50612 \u46500  \u51221 \u49888 \u50640  \u51032 \u54616 \u50668  \u50880 \u51649 \u51060 \u44256  \u51080 \u45796 \u45716  \u44163 \u51012  \u45320 \u47924 \u46020  \u47749 \u48177 \u54616 \u44172  \u46300 \u47084 \u45236 \u50632 \u45796 . \'93\u44536 \u45716  \u50676 \u49457 \u44284  \u44221 \u44148 \u51004 \u47196 \u48372 \u45796 \u45716  \u51613 \u50724 \u50752  \u48373 \u49688 \u49900 \u51004 \u47196  \u51648 \u48176 \u46104 \u50632 \u45796 \'94 (D\'92Aubigne, b.7, ch.1) \u45716  \u44163 \u51060  \u51068 \u48152 \u51201 \u51064  \u54217 \u51060 \u50632 \u45796 . \u51032 \u54924 \u51032  \u45824 \u45796 \u49688 \u51032  \u49324 \u46988 \u46308 \u51008  \u50612 \u45712  \u46412 \u48372 \u45796 \u46020  \u45908 \u50865  \u47336 \u53552 \u51032  \u49324 \u50629 \u50640  \u54840 \u44048 \u51012  \u44054 \u44172  \u46104 \u50632 \u45796 .\
\uc0\u50508 \u47532 \u50504 \u45908 \u45716  \u45796 \u49884  \u48176 \u44032 \u46108  \u50676 \u49457 \u51004 \u47196  \u54889 \u51228 \u50640 \u44172  \u48277 \u50773 \u51032  \u52825 \u47161 \u51012  \u49892 \u54665 \u54624  \u51032 \u47924 \u44032  \u51080 \u45796 \u44256  \u50669 \u49444 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u46021 \u51068 \u51032  \u48277 \u47456 \u49345 \u51004 \u47196  \u51060  \u51068 \u51012  \u51228 \u54980 \u46308 \u51032  \u52268 \u46041  \u50630 \u51060 \u45716  \u54624  \u49688  \u50630 \u50632 \u45796 . \u44536 \u47084 \u45208  \u54889 \u51228 \u45716  \u47560 \u52840 \u45236  \u44536  \u49324 \u51208 \u51032  \u51665 \u50836 \u54620  \u50836 \u44396 \u50640  \u47803  \u51060 \u44200 \u49436  \u44536 \u51032  \u49548 \u49569  \u49324 \u44148 \u51012  \u51032 \u54924 \u50640  \u51228 \u52636 \u54616 \u46972 \u44256  \u47749 \u47161 \u54616 \u50688 \u45796 . \'93\u44536 \u45216 \u51008  \u44368 \u54889  \u49324 \u51208 \u50640 \u44172  \u51080 \u50612 \u49436 \u45716  \u51088 \u46993 \u49828 \u47084 \u50868  \u45216 \u51060 \u50632 \u45796 . \u54924 \u51473 \u46020  \u45824 \u45800 \u54616 \u50688 \u51648 \u47560 \u45716  \u49548 \u49569  \u49324 \u44148 \u51008  \u45908 \u50865 \u45908  \u45824 \u45800 \u54616 \u50688 \u45796 . \u50508 \u47532 \u50504 \u45908 \u45716  \u47784 \u46304  \u44368 \u54924 \u51032  \u50612 \u47672 \u45768 \u51060 \u47728  \u51452 \u51064 \u51064  \u47196 \u47560 \u47484  \u50948 \u54616 \u50668  \u48320 \u54840 \u54624  \u44163 \u51060 \u50632 \u45796 .\'94 \u44536 \u45716  \u44144 \u44592 \u50640  \u47784 \u51064  \u44536 \u47532 \u49828 \u46020 \u44368 \u44397 \u51032  \u50896 \u47196 \u46308  \u50526 \u50640 \u49436  \u48288 \u46300 \u47196 \u51032  \u44428 \u50948 \u47484  \u48320 \u54840 \u54624  \u44163 \u51060 \u50632 \u45796 . \'93\u50508 \u47532 \u50504 \u45908 \u45716  \u50885 \u48320 \u51032  \u51116 \u44036 \u51012  \u48155 \u51008  \u49324 \u46988 \u51004 \u47196 \u49436  \u51060 \u52376 \u47100  \u51473 \u45824 \u54620  \u49884 \u44592 \u47484  \u50948 \u54616 \u50668  \u49440  \u49324 \u46988 \u51060 \u50632 \u45796 . \u47196 \u47560 \u44032  \u48708 \u45212 \u51012  \u48155 \u44592  \u51204 \u50640  \u44032 \u51109  \u50976 \u45733 \u54620  \u50885 \u48320 \u44032 \u44032  \u44536 \u47111 \u46319  \u50628 \u49689 \u54620  \u48277 \u51221 \u50640  \u45208 \u53440 \u45208 \u49436  \u44256 \u49548 \u47484  \u54620  \u44163 \u51060  \u54616 \u45208 \u45784 \u51032  \u49453 \u47532 \u50688 \u45796 \'94 (Wylie, b.6, ch.4). \u47336 \u53552 \u50640 \u44172  \u54840 \u44048 \u51012  \u44032 \u51652  \u51032 \u50896 \u46308 \u51008  \u50508 \u47532 \u50504 \u45908 \u51032  \u48320 \u47200 \u51032  \u44208 \u44284 \u50640  \u45824 \u54616 \u50668  \u50612 \u45712  \u51221 \u46020  \u50684 \u47140 \u54616 \u51648  \u50506 \u51012  \u49688  \u50630 \u50632 \u45796 . \u51089 \u49468 \u51032  \u49440 \u54980 \u45716  \u52280 \u49437 \u54616 \u51648  \u50506 \u50520 \u51004 \u45208  \u51088 \u44592 \u51032  \u44256 \u47928 \u44284  \u47751  \u49324 \u46988 \u51012  \u52280 \u49437 \u49884 \u53020  \u48277 \u50773 \u51032  \u49324 \u51208 \u51032  \u50672 \u49444 \u51012  \u54596 \u44592 \u54616 \u44172  \u54616 \u50688 \u45796 .\
\uc0\u50508 \u47532 \u50504 \u45908 \u45716  \u54617 \u47928 \u44284  \u50885 \u48320 \u51032  \u55192 \u51012  \u47784 \u46160  \u48156 \u55064 \u54616 \u50668  \u51652 \u47532 \u47484  \u51204 \u48373 \u49884 \u53412 \u44256 \u51088  \u51652 \u47141 \u54616 \u50688 \u45796 . \u44536 \u45716  \u47336 \u53552 \u47484  \u44368 \u54924 \u50752  \u44397 \u44032 , \u49328  \u51088 \u50752  \u51453 \u51008  \u51088 , \u49457 \u51649 \u51088 \u50752  \u54217 \u49888 \u51088 , \u44536 \u47532 \u49828 \u46020 \u51032  \u44368 \u54924 \u50752  \u44060 \u51064 \u51032  \u50896 \u49688 \u46972 \u44256  \u44144 \u46317 \u44144 \u46317  \u44256 \u48156 \u54616 \u50688 \u45796 . \'93\u47336 \u53552 \u51032  \u50724 \u47448 \u50640 \u45716  \u49901 \u47564  \u47749 \u51032  \u51060 \u45800 \u51012  \u54868 \u54805 \u49884 \u53420  \u47564 \u54620  \u51116 \u47308 \u44032  \u45321 \u45321 \u55176  \u51080 \u45796 \'94\u44256  \u44536 \u45716  \u51452 \u51109 \u54616 \u50688 \u45796 .\
\uc0\u44208 \u47200 \u51201 \u51004 \u47196  \u44536 \u45716  \u44060 \u54785 \u51452 \u51032 \u51032  \u49888 \u50521 \u51012  \u44256 \u49688 \u54616 \u45716  \u49324 \u46988 \u46308 \u51012  \u47784 \u50837 \u54616 \u44256 \u51088  \u45432 \u47141 \u54616 \u50688 \u45796 . \'93\u47336 \u53552 \u45817 \u51060 \u46976  \u47924 \u50631 \u51064 \u44032 ? \u50724 \u47564 \u54620  \u44368 \u49324 \u46308 , \u53440 \u46973 \u54620  \u49888 \u48512 \u46308 , \u48169 \u53461 \u54620  \u49849 \u47140 \u46308 , \u47924 \u51648 \u54620  \u48320 \u54840 \u51088 \u46308 , \u48512 \u54056 \u54620  \u44480 \u51313 \u46308 , \u51096 \u47803  \u51648 \u46020 \u46104 \u50612  \u48708 \u46756 \u50612 \u51652  \u51068 \u48152  \u48177 \u49457 \u46308 \u51032  \u51665 \u45800 \u46308 \u51060 \u45796 . \u44536 \u47084 \u45208  \u44032 \u53672 \u47533  \u45817 \u51008  \u49688 \u50752  \u45733 \u47141 \u44284  \u44428 \u47141  \u47732 \u50640 \u49436  \u44536 \u46308 \u48372 \u45796  \u50620 \u47560 \u45208  \u50864 \u49464 \u54620 \u44032 ! \u51060  \u50976 \u47749 \u54620  \u51032 \u54924 \u50640 \u49436  \u47564 \u51109 \u51068 \u52824 \u47196  \u44208 \u51032 \u54616 \u50668  \u47924 \u51648 \u54620  \u51088 \u47484  \u44228 \u47805 \u54616 \u44256 , \u44368 \u47564 \u54620  \u51088 \u47484  \u44221 \u44256 \u54616 \u44256 , \u50836 \u46041 \u54616 \u45716  \u51088 \u47484  \u50504 \u51221 \u49884 \u53412 \u44256 , \u50557 \u54620  \u51088 \u50640 \u44172  \u55192 \u51012  \u51460  \u44163 \u51060 \u45796 \'94 (D\'92Aubigne, b.7, ch.3).\
