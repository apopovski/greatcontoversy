\uc0\u54616 \u45208 \u45784 \u51032  \u49453 \u47532 \u47196 , \u54028 \u47532 \u45716  \u48373 \u51020 \u51012  \u48155 \u50500 \u46308 \u51060 \u46972 \u45716  \u46608  \u45796 \u47480  \u52488 \u52397 \u51012  \u48155 \u44172  \u46112  \u44163 \u51060 \u50632 \u45796 . \u47084 \u54168 \u48652 \u47476 \u50752  \u54028 \u47120 \u51032  \u54840 \u49548 \u45716  \u44144 \u51208 \u45817 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u45796 \u49884  \u44536  \u44592 \u48324 \u51008  \u51060  \u53360  \u46020 \u49884 \u51032  \u44033 \u44228 \u44033 \u52789 \u51032  \u49324 \u46988 \u46308 \u50640 \u44172  \u51204 \u54644 \u51256 \u50556  \u54624  \u44163 \u51060 \u50632 \u45796 . \u54532 \u46976 \u49884 \u49828  \u50773 \u51008  \u51221 \u52824 \u51201  \u50689 \u54693  \u46412 \u47928 \u50640  \u50500 \u51649  \u44060 \u54785 \u51452 \u51032 \u47484  \u45824 \u54637 \u54616 \u50668  \u47196 \u47560 \u51032  \u54200 \u50640  \u50756 \u51204 \u55176  \u44032 \u45812 \u54616 \u51648  \u50500 \u45768 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u54889 \u51228 \u51032  \u45572 \u51060  \u47560 \u44032 \u47112 \u53944 \u45716  \u44060 \u54785 \u51452 \u51032 \u44032  \u54532 \u46993 \u49828 \u50640 \u49436  \u49849 \u47532 \u47484  \u50619 \u50612 \u50556  \u54620 \u45796 \u45716  \u55148 \u47581 \u51012  \u50668 \u51204 \u55176  \u44256 \u49688 \u54616 \u44256  \u51080 \u50632 \u45796 . \u44536 \u45716  \u44060 \u54785 \u51452 \u51032 \u47484  \u54028 \u47532 \u50640  \u49440 \u54252 \u54616 \u50668 \u50556 \u44192 \u45796 \u44256  \u44208 \u49900 \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u50773 \u51032  \u48512 \u51116 \u49884 \u50640 , \u44536 \u45716  \u44060 \u54785 \u54028 \u51032  \u54620  \u47785 \u49324 \u50640 \u44172  \u54028 \u47532 \u51032  \u50668 \u47084  \u44368 \u54924 \u50640 \u49436  \u48373 \u51020 \u51012  \u51204 \u54616 \u46972 \u45716  \u47749 \u47161 \u51012  \u54616 \u50688 \u45796 . \u51060 \u50752  \u44057 \u51008  \u51068 \u51060  \u48277 \u50773 \u51032  \u45817 \u44397 \u51088 \u46308 \u50640  \u51032 \u54616 \u50668  \u44552 \u51648 \u46104 \u50612  \u51080 \u45716  \u44163 \u51012  \u50508 \u44256  \u44536 \u45716  \u50773 \u44417 \u51012  \u44277 \u44060 \u54616 \u50688 \u45796 . \u44536 \u45716  \u44536  \u51068 \u48512 \u47484  \u44060 \u51312  (\u25913 \u36896 ) \u54616 \u50668  \u44053 \u45817 \u51012  \u47564 \u46308 \u44256 , \u47588 \u51068  \u51068 \u51221 \u54620  \u49884 \u44036 \u50640  \u49444 \u44368 \u47484  \u54616 \u46020 \u47197  \u54616 \u44256 , \u44228 \u44553 \u44284  \u51648 \u50948 \u47484  \u48520 \u47928 \u54616 \u44256  \u45572 \u44396 \u46304 \u51648  \u52280 \u49437 \u54616 \u46020 \u47197  \u44305 \u44256 \u54664 \u45796 . \u47566 \u51008  \u49324 \u46988 \u46308 \u51060  \u44536  \u50696 \u48176 \u50640  \u52280 \u49437 \u54664 \u45796 . \u44053 \u45817 \u49104  \u50500 \u45768 \u46972  \u44536  \u44540 \u48169 \u51032  \u48169 \u46308 \u44620 \u51648 \u46020  \u49324 \u46988 \u46308 \u47196  \u44873  \u52284 \u45796 . \u47588 \u51068  \u47566 \u51008  \u49324 \u46988 \u46308 \u51060  \u47784 \u50688 \u45796 . \u44144 \u44592 \u50640 \u45716  \u44480 \u51313 , \u51221 \u52824 \u44032 , \u48277 \u47456 \u44032 , \u49345 \u51064 , \u51649 \u44277 \u46308 \u44620 \u51648 \u46020  \u51080 \u50632 \u45796 . \u50773 \u51008  \u51060 \u50752  \u44057 \u51008  \u51665 \u54924 \u47484  \u44552 \u51648 \u54616 \u45716  \u45824 \u49888 \u50640  \u54028 \u47532  \u49884 \u45236 \u51032  \u46160  \u44368 \u54924 \u50640 \u49436 \u46020  \u51060 \u50752  \u44057 \u51008  \u51665 \u54924 \u47484  \u50676 \u46020 \u47197  \u47749 \u47161 \u54616 \u50688 \u45796 . \u49884 \u48124 \u46308 \u51008  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51012  \u53685 \u54616 \u50668  \u51068 \u52237 \u51060  \u48155 \u50500 \u48372 \u51648  \u47803 \u54620  \u44048 \u46041 \u51012  \u48155 \u50520 \u45796 . \u54616 \u45720 \u50640 \u49436  \u50728  \u49373 \u47749 \u51032  \u44592 \u50868 \u51060  \u49324 \u46988 \u46308 \u50640 \u44172  \u46308 \u50612 \u44036  \u44163  \u44057 \u50520 \u45796 . \u49696  \u52712 \u54632 \u44284  \u48169 \u53461 \u54632 \u44284  \u53804 \u51137 \u44284  \u44172 \u51004 \u47492 \u51060  \u51208 \u51228 \u50752  \u49692 \u44208 \u44284  \u51656 \u49436 \u50752  \u44540 \u47732 \u51004 \u47196  \u48148 \u45068 \u50612 \u51276 \u45796 .\
\uc0\u44536 \u47084 \u45208  \u49457 \u51649 \u51088  \u44228 \u44553 \u50640 \u49436 \u45716  \u44032 \u47564 \u51080 \u51648  \u50506 \u50520 \u45796 . \u50773 \u51008  \u50668 \u51204 \u55176  \u48373 \u51020  \u51204 \u46020 \u47484  \u51473 \u45800 \u49884 \u53412 \u45716  \u51068 \u50640  \u44036 \u49453 \u54616 \u44592 \u47484  \u44144 \u48512 \u54616 \u50688 \u45796 . \u44536 \u47084 \u48064 \u47196  \u44536 \u46308 \u51008  \u45824 \u51473 \u50640 \u44172 \u47196  \u48169 \u54693 \u51012  \u46028 \u47160 \u45796 . \u47924 \u51648 \u54616 \u44256  \u48120 \u49888 \u51201 \u51064  \u47566 \u51008  \u47924 \u47532 \u50640 \u44172  \u44277 \u54252 \u50752  \u54200 \u44204 \u44284  \u44305 \u49888 \u51012  \u51068 \u51004 \u53412 \u44592  \u50948 \u54616 \u50668  \u50612 \u46496 \u54620  \u49688 \u45800 \u46020  \u44032 \u47532 \u51648  \u50506 \u44256  \u49324 \u50857 \u54616 \u50688 \u45796 . \u44144 \u51667  \u44368 \u49324 \u46308 \u50640 \u44172  \u47609 \u51333 \u54620  \u54028 \u47532 \u45716  \u50715 \u45216 \u51032  \u50696 \u47336 \u49332 \u47128 \u44284  \u44057 \u51060  \u44536 \u46308 \u51032  \u49900 \u54032 \u51032  \u45216 \u46020  \u50508 \u51648  \u47803 \u54616 \u50688 \u44256 , \u54217 \u44053 \u50640  \u49549 \u54620  \u51068 \u46020  \u50508 \u51648  \u47803 \u54616 \u50688 \u45796 . 2\u45380  \u46041 \u50504  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51008  \u54028 \u47532 \u50640 \u49436  \u51204 \u54028 \u46104 \u50632 \u45796 . \u44536  \u46041 \u50504 \u50640  \u47566 \u51008  \u49324 \u46988 \u46308 \u51060  \u48373 \u51020 \u51012  \u48155 \u50500 \u46308 \u50688 \u51004 \u45208 , \u48177 \u49457 \u46308  \u51473 \u51032  \u45824 \u45796 \u49688 \u45716  \u44144 \u51208 \u54616 \u50688 \u45796 . \u54532 \u46976 \u49884 \u49828  \u50773 \u51008  \u45800 \u49692 \u55176  \u51088 \u44592  \u51088 \u49888 \u51032  \u47785 \u51201 \u51012  \u49457 \u52712 \u54616 \u44592  \u50948 \u54616 \u50668  \u44060 \u54785 \u51452 \u51032 \u47484  \u54728 \u50857 \u54616 \u50688 \u51004 \u48064 \u47196 , \u48277 \u50773 \u52769 \u51060  \u45796 \u49884  \u44428 \u49464 \u47484  \u54924 \u48373 \u54616 \u45716  \u45936  \u49457 \u44277 \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44368 \u54924 \u45716  \u45796 \u49884  \u54224 \u49604 \u46104 \u44256 , \u54868 \u54805 \u51452 \u44032  \u49464 \u50892 \u51276 \u45796 .\
