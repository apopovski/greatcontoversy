\f1\b0 \cf0 \
\uc0\u44536  \u46160 \u47336 \u47560 \u47532 \u45716  \u53664 \u50836 \u51068  \u51228 9\u49884 , \u44263  \u50724 \u54980  3\u49884 \u48512 \u53552  \u50900 \u50836 \u51068  \u54644  \u46896  \u46412 \u44620 \u51648  \u45432 \u46041 \u51012  \u54616 \u51648  \u47803 \u54616 \u46020 \u47197  \u44552 \u54616 \u50688 \u45796 . \u44536 \u47532 \u44256  \u44536  \u44428 \u50948 \u45716  \u47566 \u51008  \u51060 \u51201 \u46308 \u51060  \u51077 \u51613 \u54644  \u51460  \u44163 \u51060 \u46972 \u44256  \u54616 \u50688 \u45796 . \u51648 \u51221 \u46108  \u49884 \u44036  \u50808 \u50640  \u51068 \u54616 \u48064 \u47196  \u47560 \u48708 \u51613 \u50640  \u44152 \u47536  \u49324 \u46988 \u46308 \u51060  \u51080 \u45796 \u45716  \u49548 \u47928 \u46020  \u54140 \u51276 \u45796 . \u54620  \u51228 \u48516 \u50629 \u51088 \u44032  \u44257 \u49885 \u51012  \u44040 \u47140 \u44256  \u54616 \u51088  \u44032 \u47336 \u44032  \u45208 \u50724 \u45716  \u45824 \u49888 \u50640  \u54588 \u44032  \u50143 \u50500 \u51256  \u45208 \u50724 \u44256  \u47932 \u51008  \u55192  \u51080 \u44172  \u55128 \u47084 \u45236 \u47160 \u51020 \u50640 \u46020  \u48520 \u44396 \u54616 \u44256  \u49688 \u52264  (\u27700 \u36554 ) \u44032  \u51204 \u54784  \u50880 \u51649 \u51060 \u51648  \u50506 \u50520 \u45796 . \u46497 \u51012  \u52236 \u47140 \u44256  \u46497 \u48152 \u51453 \u51012  \u44032 \u47560 \u50640  \u45347 \u50632 \u45912  \u54620  \u48512 \u51064 \u51008  \u46497 \u51012  \u44732 \u45236  \u48372 \u45768  \u44032 \u47560 \u45716  \u47588 \u50864  \u45908 \u50892  \u51080 \u50612 \u46020  \u46497 \u51008  \u49373 \u48152 \u51453  \u44536 \u45824 \u47196 \u50688 \u45796 . \u46608  \u45796 \u47480  \u48512 \u51064 \u51008  \u46497  \u48152 \u51453 \u51012  \u54664 \u51004 \u45208  \u50724 \u54980  3\u49884 \u44032  \u46104 \u50632 \u51004 \u48064 \u47196  \u50900 \u50836 \u51068 \u44620 \u51648  \u46160 \u50612 \u46160 \u44592 \u47196  \u54664 \u45716 \u45936  \u51060 \u53951 \u45216  \u48376 \u51593  \u48268 \u50024  \u54616 \u45208 \u45784 \u51032  \u45733 \u47141 \u51004 \u47196  \u54988 \u47469 \u54620  \u46497 \u51004 \u47196  \u44396 \u50892 \u51256  \u51080 \u50632 \u45796 . \u50612 \u46500  \u49324 \u46988 \u51008  \u53664 \u50836 \u51068  \u50724 \u54980  3\u49884 \u44032  \u51648 \u45208 \u49436  \u46497 \u51012  \u44396 \u50892  \u44536  \u51060 \u53951 \u45216  \u50500 \u52840 \u50640  \u48288 \u50612  \u48372 \u45768  \u44144 \u44592 \u49436  \u54588 \u44032  \u45208 \u50772 \u45796 . \u51060 \u50752  \u44057 \u51060  \u53552 \u47924 \u45768 \u50630 \u44256  \u48120 \u49888 \u51201 \u51064  \u51060 \u50556 \u44592 \u47196  \u51068 \u50836 \u51068 \u51032  \u50745 \u54840 \u51088 \u46308 \u51008  \u44536 \u45216 \u51032  \u49888 \u49457 \u49457 \u51012  \u50745 \u54840 \u54644  \u48372 \u44256 \u51088  \u45432 \u47141 \u54616 \u50688 \u45796  (Roger de Hoveden, An-nals, vol.2, pp.528~530 \u52280 \u51312 ).\
\uc0\u49828 \u53076 \u53952 \u47004 \u46300 \u50640 \u49436 \u46020  \u50689 \u44397 \u50640 \u49436 \u52376 \u47100  \u44256 \u45824 \u51032  \u50504 \u49885 \u51068 \u51032  \u51068 \u48512 \u48516 \u44284  \u51068 \u50836 \u51068 \u51012  \u50672 \u44208 \u49884 \u53428 \u51004 \u47196 \u50024  \u51068 \u50836 \u51068 \u51012  \u53356 \u44172  \u51316 \u51473 \u54616 \u44172  \u46104 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44144 \u47337 \u54616 \u44172  \u51648 \u53020 \u50556  \u54624  \u49884 \u44036 \u51008  \u45804 \u46992 \u45796 . \u49828 \u53076 \u53952 \u47004 \u46300  \u50773 \u51060  \u45236 \u47536  \u52825 \u47161 \u50640 \u45716  \'93\u53664 \u50836 \u51068  \u51221 \u50724  12\u49884 \u48512 \u53552  \u44144 \u47337 \u54616 \u44172  \u51648 \u53020 \u51256 \u50556  \u54620 \u45796 \'94 (Morer, pp.290, 291) \u44256  \u46104 \u50632 \u44256  \u44536  \u49884 \u44036 \u48512 \u53552  \u50900 \u50836 \u51068  \u50500 \u52840 \u44620 \u51648  \u50612 \u46500  \u49324 \u46988 \u46020  \u49464 \u49549 \u51201  \u51068 \u50640  \u51333 \u49324 \u54616 \u51648  \u47568  \u44163 \u51060 \u46972 \u44256  \u54616 \u50688 \u45796 .\
\uc0\u51068 \u50836 \u51068  \u49888 \u49457 \u49457 \u51012  \u54869 \u47549 \u54616 \u44592  \u50948 \u54616 \u50668  \u50728 \u44054  \u45432 \u47141 \u51012  \u44592 \u50872 \u50688 \u51020 \u50640 \u46020  \u48520 \u44396 \u54616 \u44256  \u48277 \u50773 \u44368 \u46020  \u51088 \u49888 \u46308 \u51008  \u50504 \u49885 \u51068 \u51032  \u44144 \u47337 \u54620  \u44428 \u50948 \u50752  \u44536 \u44163 \u51012  \u45824 \u49888 \u54616 \u50668  \u49373 \u44596  \u51068 \u50836 \u51068  \u51228 \u46020 \u44032  \u49324 \u46988 \u50640 \u44172 \u49436  \u45208 \u50772 \u45796 \u45716  \u49324 \u49892 \u51012  \u49828 \u49828 \u47196  \u44277 \u44277 \u50672 \u54616 \u44172  \u44256 \u48177 \u54616 \u50688 \u45796 . 16\u49464 \u44592 \u50640  \u51080 \u51008  \u48277 \u50773 \u44368  \u54924 \u51032 \u45716  \u50500 \u47000 \u50752  \u44057 \u51060  \u48516 \u47749 \u55176  \u50616 \u47749 \u54616 \u50688 \u45796 . \'93\u47784 \u46304  \u44536 \u47532 \u49828 \u46020 \u51064 \u51008  \u51228 \u52832 \u51068 \u51060  \u54616 \u45208 \u45784 \u44760 \u49436  \u49457 \u48324 \u54616 \u49888  \u45216 \u51060 \u47728  \u50976 \u45824 \u51064 \u49104 \u47564  \u50500 \u45768 \u46972  \u54616 \u45208 \u45784 \u51012  \u44221 \u48176 \u54616 \u45432 \u46972 \u44256  \u44277 \u50616 \u54616 \u45716  \u51088 \u46308 \u51060  \u44536  \u49324 \u49892 \u51012  \u51064 \u51221 \u54616 \u44256  \u51648 \u53020 \u50724 \u45912  \u45216 \u51076 \u51012  \u44592 \u50613 \u54644 \u50556  \u54620 \u45796 . \u44536 \u47084 \u45208  \u50864 \u47532  \u44536 \u47532 \u49828 \u46020 \u51064 \u46308 \u51008  \u44536 \u46308 \u51032  \u50504 \u49885 \u51068 \u51012  \u51452 \u51032  \u45216 \u47196  \u48320 \u44221 \u54616 \u50688 \u45796 \'94 (S.Bliss, Memoirs of Wm.Miller, pp.281, 282). \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51012  \u54632 \u48512 \u47196  \u48320 \u44221 \u54620  \u51088 \u46308 \u51008  \u44536 \u46308 \u51060  \u54620  \u51068 \u51060  \u50612 \u46500  \u51068 \u51064 \u44032 \u47484  \u47784 \u47476 \u44256  \u54620  \u44163 \u51060  \u50500 \u45768 \u50632 \u45796 . \u44536 \u46308 \u51008  \u44256 \u51032 \u51201 \u51004 \u47196  \u44536 \u46308  \u51088 \u49888 \u51012  \u54616 \u45208 \u45784 \u48372 \u45796  \u45458 \u51060 \u44256  \u51080 \u50632 \u45796 .\
