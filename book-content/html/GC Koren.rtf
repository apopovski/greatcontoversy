\uc0\u50689 \u50896  \u51648 \u50725 \u49444 \u51008  \u48148 \u48296 \u47200 \u51060  \u47784 \u46304  \u45208 \u46972 \u50640  \u47560 \u49884 \u50864 \u44256  \u51080 \u45716  \'93\u51652 \u45432 \u51032  \u54252 \u46020 \u51452 \'94\u46972 \u45716  \u44144 \u51667  \u44368 \u47532  \u51473  \u54616 \u45208 \u51060 \u45796  (\u44228  14:8, 17:2 \u52280 \u51312 ). \u44536 \u47088 \u45936  \u44536 \u47532 \u49828 \u46020 \u51032  \u51333 \u46308 \u51060  \u51060 \u47088  \u51060 \u45800 \u49444 \u51012  \u48155 \u50500 \u46308 \u51060 \u44256  \u44144 \u47337 \u54620  \u45800 \u50640 \u49436  \u44536 \u44163 \u51012  \u51204 \u54620 \u45796 \u45716  \u44163 \u51008  \u49892 \u47196  \u51060 \u54644 \u54624  \u49688  \u50630 \u45716  \u51068 \u51060 \u45796 . \u44536 \u46308 \u51008  \u47560 \u52824  \u44144 \u51667  \u50504 \u49885 \u51068 \u51012  \u47196 \u47560 \u44368 \u50640 \u49436  \u48155 \u51008  \u44163 \u52376 \u47100  \u44536 \u44163 \u46020  \u47196 \u47560 \u44368 \u47196 \u48512 \u53552  \u48155 \u50520 \u45796 . \u50948 \u45824 \u54616 \u44256  \u49440 \u47049 \u54620  \u49324 \u46988 \u46308 \u51060  \u44536 \u44163 \u51012  \u44032 \u47476 \u52432  \u50728  \u44163 \u51060  \u49324 \u49892 \u51060 \u45796 . \u44536 \u47084 \u45208  \u51060  \u47928 \u51228 \u50640  \u45824 \u54616 \u50668  \u44536 \u46308 \u51060  \u48155 \u51008  \u48731 \u51008  \u50864 \u47532 \u44032  \u48155 \u51008  \u48731 \u44284  \u44057 \u51648  \u50506 \u50520 \u45796 . \u44536 \u46308 \u51008  \u50724 \u51649  \u44536 \u46308 \u51032  \u49884 \u45824 \u50640  \u51452 \u50612 \u51652  \u48731 \u50640  \u45824 \u54616 \u50668 \u47564  \u52293 \u51076 \u51060  \u51080 \u50632 \u45796 . \u50864 \u47532 \u45716  \u50864 \u47532  \u49884 \u45824 \u50640  \u48708 \u52824 \u45716  \u48731 \u50640  \u45824 \u54616 \u50668  \u52293 \u51076 \u51060  \u51080 \u45796 . \u47564 \u51068  \u50864 \u47532 \u44032  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51032  \u51613 \u44144 \u47484  \u48260 \u47532 \u44256  \u50864 \u47532 \u51032  \u49440 \u51312 \u46308 \u51060  \u44032 \u47476 \u52452 \u45796 \u45716  \u51060 \u50976 \u47196  \u44144 \u51667  \u44368 \u47532 \u47484  \u48155 \u50500 \u46308 \u51060 \u44172  \u46104 \u47732  \u50864 \u47532 \u45716  \u48148 \u48296 \u47200 \u50640  \u49440 \u44256 \u46108  \u51221 \u51396 \u47484  \u48155 \u44172  \u46108 \u45796 . \u50864 \u47532 \u45716  \u48148 \u48296 \u47200 \u51032  \u44032 \u51613 \u54620  \u46021 \u51452 \u47484  \u47560 \u49884 \u44172  \u46108 \u45796 .\
\uc0\u46608 \u54620  \u50689 \u50896  \u51648 \u50725 \u49444 \u51012  \u48152 \u45824 \u54616 \u45716  \u47566 \u51008  \u48512 \u47448 \u51032  \u49324 \u46988 \u46308 \u51008  \u44536 \u44163 \u44284  \u48152 \u45824 \u46104 \u45716  \u50724 \u47448 \u50640  \u48736 \u51256  \u51080 \u45796 . \u44536 \u46308 \u51008  \u49457 \u44221 \u51060  \u54616 \u45208 \u45784 \u44760 \u49436  \u49324 \u46993 \u44284  \u44557 \u55100 \u51060  \u47566 \u51004 \u49888  \u48516 \u51004 \u47196  \u45208 \u53440 \u45236 \u44256  \u51080 \u45716  \u44163 \u51012  \u50508 \u48064 \u47196  \u44536 \u48516 \u44760 \u49436  \u45817 \u49888 \u51032  \u54588 \u51312 \u47932 \u46308 \u51012  \u50689 \u50896 \u54620  \u51648 \u50725  \u48520 \u50640  \u45912 \u51648 \u49892  \u44163 \u51060 \u46972 \u45716  \u49324 \u49892 \u51012  \u48127 \u51648  \u50506 \u45716 \u45796 . \u44536 \u47084 \u45208  \u44536 \u46308 \u51008  \u50689 \u54844 \u51060  \u44540 \u48376 \u51201 \u51004 \u47196  \u48520 \u47736 \u51060 \u46972 \u44256  \u48127 \u44256  \u51080 \u51004 \u48064 \u47196  \u51064 \u47448 \u45716  \u52572 \u51333 \u51201 \u51004 \u47196  \u47784 \u46160  \u44396 \u50896 \u51012  \u48155 \u51012  \u49688 \u48150 \u50640  \u50630 \u45796 \u44256  \u44208 \u47200 \u51012  \u45236 \u47536 \u45796 . \u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u49457 \u44221 \u50640  \u46160 \u47140 \u50868  \u44221 \u44256 \u46308 \u51060  \u44592 \u47197 \u46104 \u50612  \u51080 \u45716  \u44163 \u51008  \u45800 \u49692 \u55176  \u49324 \u46988 \u46308 \u51012  \u49692 \u51333 \u54616 \u44172  \u54616 \u44256 \u51088  \u50948 \u54801 \u54616 \u45716  \u44163 \u51060 \u47728  \u44544 \u51088  \u44536 \u45824 \u47196  \u48152 \u46300 \u49884  \u49457 \u52712 \u46104 \u45716  \u44163 \u51060  \u50500 \u45768 \u46972 \u44256  \u49373 \u44033 \u54620 \u45796 . \u44536 \u47084 \u48064 \u47196  \u51396 \u51064 \u51060  \u48708 \u47197  \u51060 \u44592 \u51201  \u53132 \u46973 \u51012  \u44228 \u49549 \u54616 \u44256  \u54616 \u45208 \u45784 \u51032  \u50836 \u44396 \u47484  \u47924 \u49884 \u54624 \u51648 \u46972 \u46020  \u52572 \u54980 \u50640 \u45716  \u54616 \u45208 \u45784 \u51032  \u51008 \u52509 \u51012  \u48155 \u51012  \u44163 \u51012  \u44592 \u45824 \u54624  \u49688  \u51080 \u44172  \u46108 \u45796 . \u51060 \u47084 \u54620  \u44368 \u47532 \u45716  \u54616 \u45208 \u45784 \u51032  \u51088 \u48708 \u47564  \u49373 \u44033 \u54616 \u44256  \u44536 \u48516 \u51032  \u44277 \u51032 \u47484  \u47924 \u49884 \u54616 \u44592  \u46412 \u47928 \u50640  \u50977 \u49888 \u51201  \u47560 \u51020 \u51012  \u51600 \u44161 \u44172  \u54616 \u44256  \u50501 \u51064 \u46308 \u47196  \u54616 \u50668 \u44552  \u51396 \u50501 \u51012  \u48276 \u54616 \u44592 \u50640  \u45812 \u45824 \u54616 \u44172  \u54644 \u51456 \u45796 .\
\uc0\u48372 \u54200  \u44396 \u51228 \u49444 \u51012  \u48127 \u45716  \u51088 \u46308 \u51060  \u44536 \u46308 \u51032  \u50689 \u54844 \u51012  \u54028 \u47736 \u49884 \u53412 \u45716  \u44368 \u47532 \u47484  \u51648 \u51648 \u54616 \u44592  \u50948 \u54616 \u50668  \u50612 \u46523 \u44172  \u49457 \u44221 \u51012  \u44257 \u54644 \u54616 \u44256  \u51080 \u45716 \u51648  \u48372 \u50668  \u51452 \u45716  \u45936 \u45716  \u44536 \u46308  \u51088 \u49888 \u51032  \u47568 \u51012  \u51064 \u50857 \u54616 \u45716  \u44163 \u51004 \u47196  \u52649 \u48516 \u54616 \u45796 . \u44049 \u51089 \u49828 \u47088  \u49324 \u44256 \u47196  \u51593 \u49324 \u54620  \u48127 \u51648  \u50506 \u45716  \u52397 \u45380 \u51032  \u51109 \u47168 \u49885 \u50640 \u49436  \u48372 \u54200  \u44396 \u51228 \u49444 \u51012  \u48127 \u45716  \u54620  \u47785 \u49324 \u45716  \u45796 \u50967 \u50640  \u44288 \u54616 \u50668  \u50420  \u49457 \u44221 \u51208 , \u44263  \'93\u50516 \u45436 \u51008  \u51060 \u48120  \u51453 \u50632 \u51004 \u48064 \u47196  \u50773 \u51060  \u50948 \u47196 \u47484  \u48155 \u50520 \u51020 \u51060 \u45908 \u46972 \'94 (\u49340 \u54616  13:39) \u45716  \u44396 \u51208 \u51012  \u51064 \u50857 \u54616 \u50688 \u45796 .\
\uc0\u44536  \u49444 \u44368 \u51088 \u45716  \u47568 \u54616 \u50688 \u45796 . \'93\u45208 \u45716  \u51396  \u44032 \u50868 \u45936 \u49436  \u51060  \u49464 \u49345 \u51012  \u46496 \u45212  \u51088 , \u54841  \u49696 \u52712 \u54620  \u49345 \u53468 \u50640 \u49436  \u51453 \u51008  \u51088 , \u48276 \u51396 \u47196  \u49352 \u48744 \u44059 \u44172  \u47932 \u46304  \u44536 \u46308 \u51032  \u46160 \u47336 \u47560 \u44592 \u47484  \u50491 \u51648  \u47803 \u54620  \u52292  \u51453 \u51008  \u51088 , \u51060  \u52397 \u45380 \u52376 \u47100  \u50500 \u51649  \u49888 \u50521 \u51012  \u44256 \u48177 \u54616 \u51648  \u47803 \u54616 \u44256  \u48127 \u51020 \u51032  \u44221 \u54744 \u51012  \u44054 \u51648  \u47803 \u54620  \u52292  \u51453 \u51008  \u51088 \u46308 \u51032  \u50868 \u47749 \u51060  \u50612 \u46523 \u44172  \u46112  \u44163 \u51064 \u44032  \u54616 \u45716  \u51656 \u47928 \u51012  \u51333 \u51333  \u48155 \u45716 \u45796 . \u50864 \u47532 \u45716  \u49457 \u44221 \u50640 \u49436  \u47564 \u51313 \u51012  \u50619 \u45716 \u45796 . \u49457 \u44221 \u51060  \u51060  \u46160 \u47140 \u50868  \u47928 \u51228 \u50640  \u44288 \u54616 \u50668  \u45813 \u51012  \u54644 \u51452 \u44592  \u46412 \u47928 \u51060 \u45796 . \u50516 \u45436 \u51008  \u52280 \u51004 \u47196  \u51396 \u47484  \u47566 \u51060  \u51648 \u50632 \u44256  \u54924 \u44060 \u54616 \u51648  \u50506 \u50520 \u45796 . \u44536 \u45716  \u49696 \u51452 \u51221 \u48197 \u51060 \u47196  \u49696 \u50640  \u52712 \u54620  \u52292  \u51453 \u51076 \u51012  \u45817 \u54664 \u45796 . \u45796 \u50967 \u51008  \u54616 \u45208 \u45784 \u51032  \u49440 \u51648 \u51088 \u50688 \u45796 . \u44536 \u45716  \u50516 \u45436 \u51060  \u45236 \u49464 \u50640 \u49436  \u51339 \u51008  \u51068 \u51012  \u45817 \u54624  \u44163 \u51064 \u51648  \u45208 \u49244  \u51068 \u51012  \u45817 \u54624  \u44163 \u51064 \u51648  \u44600 \u55113 \u51012  \u50508 \u50520 \u51020 \u50640  \u53952 \u47548 \u50630 \u45796 . \u45