\f1\b0 \cf0 \
\uc0\u48128 \u47084 \u50752  \u44536 \u51032  \u46041 \u50669 \u51088 \u46308 \u51008  \u52376 \u51020 \u50640  2300\u51068 \u51060  1844\u45380  \u48388 \u50640  \u45149 \u45216  \u44163 \u51004 \u47196  \u48127 \u50632 \u51004 \u45208 , \u44536  \u50696 \u50616 \u51008  \u44536  \u54644  \u44032 \u51012 \u50640  \u47560 \u52832  \u44163 \u51012  \u44032 \u47532 \u53412 \u44256  \u51080 \u45796  (\u48512 \u47197  27 \u52280 \u51312 ). \u51060  \u51216 \u50640  \u45824 \u54620  \u50724 \u54644 \u45716  \u44536  \u54644  \u48388 \u50640  \u51452 \u45784 \u51032  \u51116 \u47548 \u51060  \u51080 \u51012  \u44163 \u51004 \u47196  \u49373 \u44033 \u54616 \u44256  \u44592 \u45796 \u47532 \u45912  \u49324 \u46988 \u46308 \u50640 \u44172  \u54844 \u46976 \u44284  \u49892 \u47581 \u51012  \u52488 \u47000 \u54616 \u50688 \u45796 . \u44536 \u47111 \u45796 \u44256  \u54644 \u49436  2300\u51068 \u51060  1844\u45380 \u50640  \u47560 \u52824 \u44256 , \u44536  \u46412 \u50640  \u49457 \u49548 \u44032  \u51221 \u44208 \u54616 \u44172  \u46104 \u47532 \u46972 \u44256  \u54620  \u44536  \u53360  \u49324 \u44148 \u50640  \u45824 \u54620  \u51452 \u51109 \u51012  \u50557 \u54868 \u49884 \u53420  \u49688 \u45716  \u50630 \u50632 \u45796 .\
\uc0\u48128 \u47084 \u45716  \u50896 \u47000  \u49457 \u44221 \u51060  \u54616 \u45208 \u45784 \u51032  \u44228 \u49884 \u51076 \u51012  \u51613 \u47749 \u54616 \u44592  \u50948 \u54616 \u50668  \u44536  \u50672 \u44396 \u50640  \u52265 \u49688 \u54616 \u50688 \u51004 \u48064 \u47196  \u44536 \u44032  \u51648 \u44552  \u50619 \u51008  \u44536  \u44208 \u47200 \u50640  \u51060 \u47476 \u47532 \u46972 \u44256 \u45716  \u52628 \u54840 \u46020  \u49373 \u44033 \u54616 \u51648  \u50506 \u50520 \u45796 . \u44536 \u47084 \u48064 \u47196  \u44536 \u45716  \u50672 \u44396 \u51032  \u44208 \u44284 \u47484  \u51088 \u44592  \u51088 \u49888 \u51032  \u44277 \u47196 \u47196  \u49340 \u51012  \u49688 \u44032  \u50630 \u50632 \u45796 . \u44536 \u47084 \u45208  \u49457 \u44221 \u49345  \u51613 \u44144 \u45716  \u45320 \u47924 \u46020  \u48516 \u47749 \u54616 \u44256  \u54869 \u49892 \u54616 \u50688 \u51004 \u48064 \u47196  \u44536 \u45716  \u44536 \u44163 \u51012  \u47924 \u49884 \u54644  \u48260 \u47540  \u49688  \u50630 \u50632 \u45796 .\
\uc0\u44536 \u45716  2\u45380  \u46041 \u50504  \u49457 \u44221  \u50672 \u44396 \u50640  \u51204 \u45392 \u54616 \u50688 \u44256 , 1818\u45380 \u50640  \u44536 \u45716  \u48520 \u44284  25\u45380  \u51060 \u45236 \u50640  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u45817 \u49888 \u51032  \u48177 \u49457 \u51012  \u44396 \u49549 \u54616 \u49884 \u44592  \u50948 \u54616 \u50668  \u45796 \u49884  \u50724 \u49892  \u44163 \u51060 \u46972 \u45716  \u50628 \u49689 \u54620  \u54869 \u49888 \u51012  \u44032 \u51648 \u44172  \u46104 \u50632 \u45796 . \u48128 \u47084 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u54616 \u50688 \u45796 . \'93\u44536  \u44592 \u49244  \u50526 \u45216 \u51012  \u45236 \u45796 \u48380  \u46412  \u45208 \u51032  \u47560 \u51020 \u51012  \u52649 \u47564 \u52992  \u54620  \u44536  \u51600 \u44144 \u50880 \u44284  \u44396 \u49549 \u48155 \u51008  \u49324 \u46988 \u46308 \u51032  \u44592 \u49256 \u50640  \u46041 \u52280 \u54616 \u44256 \u51088  \u54616 \u45716  \u45208 \u51032  \u47560 \u51020 \u51032  \u50676 \u47148 \u54620  \u49548 \u47581 \u50640  \u45824 \u54644 \u49436  \u45208 \u45716  \u47568 \u54624  \u54596 \u50836 \u44032  \u50630 \u45796 . \u49457 \u44221 \u51008  \u51060 \u51228  \u45208 \u50640 \u44172  \u54616 \u45208 \u51032  \u49352 \u47196 \u50868  \u52293 \u51060  \u46104 \u50632 \u45796 . \u49457 \u44221 \u51008  \u51221 \u47568 \u47196  \u45436 \u47532 \u51201 \u51004 \u47196  \u44148 \u51204 \u54620  \u52293 \u51060 \u50632 \u45796 . \u51648 \u44552 \u44620 \u51648  \u49457 \u44221 \u51032  \u44368 \u54984 \u51012  \u51060 \u54644 \u54624  \u49688  \u50630 \u44256 , \u49888 \u48708 \u51201 \u51060 \u44256 , \u48516 \u47749 \u54616 \u51648  \u47803 \u54620  \u44163 \u51004 \u47196  \u50668 \u44220 \u51004 \u45208 , \u51060 \u51228 \u45716  \u44536  \u44144 \u47337 \u54620  \u54168 \u51060 \u51648 \u50640  \u45208 \u53440 \u45212  \u48157 \u51008  \u48731  \u50526 \u50640  \u44536 \u47088  \u44163 \u46308 \u51060  \u47784 \u46160  \u45208 \u51032  \u47560 \u51020 \u50640 \u49436  \u49324 \u46972 \u51256  \u48260 \u47160 \u45796 . \u50500 \u50500 ! \u51652 \u47532 \u45716  \u50620 \u47560 \u45208  \u48157 \u44256  \u50689 \u44305 \u49828 \u47101 \u44172  \u45208 \u53440 \u45228 \u45912 \u44032 ! \u51333 \u47000 \u50640  \u47784 \u49692 \u46104 \u44256  \u51312 \u54868 \u46104 \u51648  \u47803 \u54620  \u44163 \u46308 \u51060  \u51060 \u51228  \u45796  \u49324 \u46972 \u51276 \u45796 . \u48708 \u47197  \u51060 \u54644 \u54624  \u49688 \u45716  \u51080 \u50632 \u51004 \u45208  \u47564 \u51313 \u54624  \u47564 \u53372  \u51060 \u54644 \u46104 \u51648  \u47803 \u54664 \u45912  \u47566 \u51008  \u48512 \u48516 \u46308 \u51060  \u51080 \u50632 \u45796 . \u44536 \u47084 \u45208  \u51060 \u51228 \u45716  \u44144 \u44592 \u49436  \u47566 \u51008  \u48731 \u51060  \u45208 \u50752 \u49436  \u45208 \u51032  \u51648 \u44552 \u44620 \u51648 \u51032  \u50612 \u46177 \u45912  \u47560 \u51020 \u51012  \u48708 \u52628 \u50612  \u51452 \u50632 \u51004 \u48064 \u47196  \u47560 \u52840 \u45236  \u45208 \u45716  \u49457 \u44221  \u50672 \u44396 \u50640 \u49436  \u50619 \u51004 \u47532 \u46972 \u44256  \u44592 \u45824 \u54616 \u51648  \u47803 \u54664 \u45912  \u53360  \u44592 \u49256 \u51012  \u45712 \u45180 \u44172  \u46104 \u50632 \u45796 \'94 (S.Bliss, Memoirs of Wm.Miller, pp.76, 77).\
\'93\uc0\u51060 \u52376 \u47100  \u51473 \u45824 \u54620  \u49324 \u44148 \u51060  \u49457 \u44221 \u50640  \u50696 \u50616 \u46104 \u50612  \u51080 \u44256 , \u44536 \u44163 \u51060  \u50500 \u51452  \u51687 \u51008  \u44592 \u44036  \u45236 \u50640  \u51060 \u47336 \u50612 \u51656  \u44163 \u51060 \u46972 \u45716  \u50628 \u49689 \u54620  \u54869 \u49888 \u51012  \u44032 \u51648 \u44172  \u46104 \u51088  \u45208 \u51032  \u47560 \u51020 \u50640  \u53360  \u55192 \u51004 \u47196  \u51068 \u50612 \u45208 \u45716  \u51032 \u47928 \u51008  \u51060 \u47111 \u44172  \u45236  \u47560 \u51020 \u51012  \u50880 \u51649 \u51064  \u48516 \u47749 \u54620  \u51613 \u44144 \u47484  \u48376  \u51088 \u49888 \u51060  \u49464 \u49345 \u50640  \u45824 \u54620  \u51032 \u47924 \u47484  \u50612 \u46523 \u44172  \u44048 \u45817 \u54624  \u44163 \u51064 \u44032  \u54616 \u45716  \u44163 \u51060 \u50632 \u45796 \'94 (S.Bliss, Memoirs of Wm.Miller, p.81). \u44536 \u45716  \u51088 \u44592 \u44032  \u48155 \u51008  \u48731 \u51012  \u45796 \u47480  \u49324 \u46988 \u46308 \u50640 \u44172  \u45208 \u45572 \u50612 \u51452 \u45716  \u44163 \u51060  \u51088 \u44592 \u51032  \u51032 \u47924 \u46972 \u44256  \u45712 \u45188  \u49688 \u48150 \u50640  \u50630 \u50632 \u45796 . \u44536 \u45716  \u48127 \u51648  \u50500 \u45768 \u54616 \u45716  \u51088 \u46308 \u47196 \u48512 \u53552  \u48152 \u45824 \u47484  \u48155 \u51012  \u44163 \u51012  \u49373 \u44033 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u44536 \u47532 \u49828 \u46020 \u51064 \u46308 \u51060  \u49324 \u46993 \u54616 \u45432 \u46972 \u44256  \u44256 \u48177 \u54620  \u44536 \u46308 \u51032  \u44396 \u51452 \u47484  \u47564 \u45216  \u49548 \u47581 \u51012  \u48148 \u46972 \u48372 \u44256  \u44592 \u48848 \u54624  \u44163 \u51012  \u54869 \u49888 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u51032  \u50976 \u51068 \u54620  \u50684 \u47140 \u45716  \u44263  \u49457 \u52712 \u46112  \u50689 \u44305 \u49828 \u47084 \u50868  \u44396 \u50896 \u51012  \u51648 \u45208 \u52824 \u44172  \u44592 \u48848 \u54620  \u45208 \u47672 \u51648  \u44536  \u51652 \u47532 \u44032  \u51228 \u49884 \u46112  \u46412  \u49457 \u44221  \u47568 \u50432 \u51012  \u52649 \u48516 \u55176  \u44160 \u53664 \u54616 \u51648  \u50506 \u44256  \u44536  \u44368 \u47532  \u44536 \u45824 \u47196  \u48155 \u50500 \u46308 \u51060 \u45716  \u47924 \u47532 \u44032  \u47566 \u51648  \u50506 \u51012 \u44620  \u54616 \u45716  \u50684 \u47140 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u45716  \u51088 \u44592 \u44032  \u49892 \u49688 \u47196  \u45796 \u47480  \u49324 \u46988 \u46308 \u51012  \u51096 \u47803  \u51064 \u46020 \u54616 \u51648 \u45208  \u50506 \u51012 \u44620  \u50684 \u47140 \u54616 \u50668  \u44536 \u44163 \u51012  \u48156 \u54364 \u54616 \u44592 \u47484  \u51452 \u51200 \u54616 \u50688 \u45796 . \u44536 \u45716  \u51088 \u44592 \u44032  \u50619 \u51008  \u44208 \u47200 \u51012  \u51648 \u51648 \u54644  \u51460  \u49688  \u51080 \u45716  \u51613 \u44144 \u46308 \u51012  \u49352 \u49340  \u44256 \u47140 \u54644  \u48372 \u44256 , \u51088 \u44592 \u44032  \u50612 \u47157 \u44172  \u49373 \u44033 \u54664 \u45912  \u47784 \u46304  \u47928 \u51228 \u46308 \u51012  \u49464 \u48128 \u54616 \u44172  \u44160 \u53664 \u54644  \u48372 \u50520 \u45796 . \u44536 \u45716  \u47560 \u52840 \u45236  \u54663 \u48731 \u50640  \u49324 \u46972 \u51648 \u45716  \u50504 \u44060 \u52376 \u47100  \u47784 \u46304  \u51109 \u50528 \u44032  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51032  \u48731  \u50526 \u50640 \u49436  \u49324 \u46972 \u51256 \u48260 \u47532 \u45716  \u44163 \u51012  \u48156 \u44204 \u54616 \u50688 \u45796 . \u44536  \u54980  5\u45380 \u51012  \u51648 \u45236 \u45716  \u46041 \u50504  \u44536 \u45716  \u51088 \u44592 \u51032  \u51452 \u51109 \u51060  \u51221 \u54869 \u54616 \u45796 \u45716  \u44163 \u51012  \u54869 \u49888 \u54616 \u44172  \u46104 \u50632 \u45796 .\
