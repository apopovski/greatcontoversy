\f1\b0 \cf0 \
\uc0\u44592 \u48324 \u51012  \u48155 \u50500 \u46308 \u51064  \u49324 \u46988 \u46308 \u51008  \u47568 \u54624  \u49688  \u50630 \u45716  \u49548 \u47581 \u51004 \u47196  \u44396 \u51452 \u51032  \u51116 \u47548 \u51012  \u44592 \u45796 \u47160 \u45796 . \u44536 \u46308 \u51060  \u50696 \u49688 \u45784 \u51012  \u47564 \u45216  \u44163 \u51004 \u47196  \u44592 \u45824 \u54664 \u45912  \u44536  \u49884 \u44036 \u51008  \u45576 \u50526 \u50640  \u48149 \u46160 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u47588 \u50864  \u50628 \u49689 \u54616 \u44172  \u44536  \u49884 \u44036 \u51012  \u44592 \u45796 \u47532 \u44256  \u51080 \u50632 \u45796 . \u44536 \u46308 \u51008  \u54616 \u45208 \u45784 \u44284  \u44036 \u44201  \u50630 \u45716  \u44368 \u53685 \u51012  \u54616 \u47732 \u49436  \u44536 \u46308  \u50526 \u50640  \u45459 \u51064  \u44305 \u47749 \u54620  \u48120 \u47000 \u47196  \u47560 \u51020 \u51060  \u54217 \u50504 \u54616 \u50688 \u45796 . \u44536  \u55148 \u47581 \u44284  \u49888 \u47280 \u47484  \u44221 \u54744 \u54664 \u45912  \u49324 \u46988 \u46308 \u51008  \u45817 \u49884 \u51032  \u44536  \u44480 \u51473 \u54620  \u44592 \u45796 \u47548 \u51032  \u49884 \u44036 \u51012  \u46020 \u47924 \u51648  \u51082 \u50612 \u48260 \u47540  \u49688  \u50630 \u50632 \u45796 . \u44536 \u45216 \u51012  \u47751  \u51452 \u51068  \u50526 \u46160 \u44256  \u44536 \u46308 \u51008  \u45824 \u48512 \u48516  \u49464 \u49549 \u51201 \u51064  \u49324 \u50629 \u51012  \u44536 \u52452 \u45796 . \u51652 \u49892 \u54620  \u49888 \u51088 \u46308 \u51008  \u47560 \u52824  \u51453 \u45716  \u49324 \u46988 \u51060  \u51076 \u51333  \u49884 \u50640  \u47751  \u49884 \u44036  \u46041 \u50504  \u49464 \u49345  \u49324 \u47932 \u51012  \u52488 \u50900 \u54616 \u50668  \u47749 \u49345 \u54616 \u45716  \u44163 \u52376 \u47100  \u51088 \u44592 \u46308 \u51032  \u47560 \u51020 \u49549 \u51032  \u49373 \u44033 \u44284  \u44048 \u51221 \u51012  \u49332 \u54196 \u48372 \u50520 \u45796 . \u49849 \u52380  \u50696 \u48373 \u51008  \u51204 \u54784  \u47564 \u46308 \u51648  \u50506 \u50520 \u45796  (\u48512 \u47197  30 \u52280 \u51312 ). \u44536 \u47084 \u45208  \u44396 \u51452 \u47484  \u50689 \u51217 \u54624  \u51456 \u48708 \u44032  \u46104 \u50632 \u45796 \u45716  \u45236 \u51201  \u51613 \u44144 \u51032  \u54596 \u50836 \u49457 , \u44263  \u44536 \u46308 \u51032  \u49900 \u47161 \u51032  \u49692 \u44208 \u51012  \u45208 \u53440 \u45236 \u45716  \u55152 \u50743 , \u44536 \u47532 \u49828 \u46020 \u51032  \u49549 \u51396 \u54616 \u49884 \u45716  \u54588 \u47196  \u51396 \u50640 \u49436  \u44648 \u45143 \u54616 \u44172  \u46108  \u54408 \u49457 \u51012  \u44032 \u51256 \u50556  \u54624  \u54596 \u50836 \u49457 \u51012  \u45712 \u44808 \u45796 . \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u51060 \u46972 \u44256  \u44277 \u50616 \u54616 \u45716  \u51088 \u46308 \u51060  \u51648 \u44552 \u46020  \u44536  \u46412 \u50752  \u44057 \u51060  \u49828 \u49828 \u47196 \u47484  \u49332 \u54588 \u44256 , \u50676 \u47148 \u54616 \u44256 , \u54869 \u44256 \u54620  \u49888 \u50521 \u51012  \u44032 \u51652 \u45796 \u47732  \u50620 \u47560 \u45208  \u51339 \u51012 \u44620 . \u47564 \u51068  \u44536 \u46308 \u51060  \u50724 \u45720 \u45216 \u50640 \u46020  \u44536 \u47111 \u44172  \u54616 \u45208 \u45784  \u50526 \u50640  \u44216 \u48708 \u54616 \u44256 , \u51008 \u54812 \u51032  \u48372 \u51340  \u50526 \u50640 \u49436  \u53444 \u50896 \u54620 \u45796 \u47732  \u44536 \u46308 \u51008  \u51648 \u44552  \u44536 \u46308 \u51060  \u44032 \u51652  \u44163 \u48372 \u45796  \u55016 \u50476  \u45908  \u54413 \u48512 \u54620  \u44221 \u54744 \u51012  \u44032 \u51648 \u44172  \u46104 \u50632 \u51012  \u44163 \u51060 \u45796 . \u50724 \u45720 \u45216 \u50640 \u45716  \u44592 \u46020 \u54616 \u45716  \u51068 \u51060  \u45320 \u47924 \u46020  \u51201 \u44256 , \u52649 \u49900 \u51004 \u47196  \u51396 \u47484  \u44648 \u45803 \u45716  \u51068 \u51060  \u45320 \u47924  \u51201 \u45796 . \u49328  \u49888 \u50521 \u51060  \u48512 \u51313 \u54616 \u44592  \u46412 \u47928 \u50640  \u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u44396 \u51452 \u44760 \u49436  \u54413 \u49457 \u55176  \u51452 \u49884 \u45716  \u51008 \u54812 \u47484  \u48512 \u51313 \u54616 \u44172  \u48155 \u44256  \u47564 \u45796 .\
\uc0\u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u48177 \u49457 \u51012  \u49884 \u54744 \u54616 \u49884 \u44592 \u47196  \u44228 \u54925 \u54616 \u49512 \u45796 . \u51452 \u45784 \u51032  \u49552 \u51060  \u50696 \u50616 \u51201  \u44592 \u44036 \u51032  \u44228 \u49328 \u50640 \u49436  \u49373 \u44596  \u52265 \u50724 \u47484  \u45934 \u50612  \u51452 \u49512 \u45796 . \u44536 \u47532 \u54616 \u50668  \u51116 \u47548 \u49888 \u46020 \u46308 \u51008  \u47932 \u47200 \u51060 \u50836  \u44032 \u51109  \u54617 \u49885 \u51060  \u47566 \u51008  \u48152 \u45824 \u54028 \u51032  \u54617 \u51088 \u46308 \u46020  \u44536 \u44163 \u51012  \u48156 \u44204 \u54616 \u51648  \u47803 \u54616 \u50688 \u45796 . \u44536  \u54617 \u51088 \u46308 \u51008  \u47568 \u54616 \u50688 \u45796 . \'93\u44536 \u45824 \u46308 \u51032  \u50696 \u50616 \u51201  \u44592 \u44036 \u50640  \u45824 \u54620  \u44228 \u49328 \u51008  \u50739 \u45796 . \u47924 \u49832  \u53360  \u49324 \u44148 \u51060  \u51068 \u50612 \u45216  \u44163 \u51008  \u49324 \u49892 \u51060 \u45796 . \u44536 \u47084 \u45208  \u44536 \u44163 \u51008  \u48128 \u47084 \u44032  \u50696 \u50616 \u54620  \u51068 \u44284  \u44057 \u51008  \u44163 \u51008  \u50500 \u45776  \u44163 \u51060 \u45796 . \u44536 \u44163 \u51008  \u49464 \u49345 \u51032  \u54924 \u44060 \u50836  \u44536 \u47532 \u49828 \u46020 \u51032  \u51116 \u47548 \u51008  \u50500 \u45768 \u45796 \'94 (\u48512 \u47197  31 \u52280 \u51312 ).\
\uc0\u44592 \u45824 \u54664 \u45912  \u49884 \u44036 \u51008  \u51648 \u45208 \u44052 \u51004 \u45208  \u44536 \u47532 \u46020 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u48177 \u49457 \u51012  \u44396 \u50896 \u54616 \u44592  \u50948 \u54616 \u50668  \u45208 \u53440 \u45208 \u51648  \u50500 \u45768 \u54616 \u49512 \u45796 . \u51652 \u49892 \u54620  \u49888 \u50521 \u44284  \u49324 \u46993 \u51004 \u47196  \u44396 \u51452 \u47484  \u48148 \u46972 \u48372 \u45912  \u49324 \u46988 \u46308 \u51008  \u50416 \u46356 \u50420  \u49892 \u47581 \u51012  \u45817 \u54616 \u50688 \u45796 . \u44536 \u47100 \u50640 \u46020  \u48520 \u44396 \u54616 \u44256  \u54616 \u45208 \u45784 \u51032  \u47785 \u51201 \u51008  \u49457 \u52712 \u46104 \u44256  \u51080 \u50632 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u49548 \u50948  \u51116 \u47548 \u51012  \u44592 \u45796 \u47532 \u45432 \u46972 \u44256  \u44277 \u50616 \u54616 \u45716  \u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u51012  \u49884 \u54744 \u54616 \u44256  \u44228 \u49512 \u45796 . \u44536 \u46308  \u51473 \u51032  \u47566 \u51008  \u49324 \u46988 \u51008  \u44277 \u54252  \u51060 \u50808 \u51032  \u50500 \u47924  \u45796 \u47480  \u46041 \u44592 \u44032  \u50630 \u50632 \u45796 . \u44536 \u46308 \u51032  \u49888 \u50521  \u44256 \u48177 \u51008  \u44536 \u46308  \u51088 \u49888 \u51032  \u47560 \u51020 \u50640 \u45208  \u49373 \u54876 \u50640  \u50500 \u47924 \u47088  \u50689 \u54693 \u51012  \u45180 \u52824 \u51648  \u47803 \u54616 \u50688 \u45796 . \u44592 \u45824 \u54664 \u45912  \u49324 \u44148 \u51060  \u51068 \u50612 \u45208 \u51648  \u50506 \u44172  \u46104 \u51088  \u44536 \u46308 \u51008  \u49892 \u47581 \u54616 \u51648  \u50506 \u45432 \u46972 \u44256  \u47568 \u54664 \u45796 . \u44536 \u46308 \u51008  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u51116 \u47548 \u54616 \u49884 \u47532 \u46972 \u44256  \u48127 \u51648  \u50506 \u50520 \u45796 \u44256  \u47568 \u54616 \u50688 \u45796 