\uc0\u54532 \u46972 \u54616 \u50640  \u51080 \u45716  \u52828 \u44396 \u46308 \u50640 \u44172  \u48372 \u45240  \u54200 \u51648 \u50640 \u49436  \u44536 \u45716  \u51060 \u47111 \u44172  \u47568 \u54616 \u50688 \u45796 . \'93\u45208 \u51032  \u54805 \u51228 \u46308 \u51060 \u50668 \'85\u45208 \u45716  \u50773 \u51032  \u53685 \u54665 \u44428 \u51012  \u44032 \u51648 \u44256  \u45208 \u51032  \u47566 \u51008  \u45824 \u51201 \u46308 \u51012  \u47564 \u45208 \u44256 \u51088  \u46496 \u45208 \u44032 \u44256  \u51080 \u45796 . \'85\u45208 \u45716  \u45208 \u51032  \u44396 \u51452 \u44032  \u46104 \u49884 \u45716  \u51204 \u45733 \u54616 \u49888  \u54616 \u45208 \u45784 \u44760  \u47784 \u46304  \u44163 \u51012  \u47585 \u44596 \u45796 . \u45236 \u44032  \u45733 \u55176  \u51200 \u46308 \u51012  \u45824 \u54637 \u54624  \u49688  \u51080 \u46020 \u47197  \u45208 \u51032  \u51077 \u50640  \u54616 \u45208 \u45784 \u51032  \u51648 \u54812 \u50752  \u44536 \u48516 \u51032  \u49888 \u51473 \u54616 \u49888  \u51221 \u49888 \u51012  \u45347 \u50612  \u51452 \u49884 \u44592 \u47484  \u44036 \u44396 \u54616 \u44256  \u51080 \u45716  \u44536 \u45824 \u46308 \u51032  \u50676 \u47148 \u54620  \u44592 \u46020 \u47484  \u54616 \u45208 \u45784 \u44760 \u49436  \u51025 \u45813 \u54616 \u49892  \u51460 \u47196  \u45208 \u45716  \u48127 \u45716 \u45796 . \u46608 \u54620  \u54616 \u45208 \u45784 \u44760 \u49436  \u45208 \u47484  \u45817 \u49888 \u51032  \u51652 \u47532 \u47196  \u44053 \u54616 \u44172  \u54616 \u49884 \u44592  \u50948 \u54616 \u50668  \u49457 \u47161 \u51012  \u51452 \u49884 \u44256 , \u49884 \u47144 \u51060 \u45208  \u44048 \u50725 \u51060 \u45208  \u54596 \u50836 \u54616 \u47732  \u51092 \u51064 \u54620  \u51453 \u51020 \u44620 \u51648 \u46972 \u46020  \u50857 \u44592  \u51080 \u44172  \u45817 \u54616 \u44172  \u54616 \u49892  \u51460 \u47196  \u48127 \u45716 \u45796 . \u50696 \u49688  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u49324 \u46993 \u54616 \u49884 \u45716  \u51088 \u45376 \u46308 \u51012  \u50948 \u54616 \u50668  \u44256 \u45212 \u51012  \u45817 \u54616 \u49512 \u45796 . \u44536 \u47532 \u44256  \u50864 \u47532 \u47196  \u54616 \u50668 \u44552 , \u50864 \u47532  \u51088 \u49888 \u51032  \u44396 \u50896 \u51012  \u50948 \u54616 \u50668  \u47784 \u46304  \u51068 \u50640  \u52280 \u51012  \u49688  \u51080 \u46020 \u47197  \u48376 \u51012  \u48372 \u50668  \u51452 \u49512 \u51004 \u45768  \u51060  \u50612 \u52236  \u45440 \u46972 \u50868  \u51068 \u51060  \u50500 \u45772 \u44032 . \u44536 \u48516 \u44760 \u49436 \u45716  \u54616 \u45208 \u45784 \u51060 \u49884 \u47728 , \u50864 \u47532 \u45716  \u44536 \u48516 \u51032  \u54588 \u51312 \u47932 \u51060 \u45796 . \u44536 \u48516 \u44760 \u49436 \u45716  \u51452 \u45784 \u51060 \u49884 \u47728 , \u50864 \u47532 \u45716  \u44536 \u48516 \u51032  \u51333 \u46308 \u51060 \u45796 . \u44536 \u48516 \u44760 \u49436 \u45716  \u51060  \u49464 \u49345 \u51032  \u51452 \u51064 \u51060 \u49884 \u47728 , \u50864 \u47532 \u45716  \u48708 \u52380 \u54620  \u51064 \u44036 \u46308 \u51060 \u45796 . \u44536 \u47111 \u51648 \u47564  \u44536 \u48516 \u44760 \u49436 \u45716  \u44256 \u45212 \u51012  \u45817 \u54616 \u49512 \u45796 . \u44536 \u47084 \u48064 \u47196  \u50864 \u47532 \u46308  \u46608 \u54620  \u44256 \u45212 \u51012  \u45817 \u54616 \u45716  \u44163 \u51060  \u47560 \u46405 \u54616 \u51648  \u50506 \u44192 \u45716 \u44032 ? \u45908 \u50865 \u51060  \u44256 \u45212 \u51012  \u53685 \u54616 \u50668  \u50864 \u47532 \u44032  \u51221 \u44208 \u54644 \u51648 \u45716 \u45936  \u50612 \u52236  \u50864 \u47532 \u44032  \u44256 \u53685 \u51012  \u48155 \u51648  \u50506 \u51012  \u49688  \u51080 \u44192 \u45716 \u44032 ? \u44536 \u47088 \u51593  \u49324 \u46993 \u54616 \u45716  \u52828 \u44396 \u50668 , \u47564 \u51068  \u45208 \u51032  \u51453 \u51020 \u51060  \u51452 \u45784 \u44760  \u50689 \u44305 \u51012  \u46028 \u47532 \u45716  \u51068 \u51060  \u46108 \u45796 \u47732 , \u44536 \u45216 \u51060  \u54616 \u47336  \u49549 \u55176  \u51060 \u47476 \u46020 \u47197 , \u44536 \u47532 \u44256  \u45236 \u44032  \u45817 \u54616 \u44172  \u46112  \u47784 \u46304  \u44256 \u45212 \u50640  \u44536 \u48516 \u44760 \u49436  \u54637 \u49345  \u45208 \u47484  \u48537 \u46308 \u50612  \u51452 \u49884 \u46020 \u47197  \u44592 \u46020 \u54616 \u46972 . \u47564 \u51068  \u45236 \u44032  \u44536 \u45824 \u46308 \u50640 \u44172  \u46028 \u50500 \u44032 \u45716  \u44163 \u51060  \u45908 \u50865  \u51339 \u51008  \u51068 \u51060 \u46972 \u47732  \u45208 \u47196  \u54616 \u50668 \u44552  \u50724 \u51216  (\u27738 \u40670 ) \u50630 \u51060  \u46028 \u50500 \u44032 \u44172  \u46104 \u46020 \u47197  \u54616 \u45208 \u45784 \u44760  \u44592 \u46020 \u54616 \u46972 . \u44263  \u45208 \u51032  \u54805 \u51228 \u46308 \u50640 \u44172  \u54988 \u47469 \u54620  \u48376 \u51012  \u45224 \u44200  \u45208 \u47484  \u46384 \u46972 \u50724 \u44172  \u54616 \u46020 \u47197  \u48373 \u51020 \u51032  \u51652 \u47532 \u51032  \u51068 \u51216  \u51068 \u54925 \u51060 \u46972 \u46020  \u49704 \u44592 \u45716  \u51068 \u51060  \u50630 \u46020 \u47197  \u54644  \u45804 \u46972 \u44256  \u44592 \u46020 \u54616 \u46972 . \u50500 \u47560 \u46020  \u54532 \u46972 \u54616 \u50640 \u49436  \u44536 \u45824 \u46308 \u51032  \u50620 \u44404 \u51012  \u45796 \u49884  \u48372 \u44172  \u46104 \u47532 \u46972 \u44256 \u45716  \u49373 \u44033 \u51648  \u50506 \u45716 \u45796 . \u44536 \u47084 \u45208  \u47564 \u51068  \u51204 \u45733 \u54616 \u49888  \u54616 \u45208 \u45784 \u51032  \u46907 \u51060  \u45208 \u47196  \u54616 \u50668 \u44552  \u46028 \u50500 \u44032 \u46020 \u47197  \u54728 \u46973 \u54644  \u51452 \u49888 \u45796 \u47732 , \u44536  \u46412 \u50556 \u47568 \u47196  \u50864 \u47532 \u44032  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51032  \u51648 \u49885 \u44284  \u49324 \u46993 \u51004 \u47196  \u47560 \u51020 \u51012  \u45908 \u50865  \u44403 \u44172  \u54616 \u50668  \u51204 \u51652 \u54616 \u50668 \u50556  \u54624  \u44163 \u51060 \u45796 \'94 (Bonnechose, vol.1, pp.147, 148).\
\uc0\u54980 \u49828 \u45716  \u48373 \u51020 \u51032  \u49324 \u46020 \u44032  \u46108  \u50612 \u46500  \u49888 \u48512 \u50640 \u44172  \u48372 \u45236 \u45716  \u46608  \u54620  \u51109 \u51032  \u45796 \u47480  \u54200 \u51648 \u50640 \u49436 , \u44284 \u44144 \u50640  \u54868 \u47140 \u54620  \u51032 \u48373 \u51012  \u51077 \u44592 \u47484  \u51339 \u50500 \u54616 \u44256  \u52380 \u48149 \u54620  \u51068 \u47196  \u49884 \u44036 \u51012  \u45229 \u48708 \u54620 \u45796 \u44256  \u44536 \u47484  \u48708 \u45212 \u54616 \u50688 \u45912  \u51088 \u44592 \u51032  \u44284 \u50724 \u47484  \u52649 \u49900 \u51004 \u47196  \u49324 \u44284 \u54616 \u50688 \u45796 . \u44536 \u47532 \u44256  \u44536 \u45716  \u50500 \u47000 \u50752  \u44057 \u51060  \u44048 \u46041 \u51201 \u51064  \u44428 \u44256 \u47484  \u45927 \u48537 \u50688 \u45796 . \'93\u51649 \u47197  (\u32887 \u31103 ) \u51060 \u45208  \u51116 \u49328 \u50640  \u47560 \u51020 \u51012  \u54036 \u51648  \u47568 \u44256  \u54616 \u45208 \u45784 \u51032  \u50689 \u44305 \u44284  \u50689 \u54844 \u51032  \u44396 \u50896 \u51004 \u47196  \u44536 \u45824 \u51032  \u47560 \u51020 \u51012  \u52292 \u50864 \u46972 . \u44536 \u45824 \u51032  \u47560 \u51020 \u48372 \u45796 \u46020  \u51665 \u51012  \u45908  \u44984 \u48120 \u51648  \u47568 \u44256 , \u50689 \u51201  \u51665 \u51012  \u49464 \u50864 \u45716  \u45936  \u44288 \u49900 \u51012  \u50143 \u51004 \u46972 . \u44032 \u45212 \u54620  \u49324 \u46988 \u46308 \u51012  \u52828 \u51208 \u54616 \u44256  \u44216 \u49552 \u54616 \u44172  \u45824 \u54616 \u47728 , \u44536 \u45824 \u51032  \u47932 \u51656 \u51012  \u50676 \u46973 \u54616 \u45716  \u51068 \u47196  \u45229 \u48708 \u54616 \u51648  \u47568 \u46972 . \u44536 \u45824 \u44032  \u47564 \u51068  \u44536 \u45824 \u51032  \u49373 \u50528 \u47484  \u44256 \u52824 \u44256  \u49324 \u52824 \u49828 \u47084 \u50868  \u49373 \u50528 \u47484  \u45130 \u50612  \u48260 \u47532 \u51648  \u50500 \u45768 \u54616 \u47732 , \u45236 \u44032  \u51648 \u44552  \u49900 \u54616 \u44172  \u51669 \u44228 \u47484  \u48155 \u44256  \u51080 \u45716  \u48148 \u47196  \u44536  \u51669 \u44228 \u44032  \u44536 \u45824 \u50640 \u44172  \u48120 \u52832 \u44620  \u50684 \u47140 \u46108 \u45796 . \u44536 \u45824 \u45716  \u50612 \u47140 \u49436 \u48512 \u53552  \u45208 \u51032  \u44368 \u54984 \u51012  \u48155 \u50520 \u51004 \u48064 \u47196  \u45208 \u51032  \u44368 \u54984 \u51060  \u47924 \u50631 \u51064 \u51648  \u50508 \u44256  \u51080 \u45796 . \u44536 \u47084 \u48064 \u47196  \u51060  \u51060 \u49345  \u45908  \u50424  \u54596 \u50836 \u44032  \u50630 \u45716  \u51460 \u47196  \u50504 \u45796 . \u44536 \u45824 \u44032  \u50500 \u45716  \u48148 \u50752  \u44057 \u51060  \u54620  \u46412  \u45236 \u44032  \u48736 \u51276 \u45912  \u50612 \u46496 \u54620  \u54728 \u50689 \u50640 \u46020  \u44536 \u45824 \u45716  \u48736 \u51648 \u51648  \u47568 \u44592 \u47484  \u45208 \u45716  \u51452 \u51032  \u51088 \u48708 \u47484  \u55192 \u51077 \u50612  \u44536 \u45824 \u50640 \u44172  \u44036 \u50896 \u54620 \u45796 .\'94 \u44536 \u47532 \u44256  \u44536  \u44169 \u48393 \u50640 \u45716  \'93\u45208 \u51032  \u52828 \u44396 \u50668 , \u44536 \u45824 \u45716  \u45236 \u44032  \u51453 \u51008  \u44163 \u51060  \u54869 \u49892 \u54616 \u45796 \u45716  \u49324 \u49892 \u51012  \u50508 \u44592  \u51204 \u50640 \u45716  \u51060  \u48393 \u53804 \u47484  \u46895 \u51648  \u47568 \u46972 \'94 (Bonnechose, vol.1, pp.148, 149) \u44256  \u50024  \u51080 \u50632 \u45796 .\
\uc0\u54980 \u49828 \u45716  \u44536  \u50668 \u54665  \u51473 \u50640 \u49436  \u51088 \u44592 \u51032  \u44368 \u47532 \u44032  \u46020 \u52376 \u50640  \u51204 \u54028 \u46108  \u44163 \u44284  \u51088 \u44592 \u51032  \u51204 \u46020  \u49324 \u50629 \u51060  \u54872 \u50689 \u51012  \u48155 \u44256  \u51080 \u45716  \u44163 \u51012  \u48372 \u50520 \u45796 . \u49324 \u46988 \u46308 \u51008  \u44536 \u51032  \u44225 \u51004 \u47196  \u47792 \u47140 \u50772 \u51004 \u47728 , \u50612 \u46500  \u44256 \u51012 \u50640 \u49436 \u45716  \u51648 \u48169  \u51109 \u44288 \u51060  \u44536 \u47484  \u46384 \u46972  \u44144 \u47532 \u47484  \u44057 \u51060  \u44151 \u44592 \u46020  \u54616 \u50688 \u45796 .\
