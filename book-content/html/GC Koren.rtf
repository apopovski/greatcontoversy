\f1\b0 \cf0 \
\uc0\u49692 \u44368 \u51088  \u54004 \u45916 \u51008  \u51453 \u51008  \u51088 \u51032  \u49345 \u53468 \u50640  \u45824 \u54616 \u50668  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u54616 \u50688 \u45796 . \'93\u45208 \u45716  \u51453 \u51008  \u51088 \u46308 \u51060  \u51060 \u48120  \u44536 \u47532 \u49828 \u46020 \u50752  \u54632 \u44760  \u50756 \u51204 \u54620  \u50689 \u44305 \u50640  \u52280 \u50668 \u54616 \u50688 \u44144 \u45208  \u54616 \u45208 \u45784 \u51032  \u53469 \u54616 \u49888  \u52380 \u49324 \u46308 \u44284  \u44057 \u51008  \u49345 \u53468 \u50640  \u51080 \u45796 \u45716  \u44163 \u51012  \u45225 \u46301 \u54624  \u49688  \u50630 \u51020 \u51012  \u44277 \u50616 \u54620 \u45796 . \u44536 \u44163 \u51008  \u45208 \u51032  \u49888 \u50521 \u51032  \u50612 \u46500  \u54620  \u48512 \u48516 \u51060  \u44208 \u53076  \u50500 \u45768 \u45796 . \u47564 \u51068  \u44536 \u47111 \u45796 \u47732  \u50977 \u52404 \u51032  \u48512 \u54876 \u50640  \u44288 \u54620  \u49444 \u44368 \u45716  \u51204 \u54784  \u47924 \u51061 \u54616 \u45796 \u45716  \u44163 \u51012  \u45208 \u45716  \u50504 \u45796 \'94[William Tyndale, Preface to New Testa-ment (ed.1534).Reprinted in British Reformers \'97 Tindale, Frith, Barnes, p.349].\
\uc0\u49324 \u46988 \u51060  \u51453 \u51012  \u46412 \u50640  \u48520 \u49324  (\u63847 \u27515 ) \u51032  \u52629 \u48373 \u51012  \u48155 \u45716 \u45796 \u45716  \u49548 \u47581 \u51060  \u48512 \u54876 \u50640  \u44288 \u54620  \u49457 \u44221 \u49345  \u44368 \u47532 \u47484  \u51068 \u48152 \u51201 \u51004 \u47196  \u46321 \u54620 \u55176  \u54616 \u44172  \u54664 \u45796 \u45716  \u44163 \u51008  \u48512 \u51064 \u54624  \u49688  \u50630 \u45716  \u49324 \u49892 \u51060 \u45796 . \u51060 \u47084 \u54620  \u44221 \u54693 \u50640  \u45824 \u54616 \u50668  \u50500 \u45812  \u53364 \u46972 \u53356  \u48149 \u49324 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u51652 \u49696 \u54616 \u50688 \u45796 . \'93\u48512 \u54876 \u51032  \u44368 \u47532 \u45716  \u50724 \u45720 \u45216 \u48372 \u45796  \u52488 \u45824  \u44368 \u54924 \u44032  \u45908 \u50865  \u51473 \u50836 \u54616 \u44172  \u50668 \u44596  \u44163  \u44057 \u45796 . \u50780  \u44536 \u47088 \u44032 ? \u49324 \u46020 \u46308 \u51008  \u54637 \u49345  \u48512 \u54876 \u50640  \u45824 \u54616 \u50668  \u51452 \u51109 \u54616 \u50688 \u44256  \u54616 \u45208 \u45784 \u51012  \u46384 \u47476 \u45716  \u51088 \u46308 \u51008  \u48512 \u54876 \u51012  \u53685 \u54616 \u50668  \u44540 \u47732 \u54616 \u44256  \u49692 \u51333 \u54616 \u44256  \u51600 \u44144 \u50892 \u54616 \u46020 \u47197  \u44201 \u47140 \u47484  \u48155 \u50520 \u45796 . \u44536 \u47088 \u45936  \u44536 \u46308 \u51032  \u54980 \u44228 \u51088 \u46308 \u51008  \u50724 \u45720 \u45216  \u44536 \u44163 \u51012  \u51328 \u52376 \u47100  \u47568 \u54616 \u44256  \u51080 \u51648  \u50506 \u45716 \u45796 . \u49324 \u46020 \u46308 \u51008  \u44536 \u47111 \u44172  \u49444 \u44368 \u54616 \u50688 \u44256  \u52488 \u44592 \u51032  \u44536 \u47532 \u49828 \u46020 \u51064 \u46308 \u51008  \u44536 \u47111 \u44172  \u48127 \u50632 \u45796 . \u47564 \u51068  \u50864 \u47532 \u44032  \u44536 \u47111 \u44172  \u51204 \u54616 \u47732  \u50864 \u47532 \u51032  \u52397 \u51473 \u46308 \u46020  \u44536 \u47111 \u44172  \u48127 \u44172  \u46112  \u44163 \u51060 \u45796 . \u48373 \u51020 \u51032  \u44368 \u47532 \u50640 \u49436  \u51060 \u44163 \u52376 \u47100  \u51473 \u45824 \u54620  \u44368 \u47532 \u44032  \u50630 \u45716 \u45936 \u46020  \u48520 \u44396 \u54616 \u44256  \u50724 \u45720 \u45216 \u51032  \u44053 \u45800 \u50640 \u49436  \u51060 \u44163 \u52376 \u47100  \u46321 \u54620 \u49884 \u46104 \u45716  \u44368 \u47532 \u44032  \u50630 \u45796 !\'94 (Commentary, remarks on 1 Cor-inthians 15, par.3).\
\uc0\u51060 \u47088  \u49345 \u53468 \u44032  \u44228 \u49549 \u46104 \u50612  \u47560 \u52840 \u45236  \u50689 \u44305 \u49828 \u47088  \u48512 \u54876 \u51032  \u51652 \u47532 \u44032  \u44536 \u47532 \u49828 \u46020 \u44368 \u44228 \u50640 \u49436  \u44144 \u51032  \u55148 \u48120 \u54644 \u51648 \u44256  \u49324 \u46972 \u51656  \u51648 \u44221 \u44620 \u51648  \u51060 \u47476 \u47104 \u45796 . \u44536 \u47532 \u54616 \u50668  \u50976 \u47749 \u54620  \u50612 \u46500  \u51333 \u44368  \u51200 \u49696 \u44032 \u45716  \u45936 \u49332 \u47196 \u45768 \u44032 \u51204 \u49436  4\u51109  13\u51208 \u47196  18\u51208 \u50640  \u51080 \u45716  \u48148 \u50872 \u51032  \u47568 \u51012  \u45796 \u51020 \u44284  \u44057 \u51060  \u51452 \u54644 \u54616 \u44256  \u51080 \u45796 . \'93\u51032 \u51064 \u46308 \u51032  \u48373 \u49828 \u47088  \u48520 \u47736 \u51032  \u44368 \u47532 \u45716  \u51032 \u49900 \u49828 \u47084 \u50868  \u51452 \u51032  \u51116 \u47548 \u50640  \u45824 \u54620  \u44368 \u47532 \u47484  \u45824 \u49888 \u54616 \u50668  \u49892 \u51228 \u47196  \u50864 \u47532 \u50640 \u44172  \u50948 \u47196 \u47484  \u51456 \u45796 . \u50864 \u47532 \u44032  \u51453 \u51012  \u46412  \u51452 \u45784 \u44760 \u49436  \u50864 \u47532 \u50640 \u44172  \u50724 \u49888 \u45796 . \u44536 \u44163 \u51060  \u50864 \u47532 \u44032  \u44592 \u45796 \u47532 \u44256  \u44648 \u50612  \u51080 \u50612 \u50556  \u54624  \u51060 \u50976 \u51060 \u45796 . \u51453 \u51008  \u51088 \u45716  \u51060 \u48120  \u50689 \u44305 \u51473 \u50640  \u46308 \u50612 \u44032  \u51080 \u45796 . \u44536 \u46308 \u51008  \u44536 \u46308 \u51032  \u49900 \u54032 \u44284  \u52629 \u48373 \u51012  \u44256 \u54616 \u45716  \u45208 \u54036  \u49548 \u47532 \u47484  \u44592 \u45796 \u47532 \u51648  \u50506 \u45716 \u45796 .\'94\
\uc0\u44536 \u47084 \u45208  \u50696 \u49688 \u45784 \u44760 \u49436  \u45817 \u49888 \u51032  \u51228 \u51088 \u46308 \u51012  \u46496 \u45208 \u49884 \u47140  \u54624  \u46412  \u44536 \u46308 \u51060  \u48120 \u44396 \u50640  \u45817 \u49888 \u44760 \u47196  \u50732  \u44163 \u51060 \u46972 \u44256  \u54616 \u51648  \u50506 \u51004 \u49512 \u45796 . \u44536 \u48516 \u44760 \u49436 \u45716  \'93\u45236 \u44032  \u45320 \u55148 \u47484  \u50948 \u54616 \u50668  \u52376 \u49548 \u47484  \u50696 \u48708 \u54616 \u47084  \u44032 \u45432 \u45768  \u44032 \u49436  \u45320 \u55148 \u47484  \u50948 \u54616 \u50668  \u52376 \u49548 \u47484  \u50696 \u48708 \u54616 \u47732  \u45236 \u44032  \u45796 \u49884  \u50752 \u49436  \u45320 \u55148 \u47484  \u45236 \u44172 \u47196  \u50689 \u51217 \u54616 \u50668  \u45208  \u51080 \u45716  \u44275 \u50640  \u45320 \u55148 \u46020  \u51080 \u44172  \u54616 \u47532 \u46972 \'94 (\u50836  14:2, 3) \u44256  \u47568 \u50432 \u54616 \u49512 \u45796 . \u44536 \u47532 \u44256  \u48148 \u50872 \u51008  \u44536  \u49324 \u49892 \u51012  \u45908 \u50865  \u51088 \u49464 \u54616 \u44172  \u50864 \u47532 \u50640 \u44172  \u50508 \u47140  \u51456 \u45796 . \'93\u51452 \u44760 \u49436  \u54840 \u47161 \u44284  \u52380 \u49324 \u51109 \u51032  \u49548 \u47532 \u50752  \u54616 \u45208 \u45784 \u51032  \u45208 \u54036 \u47196  \u52828 \u55176  \u54616 \u45720 \u47196  \u51335 \u50500  \u44053 \u47548 \u54616 \u49884 \u47532 \u45768  \u44536 \u47532 \u49828 \u46020  \u50504 \u50640 \u49436  \u51453 \u51008  \u51088 \u46308 \u51060  \u47676 \u51200  \u51068 \u50612 \u45208 \u44256  \u44536  \u54980 \u50640  \u50864 \u47532  \u49332 \u50500 \u45224 \u51008  \u51088 \u46020  \u51200 \u55148 \u50752  \u54632 \u44760  \u44396 \u47492 \u49549 \u51004 \u47196  \u45132 \u50612 \u50732 \u47140  \u44277 \u51473 \u50640 \u49436  \u51452 \u47484  \u50689 \u51217 \u54616 \u44172  \u54616 \u49884 \u47532 \u45768  \u44536 \u47532 \u54616 \u50668  \u50864 \u47532 \u44032  \u54637 \u49345  \u51452 \u50752  \u54632 \u44760  \u51080 \u51004 \u47532 \u46972 \'94 (\u49332 \u51204  4:16~18). \u44536 \u47532 \u44256  \u44536 \u45716  \'93\u44536 \u47084 \u48064 \u47196  \u51060  \u50668 \u47084  \u47568 \u47196  \u49436 \u47196  \u50948 \u47196 \u54616 \u46972 \'94\u44256  \u48512 \u50616 \u54620 \u45796 . \u51060  \u50948 \u47196 \u51032  \u47568 \u50432 \u44284  \u51060 \u48120  \u51064 \u50857 \u54620  \u48372 \u54200  \u44396 \u51228 \u47200 \u51012  \u48127 \u45716  \u47785 \u49324 \u51032  \u47568 \u51008  \u50620 \u47560 \u45208  \u53360  \u45824 \u51312 \u47484  \u51060 \u47336 \u45716 \u44032 ! \u44536  \u47785 \u49324 \u45716  \u45224 \u50500  \u51080 \u45716  \u52828 \u44396 \u46308 \u50640 \u44172  \u44536  \u51453 \u51008  \u51088 \u44032  \u50500 \u47924 \u47532  \u51396 \u50501 \u51201 \u51064  \u49373 \u50528 \u47484  \u49332 \u50500 \u50772 \u45796  \u54624 \u51648 \u46972 \u46020  \u44536 \u44032  \u50868 \u47749 \u54624  \u46412  \u52380 \u49324 \u46308 \u50640 \u44172  \u50689 \u51217 \u51012  \u48155 \u45716 \u45796 \u45716  \u47568 \u47196  \u54869 \u49888  \u51080 \u44172  \u50948 \u47196 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u48148 \u50872 \u51008  \u51109 \u52264  \u51080 \u51012  \u44536 \u47532 \u49828 \u46020 \u51032  \u51116 \u47548 \u51012  \u54805 \u51228 \u46308 \u50640 \u44172  \u50508 \u47140  \u51452 \u44256  \u44536 \u46412 \u50640  \u47924 \u45924 \u51032  \u49549 \u48149 \u51012  \u44648 \u46888 \u47532 \u44256  \'93\u44536 \u47532 \u49828 \u46020  \u50504 \u50640 \u49436  \u51453 \u51008  \u51088 \u46308 \'94\u51060  \u50689 \u49373 \u51004 \u47196  \u48512 \u54876 \u54624  \u44163 \u51060 \u46972 \u44256  \u47568 \u54620 \u45796 .\
\uc0\u45572 \u44396 \u46304 \u51648  \u44536  \u48373 \u46108  \u54616 \u45720  \u51665 \u50640  \u46308 \u50612 \u44032 \u44592  \u51204 \u50640  \u44536 \u46308 \u51032  \u49373 \u50528 \u44032  \u51312 \u49324 \u48155 \u44256  \u44536 \u46308 \u51032  \u54408 \u49457 \u44284  \u54665 \u50948 \u44032  \u54616 \u45208 \u45784  \u50526 \u50640  \u53685 \u44284 \u46104 \u50612 \u50556  \u54620 \u45796 . \u47784 \u46304  \u49324 \u46988 \u51008  \u52293 \u50640  \u44592 \u47197 \u46108  \u45824 \u47196  \u49900 \u54032 \u51012  \u48155 \u44256  \u44536 \u46308 \u51032  \u54665 \u50948 \u50640  \u46384 \u46972  \u48372 \u51025 \u51012  \u48155 \u45716 \u45796 . \u44536  \u49900 \u54032 \u51008  \u49324 \u46988 \u51060  \u51453 \u51012  \u46412 \u50640  \u48155 \u45716  \u44163 \u51060  \u50500 \u45768 \u45796 . \u48148 \u50872 \u51032  \u47568 \u50640  \u50976 \u51032 \u54644  \u48372 \u46972 . \'93\u51060 \u45716  \u51221 \u54616 \u49888  \u49324 \u46988 \u51004 \u47196  \u54616 \u50668 \u44552  \u52380 \u54616 \u47484  \u44277 \u51032 \u47196  \u49900 \u54032 \u54620  \u45216 \u51012  \u51089 \u51221 \u54616 \u49884 \u44256  \u51060 \u50640  \u51200 \u47484  \u51453 \u51008  \u51088  \u44032 \u50868 \u45936 \u49436  \u45796 \u49884  \u49332 \u47532 \u49888  \u44163 \u51004 \u47196  \u47784 \u46304  \u49324 \u46988 \u50640 \u44172  \u48127 \u51012  \u47564 \u54620  \u51613 \u44144 \u47484  \u51452 \u49512 \u51020 \u51060 \u45768 \u46972 \'94 (\u54665  17:31). \u50668 \u44592 \u49436  \u49324 \u46020 \u45716  \u49464 \u44228 \u51032  \u49900 \u54032 \u51012  \u50948 \u54620  \u53945 \u48324 \u54620  \u46412 , \u44263  \u48120 \u47000 \u51032  \u50612 \u46500  \u46412 \u44032  \u51089 \u51221 \u46104 \u50632 \u45796 \u44256  \u48516 \u47749 \u55176  \u47568 \u54664 \u45796 .\
\uc0\u46041 \u51068 \u54620  \u44592 \u44036 \u50640  \u45824 \u54616 \u50668  \u50976 \u45796 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u54620 \u45796 . \'93\u51088 \u44592  \u51648 \u50948 \u47484  \u51648 \u53412 \u51648  \u50500 \u45768 \u54616 \u44256  \u51088 \u44592  \u52376 \u49548 \u47484  \u46496 \u45212  \u52380 \u49324 \u46308 \u51012  \u53360  \u45216 \u51032  \u49900 \u54032 \u44620 \u51648  \u50689 \u50896 \u54620  \u44208 \u48149 \u51004 \u47196  \u55121 \u50516 \u50640  \u44032 \u46160 \u49512 \'94\u45796 . \u44536 \u47532 \u44256  \u44536 \u45716  \u45796 \u49884  \u50640 \u45433 \u51032  \u47568 \u51012  \u51064 \u50857 \u54620 \u45796 . \'93\u48372 \u46972  \u51452 \u44760 \u49436  \u44536  \u49688 \u47564 \u51032  \u44144 \u47337 \u54620  \u51088 \u50752  \u54632 \u44760  \u51076 \u54616 \u49512 \u45208 \u45768  \u51060 \u45716  \u47943 \u49324 \u46988 \u51012  \u49900 \u54032 \u54616 \u49324 \'85\u51200 \u55148 \u47484  \u51221 \u51396 \u54616 \u47140  \u54616 \u49900 \u51060 \u46972 \'94 (\u50976  6, 14, 15). \u50836 \u54620 \u51008  \'93\u45236 \u44032  \u48372 \u45768  \u51453 \u51008  \u51088 \u46308 \u51060  \u47924 \u47200  \u45824 \u49548 \u54616 \u44256  \u44536  \u48372 \u51340  \u50526 \u50640  \u49456 \u45716 \u45936  \u52293 \u46308 \u51060  \u54196 \u51080 \u44256 \'85\u51453 \u51008  \u51088 \u46308 \u51060  \u51088 \u44592  \u54665 \u50948 \u47484  \u46384 \u46972  \u52293 \u46308 \u50640  \u44592 \u47197 \u46108  \u45824 \u47196  \u49900 \u54032 \u51012  \u48155 \'94 (\u44228  20:12) \u45908 \u46972 \u44256  \u47568 \u54620 \u45796 .\
\uc0\u47564 \u51068  \u51453 \u51008  \u51088 \u46308 \u51060  \u51060 \u48120  \u54616 \u45720 \u51032  \u48373 \u46973 \u51012  \u45572 \u47532 \u44256  \u51080 \u44144 \u45208 , \u54841 \u51008  \u51648 \u50725 \u51032  \u49549 \u50640 \u49436  \u48512 \u47476 \u51670 \u44256  \u51080 \u45796 \u47732  \u51109 \u47000 \u51032  \u49900 \u54032 \u51060  \u47924 \u49832  \u54596 \u50836 \u44032  \u51080 \u45716 \u44032 ? \u51060 \u47088  \u51473 \u45824 \u54620  \u47928 \u51228 \u46308 \u50640  \u45824 \u54620  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51032  \u44032 \u47476 \u52840 \u51008  \u50528 \u47588 \u54616 \u44144 \u45208  \u47784 \u49692 \u46104 \u51648  \u50506 \u45716 \u45796 . \u44536  \u47928 \u51228 \u46308 \u51008  \u48372 \u53685 \u51032  \u46160 \u45516 \u47196  \u52649 \u48516 \u55176  \u51060 \u54644 \u54624  \u49688  \u51080 \u45796 . \u44536 \u47084 \u47732  \u49556 \u51649 \u54620  \u47560 \u51020 \u51012  \u44032 \u51652  \u49324 \u46988 \u46308 \u51060  \u50724 \u45720 \u45216  \u48372 \u44553 \u46104 \u50612  \u51080 \u45716  \u51060 \u47088  \u44368 \u47532 \u50640 \u49436  \u51648 \u54812 \u50752  \u44277 \u51032 \u47484  \u48156 \u44204 \u54624  \u49688  \u51080 \u51012 \u44620 ? \u51032 \u51064 \u46308 \u51060  \u50724 \u47019 \u46041 \u50504  \u54616 \u45208 \u45784  \u50526 \u50640  \u44144 \u54616 \u45796 \u44032  \u49900 \u54032 \u51032  \u46412 \u50640  \u44536 \u46308 \u51032  \u49324 \u44148 \u51012  \u51312 \u49324 \u48155 \u44256  \'93\u51096 \u54616 \u50688 \u46020 \u45796  \u52265 \u54616 \u44256  \u52649 \u49457 \u46108  \u51333 \u50500 \'85\u45348  \u51452 \u51064 \u51032  \u51600 \u44144 \u50880 \u50640  \u52280 \u50696 \u54624 \u51648 \u50612 \u45796 \'94 (\u47560  25:21) \u45716  \u47749 \u47161 \u51012  \u48155 \u51012  \u44163 \u51064 \u44032 ? \u44536 \u47532 \u44256  \u50501 \u51064 \u46308 \u51008  \u44256 \u53685 \u51032  \u51109 \u49548 \u50640 \u49436  \u45132 \u47140 \u45208 \u50752  \u50728  \u46405 \u51032  \u49900 \u54032 \u51109 \u50640 \u44172  \'93\u51200 \u51452 \u47484  \u48155 \u51012  \u45320 \u55148 \u50668  \u45208 \u47484  \u46496 \u45208 \'85\u50689 \u50689 \u54620  \u48520 \u50640  \u46308 \u50612 \u44032 \u46972 \'94 (\u47560  25:21, 41) \u45716  \u49440 \u44256 \u47484  \u48155 \u44172  \u46104 \u45716 \u44032 ? \u50500 , \u44536 \u44163 \u51008  \u50620 \u47560 \u45208  \u50612 \u47532 \u49437 \u51008  \u47568 \u51064 \u44032 ! \u44536 \u44163 \u51008  \u54616 \u45208 \u45784 \u51032  \u51648 \u54812 \u50752  \u44277 \u51032 \u50640  \u45824 \u54620  \u49688 \u52824 \u49828 \u47088  \u47784 \u46021 \u51060 \u45796 .\
\uc0\u50689 \u54844  \u48520 \u47736 \u49444 \u51008  \u47196 \u47560 \u44368 \u44032  \u45796 \u49888 \u44368 \u50640 \u49436  \u44032 \u51256 \u50752  \u44536 \u47532 \u49828 \u46020 \u44368 \u47196  \u46308 \u50668 \u48372 \u45240  \u44144 \u51667  \u44368 \u47532 \u46308  \u51473  \u54616 \u45208 \u50688 \u45796 . \u47560 \u54004  \u47336 \u53552 \u45716  \u44536 \u44163 \u51012  \'93\u47196 \u47560  \u48277 \u50773 \u51032  \u44368 \u47161 \u51032  \u50416 \u47112 \u44592 \u45908 \u48120 \u51032  \u48512 \u48516 \u51012  \u51060 \u47336 \u44256  \u51080 \u45716  \u44592 \u44340 \u54620  \u51060 \u50556 \u44592 \'94 (E. Petavel, The Problem of Immortality, p.255) \u47196  \u48516 \u47448 \u54664 \u45796 . \u49556 \u47196 \u47788 \u51060  \u51204 \u46020 \u49436 \u50640 \u49436 , \u51453 \u51008  \u51088 \u45716  \u50500 \u47924 \u44163 \u46020  \u50508 \u51648  \u47803 \u54620 \u45796 \u44256  \u54620  \u47568 \u51012  \u44536  \u51333 \u44368  \u44060 \u54785 \u51088 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u51452 \u54644 \u54620 \u45796 . \'93\u46608  \u45796 \u47480  \u44275 \u50640 \u49436 \u46020  \u51453 \u51008  \u51088 \u45716  \u50500 \u47924  \u44048 \u44033 \u51060  \u50630 \u45796 \u45716  \u44163 \u51012  \u51613 \u47749 \u54616 \u44256  \u51080 \u45796 . \u44144 \u44592 \u50640 \u45716  \u51032 \u47924 \u46020 , \u44284 \u54617 \u46020 , \u51648 \u49885 \u46020 , \u51648 \u54812 \u46020  \u50630 \u45796 \u44256  \u44536 \u45716  \u47568 \u54620 \u45796 . \u49556 \u47196 \u47788 \u51008  \u51453 \u51008  \u51088 \u44032  \u51104 \u51012  \u51088 \u44256  \u51080 \u51004 \u47728  \u50500 \u47924 \u47088  \u44048 \u44033 \u46020  \u50630 \u45796 \u44256  \u54032 \u45800 \u54620 \u45796 . \u51453 \u51008  \u51088 \u46308 \u51008  \u51068 \u45800  \u45572 \u50864 \u47732  \u45216 \u51060 \u45208  \u54644 \u44032  \u44032 \u45716  \u44163 \u51012  \u44228 \u49328 \u54616 \u51648  \u47803 \u54620 \u45796 . \u44536 \u47084 \u45208  \u44536 \u463