\uc0\u44536 \u47084 \u45208  \u51652 \u49900 \u51004 \u47196  \u51396 \u47484  \u54924 \u44060 \u54616 \u44256  \u48127 \u51020 \u51004 \u47196  \u44536 \u47532 \u49828 \u46020 \u51032  \u54588 \u47484  \u44536 \u46308 \u51032  \u49549 \u51396  \u51228 \u47932 \u47196  \u51452 \u51109 \u54620  \u49324 \u46988 \u46308 \u50640 \u44172 \u45716  \u54616 \u45720 \u51032  \u52293 \u50640  \u44592 \u47197 \u46108  \u44536 \u46308 \u51032  \u51060 \u47492  \u50500 \u47000  \u50857 \u49436 \u48155 \u50520 \u45796 \u45716  \u47568 \u51060  \u44592 \u47197 \u46108 \u45796 . \u44536 \u46308 \u51060  \u44536 \u47532 \u49828 \u46020 \u51032  \u51032 \u50640  \u52280 \u50668 \u54616 \u45716  \u51088 \u44032  \u46104 \u44256  \u44536 \u46308 \u51032  \u54408 \u49457 \u51060  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u44284  \u51312 \u54868 \u46108 \u45796 \u45716  \u44163 \u51060  \u45208 \u53440 \u45216  \u46412 , \u44536 \u46308 \u51032  \u51396 \u45716  \u46020 \u47568 \u46104 \u44256  \u44536 \u46308  \u51088 \u49888 \u51060  \u50689 \u50896 \u54620  \u49373 \u47749 \u51012  \u48155 \u44592 \u50640  \u54633 \u45817 \u54620  \u49324 \u46988 \u46308 \u51060  \u46112  \u44163 \u51060 \u45796 . \u51452 \u45784 \u44760 \u49436 \u45716  \u49440 \u51648 \u51088  \u51060 \u49324 \u50556 \u47484  \u53685 \u54616 \u50668  \'93\u45208  \u44263  \u45208 \u45716  \u45208 \u47484  \u50948 \u54616 \u50668  \u45348  \u54728 \u47932 \u51012  \u46020 \u47568 \u54616 \u45716  \u51088 \u45768  \u45348  \u51396 \u47484  \u44592 \u50613 \u51648  \u50500 \u45768 \u54616 \u47532 \u46972 \'94 (\u49324  43:25) \u44256  \u47568 \u50432 \u54616 \u49888 \u45796 . \u44536 \u47532 \u44256  \u50696 \u49688 \u45784 \u44760 \u49436 \u45716  \u47568 \u50432 \u54616 \u49512 \u45796 . \'93\u51060 \u44592 \u45716  \u51088 \u45716  \u51060 \u50752  \u44057 \u51060  \u55152 \u50743 \u51012  \u51077 \u51012  \u44163 \u51060 \u50836  \u45236 \u44032  \u44536  \u51060 \u47492 \u51012  \u49373 \u47749 \u52293 \u50640 \u49436  \u48152 \u46300 \u49884  \u55120 \u47532 \u51648  \u50500 \u45768 \u54616 \u44256  \u44536  \u51060 \u47492 \u51012  \u45236  \u50500 \u48260 \u51648  \u50526 \u44284  \u44536  \u52380 \u49324 \u46308  \u50526 \u50640 \u49436  \u49884 \u51064 \u54616 \u47532 \u46972 \'94 (\u44228  3:5). \'93\u45572 \u44396 \u46304 \u51648  \u49324 \u46988  \u50526 \u50640 \u49436  \u45208 \u47484  \u49884 \u51064 \u54616 \u47732  \u45208 \u46020  \u54616 \u45720 \u50640  \u44228 \u49888  \u45236  \u50500 \u48260 \u51648  \u50526 \u50640 \u49436  \u51200 \u47484  \u49884 \u51064 \u54624  \u44163 \u51060 \u50836  \u45572 \u44396 \u46304 \u51648  \u49324 \u46988  \u50526 \u50640 \u49436  \u45208 \u47484  \u48512 \u51064 \u54616 \u47732  \u45208 \u46020  \u54616 \u45720 \u50640  \u44228 \u49888  \u45236  \u50500 \u48260 \u51648  \u50526 \u50640 \u49436  \u51200 \u47484  \u48512 \u51064 \u54616 \u47532 \u46972 \'94 (\u47560  10:32, 33).\
\uc0\u49464 \u49345  \u48277 \u51221 \u51032  \u44277 \u54032 \u50640  \u45824 \u54616 \u50668  \u49324 \u46988 \u46308 \u51060  \u45208 \u53440 \u45236 \u45716  \u44032 \u51109  \u44618 \u51008  \u55141 \u48120 \u46020  \u49373 \u47749 \u52293 \u50640  \u44592 \u47197 \u46108  \u51060 \u47492 \u46308 \u51060  \u50728  \u49464 \u49345 \u51032  \u49900 \u54032 \u51109 \u46104 \u49888  \u54616 \u45208 \u45784  \u50526 \u50640 \u49436  \u49900 \u49324 \u46104 \u45716  \u54616 \u45720  \u48277 \u51221 \u50640  \u44592 \u50872 \u51060 \u45716  \u55141 \u48120 \u50640  \u48708 \u54616 \u47732  \u45796 \u47564  \u55148 \u48120 \u54620  \u44163 \u50640  \u48520 \u44284 \u54616 \u45796 . \u51473 \u48372 \u51088  \u46104 \u49888  \u51452 \u45784 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u54588 \u47484  \u48127 \u45716  \u48127 \u51020 \u51004 \u47196  \u49849 \u47532 \u47484  \u50619 \u51008  \u47784 \u46304  \u49324 \u46988 \u46308 \u51060  \u44536 \u46308 \u51032  \u51396 \u47484  \u50857 \u49436 \u48155 \u44256  \u50640 \u45940  \u48376 \u54693 \u51004 \u47196  \u45796 \u49884  \u46028 \u50500 \u44032 \u49436  \u51452 \u45784 \u44284  \u54632 \u44760  \'93\u51060 \u51204 \'85\u45208 \u46972 \'94 (\u48120  4:8) \u51032  \u54980 \u49324 \u44032  \u46104 \u50612  \u51452 \u44592 \u47484  \u44036 \u52397 \u54616 \u49888 \u45796 . \u49324 \u45800 \u51008  \u51064 \u47448 \u47484  \u49549 \u51060 \u44256  \u50976 \u54841 \u54632 \u51004 \u47196  \u51064 \u47448 \u47484  \u52285 \u51312 \u54616 \u49888  \u54616 \u45208 \u45784 \u51032  \u44228 \u54925 \u51060  \u49892 \u54056 \u47196  \u46028 \u50500 \u44032 \u44172  \u54624  \u49688  \u51080 \u45796 \u44256  \u49373 \u44033 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u51060 \u51228  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u51064 \u47448 \u44032  \u47560 \u52824  \u53440 \u46973 \u54620  \u51068 \u51060  \u51204 \u54784  \u50630 \u45716  \u44163 \u52376 \u47100  \u51060  \u44228 \u54925 \u51060  \u49892 \u54665 \u46104 \u44592 \u47484  \u44036 \u44396 \u54616 \u49888 \u45796 . \u44536 \u48516 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u48177 \u49457 \u46308 \u50640 \u44172  \u50756 \u51204 \u54616 \u44256  \u52649 \u48516 \u54620  \u50857 \u49436 \u50752  \u51032 \u47484  \u51460  \u49104 \u47564  \u50500 \u45768 \u46972  \u44536 \u46308 \u51060  \u45817 \u49888 \u51032  \u50689 \u44305 \u50640  \u46041 \u52280 \u54616 \u44256  \u45817 \u49888 \u51032  \u48372 \u51340 \u50640  \u54632 \u44760  \u50505 \u44172  \u46104 \u44592 \u47484  \u44396 \u54616 \u49888 \u45796 .\
\uc0\u50696 \u49688 \u44760 \u49436  \u45817 \u49888 \u51032  \u51008 \u54812 \u51032  \u48177 \u49457 \u46308 \u51012  \u50948 \u54616 \u50668  \u44036 \u44396 \u54616 \u44256  \u44228 \u49884 \u45716  \u46041 \u50504 , \u49324 \u45800 \u51008  \u44536 \u46308 \u51012  \u48276 \u51396 \u51088 \u47196  \u54616 \u45208 \u45784  \u50526 \u50640  \u44256 \u49548 \u54620 \u45796 . \u49324 \u45800 \u51008  \u44536 \u46308 \u51012  \u51032 \u54841 \u50640  \u48736 \u46888 \u47532 \u44256 , \u54616 \u45208 \u45784 \u51012  \u48127 \u45716  \u54869 \u49888 \u51012  \u51075 \u50612 \u48260 \u47532 \u44172  \u54616 \u44256 , \u54616 \u45208 \u45784 \u51032  \u49324 \u46993 \u50640 \u49436  \u46496 \u45208  \u44536 \u48516 \u51032  \u50984 \u48277 \u51012  \u48276 \u54616 \u44172  \u54616 \u44256 \u51088  \u51652 \u47141 \u54644  \u50772 \u45796 . \u51060 \u51228  \u44536 \u45716  \u44536 \u46308 \u51032  \u49373 \u50528 \u51032  \u44592 \u47197 \u51012  \u51648 \u51201 \u54616 \u44256 , \u44536 \u46308 \u51032  \u54408 \u49457 \u51032  \u44208 \u54632 \u44284  \u44536 \u46308 \u51060  \u44536 \u47532 \u49828 \u46020 \u50752  \u44057 \u51648  \u50500 \u45768 \u54620  \u51216 , \u44263  \u44536 \u46308 \u51060  \u44396 \u49549 \u51452 \u51032  \u50689 \u44305 \u51012  \u45908 \u47101 \u55180  \u44163 \u44284 , \u48148 \u47196  \u44536  \u51088 \u49888 \u51060  \u44536 \u46308 \u47196  \u48276 \u51396 \u52992  \u54620  \u51216 \u46308 \u51012  \u51648 \u51201 \u54620 \u45796 . \u44536 \u47532 \u44256  \u44536 \u45716  \u44536 \u47111 \u44592  \u46412 \u47928 \u50640  \u44536 \u46308 \u51060  \u51088 \u44592  \u48177 \u49457 \u51060 \u46972 \u44256  \u51452 \u51109 \u54620 \u45796 .\
\uc0\u50696 \u49688 \u45784 \u44760 \u49436 \u45716  \u44536 \u46308 \u51032  \u51396 \u50640  \u45824 \u54616 \u50668  \u48320 \u47749 \u54616 \u51648  \u50506 \u51004 \u49888 \u45796 . \u44536 \u47084 \u45208  \u44536 \u46308 \u51032  \u54924 \u44060 \u50752  \u48127 \u51020 \u51012  \u48372 \u50668  \u51452 \u49884 \u44256  \u44536 \u46308 \u51060  \u50857 \u49436 \u48155 \u51008  \u44163 \u51012  \u51452 \u51109 \u54616 \u49888 \u45796 . \u44536 \u48516 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u49345 \u54620  \u49552 \u51012  \u54616 \u45208 \u45784  \u50500 \u48260 \u51648 \u50752  \u44144 \u47337 \u54620  \u52380 \u49324 \u46308  \u50526 \u50640  \u46300 \u49884 \u44256  \'93\u45236 \u44032  \u51200 \u55148  \u51060 \u47492 \u51012  \u50517 \u45768 \u45796 . \u45236  \u49552 \u48148 \u45797 \u50640  \u51200 \u55148  \u51060 \u47492 \u51012  \u49352 \u44220 \u49845 \u45768 \u45796 .\'94 \'93\u54616 \u45208 \u45784 \u51032  \u44396 \u54616 \u49884 \u45716  \u51228 \u49324 \u45716  \u49345 \u54620  \u49900 \u47161 \u51060 \u46972  \u54616 \u45208 \u45784 \u51060 \u50668  \u49345 \u54616 \u44256  \u53685 \u54924 \u54616 \u45716  \u47560 \u51020 \u51012  \u51452 \u44760 \u49436  \u47736 \u49884 \u52824  \u50500 \u45768 \u54616 \u49884 \u47532 \u51060 \u45796 \'94 (\u49884  51:17). \u44536 \u47532 \u44256  \u45817 \u49888 \u51032  \u48177 \u49457 \u51012  \u44256 \u49548 \u54616 \u45716  \u51088 \u47484  \u54693 \u54616 \u50668  \'93\u49324 \u45800 \u50500  \u50668 \u54840 \u50752 \u44032  \u45320 \u47484  \u52293 \u47581 \u54616 \u45432 \u46972  \u50696 \u47336 \u49332 \u47128 \u51012  \u53469 \u54620  \u50668 \u54840 \u50752 \u44032  \u45320 \u47484  \u52293 \u47581 \u54616 \u45432 \u46972  \u51060 \u45716  \u48520 \u50640 \u49436  \u44732 \u45240  \u44536 \u51012 \u47536  \u45208 \u47924 \u44032  \u50500 \u45768 \u45264 \'94 (\u49829  3:2) \u44256  \u47568 \u50432 \u54616 \u49888 \u45796 . \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u50500 \u48260 \u51648 \u44760  \u52649 \u49457 \u46108  \u48177 \u49457 \u46308 \u51012  \'93\u54000 \u45208  \u51452 \u47492  \u51105 \u55180  \u44163 \u51060 \u45208  \u51060 \u47088  \u44163 \u46308 \u51060  \u50630 \'94\u45716  \'93\u50689 \u44305 \u49828 \u47084 \u50868  \u44368 \u54924 \'94\u47196  \u45208 \u53440 \u45236 \u44592  \u50948 \u54616 \u50668  \u45817 \u49888 \u51032  \u51032 \u51032  \u50743 \u51012  \u51077 \u55176 \u49892  \u44163 \u51060 \u45796  (\u50657  5:27). \u44536 \u46308 \u51032  \u51060 \u47492 \u51008  \u49373 \u47749 \u52293 \u50640  \u44592 \u47197 \u46104 \u50612  \u51080 \u45796 . \u44536 \u47532 \u44256  \'93\u55152 \u50743 \u51012  \u51077 \u44256  \u45208 \u50752  \u54632 \u44760  \u45796 \u45768 \u47532 \u45768  \u44536 \u46308 \u51008  \u54633 \u45817 \u54620  \u51088 \u51064  \u50672 \u44256 \u46972 \'94 (\u44228  3:4) \u44256  \u44536 \u46308 \u50640  \u44288 \u54616 \u50668  \u44592 \u47197 \u46104 \u50612  \u51080 \u45796 .\
