\uc0\u47932 \u47200  \u50976 \u54620 \u54620  \u49324 \u46988 \u51032  \u51648 \u47141  (\u30693 \u21147 ) \u51012  \u44032 \u51648 \u44256  \u47924 \u54620 \u54616 \u49888  \u48516 \u51032  \u44228 \u54925 \u51012  \u51060 \u54644 \u54620 \u45796 \u46304 \u44032  \u44536 \u48516 \u51032  \u47785 \u51201 \u51032  \u49457 \u52712 \u46104 \u45716  \u44284 \u51221 \u51012  \u50756 \u51204 \u55176  \u51060 \u54644 \u54624  \u49688 \u45716  \u50630 \u51648 \u47560 \u45716  \u49324 \u46988 \u51060  \u54616 \u45208 \u45784 \u44760 \u49436  \u51452 \u49888  \u44592 \u48324 \u51012  \u51060 \u54644 \u54616 \u45716  \u51068 \u50640  \u51080 \u50612 \u49436  \u44536 \u53664 \u47197  \u50864 \u46164 \u54620  \u44163 \u51008  \u44536 \u46308 \u51032  \u51096 \u47803 \u51060 \u45208  \u44172 \u51004 \u47492  \u46412 \u47928 \u51060 \u45796 . \u51068 \u48152  \u49324 \u46988 \u46308 \u51008  \u47932 \u47200 \u51060 \u50836  \u54616 \u45208 \u45784 \u51032  \u51333 \u46308 \u44620 \u51648 \u46020  \u49324 \u46988 \u46308 \u51032  \u44204 \u54644 \u50752  \u50976 \u51204 \u44284  \u44144 \u51667  \u44368 \u54984  \u46412 \u47928 \u50640  \u45576 \u51060  \u50612 \u46160 \u50892 \u51256 \u49436  \u54616 \u45208 \u45784 \u44760 \u49436  \u45817 \u49888 \u51032  \u47568 \u50432 \u51012  \u53685 \u54616 \u50668  \u48157 \u54784 \u51452 \u49888  \u53360  \u49324 \u44148 \u46308 \u51012  \u48512 \u48516 \u51201 \u51004 \u47196 \u48150 \u50640  \u51060 \u54644 \u54616 \u51648  \u47803 \u54616 \u45716  \u44221 \u50864 \u44032  \u45320 \u47924 \u46020  \u47566 \u45796 . \u44396 \u51452 \u44760 \u49436  \u49464 \u49345 \u50640  \u44228 \u49892  \u45817 \u49884 \u51032  \u51228 \u51088 \u46308 \u44620 \u51648 \u46972 \u46020  \u44536 \u47084 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u47700 \u49884 \u50556 \u44760 \u49436  \u51060  \u49464 \u49345 \u51032  \u51076 \u44552 \u51004 \u47196  \u50724 \u49884 \u47732  \u51060 \u49828 \u46972 \u50648  \u45208 \u46972 \u44032  \u50728  \u49464 \u44228 \u47484  \u53685 \u52824 \u54616 \u44172  \u46112  \u44163 \u51060 \u46972 \u45716  \u51068 \u48152  \u49324 \u46988 \u46308 \u51032  \u49373 \u44033 \u50640  \u49324 \u47196 \u51105 \u54784  \u51080 \u50632 \u44592  \u46412 \u47928 \u50640  \u51452 \u49900 \u44760 \u49436  \u48155 \u51004 \u49892  \u44256 \u45212 \u44284  \u51453 \u51020 \u51012  \u50696 \u50616 \u54620  \u47568 \u50432 \u51032  \u46907 \u51012  \u51060 \u54644 \u54624  \u49688  \u50630 \u50632 \u45796 . \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \'93\u46412 \u44032  \u52284 \u44256  \u54616 \u45208 \u45784  \u45208 \u46972 \u44032  \u44032 \u44620 \u50912 \u51004 \u45768  \u54924 \u44060 \u54616 \u44256  \u48373 \u51020 \u51012  \u48127 \u51004 \u46972 \'94 (\u47561  1:15) \u45716  \u44592 \u48324 \u51012  \u51452 \u50612 \u49436  \u51228 \u51088 \u46308 \u51012  \u45236 \u48372 \u45236 \u49512 \u45796 . \u44536  \u44592 \u48324 \u51008  \u45796 \u45768 \u50648 \u49436  9\u51109 \u50640  \u44540 \u44144 \u54620  \u44163 \u51060 \u50632 \u45796 . \u52380 \u49324 \u45716  69\u51452 \u51068  \u54980 \u50640  \'93\u44592 \u47492 \u48512 \u51020 \u51012  \u48155 \u51008  \u51088  \u44263  \u50773 \'94\u51060  \u51068 \u50612 \u45208 \u47532 \u46972 \u44256  \u49440 \u50616 \u54616 \u50688 \u45912  \u44163 \u51060 \u45796 . \u44536 \u47084 \u48064 \u47196  \u51228 \u51088 \u46308 \u51008  \u50896 \u45824 \u54620  \u55148 \u47581 \u44284  \u51600 \u44144 \u50868  \u44592 \u45824 \u47484  \u44032 \u51648 \u44256  \u47700 \u49884 \u50556 \u51032  \u50773 \u44397 \u51060  \u50696 \u47336 \u49332 \u47128 \u50640  \u44148 \u49444 \u46104 \u50612  \u50728  \u49464 \u44228 \u47484  \u51648 \u48176 \u54624  \u45216 \u51060  \u50724 \u44592 \u47484  \u48148 \u46972 \u48372 \u44256  \u51080 \u50632 \u45912  \u44163 \u51060 \u45796 .\
\uc0\u44536 \u46308 \u51008  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u47585 \u44592 \u49888  \u44592 \u48324 \u51012  \u51204 \u54028 \u54616 \u50688 \u51648 \u47564  \u44536 \u46308  \u51088 \u49888 \u51060  \u44536  \u44592 \u48324 \u51032  \u51032 \u48120 \u47484  \u50724 \u54644 \u54616 \u44256  \u51080 \u50632 \u45796 . \u44536 \u46308 \u51008  \u45796 \u45768 \u50648 \u49436  9\u51109  25\u51208 \u51012  \u44540 \u44144 \u47196  \u44592 \u48324 \u51012  \u51204 \u54616 \u50688 \u51648 \u47560 \u45716  \u44536  \u45796 \u51020 \u51208 \u50640  \u44592 \u47197 \u46108  \u44592 \u47492 \u48512 \u51020 \u51012  \u48155 \u45716  \u51088 \u44032  \u45130 \u50612 \u51648 \u47532 \u46972 \u45716  \u47568 \u50432 \u51008  \u44648 \u45803 \u51648  \u47803 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u49464 \u49345 \u50640  \u45208 \u47732 \u49436 \u48512 \u53552  \u44536  \u47560 \u51020 \u51060  \u49464 \u49345  \u45208 \u46972 \u51032  \u50689 \u44305 \u50640  \u44256 \u52265 \u46104 \u50612  \u51080 \u50632 \u51004 \u48064 \u47196  \u50696 \u50616 \u51032  \u51088 \u49464 \u54620  \u45236 \u50857 \u44284  \u44536 \u47532 \u49828 \u46020 \u51032  \u47568 \u50432 \u44620 \u51648 \u46020  \u46020 \u47924 \u51648  \u51060 \u54644 \u54624  \u49688  \u50630 \u50632 \u45796 .\
\uc0\u44536 \u46308 \u51008  \u50976 \u45824  \u48177 \u49457 \u46308 \u50640 \u44172  \u51088 \u48708 \u51032  \u52488 \u52397 \u51012  \u54632 \u51004 \u47196  \u44536 \u46308 \u51032  \u51032 \u47924 \u47484  \u51060 \u54665 \u54616 \u50688 \u45796 . \u44536 \u47532 \u44256  \u44536 \u46308 \u51060  \u51452 \u45784 \u44760 \u49436  \u45796 \u50967 \u51032  \u48372 \u51340 \u50640  \u50724 \u47476 \u49892  \u44163 \u51004 \u47196  \u44592 \u45824 \u54616 \u44256  \u51080 \u51012  \u44536  \u46412 \u50640 , \u51452 \u45784 \u44760 \u49436 \u45716  \u46907 \u48150 \u50640 \u46020  \u51396 \u51064 \u51004 \u47196  \u52404 \u54252 \u46104 \u50612  \u47588 \u47484  \u47582 \u51004 \u49884 \u44256 , \u51312 \u47217 \u51012  \u48155 \u51004 \u49884 \u44256 , \u51221 \u51396 \u51032  \u49440 \u44256 \u47484  \u48155 \u50500  \u44040 \u48148 \u47532 \u51032  \u49901 \u51088 \u44032 \u50640  \u47803  \u48149 \u55176 \u49884 \u45716  \u44163 \u51012  \u44536 \u46308 \u51008  \u47785 \u44201 \u54616 \u50688 \u45796 . \u51452 \u45784 \u44760 \u49436  \u47924 \u45924 \u50640 \u49436  \u49772 \u44256  \u44228 \u49884 \u45716  \u46041 \u50504 , \u51228 \u51088 \u46308 \u51032  \u48127 \u51020 \u51008  \u50620 \u47560 \u45208  \u53360  \u49892 \u47581 \u44284  \u48264 \u48124 \u51004 \u47196  \u52649 \u44201 \u51012  \u48155 \u50520 \u45912 \u44032 !\
