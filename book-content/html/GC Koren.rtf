\uc0\u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u49440 \u51648 \u51088 \u51032  \u44544 \u50640  \u50696 \u50616 \u46108  \u48148 \u47196  \u44536  \u49884 \u44592 \u50640 , \u46608 \u54620  \u44536 \u45824 \u47196 \u51032  \u47784 \u50577 \u51004 \u47196  \u50724 \u49512 \u45796 . \u49457 \u44221 \u51032  \u51613 \u50616 \u51008  \u44536 \u48516 \u51032  \u48393 \u49324 \u47484  \u49464 \u48128 \u54620  \u48512 \u48516 \u50640  \u51060 \u47476 \u44592 \u44620 \u51648  \u47568 \u54664 \u45796 . \u44536 \u48516 \u44760 \u49436 \u45716  \u44396 \u50896 \u51032  \u44592 \u48324 \u51012  \u51204 \u54028 \u54616 \u50688 \u51004 \u47728  \u44536 \u48516 \u51032  \u47568 \u50432 \u50640 \u45716  \'93\u44428 \u49464 \u44032  \u51080 \u51020 \u51060 \u47084 \u46972 .\'94 \u44536 \u48516 \u51032  \u47568 \u50432 \u51012  \u46308 \u51008  \u49324 \u46988 \u46308 \u51008  \u44536  \u44592 \u48324 \u51060  \u54616 \u45720 \u50640 \u49436  \u50728  \u44592 \u48324 \u51076 \u51012  \u47785 \u44201 \u54616 \u50688 \u45796 . \u44536  \u47568 \u50432 \u44284  \u54616 \u45208 \u45784 \u51032  \u49457 \u47161 \u51008  \u54616 \u45208 \u45784 \u51032  \u50500 \u46308 \u51032  \u44144 \u47337 \u54620  \u49324 \u47749 \u51012  \u51077 \u51613 \u54616 \u50688 \u45796 .\
\uc0\u51228 \u51088 \u46308 \u46020  \u44536 \u46308 \u51032  \u49324 \u46993 \u54616 \u45716  \u51452 \u45784 \u50640  \u45824 \u54616 \u50668  \u50668 \u51204 \u55176  \u44618 \u51008  \u50528 \u51221 \u51012  \u44032 \u51648 \u44256  \u51080 \u50632 \u45796 . \u44536 \u47111 \u51648 \u47564  \u44536 \u46308 \u51032  \u47560 \u51020 \u51008  \u48520 \u50504 \u44284  \u51032 \u54841 \u50640  \u46168 \u47140  \u51080 \u50632 \u45796 . \u44536 \u46308 \u51008  \u48264 \u48124 \u50640  \u49324 \u47196 \u51105 \u55180  \u45208 \u47672 \u51648  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u45817 \u49888 \u51032  \u44256 \u45212 \u44284  \u51453 \u51004 \u49900 \u50640  \u44288 \u54616 \u50668  \u48120 \u47532  \u47568 \u50432 \u54616 \u49888  \u48148 \u47484  \u44592 \u50613 \u54616 \u51648  \u47803 \u54616 \u50688 \u45796 . \u45208 \u49324 \u47131  \u50696 \u49688 \u45784 \u44760 \u49436  \u52280 \u51004 \u47196  \u47700 \u49884 \u50556 \u51060 \u49512 \u45908 \u46972 \u47732  \u44536 \u46308 \u51060  \u44536 \u52376 \u47100  \u48708 \u50528 \u50752  \u49892 \u47581 \u50640  \u48736 \u51656  \u49688  \u51080 \u50632 \u44192 \u45716 \u44032 ? \u44536 \u50752  \u44057 \u51008  \u51032 \u47928 \u51060  \u44536  \u51208 \u47581 \u51201 \u51064  \u50504 \u49885 \u51068 , \u44263  \u44396 \u51452 \u44760 \u49436  \u46028 \u50500 \u44032 \u49888  \u54980  \u48512 \u54876 \u54616 \u49884 \u44592 \u44620 \u51648  \u47924 \u45924 \u49549 \u50640  \u45572 \u50892  \u44228 \u49884 \u45716  \u46041 \u50504 , \u44536 \u46308 \u51032  \u47560 \u51020 \u51012  \u47801 \u49884  \u44340 \u47213 \u54804 \u45796 .\
\uc0\u44536 \u47084 \u45208  \u48708 \u47197  \u49836 \u54548 \u51032  \u48164 \u51060  \u50696 \u49688 \u45784 \u51032  \u51228 \u51088 \u46308 \u51012  \u50612 \u46176 \u51004 \u47196  \u46168 \u47084 \u49932 \u51012 \u51648 \u46972 \u46020  \u44536 \u46308 \u51008  \u48260 \u47536  \u48148  \u46104 \u51648  \u50500 \u45768 \u54616 \u50688 \u45796 . \u49440 \u51648 \u51088 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u54616 \u50688 \u45796 . \'93\u45208 \u45716 \'85\u50612 \u46160 \u50868  \u45936  \u50505 \u51012 \u51648 \u46972 \u46020  \u50668 \u54840 \u50752 \u44760 \u49436  \u45208 \u51032  \u48731 \u51060  \u46104 \u49892  \u44163 \u51076 \u51060 \u47196 \u45796 \'85\u51452 \u44760 \u49436  \u45208 \u47484  \u51064 \u46020 \u54616 \u49324  \u44305 \u47749 \u50640  \u51060 \u47476 \u44172  \u54616 \u49884 \u47532 \u45768  \u45236 \u44032  \u44536 \u51032  \u51032 \u47484  \u48372 \u47532 \u47196 \u45796 .\'94 \'93\u51452 \u50640 \u44172 \u49436 \u45716  \u55121 \u50516 \u51060  \u49704 \u44592 \u51648  \u47803 \u54616 \u47728  \u48164 \u51060  \u45230 \u44284  \u44057 \u51060  \u48708 \u52712 \u45208 \u45768  \u51452 \u50640 \u44172 \u45716  \u55121 \u50516 \u44284  \u48731 \u51060  \u51068 \u48152 \u51060 \u45768 \u45796 .\'94 \u46608  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \'93\u51221 \u51649 \u54620  \u51088 \u50640 \u44172 \u45716  \u55121 \u50516  \u51473 \u50640  \u48731 \u51060  \u51068 \u50612 \u45208 \u45208 \u45768 \'94, \'93\u49548 \u44221 \u51012  \u44536 \u46308 \u51032  \u50508 \u51648  \u47803 \u54616 \u45716  \u44600 \u47196  \u51060 \u45132 \u47728  \u44536 \u46308 \u51032  \u50508 \u51648  \u47803 \u54616 \u45716  \u52393 \u44221 \u51004 \u47196  \u51064 \u46020 \u54616 \u47728  \u55121 \u50516 \u51004 \u47196  \u44536  \u50526 \u50640  \u44305 \u47749 \u51060  \u46104 \u44172  \u54616 \u47728  \u44413 \u51008  \u45936 \u47484  \u44263 \u44172  \u54624  \u44163 \u51060 \u46972  \u45236 \u44032  \u51060  \u51068 \u510