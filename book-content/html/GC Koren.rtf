\f1\b0 \cf0 \
\uc0\u46021 \u51068 \u50640 \u49436 \u45716  18\u49464 \u44592 \u50640  \u47336 \u53552  \u44368 \u54924 \u51032  \u54620  \u47785 \u49324 \u50836  \u49457 \u44221 \u54617 \u51088 \u50836  \u54217 \u47200 \u44032 \u47196  \u50976 \u47749 \u54620  \u48309 \u44180 \u51060 \u46972 \u45716  \u49324 \u46988 \u51060  \u51060  \u44368 \u47532 \u47484  \u44032 \u47476 \u52452 \u45796 . \u48309 \u44180 \u51008  \u54617 \u50629 \u51012  \u47560 \u52824 \u44256  \u49888 \u54617  \u50672 \u44396 \u47484  \u49884 \u51089 \u54616 \u50688 \u45716 \u45936 , \u44536 \u44032  \u48155 \u51008  \u52488 \u44592 \u51032  \u44368 \u50977 \u44284  \u54984 \u47144 \u51008  \u44536 \u51032  \u47560 \u51020 \u50640  \u48376 \u47000 \u48512 \u53552  \u44032 \u51648 \u44256  \u51080 \u45912  \u50628 \u49689 \u54620  \u49373 \u44033 \u44284  \u51333 \u44368 \u51201  \u44592 \u51656 \u51012  \u44618 \u44172  \u54616 \u44256  \u44053 \u54616 \u44172  \u54616 \u50688 \u45796 . \u44536 \u46020  \u50669 \u49884  \u44256 \u44552 \u51012  \u47561 \u47200 \u54616 \u44256  \u49324 \u44256 \u47141  (\u24605 \u32771 \u21147 ) \u51060  \u47566 \u51008  \u45796 \u47480  \u52397 \u45380 \u46308 \u52376 \u47100  \u51333 \u44368 \u51201  \u51032 \u47928 \u44284  \u50612 \u47140 \u50868  \u47928 \u51228 \u46308 \u47196  \u51064 \u54616 \u50668  \u48264 \u48124 \u54616 \u50688 \u45716 \u45936 , \u44536 \u45716  \u44048 \u44060 \u47924 \u47049 \u54620  \u44032 \u50868 \u45936  \'93\u51088 \u44592 \u51032  \u44032 \u47144 \u54620  \u47560 \u51020 \u51012  \u45040 \u46763 \u44256  \u44536  \u51210 \u51008  \u44048 \u51221 \u51012  \u47803  \u44204 \u46356 \u44172  \u47564 \u46308 \u50632 \u45912  \u54728 \u45796 \u54620  \u54868 \u49332 \u46308 \u50640  \u45824 \u54616 \u50668  \u47568 \u54616 \u50688 \u45796 .\'94 \u48708 \u53584 \u48288 \u47476 \u53356 \u51032  \u51333 \u44368  \u48277 \u50896  (\u23447 \u25934 \u27861 \u38498 ) \u51032  \u51068 \u50896 \u51060  \u46104 \u51088  \u44536 \u45716  \u51333 \u44368  \u51088 \u50976 \u47484  \u48512 \u47476 \u51670 \u50632 \u45796 . \'93\u44536 \u45716  \u44368 \u54924 \u51032  \u44428 \u47532 \u50752  \u53945 \u44428 \u51012  \u51452 \u51109 \u54616 \u45716  \u54620 \u54200 , \u50577 \u49900 \u51012  \u50948 \u54616 \u50668  \u44368 \u54924 \u50640 \u49436  \u47932 \u47084 \u45216  \u49688 \u48150 \u50640  \u50630 \u45796 \u44256  \u49373 \u44033 \u54616 \u45716  \u49324 \u46988 \u46308 \u51060  \u45817 \u50672 \u55176  \u45572 \u47540  \u50728 \u44054  \u51088 \u50976 \u47484  \u50948 \u54616 \u45716  \u50745 \u54840 \u51088 \u44032  \u46104 \u50632 \u45796 \'94 (Encyclo-pedia Britannica, 9th ed., art.\'93Bengel\'94). \u44536 \u50752  \u44057 \u51008  \u48169 \u52840 \u50640 \u49436  \u45208 \u50728  \u54988 \u47469 \u54620  \u44208 \u44284 \u44032  \u50724 \u45720 \u45216 \u50640 \u46020  \u44536 \u51032  \u44256 \u54693 \u50640  \u45224 \u50500  \u51080 \u45796 .\
\uc0\u44536 \u47532 \u49828 \u46020 \u51032  \u51116 \u47548 \u51032  \u51652 \u47532 \u44032  \u48309 \u44180 \u51032  \u47560 \u51020 \u50640  \u54869 \u49888 \u51012  \u51456  \u44163 \u51008  \u44536 \u44032  \u44053 \u47548 \u51208  (\u38477 \u33256 \u31680 ) \u51032  \u51068 \u50836 \u51068 \u50640  \u49324 \u50857 \u54624  \u49444 \u44368 \u51032  \u51456 \u48708 \u47484  \u50948 \u54616 \u50668  \u50836 \u54620 \u44228 \u49884 \u47197  21\u51109 \u51012  \u50672 \u44396 \u54616 \u45912  \u46412 \u51060 \u50632 \u45796 . \u44536 \u45716  \u51060 \u46412 \u50640  \u50836 \u54620 \u44228 \u49884 \u47197 \u51032  \u50696 \u50616 \u46308 \u51012  \u44284 \u44144  \u50612 \u45712  \u46412 \u48372 \u45796  \u51096  \u51060 \u54644 \u54616 \u44172  \u46104 \u50632 \u45796 . \u44536 \u45716  \u44536  \u50696 \u50616 \u50640  \u45208 \u53440 \u45212  \u44305 \u44221 \u51060  \u45320 \u47924 \u46020  \u51473 \u45824 \u54616 \u44256  \u50689 \u44305 \u49828 \u47101 \u45796 \u45716  \u49373 \u44033 \u50640  \u50517 \u46020 \u46104 \u50612  \u54620 \u46041 \u50504  \u44536  \u47928 \u51228 \u50640  \u45824 \u54620  \u47749 \u49345 \u51012  \u51473 \u51648 \u54624  \u49688 \u48150 \u50640  \u50630 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44536 \u44032  \u44053 \u45800 \u50640 \u49436  \u49444 \u44368 \u47484  \u54616 \u44172  \u46104 \u51088  \u44536  \u49373 \u44033 \u51008  \u45796 \u49884  \u49373 \u49373 \u54616 \u44172 , \u46608 \u54620  \u45733 \u47141  \u51080 \u44172  \u44536 \u50640 \u44172  \u45208 \u53440 \u45228 \u45796 . \u44536 \u46412 \u48512 \u53552  \u44536 \u45716  \u50696 \u50616 \u49436 , \u53945 \u55176  \u50836 \u54620 \u44228 \u49884 \u47197 \u51032  \u50672 \u44396 \u50640  \u47792 \u46160 \u54616 \u50688 \u45716 \u45936 , \u50724 \u47000 \u51648  \u50500 \u45768 \u54616 \u50668  \u44536  \u50696 \u50616 \u49436 \u50640 \u49436  \u44032 \u47476 \u52824 \u44256  \u51080 \u45716  \u44536 \u47532 \u49828 \u46020 \u51032  \u51116 \u47548 \u51060  \u44032 \u44620 \u50912 \u45796 \u45716  \u49888 \u50521 \u51012  \u44032 \u51648 \u44172  \u46104 \u50632 \u45796 . \u44536 \u47532 \u44256  \u44536 \u44032  \u44536 \u47532 \u49828 \u46020 \u51032  \u51116 \u47548 \u51032  \u46412 \u46972 \u44256  \u54869 \u51221 \u54620  \u50672 \u45824 \u45716  \u44536  \u54980 \u50640  \u48128 \u47084 \u44032  \u51452 \u51109 \u54620  \u50672 \u45824 \u50752  \u48708 \u44368 \u54616 \u47732  \u47588 \u50864  \u44540 \u49548 \u54620  \u52264 \u51060 \u48150 \u50640  \u50630 \u50632 \u45796 .\
\uc0\u48309 \u44180 \u51032  \u51200 \u49436 \u45716  \u44536 \u47532 \u49828 \u46020 \u44368 \u44397 \u50640  \u45328 \u47532  \u51204 \u54616 \u50668 \u51276 \u45796 . \u50696 \u50616 \u50640  \u44288 \u54620  \u44536 \u51032  \u44204 \u54644 \u45716  \u44536 \u51032  \u44256 \u54693 \u51064  \u48708 \u53584 \u48288 \u47476 \u53356 \u50640 \u49436  \u51068 \u48152 \u51201 \u51004 \u47196  \u51096  \u48155 \u50500 \u46308 \u50668 \u51276 \u51004 \u47728 , \u46608 \u54620  \u46021 \u51068 \u51032  \u45796 \u47480  \u51648 \u48169 \u50640 \u46020  \u51204 \u54644 \u51276 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536  \u50868 \u46041 \u51008  \u44536 \u44032  \u51453 \u51008  \u54980 \u50640 \u46020  \u44228 \u49549 \u46104 \u50632 \u45716 \u45936 , \u51116 \u47548 \u44592 \u48324 \u51008  \u46021 \u51068 \u50640 \u49436 \u46020  \u45796 \u47480  \u45208 \u46972 \u46308 \u44284  \u44057 \u51008  \u49884 \u44592 \u50640  \u51204 \u54028 \u46104 \u50632 \u45796 . \u46608 \u54620  \u52488 \u44592 \u51032  \u49888 \u51088 \u46308  \u51473 \u51032  \u47751  \u49324 \u46988 \u51060  \u47084 \u49884 \u50500 \u47196  \u44032 \u49436  \u49332 \u44172  \u46104 \u50632 \u45716 \u45936 , \u44536 \u46308 \u51008  \u44536 \u44275 \u50640 \u49436  \u51060 \u48124 \u45800 \u51012  \u51312 \u51649 \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u50724 \u45720 \u45216 \u50640 \u46020  \u44536  \u45208 \u46972 \u51032  \u46021 \u51068 \u51064  \u44368 \u54924 \u45716  \u44536 \u47532 \u49828 \u46020 \u51032  \u51116 \u47548 \u51032  \u49888 \u50521 \u51012  \u51316 \u49549 \u49884 \u53412 \u44256  \u51080 \u45796 .\
