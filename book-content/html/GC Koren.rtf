\uc0\u44536 \u47084 \u45208  \u44228 \u49549 \u51201 \u51004 \u47196  \u48120 \u44397 \u51032  \u54644 \u50504 \u51004 \u47196  \u44148 \u45320 \u50724 \u45716  \u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u45817 \u52488 \u51032  \u54596 \u44536 \u47548 \u46308 \u44284 \u45716  \u51204 \u50672  \u45796 \u47480  \u47785 \u51201 \u51004 \u47196  \u50724 \u44172  \u46104 \u50632 \u45796 . \u52488 \u44592 \u51032  \u49888 \u50521 \u44284  \u49692 \u44208 \u51060  \u45331 \u51008  \u48276 \u50948 \u50640  \u44152 \u52432 \u49436  \u50689 \u54693 \u51012  \u48120 \u52824 \u44256  \u51080 \u50632 \u51648 \u47564  \u49464 \u49549 \u51201  \u51060 \u51061 \u47564 \u51012  \u52286 \u50500 \u50724 \u45716  \u49324 \u46988 \u46308 \u51032  \u49688 \u44032  \u51613 \u44032 \u46120 \u50640  \u46384 \u46972  \u48376 \u47000  \u51221 \u49888 \u51008  \u51216 \u51216  \u55120 \u47140 \u51256  \u44052 \u45796 .\
\uc0\u50724 \u51649  \u44368 \u54924 \u51032  \u44368 \u51064 \u47564 \u51060  \u53804 \u54364 \u44428 \u51012  \u44032 \u51648 \u47728  \u51221 \u48512  \u44592 \u44288 \u51032  \u44277 \u51649 \u51012  \u50619 \u51012  \u49688  \u51080 \u46020 \u47197  \u52488 \u44592 \u51032  \u51060 \u51452 \u48124 \u46308 \u51060  \u52292 \u53469 \u54620  \u44508 \u51221 \u51008  \u44032 \u51109  \u54644 \u47196 \u50868  \u44208 \u44284 \u47484  \u52488 \u47000 \u54616 \u50688 \u45796 . \u44536  \u48277 \u50504 \u51008  \u51452  (\u24030 ) \u51032  \u49692 \u49688 \u49457 \u51012  \u48372 \u51316 \u54616 \u45716  \u54620  \u48169 \u54200 \u51004 \u47196  \u52292 \u53469 \u46104 \u50632 \u51004 \u45208 , \u44208 \u44284 \u51201 \u51004 \u47196 \u45716  \u44368 \u54924 \u51032  \u48512 \u54056 \u47484  \u52488 \u47000 \u54616 \u50688 \u45796 . \u49888 \u50521  \u44256 \u48177 \u51060  \u52280 \u51221 \u44428 \u44284  \u44288 \u51649 \u51012  \u50619 \u45716  \u51312 \u44148 \u51060  \u46104 \u50632 \u51004 \u48064 \u47196  \u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u47560 \u51020 \u51032  \u48320 \u54868  \u50630 \u51060  \u45796 \u47564  \u49464 \u49549 \u51201  \u51221 \u52293 \u51060  \u46041 \u44592 \u44032  \u46104 \u50612  \u44368 \u54924 \u50640  \u51077 \u44368 \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44368 \u54924 \u46308 \u51008  \u49345 \u45817 \u55176  \u45331 \u51008  \u48276 \u50948 \u50640  \u44152 \u52432  \u54924 \u44060 \u54616 \u51648  \u50500 \u45768 \u54620  \u49324 \u46988 \u46308 \u47196  \u47568 \u48120 \u50516 \u50500  \u51060 \u47336 \u50612 \u51648 \u44256 , \u49457 \u51649 \u51088 \u46308  \u51473 \u50640 \u49436 \u46020  \u44368 \u47532 \u49345 \u51032  \u50724 \u47448 \u47484  \u44032 \u51648 \u44256  \u51080 \u51012  \u49104 \u47564  \u50500 \u45768 \u46972  \u49457 \u47161 \u51032  \u49352 \u47213 \u44172  \u54616 \u49884 \u45716  \u45733 \u47141 \u51012  \u52404 \u54744 \u54616 \u51648  \u47803 \u54620  \u51088 \u46308 \u51060  \u51080 \u50632 \u45796 . \u44536 \u47532 \u54616 \u50668  \u53080 \u49828 \u53444 \u54000 \u45572 \u49828 \u51032  \u49884 \u45824 \u50640 \u49436  \u50724 \u45720 \u45216 \u50640  \u51060 \u47476 \u44592 \u44620 \u51648  \u44368 \u54924 \u51032  \u50669 \u49324 \u50640 \u49436  \u51068 \u48152 \u51201 \u51004 \u47196  \u55124 \u55176  \u48372 \u45716  \u45208 \u49244  \u44208 \u44284 \u44032  \u45796 \u49884  \u45208 \u53440 \u45228 \u45796 . \u44263  \'93\u45236  \u45208 \u46972 \u45716  \u51060  \u49464 \u49345 \u50640  \u49549 \u54620  \u44163 \u51060  \u50500 \u45768 \u46972 \'94 (\u50836  18:36) \u44256  \u47568 \u50432 \u54616 \u49888  \u50696 \u49688 \u45784 \u51032  \u48373 \u51020  \u49324 \u50629 \u51012  \u50976 \u51648 \u54616 \u44592  \u50948 \u54616 \u50668  \u44397 \u44032 \u51032  \u44428 \u47141 \u50640  \u54840 \u49548 \u54616 \u50668  \u44536  \u46020 \u50880 \u51012  \u50619 \u50612 \u49436  \u44368 \u54924 \u47484  \u49464 \u50864 \u44256 \u51088  \u49884 \u46020 \u54616 \u50688 \u45796 . \u44368 \u54924 \u50752  \u44397 \u44032 \u51032  \u50672 \u54633 \u51008  \u44208 \u53076  \u45824 \u49688 \u47213 \u51648  \u50506 \u51008  \u44163 \u52376 \u47100  \u48380  \u49688  \u50630 \u45716  \u44163 \u51060 \u45796 . \u44536 \u44163 \u51060  \u50808 \u44288 \u49345 \u51004 \u47196 \u45716  \u49464 \u49345 \u51012  \u44368 \u54924  \u54200 \u51004 \u47196  \u44032 \u44620 \u51060  \u51217 \u44540 \u49884 \u53412 \u45716  \u46319 \u51060  \u48372 \u51060 \u51648 \u47564  \u49324 \u49892 \u50640  \u51080 \u50612 \u49436 \u45716  \u44368 \u54924 \u47484  \u49464 \u49345  \u54200 \u51004 \u47196  \u45908 \u50865  \u44032 \u44620 \u51060  \u44032 \u44172  \u54616 \u45716  \u44163 \u50640  \u48520 \u44284 \u54616 \u45796 .\
\uc0\u47196 \u48712 \u49832 \u44284  \u47196 \u51200  \u50956 \u47532 \u50628 \u51592 \u44032  \u54988 \u47469 \u54616 \u44172  \u50745 \u54840 \u54620  \u50948 \u45824 \u54620  \u50896 \u52825 , \u44263  \u51652 \u47532 \u45716  \u51216 \u51652 \u51201 \u51064  \u44163 \u51060 \u48064 \u47196  \u44536 \u47532 \u49828 \u46020 \u51064 \u51008  \u54637 \u49345  \u49457 \u44221 \u50640 \u49436  \u45208 \u50724 \u45716  \u47784 \u46304  \u48731 \u51012  \u48155 \u50500 \u46308 \u51068  \u51456 \u48708 \u47484  \u44054 \u52628 \u44256  \u51080 \u50612 \u50556  \u54620 \u45796 \u45716  \u50896 \u52825 \u51012  \u44536 \u46308 \u51032  \u51088 \u49552 \u46308 \u51008  \u51082 \u50612 \u48260 \u47532 \u44256  \u47568 \u50520 \u45796 . \u44536 \u47532 \u54616 \u50668  \u48120 \u44397 \u51032  \u44060 \u49888 \u44368 \u46020 \u46308 \u51008 , \u50976 \u47101 \u51032  \u44060 \u49888 \u44368 \u46020 \u46308 \u46020  \u47560 \u52268 \u44032 \u51648 \u50688 \u51648 \u47564 , \u51333 \u44368 \u44060 \u54785 \u51032  \u54413 \u49457 \u54620  \u52629 \u48373 \u51012  \u48155 \u44256  \u51080 \u51004 \u47732 \u49436 \u46020 , \u44060 \u54785 \u51032  \u44600 \u51012  \u46384 \u46972  \u51204 \u51652 \u54616 \u45716  \u51068 \u50640  \u49892 \u54056 \u54616 \u50688 \u45796 . \u48708 \u47197  \u49548 \u49688 \u51032  \u49888 \u49892 \u54620  \u49324 \u46988 \u46308 \u51060  \u51068 \u50612 \u45208 \u49436  \u49352 \u47196 \u50868  \u51652 \u47532 \u47484  \u49440 \u54252 \u54616 \u44256  \u50724 \u47019 \u46041 \u50504  \u44256 \u51665 \u54616 \u50668  \u50724 \u45912  \u50724 \u47448 \u47484  \u54253 \u47196 \u54616 \u50688 \u51004 \u45208 , \u45824 \u45796 \u49688 \u51032  \u49324 \u46988 \u46308 \u51008  \u47560 \u52824  \u44536 \u47532 \u49828 \u46020  \u45817 \u49884 \u51032  \u50976 \u45824 \u51064 \u46308 \u51060 \u45208  \u47336 \u53552  \u45817 \u49884 \u51032  \u48277 \u50773 \u44368 \u46020 \u46308 \u44284  \u44057 \u51060  \u44536 \u46308 \u51032  \u51312 \u49345 \u46308 \u51060  \u48127 \u45912  \u44163 \u52376 \u47100  \u48127 \u44256 , \u44536 \u46308 \u51060  \u49373 \u54876 \u54616 \u45912  \u44163 \u52376 \u47100  \u49373 \u54876 \u54616 \u45716  \u44163 \u51012  \u47564 \u51313 \u54616 \u44172  \u50668 \u44220 \u45796 . \u44536 \u47532 \u54616 \u50668  \u51333 \u44368 \u45716  \u45796 \u49884  \u54805 \u49885 \u51452 \u51032 \u47196  \u51204 \u46973 \u54644  \u48260 \u47160 \u45796 . \u44536 \u47532 \u44256  \u47564 \u51068  \u44368 \u54924 \u44032  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51032  \u48731 \u51012  \u44228 \u49549 \u54644 \u49436  \u46384 \u46972 \u44052 \u45796 \u47732  \u45817 \u50672 \u55176  \u48176 \u52377 \u54624  \u49688 \u48150 \u50640  \u50630 \u45716  \u48120 \u49888 \u44284  \u50724 \u47448 \u47484  \u44036 \u51649 \u54616 \u44256  \u51648 \u53412 \u44172  \u46104 \u50632 \u45796 . \u51060 \u47532 \u54616 \u50668  \u51333 \u44368 \u44060 \u54785 \u51004 \u47196  \u51064 \u54616 \u50668  \u44256 \u47924 \u46104 \u50632 \u45912  \u51221 \u49888 \u51008  \u51216 \u52264  \u49324 \u46972 \u51256  \u48260 \u47160 \u44256 , \u47560 \u52840 \u45236  \u47336 \u53552  \u49884 \u45824 \u51032  \u47196 \u47560  \u44368 \u54924 \u52376 \u47100  \u44060 \u49888  \u44368 \u54924 \u46020  \u53360  \u44060 \u54785 \u51060  \u54596 \u50836 \u54620  \u51648 \u44221 \u50640  \u51060 \u47476 \u44172  \u46104 \u50632 \u45796 . \u46609 \u44057 \u51008  \u49464 \u49549 \u54868 \u50752  \u50689 \u51201  \u54844 \u48120  \u49345 \u53468 , \u51064 \u44036 \u51201  \u51032 \u44204 \u51032  \u51316 \u51473 , \u44536 \u47532 \u44256  \u49324 \u46988 \u51032  \u51060 \u47200 \u51012  \u44032 \u51648 \u44256  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51032  \u44368 \u54984 \u51012  \u45824 \u49888 \u54616 \u45716  \u51068 \u51060  \u51080 \u50632 \u45796 .\
