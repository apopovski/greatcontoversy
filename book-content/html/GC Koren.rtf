\uc0\u51652 \u47532 \u47484  \u44144 \u51208 \u54620  \u47784 \u46304  \u51088 \u46308 \u51032  \u49373 \u50528 \u50640 \u45716  \u50577 \u49900 \u51060  \u44033 \u49457 \u46104 \u44256 , \u50948 \u49440 \u51201  \u49373 \u54876 \u50640  \u45824 \u54620  \u44340 \u47196 \u50868  \u52628 \u50613 \u51060  \u46104 \u49332 \u50500 \u45208 \u49436  \u49900 \u47161 \u51060  \u54747 \u46108  \u54980 \u54924 \u47196  \u44340 \u47196 \u50880 \u51012  \u45817 \u54616 \u45716  \u49692 \u44036 \u46308 \u51060  \u51080 \u45796 . \u44536 \u47084 \u45208  \u44536 \u44163 \u51008  \'93\u46160 \u47140 \u50880 \u51060  \u44305 \u54413 \u44057 \u51060  \u51076 \u54616 \'94\u44256  \'93\u51116 \u50521 \u51060  \u54253 \u54413 \u44057 \u51060 \'94 (\u51104  1:27) \u51060 \u47476 \u45716  \u45216 \u50640  \u54616 \u45716  \u54980 \u54924 \u50752  \u48708 \u44368 \u44032  \u46104 \u51648  \u50506 \u45716 \u45796 . \u44536 \u47532 \u49828 \u46020 \u50752  \u44536 \u48516 \u51032  \u48177 \u49457 \u51012  \u51453 \u51060 \u47140 \u45912  \u51088 \u46308 \u51008  \u44536  \u49324 \u46988 \u46308  \u50948 \u50640  \u51080 \u45716  \u50689 \u44305 \u51012  \u48376 \u45796 . \u44536 \u46308 \u51060  \u44277 \u54252 \u50640  \u46504 \u44256  \u51080 \u51012  \u46412  \u44536 \u46308 \u51008  \u49457 \u46020 \u46308 \u51060  \u44592 \u49244  \u49548 \u47532 \u47196  \'93\u51060 \u45716  \u50864 \u47532 \u51032  \u54616 \u45208 \u45784 \u51060 \u49884 \u46972  \u50864 \u47532 \u44032  \u44536 \u47484  \u44592 \u45796 \u47160 \u51004 \u45768  \u44536 \u44032  \u50864 \u47532 \u47484  \u44396 \u50896 \u54616 \u49884 \u47532 \u47196 \u45796 \'94 (\u49324  25:9) \u44256  \u48512 \u47476 \u51670 \u45716  \u51020 \u49457 \u51012  \u46307 \u45716 \u45796 .\
\uc0\u46405 \u51060  \u55124 \u46308 \u47532 \u44256  \u48264 \u44060 \u44032  \u48264 \u51789 \u51060 \u44256  \u50864 \u47112  \u49548 \u47532 \u44032  \u50836 \u46976 \u54620  \u51473 \u50640  \u54616 \u45208 \u45784 \u51032  \u50500 \u46308 \u51032  \u51020 \u49457 \u51060  \u51088 \u45716  \u49457 \u46020 \u46308 \u51012  \u48520 \u47084 \u51068 \u51004 \u53416 \u45796 . \u51452 \u45784 \u44760 \u49436 \u45716  \u51032 \u51064 \u46308 \u51032  \u47924 \u45924 \u51012  \u48372 \u49884 \u44256  \u45817 \u49888 \u51032  \u49552 \u51012  \u54616 \u45720 \u51012  \u54693 \u54616 \u50668  \u46300 \u49884 \u44256 , \'93\u44648 \u50612 \u46972 , \u44648 \u50612 \u46972 , \u44648 \u50612 \u46972 , \u54000 \u45132  \u44032 \u50868 \u45936 \u49436  \u51088 \u45716  \u51088 \u50668 , \u51068 \u50612 \u45208 \u46972 !\'94\u44256  \u50808 \u52824 \u49888 \u45796 . \u51060  \u46405 \u51032  \u50612 \u45712  \u44275 \u50640 \u49436 \u45208  \u51453 \u51008  \u51088 \u46308 \u51060  \u44536  \u51020 \u49457 \u51012  \u46307 \u44172  \u46112  \u44163 \u51060 \u47728 , \u44536  \u51020 \u49457 \u51012  \u46307 \u45716  \u51088 \u45716  \u49332 \u50500 \u45216  \u44163 \u51060 \u45796 . \u51060 \u46412 \u50640  \u50728  \u49464 \u49345 \u51008  \u47784 \u46304  \u45208 \u46972 \u50752  \u51313 \u49549 \u44284  \u48169 \u50616 \u44284  \u48177 \u49457  \u51473 \u50640 \u49436  \u48512 \u54876 \u54620  \u53360  \u47924 \u47532 \u47196  \u49548 \u51020  (\u39479 \u38899 ) \u51060  \u51068 \u50612 \u45216  \u44163 \u51060 \u45796 . \u44536 \u46308 \u51008  \u49324 \u47581 \u51032  \u44048 \u50725 \u50640 \u49436  \u45208 \u50752  \u48520 \u47736 \u51032  \u50689 \u44305 \u51012  \u51077 \u44256  \'93\u49324 \u47581 \u50500  \u45320 \u51032  \u51060 \u44592 \u45716  \u44163 \u51060  \u50612 \u46356  \u51080 \u45712 \u45264  \u49324 \u47581 \u50500  \u45320 \u51032  \u50136 \u45716  \u44163 \u51060  \u50612 \u46356  \u51080 \u45712 \u45264 \'94 (\u44256 \u51204  15:55) \u44256  \u50808 