\uc0\u49324 \u46988 \u46308 \u51032  \u47784 \u50577 \u51012  \u54620  \u52380 \u49324 \u46308 \u51008  \u46412 \u46412 \u47196  \u51032 \u51064 \u46308 \u51032  \u51665 \u54924 \u50640  \u52280 \u49437 \u54620 \u45796 . \u44536 \u47532 \u44256  \u44536 \u46308 \u51008  \u49548 \u46036  \u49457 \u50640  \u44032 \u49436  \u44536  \u51452 \u48124 \u46308 \u51032  \u54665 \u50948 \u47484  \u44592 \u47197 \u54616 \u50668  \u54616 \u45208 \u45784 \u44760 \u49436  \u45908  \u51060 \u49345  \u50857 \u49436 \u54624  \u49688  \u50630 \u45716  \u54620 \u44228 \u47484  \u45336 \u44256  \u51080 \u45716 \u51648 \u51032  \u50668 \u48512 \u47484  \u44208 \u51221 \u54616 \u44256 \u51088  \u54664 \u45912  \u44163 \u52376 \u47100  \u50501 \u51064 \u46308 \u51032  \u51665 \u54924 \u50640 \u46020  \u48169 \u47928 \u54620 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u51088 \u48708 \u47484  \u48288 \u54392 \u49884 \u44592 \u47484  \u51600 \u44200 \u54616 \u49888 \u45796 . \u44536 \u48516 \u44760 \u49436 \u45716  \u46608 \u54620  \u45817 \u49888 \u51012  \u51652 \u49900 \u51004 \u47196  \u49452 \u44592 \u45716  \u49548 \u49688 \u51032  \u49324 \u46988  \u46412 \u47928 \u50640  \u51116 \u45212 \u51012  \u50613 \u51228 \u54616 \u49884 \u44256  \u47566 \u51008  \u49324 \u46988 \u46308 \u51032  \u54217 \u50504 \u51012  \u50672 \u51109 \u49884 \u53020 \u51452 \u49888 \u45796 . \u44536 \u47084 \u45208  \u54616 \u45208 \u45784 \u51012  \u45824 \u51201 \u54616 \u45716  \u51396 \u51064 \u46308 \u51008  \u44536 \u46308  \u51088 \u49888 \u51032  \u49373 \u47749 \u51060  \u44536 \u46308 \u51060  \u51312 \u47217 \u54616 \u44256  \u54605 \u48149 \u54616 \u45716  \u52649 \u49457 \u46108  \u49548 \u49688 \u51032  \u49324 \u46988 \u46308 \u51032  \u51008 \u54812 \u47196  \u51648 \u49549 \u46108 \u45796 \u45716  \u49324 \u49892 \u51012  \u44144 \u51032  \u44648 \u45803 \u51648  \u47803 \u54616 \u44256  \u51080 \u45796 .\
