\f1\b0 \cf0 \
\uc0\u45817 \u49884 \u50640  \u44536 \u46308 \u51032  \u47785 \u49324 \u50688 \u51648 \u47564  \u54616 \u45208 \u45784 \u51032  \u49453 \u47532 \u47196  \u44536 \u46308 \u44284  \u46041 \u54665 \u54624  \u49688  \u50630 \u50632 \u45912  \u51316  \u47196 \u48712 \u49832 \u51008  \u44536  \u47581 \u47749 \u51088 \u46308 \u44284  \u44256 \u48324 \u54616 \u45716  \u49444 \u44368 \u50640 \u49436  \u45796 \u51020 \u44284  \u44057 \u51008  \u47568 \u51012  \u54616 \u50688 \u45796 .\
\'93\uc0\u54805 \u51228 \u46308 \u51060 \u50668 , \u50864 \u47532 \u45716  \u51060 \u51228  \u48120 \u44396 \u50640  \u54756 \u50612 \u51656  \u49688 \u48150 \u50640  \u50630 \u49845 \u45768 \u45796 . \u45236 \u44032  \u54805 \u51228 \u46308 \u51032  \u50620 \u44404 \u51012  \u45796 \u49884  \u48380  \u49688  \u51080 \u51012  \u44163 \u51064 \u51648 \u45716  \u50724 \u51649  \u54616 \u45208 \u45784 \u44760 \u49436 \u47564  \u50500 \u49901 \u45768 \u45796 . \u51452 \u45784 \u44760 \u49436  \u45796 \u49884  \u47564 \u45216  \u44592 \u54924 \u47484  \u51452 \u49884 \u46304 \u51648  \u51452 \u49884 \u51648  \u50506 \u46304 \u51648  \u45208 \u45716  \u54616 \u45208 \u45784 \u44284  \u44144 \u47337 \u54620  \u52380 \u49324 \u46308  \u50526 \u50640 \u49436  \u54805 \u51228 \u46308 \u50640 \u44172  \u44428 \u47732 \u54633 \u45768 \u45796 . \u54805 \u51228 \u46308 \u51008  \u45236 \u44032  \u44536 \u47532 \u49828 \u46020 \u47484  \u46384 \u46972 \u44036  \u44536  \u47564 \u53372  \u45208 \u47484  \u46384 \u47476 \u44592 \u47484  \u48148 \u46989 \u45768 \u45796 . \u46608 \u54620  \u54616 \u45208 \u45784 \u44760 \u49436  \u45796 \u47480  \u51064 \u47932 \u51012  \u53685 \u54616 \u50668  \u47924 \u50631 \u51064 \u44032 \u47484  \u50668 \u47084 \u48516 \u50640 \u44172  \u45208 \u53440 \u45236  \u51452 \u49892  \u46412 , \u50668 \u47084 \u48516 \u51008  \u45208 \u51032  \u48393 \u49324 \u47484  \u53685 \u54616 \u50668  \u45208 \u53440 \u45236  \u51456  \u51652 \u47532 \u47484  \u48155 \u50500 \u46308 \u51064  \u44163 \u52376 \u47100  \u44536 \u44163 \u51012  \u48155 \u50500 \u46308 \u51060 \u44592 \u47484  \u48148 \u46989 \u45768 \u45796 . \u50780 \u45264 \u54616 \u47732  \u45208 \u45716  \u54616 \u45208 \u45784 \u44760 \u49436  \u45817 \u49888 \u51032  \u44144 \u47337 \u54620  \u47568 \u50432 \u50640 \u49436  \u44228 \u49884 \u54644  \u51452 \u49892  \u45908 \u50865  \u47566 \u51008  \u51652 \u47532 \u50752  \u48731 \u51012  \u44032 \u51648 \u44256  \u51080 \u45716  \u44163 \u51012  \u54869 \u49888 \u54616 \u44256  \u51080 \u44592  \u46412 \u47928 \u51077 \u45768 \u45796 \'94 (Martyn, vol.5, p.70).\
\'93\uc0\u45208  \u44060 \u51064 \u51004 \u47196 \u49436 \u45716  \u44060 \u49888 \u44368 \u51032  \u49345 \u53468 \u50640  \u45824 \u54616 \u50668  \u53444 \u49885 \u54644  \u47560 \u51648 \u50506 \u49845 \u45768 \u45796 . \u44536  \u44368 \u54924 \u45716  \u54620  \u46412  \u49888 \u50521 \u51201 \u51060 \u50632 \u51648 \u47564  \u44060 \u54785  \u50868 \u46041 \u51012  \u51068 \u51004 \u53416  \u51064 \u47932 \u46308  \u51060 \u49345 \u51004 \u47196 \u45716  \u54620  \u48156 \u44152 \u51020 \u46020  \u45908  \u45208 \u50500 \u44032 \u51648  \u47803 \u54620  \u54805 \u54200 \u51077 \u45768 \u45796 . \u47336 \u53552 \u44368 \u46020 \u45716  \u47336 \u53552 \u44032  \u44648 \u45804 \u51008  \u44163  \u51060 \u49345 \u51008  \u45908  \u44648 \u45803 \u51648  \u47803 \u54616 \u50688 \u49845 \u45768 \u45796 . \'85\u52860 \u48712 \u54028 \u51032  \u49888 \u46020 \u46308  \u50669 \u49884  \u50668 \u47084 \u48516 \u51060  \u48372 \u45716  \u48148 \u50752  \u44057 \u51060  \u44536  \u50948 \u45824 \u54620  \u54616 \u45208 \u45784 \u51032  \u49324 \u46988 , \u44536 \u47084 \u45208  \u47784 \u46304  \u44163 \u51012  \u45796  \u44648 \u45804 \u50520 \u45796 \u44256  \u54624  \u49688  \u50630 \u45716  \u44536  \u49324 \u46988 \u51060  \u45224 \u44596  \u44163 \u51012  \u44536 \u45824 \u47196  \u44256 \u49688 \u54616 \u44256  \u51080 \u51012  \u49104 \u51077 \u45768 \u45796 . \u51060 \u44163 \u51008  \u53444 \u49885 \u54624  \u49688 \u48150 \u50640  \u50630 \u45716  \u48520 \u54665 \u51077 \u45768 \u45796 . \u50780 \u45264 \u54616 \u47732  \u48708 \u47197  \u44536 \u46308 \u51060  \u44536  \u45817 \u49884 \u50640 \u45716  \u48157 \u44172  \u48708 \u52824 \u45716  \u48731 \u51060 \u50632 \u51648 \u47564 , \u44536 \u46308 \u51008  \u54616 \u45208 \u45784 \u51032  \u44144 \u47337 \u54620  \u46020 \u47532 \u51032  \u51204 \u48512 \u47484  \u48157 \u55176  \u44648 \u45803 \u51648 \u45716  \u47803 \u54616 \u50688 \u44592  \u46412 \u47928 \u51077 \u45768 \u45796 . \u44536 \u46308 \u51060  \u50724 \u45720 \u45216  \u49332 \u50500  \u51080 \u45796 \u47732  \u44536 \u46308 \u51008  \u48516 \u47749 \u55176  \u51200 \u55148 \u44032  \u52376 \u51020 \u50640  \u48155 \u51008  \u48731  \u51060 \u49345 \u51032  \u48731 \u51012  \u48155 \u44256 \u51088  \u44040 \u47581 \u54624  \u44163 \u51077 \u45768 \u45796 \'94 (D.Neal, History of the Puritans, vol.1, p.269).\
\'93\uc0\u51068 \u52237 \u51060  \u50668 \u47084 \u48516 \u51060  \u44368 \u54924 \u50640 \u49436  \u54620  \u49436 \u50557 , \u44263  \u51060 \u48120  \u50508 \u47140 \u51276 \u44144 \u45208  \u51109 \u52264  \u50508 \u47140 \u51656  \u51452 \u51032  \u44600 \u51012  \u50728 \u51204 \u55176  \u46384 \u46972 \u44032 \u44592 \u47196  \u54620  \u44536  \u49436 \u50557 \u51012  \u44592 \u50613 \u54616 \u49901 \u49884 \u50724 . \u54616 \u45208 \u45784 \u51032  \u44592 \u47197 \u46108  \u47568 \u50432 \u50640 \u49436  \u50668 \u47084 \u48516 \u50640 \u44172  \u50508 \u47140 \u51648 \u45716  \u51652 \u47532 \u50752  \u48731 \u51008  \u50612 \u46500  \u44163 \u51060 \u46304 \u51648  \u48155 \u50500 \u46308 \u51060 \u44192 \u45796 \u44256  \u54616 \u45208 \u45784 \u51012  \u54693 \u54616 \u50668 , \u44536 \u47532 \u44256  \u54588 \u52264 \u44036 \u50640  \u47609 \u49464 \u54616 \u44256  \u50557 \u49549 \u54620  \u48148 \u47484  \u44592 \u50613 \u54616 \u49901 \u49884 \u50724 . \u44536 \u47532 \u44256  \u46608 \u54620  \u44221 \u44228 \u54624  \u44163 \u51008  \u50668 \u47084 \u48516 \u51060  \u50612 \u46496 \u54620  \u44163 \u51012  \u51652 \u47532 \u47196  \u48155 \u50500 \u46308 \u51068  \u46412 \u45716  \u48152 \u46300 \u49884  \u44536 \u44163 \u51012  \u49457 \u44221 \u51032  \u45796 \u47480  \u51652 \u47532 \u50752  \u48708 \u44368 \u54616 \u44256  \u44204 \u51452 \u50612  \u48372 \u50500 \u50556  \u54620 \u45796 \u45716  \u44163 \u51077 \u45768 \u45796 . \u50780 \u45264 \u54616 \u47732  \u44536 \u47532 \u49828 \u46020 \u44368 \u45716  \u44537 \u55176  \u52572 \u44540 \u50640  \u48708 \u44536 \u47532 \u49828 \u46020 \u44368 \u51201  \u50516 \u55121  \u44032 \u50868 \u45936 \u49436  \u45208 \u50772 \u51012  \u49104 \u51060 \u48064 \u47196  \u50500 \u51452  \u50756 \u51204 \u54620  \u51648 \u49885 \u51060  \u54620 \u44732 \u48264 \u50640  \u51452 \u50612 \u51276 \u45796 \u44256  \u54624  \u49688  \u50630 \u44592  \u46412 \u47928 \u51077 \u45768 \u45796 \'94 (Martyn, vol.5, p.70, 71).\
\uc0\u44536  \u49692 \u47168 \u51088 \u46308 \u51012  \u44256 \u47924 \u49884 \u53020  \u44596  \u50668 \u54665 \u51032  \u50948 \u54744 \u51012  \u50857 \u44048 \u54616 \u44172  \u46763 \u44256  \u48148 \u45796 \u47484  \u44148 \u45320 \u44032 \u44172  \u54616 \u44256 , \u54889 \u47049 \u54620  \u46308 \u50640 \u49436  \u50668 \u47084  \u44032 \u51648  \u44256 \u45212 \u44284  \u50948 \u54744 \u51012  \u44204 \u46356 \u50612  \u45236 \u44172  \u54616 \u44256  \u47560 \u52840 \u45236  \u54616 \u45208 \u45784 \u51032  \u52629 \u48373 \u51004 \u47196  \u50500 \u47700 \u47532 \u52852 \u51032  \u54644 \u48320 \u50640  \u53360  \u45208 \u46972 \u51032  \u44592 \u52488 \u47484  \u49464 \u50864 \u44172  \u54620  \u44163 \u51008  \u50577 \u49900 \u51032  \u51088 \u50976 \u50640  \u45824 \u54620  \u44040 \u47581 \u51060 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44536 \u46308 \u51060  \u51221 \u51649 \u54616 \u44256  \u54616 \u45208 \u45784 \u51012  \u44221 \u50808 \u54616 \u44592 \u45716  \u54616 \u50688 \u51004 \u45208  \u44536 \u46308 \u51008  \u51333 \u44368  \u51088 \u50976 \u51032  \u50948 \u45824 \u54620  \u50896 \u52825 \u51012  \u50500 \u51649 \u44751  \u44648 \u45803 \u51648  \u47803 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u51088 \u49888 \u51012  \u50948 \u54616 \u50668  \u47566 \u51008  \u55148 \u49373 \u51012  \u46300 \u47140 \u49436  \u50619 \u51008  \u51088 \u50976 \u47484  \u45796 \u47480  \u49324 \u46988 \u46308 \u50640 \u44172 \u46020  \u44512 \u46321 \u54616 \u44172  \u45208 \u45572 \u50612  \u51460  \u51456 \u48708 \u44032  \u46104 \u50612  \u51080 \u51648  \u47803 \u54616 \u50688 \u45796 . \'9317\u49464 \u44592 \u51032  \u51228 \u51068 \u44032 \u45716  \u49324 \u49345 \u44032 \u46308 \u44284  \u46020 \u45909 \u44032 \u46308  \u51473 \u50640 \u49436 \u44620 \u51648 \u46020  \u49888 \u50557  \u49457 \u44221 \u50640 \u49436  \u45208 \u50728  \u50948 \u45824 \u54620  \u50896 \u52825 , \u44263  \u54616 \u45208 \u45784  \u51060 \u50808 \u50640 \u45716  \u50500 \u47924 \u46020  \u49324 \u46988 \u51032  \u49888 \u50521 \u51012  \u49900 \u54032 \u54624  \u49688  \u50630 \u45796 \u45716  \u49324 \u49892 \u51012  \u50732 \u48148 \u47476 \u44172  \u51064 \u49885 \u54620  \u49324 \u46988 \u51008  \u44537 \u55176  \u46300 \u47932 \u50632 \u45796 \'94 (Martyn, vol.5, p.297). \u49324 \u46988 \u51032  \u50577 \u49900 \u51012  \u51648 \u48176 \u54616 \u44256  \u51060 \u45800 \u51012  \u51221 \u51396 \u54616 \u50668  \u52376 \u48268 \u54624  \u44428 \u54620 \u51012  \u54616 \u45208 \u45784 \u44760 \u49436  \u44368 \u54924 \u50640  \u50948 \u53441 \u54616 \u49512 \u45796 \u45716  \u44368 \u47532 \u45716  \u44032 \u51109  \u44618 \u51060  \u49100 \u47532 \u47484  \u48149 \u51008  \u48277 \u50773 \u44368 \u51032  \u50724 \u47448  \u44032 \u50868 \u45936  \u54616 \u45208 \u51060 \u45796 . \u44536 \u47088 \u45936  \u44060 \u54785 \u51088 \u46308 \u51008  \u47196 \u47560 \u44368 \u51032  \u49888 \u51312 \u47484  \u48512 \u51064 \u54616 \u47732 \u49436 \u46020  \u47196 \u47560 \u44368 \u51032  \u48708 \u44288 \u50857 \u51201  \u51221 \u49888 \u50640 \u49436  \u50756 \u51204 \u55176  \u48279 \u50612 \u45208 \u51648  \u47803 \u54616 \u50688 \u45796 . \u50724 \u47019 \u46041 \u50504 \u51032  \u48277 \u50773 \u44368 \u51032  \u51648 \u48176  \u50500 \u47000  \u51204  \u44536 \u47532 \u49828 \u46020 \u44368 \u44397 \u50640  \u54140 \u51256  \u51080 \u45912  \u51673 \u51008  \u55121 \u50516 \u51008  \u50500 \u51649 \u46020  \u50756 \u51204 \u55176  \u49324 \u46972 \u51648 \u51648  \u50506 \u50520 \u45796 . \u51060  \u51216 \u50640  \u45824 \u54616 \u50668  \u47588 \u49324 \u52628 \u49464 \u52768  \u47564  (\u28771 ) \u51032  \u49885 \u48124 \u51648 \u50640  \u49332 \u45912  \u54620  \u50976 \u47749 \u54620  \u47785 \u49324 \u45716  \'93\u51060 \u49444  (\u30064 \u35498 ) \u50640  \u45824 \u54620  \u44288 \u50857 \u51008  \u51060  \u49464 \u49345 \u51012  \u48152  (\u21453 ) \u44536 \u47532 \u49828 \u46020 \u44368 \u51201 \u51004 \u47196  \u47564 \u46308 \u50632 \u44256 , \u51060 \u45800 \u51012  \u51669 \u48268 \u54616 \u45716  \u51068 \u51008  \u44368 \u54924 \u50640  \u50500 \u47924 \u47088  \u49552 \u54644 \u46020  \u51077 \u55176 \u51648  \u50506 \u50520 \u45796 \'94 (Martyn, vol.5, p.335) \u44256  \u47568 \u54616 \u50688 \u45796 . \u44368 \u54924 \u51032  \u44368 \u51064 \u46308 \u47564 \u51060  \u49464 \u49345  \u51221 \u48512 \u50640  \u45824 \u54616 \u50668  \u48156 \u50616 \u44428 \u51012  \u44032 \u51652 \u45796 \u45716  \u44508 \u51221 \u51060  \u51060 \u51452 \u48124 \u46308 \u50640  \u51032 \u54616 \u50668  \u52292 \u53469 \u46104 \u50632 \u45796 . \u51068 \u51333 \u51032  \u44397 \u44368 \u54924  (\u22283 \u25934 \u26371 ) \u44032  \u54805 \u49457 \u46104 \u50632 \u44256 , \u47784 \u46304  \u49324 \u46988 \u50640 \u44172 \u45716  \u44368 \u51649 \u51088 \u47484  \u48512 \u50577 \u54616 \u45716  \u45936  \u54596 \u50836 \u54620  \u44592 \u48512 \u44032  \u44053 \u50836 \u46104 \u50632 \u45796 . \u44536 \u47532 \u44256  \u51109 \u44288 \u46308 \u50640 \u44172 \u45716  \u51060 \u45800 \u51012  \u48149 \u47736 \u54624  \u49688  \u51080 \u45716  \u44428 \u54620 \u51060  \u48512 \u50668 \u46104 \u50632 \u45796 . \u44536 \u47532 \u54616 \u50668  \u49549 \u44428 \u51060  \u44368 \u54924 \u51032  \u49688 \u51473 \u51004 \u47196  \u46308 \u50612 \u44032  \u48260 \u47160 \u45796 . \u51060  \u51312 \u52824 \u51032  \u54596 \u50672 \u51201 \u51064  \u44208 \u44284 \u47196 \u49436  \u50724 \u47000 \u51648  \u50500 \u45768 \u54616 \u50668  \u48149 \u54644 \u44032  \u51068 \u50612 \u45228 \u45796 .\
\pard\pardeftab720\sa319\partightenfactor0

\f0\b \cf0 \uc0\u49888 \u44368  \u51088 \u50976 \u51032  \u53804 \u49324  \u47196 \u51200  \u50956 \u47532 \u50628 \u51592 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u52572 \u52488 \u51032  \u49885 \u48124 \u51648 \u44032  \u44060 \u52377 \u46108  \u51648  11\u45380  \u54980 \u50640  \u47196 \u51200  \u50956 \u47532 \u50628 \u51592 \u44032  \u49888 \u45824 \u47449 \u51004 \u47196  \u50772 \u45796 . \u52488 \u44592 \u51032  \u49692 \u47168 \u51088 \u46308 \u52376 \u47100  \u44536 \u46020  \u50669 \u49884  \u49888 \u50521 \u51032  \u51088 \u50976 \u47484  \u50619 \u44592  \u50948 \u54616 \u50668  \u44536  \u44275 \u51004 \u47196  \u50772 \u45796 . \u44536 \u47084 \u45208  \u47676 \u51200  \u50728  \u49324 \u46988 \u46308 \u44284 \u45716  \u45804 \u47532  \u44536 \u45716 , \u45817 \u49884 \u50640  \u44536 \u44163 \u51012  \u51064 \u51221 \u54620  \u49324 \u46988 \u51060  \u44537 \u55176  \u46300 \u47932 \u50632 \u51648 \u47560 \u45716 , \u49888 \u51312 \u44032  \u50500 \u47924 \u47532  \u45796 \u47484 \u51648 \u46972 \u46020  \u51088 \u50976 \u45716  \u44033  \u49324 \u46988 \u50640 \u44172  \u49549 \u54620  \u50577 \u46020 \u54624  \u49688  \u50630 \u45716  \u44428 \u47532 \u46972 \u45716  \u49324 \u49892 \u51012  \u51064 \u51221 \u54616 \u50688 \u45796 . \u44536 \u45716  \u50676 \u47148 \u54620  \u51652 \u47532 \u51032  \u53456 \u44396 \u51088 \u47196 \u49436  \u47196 \u48712 \u49832 \u52376 \u47100  \u49457 \u44221 \u50640  \u51080 \u45716  \u48731 \u51060  \u51060 \u48120  \u45796  \u51228 \u44277 \u46104 \u50612  \u44536  \u51060 \u49345  \u45908  \u48155 \u51012  \u44163 \u51060  \u50630 \u45796 \u44256  \u49373 \u44033 \u51648  \u50506 \u50520 \u45796 . \u50956 \u47532 \u50628 \u51592 \u45716  \'93\u44540 \u49464 \u51032  \u44536 \u47532 \u49828 \u46020 \u44368 \u44397 \u50640  \u50577 \u49900 \u51032  \u51088 \u50976 , \u44263  \u45572 \u44396 \u46304 \u51648  \u48277 \u47456  \u50526 \u50640 \u49436 \u45716  \u54217 \u46321 \u54616 \u45796 \u45716  \u49888 \u51312 \u50640  \u44592 \u52488 \u54616 \u50668  \u48124 \u44428  \u51221 \u52824  (\u27665 \u27402 \u25919 \u27835 ) \u47484  \u54869 \u47549 \u49884 \u53416  \u52572 \u52488 \u51032  \u49324 \u46988 \u51060 \u50632 \u45796 \'94 (Bancroft, pt.1, ch.15, par.16). \u50956 \u47532 \u50628 \u51592 \u45716  \u48276 \u51396 \u47484  \u44536 \u52824 \u44172  \u54616 \u45716  \u44163 \u51060  \u44397 \u44032  \u54665 \u51221 \u51088 \u51032  \u51032 \u47924 \u51060 \u44592 \u45716  \u54616 \u51648 \u47564  \u50577 \u49900 \u51008  \u44208 \u53076  \u51648 \u48176 \u54624  \u49688  \u50630 \u45796 \u44256  \u51452 \u51109 \u54616 \u50688 \u45796 . \u44536 \u45716  \u47568 \u54616 \u50688 \u45796 . \'93\u51068 \u48152  \u48124 \u51473 \u51060 \u45208  \u51109 \u44288 \u51060  \u49324 \u46988 \u44284  \u49324 \u46988 \u46308  \u49324 \u51060 \u50640  \u51080 \u45716  \u51068 \u51008  \u44208 \u51221 \u51648 \u51012  \u49688  \u51080 \u45796 . \u44536 \u47084 \u45208  \u44536 \u46308 \u51060  \u54616 \u45208 \u45784 \u44760  \u45824 \u54620  \u49324 \u46988 \u51032  \u51032 \u47924 \u47484  \u44508 \u51221 \u54616 \u47140 \u44256  \u54616 \u47732 , \u44536 \u44163 \u51008  \u50900 \u44428 \u51060 \u50836  \u50948 \u54744 \u54620  \u51068 \u51060 \u45796 . \u50780 \u45264 \u54616 \u47732  \u47564 \u51068  \u51109 \u44288 \u51060  \u44536 \u50752  \u44057 \u51008  \u44428 \u47532 \u47484  \u49548 \u50976 \u54616 \u44172  \u46104 \u47732 , \u47560 \u52824  \u50689 \u44397 \u50640 \u49436  \u50612 \u46500  \u44397 \u50773 \u51060 \u45208  \u50668 \u50773 \u51060  \u54620  \u44163 \u52376 \u47100 , \u44536 \u47532 \u44256  \u47196 \u47560 \u44368 \u50640 \u49436  \u50612 \u46500  \u48277 \u50773 \u51060 \u45208  \u51032 \u54924 \u44032  \u54620  \u44163 \u44284  \u44057 \u51060  \u50724 \u45720  \u54620  \u44032 \u51648  \u51452 \u51109 \u51060 \u45208  \u49888 \u51312 \u47484  \u49464 \u50912 \u45796 \u44032  \u45236 \u51068  \u45796 \u47480  \u51452 \u51109 \u51004 \u47196  \u48148 \u44984 \u44172  \u46104 \u50612  \u44208 \u44397  \u49888 \u51312 \u50640  \u47566 \u51008  \u54844 \u46976 \u51012  \u44032 \u51256 \u50724 \u44256  \u47568  \u44163 \u51060 \u44592  \u46412 \u47928 \u51060 \u45796 \'94 (Martyn, vol.5, p.340).\
\uc0\u44397 \u44368 \u51032  \u50696 \u48176 \u50640  \u52280 \u49437 \u54616 \u51648  \u50506 \u45716  \u49324 \u46988 \u51008  \u48268 \u44552 \u51060 \u45208  \u53804 \u50725 \u51032  \u54805 \u48268 \u51012  \u48155 \u46020 \u47197  \u46104 \u50612  \u51080 \u50632 \u45796 . \'93\u50956 \u47532 \u50628 \u51592 \u45716  \u51060 \u47084 \u54620  \u48277 \u47456 \u51012  \u48512 \u51064 \u54616 \u50688 \u45796 . \u50689 \u44397  \u48277 \u51204  (\u27861 \u20856 ) \u51032  \u52572 \u50501 \u51032  \u48277 \u47161 \u51008  \u44368 \u44396 \u45236 \u51032  \u44368 \u54924 \u50640  \u52636 \u49437 \u54616 \u44592 \u47484  \u44053 \u50836 \u54620  \u44163 \u51060 \u50632 \u45796 . \u44057 \u51648  \u50500 \u45768 \u54620  \u49888 \u51312 \u47484  \u44032 \u51652  \u51088 \u46308 \u51012  \u50672 \u54633 \u54616 \u46020 \u47197  \u44053 \u50836 \u54616 \u45716  \u44163 \u51008  \u49324 \u46988 \u51032  \u49373 \u46301 \u44428  (\u29983 \u24471 \u27402 ) \u51012  \u44277 \u44277 \u50672 \u54616 \u44172  \u50976 \u47536 \u54616 \u45716  \u44163 \u51060 \u46972 \u44256  \u44536 \u45716  \u48372 \u50520 \u45796 . \u49888 \u50521 \u51060  \u50630 \u45716  \u51088 \u46308 \u44284  \u47560 \u51020 \u51004 \u47196  \u50896 \u54616 \u51648  \u50506 \u45716  \u51088 \u46308 \u51012  \u44277 \u51473  \u50696 \u48176 \u50640  \u50613 \u51648 \u47196  \u45132 \u44256  \u50724 \u45716  \u44163 \u51008  \u50948 \u49440 \u51012  \u44053 \u50836 \u54616 \u45716  \u44163 \u44284  \u45796 \u47492 \u51060  \u50630 \u45716  \u51068 \u51060 \u50632 \u45796 . \'91\'85\u45572 \u44396 \u46304 \u51648  \u48376 \u51064 \u51032  \u51032 \u49324 \u47484  \u47924 \u49884 \u54616 \u44256  \u50696 \u48176 \u47484  \u44053 \u50836 \u54616 \u44144 \u45208  \u44368 \u54924 \u51032  \u44221 \u48708 \u47484  \u48512 \u45812 \u49884 \u53420  \u49688 \u45716  \u50630 \u45796 \'92\u44256  \u44536 \u45716  \u48512 \u50616 \u54616 \u50688 \u45796 . \u48152 \u45824 \u51088 \u46308 \u51008  \u44536 \u51032  \u51452 \u51109 \u50640  \u45440 \u46972 \u49436 , \'91\u47924 \u50631 \u51060 \u46972 \u44256 ? \u51068 \u54616 \u45716  \u51088 \u44032  \u44536  \u49327 \u51012  \u48155 \u45716  \u44163 \u51060  \u47560 \u46405 \u54620  \u51068 \u51060  \u50500 \u45768 \u45264 \'92\u44256  \u48152 \u47928 \u54616 \u50688 \u45796 . \u44536 \u45716  \u49436 \u49844 \u51648  \u50506 \u44256  \'91\u44536 \u47111 \u45796 . \u44536 \u47084 \u45208  \u44536  \u49327 \u51008  \u51068  \u49884 \u53416  \u51088 \u50640 \u44172 \u49436  \u48155 \u45716  \u44163 \u51060  \u45817 \u50672 \u54620  \u51068 \u51060 \u45796 \'92\u44256  \u45824 \u45813 \u54616 \u50688 \u45796 \'94 (Bancroft, pt.1, ch.15, par.2).\
\uc0\u47196 \u51200  \u50956 \u47532 \u50628 \u51592 \u45716  \u52649 \u49892 \u54616 \u44256  \u53945 \u51060 \u54620  \u51116 \u45733 \u51012  \u44054 \u52632  \u47785 \u49324 \u47196 \u49436  \u54408 \u49457 \u51060  \u44256 \u44208 \u54616 \u44256  \u51064 \u51221 \u51060  \u47566 \u51008  \u49324 \u46988 \u51004 \u47196  \u51316 \u44221 \u51012  \u48155 \u50520 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u50948 \u51221 \u51088 \u44032  \u44368 \u54924 \u47484  \u51648 \u48176 \u54616 \u45716  \u44428 \u49464 \u47484  \u45800 \u54840 \u55176  \u44144 \u48512 \u54616 \u45716  \u51068 \u44284  \u49888 \u44368  \u51088 \u50976 \u50640  \u45824 \u54620  \u50948 \u51221 \u51088 \u51032  \u50836 \u44396 \u50640  \u54637 \u44144 \u54616 \u45716  \u51068 \u47564 \u51008  \u50577 \u48372 \u54624  \u49688  \u50630 \u50632 \u45796 . \u51060 \u47084 \u54620  \u49352 \u47196 \u50868  \u49888 \u51312 \u51032  \u51452 \u51109 \u51008  \'93\u44397 \u44032 \u51032  \u51221 \u52824 \u50752  \u44592 \u52488 \u47484  \u50948 \u53468 \u47213 \u44172  \u54616 \u45716  \u44163 \'94 (Bancroft, pt.1, ch.15, par.2) \u51060 \u46972 \u44256  \u44277 \u44201 \u51012  \u48155 \u44172  \u46104 \u50632 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u45716  \u50728  \u49885 \u48124 \u51648 \u46308 \u47196 \u48512 \u53552  \u52628 \u48169  \u47749 \u47161 \u51012  \u48155 \u44172  \u46104 \u50632 \u51004 \u47728 , \u47560 \u52840 \u45236  \u52404 \u54252 \u47484  \u47732 \u54616 \u44592  \u50948 \u54616 \u50668  \u52628 \u50868  \u44200 \u50872 \u51032  \u45576 \u48372 \u46972  \u49549 \u50640 \u49436  \u51064 \u51201 \u46020  \u50630 \u45716  \u49328 \u47548  \u49549 \u51004 \u47196  \u46020 \u47581 \u54624  \u49688 \u48150 \u50640  \u50630 \u45716  \u49888 \u49464 \u44032  \u46104 \u50632 \u45796 .\
\uc0\u44536 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u54616 \u50688 \u45796 . \'93\u45208 \u45716  \u50557  14 \u51452 \u44036  \u46041 \u50504  \u54841 \u46021 \u54620  \u52628 \u50948  \u44032 \u50868 \u45936  \u51060 \u47532 \u51200 \u47532  \u46020 \u47581 \u51012  \u45796 \u45396 \u45716 \u45936 , \u45208 \u50640 \u44172 \u45716  \u47673 \u51012  \u44163 \u46020  \u51096  \u44275 \u46020  \u50630 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44144 \u52828  \u46308 \u50640 \u49436 \u45716  \u44620 \u47560 \u44480 \u44032  \u45208 \u50640 \u44172  \u50577 \u49885 \u51012  \u51452 \u50632 \u44256 , \u51060 \u46384 \u44552  \u49549 \u51060  \u48712  \u45208 \u47924 \u44032  \u45208 \u50640 \u44172  \u49689 \u49548 \u47484  \u51228 \u44277 \u54644  \u51452 \u50632 \u45796 \'94 (Martyn, vol.5, pp.349, 350). \u44536 \u47532 \u54616 \u50668  \u44536 \u45716  \u44600  \u50630 \u45716  \u49328 \u47548  \u49549 \u51032  \u45576 \u51012  \u54756 \u52824 \u44256  \u45796 \u45768 \u47732 \u49436  \u44340 \u47196 \u50868  \u53804 \u51137 \u51012  \u44228 \u49549 \u54616 \u50688 \u45796 . \u44536 \u45716  \u46300 \u46356 \u50612  \u50612 \u46500  \u51064 \u46356 \u50616 \u51032  \u48512 \u46973 \u50640 \u49436  \u54588 \u45212 \u52376 \u47484  \u52286 \u50520 \u45716 \u45936  \u44536  \u44275 \u51008  \u44536 \u44032  \u51068 \u52237 \u51060  \u48373 \u51020 \u51032  \u51652 \u47532 \u47484  \u51204 \u54616 \u44256 \u51088  \u49688 \u44256 \u54616 \u45716  \u51473 \u50640  \u44536 \u46308 \u51032  \u49324 \u46993 \u44284  \u49888 \u51076 \u51012  \u48155 \u45912  \u44275 \u51060 \u50632 \u45796 .\
\uc0\u49688 \u44060 \u50900  \u46041 \u50504  \u50668 \u44592 \u51200 \u44592  \u46496 \u46028 \u50500 \u45796 \u45772  \u45149 \u50640  \u44536 \u45716  \u47560 \u52840 \u45236  \u45236 \u47084 \u44148 \u49464 \u53944  \u47564  (\u28771 ) \u50640  \u46020 \u52265 \u54616 \u50668  \u44144 \u44592 \u49436  \u44032 \u51109  \u50756 \u51204 \u54620  \u51032 \u48120 \u50640 \u49436 , \u44540 \u49464 \u51032  \u49888 \u50521  \u51088 \u50976 \u51032  \u44428 \u47532 \u47484  \u52384 \u51200 \u54616 \u44172  \u49849 \u51064 \u54616 \u45716  \u52572 \u52488 \u51032  \u51452  (\u24030 ) \u51032  \u44592 \u52488 \u47484  \u45459 \u50520 \u45796 . \u47196 \u51200  \u50956 \u47532 \u50628 \u51592 \u51032  \u49885 \u48124 \u51648 \u51032  \u44540 \u48376  \u50896 \u52825 \u51008  \'93\u49324 \u46988 \u51008  \u45572 \u44396 \u45208  \u51088 \u44592 \u51032  \u50577 \u49900 \u51032  \u48731 \u51012  \u46384 \u46972  \u54616 \u45208 \u45784 \u51012  \u44221 \u48176 \u54624  \u51088 \u50976 \u47484  \u44032 \u51276 \u45796 \'94 (Martyn, vol.5, p.354) \u45716  \u44163 \u51060 \u50632 \u45796 . \u44536 \u51032  \u51089 \u51008  \u51452  (\u24030 ), \u47196 \u46300  \u50500 \u51068 \u47004 \u46300 \u45716  \u48149 \u54644 \u47196  \u44256 \u45212 \u45817 \u54616 \u45716  \u51088 \u46308 \u51032  \u54588 \u45212 \u52376 \u44032  \u46104 \u50612  \u52264 \u52784  \u49324 \u46988 \u51032  \u49688 \u44032  \u51613 \u44032 \u46104 \u50612  \u48264 \u52285 \u54644 \u51276 \u45796 . \u44536 \u47532 \u44256  \u44536  \u51452 \u51032  \u44592 \u48376  \u50896 \u52825 , \u44263  \u51221 \u52824 \u50752  \u51333 \u44368 \u51032  \u51088 \u50976 \u44032  \u47560 \u52840 \u45236  \u48513 \u48120  \u44277 \u54868 \u44397 \u51032  \u52488 \u49437 \u51060  \u46104 \u50632 \u45796 .\
