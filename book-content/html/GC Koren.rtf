\uc0\u48128 \u47084 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u54616 \u50688 \u45796 . \'93\u46608  \u54620  \u44032 \u51648  \u45208 \u51032  \u47560 \u51020 \u50640  \u44618 \u51008  \u54869 \u49888 \u51012  \u51456  \u44163 \u51008  \u49457 \u44221 \u51032  \u50672 \u45824 \u44592  (\u63886 \u20195 \u35352 ) \u50688 \u45796 . \'85\u45208 \u45716  \u44284 \u44144 \u50640  \u51060 \u48120  \u49457 \u52712 \u46108  \u50696 \u50616 \u51201  \u49324 \u44148 \u46308 \u51060  \u47784 \u46160  \u44536  \u50696 \u50616 \u46108  \u49884 \u44592 \u50640  \u49457 \u52712 \u46108  \u49324 \u49892 \u51012  \u48156 \u44204 \u54616 \u44172  \u46104 \u50632 \u45796 . \u54861 \u49688 \u44032  \u45236 \u47532 \u44592 \u44620 \u51648 \u51032  120\u45380  (\u52285  6:3), \u54861 \u49688  \u51649 \u51204 \u51032  7\u51068 \u44036 \u44284  40\u51068 \u44036 \u51032  \u44053 \u50864  (\u52285  7:4), \u50500 \u48652 \u46972 \u54632 \u44284  \u44536 \u51032  \u51088 \u49552 \u51060  \u50976 \u47532 \u54364 \u48149 \u54620  4\u48177 \u45380 \u44036  (\u52285  15:13), \u46497  \u47585 \u51008  \u44288 \u50896 \u51109 \u44284  \u49696  \u47585 \u51008  \u44288 \u50896 \u51109 \u51032  \u45000 \u51032  3\u51068 \u44036  (\u52285  40:12~20), \u48148 \u47196 \u51032  7\u45380 \u44036  (\u52285  41:28~54), \u44305 \u50556 \u51032  40\u45380 \u44036  (\u48124  14:30), 3\u45380  \u48152  \u46041 \u50504 \u51032  \u44592 \u44540  (\u50773 \u49345  17:1), \'8570\u45380  \u46041 \u50504 \u51032  \u54252 \u47196  \u44592 \u44036  (\u47128  25:11), \u45712 \u48512 \u44051 \u45348 \u49332  \u50773 \u51032  \u51068 \u44273  \u46412  (\u45800  4:13~16), \u46608 \u54620  \u50976 \u45824 \u51064 \u51012  \u50948 \u54616 \u50668  \u51648 \u51221 \u46108  7\u51452 \u51068 \u44284  62\u51452 \u51068 \u44284  1\u51452 \u51068 , \u44263  70\u51452 \u51068  (\u45800  9:24~27), \u44536 \u50752  \u44057 \u51060  \u49884 \u44036 \u51201 \u51004 \u47196  \u54620 \u51221 \u46108  \u49324 \u44148 \u46