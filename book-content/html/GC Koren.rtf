\f0\b \cf0 \uc0\u50689 \u44397  \u44397 \u50773 \u44284  \u50948 \u53364 \u47532 \u54532 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u50948 \u53364 \u47532 \u54532 \u45716  \u47196 \u47560  \u48277 \u50773 \u51032  \u52840 \u47029 \u51201  \u49464 \u47141 \u50640  \u45824 \u54637 \u54616 \u50668  \u50689 \u44397  \u44397 \u50773 \u51032  \u44428 \u47532 \u47484  \u50745 \u54840 \u54616 \u44592  \u50948 \u54616 \u50668  \u45796 \u49884  \u48512 \u47492 \u51012  \u51077 \u50632 \u45796 . \u44536 \u45716  \u44397 \u50773 \u51032  \u49324 \u49888 \u51060  \u46104 \u50612  \u45348 \u45916 \u46976 \u46300 \u50640 \u49436  2\u45380  \u46041 \u50504  \u51648 \u45236 \u47732 \u49436  \u48277 \u50773 \u51032  \u49324 \u51208 \u46308 \u44284  \u54924 \u51032 \u47484  \u54616 \u50688 \u45796 . \u44144 \u44592 \u49436  \u44536 \u45716  \u54532 \u46993 \u49828 , \u51060 \u53448 \u47532 \u50500 , \u49828 \u54168 \u51064 \u51032  \u49849 \u47140 \u46308 \u44284  \u44368 \u51228 \u54616 \u44172  \u46104 \u50632 \u51004 \u47728 , \u44536 \u47196  \u51064 \u54616 \u50668  \u44536 \u46308 \u51032  \u51060 \u47732 \u51012  \u48380  \u49688  \u51080 \u45716  \u44592 \u54924 \u47484  \u44032 \u51648 \u44172  \u46104 \u50632 \u44256 , \u50689 \u44397 \u50640 \u49436 \u45716  \u46020 \u51200 \u55176  \u48380  \u49688  \u50630 \u50632 \u45912  \u47566 \u51008  \u44163 \u46308 \u51012  \u44648 \u45803 \u44172  \u46104 \u50632 \u45796 . \u44144 \u44592 \u49436  \u44536 \u45716  \u51109 \u47000  \u54876 \u46041 \u50640  \u46020 \u50880 \u51060  \u46104 \u45716  \u44163 \u46308 \u51012  \u47566 \u51060  \u48176 \u50912 \u45796 . \u51060  \u48277 \u50773 \u44428 \u51032  \u45824 \u54364 \u51088 \u46308 \u51012  \u53685 \u54616 \u50668  \u44536 \u45716  \u44536  \u44368 \u51649  \u51221 \u52824  (\u25934 \u32887 \u25919 \u27835 ) \u51032  \u52280 \u46108  \u49457 \u44201 \u44284  \u47785 \u51201 \u51012  \u50508 \u50520 \u45796 . \u50689 \u44397 \u50640  \u46028 \u50500 \u44036  \u54980 \u50640  \u44536 \u45716  \u51333 \u47000 \u51032  \u44032 \u47476 \u52840 \u51012  \u45908 \u50865  \u45812 \u45824 \u54616 \u44172  \u46104 \u54400 \u51060 \u54616 \u50688 \u44256 , \u45908 \u50865  \u53360  \u50676 \u49457 \u51004 \u47196  \u53456 \u50837 \u44284  \u44368 \u47564 \u44284  \u44592 \u47564 \u51060  \u47196 \u47560 \u44368 \u51032  \u49888  (\u31070 ) \u51060 \u46972 \u44256  \u44277 \u50616 \u54616 \u50688 \u45796 .\
\uc0\u44536 \u45716  \u51088 \u44592 \u44032  \u51200 \u49696 \u54620  \u49548 \u52293 \u51088 \u50640 \u49436  \u48277 \u50773 \u44284  \u48277 \u50773 \u51032  \u47784 \u44552 \u51088  (\u21215 \u63754 \u32773 ) \u50640  \u45824 \u54616 \u50668  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u54616 \u50688 \u45796 . \'93\u44536 \u46308 \u51008  \u50864 \u47532 \u45208 \u46972 \u51032  \u44032 \u45212 \u54620  \u49324 \u46988 \u46308 \u51032  \u49373 \u44228 \u48708 \u47484  \u48764 \u50519 \u44256 , \u54644 \u47560 \u45796  \u49688 \u52380  \u47560 \u47476 \u53356 \u51032  \u46024 \u51012  \u49457 \u51649  \u47588 \u47588 \u51032  \u51200 \u51452 \u48155 \u51008  \u51060 \u45800 \u50640  \u48520 \u44284 \u54620  \u49457 \u47932 \u44284  \u49888 \u47161 \u54620  \u54665 \u49324 \u47484  \u50948 \u54616 \u50668  \u48764 \u50519 \u50500  \u44032 \u47728 , \u47784 \u46304  \u44536 \u47532 \u49828 \u46020 \u44397 \u51004 \u47196  \u54616 \u50668 \u44552  \u44536  \u51060 \u45800 \u51012  \u52268 \u46041 \u54616 \u44256  \u51648 \u51648 \u54616 \u46020 \u47197  \u47564 \u46304 \u45796 . \u52280 \u51004 \u47196  \u50864 \u47532 \u45208 \u46972 \u50640 \u45716  \u44552 \u51004 \u47196  \u46108  \u44144 \u45824 \u54620  \u49328 \u51060  \u51080 \u45716 \u45936  \u51648 \u44552 \u44751 , \u44536 \u44163 \u51012  \u44032 \u51256 \u44032 \u45716  \u51088 \u44032  \u50630 \u50632 \u51004 \u45208 , \u50724 \u51649  \u51200  \u44368 \u47564 \u54616 \u44256  \u49464 \u49549 \u51201 \u51064  \u49888 \u48512 \u46972 \u45716  \u47784 \u44552 \u51088 \u44032  \u44032 \u51256 \u44032 \u44256  \u51080 \u51004 \u48064 \u47196  \u49464 \u50900 \u51060  \u51648 \u45224 \u50640  \u46384 \u46972  \u44536  \u49328 \u51008  \u49324 \u46972 \u51648 \u44256  \u47568  \u44163 \u51060 \u45796 . \u50780 \u45264 \u54616 \u47732  \u44536 \u45716  \u50864 \u47532 \u45208 \u46972 \u50640 \u49436  \u46024 \u51008  \u44032 \u51256 \u44032 \u44256  \u49457 \u51649  \u47588 \u47588 \u47196  \u47568 \u48120 \u50516 \u51008  \u54616 \u45208 \u45784 \u51032  \u51200 \u51452 \u47564 \u51012  \u45224 \u44200  \u45459 \u44592  \u46412 \u47928 \u51060 \u45796 \'94 (John Lewis, History of the Life and Sufferings of J.Wycliffe, p.37).\
\uc0\u50948 \u53364 \u47532 \u54532 \u44032  \u50689 \u44397 \u51004 \u47196  \u46028 \u50500 \u50728  \u51648  \u50620 \u47560  \u46104 \u51648  \u50500 \u45768 \u54616 \u50668 , \u44536 \u45716  \u52825 \u47749  (\u21189 \u21629 ) \u51004 \u47196  \u47336 \u53552 \u50892 \u46300 \u51032  \u44368 \u44396 \u51109  (\u25934 \u21312 \u38263 ) \u51060  \u46104 \u50632 \u45796 . \u51060  \u49324 \u49892 \u51008  \u51201 \u50612 \u46020  \u44397 \u50773 \u51060  \u44536 \u51032  \u49556 \u51649 \u54620  \u47568 \u51012  \u48520 \u53132 \u54616 \u44172  \u50668 \u44592 \u51648  \u50506 \u45716 \u45796 \u45716  \u49324 \u49892 \u51012  \u48372 \u51613 \u54644  \u51452 \u45716  \u51068 \u51060 \u50632 \u45796 . \u50948 \u53364 \u47532 \u54532 \u51032  \u44048 \u54868 \u45716  \u44557 \u51221 \u51032  \u53468 \u46020 \u47484  \u44208 \u51221 \u54616 \u44256  \u44397 \u48124 \u46308 \u51032  \u49888 \u45392 \u51012  \u54805 \u49457 \u54616 \u45716  \u51068 \u50640  \u50689 \u54693 \u51012  \u48120 \u52452 \u45796 .\
\uc0\u44536 \u47084 \u45208  \u44263  \u48277 \u50773 \u51032  \u51652 \u45432 \u50752  \u50948 \u54801 \u51060  \u44536 \u50640 \u44172  \u45796 \u44032 \u50772 \u45796 . \u45824 \u54617 \u44284  \u44397 \u50773 \u44284  \u44048 \u46021 \u46308 \u50640 \u44172  \u48372 \u45236 \u45716  \u49464  \u44032 \u51648  \u44368 \u49436 \u44032  \u50689 \u44397 \u51004 \u47196  \u44553 \u55176  \u51204 \u45804 \u46104 \u50632 \u45796 . \u44536  \u45236 \u50857 \u51008  \u47784 \u46160  \u44536  \u51060 \u45800 \u51032  \u44368 \u49324 \u47484  \u52840 \u47925 \u49884 \u53412 \u44592  \u50948 \u54616 \u50668  \u51593 \u44033 \u51201 \u51060 \u44256  \u45800 \u54840 \u54620  \u51312 \u52824 \u47484  \u52712 \u54616 \u46972 \u45716  \u47749 \u47161 \u51060 \u50632 \u45796  (\u48512 \u47197  14 \u52280 \u51312 ) (Augustus Neander, General History of the Christian Religion and Church, period 6, sec.2, pt.1, par.\u52280 \u51312 ). \u51060  \u44368 \u49436 \u44032  \u54616 \u45804 \u46104 \u44592  \u51204 \u50640  \u51060 \u48120  \u44048 \u46021 \u46308 \u51008  \u44201 \u48516 \u54620  \u45208 \u47672 \u51648  \u50948 \u53364 \u47532 \u54532 \u47484  \u48277 \u51221 \u51004 \u47196  \u49548 \u54872 \u54664 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44397 \u45236 \u50640 \u49436  \u44032 \u51109  \u49464 \u47141  \u51080 \u45716  \u46160  \u50773 \u51313 \u51060  \u44536 \u47484  \u46041 \u48152 \u54616 \u50668  \u48277 \u51221 \u50640  \u51076 \u49437 \u54616 \u50688 \u44256 , \u44400 \u51473 \u46308 \u51060  \u48277 \u51221  \u48150 \u51012  \u50640 \u50892 \u49912 \u44256  \u47560 \u52840 \u45236  \u48277 \u51221  \u50504 \u51004 \u47196  \u46832 \u50612  \u46308 \u50612 \u44032 \u47140 \u45716  \u49548 \u46041 \u44620 \u51648  \u51068 \u51004 \u53040 \u51004 \u48064 \u47196 , \u51116 \u54032 \u51012  \u51652 \u54665 \u54616 \u45912  \u48277 \u44288 \u46308 \u46020  \u51060 \u47484  \u46160 \u47140 \u50892 \u54616 \u50668  \u49900 \u47928 \u51012  \u51104 \u44624  \u51473 \u51648 \u54616 \u44256  \u44536 \u47484  \u45459 \u50500  \u51460  \u49688 \u48150 \u50640  \u50630 \u50632 \u45912  \u44163 \u51060 \u45796 . \u44536 \u47088 \u45936  \u44048 \u46021 \u46308 \u51060  \u45208 \u51060  \u47566 \u51008  \u50640 \u46300 \u50892 \u46300  3\u49464 \u47196  \u54616 \u50668 \u44552  \u44536  \u44060 \u54785 \u51088 \u47484  \u48176 \u52377 \u54616 \u46020 \u47197  \u54616 \u44256 \u51088  \u44928 \u54616 \u50688 \u51004 \u45208  \u50620 \u47560  \u54980 \u50640  \u44536  \u50773 \u51008  \u51453 \u44256 , \u51204 \u50640  \u50948 \u53364 \u47532 \u54532 \u47484  \u48372 \u54840 \u54616 \u45912  \u51060 \u44032  \u49453 \u51221 \u51012  \u54616 \u44172  \u46104 \u50632 \u45796 .\
\uc0\u44536 \u47084 \u45208  \u44368 \u49436 \u44032  \u46020 \u52265 \u46104 \u51088  \u51060 \u45800 \u51088 \u47484  \u52404 \u54252 \u54616 \u50668  \u50725 \u50640  \u44032 \u46160 \u46972 \u45716  \u50628 \u54620  \u47749 \u47161 \u51060  \u50728  \u50689 \u44397 \u50640  \u49440 \u54252 \u46104 \u50632 \u45796 . \u51060 \u47084 \u54620  \u51312 \u52824 \u45716  \u48516 \u47749 \u55176  \u54868 \u54805 \u51452  (\u28779 \u21009 \u26609 ) \u47484  \u51032 \u48120 \u54616 \u50688 \u45796 . \u50948 \u53364 \u47532 \u54532 \u45716  \u50724 \u47000 \u51648  \u50506 \u50500 \u49436  \u48152 \u46300 \u49884  \u47196 \u47560 \u51032  \u48372 \u48373 \u51032  \u55148 \u49373  \u51228 \u47932 \u51060  \u46112  \u49688 \u48150 \u50640  \u50630 \u45716  \u54805 \u54200 \u51060 \u50632 \u45796 . \u44536 \u47084 \u45208  \u50715 \u45216 \u51032  \u45432 \u46021  \u51473 \u51032  \u54620  \u49324 \u46988 \u50640 \u44172  \'93\u46160 \u47140 \u50892  \u47568 \u46972  \u45208 \u45716  \u45320 \u51032  \u48169 \u54056 \u46972 \'94 (\u52285  15:1) \u44256  \u47568 \u50432 \u54616 \u49888  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u46608 \u45796 \u49884  \u49552 \u51012  \u54196 \u49324  \u45817 \u49888 \u51032  \u51333 \u51012  \u48372 \u54840 \u54616 \u49512 \u45796 . \u51453 \u51020 \u51060  \u45796 \u44032 \u50772 \u51004 \u45208  \u44536  \u51453 \u51020 \u51008  \u44060 \u54785 \u51088 \u50640 \u44172 \u44032  \u50500 \u45768 \u44256  \u46020 \u47532 \u50612  \u44060 \u54785 \u51088 \u50640 \u44172  \u51453 \u51020 \u51012  \u49440 \u44256 \u54620  \u48277 \u50773  \u51088 \u49888 \u50640 \u44172  \u45796 \u44032 \u50772 \u45796 . \u44536 \u47112 \u44256 \u47532 \u50864 \u49828  \u8545 \u49464 \u45716  \u51453 \u50632 \u45796 . \u44536 \u47084 \u48064 \u47196  \u50948 \u53364 \u47532 \u54532 \u47484  \u49900 \u47928 \u54616 \u44592  \u50948 \u54616 \u50668  \u47784 \u50688 \u45912  \u44368 \u51649 \u51088  (\u25934 \u32887 \u32773 ) \u46308 \u51008  \u48512 \u46301 \u51060  \u49328 \u54924 \u54624  \u49688 \u48150 \u50640  \u50630 \u50632 \u45796 .\
