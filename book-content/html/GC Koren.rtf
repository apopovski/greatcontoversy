80 \u45716  \u44275 , \u54620 \u51201 \u54620  \u51109 \u49548 , \u45224 \u51060  \u47784 \u47476 \u45716  \u44417 \u48317 \u54620  \u44275 , \u47680 \u47532  \u46504 \u50612 \u51256 \u49436  \u50504 \u51204 \u54620  \u44275 \u51012  \u52286 \u50520 \u45912  \u44163 \u51060  \u50500 \u45772 \u44032 ? \u48372 \u46972 , \u54217 \u54868 \u47213 \u44172  \u51221 \u48373 \u54620  \u44536  \u44305 \u45824 \u54620  \u51648 \u50669 \u51012 , \u44536 \u46308 \u51008  \u44144 \u44592 \u45796 \u44032  \u49901 \u51088 \u44032 \u51032  \u44611 \u48156 \u51012  \u49464 \u50912 \u45912  \u44163 \u51060 \u45796 \'94 (Speech delivered at Plymouth, Massachu-setts, Dec.22, 1824, p.11).\
\'93\uc0\u49352 \u45180 \u50577  \u44057 \u51060  \u46160  \u49108 \u51060  \u51080 \u44256 .\'94 \u44536  \u46160  \u49108  \u44032 \u51652  \u49352 \u45180 \u50577  \u44057 \u51008  \u51664 \u49849 \u51008  \u50612 \u47532 \u44256  \u49692 \u51652 \u54616 \u44256  \u50728 \u49692 \u54620  \u44163 \u51012  \u45208 \u53440 \u45236 \u44256  \u51080 \u51004 \u47728  \u49440 \u51648 \u51088 \u44032  \'93\u50732 \u46972 \'94\u50724 \u47532 \u46972 \u44256  \u47568 \u54620  \u44536 \u45824 \u47196  1798\u45380 \u50640  \u45208 \u53440 \u45212  \u54633 \u51473 \u44397 \u51032  \u49457 \u44201 \u51012  \u51201 \u51208 \u55176  \u47896 \u49324 \u54616 \u44256  \u51080 \u45796 . \u50500 \u47700 \u47532 \u52852 \u47196  \u54588 \u54616 \u50668  \u50752 \u49436  \u44144 \u44592 \u49436  \u50773 \u51032  \u50517 \u48149 \u44284  \u49888 \u48512 \u46308 \u51032  \u48149 \u54644 \u50640 \u49436  \u54588 \u45212 \u52376 \u47484  \u50619 \u51008  \u44536 \u47532 \u49828 \u46020 \u51064 \u46308  \u51473 \u50640 \u45716  \u51221 \u52824 \u50752  \u51333 \u44368 \u51032  \u51088 \u50976 \u47484  \u53360  \u44592 \u52488 \u47196  \u49340 \u45716  \u51221 \u48512 \u47484  \u49464 \u50864 \u44592 \u47196  \u44208 \u49900 \u54620  \u51088 \u46308 \u51060  \u47566 \u50520 \u45796 . \u44536 \u46308 \u51032  \u44204 \u54644 \u45716  \'93\u47784 \u46304  \u49324 \u46988 \u51008  \u54217 \u46321 \u54616 \u44172  \u52285 \u51312 \u46104 \u50632 \u44256  \u49373 \u47749 \u44284  \u51088 \u50976 \u50752  \u54665 \u48373 \u51012  \u52628 \u44396 \u54616 \u45716  \u45936  \u51080 \u50612 \u49436  \u45224 \u50640 \u44172  \u50577 \u46020 \u54624  \u49688  \u50630 \u45716  \u44428 \u47532 \u47484  \u48512 \u50668 \u48155 \u50520 \u45796 \'94\u45716  \u53360  \u51652 \u47532 \u47484  \u48157 \u54784  \u51452 \u45716  \u46021 \u47549  \u49440 \u50616 \u49436 \u50640  \u47749 \u49884 \u46104 \u50612  \u51080 \u45796 . \u44536 \u47532 \u44256  \u54732 \u48277 \u51008  \u51088 \u52824 \u51032  \u44428 \u4