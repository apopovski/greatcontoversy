\'93\uc0\u47784 \u46304  \u48277  \u51473 \u50640 \u49436  \u44032 \u51109  \u55113 \u50501 \u54620  \u48277 \u51060  \u50612 \u46500  \u48277 \u51221 \u48372 \u45796  \u44032 \u51109  \u55113 \u50501 \u54620  \u48277 \u51221 \u50640 \u49436  \u51201 \u50857 \u46104 \u44256 , \u44537 \u54805 \u51012  \u48155 \u51012  \u44033 \u50724 \u47484  \u54616 \u51648  \u50506 \u44256 \u49436 \u45716  \u51060 \u50883  \u49324 \u46988 \u50640 \u44172  \u51064 \u49324 \u54616 \u44144 \u45208  \u54616 \u45208 \u45784 \u44760  \u44592 \u46020 \u47484  \u46300 \u47540  \u49688  \u50630 \u44256 , \u46020 \u52376 \u50640  \u48128 \u51221 \u46308 \u51060  \u51104 \u48373 \u54644  \u51080 \u44256 , \u47588 \u51068  \u45800 \u46160 \u45824 \u44032  \u50500 \u52840 \u48512 \u53552  \u51109 \u49884 \u44036 \u50640  \u44152 \u52432  \u55192 \u46304  \u51068 \u51012  \u54616 \u44256 , \u45432 \u50696 \u49440 \u46308 \u51060  \u52264 \u44256  \u45336 \u52824 \u45716  \u44163 \u52376 \u47100  \u44048 \u50725 \u46308 \u51060  \u45336 \u52824 \u44256 , \u54616 \u49688 \u44396 \u51032  \u46020 \u46993 \u46308 \u51060  \u54588 \u47196  \u47932 \u46308 \u50612  \u49464 \u45712  (Seine) \u44053 \u51004 \u47196  \u55128 \u47084 \u46308 \u50612 \u44032 \u45716  \u44536 \u47088  \u49884 \u45824 \u44032  \u50772 \u45796 . \'85\u52376 \u54805 \u46112  \u55148 \u49373 \u51088 \u46308 \u51012  \u49892 \u51008  \u47560 \u52264 \u46308 \u51060  \u45216 \u47560 \u45796  \u54028 \u47532  \u49884 \u51032  \u46020 \u47196 \u47484  \u51648 \u45208  \u44536  \u50868 \u47749 \u51032  \u49900 \u54032 \u51221 \u51004 \u47196  \u44032 \u44256  \u51080 \u45716  \u46041 \u50504 \u50640  \u52572 \u44256  \u51032 \u50896 \u46308 \u51060  \u48372 \u45240  \u44033  \u51648 \u48169 \u51032  \u52509 \u46021 \u46308 \u51008  \u49892 \u47196  \u49688 \u46020  \u54028 \u47532 \u50640 \u49436 \u51312 \u52264  \u48380  \u49688  \u50630 \u45716  \u51092 \u51064 \u47924 \u46020 \u54620  \u51068 \u51012  \u54665 \u54616 \u44256  \u5