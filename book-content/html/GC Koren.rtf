\uc0\u54000 \u53804 \u49828 \u45716  \u47924 \u49832  \u48169 \u48277 \u51004 \u47196 \u46304 \u51648  \u44536  \u48708 \u52280 \u54620  \u44305 \u44221 \u51012  \u48744 \u47532  \u45149 \u45236 \u44256  \u50696 \u47336 \u49332 \u47128 \u51032  \u50756 \u51204 \u54620  \u54028 \u47736 \u51012  \u47561 \u50500  \u48372 \u44256 \u51088  \u54616 \u50688 \u45796 . \u44536 \u45716  \u44264 \u51676 \u44592 \u50640  \u49939 \u50668  \u51080 \u45716  \u49884 \u52404 \u46308 \u51012  \u48372 \u44256  \u44277 \u54252 \u47196  \u52649 \u47564 \u54616 \u50668 \u51276 \u45796 . \u44536 \u45716  \u47924 \u50631 \u50640  \u46020 \u52712 \u46108  \u49324 \u46988 \u52376 \u47100  \u44048 \u46988 \u49328  \u50948 \u50640 \u49436  \u50885 \u51109 \u54620  \u49457 \u51204 \u51012  \u48148 \u46972 \u48372 \u50520 \u45796 . \u44536 \u47532 \u44256  \u44536  \u46028  \u54616 \u45208 \u46020  \u45796 \u52824 \u51648  \u47568 \u46972 \u44256  \u47749 \u47161 \u54616 \u50688 \u45796 . \u44536 \u45716  \u44536  \u50836 \u49352 \u47484  \u51216 \u47161 \u54616 \u45716  \u51089 \u51204 \u51012  \u48268 \u51060 \u44592  \u51204 \u50640  \u50976 \u45824  \u51648 \u46020 \u51088 \u46308 \u50640 \u44172  \u51088 \u44592 \u44032  \u51060  \u44144 \u47337 \u54620  \u44275 \u51012  \u48512 \u46301 \u51060  \u54588 \u47196 \u50024  \u45908 \u47101 \u55176 \u45716  \u51068 \u51060  \u50630 \u46020 \u47197  \u54644  \u45804 \u46972 \u44256  \u50676 \u47148 \u55176  \u54840 \u49548 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51060  \u49457 \u50640 \u49436  \u45208 \u50752 \u49436  \u50612 \u46500  \u45796 \u47480  \u44275 \u50640 \u49436  \u49912 \u50912 \u45796 \u47732  \u47196 \u47560 \u44400 \u51008  \u50500 \u47924 \u46020  \u44536  \u49457 \u51204 \u51032  \u49888 \u49457 \u49457 \u51012  \u44648 \u46888 \u47532 \u51648  \u50500 \u45768 \u54616 \u50688 \u51012  \u44163 \u51060 \u45796 . \u50836 \u49464 \u54392 \u49828  (Josephus) \u45716  \u47588 \u50864  \u50676 \u47148 \u54620  \u50885 \u48320 \u51004 \u47196  \u44536 \u46308  \u51088 \u49888 \u44284  \u44536 \u46308 \u51032  \u46020 \u49457 \u44284  \u44536 \u46308 \u51032  \u50696 \u48176 \u54616 \u45716  \u49457 \u51204 \u51012  \u44148 \u51256 \u45236 \u44592  \u50948 \u54616 \u50668  \u54637 \u48373 \u54616 \u46972 \u44256  \u44036 \u50896 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536  \u44057 \u51008  \u44036 \u52397 \u50640  \u45824 \u54616 \u50668  \u44536 \u46308 \u51008  \u49900 \u54620  \u51200 \u51452 \u47196  \u51025 \u49688 \u54624  \u49104 \u51060 \u50632 \u45796 . \u52572 \u54980 \u51032  \u51312 \u51221 \u51088 \u47196  \u44536 \u46308 \u50640 \u44172  \u54028 \u44204 \u46104 \u50612  \u44036 \u50896 \u54616 \u45716  \u49324 \u46988 \u50640 \u44172  \u44536 \u46308 \u51008  \u46020 \u47532 \u50612  \u52285 \u46308 \u51012  \u45912 \u51276 \u45796 . \u51068 \u52237 \u51060  \u50976 \u45824 \u51064 \u46308 \u51008  \u54616 \u45208 \u45784 \u51032  \u50500 \u46308 \u51032  \u44036 \u52397 \u51012  \u48176 \u52377 \u54664 \u50632 \u45796 . \u51060 \u51228  \u44536  \u52649 \u44256 \u50752  \u44036 \u50896 \u51008  \u44536 \u46308 \u47196  \u54616 \u50668 \u44552  \u52572 \u54980 \u51032  \u51068 \u44033 \u44620 \u51648  \u45908 \u50865  \u45800 \u54840 \u54616 \u44172  \u51200 \u54637 \u54616 \u46020 \u47197  \u47564 \u46308  \u49104 \u51060 \u50632 \u45796 . \u54000 \u53804 \u49828 \u44032  \u49457 \u51204 \u51012  \u48372 \u51204 \u54616 \u44592  \u50948 \u54616 \u50668  \u44592 \u50872 \u51064  \u50728 \u44054  \u45432 \u47141 \u51008  \u54728 \u51648 \u47196  \u46028 \u50500 \u44052 \u45796 . \u54000 \u53804 \u49828 \u48372 \u45796  \u45908 \u50865  \u50948 \u45824 \u54616 \u49888  \u48516 \u44760 \u49436  \u51068 \u52237 \u51060  \u46028  \u54616 \u45208 \u46020  \u46028  \u50948 \u50640  \u52393  \u45459 \u51060 \u51648  \u50500 \u45768 \u54616 \u47532 \u46972 \u44256  \u49440 \u50616 \u54616 \u49512 \u45912  \u44163 \u51060 \u45796 .\
\uc0\u50976 \u45824  \u51648 \u46020 \u51088 \u46308 \u51032  \u47609 \u47785 \u51201 \u51064  \u44256 \u51665 \u44284  \u54252 \u50948 \u46108  \u49457  \u50504 \u50640 \u49436  \u51088 \u54665 \u46104 \u45716  \u44032 \u51613 \u54620  \u48276 \u51396 \u46308 \u51008  \u47196 \u47560 \u44400 \u51032  \u44277 \u54252 \u50752  \u48516 \u45432 \u47484  \u45908 \u50865  \u51088 \u44537 \u49884 \u53040 \u45796 . \u44536 \u47532 \u54616 \u50668  \u47560 \u52840 \u45236  \u54000 \u53804 \u49828 \u45716  \u44053 \u49845 \u54616 \u50668  \u49457 \u51204 \u51012  \u51216 \u47161 \u54616 \u44592 \u47196  \u44208 \u49900 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u54624  \u49688 \u47564  \u51080 \u51004 \u47732  \u44536  \u49457 \u51204 \u51012  \u54028 \u47736 \u50640 \u49436  \u44148 \u51256 \u45236 \u44256 \u51088  \u50528 \u47484  \u50044 \u45796 . \u44536 \u47084 \u45208  \u44536 \u51032  \u47749 \u47161 \u51008  \u47924 \u49884 \u46104 \u50632 \u45796 . \u48164 \u51060  \u46104 \u50612  \u44536 \u45716  \u51088 \u44592 \u51032  \u52380 \u47561 \u51004 \u47196  \u46028 \u50500 \u50772 \u45716 \u45936  \u44536  \u46412 \u50640  \u50976 \u45824 \u51064 \u46308 \u51060  \u49457 \u51204 \u50640 \u49436  \u46832 \u50612 \u45208 \u50752 \u49436  \u48150 \u50640  \u51080 \u45716  \u44400 \u49324 \u46308 \u51012  \u44049 \u51088 \u44592  \u44277 \u44201 \u54616 \u50688 \u45796 . \u54620 \u52285  \u49436 \u47196  \u49912 \u50880 \u51060  \u48268 \u50612 \u51276 \u51012  \u46412 \u50640  \u54620  \u44400 \u51064 \u51060  \u48520 \u48537 \u51064  \u54915 \u48520 \u51012  \u47928  \u50504 \u51004 \u47196  \u45912 \u51664 \u51004 \u47196 \u50024  \u49457 \u51204  \u51452 \u50948 \u51032  \u54665 \u46993 \u51060  \u44049 \u51088 \u44592  \u48520 \u44867 \u50640  \u55081 \u49912 \u50688 \u45796 . \u54000 \u53804 \u49828 \u45716  \u51109 \u44400 \u46308 \u44284  \u47566 \u51008  \u44400 \u49324 \u46308 \u51012  \u44144 \u45712 \u47532 \u44256  \u44536  \u44275 \u51004 \u47196  \u45804 \u47140 \u44032 \u49436  \u48520 \u51012  \u45124 \u46020 \u47197  \u47749 \u47161 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u50500 \u47924 \u46020  \u44536 \u51032  \u47749 \u47161 \u50640  \u46384 \u47476 \u51648  \u50506 \u50520 \u45796 . \u44201 \u48516 \u54620  \u44400 \u51064 \u46308 \u51008  \u49457 \u51204 \u50640  \u48537 \u50612  \u51080 \u45716  \u48169 \u46308 \u50640  \u48520 \u51012  \u45912 \u51648 \u44256  \u44144 \u44592 \u50640  \u54588 \u54644  \u51080 \u45716  \u47566 \u51008  \u49324 \u46988 \u46308 \u51012  \u52860 \u47196  \u51453 \u50688 \u45796 . \u49457 \u51204 \u51004 \u47196  \u46308 \u50612 \u44032 \u45716  \u52789 \u52789 \u45824 \u45716  \u54588 \u47196  \u47932 \u46308 \u50632 \u45796 . \u49892 \u47196  \u49688 \u48177 \u47564  \u47749 \u51032  \u50976 \u45824 \u51064 \u46308 \u51060  \u51453 \u51076 \u51012  \u45817 \u54664 \u45796 . \u51204 \u51137 \u51032  \u49548 \u50857 \u46028 \u51060  \u49549 \u50640 \u49436  \'93\u51060 \u44032 \u48391 \'94 (Ichabod \'97 \u50689 \u44305 \u51060  \u46496 \u45228 \u45796 ) \u51060 \u46972 \u44256  \u50808 \u52824 \u45716  \u49548 \u47532 \u46308 \u51060  \u46308 \u47140 \u50772 \u45796 .\
