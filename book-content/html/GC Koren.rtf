\uc0\u44396 \u51452 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u51228 \u51088 \u46308 \u51012  \u46496 \u45208 \u44032 \u49884 \u44256 \u51088  \u54616 \u49512 \u51012  \u46412 , \u44536 \u46308 \u50640 \u44172  \u45796 \u49884  \u50724 \u49884 \u44192 \u45796 \u44256  \u48372 \u51613 \u54616 \u49900 \u51004 \u47196  \u49836 \u54548 \u50640  \u51104 \u44200 \u51080 \u45716  \u44536 \u46308 \u51012  \u50948 \u47196 \u54616 \u49512 \u45796 . \'93\u45320 \u55148 \u45716  \u47560 \u51020 \u50640  \u44540 \u49900 \u54616 \u51648  \u47568 \u46972  \u54616 \u45208 \u45784 \u51012  \u48127 \u51004 \u45768  \u46608  \u45208 \u47484  \u48127 \u51004 \u46972  \u45236  \u50500 \u48260 \u51648  \u51665 \u50640  \u44144 \u54624  \u44275 \u51060  \u47566 \u46020 \u45796  \u44536 \u47111 \u51648  \u50506 \u51004 \u47732  \u45320 \u55148 \u50640 \u44172  \u51068 \u47104 \u51004 \u47532 \u46972  \u45236 \u44032  \u45320 \u55148 \u47484  \u50948 \u54616 \u50668  \u52376 \u49548 \u47484  \u50696 \u48708 \u54616 \u47084  \u44032 \u45432 \u45768  \u44032 \u49436  \u45320 \u55148 \u47484  \u50948 \u54616 \u50668  \u52376 \u49548 \u47484  \u50696 \u48708 \u54616 \u47732  \u45236 \u44032  \u45796 \u49884  \u50752 \u49436  \u45320 \u55148 \u47484  \u45236 \u44172 \u47196  \u50689 \u51217 \u54616 \u50668  \u45208  \u51080 \u45716  \u44275 \u50640  \u45320 \u55148 \u46020  \u51080 \u44172  \u54616 \u47532 \u46972 \'94 (\u50836  14:1~3). \'93\u51064 \u51088 \u44032  \u51088 \u44592  \u50689 \u44305 \u51004 \u47196  \u47784 \u46304  \u52380 \u49324 \u50752  \u54632 \u44760  \u50732  \u46412 \u50640  \u51088 \u44592  \u50689 \u44305 \u51032  \u48372 \u51340 \u50640  \u50505 \u51004 \u47532 \u45768  \u47784 \u46304  \u48124 \u51313 \u51012  \u44536  \u50526 \u50640  \u47784 \u51004 \'94 (\u47560  25:31, 32) \u47532 \u46972 .\
\uc0\u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u49849 \u52380 \u54616 \u49888  \u54980 \u50640  \u44048 \u46988 \u49328  \u50948 \u50640  \u47672 \u47932 \u47084  \u51080 \u45912  \u52380 \u49324 \u46308 \u51008  \u51228 \u51088 \u46308 \u50640 \u44172  \u51452 \u45784 \u44760 \u49436  \u45796 \u49884  \u50724 \u49892  \u44163 \u51012  \u44144 \u46317  \u46104 \u54400 \u51060 \u54616 \u50668  \u47568 \u54616 \u50688 \u45796 . \'93\u44040 \u47540 \u47532  \u49324 \u46988 \u46308 \u50500  \u50612 \u52236 \u54616 \u50668  \u49436 \u49436  \u54616 \u45720 \u51012  \u52432 \u45796 \u48372 \u45712 \u45264  \u45320 \u55148  \u44032 \u50868 \u45936 \u49436  \u54616 \u45720 \u47196  \u50732 \u47532 \u50864 \u49888  \u51060  \u50696 \u49688 \u45716  \u54616 \u45720 \u47196  \u44032 \u49900 \u51012  \u48376  \u44536 \u45824 \u47196  \u50724 \u49884 \u47532 \u46972 \'94 (\u54665  1:11). \u49324 \u46020  \u48148 \u50872 \u51008  \u49457 \u47161 \u51032  \u50689 \u44048 \u51012  \u48155 \u50500  \'93\u51452 \u44760 \u49436  \u54840 \u47161 \u44284  \u52380 \u49324 \u51109 \u51032  \u49548 \u47532 \u50752  \u54616 \u45208 \u45784 \u51032  \u45208 \u54036 \u47196  \u52828 \u55176  \u54616 \u45720 \u47196  \u51335 \u50500  \u44053 \u47548 \u54616 \u49884 \u47532 \'94 (\u49332 \u51204  4:16) \u46972 \u44256  \u51613 \u50616 \u54616 \u50688 \u45796 . \u48167 \u47784 \u49452 \u51032  \u49440 \u51648 \u51088  \u50836 \u54620 \u51008  \'93\u48380 \u51648 \u50612 \u45796  \u44396 \u47492 \u51012  \u53440 \u44256  \u50724 \u49884 \u47532 \u46972  \u44033 \u51064 \u51032  \u45576 \u51060  \u44536 \u47484  \u48372 \u44192 \u44256 \'94 (\u44228  1:7) \u46972 \u44256  \u47568 \u54616 \u50688 \u45796 .\
\uc0\u44536 \u48516 \u51032  \u51116 \u47548 \u51008  \'93\u54616 \u45208 \u45784 \u51060  \u50689 \u50896  \u51204 \u48512 \u53552  \u44144 \u47337 \u54620  \u49440 \u51648 \u51088 \u51032  \u51077 \u51012  \u51032 \u53441 \u54616 \u50668  \u47568 \u50432 \u54616 \u49888 \u48148  \u47564 \u50976 \u47484  \u54924 \u48373 \u54616 \u49892  \u46412 \'94 (\u54665  3:21) \u51032  \u50689 \u44305 \u51060  \u46108 \u45796 . \u50724 \u47019 \u46041 \u50504  \u44228 \u49549 \u54616 \u50668  \u50728  \u50501 \u51032  \u53685 \u52824 \u44032  \u44536  \u46412 \u50640  \u44648 \u50612 \u51656  \u44163 \u51060 \u45796 . \u44536 \u47532 \u44256  \'93\u49464 \u49345  \u45208 \u46972 \u44032  \u51452 \u50752  \u44536 \u47532 \u49828 \u46020 \u51032  \u45208 \u46972 \u44032  \u46104 \u50612  \u44536 \u44032  \u49464 \u49464 \u53664 \u47197  \u50773 \u45432 \u47495  \u54616 \u49884 \u47532 \u47196 \u45796 \'94 (\u44228  11:15). \'93\u50668 \u54840 \u50752 \u51032  \u50689 \u44305 \u51060  \u45208 \u53440 \u45208 \u44256  \u47784 \u46304  \u50977 \u52404 \u44032  \u44536 \u44163 \u51012  \u54632 \u44760  \u48372 \u47532 \u46972 \'94, \'93\u50668 \u54840 \u50752 \u44760 \u49436  \u51032 \u50752  \u52268 \u49569 \u51012  \u50676 \u48169  \u50526 \u50640  \u48156 \u49373 \u54616 \u44172  \u54616 \u49884 \u47532 \u46972 \'94 \'93\u44536 \u45216 \u50640  \u47564 \u44400 \u51032  \u50668 \u54840 \u50752 \u44760 \u49436  \u44536  \u45224 \u51008  \u48177 \u49457 \u50640 \u44172  \u50689 \u54868 \u47196 \u50868  \u47732 \u47448 \u44288 \u51060  \u46104 \u49884 \u47728  \u50500 \u47492 \u45796 \u50868  \u54868 \u44288 \u51060  \u46104 \u49892  \u44163 \u51060 \u46972 \'94 (\u49324  40:5, 61:11, 28:5).\
\uc0\u44536  \u46412 \u50640  \u50724 \u47019 \u46041 \u50504  \u44592 \u45796 \u47536  \u54217 \u54868 \u47196 \u50868  \u47700 \u49884 \u50556 \u51032  \u45208 \u46972 \u44032  \u50728  \u50864 \u51452  \u50526 \u50640  \u49464 \u50892 \u51656  \u44163 \u51060 \u45796 . \'93\u45824 \u51200  \u45208  \u50668 \u54840 \u50752 \u44032  \u49884 \u50728 \u51012  \u50948 \u47196 \u54616 \u46104  \u44536  \u47784 \u46304  \u54889 \u54224 \u54620  \u44275 \u51012  \u50948 \u47196 \u54616 \u50668  \u44536  \u44305 \u50556 \u47196  \u50640 \u45940  \u44057 \u44256  \u44536  \u49324 \u47561 \u51004 \u47196  \u50668 \u54840 \u50752 \u51032  \u46041 \u49328  \u44057 \u44172  \u54616 \u50688 \u45208 \u45768 \'94, \'93\u47112 \u48148 \u45436 \u51032  \u50689 \u44305 \u44284  \u44040 \u47708 \u44284  \u49324 \u47200 \u51032  \u50500 \u47492 \u45796 \u50880 \u51012  \u50619 \u51012  \u44163 \u51060 \u46972 \'94, \'93\u45796 \u49884 \u45716  \u45320 \u47484  \u48260 \u47532 \u50868  \u51088 \u46972  \u52845 \u54616 \u51648  \u50500 \u45768 \u54616 \u47728  \u45796 \u49884 \u45716  \u45348  \u46405 \u51012  \u54889 \u47924 \u51648 \u46972  \u52845 \u54616 \u51648  \u50500 \u45768 \u54616 \u44256  \u50724 \u51649  \u45320 \u47484  \u54773 \u49884 \u48148 \u46972  \u54616 \u47728  \u45348  \u46405 \u51012  \u49212 \u46972 \u46972  \u54616 \u47532 \u45768 \'85\u47560 \u52824  \u52397 \u45380 \u51060  \u52376 \u45376 \u50752  \u44208 \u54844 \u54632 \u44057 \u51060 \'85\u45348  \u54616 \u45208 \u45784 \u51060  \u45320 \u47484  \u44592 \u48848 \u54616 \u49884 \u47532 \u46972 \'94 (\u49324  51:3, 35:2, 62:4, 5).\
\uc0\u44536 \u47532 \u49828 \u46020 \u51032  \u51116 \u47548 \u51008  \u44033  \u49884 \u45824 \u47484  \u53685 \u54616 \u50668  \u54616 \u45208 \u45784 \u51032  \u51088 \u45376 \u46308 \u51032  \u55148 \u47581 \u51060  \u46104 \u50612  \u50772 \u45796 . \u44396 \u51452 \u44760 \u49436  \u44048 \u46988 \u49328 \u50640 \u49436  \u51060 \u48324 \u54616 \u49884 \u47732 \u49436  \u45796 \u49884  \u50724 \u49884 \u44192 \u45796 \u44256  \u54616 \u49888  \u51116 \u47548 \u51032  \u50557 \u49549 \u51008  \u51228 \u51088 \u46308 \u51032  \u48120 \u47000 \u47484  \u48157 \u54784  \u51452 \u50632 \u44256 , \u50612 \u46500  \u49836 \u54548 \u46020  \u48764 \u50519 \u50500  \u44040  \u49688  \u50630 \u44256  \u50612 \u46500  \u49884 \u47144 \u46020  \u55120 \u47532 \u44172  \u54624  \u49688  \u50630 \u45716  \u44592 \u49256 \u44284  \u55148 \u47581 \u51004 \u47196  \u44536 \u46308 \u51032  \u47560 \u51020 \u51012  \u52649 \u47564 \u54616 \u44172  \u54616 \u50668  \u51452 \u50632 \u45796 . \u48149 \u54644 \u50752  \u49884 \u47144  \u51473 \u50640 \u49436 \u46020  \'93\u53356 \u49888  \u54616 \u45208 \u45784  \u50864 \u47532  \u44396 \u51452  \u50696 \u49688  \u44536 \u47532 \u49828 \u46020 \u51032  \u50689 \u44305 \u51032  \u45208 \u53440 \u45208 \u49900 \'94\u51060  \'93\u48373 \u46108  \u49548 \u47581 \'94\u51060  \u46104 \u50632 \u45796 . \u45936 \u49332 \u47196 \u45768 \u44032 \u51032  \u44536 \u47532 \u49828 \u46020 \u51064 \u46308 \u51060  \u49332 \u50500 \u49436  \u51452 \u45784 \u51032  \u51116 \u47548 \u51012  \u48372 \u44592 \u47484  \u55148 \u47581 \u54616 \u45912  \u49324 \u46993 \u54616 \u45716  \u49324 \u46988 \u46308 \u51060  \u51453 \u51004 \u48064 \u47196  \u49836 \u54548 \u50640  \u51104 \u44200  \u51080 \u51012  \u46412  \u44536 \u46308 \u51032  \u49828 \u49849 \u51064  \u48148 \u50872 \u51008  \u44396 \u51452 \u51032  \u51116 \u47548 \u49884 \u50640  \u51080 \u51012  \u48512 \u54876 \u51012  \u44536 \u46308 \u50640 \u44172  \u50508 \u47140  \u51452 \u50632 \u45796 . \'93\u44536 \u47532 \u49828 \u46020  \u50504 \u50640 \u49436  \u51453 \u51008  \u51088 \u46308 \u51060  \u47676 \u51200  \u51068 \u50612 \u45208 \u44256  \u44536  \u54980 \u50640  \u50864 \u47532  \u49332 \u50500 \u45224 \u51008  \u51088 \u46020  \u51200 \u55148 \u50752  \u54632 \u44760  \u44396 \u47492  \u49549 \u51004 \u47196  \u45132 \u50612 \u50732 \u47140  \u44277 \u51473 \u50640 \u49436  \u51452 \u47484  \u50689 \u51217 \u54616 \u44172  \u54616 \u49884 \u47532 \u45768  \u44536 \u47532 \u54616 \u50668  \u50864 \u47532 \u44032  \u54637 \u49345  \u51452 \u50752  \u54632 \u44760  \u51080 \u51004 \u47532 \u46972  \u44536 \u47084 \u48064 \u47196  \u51060  \u50668 \u47084  \u47568 \u47196  \u49436 \u47196  \u50948 \u47196 \u54616 \u46972 \'94 (\u49332 \u51204  4:16~18).\
