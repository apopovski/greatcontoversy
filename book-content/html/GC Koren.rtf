\f0\b \cf0 \uc0\u48277 \u50773 \u52769 \u51032  \u50948 \u54801 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u47196 \u47560 \u44368 \u46020 \u46308 \u51008  \u54056 \u48176 \u54616 \u50668  \u54805 \u49464 \u44032  \u44032 \u51109  \u48520 \u47532 \u54620  \u52376 \u51648 \u50640  \u45459 \u51064  \u44163 \u52376 \u47100  \u48372 \u50688 \u45796 . \u44536 \u47084 \u51088  \u44536 \u46308 \u51008  \u49457 \u44221 \u50640  \u51032 \u54616 \u51648  \u50506 \u44256  \u47196 \u47560 \u51032  \u49345 \u53804  \u49688 \u45800 \u51064  \u50948 \u54801 \u51004 \u47196  \u44536 \u46308 \u51032  \u44428 \u47141 \u51012  \u50976 \u51648 \u54616 \u44256 \u51088  \u45432 \u47141 \u54616 \u50688 \u45796 . \u51032 \u54924 \u51032  \u45824 \u48320 \u51064 \u51008  \'93\u47564 \u51068  \u45348 \u44032  \u52712 \u49548 \u54616 \u51648  \u50506 \u45716 \u45796 \u47732  \u54889 \u51228 \u50752  \u47784 \u46304  \u50672 \u48169 \u51008  \u51060 \u52376 \u47100  \u50756 \u44256 \u54620  \u51060 \u45800 \u51088 \u47484  \u50612 \u46523 \u44172  \u52376 \u52824 \u54624  \u44163 \u51064 \u51648  \u51032 \u45436 \u54624  \u44163 \u51060 \u45796 \'94\u46972 \u44256  \u49440 \u50616 \u54616 \u50688 \u45796 .\
\uc0\u47336 \u53552 \u51032  \u54988 \u47469 \u54620  \u48320 \u54840 \u47484  \u53360  \u44592 \u49256 \u51004 \u47196  \u46307 \u44256  \u51080 \u45912  \u47336 \u53552 \u51032  \u52828 \u44396 \u46308 \u51008  \u44536  \u49440 \u50616 \u51012  \u46307 \u44256  \u46160 \u47140 \u50892  \u46504 \u44172  \u46104 \u50632 \u45796 . \u44536 \u47084 \u45208  \u47336 \u53552 \u45716  \u50500 \u51452  \u52840 \u52265 \u54616 \u44172  \'93\u54616 \u45208 \u45784 \u51008  \u45208 \u47484  \u46020 \u50752 \u51452 \u49892  \u44163 \u51060 \u45796 . \u45208 \u45716  \u44208 \u53076  \u52712 \u49548 \u54624  \u49688  \u50630 \u45796 \'94 (D\'92Aubigne, b.7, ch.8) \u44256  \u47568 \u54616 \u50688 \u45796 .\
\uc0\u44536 \u45716  \u51032 \u50896 \u46308 \u51060  \u54801 \u51032 \u54616 \u45716  \u46041 \u50504 , \u53748 \u51109 \u54616 \u46972 \u45716  \u47749 \u47161 \u51012  \u48155 \u50520 \u45796 . \u50612 \u46500  \u53360  \u50948 \u44592 \u44032  \u45796 \u44032 \u50728  \u44163 \u51012  \u45712 \u45180 \u44172  \u46104 \u50632 \u45796 . \u47336 \u53552 \u44032  \u52572 \u54980 \u44620 \u51648  \u44404 \u48373 \u54616 \u51648  \u50506 \u44256  \u44403 \u44172  \u49440  \u44163 \u51008  \u50668 \u47084  \u49884 \u45824 \u47484  \u53685 \u54616 \u50668  \u44368 \u54924 \u51032  \u50669 \u49324 \u50640  \u50689 \u54693 \u51012  \u48120 \u52832  \u49688 \u48150 \u50640  \u50630 \u50632 \u45796 . \u44536 \u47084 \u48064 \u47196  \u44536 \u50640 \u44172  \u52712 \u49548 \u54624  \u44592 \u54924 \u47484  \u54620  \u48264  \u45908  \u51452 \u44592 \u47196  \u44208 \u51221 \u46104 \u50632 \u45796 . \u44536 \u45716  \u47560 \u51648 \u47561 \u51004 \u47196  \u51032 \u54924 \u50640  \u52636 \u46160 \u54616 \u44172  \u46104 \u50632 \u45796 . \u44536 \u51032  \u51452 \u51109 \u51012  \u48512 \u51064 \u54624  \u44163 \u51064 \u51648  \u50504  \u54624  \u44163 \u51064 \u51648 \u50640  \u45824 \u54616 \u50668  \u45796 \u49884  \u51656 \u47928 \u51060  \u51452 \u50612 \u51276 \u45796 . \u44536 \u45716  \'93\u48376 \u51064 \u51008  \u51060 \u48120  \u45824 \u45813 \u54616 \u50688 \u51004 \u48064 \u47196  \u44536  \u51060 \u49345  \u45796 \u47480  \u45824 \u45813 \u51012  \u54624  \u44163 \u51060  \u50630 \u49845 \u45768 \u45796 \'94\u46972 \u44256  \u47568 \u54616 \u50688 \u45796 . \u50500 \u47924 \u47532  \u44428 \u50976 \u54616 \u44256  \u50948 \u54801 \u54624 \u51648 \u46972 \u46020  \u47196 \u47560 \u51032  \u47749 \u47161 \u50640  \u48373 \u51333 \u54616 \u46020 \u47197  \u49444 \u46301 \u54624  \u49688  \u50630 \u45796 \u45716  \u44163 \u51060  \u48516 \u47749 \u54644 \u51276 \u45796 .\
\uc0\u48277 \u50773 \u52769 \u51032  \u51648 \u46020 \u51088 \u46308 \u51008  \u44397 \u50773 \u44284  \u44480 \u51313 \u46308 \u44620 \u51648 \u46020  \u46160 \u47140 \u50892  \u46504 \u44172  \u54664 \u45912  \u44536 \u46308 \u51032  \u44428 \u47141 \u51060  \u51068 \u44060  \u48708 \u52380 \u54620  \u49849 \u47140 \u50640 \u44172  \u51060 \u52376 \u47100  \u47924 \u49884 \u45817 \u54620  \u44163 \u51012  \u48512 \u45124 \u47101 \u44172  \u50668 \u44220 \u45796 . \u44536 \u46308 \u51008  \u44256 \u47928 \u51004 \u47196  \u44536 \u51032  \u49373 \u47749 \u51012  \u48764 \u50519 \u51020 \u51004 \u47196  \u44536 \u50640 \u44172  \u45824 \u54620  \u44536 \u46308 \u51032  \u48516 \u45432 \u47484  \u50508 \u47140 \u51452 \u44256 \u51088  \u44040 \u47581 \u54616 \u50688 \u45796 . \u47336 \u53552 \u45716  \u51060 \u47084 \u54620  \u50948 \u54744 \u51012  \u44648 \u45803 \u44256  \u50948 \u50628  \u51080 \u44256  \u52840 \u52265 \u54620  \u44536 \u47532 \u49828 \u46020 \u51064 \u51032  \u53468 \u46020 \u47196  \u47784 \u46304  \u49324 \u46988 \u50640 \u44172  \u47568 \u54616 \u50688 \u45796 . \u44536 \u51032  \u47568 \u50640 \u45716  \u44368 \u47564 \u44284  \u44201 \u47148 \u54620  \u44048 \u51221 \u44284  \u54728 \u50948 \u44032  \u51312 \u44552 \u46020  \u50630 \u50632 \u45796 . \u44536 \u45716  \u51088 \u44592  \u51088 \u49888 \u51060 \u45208  \u51088 \u44592  \u51452 \u50948 \u50640  \u45458 \u51008  \u51064 \u47932 \u46308 \u51060  \u51080 \u45716  \u44163 \u46020  \u45796  \u51082 \u50612 \u48260 \u47532 \u44256 , \u45796 \u47564  \u44536 \u44032  \u48277 \u50773 \u51060 \u45208  \u51452 \u44368 \u45208  \u50773 \u51060 \u45208  \u54889 \u51228 \u48372 \u45796 \u46020  \u45908 \u50865  \u52488 \u50900 \u54616 \u49888  \u48516  \u50526 \u50640  \u51080 \u45716  \u49324 \u49892 \u51012  \u44648 \u45804 \u50520 \u45796 . \u47336 \u53552 \u51032  \u51613 \u44144 \u47484  \u53685 \u54616 \u50668  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u50628 \u49689 \u54616 \u44256  \u55192  \u51080 \u44172  \u47568 \u50432 \u54616 \u49512 \u51004 \u48064 \u47196  \u52828 \u44396 \u46308 \u44284  \u50896 \u49688 \u46308 \u51060  \u45796  \u44057 \u51060  \u44221 \u53444 \u44284  \u46160 \u47140 \u50880 \u50640  \u49324 \u47196 \u51105 \u55176 \u44172  \u46104 \u50632 \u45796 . \u54616 \u45208 \u45784 \u51032  \u49457 \u47161 \u44760 \u49436  \u44536  \u51032 \u54924 \u50640  \u45208 \u53440 \u45208 \u49436  \u45208 \u46972 \u51032  \u51473 \u49888  (\u37325 \u33251 ) \u46308 \u51032  \u47560 \u51020 \u50640  \u44618 \u51008  \u44048 \u46041 \u51012  \u51452 \u49512 \u45796 . \u50668 \u47084  \u47749 \u51032  \u50689 \u51452 \u46308 \u51060  \u47336 \u53552 \u51032  \u51452 \u51109 \u51012  \u44277 \u51221 \u54616 \u45796 \u44256  \u44592 \u53444 \u50630 \u51060  \u47568 \u54616 \u50688 \u45796 . \u47566 \u51008  \u49324 \u46988 \u46308 \u51060  \u44536  \u51652 \u47532 \u47484  \u54869 \u49888 \u54616 \u44172  \u46104 \u50632 \u45796 . \u44536 \u47084 \u45208  \u50612 \u46500  \u49324 \u46988 \u46308 \u51008  \u50724 \u47000 \u51648  \u50500 \u45768 \u54616 \u50668  \u44536  \u54869 \u49888 \u51012  \u51075 \u50612 \u48260 \u47160 \u45796 . \u44536 \u47084 \u45208  \u51088 \u44592 \u44032  \u48155 \u51008  \u44048 \u47749 \u51012  \u45817 \u51109 \u50640  \u54364 \u49884 \u54616 \u51648 \u45716  \u50506 \u50520 \u51004 \u45208  \u49828 \u49828 \u47196  \u49457 \u44221 \u51012  \u50672 \u44396 \u54620  \u54980 \u50640 , \u51109 \u52264  \u44060 \u54785  \u50868 \u46041 \u51032  \u50976 \u47141 \u54620  \u54980 \u50896 \u51088 \u46308 \u51060  \u46108  \u49324 \u46988 \u46020  \u51080 \u50632 \u45796 .\
