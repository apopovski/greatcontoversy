\uc0\u51060 \u47532 \u54616 \u50668  \u51060  \u53360  \u48176 \u46020 \u51088 \u45716  \u47560 \u52840 \u45236  \u48276 \u49324 \u50640  \u51068 \u52971 \u45716  \'93\u54616 \u45208 \u45784 \u51060 \u45208  \u49709 \u48176 \u54632 \u51012  \u48155 \u45716  \u51088  \u50948 \u50640  \u46832 \u50612 \u45208 \'94 (\u49332 \u54980  2:4) \u44172  \u49828 \u49828 \u47196 \u47484  \u45458 \u51060 \u45716  \u45936  \u49457 \u44277 \u54616 \u50688 \u45796 . \u44536 \u45716  \u45824 \u45812 \u54616 \u44172 \u46020  \u47784 \u46304  \u51064 \u47448 \u50640 \u44172  \u49332 \u50500 \u44228 \u49888  \u52280  \u54616 \u45208 \u45784 \u51012  \u51221 \u54869 \u54616 \u44172  \u44032 \u47476 \u52432 \u51452 \u45716  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51032  \u50976 \u51068 \u54620  \u44228 \u47749 \u51012  \u48320 \u44221 \u54616 \u47140 \u44256  \u49884 \u46020 \u54616 \u50688 \u45796 . \u45367 \u51704  \u44228 \u47749  \u44032 \u50868 \u45936  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u52380 \u51648 \u51032  \u52285 \u51312 \u51452 \u47196 \u49436  \u44228 \u49884 \u46104 \u50632 \u51004 \u47728  \u44536 \u47088  \u44620 \u45805 \u50640  \u45796 \u47480  \u44144 \u51667  \u49888 \u46308 \u44284  \u44396 \u48324 \u46104 \u49888 \u45796 . \u44536 \u47532 \u44256  \u51228 \u52832 \u51068 \u51060  \u51064 \u47448 \u51032  \u50504 \u49885 \u51068 \u47196  \u44144 \u47337 \u55176  \u44396 \u48324 \u46108  \u44163 \u51008  \u54620 \u54200 \u51004 \u47196  \u52285 \u51312  \u49324 \u50629 \u51012  \u44592 \u45392 \u54616 \u45716  \u46041 \u49884 \u50640 , \u46608 \u54620  \u51064 \u47448 \u51032  \u47560 \u51020 \u50640  \u49332 \u50500  \u44228 \u49888  \u54616 \u45208 \u45784 \u51008  \u49373 \u47749 \u51032  \u44540 \u50896 \u51060 \u47728  \u51316 \u44221 \u44284  \u50696 \u48176 \u51032  \u45824 \u49345 \u51060  \u46104 \u49888 \u45796 \u45716  \u44163 \u51012  \u50616 \u51228 \u45208  \u49373 \u44033 \u45208 \u44172  \u54616 \u44592  \u50948 \u54632 \u51060