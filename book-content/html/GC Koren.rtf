\uc0\u47566 \u51008  \u51333 \u44368  \u51648 \u46020 \u51088 \u46308 \u51008  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u45817 \u49888 \u51032  \u51453 \u51020 \u51004 \u47196  \u50984 \u48277 \u51012  \u54224 \u54616 \u49512 \u44592  \u46412 \u47928 \u50640  \u44536  \u51060 \u54980 \u48512 \u53552  \u49324 \u46988 \u51060  \u50984 \u48277 \u51032  \u50836 \u44396 \u50640 \u49436  \u54644 \u48169 \u46104 \u50632 \u45796 \u44256  \u51452 \u51109 \u54620 \u45796 . \u44536  \u51473  \u50612 \u46500  \u49324 \u46988 \u46308 \u51008  \u50984 \u48277 \u51012  \u47560 \u52824  \u47924 \u44144 \u50868  \u47693 \u50640 \u52376 \u47100  \u45208 \u53440 \u45236 \u44256  \u50984 \u48277 \u51032  \u49549 \u48149 \u44284  \u48373 \u51020  \u50500 \u47000 \u49436  \u45572 \u47540  \u49688  \u51080 \u45716  \u51088 \u50976 \u47484  \u45824 \u51312 \u51201 \u51004 \u47196  \u47568 \u54620 \u45796 .\
\uc0\u44536 \u47084 \u45208  \u49440 \u51648 \u51088 \u46308 \u44284  \u49324 \u46020 \u46308 \u51008  \u54616 \u45208 \u45784 \u51032  \u44144 \u47337 \u54620  \u50984 \u48277 \u51012  \u44536 \u47111 \u44172  \u49373 \u44033 \u54616 \u51648  \u50506 \u50520 \u45796 . \u45796 \u50967 \u51008  \'93\u45236 \u44032  \u51452 \u51032  \u48277 \u46020 \u47484  \u44396 \u54616 \u50688 \u49324 \u50724 \u45768  \u51088 \u50976 \u47213 \u44172  \u54665 \u48372 \u54624  \u44163 \u51060 \u50724 \u47728 \'94 (\u49884  119:45) \u46972  \u54616 \u50688 \u45796 . \u49324 \u46020  \u50556 \u44256 \u48372 \u45716  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u46028 \u50500 \u44032 \u49888  \u54980 \u50640  \u49901 \u44228 \u47749 \u51012  \'93\u52572 \u44256 \u54620  \u48277 \'94 \u46608 \u54620  \'93\u50728 \u51204 \u54620  \u50984 \u48277 \'94\u51060 \u46972 \u44256  \u47568 \u54616 \u50688 \u45796  (\u50557  2:8, 1:25). \u46608 \u54620  \u50836 \u54620 \u44228 \u49884 \u47197 \u51032  \u44592 \u51088 \u45716  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u49901 \u51088 \u44032 \u50640  \u46028 \u50500 \u44032 \u49888  \u51648  \u48152 \u49464 \u44592  \u54980 \u50640  \'93\u44536  \u46160 \u47336 \u47560 \u44592 \u47484  \u48736 \u45716  \u51088  (\u50689 \u50612  \u55136 \u51221 \u50669  \u49457 \u44221 \u50640 \u45716  \'91\u44228 \u47749 \u51012  \u51648 \u53412 \u45716  \u51088 \'92\u47196  \u48264 \u50669 \u46104 \u50632 \u51020 ) \u46308 \u51008  \u48373 \u51060  \u51080 \u51004 \u45768  \u51060 \u45716  \u51200 \u55148 \u44032  \u49373 \u47749 \u45208 \u47924 \u50640  \u45208 \u50500 \u44032 \u47728  \u47928 \u46308 \u51012  \u53685 \u54616 \u50668  \u49457 \u50640  \u46308 \u50612 \u44040  \u44428 \u49464 \u47484  \u50619 \u51004 \u47140 \u54632 \u51060 \u47196 \u45796 \'94 (\u44228  22:14) \u44256  \u54616 \u50688 \u45796 .\
\uc0\u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u45817 \u49888 \u51032  \u51453 \u51020 \u51004 \u47196 \u50024  \u54616 \u45720  \u50500 \u48260 \u51648 \u51032  \u50984 \u48277 \u51012  \u54224 \u54616 \u49512 \u45796 \u45716  \u51452 \u51109 \u51008  \u50500 \u47924  \u44540 \u44144 \u44032  \u50630 \u45796 . \u47564 \u51068  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51060  \u48320 \u44221 \u46104 \u44144 \u45208  \u54224 \u51648 \u46112  \u49688  \u51080 \u50632 \u45796 \u47732  \u49324 \u46988 \u51012  \u51396 \u51032  \u54805 \u48268 \u50640 \u49436  \u44396 \u50896 \u54616 \u44592  \u50948 \u54616 \u50668  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u46028 \u50500 \u44032 \u49892  \u54596 \u50836 \u44032  \u50630 \u50632 \u51012  \u44163 \u51060 \u45796 . \u44536 \u47532 \u49828 \u46020 \u51032  \u51453 \u51020 \u51008  \u50984 \u48277 \u51012  \u54224 \u51648 \u54616 \u44592 \u45716 \u52964 \u45397  \u50984 \u48277 \u51032  \u48520 \u48320 \u49457 \u51012  \u51613 \u47749 \u54644  \u51456 \u45796 . \u54616 \u45208 \u45784 \u51032  \u50500 \u46308 \u51008  \'93\u50984 \u48277 \u51012  \u53356 \u44172  \u54616 \u47728  \u51316 \u44480 \u52992 \'94 \u54616  (\u49324  42:21 \u45212 \u50808  \u51452 \u49437 ) \u44592  \u50948 \u54616 \u50668  \u50724 \u49512 \u45796 . \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \'93\u45236 \u44032  \u50984 \u48277  (\u51012 ) \'85\u54224 \u54616 \u47084  \u50728  \u51460 \u47196  \u49373 \u44033 \u51648  \u47568 \u46972 \'85\u52380 \u51648 \u44032  \u50630 \u50612 \u51648 \u44592  \u51204 \u50640 \u45716  \u50984 \u48277 \u51032  \u51068 \u51216 \u51068 \u54925 \u51060 \u46972 \u46020  \u48152 \u46300 \u49884  \u50630 \u50612 \u51648 \u51648  \u50500 \u45768 \u54616 \u44256  \u45796  \u51060 \u47336 \u47532 \u46972 \'94 (\u47560  5:17, 18) \u44256  \u47568 \u50432 \u54616 \u49512 \u45796 . \u46608 \u54620  \u44536 \u48516 \u44760 \u49436 \u45716  \u45817 \u49888  \u51088 \u49888 \u50640  \u45824 \u54616 \u50668  \'93\u45208 \u51032  \u54616 \u45208 \u45784 \u51060 \u50668  \u45236 \u44032  \u51452 \u51032  \u46907  \u54665 \u54616 \u44592 \u47484  \u51600 \u44592 \u50724 \u45768  \u51452 \u51032  \u48277 \u51060  \u45208 \u51032  \u49900 \u51473 \u50640  \u51080 \u45208 \u51060 \u45796 \'94 (\u49884  40:8) \u44256  \u50616 \u47749 \u54616 \u49888 \u45796 .\
\uc0\u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51008  \u48148 \u47196  \u44536  \u48376 \u51656 \u49345 \u51004 \u47196  \u48520 \u48320 \u51060 \u45796 . \u44536 \u44163 \u51008  \u50984 \u48277 \u51032  \u52285 \u49884 \u51088 \u51060 \u49888  \u54616 \u45208 \u45784 \u51032  \u46907 \u44284  \u54408 \u49457 \u51012  \u45208 \u53440 \u45240 \u45796 . \u54616 \u45208 \u45784 \u51060  \u49324 \u46993 \u51060 \u49884 \u48064 \u47196  \u44536 \u48516 \u51032  \u50984 \u48277 \u46020  \u49324 \u46993 \u51060 \u45796 . \u50984 \u48277 \u51032  \u46160  \u44032 \u51648  \u53360  \u50896 \u52825 \u51008  \u54616 \u45208 \u45784 \u44760  \u45824 \u54620  \u49324 \u46993 \u44284  \u49324 \u46988 \u50640 \u44172  \u45824 \u54620  \u49324 \u46993 \u51060 \u45796 . \'93\u49324 \u46993 \u51008  \u50984 \u48277 \u51032  \u50756 \u49457 \u51060 \'94 (\u47212  13:10) \u45796 . \u54616 \u45208 \u45784 \u51032  \u54408 \u49457 \u51008  \u51032 \u47728  \u51652 \u47532 \u51060 \u45796 . \u44536 \u51032  \u50984 \u48277 \u51032  \u48376 \u51656 \u46020  \u47560 \u52268 \u44032 \u51648 \u51060 \u45796 . \u49884 \u54200  \u44592 \u51088 \u45716  \'93\u51452 \u51032  \u48277 \u51008  \u51652 \u47532 \u47196 \u49548 \u51060 \u45796 \'94, \'93\u51452 \u51032  \u47784 \u46304  \u44228 \u47749 \u51060  \u51032 \u47196 \u50864 \'94 (\u49884  119:142, 172) \u45768 \u51060 \u45796 \u44256  \u47568 \u54620 \u45796 . \u46608 \u54620  \u49324 \u46020  \u48148 \u50872 \u51008  \'93\u50984 \u48277 \u46020  \u44144 \u47337 \u54616 \u47728  \u44228 \u47749 \u46020  \u44144 \u47337 \u54616 \u47728  \u51032 \u47196 \u50864 \u47728  \u49440 \u54616 \u46020 \u45796 \'94 (\u47212  7:12) \u44256  \u51452 \u51109 \u54620 \u45796 . \u51060 \u50752  \u44057 \u51060  \u50984 \u48277 \u51008  \u54616 \u45208 \u45784 \u51032  \u47560 \u51020 \u44284  \u46907 \u51032  \u54364 \u54788 \u51060 \u48064 \u47196  \u44536  \u52285 \u49884 \u51088 \u50752  \u44057 \u51060  \u50689 \u44396 \u51201 \u51064  \u44163 \u51060  \u46104 \u50612 \u50556  \u54620 \u45796 .\
\uc0\u49324 \u46988 \u51012  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51032  \u50896 \u52825 \u44284  \u51068 \u52824 \u46104 \u44172  \u54644 \u51468 \u51004 \u47196  \u54616 \u45208 \u45784 \u44284  \u49324 \u46988 \u51012  \u54868 \u47785 \u54616 \u44172  \u54644 \u51452 \u45716  \u44163 \u51060  \u54924 \u44060 \u50752  \u49457 \u54868 \u51032  \u49324 \u50629 \u51060 \u45796 . \u53468 \u52488 \u50640  \u49324 \u46988 \u51008  \u54616 \u45208 \u45784 \u51032  \u54805 \u49345 \u45824 \u47196  \u52285 \u51312 \u46104 \u50632 \u45796 . \u49324 \u46988 \u51008  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u44284  \u48376 \u49457 \u50640  \u50756 \u51204 \u55176  \u51312 \u54868 \u47484  \u51060 \u47336 \u50632 \u45796 . \u51032 \u51032  \u50896 \u52825 \u51060  \u44536 \u51032  \u47560 \u51020 \u50640  \u49352 \u44200 \u51256  \u51080 \u50632 \u45796 . \u44536 \u47084 \u45208  \u51396 \u44032  \u52285 \u51312 \u51452 \u50752  \u49324 \u46988 \u51012  \u48516 \u47532 \u49884 \u53040 \u45796 . \u44536 \u45716  \u45908  \u51060 \u49345  \u54616 \u45208 \u45784 \u51032  \u54805 \u49345 \u51012  \u48152 \u49324 \u54624  \u49688  \u50630 \u44172  \u46104 \u50632 \u45796 . \u44536 \u51032  \u47560 \u51020 \u51008  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51032  \u50896 \u52825 \u44284  \u48152 \u45824 \u46104 \u50632 \u45796 . \'93\u50977 \u49888 \u51032  \u49373 \u44033 \u51008  \u54616 \u45208 \u45784 \u44284  \u50896 \u49688 \u44032  \u46104 \u45208 \u45768  \u51060 \u45716  \u54616 \u45208 \u45784 \u51032  \u48277 \u50640  \u44404 \u48373 \u52824  \u50500 \u45768 \u54624  \u49104  \u50500 \u45768 \u46972  \u54624  \u49688 \u46020  \u50630 \u51020 \u51060 \u46972 \'94 (\u47212  8:7). \u44536 \u47084 \u45208  \'93\u54616 \u45208 \u45784 \u51060  \u49464 \u49345 \u51012  \u51060 \u52376 \u47100  \u49324 \u46993 \u54616 \u49324  \u46021 \u49373 \u51088 \u47484  \u51452 \'94\u49884 \u48064 \u47196  \u49324 \u46988 \u51060  \u54616 \u45208 \u45784 \u44284  \u54868 \u47785 \u54624  \u49688  \u51080 \u44172  \u46104 \u50632 \u45796 . \u49324 \u46988 \u51008  \u44536 \u47532 \u49828 \u46020 \u51032  \u44277 \u47196 \u47484  \u53685 \u54616 \u50668  \u52285 \u51312 \u51452 \u50752 \u51032  \u51312 \u54868 \u47484  \u54924 \u48373 \u54624  \u49688  \u51080 \u44172  \u46104 \u50632 \u45796 . \u49324 \u46988 \u51032  \u47560 \u51020 \u51008  \u54616 \u45208 \u45784 \u51032  \u51008 \u54812 \u47196  \u49352 \u47196 \u50892 \u51256 \u50556  \u54616 \u44256  \u50948 \u47196 \u48512 \u53552  \u49352  \u49373 \u47749 \u51012  \u48155 \u50500 \u50556  \u54620 \u45796 . \u51060 \u50752 \u44057 \u51008  \u48320 \u54868 \u45716  \u49352 \u47196  \u45208 \u45716  \u44163 \u51064 \u45936 , \u50696 \u49688 \u45784 \u44760 \u49436 \u45716  \u51060  \u51068 \u51060  \u50630 \u51060 \u45716  \'93\u54616 \u45208 \u45784  \u45208 \u46972 \u47484  \u48380  \u49688  \u50630 \'94\u45796 \u44256  \u47568 \u50432 \u54616 \u49888 \u45796 .\
