\f1\b0 \cf0 \
\uc0\u51060 \u51228  \u47336 \u53552 \u45716  \u51652 \u47532 \u51032  \u53804 \u49324 \u47196 \u49436  \u51088 \u44592 \u51032  \u49324 \u50629 \u50640  \u45812 \u45824 \u55176  \u52265 \u49688 \u54616 \u50688 \u45796 . \u44536 \u45716  \u44053 \u45800 \u50640 \u49436  \u49548 \u47532  \u45458 \u50668  \u50676 \u47148 \u54616 \u44256 \u46020  \u50628 \u49689 \u54616 \u44172  \u44221 \u44256 \u54616 \u50688 \u45796 . \u44536 \u45716  \u52397 \u51473 \u50640 \u44172  \u51396 \u44032  \u50620 \u47560 \u45208  \u47924 \u49436 \u50868  \u44163 \u51076 \u51012  \u48157 \u54784  \u51452 \u45716  \u46041 \u49884 \u50640  \u49324 \u46988 \u51060  \u51088 \u47141 \u51004 \u47196  \u51396 \u50501 \u51012  \u52628 \u54840 \u46972 \u46020  \u44221 \u44048 \u49884 \u53412 \u44144 \u45208  \u51228 \u44144 \u54624  \u49688  \u50630 \u44256 , \u44536  \u54805 \u48268 \u51012  \u47732 \u54624  \u49688 \u46020  \u50630 \u45796 \u44256  \u44032 \u47476 \u52452 \u45796 . \u54616 \u45208 \u45784 \u44760  \u54924 \u44060 \u54616 \u44256  \u44536 \u47532 \u49828 \u46020 \u47484  \u48127 \u45716  \u44163  \u48150 \u50640 \u45716  \u51396 \u51064 \u51060  \u44396 \u50896 \u48155 \u51012  \u49688  \u51080 \u45716  \u44600 \u51060  \u50630 \u45796 . \u44536 \u47532 \u49828 \u46020 \u51032  \u51008 \u54812 \u45716  \u46024 \u51004 \u47196  \u49332  \u49688  \u50630 \u44256  \u45796 \u47564  \u44050 \u50630 \u51060  \u48155 \u45716  \u49440 \u47932 \u51060 \u45796 . \u44536 \u45716  \u49324 \u46988 \u46308 \u50640 \u44172  \u49324 \u51396 \u44428 \u51012  \u49324 \u51648  \u47568 \u44256  \u48127 \u51020 \u51004 \u47196  \u49901 \u51088 \u44032 \u51032  \u44396 \u51452 \u47484  \u52432 \u45796 \u48372 \u46972 \u44256  \u44428 \u47732 \u54616 \u50688 \u45796 . \u44536 \u45716  \u44396 \u50896 \u51012  \u50619 \u44592  \u50948 \u54616 \u50668  \u44404 \u50837 \u44284  \u44256 \u45212 \u51004 \u47196  \u54747 \u46104 \u51060  \u45432 \u47141 \u54620  \u51088 \u44592 \u51032  \u50416 \u46972 \u47536  \u44221 \u54744 \u51012  \u47568 \u54616 \u44256 , \u51088 \u49888 \u51012  \u48372 \u51648  \u50506 \u44256  \u44536 \u47532 \u49828 \u46020 \u47484  \u48127 \u51004 \u48064 \u47196  \u54217 \u50504 \u44284  \u44592 \u49256 \u51012  \u50619 \u50632 \u45796 \u45716  \u49324 \u49892 \u51012  \u52397 \u51473 \u46308 \u50640 \u44172  \u48372 \u51613 \u54616 \u50688 \u45796 .\
\uc0\u53580 \u52412 \u51060  \u49549 \u51396 \u48512 \u51032  \u47588 \u47588 \u50752  \u48520 \u44221 \u54620  \u50616 \u46041 \u51012  \u44228 \u49549 \u54616 \u44256  \u51080 \u50632 \u51004 \u48064 \u47196 , \u47336 \u53552 \u45716  \u44144 \u44592 \u50640  \u45824 \u54616 \u50668  \u54620 \u52789  \u45908  \u54952 \u44284 \u51201 \u51064  \u54637 \u51032  (\u25239 \u35696 ) \u47484  \u54616 \u47140 \u44256  \u44208 \u49900 \u54616 \u50688 \u45796 . \u47560 \u52840  \u44592 \u54924 \u44032  \u50772 \u45796 . \u48708 \u53584 \u48288 \u47476 \u53356  \u49457  \u44368 \u54924 \u50640 \u45716  \u50668 \u47084  \u44032 \u51648  \u50976 \u47932 \u46308 \u51060  \u48372 \u44288 \u46104 \u50612  \u51080 \u50632 \u51004 \u47728 , \u53945 \u51221 \u54620  \u52629 \u51228 \u51068 \u46308 \u50640 \u45716  \u44536 \u44163 \u46308 \u51012  \u51068 \u48152 \u50640 \u44172  \u44277 \u44060 \u54616 \u50688 \u45796 . \u44536 \u47532 \u44256  \u44536 \u45216 \u50640  \u44368 \u54924 \u50640  \u50752 \u49436  \u52280 \u54924 \u54616 \u45716  \u51088 \u45716  \u51396 \u51032  \u50857 \u49436 \u47484  \u50756 \u51204 \u55176  \u48155 \u51008  \u44163 \u51004 \u47196  \u46104 \u50612  \u51080 \u50632 \u45796 . \u44536 \u47084 \u48064 \u47196  \u44536  \u52629 \u51068 \u50640 \u45716  \u49688 \u47566 \u51008  \u49324 \u46988 \u51060  \u44536  \u44275 \u51004 \u47196  \u47784 \u50668 \u46308 \u50632 \u45796 . \u46412 \u47560 \u52840  \u44536  \u52629 \u51228 \u51068 \u46308  \u51473 \u50640 \u49436  \u44032 \u51109  \u51473 \u50836 \u54620  \u51228 \u49457 \u51228  (\u35576 \u32854 \u31085 ) \u44032  \u44032 \u44620 \u51060  \u45796 \u44032 \u50724 \u44256  \u51080 \u50632 \u45796 . \u44536  \u51204 \u45216 \u50640  \u47336 \u53552 \u45716  \u54924 \u45817 \u51004 \u47196  \u47784 \u50668 \u46300 \u45716  \u44400 \u51473 \u46308 \u44284  \u54632 \u44760  \u44032 \u49436  \u47732 \u51396 \u48512 \u51032  \u44368 \u47532 \u50640  \u54637 \u51032 \u54616 \u45716  95\u44060 \u51312 \u51032  \u45436 \u51228 \u47484  \u44592 \u47197 \u54620  \u51333 \u51060 \u47484  \u44536  \u49457 \u51204 \u51032  \u52636 \u51077 \u47928 \u50640  \u48537 \u50668  \u45459 \u50520 \u45796 . \u44536 \u47532 \u44256  \u44536 \u45716  \u44536  \u45436 \u51228 \u50640  \u45824 \u54616 \u50668  \u48152 \u45824  \u51032 \u44204 \u51012  \u44032 \u51652  \u49324 \u46988 \u46308 \u50640 \u44172 \u45716  \u51060 \u53951 \u45216  \u45824 \u54617 \u50640 \u49436  \u44144 \u44592 \u50640  \u45824 \u54620  \u45813 \u48320 \u51012  \u54616 \u44192 \u45432 \u46972 \u44256  \u48156 \u54364 \u54616 \u50688 \u45796 .\
\uc0\u44536 \u51032  \u45436 \u51228 \u45716  \u51068 \u48152 \u51032  \u51452 \u51032 \u47484  \u45132 \u50632 \u45796 . \u49324 \u46988 \u46308 \u51008  \u44536 \u44163 \u51012  \u51069 \u44256  \u46608  \u51069 \u51008  \u45796 \u51020 \u50640  \u44536 \u44163 \u51012  \u49324 \u48169 \u50640  \u51204 \u54616 \u50688 \u45796 . \u45824 \u54617  \u50504 \u50640 \u50752  \u50728  \u49457 \u50640  \u53360  \u49548 \u46041 \u51060  \u51068 \u50612 \u45228 \u45796 . \u51060  \u45436 \u51228 \u47196  \u47568 \u48120 \u50516 \u50500  \u51396 \u47484  \u49324 \u50976 \u54644  \u51452 \u44256  \u51396 \u51032  \u54805 \u48268 \u51012  \u47732 \u54616 \u44172  \u54644 \u51452 \u45716  \u44428 \u49464 \u44032  \u48277 \u50773 \u51060 \u45208  \u50612 \u46500  \u45796 \u47480  \u49324 \u46988 \u50640 \u44172 \u46020  \u50948 \u51076 \u46108  \u51201 \u51060  \u44208 \u53076  \u50630 \u50632 \u45796 \u45716  \u49324 \u49892 \u51060  \u47749 \u54869 \u54616 \u44172  \u46300 \u47084 \u45228 \u45796 . \u44536 \u47084 \u54620  \u44228 \u54925 \u51008  \u48120 \u49888 \u51201 \u51064  \u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u51012  \u51060 \u50857 \u54616 \u50668  \u44552 \u51204 \u51012  \u49324 \u52712 \u54616 \u47140 \u45716  \u49324 \u44592 \u51201  \u49696 \u52293 , \u44263  \u49324 \u45800 \u51060  \u44536  \u44144 \u51667 \u46108  \u51068 \u51012  \u51032 \u47280 \u54616 \u45716  \u47784 \u46304  \u51088 \u46308 \u51012  \u47736 \u47581 \u49884 \u53412 \u44592  \u50948 \u54616 \u50668  \u52712 \u54620  \u49688 \u45800 \u50640  \u48520 \u44284 \u54616 \u50688 \u45796 . \u44536 \u47532 \u49828 \u46020 \u51032  \u48373 \u51020 \u47564 \u51060  \u44368 \u54924  \u50504 \u50640  \u51080 \u45716  \u44032 \u51109  \u44032 \u52824  \u51080 \u45716  \u48372 \u48176 \u51060 \u47728 , \u44536  \u48373 \u51020 \u50640  \u45208 \u53440 \u45212  \u54616 \u45208 \u45784 \u51032  \u51008 \u52509 \u51008  \u48127 \u51020 \u44284  \u54924 \u44060 \u47196 \u50024  \u44536 \u44163 \u51012  \u44396 \u54616 \u45716  \u47784 \u46304  \u49324 \u46988 \u50640 \u44172  \u44050 \u50630 \u51060  \u51452 \u50612 \u51652 \u45796 \u45716  \u44163 \u51060  \u46608 \u54620  \u48516 \u47749 \u55176  \u48157 \u54784 \u51276 \u45796 .\
\uc0\u47336 \u53552 \u51032  \u45436 \u51228 \u45716  \u53664 \u47200 \u51012  \u50836 \u44396 \u54616 \u50688 \u51004 \u45208  \u50500 \u47924 \u46020  \u44144 \u44592 \u50640  \u51025 \u54616 \u45716  \u51088 \u44032  \u50630 \u50632 \u45796 . \u44536 \u44032  \u51228 \u49884 \u54620  \u47928 \u51228 \u46308 \u51008  \u49688 \u51068  \u45236 \u50640  \u50728  \u46021 \u51068 \u50640  \u54140 \u51648 \u44256 , \u47751  \u51452 \u51068  \u50504 \u50640  \u44033  \u44536 \u47532 \u49828 \u46020 \u44368 \u44397 \u46308 \u50640  \u51204 \u54028 \u46104 \u50632 \u45796 . \u44368 \u54924  \u50504 \u50640 \u49436  \u54140 \u51256 \u44032 \u44256  \u51080 \u45716  \u47924 \u49436 \u50868  \u51396 \u50501 \u51012  \u48372 \u44256  \u53444 \u49885 \u54616 \u47732 \u49436 \u46020  \u44536  \u44592 \u49464 \u47484  \u44734 \u51012  \u48169 \u48277 \u51012  \u50508 \u51648  \u47803 \u54616 \u45912  \u47566 \u51008  \u44221 \u44148 \u54620  \u47196 \u47560 \u44368 \u46020 \u46308 \u51008  \u53360  \u44592 \u49256 \u51004 \u47196  \u51060  \u45436 \u51228 \u46308 \u51012  \u51069 \u44256  \u54616 \u45208 \u45784 \u51032  \u51020 \u49457 \u51060  \u44536  \u49549 \u50640  \u51080 \u51020 \u51012  \u51064 \u51221 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u48277 \u50773 \u52397 \u50640 \u49436  \u55128 \u47084 \u45208 \u50724 \u45716  \u53440 \u46973 \u51032  \u51312 \u47448 \u47484  \u47561 \u44592  \u50948 \u54616 \u50668  \u51452 \u45784 \u44760 \u49436  \u51088 \u48708 \u54616 \u44172 \u46020  \u45817 \u49888 \u51032  \u49552 \u51012  \u54196 \u49884 \u45716  \u51460 \u47196  \u50508 \u50520 \u45796 . \u50773 \u54980  (\u29579 \u20399 ) \u46308 \u44284  \u51648 \u48169  \u51109 \u44288 \u46308 \u51008  \u54620  \u48264  \u44208 \u51221 \u54620  \u51068 \u51060 \u47732  \u50500 \u47924 \u46020  \u53444 \u50896 \u54624  \u49688  \u50630 \u45716  \u44536  \u44368 \u47564 \u54620  \u44428 \u47141 \u51012  \u52432 \u48512 \u49688 \u44172  \u46108  \u44163 \u51012  \u49549 \u51004 \u47196  \u51008 \u44540 \u55176  \u44592 \u48848 \u54616 \u50688 \u45796 .\
