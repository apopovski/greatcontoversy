0 \u51452 \u47484  \u49440 \u50616 \u54616 \u50688 \u45796 . \u51060 \u47532 \u54616 \u50668  \u45576 \u47680 \u44256  \u50756 \u44256 \u54620  \u49345 \u53468 \u50640 \u49436  \u51060 \u49828 \u46972 \u50648  \u48177 \u49457 \u46308 \u51008  \u44396 \u50896 \u51032  \u51008 \u54812 \u47196 \u50868  \u49440 \u47932 \u51012  \u47924 \u44288 \u49900 \u54616 \u44172  \u45824 \u54616 \u44256 , \u48373 \u51020 \u51032  \u52629 \u48373 \u51012  \u50684 \u46160 \u50640  \u46160 \u51648  \u50506 \u44256 , \u54616 \u45720 \u50640 \u49436  \u50724 \u45716  \u48731 \u51012  \u44144 \u51208 \u54616 \u45716  \u51068 \u51032  \u50948 \u54744 \u49457 \u50640  \u45824 \u54620  \u50628 \u49689 \u54616 \u44256  \u46160 \u47140 \u50868  \u44221 \u44256 \u46308 \u50640  \u50976 \u51032 \u54616 \u51648  \u50500 \u45768 \u54620  \u52292  1800\u45380 \u51032  \u49464 \u50900 \u51012  \u48372 \u45256 \u45796 .\
\uc0\u50896 \u51064 \u51060  \u51080 \u45716  \u44275 \u50640 \u45716  \u44208 \u44284 \u44032  \u46384 \u47480 \u45796 . \u51032 \u47924 \u50640  \u45824 \u54620  \u44033 \u49457 \u51060  \u51088 \u44592 \u51032  \u49457 \u48120 \u50640  \u47582 \u51648  \u50506 \u45716 \u45796 \u44256  \u54644 \u49436  \u51060 \u47484  \u44256 \u51032 \u51201 \u51004 \u47196  \u51667 \u48159 \u50500  \u48260 \u47532 \u47732 , \u47560 \u52840 \u45236  \u51652 \u47532 \u50752  \u50724 \u47448 \u47484  \u48516 \u48324 \u54616 \u45716  \u45733 \u47141 \u51012  \u51075 \u50612 \u48260 \u47532 \u44172  \u46112  \u44163 \u51060 \u45796 . \u51060 \u54644 \u47141 \u51008  \u46164 \u54616 \u50668 \u51648 \u44256 , \u50577 \u49900 \u51008  \u47924 \u44048 \u44033 \u54616 \u50668 \u51648 \u44256 , \u47560 \u51020 \u51008  \u44403 \u50612 \u51648 \u44256 , \u49900 \u47161 \u51008  \u54616 \u45208 \u45784 \u44760 \u47196 \u48512 \u53552  \u46496 \u45208 \u44172  \u46108 \u45796 . \u44144 \u47337 \u54620  \u51652 \u47532 \u51032  \u44592 \u48324 \u51060  \u48176 \u52377 \u46104 \u44256  \u47736 \u49884 \u48155 \u45716  \u44275 \u50640 \u45716  \u44368 \u54924 \u44032  \u55121 \u50516 \u50640  \u49912 \u51060 \u44172  \u46104 \u44256 , \u48127 \u51020 \u44284  \u49324 \u46993 \u51060  \u49885 \u50612 \u51648 \u44256 , \u48516 \u47532 \u50752  \u48520 \u54868 \u44032  \u46308 \u50612 \u50724 \u44172  \u46108 \u45796 . \u44368 \u51064 \u46308 \u51008  \u44536 \u46308 \u51032  \u44288 \u49900 \u44284  \u51221 \u47141 \u51012  \u49464 \u49549 \u51201 \u51064  \u47785 \u51201 \u50640  \u50143 \u44172  \u46104 \u44256 , \u51396 \u51064 \u46308 \u51008  \u45908 \u50865  \u50756 \u50501 \u54616 \u50668 \u51652 \u45796 .\
\uc0\u54616 \u45208 \u45784 \u51032  \u49900 \u54032 \u51032  \u46412 \u47484  \u50508 \u47140  \u51452 \u44256 , \u54616 \u45208 \u45784 \u51012  \u46160 \u47140 \u50892 \u54616 \u44256  \u44221 \u48176 \u54616 \u46972 \u45716  \u50836 \u54620 \u44228 \u49884 \u47197  14\u51109 \u51032  \u52395 \u51704  \u52380 \u49324 \u51032  \u44592 \u48324 \u51008  \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u51060 \u46972 \u44256  \u44277 \u50616 \u54616 \u45716  \u49324 \u46988 \u46308 \u47196  \u54616 \u50668 \u44552  \u49464 \u49345 \u51032  \u48512 \u54056 \u54620  \u44048 \u54868 \u50640 \u49436  \u46496 \u45208 \u44172  \u54616 \u44256 , \u49464 \u49549 \u54868 \u46104 \u44256  \u53440 \u46973 \u54620  \u44536 \u46308 \u51032  \u52280  \u49345 \u53468 \u47484  \u48372 \u46020 \u47197  \u44536 \u46308 \u51012  \u51068 \u44648 \u50892 \u51452 \u44592  \u50948 \u54616 \u50668  \u51452 \u50612 \u51652  \u44592 \u48324 \u51060 \u50632 \u45796 . \u51060  \u44592 \u48324 \u51012  \u53685 \u54616 \u50668  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u44368 \u54924 \u50640  \u54620  \u44221 \u44256 \u47484  \u51452 \u49512 \u45716 \u45936 , \u44536 \u46308 \u51060  \u44536 \u44163 \u51012  \u48155 \u50500 \u46308 \u51068  \u46412  \u44536 \u46308 \u51012  \u54616 \u45208 \u45784 \u50640 \u44172 \u49436  \u46496 \u45208 \u44172  \u54616 \u50688 \u45912  \u44536  \u50501 \u51012  \u44368 \u51221 \u54624  \u49688  \u51080 \u44172  \u54620  \u44163 \u51060 \u45796 . \u47564 \u51068  \u44536 \u46308 \u51060  \u54616 \u45720 \u47196 \u48512 \u53552  \u50728  \u44536  \u44592 \u48324 \u51012  \u48155 \u50500 \u46308 \u51060 \u44256  \u54616 \u45208 \u45784  \u50526 \u50640 \u49436  \u44536 \u46308 \u51032  \u47560 \u51020 \u51012  \u44216 \u48708 \u54616 \u44172  \u54616 \u44256  \u51652 \u51221 \u51004 \u47196  \u54616 \u45208 \u45784  \u50526 \u50640  \u49444  \u49688  \u51080 \u46020 \u47197  \u51456 \u48708 \u54616 \u50688 \u51012  \u44163  \u44057 \u51004 \u47732 , \u54616 \u45208 \u45784 \u51032  \u49457 \u47161 \u44284  \u44428 \u45733 \u51060  \u48152 \u46300 \u49884  \u44536 \u46308  \u50948 \u50640  \u45208 \u53440 \u45228 \u51012  \u44163 \u51060 \u45796 . \u44536 \u47532 \u54616 \u50688 \u51012  \u44163  \u44057 \u51004 \u47732  \u44368 \u54924 \u45716  \u49324 \u46020  \u49884 \u45824 \u51032  \u49888 \u51088 \u46308 \u51060  \'93\u54620  \u47560 \u51020 \u44284  \u54620  \u46907 \u51060  \u46104 \u50612 \'94 \'93\u45812 \u45824 \u55176  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51012  \u51204 \'94\u54624  \u46412  \'93\u51452 \u44760 \u49436  \u44396 \u50896 \u48155 \u45716  \u49324 \u46988 \u51012  \u45216 \u47560 \u45796  \u45908 \u54616 \u44172 \'94 \u54616 \u49512 \u45912  \u45817 \u49884 \u51032  \u50672 \u54633 \u44284  \u48127 \u51020 \u44284  \u49324 \u46993 \u51032  \u48373 \u46108  \u49345 \u53468 \u50640  \u45796 \u49884  \u54620  \u48264  \u46020 \u45804 \u54616 \u50688 \u51012  \u44163 \u51060 \u45796  (\u54665  4:32, 31, 2:47).\
\uc0\u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u51060 \u46972 \u44256  \u44277 \u50616 \u54616 \u45716  \u49324 \u46988 \u46308 \u51060  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u50640 \u49436  \u44536 \u46308 \u50640 \u44172  \u48708 \u52824 \u45716  \u44536  \u48731 \u51012  \u44536 \u45824 \u47196  \u48155 \u50500 \u46308 \u50688 \u51012  \u44163  \u44057 \u51004 \u47732  \u44536 \u46308 \u51008  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u44592 \u46020 \u54616 \u49512 \u44256  \u49324 \u46020 \u44032  \u44592 \u47197 \u54620  \u44536 \u45824 \u47196  \'93\u54217 \u50504 \u51032  \u47588 \u45716  \u51460 \u47196  \u49457 \u47161 \u51032  \u54616 \u45208  \u46104 \u44172  \u54616 \u49888 \'94 \u44536  \u50672 \u54633 \u51012  \u51060 \u47336 \u50632 \u51012  \u44163 \u51060 \u45796 . \u44536 \u45716  \u45796 \u49884  \'93\u47800 \u51060  \u54616 \u45208 \u51060 \u50836  \u49457 \u47161 \u51060  \u54616 \u45208 \u51060 \u45768  \u51060 \u50752  \u44057 \u51060  \u45320 \u55148 \u44032  \u48512 \u47476 \u49900 \u51032  \u54620  \u49548 \u47581  \u50504 \u50640 \u49436  \u48512 \u47476 \u49900 \u51012  \u51077 \u50632 \u45712 \u45768 \u46972  \u51452 \u46020  \u54616 \u45208 \u51060 \u50836  \u48127 \u51020 \u46020  \u54616 \u45208 \u51060 \u50836  \u52840 \u47168 \u46020  \u54616 \u45208 \u51060 \u50836 \'94 (\u50657  4:3~5) \u46972 \u44256  \u47568 \u54616 \u50688 \u45796 .\
\uc0\u51116 \u47548 \u44592 \u48324 \u51012  \u48155 \u50500 \u46308 \u51064  \u49324 \u46988 \u46308 \u51008  \u51060 \u47084 \u54620  \u48373 \u49828 \u47084 \u50868  \u44208 \u44284 \u47484  \u52404 \u54744 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u44033 \u44033  \u45796 \u47480  \u44368 \u54028 \u50640 \u49436  \u45208 \u50772 \u51004 \u45208  \u44536 \u46308 \u51032  \u44368 \u54028 \u51201  \u51109 \u48317 \u51008  \u47924 \u45320 \u51648 \u44256 , \u47784 \u49692 \u46104 \u45716  \u49888 \u51312 \u46308 \u51008  \u49328 \u49328 \u51060  \u48512 \u49436 \u51276 \u45796 . \u48373 \u52380 \u45380 \u51060  \u49464 \u49345 \u50640  \u50728 \u45796 \u45716  \u48708 \u49457 \u49436 \u51201 \u51064  \u49548 \u47581 \u51008  \u49324 \u46972 \u51276 \u44256 , \u51116 \u47548 \u50640  \u45824 \u54620  \u44536 \u47495 \u46108  \u44204 \u54644 \u45716  \u44368 \u51221 \u46104 \u50632 \u45796 . \u49464 \u49549 \u51012  \u46384 \u47476 \u45716  \u47560 \u51020 \u44284  \u44368 \u47564 \u54620  \u47560 \u51020 \u51008  \u50630 \u50612 \u51648 \u44256 , \u47784 \u46304  \u51096 \u47803 \u51008  \u48148 \u47476 \u44172  \u44256 \u52432 \u51648 \u44256 , \u44033  \u49324 \u46988 \u51032  \u47560 \u51020 \u51008  \u46384 \u46907 \u54620  \u50864 \u51221 \u51004 \u47196  \u50672 \u54633 \u46104 \u44256 , \u49324 \u46993 \u44284  \u44592 \u49256 \u51060  \u44536 \u46308 \u51012  \u51648 \u48176 \u54616 \u50688 \u45796 . \u44536  \u44368 \u47532 \u47484  \u48155 \u50500 \u46308 \u51064  \u49548 \u49688 \u51032  \u49324 \u46988 \u46308 \u50640 \u44172  \u44536 \u50752  \u44057 \u51008  \u44208 \u44284 \u44032  \u49373 \u44220 \u45796 \u45716  \u49324 \u49892 \u51008  \u47564 \u51068  \u47784 \u46304  \u49324 \u46988 \u51060  \u44536  \u44368 \u47532 \u47484  \u48155 \u50500 \u46308 \u50688 \u51012  \u44163  \u44057 \u51004 \u47732  \u44536  \u47784 \u46304  \u49324 \u46988 \u50640 \u44172  \u44057 \u51008  \u44208 \u44284 \u44032  \u49373 \u44220 \u51012  \u44163 \u51060 