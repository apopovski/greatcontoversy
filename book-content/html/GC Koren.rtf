\uc0\u44536 \u47088 \u45936  \u44049 \u51088 \u44592  \u44536 \u51032  \u54876 \u46041 \u51008  \u51473 \u45800 \u46104 \u50632 \u45796 . \u50500 \u51649  60\u49464 \u46020  \u50504  \u46104 \u50632 \u51648 \u47564  \u45130 \u51076 \u50630 \u45716  \u49688 \u44256 \u50752  \u50672 \u44396 \u50752  \u50896 \u49688 \u46308 \u51032  \u44277 \u44201 \u51060  \u44536 \u51032  \u44592 \u47141 \u50640  \u50689 \u54693 \u51012  \u48120 \u52452 \u44592  \u46412 \u47928 \u50640  \u44536 \u45716  \u49888 \u49549 \u55176  \u45432 \u49632 \u54616 \u44172  \u46104 \u50632 \u45796 . \u44536 \u45716  \u50948 \u54744 \u54620  \u48337 \u50640  \u44152 \u47160 \u45796 . \u51060  \u49548 \u49885 \u51008  \u53441 \u48156 \u49849 \u46308 \u50640 \u44172  \u53360  \u44592 \u49256 \u51060  \u46104 \u50632 \u45796 . \u44536 \u46308 \u51008  \u51060 \u51228 \u50556  \u44536 \u44032  \u44368 \u54924 \u50640  \u45824 \u54616 \u50668  \u48276 \u54620  \u50501 \u54665 \u51012  \u44618 \u51060  \u45656 \u50864 \u52832  \u44163 \u51060 \u46972 \u44256  \u49373 \u44033 \u54616 \u44256 , \u44536 \u51032  \u51088 \u48373 \u51012  \u46307 \u44592  \u50948 \u54616 \u50668  \u44536 \u44032  \u44144 \u52376 \u54616 \u44256  \u51080 \u45716  \u44275 \u51004 \u47196  \u45804 \u47140 \u44052 \u45796 . \u45348  \u51333 \u44368  \u45800 \u52404 \u50640 \u49436  \u50728  \u45824 \u54364 \u51088 \u46308 \u44284  \u45348  \u49324 \u46988 \u51032  \u51221 \u48512 \u51032  \u44288 \u47532 \u46308 \u51060  \u51076 \u51333 \u51060  \u44032 \u44620 \u50868  \u44163 \u51004 \u47196  \u49373 \u44033 \u46104 \u45716  \u44536 \u51032  \u51452 \u50948 \u50640  \u47784 \u50668  \u51080 \u50632 \u45796 . \'93\u44536 \u45824 \u51032  \u51453 \u51020 \u51060  \u51076 \u48149 \u54616 \u50688 \u51004 \u45768  \u51060 \u51228  \u44284 \u44144 \u51032  \u47784 \u46304  \u51396 \u44284 \u47484  \u45656 \u50864 \u52824 \u44256  \u51068 \u52237 \u51060  \u50864 \u47532 \u50640 \u44172  \u49552 \u54644 \u47484  \u51452 \u44592  \u50948 \u54616 \u50668  \u47568 \u54620  \u47784 \u46304  \u44163 \u51012  \u50864 \u47532  \u50526 \u50640 \u49436  \u52712 \u49548 \u54616 \u46972 \'94\u44256  \u44536 \u46308 \u51008  \u47568 \u54616 \u50688 \u45796 . \u44536  \u44060 \u54785 \u51088 \u45716  \u51312 \u50857 \u55176  \u46307 \u44256  \u51080 \u45796 \u44032  \u49884 \u51473 \u46300 \u45716  \u49324 \u46988 \u51032  \u46020 \u50880 \u51012  \u48155 \u50500  \u52840 \u49345 \u50640 \u49436  \u51068 \u50612 \u45208 , \u49888 \u50521 \u51032  \u52712 \u49548 \u47484  \u46308 \u51004 \u47140 \u44256  \u44592 \u45796 \u47532 \u44256  \u51080 \u45716  \u44536 \u46308 \u51012  \u46609 \u48148 \u47196  \u52432 \u45796 \u48372 \u50520 \u45796 . \u44536 \u47532 \u44256  \u44536 \u45716  \u44536 \u46308 \u51012  \u44536 \u52376 \u47100  \u51088 \u51452  \u46504 \u44172  \u54644 \u51452 \u50632 \u45912  \u48516 \u47749 \u54616 \u44256  \u53360  \u51020 \u49457 \u51004 \u47196  \u45796 \u51020 \u44284  \u44057 \u51060  \u50808 \u52452 \u45796 . \'93\u45208 \u45716  \u51453 \u51648  \u50506 \u44256  \u49332 \u50500 \u45216  \u44163 \u51060 \u45796 . \u44536 \u47532 \u54616 \u50668  \u45796 \u49884  \u45320 \u55148  \u53441 \u48156 \u49849 \u46308 \u51032  \u50501 \u54665 \u51012  \u44277 \u44060 \u54624  \u44163 \u51060 \u45796 \'94 (D\'92Aubigne, b.17, ch.7). \u52380 \u47564  \u46907 \u48150 \u50640  \u51656 \u52293 \u51012  \u48155 \u51008  \u49849 \u47140 \u46308 \u51008  \u44536 \u47564  \u45440 \u46972 \u44256  \u48512 \u45124 \u47084 \u50892 \u49436  \u44536  \u51088 \u47532 \u50640 \u49436  \u44553 \u55176  \u45208 \u44032  \u48260 \u47160 \u45796 .\
\uc0\u50948 \u53364 \u47532 \u54532 \u51032  \u47568 \u51008  \u49457 \u52712 \u46104 \u50632 \u45796 . \u44536 \u45716  \u47196 \u47560 \u47484  \u45824 \u54637 \u54616 \u45716  \u47784 \u46304  \u47924 \u44592  \u51473 \u51032  \u44032 \u51109  \u44053 \u47141 \u54620  \u47924 \u44592 , \u44263  \u49324 \u46988 \u46308 \u50640 \u44172  \u51088 \u50976 \u47484  \u51452 \u44256 , \u44536 \u46308 \u51012  \u44228 \u47805 \u49884 \u53412 \u44256  \u44368 \u54868 \u49884 \u53412 \u44592  \u50948 \u54616 \u50668  \u54616 \u45208 \u45784 \u44760 \u49436  \u51648 \u51221 \u54616 \u49888  \u49457 \u44221 \u51012  \u51088 \u44592  \u46041 \u54252 \u46308 \u51032  \u49552 \u50640  \u51536 \u50612  \u51452 \u44592 \u44620 \u51648  \u49373 \u47749 \u51060  \u50672 \u51109 \u46104 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u51060  \u49324 \u50629 \u51032  \u50756 \u49457 \u51012  \u48372 \u44592 \u44620 \u51648  \u50668 \u47084  \u44032 \u51648  \u53360  \u51109 \u50528 \u47484  \u44202 \u50632 \u45796 . \u50948 \u53364 \u47532 \u54532 \u45716  \u44148 \u44053 \u51060  \u45824 \u45800 \u55176  \u51339 \u51648  \u47803 \u54616 \u48064 \u47196  \u51088 \u44592 \u44032  \u51068 \u54624  \u49688  \u51080 \u45716  \u49884 \u44036 \u51060  \u48520 \u44284  \u47751  \u45380 \u48150 \u50640  \u45224 \u51648  \u50506 \u51008  \u44163 \u51012  \u50508 \u50520 \u51004 \u47728 , \u46608 \u54620  \u48152 \u46300 \u49884  \u48152 \u45824 \u47484  \u47564 \u45208 \u44172  \u46112  \u44163 \u51012  \u45236 \u45796 \u48372 \u50520 \u45796 . \u44536 \u47084 \u45208  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432  \u44032 \u50868 \u45936  \u51080 \u45716  \u54728 \u46973 \u51004 \u47196  \u55192 \u51012  \u50619 \u50612 \u49436  \u44536 \u45716  \u44208 \u53076  \u44404 \u54616 \u51648  \u50506 \u44256  \u50526 \u51004 \u47196  \u45208 \u50500 \u44052 \u45796 . \u44536 \u45716  \u51648 \u44552 \u44751  \u50773 \u49457 \u54620  \u51648 \u47141  (\u26234 \u21147 ) \u44284  \u54413 \u48512 \u54620  \u52404 \u54744  \u49549 \u50640 \u49436  \u44536 \u51032  \u49324 \u50629  \u51473 \u51032  \u44032 \u51109  \u50948 \u45824 \u54620  \u49324 \u50629 \u51012  \u50948 \u54616 \u50668  \u54616 \u45208 \u45784 \u51032  \u53945 \u48324 \u54620  \u49453 \u47532 \u50640  \u51032 \u54616 \u50668  \u48372 \u54840 \u47484  \u48155 \u44256  \u51456 \u48708 \u54616 \u50668  \u50772 \u45796 . \u47784 \u46304  \u44536 \u47532 \u49828 \u46020 \u44368 \u44397 \u51060  \u50728 \u53685  \u54844 \u46976  \u51473 \u50640  \u48736 \u51256  \u51080 \u45716  \u44536  \u46412 \u50640 , \u51060  \u44060 \u54785 \u51088 \u45716  \u47336 \u53552 \u50892 \u46300 \u51032  \u47785 \u49324 \u44288  (\u29287 \u24107 \u39208 ) \u50640 \u49436  \u50808 \u48512 \u51032  \u54253 \u54413 \u44284 \u45716  \u49345 \u44288 \u50630 \u51060  \u51088 \u44592 \u50640 \u44172  \u51452 \u50612 \u51652  \u44536  \u49324 \u50629 \u50640  \u47792 \u46160 \u54616 \u50688 \u45796 .\
\uc0\u46300 \u46356 \u50612  \u49324 \u50629 \u51060  \u50756 \u49457 \u46104 \u50612  \u52572 \u52488 \u51032  \u50689 \u50612  \u49457 \u44221 \u51060  \u45208 \u50724 \u44172  \u46104 \u50632 \u45796 . \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51008  \u50689 \u44397 \u50640  \u44277 \u44060 \u46104 \u50632 \u45796 . \u44060 \u54785 \u51088 \u45716  \u51060 \u51228  \u44048 \u50725 \u51060 \u46304 \u51648  \u54868 \u54805 \u51452 \u46304 \u51648  \u46160 \u47140 \u50892 \u54624  \u44163 \u51060  \u50630 \u50632 \u45796 . \u44536 \u45716  \u44208 \u53076  \u44732 \u51656  \u49688  \u50630 \u45716  \u48731 \u51012  \u50689 \u44397  \u44397 \u48124 \u51032  \u49552 \u50640  \u51536 \u50612  \u51452 \u50632 \u45796 . \u44536 \u45716  \u51088 \u44592 \u51032  \u46041 \u54252 \u46308 \u50640 \u44172  \u49457 \u44221 \u51012  \u51468 \u51004 \u47196  \u47924 \u51648 \u50752  \u51396 \u50501 \u51032  \u49324 \u49836 \u51012  \u45130 \u50612  \u48260 \u47532 \u45716  \u44163  \u51060 \u49345 \u51032  \u44163 , \u51088 \u44592 \u51032  \u45208 \u46972 \u47484  \u54644 \u48169 \u49884 \u53412 \u44256  \u54693 \u49345 \u54616 \u46020 \u47197  \u51060 \u45132 \u44592  \u50948 \u54616 \u50668  \u51204 \u51137 \u53552 \u50640 \u49436  \u48731 \u45208 \u45716  \u49849 \u47532 \u47484  \u50619 \u51008  \u44163 \u48372 \u45796  \u45908 \u50865  \u50948 \u45824 \u54620  \u51068 \u51012  \u49457 \u52712 \u54616 \u50688 \u45796 .\
\uc0\u44536 \u47084 \u45208  \u45817 \u49884 \u45716  \u50500 \u51649 \u46020  \u51064 \u49604 \u44592 \u44032  \u48156 \u47749 \u46104 \u51648  \u50500 \u45768 \u54616 \u50688 \u51004 \u48064 \u47196  \u49457 \u44221 \u51032  \u48512 \u49688 \u47484  \u51613 \u44032 \u49884 \u53412 \u47140 \u47732  \u45908 \u46356 \u44256 \u46020  \u48264 \u44144 \u47196 \u50868  \u49688 \u44256 \u47484  \u54624  \u49688 \u48150 \u50640  \u50630 \u50632 \u45796 . \u49457 \u44221 \u51012  \u44032 \u51648 \u44256  \u49910 \u51008  \u50837 \u47581 \u51060  \u45320 \u47924 \u45208  \u47566 \u50520 \u51004 \u48064 \u47196  \u47566 \u51008  \u49324 \u46988 \u46308 \u51060  \u49457 \u44221 \u51012  \u48373 \u49324 \u54616 \u45716  \u51068 \u51012  \u51088 \u50896 \u54616 \u50668  \u45812 \u45817 \u54616 \u44256 \u51088  \u54664 \u45796 . \u44536 \u47084 \u45208  \u50836 \u44396 \u46104 \u45716  \u47564 \u53372 \u51032  \u48512 \u49688 \u47484  \u44277 \u44553 \u54616 \u44592 \u45716  \u50612 \u47140 \u50912 \u45796 . \u44536  \u51473 \u50640  \u46024 \u51060  \u47566 \u51008  \u48512 \u51088 \u46308 \u51008  \u49457 \u44221 \u51204 \u49436 \u47484  \u49324 \u44256 \u51088  \u50837 \u47581 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u50612 \u46500  \u49324 \u46988 \u46308 \u51008  \u51068 \u48512 \u48516 \u47564 \u51012  \u49344 \u45796 . \u47566 \u51008  \u44221 \u50864 \u50640 , \u50668 \u47084  \u44032 \u51221 \u46308 \u51060  \u54633 \u54616 \u50668  \u49457 \u44221 \u51012  \u49344 \u45796 . \u44536 \u47532 \u54616 \u50668  \u50948 \u53364 \u47532 \u54532 \u51032  \u49457 \u44221 \u51008  \u47566 \u51008  \u49324 \u46988 \u46308 \u51032  \u44032 \u51221 \u51004 \u47196  \u46308 \u50612 \u44032 \u44172  \u46104 \u50632 \u45796 .\
\uc0\u51060 \u50752  \u44057 \u51060  \u49324 \u46988 \u51032  \u51060 \u49457  (\u63972 \u24615 ) \u50640  \u54840 \u49548 \u54620  \u44208 \u44284 , \u49324 \u46988 \u46308 \u51008  \u48277 \u50773 \u44368 \u51032  \u44368 \u47532 \u50640  \u47609 \u51333 \u54616 \u45912  \u49345 \u53468 \u50640 \u49436  \u44033 \u49457 \u54616 \u50688 \u45796 . \u50948 \u53364 \u47532 \u54532 \u45716  \u51060 \u51228  \u44060 \u49888 \u44368 \u51032  \u47749 \u54869 \u54620  \u44368 \u47532 , \u44263  \u44536 \u47532 \u49828 \u46020 \u47484  \u48127 \u51020 \u51004 \u47196  \u47568 \u48120 \u50516 \u45716  \u44396 \u50896 \u44284  \u49457 \u44221 \u51032  \u51208 \u45824 \u51201 \u51064  \u54869 \u49892 \u49457 \u50640  \u45824 \u54616 \u50668  \u44032 \u47476 \u52452 \u45796 . \u49457 \u44221 \u51012  \u51204 \u54616 \u44592  \u50948 \u54616 \u50668  \u48372 \u45252 \u51012  \u48155 \u51008  \u51204 \u46020 \u51088 \u46308 \u51008  \u51060  \u44060 \u54785 \u51088 \u51032  \u51200 \u49436 \u46020  \u51204 \u54616 \u50688 \u45716 \u45936 , \u44536 \u47196  \u51064 \u54616 \u50668  \u50689 \u44397  \u44397 \u48124 \u51032  \u50557  \u51208 \u48152 \u51060  \u51060  \u49352  \u49888 \u51312 \u47484  \u48155 \u50500 \u46308 \u51060 \u44172  \u46104 \u47532 \u47564 \u53372  \u53360  \u49457 \u44277 \u51012  \u44144 \u46160 \u50632 \u45796 .\
