\uc0\u49464 \u49345 \u51060  \u44536 \u47532 \u49828 \u46020 \u47484  \u44144 \u51208 \u54616 \u46020 \u47197  \u49440 \u46041 \u54620  \u44163 \u51008  \u49324 \u45800 \u51060 \u50632 \u45796 . \u50501 \u51032  \u51076 \u44552 \u51008  \u44536 \u51032  \u50728  \u55192 \u44284  \u44036 \u44228 \u47484  \u45796 \u54616 \u50668  \u50696 \u49688 \u45784 \u51012  \u47736 \u54616 \u47140  \u54616 \u50688 \u45796 . \u50780 \u45264 \u54616 \u47732  \u44536 \u45716  \u44396 \u51452 \u51032  \u51008 \u54812 \u50752  \u49324 \u46993 \u44284  \u46041 \u51221 \u44284  \u51088 \u48708 \u44032  \u54616 \u45208 \u45784 \u51032  \u54408 \u49457 \u51012  \u51060  \u49464 \u49345 \u50640  \u45208 \u53440 \u45236 \u44256  \u51080 \u51020 \u51012  \u51096  \u50508 \u50520 \u44592  \u46412 \u47928 \u51060 \u50632 \u45796 . \u49324 \u45800 \u51008  \u54616 \u45208 \u45784 \u51032  \u50500 \u46308 \u51060  \u51452 \u51109 \u54616 \u45716  \u47784 \u46304  \u51216 \u51012  \u45824 \u51201 \u54616 \u44256  \u49324 \u46988 \u46308 \u51012  \u49440 \u46041 \u54616 \u50668  \u44396 \u51452 \u51032  \u49373 \u50528 \u44032  \u44256 \u53685 \u44284  \u49836 \u54548 \u51004 \u47196  \u52649 \u47564 \u54644 \u51648 \u44172  \u54616 \u50688 \u45796 . \u50696 \u49688 \u45784 \u51032  \u54876 \u46041 \u51012  \u48169 \u54644 \u54616 \u44592  \u50948 \u54616 \u50668  \u49324 \u45800 \u51060  \u49324 \u50857 \u54620  \u44452 \u48320 \u44284  \u54728 \u50948 , \u48520 \u49692 \u51333 \u51032  \u51088 \u45376 \u46308 \u51012  \u53685 \u54616 \u50668  \u45208 \u53440 \u45240  \u51613 \u50724 , \u48708 \u44368 \u54624  \u48148  \u50630 \u51060  \u49440 \u54620  \u49373 \u50528 \u47484  \u49324 \u49888  \u54616 \u45208 \u45784 \u51032  \u50500 \u46308 \u50640  \u45824 \u54620  \u49324 \u45800 \u51032  \u51092 \u51064 \u54620  \u48708 \u45212 , \u51060  \u47784 \u46304  \u44163 \u51008  \u45796  \u44053 \u54620  \u48373 \u49688 \u49900 \u50640 \u49436  \u45208 \u50728  \u44163 \u46308 \u51060 \u50632 \u4579