\uc0\u49352  \u54889 \u51228  \u52852 \u50508  5\u49464 \u44032  \u46021 \u51068  \u54889 \u51228 \u47196  \u46321 \u44537 \u54616 \u44172  \u46104 \u51088 , \u47196 \u47560 \u51032  \u49324 \u51088 \u46308 \u51008  \u49888 \u49549 \u55176  \u52629 \u54616 \u51032  \u46907 \u51012  \u54364 \u54616 \u44256  \u44536  \u54889 \u51228 \u50640 \u44172  \u44428 \u47141 \u51004 \u47196  \u44060 \u54785  \u49324 \u50629 \u51012  \u48152 \u45824 \u54644  \u45804 \u46972 \u44256  \u44428 \u54616 \u50688 \u45796 . \u54620 \u54200 \u51004 \u47196 , \u52852 \u50508 \u51060  \u50773 \u44288 \u51012  \u50619 \u45716  \u51068 \u50640  \u53356 \u44172  \u44277 \u54732 \u51012  \u54620  \u51089 \u49468 \u51032  \u49440 \u54980  (\u36984 \u20399 ) \u45716  \u47336 \u53552 \u50640 \u44172  \u51060 \u50556 \u44592 \u54624  \u49688  \u51080 \u45716  \u44592 \u54924 \u47484  \u51452 \u44592  \u51204 \u50640 \u45716  \u50612 \u46496 \u54620  \u51312 \u52824 \u46020  \u52712 \u54616 \u51648  \u47568 \u44592 \u47484  \u52852 \u50508 \u50640 \u44172  \u44036 \u52397 \u54616 \u50688 \u45796 . \u44536 \u47084 \u48064 \u47196  \u54889 \u51228 \u45716  \u47588 \u50864  \u45212 \u52376 \u54616 \u44256  \u44260 \u46976 \u54620  \u52376 \u51648 \u50640  \u45459 \u51060 \u44172  \u46104 \u50632 \u45796 . \u48277 \u50773 \u45817 \u46308 \u51008  \u47336 \u53552 \u50640 \u44172  \u49324 \u54805 \u51012  \u50616 \u46020 \u54616 \u45716  \u52825 \u47161 \u51004 \u47196 \u47564  \u47564 \u51313 \u54624  \u44163 \u51060 \u50632 \u45796 . \u44536 \u47084 \u45208  \u49440 \u54980 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u45800 \u54840 \u54616 \u44172  \u51452 \u51109 \u54616 \u50688 \u45796 . \'93\u54889 \u51228 \u45208  \u44536  \u48150 \u51032  \u50612 \u46500  \u49324 \u46988 \u46020  \u47336 \u53552 \u51032  \u51200 \u49436 \u46308 \u51060  \u48152 \u48149 \u51012  \u45817 \u54616 \u50688 \u45796 \u45716  \u44163 \u51012  \u48372 \u50668 \u51452 \u51648  \u47803 \u54616 \u50688 \u45796 . \u44536 \u47084 \u48064 \u47196  \u47336 \u53552  \u48149 \u49324 \u50640 \u44172  \u53685 \u54665 \u44428 \u51012  \u51452 \u50612  \u54617 \u49885  \u51080 \u44256 , \u44221 \u44148 \u54616 \u44256 , \u44277 \u51221 \u54620  \u51116 \u54032 \u44288  \u50526 \u50640  \u44032 \u49436  \u51116 \u54032 \u51012  \u48155 \u44172  \u54616 \u45716  \u44163 \u51060  \u47560 \u46405 \u54620  \u51068 \u51060 \u45796 \'94 (D\'92Aubigne, b.6, ch.11).\
\uc0\u51060 \u51228  \u47784 \u46304  \u45817 \u54028 \u51032  \u51452 \u47785 \u51008  \u52852 \u50508 \u51060  \u54889 \u51228 \u47196  \u51593 \u50948 \u54620  \u51648  \u50620 \u47560  \u54980 \u50640  \u48372 \u47492 \u49828  (Worms) \u50640 \u49436  \u50676 \u47536  \u46021 \u51068 \u51032  \u51032 \u54924 \u47196  \u50144 \u47532 \u44172  \u46104 \u50632 \u45796 . \u46021 \u51068 \u51032  \u50689 \u51452 \u46308 \u51060  \u51210 \u51008  \u54889 \u51228 \u50752  \u52376 \u51020 \u51004 \u47196  \u49900 \u51032 \u54924 \u50640 \u49436  \u47564 \u45208 \u44172  \u46104 \u50632 \u51004 \u48064 \u47196  \u51060  \u44397 \u54924 \u50640 \u45716  \u53664 \u51032 \u54644 \u50556  \u54624  \u51473 \u50836 \u54620  \u51221 \u52824 \u51201 \u51064  \u47928 \u51228 \u46308 \u44284  \u50504 \u44148 \u46308 \u51060  \u51080 \u50632 \u45796 . \u44397 \u45236 \u51032  \u44033  \u51648 \u48169 \u50640 \u49436  \u44368 \u54924 \u50752  \u44397 \u44032 \u51032  \u44256 \u44288 \u46308 \u51060  \u47784 \u50668 \u46308 \u50632 \u45796 . \u44480 \u51313  \u52636 \u49888 \u51004 \u47196  \u49464 \u47141  \u51080 \u44256  \u49464 \u49845 \u51201  \u44428 \u47532 \u47484  \u51088 \u46993 \u54616 \u45716  \u50689 \u51452 \u46308 , \u44228 \u44553 \u44284  \u44428 \u47141 \u51032  \u50864 \u50900 \u44048 \u50640  \u46020 \u52712 \u46108  \u49457 \u51649 \u51088 \u46308 , \u44592 \u54408  \u51080 \u45716  \u44592 \u49324  (\u39438 \u22763 ) \u46308 \u44284  \u47924 \u51109 \u51012  \u54620  \u44536  \u48512 \u54616 \u46308 , \u45231 \u49440  \u47676  \u45208 \u46972 \u46308 \u47196 \u48512 \u53552  \u54028 \u44204 \u46108  \u45824 \u49324 \u46308 , \u44536  \u47784 \u46304  \u49324 \u46988 \u46308 \u51060  \u48372 \u47492 \u49828 \u47196  \u47784 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u52376 \u47100  \u47566 \u51008  \u49324 \u46988 \u51060  \u47784 \u51064  \u51473 \u50640 \u49436  \u44032 \u51109  \u53360  \u55141 \u48120 \u47484  \u51068 \u51004 \u53416  \u44163 \u51008  \u51089 \u49468 \u51032  \u44060 \u54785 \u51088 \u50640  \u44288 \u54620  \u49324 \u44148 \u51060 \u50632 \u45796 .\
\uc0\u52852 \u50508 \u51008  \u51060 \u48120  \u49440 \u54980 \u50640 \u44172  \u47336 \u53552 \u47484  \u45936 \u47532 \u44256  \u51032 \u54924 \u50640  \u50732  \u44163 \u51012  \u51648 \u49884 \u54616 \u44256 , \u44536 \u51032  \u48372 \u54840 \u47484  \u48372 \u51613 \u54616 \u44256 , \u45436 \u51032 \u54624  \u47928 \u51228 \u50640  \u44288 \u54616 \u50668  \u51088 \u44201 \u51012  \u44054 \u52632  \u49324 \u46988 \u46308 \u44284  \u51088 \u50976 \u47196 \u50868  \u53664 \u47200 \u51012  \u54728 \u46973 \u54616 \u44192 \u45796 \u44256  \u50557 \u49549 \u54616 \u50688 \u45796 . \u47336 \u53552 \u45716  \u54889 \u51228  \u50526 \u50640  \u45208 \u44032 \u44592 \u47484  \u50676 \u47581 \u54616 \u50688 \u45796 . \u44536 \u45716  \u45817 \u49884 \u50640  \u44148 \u44053 \u51060  \u47588 \u50864  \u45208 \u48756 \u51648 \u47564 , \u49440 \u54980 \u50640 \u44172  \u45796 \u51020 \u44284  \u44057 \u51060  \u54200 \u51648 \u47484  \u50044 \u45796 . \'93\u47564 \u51068  \u45236 \u44032  \u44148 \u44053 \u54620  \u49345 \u53468 \u47196  \u48372 \u47492 \u49828 \u50640  \u44040  \u49688  \u50630 \u45796 \u47732 , \u45208 \u45716  \u50515 \u45716  \u44536 \u45824 \u47196  \u50868 \u48152 \u46104 \u50612  \u44040  \u44163 \u51077 \u45768 \u45796 . \u50780 \u45264 \u54616 \u47732  \u45208 \u45716  \u54889 \u51228 \u44760 \u49436  \u45208 \u47484  \u48512 \u47476 \u45716  \u44163 \u51008  \u54616 \u45208 \u45784 \u44760 \u49436  \u52828 \u55176  \u48512 \u47476 \u49884 \u45716  \u44163 \u51060 \u46972 \u44256  \u48127 \u50612  \u51032 \u49900 \u52824  \u50506 \u44592  \u46412 \u47928 \u51077 \u45768 \u45796 . \u47564 \u51068  \u44536 \u46308 \u51060  \u45236 \u44172  \u45824 \u54616 \u50668  \u54253 \u47141 \u51012  \u50416 \u44592 \u47484  \u50896 \u54620 \u45796 \u47732 , \u46608 \u54620  \u44536 \u47111 \u44172  \u54624  \u44032 \u45733 \u49457 \u51008  \u47588 \u50864  \u47566 \u51012 \u51648 \u46972 \u46020 , \u45208 \u45716  \u44536  \u47928 \u51228 \u47484  \u51452 \u45784 \u51032  \u49552 \u50640  \u47585 \u44592 \u44256  \u51080 \u49845 \u45768 \u45796 . (\u50780 \u45264 \u54616 \u47732  \u44536 \u46308 \u51060  \u45208 \u51032  \u52636 \u46160 \u47484  \u47749 \u54620  \u44163 \u51008  \u45236 \u44172 \u49436  \u44368 \u54984 \u51012  \u48155 \u44592  \u50948 \u54632 \u51060  \u50500 \u45768 \u44592  \u46412 \u47928 \u51077 \u45768 \u45796 .) \u49464  \u51210 \u51008 \u51060 \u46308 \u51012  \u53440 \u50724 \u47476 \u45716  \u54400 \u47924 \u48520  \u49549 \u50640 \u49436  \u51648 \u53020  \u51452 \u49888  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u51648 \u44552 \u46020  \u49332 \u50500  \u44228 \u49492 \u49436  \u53685 \u52824 \u54616 \u49901 \u45768 \u45796 . \u44536 \u48516 \u44760 \u49436  \u45208 \u47484  \u44396 \u50896 \u54644  \u51452 \u49884 \u51648  \u50506 \u51012 \u51648 \u46972 \u46020 , \u45208 \u51032  \u49373 \u47749 \u51008  \u48324 \u48152  \u51473 \u50836 \u54616 \u51648  \u50506 \u49845 \u45768 \u45796 . \u45796 \u47564  \u48373 \u51020 \u51060  \u50501 \u54620  \u51088 \u46308 \u51032  \u51312 \u47217 \u51012  \u48155 \u51648  \u50506 \u46020 \u47197  \u48372 \u54840 \u54616 \u44256 , \u48373 \u51020 \u51012  \u50948 \u54616 \u50668  \u50864 \u47532 \u51032  \u54588 \u47484  \u55128 \u47549 \u49884 \u45796 . \u44161 \u51012  \u45236 \u47732  \u44536 \u46308 \u51060  \u48152 \u46300 \u49884  \u49849 \u47532 \u54616 \u44592  \u46412 \u47928 \u51077 \u45768 \u45796 . \u47784 \u46304  \u49324 \u46988 \u46308 \u51032  \u44396 \u50896 \u51012  \u50948 \u54616 \u50668  \u45236 \u44032  \u49324 \u45716  \u44163 \u51060  \u51339 \u51004 \u45264 , \u51453 \u45716  \u44163 \u51060  \u51339 \u51004 \u45264  \u54616 \u45716  \u47928 \u51228 \u47484  \u44208 \u51221 \u54616 \u45716  \u44163 \u51008  \u45236 \u44032  \u50500 \u45785 \u45768 \u45796 . \u51204 \u54616  (\u27583 \u19979 ) \u44760 \u49436 \u45716  \u45236 \u44032  \u46020 \u47581 \u54616 \u45716  \u51068 \u44284  \u48127 \u51020 \u51012  \u52712 \u49548 \u54616 \u45716  \u51068  \u51060 \u50808 \u50640 \u45716  \u45208 \u50640 \u44172 \u49436  \u50612 \u46500  \u44163 \u51060 \u46304 \u51648  \u44592 \u45824 \u54644 \u46020  \u51339 \u49845 \u45768 \u45796 . \u45208 \u45716  \u46020 \u47581 \u54624  \u49688  \u50630 \u51004 \u47728 , \u48127 \u51020 \u51012  \u52712 \u49548 \u54624  \u49688 \u45716  \u45908 \u50865  \u50630 \u49845 \u45768 \u45796 \'94 (D\'92Aubigne, b.7, ch.1).\
