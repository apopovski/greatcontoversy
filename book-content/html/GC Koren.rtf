\uc0\u48128 \u47084 \u45716  \u45817 \u49884 \u51032  \u51068 \u50640  \u45824 \u54616 \u50668  \u45796 \u51020 \u44284  \u44057 \u51060  \u44592 \u47197 \u54616 \u50688 \u45796 . \'93\u50676 \u44305 \u51201 \u51064  \u54872 \u55148 \u45716  \u50630 \u50632 \u45796 . \u44536 \u47088  \u51068 \u51008  \u48120 \u47000 \u50640  \u49549 \u54620  \u44163 \u51004 \u47196  \u54616 \u45720 \u44284  \u46405 \u51060  \u47568 \u54624  \u49688  \u50630 \u45716  \u44592 \u49256 \u44284  \u50689 \u44305 \u51004 \u47196  \u52649 \u47564 \u54616 \u50668 \u51656  \u44536  \u46412 \u47484  \u50948 \u54616 \u50668  \u45224 \u44200  \u46160 \u50632 \u45796 . \u46608 \u54620  \u51600 \u44144 \u50868  \u54872 \u54840 \u49457  (\u27489 \u21628 \u32882 ) \u46020  \u50630 \u50632 \u45796 . \u44536 \u44163  \u50669 \u49884  \u54616 \u45720 \u50640 \u49436  \u54872 \u54840 \u49457 \u51012  \u50732 \u47540  \u46412 \u47484  \u50948 \u54616 \u50668  \u45224 \u44200  \u46160 \u50632 \u44592  \u46412 \u47928 \u51060 \u50632 \u45796 . \u45432 \u47000 \u54616 \u45716  \u49324 \u46988 \u46308 \u46020  \u51104 \u51104 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u54616 \u45720 \u51032  \u52268 \u50577 \u45824 , \u44263  \u52380 \u49324 \u46308 \u51032  \u47924 \u47532 \u50752  \u50672 \u54633 \u54616 \u44592 \u47484  \u44592 \u45796 \u47532 \u44256  \u51080 \u50632 \u45796 . \'85\u51032 \u44204 \u51032  \u52649 \u46028 \u51060  \u50630 \u50632 \u44256 , \u47784 \u46160  \u54620  \u47560 \u51020 \u44284  \u54620  \u46907 \u51004 \u47196  \u47945 \u52432 \u51080 \u50632 \u45796 \'94 (S.Bliss, Me-moirs of Wm.Miller., pp.270, 271).\
\uc0\u44536  \u50868 \u46041 \u50640  \u52280 \u44032 \u54664 \u45912  \u46608  \u45796 \u47480  \u49324 \u46988 \u51008  \u45796 \u51020 \u44284  \u44057 \u51060  \u51613 \u44144 \u54616 \u50688 \u45796 . \'93\u44536  \u50868 \u46041 \u51008  \u44033  \u44275 \u50640 \u49436  \u54616 \u45720 \u50640  \u44228 \u49888  \u54616 \u45208 \u45784  \u50526 \u50640  \u47560 \u51020 \u51012  \u44618 \u51060  \u49332 \u54588 \u45716  \u51068 \u44284  \u49900 \u47161 \u51012  \u44216 \u48708 \u54616 \u44172  \u54616 \u45716  \u51068 \u51012  \u51068 \u51004 \u53040 \u45796 . \u44536  \u50868 \u46041 \u51008  \u49464 \u49549 \u51201  \u49324 \u47932 \u50640  \u45824 \u54620  \u50528 \u52265 \u51012  \u48260 \u47532 \u44172  \u54616 \u50688 \u44256 , \u45796 \u53820 \u44284  \u50896 \u54620 \u51012  \u54868 \u54644 \u54616 \u44256 , \u47784 \u46304  \u51096 \u47803 \u51012  \u44256 \u48177 \u54616 \u44256 , \u54616 \u45208 \u45784  \u50526 \u50640  \u44404 \u48373 \u54616 \u44256 , \u54616 \u45208 \u45784 \u44760 \u47196 \u48512 \u53552  \u50857 \u49436 \u50752  \u44032 \u45225 \u54616 \u49900 \u51012  \u50619 \u44592  \u50948 \u54616 \u50668  \u54924 \u44060 \u54616 \u44256  \u53685 \u54924 \u54616 \u45716  \u47560 \u51020 \u51004 \u47196  \u44536 \u48516 \u44760  \u53444 \u50896 \u54616 \u44172  \u54616 \u50688 \u45796 . \u44536 \u44163 \u51008  \u50864 \u47532 \u47196  \u54616 \u50668 \u44552  \u51068 \u52237 \u51060  \u44221 \u54744 \u54616 \u51648  \u47803 \u54664 \u45912  \u44216 \u48708 \u50752  \u50756 \u51204 \u54620  \u49692 \u51333 \u51012  \u54616 \u44172  \u54616 \u50688 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436  \u50836 \u50648 \u51012  \u53685 \u54616 \u50668  \u50668 \u54840 \u50752 \u51032  \u53360  \u45216 \u51060  \u51208 \u48149 \u54644  \u50724 \u45716  \u46412 \u47484  \u47568 \u50432 \u54616 \u49884 \u51088  \u49324 \u46988 \u46308 \u51008  \u50743 \u51012  \u52258 \u51648  \u50506 \u44256  \u47560 \u51020 \u51012  \u52258 \u50632 \u51004 \u47728 , \u44552 \u49885 \u54616 \u44256  \u53685 \u54924 \u54632 \u51004 \u47196  \u54616 \u45208 \u45784 \u44760 \u47196  \u46028 \u50500 \u50772 \u45796 . \u49828 \u44032 \u47028 \u47484  \u53685 \u54616 \u50668  \u47568 \u50432 \u54616 \u49888  \u45824 \u47196  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u51088 \u45376 \u46308 \u50640 \u44172  \u51008 \u52509 \u44284  \u44036 \u44396 \u54616 \u45716  \u47560 \u51020 \u51012  \u48512 \u50612  \u51452 \u49512 \u45796 . \u44536 \u46308 \u51008  \u44536 \u46308 \u51060  \u52236 \u47480  \u51452 \u45784 \u51012  \u50864 \u47084 \u47084 \u48372 \u50520 \u51004 \u48064 \u47196  \u50728  \u46405 \u50640 \u45716  \u53356 \u44172  \u53685 \u44257 \u54616 \u45716  \u51068 \u51060  \u51080 \u50632 \u45796 . \'85\u44536 \u47532 \u54616 \u50668  \u51452 \u45784 \u51012  \u44592 \u45796 \u47532 \u45716  \u51088 \u46308 \u51008  \u54616 \u45208 \u45784  \u50526 \u50640 \u49436  \u44536 \u46308 \u51032  \u47560 \u51020 \u51012  \u44340 \u47213 \u44172  \u54616 \u50688 \u45796 \'94[Bliss in Advent Shield and Review, vol 1, p.271 (Jan., 1845) ].\
\uc0\u49324 \u46020  \u49884 \u45824  \u51060 \u47000 \u47196  \u47784 \u46304  \u50948 \u45824 \u54620  \u51333 \u44368 \u50868 \u46041 \u46308  \u51473 \u50640 \u49436  1844\u45380  \u44032 \u51012 \u51032  \u51116 \u47548 \u50868 \u46041 \u47564 \u53372  \u51064 \u44036 \u51201  \u44208 \u54632 \u44284  \u49324 \u45800 \u51032  \u44036 \u44228 \u50640 \u49436  \u48279 \u50612 \u45212  \u50868 \u46041 \u51008  \u50630 \u50632 \u45796 . \u44536  \u54980  \u50668 \u47084  \u54644 \u47484  \u51648 \u45240  \u50724 \u45720 \u45216 \u50640  \u51080 \u50612 \u49436 \u44620 \u51648 \u46020  \u44536  \u45817 \u49884 \u51032  \u50868 \u46041 \u50640  \u52280 \u44032 \u54616 \u50668  \u51652 \u47532 \u51032  \u53664 \u45824  \u50948 \u50640  \u44403 \u44172  \u49456 \u45912  \u49324 \u46988 \u46308 \u51008  \u45572 \u44396 \u45208  \u45817 \u49884 \u51032  \u44536  \u48373 \u46108  \u49324 \u50629 \u50640  \u45208 \u53440 \u45228 \u45912  \u44144 \u47337 \u54620  \u44048 \u54868 \u47141 \u51012  \u44648 \u45803 \u44256 , \u44536 \u44163 \u51060  \u54616 \u45208 \u45784 \u44760  \u49549 \u54620  \u50868 \u46041 \u51060 \u50632 \u51020 \u51012  \u50668 \u51204 \u55176  \u45712 \u45180 \u44256  \u51080 \u45796 .\
\'93\uc0\u48372 \u46972  \u49888 \u46993 \u51060 \u47196 \u45796  \u47582 \u51004 \u47084  \u45208 \u50724 \u46972 \'94\u45716  \u48512 \u47476 \u51670 \u51020 \u51012  \u46307 \u44256  \u44592 \u45796 \u47532 \u44256  \u51080 \u45912  \u49324 \u46988 \u46308 \u51008  \'93\u45796  \u51068 \u50612 \u45208  \u46321 \u51012  \u51456 \u48708 \'94\u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u51648 \u44552 \u44620 \u51648  \u48372 \u51648  \u47803 \u54620  \u50676 \u47148 \u54620  \u55141 \u48120 \u47484  \u44032 \u51648 \u44256  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51012  \u50672 \u44396 \u54616 \u50688 \u45796 . \u52380 \u49324 \u46308 \u51008  \u49892 \u47581 \u54620  \u49324 \u46988 \u46308 \u51012  \u51068 \u51004 \u53020 \u49436  \u44536  \u44592 \u48324 \u51012  \u48155 \u50500 \u46308 \u51068  \u51456 \u48708 \u47484  \u44054 \u52628 \u44172  \u54616 \u44256 \u51088  \u54616 \u45720 \u47196 \u48512 \u53552  \u48372 \u45236 \u49900 \u51012  \u48155 \u50520 \u45796 . \u44536  \u49324 \u50629 \u51008  \u49324 \u46988 \u51032  \u51648 \u54812 \u45208  \u54617 \u49885 \u51004 \u47196  \u51648 \u49549 \u46108  \u44163 \u51060  \u50500 \u45768 \u46972  \u54616 \u45208 \u45784 \u51032  \u45733 \u47141 \u51004 \u47196  \u46104 \u50632 \u45796 . \u51060  \u48512 \u47476 \u49900 \u51012  \u52376 \u51020 \u51004 \u47196  \u46307 \u44256  \u49692 \u51333 \u54620  \u49324 \u46988 \u46308 \u51008  \u44032 \u51109  \u51116 \u45733 \u51060  \u47566 \u51008  \u49324 \u46988 \u46308 \u51060  \u50500 \u45768 \u46972  \u44032 \u51109  \u44216 \u48708 \u54616 \u44256  \u54732 \u49888 \u51201 \u51064  \u49324 \u46988 \u46308 \u51060 \u50632 \u45796 . \u45453 \u48512 \u46308 \u51008  \u52628 \u49688 \u54624  \u44257 \u49885 \u46308 \u51012  \u48173 \u50640  \u49464 \u50892 \u46164  \u52292 , \u51649 \u44277 \u46308 \u51008  \u44536 \u46308 \u51032  \u46020 \u44396 \u47484  \u48260 \u47140 \u46164  \u52292 , \u45576 \u47932 \u44284  \u44592 \u49256 \u51004 \u47196  \u44536  \u44221 \u44256 \u51032  \u44592 \u48324 \u51012  \u51204 \u54616 \u44592  \u50948 \u54616 \u50668  \u45208 \u50500 \u44052 \u45796 . \u44536 \u47088 \u45936  \u51204 \u50640 \u45716  \u47924 \u49832  \u51068 \u50640 \u45208  \u50526 \u51109 \u51012  \u49436 \u45912  \u49324 \u46988 \u46308 \u51060  \u51060  \u50868 \u46041 \u50640 \u45716  \u47592  \u46244 \u50640  \u49436  \u51080 \u50632 \u45796 . \u44368 \u54924 \u46308 \u51008  \u51068 \u48152 \u51201 \u51004 \u47196  \u44536  \u44592 \u48324 \u50640  \u45824 \u54616 \u50668  \u47928 \u51012  \u45803 \u50520 \u51004 \u48064 \u47196  \u44536  \u44592 \u48324 \u51012  \u48155 \u50500 \u46308 \u51064  \u47566 \u51008  \u47924 \u47532 \u46308 \u51008  \u44536 \u46308 \u51032  \u44368 \u54028 \u50640 \u49436  \u45208 \u50772 \u45796 . \u54616 \u45208 \u45784 \u51032  \u49453 \u47532 \u47196  \u44536  \u44592 \u48324 \u51032  \u49440 \u54252 \u44032  \u46168 \u51704  \u52380 \u49324 \u51032  \u44592 \u48324 \u44284  \u50672 \u54633 \u46104 \u50612  \u44536  \u49324 \u50629 \u50640  \u53360  \u55192 \u51012  \u45908 \u54616 \u44172  \u46104 \u50632 \u45796 .\
\'93\uc0\u48372 \u46972  \u49888 \u46993 \u51060 \u47196 \u45796 \'94\u45716  \u44592 \u48324 \u51008  \u49457 \u44221 \u51201 \u51064  \u51613 \u44144 \u44032  \u48516 \u47749 \u54616 \u44256  \u44208 \u51221 \u51201 \u51060 \u50632 \u51648 \u47564  \u44536 \u44163 \u51008  \u45436 \u51613 \u51032  \u47928 \u51228 \u45716  \u50500 \u45768 \u50632 \u45796 . \u44536  \u44592 \u48324 \u50640 \u45716  \u49900 \u47161 \u51012  \u50880 \u51649 \u51060 \u45716  \u50517 \u46020 \u51201 \u51064  \u45733 \u47141 \u51060  \u54632 \u44760  \u54616 \u50688 \u45796 . \u44144 \u44592 \u50640 \u45716  \u50500 \u47924  \u51032 \u49900 \u46020 , \u51656 \u47928 \u46020  \u50630 \u50632 \u45796 . \u51068 \u52237 \u51060  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u50696 \u47336 \u49332 \u47128 \u51004 \u47196  \u49849 \u47532 \u51032  \u51077 \u49457 \u51012  \u54616 \u49892  \u46412  \u50976 \u50900 \u51208 \u51012  \u51648 \u53412 \u47084  \u44033  \u44275 \u50640 \u49436  \u50728  \u49324 \u46988 \u46308 \u51060  \u44048 \u46988 \u49328 \u51004 \u47196  \u47784 \u50688 \u45796 . \u44144 \u44592 \u49436  \u44536 \u46308 \u51008  \u50696 \u49688 \u45784 \u51012  \u49688 \u54665 \u54616 \u44256  \u51080 \u45716  \u44400 \u51473 \u46308 \u44284  \u54633 \u49464 \u54616 \u50688 \u45716 \u45936 , \u44536 \u46308 \u51008  \u44536  \u48516 \u50948 \u44592 \u51032  \u50689 \u44048 \u50640  \u49324 \u47196 \u51105 \u54784  \'93\u51452 \u51032  \u51060 \u47492 \u51004 \u47196  \u50724 \u49884 \u45716  \u51060 \u44032  \u48373 \u51060  \u51080 \u51012 \u51648 \u50612 \u45796 \'94 (\u47560  21:9) \u44256  \u48512 \u47476 \u51670 \u51012  \u49688 \u48150 \u50640  \u50630 \u50632 \u45796 . \u44536 \u50752  \u47560 \u52268 \u44032 \u51648 \u47196  \u51116 \u47548 \u49888 \u51088 \u46308 \u51032  \u51665 \u54924 \u50640  \u52280 \u49437 \u54664 \u45912  \u48520 \u49888 \u51088 \u46308 \u51060  \u45908 \u47084 \u45716  \u54840 \u44592 \u49900 \u50640 \u49436 , \u45908 \u47084 \u45716  \u51312 \u47217 \u54616 \u44592  \u50948 \u54616 \u50668  \u47784 \u50688 \u51648 \u47560 \u45716  \u44536 \u46308  \u50669 \u49884  \'93\u48372 \u46972  \u49888 \u46993 \u51060 \u47196 \u45796 \'94\u45716  \u44536  \u44592 \u48324 \u51060  \u44032 \u51652  \u44048 \u46041 \u51201 \u51064  \u45733 \u47141 \u51012  \u45712 \u44808 \u45796 .\
