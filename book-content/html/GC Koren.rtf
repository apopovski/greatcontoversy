\uc0\u50836 \u54620 \u50640 \u44172 \u45716  \u51109 \u52264  \u44368 \u54924 \u44032  \u44221 \u54744 \u54624  \u49900 \u50724 \u54616 \u44256  \u55141 \u48120 \u47196 \u50868  \u50668 \u47084  \u44032 \u51648  \u51109 \u47732 \u46308 \u51060  \u51204 \u44060 \u46104 \u50632 \u45796 . \u44536 \u45716  \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u46308 \u51032  \u50948 \u52824 , \u50948 \u54744 , \u53804 \u51137 , \u52572 \u54980 \u51032  \u44396 \u50896  \u46321 \u51012  \u48372 \u50520 \u45796 . \u44536 \u45716  \u46608 \u54620  \u54616 \u45720  \u52285 \u44256 \u50640  \u46308 \u50612 \u44032 \u44592  \u50948 \u54616 \u50668  \u47926 \u51060 \u46304 \u51648 , \u47736 \u47581 \u51032  \u48520 \u50640  \u53468 \u50892 \u51648 \u44592  \u50948 \u54616 \u50668  \u47926 \u51060 \u46304 \u51648  \u44036 \u50640  \u49464 \u49345 \u51032  \u52628 \u49688 \u47484  \u50948 \u54620  \u47560 \u51648 \u47561  \u44592 \u48324 \u51012  \u44592 \u47197 \u54616 \u44256  \u51080 \u45796 . \u44536 \u47532 \u44256  \u50668 \u47084  \u44032 \u51648  \u51473 \u50836 \u54620  \u49324 \u44148 \u46308 , \u53945 \u55176  \u47560 \u51648 \u47561  \u44368 \u54924 \u50640  \u51080 \u50612 \u49436  \u44536 \u47495 \u46108  \u44600 \u50640 \u49436  \u51652 \u47532 \u51032  \u44600 \u47196  \u46028 \u50500 \u50724 \u45716  \u49324 \u46988 \u46308 \u51060  \u44202 \u51012  \u53804 \u51137 \u44284  \u50948 \u54744 \u50640  \u44288 \u54620  \u44368 \u54984 \u46308 \u51060  \u44536 \u50640 \u44172  \u48372 \u50668 \u51276 \u45796 . \u44536 \u47084 \u48064 \u47196  \u45572 \u44396 \u46304 \u51648  \u51109 \u52264  \u49464 \u49345 \u50640  \u51068 \u50612 \u45216  \u51068 \u46308 \u50640  \u44288 \u54616 \u50668  \u47924 \u51648 \u54620  \u44032 \u50868 \u45936  \u47931 \u54784  \u51080 \u51012  \u54596 \u50836 \u45716  \u50630 \u45796 .\
