\f0\b \cf0 \uc0\u47196 \u47560  \u48169 \u47928 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u44536 \u47084 \u45208  \u47336 \u53552 \u45716  \u50668 \u51204 \u55176  \u48277 \u50773  \u44368 \u54924 \u51032  \u52280 \u46108  \u50500 \u46308 \u51060 \u50632 \u51004 \u47728 , \u44536 \u45716  \u44536  \u50808 \u50640  \u45796 \u47480  \u49373 \u44033 \u51012  \u51312 \u44552 \u46020  \u44032 \u51648 \u51648  \u50506 \u50520 \u45796 . \u44536 \u45716  \u54616 \u45208 \u45784 \u51032  \u49453 \u47532 \u47196  \u47196 \u47560 \u47484  \u48169 \u47928 \u54616 \u44172  \u46104 \u50632 \u45796 . \u44536 \u45716  \u46020 \u48372 \u47196  \u50668 \u54665 \u54616 \u47732 \u49436  \u46020 \u51473 \u50640  \u51080 \u45716  \u49688 \u46020 \u50896 \u46308 \u50640 \u49436  \u49689 \u48149 \u54616 \u50688 \u45796 . \u51060 \u53448 \u47532 \u50500 \u50640  \u51080 \u45716  \u54620  \u49688 \u46020 \u50896 \u50640 \u49436  \u44536 \u45716  \u45320 \u47924 \u45208  \u48512 \u50836 \u54616 \u44256  \u54868 \u47140 \u54616 \u44256  \u49324 \u52824 \u54620  \u44163 \u51012  \u47785 \u44201 \u54616 \u44256  \u49900 \u55176  \u45440 \u46992 \u45796 . \u44536  \u49849 \u47140 \u46308 \u51008  \u47560 \u52824  \u50773 \u54980  (\u29579 \u20399 ) \u46308 \u44284  \u44057 \u51008  \u49688 \u51077 \u51004 \u47196  \u54868 \u47140 \u54620  \u51665 \u50640  \u49332 \u44256 , \u47588 \u50864  \u44050 \u51652  \u51032 \u48373 \u51012  \u51077 \u44256 , \u51652 \u49688 \u49457 \u52268 \u51012  \u47673 \u50632 \u45796 . \u47336 \u53552 \u45716  \u44340 \u47196 \u50872  \u51221 \u46020 \u47196  \u48520 \u50504 \u54620  \u47560 \u51020 \u51004 \u47196  \u44536  \u44305 \u44221 \u46308 \u51012  \u51088 \u44592 \u51032  \u49324 \u49373 \u54876 \u51032  \u44537 \u44592 \u50752  \u44256 \u45212 \u44284  \u45824 \u51312 \u54616 \u50668  \u48372 \u50520 \u45796 . \u44536 \u51032  \u47560 \u51020 \u51008  \u48264 \u48124 \u54616 \u44592  \u49884 \u51089 \u54616 \u50688 \u45796 .\
\uc0\u46300 \u46356 \u50612  \u44536 \u45716  \u47680 \u47532  \u51068 \u44273  \u47719 \u48512 \u47532 \u51032  \u46020 \u49457 \u51012  \u48148 \u46972 \u48372 \u50520 \u45796 . \u44536 \u45716  \u51060  \u46412  \u44618 \u51008  \u44048 \u46041 \u51012  \u48155 \u44256  \u46405 \u50640  \u50638 \u46300 \u47140 \u49436  \'93\u44144 \u47337 \u54620  \u49457  \u47196 \u47560 \u50668 ! \u45208 \u45716  \u45348 \u44172  \u44221 \u51032 \u47484  \u54364 \u54616 \u45432 \u46972 \'94 (D\'92Aubigne, b.2, ch.6) \u44256  \u48512 \u47476 \u51670 \u50632 \u45796 . \u44536 \u45716  \u47196 \u47560  \u46020 \u49457 \u51004 \u47196  \u46308 \u50612 \u44032 \u49436  \u50668 \u47084  \u44368 \u54924 \u47484  \u48169 \u47928 \u54616 \u44256 , \u49888 \u48512 \u50752  \u49849 \u47140 \u46308 \u51060  \u45720 \u50612 \u45459 \u45716  \u50668 \u47084  \u44032 \u51648  \u51060 \u50556 \u44592 \u47484  \u46307 \u44256 , \u54596 \u50836 \u54620  \u50728 \u44054  \u51032 \u49885 \u51012  \u54665 \u54616 \u50688 \u45796 . \u48372 \u45716  \u44163 \u47560 \u45796  \u44536 \u50640 \u44172  \u45440 \u46972 \u50880 \u44284  \u46160 \u47140 \u50880 \u51012  \u51452 \u51648  \u50506 \u45716  \u44163 \u51060  \u50630 \u50632 \u45796 . \u44536 \u45716  \u44033  \u44228 \u44553 \u51032  \u49849 \u47140 \u46308  \u44032 \u50868 \u45936  \u51396 \u50501 \u51060  \u44032 \u46301  \u52264  \u51080 \u45716  \u44163 \u51012  \u48372 \u50520 \u45796 . \u44536 \u45716  \u51452 \u44368 \u51032  \u51077 \u50640 \u49436 \u44620 \u51648  \u50556 \u48708 \u54620  \u45453 \u45812 \u51012  \u46307 \u44172  \u46104 \u50632 \u44256 , \u47924 \u49436 \u50868  \u48520 \u44221 , \u49900 \u51648 \u50612  \u48120 \u49324 \u47484  \u46300 \u47532 \u45716  \u46412 \u50640 \u46020  \u44536 \u47088  \u51068 \u51060  \u45208 \u53440 \u45224 \u51012  \u48372 \u44256  \u50724 \u51649  \u51204 \u50984 \u54624  \u49688 \u48150 \u50640  \u50630 \u50632 \u45796 . \u44536 \u45716  \u49849 \u47140 \u50752  \u49884 \u48124 \u46308 \u44284 \u51032  \u44368 \u51228 \u47484  \u53685 \u54616 \u50668  \u44536 \u46308 \u51060  \u48169 \u53461 \u54616 \u44256  \u51452 \u49353 \u50640  \u48736 \u51256  \u51080 \u45716  \u44163 \u51012  \u47785 \u44201 \u54616 \u50688 \u45796 . \u44536 \u45716  \u49888 \u49457 \u54620  \u51109 \u49548 \u50640 \u49436  \u54616 \u45208 \u45784 \u51012  \u47784 \u46021 \u54616 \u45716  \u51068 \u44620 \u51648  \u44048 \u54665 \u46104 \u45716  \u44163 \u51012  \u48372 \u50520 \u45796 . \u44536 \u45716  \u44536  \u51068 \u50640  \u45824 \u54616 \u50668  \u45796 \u51020 \u44284  \u44057 \u51060  \u44592 \u47197 \u54616 \u50688 \u45796 . \'93\u47196 \u47560 \u50640 \u49436  \u44048 \u54665 \u46104 \u45716  \u47784 \u46304  \u51396 \u50501 \u44284  \u54028 \u47156 \u52824 \u54620  \u54665 \u46041 \u51008  \u50500 \u47924 \u46020  \u49345 \u49345 \u54624  \u49688  \u50630 \u45796 . \u44536 \u44163 \u51008  \u49892 \u51228 \u47196  \u44032 \u49436  \u48372 \u51648  \u50506 \u44256 \u45716  \u48127 \u51012  \u49688  \u50630 \u45716  \u51068 \u51060 \u50632 \u45796 . \'91\u49464 \u49345 \u50640  \u51648 \u50725 \u51060 \u46972 \u45716  \u44163 \u51060  \u51080 \u45796 \u47732  \u47196 \u47560 \u45716  \u54596 \u49884  \u44536  \u50948 \u50640  \u44148 \u49444 \u46104 \u50632 \u51012  \u44163 \u51060 \u45796 . \u44536  \u44275 \u51008  \u50728 \u44054  \u51396 \u50501 \u51060  \u49373 \u44200 \u45208 \u45716  \u47924 \u54620  \u51648 \u50725 \u51060 \u45796 \'92\u45716  \u47568 \u44620 \u51648  \u51080 \u45716  \u44163 \u51060 \u45796 \'94 (D\'92Aubigne, b.2, ch.6).\
\uc0\u45817 \u49884 \u50640  \u48277 \u50773 \u51032  \u54620  \u44368 \u47161 \u51060  \u48152 \u54252 \u46104 \u50632 \u45716 \u45936 , \u44536 \u44163 \u51008  \u49548 \u50948  \u48716 \u46972 \u46020 \u51032  \u52789 \u44228 \u46972 \u45716  \u44163 \u51012  \u47924 \u47502 \u51004 \u47196  \u50732 \u46972 \u44032 \u45716  \u51088 \u45716  \u45572 \u44396 \u46304 \u51648  \u51396 \u49324 \u54632 \u51012  \u48155 \u45716 \u45796 \u45716  \u44163 \u51060 \u50632 \u45796 . \u44536  \u52789 \u44228 \u45716  \u50696 \u49688 \u44760 \u49436  \u47196 \u47560 \u51064 \u51032  \u51116 \u54032 \u51221 \u51012  \u45208 \u50724 \u49892  \u46412 \u50640  \u45236 \u47140 \u50724 \u49888  \u52789 \u44228 \u47196 \u49436  \u44536 \u44163 \u51060  \u44592 \u51201 \u51201 \u51004 \u47196  \u50696 \u47336 \u49332 \u47128 \u50640 \u49436  \u47196 \u47560 \u47196  \u50734 \u44200 \u50724 \u44172  \u46104 \u50632 \u45796 \u45716  \u44163 \u51060 \u50632 \u45796 . \u50612 \u45712  \u45216  \u47336 \u53552 \u45716  \u44221 \u44148 \u54620  \u47560 \u51020 \u51004 \u47196  \u44536  \u52789 \u44228 \u47484  \u54616 \u45208 \u50473  \u54616 \u45208 \u50473  \u50724 \u47476 \u44256  \u51080 \u50632 \u45716 \u45936 , \u44049 \u51088 \u44592  \'93\u51032 \u51064 \u51008  \u48127 \u51020 \u51004 \u47196  \u47568 \u48120 \u50516 \u50500  \u49332 \u47532 \u46972 \'94 (\u47212  1:17) \u45716  \u47568 \u50432 \u51060  \u50864 \u47112 \u52376 \u47100  \u46308 \u47532 \u45716  \u46319 \u54616 \u50688 \u45796 . \u44536 \u45716  \u46160 \u47157 \u44256  \u48512 \u45124 \u47084 \u50868  \u49373 \u44033 \u51060  \u45208 \u49436  \u44553 \u55176  \u44536  \u44275 \u50640 \u49436  \u51068 \u50612 \u45208 \u49436  \u45208 \u50772 \u45796 . \u44536  \u49457 \u44221  \u44396 \u51208 \u51060  \u44536 \u51032  \u49900 \u47161 \u50640  \u51452 \u45716  \u45733 \u47141 \u51008  \u44208 \u53076  \u49548 \u47736 \u46104 \u51648  \u50506 \u50520 \u45796 . \u44536  \u46412 \u48512 \u53552  \u44536 \u45716  \u44396 \u50896 \u51012  \u50619 \u45716  \u45936  \u51080 \u50612 \u49436  \u49324 \u46988 \u51032  \u54665 \u50948 \u47484  \u51032 \u51648 \u54616 \u45716  \u44163 \u51060  \u50612 \u47532 \u49437 \u51008  \u51068 \u51060 \u46972 \u45716  \u44163 \u44284  \u44536 \u47532 \u49828 \u46020 \u51032  \u44277 \u47196 \u47484  \u54637 \u49345  \u48127 \u50612 \u50556  \u54624  \u54596 \u50836 \u49457 \u51012  \u44284 \u44144  \u50612 \u45712  \u46412 \u48372 \u45796  \u45908 \u50865  \u51208 \u49892 \u55176  \u44648 \u45804 \u50520 \u45796 . \u44536 \u51032  \u45576 \u51008  \u50676 \u47536  \u48148  \u46104 \u50632 \u51004 \u47728 , \u45796 \u49884 \u45716  \u48277 \u50773 \u44368 \u51032  \u48120 \u54841 \u51004 \u47196  \u44032 \u47140 \u51648 \u51648  \u50500 \u45768 \u54624  \u44163 \u51060 \u50632 \u45796 . \u44536 \u44032  \u47196 \u47560 \u50640 \u49436  \u50620 \u44404 \u51012  \u46028 \u47532 \u44172  \u46104 \u51088 , \u44536 \u51032  \u47560 \u51020 \u46020  \u46608 \u54620  \u47196 \u47560 \u50640 \u49436  \u46496 \u45228 \u45796 . \u44536  \u54980 \u47196  \u47196 \u47560 \u50752 \u51032  \u44036 \u44201 \u51008  \u51216 \u51216  \u48268 \u50612 \u51256 \u49436  \u47560 \u52840 \u45236  \u48277 \u50773  \u44368 \u54924 \u50752  \u47784 \u46304  \u44288 \u44228 \u47484  \u45130 \u50612  \u48260 \u47160 \u45796 .\
