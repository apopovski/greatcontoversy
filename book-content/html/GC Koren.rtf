\uc0\u54924 \u51032 \u51032  \u44208 \u51032 \u47196 \u49436  \u52649 \u48516 \u52824  \u47803 \u54632 \u51060  \u51077 \u51613 \u46104 \u51088  \u49464 \u49345 \u51032  \u51665 \u44428 \u51088 \u46308 \u51008  \u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u50640  \u46160 \u47140 \u50880 \u51012  \u51452 \u50612  \u51068 \u50836 \u51068 \u50640  \u51068 \u51012  \u54616 \u51648  \u47803 \u54616 \u46020 \u47197  \u44053 \u50836 \u54616 \u45716  \u48277 \u47161 \u51012  \u48152 \u54252 \u54616 \u46020 \u47197  \u44036 \u52397 \u51012  \u48155 \u50520 \u45796 . \u44536 \u47532 \u54616 \u50668  \u47196 \u47560 \u50640 \u49436  \u44060 \u52572 \u46108  \u51333 \u44368  \u54924 \u51032 \u50640 \u49436  \u51060 \u51204 \u50640  \u44208 \u51221 \u46108  \u47784 \u46304  \u44208 \u51032 \u44032  \u45908  \u54620 \u52789  \u53360  \u50689 \u54693 \u47141 \u44284  \u44428 \u50948 \u44032  \u51080 \u45716  \u44163 \u51004 \u47196  \u51116 \u48372 \u51613 \u46104 \u50632 \u45796 . \u51060 \u44163 \u46308 \u51008  \u51333 \u44368 \u51201  \u48277 \u47456 \u51060  \u46104 \u50612  \u44144 \u51032  \u47784 \u46304  \u44536 \u47532 \u49828 \u46020 \u44368  \u44397 \u50640 \u49436  \u44536  \u45208 \u46972 \u51032  \u51665 \u44428 \u51088 \u46308 \u50640  \u51032 \u54616 \u50668  \u44053 \u50836 \u46104 \u50632 \u45796  (Heylyn, History of the Sabbath, pt.2, ch.5, sec.7 \u52280 \u51312 ).\
\uc0\u44536 \u47084 \u45208  \u51068 \u50836 \u51068  \u51456 \u49688 \u47484  \u49457 \u44221 \u51032  \u44428 \u50948 \u47196  \u48372 \u51613 \u54624  \u49688  \u50630 \u45716  \u44163 \u51008  \u50668 \u51204 \u55176  \u53360  \u44260 \u46976 \u51060  \u50500 \u45776  \u49688  \u50630 \u50632 \u45796 . \u49324 \u46988 \u46308 \u51008  \u53468 \u50577 \u51032  \u45216 \u51012  \u49709 \u48176 \u54616 \u44592  \u50948 \u54616 \u50668  \'93\u51228 \u52832 \u51068 \u51008  \u45320 \u51032  \u54616 \u45208 \u45784  \u50668 \u54840 \u50752 \u51032  \u50504 \u49885 \u51068 \'94\u51060 \u46972 \u44256  \u54620  \u50668 \u54840 \u50752 \u51032  \u48516 \u47749 \u54620  \u49440 \u50616 \u51012  \u47924 \u49884 \u54644 \u48260 \u47540  \u44428 \u47532 \u44032  \u44536 \u46308 \u51032  \u51648 \u46020 \u51088 \u46308 \u50640 \u44172  \u51080 \u45716 \u44032  \u51656 \u47928 \u54616 \u50688 \u45796 . \u49457 \u44221 \u50640 \u49436  \u50619 \u50612 \u50556  \u54624  \u51613 \u44144 \u51032  \u44208 \u54605 \u51012  \u48372 \u52649 \u54616 \u44592  \u50948 \u54616 \u50668  \u45796 \u47480  \u48169 \u54200 \u51060  \u54596 \u50836 \u54616 \u50688 \u45796 . 12\u49464 \u44592  \u47568 \u50685 \u50640  \u50689 \u44397 \u51032  \u44368 \u54924 \u46308 \u51012  \u48169 \u47928 \u54620  \u50676 \u47148 \u54620  \u54620  \u51068 \u50836 \u51068  \u50745 \u54840 \u51088 \u45716  \u52649 \u49457 \u46108  \u51652 \u47532 \u51032  \u51613 \u51064 \u46308 \u50640 \u44172  \u44144 \u51208 \u51012  \u45817 \u54616 \u50688 \u45796 . \u44536 \u45716  \u50500 \u47924 \u47532  \u45432 \u47141 \u54624 \u51648 \u46972 \u46020  \u54952 \u44284 \u44032  \u50630 \u51004 \u48064 \u47196  \u51068 \u49884  \u44256 \u44397 \u51004 \u47196  \u46028 \u50500 \u44032 \u49436  \u51088 \u44592 \u51032  \u44032 \u47476 \u52840 \u51012  \u44053 \u50836 \u54616 \u44592  \u50948 \u54620  \u50612 \u46500  \u48169 \u50504 \u51012  \u50672 \u44396 \u54616 \u45716  \u51068 \u50640  \u47792 \u46160 \u54616 \u50688 \u4