 \u50629 \u50640  \u45824 \u54620  \u54616 \u45720  \u52380 \u49324 \u46308 \u51032  \u44288 \u49900 \u44284  \u55141 \u48120 \u47484  \u48372 \u50668 \u51456 \u45796 . \u51060 \u44163 \u51008  \u52380 \u49324 \u46308 \u51060  \u50508 \u44592 \u47484  \u50896 \u54616 \u45716  \u51088 \u48708 \u51032  \u50724 \u47896 \u51060 \u45796 . \u44536  \u50724 \u47896 \u45716  \u54616 \u45208 \u45784 \u44760 \u49436  \u54924 \u44060 \u54620  \u51396 \u51064 \u51012  \u51032 \u47213 \u45796  \u54616 \u49884 \u44256  \u45817 \u49888 \u51060  \u51032 \u47213 \u44172  \u46104 \u49884 \u45716  \u44163 , \u53440 \u46973 \u54620  \u51064 \u47448 \u47196  \u45908 \u48520 \u50612  \u45796 \u49884 \u44552  \u44368 \u51228 \u47484  \u49352 \u47213 \u44172  \u54616 \u49884 \u47732 \u49436  \u46041 \u49884 \u50640  \u44536 \u48516 \u44760 \u49436  \u51032 \u47196 \u50864 \u49892  \u49688  \u51080 \u45796 \u45716  \u44163 , \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u49688 \u47566 \u51008  \u47924 \u47532 \u46308 \u51012  \u47736 \u47581 \u51032  \u44396 \u45929 \u51060 \u50640 \u49436  \u44396 \u50896 \u54616 \u49884 \u47140 \u44256  \u44053 \u47548 \u54616 \u49884 \u45716  \u44163 , \u44536 \u46308 \u50640 \u44172  \u55136 \u51060  \u50630 \u45716  \u45817 \u49888 \u51032  \u51032 \u51032  \u50743 \u51012  \u51077 \u55176 \u49884 \u44256 , \u51068 \u52237 \u51060  \u53440 \u46973 \u54620  \u51068 \u51060  \u50630 \u45716  \u52380 \u49324 \u46308 \u44284  \u50672 \u54633 \u49884 \u53412 \u49324  \u45817 \u49888  \u50526 \u50640 \u49436  \u50689 \u50896 \u55176  \u49332 \u44172  \u54616 \u49884 \u45716  \u44163  \u46321 \u51060 \u45796 .\
