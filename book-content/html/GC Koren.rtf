\uc0\u47560 \u52840 \u45236  \u54889 \u51228 \u47484  \u48473 \u44592 \u47196  \u51648 \u51221 \u46108  \u49884 \u44036 \u51060  \u50772 \u45796 . \u48372 \u51340 \u50640  \u50505 \u51008  \u52852 \u50508  5\u49464 \u45716  \u44033  \u49440 \u54980 \u50752  \u44480 \u51313 \u46308 \u50640 \u44172  \u46168 \u47084 \u49912 \u50668  \'93\u54532 \u47196 \u53580 \u49828 \u53444 \u53944 \'94\u50640  \u49549 \u54620  \u44060 \u54785 \u51088 \u46308 \u51032  \u47568 \u50640  \u44480 \u47484  \u44592 \u50872 \u50688 \u45796 . \u44060 \u54785 \u51088 \u46308 \u51032  \u49888 \u50521  \u44256 \u48177 \u49436 \u44032  \u45229 \u46021 \u46104 \u50632 \u45796 . \u44536  \u50628 \u49689 \u54620  \u51665 \u54924 \u50640 \u49436  \u48373 \u51020 \u51032  \u51652 \u47532 \u45716  \u48157 \u54784 \u51648 \u44256  \u47196 \u47560  \u44368 \u54924 \u51032  \u50724 \u47448 \u46308 \u51008  \u51648 \u51201 \u46104 \u50632 \u45796 . \u51060 \u45216 \u51012  \'93\u44060 \u54785  \u49324 \u50629 \u51032  \u44032 \u51109  \u53360  \u45216 , \u44536 \u47532 \u49828 \u46020 \u44368 \u50752  \u51064 \u47448 \u51032  \u50669 \u49324 \u50640 \u49436  \u44032 \u51109  \u50689 \u44305 \u49828 \u47084 \u50868  \u45216 \'94 (D\'92Aubigne, b.14, ch.7) \u51060 \u46972 \u44256  \u51068 \u52971 \u44172  \u46108  \u44163 \u51008  \u45320 \u47924 \u46020  \u45817 \u50672 \u54620  \u51068 \u51060 \u45796 .\
\uc0\u48708 \u53584 \u48288 \u47476 \u53356 \u51032  \u49849 \u47140  (\u47336 \u53552 \u47484  \u44032 \u47532 \u53412 \u45716  \u47568 \u51076 -\u50669 \u51088  \u51452 ) \u44032  \u48372 \u47492 \u49828 \u51032  \u44397 \u54924  \u50526 \u50640  \u54848 \u47196  \u49456 \u45912  \u46412 \u47196 \u48512 \u53552  \u48520 \u44284  \u47751  \u45380 \u51060  \u51648 \u45228 \u51012  \u49104 \u51060 \u50632 \u45796 . \u51648 \u44552 \u51008  \u44536 \u47484  \u45824 \u49888 \u54616 \u50668  \u44536  \u45208 \u46972 \u51032  \u44032 \u51109  \u44480 \u54616 \u44256  \u50976 \u47141 \u54620  \u51228 \u54980 \u46308 \u51060  \u49436  \u51080 \u50632 \u45796 . \u47336 \u53552 \u45716  \u50500 \u50864 \u53356 \u49828 \u48512 \u47476 \u53356 \u50640  \u52636 \u46160 \u54616 \u51648  \u47803 \u54616 \u46020 \u47197  \u44552 \u51648 \u46104 \u50612  \u51080 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u51088 \u44592 \u51032  \u47568 \u44284  \u44592 \u46020 \u47196 \u50024  \u44144 \u44592  \u52280 \u49437 \u54616 \u50688 \u45796 . \u44536 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u44592 \u47197 \u54616 \u50688 \u45796 . \'93\u45208 \u45716  \u44536 \u52376 \u47100  \u50976 \u47749 \u54620  \u49888 \u50521  \u44256 \u48177 \u51088 \u46308 \u44284  \u50689 \u44305 \u49828 \u47084 \u50868  \u51665 \u54924 \u50640 \u49436  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u44277 \u44277 \u50672 \u54616 \u44172  \u45458 \u51076 \u51012  \u48155 \u51008  \u51060  \u49884 \u44036 \u44620 \u51648  \u49332 \u50500  \u51080 \u45716  \u44163 \u51012  \u45336 \u52824 \u45716  \u44592 \u49256 \u51004 \u47196  \u49373 \u44033 \u54620 \u45796 \'94 (D\'92Aubigne, b.14, ch.7). \u44536 \u47532 \u54616 \u50668  \'93\u46608  \u50676 \u50773  \u50526 \u50640  \u51452 \u51032  \u51613 \u44144 \u47484  \u47568 \u54624 \'94 (\u49884  119:46) \u44163 \u51060 \u46972 \u45716  \u49457 \u44221  \u47568 \u50432 \u51060  \u49457 \u52712 \u46104 \u50632 \u45796 .\
\uc0\u48148 \u50872 \u51032  \u49884 \u45824 \u50640  \u48148 \u50872 \u51008  \u48373 \u51020 \u51012  \u50948 \u54616 \u50668  \u50725 \u50640  \u44039 \u55176 \u44592 \u44620 \u51648  \u54616 \u50688 \u51648 \u47564  \u44536  \u48373 \u51020 \u51060  \u47196 \u47560  \u51228 \u44397 \u51032  \u51228 \u54980 \u46308 \u44284  \u44480 \u51313 \u46308  \u50526 \u50640  \u51228 \u49884 \u46104 \u50632 \u45796 . \u44536 \u50752  \u47560 \u52268 \u44032 \u51648 \u47196  \u51060 \u48264 \u50640 \u46020  \u54889 \u51228 \u51032  \u47749 \u47161 \u51004 \u47196  \u44053 \u45800 \u50640 \u49436 \u45716  \u49444 \u44368 \u54624  \u49688  \u50630 \u46020 \u47197  \u44552 \u51648 \u46104 \u50612  \u51080 \u50632 \u51004 \u45208  \u50773 \u44417 \u50640 \u49436  \u48373 \u51020 \u51012  \u51204 \u54616 \u44172  \u46104 \u50632 \u45796 . \u47566 \u51008  \u49324 \u46988 \u46308 \u51060  \u51333 \u46308 \u51312 \u52264  \u46307 \u44592 \u50640  \u48512 \u51201 \u54633 \u54616 \u45796 \u44256  \u50668 \u44200  \u50724 \u45912  \u44163 \u51012  \u44397 \u44032 \u51032  \u44400 \u51452 \u46308 \u44284  \u44256 \u44288 \u46308 \u51060  \u44221 \u53444 \u54616 \u47732 \u49436  \u44480 \u47484  \u44592 \u50872 \u50688 \u45796 . \u50773 \u46308 \u44284  \u50948 \u45824 \u54620  \u49324 \u46988 \u46308 \u51060  \u52397 \u51473 \u51060  \u46104 \u44256 , \u44428 \u50948  \u51080 \u45716  \u51228 \u54980 \u46308 \u51060  \u49444 \u44368 \u51088 \u44032  \u46104 \u50612  \u54616 \u45208 \u45784 \u51032  \u44144 \u47337 \u54620  \u51652 \u47532 \u47484  \u49444 \u44368 \u54616 \u50688 \u45796 . \'93\u49324 \u46020  \u49884 \u45824  \u51060 \u47000 \u47196  \u51060 \u48372 \u45796  \u45908  \u50948 \u45824 \u54620  \u49324 \u50629 \u44284  \u51060 \u48372 \u45796  \u45908  \u54988 \u47469 \u54620  \u49888 \u50521  \u44256 \u48177 \u51060  \u51080 \u50632 \u45912  \u51201 \u51008  \u50630 \u45796 \'94 (D\'92Aubigne, b.14, ch.7) \u44256  \u50612 \u46500  \u51200 \u49696 \u44032 \u45716  \u44592 \u47197 \u54616 \u50688 \u45796 .\
\'93\uc0\u47336 \u53552 \u54028 \u50640 \u49436  \u47568 \u54620  \u44163 \u51008  \u47784 \u46160  \u50739 \u45796 . \u50864 \u47532 \u45716  \u44536  \u49324 \u49892 \u51012  \u48512 \u51064 \u54624  \u49688  \u50630 \u45796 \'94\u44256  \u48277 \u50773 \u45817 \u51032  \u54620  \u44048 \u46021 \u51008  \u47568 \u54616 \u50688 \u45796 . \u46608  \u45796 \u47480  \u54620  \u49324 \u46988 \u51008  \u50640 \u53356  \u48149 \u49324 \u50640 \u44172  \'93\u49440 \u54980  (\u36984 \u20399 ) \u50752  \u44536 \u51032  \u46041 \u47308 \u46308 \u51060  \u51089 \u49457 \u54620  \u49888 \u50521  \u44256 \u48177 \u49436 \u50640  \u45824 \u54616 \u50668  \u44148 \u51204 \u54620  \u45436 \u47532 \u47484  \u44032 \u51648 \u44256  \u48152 \u48149 \u54624  \u49688  \u51080 \u45716 \u44032 ?\'94\u46972 \u44256  \u47932 \u50632 \u45796 . \u44536 \u47084 \u51088  \u44536 \u45716  \'93\u49324 \u46020 \u46308 \u44284  \u49440 \u51648 \u51088 \u46308 \u51032  \u44544 \u51012  \u44032 \u51648 \u44256 \u45716  \u54624  \u49688  \u50630 \u51004 \u45208  \u44368 \u48512  (\u25934 \u29238 ) \u46308 \u44284  \u54924 \u51032 \u51032  \u44592 \u47197 \u51012  \u44032 \u51648 \u44256 \u45716  \u54624  \u49688  \u51080 \u45796 \'94 (D\'92Aubigne, b.14, ch.8) \u44256  \u45824 \u45813 \u54616 \u50688 \u45796 . \u44536  \u51656 \u47928 \u51012  \u54620  \u49324 \u46988 \u51008  \'93\u44536 \u47084 \u47732  \u45817 \u49888 \u51032  \u44204 \u54644 \u50640  \u51032 \u54616 \u47732  \u47336 \u53552 \u54028 \u45716  \u49457 \u44221 \u51012  \u51473 \u49900 \u51004 \u47196  \u54616 \u44256  \u50864 \u47532 \u45716  \u44536 \u47111 \u51648  \u47803 \u54616 \u45796 \u45716  \u47568 \u51064  \u51460  \u50508 \u44192 \u45796 \'94\u44256  \u45824 \u45813 \u54616 \u50688 \u45796 .\
\uc0\u46021 \u51068 \u51032  \u51228 \u54980  \u51473  \u47751  \u49324 \u46988 \u46308 \u51060  \u44060 \u54785 \u54028 \u51032  \u49888 \u50521 \u51012  \u44032 \u51648 \u44172  \u46104 \u50632 \u45796 . \u54889 \u51228 \u46020  \u44060 \u54785 \u54028 \u51032  \u49888 \u51312 \u46308 \u51060  \u51652 \u47532 \u51064  \u44163 \u51012  \u52828 \u55176  \u49440 \u50616 \u54616 \u50688 \u45796 . \u44536  \u49888 \u50521  \u44256 \u48177 \u49436 \u45716  \u44033 \u44397 \u51032  \u47568 \u47196  \u48264 \u50669 \u46104 \u50612  \u51204  \u44396 \u46972 \u54028 \u50640  \u48372 \u44553 \u46104 \u50632 \u45796 . \u44536  \u54980  \u50668 \u47084  \u49884 \u45824 \u47484  \u53685 \u54616 \u50668  \u47566 \u51008  \u49324 \u46988 \u46308 \u51060  \u44536 \u44163 \u51012  \u51088 \u44592 \u46308 \u51032  \u49888 \u50521 \u51004 \u47196  \u48155 \u50500 \u46308 \u50688 \u45796 .\
\uc0\u54616 \u45208 \u45784 \u51032  \u49888 \u49892 \u54620  \u51333 \u46308 \u51008  \u54848 \u47196  \u49688 \u44256 \u54616 \u51648  \u50506 \u50520 \u45796 . \'93\u51221 \u49324  (\u25919 \u20107 ) \u50752  \u44428 \u49464 \u50752  \u54616 \u45720 \u50640  \u51080 \u45716  \u50501 \u51032  \u50689 \u46308 \'94\u51060  \u50672 \u54633 \u54616 \u50668  \u44536 \u46308 \u51012  \u45824 \u54637 \u54616 \u50688 \u51004 \u45208  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u48177 \u49457 \u51012  \u48260 \u47532 \u51648  \u50506 \u51004 \u49512 \u45796 . \u47564 \u51068  \u44536 \u46308 \u51032  \u45576 \u51060  \u50676 \u47540  \u49688  \u51080 \u50632 \u45908 \u46972 \u47732  \u44536 \u46308 \u51008  \u50715 \u45216 \u51032  \u54620  \u49440 \u51648 \u51088 \u52376 \u47100  \u54616 \u45208 \u45784 \u51032  \u51076 \u51116 \u54616 \u49900 \u44284  \u44536 \u48516 \u51032  \u46020 \u50864 \u49900 \u51032  \u48516 \u47749 \u54620  \u51613 \u44144 \u47484  \u48372 \u50520 \u51012  \u44163 \u51060 \u45796 . \u50648 \u47532 \u49324 \u51032  \u51333 \u51060  \u44536 \u51032  \u51452 \u51064 \u50640 \u44172  \u44536 \u46308 \u51012  \u50640 \u50892 \u49912 \u44256  \u51080 \u45716  \u51201 \u44400 \u46308 \u44284  \u46020 \u47581 \u54624  \u47784 \u46304  \u44592 \u54924 \u44032  \u45130 \u50612 \u51652  \u44163 \u51012  \u51648 \u51201 \u54664 \u51012  \u46412  \u44536  \u49440 \u51648 \u51088 \u45716  \'93\u50668 \u54840 \u50752 \u50668  \u50896 \u52968 \u45824  \u51200 \u51032  \u45576 \u51012  \u50676 \u50612 \u49436  \u48372 \u44172  \u54616 \u50741 \u49548 \u49436 \'94 (\u50773 \u54616  6:17) \u46972 \u44256  \u44592 \u46020 \u54616 \u50688 \u45796 . \u44536  \u46412 \u50640  \u44536  \u49328 \u51008  \u48520 \u47568 \u44284  \u48520 \u48337 \u44144 \u47196  \u44032 \u46301  \u52264  \u51080 \u50632 \u44256  \u54616 \u45720 \u51032  \u44400 \u49324 \u44032  \u54616 \u45208 \u45784 \u51032  \u49324 \u46988 \u51012  \u46168 \u47084  \u51652  \u52432  \u51080 \u45716  \u44163 \u51012  \u48372 \u44172  \u46104 \u50632 \u45796 . \u51060 \u50752  \u44057 \u51060  \u54616 \u45208 \u45784 \u51032  \u52380 \u49324 \u46308 \u51008  \u44060 \u54785  \u49324 \u50629 \u50640  \u51333 \u49324 \u54616 \u45716  \u50669 \u44400 \u46308 \u51012  \u51648 \u53412 \u49512 \u45796 .\
