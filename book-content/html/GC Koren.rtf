\f1\b0 \cf0 \
\uc0\u51060 \u47111 \u44172  \u50836 \u44396 \u54632 \u51004 \u47196 , \u47336 \u53552 \u45716  \u51648 \u54812 \u47213 \u44172  \u52376 \u49888 \u54616 \u50688 \u45796 . \u44536 \u51032  \u54665 \u50948 \u45716  \u44144 \u44592  \u47784 \u51064  \u49324 \u46988 \u46308 \u47196  \u54616 \u50668 \u44552  \u44536 \u44032  \u44048 \u51221 \u51060 \u45208  \u51068 \u49884 \u51201  \u52649 \u46041 \u51004 \u47196  \u50880 \u51649 \u51060 \u51648  \u50506 \u50520 \u45796 \u45716  \u44163 \u51012  \u54869 \u49888 \u54616 \u44172  \u54616 \u50688 \u45796 . \u44536 \u50752  \u44057 \u51008  \u52840 \u52265 \u49457 \u44284  \u51088 \u51228 \u47141 \u51008  \u45824 \u45812 \u54616 \u44256  \u48708 \u53440 \u54801 \u51201 \u51064  \u44536 \u50640 \u44172 \u49436  \u51204 \u54784  \u44592 \u45824 \u54616 \u51648  \u47803 \u54616 \u50688 \u45912  \u44163 \u51060 \u45796 . \u44536 \u44163 \u51060  \u44536 \u50640 \u44172  \u55192 \u51012  \u45908 \u54616 \u50668  \u45208 \u51473 \u50640 \u45716  \u44536 \u47196  \u54616 \u50668 \u44552  \u49888 \u51473 \u54616 \u44256  \u44284 \u45800 \u49457  \u51080 \u44256 , \u51648 \u54812 \u47213 \u44256 , \u44428 \u50948  \u51080 \u44172  \u45824 \u45813 \u54624  \u49688  \u51080 \u44172  \u54616 \u50688 \u51004 \u47728 , \u50896 \u49688 \u46308 \u46020  \u45440 \u46972 \u44256  \u49892 \u47581 \u54616 \u44172  \u46104 \u50632 \u51004 \u47728 , \u44536 \u46308 \u51032  \u50724 \u47564 \u54616 \u44256  \u48520 \u49692 \u54620  \u53468 \u46020 \u47484  \u44204 \u52293  \u48155 \u44172  \u46104 \u50632 \u45796 .\
\uc0\u51060 \u53951 \u45216  \u44536 \u45716  \u52572 \u54980 \u51032  \u45813 \u48320 \u51012  \u54616 \u44592  \u50948 \u54616 \u50668  \u54924 \u51032 \u51109 \u50640  \u45208 \u50500 \u44032 \u50556  \u54664 \u45796 . \u51104 \u49884  \u46041 \u50504  \u44536 \u45716  \u51652 \u47532 \u47484  \u45824 \u54637 \u54616 \u50668  \u50672 \u54633 \u46108  \u49464 \u47141 \u51012  \u49373 \u44033 \u54644  \u48380  \u46412 , \u47560 \u51020 \u49549 \u50640 \u49436 \u48512 \u53552  \u50857 \u44592 \u44032  \u44734 \u50688 \u45796 . \u44536 \u51032  \u49888 \u50521 \u51008  \u55124 \u46308 \u47160 \u44256 , \u46160 \u47140 \u50892  \u46504 \u50632 \u51004 \u47728 , \u44536 \u45716  \u44277 \u54252 \u50640  \u50613 \u45580 \u47532 \u44172  \u46104 \u50632 \u45796 . \u50668 \u47084  \u44032 \u51648  \u50948 \u54744 \u51060  \u44536 \u51032  \u50526 \u50640  \u45208 \u53440 \u45228 \u44256 , \u50896 \u49688 \u46308 \u51060  \u49849 \u47532 \u54616 \u44256 , \u50516 \u55121 \u51032  \u44428 \u50948 \u44032  \u51060 \u44600  \u44163 \u52376 \u47100  \u48372 \u50688 \u45796 . \u44160 \u51008  \u44396 \u47492 \u51060  \u44536 \u47484  \u46168 \u47084 \u49932 \u44256 , \u44536 \u47484  \u54616 \u45208 \u45784 \u44760 \u47196 \u48512 \u53552  \u48516 \u47532 \u49884 \u53412 \u45716  \u46319 \u54616 \u50688 \u45796 . \u44536  \u46412 \u50640  \u44536 \u45716  \u47564 \u50976 \u51032  \u51452 \u44760 \u49436  \u51088 \u44592 \u50752  \u54632 \u44760  \u54616 \u49888 \u45796 \u45716  \u48372 \u51613 \u51012  \u50619 \u44256 \u51088  \u44040 \u47581 \u54616 \u50688 \u45796 . \u44536 \u45716  \u47560 \u51020 \u51032  \u44340 \u47196 \u50880 \u51012  \u50504 \u44256  \u50620 \u44404 \u51012  \u46405 \u50640  \u45824 \u44256  \u50638 \u46300 \u47160 \u45796 . \u44536 \u45716  \u52285 \u51088 \u44032  \u45130 \u50612 \u51648 \u45716  \u46319 \u54620  \u48512 \u47476 \u51670 \u51020 , \u54616 \u45208 \u45784  \u51060 \u50808 \u50640 \u45716  \u50500 \u47924 \u46020  \u50508  \u49688  \u50630 \u45716  \u48512 \u47476 \u51670 \u51020 \u51012  \u53664 \u47196 \u54616 \u50688 \u45796 .\
\'93\uc0\u50724 \u50724 ! \u51204 \u45733 \u54616 \u49884 \u44256  \u50689 \u50896 \u54616 \u49888  \u54616 \u45208 \u45784 \u51060 \u49884 \u50668 ! \u51060  \u49464 \u49345 \u51060  \u50620 \u47560 \u45208  \u47924 \u49453 \u49845 \u45768 \u44620 ? \u49464 \u49345 \u51008  \u51077 \u51012  \u48268 \u47532 \u44256  \u51060  \u51333 \u51012  \u49340 \u53412 \u47140 \u44256  \u45804 \u47140 \u46317 \u45768 \u45796 . \u44536 \u47084 \u45208  \u51060  \u51333 \u51060  \u45817 \u49888 \u51012  \u48127 \u45716  \u48127 \u51020 \u51008  \u45320 \u47924 \u45208  \u48120 \u50557 \u54633 \u45768 \u45796 . \u47564 \u51068  \u51060  \u51333 \u51060  \u49888 \u47280 \u54624  \u44163 \u51060  \u51060  \u49464 \u49345 \u51032  \u55192 \u49104 \u51060 \u46972 \u47732 , \u47784 \u46304  \u44163 \u51008  \u45149 \u45228 \u49845 \u45768 \u45796 . \'85 \u51333 \u51032  \u52572 \u54980 \u51032  \u49884 \u44036 \u51008  \u45796 \u44032 \u50772 \u49845 \u45768 \u45796 . \u51060 \u48120  \u51333 \u51008  \u51221 \u51396 \u51032  \u49440 \u44256 \u47484  \u48155 \u50520 \u49845 \u45768 \u45796 . \'85 \u50724 \u50724 ! \u54616 \u45208 \u45784 \u51060 \u49884 \u50668 ! \u49464 \u49345 \u51032  \u50728 \u44054  \u51648 \u54812 \u47484  \u45824 \u54637 \u54616 \u44256  \u51080 \u45716  \u51060  \u51333 \u51012  \u46020 \u50752 \u51452 \u49884 \u50741 \u49548 \u49436 . \u50724 \u51649  \u45817 \u49888 \u47564 \u51060  \u46020 \u50752 \u51452 \u49892  \u49688  \u51080 \u45716  \u50976 \u51068 \u51032  \u48516 \u51060 \u49901 \u45768 \u45796 . \u51060 \u44163 \u51008  \u51333 \u51032  \u49324 \u50629 \u51060  \u50500 \u45768 \u50836  \u45817 \u49888 \u51032  \u49324 \u50629 \u51077 \u45768 \u45796 . \u51333 \u51008  \u50500 \u47924 \u44163 \u46020  \u54624  \u49688  \u50630 \u49845 \u45768 \u45796 . \u51060  \u49464 \u49345 \u51032  \u44428 \u47141 \u51088 \u46308 \u44284  \u45796 \u53812  \u49688 \u44032  \u50630 \u49845 \u45768 \u45796 . \'85\u44536 \u47084 \u45208  \u51060  \u49324 \u50629 \u51008  \u45817 \u49888 \u51032  \u49324 \u50629 \u51060 \u47728  \u51032 \u47213 \u44256  \u50689 \u50896 \u54620  \u49324 \u50629 \u51077 \u45768 \u45796 . \u50724 \u50724 ! \u51452 \u50668 ! \u45208 \u47484  \u46020 \u50752 \u51452 \u49884 \u50741 \u49548 \u49436 . \u51652 \u49892 \u54616 \u44256  \u50689 \u50896 \u54616 \u49888  \u54616 \u45208 \u45784 \u51060 \u50668 ! \u51333 \u51008  \u51060 \u51228  \u50612 \u46496 \u54620  \u49324 \u46988 \u51060 \u46972 \u46020  \u49888 \u47280 \u54616 \u51648  \u50506 \u44192 \u45208 \u51060 \u45796 . \u49324 \u46988 \u50640 \u44172  \u49549 \u54620  \u44163 \u51008  \u47784 \u46160  \u51221 \u54632 \u51060  \u50630 \u44256 , \u49324 \u46988 \u51004 \u47196  \u47568 \u48120 \u50516 \u50500  \u50724 \u45716  \u44163 \u51008  \u47784 \u46160  \u47924 \u45320 \u51648 \u44256  \u47577 \u45768 \u45796 . \'85\u45817 \u49888 \u44760 \u49436  \u51060  \u49324 \u50629 \u51012  \u50948 \u54616 \u50668  \u45208 \u47484  \u53469 \u54616 \u49512 \u45208 \u51060 \u45796 . \'85\u45208 \u51032  \u44225 \u50640  \u49436  \u51452 \u50741 \u49548 \u49436 . \u45208 \u51032  \u55192 , \u45208 \u51032  \u48169 \u54056 , \u45208 \u51032  \u47581 \u45824 \u51060 \u49888  \u45817 \u49888 \u51032  \u49324 \u46993 \u54616 \u49884 \u45716  \u50500 \u46308  \u50696 \u49688  \u44536 \u47532 \u49828 \u46020 \u51032  \u51060 \u47492 \u51004 \u47196  \u44592 \u46020 \u54633 \u45768 \u45796 \'94 (D\'92Aubigne, b.7, ch.8).\
\uc0\u47924 \u54620 \u55176  \u51648 \u54812 \u47196 \u50864 \u49888  \u54616 \u45208 \u45784 \u51032  \u49453 \u47532 \u45716  \u47336 \u53552 \u50640 \u44172  \u51088 \u49888 \u51032  \u50948 \u54744 \u51012  \u44648 \u45803 \u44172  \u54644 \u51452 \u49512 \u44256 , \u44536 \u47196  \u54616 \u50668 \u44552  \u51088 \u44592 \u51032  \u55192 \u51012  \u51032 \u47280 \u54616 \u51648  \u50506 \u44172  \u54616 \u49884 \u48064 \u47196  \u47924 \u47784 \u54616 \u44172  \u50948 \u54744  \u49549 \u51004 \u47196  \u46832 \u50612 \u46308 \u51648  \u47803 \u54616 \u44172  \u54616 \u49512 \u45796 . \u44536 \u47084 \u45208  \u44536 \u44032  \u44277 \u54252 \u50640  \u45580 \u47532 \u44172  \u46108  \u44163 \u51008  \u51593 \u49884 \u47196  \u45796 \u44032 \u50732  \u44163 \u52376 \u47100  \u48372 \u51060 \u45716  \u51088 \u49888 \u51032  \u44256 \u45212 \u44284  \u44256 \u47928 \u44284  \u51453 \u51020 \u51032  \u46160 \u47140 \u50880  \u46412 \u47928 \u51060  \u50500 \u45768 \u50632 \u45796 . \u44536 \u45716  \u50948 \u44592 \u47484  \u45817 \u47732 \u54616 \u50668 \u49436  \u44536 \u44163 \u51012  \u45824 \u54637 \u54616 \u45716  \u45936  \u51088 \u44592 \u51032  \u55192 \u51060  \u45320 \u47924 \u46020  \u48120 \u50557 \u54620  \u44163 \u51012  \u45712 \u44808 \u45912  \u44163 \u51060 \u45796 . \u51088 \u44592 \u51032  \u50672 \u50557 \u54632  \u46412 \u47928 \u50640  \u51652 \u47532 \u51032  \u49324 \u50629 \u51060  \u54056 \u48176 \u45817 \u54624 \u44620  \u46160 \u47140 \u50892 \u54620  \u44163 \u51060 \u50632 \u45796 . \u51088 \u49888 \u51032  \u50504 \u51204 \u51012  \u50948 \u54644 \u49436 \u44032  \u50500 \u45768 \u46972  \u48373 \u51020 \u51032  \u49849 \u47532 \u47484  \u50948 \u54616 \u50668  \u44536 \u45716  \u54616 \u45208 \u45784 \u44284  \u50472 \u47492 \u54616 \u50688 \u45796 . \u48164 \u51473 \u50640  \u50424 \u50424 \u54620  \u49884 \u45255 \u44032 \u50640 \u49436  \u53804 \u51137 \u54624  \u46412  \u51060 \u49828 \u46972 \u50648 \u51060  \u45712 \u44808 \u45912  \u44163 \u44284  \u44057 \u51008  \u44256 \u48124 \u44284  \u44040 \u46321 \u51060  \u44536 \u51032  \u47560 \u51020 \u49549 \u50640  \u52649 \u47564 \u54616 \u50688 \u45796 . \u51060 \u49828 \u46972 \u50648 \u52376 \u47100  \u44536 \u46020  \u54616 \u45208 \u45784 \u51012  \u51060 \u44220 \u45796 . \u50756 \u51204 \u54620  \u51208 \u47581  \u44032 \u50868 \u45936 \u49436  \u44536 \u45716  \u48127 \u51020 \u51004 \u47196  \u51204 \u45733 \u54616 \u49888  \u44396 \u50896 \u51088  \u44536 \u47532 \u49828 \u46020 \u47484  \u44403 \u44172  \u48537 \u46308 \u50632 \u45796 . \u44536 \u51032  \u47560 \u51020 \u51008  \u44536 \u44032  \u45800 \u46021 \u51004 \u47196  \u51032 \u54924 \u50640  \u52636 \u46160 \u54616 \u51648  \u50506 \u45716 \u45796 \u45716  \u48372 \u51613 \u51004 \u47196  \u44403 \u49464 \u50612 \u51276 \u45796 . \u44536 \u51032  \u47560 \u51020 \u49549 \u50640 \u45716  \u54217 \u50504 \u51060  \u44611 \u46308 \u50632 \u51004 \u47728 , \u44536 \u45716  \u44256 \u44288 \u46308 \u44284  \u51228 \u54980 \u46308  \u50526 \u50640 \u49436  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51012  \u45458 \u51068  \u49688  \u51080 \u46020 \u47197  \u54728 \u46973 \u51012  \u48155 \u51008  \u44163 \u51012  \u44592 \u48848 \u54616 \u44172  \u46104 \u50632 \u45796 .\
\uc0\u47336 \u53552 \u45716  \u54616 \u45208 \u45784 \u51012  \u51204 \u49900 \u51004 \u47196  \u49888 \u47280 \u54616 \u47732 \u49436  \u51088 \u44592 \u50640 \u44172  \u45796 \u44032 \u50724 \u44256  \u51080 \u45716  \u53804 \u51137 \u51012  \u50948 \u54616 \u50668  \u51456 \u48708 \u54616 \u50688 \u45796 . \u44536 \u45716  \u45824 \u45813 \u54624  \u44228 \u54925 \u51012  \u49373 \u44033 \u54616 \u44256 , \u51088 \u44592 \u51032  \u51200 \u49436 \u46308 \u50640  \u51080 \u45716  \u44396 \u51208 \u46308 \u51012  \u44160 \u53664 \u54616 \u44256 , \u49457 \u44221 \u50640 \u49436  \u44536 \u51032  \u51452 \u51109 \u51012  \u51077 \u51613 \u54616 \u44256  \u51648 \u51648 \u54624  \u47564 \u54620  \u51201 \u45817 \u54620  \u44396 \u51208 \u46308 \u51012  \u48977 \u50520 \u45796 . \u44536  \u54980 \u50640  \u44536 \u45716  \u51088 \u44592  \u50526 \u50640  \u54204 \u52432 \u51256  \u51080 \u45716  \u49457 \u44221  \u50948 \u50640  \u50812 \u49552 \u51012  \u50617 \u44256 , \u50724 \u47480 \u49552 \u51012  \u45458 \u51060  \u52432 \u46308 \u50612  \'93\u48708 \u47197  \u51613 \u44144 \u47484  \u50948 \u54616 \u50668  \u45208 \u51032  \u54588 \u47484  \u55128 \u47532 \u45716  \u54620 \u51060  \u51080 \u45908 \u46972 \u46020  \u48373 \u51020 \u51012  \u50948 \u54616 \u50668  \u45149 \u44620 \u51648  \u52649 \u49457 \u51012  \u45796 \u54616 \u44256 , \u45208 \u51032  \u49888 \u50521 \u51012  \u44144 \u47532 \u45196  \u50630 \u51060  \u44256 \u48177 \u54616 \u44192 \u45432 \u46972 \'94 (D\'92Aubigne, b.7, ch.8) \u44256  \u47609 \u49464 \u54616 \u50688 \u45796 .\
