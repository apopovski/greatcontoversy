\uc0\u54620  \u48264 \u51008  \u47196 \u47560 \u44368 \u44032  \u44536  \u48120 \u50892 \u54616 \u45716  \u51333 \u54028 \u47484  \u44540 \u51208 \u54616 \u44592 \u47196  \u44208 \u51221 \u54616 \u50688 \u51012  \u46412  \u44536 \u46308 \u51012  \u51060 \u45800 \u51004 \u47196  \u51221 \u51396 \u54616 \u50668  \u49332 \u50977 \u50640  \u45236 \u50612  \u51456 \u45796 \u45716  \u54252 \u44256  (\u24067 \u21578 ) \u44032  \u48277 \u50773 \u51004 \u47196  \u47568 \u48120 \u50516 \u50500  \u44256 \u49884  (\u21578 \u31034 ) \u46104 \u50632 \u45796  (\u48512 \u47197  13 \u52280 \u51312 ). \u44536 \u46308 \u51008  \u44172 \u51004 \u47476 \u44144 \u45208  \u48512 \u51221 \u51649 \u54616 \u44144 \u45208  \u51656 \u49436 \u47484  \u47928 \u46976 \u52992  \u54620 \u45796 \u45716  \u51396 \u47196  \u44256 \u49548 \u46104 \u51648  \u50500 \u45768 \u54616 \u44256 , \u46020 \u47532 \u50612  \u50808 \u47784 \u47196 \u45716  \u44221 \u44148 \u54616 \u44256  \u49457 \u44208 \u54620  \u52404 \u54616 \u47732 \u49436  \u49892 \u49345 \u51008  \'93\u52280 \u46108  \u50577 \u50864 \u47532 \u51032  \u50577 \u51012  \u49549 \u51060 \u45716  \u51088 \u46308 \'94\u51060 \u46972 \u44256  \u51221 \u51396 \u46104 \u50632 \u45796 . \u44536 \u47084 \u48064 \u47196  \u48277 \u50773 \u51008  \u44536  \u50976 \u54644 \u54616 \u44256  \u55113 \u50501 \u54616 \u50668  \u51613 \u50724 \u54624  \u47564 \u54620  \u51333 \u54028 \u44032  \u44536 \u46308 \u51032  \u49888 \u50521 \u51012  \u54252 \u44592 \u54616 \u44592 \u47484  \u44144 \u51208 \u54620 \u45796 \u47732  \'93\u46021 \u49324 \u52376 \u47100  \u51667 \u51060 \u44200  \u51453 \u51060 \u46972 \'94 (Wylie, b.16, ch.1) \u44256  \u47749 \u47161 \u54616 \u50688 \u45796 . \u51060  \u44144 \u47564 \u54620  \u44428 \u47141 \u51088 \u44032  \u51088 \u44592 \u44032  \u54620  \u47568 \u51012  \u45796 \u49884  \u49373 \u44033 \u54624  \u46412 \u44032  \u50732  \u44163 \u51060 \u46972 \u44256  \u50696 \u44592 \u54616 \u50688 \u51012 \u44620 ? \u44536  \u47568 \u46308 \u51060  \u54616 \u45720  \u52293 \u50640  \u44592 \u47197 \u46104 \u44256 , \u49900 \u54032  \u45216 \u50640  \u51396 \u51613  (\u32618 \u35657 ) \u51004 \u47196  \u44536 \u51032  \u50526 \u50640  \u51228 \u49884 \u46104 \u47532 \u46972 \u45716  \u44163 \u51012  \u50508 \u50520 \u51012 \u44620 ? \'93\u45236 \u44032  \u51652 \u49892 \u47196  \u45320 \u55148 \u50640 \u44172  \u51060 \u47476 \u45432 \u45768  \u45320 \u55148 \u44032  \u50668 \u44592  \u45236  \u54805 \u51228  \u51473 \u50640  \u51648 \u44537 \u55176  \u51089 \u51008  \u51088  \u54616 \u45208 \u50640 \u44172  \u54620  \u44163 \u51060  \u44263  \u45236 \u44172  \u54620  \u44163 \u51060 \u45768 \u46972 \'94 (\u47560  25:40) \u44256  \u50696 \u49688 \u45784 \u44760 \u49436 \u45716  \u47568 \u50432 \u54616 \u49512 \u45796 .\
\uc0\u51060  \u54252 \u44256 \u45716  \u44368 \u54924 \u51032  \u47784 \u46304  \u44368 \u51064 \u46308 \u50640 \u44172  \u51060 \u45800 \u51012  \u53664 \u48268 \u54616 \u45716  \u49901 \u51088 \u44400 \u50640  \u52280 \u44032 \u54616 \u46020 \u47197  \u50836 \u44396 \u54616 \u50688 \u45796 . \u51060  \u51092 \u51064 \u54620  \u51068 \u50640  \u44032 \u45812 \u49884 \u53412 \u44592  \u50948 \u54616 \u50668  \u45796 \u51020 \u44284  \u44057 \u51008  \u53945 \u44428 \u51060  \u51228 \u49884 \u46104 \u50632 \u45796 . \'93\u49901 \u51088 \u44400 \u50640  \u52280 \u44032 \u54620  \u51088 \u46308 \u51008  \u51068 \u48152 \u51201 \u51060 \u44144 \u45208  \u53945 \u49688 \u54620  \u44163 \u51012  \u47561 \u47200 \u54616 \u44256  \u50728 \u44054  \u51333 \u44368 \u51201  \u54805 \u48268 \u50640 \u49436  \u47732 \u51396 \u46104 \u44256 , \u47560 \u46405 \u55176  \u54665 \u54616 \u44592 \u47196  \u49440 \u49436 \u54620  \u44163 \u46308 \u46020  \u47732 \u51228 \u46104 \u44256 , \u48708 \u54633 \u48277 \u51201 \u51004 \u47196  \u50619 \u51008  \u50612 \u46500  \u51116 \u49328 \u46020  \u54633 \u48277 \u51201 \u51004 \u47196  \u51064 \u51221 \u46104 \u44256 , \u51060 \u45800 \u51088 \u46308 \u51012  \u51453 \u51060 \u45716  \u44536  \u51068 \u50640  \u44032 \u45812 \u54632 \u51004 \u47196  \u47784 \u46304  \u51396 \u50640 \u49436  \u49324 \u50976 \u54632 \u51012  \u48155 \u45716 \u45796 \u44256  \u48372 \u51613 \u46104 \u50632 \u45796 . \u44536 \u44163 \u51008  \u48372 \u50864 \u46020 \u48400 \u51064 \u46308 \u50640 \u44172  \u50976 \u47532 \u54616 \u46020 \u47197  \u52404 \u44208 \u46108  \u47784 \u46304  \u44228 \u50557 \u51012  \u52712 \u49548 \u52992  \u54616 \u44256 , \u44536 \u46308 \u51032  \u51333 \u51060  \u46104 \u50632 \u45912  \u51088 \u46308 \u51008  \u44536  \u49345 \u51204 \u51032  \u51665 \u51012  \u45208 \u44032 \u44172  \u54616 \u44256 , \u45572 \u44396 \u46304 \u51648  \u44536 \u46308 \u51012  \u46020 \u50752 \u51452 \u45716  \u51068 \u51012  \u44552 \u51648 \u54616 \u50688 \u44256 , \u50500 \u47924 \u45208  \u44536 \u46308 \u51032  \u49548 \u50976 \u47932 \u51012  \u48764 \u50519 \u51012  \u49688  \u51080 \u44172  \u54728 \u46973 \u54616 \u50688 \u45796 \'94 (Wylie, b.16, ch.1). \u51060  \u44592 \u47197 \u51008  \u44536  \u48176 \u54980 \u50640 \u49436  \u51312 \u51333 \u54616 \u45716  \u51088 \u44032  \u45572 \u44396 \u51076 \u51012  \u48516 \u47749 \u55176  \u45208 \u53440 \u45236  \u51456 \u45796 . \u44536  \u49549 \u50640 \u49436  \u46308 \u47140 \u50724 \u45716  \u49548 \u47532 \u45716  \u50696 \u49688 \u45784 \u51032  \u51020 \u49457 \u51060  \u50500 \u45768 \u44256  \u48516 \u45432 \u54620  \u50857 \u51032  \u48512 \u47476 \u51670 \u51020 \u51060 \u45796 .\
\uc0\u48277 \u50773 \u44368 \u51032  \u51648 \u46020 \u51088 \u46308 \u51008  \u44536 \u46308 \u51032  \u54408 \u49457 \u51012  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51032  \u53360  \u54364 \u51456 \u50640  \u47582 \u52628 \u47140 \u44256  \u54616 \u51648  \u50500 \u45768 \u54616 \u44256  \u44536 \u46308 \u50640 \u44172  \u51201 \u54633 \u54620  \u45796 \u47480  \u54364 \u51456 \u51012  \u47564 \u46308 \u50632 \u51004 \u47728  \u47196 \u47560 \u44368 \u44032  \u54616 \u44256 \u51088  \u54616 \u45716  \u45824 \u47196  \u47784 \u46304  \u49324 \u46988 \u46308 \u46020  \u44536  \u54364 \u51456 \u50640  \u47582 \u52628 \u50612 \u50556  \u54620 \u45796 \u44256  \u44053 \u50836 \u54616 \u50688 \u45796 . \u51060 \u47196  \u51064 \u54616 \u50668  \u44032 \u51109  \u47924 \u49436 \u50868  \u48708 \u44537 \u51060  \u50672 \u52636 \u46104 \u50632 \u45796 . \u53440 \u46973 \u54616 \u44256  \u52280 \u46988 \u46108  \u49888 \u48512 \u46308 \u44284  \u48277 \u50773 \u46308 \u51008  \u49324 \u45800 \u51060  \u44536 \u46308 \u50640 \u44172  \u51648 \u51221 \u54644  \u51456  \u44536  \u51068 \u51012  \u54616 \u44256  \u51080 \u50632 \u45796 . \u44536 \u46308 \u51032  \u54408 \u49457  \u44032 \u50868 \u45936 \u45716  \u51088 \u48708 \u44032  \u50857 \u45225 \u46112  \u53960 \u51060  \u50630 \u50632 \u45796 . \u44536 \u47532 \u49828 \u46020 \u47484  \u49901 \u51088 \u44032 \u50640  \u47803  \u48149 \u44256  \u44536 \u48516 \u51032  \u51228 \u51088 \u46308 \u51012  \u49332 \u50977 \u54620  \u48148 \u47196  \u44536  \u51221 \u49888 , \u44536 \u47532 \u44256  \u54588 \u50640  \u44406 \u51452 \u47536  \u45348 \u47196 \u44032  \u44536  \u45817 \u49884 \u51032  \u49888 \u49892 \u54620  \u44536 \u47532 \u49828 \u46020 \u51064 \u46308 \u50640 \u44172  \u45208 \u53440 \u45256 \u45912  \u48148 \u47196  \u44536  \u51221 \u49888 \u51060  \u54616 \u45208 \u45784 \u51032  \u49324 \u46993 \u48155 \u45716  \u49324 \u46988 \u46308 \u51012  \u51060  \u51648 \u49345 \u50640 \u49436  \u51228 \u44144 \u54644  \u48260 \u47532 \u45716  \u51068 \u50640  \u45208 \u53440 \u45228 \u45796 .\
\uc0\u54616 \u45208 \u45784 \u51012  \u44221 \u50808 \u54616 \u45716  \u48177 \u49457 \u46308 \u51008  \u44536 \u46308 \u50640 \u44172  \u48120 \u52828  \u50668 \u47084  \u49464 \u44592 \u51032  \u48149 \u54644 \u47484  \u44536 \u46308 \u51032  \u44396 \u50896 \u51032  \u51452 \u47484  \u50689 \u54868 \u47213 \u44172  \u54620  \u51064 \u45236 \u50752  \u49457 \u49892 \u47196  \u44204 \u46356 \u50632 \u45796 . \u44536 \u46308 \u51008  \u53664 \u48268 \u51012  \u45817 \u54616 \u50668  \u48708 \u51064 \u46020 \u51201 \u51064  \u54617 \u49332 \u51012  \u45817 \u54616 \u50688 \u51020 \u50640 \u46020  \u48520 \u44396 \u54616 \u44256 , \u44480 \u51473 \u54620  \u51652 \u47532 \u47484  \u49440 \u54252 \u54616 \u44592  \u50948 \u54616 \u50668  \u51204 \u46020 \u51088 \u47484  \u54028 \u44204 \u54616 \u45716  \u51068 \u51012  \u44536 \u52824 \u51648  \u50500 \u45768 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u51105 \u54784 \u49436  \u51453 \u51076 \u51012  \u45817 \u54616 \u50688 \u51004 \u45208  \u46020 \u47532 \u50612  \u44536 \u46308 \u51032  \u54588 \u45716  \u51060 \u48120  \u49100 \u47536  \u50472 \u50640  \u47932 \u51012  \u51452 \u44172  \u46104 \u50612  \u44208 \u49892 \u51012  \u44032 \u51256 \u45796 \u51452 \u50632 \u45796 . \u51060 \u50752  \u44057 \u51060  \u50760 \u45940 \u49828 \u51064 \u46308 \u51008  \u47336 \u53552 \u44032  \u45208 \u44592  \u49688 \u49464 \u44592  \u51204 \u50640  \u54616 \u45208 \u45784 \u51012  \u50948 \u54616 \u50668  \u51613 \u44144 \u54616 \u50688 \u45796 . \u50668 \u47084  \u45208 \u46972 \u47196  \u55145 \u50612 \u51652  \u44536 \u46308 \u51008  \u50948 \u53364 \u47532 \u54532  \u49884 \u45824 \u50640  \u49884 \u51089 \u46108  \u51333 \u44368 \u44060 \u54785 \u51032  \u50472 \u47484  \u49100 \u47160 \u45716 \u45936 , \u44536  \u50868 \u46041 \u51008  \u47336 \u53552  \u49884 \u45824 \u50640  \u51060 \u47476 \u47084  \u54620 \u52789  \u45908  \u44618 \u44256  \u45331 \u44172  \u51088 \u46972 \u45228 \u51004 \u47728 , \'93\u54