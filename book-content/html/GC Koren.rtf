\uc0\u44536 \u47084 \u45208  \u51060 \u46412 \u51032  \u49892 \u47581 \u51008  \u44536 \u47532 \u49828 \u46020 \u51032  \u52488 \u47548  \u45817 \u49884 \u50640  \u51228 \u51088 \u46308 \u51060  \u44221 \u54744 \u54620  \u44163 \u47564 \u53372  \u53360  \u44163 \u51008  \u50500 \u45768 \u50632 \u45796 . \u50696 \u49688 \u45784 \u44760 \u49436  \u50696 \u47336 \u49332 \u47128 \u50640  \u45817 \u45817 \u54616 \u44172  \u51077 \u49457 \u51012  \u54616 \u49888  \u46412 \u50640  \u51228 \u51088 \u46308 \u51008  \u51452 \u45784 \u44760 \u49436  \u48120 \u44396 \u50640  \u45796 \u50967 \u51032  \u48372 \u51340 \u50640  \u51593 \u50948 \u54616 \u49884 \u44256  \u51060 \u49828 \u46972 \u50648  \u48124 \u51313 \u51012  \u50517 \u51228 \u51088 \u46308 \u51032  \u49552 \u50640 \u49436  \u44396 \u50896 \u54644  \u45236 \u49892  \u44163 \u51004 \u47196  \u48127 \u50632 \u45796 . \u44536 \u46308 \u51008  \u55148 \u47581 \u44284  \u50689 \u44305 \u49828 \u47084 \u50868  \u44592 \u45824 \u47484  \u44032 \u51648 \u44256  \u49436 \u47196  \u45796 \u53804 \u50612  \u44536  \u50773 \u44760  \u44221 \u51032 \u47484  \u54364 \u54616 \u50688 \u45796 . \u47566 \u51008  \u49324 \u46988 \u46308 \u51008 , \u44536 \u46308 \u51032  \u51032 \u48373 \u51012  \u51452 \u45784 \u44760 \u49436  \u44152 \u50612 \u44032 \u49884 \u45716  \u44600 \u50640  \u44628 \u44256 , \u47924 \u49457 \u54620  \u51333 \u47140 \u45208 \u47924  \u44032 \u51648 \u47484  \u55124 \u46308 \u50632 \u45796 . \u44536 \u46308 \u51008  \u50676 \u47148 \u54620  \u44592 \u49256 \u51004 \u47196  \'93\u54840 \u49328 \u45208  \u45796 \u50967 \u51032  \u51088 \u49552 \u51060 \u50668  \u52268 \u49569 \u54616 \u47532 \u47196 \u45796 \'94\u44256  \u50808 \u52452 \u45796 . \u51060 \u50752  \u44057 \u51008  \u44592 \u49256 \u51032  \u54364 \u54788 \u51012  \u48372 \u44256  \u54868 \u44032  \u45208 \u44256  \u45212 \u52376 \u54644 \u51652  \u48148 \u47532 \u49352 \u51064 \u46308 \u51060  \u51228 \u51088 \u46308 \u51012  \u44984 \u51670 \u50612  \u45804 \u46972 \u44256  \u50696 \u49688 \u45784 \u44760  \u50836 \u44396 \u54616 \u50688 \u51012  \u46412 , \u51452 \u45784 \u44760 \u49436 \u45716  \'93\u47564 \u51068  \u51060  \u49324 \u46988 \u46308 \u51060  \u51104 \u51104 \u54616 \u47732  \u46028 \u46308 \u51060  \u49548 \u47532 \u51648 \u47476 \u47532 \u46972 \'94 (\u45573  19:40) \u44256  \u45824 \u45813 \u54616 \u49512 \u45796 . \u50696 \u50616 \u51008  \u49457 \u52712 \u46112  \u49688 \u48150 \u50640  \u50630 \u45796 . \u51228 \u51088 \u46308 \u51008  \u54616 \u45208 \u45784 \u51032  \u47785 \u51201 \u51012  \u49457 \u52712 \u54616 \u44256  \u51080 \u50632 \u51648 \u47564  \u44536 \u46308  \u50526 \u50640 \u45716  \u50416 \u46972 \u47536  \u49892 \u47581 \u51032  \u50868 \u47749 \u51060  \u44592 \u45796 \u47532 \u44256  \u51080 \u50632 \u45796 . \u47728 \u52832 \u51060  \u51648 \u45208 \u44036  \u54980  \u44536 \u46308 \u51008  \u44396 \u51452 \u44760 \u49436  \u44256 \u53685 \u51032  \u51453 \u51020 \u51012  \u45817 \u54616 \u49884 \u44256  \u47924 \u45924  \u49549 \u51004 \u47196  \u46308 \u50612 \u44032 \u49884 \u45716  \u44163 \u51012  \u48372 \u50520 \u45796 . \u44536 \u46308 \u51032  \u44592 \u45824 \u45716  \u45800  \u54616 \u45208 \u46020  \u49892 \u54788 \u46104 \u51648  \u47803 \u54616 \u44256 , \u44536 \u46308 \u51032  \u55148 \u47581 \u51008  \u50696 \u49688 \u45784 \u51032  \u51453 \u51020 \u44284  \u54632 \u44760  \u49324 \u46972 \u51276 \u45796 . \u44536 \u46308 \u51008  \u44396 \u51452 \u44760 \u49436  \u47924 \u45924 \u51012  \u51221 \u48373 \u54616 \u44256  \u48512 \u54876 \u54616 \u49884 \u51088  \u48708 \u47196 \u49548  \'93\u44536 \u47532 \u49828 \u46020 \u44032  \u54644 \u47484  \u48155 \u44256  \u51453 \u51008  \u51088  \u44032 \u50868 \u45936 \u49436  \u45796 \u49884  \u49332 \u50500 \u50556  \u54624  \u44163 \'94 (\u54665  17:3) \u51060 \u46972 \u44256  \u50696 \u50616 \u46104 \u50612  \u51080 \u45716  \u47784 \u46304  \u44163 \u51012  \u44648 \u45803 \u44172  \u46104 \u50632