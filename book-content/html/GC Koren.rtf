\uc0\u51060 \u50752  \u44057 \u51060  \u51088 \u44592  \u50526 \u50640  \u48516 \u47749 \u55176  \u47928 \u51228 \u44032  \u51228 \u49884 \u46104 \u50632 \u51020 \u50640 \u46020  \u48520 \u44396 \u54616 \u44256  \u49324 \u46988 \u51060  \u51221 \u54620  \u51228 \u46020 \u47484  \u46384 \u47476 \u44592  \u50948 \u54616 \u50668  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51012  \u48276 \u54616 \u45716  \u51088 \u45716  \u45572 \u44396 \u46304 \u51648  \u51664 \u49849 \u51032  \u54364 \u47484  \u48155 \u44172  \u46104 \u44256  \u44536 \u44032  \u54616 \u45208 \u45784  \u45824 \u49888 \u50640  \u49692 \u51333 \u54616 \u44592 \u47196  \u53469 \u54620  \u44536  \u49464 \u47141 \u50640  \u52649 \u49457 \u54616 \u45716  \u54364 \u47484  \u48155 \u44172  \u46108 \u45796 . \u51060 \u50640  \u45824 \u54620  \u54616 \u45720 \u51032  \u44221 \u44256 \u45716  \u45796 \u51020 \u44284  \u44057 \u45796 . \'93\u47564 \u51068  \u45572 \u44396 \u46304 \u51648  \u51664 \u49849 \u44284  \u44536 \u51032  \u50864 \u49345 \u50640 \u44172  \u44221 \u48176 \u54616 \u44256  \u51060 \u47560 \u50640 \u45208  \u49552 \u50640  \u54364 \u47484  \u48155 \u51004 \u47732  \u44536 \u46020  \u54616 \u45208 \u45784 \u51032  \u51652 \u45432 \u51032  \u54252 \u46020 \u51452 \u47484  \u47560 \u49884 \u47532 \u45768  \u44536  \u51652 \u45432 \u51032  \u51092 \u50640  \u49438 \u51064  \u44163 \u51060  \u50630 \u51060  \u48512 \u51008  \u54252 \u46020 \u51452 \u46972 \'94 (\u44228  14:9, 10).\
\uc0\u44536 \u47084 \u45208  \u51652 \u47532 \u44032  \u47560 \u51020 \u44284  \u50577 \u49900  \u49549 \u50640  \u48516 \u47749 \u55176  \u50508 \u47140 \u51648 \u44592  \u51204 \u50640 \u45716  \u50500 \u47924 \u46020  \u54616 \u45208 \u45784 \u51032  \u51652 \u45432 \u47484  \u48155 \u51648  \u50506 \u45716 \u45796 . \u45796 \u47564  \u51652 \u47532 \u47484  \u48516 \u47749 \u55176  \u50508 \u44256  \u44536 \u44163 \u51012  \u44144 \u51208 \u54624  \u46412  \u54616 \u45208 \u45784 \u51032  \u51652 \u45432 \u44032  \u48512 \u50612 \u51652 \u45796 . \u51060  \u49884 \u45824 \u47484  \u50948 \u54620  \u53945 \u48324 \u54620  \u51652 \u47532 \u47484  \u46308 \u51012  \u44592 \u54924 \u47484  \u44054 \u51648  \u47803 \u54616 \u45716  \u49324 \u46988 \u46308 \u51060  \u47566 \u51060  \u51080 \u45796 . \u45367 \u51704  \u44228 \u47749 \u50640  \u45824 \u54620  \u51032 \u47924 \u45716  \u44536 \u46308  \u50526 \u50640  \u51652 \u51221 \u54620  \u48731 \u51004 \u47196  \u44208 \u53076  \u51228 \u49884 \u46104 \u51648  \u50506 \u50520 \u45796 . \u47784 \u46304  \u49324 \u46988 \u51032  \u47560 \u51020 \u51012  \u50500 \u49884 \u47728  \u47784 \u46304  \u46041 \u44592 \u47484  \u54756 \u50500 \u47532 \u49884 \u45716  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u51652 \u47532 \u51032  \u51648 \u49885 \u51012  \u44040 \u47581 \u54616 \u45716  \u49324 \u46988 \u46308 \u51060  \u51060  \u53804 \u51137 \u51032  \u44228 \u51137 \u51216  (\u20418 \u29229 \u40670 ) \u50640  \u44288 \u54616 \u50668  \u44592 \u47564 \u45817 \u54616 \u46020 \u47197  \u48260 \u47140 \u46160 \u51648  \u50506 \u51004 \u49892  \u44163 \u51060 \u45796 . \u44536  \u48277 \u47161 \u51008  \u49324 \u46988 \u46308 \u50640 \u44172  \u47609 \u47785 \u51201 \u51004 \u47196  \u44053 \u50836 \u46104 \u51648 \u45716  \u50506 \u51012  \u44163 \u51060 \u45796 . \u44033  \u49324 \u46988 \u51008  \u54788 \u47749 \u54620  \u44208 \u51221 \u51012  \u54616 \u47532 \u47564 \u53372  \u52649 \u48516 \u54620  \u48731 \u51012  \u44054 \u44172  \u46112  \u44163 \u51060 \u45796 .\
\uc0\u50504 \u49885 \u51068 \u51008  \u52649 \u49457 \u51032  \u53360  \u49884 \u44552 \u49437 \u51060  \u46112  \u44163 \u51060 \u45796 . \u50780 \u45264 \u54616 \u47732  \u50504 \u49885 \u51068 \u51008  \u53945 \u48324 \u55176  \u53804 \u51137 \u51032  \u52488 \u51216 \u51060  \u46104 \u45716  \u51652 \u47532 \u44032  \u46104 \u44592  \u46412 \u47928 \u51060 \u45796 . \u49324 \u46988 \u46308 \u50640 \u44172  \u47560 \u51648 \u47561  \u49884 \u47144 \u51060  \u45797 \u52432 \u50732  \u46412  \u54616 \u45208 \u45784 \u51012  \u49452 \u44592 \u45716  \u49324 \u46988 \u46308 \u44284  \u49452 \u44592 \u51648  \u50500 \u45768 \u54616 \u45716  \u51088 \u46308 \u51012  \u44396 \u48324 \u54616 \u45716  \u49440 \u51060  \u44536 \u50612 \u51656  \u44163 \u51060 \u45796 . \u45367 \u51704  \u44228 \u47749 \u51012  \u51648 \u53412 \u45716  \u45824 \u49888 \u50640  \u44397 \u44032 \u51032  \u48277 \u47456 \u44284  \u51068 \u52824 \u46104 \u46020 \u47197  \u44144 \u51667  \u50504 \u49885 \u51068 \u51012  \u51648 \u53412 \u45716  \u44163 \u51008  \u54616 \u45208 \u45784 \u44284  \u48152 \u45824 \u46104 \u45716  \u49464 \u47141 \u50640  \u52649 \u49457 \u54616 \u45716  \u54364 \u44032  \u46104 \u45716  \u54620 \u54200 , \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51012  \u51335 \u50500  \u52280  \u50504 \u49885 \u51068 \u51012  \u51648 \u53412 \u45716  \u44163 \u51008  \u52285 \u51312 \u51452 \u44760  \u52649 \u49457 \u54616 \u45716  \u51613 \u44144 \u44032  \u46108 \u45796 . \u44536 \u47532 \u54616 \u50668  \u54620  \u44228 \u52789 \u51032  \u49324 \u46988 \u46308 \u51008  \u49464 \u49345 \u51032  \u49464 \u47141 \u50640  \u48373 \u51333 \u54616 \u45716  \u51064 \u51012  \u48155 \u51020 \u51004 \u47196 \u50024  \u51664 \u49849 \u51032  \u54364 \u47484  \u48155 \u45716  \u48152 \u47732 \u50640  \u45796 \u47480  \u54620  \u44228 \u52789 \u51032  \u49324 \u46988 \u46308 \u51008  \u54616 \u45208 \u45784 \u51032  \u44428 \u50948 \u50640  \u52649 \u49457 \u54616 \u45716  \u54364 