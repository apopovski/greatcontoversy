\uc0\u54616 \u45208 \u45784 \u44760 \u49436  \u44144 \u47337 \u54620  \u52380 \u49324 \u46308 \u51060  \u44277 \u51473 \u50640  \u45216 \u50500 \u44032 \u47732 \u49436  \u49440 \u54252 \u54616 \u45716  \u44163 \u51004 \u47196  \u45208 \u53440 \u45236 \u49884 \u47532  \u47564 \u53372  \u44536 \u47111 \u44172  \u51473 \u45824 \u54620  \u44221 \u44256 \u47484  \u49324 \u46988 \u46308 \u50640 \u44172  \u51452 \u49892  \u46412  \u44536 \u48516 \u44760 \u49436 \u45716  \u51060 \u49457 \u51012  \u44032 \u51652  \u47784 \u46304  \u49324 \u46988 \u51060  \u44536  \u44592 \u48324 \u50640  \u50976 \u51032 \u54616 \u44592 \u47484  \u48148 \u46972 \u49888 \u45796 . \u51664 \u49849 \u44284  \u44536 \u51032  \u50864 \u49345 \u50640 \u44172  \u44221 \u48176  (\u44228  14:9~11 \u52280 \u51312 ) \u54616 \u45716  \u51088 \u50640 \u44172  \u47924 \u49436 \u50868  \u49900 \u54032 \u51060  \u49440 \u44256 \u46104 \u50612  \u51080 \u51004 \u48064 \u47196  \u47784 \u46304  \u49324 \u46988 \u51008  \u51664 \u49849 \u51032  \u54364 \u44032  \u47924 \u50631 \u51060 \u47728  \u50612 \u46523 \u44172  \u44536 \u44163 \u51012  \u48155 \u51648  \u50506 \u44256  \u54588 \u54624  \u49688  \u51080 \u51012  \u44163 \u51064 \u51648  \u50508 \u44592  \u50948 \u54616 \u50668  \u50696 \u50616 \u51012  \u48512 \u51648 \u47088 \u55176  \u50672 \u44396 \u54616 \u46020 \u47197  \u51648 \u46020 \u46104 \u50612 \u50556  \u54620 \u45796 . \u44536 \u47084 \u45208  \u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u44536 \u46308 \u51032  \u44480 \u47484  \u46028 \u47140  \u51652 \u47532 \u47484  \u46307 \u51648  \u50506 \u44256  \u51648 \u50612 \u45240  \u51060 \u50556 \u44592 \u50640  \u44480 \u47484  \u44592 \u50872 \u51064 \u45796 . \u49324 \u46020  \u48148 \u50872 \u51008  \u47560 \u51648 \u47561  \u45216 \u51012  \u45236 \u45796 \u48372 \u44256  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u54616 \u50688 \u45796 . \'93\u46412 \u44032  \u51060 \u47476 \u47532 \u45768  \u49324 \u46988 \u51060  \u48148 \u