\uc0\u50948 \u53364 \u47532 \u54532 \u45716  \u44032 \u51109  \u50948 \u45824 \u54620  \u44060 \u54785 \u51088  \u51473 \u51032  \u54620  \u49324 \u46988 \u51060 \u50632 \u45796 . \u44536 \u51032  \u54644 \u48149 \u54620  \u51648 \u49885 , \u47749 \u49437 \u54620  \u49324 \u44256 \u47141 , \u51652 \u47532 \u47484  \u51452 \u51109 \u54624  \u46412  \u48372 \u50668 \u51456  \u54869 \u49888 , \u44536 \u47532 \u44256  \u51652 \u47532 \u47484  \u50745 \u54840 \u54616 \u44592  \u50948 \u54620  \u45812 \u47141  \u46321 \u51008  \u44536 \u48372 \u45796  \u54980 \u50640  \u45208 \u53440 \u45212  \u49324 \u46988 \u46308  \u51473 \u50640 \u49436 \u46020  \u44536 \u50752  \u54596 \u51201 \u54624  \u49324 \u46988 \u51060  \u48324 \u47196  \u50630 \u45796 . \u44536 \u44032  \u49332 \u45912  \u49884 \u45824 \u50640 \u45716  \u51648 \u51201 \u51004 \u47196  \u47805 \u47588 \u54616 \u44256  \u46020 \u45909 \u51201 \u51004 \u47196  \u48512 \u54056 \u54620  \u49884 \u45824 \u50688 \u51648 \u47564 , \u51060  \u52572 \u52488 \u51032  \u44060 \u54785 \u51088 \u51032  \u48393 \u49324 \u45716  \u49373 \u50528 \u51032  \u49692 \u44208 , \u50672 \u44396 \u50752  \u54876 \u46041 \u50640  \u51080 \u50612 \u49436 \u51032  \u44540 \u47732 , \u47588 \u49688 \u46104 \u51648  \u50506 \u45716  \u52397 \u47156 , \u49324 \u50629 \u50640  \u51080 \u50612 \u49436 \u51032  \u44536 \u47532 \u49828 \u46020 \u50752  \u44057 \u51008  \u49324 \u46993 \u44284  \u52649 \u49457  \u46321 \u51004 \u47196  \u53945 \u51669 \u51012  \u51060 \u47336 \u50632 \u45796 .\
\uc0\u51060 \u50752  \u44057 \u51008  \u50948 \u53364 \u47532 \u54532 \u51032  \u51064 \u44201 \u51008  \u49457 \u44221 \u51060  \u49324 \u46988 \u51012  \u44368 \u50977 \u49884 \u53412 \u44256  \u48320 \u54868 \u49884 \u53412 \u45716  \u45733 \u47141 \u51060  \u51080 \u45716  \u44163 \u51012  \u51613 \u47749 \u54644  \u51452 \u45716  \u51339 \u51008  \u50696 \u51613 \u51060  \u46108 \u45796 . \u44284 \u50672  \u49457 \u44221 \u51060  \u44536 \u47196  \u54616 \u50668 \u44552  \u44536 \u47084 \u54620  \u51064 \u47932 \u51060  \u46104 \u44172  \u54616 \u50688 \u45796 . \u44228 \u49884 \u50640  \u45208 \u53440 \u45212  \u50948 \u45824 \u54620  \u51652 \u47532 \u47484  \u44648 \u45803 \u44256 \u51088  \u54616 \u45716  \u45432 \u47141 \u51008  \u47784 \u46304  \u44592 \u45733 \u50640  \u49352 \u47196 \u50880 \u44284  \u54876 \u44592 \u47484  \u51456 \u45796 . \u44536 \u44163 \u51008  \u47560 \u51020 \u51012  \u45331 \u54784  \u51452 \u44256 , \u51060 \u54644 \u47141 \u51012  \u50696 \u48124 \u54616 \u44172  \u54644 \u51452 \u44256 , \u54032 \u45800 \u47141 \u51012  \u49457 \u49689 \u54616 \u44172  \u54644 \u51456 \u45796 . \u49457 \u44221  \u50672 \u44396 \u45716  \u50612 \u46500  \u50672 \u44396 \u48372 \u45796 \u46020  \u49324 \u49345 \u44284  \u44048 \u51221 \u44284  \u50837 \u47581 \u51012  \u45908 \u50865  \u51221 \u54868  (\u28136 \u21270 ) \u49884 \u53020  \u51460  \u44163 \u51060 \u45796 . \u44536 \u44163 \u51008  \u44204 \u51064 \u48520 \u48156 \u51032  \u51221 \u49888 \u44284  \u51064 \u45236 \u50752  \u50857 \u44592 \u50752  \u44403 \u49468  \u47560 \u51020 \u51012  \u44032 \u51256 \u45796 \u51456 \u45796 . \u44536 \u44163 \u51008  \u54408 \u49457 \u51012  \u49464 \u47144 \u49884 \u53020  \u51452 \u44256 , \u49900 \u47161 \u51012  \u44144 \u47337 \u54616 \u44172  \u47564 \u46308 \u50612 \u51456 \u45796 . \u49457 \u44221 \u51012  \u51316 \u51473 \u54616 \u44256  \u50676 \u49900 \u55176  \u50672 \u44396 \u54616 \u45716  \u49324 \u46988 \u51032  \u47560 \u51020 \u51008  \u47924 \u54620 \u54616 \u49888  \u54616 \u45208 \u45784 \u51032  \u47560 \u51020 \u44284  \u51649 \u51217  \u51217 \u52489 \u54616 \u44172  \u46104 \u48064 \u47196 , \u50612 \u46496 \u54620  \u51064 \u44036 \u51201 \u51064  \u52384 \u54617 \u51060  \u44032 \u51256 \u45796 \u51452 \u45716  \u44032 \u51109  \u54988 \u47469 \u54620  \u44208 \u44284 \u48372 \u45796  \u45908 \u50865  \u44256 \u49345 \u54620  \u50896 \u52825 \u51008  \u47932 \u47200 \u51060 \u50836 , \u45908 \u50865  \u44053 \u54616 \u44256  \u51201 \u44537 \u51201 \u51064  \u51648 \u49457 \u51012  \u44054 \u52632  \u51064 \u47932 \u51060  \u46104 \u44172  \u54644 \u51460  \u44163 \u51060 \u45796 . \u44536 \u47084 \u48064 \u47196  \u49884 \u54200  \u44592 \u51088 \u45716  \'93\u51452 \u51032  \u47568 \u50432 \u51012  \u50676 \u48064 \u47196  \u50864 \u46164 \u54620  \u51088 \u50640 \u44172  \u48708 \u52712 \u50612  \u44648 \u45803 \u44172  \u54616 \u45208 \u51060 \u45796 \'94 (\u49884  119:130) \u44256  \u47568 \u54616 \u44256  \u51080 \u45796 .\
\uc0\u50948 \u53364 \u47532 \u54532 \u44032  \u44032 \u47476 \u52828  \u44368 \u47532 \u45716  \u44536  \u54980 \u50640 \u46020  \u50620 \u47560  \u46041 \u50504  \u45328 \u47532  \u51204 \u54644 \u51276 \u45796 . \u44536 \u47484  \u46384 \u47476 \u45716  \u51088 \u46308 , \u44263  \u50948 \u53364 \u47532 \u54532  \u44368 \u46020 \u50752  \u47204 \u46972 \u46300  \u44368 \u46020 \u46972 \u44256  \u48520 \u47532 \u45716  \u47924 \u47532 \u46308 \u51008  \u50689 \u44397 \u50640  \u48373 \u51020 \u51032  \u51648 \u49885 \u51012  \u51204 \u54664 \u51012  \u49104 \u47564  \u50500 \u45768 \u46972  \u50808 \u44397 \u50640 \u44620 \u51648 \u46020  \u44536 \u44163 \u51012  \u44032 \u51648 \u44256  \u45208 \u50500 \u44052 \u45796 . \u51060 \u51228  \u51648 \u46020 \u51088 \u45716  \u50630 \u50612 \u51276 \u51004 \u45208  \u44536  \u51204 \u46020 \u51088 \u46308 \u51008  \u51204 \u48372 \u45796 \u46020  \u45908 \u50865  \u53360  \u50676 \u49457 \u51004 \u47196  \u51068 \u54616 \u50688 \u44256 , \u47566 \u51008  \u49324 \u46988 \u46308 \u51060  \u44536 \u46308 \u51032  \u44032 \u47476 \u52840 \u51012  \u46307 \u44592  \u50948 \u54616 \u50668  \u47784 \u50668 \u46308 \u50632 \u45796 . \u44536 \u46308 \u51060  \u51204 \u54620  \u48373 \u51020 \u51012  \u46307 \u44256  \u54924 \u44060 \u54620  \u49324 \u46988 \u46308  \u51473 \u50640 \u45716  \u44480 \u51313 \u46020  \u51080 \u44256  \u50773 \u48708 \u46020  \u51080 \u50632 \u45796 . \u47566 \u51008  \u44275 \u50640 \u49436  \u49324 \u46988 \u46308 \u51032  \u49373 \u54876  \u49345 \u53468 \u44032  \u54788 \u51200 \u54616 \u44172  \u44060 \u54785 \u46104 \u50632 \u44256 , \u47196 \u47560 \u44368 \u51032  \u50864 \u49345 \u51201  \u49345 \u51669 \u51008  \u44368 \u54924 \u50640 \u49436  \u51228 \u44144 \u46104 \u50632 \u45796 . \u44536 \u47084 \u45208  \u47924 \u51088 \u48708 \u54620  \u48149 \u54644 \u51032  \u54253 \u54413 \u51060  \u49457 \u44221 \u51012  \u44536 \u46308 \u51032  \u51648 \u46020 \u51088 \u47196  \u48155 \u50500 \u46308 \u51064  \u49324 \u46988 \u46308 \u50640 \u44172  \u44263  \u47792 \u47140 \u50772 \u45796 . \u50689 \u44397 \u51032  \u44397 \u50773 \u46308 \u51008  \u47196 \u47560  \u48277 \u50773 \u51032  \u51648 \u51648 \u47484  \u50619 \u50612  \u51088 \u44592 \u46308 \u51032  \u44428 \u49464 \u47484  \u44053 \u54868 \u49884 \u53412 \u44592  \u50948 \u54616 \u50668  \u44060 \u54785 \u51088 \u46308 \u51012  \u55148 \u49373 \u49884 \u53412 \u45716  \u51068 \u51012  \u51452 \u51200 \u54616 \u51648  \u50500 \u45768 \u54616 \u50688 \u45796 . \u50689 \u44397  \u50669 \u49324 \u49345  \u52572 \u52488 \u47196  \u48373 \u51020 \u51032  \u49324 \u46020 \u46308 \u50640  \u45824 \u54616 \u50668  \u54868 \u54805 \u51032  \u49440 \u44256 \u44032  \u45236 \u47160 \u45796 . \u49692 \u44368 \u51088 \u44032  \u44228 \u49549 \u54616 \u50668  \u46244 \u47484  \u51060 \u50632 \u45796 . \u48277 \u47456 \u51032  \u48372 \u54840 \u47484  \u48149 \u53448 \u45817 \u54616 \u44256  \u44256 \u47928 \u50640  \u49884 \u45804 \u47532 \u45716  \u51652 \u47532 \u51032  \u50745 \u54840 \u51088 \u46308 \u51008  \u47564 \u44400 \u51032  \u50668 \u54840 \u50752 \u44760  \u48512 \u47476 \u51670 \u45716  \u44600 \u48150 \u50640  \u45796 \u47480  \u44600 \u51060  \u50630 \u50632 \u45796 . \u44536 \u46308 \u51008  \u44368 \u54924 \u51032  \u50896 \u49688 \u50836  \u44397 \u44032 \u51032  \u48152 \u50669 \u51088 \u47196  \u45572 \u47749 \u51012  \u50416 \u44256  \u52628 \u44201 \u51012  \u48155 \u51004 \u47732 \u49436 \u46020  \u47792 \u47000  \u48373 \u51020 \u51012  \u51204 \u54616 \u45716  \u51068 \u51012  \u44536 \u52824 \u51648  \u50500 \u45768 \u54616 \u50688 \u51004 \u47728 , \u48712 \u44417 \u54620  \u51088 \u46308 \u51032  \u51665 \u51012  \u44536 \u46308 \u51032  \u44032 \u51109  \u51339 \u51008  \u51008 \u49888 \u52376 \u47196  \u49340 \u50520 \u44256 , \u46412 \u46412 \u47196  \u44404  \u49549 \u51012  \u44536 \u46308 \u51032  \u54588 \u45212 \u52376 \u47196  \u49340 \u44592 \u46020  \u54616 \u50688 \u45796 .\
\uc0\u44201 \u47148 \u54620  \u48149 \u54644 \u47484  \u48155 \u51004 \u47732 \u49436 \u46020 , \u53440 \u46973 \u54620  \u51333 \u44368 \u51032  \u49464 \u47141 \u51012  \u45824 \u54637 \u54616 \u50668  \u51204 \u44060 \u54620  \u51312 \u50857 \u54616 \u44256 , \u44221 \u44148 \u54616 \u44256 , \u50676 \u47148 \u54616 \u44256 , \u44984 \u51456 \u54620  \u48152 \u54637 \u51008  \u50668 \u47084  \u49464 \u44592  \u46041 \u50504  \u44228 \u49549 \u46104 \u50632 \u45796 . \u45817 \u49884 \u51032  \u44536 \u47532 \u49828 \u46020 \u51064 \u46308 \u51008  \u51652 \u47532 \u50640  \u44288 \u54620  \u51648 \u49885 \u51012  \u51068 \u48512 \u48516 \u48150 \u50640  \u50508 \u51648  \u47803 \u54616 \u50688 \u45796 . \u47560 \u52824  \u49324 \u46020  \u49884 \u45824 \u51032  \u51228 \u51088 \u46308 \u44284  \u44057 \u51060  \u50668 \u47084  \u49324 \u46988 \u51060  \u44536 \u47532 \u49828 \u46020 \u51032  \u49324 \u50629 \u51012  \u50948 \u54616 \u50668  \u49464 \u49345 \u51032  \u51116 \u47932 \u51012  \u55148 \u49373 \u54616 \u50688 \u45796 . \u45796 \u54665 \u55176  \u44032 \u51221 \u50640 \u49436  \u49332 \u46020 \u47197  \u54728 \u46973  \u48155 \u51008  \u49324 \u46988 \u46308 \u51008  \u52628 \u48169 \u45817 \u54620  \u54805 \u51228 \u46308 \u51012  \u44592 \u44732 \u51060  \u49704 \u44200  \u51452 \u50632 \u44256 , \u44536 \u46308  \u50669 \u49884  \u52628 \u48169 \u51012  \u45817 \u54644 \u50556  \u54624  \u44221 \u50864 \u50640 \u45716  \u51600 \u44144 \u51060  \u44536  \u50868 \u47749 \u51012  \u48155 \u50500 \u46308 \u50688 \u45796 . \u47932 \u47200  \u44536  \u51473 \u50640 \u45716  \u48149 \u54644 \u51088 \u46308 \u51032  \u48516 \u45432 \u47484  \u46160 \u47140 \u50892 \u54616 \u50668  \u49888 \u50521 \u51012  \u55148 \u49373 \u54616 \u50668  \u51088 \u50976 \u47484  \u50619 \u44256 , \u52280 \u54924 \u51088 \u51032  \u50743 \u51012  \u51077 \u44256  \u44048 \u50725 \u50640 \u49436  \u45208 \u50752  \u49888 \u50521 \u51032  \u52712 \u49548 \u47484  \u49440 \u50616 \u54620  \u51088 \u46308 \u46020  \u49688 \u52380  \u47749 \u51060  \u51080 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44048 \u50725 \u44284  \u47204 \u46972 \u46300 \u53457  (\u22612 ) \u50640  \u44039 \u55176 \u46304 \u51648 , \u49900 \u51648 \u50612 \u45716  \u44256 \u47928 \u44284  \u54868 \u54805 \u51012  \u48155 \u51012 \u51648 \u46972 \u46020  \u44536 \u47532 \u49828 \u46020 \u51032  \u44256 \u45212 \u50640  \u46041 \u52280 \u54616 \u45716  \u44163 \u51012  \u44032 \u52824  \u51080 \u45716  \u44163 \u51004 \u47196  \u50668 \u44592 \u44256  \u46160 \u47140 \u50880  \u50630 \u51060  \u44592 \u49256 \u51004 \u47196  \u51652 \u47532 \u47484  \u50948 \u54616 \u50668  \u51613 \u44144 \u54620  \u49324 \u46988 \u46308 \u51060  \u44208 \u53076  \u51201 \u51648  \u50506 \u50520 \u45796 . \u44536 \u46308  \u51473 \u50640 \u45716  \u48712 \u44417 \u54616 \u44256  \u48708 \u52380 \u54620  \u49324 \u46988 \u46308 \u46020  \u51080 \u50632 \u51004 \u45208  \u44480 \u51313  \u52636 \u49888 \u51032  \u49324 \u46988 \u46308 \u46020  \u51080 \u50632 \u45796 .\
