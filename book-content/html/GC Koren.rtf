\f0\b \cf0 \uc0\u50504 \u49885 \u51068  \u47928 \u51228 \u50752  \u49483 \u51704  \u52380 \u49324 \u51032  \u44592 \u48324 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u47196 \u47560 \u44368 \u54924 \u45716  \u50500 \u51649 \u44620 \u51648  \u51088 \u49888 \u51032  \u52572 \u49345 \u44428 \u50640  \u45824 \u54620  \u51452 \u51109 \u51012  \u52384 \u54924 \u54616 \u51648  \u50506 \u50520 \u45796 . \u44536 \u47532 \u44256  \u49464 \u49345  \u49324 \u46988 \u44284  \u44060 \u49888 \u44368 \u54924 \u46308 \u51008  \u49457 \u44221 \u49345  \u50504 \u49885 \u51068 \u51012  \u48512 \u51064 \u54616 \u45716  \u54620 \u54200  \u47196 \u47560 \u44368 \u44032  \u51228 \u51221 \u54620  \u50504 \u49885 \u51068 \u51012  \u48155 \u50500 \u46308 \u51076 \u51004 \u47196  \u49324 \u49892 \u49345  \u51060  \u51452 \u51109 \u51012  \u49884 \u51064 \u54616 \u44256  \u51080 \u45796 . \u44536 \u46308 \u51008  \u51060 \u50752  \u44057 \u51008  \u48320 \u44221 \u51012  \u51204 \u53685 \u51032  \u55192 \u51060 \u45208  \u44368 \u48512 \u46308 \u51032  \u45733 \u47141 \u51060 \u46972 \u44256  \u51452 \u51109 \u54624  \u49688 \u46020  \u51080 \u51012  \u44163 \u51060 \u45796 . \u44536 \u47084 \u45208  \u51060 \u47111 \u44172  \u54632 \u51004 \u47196 \u50024  \u44536 \u46308 \u51008  \u44208 \u44397  \u47196 \u47560 \u44368 \u50752  \u44536 \u46308 \u51012  \u48516 \u47532 \u49884 \u53412 \u45716  \u48148 \u47196  \u44536  \u50896 \u52825 , \u44263  \'93\u49457 \u44221 , \u50724 \u51649  \u49457 \u44221 \u47564 \u51060 \'94 \u44060 \u49888 \u44368 \u51032  \u49888 \u50521 \u51060 \u46972 \u45716  \u50896 \u52825 \u51012  \u47924 \u49884 \u54616 \u44172  \u46108 \u45796 . \u48277 \u50773 \u44368 \u46020 \u46308 \u51008  \u44060 \u49888 \u44368 \u46020 \u46308 \u51060  \u51060  \u49324 \u49892 \u50640  \u45824 \u54616 \u50668  \u44256 \u51032 \u51201 \u51004 \u47196  \u45576 \u51012  \u44048 \u44256  \u49828 \u49828 \u47196  \u49549 \u44256  \u51080 \u45796 \u45716  \u44163 \u51012  \u50508 \u44256  \u51080 \u45796 . \u51068 \u50836 \u51068 \u51012  \u44053 \u50836 \u54616 \u45716  \u50868 \u46041 \u51060  \u49464 \u47141 \u51012  \u50619 \u44172  \u46104 \u47732  \u44060 \u49888 \u44368  \u51204 \u52404 \u44032  \u47196 \u47560 \u44368 \u51032  \u44611 \u48156  \u50500 \u47000  \u49436 \u44172  \u46112  \u44163 \u51012  \u54869 \u49888 \u54632 \u51004 \u47196  \u48277 \u50773 \u44368 \u45716  \u47588 \u50864  \u44592 \u48848 \u54620 \u45796 .\
\uc0\u47196 \u47560 \u44368 \u46020 \u46308 \u51008  \'93\u44060 \u49888 \u44368 \u46020 \u46308 \u51032  \u51068 \u50836 \u51068  \u51456 \u49688 \u45716  \u44536 \u46308 \u51060  \u50612 \u46496 \u54620  \u47568 \u51012  \u54616 \u46304 \u51648 \u44036 \u50640  \u44368 \u54924  (\u52380 \u51452 \u44368 ) \u51032  \u44428 \u50948 \u50640  \u51316 \u44221 \u51012  \u54364 \u54616 \u45716  \u51068 \u51060 \u45796 \'94 (Mgr.Segur, Plain Talk About the Protestantism of Today, p.213) \u46972 \u44256  \u51452 \u51109 \u54620 \u45796 . \u44536 \u47084 \u48064 \u47196  \u44060 \u49888 \u44368 \u52769 \u51032  \u51068 \u50836 \u51068  \u51456 \u49688 \u51032  \u44053 \u50836 \u45716  \u48277 \u50773 \u44428 , \u44263  \u51664 \u49849 \u50640  \u45824 \u54620  \u44221 \u48176 \u47484  \u44053 \u50836 \u54616 \u45716  \u51068 \u51060 \u45796 . \u45367 \u51704  \u44228 \u47749 \u51032  \u50836 \u44396 \u47484  \u50508 \u47732 \u49436  \u52280  \u50504 \u49885 \u51068  \u45824 \u49888 \u50640  \u44144 \u51667  \u44163 \u51012  \u51648 \u53412 \u44592 \u47196  \u49440 \u53469 \u54616 \u45716  \u51088 \u46308 \u51008  \u44536  \u44144 \u51667  \u44163 \u51012  \u51648 \u53412 \u46020 \u47197  \u47749 \u47161 \u54620  \u44428 \u50948 \u50640  \u44221 \u48176 \u54616 \u45716  \u49480 \u51060 \u45796 . \u44536 \u47084 \u45208  \u49464 \u49549 \u51201  \u44428 \u47141 \u51012  \u44032 \u51648 \u44256  \u51333 \u44368 \u51201  \u51032 \u47924 \u47484  \u44053 \u50836 \u54616 \u45716  \u48148 \u47196  \u44536  \u54665 \u50948 \u47196  \u47568 \u48120 \u50516 \u50500  \u44368 \u54924 \u46308 \u51008  \u49828 \u49828 \u47196  \u51664 \u49849 \u51032  \u50864 \u49345 \u51012  \u47564 \u46308 \u44172  \u46108 \u45796 . \u51060 \u47088  \u51032 \u48120 \u50640 \u49436  \u48513 \u48120  \u54633 \u51473 \u44397 \u51060  \u51068 \u50836 \u51068  \u51456 \u49688 \u47484  \u44053 \u50836 \u54616 \u45716  \u44163 \u51008  \u51664 \u49849 \u44284  \u44536  \u50864 \u49345 \u50640 \u44172  \u44221 \u48176 \u54616 \u46020 \u47197  \u44053 \u50836 \u54616 \u45716  \u51068 \u51060  \u46108 \u45796 .\
\uc0\u44536 \u47084 \u45208  \u51648 \u45212  \u50668 \u47084  \u49464 \u45824 \u51032  \u44536 \u47532 \u49828 \u46020 \u51064 \u46308 \u51008  \u44536 \u46308 \u51060  \u49457 \u44221 \u49345  \u50504 \u49885 \u51068 \u51012  \u51648 \u53412 \u45716  \u51460 \u47196  \u48127 \u44256  \u51068 \u50836 \u51068 \u51012  \u51648 \u53040 \u45796 . \u44536 \u47532 \u44256  \u50724 \u45720 \u45216 \u46020  \u47196 \u47560  \u52380 \u51452 \u44368 \u47484  \u54252 \u54632 \u54620  \u44033  \u44368 \u54924 \u50640 \u45716  \u51068 \u50836 \u51068 \u51060  \u54616 \u45208 \u45784 \u44760 \u49436  \u51228 \u51221 \u54616 \u49888  \u50504 \u49885 \u51068 \u51064  \u51460  \u51652 \u49900 \u51004 \u47196  \u48127 \u45716  \u51652 \u49892 \u54620  \u44536 \u47532 \u49828 \u46020 \u51064 \u46308 \u51060  \u51080 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u51060 \u47084 \u54620  \u49324 \u46988 \u46308 \u51032  \u51652 \u49892 \u54620  \u47560 \u51020 \u44284  \u46608 \u54620  \u45817 \u49888  \u50526 \u50640  \u45208 \u53440 \u45236 \u45716  \u44536 \u46308 \u51032  \u49457 \u49892 \u49457 \u51012  \u51064 \u51221 \u54616 \u49888 \u45796 . \u44536 \u47084 \u45208  \u48277 \u47456 \u47196 \u50024  \u51068 \u50836 \u51068  \u51456 \u49688 \u47484  \u44053 \u50836 \u54616 \u44256  \u51652 \u51221 \u54620  \u50504 \u49885 \u51068  \u51456 \u49688 \u50640  \u44288 \u54620  \u49324 \u49892 \u51060  \u50728  \u49464 \u44228 \u50640  \u48157 \u54784 \u51656  \u46412 \u50640 \u45716  \u54616 \u45208 \u45784 \u51032  \u47749 \u47161 \u51012  \u50612 \u44592 \u44256  \u47196 \u47560 \u44368 \u51032  \u47749 \u47161 \u44284  \u45796 \u47492 \u51060  \u50630 \u45716  \u47749 \u47161 \u50640  \u49692 \u51333 \u54616 \u45716  \u51088 \u46308 \u51008  \u51060 \u47196 \u50024  \u54616 \u45208 \u45784 \u48372 \u45796  \u48277 \u50773 \u51012  \u45458 \u51060 \u44172  \u46112  \u44163 \u51060 \u45796 . \u44536 \u47088  \u49324 \u46988 \u46308 \u51008  \u47196 \u47560 \u44368 \u50640  \u48373 \u51333 \u54616 \u44256  \u47196 \u47560 \u44368 \u44032  \u51228 \u51221 \u54620  \u51228 \u46020 \u47484  \u44053 \u51228 \u47196  \u49884 \u54665 \u54616 \u45716  \u44428 \u49464 \u50640  \u48373 \u51333 \u54616 \u45716  \u51088 \u46308 \u51060 \u45796 . \u44536 \u46308 \u51008  \u51664 \u49849 \u44284  \u44536  \u50864 \u49345 \u50640 \u44172  \u44221 \u48176 \u54616 \u45716  \u51088 \u46308 \u51060 \u45796 . \u44536 \u47532 \u54616 \u50668  \u49324 \u46988 \u46308 \u51060  \u54616 \u45208 \u45784 \u44760 \u49436  \u45817 \u49888 \u51032  \u44428 \u50948 \u51032  \u54364 \u44032  \u46108 \u45796 \u44256  \u49440 \u50616 \u54616 \u49888  \u51228 \u46020 \u47484  \u48260 \u47532 \u44256  \u44536  \u45824 \u49888 \u50640  \u47196 \u47560 \u44368 \u44032  \u51088 \u44592 \u51032  \u52572 \u49345 \u44428 \u51032  \u54364 \u47196  \u53469 \u54620  \u44163 \u51012  \u45458 \u51068  \u46412 \u50640  \u44536 \u44163 \u51004 \u47196 \u50024  \u44536 \u46308 \u51008  \u47196 \u47560 \u44368 \u50640  \u48373 \u51333 \u54616 \u45716  \u54364 , \u44263  \'93\u51664 \u49849 \u51032  \u54364 \'94\u47484  \u48155 \u44172  \u46112  \u44163 \u51060 \u45796 . \u51060 \u51228  \u47928 \u51228 \u45716  \u44537 \u55176  \u48516 \u47749 \u54644 \u51276 \u51004 \u48064 \u47196  \u54616 \u45208 \u45784 \u51032  \u44228 \u47749 \u51012  \u49692 \u51333 \u54616 \u45712 \u45264  \u49324 \u46988 \u51032  \u44228 \u47749 \u51012  \u49692 \u51333 \u54616 \u45712 \u45264  \u54616 \u45716  \u47928 \u51228  \u51473  \u50612 \u45712  \u54620  \u54200 \u51012  \u53469 \u54616 \u51648  \u50506 \u51004 \u47732  \u50504  \u46108 \u45796 . \u44536 \u47100 \u50640 \u46020  \u48520 \u44396 \u54616 \u44256  \u54616 \u45208 \u45784 \u51032  \u44228 \u47749 \u51012  \u44228 \u49549 \u54644 \u49436  \u48276 \u54616 \u45716  \u51088 \u45716  \'93\u51664 \u49849 \u51032  \u54364 \'94\u47484  \u48155 \u44172  \u46108 \u45796 .\
\uc0\u51064 \u47448 \u50640 \u44172  \u51648 \u44552 \u44751  \u51452 \u50612 \u51652  \u44032 \u51109  \u46160 \u47140 \u50868  \u44221 \u44256 \u44032  \u49483 \u51704  \u52380 \u49324 \u51032  \u44592 \u48324 \u50640  \u54252 \u54632 \u46104 \u50612  \u51080 \u45796 . \u51088 \u48708 \u44032  \u49438 \u51060 \u51648  \u50500 \u45768 \u54620  \u54616 \u45208 \u45784 \u51032  \u51652 \u45432 \u47484  \u52488 \u47000 \u54616 \u45716  \u44163 \u51008  \u47924 \u49436 \u50868  \u51396 \u51076 \u50640  \u53952 \u47548 \u50630 \u45796 . \u51060 \u52376 \u47100  \u51473 \u45824 \u54620  \u47928 \u51228 \u50640  \u44288 \u54616 \u50668  \u49324 \u46988 \u46308 \u51060  \u47784 \u47476 \u44256  \u51080 \u50612 \u49436 \u45716  \u50504  \u46108 \u45796 . \u51060  \u51396 \u50501 \u50640  \u44288 \u54620  \u44221 \u44256 \u45716  \u54616 \u45208 \u45784 \u51032  \u49900 \u54032 \u51060  \u51060 \u47476 \u44592  \u51204 \u50640  \u48152 \u46300 \u49884  \u50728  \u49464 \u44228 \u50640  \u51204 \u54028 \u46104 \u50612  \u47784 \u46304  \u49324 \u46988 \u46308 \u51060  \u50612 \u52236 \u54616 \u50668  \u51200 \u55148 \u44032  \u54805 \u48268 \u51012  \u48155 \u50500 \u50556  \u54616 \u45716 \u51648 , \u46608  \u50612 \u52236 \u54616 \u47732  \u44536 \u44163 \u51012  \u54588 \u54624  \u49688  \u51080 \u45716 \u51648  \u44648 \u45803 \u44172  \u46104 \u50612 \u50556  \u54620 \u45796 . \u50696 \u50616 \u51008  \u52395 \u51704  \u52380 \u49324 \u44032  \u44536  \u44592 \u48324 \u51012  \'93\u50668 \u47084  \u45208 \u46972 \u50752  \u51313 \u49549 \u44284  \u48169 \u50616 \u44284  \u48177 \u49457 \'94\u50640 \u44172  \u51204 \u54624  \u44163 \u51060 \u46972 \u44256  \u54620 \u45796 . \u49340 \u51473  \u44592 \u48324 \u51032  \u54620  \u48512 \u48516 \u51064  \u49483 \u51704  \u52380 \u49324 \u51032  \u44592 \u48324  \u50669 \u49884  \u44536 \u44163 \u44284  \u44057 \u51008  \u48276 \u50948 \u47196  \u51204 \u54028 \u46104 \u50612 \u50556  \u54620 \u45796 . \u50696 \u50616 \u50640 \u45716  \u44277 \u51473 \u50640  \u45216 \u50500 \u44032 \u45716  \u54620  \u52380 \u49324 \u44032  \u53360  \u51020 \u49457 \u51004 \u47196  \u51204 \u54028 \u54624  \u44163 \u51004 \u47196  \u54364 \u54788 \u46104 \u50612  \u51080 \u45796 . \u44536 \u47084 \u48064 \u47196  \u44536 \u44163 \u51008  \u48152 \u46300 \u49884  \u49464 \u44228 \u51032  \u51452 \u47785 \u51012  \u45132 \u44172  \u46112  \u44163 \u51060 \u45796 .\
\uc0\u51137 \u53804 \u51032  \u44208 \u44284 \u47196  \u50728  \u44536 \u47532 \u49828 \u46020 \u44368 \u44397 \u51008  \u54616 \u45208 \u45784 \u51032  \u44228 \u47749 \u44284  \u50696 \u49688  \u48127 \u51020 \u51012  \u51648 \u53412 \u45716  \u51088 \u46308 \u44284 , \u51664 \u49849 \u44284  \u44536  \u50864 \u49345 \u50640 \u44172  \u44221 \u48176 \u54616 \u44256  \u44536  \u54364 \u47484  \u48155 \u51008  \u51088 \u46308 \u51032  \u46160  \u51333 \u47448 \u47196  \u45208 \u45664  \u44163 \u51060 \u45796 . \u48708 \u47197  \u44368 \u54924 \u50752  \u44397 \u44032 \u44032  \u44536 \u46308 \u51032  \u44428 \u47141 \u51012  \u50672 \u54633 \u49884 \u53020  \'93\u47784 \u46304  \u51088  \u44263  \u51089 \u51008  \u51088 \u45208  \u53360  \u51088 \u45208  \u48512 \u51088 \u45208  \u48712 \u44417 \u54620  \u51088 \u45208  \u51088 \u50976 \u54620  \u51088 \u45208  \u51333 \u46308 \'94 (\u44228  13:16) \u50640 \u44172  \u44053 \u51228 \u51201 \u51004 \u47196  \'93\u51664 \u49849 \u51032  \u54364 \'94\u47484  \u48155 \u44172  \u54624 \u51648 \u46972 \u46020  \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u46308 \u51008  \u44208 \u53076  \u44536 \u44163 \u51012  \u48155 \u51648  \u50506 \u51012  \u44163 \u51060 \u45796 . \u48167 \u47784  \u49452 \u51032  \u49440 \u51648 \u51088 \u45716  \'93\u51664 \u49849 \u44284  \u44536 \u51032  \u50864 \u49345 \u44284  \u44536 \u51032  \u51060 \u47492 \u51032  \u49688 \u47484  \u51060 \u44592 \u44256  \u48279 \u50612 \u45212  \u51088 \u46308 \u51060  \u50976 \u47532  \u48148 \u45815 \u44032 \u50640  \u49436 \u49436  \u54616 \u45208 \u45784 \u51032  \u44144 \u47928 \u44256 \u47484  \u44032 \u51648 \u44256  \u54616 \u45208 \u45784 \u51032  \u51333  \u47784 \u49464 \u51032  \u45432 \u47000  \u50612 \u47536 \u50577 \u51032  \u45432 \u47000 \'94 (\u44228  15:2, 3) \u47484  \u48512 \u47476 \u45716  \u44163 \u51012  \u48372 \u50520 \u45796 .\
