\f1\b0 \cf0 \
\uc0\u44536 \u47084 \u45208  \u51396 \u47484  \u49324 \u46993 \u54616 \u45716  \u48120 \u49888 \u51201 \u51064  \u49324 \u46988 \u46308 \u51008  \u51088 \u44592 \u46308 \u51032  \u46160 \u47140 \u50880 \u51012  \u51652 \u51221 \u49884 \u53020 \u51452 \u45912  \u44452 \u48320 \u51060  \u49324 \u46972 \u51256  \u48260 \u47160 \u51004 \u48064 \u47196  \u45440 \u46992 \u45796 . \u48276 \u51396 \u47484  \u51064 \u44032 \u54644  \u51452 \u45716  \u44536 \u46308 \u51032  \u49324 \u50629 \u51060  \u48169 \u54644 \u47484  \u48155 \u44256 , \u44536 \u46308 \u51032  \u51060 \u46301 \u50640  \u50948 \u54801 \u51012  \u45712 \u45180 \u44172  \u46108  \u44368 \u54876 \u54620  \u49849 \u47140 \u46308 \u51008  \u44201 \u48516 \u54616 \u50688 \u51004 \u47728 , \u44536 \u46308 \u51032  \u51452 \u51109 \u51012  \u44288 \u52384 \u49884 \u53412 \u44592  \u50948 \u54616 \u50668  \u44208 \u49549 \u54616 \u50688 \u45796 . \u51060 \u50640  \u44060 \u54785 \u51088 \u45716  \u54841 \u46021 \u54620  \u47924 \u44256  (\u35491 \u21578 ) \u47484  \u45817 \u54616 \u44172  \u46104 \u50632 \u45796 . \u50612 \u46500  \u51088 \u46308 \u51008  \u44536 \u44032  \u52649 \u46041 \u51004 \u47196  \u51312 \u44553 \u54620  \u54665 \u46041 \u51012  \u54616 \u50688 \u45796 \u44256  \u48708 \u45212 \u54616 \u50688 \u45796 . \u46608  \u45796 \u47480  \u49324 \u46988 \u46308 \u51008  \u44536 \u47484  \u52280 \u46988 \u46108  \u51088 \u46972 \u44256  \u50837 \u54616 \u44256 , \u54616 \u45208 \u45784 \u51032  \u51648 \u46020 \u47484  \u48155 \u45716  \u44163 \u51060  \u50500 \u45768 \u46972  \u44368 \u47564 \u54616 \u44256  \u44148 \u48169 \u51652  \u54665 \u50948 \u47484  \u54616 \u44256  \u51080 \u45796 \u44256  \u48708 \u45212 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u47336 \u53552 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u45824 \u45813 \u54616 \u50688 \u45796 . \'93\u49324 \u46988 \u51060  \u50612 \u46500  \u49352  \u51032 \u44204 \u51012  \u51452 \u51109 \u54616 \u44172  \u46112  \u46412  \u44368 \u47564 \u54644  \u48372 \u51060 \u51648  \u50506 \u44144 \u45208  \u49912 \u50880 \u51012  \u51068 \u51004 \u53412 \u45716  \u44163 \u52376 \u47100  \u48372 \u51060 \u51648  \u50506 \u51004 \u47732 \u49436  \u44536 \u47088  \u51068 \u51012  \u54620  \u44221 \u50864 \u44032  \u46300 \u47932 \u45796 \u45716  \u44163 \u51012  \u45572 \u44032  \u47784 \u47476 \u44192 \u45716 \u44032 ? \u44536 \u47532 \u49828 \u46020 \u50752  \u47784 \u46304  \u49692 \u44368 \u51088 \u46308 \u51060  \u51453 \u51076 \u51012  \u45817 \u54616 \u44172  \u46108  \u51060 \u50976 \u45716  \u47924 \u50631 \u51064 \u44032 ? \u44536 \u46308 \u51008  \u44536  \u45817 \u49884 \u51032  \u51648 \u54812 \u47484  \u47736 \u49884 \u54616 \u45716  \u44368 \u47564 \u54620  \u49324 \u46988 \u46308 \u52376 \u47100  \u48372 \u50688 \u45912  \u50672 \u44256 \u51060 \u47728 , \u44536 \u46308 \u51060  \u50715 \u45216 \u48512 \u53552  \u51204 \u54644  \u50724 \u45716  \u44032 \u47476 \u52840 \u51012  \u44216 \u49552 \u54616 \u44172  \u48155 \u50500 \u46308 \u51060 \u51648  \u50500 \u45768 \u54616 \u44256  \u49352 \u47196 \u50868  \u48169 \u54693 \u51004 \u47196  \u45208 \u50500 \u44052 \u45912  \u44620 \u45805 \u51060 \u45796 .\'94\
\uc0\u44536 \u45716  \u45796 \u49884  \u47568 \u51012  \u51060 \u50632 \u45796 . \'93\u45236 \u44032  \u54616 \u45716  \u51068 \u51008  \u47924 \u50631 \u51060 \u46304 \u51648  \u49324 \u46988 \u51032  \u54032 \u45800 \u47141 \u51004 \u47196  \u54624  \u44163 \u51060  \u50500 \u45768 \u46972  \u54616 \u45208 \u45784 \u51032  \u51648 \u49884 \u50640  \u46384 \u46972 \u49436  \u54624  \u44163 \u51060 \u45796 . \u47564 \u51068  \u44536  \u51068 \u51060  \u54616 \u45208 \u45784 \u44760  \u49549 \u54620  \u51068 \u51060 \u46972 \u47732  \u45572 \u44032  \u44536 \u44163 \u51012  \u48169 \u54644 \u54624  \u49688  \u51080 \u44192 \u45716 \u44032 ? \u44536 \u44163 \u51060  \u54616 \u45208 \u45784 \u51032  \u51068 \u51060  \u50500 \u45768 \u46972 \u47732  \u45572 \u44032  \u45733 \u55176  \u44536  \u51068 \u51012  \u51652 \u51204 \u49884 \u53420  \u49688  \u51080 \u44192 \u45716 \u44032 ? \u51060 \u44163 \u51008  \u45236  \u46907 \u51060  \u50500 \u45768 \u50836  \u44536 \u46308 \u51032  \u46907 \u46020  \u50500 \u45768 \u47728  \u46608  \u50864 \u47532 \u51032  \u46907 \u46020  \u50500 \u45768 \u50836 , \u54616 \u45720 \u50640  \u44228 \u49888  \u44144 \u47337 \u54616 \u49888  \u50500 \u48260 \u51648  \u48148 \u47196  \u45817 \u49888 \u51032  \u46907 \u51060 \u45768 \u51060 \u45796 \'94 (D\'92Aubigne, b.3, ch.6).\
\uc0\u47336 \u53552 \u45716  \u49457 \u47161 \u51032  \u44048 \u46041 \u51012  \u48155 \u44256  \u44536  \u51068 \u51012  \u49884 \u51089 \u54616 \u50688 \u51004 \u45208 , \u44536  \u49324 \u50629 \u51012  \u51204 \u51652 \u49884 \u53412 \u47140 \u47732  \u47924 \u49436 \u50868  \u53804 \u51137 \u51012  \u47732 \u54624  \u49688  \u50630 \u50632 \u45796 . \u50896 \u49688 \u46308 \u51032  \u48708 \u45212 \u44284  \u44536 \u51032  \u47785 \u51201 \u50640  \u45824 \u54620  \u44536 \u46308 \u51032  \u50724 \u54644 \u50752  \u44536 \u51032  \u46041 \u44592 \u50752  \u51064 \u44201 \u50640  \u45824 \u54620  \u49888 \u46980 \u54616 \u44256  \u50728 \u45817 \u52824  \u50506 \u51008  \u48708 \u45212  \u46321 \u51060  \u44144 \u49468  \u54861 \u49688 \u52376 \u47100  \u50628 \u49845 \u54644  \u50772 \u45796 . \u44536 \u45716  \u44368 \u54924 \u50752  \u54617 \u44368  \u50504 \u50640  \u51080 \u45716  \u48177 \u49457 \u46308 \u51032  \u51648 \u46020 \u51088 \u46308 \u51060  \u51600 \u44144 \u51060  \u44060 \u54785  \u49324 \u50629 \u50640  \u52280 \u50668 \u54616 \u44256  \u44536 \u50752  \u50672 \u54633 \u54644  \u51460  \u44163 \u51012  \u44403 \u44172  \u48127 \u50632 \u45796 . \u44536 \u45716  \u45458 \u51008  \u51648 \u50948 \u50640  \u51080 \u45716  \u49324 \u46988 \u46308 \u47196 \u48512 \u53552  \u44201 \u47140 \u51032  \u47568 \u51012  \u46307 \u44256 , \u44592 \u49256 \u44284  \u55148 \u47581 \u51004 \u47196  \u44256 \u47924 \u46104 \u50632 \u45796 . \u44536 \u45716  \u51060 \u48120  \u49440 \u44204 \u51648 \u47749 \u51012  \u44032 \u51648 \u44256  \u44368 \u54924  \u50504 \u50640  \u45908 \u50865  \u44305 \u47749 \u54620  \u49352 \u48317 \u51060  \u48157 \u50500  \u50724 \u45716  \u44163 \u51012  \u48372 \u50520 \u45796 . \u44536 \u47088 \u45936  \u44201 \u47140 \u44032  \u48708 \u45212 \u44284  \u51221 \u51396 \u47196  \u46028 \u48320 \u54616 \u50688 \u45796 . \u51221 \u48512 \u50752  \u44368 \u54924 \u51032  \u47566 \u51008  \u44256 \u44288 \u46308 \u51008  \u44536 \u51032  \u51060 \u47200 \u51032  \u51221 \u45817 \u49457 \u51012  \u54869 \u49888 \u54616 \u50688 \u51004 \u45208 , \u44536  \u51652 \u47532 \u46308 \u51012  \u49849 \u51064 \u54616 \u44172  \u46104 \u47732  \u48120 \u44396 \u50640  \u53360  \u48320 \u54785 \u51060  \u52488 \u47000 \u46104 \u47532 \u46972 \u45716  \u44163 \u51012  \u50508 \u50520 \u45796 . \u48177 \u49457 \u46308 \u51060  \u44228 \u47805 \u46104 \u50612  \u44060 \u54785 \u51012  \u51068 \u51004 \u53412 \u44172  \u46104 \u47732 , \u49324 \u49892 \u49345  \u47196 \u47560 \u51032  \u44428 \u50948 \u47484  \u54644 \u52824 \u44256 , \u44536  \u44552 \u44256 \u47196  \u55128 \u47084  \u46308 \u50612 \u44032 \u45716  \u47924 \u49688 \u54620  \u48372 \u54868 \u51032  \u47932 \u51460 \u44592 \u47484  \u47688 \u52628 \u44172  \u54616 \u50668  \u48277 \u50773 \u44368 \u51032  \u51648 \u46020 \u51088 \u46308 \u51032  \u45229 \u48708 \u50752  \u49324 \u52824 \u47484  \u53356 \u44172  \u51460 \u50612 \u51648 \u44172  \u54624  \u44163 \u51060 \u50632 \u45796 . \u44536 \u49104  \u50500 \u45768 \u46972  \u51068 \u48152  \u45824 \u51473 \u46308 \u51012  \u51228 \u44033 \u44592  \u48516 \u48324 \u47141  \u51080 \u45716  \u49324 \u46988 \u51004 \u47196  \u49373 \u44033 \u54616 \u44256  \u54665 \u46041 \u54616 \u46020 \u47197  \u44032 \u47476 \u52432 \u49436  \u44536 \u47532 \u49828 \u46020 \u47564 \u51012  \u44396 \u51452 \u47196  \u52432 \u45796 \u48372 \u44172  \u54620 \u45796 \u47732 , \u48277 \u50773 \u51032  \u48372 \u51340 \u45716  \u51204 \u48373 \u46104 \u44256 , \u54596 \u44221 \u50640 \u45716  \u44536 \u46308  \u51088 \u49888 \u46308 \u51032  \u44428 \u50948 \u46020  \u49345 \u49892 \u46112  \u44163 \u51060 \u50632 \u45796 . \u44536 \u47084 \u48064 \u47196  \u44536 \u46308 \u51008  \u54616 \u45208 \u45784 \u44760 \u49436  \u51452 \u49888  \u51648 \u49885 \u51012  \u44144 \u51208 \u54616 \u44256  \u54616 \u45208 \u45784 \u44760 \u49436  \u44536 \u46308 \u51012  \u44228 \u47805 \u49884 \u53412 \u44592  \u50948 \u54616 \u50668  \u48372 \u45240  \u49324 \u46988 \u51012  \u48152 \u45824 \u54632 \u51004 \u47196 \u50024  \u44536 \u47532 \u49828 \u46020 \u50752  \u51652 \u47532 \u47484  \u45796 \u44057 \u51060  \u48176 \u48152 \u54616 \u45716  \u54665 \u46041 \u51012  \u52712 \u54616 \u50688 \u45796 .\
\uc0\u47336 \u53552 \u45716  \u51088 \u44592  \u51088 \u49888 , \u44263  \u51648 \u49345 \u51032  \u44032 \u51109  \u53360  \u49464 \u47141 \u51012  \u45824 \u54637 \u54616 \u44256  \u51080 \u45716  \u51088 \u44592  \u51088 \u49888 \u51012  \u48148 \u46972 \u48372 \u44256  \u51204 \u50984 \u54616 \u50688 \u45796 . \u50612 \u46500  \u46412 \u50640 \u45716  \u44536 \u44032  \u44284 \u50672  \u54616 \u45208 \u45784 \u51032  \u51648 \u46020 \u47484  \u46384 \u46972 \u49436  \u48277 \u50773 \u44368 \u51032  \u44428 \u50948 \u50640  \u45824 \u54637 \u54616 \u44256  \u51080 \u45716  \u44163 \u51064 \u51648  \u51032 \u49900 \u54616 \u44592 \u46020  \u54616 \u50688 \u45796 . \u44536 \u45716  \u46608  \u45796 \u51020 \u44284  \u44057 \u51060  \u44592 \u47197 \u54616 \u50688 \u45796 . \'93\u51648 \u49345 \u51032  \u44400 \u50773 \u46308 \u44284  \u50728  \u49464 \u44228 \u44032  \u46160 \u47140 \u50892 \u54616 \u44256  \u46496 \u45716  \u48277 \u50773 \u44428 \u51012  \u45824 \u54637 \u54616 \u50668  \u51068 \u50612 \u49440  \u45208 \u45716  \u45824 \u52404  \u47924 \u50631 \u51060 \u45264 ! \u52376 \u51020  2\u45380 \u44036  \u47560 \u51020 \u49549 \u51004 \u47196  \u50612 \u45712  \u51221 \u46020 \u51032  \u44256 \u48124 \u51012  \u54616 \u50688 \u51004 \u47728  \u49892 \u47581 \u44284  \u45209 \u45812 \u51012  \u44202 \u50632 \u45716 \u51648  \u50500 \u47924 \u46020  \u47784 \u47484  \u44163 \u51060 \u45796 \'94 (D\'92Au-bigne, b.3, ch.6). \u44536 \u47084 \u45208  \u44536 \u45716  \u50756 \u51204 \u55176  \u49892 \u47581 \u54616 \u46020 \u47197  \u48260 \u47140 \u51648 \u51648  \u50500 \u45768 \u54616 \u50688 \u45796 . \u44536 \u45716  \u49324 \u46988 \u51032  \u46020 \u50880 \u51060  \u45130 \u50612 \u51276 \u51012  \u46412 , \u54616 \u45208 \u45784 \u47564 \u51012  \u50521 \u47581 \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u45716  \u51204 \u45733 \u54616 \u49888  \u54616 \u45208 \u45784 \u51032  \u49552 \u51012  \u48537 \u46308  \u46412 \u50640  \u51208 \u45824 \u47196  \u50504 \u51204 \u54616 \u45796 \u45716  \u44163 \u51012  \u48176 \u50912 \u45796 .\
