\uc0\u47564 \u51068  \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u46308 \u51060  \u44216 \u49552 \u54616 \u44256  \u53685 \u54924 \u54616 \u45716  \u47560 \u51020 \u51004 \u47196  \u44536 \u46308 \u51032  \u51396 \u47484  \u44256 \u48177 \u54616 \u44256  \u48260 \u47532 \u47728 , \u48127 \u51020 \u51004 \u47196  \u44536 \u48516 \u51032  \u54728 \u46973 \u51012  \u44403 \u44172  \u48537 \u51105 \u45716 \u45796 \u47732  \u50501 \u51064 \u46308 \u51060 \u45208  \u47560 \u44480 \u46308 \u46020  \u54616 \u45208 \u45784 \u51032  \u49324 \u50629 \u51012  \u48169 \u54644 \u54616 \u44144 \u45208  \u44536 \u48516 \u51032  \u48177 \u49457 \u46308 \u51060  \u54616 \u45208 \u45784  \u50526 \u50640  \u45208 \u44032 \u45716  \u51068 \u51012  \u47561 \u51012  \u49688  \u50630 \u45796 . \u44277 \u44277 \u50672 \u54620  \u44163 \u51060 \u46304 \u51648  \u51008 \u48128 \u54620  \u44163 \u51060 \u46304 \u51648  \u47784 \u46304  \u50976 \u54841 \u44284  \u47784 \u46304  \u48152 \u45824  \u49464 \u47141 \u51008  \'93\u55192 \u51004 \u47196  \u46104 \u51648  \u50500 \u45768 \u54616 \u47728  \u45733 \u51004 \u47196  \u46104 \u51648  \u50500 \u45768 \u54616 \u44256  \u50724 \u51649  \u45208 \u51032  \u49888 \u51004 \u47196 \'94 (\u49829  4:6) \u49457 \u44277 \u51201 \u51064  \u51200 \u54637 \u51060  \u44032 \u45733 \u54616 \u45796 .\
