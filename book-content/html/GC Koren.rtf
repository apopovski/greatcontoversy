\uc0\u47336 \u53552 \u44032  \u48393 \u54616 \u50668 \u51652  \u49457 \u44221 \u51012  \u46021 \u51068  \u48177 \u49457 \u46308 \u50640 \u44172  \u50676 \u50612  \u51452 \u44256  \u51080 \u45716  \u46041 \u50504  \u54004 \u45916  (Tyndale) \u46020  \u54616 \u45208 \u45784 \u51032  \u49457 \u47161 \u51004 \u47196  \u44048 \u46041 \u51012  \u48155 \u50500  \u50689 \u44397 \u50640 \u49436  \u44057 \u51008  \u51068 \u51012  \u54616 \u50688 \u45796 . \u51060  \u51068 \u51060  \u51080 \u44592  \u51204 \u50640  \u50948 \u53364 \u47532 \u54532 \u44032  \u46972 \u54004 \u50612  \u49457 \u44221 \u50640 \u49436  \u51060 \u48120  \u49457 \u44221 \u51012  \u48264 \u50669 \u54616 \u44592 \u45716  \u54616 \u50688 \u51004 \u45208  \u44536 \u44163 \u51008  \u51096 \u47803  \u48264 \u50669 \u46108  \u45936 \u44032  \u47566 \u50520 \u45796 . \u44536 \u44163 \u51008  \u46608 \u54620  \u51064 \u49604 \u46104 \u51648  \u50506 \u50520 \u44592  \u46412 \u47928 \u50640  \u44032 \u44201 \u51060  \u45824 \u45800 \u55176  \u48708 \u49912 \u49436  \u48512 \u51088 \u45208  \u44480 \u51313 \u51060  \u50500 \u45768 \u47732  \u44032 \u51656  \u49688 \u44032  \u50630 \u50632 \u45796 . \u44536 \u49104  \u50500 \u45768 \u46972  \u44368 \u54924 \u50640 \u49436  \u44536  \u49457 \u44221 \u51012  \u50628 \u44201 \u54616 \u44172  \u44552 \u51648 \u54616 \u50688 \u44592  \u46412 \u47928 \u50640  \u48708 \u44368 \u51201  \u51329 \u51008  \u48276 \u50948 \u50640  \u44152 \u52432 \u49436  \u48372 \u44553 \u46104 \u50632 \u45796 . 1516\u45380 , \u44263  \u47336 \u53552 \u44032  95\u44060 \u51312 \u47484  \u44277 \u44060 \u54616 \u44592  \u51068  \u45380  \u51204 \u50640  \u50640 \u46972 \u49828 \u47924 \u49828 \u44032  \u54764 \u46972 \u50612 \u50752  \u46972 \u54004 \u50612 \u51032  \u49888 \u50557  \u49457 \u44221 \u51012  \u48156 \u54665 \u54616 \u50688 \u45716 \u45936 , \u44536 \u44163 \u51008  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51060  \u52376 \u51020 \u51004 \u47196  \u50896 \u50612  (original tongue) \u47196  \u52636 \u54032 \u46108  \u51068 \u51060 \u50632 \u45796 . \u51060  \u49457 \u44221 \u51004 \u47196  \u47568 \u48120 \u50516 \u50500  \u44536 \u51204 \u50640  \u48264 \u50669 \u46108  \u49457 \u44221 \u50640 \u49436  \u51096 \u47803 \u46108  \u51216 \u51060  \u51221 \u51221 \u46104 \u44256  \u51032 \u48120 \u44032  \u55016 \u50476  \u45908  \u48516 \u47749 \u54616 \u50668 \u51276 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44368 \u50577  \u51080 \u45716  \u49324 \u46988 \u46308 \u51060  \u45908 \u50865  \u52384 \u51200 \u54616 \u44172  \u51652 \u47532 \u51032  \u51648 \u49885 \u51012  \u49548 \u50976 \u54616 \u44172  \u46104 \u50632 \u44256 , \u44060 \u54785  \u49324 \u50629 \u50640  \u45824 \u54616 \u50668  \u49352 \u47196 \u50868  \u51088 \u44537 \u51012  \u48155 \u44172  \u46104 \u50632 \u45796 . \u44536 \u47084 \u45208  \u51068 \u48152  \u49324 \u46988 \u46308 \u51008  \u50668 \u51204 \u55176  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51012  \u45824 \u48512 \u48516  \u48155 \u51648  \u47803 \u54616 \u44256  \u51080 \u50632 \u45796 . \u44536 \u47084 \u54620  \u46412 \u50640  \u51088 \u44592  \u45208 \u46972 \u51032  \u48177 \u49457 \u46308 \u50640 \u44172  \u49457 \u44221 \u51012  \u48372 \u44553 \u54632 \u51004 \u47196 \u50024  \u50948 \u53364 \u47532 \u54532 \u51032  \u49324 \u50629 \u51012  \u50756 \u49457 \u49884 \u53412 \u44256 \u51088  \u54620  \u49324 \u46988 \u51060  \u44263  \u54004 \u45916 \u51060 \u50632 \u45796 .\
\uc0\u44540 \u47732 \u54620  \u54617 \u46020 \u50836 , \u50676 \u47148 \u54620  \u51652 \u47532 \u51032  \u53456 \u44396 \u51088 \u50688 \u45912  \u44536 \u45716  \u50640 \u46972 \u49828 \u47924 \u49828 \u51032  \u54764 \u46972 \u50612  \u49888 \u50557 \u50640 \u49436  \u48373 \u51020 \u51012  \u48155 \u50500 \u46308 \u50688 \u45796 . \u44536 \u45716  \u44648 \u45804 \u51008  \u48148 \u47484  \u46160 \u47140 \u50880  \u50630 \u51060  \u51204 \u54028 \u54616 \u44256 , \u47784 \u46304  \u44368 \u47532 \u47484  \u49457 \u44221 \u50640  \u48708 \u52628 \u50612  \u44160 \u53664 \u54644 \u50556  \u54620 \u45796 \u44256  \u44053 \u51312 \u54616 \u50688 \u45796 . \u44368 \u54924 \u44032  \u49457 \u44221 \u51012  \u51452 \u50632 \u44592  \u46412 \u47928 \u50640  \u50724 \u51649  \u44368 \u54924 \u47564 \u51060  \u49457 \u44221 \u51012  \u54644 \u49437 \u54624  \u49688  \u51080 \u45796 \u45716  \u48277 \u50773 \u44368 \u46020 \u46308 \u51032  \u51452 \u51109 \u50640  \u45824 \u54616 \u50668  \u54004 \u45916 \u51008  \u45796 \u51020 \u44284  \u44057 \u51060  \u45824 \u45813 \u54616 \u50688 \u45796 . \'93\u45320 \u55148 \u45716  \u45572 \u44032  \u46021 \u49688 \u47532 \u50640 \u44172  \u47673 \u51012  \u44163 \u51012  \u52286 \u46020 \u47197  \u44032 \u47476 \u52432  \u51452 \u50632 \u45716 \u51648  \u50500 \u45712 \u45264 ? \u44536  \u46041 \u51068 \u54620  \u54616 \u45208 \u45784 \u44760 \u49436  \u45817 \u49888 \u51032  \u44406 \u51452 \u47536  \u51088 \u45376 \u46308 \u50640 \u44172  \u45817 \u49888 \u51032  \u47568 \u50432 \u51012  \u53685 \u54616 \u50668  \u44536 \u46308 \u51032  \u50500 \u48260 \u51648 \u47484  \u52286 \u50500 \u45236 \u46020 \u47197  \u44032 \u47476 \u52432  \u51452 \u49888 \u45796 . \u44536 \u47088 \u45936  \u49457 \u44221 \u51012  \u50864 \u47532 \u50640 \u44172  \u51452 \u44592 \u45716 \u52964 \u45397  \u50864 \u47532 \u50640 \u44172 \u49436  \u44048 \u52628 \u44256  \u51080 \u45716  \u49324 \u46988 \u46308 \u51008  \u45320 \u55148 \u46308 \u51060 \u45796 . \u50864 \u47532 \u50640 \u44172  \u49457 \u44221 \u51012  \u44032 \u47476 \u52432  \u51452 \u45716  \u49324 \u46988 \u46308 \u51012  \u54868 \u54805 \u49884 \u53412 \u45716  \u49324 \u46988 \u46308 \u51008  \u45320 \u55148 \u46308 \u51060 \u45796 . \u44536 \u47084 \u48064 \u47196  \u45320 \u55148 \u46308 \u51008  \u54624  \u49688 \u47564  \u51080 \u51004 \u47732  \u49457 \u44221  \u51088 \u52404 \u44620 \u51648 \u46020  \u48520 \u49332 \u46972  \u48260 \u47540  \u44163 \u51060 \u45796 \'94 (D\'92Aubigne, History of the Reformation of the Sixteenth Century, b.18, ch.4).\
