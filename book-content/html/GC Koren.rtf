\f1\b0 \cf0 \
\uc0\u49457 \u44221 \u51060  \u45208 \u50724 \u44172  \u46104 \u51088  \u44368 \u54924 \u51032  \u45817 \u44397 \u51088 \u46308 \u51008  \u45817 \u54889 \u54616 \u44172  \u46104 \u50632 \u45796 . \u44536 \u46308 \u51008  \u51060 \u51228  \u50948 \u53364 \u47532 \u54532 \u48372 \u45796  \u45908 \u50865  \u44053 \u54620  \u44163 , \u44263  \u44536 \u46308 \u51032  \u47924 \u44592 \u46020  \u44144 \u51032  \u49548 \u50857 \u50630 \u51012  \u51221 \u46020 \u51032  \u53360  \u55192 \u44284  \u45824 \u44208 \u54616 \u44172  \u46104 \u50632 \u45796 . \u44536  \u45817 \u49884  \u50689 \u44397 \u50640 \u45716  \u51088 \u44397 \u50612 \u47196  \u46108  \u49457 \u44221 \u51060  \u52636 \u54032 \u46104 \u51648  \u50500 \u45768 \u54616 \u50688 \u51004 \u48064 \u47196 , \u50500 \u51649 \u44620 \u51648  \u49457 \u44221 \u51012  \u44552 \u51648 \u54616 \u45716  \u48277 \u47161 \u51060  \u49373 \u44592 \u51648  \u50500 \u45768 \u54616 \u50688 \u45796 . \u44536 \u47088  \u48277 \u47161 \u46308 \u51008  \u44536  \u54980 \u50640  \u51228 \u51221 \u46104 \u50612  \u44053 \u47141 \u54616 \u44172  \u49884 \u54665 \u46104 \u50632 \u45796 . \u44536 \u47084 \u48064 \u47196  \u49849 \u47140 \u46308 \u51032  \u48152 \u45824 \u45716  \u51080 \u50632 \u51012 \u51648 \u46972 \u46020  \u50620 \u47560 \u51032  \u44592 \u44036  \u46041 \u50504  \u49457 \u44221 \u51060  \u48176 \u54252  (\u37197 \u24067 ) \u46112  \u44592 \u54924 \u44032  \u51452 \u50612 \u51276 \u45796 .\
\uc0\u48277 \u50773 \u44368 \u51032  \u51648 \u46020 \u51088 \u46308 \u51008  \u44060 \u54785 \u51088 \u51032  \u49548 \u47532 \u47484  \u52840 \u47925 \u49884 \u53412 \u44592  \u50948 \u54616 \u50668  \u45796 \u49884  \u51020 \u47784 \u47484  \u44984 \u47748 \u45796 . \u44060 \u54785 \u51088 \u45716  \u49464  \u48264 \u51060 \u45208  \u49900 \u47928 \u51012  \u48155 \u44592  \u50948 \u54616 \u50668  \u48277 \u51221 \u50640  \u49548 \u54872 \u46104 \u50632 \u51004 \u45208  \u48169 \u47732 \u46104 \u50632 \u45796 . \u44536 \u47084 \u45208  \u52395 \u51704 \u47196  \u44048 \u46021 \u46308 \u51032  \u51333 \u44368  \u54924 \u51032 \u50640 \u49436  \u44536 \u51032  \u51200 \u49436 \u47484  \u51060 \u45800 \u51060 \u46972 \u44256  \u49440 \u44256 \u54616 \u44256 , \u44536 \u46308 \u51008  \u51210 \u51008  \u50773  \u47532 \u52320 \u46300  2\u49464 \u47484  \u44536 \u46308  \u54200 \u51004 \u47196  \u45132 \u50612 \u46308 \u50668  \u45572 \u44396 \u45208  \u44552 \u51648 \u46108  \u44368 \u47532 \u47484  \u51648 \u51648 \u54616 \u45716  \u51088 \u45716  \u53804 \u50725 \u49884 \u53420  \u44163 \u51060 \u46972 \u45716  \u52825 \u47161 \u51012  \u48152 \u54252 \u54616 \u44172  \u54616 \u50688 \u45796 .\
\uc0\u50948 \u53364 \u47532 \u54532 \u45716  \u51333 \u44368  \u54924 \u51032 \u47196 \u48512 \u53552  \u44397 \u54924 \u50640  \u54840 \u49548 \u54616 \u50688 \u51004 \u47728 , \u44536 \u45716  \u44397 \u54924 \u50640 \u49436  \u46160 \u47140 \u50880  \u50630 \u51060  \u44368 \u51649  \u51221 \u52824 \u47484  \u48708 \u45212 \u54616 \u44256 , \u44368 \u54924 \u44032  \u49884 \u51064 \u54620  \u47924 \u49436 \u50868  \u50501 \u54224 \u46308 \u51012  \u54785 \u49888 \u54624  \u44163 \u51012  \u50836 \u44396 \u54616 \u50688 \u45796 . \u44536 \u45716  \u54869 \u49888 \u51012  \u44032 \u51648 \u44256  \u48277 \u50773 \u52769 \u51032  \u52280 \u46988 \u44284  \u53440 \u46973 \u51012  \u54253 \u47196 \u54616 \u50688 \u45796 . \u44536 \u51032  \u50896 \u49688 \u46308 \u51008  \u54844 \u46976 \u50640  \u48736 \u51276 \u45796 . \u51060 \u48120  \u50948 \u53364 \u47532 \u54532 \u51032  \u52828 \u44396 \u46308 \u44284  \u51648 \u51648 \u51088 \u46308 \u51008  \u48512 \u46301 \u51060  \u44404 \u48373 \u54616 \u46020 \u47197  \u44053 \u50836 \u46104 \u50632 \u45796 . \u44536 \u47084 \u48064 \u47196  \u44256 \u47549 \u47924 \u50896  (\u23396 \u31435 \u28961 \u25588 ) \u54620  \u45721 \u51008  \u44060 \u54785 \u51088 \u46020  \u51076 \u44552 \u44284  \u48277 \u50773 \u51032  \u50672 \u54633 \u46108  \u44428 \u50948  \u50526 \u50640  \u47924 \u47502 \u51012  \u44999 \u51648  \u50506 \u51012  \u49688  \u50630 \u51004 \u47532 \u46972 \u44256  \u44592 \u45824 \u46104 \u44256  \u51080 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44536 \u47111 \u44172  \u46104 \u45716  \u45824 \u49888 \u50640  \u48277 \u50773 \u44368 \u46020 \u46308 \u51008  \u51088 \u44592 \u46308 \u51060  \u54056 \u48176 \u45817 \u54620  \u44163 \u51012  \u50508 \u44172  \u46104 \u50632 \u45796 . \u51032 \u54924 \u45716  \u50948 \u53364 \u47532 \u54532 \u51032  \u44048 \u46041 \u51201 \u51064  \u54840 \u49548 \u50640  \u44048 \u54868 \u47484  \u48155 \u44256 , \u54605 \u48149 \u54616 \u45716  \u52825 \u47161 \u51012  \u52384 \u54924 \u49884 \u53040 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44060 \u54785 \u51088 \u45716  \u45796 \u49884  \u51088 \u50976 \u47213 \u44172  \u46104 \u50632 \u45796 .\
\uc0\u44536 \u45716  \u49464  \u48264 \u51704 \u51032  \u49900 \u47928 \u51012  \u48155 \u44172  \u46104 \u50632 \u45716 \u45936 , \u44397 \u45236 \u51032  \u52572 \u44256  \u51333 \u44368  \u51116 \u54032 \u49548 \u50640 \u49436  \u48155 \u50520 \u45796 . \u51060 \u44275 \u51008  \u51060 \u45800 \u51088 \u50640 \u44172  \u50500 \u47924 \u47088  \u50976 \u47532 \u54620  \u54032 \u44208 \u51060  \u45236 \u47540  \u49688  \u50630 \u45716  \u44275 \u51060 \u45796 . \u50668 \u44592 \u50640 \u49436  \u47196 \u47560 \u44368 \u45716  \u52572 \u54980 \u51032  \u49849 \u47532 \u47484  \u50619 \u44256 , \u44060 \u54785 \u51088 \u51032  \u54876 \u46041 \u51008  \u51221 \u51648 \u46104 \u47532 \u46972 \u44256  \u48277 \u50773 \u44368 \u46020 \u46308 \u51008  \u49373 \u44033 \u54616 \u50688 \u45796 . \u47924 \u49832  \u48169 \u48277 \u51004 \u47196 \u46304 \u51648  \u44536 \u46308 \u51032  \u47785 \u51201 \u51012  \u49457 \u52712 \u54624  \u49688 \u47564  \u51080 \u45796 \u47732  \u50948 \u53364 \u47532 \u54532 \u45716  \u54616 \u45716  \u49688  \u50630 \u51060  \u51088 \u44592 \u51032  \u44368 \u47532 \u47484  \u48260 \u47532 \u46304 \u51648  \u54868 \u54805 \u51032  \u49440 \u44256 \u47484  \u48155 \u44256  \u48277 \u51221 \u51012  \u46496 \u45208 \u44032 \u46304 \u51648  \u54624  \u44163 \u51060 \u50632 \u45796 .\
\uc0\u44536 \u47084 \u45208  \u50948 \u53364 \u47532 \u54532 \u45716  \u51088 \u44592 \u51032  \u44368 \u47532 \u47484  \u52384 \u54924 \u54616 \u51648 \u46020  \u50506 \u44256  \u49704 \u44592 \u51648 \u46020  \u50506 \u50520 \u45796 . \u44536 \u45716  \u46160 \u47140 \u50880  \u50630 \u51060  \u51088 \u44592 \u44032  \u44032 \u47476 \u52824 \u45716  \u48148 \u47484  \u51452 \u51109 \u54616 \u44256  \u51088 \u44592 \u47484  \u48149 \u54644 \u54616 \u45716  \u51088 \u46308 \u51032  \u48708 \u45212 \u51012  \u48152 \u48149 \u54616 \u50688 \u45796 . \u44536 \u45716  \u51088 \u44592  \u51088 \u49888 \u44284  \u51088 \u44592 \u51032  \u50948 \u52824 \u50752  \u51088 \u44592 \u51032  \u54872 \u44221 \u51012  \u45796  \u51082 \u50612 \u48260 \u47532 \u44256 , \u44536 \u51032  \u52397 \u51473 \u46308 \u51012  \u54616 \u45208 \u45784 \u51032  \u49900 \u54032 \u51221 \u50640  \u49464 \u50892  \u45459 \u44256 , \u44536 \u46308 \u51032  \u44452 \u48320 \u44284  \u44592 \u47564 \u51012  \u50689 \u50896 \u54620  \u51652 \u47532 \u51032  \u51200 \u50872 \u47196  \u45804 \u50520 \u45796 . \u49457 \u47161 \u51032  \u44428 \u45733 \u51060  \u44536  \u48277 \u51221  \u50504 \u50640  \u52649 \u47564 \u54616 \u50688 \u45796 . \u54616 \u45208 \u45784 \u44760 \u47196 \u48512 \u53552  \u50724 \u45716  \u51060 \u49345 \u54620  \u55192 \u51060  \u52397 \u51473 \u46308 \u50640 \u44172  \u51076 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u44536  \u51088 \u47532 \u47484  \u46496 \u45208 \u44040  \u55192 \u51060  \u50630 \u45716  \u46319 \u51060  \u48372 \u50688 \u45796 . \u44060 \u54785 \u51088 \u51032  \u47568 \u51008  \u47560 \u52824  \u54616 \u45208 \u45784 \u51032  \u51204 \u53685  (\u31661 \u31570 ) \u50640 \u49436  \u45208 \u50728  \u54868 \u49332 \u52376 \u47100  \u46307 \u45716  \u51060 \u46308 \u51032  \u47560 \u51020 \u51012  \u52244 \u47104 \u45796 . \u44536 \u47484  \u51060 \u45800 \u51060 \u46972 \u44256  \u48708 \u45212 \u54664 \u45912  \u44536 \u46308 \u51032  \u44256 \u49548 \u47484  \u44536 \u45716  \u49444 \u48373 \u49884 \u53412 \u45716  \u45733 \u47141 \u51012  \u44032 \u51648 \u44256  \u51060 \u51228  \u44536  \u49324 \u46988 \u46308 \u50640 \u44172  \u46104 \u46028 \u47160 \u45796 . \u50612 \u52236 \u54616 \u50668  \u44536 \u46308 \u51060  \u51088 \u44592 \u46308 \u51032  \u50724 \u47448 \u47484  \u54140 \u46888 \u47532 \u44256 \u51088  \u54616 \u50688 \u45716 \u44032 \u46972 \u44256  \u44536 \u45716  \u48512 \u47476 \u51670 \u50632 \u45796 . \'93\u51060  (\u63965 ) \u47484  \u50619 \u44592  \u50948 \u54616 \u50668 , \u54616 \u45208 \u45784 \u51032  \u51008 \u54812 \u47484  \u49345 \u54408 \u54868 \u54616 \u44256 \u51088 ?\'94\
\uc0\u44536 \u45716  \u46608  \u47560 \u51648 \u47561 \u51004 \u47196 , \'93\u44536 \u45824 \u46308 \u51008  \u45572 \u44396 \u50752  \u45908 \u48520 \u50612  \u49912 \u50864 \u44256  \u51080 \u45796 \u44256  \u49373 \u44033 \u54616 \u45716 \u44032 ? \u47924 \u45924 \u50640  \u46308 \u50612 \u44032 \u44592  \u51649 \u51204 \u50640  \u51080 \u45716  \u45721 \u51008 \u51060 \u50752  \u45908 \u48520 \u50612  \u49912 \u50864 \u44256  \u51080 \u45716 \u44032 ? \u44208 \u53076  \u44536 \u47111 \u51648  \u50506 \u45796 . \u44536 \u45824 \u46308 \u51008  \u51652 \u47532 , \u44263  \u44536 \u45824 \u46308 \u48372 \u45796  \u45908 \u50865  \u44053 \u54616 \u47728  \u47560 \u52840 \u45236  \u44536 \u45824 \u46308 \u51012  \u51060 \u44592 \u44256 \u50556  \u47568  \u51652 \u47532 \u50752  \u45908 \u48520 \u50612  \u49912 \u50864 \u44256  \u51080 \u45716  \u44163 \u51060 \u45796 \'94 (Wylie, b.2, ch.13) \u46972 \u44256  \u47568 \u54616 \u50688 \u45796 . \u44536 \u47111 \u44172  \u47568 \u54620  \u45796 \u51020 \u50640 \u45716  \u48277 \u51221 \u51012  \u45208 \u50772 \u51004 \u45208  \u44536 \u51032  \u50896 \u49688 \u46308  \u51473 \u50640 \u49436  \u54620  \u49324 \u46988 \u46020  \u44536 \u47484  \u47561 \u45716  \u51088 \u44032  \u50630 \u50632 \u45796 .\
\pard\pardeftab720\sa319\partightenfactor0

\f0\b \cf0 \uc0\u48277 \u50773 \u50640  \u45824 \u54620  \u52572 \u54980 \u51032  \u44221 \u44256 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u50948 \u53364 \u47532 \u54532 \u51032  \u49324 \u50629 \u51008  \u44144 \u51032  \u47560 \u52432 \u51276 \u45796 . \u50724 \u47019 \u46041 \u50504  \u51536 \u44256  \u51080 \u45912  \u51652 \u47532 \u51032  \u44611 \u48156 \u51008  \u44263  \u44536 \u51032  \u49552 \u50640 \u49436  \u46496 \u45216  \u44163 \u51060 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u45796 \u49884  \u54620  \u48264  \u48373 \u51020 \u51012  \u50948 \u54616 \u50668  \u51613 \u44144 \u54624  \u44163 \u51060 \u50632 \u45796 . \u44536  \u51652 \u47532 \u45716  \u48148 \u47196  \u50724 \u47448 \u51032  \u50773 \u44397 \u51032  \u48376 \u44144 \u51648 \u50640 \u49436  \u49440 \u54252 \u46104 \u50612 \u50556  \u54624  \u44163 \u51060 \u50632 \u45796 . \u50948 \u53364 \u47532 \u54532 \u45716  \u49900 \u47928 \u51012  \u48155 \u44592  \u50948 \u54616 \u50668  \u45320 \u47924 \u46020  \u51088 \u51452  \u49457 \u46020 \u46308 \u51032  \u54588 \u47484  \u50519 \u50500 \u44036  \u47196 \u47560 \u48277 \u50773 \u51032  \u51116 \u54032 \u51221 \u50640  \u54840 \u52636 \u46104 \u50632 \u45796 . \u44536 \u45716  \u51088 \u44592 \u47484  \u50948 \u54801 \u54616 \u44256  \u51080 \u45716  \u50948 \u54744 \u51012  \u50508 \u44256  \u51080 \u50632 \u51648 \u47564  \u44536  \u49548 \u54872 \u50640  \u51025 \u54616 \u44256 \u51088  \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u47560 \u52840  \u44536  \u46412  \u44536 \u45716  \u51473 \u54413 \u51004 \u47196  \u50668 \u54665 \u51012  \u54624  \u49688  \u50630 \u50632 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u45716  \u50977 \u49457 \u51004 \u47196 \u45716  \u47196 \u47560 \u50640 \u49436  \u47568 \u54624  \u49688  \u50630 \u50632 \u51012 \u51648 \u46972 \u46020  \u54200 \u51648 \u47196 \u45716  \u47568 \u54624  \u49688  \u51080 \u50632 \u51004 \u48064 \u47196 , \u44536 \u45716  \u44208 \u44397  \u44536 \u47111 \u44172  \u54616 \u44592 \u47196  \u44208 \u49900 \u54616 \u50688 \u45796 . \u44536 \u45716  \u51088 \u44592 \u51032  \u47785 \u49324 \u44288 \u50640 \u49436  \u48277 \u50773 \u50640 \u44172  \u48372 \u45244  \u54200 \u51648 \u47484  \u50044 \u45796 . \u44536  \u54200 \u51648 \u50640 \u45716  \u50696 \u51032 \u48148 \u47480  \u50616 \u49324 \u50752  \u44536 \u47532 \u49828 \u46020 \u51064 \u51201  \u51221 \u49888 \u51060  \u45208 \u53440 \u45208  \u51080 \u50632 \u51004 \u45208  \u48277 \u50773 \u52397 \u51032  \u54728 \u49885 \u44284  \u44368 \u47564 \u51012  \u45216 \u52852 \u47213 \u44172  \u44204 \u52293 \u54616 \u45716  \u45236 \u50857 \u51012  \u45812 \u44256  \u51080 \u50632 \u45796 .\
\'93\uc0\u45208 \u45716  \u45236 \u44032  \u44032 \u51648 \u44256  \u51080 \u45716  \u49888 \u50521 \u51012  \u47784 \u46304  \u49324 \u46988 , \u53945 \u55176  \u47196 \u47560  \u51452 \u44368  (\u48277 \u50773 ) \u50640 \u44172  \u44277 \u44060 \u54616 \u50668  \u51452 \u51109 \u54624  \u49688  \u51080 \u45716  \u44163 \u51012  \u47588 \u50864  \u44592 \u49240 \u44172  \u49373 \u44033 \u54620 \u45796 . \u45208 \u45716  \u51060  \u49888 \u50521 \u51060  \u44148 \u51204 \u54616 \u44256  \u52280 \u46108  \u51460 \u47196  \u48127 \u44592  \u46412 \u47928 \u50640  \u44536 \u45716  \u44032 \u51109  \u51600 \u44144 \u50868  \u47560 \u51020 \u51004 \u47196  \u45236 \u44032  \u51452 \u51109 \u54616 \u45716  \u49888 \u50521 \u50640  \u46041 \u51032 \u54624  \u51460 \u47196  \u48127 \u51004 \u47728 , \u47564 \u51068  \u44536  \u49888 \u50521 \u51060  \u51096 \u47803 \u46108  \u44163 \u51060 \u46972 \u47732  \u50669 \u49884  \u44368 \u51221 \u54616 \u50668  \u51460  \u51460 \u47196  \u48127 \u45716 \u45796 .\
\uc0\u45208 \u45716  \u52395 \u51704 \u47196  \u44536 \u47532 \u49828 \u46020 \u51032  \u48373 \u51020 \u51008  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51032  \u51204 \u48512 \u46972 \u44256  \u48127 \u45716 \u45796 . \'85\u47196 \u47560  \u44048 \u46021 \u51060  \u51648 \u49345 \u50640  \u51080 \u45716  \u44536 \u47532 \u49828 \u46020 \u51032  \u45824 \u47532 \u51088 \u46972 \u47732 , \u44536 \u45716  \u45796 \u47480  \u50612 \u46500  \u49324 \u46988 \u48372 \u45796  \u48373 \u51020 \u51032  \u50984 \u48277 \u50640  \u44208 \u49549 \u46104 \u50612  \u51080 \u50612 \u50556  \u54620 \u45796 \u44256  \u45208 \u45716  \u48127 \u45716 \u45796 . \u44536 \u47532 \u49828 \u46020 \u51032  \u51228 \u51088 \u46308  \u44032 \u50868 \u45936 \u49436  \u50948 \u45824 \u54616 \u45796 \u44256  \u54616 \u45716  \u44163 \u51008  \u50612 \u46500  \u49464 \u49549 \u51201  \u50948 \u50628 \u51060 \u45208  \u47749 \u50696 \u50640  \u51080 \u51648  \u50500 \u45768 \u54616 \u44256  \u44536 \u47532 \u49828 \u46020 \u51032  \u49373 \u50528 \u50752  \u44536 \u48516 \u51032  \u53468 \u46020 \u50640  \u44032 \u44637 \u44172 , \u46608 \u54620  \u51221 \u54869 \u54616 \u44172  \u46384 \u46972 \u44032 \u44256  \u51080 \u45716  \u51216 \u50640 \u49436  \u44536 \u47084 \u54616 \u50688 \u45796 . \'85\u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u49464 \u49345 \u50640  \u44228 \u49512 \u51012  \u45817 \u49884 \u51032  \u49373 \u50528 \u45716  \u44032 \u51109  \u48712 \u44260 \u54616 \u44256 , \u47784 \u46304  \u49464 \u49549 \u51201  \u44428 \u47141 \u44284  \u47749 \u50696 \u50640 \u49436  \u46496 \u45212  \u49373 \u50528 \u50688 \u45796 .\
\uc0\u50612 \u46500  \u49888 \u49892 \u54620  \u49324 \u46988 \u46020  \u48277 \u50773 \u51060 \u45208  \u50612 \u46500  \u49457 \u51064 \u51012  \u46384 \u46972 \u44040  \u46412 , \u44536 \u46308 \u51060  \u48148 \u47196  \u51452  \u50696 \u49688  \u44536 \u47532 \u49828 \u46020 \u47484  \u46384 \u46972 \u44036  \u44536  \u51216 \u50640  \u51080 \u50612 \u49436 \u47564  \u44536 \u47484  \u46384 \u46972 \u50556  \u54624  \u44163 \u51060 \u45796 . \u50780 \u45264 \u54616 \u47732  \u48288 \u46300 \u47196 \u50752  \u49464 \u48288 \u45824 \u51032  \u50500 \u46308 \u46308 \u51008  \u44536 \u47532 \u49828 \u46020 \u51032  \u48156 \u51088 \u52712 \u47484  \u46384 \u46972 \u44032 \u45716  \u45824 \u49888 \u50640  \u49464 \u49549 \u51201  \u47749 \u50696 \u47484  \u49324 \u47784 \u54632 \u51004 \u47196  \u51396 \u47484  \u48276 \u54616 \u50688 \u44592  \u46412 \u47928 \u51060 \u45796 . \u44536 \u47084 \u48064 \u47196  \u50864 \u47532 \u46308 \u51008  \u44536 \u50752  \u44057 \u51008  \u51096 \u47803 \u51012  \u48276 \u54644 \u49436 \u45716  \u50504  \u46112  \u44163 \u51060 \u45796 . \'85\
\uc0\u48277 \u50773 \u51008  \u51088 \u44592 \u51032  \u47784 \u46304  \u50689 \u53664 \u50752  \u53685 \u52824 \u44428 \u51012  \u49464 \u49549 \u51201  \u44428 \u47141 \u50640 \u44172  \u47560 \u46405 \u55176  \u45336 \u44200 \u51452 \u44256 , \u46608 \u54620  \u51088 \u44592 \u50640 \u44172  \u49549 \u54620  \u47784 \u46304  \u44368 \u51649 \u51088 \u46308 \u50640 \u44172 \u46020  \u44536 \u47111 \u44172  \u44032 \u47476 \u52824 \u44256  \u44536 \u47111 \u44172  \u51060 \u54665 \u54616 \u46020 \u47197  \u54644 \u50556  \u54620 \u45796 . \u50780 \u45264 \u54616 \u47732  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u44536 \u47111 \u44172  \u54616 \u49512 \u44256 , \u53945 \u48324 \u55176  \u44536 \u48516 \u51032  \u51228 \u51088 \u46308 \u46020  \u44536 \u47111 \u44172  \u54616 \u50688 \u44592  \u46412 \u47928 \u51060 \u45796 . \u44536 \u47084 \u48064 \u47196  \u51060 \u47088  \u51216 \u46308 \u50640  \u51080 \u50612 \u49436  \u45236 \u44172  \u51096 \u47803 \u51060  \u51080 \u51004 \u47732  \u45208 \u45716  \u44216 \u49552 \u54620  \u47560 \u51020 \u51004 \u47196  \u51060 \u47484  \u51221 \u51221  (\u35330 \u27491 ) \u54624  \u44163 \u51060 \u47728 , \u47564 \u51068  \u54596 \u50836 \u54616 \u45796 \u47732  \u51453 \u51020 \u51060 \u46972 \u46020  \u49324 \u50577 \u52824  \u50500 \u45768 \u54624  \u44163 \u51060 \u45796 . \u45236  \u51088 \u49888 \u51032  \u46907 \u44284  \u49548 \u50896 \u45824 \u47196  \u54620 \u45796 \u47732 , \u45208 \u45716  \u53952 \u47548 \u50630 \u51060  \u47196 \u47560  \u44048 \u46021  \u50526 \u51004 \u47196  \u45804 \u47140  \u45208 \u50500 \u44052 \u51012  \u44163 \u51060 \u45796 . \u44536 \u47084 \u45208  \u51452 \u45784 \u44760 \u49436 \u45716  \u44536 \u50752  \u48152 \u45824 \u47196  \u45796 \u47480  \u51068 \u51060  \u45236 \u44172  \u49373 \u44592 \u44172  \u54616 \u49492 \u49436  \u45208 \u47196  \u54616 \u50668 \u44552  \u49324 \u46988 \u51012  \u49692 \u51333 \u54616 \u44592 \u48372 \u45796  \u54616 \u45208 \u45784 \u51012  \u49692 \u51333 \u54616 \u46020 \u47197  \u44032 \u47476 \u52432  \u51452 \u49512 \u45796 .\'94\
\uc0\u44536 \u45716  \u45796 \u51020 \u44284  \u44057 \u51008  \u47568 \u47196  \u54200 \u51648 \u47484  \u47560 \u52452 \u45796 . \'93\u50864 \u47532  \u54616 \u45208 \u45784 \u44760 \u49436  \u48277 \u50773  \u50612 \u48152  6\u49464 \u51032  \u47560 \u51020 \u51012  \u44048 \u46041 \u54616 \u49324  \u44536 \u44032  \u52828 \u55176  \u48376 \u51012  \u48372 \u50668  \u44536 \u51032  \u44368 \u51649 \u51088 \u46308 \u44284  \u54632 \u44760  \u44536  \u49373 \u54876 \u44284  \u53468 \u46020 \u50640  \u51080 \u50612 \u49436  \u51452  \u50696 \u49688  \u44536 \u47532 \u49828 \u46020 \u47484  \u46384 \u46972 \u44032 \u44256 , \u46608 \u54620  \u44536 \u46308 \u51060  \u48177 \u49457 \u46308 \u51012  \u54952 \u44284 \u51201 \u51004 \u47196  \u44032 \u47476 \u52432 \u49436  \u44536 \u46308 \u44284  \u47560 \u52268 \u44032 \u51648 \u47196  \u49888 \u49892 \u55176  \u51452 \u45784 \u51012  \u46384 \u47476 \u44172  \u46104 \u44592 \u47484  \u50864 \u47532 \u45716  \u44592 \u46020 \u54616 \u45716  \u48148 \u51060 \u45796 \'94 (John Foxe, Acts and Monu-ments, vol.3, pp.49, 50).\
\uc0\u51060 \u50752  \u44057 \u51060  \u50948 \u53364 \u47532 \u54532 \u45716  \u48277 \u50773 \u44284  \u44536 \u51032  \u52628 \u44592 \u44221 \u46308 \u50640 \u44172  \u44536 \u47532 \u49828 \u46020 \u51032  \u50728 \u50976 \u50752  \u44216 \u49552 \u51012  \u45208 \u53440 \u45236  \u51452 \u50632 \u44256  \u51060 \u46308 \u51060  \u45824 \u54364 \u54616 \u44256  \u51080 \u45432 \u46972 \u44256  \u44277 \u50616 \u54616 \u45716  \u51452 \u45784 \u44284  \u44536 \u46308  \u51088 \u49888 \u44284 \u51032  \u54788 \u51200 \u54620  \u52264 \u51060 \u47484  \u44536 \u46308  \u51088 \u49888 \u50640 \u44172 \u49104 \u47564  \u50500 \u45768 \u46972  \u47784 \u46304  \u44536 \u47532 \u49828 \u46020 \u44368 \u44397 \u50640  \u45208 \u53440 \u45236  \u48372 \u50668  \u51452 \u50632 \u45796 .\
