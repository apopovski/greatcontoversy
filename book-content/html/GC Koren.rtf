\f0\b \cf0 \uc0\u54980 \u49828 \u51032  \u51109 \u47148 \u54620  \u52572 \u54980 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u54980 \u49828 \u45716  \u47560 \u51648 \u47561 \u51004 \u47196  \u53360  \u54924 \u51032 \u50640  \u49548 \u54872 \u46104 \u50632 \u45796 . \u44536 \u44163 \u51008  \u49892 \u47196  \u44508 \u47784 \u44032  \u53356 \u44256 \u46020  \u50628 \u49689 \u54620  \u51665 \u54924 \u50688 \u45796 . \u54889 \u51228 \u50752  \u50773 \u44277 \u44284  \u49324 \u49888 \u44284  \u52628 \u44592 \u44221 \u46308 \u44284  \u44048 \u46021 \u44284  \u49888 \u48512 \u46308 \u51060  \u50676 \u49437 \u54616 \u44256 , \u48150 \u50640 \u45716  \u54728 \u45796 \u54620  \u48169 \u52397 \u51088 \u44032  \u47784 \u50668  \u51080 \u50632 \u45796 . \u44536 \u46308 \u51008  \u50577 \u49900 \u51032  \u51088 \u50976 \u47484  \u50619 \u44592  \u50948 \u54620  \u44596  \u53804 \u51137 \u50640 \u49436  \u52572 \u52488 \u51032  \u53360  \u55148 \u49373 \u51088 \u47484  \u47785 \u44201 \u54616 \u44256 \u51088  \u44536 \u47532 \u49828 \u46020 \u44368 \u44397 \u51032  \u44033  \u44275 \u50640 \u49436  \u47784 \u51064  \u49324 \u46988 \u46308 \u51060 \u50632 \u45796 .\
\uc0\u54980 \u49828 \u45716  \u52572 \u54980 \u51032  \u44208 \u49900 \u51012  \u54364 \u47749 \u54616 \u46020 \u47197  \u50836 \u44396 \u48155 \u50520 \u51012  \u46412 , \u51088 \u44592 \u51032  \u44204 \u54644 \u47484  \u52384 \u54924 \u54616 \u44592 \u47484  \u45800 \u54840 \u54616 \u44172  \u44144 \u51208 \u54616 \u50688 \u45796 . \u44536 \u45716  \u50557 \u49549 \u54620  \u48148 \u47484  \u50500 \u47924 \u47088  \u44032 \u52293  \u50630 \u51060  \u44648 \u46888 \u47140 \u48260 \u47536  \u54889 \u51228 \u47484  \u46763 \u50612 \u51648 \u44172  \u52432 \u45796 \u48372 \u47732 \u49436  \'93\u45208 \u45716  \u50668 \u44592  \u51076 \u49437 \u54620  \u54889 \u51228 \u51032  \u49888 \u51032  (\u20449 \u32681 ) \u50752  \u44277 \u44277 \u50672 \u54620  \u48372 \u54840  \u50500 \u47000  \u45236  \u51088 \u49888 \u51032  \u51088 \u50976 \u51032 \u49324 \u50640  \u51032 \u54616 \u50668  \u45824 \u54924 \u51032 \u50640  \u52636 \u49437 \u54616 \u44592 \u47196  \u44208 \u49900 \u54620  \u44163 \u51060 \u45796 \'94 (Bonnechose, vol.2, p.84) \u46972 \u44256  \u50616 \u47749 \u54616 \u50688 \u45796 . \u44536 \u47084 \u51088  \u44144 \u44592 \u50640  \u47784 \u51064  \u47784 \u46304  \u49324 \u46988 \u51032  \u49884 \u49440 \u51060  \u51068 \u51228 \u55176  \u54889 \u51228 \u50640 \u44172  \u51665 \u51473 \u46104 \u50632 \u51004 \u47728 , \u49884 \u44592 \u49828 \u47928 \u53944 \u45716  \u50620 \u44404 \u51012  \u48521 \u54804 \u45796 .\
\uc0\u49440 \u44256 \u44032  \u50616 \u46020 \u46104 \u44256 , \u51648 \u50948 \u47484  \u48149 \u53448 \u54616 \u45716  \u51032 \u49885 \u51060  \u49884 \u51089 \u46104 \u50632 \u45796 . \u44048 \u46021 \u46308 \u51008  \u44536  \u51396 \u49688 \u50640 \u44172  \u49849 \u47140 \u50752  \u44057 \u51008  \u50743 \u51012  \u51077 \u54804 \u45796 . \u54980 \u49828 \u45716  \u49849 \u48373 \u51012  \u49552 \u50640  \u46308 \u44256  \'93\u50864 \u47532  \u51452  \u50696 \u49688  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u52824 \u50837 \u51012  \u48155 \u51004 \u49892  \u46412 \u50640  \u55152 \u50743 \u51012  \u51077 \u51004 \u49884 \u44256  \u54756 \u47215 \u50640 \u44172 \u49436  \u48716 \u46972 \u46020 \u50640 \u44172 \u47196  \u54840 \u49569 \u46104 \u49512 \u45796 \'94 (Bon-nechose, vol.2, p.86) \u44256  \u47568 \u54616 \u50688 \u45796 . \u44536 \u47532 \u44256  \u44536 \u51032  \u51452 \u51109 \u51012  \u52712 \u49548 \u54616 \u46972 \u45716  \u44428 \u44256 \u47484  \u45796 \u49884  \u48155 \u44172  \u46104 \u51088  \u44536 \u45716  \u44400 \u51473 \u51012  \u54693 \u54616 \u50668  \u46028 \u50500 \u49436 \u49436  \u45796 \u51020 \u44284  \u44057 \u51060  \u45824 \u45813 \u54616 \u50688 \u45796 . \'93\u44536 \u47111 \u45796 \u47732  \u45236 \u44032  \u47924 \u49832  \u47732 \u47785 \u51004 \u47196  \u54616 \u45720 \u51012  \u52432 \u45796 \u48380  \u49688  \u51080 \u44192 \u45716 \u44032 ? \u45236 \u44032  \u51648 \u44552 \u44620 \u51648  \u49692 \u44208 \u54620  \u48373 \u51020 \u51012  \u51204 \u54620  \u51200  \u49324 \u46988 \u46308 \u51012  \u47924 \u49832  \u47732 \u47785 \u51004 \u47196  \u52432 \u45796 \u48380  \u49688  \u51080 \u44192 \u45716 \u44032 ? \u45208 \u45716  \u44536 \u46308 \u51032  \u44396 \u50896 \u51012  \u51060 \u51228  \u51453 \u44592 \u47196  \u51089 \u51221 \u46108  \u48520 \u49933 \u54620  \u45208 \u51032  \u47800  \u51060 \u49345 \u51004 \u47196  \u44480 \u51473 \u54616 \u44172  \u50668 \u44596 \u45796 .\'94 \u44536 \u51032  \u51228 \u48373  (\u31085 \u26381 ) \u51008  \u54616 \u45208 \u50473  \u52264 \u47168 \u47196  \u48279 \u44200 \u51276 \u45716 \u45936 , \u44536 \u47092  \u46412 \u47560 \u45796  \u51032 \u49885 \u51012  \u54665 \u54616 \u44256 , \u50676 \u49437 \u54620  \u44048 \u46021 \u46308 \u51008  \u52264 \u47168 \u45824 \u47196  \u51200 \u51452 \u47484  \u49440 \u50616 \u54616 \u50688 \u45796 . \u46300 \u46356 \u50612  \u44536 \u51032  \u47672 \u47532  \u50948 \u50640 \u45716  \u47784 \u51088  \u44263  \u54588 \u46972 \u48120 \u46300  \u47784 \u50577 \u51004 \u47196  \u47564 \u46304  \u51333 \u51060  \u44256 \u44628 \u51060  \u50444 \u50892 \u51276 \u45716 \u45936 , \u44144 \u44592 \u50640 \u45716  \u50501 \u47560 \u51032  \u47924 \u49436 \u50868  \u54805 \u49345 \u51060  \u44536 \u47140 \u51256  \u51080 \u44256  \u45824 \u51060 \u45800 \u51088 \u46972 \u45716  \u44544 \u51088 \u44032  \u44536  \u50526 \u47732 \u50640  \u46748 \u47159 \u54616 \u44172  \u50416 \u50668  \u51080 \u50632 \u45796 . \u54980 \u49828 \u45716  \'91\u51452  \u50696 \u49688 \u50668  \u51060  \u51333 \u51008  \u45908 \u54624  \u49688  \u50630 \u45716  \u44592 \u49256 \u51004 \u47196  \u45817 \u49888 \u51012  \u50948 \u54616 \u50668  \u52824 \u50837 \u51032  \u44288 \u51012  \u50416 \u45208 \u51060 \u45796 . \u45208 \u47484  \u50948 \u54616 \u50668  \u44032 \u49884 \u44288 \u51012  \u50416 \u49888  \u51452  \u50696 \u49688 \u50668 !\'92 \u54616 \u44256  \u48512 \u47476 \u51670 \u50632 \u45796 .\
\uc0\u51060 \u47088  \u51032 \u49885 \u51012  \u54665 \u54620  \u54980 \u50640  \'93\u51452 \u44368 \u45716  \'91\u45348  \u50689 \u54844 \u51012  \u47560 \u44480 \u50640 \u44172  \u51452 \u45432 \u46972 \'92\u44256  \u47568 \u54616 \u50688 \u45796 . \u44536  \u46412 \u50640  \u50560  \u54980 \u49828 \u45716  \u54616 \u45720 \u51012  \u50864 \u47084 \u47084 , \'91\u50724 , \u51452  \u50696 \u49688 \u50668 ! \u45817 \u49888 \u51060  \u45208 \u47484  \u44396 \u50896 \u54616 \u49512 \u51004 \u45768 , \u45208 \u45716  \u45236  \u50689 \u54844 \u51012  \u45817 \u49888 \u51032  \u49552 \u50640  \u47585 \u44592 \u45208 \u51060 \u45796 \'92\u44256  \u47568 \u54616 \u50688 \u45796 \'94 (Wylie, b.3, ch.7).\
\uc0\u44536  \u54980 \u50640  \u44536 \u45716  \u49464 \u49549 \u51201  \u44428 \u49464 \u50640  \u47585 \u44200 \u51256  \u52376 \u54805 \u51109 \u51004 \u47196  \u45132 \u47140 \u45208 \u44052 \u45796 . \u44536 \u51032  \u46244 \u50640 \u45716  \u47566 \u51008  \u44400 \u51473 , \u47751 \u48177  \u47749 \u51032  \u47924 \u51109 \u54620  \u49324 \u46988 \u46308 , \u50500 \u47492 \u45796 \u50868  \u51032 \u48373 \u51012  \u51077 \u51008  \u49888 \u48512 \u50752  \u51452 \u44368 \u46308 , \u53080 \u49828 \u53444 \u49828  \u49457 \u51032  \u51452 \u48124 \u46308 \u51060  \u46384 \u46992 \u45796 . \u44536 \u44032  \u54868 \u54805 \u51452 \u50640  \u44208 \u48149 \u46104 \u44256  \u48520 \u51012  \u48537 \u51068  \u49688  \u51080 \u45716  \u51456 \u48708 \u44032  \u45796  \u44054 \u52628 \u50612 \u51276 \u51012  \u46412 \u50640  \u44536  \u49692 \u44368 \u51088 \u45716  \u51088 \u44592 \u51032  \u49373 \u47749 \u51012  \u48372 \u51316 \u54616 \u44592  \u50948 \u54616 \u50668  \u45796 \u49884  \u54620  \u48264  \u44536 \u51032  \u50724 \u47448 \u47484  \u52712 \u49548 \u54616 \u46972 \u45716  \u44428 \u44256 \u47484  \u48155 \u50520 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u45824 \u45813 \u54664 \u45796 . \'93\u47924 \u49832  \u50724 \u47448 \u47484  \u52712 \u49548 \u54616 \u46972 \u44256  \u54616 \u45716 \u44032 ? \u45208 \u45716  \u50500 \u47924 \u47088  \u51396 \u47484  \u51667 \u51648  \u50506 \u50520 \u45796 \u44256  \u49373 \u44033 \u54620 \u45796 . \u45236 \u44032  \u51200 \u49696 \u54620  \u44163 \u44284  \u51204 \u54028 \u54620  \u44163 \u51008  \u47784 \u46160  \u49324 \u46988 \u51012  \u51396 \u50752  \u47736 \u47581 \u50640 \u49436  \u44396 \u50896 \u54616 \u44592  \u50948 \u54620  \u44163 \u51060 \u50632 \u51020 \u51012  \u54616 \u45208 \u45784 \u51032  \u51060 \u47492 \u51004 \u47196  \u51613 \u44144 \u54620 \u45796 . \u44536 \u47084 \u48064 \u47196  \u45208 \u45716  \u45236 \u44032  \u51200 \u49696 \u54616 \u44256  \u51204 \u54028 \u54620  \u51652 \u47532 \u47484  \u45208 \u51032  \u54588 \u47196 \u50024  \u54869 \u51064 \u54616 \u44592 \u47484  \u47588 \u50864  \u44592 \u48848 \u54620 \u45796 \'94 (Wylie, b.3, ch.7). \u51060 \u51005 \u44256  \u48520 \u51012  \u48537 \u51060 \u47588  \u44536 \u45716  \'93\u45796 \u50967 \u51032  \u50500 \u46308  \u50696 \u49688 \u50668 , \u45208 \u47484  \u48520 \u49933 \u55176  \u50668 \u44592 \u49548 \u49436 \'94\u46972 \u45716  \u52268 \u48120 \u47484  \u44536 \u51032  \u47785 \u49548 \u47532 \u44032  \u50689 \u50689 \u55176  \u44536 \u52432 \u51656  \u46412 \u44620 \u51648  \u48520 \u47104 \u45796 .\
\uc0\u49900 \u51648 \u50612  \u44536 \u51032  \u50896 \u49688 \u46308 \u44620 \u51648 \u46020  \u44536 \u51032  \u50689 \u50885 \u51201 \u51064  \u53468 \u46020 \u50640  \u44048 \u46041 \u51012  \u48155 \u50520 \u45796 . \u50676 \u44305 \u51201 \u51064  \u48277 \u50773 \u45817 \u51032  \u54620  \u49324 \u46988 \u51008  \u54980 \u49828 \u50752  \u44536  \u54980 \u50640  \u51080 \u51008  \u51228 \u47212 \u51032  \u49692 \u44368 \u50640  \u45824 \u54616 \u50668  \u45796 \u51020 \u44284  \u44057 \u51060  \u47896 \u49324 \u54616 \u50688 \u45796 . \'93\u46160  \u49324 \u46988 \u51008  \u45796 \u44057 \u51060  \u52572 \u54980 \u51032  \u49692 \u44036 \u44620 \u51648  \u48320 \u54632 \u50630 \u51060  \u54869 \u44256 \u54620  \u47560 \u51020 \u51012  \u44032 \u51648 \u44256  \u51080 \u50632 \u45796 . \u44536 \u46308 \u51008  \u54868 \u54805 \u51012  \u48155 \u44592  \u50948 \u54616 \u50668  \u45208 \u50500 \u44032 \u44592 \u47484  \u47560 \u52824  \u54844 \u51064  \u51092 \u52824 \u50640  \u45208 \u50500 \u44032 \u45716  \u44163 \u44284  \u44057 \u51060  \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u50500 \u47924 \u47088  \u44256 \u53685 \u51032  \u48512 \u47476 \u51670 \u51020 \u46020  \u48156 \u54616 \u51648  \u50506 \u50520 \u45796 . \u48520 \u44600 \u51060  \u51068 \u50612 \u45216  \u46412 \u50640  \u44536 \u46308 \u51008  \u52268 \u48120 \u47484  \u48512 \u47476 \u44592  \u49884 \u51089 \u54616 \u50688 \u45716 \u45936 , \u44536  \u48520 \u44600 \u51032  \u44592 \u49464 \u46020  \u44536 \u46308 \u51060  \u48512 \u47476 \u45716  \u45432 \u47000 \u47484  \u44536 \u52824 \u44172  \u54624  \u49688  \u50630 \u45716  \u46319 \u54616 \u50688 \u45796 \'94 (Wylie, b.3, ch.7).\
\uc0\u54980 \u49828 \u51032  \u47800 \u51060  \u45796  \u53440 \u48260 \u47536  \u45796 \u51020 \u50640  \u44536 \u46308 \u51008  \u44536  \u51116 \u50752  \u55129 \u51012  \u47784 \u50500 \u49436  \u46972 \u51064  \u44053 \u50640  \u45912 \u51256  \u45824 \u54644 \u47196  \u55128 \u47084 \u44032 \u44172  \u54616 \u50688 \u45796 . \u44536 \u51032  \u54605 \u48149 \u51088 \u46308 \u51008  \u44536 \u44032  \u51204 \u54620  \u51652 \u47532 \u47484  \u44540 \u51208 \u54620  \u44163 \u52376 \u47100  \u49373 \u44033 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45216 \u50640  \u45912 \u51256 \u51652  \u51116 \u44032  \u45824 \u54644 \u47196  \u55128 \u47084 \u44032 \u49436  \u44033  \u45208 \u46972 \u50640  \u50472 \u47484  \u49100 \u47532 \u44256 , \u50500 \u51649 \u44620 \u51648  \u50508 \u47140 \u51648 \u51648  \u50506 \u51008  \u45208 \u46972 \u50640 \u49436 \u44620 \u51648  \u51652 \u47532 \u47484  \u51613 \u44144 \u54616 \u45716  \u50676 \u47588 \u44032  \u54413 \u49457 \u54616 \u44172  \u47610 \u54784 \u51656  \u44163 \u51012  \u44536 \u46308 \u51008  \u44144 \u51032  \u49373 \u44033 \u51648  \u47803 \u54616 \u50688 \u45796 . \u53080 \u49828 \u53444 \u49828 \u51032  \u54924 \u51032 \u51109 \u50640 \u49436  \u48512 \u47476 \u51670 \u51008  \u44536 \u51032  \u49548 \u47532 \u45716  \u47700 \u50500 \u47532 \u44032  \u46104 \u50612  \u44536  \u54980  \u44033  \u49884 \u45824 \u47484  \u53685 \u54616 \u50668  \u49788 \u50630 \u51060  \u50872 \u47140  \u54140 \u51656  \u44163 \u51060 \u50632 \u45796 . \u54980 \u49828 \u45716  \u51060 \u48120  \u44032 \u44256  \u50630 \u51004 \u45208  \u44536 \u44032  \u49373 \u47749 \u51012  \u48148 \u52432 \u49436 \u44620 \u51648  \u50745 \u54840 \u54620  \u44536  \u51652 \u47532 \u45716  \u44208 \u53076  \u47736 \u51208 \u46112  \u49688  \u50630 \u50632 \u45796 . \u44536 \u51032  \u49888 \u50521 \u44284  \u52649 \u49457 \u51032  \u47784 \u48376 \u51008  \u47566 \u51008  \u49324 \u46988 \u46308 \u47196  \u54616 \u50668 \u44552  \u44256 \u47928 \u44284  \u49324 \u47581 \u51012  \u45817 \u54616 \u47732 \u49436 \u46020  \u51652 \u47532 \u47484  \u50948 \u54616 \u50668  \u44403 \u44172  \u49444  \u49688  \u51080 \u45716  \u50857 \u44592 \u47484  \u51452 \u50632 \u45796 . \u44536 \u47532 \u44256  \u44536 \u51032  \u52376 \u54805  (\u34389 \u21009 ) \u51008  \u54945 \u54252 \u54620  \u47196 \u47560 \u51032  \u51092 \u51064 \u49457 \u51012  \u51204  \u49464 \u44228 \u50640  \u46300 \u47084 \u45236  \u48372 \u51060 \u45716  \u51068 \u51060  \u46104 \u50632 \u45796 . \u51652 \u47532 \u51032  \u50896 \u49688 \u46308 \u51008  \u51088 \u44592 \u46308 \u51060  \u50630 \u50528  \u48260 \u47532 \u47140 \u44256  \u54620  \u44536  \u49324 \u50629 \u51012  \u50508 \u51648  \u47803 \u54616 \u45716  \u49324 \u51060 \u50640  \u50724 \u55176 \u47140  \u48156 \u51204 \u49884 \u53412 \u45716  \u44208 \u44284 \u47484  \u48730 \u50612 \u45236 \u44172  \u46104 \u50632 \u45796 .\
\pard\pardeftab720\sa319\partightenfactor0

\f0\b \cf0 \uc0\u51228 \u47212 \u51032  \u50725 \u51473  \u49373 \u54876 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u51060 \u51228  \u46608  \u54616 \u45208 \u51032  \u54868 \u54805 \u51452 \u44032  \u53080 \u49828 \u53444 \u49828  \u49457 \u50640  \u49464 \u50892 \u51656  \u44163 \u51060 \u50632 \u45796 . \u46608  \u54620  \u49324 \u46988 \u51032  \u51613 \u51064 \u51032  \u54588 \u44032  \u51652 \u47532 \u47484  \u50948 \u54616 \u50668  \u51613 \u44144 \u54616 \u50668 \u50556  \u54624  \u44163 \u51060 \u50632 \u45796 . \u51228 \u47212 \u51008  \u54980 \u49828 \u44032  \u45824 \u54924 \u51032 \u50640  \u45208 \u50500 \u44040  \u46412 \u50640  \u44536 \u50752  \u51089 \u48324 \u54616 \u47732 \u49436  \u44536 \u50640 \u44172  \u50857 \u44592 \u50752  \u54869 \u44256 \u54620  \u53468 \u46020 \u47484  \u44032 \u51648 \u46972 \u44256  \u44428 \u47732 \u54616 \u44256  \u47564 \u51068  \u44536 \u50640 \u44172  \u50948 \u54744 \u51060  \u51080 \u51012  \u46412 \u50640 \u45716  \u51593 \u49884  \u46020 \u50752 \u51452 \u44192 \u45432 \u46972 \u44256  \u54616 \u50688 \u45796 . \u44060 \u54785 \u51088 \u51032  \u53804 \u50725  (\u25237 \u29508 ) \u49548 \u49885 \u51012  \u46307 \u51088  \u52649 \u49892 \u54620  \u44536  \u51228 \u51088 \u45716  \u44263  \u50557 \u49549 \u51012  \u51060 \u54665 \u54616 \u47140  \u54616 \u50688 \u45796 . \u44536 \u45716  \u53685 \u54665 \u44428 \u46020  \u44032 \u51648 \u51648  \u50506 \u44256  \u54620  \u46041 \u47308 \u47484  \u45936 \u47532 \u44256 , \u53080 \u49828 \u53444 \u49828  \u49457 \u51012  \u54693 \u54616 \u50668  \u46496 \u45228 \u45796 . \u44536 \u45716  \u44536  \u44275 \u50640  \u46020 \u52265 \u54616 \u51088 , \u54980 \u49828 \u47484  \u44396 \u52636 \u54616 \u44592 \u45716 \u52964 \u45397  \u50724 \u55176 \u47140  \u44536  \u51088 \u49888 \u51012  \u50948 \u54744 \u50640  \u45432 \u52636 \u49884 \u53040 \u45796 \u45716  \u44163 \u51012  \u44648 \u45804 \u50520 \u45796 . \u44536 \u45716  \u44536  \u49457 \u50640 \u49436  \u54588 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u46028 \u50500 \u44032 \u45716  \u44600 \u50640  \u44536 \u45716  \u48537 \u51105 \u55176 \u50612  \u49632 \u49324 \u49836 \u50640  \u47588 \u50668  \u51068 \u45800 \u51032  \u44400 \u51064 \u46308 \u50640  \u51032 \u54616 \u50668  \u54840 \u49569 \u46104 \u50632 \u45796 . \u44536 \u44032  \u52376 \u51020 \u51004 \u47196  \u45824 \u54924 \u51032 \u50640  \u45132 \u47140 \u45208 \u50752  \u44536 \u50640  \u45824 \u54620  \u49548 \u49569 \u50640  \u45813 \u48320 \u51012  \u54616 \u44256 \u51088  \u54664 \u51012  \u46412  \u44536 \u45716  \'93\u54868 \u54805 \u50640  \u52376 \u54616 \u46972 , \u54868 \u54805 \u50640  \u52376 \u54616 \u46972 \'94\u45716  \u48512 \u47476 \u51670 \u51020 \u51012  \u46307 \u44172  \u46104 \u50632 \u45796  (Bonnechose, vol.1, p.234). \u44536 \u45716  \u53360  \u44256 \u53685 \u51012  \u45712 \u45180 \u46020 \u47197  \u49632 \u49324 \u49836 \u50640  \u44208 \u48149 \u46108  \u52292 \u47196  \u53804 \u50725 \u46104 \u50612  \u51080 \u50632 \u45716 \u45936 , \u47673 \u51012  \u44163 \u51060 \u46972 \u44256 \u45716  \u47932 \u44284  \u48757 \u49104 \u51060 \u50632 \u45796 . \u50725 \u51473 \u50640 \u49436  \u45320 \u47924 \u45208  \u44032 \u54841 \u54620  \u45824 \u50864 \u47484  \u48155 \u50520 \u51004 \u48064 \u47196  \u51228 \u47212 \u51008  \u48337 \u50640  \u44152 \u47140  \u49373 \u47749 \u51032  \u50948 \u54801 \u51012  \u48155 \u44172  \u46104 \u50632 \u45796 . \u44536 \u47084 \u48064 \u47196  \u44536 \u51032  \u50896 \u49688 \u46308 \u51008  \u44536 \u44032  \u44536 \u45824 \u47196  \u51453 \u51012  \u44163 \u51012  \u50684 \u47140 \u54616 \u50668  \u50557 \u44036  \u44288 \u45824 \u54616 \u44172  \u45824 \u50864 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u50557  1\u45380 \u44036  \u50725 \u51473 \u50640  \u44536 \u45824 \u47196  \u44039 \u55176 \u50612  \u51080 \u50632 \u45796 .\
\uc0\u54980 \u49828 \u51032  \u51453 \u51020 \u51008  \u48277 \u50773 \u45817 \u50640 \u44172  \u51080 \u50612 \u49436  \u44592 \u45824 \u54620  \u44163 \u47564 \u53372 \u51032  \u54952 \u44284 \u44032  \u50630 \u50632 \u45796 . \u54980 \u49828 \u51032  \u53685 \u54665 \u44428 \u50640  \u45824 \u54620  \u52840 \u54644 \u44032  \u49900 \u54620  \u48516 \u45432 \u50752  \u47932 \u51032 \u47484  \u51068 \u51004 \u53040 \u51004 \u48064 \u47196 , \u45908  \u50504 \u51204 \u54620  \u48169 \u48277 \u51004 \u47196 , \u45824 \u54924 \u51032 \u45716  \u51228 \u47212 \u51012  \u54868 \u54805 \u50640  \u52376 \u54616 \u45716  \u45824 \u49888 \u50640  \u54624  \u49688  \u51080 \u45716  \u45824 \u47196  \u44536 \u47484  \u44053 \u50836 \u54616 \u50668  \u44536 \u51032  \u51452 \u51109 \u51012  \u52712 \u49548 \u54616 \u44172  \u54616 \u44256 \u51088  \u44208 \u51221 \u54616 \u50688 \u45796 . \u44536 \u45716  \u54924 \u51032 \u51109 \u50640  \u45132 \u47140 \u45208 \u50752  \u50724 \u47448 \u47484  \u52712 \u49548 \u54616 \u46304 \u44032 , \u54868 \u54805 \u51004 \u47196  \u51453 \u46304 \u44032  \u46168  \u51473 \u51032  \u54616 \u45208 \u47484  \u53469 \u54616 \u46972 \u45716  \u44428 \u44256 \u47484  \u48155 \u50520 \u45796 . \u44536 \u44032  \u45817 \u54620  \u47924 \u49436 \u50868  \u44256 \u45212 \u51012  \u49373 \u44033 \u54644  \u48372 \u47732  \u49688 \u44048  \u52488 \u44592 \u50640  \u51453 \u45716  \u44163 \u51060  \u46020 \u47532 \u50612  \u44536 \u50640 \u44172 \u45716  \u46041 \u51221  \u44618 \u51008  \u52376 \u49324 \u46972 \u44256  \u54624  \u49688  \u51080 \u50632 \u51012  \u44163 \u51060 \u50632 \u45796 . \u51060 \u51228  \u50725 \u51473 \u50640 \u49436  \u45817 \u54620  \u44256 \u53685 \u51004 \u47196  \u50619 \u51008  \u51656 \u48337  \u46412 \u47928 \u50640  \u44592 \u47141 \u51060  \u49632 \u54616 \u50668 \u51276 \u44256 , \u44540 \u49900 \u44284  \u48520 \u50504 \u50640 \u49436  \u50724 \u45716  \u44340 \u47196 \u50880 , \u52828 \u44396 \u46308 \u44284 \u51032  \u51060 \u48324 , \u54980 \u49828 \u51032  \u51453 \u51020 \u51004 \u47196  \u51064 \u54620  \u45209 \u49900  \u46321 \u44284  \u44057 \u51008  \u51068 \u46308 \u47196  \u47568 \u48120 \u50516 \u50500  \u51228 \u47212 \u51032  \u50857 \u44592 \u45716  \u44734 \u51060 \u50612  \u47560 \u52840 \u45236  \u44536 \u45716  \u54924 \u51032 \u50640  \u44404 \u48373 \u54616 \u50688 \u45796 . \u44536 \u45716  \u44032 \u53672 \u47533 \u51032  \u49888 \u50521 \u51012  \u44403 \u44172  \u51648 \u53420  \u44163 \u51012  \u49436 \u50557 \u54616 \u44256 , \u50948 \u53364 \u47532 \u54532 \u50752  \u54980 \u49828 \u44032  \u44032 \u47476 \u52828  \u44368 \u47532  \u51473  \u49548 \u50948  \'93\u49888 \u49457 \u54620  \u51652 \u47532 \'94 (Bonnechose, vol.2, p.141) \u51060 \u50808 \u51032  \u44163 \u51012  \u51221 \u51396 \u54620  \u54924 \u51032 \u51032  \u44208 \u51032 \u47484  \u49688 \u46973 \u54616 \u50688 \u45796 .\
\uc0\u51060 \u50752  \u44057 \u51008  \u51076 \u44592 \u51025 \u48320 \u51032  \u49688 \u45800 \u51004 \u47196  \u51228 \u47212 \u51008  \u50577 \u49900 \u51032  \u49548 \u47532 \u47484  \u52840 \u47925 \u49884 \u53412 \u44256  \u51208 \u48149 \u54644  \u50724 \u45716  \u51453 \u51020 \u51012  \u47732 \u54644  \u48372 \u47140 \u44256  \u45432 \u47141 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44048 \u48169 \u51032  \u51201 \u47561  \u49549 \u50640 \u49436  \u44536 \u45716  \u51088 \u44592 \u44032  \u54620  \u51068 \u51060  \u47924 \u50631 \u51076 \u51012  \u48516 \u47749 \u55176  \u50508 \u44172  \u46104 \u50632 \u45796 . \u44536 \u45716  \u54980 \u49828 \u51032  \u52649 \u49457 \u44284  \u50857 \u44592 \u50640  \u45824 \u54616 \u50668  \u49373 \u44033 \u54616 \u50688 \u45796 . \u44536 \u44163 \u44284  \u48708 \u44368 \u54644 \u49436  \u51652 \u47532 \u47484  \u44144 \u48512 \u54620  \u51088 \u44592 \u51032  \u47924 \u44032 \u52824 \u54620  \u54665 \u46041 \u51012  \u49689 \u44256 \u54616 \u50688 \u45796 . \u44536 \u45716  \u51088 \u44592 \u44032  \u49452 \u44592 \u44592 \u47196  \u49436 \u50557 \u54620  \u44144 \u47337 \u54616 \u49888  \u51452 \u45784 , \u51088 \u44592 \u47484  \u50948 \u54616 \u50668  \u49901 \u51088 \u44032 \u51032  \u51453 \u51020 \u44620 \u51648  \u52280 \u51004 \u49888  \u51452 \u45784 \u51012  \u49373 \u44033 \u54616 \u50688 \u45796 . \u49888 \u50521 \u51012  \u52712 \u49548 \u54616 \u44592  \u51204 \u50640 \u45716  \u50728 \u44054  \u44256 \u45212  \u51473 \u50640 \u46020  \u54616 \u45208 \u45784 \u51032  \u51008 \u54812 \u51032  \u54869 \u51613 \u51004 \u47196  \u47568 \u48120 \u50516 \u45716  \u50948 \u47196 \u44032  \u51080 \u50632 \u51648 \u47564  \u51060 \u51228 \u45716  \u44536 \u51032  \u47560 \u51020 \u49549 \u50640  \u50724 \u51649  \u54980 \u54924 \u50752  \u51032 \u54841 \u44284  \u44256 \u48124 \u47564 \u51060  \u45224 \u50500 \u51080 \u51020 \u51012  \u44648 \u45803 \u44172  \u46104 \u50632 \u45796 . \u44536 \u47532 \u44256  \u44536 \u44032  \u47196 \u47560 \u44368 \u50752  \u54868 \u54644 \u54616 \u47140 \u47732  \u50500 \u51649 \u46020  \u50668 \u47084  \u48264  \u49888 \u50521 \u51032  \u52712 \u49548 \u47484  \u54616 \u51648  \u50506 \u51004 \u47732  \u50504  \u46108 \u45796 \u45716  \u44163 \u51012  \u50508 \u50520 \u45796 . \u44536 \u44032  \u45208 \u50500 \u44032 \u45716  \u44600 \u51008  \u50756 \u51204 \u54620  \u48176 \u46020 \u47196  \u45149 \u45216  \u44163 \u51060 \u50632 \u45796 . \u44536 \u45716  \u51104 \u44624  \u46041 \u50504 \u51032  \u44256 \u45212 \u51012  \u47732 \u54616 \u44592  \u50948 \u54616 \u50668  \u51088 \u44592 \u51032  \u51452 \u45784 \u51012  \u48512 \u51064 \u54616 \u51648  \u50506 \u44592 \u47196  \u44208 \u49900 \u54616 \u50688 \u45796 .\
