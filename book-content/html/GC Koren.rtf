\uc0\u44536 \u45716  \u46041 \u47308 \u46308 \u47196 \u48512 \u53552  \u48373 \u51020 \u51032  \u49324 \u51088 \u44032  \u46104 \u46972 \u45716  \u44428 \u44256 \u47484  \u48155 \u50520 \u51012  \u46412 \u50640  \u44536  \u52293 \u51076 \u51032  \u51473 \u50836 \u49457 \u51012  \u46160 \u47140 \u50892 \u54616 \u50668  \u50724 \u47019 \u46041 \u50504  \u51452 \u51200 \u54616 \u50688 \u45796 . \u44536 \u45716  \u50668 \u47084  \u45216 \u51012  \u51665 \u50504 \u50640  \u53952 \u50612 \u48149 \u54784  \u49373 \u44033 \u54616 \u44256  \u48264 \u48124 \u54616 \u44172  \u46104 \u50632 \u45796 . \u44536 \u47084 \u45208  \u51068 \u45800  \u44536  \u51068 \u51012  \u47585 \u44172  \u46104 \u51088  \u44536 \u45716  \u54869 \u44256 \u54620  \u44208 \u49900 \u44284  \u48520 \u44404 \u51032  \u50857 \u44592 \u47196 \u50024  \u49373 \u47749 \u51060  \u45796 \u54624  \u46412 \u44620 \u51648  \u51204 \u51652 \u54616 \u50688 \u45796 . \u51060  \u52649 \u49457 \u46104 \u44256  \u50676 \u47148 \u54620  \u44060 \u54785 \u51088 \u45716  \u49324 \u46988 \u51032  \u45231 \u51012  \u51204 \u50672  \u46160 \u47140 \u50892 \u54616 \u51648  \u50500 \u45768 \u54616 \u50688 \u45796 . \u44536 \u51032  \u51452 \u50948 \u50640 \u49436  \u51068 \u50612 \u45208 \u44256  \u51080 \u45716  \u48149 \u54644 \u51032  \u48520 \u44867 \u51008  \u44536 \u51032  \u50676 \u49457 \u51012  \u45908 \u50865  \u44032 \u51473 \u49884 \u53412 \u45716  \u52489 \u51652 \u51228 \u44032  \u46112  \u49104 \u51060 \u50632 \u45796 . \u50517 \u51228 \u51088 \u51032  \u46020 \u45180 \u44032  \u44536 \u51032  \u47672 \u47532 \u47484  \u50948 \u54801 \u54616 \u47732 \u49436  \u46308 \u47140  \u51080 \u51012 \u51648 \u46972 \u46020  \u44536 \u45716  \u51088 \u44592 \u51032  \u51088 \u47532 \u50640  \u44403 \u44172  \u49436 \u49436 , \u48148 \u47480 \u49552 \u51004 \u47196 \u45716  \u44053 \u54620  \u53440 \u44201 \u51012  \u51452 \u44256 , \u50812 \u49552 \u51004 \u47196 \u45716  \u50864 \u49345  \u49709 \u48176 \u47484  \u48516