\f1\b0 \cf0 \
\uc0\u50696 \u49688 \u44760 \u49436  \u48512 \u54876 \u54616 \u49888  \u54980 , \u50656 \u47560 \u50724 \u47196  \u44032 \u44256  \u51080 \u45716  \u45817 \u49888 \u51032  \u51228 \u51088 \u46308 \u50640 \u44172  \u45208 \u53440 \u45208 \u49492 \u49436  \'93\u47784 \u49464 \u50752  \u48143  \u47784 \u46304  \u49440 \u51648 \u51088 \u51032  \u44544 \u47196  \u49884 \u51089 \u54616 \u50668  \u47784 \u46304  \u49457 \u44221 \u50640  \u50420 \u48148  \u51088 \u44592 \u50640  \u44288 \u54620  \u44163 \u51012  \u51088 \u49464 \u55176  \u49444 \u47749 \u54616 \u49884 \'94 (\u45573  24:27) \u50632 \u45796 . \u51228 \u51088 \u46308 \u51032  \u47560 \u51020 \u51008  \u55141 \u48516 \u46104 \u50632 \u45796 . \u44536 \u46308 \u50640 \u44172 \u45716  \u48127 \u51020 \u51060  \u48520 \u53440 \u50732 \u46992 \u45796 . \u44536 \u46308 \u51008  \u50696 \u49688 \u45784 \u44760 \u49436  \u44536 \u46308 \u50640 \u44172  \u52828 \u55176  \u45208 \u53440 \u45208 \u49884 \u44592  \u51204 \u48512 \u53552  \u51060 \u48120  \'93\u44144 \u46317 \u45208 \'94\u49436  \'93\u49328  \u49548 \u47581 \u51060  \u51080 \'94\u50632 \u45796 . \u44536 \u46308 \u51032  \u51060 \u54644 \u47141 \u51012  \u48157 \u54784  \u51452 \u49884 \u44256 , \u44536 \u46308 \u51032  \u48127 \u51020 \u51012  \'93\u54869 \u49892 \u54620  \u50696 \u50616 \'94 \u50948 \u50640  \u49464 \u50864 \u45716  \u44163 \u51060  \u50696 \u49688 \u45784 \u51032  \u47785 \u51201 \u51060 \u50632 \u45796 . \u44536 \u48516 \u44760 \u49436 \u45716  \u45817 \u49888 \u44760 \u49436  \u52828 \u55176  \u47568 \u50432 \u54616 \u49888  \u51613 \u44144 \u50640 \u49436 \u49104 \u47564  \u50500 \u45768 \u46972 , \u54364 \u49345 \u51201 \u51064  \u50984 \u48277 \u51060  \u44032 \u47532 \u53412 \u45716  \u49345 \u51669 \u46308 \u44284  \u44536 \u47548 \u51088 \u46308 \u51012  \u53685 \u54616 \u50668 , \u44536 \u47532 \u44256  \u44396 \u50557 \u51032  \u50696 \u50616 \u46308 \u51012  \u53685 \u54616 \u50668  \u44536 \u46308 \u51032  \u47560 \u51020 \u49549 \u50640  \u51652 \u47532 \u44032  \u44403 \u44172  \u54869 \u47549 \u46104 \u44592 \u47484  \u50896 \u54616 \u49512 \u45796 . \u44536 \u47532 \u49828 \u46020 \u51032  \u51228 \u51088 \u46308 \u50640 \u44172 \u45716  \u51088 \u49888 \u46308 \u51012  \u50948 \u54644 \u49436  \u49104 \u47564  \u50500 \u45768 \u46972  \u44536 \u47532 \u49828 \u46020 \u50640  \u44288 \u54620  \u51648 \u49885 \u51012  \u49464 \u49345 \u50640  \u51204 \u54616 \u44592  \u50948 \u54616 \u50668 \u49436 \u46020  \u47749 \u52384 \u54620  \u49888 \u50521 \u51060  \u54596 \u50836 \u54616 \u50688 \u45796 . \u44536 \u47084 \u48064 \u47196  \u50696 \u49688 \u44760 \u49436 \u45716  \u51060 \u47088  \u51648 \u49885 \u51012  \u51452 \u49884 \u45716  \u52395 \u51704  \u45800 \u44228 \u47196 \u49436  \u51228 \u51088 \u46308 \u51032  \u49373 \u44033 \u51012  \'93\u47784 \u49464 \u50752 \'85\u49440 \u51648 \u51088 \'94\u46308 \u50640 \u44172 \u47196  \u54693 \u54616 \u44172  \u54616 \u49512 \u45796 . \u48512 \u54876 \u54616 \u49888  \u44396 \u51452 \u44760 \u49436  \u44396 \u50557  \u49457 \u44221 \u51032  \u44032 \u52824 \u50752  \u51473 \u50836 \u49457 \u50640  \u44288 \u54616 \u50668  \u51613 \u44144 \u54616 \u49888  \u44163 \u51008  \u48148 \u47196  \u51060 \u47088  \u51032 \u48120 \u50640 \u49436 \u50688 \u45796 .\
\uc0\u45796 \u49884  \u54620  \u48264  \u44396 \u51452 \u51032  \u50728 \u50976 \u54616 \u49888  \u50620 \u44404 \u51012  \u45824 \u54624  \u46412 \u50640  \u44536  \u51228 \u51088 \u46308 \u51032  \u47560 \u51020 \u50640 \u45716  \u44284 \u50672  \u50612 \u46496 \u54620  \u48320 \u54868 \u44032  \u51068 \u50612 \u45228 \u45912 \u44032 ! (\u45573  24:32 \u52280 \u51312 ). \u44536 \u46308 \u51008  \u51204 \u50640  \u50630 \u51060  \u45908 \u50865  \u50756 \u51204 \u54620  \u51032 \u48120 \u50640 \u49436  \'93\u47784 \u49464 \u44032  \u50984 \u48277 \u50640  \u44592 \u47197 \u54616 \u50688 \u44256  \u50668 \u47084  \u49440 \u51648 \u51088 \u44032  \u44592 \u47197 \u54620  \u44536 \u51060 \u47484 \'85\u47564 \'94\u45208 \u44172  \u46104 \u50632 \u45912  \u44163 \u51060 \u45796 . \u48520 \u50504 , \u44256 \u53685 , \u49892 \u47581 \u51008  \u50756 \u51204 \u54620  \u48372 \u51613 , \u44396 \u47492  \u54620  \u51216  \u50630 \u45716  \u48127 \u51020 \u51004 \u47196  \u48148 \u45068 \u50612 \u51276 \u45796 . \u44396 \u51452 \u44760 \u49436  \u49849 \u52380 \u54616 \u49888  \u54980 \u50640  \u44536 \u46308 \u51060  \'93\u45720  \u49457 \u51204 \u50640  \u51080 \u50612  \u54616 \u45208 \u45784 \u51012  \u52268 \u49569 \'94\u54620  \u44163 \u51008  \u50620 \u47560 \u45208  \u45440 \u46972 \u50868  \u51068 \u51064 \u44032 ! \u44396 \u51452 \u51032  \u52824 \u50837 \u51201 \u51064  \u51453 \u51020 \u51012  \u50500 \u45716  \u49324 \u46988 \u46308 \u51008  \u44536  \u51228 \u51088 \u46308 \u51032  \u50620 \u44404 \u50640 \u49436  \u49836 \u54548 \u44284  \u45229 \u54056 \u50752  \u49892 \u47581 \u51032  \u54364 \u51221 \u51060  \u45208 \u53440 \u45216  \u44163 \u51004 \u47196  \u49373 \u44033 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u46308 \u51008  \u50724 \u55176 \u47140  \u44592 \u49256 \u44284  \u49849 \u47532 \u51032  \u54364 \u51221 \u51012  \u48372 \u44172  \u46104 \u50632 \u45796 . \u44536  \u51228 \u51088 \u46308 \u51008  \u44536 \u46308 \u51032  \u50