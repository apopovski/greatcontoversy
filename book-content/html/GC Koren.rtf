\f1\b0 \cf0 \
\uc0\u47196 \u47560 \u50640 \u49436  \u44480 \u44397 \u54620  \u54980 \u50640  \u47336 \u53552 \u45716  \u48708 \u53584 \u48288 \u47476 \u53356  (Wit-tenberg) \u45824 \u54617 \u50640 \u49436  \u49888 \u54617  \u48149 \u49324  \u54617 \u50948 \u47484  \u48155 \u50520 \u45796 . \u51060 \u51228  \u44536 \u45716  \u44284 \u44144  \u50612 \u45712  \u46412 \u48372 \u45796  \u44536 \u44032  \u49324 \u46993 \u54616 \u45716  \u49457 \u44221  \u50672 \u44396 \u50640  \u45908 \u50865  \u47792 \u46160 \u54624  \u49688  \u51080 \u44172  \u46104 \u50632 \u45796 . \u44536 \u45716  \u48277 \u50773 \u51032  \u44368 \u47532 \u50752  \u44536 \u51032  \u47568 \u51060  \u50500 \u45772  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51012  \u54217 \u49373  \u46041 \u50504  \u51452 \u51032  \u44618 \u51060  \u50672 \u44396 \u54616 \u44256  \u52649 \u49457 \u49828 \u47101 \u44172  \u51204 \u54028 \u54616 \u44592 \u47196  \u50628 \u49689 \u55176  \u47609 \u49464 \u54616 \u50688 \u45796 . \u44536  \u54980 \u47196  \u44536 \u45716  \u45800 \u49692 \u54620  \u49849 \u47140 \u45208  \u44368 \u49688 \u44032  \u50500 \u45768 \u46972  \u44277 \u51064 \u46108  \u49457 \u44221 \u51032  \u51204 \u46020 \u51088 \u44032  \u46104 \u50632 \u45796 . \u44536 \u45716  \u51652 \u47532 \u47484  \u52286 \u44256 \u51088  \u51452 \u47532 \u44256  \u47785 \u47568 \u46972 \u54616 \u45716  \u54616 \u45208 \u45784 \u51032  \u50577 \u47924 \u47532 \u47484  \u52824 \u45716  \u47785 \u51088 \u47196  \u48512 \u47476 \u49900 \u51012  \u48155 \u50520 \u45796 . \u44536 \u45716  \u45800 \u50672 \u55176  \u44536 \u47532 \u49828 \u46020 \u51064 \u51008  \u49457 \u44221 \u51032  \u44428 \u50948 \u50640  \u44592 \u52488 \u46104 \u51648  \u50506 \u51008  \u50612 \u46500  \u44368 \u47532 \u46020  \u50857 \u45225 \u54644 \u49436 \u45716  \u50504  \u46108 \u45796 \u44256  \u54869 \u44256 \u54616 \u44172  \u50616 \u47749 \u54616 \u50688 \u45796 . \u51060  \u47568 \u51008  \u48148 \u47196  \u48277 \u50773 \u51032  \u52572 \u49345 \u44428 \u51032  \u44592 \u52488 \u47484  \u44277 \u44201 \u54616 \u50688 \u45796 . \u51060  \u47568  \u49549 \u50640  \u51333 \u44368 \u44060 \u54785 \u51032  \u44540 \u48376  \u50896 \u52825 \u51060  \u54252 \u54632 \u46104 \u50612  \u51080 \u50632 \u45796 .\
\uc0\u47336 \u53552 \u45716  \u49324 \u46988 \u51032  \u51060 \u47200 \u51012  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u48372 \u45796  \u45908 \u50865  \u51316 \u51473 \u54616 \u45716  \u44163 \u51060  \u50948 \u54744 \u54616 \u45796 \u45716  \u44163 \u51012  \u50508 \u50520 \u45796 . \u44536 \u45716  \u46160 \u47140 \u50880  \u50630 \u51060  \u54617 \u51088 \u46308 \u51032  \u49324 \u48320 \u51201  \u47924 \u49888 \u47200  (\u24605 \u36776 \u30340  \u28961 \u31070 \u35542 ) \u51012  \u44277 \u44201 \u54616 \u44256 , \u50724 \u47019 \u46041 \u50504  \u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u51012  \u51109 \u50501 \u54616 \u50668  \u51648 \u48176 \u54644  \u50728  \u52384 \u54617 \u44284  \u49888 \u54617 \u50640  \u48152 \u45824 \u54616 \u50688 \u45796 . \u44536 \u45716  \u51060 \u50752  \u44057 \u51008  \u50672 \u44396 \u50640  \u47792 \u46160 \u54616 \u45716  \u44163 \u51060  \u47924 \u44032 \u52824 \u54624  \u49104 \u47564  \u50500 \u45768 \u46972  \u54644 \u44032  \u46104 \u45716  \u51068 \u51060 \u46972 \u44256  \u47568 \u54616 \u44256 , \u52397 \u51473 \u46308 \u51032  \u47560 \u51020 \u51012  \u52384 \u54617 \u51088 \u45208  \u49888 \u54617 \u51088 \u51032  \u44452 \u48320 \u50640 \u49436  \u46028 \u51060 \u53020 \u49436  \u49440 \u51648 \u51088 \u46308 \u44284  \u49324 \u46020 \u46308 \u51060  \u47568 \u54620  \u50689 \u50896 \u54620  \u51652 \u47532 \u47196  \u46028 \u50500 \u50724 \u44172  \u54616 \u44256 \u51088  \u45432 \u47141 \u54616 \u50688 \u45796 .\
\uc0\u44536 \u44032  \u51613 \u44144 \u54620  \u44592 \u48324 \u51008  \u44536 \u51032  \u47568 \u51012  \u50676 \u49900 \u51004 \u47196  \u46307 \u45716  \u47924 \u47532 \u50640 \u44172  \u44480 \u51473 \u54620  \u44163 \u51060 \u50632 \u45796 . \u44536 \u46308 \u51008  \u51060 \u51204 \u50640  \u51060 \u47084 \u54620  \u44032 \u47476 \u52840 \u51012  \u48155 \u51008  \u51068 \u51060  \u44208 \u53076  \u50630 \u50632 \u45796 . \u44396 \u51452 \u51032  \u49324 \u46993 \u50640  \u44288 \u54620  \u44592 \u49244  \u49548 \u49885 , \u44536 \u48516 \u51032  \u44396 \u49549 \u51032  \u54588 \u47196  \u47568 \u48120 \u50516 \u50500  \u49324 \u50976 \u50752  \u54217 \u50504 \u51012  \u50619 \u44172  \u46108 \u45796 \u45716  \u48372 \u51613 \u51008  \u44536 \u46308 \u51032  \u47560 \u51020 \u50640  \u44592 \u49256 \u51012  \u50504 \u44200 \u51452 \u44256  \u48520 \u47736 \u51032  \u49548 \u47581 \u51012  \u44256 \u47924 \u49884 \u53020  \u51452 \u50632 \u45796 . \u50728  \u49464 \u44228 \u47484  \u46160 \u47336  \u48708 \u52628 \u50612  \u51460  \u44305 \u47749 \u54620  \u48731 \u51060  \u48708 \u53584 \u48288 \u47476 \u53356 \u50640 \u49436  \u48157 \u54784 \u51276 \u51004 \u47728  \u51060  \u48731 \u51008  \u47568 \u49464 \u44032  \u46112 \u49688 \u47197  \u45908 \u50865  \u48157 \u44172  \u48731 \u45216  \u44163 \u51060 \u50632 \u45796 .\
\uc0\u44536 \u47084 \u45208  \u50516 \u55121 \u44284  \u44305 \u47749 \u51008  \u51312 \u54868 \u46112  \u49688  \u50630 \u45796 . \u51652 \u47532 \u50752  \u50724 \u47448  \u49324 \u51060 \u50640 \u45716  \u54588 \u54624  \u49688  \u50630 \u45716  \u49912 \u50880 \u51060  \u51080 \u45796 . \u44536  \u51473 \u51032  \u54616 \u45208 \u47484  \u51648 \u51648 \u54616 \u44256  \u50745 \u54840 \u54616 \u44592  \u50948 \u54616 \u50668 \u49436 \u45716  \u45796 \u47480  \u54616 \u45208 \u47484  \u44277 \u44201 \u54616 \u44256  \u45336 \u50612 \u46888 \u47140 \u50556  \u54620 \u45796 . \u50864 \u47532  \u44396 \u51452 \u44760 \u49436 \u45716  \'93\u45236 \u44032  \u49464 \u49345 \u50640  \u54868 \u54217 \u51012  \u51452 \u47084  \u50728  \u51460 \u47196  \u49373 \u44033 \u51648  \u47568 \u46972  \u54868 \u54217 \u51060  \u50500 \u45768 \u50836  \u44160 \u51012  \u51452 \u47084  \u50772 \u45432 \u46972 \'94 (\u47560  10:34) \u44256  \u52828 \u55176  \u47568 \u50432 \u54616 \u49512 \u45796 . \u47336 \u53552 \u45716  \u51333 \u44368 \u44060 \u54785 \u51012  \u51068 \u51004 \u53416  \u51648  \u50620 \u47560  \u54980 \u50640  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u54616 \u50688 \u45796 . \'93\u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u45208 \u47484  \u51064 \u46020 \u54616 \u49884 \u51648  \u50500 \u45768 \u54616 \u49884 \u44256 , \u45208 \u47484  \u50526 \u51004 \u47196  \u45208 \u44032 \u46020 \u47197  \u46496 \u48120 \u49888 \u45796 . \u44536 \u48516 \u44760 \u49436 \u45716  \u45208 \u47196  \u54616 \u50668 \u44552  \u45323 \u51012  \u51075 \u44172  \u54616 \u49888 \u45796 . \u45208 \u45716  \u45208  \u51088 \u49888 \u51032  \u51452 \u51064 \u51060  \u50500 \u45768 \u45796 . \u45208 \u45716  \u54217 \u50504 \u55176  \u49332 \u44592 \u47484  \u44040 \u47581 \u54616 \u51648 \u47564  \u49548 \u46041 \u44284  \u44060 \u54785 \u51032  \u50752 \u51473 \u50640  \u45912 \u51256 \u51256  \u51080 \u45796 \'94 (D\'92Aubigne, b.5, ch.2). \u44536 \u45716  \u51060  \u46412  \u53804 \u51137 \u51032  \u54620 \u44032 \u50868 \u45936 \u47196  \u46308 \u50612 \u44032 \u46020 \u47197  \u44053 \u50836 \u45817 \u54616 \u44256  \u51080 \u50632 \u45796 .\
\uc0\u47196 \u47560 \u44368 \u45716  \u54616 \u45208 \u45784 \u51032  \u51008 \u54812 \u47484  \u49345 \u54408 \u51004 \u47196  \u49340 \u50520 \u45796 . \u49548 \u50948  \u54872 \u51204 \u45824  (\u25563 \u37666 \u33274 ) \u46972 \u45716  \u44163 \u51060  \u51228 \u45800  \u44225 \u50640  \u49373 \u44592 \u44256  \u44144 \u44592 \u49436  \u47588 \u47588 \u54616 \u45716  \u51088 \u46308 \u51032  \u46496 \u46300 \u45716  \u49548 \u47532 \u44032  \u50836 \u46976 \u54616 \u44172  \u50872 \u47140  \u54140 \u51276 \u45796 . \u47196 \u47560 \u50640  \u51080 \u45716  \u49457  \u48288 \u46300 \u47196  \u44368 \u54924 \u45817 \u51032  \u44148 \u52629  \u51088 \u44552 \u51012  \u47784 \u44552 \u54620 \u45796 \u45716  \u47749 \u47785  \u50500 \u47000  \u47732 \u51396 \u48512 \u44032  \u48277 \u50773 \u51032  \u44428 \u50948 \u50640  \u51032 \u54616 \u50668  \u44277 \u44277 \u50672 \u54616 \u44172  \u48156 \u47588 \u46104 \u50632 \u45796 . \u54616 \u45208 \u45784 \u51012  \u44221 \u48176 \u54616 \u45716  \u44368 \u54924 \u45817 \u51060  \u51396 \u51032  \u44050 \u51004 \u47196  \u44148 \u49444 \u46104 \u44256 , \u44536  \u47784 \u53825 \u51060 \u51032  \u51452 \u52647 \u46028 \u51060  \u48520 \u51032 \u51032  \u44050 \u51004 \u47196  \u45459 \u51060 \u44172  \u46112  \u44163 \u51060 \u50632 \u45796 . \u44536 \u47084 \u45208  \u47196 \u47560 \u51032  \u49464 \u47141  \u54869 \u51109 \u51012  \u50948 \u54616 \u50668  \u52712 \u54616 \u50668 \u51652  \u51060 \u50752  \u44057 \u51008  \u49688 \u45800 \u46308 \u51060  \u50724 \u55176 \u47140  \u44536  \u49464 \u47141 \u44284  \u50689 \u44305 \u50640  \u52824 \u47749 \u51201 \u51064  \u53440 \u44201 \u51012  \u44032 \u51256 \u45796 \u51452 \u45716  \u53360  \u50896 \u51064 \u51060  \u46104 \u50632 \u45796 . \u51060 \u44163 \u51004 \u47196  \u47568 \u48120 \u50516 \u50500  \u44032 \u51109  \u44208 \u51221 \u51201 \u51060 \u44256  \u49457 \u44277 \u51201 \u51064  \u48277 \u50773 \u44368 \u51032  \u50896 \u49688 \u46308 \u51060  \u51068 \u50612 \u45208 \u49436  \u48277 \u50773 \u51032  \u48372 \u51340 \u47484  \u55124 \u46308 \u44256 , \u44536  \u47672 \u47532  \u50948 \u50640  \u51080 \u45716  \u49340 \u52789  \u47732 \u47448 \u44288 \u51012  \u50836 \u46041 \u54616 \u44172  \u54616 \u45716  \u53804 \u51137 \u51012  \u51068 \u51004 \u53040 \u45796 .\
\pard\pardeftab720\sa319\partightenfactor0

\f0\b \cf0 \uc0\u52628 \u50501 \u54620  \u49324 \u51396 \u44428 \u51032  \u48156 \u47588 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u46021 \u51068 \u50640 \u49436  \u47732 \u51396 \u48512 \u47484  \u54036 \u46020 \u47197  \u53469 \u54632 \u51012  \u48155 \u51008  \u53580 \u52412  (Tetze1) \u51060 \u46972 \u45716  \u49324 \u46988 \u51008  \u49324 \u54924 \u51201 \u51004 \u47196 \u45208  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u49345 \u51004 \u47196  \u48380  \u46412  \u44032 \u51109  \u45572 \u52628 \u54620  \u51396 \u47484  \u48276 \u54620  \u49324 \u46988 \u51060 \u50632 \u45796 . \u44536 \u45716  \u45817 \u50672 \u55176  \u51088 \u44592 \u51032  \u51396 \u50640  \u46384 \u46972  \u48268 \u51012  \u48155 \u50500 \u50556  \u54624  \u49324 \u46988 \u51060 \u50632 \u51004 \u45208  \u48277 \u50773 \u51032  \u51116 \u51221 \u51012  \u54869 \u48372 \u54644  \u51452 \u44256  \u44536 \u51032  \u47924 \u47784 \u54620  \u44228 \u54925 \u51012  \u49457 \u52712 \u49884 \u53420  \u51088 \u47196  \u49440 \u53469 \u46104 \u50612  \u54805 \u48268 \u51012  \u47732 \u54616 \u44172  \u46104 \u50632 \u45796 . \u44536 \u45716  \u54028 \u47156 \u52824 \u54616 \u44172 \u46020  \u51204 \u54784  \u44540 \u44144  \u50630 \u45716  \u47568 \u51012  \u54616 \u47728 , \u47924 \u51648 \u54616 \u44256  \u50612 \u47532 \u49437 \u44256  \u48120 \u49888 \u51201 \u51064  \u48177 \u49457 \u46308 \u50640 \u44172  \u44592 \u44340 \u54616 \u44256  \u45440 \u46972 \u50868  \u51060 \u50556 \u44592 \u47484  \u46308 \u47140 \u51452 \u50632 \u45796 . \u44536 \u46308 \u51060  \u49457 \u44221 \u51012  \u44032 \u51648 \u44256  \u51080 \u50632 \u45796 \u47732  \u44536 \u47111 \u44172  \u49549 \u51648  \u50506 \u50520 \u51012  \u44163 \u51060 \u45796 . \u49457 \u44221 \u51008  \u45817 \u49884 \u50640  \u50556 \u49900 \u51201 \u51064  \u47196 \u47560  \u51648 \u46020 \u51088 \u46308 \u51032  \u44428 \u49464 \u50752  \u51116 \u47932 \u51012  \u51613 \u44032 \u49884 \u53412 \u44592  \u50948 \u54616 \u50668  \u48277 \u50773 \u44428 \u51032  \u53685 \u51228  \u50500 \u47000  \u49324 \u51109  (\u27515 \u34255 ) \u46104 \u50612  \u51080 \u50632 \u44256 , \u44536 \u46308 \u51060  \u44032 \u51648 \u46020 \u47197  \u50857 \u45225 \u46104 \u51648  \u50506 \u50520 \u45796  (John C.Gieseler, A Compendium of Ecclesiastical History, per.4, sec.1, par.5 \u52280 \u51312 ).\
\uc0\u53580 \u52412 \u51060  \u49457 \u50640  \u46020 \u52265 \u54616 \u51088  \u44536 \u48372 \u45796  \u47676 \u51200  \u44036  \u54620  \u49324 \u51088 \u45716  \'93\u54616 \u45208 \u45784 \u44284  \u49457 \u48512 \u51032  \u51008 \u54812 \u44032  \u45320 \u55148  \u47928 \u50640  \u51080 \u51012 \u51648 \u50612 \u45796 \'94 (D\'92Aubigne, b.3, ch.1) \u44256  \u49440 \u54252 \u54616 \u50688 \u45796 . \u49324 \u46988 \u46308 \u51008  \u52280 \u46988 \u46108  \u44536  \u49324 \u44592 \u44988 \u51012  \u47560 \u52824  \u54616 \u45720 \u50640 \u49436  \u45236 \u47140 \u50728  \u54616 \u45208 \u45784 \u51012  \u52828 \u55176  \u47582 \u51060 \u54616 \u45716  \u44163 \u52376 \u47100  \u54872 \u50689 \u54616 \u50688 \u45796 . \u44536 \u47532 \u44256  \u51060 \u50752  \u44057 \u51008  \u44032 \u51613 \u54620  \u47588 \u47588 \u44032  \u44368 \u54924  \u50504 \u50640 \u49436  \u51060 \u47336 \u50612 \u51276 \u45796 . \u53580 \u52412 \u51008  \u44053 \u45800 \u50640  \u50732 \u46972 \u44032  \u49324 \u51396 \u44428 \u51012  \u54616 \u45208 \u45784 \u51032  \u44032 \u51109  \u44480 \u51473 \u54620  \u49440 \u47932 \u51060 \u46972 \u44256  \u44201 \u52268 \u54616 \u50688 \u45796 . \u44536 \u45716  \u44536  \u49324 \u51396 \u44428 \u51032  \u54952 \u47141 \u51004 \u47196  \u47568 \u48120 \u50516 \u50500  \u44536 \u44163 \u51012  \u49324 \u45716  \u51088 \u50640 \u44172 \u45716  \u44536  \u54980 \u50640  \u48276 \u54616 \u45716  \u51396 \u44620 \u51648 \u46020  \u54924 \u44060 \u54624  \u54596 \u50836  \u50630 \u51060  \u49324 \u50976 \u46108 \u45796 \u44256  \u51452 \u51109 \u54616 \u50688 \u45796  (D\'92Aubigne, b.3, ch.1). \u44536 \u45716  \u54620  \u44152 \u51020  \u45908  \u45208 \u50500 \u44032  \u52397 \u51473 \u46308 \u50640 \u44172  \'93\u51060  \u49324 \u51396 \u44428 \u51008  \u54788 \u51116  \u49332 \u50500  \u51080 \u45716  \u51088 \u49104  \u50500 \u45768 \u46972  \u51060 \u48120  \u51453 \u51008  \u51088 \u46020  \u44396 \u50896 \u54624  \u54952 \u45733 \u51060  \u51080 \u51004 \u47728 , \u46024 \u51060  \u44452  \u48145 \u50640  \u46504 \u50612 \u51256  \u49548 \u47532 \u47484  \u45236 \u45716  \u44536  \u51593 \u49884  \u50948 \u54616 \u50668  \u49549 \u51204 \u51012  \u45240  \u44536  \u49324 \u46988 \u51060  \u50672 \u50725 \u50640 \u49436  \u52380 \u44397 \u51004 \u47196  \u44032 \u44172  \u46108 \u45796 \'94\u44256  \u48372 \u51613 \u54616 \u50688 \u45796  (K.R.Hagenbach, History of the Reformation, vol, p.96.\u52280 \u51312 ).\
\uc0\u47560 \u49696 \u49324  \u49884 \u47788 \u51060  \u46024 \u51004 \u47196  \u49324 \u46020 \u46308 \u50640 \u44172 \u49436  \u51060 \u51201 \u51012  \u54665 \u54616 \u45716  \u45733 \u47141 \u51012  \u49324 \u47140 \u44256  \u54624  \u46412 , \u48288 \u46300 \u47196 \u45716  \'93\u45348 \u44032  \u54616 \u45208 \u45784 \u51032  \u49440 \u47932 \u51012  \u46024  \u51452 \u44256  \u49332  \u51460 \u47196  \u49373 \u44033 \u54616 \u50688 \u51004 \u45768  \u45348  \u51008 \u44284  \u45348 \u44032  \u54632 \u44760  \u47581 \u54624 \u51648 \u50612 \u45796 \'94 (\u54665  8:20) \u44256  \u45824 \u45813 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u53580 \u52412 \u51032  \u49440 \u47932 \u51012  \u47566 \u51008  \u50676 \u49457 \u51201 \u51064  \u47924 \u47532 \u46308 \u51060  \u49324 \u44172  \u46104 \u50632 \u45796 . \u44552 \u44284  \u51008 \u51008  \u44536 \u51032  \u44552 \u44256 \u47196  \u55128 \u47084  \u46308 \u50612 \u44052 \u45796 . \u46024 \u51004 \u47196  \u49332  \u49688  \u51080 \u45716  \u44396 \u50896 \u51008  \u54924 \u44060 \u50752  \u48127 \u51020 \u44284  \u51396 \u47484  \u45824 \u54637 \u54616 \u50668  \u49912 \u50864 \u45716  \u45128 \u45909 \u51652  \u45432 \u47141 \u51004 \u47196  \u50619 \u45716  \u44396 \u50896 \u48372 \u45796  \u45908 \u50865  \u49789 \u44172  \u50619 \u51012  \u49688  \u51080 \u45716  \u44163 \u51060 \u50632 \u45796 .\
\uc0\u47732 \u51396 \u48512 \u51032  \u44368 \u47532 \u45716  \u47196 \u47560 \u44368  \u50504 \u50640  \u51080 \u45716  \u44221 \u44148 \u54616 \u44256  \u54617 \u49885  \u51080 \u45716  \u49324 \u46988 \u46308 \u47196 \u48512 \u53552  \u48152 \u45824 \u47484  \u48155 \u50500 \u50772 \u45796 . \u44536 \u47084 \u45208  \u51060 \u49457  (\u63972 \u24615 ) \u44284  \u44228 \u49884  (\u21843 \u31034 ), \u50612 \u45712  \u54200 \u51004 \u47196  \u48372 \u45208  \u53356 \u44172  \u48176 \u52824 \u46104 \u45716  \u44536 \u50752  \u44057 \u51008  \u51452 \u51109 \u51012  \u48127 \u51648  \u50500 \u45768 \u54616 \u45716  \u49324 \u46988 \u46308 \u51060  \u47566 \u51060  \u51080 \u50632 \u45796 . \u50612 \u46500  \u51452 \u44368 \u46020  \u44536  \u48512 \u51221 \u54620  \u47588 \u47588 \u50640  \u45824 \u54616 \u50668  \u48152 \u45824 \u54616 \u45716  \u47568 \u51012  \u44048 \u55176  \u54616 \u51648  \u47803 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u47566 \u51008  \u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u51008  \u54844 \u46976 \u54616 \u44256  \u48520 \u50504 \u54644  \u44032 \u44256  \u51080 \u50632 \u45796 . \u44536 \u46308 \u51008  \u54616 \u45208 \u45784 \u44760 \u49436  \u45817 \u49888 \u51032  \u44368 \u54924 \u47484  \u51221 \u44208 \u52992  \u54616 \u49884 \u44592  \u50948 \u54616 \u50668  \u47924 \u49832  \u48169 \u48277 \u51012  \u50416 \u49884 \u51648 \u45716  \u50500 \u45768 \u54616 \u49892 \u51648  \u47932 \u50632 \u45796 .\
\uc0\u47336 \u53552 \u45716  \u50668 \u51204 \u55176  \u48277 \u50773 \u44368 \u51032  \u52649 \u49892 \u54620  \u54620  \u49324 \u46988 \u51060 \u50632 \u51004 \u45208  \u49324 \u51396 \u44428  \u48156 \u47588 \u51088 \u51032  \u47581 \u47161 \u46104 \u44256  \u52280 \u46988 \u46108  \u54665 \u50948 \u47484  \u48372 \u44172  \u46104 \u51088  \u51204 \u50984 \u54624  \u49688 \u48150 \u50640  \u50630 \u50632 \u45796 . \u44536 \u44032  \u49884 \u47924 \u54616 \u45716  \u44368 \u54924 \u51032  \u49888 \u51088 \u46308  \u44032 \u50868 \u45936 \u46020  \u49324 \u51396 \u44428 \u51012  \u49328  \u49324 \u46988 \u46308 \u51060  \u47566 \u51060  \u51080 \u50632 \u45796 . \u44536 \u46308 \u51008  \u47336 \u53552 \u50640 \u44172  \u50752 \u49436  \u50668 \u47084  \u44032 \u51648  \u51396 \u47484  \u44256 \u48177 \u54616 \u44256  \u49324 \u47732 \u51012  \u44396 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u46308 \u51008  \u51396 \u47484  \u45656 \u50864 \u52824 \u44256  \u49352 \u47196 \u50868  \u49373 \u50528 \u47196  \u46308 \u50612 \u44032 \u47140 \u45716  \u55148 \u47581 \u51004 \u47196  \u44536 \u47111 \u44172  \u54616 \u45716  \u44163 \u51060  \u50500 \u45768 \u44256  \u47732 \u51396 \u48512 \u47484  \u49344 \u51004 \u48064 \u47196  \u47732 \u51396 \u48155 \u50500 \u50556  \u54620 \u45796 \u45716  \u44163 \u51060 \u50632 \u45796 . \u47336 \u53552 \u45716  \u45800 \u50672 \u55176  \u51060 \u47484  \u47932 \u47532 \u52824 \u44256  \u44536 \u46308 \u51060  \u54924 \u44060 \u54616 \u50668  \u49373 \u50528 \u51032  \u48320 \u54868 \u47484  \u51068 \u51004 \u53412 \u51648  \u50500 \u45768 \u54616 \u47732  \u44536  \u51396 \u47196  \u51064 \u54616 \u50668  \u47736 \u47581 \u51012  \u48155 \u51012  \u49688 \u48150 \u50640  \u50630 \u45796 \u44256  \u44221 \u44256 \u54616 \u50688 \u45796 . \u45212 \u52376 \u54620  \u51648 \u44221 \u50640  \u48736 \u51652  \u44536 \u46308 \u51008  \u53580 \u52412 \u50640 \u44172 \u47196  \u44032 \u49436  \u44536 \u46308 \u51032  \u52280 \u54924  \u52397 \u47928 \u49849  (\u25082 \u24724 \u32893 \u32862 \u20711 ) \u51064  \u47336 \u53552 \u44032  \u44536 \u46308 \u51032  \u44256 \u48177 \u51012  \u48155 \u50500 \u51452 \u51648  \u50506 \u50520 \u45796 \u45716  \u49324 \u49892 \u51012  \u47568 \u54616 \u44256 , \u50612 \u46500  \u49324 \u46988 \u46308 \u51008  \u44536 \u46308 \u51032  \u46024 \u51012  \u46020 \u47196  \u46028 \u47140  \u45804 \u46972 \u44256  \u45812 \u45824 \u55176  \u50836 \u44396 \u54616 \u50688 \u45796 . \u44536 \u47084 \u51088  \u44536  \u49849 \u47140 \u45716  \u44201 \u45432 \u54616 \u50688 \u45796 . \u44536 \u45716  \u44032 \u51109  \u47924 \u49436 \u50868  \u51200 \u51452 \u47484  \u54616 \u44256 , \u44144 \u47532  \u47784 \u53825 \u51060 \u50640  \u48520 \u51012  \u54588 \u50864 \u44256 , \'93\u45208 \u45716  \u51060  \u49888 \u49457 \u54620  \u47732 \u51396 \u48512 \u47484  \u48152 \u45824 \u54616 \u45716  \u47784 \u46304  \u51060 \u45800 \u51088 \u47484  \u54868 \u54805 \u50640  \u52376 \u54616 \u46972 \u45716  \u47749 \u47161 \u51012  \u48277 \u50773 \u51004 \u47196 \u48512 \u53552  \u48155 \u50520 \u45796 \'94\u44256  \u49548 \u47532 \u51656 \u47104 \u45796  (D\'92Aubigne, b.3, ch.4).\
