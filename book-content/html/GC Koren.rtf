\uc0\u49324 \u46988 \u46308 \u51060  \u47564 \u51068  \u54616 \u45720 \u51032  \u49324 \u47932 \u51012  \u48380  \u49688  \u51080 \u45796 \u47732  \u44536 \u46308 \u51008  \u45733 \u47141  \u51080 \u45716  \u52380 \u49324 \u51032  \u47924 \u47532 \u44032  \u44536 \u47532 \u49828 \u46020 \u51032  \u51064 \u45236 \u51032  \u47568 \u50432 \u51012  \u51648 \u53020 \u50728  \u49324 \u46988 \u46308 \u51012  \u46168 \u47084  \u51652 \u52824 \u44256  \u51080 \u45716  \u44163 \u51012  \u48372 \u44172  \u46112  \u44163 \u51060 \u45796 . \u52380 \u49324 \u46308 \u51008  \u48512 \u46300 \u47084 \u50868  \u46041 \u51221 \u49900 \u51004 \u47196  \u44536 \u46308 \u51032  \u44256 \u53685 \u51012  \u48148 \u46972 \u48372 \u44256  \u44536 \u46308 \u51032  \u44592 \u46020 \u47484  \u46308 \u50632 \u45796 . \u44536 \u46308 \u51008  \u49324 \u46988 \u46308 \u51012  \u50948 \u54744 \u50640 \u49436  \u44396 \u54644  \u45236 \u46972 \u45716  \u49324 \u47161 \u44288 \u51032  \u47749 \u47161 \u51060  \u45236 \u47532 \u44592 \u47484  \u44592 \u45796 \u47532 \u44256  \u51080 \u45796 . \u44536 \u47084 \u45208  \u44536 \u46308 \u51008  \u51312 \u44552  \u45908  \u44592 \u45796 \u47140 \u50556  \u54620 \u45796 . \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u46308 \u51008  \u50420  \u51092 \u51012  \u47560 \u49884 \u44256  \u54588 \u51032  \u52840 \u47168 \u47484  \u48155 \u50500 \u50556  \u54620 \u45796 . \u44536 \u46308 \u50640 \u44172  \u44536 \u52376 \u47100  \u53360  \u44256 \u53685 \u51032  \u50836 \u49548 \u44032  \u46104 \u45716  \u44396 \u50896 \u51032  \u51648 \u50672 \u51008  \u44536 \u46308 \u51032  \u53444 \u50896 \u50640  \u45824 \u54620  \u44032 \u51109  \u51339 \u51008  \u51025 \u45813 \u51060 \u45796 . \u44536 \u46308 \u51060  \u51452 \u45784 \u44760 \u49436  \u51068 \u51012  \u54616 \u49884 \u46020 \u47197  \u51652 \u49900 \u51004 \u47196  \u44592 \u45796 \u47532 \u44256 \u51088  \u50528 \u47484  \u50416 \u44256  \u51080 \u45716  \u46041 \u50504  \u44536 \u46308 \u51008  \u4