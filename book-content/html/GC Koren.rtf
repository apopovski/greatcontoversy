\uc0\u53664 \u47200 \u51008  \u48148 \u45940  (Baden) \u50640 \u49436  \u54616 \u46020 \u47197  \u44208 \u51221 \u46104 \u50632 \u45796 . \u44536 \u47084 \u45208  \u52768 \u48729 \u44544 \u47532 \u45716  \u44144 \u44592 \u50640  \u52280 \u49437 \u54616 \u51648  \u50506 \u50520 \u45796 . \u52712 \u47532 \u55176 \u51032  \u51032 \u54924 \u45716  \u48277 \u50773 \u45817 \u51032  \u44228 \u54925 \u51012  \u51032 \u49900 \u54616 \u44172  \u46104 \u50632 \u44256 , \u46608 \u54620  \u48127 \u45432 \u46972 \u44256  \u44256 \u48177 \u54620  \u49324 \u46988 \u46308 \u50640  \u45824 \u54616 \u50668  \u48277 \u50773 \u51032  \u44368 \u44396 \u50640 \u49436  \u54868 \u54805 \u50640  \u52376 \u54620 \u45796 \u45716  \u44221 \u44256 \u47484  \u48155 \u50520 \u51004 \u48064 \u47196  \u44536 \u46308 \u51032  \u47785 \u49324 \u47484  \u51060 \u50752  \u44057 \u51008  \u50948 \u54744 \u50640  \u48736 \u51648 \u51648  \u50506 \u46020 \u47197  \u44552 \u54616 \u50688 \u45796 . \u52712 \u47532 \u55176 \u50640 \u49436 \u45716  \u47196 \u47560 \u50640 \u49436  \u54028 \u44204 \u46108  \u50500 \u47924 \u47532  \u45817 \u54028 \u49900 \u51060  \u44053 \u54620  \u49324 \u46988 \u44284 \u46020  \u47564 \u45216  \u51456 \u48708 \u44032  \u44536 \u50640 \u44172 \u45716  \u46104 \u50612  \u51080 \u50632 \u45796 . \u44536 \u47084 \u45208  \u51652 \u47532 \u47484  \u50948 \u54616 \u50668  \u55128 \u47536  \u49692 \u44368 \u51088 \u51032  \u54588 \u44032  \u50500 \u51649 \u46020  \u47560 \u47476 \u51648  \u50500 \u45768 \u54620  \u48148 \u45940 \u51004 \u47196  \u44032 \u45716  \u44163 \u51008  \u51453 \u51020 \u51012  \u54693 \u54616 \u50668  \u44032 \u45716  \u44163 \u51060 \u45208  \u45796 \u47492 \u51060  \u50630 \u50632 \u45796 . \u47560 \u52840 \u45236  \u50640 \u53084 \u46988 \u54028 \u46356 \u50864 \u49828  (Ecolampadius) \u50752  \u54624 \u47084  (Haller) \u44032  \u44060 \u54785 \u54028 \u47484  \u45824 \u54364 \u54616 \u50668  \u52636 \u49437 \u54616 \u44172  \u46104 \u50632 \u44256 , \u54620 \u54200 \u51004 \u47196  \u47566 \u51008  \u50976 \u49885 \u54620  \u48149 \u49324 \u46308 \u44284  \u51452 \u44368 \u46308 \u51032  \u51648 \u51648 \u47484  \u48155 \u45716  \u50640 \u53356  (Eck) \u48149 \u49324 \u44032  \u47196 \u47560 \u52769 \u51032  \u45824 \u54364 \u47196  \u49436 \u44172  \u46104 \u50632 \u45796 .\
\uc0\u48708 \u47197  \u52768 \u48729 \u44544 \u47532 \u44032  \u44536  \u44275 \u50640  \u52636 \u49437 \u54616 \u51648 \u45716  \u50506 \u50520 \u51004 \u45208  \u44536 \u51032  \u50948 \u47141 \u51008  \u54924 \u51032 \u49437 \u44620 \u51648  \u48120 \u52452 \u45796 . \u49436 \u44592 \u45716  \u51204 \u48512  \u48277 \u50773 \u45817 \u50640  \u51032 \u54616 \u50668  \u49440 \u52636 \u46104 \u50632 \u44256 , \u44536  \u51060 \u50808 \u51032  \u49324 \u46988 \u51008  \u54596 \u44592 \u47484  \u47803 \u54616 \u46020 \u47197  \u44552 \u51648 \u46104 \u50612 \u49436  \u51060 \u47484  \u48276 \u54616 \u45716  \u51088 \u45716  \u49324 \u54805 \u50640  \u52376 \u54616 \u44592 \u47196  \u46104 \u50632 \u45796 . \u44536 \u47092 \u51648 \u46972 \u46020  \u52768 \u48729 \u44544 \u47532 \u45716  \u47588 \u51068  \u48148 \u45940 \u50640 \u49436  \u50612 \u46496 \u54620  \u44163 \u51060  \u53664 \u47200 \u46104 \u50632 \u45716 \u51648 \u50640  \u45824 \u54616 \u50668  \u49345 \u49464 \u54620  \u48372 \u44256 \u47484  \u48155 \u50520 \u45796 . \u53664 \u47200 \u51109 \u50640  \u52636 \u49437 \u54620  \u54620  \u54617 \u49373 \u51008  \u47588 \u51068  \u51200 \u45377  \u44536 \u45216 \u50640  \u51080 \u50632 \u45912  \u53664 \u47200 \u50640  \u44288 \u54620  \u44592 \u47197 \u51012  \u51089 \u49457 \u54616 \u50688 \u45796 . \u51060  \u48372 \u44256 \u49436 \u45716  \u45796 \u49884  \u45796 \u47480  \u46160  \u54617 \u49373 \u51004 \u47196  \u47568 \u48120 \u50516 \u50500  \u50640 \u53084 \u46988 \u54028 \u46356 \u50864 \u49828 \u51032  \u54200 \u51648 \u50752  \u54632 \u44760  \u45216 \u47560 \u45796  \u52712 \u47532 \u55176 \u50640  \u51080 \u45716  \u52768 \u48729 \u44544 \u47532 \u50640 \u44172  \u51204 \u45804 \u46104 \u50632 \u45796 . \u46041 \u49884 \u50640  \u52768 \u48729 \u44544 \u47532 \u45716  \u44144 \u44592 \u50640  \u45824 \u54620  \u54924 \u45813 \u51004 \u47196  \u51201 \u45817 \u54620  \u51312 \u50616  (\u21161 \u35328 ) \u44284  \u44428 \u44256 \u47484  \u48372 \u45236 \u50632 \u45796 . \u44536 \u51032  \u44544 \u51008  \u48164 \u50640  \u44592 \u47197 \u46104 \u50632 \u45716 \u45936 , \u50672 \u46973 \u54616 \u45716  \u54617 \u49373 \u46308 \u51008  \u44536 \u44163 \u51012  \u44032 \u51648 \u44256  \u51060 \u53951 \u45216  \u50500 \u52840  \u48148 \u45940 \u51004 \u47196  \u46028 \u50500 \u50772 \u45796 . \u46020 \u49884 \u51032  \u47928 \u51012  \u51648 \u53412 \u45716  \u54028 \u49688 \u44988 \u51012  \u54588 \u54616 \u44592  \u50948 \u54616 \u50668  \u44536  \u49900 \u48512 \u47492 \u44988 \u46308 \u51008  \u44032 \u44552  (\u23478 \u31165 ) \u51012  \u45347 \u51008  \u44305 \u51452 \u47532 \u47484  \u47672 \u47532 \u50640  \u51060 \u44256  \u46308 \u50612 \u44052 \u51004 \u48064 \u47196  \u50500 \u47924 \u47088  \u51648 \u51109 \u51060  \u50630 \u51060  \u51096  \u53685 \u44284 \u46104 \u50632 \u45796 .\
\uc0\u52768 \u48729 \u44544 \u47532 \u45716  \u51060 \u47084 \u54620  \u48169 \u48277 \u51004 \u47196  \u44368 \u54876 \u54620  \u45824 \u51201 \u44284  \u49912 \u50872  \u49688  \u51080 \u50632 \u45796 . \u48008 \u53076 \u45768 \u50864 \u49828  (Myconius) \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u54616 \u50688 \u45796 . \'93\u44536 \u45716  \u47749 \u49345 \u44284  \u52384 \u50556 \u50752  \u48148 \u45940 \u51004 \u47196  \u48372 \u45240  \u51312 \u50616  (\u21161 \u35328 ) \u51012  \u53685 \u54616 \u50668  \u51088 \u44592  \u51088 \u49888 \u51060  \u51649 \u51217  \u50896 \u49688 \u46308 \u51032  \u51652 \u51473 \u50640 \u49436  \u53664 \u47200 \u54620  \u44163 \u48372 \u45796  \u55016 \u50476  \u45908  \u45208 \u51008  \u51068 \u51012  \u54616 \u50688 \u45796 \'94 (D\'92Aubigne, b.11, ch.13).\
