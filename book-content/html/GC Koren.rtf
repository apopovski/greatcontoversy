\uc0\u50689 \u50896 \u54620  \u49464 \u50900 \u51060  \u55128 \u47084 \u44032 \u45716  \u46041 \u50504  \u45216 \u47560 \u45796  \u54616 \u45720 \u51032  \u52293 \u46308 \u50640  \u44592 \u47197 \u51032  \u50577  (\u63870 ) \u51060  \u45720 \u50612 \u45208 \u44256  \u51080 \u45796 \u45716  \u49324 \u49892 \u51012  \u49373 \u44033 \u54616 \u47732  \u50620 \u47560 \u45208  \u50628 \u49689 \u54620  \u51068 \u51064 \u44032 ! \u54620  \u48264  \u51077 \u50640 \u49436  \u45208 \u50728  \u47568 , \u54620  \u48264  \u45208 \u53440 \u45240  \u54665 \u50948 \u45716  \u44208 \u45800 \u53076  \u46028 \u51060 \u53420  \u49688  \u50630 \u45796 . \u52380 \u49324 \u46308 \u51008  \u49440 \u50501 \u44036 \u51032  \u54665 \u50948 \u47484  \u45796  \u44592 \u47197 \u54616 \u50668  \u46164 \u45796 . \u49464 \u49345 \u51032  \u44032 \u51109  \u44053 \u54620  \u51221 \u48373 \u51088 \u46020  \u45800  \u54616 \u47336 \u51032  \u44592 \u47197 \u51012  \u52712 \u49548 \u54624  \u49688  \u50630 \u45796 . \u50864 \u47532 \u51032  \u54665 \u50948 , \u50864 \u47532 \u51032  \u47568 , \u49900 \u51648 \u50612  \u44032 \u51109  \u51008 \u48128 \u54620  \u46041 \u44592 \u44620 \u51648 \u46020  \u47784 \u46160  \u54665 \u48373 \u44284  \u48520 \u54665 \u51032  \u50868 \u47749 \u51012  \u44208 \u51221 \u54616 \u45716  \u51473 \u45824 \u54620  \u50669 \u54624 \u51012  \u54620 \u45796 . \u48708 \u47197  \u50864 \u47532 \u44032  \u44536 \u44163 \u46308 \u51012  \u51082 \u50612 \u48260 \u47160 \u51012 \u51648 \u46972 \u46020  \u44536 \u44163 \u46308 \u51008  \u51032 \u47213 \u45796 \u45716  \u54032 \u44208 \u51012  \u48155 \u45712 \u45264  \u51221 \u51396 \u51032  \u49440 \u44256 \u47484  \u48155 \u45712 \u45264  \u54616 \u45716  \u47928 \u51228 \u50640 \u49436  \u51613 \u44144 \u44032  \u46112  \u44163 \u51060 \u45796 .\
\uc0\u50696 \u49696 \u44032 \u51032  \u44305 \u53469  \u45240  \u44048 \u44305 \u54032 \u50640  \u50620 \u44404 \u51032  \u47784 \u50577 \u51060  \u53952 \u47548 \u50630 \u51060  \u44536 \u45824 \u47196  \u45208 \u53440 \u45208 \u45716  \u44163 \u52376 \u47100  \u49324 \u46988 \u51032  \u54408 \u49457 \u46020  \u54616 \u45720 \u51032  \u47784 \u46304  \u44592 \u47197 \u50640  \u52649 \u49892 \u54616 \u44172  \u47896 \u49324 \u46108 \u45796 . \u44536 \u47100 \u50640 \u46020  \u48520 \u44396 \u54616 \u44256  \u54616 \u45720 \u51032  \u44144 \u47337 \u54620  \u51316 \u51116 \u46308 \u50640 \u44172  \u48372 \u51060 \u51648  \u50506 \u51012  \u49688  \u50630 \u45716  \u44536  \u44592 \u47197 \u50640  \u45824 \u54616 \u50668  \u50684 \u47140 \u54616 \u45716  \u51068 \u51060  \u50620 \u47560 \u45208  \u46300 \u47928 \u44032 . \u47564 \u51068  \u48372 \u51060 \u45716  \u49464 \u44228 \u50752  \u48372 \u51060 \u51648  \u50506 \u45716  \u49464 \u44228 \u47484  \u44396 \u48516 \u54644  \u45459 \u51008  \u55064 \u51109 \u51012  \u51228 \u44144 \u54644 \u48260 \u47548 \u51004 \u47196  \u49324 \u46988 \u46308 \u51060  \u49900 \u54032 \u45216 \u50640  \u45796 \u49884  \u47785 \u44201 \u54616 \u44172  \u46112  \u47784 \u46304  \u47568 \u44284  \u54665 \u46041 \u51012  \u44592 \u47197 \u54616 \u44256  \u51080 \u45716  \u52380 \u49324 \u47484  \u48380  \u49688  \u51080 \u45796 \u47732  \u52280 \u51004 \u47196  \u47566 \u51008  \u49324 \u46988 \u46308 \u51060  \u45216 \u47560 \u45796  \u54616 \u45716  \u47568 \u51012  \u44536 \u52824 \u44256  \u47566 \u51008  \u54665 \u46041 \u51012  \u54616 \u51648  \u50506 \u44172  \u46112  \u44163 \u51060 \u45796 .\
\uc0\u49900 \u54032  \u46412 \u50640 \u45716  \u44033 \u51333  \u51116 \u45733 \u51012  \u49324 \u50857 \u54620  \u45936  \u45824 \u54616 \u50668  \u49464 \u48128 \u54620  \u51312 \u49324 \u47484  \u48155 \u51012  \u44163 \u51060 \u45796 . \u50864 \u47532 \u45716  \u54616 \u45720 \u50640 \u49436  \u48716 \u47140  \u51456  \u51088 \u48376 \u51012  \u50612 \u46523 \u44172  \u49324 \u50857 \u54664 \u45716 \u44032 ? \u51452 \u45784 \u44760 \u49436  \u50724 \u49892  \u46412 \u50640  \u44536 \u48516 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u44163 \u51012  \u51060 \u51088 \u50752  \u54632 \u44760  \u48155 \u51648  \u50506 \u51004 \u49892  \u44163 \u51064 \u44032 ? \u50864 \u47532 \u45716  \u50864 \u47532 \u50640 \u44172  \u50948 \u53441 \u46108  \u45733 \u47141 \u51012  \u49552 \u44284  \u47560 \u51020 \u44284  \u51221 \u49888 \u51012  \u53685 \u54616 \u50668  \u54616 \u45208 \u45784 \u44760  \u50689 \u44305 \u51012  \u46028 \u47532 \u47728  \u49464 \u49345 \u51012  \u48373 \u46104 \u44172  \u54616 \u45716  \u51068 \u50640  \u51060 \u50857 \u54616 \u50688 \u45716 \u44032 ? \u50864 \u47532 \u51032  \u49884 \u44036 , \u50864 \u47532 \u51032  \u48531 , \u50864 \u47532 \u51032  \u51020 \u49457 , \u50864 \u47532 \u51032  \u46024 , \u50864 \u47532 \u51032  \u44048 \u54868 \u47141 \u51012  \u50612 \u46523 \u44172  \u49324 \u50857 \u54616 \u50688 \u45716 \u44032 ? \u50864 \u47532 \u45716  \u44536 \u47532 \u49828 \u46020 \u47484  \u50948 \u54616 \u50668  \u44032 \u45212 \u54620  \u51088 \u50752  \u48337 \u51088 \u50752  \u44256 \u50500 \u50752  \u44284 \u48512 \u46308 \u50640 \u44172  \u50612 \u46500  \u51068 \u51012  \u54616 \u50688 \u45716 \u44032 ? \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u50864 \u47532 \u47484  \u45817 \u49888 \u51032  \u44144 \u47337 \u54620  \u47568 \u50432 \u51032  \u48372 \u44288 \u51088 \u47196  \u49340 \u51004 \u49512 \u45716 \u45936 , \u50864 \u47532 \u45716  \u50864 \u47532 \u50640 \u44172  \u51452 \u50612 \u51652  \u48731 \u44284  \u