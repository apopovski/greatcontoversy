\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u51060 \u50752  \u44057 \u51008  \u44144 \u51667  \u49440 \u51648 \u51088 \u46308  \u51473 \u51032  \u54620  \u49324 \u46988 \u51008  \u51088 \u44592 \u44032  \u52380 \u49324  \u44032 \u48652 \u47532 \u50648 \u51032  \u44032 \u47476 \u52840 \u51012  \u48155 \u50520 \u45432 \u46972 \u44256  \u51452 \u51109 \u54616 \u50688 \u45796 . \u44536 \u47532 \u44256  \u44536 \u50752  \u50672 \u54633 \u54620  \u54620  \u54617 \u49373 \u51008  \u44277 \u48512 \u54616 \u45912  \u44163 \u46020  \u45236 \u48260 \u47532 \u44256 , \u44536 \u44032  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51012  \u54644 \u49437 \u54616 \u45716  \u51648 \u54812 \u47484  \u54616 \u45208 \u45784 \u44760 \u47196 \u48512 \u53552  \u51649 \u51217  \u48155 \u50520 \u45432 \u46972 \u44256  \u51452 \u51109 \u54616 \u50688 \u45796 . \u50896 \u47000 \u48512 \u53552  \u44305 \u49888 \u51201  \u44221 \u54693 \u51012  \u44032 \u51652  \u50668 \u47084  \u49324 \u46988 \u46308 \u51008  \u44536 \u46308 \u44284  \u50672 \u54633 \u54616 \u50688 \u45796 . \u51060 \u50752  \u44057 \u51008  \u44305 \u49888 \u51088 \u46308 \u51032  \u54665 \u46041 \u51008  \u53360  \u47932 \u51032 \u47484  \u51068 \u51004 \u53040 \u45796 . \u47336 \u53552 \u51032  \u49444 \u44368 \u47196  \u47568 \u48120 \u50516 \u50500  \u49324 \u46988 \u46308 \u51008  \u44033  \u44275 \u50640 \u49436  \u44060 \u54785 \u51032  \u54596 \u50836 \u47484  \u53356 \u44172  \u51088 \u44033 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u51648 \u44552 \u51008  \u51221 \u51649 \u54620  \u47751  \u49324 \u46988 \u46308 \u51060  \u44536  \u49352 \u47196 \u50868  \u49440 \u51648 \u51088 \u46308 \u51032  \u49549 \u51076 \u50640  \u48120 \u54841 \u46104 \u50632 \u45796 .\
\uc0\u44536 \u47532 \u44256  \u44536  \u50868 \u46041 \u51032  \u51648 \u46020 \u51088 \u46308 \u51008  \u48708 \u53584 \u48288 \u47476 \u53356 \u47196  \u44032 \u49436  \u47708 \u46976 \u55176 \u53668 \u44284  \u44536 \u51032  \u46041 \u51648 \u46308 \u50640 \u44172  \u51088 \u44592 \u46308 \u51032  \u51452 \u51109 \u51012  \u44053 \u50836 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u47568 \u54616 \u50688 \u45796 . \'93\u50864 \u47532 \u45716  \u48177 \u49457 \u51012  \u44032 \u47476 \u52824 \u44592  \u50948 \u54616 \u50668  \u54616 \u45208 \u45784 \u44760 \u47196 \u48512 \u53552  \u48372 \u45236 \u49900 \u51012  \u51077 \u51008  \u49324 \u46988 \u46308 \u51060 \u45796 . \u50864 \u47532 \u45716  \u51452 \u45784 \u44284  \u52828 \u48128 \u54620  \u45812 \u54868 \u47484  \u45208 \u45572 \u50632 \u45796 . \u50864 \u47532 \u45716  \u50612 \u46500  \u51068 \u51060  \u51068 \u50612 \u45216  \u44163 \u51012  \u50504 \u45796 . \u45796 \u49884  \u47568 \u54616 \u47732  \u50864 \u47532 \u45716  \u49324 \u46020 \u50836  \u49440 \u51648 \u51088 \u46308 \u51060 \u45796 . \u44536 \u47084 \u48064 \u47196  \u47336 \u53552  \u48149 \u49324 \u50640 \u44172  \u54840 \u49548 \u54616 \u44256 \u51088  \u54620 \u45796 \'94 (D\'92Aubigne, b.9, ch.7).\
\uc0\u44060 \u54785 \u51088 \u46308 \u51008  \u45440 \u46972 \u44256  \u45817 \u54889 \u54616 \u44172  \u46104 \u50632 \u45796 . \u51060 \u47084 \u54620  \u51068 \u51008  \u52376 \u51020 \u51004 \u47196  \u45817 \u54616 \u45716  \u51068 \u51060 \u50632 \u51004 \u48064 \u47196  \u44536 \u46308 \u51008  \u50612 \u52236 \u54624  \u48148 \u47484  \u47792 \u46992 \u45796 . \u47708 \u46976 \u55176 \u53668 \u51008  \u51060 \u47111 \u44172  \u47568 \u54616 \u50688 \u45796 . \'93\u44536  \u49324 \u46988 \u46308 \u50640 \u44172 \u45716  \u49892 \u47196  \u48708 \u49345 \u54620  \u49888 \u46308 \u51060  \u50669 \u49324 \u54616 \u44256  \u51080 \u45796 . \u44536 \u47084 \u45208  \u44536 \u44163 \u51008  \u47924 \u49832  \u49888 \u46308 \u51064 \u44032 ?\'85\u50864 \u47532 \u45716  \u54616 \u45208 \u45784 \u51032  \u49457 \u47161 \u51012  \u49548 \u47736 \u54624 \u44620  \u51452 \u51032 \u54616 \u45716  \u54620 \u54200  \u49324 \u45800 \u51032  \u50689 \u50640 \u44172  \u48120 \u54841 \u46104 \u51648  \u50506 \u46020 \u47197  \u51312 \u49900 \u54616 \u51648  \u50506 \u51004 \u47732  \u50504  \u46108 \u45796 \'94 (D\'92Au-bigne, b.9, ch.7).\
\uc0\u49352  \u44368 \u47532 \u51032  \u50676 \u47588 \u45716  \u50724 \u47000 \u51648  \u50506 \u50500  \u45208 \u53440 \u45228 \u45796 . \u49324 \u46988 \u46308 \u51008  \u49457 \u44221 \u51012  \u46321 \u54620 \u55176  \u50668 \u44592 \u44144 \u45208  \u50756 \u51204 \u55176  \u48260 \u47532 \u46020 \u47197  \u51648 \u46020 \u46104 \u50632 \u45796 . \u54617 \u44368 \u46308 \u51008  \u54844 \u46976  \u44032 \u50868 \u45936  \u48736 \u51276 \u45796 . \u54617 \u49373 \u46308 \u51008  \u47784 \u46304  \u44508 \u52825 \u51012  \u47924 \u49884 \u54616 \u44256  \u44277 \u48512 \u47484  \u54077 \u44060 \u52824 \u44256 , \u45824 \u54617 \u46308 \u51012  \u48260 \u47532 \u44256  \u45208 \u50724 \u44172  \u46104 \u50632 \u45796 . \u44060 \u54785  \u49324 \u50629 \u51012  \u48512 \u55141 \u49884 \u53412 \u44256  \u51648 \u46020 \u54624  \u49688  \u51080 \u45716  \u52649 \u48516 \u54620  \u45733 \u47141 \u51012  \u44054 \u52628 \u50632 \u45796 \u44256  \u51088 \u48512 \u54616 \u45912  \u49324 \u46988 \u46308 \u51008  \u44536  \u49324 \u50629 \u51012  \u54028 \u47736 \u47196  \u51064 \u46020 \u54616 \u45716  \u45936  \u49457 \u44277 \u54616 \u50688 \u51012  \u49104 \u51060 \u50632 \u45796 . \u48277 \u50773 \u45817 \u46308 \u51008  \u51060 \u51228  \u49888 \u51076 \u51012  \u45796 \u49884  \u50619 \u44172  \u46104 \u50632 \u51004 \u48064 \u47196 , \u47588 \u50864  \u44592 \u48848 \u49436 , \'93\u51060 \u51228  \u47560 \u51648 \u47561 \u51004 \u47196  \u54620  \u48264 \u47564  \u45908  \u49912 \u50864 \u47732  \u47784 \u46304  \u44163 \u51008  \u50864 \u47532 \u51032  \u44163 \u51060  \u46108 \u45796 \'94 (D\'92Aubigne, b.9, ch.7) \u44256  \u48512 \u47476 \u51670 \u50632 \u45796 .\
\uc0\u47336 \u53552 \u45716  \u48148 \u47476 \u53944 \u48512 \u47476 \u53356 \u50640 \u49436  \u51068 \u51032  \u51204 \u54980  \u49324 \u51221 \u51012  \u46307 \u44256  \u53356 \u44172  \u50684 \u47140 \u54616 \u50688 \u45796 . \'93\u45208 \u45716  \u49324 \u45800 \u51060  \u51060 \u50752  \u44057 \u51008  \u51116 \u45212 \u51012  \u44032 \u51256 \u50732  \u44163 \u51012  \u48120 \u47532 \u48512 \u53552  \u50696 \u44592 \u54616 \u44256  \u51080 \u50632 \u45796 \'94 (D\'92Au-bigne, b.9, ch.7) \u44256  \u44536 \u45716  \u47568 \u54616 \u50688 \u45796 . \u44536 \u45716  \u44144 \u51667  \u49440 \u51648 \u51088 \u46308 \u51032  \u51652 \u49345 \u51012  \u44648 \u45803 \u44256 , \u44536 \u44163 \u51060  \u51652 \u47532 \u51032  \u49324 \u50629 \u51012  \u50948 \u54801 \u54624  \u50948 \u54744 \u51012  \u48372 \u50520 \u45796 . \u48277 \u50773 \u44284  \u54889 \u51228 \u51032  \u48152 \u45824 \u46020  \u44536 \u44032  \u54788 \u51116  \u44221 \u54744 \u54616 \u44256  \u51080 \u45716  \u44256 \u53685 \u44284  \u50612 \u47140 \u50880 \u48372 \u45796  \u45908  \u53356 \u51648  \u50506 \u50520 \u45796 . \u49548 \u50948  \u44060 \u54785  \u49324 \u50629 \u51032  \u46041 \u51648 \u46972 \u44256  \u44277 \u50616 \u54616 \u45716  \u51088 \u46308  \u44032 \u50868 \u45936 \u49436  \u44032 \u51109  \u50501 \u54620  \u50896 \u49688 \u44032  \u51068 \u50612 \u45228 \u45796 . \u44536 \u50640 \u44172  \u44536 \u52376 \u47100  \u53360  \u44592 \u49256 \u44284  \u50948 \u47196 \u47484  \u44032 \u51256 \u45796 \u51452 \u50632 \u45912  \u48148 \u47196  \u44536  \u51652 \u47532 \u44032  \u44368 \u54924  \u50504 \u50640 \u49436  \u53804 \u51137 \u51012  \u51068 \u51004 \u53412 \u44256  \u54844 \u46976 \u51012  \u48730 \u50612 \u45236 \u45716  \u46020 \u44396 \u47196  \u49324 \u50857 \u46104 \u44256  \u51080 \u50632 \u45796 .\
\uc0\u44060 \u54785  \u49324 \u50629 \u50640 \u49436  \u47336 \u53552 \u45716  \u54616 \u45208 \u45784 \u51032  \u49457 \u47161 \u51032  \u50836 \u44396 \u50640  \u46384 \u46972  \u50612 \u51796  \u49688  \u50630 \u51060  \u51068 \u51012  \u54616 \u44172  \u46104 \u50632 \u51648 \u47564 , \u49324 \u49324 \u47196 \u50868  \u47560 \u51020 \u51004 \u47196  \u54616 \u51648  \u50506 \u50520 \u45796 . \u44536 \u45716  \u44536 \u44032  \u50619 \u51008  \u50948 \u52824 \u47484  \u51032 \u46020 \u51201 \u51004 \u47196  \u52712 \u54620  \u44163 \u51060  \u50500 \u45768 \u50632 \u44256 , \u44536 \u52376 \u47100  \u44049 \u51089 \u49828 \u47088  \u48320 \u54868 \u47484  \u44144 \u51032  \u50696 \u49345 \u54620  \u51201 \u46020  \u50630 \u50632 \u45796 . \u44536 \u45716  \u45796 \u47564  \u47924 \u54620 \u54616 \u49888  \u54616 \u45208 \u45784 \u51032  \u49552 \u50640  \u49324 \u50857 \u46104 \u45716  \u46020 \u44396 \u50640  \u51648 \u45208 \u51648  \u50506 \u50520 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u51088 \u44592 \u51032  \u49324 \u50629 \u51032  \u44208 \u44284  \u46412 \u47928 \u50640  \u44036 \u54841  \u46504 \u50632 \u45796 . \u44536 \u45716  \u54620  \u46412  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u54616 \u50688 \u45796 . \'93\u45236 \u44032  \u44032 \u47476 \u52828  \u44368 \u47532 \u45716  \u44536  \u51088 \u52404 \u44032  \u48373 \u51020 \u51060 \u48064 \u47196  \u44536 \u47092  \u47532 \u45716  \u50630 \u44192 \u51648 \u47564  \u47564 \u51068  \u44536  \u44368 \u47532 \u44032  \u45800  \u54620  \u49324 \u46988 \u51060 \u46972 \u46020 , \u48708 \u47197  \u50500 \u47924 \u47532  \u48708 \u52380 \u54620  \u54620  \u49324 \u46988 \u51068 \u51648 \u46972 \u46020  \u44536 \u50640 \u44172  \u49552 \u54644 \u47484  \u51452 \u50632 \u45796 \u47732  \u45208 \u45716  \u44536 \u44163 \u51012  \u52712 \u49548 \u54616 \u44192 \u45796 . \u47564 \u51068  \u44536 \u47111 \u44172  \u47803 \u54620 \u45796 \u47732  \u45208 \u45716  \u50676  \u48264 \u51060 \u46972 \u46020  \u51453 \u44192 \u45796 \'94 (D\'92Aubigne, b.9, ch.7).\
\pard\pardeftab720\sa319\partightenfactor0

\f0\b \cf0 \uc0\u44060 \u54785  \u49324 \u50629 \u51032  \u50948 \u44592 \u50752  \u47336 \u53552 \u51032  \u44208 \u49900 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u44536 \u47088 \u45936  \u44060 \u54785  \u49324 \u50629 \u51032  \u51473 \u49900 \u51648 \u51064  \u48708 \u53584 \u48288 \u47476 \u53356 \u45716  \u48148 \u50556 \u55120 \u47196  \u44305 \u49888 \u44284  \u48520 \u48277 \u51032  \u49464 \u47141  \u50500 \u47000  \u46308 \u50612 \u44032 \u44256  \u51080 \u50632 \u45796 . \u51060 \u52376 \u47100  \u46160 \u47140 \u50868  \u49324 \u53468 \u45716  \u47336 \u53552 \u51032  \u44368 \u54984 \u51032  \u44208 \u44284 \u44032  \u50500 \u45768 \u50632 \u51648 \u47564  \u46021 \u51068  \u51204 \u44397 \u50640 \u49436  \u44536 \u51032  \u50896 \u49688 \u46308 \u51008  \u44536  \u52293 \u51076 \u51012  \u44536 \u50640 \u44172  \u46028 \u47532 \u44256  \u51080 \u50632 \u45796 . \u47560 \u51020 \u51032  \u44256 \u53685 \u51012  \u50504 \u44256  \u44536 \u45716  \'93\u51060  \u50948 \u45824 \u54620  \u44060 \u54785  \u49324 \u50629 \u51032  \u44208 \u44284 \u44032  \u46020 \u45824 \u52404  \u50612 \u46523 \u44172  \u46112  \u44163 \u51064 \u44032 ?\'94 (D\'92Aubigne, b.9, ch.7) \u46972 \u44256  \u51060 \u46384 \u44552  \u51088 \u44592  \u49828 \u49828 \u47196 \u50640 \u44172  \u47932 \u50612  \u48372 \u50520 \u45796 . \u44536 \u47532 \u44256  \u44536 \u44032  \u44592 \u46020 \u47196 \u50024  \u45796 \u49884  \u54616 \u45208 \u45784 \u44284  \u50472 \u47492 \u54664 \u51012  \u46412  \u54217 \u50504 \u54620  \u47560 \u51020 \u51012  \u50619 \u50632 \u45796 . \'93\u51060  \u49324 \u50629 \u51008  \u45208 \u51032  \u49324 \u50629 \u51060  \u50500 \u45768 \u44256  \u45817 \u49888 \u51032  \u49324 \u50629 \u51077 \u45768 \u45796 . \u45817 \u49888 \u51008  \u48120 \u49888 \u44284  \u44305 \u49888 \u51004 \u47196  \u51060  \u49324 \u50629 \u51060  \u45908 \u47101 \u54784 \u51648 \u46020 \u47197  \u54728 \u46973 \u54616 \u49492 \u49436 \u45716  \u50504  \u46121 \u45768 \u45796 \'94\u46972 \u44256  \u44536 \u45716  \u44592 \u46020 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u51060 \u47084 \u54620  \u50948 \u44592 \u47484  \u45817 \u54616 \u50668  \u53804 \u51137 \u50640 \u49436  \u47932 \u47084 \u45208  \u50724 \u47019 \u46041 \u50504  \u47672 \u47932 \u47084  \u51080 \u50612 \u50556  \u54620 \u45796 \u44256  \u49373 \u44033 \u54624  \u46412  \u44536 \u45716  \u44204 \u46364  \u49688  \u50630 \u50632 \u45796 . \u44536 \u45716  \u48708 \u53584 \u48288 \u47476 \u53356 \u47196  \u46028 \u50500 \u44032 \u44592 \u47196  \u44208 \u49900 \u54616 \u50688 \u45796 .\
\uc0\u44536 \u45716  \u51648 \u52404 \u54616 \u51648  \u50506 \u44256  \u50948 \u54744 \u54620  \u50668 \u54665 \u51012  \u46496 \u45228 \u45796 . \u44536 \u45716  \u54889 \u51228 \u47196 \u48512 \u53552  \u54028 \u47928 \u51012  \u49440 \u44256  \u48155 \u44256  \u51080 \u50632 \u45796 . \u50896 \u49688 \u46308 \u51008  \u47560 \u51020 \u45824 \u47196  \u44536 \u51032  \u49373 \u47749 \u51012  \u48764 \u50519 \u51012  \u49688  \u51080 \u50632 \u44256 , \u52828 \u44396 \u46308 \u51008  \u44536 \u47484  \u46020 \u50752 \u51452 \u44144 \u45208  \u48372 \u54840 \u54616 \u45716  \u51068 \u51012  \u54616 \u51648  \u47803 \u54616 \u44172  \u46104 \u50612  \u51080 \u50632 \u45796 . \u51221 \u48512 \u45716  \u44536 \u51032  \u46041 \u51648 \u46308 \u50640 \u44172  \u53945 \u48324 \u55176  \u50628 \u51473 \u54620  \u51312 \u52824 \u47484  \u52712 \u54616 \u44256  \u51080 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u48373 \u51020  \u49324 \u50629 \u51060  \u50948 \u44592 \u50640  \u48736 \u51652  \u44163 \u51012  \u50508 \u44256 , \u45824 \u45812 \u54616 \u44172  \u51452 \u45784 \u51032  \u44144 \u47337 \u54620  \u51060 \u47492 \u51004 \u47196  \u51652 \u47532 \u47484  \u50948 \u54620  \u49912 \u50880 \u50640  \u52636 \u51204 \u54616 \u50688 \u45796 .\
\uc0\u47336 \u53552 \u45716  \u49440 \u54980  (\u36984 \u20399 ) \u50640 \u44172  \u48372 \u45236 \u45716  \u54200 \u51648 \u50640 \u49436 , \u48148 \u47476 \u53944 \u48512 \u47476 \u53356 \u47484  \u46496 \u45208 \u45716  \u51060 \u50976 \u47484  \u48157 \u55180  \u45796 \u51020 \u50640  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u54616 \u50688 \u45796 . \'93\u51204 \u54616 \u50668 , \u45236 \u44032  \u48708 \u53584 \u48288 \u47476 \u53356 \u50640  \u45208 \u44032 \u45716  \u44163 \u51008  \u44400 \u51452  (\u21531 \u20027 ) \u50752  \u49440 \u54980 \u46308 \u48372 \u45796  \u45908 \u50865  \u45458 \u51004 \u49888  \u51060 \u51032  \u48372 \u54840 \u47484  \u48155 \u44256  \u45208 \u44036 \u45796 \u45716  \u49324 \u49892 \u51012  \u50508 \u50500 \u51452 \u49901 \u49884 \u50724 . \u45208 \u45716  \u51204 \u54616 \u51032  \u51648 \u51648 \u47484  \u44036 \u52397 \u54616 \u44256  \u51080 \u51648  \u50506 \u49845 \u45768 \u45796 . \u45236 \u44032  \u51204 \u54616 \u51032  \u48372 \u54840 \u47484  \u48148 \u46972 \u45716  \u44163 \u51008  \u45908 \u50865  \u50500 \u45768 \u47728  \u50724 \u55176 \u47140  \u51204 \u54616 \u47484  \u48372 \u54840 \u54644  \u46300 \u47532 \u44256 \u51088  \u54616 \u45716  \u48148 \u51077 \u45768 \u45796 . \u47564 \u51068  \u51204 \u54616 \u44760 \u49436  \u45208 \u47484  \u48372 \u54840 \u54644  \u51452 \u49892  \u44163 \u51060 \u46972 \u47732  \u45208 \u45716  \u48708 \u53584 \u48288 \u47476 \u53356 \u47196  \u45208 \u44032 \u51648  \u50506 \u44192 \u49845 \u45768 \u45796 . \u51060  \u49324 \u50629 \u51008  \u44160 \u51004 \u47196  \u51652 \u51204 \u46112  \u49324 \u50629 \u51060  \u50500 \u45785 \u45768 \u45796 . \u50724 \u51649  \u54616 \u45208 \u45784 \u44760 \u49436  \u49324 \u46988 \u51032  \u46020 \u50880 \u44284  \u54801 \u47141  \u50630 \u51060  \u54848 \u47196  \u44536  \u49324 \u50629 \u51012  \u54616 \u49492 \u50556  \u54633 \u45768 \u45796 . \u44032 \u51109  \u53360  \u49888 \u50521 \u51012  \u44032 \u51652  \u49324 \u46988 \u51008  \u44032 \u51109  \u51096  \u48372 \u54840 \u47484  \u48155 \u51012  \u49688  \u51080 \u45716  \u49324 \u46988 \u51077 \u45768 \u45796 \'94 (D\'92Aubigne, b.9, ch.8).\
\uc0\u48708 \u53584 \u48288 \u47476 \u53356 \u47484  \u54693 \u54616 \u50668  \u44032 \u45716  \u46020 \u51473 \u50640  \u44592 \u47197 \u54620  \u46160  \u48264 \u51704  \u54200 \u51648 \u50640 \u49436  \u44536 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u54616 \u50688 \u45796 . \'93\u45208 \u45716  \u51204 \u54616 \u51032  \u48708 \u50948 \u47484  \u44144 \u49828 \u47476 \u44256  \u50728  \u49464 \u49345 \u51032  \u48516 \u45432 \u47484  \u48155 \u51012  \u44163 \u51012  \u50508 \u44256  \u51080 \u49845 \u45768 \u45796 . \u48708 \u53584 \u48288 \u47476 \u53356 \u51032  \u51452 \u48124 \u51008  \u45208 \u51032  \u50577 \u51060  \u50500 \u45785 \u45768 \u44620 ? \u54616 \u45208 \u45784 \u44760 \u49436  \u44536 \u46308 \u46020  \u45208 \u50640 \u44172  \u47585 \u44592 \u51648  \u50506 \u51004 \u49512 \u49845 \u45768 \u44620 ? \u44536 \u47084 \u48064 \u47196  \u54596 \u50836 \u54616 \u45796 \u47732 , \u44536 \u46308 \u51012  \u50948 \u54616 \u50668  \u51453 \u51020 \u51012  \u47924 \u47493 \u50416 \u44256  \u45208 \u44032 \u45716  \u44163 \u51060  \u47560 \u46405 \u52824  \u50500 \u45768 \u54616 \u44192 \u49845 \u45768 \u44620 ? \u44536  \u50808 \u50640 , \u45208 \u45716  \u46021 \u51068 \u50640 \u49436  \u50612 \u46500  \u47924 \u49436 \u50868  \u49548 \u50836 \u44032  \u51068 \u50612 \u45208 \u49436  \u44536 \u47196  \u51064 \u54616 \u50668  \u54616 \u45208 \u45784 \u44760 \u49436  \u50864 \u47532 \u45208 \u46972 \u47484  \u47736 \u54616 \u49892 \u44620  \u46160 \u47140 \u50892 \u54633 \u45768 \u45796 \'94 (D\'92Aubigne, b.9, ch.7).\
\uc0\u44537 \u55176  \u49888 \u51473 \u54616 \u44256  \u44216 \u49552 \u54620  \u53468 \u46020 \u47196 , \u44536 \u47084 \u47732 \u49436 \u46020  \u45800 \u54840 \u54616 \u44256  \u54869 \u44256 \u54620  \u53468 \u46020 \u47196  \u44536 \u45716  \u51068 \u51012  \u49884 \u51089 \u54616 \u50688 \u45796 . \u44536 \u45716  \u47568 \u54616 \u50688 \u45796 . \'93\u54253 \u47141 \u51004 \u47196  \u49464 \u50892 \u51652  \u44163 \u51012  \u50864 \u47532 \u45716  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51004 \u47196  \u47924 \u45320 \u46888 \u47532 \u44256  \u54028 \u44340 \u54644 \u50556  \u54620 \u45796 . \u45208 \u45716  \u48120 \u49888 \u51201 \u51060 \u44144 \u45208  \u48520 \u49888 \u51201 \u51064  \u49324 \u46988 \u46308 \u50640  \u45824 \u54616 \u50668  \u54253 \u47141 \u51012  \u50416 \u51648  \u50506 \u51012  \u44163 \u51060 \u45796 . \'85\u49324 \u46988 \u51008  \u44053 \u50836 \u45817 \u54644 \u49436 \u45716  \u50504  \u46108 \u45796 . \u49888 \u50521 \u51032  \u44540 \u48376  \u50836 \u49548 \u45716  \u51088 \u50976 \u51060 \u45796 \'94 (-D\'92Aubigne, b.9, ch.8).\
