\f1\b0 \cf0 \
\uc0\u49324 \u45800 \u51008  \u46160  \u53360  \u50724 \u47448 , \u50689 \u54844  \u48520 \u47736 \u49444 \u44284  \u51068 \u50836 \u51068  \u49888 \u49457 \u49444 \u51012  \u53685 \u54616 \u50668  \u49324 \u46988 \u46308 \u51012  \u44536 \u51032  \u44592 \u47564  \u50500 \u47000  \u46308 \u50612 \u50724 \u44172  \u54624  \u44163 \u51060 \u45796 . \u50689 \u54844  \u48520 \u47736 \u49444 \u51008  \u44053 \u49888 \u49696 \u51032  \u44592 \u52488 \u44032  \u46104 \u44256  \u51068 \u50836 \u51068  \u49888 \u49457 \u49444 \u51008  \u47196 \u47560 \u44368 \u54924 \u50640  \u45824 \u54620  \u44277 \u47749 \u49900 \u51012  \u51068 \u51004 \u53416 \u45796 . \u48120 \u44397 \u51032  \u44060 \u49888 \u44368 \u46020 \u46308 \u51008  \u49556 \u49440 \u54616 \u50668  \u44053 \u49888 \u49696 \u44284  \u49552 \u51012  \u51105 \u44592  \u50948 \u54616 \u50668  \u49900 \u50672  (\u28145 \u28149 ) \u51012  \u45336 \u50612  \u44536 \u46308 \u51032  \u49552 \u51012  \u45236 \u48128 \u44256  \u46608  \u44536 \u46308 \u51008  \u53360  \u44396 \u47105 \u53573 \u51060 \u47484  \u45336 \u50612 \u49436  \u47196 \u47560 \u44368 \u54924 \u51032  \u49464 \u47141 \u44284  \u50501 \u49688 \u54616 \u44592  \u50948 \u54616 \u50668  \u49552 \u51012  \u48855 \u52832  \u44163 \u51060 \u45796 . \u44536 \u50752  \u44057 \u51008  \u49340 \u51473  \u50672 \u54633 \u51032  \u49464 \u47141  \u50500 \u47000  \u51060  \u45208 \u46972 \u45716  \u50577 \u49900 \u51032  \u44428 \u47532 \u47484  \u50976 \u47536 \u54616 \u45716  \u51068 \u50640  \u47196 \u47560 \u51032  \u48156 \u51088 \u52712 \u47484  \u46384 \u47476 \u44172  \u46112  \u44163 \u51060 \u45796 .\
\uc0\u44053 \u49888 \u49696 \u51060  \u50724 \u45720 \u45216 \u51032  \u50976 \u47749 \u47924 \u49892 \u54620  \u44536 \u47532 \u49828 \u46020 \u44368 \u47484  \u45908 \u50865  \u51096  \u47784 \u48169 \u54616 \u47732  \u54624 \u49688 \u47197  \u44536 \u45716  \u45908 \u50865  \u53360  \u44592 \u47564 \u44284  \u50976 \u54841 \u51032  \u49464 \u47141 \u51012  \u44054 \u44172  \u46108 \u45796 . \u49324 \u45800 \u51008  \u54788 \u45824 \u51032  \u44048 \u44033 \u50640  \u47582 \u52628 \u50612 \u49436  \u49828 \u49828 \u47196  \u48320 \u51109 \u54620 \u45796 . \u44536 \u45716  \u48731 \u45208 \u45716  \u52380 \u49324 \u51032  \u47784 \u50577 \u51004 \u47196  \u45208 \u53440 \u45216  \u44163 \u51060 \u45796 . \u44053 \u49888 \u49696 \u51032  \u47588 \u44060 \u52404 \u47484  \u53685 \u54616 \u50668  \u51060 \u51201 \u46308 \u51060  \u54665 \u54644 \u51648 \u44256  \u48337  \u44256 \u52840 \u51012  \u48155 \u44172  \u46104 \u44256  \u48512 \u51064 \u54624  \u49688  \u50630 \u45716  \u47566 \u51008  \u44592 \u49324 \u46308 \u51060  \u45208 \u53440 \u45216  \u44163 \u51060 \u45796 . \u44536 \u47532 \u44256  \u44536  \u50689 \u46308 \u51008  \u49457 \u44221 \u51012  \u48127 \u45716  \u44536 \u46308 \u51032  \u48127 \u51020 \u51012  \u44256 \u48177 \u54616 \u44256  \u44368 \u54924 \u51032  \u51228 \u46020 \u46308 \u50640  \u45824 \u54620  \u51316 \u51473 \u49900 \u51012  \u54364 \u47749 \u54624  \u44163 \u51060 \u48064 \u47196  \u44536 \u46308 \u51032  \u54876 \u46041 \u51008  \u47560 \u52824  \u54616 \u45208 \u45784 \u51032  \u45733 \u47141 \u51032  \u54364 \u54788 \u52376 \u47100  \u51064 \u51221 \u46112  \u44163 \u51060 \u45796 .\
\uc0\u50724 \u45720 \u45216 \u51032  \u49548 \u50948  \u44536 \u47532 \u49828 \u46020 \u51064 \u51060 \u46972 \u44256  \u44277 \u50616 \u54616 \u45716  \u51088 \u46308 \u44284  \u48520 \u49888 \u51088 \u46308 \u44284 \u51032  \u54620 \u44228 \u47484  \u44144 \u51032  \u44396 \u48324 \u54624  \u49688  \u50630 \u44172  \u46104 \u50612  \u51080 \u45796 . \u44368 \u54924 \u51032  \u44368 \u51064 \u46308 \u51008  \u49464 \u49345  \u49324 \u46988 \u46308 \u51060  \u49324 \u46993 \u54616 \u45716  \u44163 \u51012  \u49324 \u46993 \u54616 \u44256  \u51080 \u44256  \u44536 \u46308 \u44284  \u50672 \u54633 \u54616 \u44256 \u51088  \u54620 \u45796 . \u44536 \u47084 \u48064 \u47196  \u49324 \u45800 \u51008  \u44536 \u46308 \u51012  \u54616 \u45208 \u51032  \u45800 \u52404 \u47196  \u50672 \u54633 \u49884 \u53020  \u44053 \u49888 \u49696 \u51032  \u45824 \u50676 \u50640  \u50424 \u50612  \u45347 \u51020 \u51004 \u47196 \u50024  \u44536 \u51032  \u49324 \u50629 \u51012  \u44053 \u54868 \u49884 \u53412 \u44256 \u51088  \u44208 \u49900 \u54616 \u44256  \u51080 \u45796 . \u51060 \u51201 \u51060  \u52280  \u44368 \u54924 \u51032  \u48516 \u47749 \u54620  \u54364 \u46972 \u44256  \u51088 \u46993 \u54616 \u45716  \u48277 \u50773 \u44368 \u46020 \u46308 \u51008  \u51060 \u51201 \u51012  \u54665 \u54616 \u45716  \u51060  \u45733 \u47141 \u50640  \u49789 \u44172  \u44592 \u47564 \u45817 \u54624  \u44163 \u51060 \u47728  \u51652 \u47532 \u51032  \u48169 \u54056 \u47484  \u48260 \u47536  \u44060 \u49888 \u44368 \u46020 \u46308  \u50669 \u49884  \u48120 \u54841 \u45817 \u54624  \u44163 \u51060 \u45796 . \u48277 \u50773  \u44368 \u46020 \u46308 \u44284  \u44060 \u49888 \u44368 \u46020 \u46308 \u44284  \u49464 \u49549 \u51064 \u46308 \u51008  \u54620 \u44208 \u44057 \u51060  \u44221 \u44148 \u51032  \u45733 \u51008  \u48260 \u47532 \u44256  \u44221 \u44148 \u51032  \u47784 \u50577 \u47564  \u48155 \u50500 \u46308 \u51068  \u44163 \u51060 \u45796 . \u44536 \u46308 \u51008  \u51060  \u50672 \u546