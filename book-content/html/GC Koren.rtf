\f1\b0 \cf0 \
\uc0\u50956 \u47532 \u50628  \u48128 \u47084 \u45716  \u49324 \u49353  (\u24605 \u32034 ) \u44284  \u50672 \u44396 \u47196  \u45798 \u51008  \u44053 \u54620  \u51221 \u49888 \u47141 \u51012  \u49548 \u50976 \u54616 \u44256  \u51080 \u50632 \u45796 . \u44536 \u47532 \u44256  \u44536 \u45716  \u51648 \u54812 \u51032  \u44540 \u50896 \u51060 \u49888  \u54616 \u45208 \u45784 \u44284  \u50672 \u54633 \u54632 \u51004 \u47196  \u54616 \u45720 \u51032  \u51648 \u54812 \u47484  \u48155 \u51008  \u49324 \u46988 \u51060 \u50632 \u45796 . \u44536 \u45716  \u49888 \u51076  \u48155 \u51012  \u47564 \u54620  \u51064 \u47932 \u47196 \u49436  \u45572 \u44396 \u45208  \u44536 \u47484  \u44256 \u44208 \u54620  \u51064 \u44201 \u51012  \u44054 \u52632  \u45909 \u49457 \u51060  \u45458 \u51008  \u49324 \u46988 \u51060 \u46972 \u44256  \u48372 \u51648  \u50506 \u51012  \u49688  \u50630 \u50632 \u45796 . \u47560 \u51020 \u50640 \u49436  \u50864 \u47084 \u45208 \u50724 \u45716  \u52280 \u46108  \u52828 \u51208 \u44284  \u44536 \u47532 \u49828 \u46020 \u51064  \u44216 \u49552 \u51012  \u44032 \u51276 \u51012  \u49104  \u50500 \u45768 \u46972  \u51088 \u51228 \u47141 \u51060  \u54413 \u48512 \u54616 \u50688 \u51004 \u48064 \u47196 , \u44536 \u45716  \u45572 \u44396 \u50640 \u44172 \u45208  \u51008 \u44540 \u54616 \u44256  \u50896 \u47564 \u54616 \u47728  \u45796 \u47480  \u51060 \u46308 \u51032  \u51032 \u44204 \u50640  \u44480 \u47484  \u44592 \u50872 \u51060 \u44256 , \u44536 \u46308 \u51032  \u51060 \u47200 \u51012  \u51316 \u51473 \u55176  \u50668 \u44592 \u44256 \u51088  \u54616 \u45716  \u49324 \u46988 \u51060 \u50632 \u45796 . \u44536 \u45716  \u44048 \u51221 \u51060 \u45208  \u55141 \u48516 \u50640  \u51340 \u50864 \u46104 \u51648  \u50506 \u44256  \u47784 \u46304  \u51060 \u47200 \u44284  \u44368 \u47532 \u47484  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51004 \u47196  \u49884 \u54744 \u54616 \u50688 \u45796 . \u44536 \u51032  \u44148 \u51204 \u54620  \u52628 \u47532 \u47141  (\u25512 \u29702 \u21147 ) \u44284  \u54644 \u48149 \u54620  \u49457 \u44221  \u51648 \u49885 \u51008  \u50724 \u47448  (\u35492 \u35628 ) \u47484  \u45436 \u54028  (\u63809 \u30772 ) \u54616 \u44256  \u44144 \u51667  \u44163 \u51012  \u46300 \u47084 \u45236 \u50632 \u45796 .\
\uc0\u44536 \u47084 \u45208  \u50956 \u47532 \u50628  \u48128 \u47084 \u45716  \u49900 \u54620  \u48152 \u45824 \u47484  \u45817 \u54616 \u47732 \u49436  \u44536 \u51032  \u49324 \u50629 \u51012  \u52628 \u51652 \u54616 \u50688 \u45796 . \u52488 \u44592 \u51032  \u44060 \u54785 \u51088 \u46308 \u44284  \u47560 \u52268 \u44032 \u51648 \u47196 , \u44536 \u44032  \u51228 \u49884 \u54620  \u51652 \u47532 \u45716  \u51068 \u48152  \u44368 \u51649 \u51088 \u46308 \u50640 \u44172  \u54872 \u50689 \u51012  \u48155 \u51648  \u47803 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u44536 \u46308 \u51032  \u51077 \u51109 \u51012  \u49457 \u44221 \u51004 \u47196  \u46263 \u48155 \u52840 \u54624  \u49688  \u50630 \u50632 \u51004 \u48064 \u47196 , \u51312 \u49345 \u46308 \u51032  \u51204 \u53685 \u44284  \u49324 \u46988 \u51032  \u44368 \u54984 \u50640  \u44540 \u44144 \u47484  \u46160 \u50632 \u45796 . \u44536 \u47084 \u45208  \u51116 \u47548 \u51032  \u51652 \u47532 \u47484  \u49440 \u54252 \u54616 \u45716  \u49324 \u46988 \u46308 \u51060  \u51064 \u51221 \u54624  \u50976 \u51068 \u51032  \u51613 \u44144 \u45716  \u45796 \u47564  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51060 \u50632 \u45796 . \'93\u49457 \u44221 , \u50724 \u51649  \u49457 \u44221 \'94\u51060 \u46972 \u45716  \u47568 \u51060  \u44536 \u46308 \u51032  \u44396 \u54840  (\u21475 \u34399 ) \u50688 \u45796 . \u48152 \u45824 \u51088 \u46308 \u51008  \u49457 \u44221 \u51012  \u44540 \u44144 \u47196  \u45436 \u51137 \u54624  \u49688  \u50630 \u50632 \u51004 \u48064 \u47196  \u51312 \u49548 \u50752  \u47784 \u47736 \u51201  \u53468 \u46020 \u47484  \u52712 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u50724 \u51649  \u51452 \u51032  \u51116 \u47548 \u51012  \u44592 \u45796 \u47532 \u44256 , \u44144 \u47337 \u54620  \u49373 \u50528 \u47484  \u49332 \u44256 \u51088  \u45432 \u47141 \u54616 \u44256 , \u45796 \u47480  \u49324 \u46988 \u46308 \u50640 \u44172  \u51452 \u45784 \u51032  \u45796 \u49884  \u50724 \u49900 \u51012  \u50948 \u54616 \u50668  \u51456 \u48708 \u54616 \u46972 \u44256  \u44428 \u47732 \u54616 \u45716  \u49324 \u46988 \u46308 \u50640 \u44172  \u50501 \u51032 \u47484  \u45208 \u53440 \u45236 \u45716  \u51068 \u50640  \u49884 \u44036 \u44284  \u44552 \u51204 \u44284  \u51116 \u45733 \u51012  \u45796  \u48148 \u52452 \u45796 .\
\uc0\u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u51012  \u51116 \u47548 \u51032  \u47928 \u51228 \u50640 \u49436  \u45796 \u47480  \u45936 \u47196  \u46028 \u47532 \u44256 \u51088  \u54616 \u45716  \u45432 \u47141 \u51060  \u50676 \u47148 \u54644 \u51276 \u45796 . \u47560 \u52824  \u44536 \u47532 \u49828 \u46020 \u51032  \u51116 \u47548 \u44284  \u49464 \u49345  \u45149 \u50640  \u44288 \u54620  \u50696 \u50616 \u51012  \u50672 \u44396 \u54616 \u45716  \u44163 \u51060  \u47924 \u49832  \u51396 \u45208  \u49688 \u52824 \u49828 \u47084 \u50868  \u51068 \u51060 \u45208  \u46104 \u45716  \u46319 \u51060  \u49373 \u44033 \u54616 \u44172  \u46104 \u50632 \u45796 . \u44536 \u47532 \u54616 \u50668  \u51068 \u48152  \u47785 \u49324 \u46308 \u51008  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u50640  \u45824 \u54620  \u48127 \u51020 \u51012  \u55036 \u49552 \u49884 \u53040 \u45796 . \u44536 \u46308 \u51032  \u44032 \u47476 \u52840 \u51008  \u49324 \u46988 \u46308 \u51012  \u48127 \u51020 \u51060  \u50630 \u45716  \u49324 \u46988 \u51004 \u47196  \u47564 \u46308 \u50612 \u48260 \u47160 \u51004 \u48064 \u47196  \u47566 \u51008  \u49324 \u46988 \u46308 \u51060  \u44536 \u46308 \u51032  \u51221 \u50837 \u45824 \u47196  \u48169 \u51333 \u54616 \u44172  \u46104 \u50632 \u45796 . \u44536 \u47084 \u51088  \u50501 \u51032  \u52285 \u49884 \u51088 \u46308 \u51008  \u44536  \u54788 \u49345 \u51012  \u47784 \u46160  \u51116 \u47548  \u49888 \u46020 \u46308 \u51032  \u49548 \u54665 \u51060 \u46972 \u44256  \u48708 \u45212 \u54616 \u50688 \u45796 .\
\uc0\u46020 \u52376 \u50640 \u49436  \u52509 \u47749 \u54616 \u44256  \u48124 \u44048 \u54620  \u47566 \u51008  \u52397 \u51473 \u46308 \u47196  \u51665 \u54924  \u51109 \u49548 \u46308 \u51008  \u48708 \u51329 \u50520 \u51648 \u47560 \u45716  \u51312 \u49548 \u50752  \u48708 \u45212 \u51032  \u51116 \u47308 \u47196  \u49324 \u50857 \u46104 \u45716  \u50808 \u50640 \u45716  \u48128 \u47084 \u51032  \u51060 \u47492 \u51060  \u51333 \u44368  \u51105 \u51648 \u50640  \u44172 \u51116 \u46104 \u45716  \u51068 \u51008  \u44144 \u51032  \u50630 \u50632 \u45796 . \u44221 \u48149 \u54616 \u44256  \u48520 \u44221 \u44148 \u54620  \u47924 \u47532 \u46308 \u51008  \u44536 \u46308 \u51060  \u44032 \u51652  \u51333 \u44368  \u51648 \u46020 \u51088 \u46972 \u45716  \u51648 \u50948 \u47484  \u48729 \u51088 \u54616 \u50668  \u47924 \u47168 \u54620  \u48324 \u47749 \u44284  \u48708 \u50676 \u54616 \u44256  \u47784 \u46021 \u51201 \u51064  \u50556 \u50976  (\u25590 \u25540 ) \u47484  \u50024 \u49436  \u48128 \u47084 \u50752  \u44536 \u51032  \u49324 \u50629 \u51012  \u50668 \u51648 \u50630 \u51060  \u47784 \u50837 \u54616 \u50688 \u45796 . \u50504 \u46973 \u54620  \u44032 \u51221 \u51012  \u46496 \u45208  \u51088 \u48708  (\u33258 \u36027 ) \u47196  \u51060  \u46020 \u49884 \u50640 \u49436  \u51200  \u46020 \u49884 \u47196 , \u51060  \u47560 \u51012 \u50640 \u49436  \u51200  \u47560 \u51012 \u47196  \u49780  \u49352  \u50630 \u51060  \u45796 \u45768 \u47732 \u49436  \u49688 \u44256 \u47484  \u47924 \u47493 \u50416 \u44256  \u49900 \u54032 \u51060  \u51208 \u48149 \u54616 \u50688 \u45796 \u45716  \u50628 \u49689 \u54620  \u44221 \u44256 \u47484  \u54616 \u44256  \u51080 \u45716  \u48177 \u48156 \u51060  \u45796  \u46108  \u44536  \u49324 \u46988 \u51012  \u46020 \u47532 \u50612  \u44305 \u49888 \u51088 , \u44144 \u51667 \u47568 \u51137 \u51060 , \u45824  \u49324 \u44592 \u54620  (\u22823 \u35408 \u27450 \u28450 ) \u51060 \u46972 \u44256  \u48708 \u45212 \u54616 \u50688 \u45796 .\
\uc0\u44536 \u50640 \u44172  \u50444 \u50868  \u51312 \u49548 , \u47924 \u44256 , \u50837 \u49444 \u51060  \u45320 \u47924  \u49900 \u54664 \u44592  \u46412 \u47928 \u50640  \u49900 \u51648 \u50612  \u49464 \u49345 \u51032  \u49888 \u47928 \u44620 \u51648  \u48516 \u44060 \u54616 \u50668  \u54637 \u51032 \u54616 \u50688 \u45796 . \u49464 \u49345  \u49324 \u46988 \u46308 \u51008  \'93\u44536 \u47111 \u44172  \u50628 \u49689 \u54616 \u44256  \u46160 \u47140 \u50868  \u44208 \u44284 \'94\u50640  \u45824 \u54620  \u47928 \u51228 \u47484  \u44221 \u49556 \u54616 \u44256  \u48520 \u44221 \u44148 \u54620  \u47568 \u47196  \u51025 \u45824 \u54616 \u45716  \u44163 \u51008  \'93\u45796 \u47564  \u44536  \u44592 \u48324 \u51012  \u51204 \u54616 \u45716  \u51088 \u50752  \u51452 \u51109 \u54616 \u45716  \u51088 \u51032  \u44048 \u51221 \u51012  \u44144 \u49828 \u47476 \u45716  \u51068 \u51060  \u46112  \u49104  \u50500 \u45768 \u46972  \u49900 \u54032 \u51032  \u45216 \u51012  \u51312 \u49548 \u54616 \u44256  \u54616 \u45208 \u45784  \u51088 \u49888 \u51012  \u51312 \u47217 \u54616 \u47728  \u44536  \u49900 \u54032 \u51221  (\u23529 \u21028 \u24311 ) \u51032  \u46160 \u47140 \u50880 \u51012  \u44221 \u47736 \u55176  \u50668 \u44592 \u45716  \u44163 \u51060 \u46972 \'94 (Bliss, p.183) \u44256  \u47568 \u54616 \u50688 \u45796 .\
