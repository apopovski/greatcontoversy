\uc0\u47196 \u47560 \u44368 \u44032  \u44397 \u51221 \u50640  \u44060 \u51077 \u54616 \u44592  \u50948 \u54616 \u50668  \u45733 \u49689 \u54616 \u44256  \u44984 \u51456 \u54620  \u45432 \u47141 \u51012  \u54644 \u50728  \u49324 \u49892 \u51008  \u50669 \u49324 \u44032  \u51613 \u44144 \u54616 \u44256  \u51080 \u51004 \u47728 , \u44536 \u47532 \u44256  \u51068 \u45800  \u48156 \u54032 \u51012  \u50619 \u44172  \u46104 \u47732  \u44400 \u51452 \u46308 \u44284  \u44397 \u48124 \u51012  \u47736 \u47581 \u50640  \u48736 \u46888 \u47532 \u45716  \u54620 \u51060  \u51080 \u45908 \u46972 \u46020  \u44536 \u46308 \u51032  \u47785 \u51201 \u51012  \u44288 \u52384 \u49884 \u53412 \u44256 \u51088  \u48128 \u44256  \u45208 \u44036 \u45796 . 1204\u45380 \u50640  \u48277 \u50773  \u51064 \u45432 \u49468 \u53944  3\u49464 \u45716  \u49828 \u54168 \u51064 \u51032  \u50500 \u46972 \u44260  \u50773  \u48288 \u46300 \u47196  2\u49464 \u50640 \u44172  \u45796 \u51020 \u44284  \u44057 \u51008  \u53945 \u48324 \u54620  \u49440 \u49436 \u47484  \u49884 \u53040 \u45796 . \'93\u45208 , \u50500 \u46972 \u44260  \u50773  \u48288 \u46300 \u47196  2\u49464 \u45716  \u45236  \u51452  \u51064 \u45432 \u49468 \u53944  \u48277 \u50773 \u44284  \u44536 \u51032  \u52380 \u51452 \u44368  \u54980 \u44228 \u51088 \u46308 \u44284  \u47196 \u47560  \u44368 \u54924 \u50640  \u50616 \u51228 \u45208  \u52649 \u49457 \u54616 \u44256  \u49692 \u51333 \u54616 \u47728  \u46608 \u54620  \u44536 \u51032  \u47749 \u47161 \u45824 \u47196  \u50864 \u47532 \u45208 \u46972 \u47484  \u50976 \u51648 \u54616 \u44256  \u52380 \u51452 \u44368 \u51032  \u49888 \u50521 \u51012  \u50745 \u54840 \u54616 \u47728  \u51060 \u45800 \u51201  \u53440 \u46973 \u51032  \u47924 \u47532 \u47484  \u48149 \u54644 \u54624  \u44163 \u51012  \u44277 \u50616 \u54616 \u47728  \u49436 \u50557 \u54633 \u45768 \u45796 \'94 (John Dowling, The History of Romanism, b.5, ch.6 sec.). \u51060  \u47568 \u51008  \u47196 \u47560  \u48277 \u50773 \u51032  \u