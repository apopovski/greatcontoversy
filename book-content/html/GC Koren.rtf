\f1\b0 \cf0 \
\uc0\u47196 \u47560 \u51032  \u44288 \u54624  \u48150 \u50640  \u51080 \u45716  \u45208 \u46972 \u46308 \u50640 \u45716  \u50668 \u47084  \u49464 \u44592  \u46041 \u50504  \u48277 \u50773 \u44368 \u51032  \u48512 \u54056 \u50640  \u51204 \u54784  \u44048 \u50684 \u46104 \u51648  \u50500 \u45768 \u54620  \u44536 \u47532 \u49828 \u46020 \u51064  \u45800 \u52404 \u46308 \u51060  \u51080 \u50632 \u45796 . \u44536 \u46308 \u51008  \u51060 \u44368 \u46020 \u46308 \u50640 \u44172  \u46168 \u47084 \u49912 \u50668  \u51080 \u50632 \u51004 \u48064 \u47196  \u49884 \u44036 \u51060  \u51648 \u45208 \u44048 \u50640  \u46384 \u46972  \u44536 \u47084 \u54620  \u50724 \u47448 \u51032  \u50689 \u54693 \u51012  \u48155 \u50520 \u45796 . \u44536 \u47084 \u45208  \u44536 \u46308 \u51008  \u49457 \u44221 \u51012  \u49888 \u50521 \u51032  \u50976 \u51068 \u54620  \u54364 \u51456 \u51004 \u47196  \u49373 \u44033 \u54616 \u44256  \u49457 \u44221 \u50640  \u51080 \u45716  \u51652 \u47532 \u51032  \u45824 \u48512 \u48516 \u51012  \u44256 \u49688 \u54644  \u50772 \u45796 . \u44536 \u46308 \u51008  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51032  \u48520 \u48320 \u49457 \u51012  \u48127 \u44256  \u49901 \u44228 \u47749  \u51473 \u51032  \u45367 \u51704  \u44228 \u47749 \u51032  \u50504 \u49885 \u51068 \u51012  \u51648 \u53040 \u45796 . \u51060 \u47084 \u54620  \u48127 \u51020 \u44284  \u49373 \u54876 \u51012  \u50976 \u51648 \u54644  \u50728  \u44368 \u54924 \u46308 \u51060  \u51473 \u50521 \u50500 \u54532 \u47532 \u52852 \u50752  \u50500 \u49884 \u50500 \u51032  \u50500 \u47476 \u47700 \u45768 \u50500  \u51313 \u49549 \u46308  \u49324 \u51060 \u50640 \u46020  \u51080 \u50632 \u45796 .\
\uc0\u48277 \u50773 \u44428 \u51032  \u52840 \u51077 \u51012  \u51200 \u54637 \u54620  \u51088 \u46308  \u51473 \u50640 \u49436  \'93\u50760 \u45940 \u49828 \'94 (Waldenses) \u51064 \u46308 \u51060  \u52572 \u49440 \u48393 \u50640  \u49456 \u45796 . \u44536 \u46308 \u51008  \u48277 \u50773 \u51032  \u51648 \u50948 \u44032  \u54869 \u47549 \u46104 \u50612  \u51080 \u45716  \u48148 \u47196  \u44536  \u45208 \u46972 \u50640  \u49332 \u47732 \u49436 \u46020  \u44536  \u54728 \u50948 \u50752  \u48512 \u54056 \u50640  \u45003 \u45003 \u51060  \u51200 \u54637 \u54616 \u50688 \u45796 . \u49688 \u49464 \u44592  \u46041 \u50504 \u50640  \u54588 \u50640 \u47805  (Piedmonte) \u51032  \u44368 \u54924 \u46308 \u51008  \u46021 \u47549 \u51012  \u50976 \u51648 \u54644  \u50772 \u51004 \u45208  \u47560 \u52840 \u45236  \u47196 \u47560 \u44032  \u44536 \u46308 \u50640 \u44172  \u48373 \u51333 \u51012  \u44053 \u50836 \u54624  \u46412 \u44032  \u45796 \u44032 \u50772 \u45796 . \u47196 \u47560 \u51032  \u50517 \u51228 \u50640  \u45824 \u54616 \u50668  \u47924 \u47141 \u54620  \u51200 \u54637 \u51012  \u54644 \u48376  \u54980 \u50640  \u47560 \u52840 \u45236  \u44536  \u50668 \u47084  \u44368 \u54924 \u51032  \u51648 \u46020 \u51088 \u46308 \u51008  \u44144 \u51032  \u50728  \u49464 \u44228 \u44032  \u51316 \u51473 \u54616 \u45716  \u46319 \u54620  \u48277 \u50773 \u51032  \u52572 \u49345 \u44428 \u51012  \u47560 \u51648 \u47803 \u54644  \u51064 \u51221 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u51068 \u48512 \u51032  \u49324 \u46988 \u46308 \u51008  \u48277 \u50773 \u44284  \u51452 \u44368 \u51032  \u44428 \u50948 \u50640  \u44404 \u48373 \u54616 \u51648  \u50506 \u50520 \u45796 . \u44536 \u46308 \u51008  \u54616 \u45208 \u45784 \u44760  \u52649 \u49457 \u51012  \u45796 \u54616 \u44256  \u44536 \u46308 \u51032  \u48127 \u51020 \u51032  \u49692 \u44208 \u51012  \u44536 \u45824 \u47196  \u48372 \u51316 \u54616 \u44256 \u51088  \u44208 \u49900 \u54616 \u50688 \u45796 . \u47560 \u52840 \u45236  \u44536 \u46308 \u51008  \u49436 \u47196  \u44040 \u46972 \u51276 \u45796 . \u50668 \u51204 \u55176  \u44284 \u44144 \u51032  \u48127 \u51020 \u51012  \u44403 \u44172  \u51648 \u53412 \u45716  \u49324 \u46988 \u46308  \u51473 \u51032  \u50612 \u46500  \u51060 \u46308 \u51008  \u51060 \u51228  \u44256 \u54693 \u51064  \u50508 \u54532 \u49828 \u47484  \u46244 \u50640  \u46160 \u44256  \u50808 \u44397 \u51004 \u47196  \u44032 \u49436  \u51652 \u47532 \u51032  \u44611 \u48156 \u51012  \u44866 \u44172  \u46104 \u50632 \u51004 \u47728 , \u50612 \u46500  \u51060 \u46308 \u51008  \u44618 \u51008  \u49328 \u44264 \u51676 \u44592 \u45208  \u54744 \u51456 \u54620  \u49328  \u49549 \u51004 \u47196  \u54588 \u54644  \u44032 \u49436  \u44144 \u44592 \u49436  \u51088 \u50976 \u47196 \u51060  \u54616 \u45208 \u45784 \u51012  \u44221 \u48176 \u54616 \u50688 \u45796 .\
\'93\uc0\u50760 \u45940 \u49828 \'94 \u44368 \u46020 \u46308 \u51060  \u47751  \u49464 \u44592  \u46041 \u50504  \u44032 \u47476 \u52432  \u50728  \u49888 \u50521 \u51008  \u47196 \u47560 \u47196 \u48512 \u53552  \u45208 \u50728  \u54728 \u50948 \u51032  \u44368 \u47532 \u50752  \u54788 \u51200 \u54620  \u45824 \u51312 \u47484  \u51060 \u47336 \u50632 \u45796 . \u44536 \u46308 \u51032  \u51333 \u44368 \u51201  \u49888 \u51312 \u45716  \u44592 \u47197 \u46108  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432  \u51593  \u44536 \u47532 \u49828 \u46020 \u51064 \u51032  \u52280  \u51228 \u46020 \u50640  \u44592 \u52488 \u46104 \u50632 \u45796 . \u49464 \u49345 \u44284  \u52264 \u45800 \u46108  \u44417 \u48317 \u54620  \u44275 \u50640 \u49436  \u45216 \u47560 \u45796  \u50577 \u46524 \u47484  \u52824 \u47728  \u54252 \u46020 \u50896 \u51012  \u44032 \u44984 \u45716  \u47588 \u51068 \u51032  \u44256 \u50669 \u50640  \u49884 \u45804 \u47532 \u44256  \u51080 \u45716  \u48708 \u52380 \u54620  \u44536  \u45453 \u48512 \u46308 \u51008  \u48176 \u44368 \u54620  \u44368 \u54924 \u51032  \u44368 \u47532 \u50752  \u51060 \u49444  (\u30064 \u35373 ) \u50640  \u48152 \u45824 \u46104 \u45716  \u51652 \u47532 \u47484  \u51088 \u44592 \u46308  \u49828 \u49828 \u47196 \u44032  \u48156 \u44204 \u54620  \u44163 \u51060  \u50500 \u45768 \u50632 \u45796 . \u44536 \u46308 \u51032  \u48127 \u51020 \u51008  \u49352 \u47213 \u44172  \u48155 \u51008  \u48127 \u51020 \u51060  \u50500 \u45768 \u50632 \u45796 . \u44536 \u46308 \u51032  \u51333 \u44368 \u51201  \u49888 \u51312 \u45716  \u44536 \u46308 \u51032  \u49440 \u51312 \u47196 \u48512 \u53552  \u47932 \u47140 \u48155 \u51008  \u44163 \u51060 \u50632 \u45796 . \u44536 \u46308 \u51008  \u49324 \u46020  \u44368 \u54924 \u51032  \u49888 \u50521  \u44263  \'93\u49457 \u46020 \u50640 \u44172  \u45800 \u48264 \u50640  \u51452 \u49888  \u48127 \u51020 \u51032  \u46020 \'94 (\u50976  3) \u47196 \u50024  \u47564 \u51313 \u54616 \u50688 \u45796 . \u49464 \u44228 \u51032  \u45824 \u46020 \u49884 \u50640  \u44144 \u47564 \u54616 \u44172  \u51088 \u47532 \u51105 \u44256  \u51080 \u45716  \u44368 \u44428  \u44368 \u54924 \u44032  \u50500 \u45772  \u51060  \'93\u44305 \u50556  \u44368 \u54924 \'94\u45716  \u54616 \u45208 \u45784 \u44760 \u49436  \u50728  \u49464 \u49345 \u50640  \u45208 \u45572 \u50612  \u51452 \u46972 \u44256  \u45817 \u49888 \u51032  \u48177 \u49457 \u50640 \u44172  \u47585 \u44592 \u49888  \u51652 \u47532 \u51032  \u48372 \u54868  (\u23542 \u36008 ) \u47484  \u51096  \u44036 \u49688 \u54616 \u44256  \u51080 \u45912  \u44536 \u47532 \u49828 \u46020 \u51032  \u52280  \u44368 \u54924 \u50688 \u45796 .\
\uc0\u52280 \u46108  \u44368 \u54924 \u44032  \u47196 \u47560 \u44368 \u47196 \u48512 \u53552  \u48516 \u47532 \u46108  \u51452 \u50836 \u54620  \u51060 \u50976 \u51032  \u54616 \u45208 \u45716  \u49457 \u44221 \u49345  \u50504 \u49885 \u51068 \u50640  \u45824 \u54620  \u47196 \u47560 \u44368 \u51032  \u51613 \u50724 \u44048  \u46412 \u47928 \u51060 \u50632 \u45796 . \u50696 \u50616 \u50640  \u44592 \u47197 \u46108  \u48148 \u50752  \u44057 \u51060  \u48277 \u50773 \u44428 \u51008  \u51652 \u47532 \u47484  \u46405 \u50640  \u45236 \u50612  \u45912 \u51276 \u45796 . \u49324 \u46988 \u51032  \u50976 \u51204 \u44284  \u44288 \u49845 \u51060  \u45458 \u51076 \u51012  \u48155 \u45716  \u48152 \u47732 \u50640  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51008  \u51667 \u48159 \u55192 \u51012  \u45817 \u54664 \u45796 . \u48277 \u50773 \u44428 \u51032  \u51648 \u48176  \u50500 \u47000  \u49549 \u54620  \u44368 \u54924 \u46308 \u51008  \u52488 \u44592 \u48512 \u53552  \u51068 \u50836 \u51068 \u51012  \u44144 \u47337 \u54620  \u45216 \u47196  \u51316 \u51473 \u54616 \u46020 \u47197  \u44053 \u50836 \u46104 \u50632 \u45796 . \u50724 \u47448  (\u35492 \u35628 ) \u50752  \u48120 \u49888 \u51060  \u49457 \u54665 \u54616 \u45716  \u51473 \u50640  \u47566 \u51008  \u49324 \u46988 \u46308 , \u49900 \u51648 \u50612  \u51652 \u49892 \u54620  \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u46308 \u44620 \u51648 \u46020  \u50612 \u52236 \u54624  \u48148 \u47484  \u47784 \u47476 \u44256  \u50504 \u49885 \u51068 \u51012  \u51456 \u49688 \u54616 \u45716  \u54620 \u54200  \u51068 \u50836 \u51068 \u50640  \u51068 \u51012  \u49772 \u50632 \u45796 . \u44536 \u47084 \u45208  \u48277 \u50773 \u44368 \u51032  \u51648 \u46020 \u51088 \u46308 \u51008  \u51060 \u44163 \u51004 \u47196  \u47564 \u51313 \u54616 \u51648  \u50500 \u45768 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u51068 \u50836 \u51068 \u51012  \u44144 \u47337 \u55176  \u50668 \u44592 \u44256  \u50504 \u49885 \u51068 \u51012  \u45908 \u47101 \u55176 \u46020 \u47197  \u44053 \u50836 \u54616 \u50688 \u45796 . \u44536 \u47532 \u44256  \u50504 \u49885 \u51068 \u51012  \u44144 \u47337 \u54616 \u44172  \u51648 \u53412 \u44256 \u51088  \u54616 \u45716  \u49324 \u46988 \u46308 \u51012  \u50500 \u51452  \u44284 \u44201 \u54620  \u47568 \u47196  \u48708 \u45212 \u54616 \u50688 \u45796 . \u44536 \u47084 \u48064 \u47196  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51012  \u54200 \u50504 \u54616 \u44172  \u51648 \u53420  \u49688  \u51080 \u45716  \u50976 \u51068 \u54620  \u44600 \u51008  \u47196 \u47560 \u51032  \u49464 \u47141 \u44428  \u48150 \u51004 \u47196  \u46020 \u47581 \u54644  \u45208 \u44032 \u45716  \u44600 \u48150 \u50640  \u50630 \u50632 \u45796 .\
