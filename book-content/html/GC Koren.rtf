\uc0\u49324 \u45800 \u51008  \u50724 \u47448 \u50752  \u51060 \u45800 \u44284  \u48120 \u49888 \u51032  \u50416 \u47112 \u44592  \u50500 \u47000  \u51652 \u47532 \u51032  \u47568 \u50432 \u51012  \u47931 \u50612  \u48260 \u47532 \u44592  \u50948 \u54616 \u50668  \u48277 \u50773 \u44368 \u51032  \u49849 \u47140 \u50752  \u51452 \u44368 \u46308 \u51012  \u46021 \u47140 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u50516 \u55121 \u49884 \u45824 \u51032  \u51204  \u44592 \u44036 \u51012  \u53685 \u54616 \u50668  \u49457 \u44221 \u51008  \u44032 \u51109  \u44592 \u51060 \u54620  \u48169 \u48277 \u51004 \u47196  \u49552 \u49345 \u46104 \u51648  \u50506 \u51008  \u52292 \u47196  \u48372 \u51204 \u46104 \u50632 \u45796 . \u49457 \u44221 \u51008  \u49324 \u46988 \u51032  \u51064 \u51012  \u47582 \u51008  \u44163 \u51060  \u50500 \u45768 \u46972  \u54616 \u45208 \u45784 \u51032  \u51064 \u51012  \u47582 \u50520 \u45796 . \u49324 \u46988 \u46308 \u51008  \u49457 \u44221 \u51032  \u47749 \u48177 \u54616 \u44256  \u54869 \u49892 \u54620  \u51032 \u48120 \u47484  \u55120 \u47140  \u48260 \u47532 \u44592  \u50948 \u54616 \u50668  \u49457 \u44221  \u51088 \u52404 \u51032  \u51613 \u44144 \u46308 \u51012  \u49436 \u47196  \u47784 \u49692 \u46104 \u45716  \u44163 \u52376 \u47100  \u48372 \u51060 \u44256 \u51088  \u45130 \u51076 \u50630 \u51060  \u45432 \u47141 \u54644  \u50772 \u45796 . \u44536 \u47084 \u45208  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51008  \u53360  \u54028 \u46020 \u51032  \u44618 \u51008  \u47932  \u49549 \u50640  \u46892  \u48169 \u51452 \u52376 \u47100  \u44536 \u47484  \u54028 \u47736 \u49884 \u53412 \u44256 \u51088  \u54616 \u45716  \u54253 \u54413 \u51012  \u54756 \u52824 \u44256  \u45208 \u50500 \u44052 \u45796 . \u47560 \u52824  \u44552 \u44284  \u44057 \u51008  \u54413 \u48512 \u54620  \u44305 \u47589 \u46308 \u51060  \u46405 \u49549 \u50640  \u49704 \u44200 \u51256  \u51080 \u51012  \u46412  \u44536  \u44480 \u51473 \u54620  \u44305 \u49437 \u46308 \u51012  \u54028 \u45236 \u50556  \u54616 \u45716  \u44163 \u52376 \u47100  \u49457 \u44221 \u46020  \u50676 \u49900  \u51080 \u44256  \u44216 \u49552 \u54616 \u44256  \u44221 \u44148 \u54620  \u47560 \u51020 \u51004 \u47196  \u52286 \u45716  \u51088 \u50640 \u44172 \u47564  \u45208 \u53440 \u45208 \u45716  \u51652 \u47532 \u51032  \u48372 \u48176 \u47484  \u44032 \u51648 \u44256  \u51080 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u49457 \u44221 \u51012  \u47784 \u46304  \u49324 \u46988 \u46308 \u51060 , \u50976 \u45380  \u49884 \u45824 \u50640 \u45208  \u52397 \u45380  \u49884 \u45824 \u50640 \u45208  \u51109 \u45380  \u49884 \u45824 \u47484  \u47561 \u47200 \u54616 \u44256  \u50616 \u51228 \u45208  \u50672 \u44396 \u54616 \u45716  \u44368 \u44284 \u49436 \u47196  \u49340 \u44256 \u51088  \u44228 \u54925 \u54616 \u49512 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u47568 \u50432 \u51012  \u45817 \u49888  \u51088 \u49888 \u51032  \u54408 \u49457 \u50640  \u45824 \u54620  \u44228 \u49884 \u47196  \u49324 \u46988 \u46308 \u50640 \u44172  \u51452 \u49512 \u45796 . \u44536 \u47084 \u48064 \u47196  \u49352 \u47196 \u50868  \u51652 \u47532 \u47484  \u44648 \u45804 \u51004 \u47732  \u44648 \u45804 \u51012 \u49688 \u47197  \u49457 \u44221 \u51032  \u51200 \u51088 \u46104 \u49888  \u54616 \u45208 \u45784 \u51032  \u49457 \u54408 \u51012  \u45908 \u50865  \u51096  \u50508 \u44172  \u46104 \u50612  \u51080 \u45796 . \u49457 \u44221  \u50672 \u44396 \u45716  \u51064 \u47448 \u47196  \u54616 \u50668 \u44552  \u52285 \u51312 \u51452 \u50752  \u45908 \u50865  \u48128 \u51217 \u55176  \u50672 \u54633 \u54616 \u44172  \u54644 \u51452 \u44256  \u44536 \u48516 \u51032  \u44144 \u47337 \u54620  \u46907 \u50640  \u44288 \u54616 \u50668  \u45908 \u50865  \u47749 \u54869 \u54620  \u51648 \u49885 \u51012  \u50619 \u44172  \u54644 \u51456 \u45796 . \u44536 \u44163 \u51008  \u54616 \u45208 \u45784 \u44284  \u44368 \u53685 \u54616 \u45716  \u51068 \u50640  \u51080 \u50612 \u49436  \u51473 \u44060 \u51032  \u50669 \u54624 \u51012  \u54644 \u51456 \u45796 .\
\uc0\u50760 \u45940 \u49828 \u51064 \u46308 \u51008  \u50668 \u54840 \u50752 \u47484  \u44221 \u50808 \u54616 \u45716  \u44163 \u51012  \u51648 \u49885 \u51032  \u44540 \u48376 \u51004 \u47196  \u50668 \u44592 \u45716  \u46041 \u49884 \u50640  \u49464 \u49345  \u49324 \u46988 \u46308 \u44284  \u44368 \u51228 \u54616 \u45716  \u51068 \u51032  \u51473 \u50836 \u49457 \u51012  \u44648 \u45803 \u44256 , \u51221 \u49888 \u47141 \u51012  \u45331 \u55176 \u44256  \u51648 \u44033 \u51012  \u50696 \u48124 \u54616 \u44172  \u54616 \u45716  \u45936  \u54596 \u50836 \u54620  \u51648 \u49885 \u44284  \u49892 \u49373 \u54876 \u50640  \u44288 \u54620  \u51648 \u49885 \u51012  \u50619 \u45716  \u51068 \u51032  \u50836 \u44596 \u54632 \u51012  \u50508 \u44256  \u51080 \u50632 \u45796 . \u50612 \u46500  \u52397 \u45380 \u46308 \u51008  \u44536  \u49328 \u44036 \u51032  \u54617 \u44368 \u47196 \u48512 \u53552  \u44536 \u46308 \u51060  \u49332 \u44256  \u51080 \u45716  \u50508 \u54532 \u49828 \u50640  \u48708 \u54616 \u50668  \u44277 \u48512 \u54616 \u44256  \u50672 \u44396 \u54616 \u44256  \u44288 \u52272 \u54616 \u44592 \u50640  \u45908 \u50865  \u50976 \u47532 \u54620  \u51648 \u50669 \u51064  \u54532 \u46993 \u49828 \u45208  \u51060 \u53448 \u47532 \u50500 \u51032  \u46020 \u49884 \u46308 \u50640  \u51080 \u45716  \u44368 \u50977  \u44592 \u44288 \u51004 \u47196  \u54028 \u44204 \u46104 \u50632 \u45796 . \u51060 \u47111 \u44172  \u54028 \u44204 \u46108  \u52397 \u45380 \u46308 \u51008  \u50976 \u54841 \u51012  \u48155 \u44256 , \u48512 \u46020 \u45909 \u54620  \u51068 \u51012  \u47785 \u44201 \u54616 \u44256 , \u44032 \u51109  \u44368 \u54876 \u54620  \u51060 \u45800 \u49444 \u44284  \u50948 \u54744 \u49457 \u51060  \u47566 \u51008  \u44592 \u47564 \u51004 \u47196  \u51217 \u44540 \u54616 \u45716  \u49324 \u45800 \u51032  \u44368 \u54876 \u54620  \u45824 \u47532 \u51088 \u46308 \u44284  \u51217 \u52489 \u54616 \u44592 \u46020  \u54664 \u45796 . \u44536 \u47084 \u45208  \u50612 \u47540  \u46412 \u48512 \u53552  \u48155 \u51008  \u44536 \u46308 \u51032  \u44368 \u50977 \u51008  \u51060  \u47784 \u46304  \u50612 \u47140 \u50868  \u51068 \u46308 \u51012  \u45733 \u55176  \u51060 \u44600  \u47564 \u54620  \u54408 \u49457 \u51012  \u51060 \u47336 \u50612  \u45459 \u50520 \u45796 .\
\uc0\u44536 \u46308 \u51008  \u50612 \u45712  \u54617 \u44368 \u47196  \u44032 \u46304 \u51648  \u54632 \u48512 \u47196  \u48708 \u48128 \u51012  \u46300 \u47084 \u45236 \u45716  \u44536 \u47088  \u48279 \u51012  \u49324 \u44480 \u51648  \u50500 \u45768 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51032  \u51032 \u48373 \u51008  \u44032 \u51109  \u44480 \u51473 \u54620  \u48372 \u47932 \u51064  \u49457 \u44221  \u49324 \u48376  (\u32854 \u32147 \u23531 \u26412 ) \u51012  \u44048 \u52636  \u49688  \u51080 \u46020 \u47197  \u47564 \u46308 \u50612 \u51256  \u51080 \u50632 \u45796 . \u44536 \u46308 \u51008  \u50668 \u47084  \u54644  \u46041 \u50504  \u49688 \u44256 \u54616 \u50668  \u54596 \u44592 \u54620  \u49457 \u44221  \u49324 \u48376 \u51012  \u44032 \u51648 \u44256  \u45796 \u45768 \u47732 \u49436  \u44592 \u54924 \u44032  \u51080 \u45716  \u45824 \u47196  \u51032 \u49900 \u51012  \u48155 \u51648  \u50506 \u51012  \u47564 \u53372  \u51452 \u51032 \u54616 \u47732 \u49436  \u51652 \u47532 \u47484  \u44040 \u47581 \u54616 \u45716  \u51088 \u47196  \u51064 \u51221 \u46104 \u45716  \u49324 \u46988 \u46308 \u50640 \u44172  \u44536  \u50612 \u46500  \u48512 \u48516 \u51012  \u48372 \u50668 \u51452 \u50632 \u45796 . \u50760 \u45940 \u49828 \u51064 \u51032  \u51210 \u51008 \u51060 \u46308 \u51008  \u50612 \u47672 \u45768 \u51032  \u49836 \u54616 \u50640 \u49436  \u51060 \u47084 \u54620  \u47785 \u51201 \u51012  \u50948 \u54616 \u50668  \u54984 \u50977 \u51012  \u48155 \u50520 \u51004 \u48064 \u47196  \u44536 \u46308 \u51008  \u44536 \u46308 \u51032  \u49324 \u50629 \u51012  \u51060 \u54644 \u54616 \u44256  \u44536 \u44163 \u51012  \u49457 \u49892 \u54616 \u44172  \u51060 \u54665 \u54616 \u50688 \u45796 . \u52280 \u46108  \u49888 \u50521 \u51004 \u47196  \u54924 \u44060 \u54620  \u49324 \u46988 \u46308 \u51060  \u51060 \u47084 \u54620  \u54617 \u44368  \u50504 \u50640  \u49373 \u44200 \u45228 \u51004 \u48064 \u47196  \u51060 \u46384 \u44552  \u48127 \u51020 \u51032  \u50896 \u52825 \u51060  \u50728  \u54617 \u44368 \u50640  \u48372 \u44553 \u46104 \u45716  \u51068 \u46020  \u51080 \u50632 \u45796 . \u44536 \u47084 \u45208  \u48277 \u50773 \u44368 \u51032  \u51648 \u46020 \u51088 \u46308 \u51060  \u50500 \u47924 \u47532  \u49464 \u48128 \u54616 \u44172  \u51312 \u49324 \u47484  \u54624 \u51648 \u46972 \u46020  \u49548 \u50948  \u48512 \u54056 \u52992  \u54616 \u45716  \u51060 \u45800 \u51032  \u44540 \u50896  (\u26681 \u28304 ) \u51008  \u46020 \u51200 \u55176  \u52286 \u50500 \u45244  \u49688 \u44032  \u50630 \u50632 \u45796 .\
\uc0\u44536 \u47532 \u49828 \u46020 \u51032  \u51221 \u49888 \u51008  \u51204 \u46020 \u51032  \u51221 \u49888 \u51060 \u45796 . \u44144 \u46317 \u45212  \u47560 \u51020 \u49549 \u50640  \u51228 \u51068  \u47676 \u51200  \u49373 \u44592 \u45716  \u52649 \u46041 \u51008  \u45796 \u47480  \u49324 \u46988 \u46308  \u46608 \u54620  \u44396 \u51452 \u44760 \u47196  \u51064 \u46020 \u54616 \u44256 \u51088  \u54616 \u45716  \u52649 \u46041 \u51060 \u45796 . \u44536 \u44163 \u51008  \u48372 \u50864 \u46020 \u48400 \u51032  \u44536 \u47532 \u49828 \u46020 \u51064 \u46308 \u51060  \u54408 \u51008  \u51221 \u49888 \u51060 \u50632 \u45796 . \u44536 \u46308 \u51008  \u54616 \u45208 \u45784 \u44760 \u49436  \u45800 \u49692 \u55176  \u44536 \u46308 \u51032  \u44368 \u54924  \u50504 \u50640 \u49436  \u49692 \u44208 \u54620  \u51652 \u47532 \u47484  \u48372 \u51204 \u54616 \u45716  \u44163  \u51060 \u49345 \u51012  \u50836 \u44396 \u54616 \u49888 \u45796 \u45716  \u44163 , \u51593  \u50516 \u55121  \u44032 \u50868 \u45936  \u50505 \u50500  \u51080 \u45716  \u51088 \u46308 \u50640 \u44172 \u46020  \u48731 \u51012  \u48708 \u52628 \u50612  \u51460  \u50628 \u49689 \u54620  \u52293 \u51076 \u51012  \u47585 \u44200 \u51452 \u49512 \u45796 \u45716  \u44163 \u51012  \u51208 \u49892 \u55176  \u45712 \u44808 \u45796 . \u44536 \u46308 \u51008  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51032  \u50948 \u45824 \u54620  \u55192 \u51012  \u44032 \u51648 \u44256  \u47196 \u47560 \u44368 \u54924 \u44032  \u49324 \u46988 \u46308 \u50640 \u44172  \u47700 \u50892  \u51456  \u47924 \u44144 \u50868  \u47693 \u50640 \u47484  \u45130 \u50612  \u48260 \u47532 \u44256 \u51088  \u55192 \u50044 \u45796 . \u48372 \u50864 \u46020 \u48400 \u51032  \u47785 \u49324 \u46308 \u51008  \u45572 \u44396 \u45208  \u45796  \u49440 \u44368 \u49324 \u47196 \u49436 \u51032  \u54984 \u47144 \u51012  \u48155 \u50520 \u45796 . \u49457 \u51649 \u50640  \u46308 \u50612 \u44032 \u44592 \u47484  \u50896 \u54616 \u45716  \u49324 \u46988 \u51008  \u45572 \u44396 \u45208  \u47676 \u51200  \u51204 \u46020 \u51088 \u51032  \u44221 \u54744 \u51012  \u49939 \u50500 \u50556  \u54616 \u50688 \u45796 . \u44256 \u54693 \u50640  \u51080 \u45716  \u44368 \u54924 \u51032  \u52293 \u51076 \u51012  \u47585 \u44592  \u51204 \u50640  \u50612 \u46500  \u49440 \u44368  \u51648 \u50669 \u50640 \u49436  3\u45380  \u46041 \u50504  \u48393 \u49324 \u54616 \u50668 \u50556  \u54616 \u50688 \u45796 . \u51060 \u47084 \u54620  \u48393 \u49324 \u45716  \u47924 \u50631 \u48372 \u45796 \u46020  \u44537 \u44592 \u50752  \u55148 \u49373 \u51012  \u50836 \u44396 \u54616 \u50688 \u51004 \u47728 , \u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u51060  \u49884 \u47144 \u51012  \u44202 \u44256  \u51080 \u45912  \u44536 \u47088  \u49884 \u45824 \u50640  \u51080 \u50612 \u49436  \u47785 \u49324 \u47484  \u51648 \u47581 \u54616 \u45716  \u49324 \u46988 \u50640 \u44172  \u51201 \u51208 \u54620  \u51077 \u47928  (\u20837 \u38272 ) \u51060  \u46104 \u50632 \u45796 . \u51060 \u50752  \u44057 \u51060  \u54616 \u50668  \u49457 \u51649 \u50640  \u45208 \u50500 \u44036  \u52397 \u45380 \u46308 \u51008  \u44536  \u50526 \u44600 \u50640  \u49464 \u49549 \u51201  \u51060 \u51061 \u44284  \u48264 \u50689 \u51012  \u48148 \u46972 \u51648  \u50500 \u45768 \u54616 \u44256  \u44256 \u49373 \u44284  \u50948 \u54744 \u51032  \u49373 \u54876 , \u46412 \u50640  \u46384 \u46972 \u49436 \u45716  \u49692 \u44368 \u51088 \u51032  \u50868 \u47749 \u44620 \u51648 \u46020  \u44033 \u50724 \u54616 \u44256  \u51080 \u50632 \u45796 . \u51060  \u49440 \u44368 \u49324 \u46308 \u51008  \u50696 \u49688 \u44760 \u49436  \u51228 \u51088 \u46308 \u51012  \u45236 \u50612  \u48372 \u45236 \u49888  \u46412 \u52376 \u47100  \u46160  \u49324 \u46988 \u50473  \u54028 \u44204 \u46104 \u50632 \u45796 . \u44536 \u47532 \u54616 \u50668  \u51210 \u51008 \u51060 \u46308 \u51008  \u51068 \u48152 \u51201 \u51004 \u47196  \u45208 \u51060  \u47566 \u44256  \u44221 \u54744  \u51080 \u45716  \u49324 \u46988 \u44284  \u54632 \u44760  \u51068 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u51088 \u44592 \u47484  \u54984 \u47144 \u49884 \u53412 \u44592  \u50948 \u54616 \u50668  \u44368 \u54984 \u54644  \u51460  \u52293 \u51076 \u51012  \u51652  \u46041 \u48152 \u51088 \u51032  \u51648 \u46020 \u50640  \u48373 \u51333 \u54616 \u50688 \u45796 . \u44536  \u46041 \u50669 \u51088 \u46308 \u51008  \u50616 \u51228 \u45208  \u54632 \u44760  \u51080 \u51648 \u45716  \u50506 \u50520 \u51648 \u47564  \u51088 \u51452  \u44592 \u46020 \u54616 \u44256  \u54801 \u51032 \u54616 \u44592  \u50948 \u54616 \u50668  \u54632 \u44760  \u47784 \u50668  \u54588 \u52264 \u50640  \u49888 \u50521 \u51012  \u44053 \u54868 \u49884 \u53040 \u45796 .\
