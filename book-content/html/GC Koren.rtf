\uc0\u47560 \u52824  \u54861 \u49688  \u46412 \u51032  \u47932 \u44284  \u44057 \u51060  \u47560 \u51648 \u47561  \u45216 \u51032  \u48520 \u51008  \u50501 \u51064 \u46308 \u51032  \u48520 \u51032 \u44032  \u46020 \u47924 \u51648  \u44256 \u52432 \u51656  \u49688  \u50630 \u45796 \u45716  \u54616 \u45208 \u45784 \u51032  \u54032 \u44208 \u51012  \u49440 \u54252 \u54620 \u45796 . \u50501 \u51064 \u46308 \u51008  \u54616 \u45208 \u45784 \u51032  \u44428 \u50948 \u50640  \u48373 \u51333 \u54624  \u51032 \u54693 \u51060  \u50630 \u45796 . \u44536 \u46308 \u51032  \u51032 \u51648 \u45716  \u48152 \u50669 \u50640  \u49324 \u50857 \u46104 \u50612  \u50772 \u45796 . \u44536 \u47084 \u48064 \u47196  \u49373 \u47749 \u51060  \u45130 \u50612 \u51276 \u51012  \u46412 , \u44536 \u46308 \u51032  \u49373 \u44033 \u51012  \u48152 \u45824  \u48169 \u54693 \u51004 \u47196  \u46028 \u47532 \u44592 \u50640 \u45716  \u46412 \u44032  \u45320 \u47924  \u45734 \u50632 \u45796 . \u48276 \u51396 \u50640 \u49436  \u49692 \u51333 \u51004 \u47196 , \u51613 \u50724 \u50640 \u49436  \u49324 \u46993 \u51004 \u47196  \u46028 \u51060 \u53412 \u44592 \u50640 \u45716  \u49884 \u44592 \u44032  \u45320 \u47924  \u45734 \u50632 \u45796 .\
\uc0\u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u49332 \u51064 \u51088  \u44032 \u51064 \u51012  \u49332 \u47140 \u46160 \u49900 \u51004 \u47196  \u51396 \u51064 \u50640 \u44172  \u47560 \u51020 \u45824 \u47196  \u51396 \u50501 \u51032  \u44600 \u51012  \u44228 \u49549 \u54644 \u49436  \u44151 \u46020 \u47197  \u54728 \u50857 \u54616 \u45716  \u44208 \u44284 \u44032  \u50612 \u46500  \u44163 \u51064 \u51648 \u50640  \u45824 \u54620  \u50696 \u51613 \u51012  \u49464 \u49345 \u50640  \u48372 \u51060 \u49512 \u45796 . \u44032 \u51064 \u51032  \u44032 \u47476 \u52840 \u44284  \u47784 \u48376 \u51032  \u50689 \u54693 \u51004 \u47196  \u44536 \u51032  \u51088 \u49552 \u46308 \u51032  \u45796 \u49688 \u44032  \u51396 \u50640  \u48736 \u51648 \u44172  \u46104 \u50612  \u47560 \u52840 \u45236  \'93\u49324 \u46988 \u51032  \u51396 \u50501 \u51060  \u49464 \u49345 \u50640  \u44288 \u50689 \u54632 \u44284  \u44536  \u47560 \u51020 \u51032  \u49373 \u44033 \u51032  \u47784 \u46304  \u44228 \u54925 \u51060  \u54637 \u49345  \u50501 \u54624  \u49104 \'94 (\u52285  6:5) \u51060 \u50632 \u45796 . \'93\u50728  \u46405 \u51060  \u54616 \u45208 \u45784  \u50526 \u50640  \u54056 \u44340 \u54616 \u50668  \u44053 \u54252 \u44032  \u46405 \u50640  \u52649 \u47564 \'94 (\u52285  6:5, 11) \u54616 \u44172  \u46104 \u50632 \u45796 .\
\uc0\u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u49464 \u49345 \u50640  \u45824 \u54620  \u51088 \u48708 \u47196 \u50024  \u45432 \u50500  \u49884 \u45824 \u51032  \u50501 \u54620  \u44144 \u48124 \u46308 \u51012  \u51228 \u44144 \u54644 \u48260 \u47532 \u49512 \u45796 . \u44536 \u48516 \u44760 \u49436 \u45716  \u51088 \u48708 \u47196 \u50024  \u48512 \u54056 \u54620  \u49548 \u46036 \u51032  \u44144 \u48124 \u46308 \u51012  \u47736 \u47581 \u49884 \u53412 \u49512 \u45796 . \u49324 \u45800 \u51032  \u44592 \u47564 \u51201  \u45733 \u47141 \u51004 \u47196  \u50501 \u51012  \u54665 \u54616 \u45716  \u51088 \u46308 \u51008  \u52268 \u49457 \u44284  \u52845 \u52268 \u51012  \u48155 \u51020 \u51004 \u47196  \u45796 \u47480  \u49324 \u46988 \u46308 \u51012  \u45130 \u51076 \u50630 \u51060  \u48152 \u50669 \u51004 \u47196  \u51064 \u46020 \u54620 \u45796 . \u44032 \u51064 \u51032  \u49884 \u45824 , \u45432 \u50500 \u51032  \u49884 \u45824 , \u50500 \u48652 \u46972 \u54632 \u51032  \u49884 \u45824 , \u47215 \u51032  \u49884 \u45824 \u50640  \u44536 \u47084 \u54616 \u50688 \u44256  \u46608 \u54620  \u50724 \u45720 \u45216  \u50864 \u47532 \u51032  \u49884 \u45824 \u50640 \u46020  \u50669 \u49884  \u44536 \u47111 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436  \u45817 \u49888 \u51032  \u51008 \u54812 \u47484  \u44144 \u51208 \u54616 \u45716  \u51088 \u46308 \u51012  \u52572 \u51333 \u51201 \u51004 \u47196  \u47736 \u47581 \u49884 \u53412 \u45716  \u44163 \u51008  \u50864 \u51452 \u50640  \u45824 \u54620  \u51088 \u48708 \u50640 \u49436 \u51060 \u45796 .\
\'93\uc0\u51396 \u51032  \u49327 \u51008  \u49324 \u47581 \u51060 \u50836  \u54616 \u45208 \u45784 \u51032  \u51008 \u49324 \u45716  \u44536 \u47532 \u49828 \u46020  \u50696 \u49688  \u50864 \u47532  \u51452  \u50504 \u50640  \u51080 \u45716  \u50689 \u49373 \u51060 \u45768 \u46972 \'94 (\u47212  6:23). \u49373 \u47749 \u51008  \u51032 \u51064 \u51060  \u48155 \u51012  \u50976 \u50629 \u51060 \u50836  \u49324 \u47581 \u51008  \u50501 \u51064 \u51060  \u48155 \u51012  \u47787 \u51060 \u45796 . \u47784 \u49464 \u45716  \u51060 \u49828 \u46972 \u50648  \u49324 \u46988 \u46308 \u50640 \u44172  \'93\u45236 \u44032  \u50724 \u45720 \u45216  \u49373 \u47749 \u44284  \u48373 \u44284  \u49324 \u47581 \u44284  \u54868 \u47484  \u45348  \u50526 \u50640  \u46160 \'94 (\u49888  30:15) \u45432 \u46972 \u44256  \u47568 \u54616 \u50688 \u45796 . \u51060  \u49457 \u44221 \u51208 \u50640 \u49436  \u47568 \u54616 \u45716  \u49324 \u47581 \u51008  \u50500 \u45812 \u50640 \u44172  \u49440 \u44256 \u46108  \u49324 \u47581 \u51060  \u50500 \u45768 \u45796 . \u50780 \u45264 \u54616 \u47732  \u47784 \u46304  \u51064 \u47448 \u45716  \u50500 \u45812 \u51032  \u48276 \u51396 \u51032  \u54805 \u48268 \u51012  \u48155 \u44256  \u51080 \u44592  \u46412 \u47928 \u51060 \u45796 . \u44536 \u44163 \u51008  \u50689 \u49373 \u44284  \u45824 \u51312 \u51201 \u51064  \u50948 \u52824 \u50640  \u51080 \u45716  \'93\u46168 \u51704  \u49324 \u47581 \'94\u51060 \u45796 .\
