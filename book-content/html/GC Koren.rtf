\uc0\u54616 \u45208 \u45784 \u44760 \u49436  \u53469 \u54632 \u51012  \u51077 \u51008  \u44536  \u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u50640  \u53360  \u48731 \u51012  \u51452 \u49512 \u51004 \u48064 \u47196  \u44536 \u46308 \u51008  \u47196 \u47560 \u51032  \u50668 \u47084  \u44032 \u51648  \u50724 \u47448 \u46308 \u51012  \u44648 \u45803 \u44172  \u46104 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44536 \u46308 \u51008  \u49464 \u49345 \u50640  \u51204 \u54644  \u51452 \u50612 \u50556  \u54624  \u48731 \u51012  \u45224 \u44608 \u50630 \u51060  \u45796  \u48155 \u51008  \u44163 \u51008  \u50500 \u45768 \u50632 \u45796 . \u51060 \u47084 \u54620  \u51333 \u46308 \u51012  \u53685 \u54616 \u50668  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u49324 \u46988 \u46308 \u51012  \u47196 \u47560 \u44368 \u51032  \u55121 \u50516 \u50640 \u49436  \u45208 \u50724 \u46020 \u47197  \u51064 \u46020 \u54616 \u44256  \u44228 \u49512 \u45796 . \u44536 \u47084 \u45208  \u44536 \u46308 \u51008  \u50728 \u44054  \u53360  \u51109 \u50528 \u47484  \u47564 \u45208 \u50556  \u54624  \u44163 \u51060 \u50632 \u51004 \u48064 \u47196 , \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u44536 \u46308 \u51060  \u44048 \u45817 \u54624  \u49688  \u51080 \u51012  \u47564 \u53372  \u44536 \u46308 \u51012  \u54620  \u44228 \u45800 \u50473  \u54620  \u44228 \u45800 \u50473  \u51064 \u46020 \u54616 \u50668  \u45236 \u49512 \u45796 . \u44536 \u46308 \u51008  \u47784 \u46304  \u48731 \u51012  \u54620 \u44732 \u48264 \u50640  \u48155 \u51012  \u49688  \u51080 \u45716  \u51456 \u48708 \u44032  \u46104 \u50612  \u51080 \u51648  \u50506 \u50520 \u45796 . \u51221 \u50724 \u51032  \u54663 \u48731 \u44284  \u44057 \u51060  \u45576 \u48512 \u49884 \u44172  \u48157 \u51008  \u48731 \u51060  \u51452 \u50612 \u51276 \u50632 \u45908 \u46972 \u47732 , \u50516 \u55121  \u49549 \u50640  \u50724 \u47019 \u46041 \u50504  \u44039 \u54784  \u51080 \u50632 \u45912  \u49324 \u46988 \u46308 \u52376 \u47100  \u