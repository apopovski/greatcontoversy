\uc0\u47196 \u47560 \u44368 \u54924 \u44032  \u44428 \u49464 \u47484  \u51105 \u44172  \u46104 \u48064 \u47196  \u51060 \u47480 \u48148  \u50516 \u55121 \u49884 \u45824 \u44032  \u49884 \u51089 \u46104 \u50632 \u45796 . \u44536  \u44428 \u49464 \u44032  \u45908 \u54644  \u44040  \u51201 \u47560 \u45796  \u50516 \u55121 \u51008  \u45908 \u50865  \u51673 \u50612 \u51276 \u45796 . \u48127 \u51020 \u51008  \u51652 \u51221 \u54620  \u44592 \u52488 \u51060 \u49888  \u44536 \u47532 \u49828 \u46020 \u44760 \u47196 \u48512 \u53552  \u47196 \u47560  \u48277 \u50773 \u50640 \u44172 \u47196  \u50734 \u44592 \u50612  \u44052 \u45796 . \u49324 \u46988 \u46308 \u51008  \u51396 \u51032  \u49324 \u50976 \u50752  \u50689 \u50896 \u54620  \u44396 \u50896 \u51012  \u54616 \u45208 \u45784 \u51032  \u50500 \u46308 \u50640 \u44172  \u51032 \u47280 \u54616 \u45716  \u45824 \u49888 \u50640  \u48277 \u50773 \u44284  \u48277 \u50773 \u50640 \u44172 \u49436  \u44428 \u49464 \u47484  \u48155 \u51008  \u49888 \u48512 \u45208  \u51452 \u44368 \u50640 \u44172  \u44396 \u54616 \u44172  \u46104 \u50632 \u45796 . \u48277 \u50773 \u51008  \u49464 \u49345 \u50640  \u51080 \u45716  \u44536 \u46308 \u51032  \u51473 \u48372 \u51088 \u51060 \u47728 , \u44536 \u47484  \u53685 \u54616 \u50668 \u49436 \u47564  \u54616 \u45208 \u45784 \u44760  \u45208 \u50500 \u44040  \u49688  \u51080 \u51004 \u47728 , \u48277 \u50773 \u51008  \u44536 \u46308 \u50640 \u44172  \u54616 \u45208 \u45784 \u51032  \u50948 \u52824 \u50640  \u49436  \u51080 \u51004 \u48064 \u47196  \u44536 \u50640 \u44172  \u51208 \u45824 \u51201 \u51004 \u47196  \u48373 \u51333 \u54616 \u51648  \u50506 \u51004 \u47732  \u50504  \u46108 \u45796 \u44256  \u44536 \u46308 \u51008  \u48176 \u50912 \u45796 . \u44536 \u47084 \u48064 \u47196  \u44536 \u51032  \u50836 \u44396 \u50640  \u51025 \u54616 \u51648  \u50506 \u51004 \u47732  \u49900 \u49888 \u50640  \u50628 \u54620  \u48268 \u51012  \u48155 \u45716  \u44163 \u51060  \u45817 \u50672 \u54616 \u45796 \u44256  \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u51008  \u54616 \u45208 \u45784 \u44760 \u47196 \u48512 \u53552  \u46496 \u45208 \u49436  \u50724 \u47448 \u44032  \u47566 \u44256  \u51092 \u51064 \u54620  \u49324 \u46988 \u46308 , \u50500 \u45768  \u44536 \u48372 \u45796 \u46020  \u44536 \u46308 \u51012  \u53685 \u54616 \u50668  \u51088 \u44592 \u51032  \u44428 \u47141 \u51012  \u54665 \u49324 \u54616 \u45716  \u50516 \u55121 \u51032  \u51076 \u44552 \u50640 \u44172 \u47196  \u54693 \u54616 \u44172  \u46104 \u50632 \u45796 . \u51396 \u45716  \u49888 \u49457  (\u31070 \u32854 ) \u51060 \u46972 \u45716  \u44032 \u47732 \u51012  \u50416 \u44172  \u46104 \u50632 \u45796 . \u44536 \u47088 \u51593  \u49457 \u44221 \u51060  \u44552 \u51648 \u47484  \u45817 \u54616 \u44256 , \u49324 \u46988 \u51060  \u51088 \u44592 \u47484  \u51648 \u44537 \u55176  \u45458 \u51008  \u51088 \u46972 \u44256  \u54624  \u46412  \u50864 \u47532 \u45716  \u44144 \u51667 \u44284  \u49549 \u51076 \u44284  \u48520 \u48277 \u50640  \u45824 \u54616 \u50668  \u44221 \u44228 \u54644 \u50556  \u54620 \u45796 . \u49324 \u46988 \u51032  \u48277 \u44284  \u51204 \u49444 \u51060  \u45458 \u51076 \u51012  \u48155 \u51012  \u46412 \u50640 \u45716  \u50616 \u51228 \u45208  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51012  \u47924 \u49884 \u54632 \u51004 \u47196  \u49373 \u44592 \u45716  \u53440 \u46973 \u51060  \u45208 \u53440 \u45228 \u45796 .\
\uc0\u51060 \u46412 \u45716  \u44536 \u47532 \u49828 \u46020 \u44368 \u54924 \u44032  \u50948 \u44592 \u50640  \u45459 \u51064  \u49884 \u45824 \u50688 \u45796 . \u52649 \u49457 \u46108  \u44592 \u49688  (\u26071 \u25163 ) \u45716  \u52280 \u51004 \u47196  \u51201 \u50632 \u45796 . \u51652 \u47532 \u47484  \u51613 \u44144 \u54616 \u45716  \u49324 \u46988 \u46308 \u51060  \u50630 \u50612 \u51652  \u44163 \u51008  \u50500 \u45768 \u50632 \u51648 \u47560 \u45716  \u50724 \u47448 \u50752  \u48120 \u49888 \u51060  \u50756 \u51204 \u55176  \u49849 \u47532 \u54616 \u44256  \u51652 \u51221 \u54620  \u51333 \u44368 \u45716  \u49464 \u49345 \u50640 \u49436  \u51228 \u44144 \u46112  \u44163 \u52376 \u47100  \u48372 \u50688 \u45796 . \u48373 \u51020 \u51008  \u51082 \u54784 \u51652  \u48148  \u46104 \u50632 \u44256  \u51333 \u44368 \u51032  \u54805 \u49885 \u51008  \u51613 \u44032 \u46104 \u50632 \u51004 \u47728  \u49324 \u46988 \u46308 \u51008  \u50668 \u47084  \u44032 \u51648  \u44032 \u54841 \u54620  \u50836 \u44396  \u46412 \u47928 \u50640  \u47924 \u44144 \u50868  \u51664 \u51012  \u51648 \u44256  \u51080 \u50632 \u45796 .\
\uc0\u44536 \u46308 \u51008  \u48277 \u50773 \u51012  \u44536 \u46308 \u51032  \u51473 \u48372 \u51088 \u47196  \u50864 \u47084 \u47084 \u48372 \u44256 , \u51396 \u47484  \u49549 \u54616 \u44592  \u50948 \u54616 \u50668  \u51088 \u44592 \u51032  \u54665 \u50948 \u47484  \u51032 \u51648 \u54616 \u46020 \u47197  \u44032 \u47476 \u52840 \u51012  \u48155 \u50520 \u45796 . \u44536 \u47532 \u54616 \u50668  \u54616 \u45208 \u45784 \u51032  \u51652 \u45432 \u47484  \u44032 \u46972 \u50505 \u55176 \u44256  \u44536 \u48516 \u51032  \u51008 \u52509 \u51012  \u50619 \u44592  \u50948 \u54616 \u50668  \u47676  \u44600 \u51032  \u49692 \u47168  \u50668 \u54665 , \u44256 \u54665 , \u50976 \u47932  \u50696 \u48176  (\u36986 \u29289 \u63926 \u25308 ), \u44368 \u54924 \u45817 \u44284  \u51228 \u45800 \u44284  \u49688 \u46020 \u50896 \u51032  \u44148 \u47549  (\u24314 \u31435 ), \u47566 \u51008  \u46024 \u51032  \u54732 \u45225  (\u29563 \u32013 ), \u44536 \u50752  \u50976 \u49324 \u54620  \u44536  \u48150 \u51032  \u51068 \u46308 \u51012  \u54665 \u54616 \u46972 \u45716  \u47749 \u47161 \u51060  \u51452 \u50612 \u51276 \u45796 .\
\uc0\u47560 \u52824  \u54616 \u45208 \u45784 \u44760 \u49436  \u49324 \u46988 \u52376 \u47100  \u49324 \u49548 \u54620  \u51068 \u47196  \u51652 \u45432 \u54616 \u49884 \u44256 , \u50696 \u47932 \u51060 \u45208  \u44256 \u54665 \u51004 \u47196  \u44536  \u51652 \u45432 \u47484  \u44144 \u46160 \u49884 \u45716  \u48516 \u51060 \u49884 \u44592 \u45208  \u54620  \u44163 \u52376 \u47100 .\
\uc0\u48708 \u54665  (\u38750 \u34892 ) \u51008  \u50728  \u49324 \u54924 \u50640  \u54140 \u51648 \u46104  \u49900 \u51648 \u50612  \u47196 \u47560 \u44368 \u54924 \u51032  \u51648 \u46020 \u51088 \u46308 \u50640 \u44172 \u44620 \u51648 \u46020  \u54028 \u44553 \u46104 \u50632 \u51648 \u47564  \u44536  \u44368 \u54924 \u51032  \u49464 \u47141 \u51008  \u44984 \u51456 \u55176  \u51613 \u44032 \u46104 \u45716  \u46319 \u54616 \u50688 \u45796 . 8\u49464 \u44592 \u51032  \u47568 \u50685 \u50640  \u48277 \u50773 \u44368 \u46020 \u46308 \u51008  \u52488 \u45824 \u51032  \u44368 \u54924 \u50640 \u49436 \u46020  \u47196 \u47560 \u51032  \u44048 \u46021 \u46308 \u51008  \u54788 \u51116  \u44536 \u46308 \u51060  \u44032 \u51648 \u44256  \u51080 \u45716  \u44163 \u44284  \u46609 \u44057 \u51008  \u49888 \u47161 \u51201  \u44428 \u47141 \u51012  \u44032 \u51648 \u44256  \u51080 \u50632 \u45796 \u44256  \u51452 \u51109 \u54616 \u50688 \u45796 . \u51060  \u51452 \u51109 \u51032  \u54869 \u49892 \u49457 \u51012  \u44277 \u44256 \u55176  \u54616 \u44256  \u44536 \u44163 \u51012  \u45908 \u50865  \u44428 \u50948  \u51080 \u44172  \u54616 \u44592  \u50948 \u54616 \u50668  \u47924 \u49832  \u48169 \u48277 \u51060  \u49324 \u50857 \u46104 \u50612 \u50556 \u47564  \u54616 \u50688 \u45796 . \u44536 \u47532 \u44256  \u44144 \u51667 \u47568 \u54616 \u45716  \u51088 \u51032  \u50500 \u48708 \u47196  \u47568 \u48120 \u50516 \u50500  \u51060 \u47084 \u54620  \u47785 \u51201 \u51012  \u51060 \u47336 \u45716  \u45936  \u49324 \u50857 \u54624  \u49688  \u51080 \u45716  \u48169 \u48277 \u50640  \u45824 \u54620  \u50516 \u49884 \u44032  \u51060 \u48120  \u51452 \u50612 \u51256  \u51080 \u50632 \u45796 . \u49849 \u47140 \u46308 \u51008  \u44256 \u49436  (\u21476 \u26360 ) \u46308 \u51012  \u50948 \u51312 \u54616 \u50688 \u45796 . \u52488 \u44592 \u48512 \u53552  \u48277 \u50773 \u51008  \u51204 \u48152 \u51201 \u51064  \u52572 \u49345 \u44428 \u51012  \u44032 \u51648 \u44256  \u51080 \u50632 \u45796 \u45716  \u51452 \u51109 \u51012  \u49464 \u50864 \u44592  \u50948 \u54616 \u50668  \u44536  \u45817 \u49884 \u44620 \u51648  \u51204 \u54784  \u46307 \u51648  \u47803 \u54620  \u51333 \u44368  \u54924 \u51032 \u51032  \u44208 \u51032 \u47928 \u46308 \u51060  \u48156 \u44204 \u46104 \u50632 \u45796 \u44256  \u51452 \u51109 \u54616 \u50688 \u45796 . \u44536 \u47532 \u44256  \u51652 \u47532 \u47484  \u48176 \u48152 \u54620  \u44368 \u54924 \u45716  \u51060  \u44592 \u47564 \u51012  \u51600 \u44200  \u48155 \u50500 \u46308 \u50688 \u45796  (\u48512 \u47197  6 \u52280 \u51312 ).\
\uc0\u52280 \u46108  \u44592 \u52488  \u50948 \u50640 \u49436  \u51068 \u51012  \u54616 \u45912  \u49548 \u49688 \u51032  \u49888 \u49892 \u54620  \u44148 \u52629 \u44032 \u46308 \u51008  \u44144 \u51667  \u44368 \u47532 \u44032  \u51088 \u44592 \u46308 \u51032  \u51068 \u51012  \u48169 \u54644 \u54616 \u44592  \u46412 \u47928 \u50640  \u54844 \u46976 \u44284  \u50612 \u47140 \u50880 \u51012  \u45712 \u44808 \u45796 . \u47560 \u52824  \u45712 \u54756 \u48120 \u50556  \u45817 \u49884 \u50640  \u50696 \u47336 \u49332 \u47128  \u49457 \u51012  \u49939 \u45912  \u49324 \u46988 \u46308 \u52376 \u47100  \'93\u55129 \u47924 \u45908 \u44592 \u44032  \u50500 \u51649 \u46020  \u47566 \u44144 \u45720  \u45812 \u48512 \u54616 \u45716  \u51088 \u51032  \u55192 \u51060  \u49632 \u54616 \u50688 \u51004 \u45768  \u50864 \u47532 \u44032  \u49457 \u51012  \u44148 \u52629 \u54616 \u51648  \u47803 \u54616 \u47532 \u46972 \'94 (\u45712  4:10) \u44256  \u47568 \u54616 \u45716  \u49324 \u46988 \u46308 \u46020  \u45908 \u47084  \u51080 \u50632 \u45796 . \u44536 \u46308 \u51008  \u44277 \u49324 \u51032  \u51652 \u54665 \u51012  \u48169 \u54644 \u54616 \u44592  \u50948 \u54616 \u50668  \u51088 \u54665 \u46104 \u45716  \u48149 \u54644 , \u44592 \u47564 , \u48520 \u48277 , \u44536  \u48150 \u50640  \u49324 \u45800 \u51060  \u44256 \u50504 \u54644  \u45244  \u49688  \u51080 \u45716  \u50728 \u44054  \u51109 \u50528 \u47932 \u44284 \u51032  \u45130 \u51076 \u50630 \u45716  \u49912 \u50880 \u51004 \u47196  \u54588 \u44260 \u54616 \u50668 \u51256 \u49436 , \u52649 \u49457 \u46108  \u44148 \u52629 \u44032 \u46308 \u51060 \u50632 \u45912  \u51088 \u46308  \u51473  \u45908 \u47084 \u45716  \u45209 \u45812 \u54644  \u48260 \u47160 \u45796 . \u44536 \u46308 \u51008  \u47560 \u52840 \u45236  \u49373 \u47749 \u51032  \u50504 \u51204 \u44284  \u51116 \u49328 \u51032  \u48372 \u54840 \u47484  \u50948 \u54616 \u50668  \u52280 \u46108  \u44592 \u52488 \u50640 \u49436  \u47932 \u47084 \u44052 \u45796 . \u44536 \u47084 \u45208  \u50896 \u49688 \u46308 \u51032  \u48152 \u45824 \u50640 \u46020  \u44404 \u54616 \u51648  \u50506 \u44256  \'93\u45320 \u55148 \u45716  \u51200 \u55148 \u47484  \u46160 \u47140 \u50892  \u47568 \u44256  \u51648 \u44537 \u55176  \u53356 \u49884 \u44256  \u46160 \u47140 \u50864 \u49888  \u51452 \u47484  \u44592 \u50613 \u54616 \'94 (\u45712  4:14) \u46972 \u44256  \u50857 \u44048 \u54616 \u44172  \u50808 \u52824 \u47732 \u49436  \u54728 \u47532 \u50640  \u52860 \u51012  \u52264 \u44256  \u51068 \u51012  \u54616 \u45716  \u49324 \u46988 \u46308 \u46020  \u51080 \u50632 \u45796 .\
