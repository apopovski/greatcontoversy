\uc0\u51060  \u47784 \u46304  \u51068 \u51008  \u49324 \u45800 \u51060  \u49548 \u50896 \u54616 \u45912  \u51068 \u47196 \u49436  \u44536 \u45716  \u44536  \u51068 \u51012  \u50668 \u47084  \u49884 \u45824 \u50640  \u44152 \u52432 \u49436  \u44228 \u54925 \u54616 \u44256  \u51060 \u47336 \u44256 \u51088  \u45432 \u47141 \u54616 \u50668  \u50772 \u45912  \u44163 \u51060 \u45796 . \u44536 \u51032  \u51221 \u52293 \u51008  \u52376 \u51020 \u48512 \u53552  \u45149 \u44620 \u51648  \u50728 \u51204 \u55176  \u44592 \u47564 \u51004 \u47196  \u51060 \u47336 \u50612 \u51652 \u45796 . \u44536 \u47532 \u44256  \u44536 \u51032  \u45800 \u54840 \u54620  \u47785 \u51201 \u51008  \u49324 \u46988 \u46308 \u50640 \u44172  \u51200 \u51452 \u50752  \u48520 \u54665 \u51012  \u44032 \u51256 \u45796 \u51452 \u44256  \u54616 \u45208 \u45784 \u44760 \u49436  \u54616 \u49884 \u45716  \u51068 \u51012  \u54028 \u44340 \u54616 \u44256  \u50837 \u46104 \u44172  \u54632 \u51004 \u47196  \u44536 \u48516 \u51032  \u51088 \u48708 \u50752  \u51064 \u50528 \u51032  \u44144 \u47337 \u54616 \u49888  \u47785 \u51201 \u51012  \u48169 \u54644 \u54616 \u50668  \u54616 \u45720 \u50640  \u49836 \u54548 \u51012  \u44032 \u51256 \u45796 \u51452 \u45716  \u51068 \u51060 \u45796 . \u44536 \u47532 \u44256  \u44536 \u45716  \u44536 \u51032  \u44592 \u47564 \u51201 \u51064  \u49696 \u52293 \u51004 \u47196  \u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u51032  \u45576 \u51012  \u50612 \u46177 \u44172  \u54616 \u50668  \u44536 \u46308 \u47196  \u54616 \u50668 \u44552  \u51088 \u44592 \u46308 \u51032  \u51096 \u47803 \u51012  \u54616 \u45208 \u45784 \u44760 \u49436  \u54616 \u49888  \u51068 \u52376 \u47100  \u45712 \u45180 \u44172  \u54616 \u44256 , \u51088 \u44592 \u44032  \u44032 \u51256 \u50728  \u47784 \u46304  \u48708 \u52280 \u54620  \u51068 \u46308 \u51012  \u52285 \u51312 \u51452 \u51032  \u44228 \u54925 \u51032  \u44208 \u44284 \u52376 \u47100  \u45712 \u45180 \u44172  \u54620 \u45796 . \u51060 \u50752  \