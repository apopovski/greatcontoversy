\uc0\u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u46308 \u51008  \u44256 \u45212 \u51012  \u47732 \u52824  \u47803 \u54624  \u44163 \u51060 \u45796 . \u48149 \u54644 \u50752  \u44256 \u53685 \u51012  \u45817 \u54616 \u44256  \u44417 \u54605 \u44284  \u44256 \u45212 \u51012  \u44204 \u46364 \u51648 \u46972 \u46020  \u44536 \u46308 \u51008  \u51453 \u46020 \u47197  \u48260 \u47140 \u51648 \u51648  \u50506 \u51012  \u44163 \u51060 \u45796 . \u50648 \u47532 \u50556 \u47484  \u48372 \u54840 \u54644  \u51452 \u49888  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u51088 \u50500 \u47484  \u55148 \u49373 \u54616 \u44256  \u51080 \u45716  \u45817 \u49888 \u51032  \u51088 \u45376 \u46308 \u51012  \u54620  \u49324 \u46988 \u46020  \u51648 \u45208 \u52432  \u48260 \u47532 \u51648  \u50506 \u51004 \u49892  \u44163 \u51060 \u45796 . \u44536 \u46308 \u51032  \u47672 \u47532 \u53560 \u44620 \u51648  \u49464 \u49884 \u45716  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u44536 \u46308 \u51012  \u48372 \u54840 \u54644  \u51452 \u49892  \u44163 \u51060 \u47728 , \u44592 \u44540 \u51032  \u46412 \u50640 \u46020  \u44536 \u46308 \u51032  \u54596 \u50836 \u47484  \u52292 \u50892  \u51452 \u49892  \u44163 \u51060 \u45796 . \u50501 \u54620  \u51088 \u46308 \u51060  \u44592 \u44540 \u44284  \u51656 \u48337 \u51004 \u47196  \u51453 \u50612 \u44040  \u46041 \u50504  \u52380 \u49324 \u46308 \u51008  \u51032 \u51064 \u46308 \u51012  \u48372 \u54840 \u54616 \u44256  \u44536 \u46308 \u51032  \u54596 \u50836 \u47484  \u52292 \u50892  \u51460  \u44163 \u51060 \u45796 . \u51032 \u47213 \u44172  \u54665 \u54616 \u45716  \u51088 \u46308 \u50640 \u44172  \'93\u44536  \u50577 \u49885 \u51008  \u44277 \u44553 \u46104 \u44256  \u44536  \u47932 \u51008  \u45130 \u52824 \u51648  \u50500 \u45768 \u54616 \u47532 \u46972 \'94\u45716  \u50557 \u49549 \u51060  \u51080 \u45796 . \'93\u44032 \u47144 \u54616 \u44256  \u48712 \u54605 \u54620  \u51088 \u44032  \u47932 \u51012  \u44396 \u54616 \u46104  \u47932 \u51060  \u50630 \u50612 \u49436  \u44040 \u51613 \u51004 \u47196  \u44536 \u46308 \u51032  \u54784 \u44032  \u47560 \u47484  \u46412 \u50640  \u45208  \u50668 \u54840 \u50752 \u44032  \u44536 \u46308 \u50640 \u44172  \u51025 \u45813 \u54616 \u44192 \u44256  \u45208  \u51060 \u49828 \u46972 \u50648 \u51032  \u54616 \u45208 \u45784 \u51060  \u44536 \u46308 \u51012  \u48260 \u47532 \u51648  \u50500 \u45768 \u54624  \u44163 \u51060 \u46972 \'94 (\u49324  33:15, 16, 41:17).\
\'93\uc0\u48708 \u47197  \u47924 \u54868 \u44284 \u45208 \u47924 \u44032  \u47924 \u49457 \u52824  \u47803 \u54616 \u47728  \u54252 \u46020 \u45208 \u47924 \u50640  \u50676 \u47588 \u44032  \u50630 \u51004 \u47728  \u44048 \u46988 \u45208 \u47924 \u50640  \u49548 \u52636 \u51060  \u50630 \u51004 \u47728  \u48173 \u50640  \u49885 \u47932 \u51060  \u50630 \u51004 \u47728  \u50864 \u47532 \u50640  \u50577 \u51060  \u50630 \u51004 \u47728  \u50808 \u50577 \u44036 \u50640  \u49548 \u44032  \u50630 \u51012 \u51648 \u46972 \u46020 \'94 (\u54633  3:17) \u54616 \u45208 \u45784 \u51012  \u44221 \u50808 \u54616 \u45716  \u49324 \u46988 \u46308 \u51008  \'93\u50668 \u54840 \u50752 \u47484  \u51064 \u54616 \u50668  \u51600 \u44144 \u50892 \u54616 \u47728 \'94 (\u54633  3:17, 18) \u44396 \u50896 \u51032  \u54616 \u45208 \u45784 \u51012  \u51064 \u54616 \u50668  \u44592 \u48848 \u54624  \u44163 \u51060 \u45796 .\
\'93\uc0\u50668 \u54840 \u50752 \u45716  \u45320 \u47484  \u51648 \u53412 \u49884 \u45716  \u51088 \u46972  \u50668 \u54840 \u50752 \u44760 \u49436  \u45348  \u50864 \u54200 \u50640 \u49436  \u45348  \u44536 \u45720 \u51060  \u46104 \u49884 \u45208 \u45768  \u45230 \u51032  \u54644 \u44032  \u45320 \u47484  \u49345 \u52824  \u50500 \u45768 \u54616 \u47728  \u48164 \u51032  \u45804 \u46020  \u45320 \u47484  \u54644 \u52824  \u50500 \u45768 \u54616 \u47532 \u47196 \u45796  \u50668 \u54840 \u50752 \u44760 \u49436  \u45320 \u47484  \u51648 \u53020  \u47784 \u46304  \u54872 \u45212 \u51012  \u47732 \u52992  \u54616 \u49884 \u47728  \u46608  \u45348  \u50689 \u54844 \u51012  \u51648 \u53412 \u49884 \u47532 \u47196 \u45796 \'94 (\u49884  121:5~7). \'93\u51200 \u44032  \u45320 \u47484  \u49352  \u49324 \u45285 \u44988 \u51032  \u50732 \u47924 \u50640 \u49436 \u50752  \u44537 \u54620  \u50684 \u48337 \u50640 \u49436  \u44148 \u51648 \u49892  \u44163 \u51076 \u51060 \u47196 \u45796  \u51200 \u44032  \u45320 \u47484  \u44536  \u44611 \u51004 \u47196  \u45934 \u51004 \u49884 \u47532 \u45768  \u45348 \u44032  \u44536  \u45216 \u44060  \u50500 \u47000  \u54588 \u54616 \u47532 \u47196 \u45796  \u44536 \u51032  \u51652 \u49892 \u54632 \u51008  \u48169 \u54056 \u50752  \u49552  \u48169 \u54056 \u44032  \u46104 \u45208 \u45768  \u45320 \u45716  \u48164 \u50640  \u45440 \u47016 \u44284  \u45230 \u50640  \u55120 \u47476 \u45716  \u49332 \u44284  \u55121 \u50516  \u51473 \u50640  \u54665 \u54616 \u45716  \u50684 \u48337 \u44284  \u48177 \u51452 \u50640  \u54889 \u54224 \u52992  \u54616 \u45716  \u54028 \u47736 \u51012  \u46160 \u47140 \u50892  \u50500 \u45768 \u54616 \u47532 \u47196 \u45796  \u52380 \u51064 \u51060  \u45348  \u44225 \u50640 \u49436 , \u47564 \u51064 \u51060  \u45348  \u50864 \u54200 \u50640 \u49436  \u50638 \u46300 \u47140 \u51648 \u45208  \u51060  \u51116 \u50521 \u51060  \u45348 \u44172  \u44032 \u44620 \u51060  \u47803 \u54616 \u47532 \u47196 \u45796  \u50724 \u51649