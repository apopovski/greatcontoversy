\f0\b \cf0 \uc0\u54616 \u45208 \u45784 \u51032  \u50500 \u46308 \u51032  \u54840 \u49548 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u54616 \u45208 \u45784 \u51032  \u50500 \u46308 \u51060  \u52828 \u55176  \u54924 \u44060 \u54616 \u51648  \u50506 \u45716  \u46020 \u49457 \u50640  \u44036 \u52397 \u54616 \u44592  \u50948 \u54616 \u50668  \u54028 \u44204 \u46104 \u49512 \u45796 . \u51068 \u52237 \u51060  \u51060 \u49828 \u46972 \u50648 \u51012  \u51339 \u51008  \u54252 \u46020 \u45208 \u47924 \u47196 \u49436  \u50528 \u44413 \u50640 \u49436  \u51064 \u46020 \u54644  \u45236 \u49888  \u51060 \u45716  \u48148 \u47196  \u44536 \u47532 \u49828 \u46020 \u49512 \u45796  (\u49884  80:8). \u44536 \u48516 \u44760 \u49436 \u45716  \u49552 \u49688  \u51060 \u48169  \u49324 \u46988 \u46308 \u51012  \u44536  \u50526 \u50640 \u49436  \u47792 \u50500 \u45236 \u49884 \u44256  \u44536  \u45208 \u47924 \u47484  \'93\u49900 \u55176  \u44592 \u47492 \u51652  \u49328 \u50640 \'94 \u49900 \u51004 \u49512 \u45796 . \u44536 \u47532 \u44256  \u44536 \u48516 \u44760 \u49436 \u45716  \u44536  \u45208 \u47924 \u47484  \u48372 \u54840 \u54616 \u44592  \u50948 \u54616 \u50668  \u49328 \u50872 \u51012  \u46168 \u47084 \u52824 \u49512 \u45796 . \u46608  \u51333 \u46308 \u51012  \u48372 \u45236  \u44536 \u44163 \u51012  \u44032 \u44984 \u44172  \u54616 \u49512 \u45796 . \u44536 \u48516 \u44760 \u49436  \'93\u45236  \u54252 \u46020 \u50896 \u51012  \u50948 \u54616 \u50668  \u54665 \u54620  \u44163  \u50808 \u50640  \u47924 \u50631 \u51012  \u45908 \u54624  \u44163 \u51060  \u51080 \u50632 \u51004 \u47028 \'94 (\u49324  5:1~4 \u52280 \u51312 ) \u44256  \u50808 \u52824 \u49512 \u45796 . \u44536 \u48516 \u44760 \u49436  \u54252 \u46020 \u44032  \u50676 \u47160 \u45716 \u51648  \u49332 \u54588 \u49512 \u51012  \u46412  \u46308 \u54252 \u46020 \u44032  \u50676 \u47160 \u45796 . \u51060 \u50752  \u44057 \u51060  \u50676 \u47588 \u44032  \u50630 \u51020 \u50640 \u46020  \u48520 \u44396 \u54616 \u44256  \u44536 \u48516 \u44760 \u49436 \u45716  \u50676 \u47588 \u47484  \u47610 \u55176 \u44172  \u54616 \u49884 \u47140 \u45716  \u50676 \u47581 \u51004 \u47196  \u52828 \u55176  \u54252 \u46020 \u50896 \u50640  \u50724 \u49492 \u49436  \u44536 \u47484  \u47736 \u54616 \u51648  \u50506 \u44256  \u44396 \u50896 \u54616 \u49884 \u44256 \u51088  \u54616 \u49512 \u45796 . \u44536 \u48516 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u54252 \u46020 \u45208 \u47924 \u51032  \u51452 \u50948 \u47484  \u54028 \u44256  \u51204 \u51221 \u51012  \u54616 \u44256  \u44032 \u44984 \u49512 \u45796 . \u44536 \u48516 \u44760 \u49436 \u45716  \u49552 \u49688  \u49900 \u51004 \u49888  \u44536  \u54252 \u46020 \u45208 \u47924 \u47484  \u49332 \u47532 \u44592  \u50948 \u54616 \u50668  \u52572 \u49440 \u51032  \u45432 \u47141 \u51012  \u45796 \u54616 \u49512 \u45796 .\
\uc0\u48731 \u44284  \u50689 \u44305 \u51032  \u51452 \u44760 \u49436  3\u45380  \u46041 \u50504  \u45817 \u49888 \u51032  \u48177 \u49457 \u44284  \u54632 \u44760  \u51648 \u45236 \u49512 \u45796 . \u44536 \u48516 \u44760 \u49436 \u45716  \'93\u46160 \u47336  \u45796 \u45768 \u49884 \u47728  \u52265 \u54620  \u51068 \u51012  \u54665 \u54616 \u49884 \u44256  \u47560 \u44480 \u50640 \u44172  \u45580 \u47536  \u47784 \u46304  \u51088 \u47484  \u44256 \u52824 \'94 (\u54665  10:38) \u49512 \u45796 . \u44536 \u48516 \u44760 \u49436 \u45716  \u47560 \u51020 \u51060  \u49345 \u54620  \u51088 \u47484  \u50948 \u47196 \u54616 \u44256  \u44039 \u55180  \u51088 \u47484  \u45459 \u50500  \u51452 \u44256  \u45576 \u47676  \u51088 \u47484  \u48372 \u44172  \u54616 \u44256  \u50505 \u51008 \u48197 \u51060 \u47484  \u44151 \u44172  \u54616 \u44256  \u47928 \u46181 \u48337 \u51088 \u47484  \u44648 \u45143 \u52992  \u54616 \u44256  \u44480 \u47672 \u44144 \u47532 \u47484  \u46307 \u44172  \u54616 \u44256  \u51453 \u51008  \u51088 \u47484  \u49332 \u47532 \u44256  \u44032 \u45212 \u54620  \u51088 \u50640 \u44172  \u48373 \u51020 \u51012  \u51204 \u54616 \u49512 \u45796  (\u45573  4:18; \u47560  11:5 \u52280 \u51312 ). \u47784 \u46304  \u44228 \u52789 \u51032  \u49324 \u46988 \u46308 \u50640 \u44172  \'93\u49688 \u44256 \u54616 \u44256  \u47924 \u44144 \u50868  \u51664  \u51652  \u51088 \u46308 \u50500  \u45796  \u45236 \u44172 \u47196  \u50724 \u46972  \u45236 \u44032  \u45320 \u55148 \u47484  \u49772 \u44172  \u54616 \u47532 \u46972 \'94 (\u47560  11:28) \u45716  \u51008 \u54812 \u51032  \u52488 \u52397 \u51060  \u46609 \u44057 \u51060  \u51452 \u50612 \u51276 \u45796 .\
