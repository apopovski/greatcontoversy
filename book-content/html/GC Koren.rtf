\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u47336 \u53552 \u45716  \u44305 \u49888 \u51032  \u44208 \u44284 \u47196  \u44060 \u54785  \u50868 \u46041 \u51060  \u48708 \u45212 \u51012  \u48155 \u45716  \u44163 \u51012  \u48372 \u50520 \u51012  \u46412 , \u50724 \u47000  \u51204 \u50640  \u44536 \u44032  \u50640 \u47476 \u54392 \u47476 \u53944 \u50640 \u49436  \u45817 \u54620  \u47560 \u51020 \u51032  \u48264 \u48124 \u48372 \u45796  \u48176 \u45208  \u45908  \u49900 \u54616 \u44172  \u48155 \u44172  \u46104 \u50632 \u45796 . \u48277 \u50773 \u45817 \u51032  \u51228 \u54980 \u46308 \u51008  \u44536  \u48152 \u46976 \u51060  \u47336 \u53552 \u51032  \u44368 \u47532 \u44032  \u44032 \u51256 \u50728  \u54596 \u50672 \u51201  \u44208 \u44284 \u46972 \u44256  \u51452 \u51109 \u54616 \u50688 \u44256 , \u47566 \u51008  \u49324 \u46988 \u46308 \u46020  \u44536 \u46308 \u51032  \u51652 \u49696 \u51012  \u48127 \u51004 \u47140 \u44256  \u54616 \u50688 \u45796 . \u48708 \u47197  \u51060 \u50752  \u44057 \u51008  \u48708 \u45212 \u51008  \u51204 \u54784  \u44540 \u44144  \u50630 \u45716  \u44163 \u51060 \u50632 \u51648 \u47560 \u45716  \u44060 \u54785 \u51088 \u51032  \u47560 \u51020 \u50640 \u45716  \u53360  \u44256 \u48124 \u51060  \u50500 \u45776  \u49688  \u50630 \u50632 \u45796 . \u51652 \u47532 \u51032  \u49324 \u50629 \u51060  \u44032 \u51109  \u48708 \u50676 \u54620  \u44305 \u49888 \u51452 \u51032 \u50752  \u46041 \u51068 \u54616 \u44172  \u48372 \u51068  \u47564 \u53372  \u44032 \u52824 \u44032  \u46504 \u50612 \u51256 \u50556  \u54620 \u45796 \u45716  \u44163 \u51008  \u52280 \u51012  \u49688  \u50630 \u45716  \u51068 \u47196  \u49373 \u44033 \u46104 \u50632 \u45796 . \u45796 \u47480  \u54200 \u51004 \u47196 , \u44536  \u50868 \u46041 \u51032  \u51648 \u46020 \u51088 \u46308 \u51008  \u47336 \u53552 \u44032  \u44536 \u46308 \u51032  \u44368 \u47532 \u47484  \u48152 \u45824 \u54616 \u44256 , \u54616 \u45208 \u45784 \u51032  \u50689 \u44048 \u51012  \u48155 \u50520 \u45432 \u46972 \u44256  \u54616 \u45716  \u44536 \u46308 \u51032  \u51452 \u51109 \u51012  \u44144 \u48512 \u54624  \u49104 \u47564  \u50500 \u45768 \u46972 , \u44536 \u46308 \u51012  \u44397 \u44032 \u51032  \u44428 \u50948 \u50640  \u45824 \u54616 \u50668  \u48152 \u50669 \u54616 \u45716  \u51088 \u46972 \u44256  \u49440 \u50616 \u54620  \u44620 \u45805 \u51004 \u47196  \u44536 \u47484  \u48120 \u50892 \u54616 \u50688 \u45796 . \u44144 \u44592 \u50640  \u45824 \u54620  \u48372 \u48373 \u51004 \u47196  \u44536 \u46308 \u51008  \u47336 \u53552 \u47484  \u48708 \u50676 \u54620  \u49324 \u44592 \u44988 \u51060 \u46972 \u44256  \u48708 \u45212 \u54616 \u50688 \u45796 . \u44536 \u45716  \u47560 \u52824  \u51228 \u54980 \u46308 \u44284  \u48177 \u49457 \u46308  \u47784 \u46160 \u47196 \u48512 \u53552  \u51613 \u50724 \u47484  \u48155 \u44256  \u51080 \u45716  \u44163 \u52376 \u47100  \u48372 \u50688 \u45796 .\
\uc0\u47196 \u47560 \u44368 \u46020 \u46308 \u51008  \u44060 \u54785  \u49324 \u50629 \u51060  \u49888 \u49549 \u55176  \u47792 \u46973 \u46112  \u44163 \u51012  \u50696 \u44592 \u54616 \u44256  \u53356 \u44172  \u44592 \u48848 \u54616 \u50688 \u45796 . \u44536 \u47532 \u44256  \u44536 \u46308 \u51008  \u47336 \u53552 \u44032  \u44368 \u51221 \u49884 \u53412 \u44592  \u50948 \u54616 \u50668  \u44032 \u51109  \u50676 \u47148 \u55176  \u45432 \u47141 \u54644  \u50772 \u45912  \u50724 \u47448 \u50640  \u45824 \u54620  \u52293 \u51076 \u51012  \u44536 \u50640 \u44172  \u45934 \u50612 \u50444 \u50912 \u45796 . \u44305 \u49888 \u51201 \u51064  \u47924 \u47532 \u46308 \u51008  \u51088 \u44592 \u46308 \u51060  \u48512 \u45817 \u54620  \u45824 \u50864 \u47484  \u48155 \u44256  \u51080 \u45796 \u44256  \u44144 \u51667 \u46108  \u49440 \u51204 \u51012  \u54632 \u51004 \u47196 \u50024  \u47566 \u51008  \u48177 \u49457 \u46308 \u51032  \u46041 \u51221 \u51012  \u49324 \u45716  \u45936  \u49457 \u44277 \u54616 \u50688 \u45796 . \u51096 \u47803 \u46108  \u49345 \u54889 \u50640  \u51080 \u51004 \u47732 \u49436 \u46020  \u49324 \u46988 \u46308 \u50640 \u44172  \u49692 \u44368 \u51088 \u52376 \u47100  \u50668 \u44200 \u51648 \u45716  \u50696 \u44032  \u55124 \u55176  \u51080 \u45716  \u44163 \u52376 \u47100  \u44536  \u49324 \u46988 \u46308 \u50640 \u44172 \u46020  \u44536  \u49324 \u49892 \u51060  \u48512 \u54633 \u46104 \u50632 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44060 \u54785  \u49324 \u50629 \u51012  \u48152 \u45824 \u54616 \u45716  \u51068 \u50640  \u51652 \u47141 \u54616 \u44256  \u51080 \u45716  \u47924 \u47532 \u46308 \u51060  \u47560 \u52824  \u51092 \u54617 \u44284  \u50613 \u50517 \u51032  \u55148 \u49373 \u51088 \u52376 \u47100  \u46041 \u51221 \u44284  \u52845 \u52268 \u51012  \u48155 \u50520 \u45796 . \u51060 \u44163 \u51008  \u49324 \u45800 \u51032  \u51068 \u51060 \u50632 \u44256 , \u54616 \u45720 \u50640 \u49436  \u52376 \u51020 \u50640  \u45208 \u53440 \u45228 \u45912  \u44163 \u44284  \u46041 \u51068 \u54620  \u47784 \u48152 \u51032  \u51221 \u49888 \u50640 \u49436  \u49373 \u44200 \u45212  \u51068 \u51060 \u50632 \u45796 .\
\uc0\u49324 \u45800 \u51008  \u45130 \u51076 \u50630 \u51060  \u49324 \u46988 \u46308 \u51012  \u49549 \u51060 \u44256 \u51088  \u50528 \u50416 \u44256  \u51080 \u51004 \u47728 , \u49324 \u46988 \u46308 \u47196  \u54616 \u50668 \u44552  \u51396 \u47484  \u51032 \u47196 , \u51032 \u47484  \u51396 \u47196  \u48512 \u47476 \u46020 \u47197  \u51060 \u45132 \u44256  \u51080 \u45796 . \u44536 \u51032  \u51068 \u51008  \u50620 \u47560 \u45208  \u49457 \u44277 \u51012  \u44144 \u46160 \u50612  \u50772 \u45912 \u44032 ! \u54616 \u45208 \u45784 \u51032  \u52649 \u49457 \u46108  \u51333 \u46308 \u51008  \u51652 \u47532 \u47484  \u50745 \u54840 \u54616 \u44592  \u50948 \u54616 \u50668  \u45812 \u45824 \u55176  \u49436 \u44592  \u46412 \u47928 \u50640  \u50620 \u47560 \u45208  \u51088 \u51452  \u48708 \u45212 \u44284  \u51656 \u52293 \u51012  \u48155 \u45716 \u44032 ! \u54616 \u45208 \u45784 \u44760  \u52649 \u49457 \u54632 \u51004 \u47196  \u51025 \u45817  \u51316 \u44221 \u51012  \u48155 \u44256  \u51648 \u51648 \u47484  \u48155 \u50500 \u50556  \u54624  \u49324 \u46988 \u46308 \u51060  \u44256 \u47549 \u46104 \u44256 , \u51032 \u49900 \u44284  \u48520 \u49888 \u51012  \u48155 \u45716  \u48152 \u47732 \u50640 , \u49324 \u45800 \u51032  \u45824 \u47532 \u51088 \u50640  \u48520 \u44284 \u54620  \u49324 \u46988 \u46308 \u51008  \u52845 \u52268 \u44284  \u50689 \u44305 \u51012  \u50619 \u44256  \u49692 \u44368 \u51088 \u46308 \u52376 \u47100  \u52628 \u50521 \u51012  \u48155 \u44592 \u46020  \u54620 \u45796 .\
\uc0\u44144 \u51667 \u46108  \u49457 \u44208 , \u44263  \u50948 \u51109 \u46108  \u49457 \u54868 \u45716  \u50724 \u45720 \u45216 \u46020  \u50668 \u51204 \u55176  \u49549 \u51060 \u45716  \u51068 \u51012  \u44228 \u49549 \u54616 \u44256  \u51080 \u45796 . \u44536 \u44163 \u51008  \u47336 \u53552  \u45817 \u49884 \u50752  \u46609 \u44057 \u51008  \u51221 \u49888 \u51012  \u50668 \u47084  \u44032 \u51648  \u54805 \u53468 \u47196  \u45208 \u53440 \u45252 \u51004 \u47196  \u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u51012  \u49457 \u44221 \u50640 \u49436  \u46028 \u51060 \u53020  \u54616 \u45208 \u45784 \u51032  \u48277 \u46020 \u47484  \u49692 \u51333 \u54616 \u44592 \u48372 \u45796 \u45716  \u50724 \u55176 \u47140  \u44536 \u46308  \u51088 \u49888 \u51032  \u44048 \u51221 \u44284  \u49373 \u44033 \u51012  \u46384 \u47476 \u46020 \u47197  \u51060 \u45132 \u44256  \u51080 \u45796 . \u51060 \u44163 \u51008  \u51652 \u47532 \u50752  \u49692 \u44208 \u51060  \u48708 \u45212 \u51012  \u48155 \u46020 \u47197  \u54616 \u44256 \u51088  \u49324 \u45800 \u51060  \u44256 \u50504 \u54644  \u45240  \u44032 \u51109  \u49457 \u44277 \u51201 \u51064  \u44163  \u51473 \u51032  \u54616 \u45208 \u51060 \u45796 .\
\uc0\u47336 \u53552 \u45716  \u44033  \u48169 \u47732 \u50640 \u49436  \u48128 \u47140 \u50724 \u45716  \u44277 \u44201 \u51004 \u47196 \u48512 \u53552  \u50857 \u44048 \u54616 \u44172  \u48373 \u51020 \u51012  \u50745 \u54840 \u54616 \u50688 \u45796 . \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51008  \u50612 \u46496 \u54620  \u51204 \u53804 \u50640 \u49436 \u45208  \u44053 \u47141 \u54620  \u47924 \u44592 \u47196  \u54032 \u47749 \u46104 \u50632 \u45796 . \u44536 \u45716  \u44536  \u47568 \u50432 \u51012  \u44032 \u51648 \u44256  \u48277 \u50773 \u51032  \u52280 \u46988 \u46108  \u44428 \u47141 \u44284  \u54617 \u51088 \u46308 \u51032  \u51060 \u47200 \u51201 \u51064  \u52384 \u54617 \u51012  \u45824 \u54637 \u54616 \u50668  \u49912 \u50912 \u44256 , \u54620 \u54200 \u51004 \u47196  \u51333 \u44368 \u44060 \u54785 \u44284  \u50672 \u54633 \u54616 \u47140 \u44256  \u51217 \u44540 \u54616 \u45716  \u44305 \u49888 \u51452 \u51032 \u50640  \u45824 \u54637 \u54616 \u50668  \u48152 \u49437 \u52376 \u47100  \u44403 \u44172  \u49456 \u45796 .\
\uc0\u44536  \u47784 \u46304  \u48152 \u45824 \u51088 \u46308 \u51008  \u49457 \u44221 \u51012  \u48260 \u47532 \u44256  \u49324 \u46988 \u51032  \u51648 \u54812 \u47484  \u51333 \u44368 \u51201  \u51652 \u47532 \u50752  \u51648 \u49885 \u51032  \u44540 \u50896 \u51004 \u47196  \u45458 \u50688 \u45796 . \u54633 \u47532 \u51452 \u51032  (\u21512 \u29702 \u20027 \u32681 ) \u45716  \u51060 \u49457 \u51012  \u50864 \u49345 \u54868 \u54616 \u44256 , \u44536 \u44163 \u51012  \u51333 \u44368 \u51032  \u44592 \u51456 \u51004 \u47196  \u49340 \u45716 \u45796 . \u47196 \u47560 \u44368 \u45716  \u52572 \u49345 \u44428 \u51012  \u44032 \u51652  \u48277 \u50773 \u51060  \u49324 \u46020 \u46308 \u47196 \u48512 \u53552  \u45130 \u51076 \u50630 \u51060  \u44228 \u53685 \u51012  \u46384 \u46972  \u44033  \u49884 \u45824 \u47484  \u53685 \u54616 \u50668  \u48320 \u54632 \u50630 \u51060  \u45236 \u47140 \u50728  \u50689 \u44048 \u51012  \u44032 \u51648 \u44256  \u51080 \u45432 \u46972 \u44256  \u51452 \u51109 \u54632 \u51004 \u47196 , \u50668 \u47084  \u44032 \u51648  \u48169 \u51333 \u44284  \u48512 \u54056 \u44032  \u49324 \u46020 \u51032  \u51649 \u44428 \u51060 \u46972 \u45716  \u49888 \u49457 \u54620  \u51060 \u47492  \u50500 \u47000  \u49704 \u50612  \u51080 \u51012  \u49688  \u51080 \u45716  \u52649 \u48516 \u54620  \u44592 \u54924 \u47484  \u51456 \u45796 . \u48012 \u52376 \u50752  \u44536  \u46041 \u47308 \u46308 \u51060  \u48155 \u50520 \u45432 \u46972 \u44256  \u51452 \u51109 \u54620  \u49548 \u50948  \u50689 \u44048 \u51008  \u44536  \u44540 \u50896 \u51060  \u47581 \u49345 \u51201 \u51064  \u44277 \u49345 \u50640  \u48520 \u44284 \u54616 \u50688 \u44256 , \u44536  \u50689 \u54693 \u51004 \u47196  \u51064 \u44036 \u44284  \u54616 \u45208 \u45784 \u51032  \u47784 \u46304  \u44428 \u50948 \u44032  \u54028 \u44340 \u46104 \u50632 \u45796 . \u44536 \u47084 \u45208  \u52280 \u46108  \u44536 \u47532 \u49828 \u46020 \u44368 \u45716  \u54616 \u45208 \u45784 \u51032  \u47568 \u5043