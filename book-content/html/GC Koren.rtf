\f1\b0 \cf0 \
\uc0\u50528 \u44413 \u51032  \u49549 \u48149 \u50640 \u49436  \u48177 \u49457 \u46308 \u51012  \u44396 \u50896 \u54644  \u45236 \u49892  \u46412 \u50640  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u45576 \u50640  \u48372 \u51060 \u51648  \u50500 \u45768 \u54616 \u45716  \u51648 \u46020 \u51088 \u44032  \u46104 \u49512 \u45912  \u44163 \u52376 \u47100  \u49324 \u45800 \u51008  \u47924 \u49688 \u54620  \u49692 \u44368 \u51088 \u47484  \u45236 \u45716  \u47924 \u49436 \u50868  \u51068 \u50640  \u51080 \u50612 \u49436  \u44536 \u51032  \u48512 \u54616 \u46308 \u51012  \u51648 \u55064 \u54616 \u45716  \u45576 \u50640  \u48372 \u51060 \u51648  \u50500 \u45768 \u54616 \u45716  \u51648 \u46020 \u51088 \u44032  \u46104 \u50632 \u45796 . \u54617 \u49332 \u51008  \u54028 \u47532 \u50640 \u49436  7\u51068 \u44036  \u44228 \u49549 \u46104 \u50632 \u45716 \u45936 , \u52572 \u52488 \u51032  3\u51068 \u44036 \u51008  \u53945 \u55176  \u44305 \u54252 \u44032  \u49345 \u49345 \u54624  \u49688  \u50630 \u51012  \u51221 \u46020 \u47196  \u49900 \u54664 \u45796 . \u44536 \u47532 \u44256  \u44536  \u51068 \u51008  \u50773 \u51032  \u53945 \u47749 \u50640  \u51032 \u54616 \u50668  \u54028 \u47532  \u49884 \u44032 \u50640 \u47564  \u44397 \u54620 \u46104 \u51648  \u50506 \u44256 , \u49888 \u44368 \u46020 \u46308 \u51060  \u44144 \u51452 \u54616 \u45716  \u47784 \u46304  \u46020 \u49884 \u50752  \u52492 \u46973 \u50640 \u44620 \u51648  \u54140 \u51256  \u45208 \u44052 \u45796 . \u44536  \u51068 \u51008  \u50672 \u47161 \u44284  \u49457 \u48324 \u51012  \u44396 \u48324 \u54616 \u51648  \u50506 \u50520 \u45796 . \u52380 \u51652 \u54620  \u50612 \u47536 \u50500 \u51060 \u46308 \u44284  \u48177 \u48156 \u45432 \u51064 \u46020  \u44032 \u47532 \u51648  \u50506 \u50520 \u45796 . \u44480 \u51313 \u44284  \u45453 \u48512 , \u45432 \u51064 \u44284  \u52397 \u45380 , \u50612 \u47672 \u45768 \u50752  \u50500 \u51060 , \u44536  \u47784 \u46304  \u49324 \u46988 \u46308 \u51012  \u54632 \u44760  \u49332 \u50977 \u54616 \u50688 \u45796 . \u54532 \u46993 \u49828  \u51204 \u44397 \u50640 \u49436  \u54617 \u49332 \u51060  2\u44060 \u50900 \u44036  \u44228 \u49549 \u46104 \u50632 \u45796 . \u44536 \u47532 \u54616 \u50668  \u48148 \u47196  \u44397 \u44032 \u51032  \u44867 \u51060 \u46972 \u44256  \u54624  \u49688  \u51080 \u45716  \u49324 \u46988 \u46308 \u51060  7\u47564  \u47749 \u51060 \u45208  \u51453 \u50632 \u45796 .\
\'93\uc0\u54617 \u49332 \u51032  \u48372 \u46020 \u44032  \u47196 \u47560 \u50640  \u51060 \u47476 \u51088  \u49457 \u51649 \u51088 \u46308 \u51032  \u44592 \u49256 \u51008  \u54620 \u51060  \u50630 \u50632 \u45796 . \u47196 \u47116 \u51032  \u52628 \u44592 \u44221 \u51008  \u44536  \u49324 \u51088 \u50640 \u44172  1\u52380  \u53356 \u46972 \u50868 \u51012  \u49345 \u44553 \u51004 \u47196  \u51452 \u50632 \u44256 , \u49457  \u50504 \u51236 \u47196 \u50640 \u49436 \u45716  \u52629 \u54252 \u47484  \u50136 \u50520 \u44256 , \u47784 \u46304  \u44368 \u54924 \u51032  \u52392 \u53457 \u50640 \u49436 \u45716  \u51333 \u49548 \u47532 \u44032  \u50872 \u47140  \u54140 \u51276 \u44256 , \u52629 \u54868  (\u31069 \u28779 ) \u45716  \u48164 \u49352 \u46020 \u47197  \u44732 \u51648 \u51648  \u50506 \u50520 \u45796 . \u48277 \u50773  \u44536 \u47112 \u44256 \u47532 \u50864 \u49828  13\u49464 \u45716  \u52628 \u44592 \u44221 \u44284  \u51473 \u50836 \u54620  \u49849 \u47140 \u46308 \u51012  \u45936 \u47532 \u44256  \u53360  \u54665 \u47148 \u51012  \u51648 \u50612  \u49457  \u47336 \u51060 \u51032  \u44368 \u45817 \u51004 \u47196  \u44052 \u45716 \u45936 , \u44536  \u44275 \u50640 \u49436  \u47196 \u47116 \u51032  \u52628 \u44592 \u44221 \u51060  \u53580  \u45936 \u50880  (Te Deum) \u51012  \u45229 \u49569 \u54664 \u45796 . \'85\u46608  \u51060  \u54617 \u49332 \u51012  \u44592 \u45392 \u54616 \u45716  \u47700 \u45804 \u51060  \u51452 \u51312 \u46104 \u50632 \u44256 , \u48148 \u54000 \u52856  \u44417 \u51204 \u50640 \u49436 \u45716  \u48148 \u49324 \u47532  (Vasari) \u51032  \u49564 \u50472 \u47196  \u49437  \u51109 \u51032  \u48317 \u54868 , \u44263  \u51228 \u46021  (\u25552 \u30563 ) \u51012  \u49845 \u44201 \u54616 \u45716  \u51109 \u47732 , \u54617 \u49332 \u51012  \u51020 \u47784 \u54616 \u45716  \u54924 \u51032 \u50640  \u52280 \u49437 \u54616 \u44256  \u51080 \u45716  \u50773 , \u49892 \u51228 \u47196  \u54617 \u49332 \u51012  \u54616 \u44256  \u51080 \u45716  \u51109 \u47732 \u46308 \u51060  \u44536 \u47140 \u51276 \u45796 . \u44536 \u47112 \u44256 \u47532 \u50864 \u49828  \u48277 \u50773 \u51008  \u52852 \u50508  \u54889 \u51228 \u50640 \u44172  \u54889 \u44552  \u51109 \u48120 \u47484  \u48372 \u45256 \u51004 \u47728 ,\'85\u44536  \u54617 \u49332  4\u44060 \u50900  \u54980 \u50640 \'85\u44536 \u45716  \u54620  \u54532 \u46993 \u49828  \u49888 \u48512 \u51032  \u49444 \u44368 \u47484  \u47564 \u51313 \u54620  \u47560 \u51020 \u51004 \u47196  \u46308 \u50632 \u45796 . \'85\u44536  \u49888 \u48512 \u45716  \u44536  \u54617 \u49332 \u51032  \u45216 \u50640  \u44288 \u54616 \u50668  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u54616 \u50688 \u45796 . \'91\u44536 \u45216 \u50640  \u44032 \u51109  \u44144 \u47337 \u54620  \u49888 \u48512  (\u31070 \u29238 ) \u44032  \u47924 \u54620 \u54620  \u54665 \u48373 \u44284  \u44592 \u49256 \u51004 \u47196  \u48372 \u44256 \u47484  \u48155 \u51004 \u47728 , \u44536 \u45716  \u50948 \u50628 \u51012  \u44054 \u52628 \u44256  \u54616 \u45208 \u45784 \u44284  \u49457  \u47336 \u51060 \u50640 \u44172  \u44048 \u49324 \u47484  \u46300 \u47532 \u44256 \u51088  \u45208 \u50500 \u44052 \u45796 .\'92\'94 (Henry White, The Massacre of St.Bartholomew, ch.14, Par.34).\
\uc0\u49457  \u48148 \u46028 \u47196 \u47588  \u45824 \u54617 \u49332 \u51012  \u54616 \u46020 \u47197  \u52649 \u46041 \u54620  \u48148 \u47196  \u44536  \u51221 \u49888 \u51008  \u54532 \u46993 \u49828  \u54785 \u47749 \u50640 \u46020  \u45208 \u53440 \u45228 \u45796 . \u50696 \u49688  \u44536 \u47532 \u49828 \u46020 \u47484  \u49324 \u44592 \u44988 \u51004 \u47196  \u49440 \u50616 \u54616 \u44256 , \u54532 \u46993 \u49828 \u51032  \u47924 \u49888 \u47200 \u51088 \u46308 \u51008  \u49548 \u47532 \u47484  \u45458 \u50668  \'93\u50684 \u52824  \u50630 \u45716  \u51088 \u47484  \u48149 \u47736 \u54616 \u51088 \'94\u44256  \u48512 \u47476 \u51670 \u50632 \u45716 \u45936 , \u44536 \u44163 \u51008  \u44536 \u47532 \u49828 \u46020 \u47484  \u44032 \u47532 \u53416  \u44163 \u51060 \u50632 \u45796 . \u54616 \u45720 \u51012  \u46160 \u47140 \u50892 \u54616 \u51648  \u50500 \u45768 \u54616 \u45716  \u45824 \u45812 \u54620  \u47784 \u46021 \u44284  \u44032 \u51613 \u54620  \u50501 \u51060  \u49436 \u47196  \u49552 \u51012  \u47582 \u51105 \u50520 \u51004 \u47728 , \u44032 \u51109  \u48708 \u47336 \u54620  \u51064 \u47932 , \u51092 \u51064 \u54616 \u44256  \u49324 \u50501 \u54616 \u44592  \u45908 \u54624 \u45208 \u50948  \u50630 \u45716  \u51088 , \u48708 \u51064 \u46020 \u51201 \u51064  \u51088 \u46308 \u51060  \u47924 \u54620 \u54620  \u51316 \u44221 \u51012  \u48155 \u44172  \u46104 \u50632 \u45796 . \u51060 \u47084 \u54620  \u47784 \u46304  \u51068 \u50640  \u51080 \u50612 \u49436  \u49324 \u45800 \u50640 \u44172  \u52572 \u44256 \u51032  \u51316 \u44221 \u51060  \u51452 \u50612 \u51276 \u45796 . \u44536 \u50752  \u48152 \u47732 \u50640  \u51652 \u47532 \u50752  \u49692 \u44208 \u44284  \u51060 \u53440 \u51201  \u49324 \u46993 \u51004 \u47196  \u53945 \u51669 \u51648 \u50612  \u51080 \u45716  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u49901 \u51088 \u44032 \u50640  \u47803  \u48149 \u55176 \u49512 \u45796 .\
