\uc0\u44053 \u49888 \u49696 \u51008  \u44368 \u50577  \u51080 \u44256  \u51648 \u51201 \u51064  \u49324 \u46988 \u46308 \u51012  \u49345 \u45824 \u47196  \u54624  \u46412 \u48372 \u45796  \u48169 \u53461 \u54616 \u44256  \u54693 \u46973 \u51201 \u51060 \u44256  \u50977 \u50837 \u51201 \u51064  \u49324 \u46988 \u46308 \u51012  \u49345 \u45824 \u54624  \u46412 \u50640 \u45716  \u44368 \u47896 \u54620  \u49688 \u45800 \u51012  \u45916  \u50416 \u45908 \u46972 \u46020  \u44536 \u44163 \u51012  \u45208 \u53440 \u45244  \u49688  \u51080 \u45796 . \u44536 \u46308 \u51008  \u44053 \u49888 \u49696 \u51032  \u51200 \u49549 \u54616 \u44256  \u50556 \u48708 \u54620  \u54805 \u53468  \u44032 \u50868 \u45936 \u49436  \u44536 \u46308 \u51032  \u49457 \u54693 \u50640  \u51068 \u52824 \u54616 \u45716  \u44163 \u51012  \u48156 \u44204 \u54620 \u45796 . \u49324 \u45800 \u51008  \u51064 \u44036 \u49457 \u51032  \u47784 \u46304  \u50672 \u50557 \u54620  \u49345 \u53468 \u47484  \u50672 \u44396 \u54616 \u50668  \u44033  \u49324 \u46988 \u51060  \u48276 \u54616 \u44592  \u49772 \u50868  \u51396 \u47484  \u52286 \u50500 \u45236 \u44256  \u50501 \u51004 \u47196  \u44592 \u50872 \u50612 \u51648 \u45716  \u44221 \u54693 \u51012  \u47564 \u51313 \u49884 \u53420  \u49688  \u51080 \u45716  \u44592 \u54924 \u44032  \u45130 \u50612 \u51648 \u51648  \u50506 \u44172  \u54616 \u47140 \u44256  \u50528 \u50420 \u45796 . \u44536 \u45716  \u49324 \u46988 \u46308 \u51060  \u54633 \u48277 \u51201 \u51064  \u51068 \u50640  \u51080 \u50612 \u49436 \u46020  \u44284 \u46020 \u55176  \u54665 \u54616 \u44172  \u54632 \u51004 \u47196 \u50024  \u48512 \u51208 \u51228 \u47484  \u53685 \u54616 \u50668  \u50977 \u52404 \u51201 \'b7\u51221 \u49888 \u51201 \'b7\u50689 \u51201  \u55192 \u51012  \u50557 \u54868 \u49884 \u53412 \u46020 \u47197  \u50976 \u54841 \u54620 \u45796 . \u44536 \u45716  \u51221 \u50837 \u51032  \u48169 \u51333 \u51012  \u53685 \u54616 \u50668  \u49688 \u47566 \u51008  \u49324 \u46988 \u46308 \u510