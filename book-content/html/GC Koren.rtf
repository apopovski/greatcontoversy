\uc0\u48520 \u54665 \u54620  \u54532 \u46993 \u49828 \u45716  \u51088 \u49888 \u51060  \u49900 \u51008  \u50472 \u50519 \u51012  \u54588 \u47196 \u50024  \u44144 \u46160 \u50632 \u45796 . \u54532 \u46993 \u49828 \u44032  \u47196 \u47560 \u44368 \u51032  \u51648 \u48176 \u54616 \u50640  \u48373 \u51333 \u54620  \u44208 \u44284 \u45716  \u46160 \u47140 \u50868  \u44163 \u51060 \u50632 \u45796 . \u54532 \u46993 \u49828 \u44032  \u47196 \u47560 \u51032  \u50689 \u54693 \u51012  \u48155 \u50500  \u51333 \u44368 \u44060 \u54785 \u51032  \u52488 \u44592 \u50640  \u52572 \u52488 \u51032  \u54868 \u54805 \u51452 \u47484  \u49464 \u50912 \u45912  \u44536  \u44275 \u50640  \u54532 \u46993 \u49828 \u51032  \u54785 \u47749 \u45817 \u46308 \u51008  \u52572 \u52488 \u51032  \u45800 \u46160 \u45824 \u47484  \u49464 \u50912 \u45796 . 16\u49464 \u44592 \u50640  \u44060 \u49888 \u44368 \u51032  \u49888 \u50521 \u51012  \u44032 \u51652  \u52572 \u52488 \u51032  \u49692 \u44368 \u51088 \u46308 \u51060  \u54868 \u54805 \u51012  \u48155 \u50520 \u45912  \u48148 \u47196  \u44536  \u51109 \u49548 \u50640 \u49436  18\u49464 \u44592 \u50640 \u45716  \u52572 \u52488 \u51032  \u55148 \u49373 \u51088 \u46308 \u51060  \u45800 \u46160 \u45824 \u51032  \u51060 \u49836 \u47196  \u49324 \u46972 \u51276 \u45796 . \u54532 \u46993 \u49828 \u45716  \u51088 \u44592  \u45208 \u46972 \u47484  \u52824 \u47308 \u54644  \u51460  \u48373 \u51020 \u51012  \u48176 \u52377 \u54616 \u50688 \u44592  \u46412 \u47928 \u50640  \u47924 \u49888 \u47200 \u44284  \u47736 \u47581 \u51004 \u47196  \u51064 \u46020 \u54616 \u45716  \u47928 \u51012  \u50676 \u50632 \u45796 . \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51032  \u51228 \u51116 \u47484  \u47924 \u49884 \u54644  \u48260 \u47540  \u46412  \u51064 \u44036 \u51032  \u48277 \u47456 \u51008  \u51064 \u44036 \u51032  \u51221 \u50837 \u51060 \u46972 \u45716  \u44053 \u47141 \u54620  \u47932 \u44208 \u51012  \u51228 \u50612 \u54624  \u49688  \u50630 \u45796 \u45716  \u44163 \u51060  \u47749 \u48177 \u55176  \u51077 \u51613 \u46104 \u50632 \u45796 . \u44536 \u47532 \u54616 \u50668  \u54532 \u46993 \u49828 \u45716  \u48152 \u46976 \u44284  \u47924 \u51221 \u48512  \u49345 \u53468 \u47196  \u55081 \u50424 \u47140  \u46308 \u50612 \u44052 \u45796 . \u49457 \u44221 \u50640  \u45824 \u54620  \u53804 \u51137 \u51008  \u49464 \u44228  \u50669 \u49324 \u50640 \u49436  \u44277 \u54252  \u49884 \u45824 \u46972 \u45716  \u46748 \u47159 \u54620  \u54620  \u49884 \u45824 \u47484  \u52488 \u47000 \u54616 \u50688 \u45796 . \u49324 \u46988 \u51032  \u44032 \u51221 \u44284  \u47560 \u51020 \u50640 \u49436  \u54217 \u54868 \u50752  \u54665 \u48373 \u51060  \u49324 \u46972 \u51276 \u45796 . \u50504 \u51204 \u54620  \u49324 \u46988 \u51008  \u54620  \u49324 \u46988 \u46020  \u50630 \u50632 \u45796 . \u50724 \u45720 \u51032  \u49849 \u47532 \u51088 \u44032  \u45236 \u51068 \u50640 \u45716  \u54800 \u51032 \u47484  \u48155 \u44256  \u51221 \u51396 \u47484  \u48155 \u50520 \u45796 . \u54252 \u50501 \u44284  \u51020 \u46976 \u51060  \u44537 \u46020 \u50640  \u45804 \u54616 \u50688 \u45796 .\
\uc0\u50773 \u44284  \u49457 \u51649 \u51088 \u46308 \u44284  \u44480 \u51313 \u46308 \u51008  \u55141 \u48516 \u54616 \u44256  \u48120 \u52432 \u49436  \u45216 \u46832 \u45716  \u44400 \u51473 \u46308 \u51032  \u51092 \u50501 \u47924 \u46020 \u54620  \u54665 \u46041 \u50640  \u44404 \u48373 \u54616 \u51648  \u50506 \u51012  \u49688  \u50630 \u50632 \u45796 . \u48373 \u49688 \u54616 \u44256 \u51088  \u44040 \u47581 \u54616 \u45716  \u44536 \u46308 \u51008  \u50773 \u51012  \u52376 \u54805 \u54632 \u51004 \u47196  \u54620 \u52789  \u45908  \u51088 \u44537 \u46104 \u50632 \u45796 . \u44536 \u47532 \u44256  \u50773 \u50640 \u44172  \u49324 \u54805  \u49440 \u44256 \u47484  \u45236 \u47536  \u51088 \u46308 \u46020  \u50724 \u47000 \u51648  \u50506 \u50500 \u49436  \u50773 \u51032  \u46244 \u47484  \u51060 \u50612  \u45800 \u46160 \u45824 \u47196  \u45132 \u47140 \u44052 \u45796 . \u54785 \u47749 \u51012  \u48152 \u45824 \u54616 \u45716  \u44163 \u51004 \u47196  \u54800 \u51032 \u47484  \u48155 \u51008  \u51088 \u46308 \u51008  \u45796  \u49332 \u50977 \u46104 \u50632 \u45796 . \u44048 \u50725 \u46308 \u51008  \u47564 \u50896 \u51060  \u46104 \u50632 \u45716 \u45936  \u54620  \u46412 \u45716  20\u47564  \u47749  \u51060 \u49345 \u51032  \u44160 \u44144 \u51088 \u46308 \u51060  \u49688 \u50857 \u46104 \u50632 \u45796 . \u44397 \u45236 \u51032  \u44033  \u46020 \u49884 \u50640  \u47924 \u49436 \u50868  \u49324 \u44148 \u46308 \u51060  \u51068 \u50612 \u45228 \u45796 . \u54785 \u47749 \u51452 \u51032 \u51088 \u46308 \u51032  \u54620  \u45817 \u51060  \u45796 \u47480  \u45817 \u44284  \u49912 \u50864 \u48064 \u47196  \u54532 \u46993 \u49828 \u45716  \u46300 \u46356 \u50612  \u54616 \u45208 \u51032  \u52964 \u45796 \u46976  \u49688 \u46972 \u51109 \u51060  \u46104 \u50612  \u48260 \u47532 \u44256  \u47568 \u50520 \u45796 . \u49436 \u47196  \u49912 \u50864 \u45716  \u44400 \u51473 \u46308 \u51032  \u48516 \u45432 \u50752  \u44201 \u51221 \u51008  \u50728  \u49464 \u49345 \u51012  \u55124 \u46308 \u50612  \u45459 \u50520 \u45796 . \'93\u54028 \u47532 \u50640 \u49436 \u45716  \u49548 \u46041 \u51060  \u46244 \u47484  \u51060 \u50612  \u51068 \u50612 \u45228 \u44256 , \u49884 \u48124 \u46308 \u51008  \u50668 \u47084  \u45817 \u54028 \u47196  \u45208 \u45572 \u50612 \u51256 \u49436  \u54588 \u52264 \u50640  \u49436 \u47196  \u47932 \u44256  \u46895 \u45716  \u51068 \u48150 \u50640  \u50500 \u47924 \u44163 \u46020  \u50630 \u45716  \u46319 \u51060  \u48372 \u50688 \u45796 .\'94 \u50728  \u45208 \u46972 \u44032  \u51060 \u50752  \u44057 \u51008  \u52280 \u49345 \u51012  \u45817 \u54620  \u50808 \u50640 \u46020  \u44396 \u46972 \u54028 \u51032  \u50676 \u44053 \u46308 \u51012  \u49345 \u45824 \u47196  \u50724 \u47019 \u46041 \u50504  \u54889 \u54224 \u52992  \u54616 \u45716  \u51204 \u51137 \u50640  \u55064 \u47568 \u47140  \u46308 \u50632 \u45796 . \'93\u45208 \u46972 \u45716  \u44144 \u51032  \u54028 \u47736  \u49345 \u53468 \u50640  \u51060 \u47476 \u47104 \u44256 , \u44400 \u51064 \u46308 \u51008  \u44553 \u47308 \u51032  \u51648 \u48520 \u51060  \u51648 \u50672 \u46120 \u51004 \u47196  \u49548 \u46041 \u54616 \u50688 \u44256 , \u54028 \u47532  \u49884 \u48124 \u46308 \u51008  \u44406 \u50612  \u51453 \u50612 \u44052 \u51004 \u47728 , \u44033  \u51648 \u48169 \u46308 \u51008  \u48708 \u51201 \u46308 \u47196  \u47568 \u48120 \u50516 \u50500  \u54889 \u54224 \u46104 \u50632 \u44256 , \u47928 \u54868 \u45716  \u47924 \u51221 \u48512  \u49345 \u53468 \u50752  \u48177 \u49457 \u46308 \u51032  \u48169 \u51333 \u51004 \u47196  \u44144 \u51032  \u49324 \u46972 \u51656  \u51648 \u44221 \u44620 \u51648  \u46104 \u50632 \u45796 .\'94\
