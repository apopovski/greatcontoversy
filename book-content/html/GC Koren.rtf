\uc0\u47336 \u49828 \u48296 \u51008  \u54616 \u45208 \u45784  \u47732 \u51204 \u50640  \u51080 \u45716  \u51088 \u44592  \u50948 \u52824 \u47484  \u46496 \u45208  \u52380 \u49324 \u46308  \u49324 \u51060 \u50640  \u48520 \u54217 \u51032  \u51221 \u49888 \u51012  \u54140 \u46888 \u47532 \u44256 \u51088  \u45208 \u44052 \u45796 . \u44536 \u45716  \u50620 \u47560 \u46041 \u50504  \u51088 \u44592 \u51032  \u52280  \u47785 \u51201 \u51012  \u44048 \u52628 \u44256  \u54616 \u45208 \u45784 \u51012  \u51316 \u44221 \u54616 \u45716  \u44163 \u52376 \u47100  \u44032 \u51109 \u54616 \u50668  \u51008 \u48128 \u54620  \u48169 \u48277 \u51004 \u47196  \u54876 \u46041 \u54664 \u45796 . \u44536 \u45716  \u54616 \u45720  \u44144 \u48124 \u46308 \u51012  \u53685 \u51228 \u54616 \u45716  \u48277 \u52825 \u51060  \u54596 \u50836  \u50630 \u45716  \u44396 \u49549 \u51012  \u44284 \u54616 \u45716  \u44163 \u51060 \u46972 \u44256  \u50516 \u49884 \u54632 \u51004 \u47196 \u50024  \u44144 \u44592 \u50640  \u45824 \u54620  \u48520 \u47564 \u51012  \u51088 \u44537 \u54616 \u44256 \u51088  \u45432 \u47141 \u54616 \u50688 \u45796 . \u44536 \u45716  \u52380 \u49324 \u46308 \u51032  \u48376 \u49457 \u51008  \u49457 \u44208 \u54616 \u48064 \u47196  \u44536 \u46308 \u51008  \u51088 \u44592  \u51088 \u49888 \u51032  \u51032 \u51648 \u44032  \u51648 \u49884 \u54616 \u45716  \u45824 \u47196  \u46384 \u46972 \u50556  \u54620 \u45796 \u44256  \u51452 \u51109 \u54616 \u50688 \u45796 . \u44536 \u45716  \u54616 \u45208 \u45784 \u44760 \u49436  \u44536 \u47532 \u49828 \u46020 \u50640 \u44172  \u52572 \u49345 \u51032  \u50689 \u44305 \u51012  \u51452 \u49900 \u51004 \u47196 \u50024  \u51088 \u44592 \u47484  \u48520 \u44277 \u54217 \u54616 \u44172  \u52712 \u44553 \u54616 \u49512 \u45796 \u44256  \u51452 \u51109 \u54632 \u51004 \u47196  \u46041 \u51221 \u51012  \u50619 \u44256 \u51088  \u45432 \u47141 \u54616 \u50688 \u45796 . \u44536 \u45716  \u51088 \u44592 \u44032  \u45908 \u50865  \u53360  \u44428 \u49464