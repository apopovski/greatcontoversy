\f0\b \cf0 \uc0\u51068 \u50836 \u51068  \u55092 \u50629 \u47161 \u51032  \u48376 \u51656 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u50504 \u49885 \u51068 \u51012  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u48320 \u44221 \u54616 \u49888  \u44163 \u52376 \u47100  \u55124 \u55176  \u51452 \u51109 \u54616 \u45716 \u45936 , \u44536 \u47084 \u54620  \u51452 \u51109 \u51032  \u44536 \u47495 \u46120 \u51008  \u44536 \u47532 \u49828 \u46020  \u51088 \u49888 \u51032  \u47568 \u50432 \u51004 \u47196  \u51613 \u47749 \u46108 \u45796 . \u51452  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u49328 \u49345  \u49444 \u44368 \u50640 \u49436  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u50432 \u54616 \u49512 \u45796 . \'93\u45236 \u44032  \u50984 \u48277 \u51060 \u45208  \u49440 \u51648 \u51088 \u45208  \u54224 \u54616 \u47084  \u50728  \u51460 \u47196  \u49373 \u44033 \u51648  \u47568 \u46972  \u54224 \u54616 \u47084  \u50728  \u44163 \u51060  \u50500 \u45768 \u50836  \u50756 \u51204 \u52992  \u54616 \u47140  \u54632 \u51060 \u47196 \u46972  \u51652 \u49892 \u47196  \u45320 \u55148 \u50640 \u44172  \u51060 \u47476 \u45432 \u45768  \u52380 \u51648 \u44032  \u50630 \u50612 \u51648 \u44592  \u51204 \u50640 \u45716  \u50984 \u48277 \u51032  \u51068 \u51216 \u51068 \u54925 \u51060 \u46972 \u46020  \u48152 \u46300 \u49884  \u50630 \u50612 \u51648 \u51648  \u50500 \u45768 \u54616 \u44256  \u45796  \u51060 \u47336 \u47532 \u46972  \u44536 \u47084 \u48064 \u47196  \u45572 \u44396 \u46304 \u51648  \u51060  \u44228 \u47749  \u51473 \u50640  \u51648 \u44537 \u55176  \u51089 \u51008  \u44163  \u54616 \u45208 \u46972 \u46020  \u48260 \u47532 \u44256  \u46608  \u44536 \u44057 \u51060  \u49324 \u46988 \u51012  \u44032 \u47476 \u52824 \u45716  \u51088 \u45716  \u52380 \u44397 \u50640 \u49436  \u51648 \u44537 \u55176  \u51089 \u45796  \u51068 \u52972 \u51020 \u51012  \u48155 \u51012  \u44163 \u51060 \u50836  \u45572 \u44396 \u46304 \u51648  \u51060 \u47484  \u54665 \u54616 \u47728  \u44032 \u47476 \u52824 \u45716  \u51088 \u45716  \u52380 \u44397 \u50640 \u49436  \u53356 \u45796  \u51068 \u52972 \u51020 \u51012  \u48155 \u51004 \u47532 \u46972 \'94 (\u47560  5:17~19).\
\uc0\u50504 \u49885 \u51068 \u51032  \u48320 \u44221 \u50640  \u44288 \u54616 \u50668  \u49457 \u44221 \u49345  \u44540 \u44144 \u44032  \u51204 \u54784  \u50630 \u45796 \u45716  \u44163 \u51008  \u44060 \u49888 \u44368 \u46020 \u46308 \u51060  \u51068 \u48152 \u51201 \u51004 \u47196  \u49884 \u51064 \u54616 \u45716  \u49324 \u49892 \u51060 \u45796 . \u48120 \u44397  \u51204 \u46020  \u47928 \u49436  \u54801 \u54924 \u50752  \u48120 \u44397  \u51452 \u51068  \u54617 \u44368  \u50672 \u47609 \u50640 \u49436  \u48156 \u54665 \u54620  \u52636 \u54032 \u47932 \u46308 \u50640 \u45716  \u44536  \u49324 \u49892 \u51060  \u48516 \u47749 \u55176  \u48157 \u54784 \u51256  \u51080 \u45796 . \u44536  \u51473 \u51032  \u54620  \u52293 \u51008  \'93\u49888 \u50557  \u49457 \u44221 \u50640 \u45716  \u50504 \u49885 \u51068  [\u51068 \u50836 \u51068 , \u51452 \u51068  \u51473  \u52395 \u51704  \u45216 ]\u50640  \u45824 \u54616 \u50668  \u50500 \u47924 \u47088  \u48516 \u47749 \u54620  \u47749 \u47161 \u51060  \u50630 \u44256 , \u44536 \u45216 \u51012  \u51648 \u53412 \u45716  \u51068 \u50640  \u45824 \u54616 \u50668  \u54869 \u49892 \u54620  \u44508 \u51221 \u46020  \u51204 \u54784  \u44592 \u47197 \u46104 \u50612  \u51080 \u51648  \u50506 \u45796 \'94 (George Elliott, The Abiding Sabbath, p.184) \u44256  \u47568 \u54616 \u50688 \u45796 .\
\uc0\u46608  \u45796 \u47480  \u54620  \u52293 \u50640 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u44592 \u47197 \u46104 \u50612  \u51080 \u45796 . \'93\u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u46028 \u50500 \u44032 \u49884 \u44592 \u44620 \u51648 \u45716  \u44536 \u45216  (\u50504 \u49885 \u51068 \u51012  \u44032 \u47532 \u53428 ) \u50640  \u44288 \u54616 \u50668  \u50500 \u47924 \u47088  \u48320 \u44221 \u46020  \u50630 \u50632 \u45796 . \u46608  \u49457 \u44221 \u51032  \u44592 \u47197 \u50640  \u51032 \u54616 \u47732  \u49324 \u46020 \u46308 \u51060  \u51228 \u52832 \u51068  \u50504 \u49885 \u51068 \u51012  \u54224 \u51648 \u54616 \u44256 , \u44536  \u45824 \u49888 \u50640  \u51452 \u51068  \u51473  \u52395 \u51704  \u45216 \u51012  \u51648 \u53412 \u46972 \u44256  \u47749 \u47161 \u54620  \u50500 \u47924  \u54869 \u49892 \u54620  \u47568 \u46020  \u54620  \u51068 \u51060  \u50630 \u45796 \'94 (A.E.Waffle, The Lord\'92s Day, pp.186~188).\
\uc0\u47196 \u47560  \u52380 \u51452 \u44368 \u45716  \u44536 \u46308 \u51032  \u44368 \u54924 \u44032  \u50504 \u49885 \u51068 \u51012  \u48320 \u44221 \u49884 \u53040 \u45796 \u45716  \u49324 \u49892 \u51012  \u49884 \u51064 \u54616 \u47728 , \u44060 \u49888 \u44368 \u44032  \u51068 \u50836 \u51068 \u51012  \u51648 \u53412 \u45716  \u44163 \u51008  \u44536 \u46308 \u51032  \u44368 \u54924 \u51032  \u44428 \u50948 \u47484  \u51064 \u51221 \u54616 \u45716  \u44163 \u51060 \u46972 \u44256  \u47568 \u54620 \u45796 . \'93\u52380 \u51452 \u44368  \u44368 \u47532  \u47928 \u45813 \'94 (Catholic Catechism of Christian Religion) \u51008  \u45367 \u51704  \u44228 \u47749 \u50640  \u46384 \u46972  \u51648 \u53020 \u50556  \u54624  \u45216 \u50640  \u44288 \u54620  \u51656 \u47928 \u50640  \u45824 \u54616 \u50668  \u45796 \u51020 \u44284  \u44057 \u51060  \u45824 \u45813 \u54616 \u50688 \u45796 . \'93\u44396 \u50557  \u49884 \u45824 \u50640 \u45716  \u53664 \u50836 \u51068 \u51060  \u49457 \u48324 \u46108  \u45216 \u51060 \u50632 \u45796 . \u44536 \u47084 \u45208  \u50696 \u49688  \u44536 \u47532 \u49828 \u46020 \u51032  \u44368 \u54984 \u51012  \u48155 \u44256  \u49457 \u47161 \u51032  \u51648 \u46020 \u47484  \u46384 \u47480  \u44368 \u54924 \u45716  \u51068 \u50836 \u51068 \u47196  \u53664 \u50836 \u51068 \u51012  \u45824 \u49888 \u54616 \u44172  \u54664 \u45796 . \u44536 \u47084 \u48064 \u47196  \u50724 \u45720 \u45216  \u50864 \u47532 \u45716  \u51228 \u52832  \u51068 \u51060  \u50500 \u45772  \u51228 \u51068  \u51068 \u51012  \u49457 \u48324 \u54620 \u45796 . \u51648 \u44552 \u51008  \u51068 \u50836 \u51068 \u51060  \u51452 \u51032  \u45216 \u51012  \u51032 \u48120 \u54620 \u45796 .\'94\
\uc0\u52380 \u51452 \u44368 \u54924 \u51032  \u51200 \u49696 \u44032 \u46308 \u46020  \u44536  \u44368 \u54924 \u51032  \u44428 \u50948 \u51032  \u54364 \u47196  \'93\u50504 \u49885 \u51068 \u51012  \u44060 \u49888 \u44368 \u46020 \u46308 \u46020  \u49884 \u51064 \u54616 \u44256  \u51080 \u45716  \u48148 \u50752  \u44057 \u51060  \u51068 \u50836 \u51068 \u47196  \u48320 \u44221 \u54620  \u44536  \u49324 \u49892 \'94\u51012  \u46308 \u50612 \u49436  \u47568 \u54616 \u47728 , \'93\u44060 \u49888 \u44368 \u46020 \u46308 \u46020  \u51068 \u50836 \u51068 \u51012  \u51648 \u53428 \u51004 \u47196 \u50024  \u44368 \u54924 \u44032  \u47784 \u46304  \u52629 \u51228 \u51068 \u51012  \u51228 \u51221 \u54616 \u44256 , \u49324 \u46988 \u46308 \u51012  \u51221 \u51396 \u54624  \u44428 \u49464 \u44032  \u51080 \u51020 \u51012  \u49884 \u51064 \u54616 \u45716  \u44163 \u51060 \u46972 \'94 (Henry Tuberville, An Abri-dgment of the Christian Doctrine, p.58) \u44256  \u47568 \u54620 \u45796 . \u44536 \u47084 \u48064 \u47196  \u50504 \u49885 \u51068 \u51032  \u48320 \u44221 \u51060 \u50556 \u47568 \u47196  \u47196 \u47560 \u44368 \u54924 \u51032  \u44428 \u50948 \u51032  \u54364 , \u44263  \u51664 \u49849 \u51032  \u54364 \u44032  \u50500 \u45768 \u44256  \u47924 \u50631 \u51060 \u44192 \u45716 \u44032 ?\
