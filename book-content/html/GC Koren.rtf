\f1\b0 \cf0 \
\uc0\u51060 \u50752  \u46041 \u49884 \u50640  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51012  \u46321 \u54620 \u55176  \u54616 \u44256  \u48512 \u51064 \u54616 \u45716  \u45936 \u49436  \u49373 \u44592 \u45716  \u44536 \u47495 \u46108  \u49457 \u54868 \u50640  \u45824 \u54620  \u51060 \u47200 \u46308 \u51060  \u50724 \u45720 \u45216 \u51032  \u51333 \u44368  \u50868 \u46041 \u50640 \u49436  \u54788 \u51200 \u54620  \u50948 \u52824 \u47484  \u52264 \u51648 \u54616 \u44256  \u51080 \u45796 . \u51060 \u47088  \u51060 \u47200 \u51008  \u44368 \u47532 \u49345 \u51004 \u47196  \u44144 \u51667 \u46112  \u49104 \u47564  \u50500 \u45768 \u46972  \u49892 \u49373 \u54876 \u50640  \u51080 \u50612 \u49436 \u46020  \u50948 \u54744 \u54620  \u44208 \u44284 \u47484  \u52488 \u47000 \u54620 \u45796 . \u44536 \u47532 \u44256  \u44536 \u47088  \u44163 \u51060  \u51068 \u48152 \u50640 \u44172  \u54872 \u50689 \u51012  \u48155 \u45716  \u49324 \u49892 \u51012  \u48380  \u46412  \u51060  \u51216 \u50640  \u45824 \u54620  \u49457 \u44221 \u51032  \u44032 \u47476 \u52840 \u51012  \u47749 \u48177 \u55176  \u51060 \u54644 \u54616 \u45716  \u44163 \u51060  \u52280 \u51004 \u47196  \u50836 \u44596 \u54620  \u51068 \u51076 \u51012  \u44648 \u45803 \u44172  \u46108 \u45796 .\
\uc0\u52280 \u46108  \u49457 \u54868 \u45716  \u49457 \u44221 \u49345  \u44368 \u47532 \u51060 \u45796 . \u49324 \u46020  \u48148 \u50872 \u51008  \u45936 \u49332 \u47196 \u45768 \u44032  \u44368 \u54924 \u50640  \u48372 \u45240  \u54200 \u51648 \u50640 \u49436  \'93\u54616 \u45208 \u45784 \u51032  \u46907 \u51008  \u51060 \u44163 \u51060 \u45768  \u45320 \u55148 \u51032  \u44144 \u47337 \u54632 \u51060 \u46972 \'94 (\u49332 \u51204  4:3) \u44256  \u51452 \u51109 \u54616 \u50688 \u45796 . \u44536 \u45716  \u46608 \u54620  \'93\u54217 \u44053 \u51032  \u54616 \u45208 \u45784 \u51060  \u52828 \u55176  \u45320 \u55148 \u47196  \u50728 \u51204 \u55176  \u44144 \u47337 \u54616 \u44172  \u54616 \u49884 \'85\u44592 \u47484  \u50896 \u54616 \u45432 \u46972 \'94 (\u49332 \u51204  5:23) \u44256  \u44592 \u46020 \u54616 \u50688 \u45796 . \u49457 \u44221 \u51008  \u49457 \u44208 \u51060  \u47924 \u50631 \u51060 \u47728 , \u44536 \u44163 \u51012  \u50612 \u46523 \u44172  \u50619 \u51012  \u49688  \u51080 \u45716 \u51648  \u44032 \u47476 \u52432  \u51456 \u45796 . \u44396 \u51452 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u51228 \u51088 \u46308 \u51012  \u50948 \u54616 \u50668  \'93\u51200 \u55148 \u47484  \u51652 \u47532 \u47196  \u44144 \u47337 \u54616 \u44172  \u54616 \u50741 \u49548 \u49436  \u50500 \u48260 \u51648 \u51032  \u47568 \u50432 \u51008  \u51652 \u47532 \u45768 \u51060 \u45796 \'94 (\u50836  17:17) \u44256  \u44592 \u46020 \u54616 \u49512 \u45796 . \u48148 \u50872 \u51008  \u49888 \u51088 \u46308 \u51060  \'93\u49457 \u47161  \u50504 \u50640 \u49436  \u44144 \u47337 \u54616 \u44172  \u46104 \'94 (\u47212  15:16) \u50612 \u50556  \u54620 \u45796 \u44256  \u44032 \u47476 \u52452 \u45796 . \u44536 \u47084 \u47732  \u49457 \u47161 \u44760 \u49436  \u54616 \u49884 \u45716  \u51068 \u51008  \u47924 \u50631 \u51064 \u44032 ? \u50696 \u49688 \u44760 \u49436 \u45716  \u51228 \u51088 \u46308 \u50640 \u44172  \'93\u51652 \u47532 \u51032  \u49457 \u47161 \u51060  \u50724 \u49884 \u47732  \u44536 \u44032  \u45320 \u55148 \u47484  \u47784 \u46304  \u51652 \u47532  \u44032 \u50868 \u45936 \u47196  \u51064 \u46020 \u54616 \u49884 \u47532 \'94 (\u50836  16:13) \u46972 \u44256  \u47568 \u50432 \u54616 \u49512 \u45796 . \u44536 \u47532 \u44256  \u49884 \u54200  \u44592 \u51088 \u45716  \'93\u51452 \u51032  \u48277 \u51008  \u51652 \u47532 \u47196 \u49548 \u51060 \u45796 \'94\u44256  \u47568 \u54616 \u50688 \u45796 . \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u44284  \u49457 \u47161 \u51012  \u53685 \u54616 \u50668  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u50640  \u44396 \u54788 \u46104 \u50612  \u51080 \u45716  \u51032 \u51032  \u53360  \u50896 \u52825 \u46308 \u51060  \u49324 \u46988 \u46308 \u50640 \u44172  \u50508 \u47140 \u51652 \u45796 . \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51008  \'93\u44144 \u47337 \u54616 \u47728  \u51032 \u47196 \u50864 \u47728  \u49440 \u54616 \'94\u47728 , \u50756 \u51204 \u54616 \u49888  \u54616 \u45208 \u45784 \u51012  \u44536 \u45824 \u47196  \u45208 \u53440 \u45236 \u51452 \u48064 \u47196  \u44536 \u47088  \u50984 \u48277 \u50640  \u49692 \u51333 \u54624  \u46412  \u51060 \u47336 \u50612 \u51648 \u45716  \u54408 \u49457 \u46020  \u46608 \u54620  \u44144 \u47337 \u54616 \u50668 \u51652 \u45796 . \u44536 \u47532 \u49828 \u46020 \u45716  \u44536 \u47088  \u54408 \u49457 \u51032  \u50756 \u51204 \u54620  \u47784 \u48376 \u51060 \u49884 \u45796 . \u44536 \u48516 \u44760 \u49436 \u45716  \'93\u45236 \u44032  \u50500 \u48260 \u51648 \u51032  \u44228 \u47749 \u51012  \u51648 \u53020 \'94 \'93\u54637 \u49345  \u44536 \u51032  \u44592 \u48848 \u54616 \u49884 \u45716  \u51068 \u51012  \u54665 \'94 (\u50836  15:10, 8:29) \u54620 \u45796 \u44256  \u47568 \u50432 \u54616 \u49512 \u45796 . \u44536 \u47532 \u49828 \u46020 \u47484  \u46384 \u47476 \u45716  \u49324 \u46988 \u46308 \u51008  \u44536 \u48516 \u44284  \u44057 \u51060  \u46104 \u50612 \u50556  \u54620 \u45796 . \u44536 \u46308 \u51008  \u54616 \u45208 \u45784 \u51032  \u51008 \u54812 \u47484  \u55192 \u51077 \u50612  \u44536 \u48516 \u51032  \u44144 \u47337 \u54620  \u50984 \u48277 \u51032  \u50896 \u52825 \u44284  \u51068 \u52824 \u54620  \u54408 \u49457 \u51012  \u51060 \u47336 \u50612 \u50556  \u54620 \u45796 . \u51060 \u44163 \u51060  \u49457 \u44221 \u51060  \u44032 \u47476 \u52824 \u45716  \u49457 \u54868 \u51060 \u45796 .\
\uc0\u51060  \u51068 \u51008  \u50724 \u51649  \u44536 \u47532 \u49828 \u46020 \u47484  \u48127 \u45716  \u48127 \u51020 \u51012  \u53685 \u54616 \u50668  \u54616 \u45208 \u45784 \u51032  \u50689 \u51032  \u45236 \u51116 \u54616 \u49884 \u45716  \u45733 \u47141 \u51004 \u47196  \u47568 \u48120 \u50516 \u50500 \u49436 \u47564  \u49457 \u52712 \u46112  \u49688  \u51080 \u45796 . \u49324 \u46020  \u48148 \u50872 \u51008  \u49888 \u51088 \u46308 \u50640 \u44172  \'93\u46160 \u47157 \u44256  \u46504 \u47548 \u51004 \u47196  \u45320 \u55148  \u44396 \u50896 \u51012  \u51060 \u47336 \u46972  \u45320 \u55148  \u50504 \u50640 \u49436  \u54665 \u54616 \u49884 \u45716  \u51060 \u45716  \u54616 \u45208 \u45784 \u51060 \u49884 \u45768  \u51088 \u44592 \u51032  \u44592 \u49240 \u49888  \u46907 \u51012  \u50948 \u54616 \u50668  \u45320 \u55148 \u47196  \u49548 \u50896 \u51012  \u46160 \u44256  \u54665 \u54616 \u44172  \u54616 \u49884 \u45208 \u45768 \'94 (\u48716  2:12, 13) \u46972 \u44256  \u44428 \u44256 \u54616 \u50688 \u45796 . \u44536 \u47532 \u49828 \u46020 \u51064 \u51008  \u51396 \u51032  \u50976 \u54841 \u51012  \u48155 \u51012  \u44163 \u51060 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u50616 \u51228 \u45208  \u44536 \u44163 \u51012  \u45824 \u54637 \u54616 \u50668  \u49912 \u50872  \u44163 \u51060 \u45796 . \u44536 \u47084 \u48064 \u47196  \u44536 \u47532 \u49828 \u46020 \u51032  \u46020 \u50880 \u51060  \u54596 \u50836 \u54616 \u45796 . \u49324 \u46988 \u51032  \u50672 \u50557 \u54632 \u51060  \u54616 \u45208 \u45784 \u51032  \u45733 \u47141 \u44284  \u50672 \u54633 \u46112  \u46412  \u48127 \u51020 \u51004 \u47196  \'93\u50864 \u47532  \u51452  \u50696 \u49688  \u44536 \u47532 \u49828 \u46020 \u47196  \u47568 \u48120 \u50516 \u50500  \u50864 \u47532 \u50640 \u44172  \u51060 \u44608 \u51012  \u51452 \u49884 \u45716  \u54616 \u45208 \u45784 \u44760  \u44048 \u49324 \u54616 \u45432 \'94 (\u44256 \u51204  15:57) \u46972 \u44256  \u48512 \u47476 \u51670 \u44172  \u46108 \u45796 .\
\uc0\u49457 \u44221 \u51008  \u49457 \u54868 \u51032  \u44284 \u50629 \u51060  \u51216 \u51652 \u51201 \u51004 \u47196  \u51060 \u47336 \u50612 \u51664 \u51012  \u48516 \u47749 \u55176  \u50508 \u47140  \u51456 \u45796 . \u51396 \u51064 \u51060  \u54924 \u44060 \u54616 \u50668  \u49549 \u51396 \u51032  \u54588 \u47196  \u47568 \u48120 \u50516 \u50500  \u54616 \u45208 \u45784 \u44284  \u54868 \u47785 \u54644 \u51656  \u46412 \u48512 \u53552  \u44536 \u47532 \u49828 \u46020 \u51064  \u49373 \u50528 \u44032  \u49884 \u51089 \u46108 \u45796 . \u51060 \u46412 \u48512 \u53552  \u44536 \u45716  \'93\u50756 \u51204 \u54620  \u45936  \u45208 \u50500 \'94\u44032 \u49436  \'93\u44536 \u47532 \u49828 \u46020 \u51032  \u51109 \u49457 \u54620  \u48516 \u47049 \u51060  \u52649 \u47564 \u54620  \u45936 \u44620 \u51648 \'94 \u51088 \u46972 \u45208 \u50556  \u54620 \u45796 . \u49324 \u46020  \u48148 \u50872 \u51008  \'93\u50724 \u51649  \u54620  \u51068  \u51593  \u46244 \u50640  \u51080 \u45716  \u44163 \u51008  \u51082 \u50612 \u48260 \u47532 \u44256  \u50526 \u50640  \u51080 \u45716  \u44163 \u51012  \u51105 \u51004 \u47140 \u44256  \u54383 \u45824 \u47484  \u54693 \u54616 \u50668  \u44536 \u47532 \u49828 \u46020  \u50696 \u49688  \u50504 \u50640 \u49436  \u54616 \u45208 \u45784 \u51060  \u50948 \u50640 \u49436  \u48512 \u47476 \u49888  \u48512 \u47492 \u51032  \u49345 \u51012  \u50948 \u54616 \u50668  \u51335 \u50500 \u44032 \u45432 \u46972 \'94 (\u48716  3:13, 14) \u44256  \u47568 \u54616 \u50688 \u45796 . \u44536 \u47532 \u44256  \u48288 \u46300 \u47196 \u46020  \u49457 \u44221 \u51060  \u51228 \u49884 \u54616 \u44256  \u51080 \u45716  \u49457 \u54868 \u47484  \u50619 \u45716  \u44228 \u45800 \u51012  \u50864 \u47532 \u50640 \u44172  \u48516 \u47749 \u55176  \u51228 \u49884 \u54616 \u44256  \u51080 \u45796 . \u44536 \u45716  \'93\u45320 \u55148 \u44032  \u45908 \u50865  \u55192 \u50024  \u45320 \u55148  \u48127 \u51020 \u50640  \u45909 \u51012 , \u45909 \u50640  \u51648 \u49885 \u51012 , \u51648 \u49885 \u50640  \u51208 \u51228 \u47484 , \u51208 \u51228 \u50640  \u51064 \u45236 \u47484 , \u51064 \u45236 \u50640  \u44221 \u44148 \u51012 , \u44221 \u44148 \u50640  \u54805 \u51228  \u50864 \u50528 \u47484 , \u54805 \u51228  \u50864 \u50528 \u50640  \u49324 \u46993 \u51012  \u44277 \u44553 \u54616 \u46972 \'85\u45320 \u55148 \u44032  \u51060 \u44163 \u51012  \u54665 \u54620 \u51593  \u50616 \u51228 \u46304 \u51648  \u49892 \u51313 \u51648  \u50500 \u45768 \u54616 \u47532 \u46972 \'94 (\u48295 \u54980  1:5~10) \u44256  \u47568 \u54616 \u50688 \u45796 .\
