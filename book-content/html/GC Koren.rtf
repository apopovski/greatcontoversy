\uc0\u51228 \u51088 \u46308 \u51008  \u49457 \u51204 \u51032  \u47736 \u47581 \u50640  \u44288 \u54620  \u50696 \u49688 \u45784 \u51032  \u50696 \u50616 \u51012  \u46307 \u44256  \u47924 \u49436 \u50892 \u54616 \u44256  \u51060 \u49345 \u55176  \u50668 \u44220 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u46308 \u51008  \u44536  \u47568 \u50432 \u51032  \u51032 \u48120 \u47484  \u48372 \u45796  \u48516 \u47749 \u55176  \u44648 \u45803 \u44592 \u47484  \u50896 \u54664 \u45796 . 40\u50668  \u45380  \u46041 \u50504  \u51116 \u47932 \u44284  \u45432 \u47141 \u44284  \u44148 \u52629 \u49345 \u51032  \u44592 \u49696 \u51060  \u51060  \u49457 \u51204 \u51032  \u51109 \u47140  (\u22767 \u40599 ) \u54632 \u51012  \u45458 \u51060 \u44592  \u50948 \u54616 \u50668  \u50500 \u45196 \u50630 \u51060  \u49548 \u48708 \u46104 \u50632 \u45796 . \u54756 \u47215  \u45824 \u50773 \u51008  \u47196 \u47560 \u51032  \u48512  (\u23500 ) \u50752  \u50976 \u45824 \u51032  \u48372 \u47932 \u51012  \u44536  \u49457 \u51204 \u51012  \u50948 \u54616 \u50668  \u47932  \u50416 \u46319 \u51060  \u50044 \u51004 \u47728  \u45817 \u49884 \u51032  \u52380 \u54616 \u47484  \u51648 \u48176 \u54616 \u45912  \u47196 \u47560 \u51032  \u54889 \u51228 \u44620 \u51648 \u46020  \u50696 \u47932 \u51012  \u48372 \u45236 \u50612  \u44536  \u51068 \u51012  \u46020 \u50772 \u45796 . \u44144 \u51032  \u48127 \u44592  \u50612 \u47140 \u50872  \u51221 \u46020 \u51032  \u44144 \u45824 \u54620  \u45824 \u47532 \u49437 \u46308 \u51060  \u47196 \u47560 \u47196 \u48512 \u53552  \u51060  \u49457 \u51204  \u44148 \u52629 \u51012  \u50948 \u54616 \u50668  \u49688 \u49569 \u46104 \u50612  \u44536  \u51204  (\u27583 ) \u51032  \u51068 \u48512 \u47484  \u51060 \u47336 \u50632 \u45796 . \u44536 \u47084 \u48064 \u47196  \u50696 \u49688 \u45784 \u51032  \u51228 \u51088 \u46308 \u51008  \u51060 \u44163 \u46308 \u50640  \u44536 \u46308 \u51032  \u49440 \u49373 \u45784 \u51032  \u51452 \u51032 \u47484  \u54872 \u44592 \u49884 \u5