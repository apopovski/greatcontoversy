\f0\b \cf0 \uc0\u50984 \u48277 \u44284  \u49888 \u50521 \u44284 \u51032  \u44288 \u44228 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u54616 \u45208 \u45784 \u44284  \u54868 \u47785 \u54616 \u45716  \u52395 \u51704  \u44228 \u45800 \u51008  \u51396 \u47484  \u44648 \u45803 \u45716  \u44163 \u51060 \u45796 . \'93\u51396 \u45716  \u48520 \u48277 \u51060 \u46972 \'94 (\u50836 \u51068  3:4), \'93\u50984 \u48277 \u51004 \u47196 \u45716  \u51396 \u47484  \u44648 \u45804 \u51020 \u51060 \u45768 \u46972 \'94 (\u47212  3:20). \u51396 \u51064 \u51060  \u51396 \u47484  \u44648 \u45804 \u51004 \u47140 \u47732  \u47676 \u51200  \u51088 \u44592 \u51032  \u54408 \u49457 \u51012  \u54616 \u45208 \u45784 \u51032  \u50948 \u45824 \u54620  \u51032 \u51032  \u54364 \u51456 \u50640  \u48708 \u52628 \u50612 \u49436  \u49332 \u54196 \u48372 \u50500 \u50556  \u54620 \u45796 . \u44536 \u44163 \u51008  \u51032 \u47196 \u50868  \u54408 \u49457 \u51032  \u50756 \u51204 \u54632 \u51012  \u48372 \u50668  \u51452 \u45716  \u44144 \u50872 \u47196 \u49436  \u51396 \u51064 \u50640 \u44172  \u44536 \u51032  \u44208 \u54632 \u51012  \u48516 \u48324 \u54616 \u44172  \u54644 \u51456 \u45796 .\
\uc0\u50984 \u48277 \u51060  \u49324 \u46988 \u50640 \u44172  \u44536 \u51032  \u51396 \u47484  \u45208 \u53440 \u45236  \u48372 \u50668  \u51452 \u44592 \u45716  \u54616 \u51648 \u47564  \u51396 \u47484  \u52824 \u47308 \u54644 \u51452 \u51648 \u45716  \u47803 \u54620 \u45796 . \u50984 \u48277 \u51008  \u49692 \u51333 \u54616 \u45716  \u51088 \u50640 \u44172  \u49373 \u47749 \u51012  \u50557 \u49549 \u54644  \u51452 \u45716  \u48152 \u47732 \u50640  \u50984 \u48277 \u51012  \u48276 \u54616 \u45716  \u44163 \u51060  \u51453 \u51020 \u51076 \u51012  \u49440 \u44256 \u54620 \u45796 . \u50724 \u51649  \u44536 \u47532 \u49828 \u46020 \u51032  \u48373 \u51020 \u47564 \u51060  \u51396 \u51032  \u49440 \u44256 \u50752  \u45908 \u47084 \u50880 \u50640 \u49436  \u49324 \u46988 \u51012  \u54644 \u48169 \u49884 \u53420  \u49688  \u51080 \u45796 . \u49324 \u46988 \u51008  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51012  \u48276 \u54616 \u50688 \u51004 \u48064 \u47196  \u54616 \u45208 \u45784 \u44760  \u54924 \u44060 \u54616 \u44256  \u44536 \u47532 \u49828 \u46020 \u47484  \u44536 \u51032  \u49549 \u51396  \u51228 \u47932 \u47196  \u48127 \u50612 \u50556  \u54620 \u45796 . \u44536 \u47111 \u44172  \u54632 \u51004 \u47196  \u49324 \u46988 \u51008  \'93\u51204 \u50640  \u51648 \u51008  \u51396 \u47484  \u44036 \u44284 \u54616 \u49900 \u51004 \u47196 \'94 \u50857 \u49436 \u47484  \u48155 \u44256  \u49888 \u51032  \u49457 \u54408 \u50640  \u52280 \u50668 \u54616 \u45716  \u51088 \u44032  \u46108 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u45716  \u54616 \u45208 \u45784 \u51032  \u50500 \u46308 \u51060  \u46104 \u50612  \u50577 \u51088 \u51032  \u50689 \u51012  \u48155 \u44256  \'93\u50500 \u48148  \u50500 \u48260 \u51648 \'94\u46972 \u44256  \u48512 \u47476 \u51670 \u44172  \u46108 \u45796 .\
\uc0\u44536 \u45716  \u51060 \u51228  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51012  \u48276 \u54616 \u50668 \u46020  \u47924 \u48169 \u54620 \u44032 ? \u48148 \u50872 \u51008  \'93\u44536 \u47088 \u51593  \u50864 \u47532 \u44032  \u48127 \u51020 \u51004 \u47196  \u47568 \u48120 \u50516 \u50500  \u50984 \u48277 \u51012  \u54224 \u54616 \u45712 \u45544  \u44536 \u47092  \u49688  \u50630 \u45712 \u45768 \u46972  \u46020 \u47532 \u50612  \u50984 \u48277 \u51012  \u44403 \u44172  \u49464 \u50864 \u45712 \u45768 \u46972 \'94 (\u47212  3:31), \'93\u51396 \u50640  \u45824 \u54616 \u50668  \u51453 \u51008  \u50864 \u47532 \u44032  \u50612 \u52236  \u44536  \u44032 \u50868 \u45936  \u45908  \u49332 \u47532 \u50836 \'94 (\u47212  6:2) \u46972 \u44256  \u47568 \u54620 \u45796 . \u50836 \u54620 \u51008  \'93\u54616 \u45208 \u45784 \u51012  \u49324 \u46993 \u54616 \u45716  \u44163 \u51008  \u51060 \u44163 \u51060 \u45768  \u50864 \u47532 \u44032  \u44536 \u51032  \u44228 \u47749 \u46308 \u51012  \u51648 \u53412 \u45716  \u44163 \u51060 \u46972  \u44536 \u51032  \u44228 \u47749 \u46308 \u51008  \u47924 \u44144 \u50868  \u44163 \u51060  \u50500 \u45768 \u47196 \u45796 \'94 (\u50836 \u51068  5:3) \u44256  \u54616 \u50688 \u45796 . \u49352 \u47196  \u45224 \u51004 \u47196 \u50024  \u49324 \u46988 \u51032  \u47560 \u51020 \u51008  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u44284  \u51068 \u52824 \u46120 \u44284  \u46041 \u49884 \u50640  \u54616 \u45208 \u45784 \u44284  \u51312 \u54868 \u47484  \u51060 \u47336 \u44172  \u46108 \u45796 . \u51060  \u50948 \u45824 \u54620  \u48320 \u54868 \u44032  \u51396 \u51064 \u51032  \u47560 \u51020 \u49549 \u50640 \u49436  \u51060 \u47336 \u50612 \u51648 \u47732  \u44536 \u45716  \u51453 \u51020 \u50640 \u49436  \u49373 \u47749 \u51004 \u47196 , \u51396 \u50640 \u49436  \u49457 \u44208 \u47196 , \u48276 \u51396 \u50752  \u48152 \u50669 \u50640 \u49436  \u49692 \u51333 \u44284  \u52649 \u49457 \u51004 \u47196  \u50734 \u44200 \u51648 \u44172  \u46108 \u45796 . \u54616 \u45208 \u45784 \u44284  \u47680 \u50612 \u51256  \u51080 \u45912  \u50715  \u49373 \u50528 \u45716  \u45149 \u45208 \u44256  \u48127 \u51020 \u44284  \u49324 \u46993 \u51004 \u47196  \u51060 \u47336 \u50612 \u51648 \u45716  \u54616 \u45208 \u45784 \u44284 \u51032  \u54868 \u47785 \u51032  \u49373 \u50528 \u44032  \u49884 \u51089 \u46108 \u45796 . \u44536 \u47532 \u54616 \u50668  \'93\u50977 \u49888 \u51012  \u51335 \u51648  \u50506 \u44256  \u44536  \u50689 \u51012  \u51335 \u50500  \u54665 \u54616 \u45716  \u50864 \u47532 \u50640 \u44172  \u50984 \u48277 \u51032  \u50836 \u44396 \u47484  \u51060 \u47336 \u50612 \u51648 \u44172 \'94 (\u47212  8:4) \u54620 \u45796 . \u44536  \u46412 \u50640  \u49900 \u47161 \u50640 \u49436  \'93\u45236 \u44032  \u51452 \u51032  \u48277 \u51012  \u50612 \u52236  \u44536 \u47532  \u49324 \u46993 \u54616 \u45716 \u51648 \u50836  \u45236 \u44032  \u44536 \u44163 \u51012  \u51333 \u51068  \u47925 \u49345 \u54616 \u45208 \u51060 \u45796 \'94 (\u49884  119:97) \u44256  \u50808 \u52824 \u44172  \u46108 \u45796 .\
\'93\uc0\u50668 \u54840 \u50752 \u51032  \u50984 \u48277 \u51008  \u50756 \u51204 \u54616 \u50668  \u50689 \u54844 \u51012  \u49548 \u49457 \u52992 \'94 (\u49884  19:7) \u54620 \u45796 . \u50984 \u48277 \u51060  \u50630 \u51004 \u47732  \u49324 \u46988 \u46308 \u51008  \u54616 \u45208 \u45784 \u51032  \u49888 \u49457 \u49457 \u44284  \u49692 \u44208 , \u44536 \u47532 \u44256  \u51088 \u44592  \u51088 \u49888 \u46308 \u51032  \u51396 \u50752  \u48520 \u44208 \u50640  \u45824 \u54616 \u50668  \u50732 \u48148 \u47480  \u44288 \u45392 \u51012  \u44032 \u51656  \u49688  \u50630 \u45796 . \u44536 \u46308 \u51008  \u51396 \u50640  \u45824 \u54616 \u50668  \u51652 \u51221 \u51004 \u47196  \u44648 \u45803 \u51648  \u47803 \u54616 \u44256  \u54924 \u44060 \u54624  \u54596 \u50836 \u49457 \u46020  \u45712 \u45180 \u51648  \u50506 \u45716 \u45796 . \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51012  \u50612 \u44596  \u51088 \u47196 \u49436 \u51032  \u44536 \u46308 \u51032  \u49549 \u51208 \u50630 \u45716  \u49345 \u53468 \u47484  \u50508 \u51648  \u47803 \u54616 \u44256  \u49549 \u51396 \u54616 \u45716  \u44536 \u47532 \u49828 \u46020 \u51032  \u54588 \u44032  \u54596 \u50836 \u54632 \u51012  \u51064 \u51221 \u54616 \u51648 \u46020  \u50506 \u45716 \u45796 . \u44540 \u48376 \u51201 \u51064  \u47560 \u51020 \u51032  \u48320 \u54868 \u46020 , \u49373 \u50528 \u51032  \u44060 \u54785 \u46020  \u50630 \u51060  \u44396 \u50896 \u51032  \u49548 \u47581 \u51012  \u48155 \u50500 \u46308 \u51064 \u45796 . \u44536 \u47532 \u54616 \u50668  \u54588 \u49345 \u51201 \u51064  \u54924 \u44060 \u44032  \u48372 \u54200 \u54868 \u46104 \u44256  \u44208 \u53076  \u44536 \u47532 \u49828 \u46020 \u50752  \u50672 \u54633 \u54620  \u44221 \u54744 \u51060  \u50630 \u45716  \u47566 \u51008  \u49324 \u46988 \u46308 \u51060  \u44368 \u54924 \u50640  \u46308 \u50612 \u50724 \u44172  \u46108 \u45796 .\
