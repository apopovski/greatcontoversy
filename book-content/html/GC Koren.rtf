\f1\b0 \cf0 \
\uc0\u47336 \u53552 \u45716  \u48376 \u47000 , \u44536 \u52376 \u47100  \u53360  \u50501 \u51012  \u48730 \u50612 \u45240  \u44305 \u49888 \u46020 \u46308 \u44284  \u45824 \u44208 \u54616 \u44592 \u47484  \u50896 \u52824  \u50506 \u50520 \u45796 . \u44536 \u46308 \u51008  \u44148 \u51204 \u52824  \u47803 \u54620  \u54032 \u45800 \u47141 \u44284  \u49464 \u47144 \u46104 \u51648  \u47803 \u54620  \u44048 \u51221 \u51012  \u44032 \u51652  \u49324 \u46988 \u46308 \u51060 \u50632 \u51004 \u48064 \u47196  \u48708 \u47197  \u44536 \u46308 \u51060  \u54616 \u45720 \u47196 \u48512 \u53552  \u53945 \u48324 \u54620  \u48731 \u51012  \u48155 \u50520 \u45432 \u46972 \u44256  \u51452 \u51109 \u54616 \u51648 \u47564 , \u51648 \u44537 \u55176  \u51089 \u51008  \u48152 \u48149 \u51060 \u45208  \u45908 \u50630 \u51060  \u52828 \u51208 \u54620  \u44221 \u52293 \u44284  \u44428 \u44256 \u50640 \u46020  \u44204 \u46356 \u51648  \u47803 \u54616 \u45716  \u51088 \u46308 \u51076 \u51012  \u44536 \u45716  \u51096  \u50508 \u50520 \u45796 . \u44536 \u46308 \u51008  \u44536 \u46308 \u50640 \u44172  \u52572 \u49345 \u44428 \u51060  \u51080 \u45796 \u44256  \u51452 \u51109 \u54616 \u47732 \u49436  \u47784 \u46304  \u49324 \u46988 \u50640 \u44172  \u50500 \u47924 \u47088  \u51032 \u49900  \u50630 \u51060  \u44536 \u46308 \u51032  \u51452 \u51109 \u51012  \u49884 \u51064 \u54616 \u44592 \u47484  \u50836 \u44396 \u54620 \u45796 . \u44536 \u47088 \u45936  \u44536 \u46308 \u51060  \u47336 \u53552 \u50752  \u47564 \u45208 \u44256 \u51088  \u50836 \u52397 \u54616 \u50688 \u51004 \u48064 \u47196  \u44536 \u45716  \u44536 \u46308 \u44284  \u47564 \u45208 \u44592 \u47196  \u46041 \u51032 \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u47336 \u53552 \u44032  \u44536 \u46308 \u51032  \u44144 \u51667 \u51012  \u49457 \u44277 \u51201 \u51004 \u47196  \u54253 \u47196 \u49884 \u53040 \u44592  \u46412 \u47928 \u50640  \u44536  \u49324 \u44592 \u44988 \u46308 \u51008  \u51593 \u49884  \u48708 \u53584 \u48288 \u47476 \u53356 \u47484  \u46496 \u45228 \u45796 .\
\uc0\u44305 \u49888 \u51452 \u51032 \u45716  \u54620 \u46041 \u50504  \u51200 \u51648 \u46104 \u50632 \u45796 . \u44536 \u47084 \u45208  \u47751  \u45380  \u54980 \u50640  \u44536 \u44163 \u51008  \u45908 \u50865  \u53360  \u49464 \u47141 \u51004 \u47196  \u45208 \u53440 \u45208 \u49436  \u47924 \u49436 \u50868  \u44208 \u44284 \u47484  \u48730 \u50612 \u45256 \u45796 . \u44536  \u50868 \u46041 \u51032  \u51648 \u46020 \u51088 \u46308 \u50640  \u44288 \u54616 \u50668  \u47336 \u53552 \u45716  \u47568 \u54616 \u50688 \u45796 . \'93\u44536 \u46308 \u50640 \u44172  \u51080 \u50612 \u49436  \u49457 \u44221 \u51008  \u51453 \u51008  \u44544 \u50640  \u48520 \u44284 \u54616 \u48064 \u47196  \u44536 \u46308 \u51008  \u47784 \u46160  \'91\u49457 \u47161 , \u49457 \u47161 \'92\u51060 \u46972 \u44256  \u48512 \u47476 \u51670 \u44592  \u49884 \u51089 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u45208 \u45716  \u44536 \u46308 \u51032  \u50689 \u51060  \u44536 \u46308 \u51012  \u51064 \u46020 \u54616 \u45716  \u44275 \u51004 \u47196  \u44208 \u53076  \u46384 \u46972 \u44032 \u51648  \u50506 \u51012  \u44163 \u51060 \u45796 . \u51008 \u54812 \u51032  \u54616 \u45208 \u45784 \u44760 \u49436  \u45208 \u47484  \u51088 \u52845  \u49457 \u46020 \u46308 \u47564 \u51060  \u51080 \u45716  \u44536  \u44368 \u54924 \u50640  \u46308 \u50612 \u44032 \u51648  \u50506 \u46020 \u47197  \u48372 \u54840 \u54644  \u51452 \u49884 \u44592 \u47484  \u48148 \u46976 \u45796 . \u45208 \u45716 , \u51396 \u47484  \u51064 \u51221 \u54616 \u44256  \u46160 \u47140 \u50892 \u54616 \u47732 \u49436  \u54637 \u49345  \u47560 \u51020 \u49549  \u44618 \u51008  \u44275 \u50640 \u49436 \u48512 \u53552  \u54616 \u45208 \u45784 \u51032  \u50948 \u47196 \u50752  \u46020 \u50864 \u49900 \u51012  \u50619 \u44256 \u51088  \u49888 \u51020 \u54616 \u44256  \u48512 \u47476 \u51670 \u45716  \u44032 \u45212 \u54616 \u44256  \u50672 \u50557 \u54616 \u44256 , \u48337 \u46304  \u51088 \u46308 \u44284  \u54632 \u44760  \u49332 \u44592 \u47484  \u50896 \u54620 \u45796 \'94 (D\'92Aubigne, b.10, ch.10).\
\uc0\u44305 \u49888 \u51088 \u46308  \u51473 \u50640 \u49436  \u44032 \u51109  \u54876 \u46041 \u51201 \u51064  \u53664 \u47560 \u49828  \u48012 \u52376  (Thomas Munzer) \u45716  \u49345 \u45817 \u55176  \u51116 \u45733 \u51060  \u51080 \u45716  \u49324 \u46988 \u51060 \u50632 \u45796 . \u48148 \u47480  \u51648 \u46020 \u47484  \u48155 \u50520 \u45796 \u47732  \u44536 \u45716  \u51339 \u51008  \u51068 \u51012  \u54624  \u49688  \u51080 \u51012  \u49324 \u46988 \u51060 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u52280  \u51333 \u44368 \u51032  \u44540 \u48376  \u50896 \u52825 \u46308 \u51012  \u48176 \u50864 \u51648  \u47803 \u54616 \u50688 \u45796 . \'93\u44536 \u45716  \u49464 \u49345 \u51012  \u44060 \u54785 \u54624  \u50676 \u47581 \u51012  \u44032 \u51276 \u51004 \u45208 , \u51068 \u48152 \u51201 \u51004 \u47196  \u47784 \u46304  \u44305 \u49888 \u51088 \u46308 \u52376 \u47100 , \u44060 \u54785 \u51060  \u51088 \u44592  \u51088 \u49888 \u51004 \u47196 \u48512 \u53552  \u49884 \u51089 \u46104 \u50612 \u50556  \u54620 \u45796 \u45716  \u49324 \u49892 \u51012  \u51082 \u50612 \u48260 \u47160 \u45796 \'94 (D\'92Aubigne, b.9, ch.8). \u44536 \u45716  \u51648 \u50948 \u50752  \u49464 \u47141 \u51012  \u50619 \u44592 \u47484  \u50676 \u47581 \u54620  \u45208 \u47672 \u51648  \u49900 \u51648 \u50612  \u47336 \u53552 \u50640 \u44172 \u44620 \u51648 \u46972 \u46020  \u46244 \u46504 \u50612 \u51648 \u44592 \u47484  \u49899 \u50612 \u54616 \u50688 \u45796 . \u44536 \u45716  \u44060 \u54785 \u51088 \u46308 \u51060  \u48277 \u50773 \u44428  \u45824 \u49888 \u50640  \u49457 \u44221 \u51032  \u44428 \u50948 \u47484  \u49464 \u50864 \u45716  \u44163 \u51008  \u51068 \u51333 \u51032  \u45796 \u47480  \u54805 \u49885 \u51032  \u48277 \u50773 \u44428 \u51012  \u49688 \u47549 \u54616 \u45716  \u45936  \u48520 \u44284 \u54616 \u45796 \u44256  \u51452 \u51109 \u54616 \u50688 \u45796 . \u44536 \u45716  \u51088 \u44592  \u51088 \u49888 \u51012  \u52280  \u44060 \u54785 \u51012  \u51068 \u51004 \u53412 \u44592  \u50948 \u54616 \u50668  \u54616 \u45720 \u47196 \u48512 \u53552  \u51076 \u47749 \u48155 \u51008  \u51088 \u46972 \u44256  \u51452 \u51109 \u54616 \u50688 \u45796 . \u48012 \u52376 \u45716  \'93\u44060 \u54785 \u51032  \u51221 \u49888 \u51012  \u44032 \u51652  \u51088 \u45716  \u48708 \u47197  \u51068 \u49373  \u46041 \u50504 \u50640  \u49457 \u44221 \u51012  \u44208 \u53076  \u48372 \u51648  \u50500 \u45768 \u54624 \u51648 \u46972 \u46020  \u52280 \u46108  \u49888 \u50521 \u51012  \u44032 \u51648 \u44172  \u46108 \u45796 \'94 (D\'92Aubigne, b.10, ch.10) \u44256  \u47568 \u54616 \u50688 \u45796 .\
\uc0\u51060 \u50752  \u44057 \u51008  \u44305 \u49888 \u51201 \u51064  \u44368 \u49324 \u46308 \u51008  \u44536 \u46308  \u51088 \u49888 \u51012  \u50756 \u51204 \u55176  \u44048 \u51221 \u51032  \u51648 \u48176  \u50500 \u47000  \u46160 \u44256  \u47784 \u46304  \u49373 \u44033 \u44284  \u52649 \u46041 \u51012  \u54616 \u45208 \u45784 \u51032  \u51020 \u49457 \u51004 \u47196  \u51064 \u51221 \u54616 \u50688 \u51004 \u48064 \u47196  \u49900 \u55176  \u44537 \u45800 \u51201 \u51004 \u47196  \u45208 \u44052 \u45796 . \u50612 \u46500  \u49324 \u46988 \u46308 \u51008  \u49457 \u44221 \u51012  \u53468 \u50892 \u48260 \u47532 \u47732 \u49436  \'93\u51032 \u47928  (\u20736 \u25991 ) \u51008  \u51453 \u51060 \u51648 \u47564  \u49457 \u47161 \u51008  \u49332 \u47536 \u45796 \'94\u44256  \u50808 \u52824 \u44592 \u44620 \u51648  \u54616 \u50688 \u45796 . \u48012 \u52376 \u51032  \u44032 \u47476 \u52840 \u51008  \u45440 \u46972 \u50872  \u51221 \u46020 \u47196  \u49324 \u46988 \u51032  \u50837 \u47581 \u50640  \u54840 \u49548 \u54616 \u45716  \u55192 \u51060  \u51080 \u50632 \u45796 . \u54620 \u54200 \u51004 \u47196  \u44536 \u44163 \u51008  \u49324 \u46988 \u51032  \u49324 \u49345 \u44284  \u51032 \u44204 \u51012  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u48372 \u45796  \u45908 \u50865  \u45458 \u51008  \u50948 \u52824 \u50640  \u45459 \u44172  \u54632 \u51004 \u47196  \u44536 \u46308 \u51032  \u51088 \u48512 \u49900 \u51012  \u47564 \u51313 \u49884 \u53020  \u51452 \u50632 \u45796 . \u47924 \u49688 \u54620  \u49324 \u46988 \u46308 \u51060  \u44536 \u51032  \u44368 \u47532 \u47484  \u48155 \u50500 \u46308 \u50688 \u45796 . \u50724 \u47000 \u51648  \u50500 \u45768 \u54616 \u50668  \u44536 \u45716  \u44277 \u51473  \u50696 \u48176 \u51032  \u47784 \u46304  \u51656 \u49436 \u47484  \u48708 \u45212 \u54616 \u44256 , \u51228 \u54980  (\u35576 \u20399 ) \u46308 \u50640 \u44172  \u49692 \u51333 \u54616 \u45716  \u44163 \u51008  \u47560 \u52824  \u54616 \u45208 \u45784 \u44284  \u48296 \u47532 \u50508 \u51012  \u46041 \u49884 \u50640  \u49452 \u44592 \u45716  \u44163 \u44284  \u44057 \u51008  \u44163 \u51060 \u46972 \u44256  \u51452 \u51109 \u54616 \u50688 \u45796 .\
\uc0\u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u51008  \u51060 \u48120  \u48277 \u50773 \u44428 \u51032  \u47693 \u50640 \u50640 \u49436  \u48279 \u50612 \u45208 \u44256  \u51080 \u50632 \u51004 \u47728  \u46608 \u54620  \u44397 \u44428 \u51032  \u49549 \u48149 \u50640  \u44204 \u46364  \u49688  \u50630 \u44172  \u46104 \u50612  \u51080 \u50632 \u45796 . \u48012 \u52376 \u44032  \u54616 \u45208 \u45784 \u51032  \u51064 \u51221 \u51012  \u48155 \u50520 \u45796 \u44256  \u51452 \u51109 \u54616 \u45716  \u54785 \u47749 \u51201 \u51064  \u44368 \u47532 \u45716  \u49324 \u46988 \u46308 \u47196  \u54616 \u50668 \u44552  \u50728 \u44054  \u50613 \u51228 \u50752  \u44396 \u49549 \u50640 \u49436  \u48279 \u50612 \u45208 \u44172  \u54616 \u44256 , \u44536 \u46308 \u51032  \u54200 \u44204 \u44284  \u44048 \u51221 \u50640  \u49324 \u47196 \u51105 \u55176 \u44172  \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44032 \u51109  \u47924 \u49436 \u50868  \u49548 \u46976 \u44284  \u53804 \u51137 \u51060  \u46244 \u47484  \u51060 \u50632 \u44256 , \u46021 \u51068 \u51032  \u46405 \u46308 \u51008  \u54588 \u47196 \u50024  \u51201 \u49884 \u50612 \u51276 \u45796 .\
