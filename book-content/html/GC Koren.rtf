\uc0\u50728 \u44054  \u50501 \u51012  \u52649 \u46041 \u54616 \u45716  \u49324 \u45800 \u51008  \u51116 \u47548 \u44592 \u48324 \u51032  \u54952 \u44284 \u47484  \u47568 \u49332 \u54644  \u48260 \u47540  \u49104  \u50500 \u45768 \u46972  \u44536  \u44592 \u48324 \u51012  \u51204 \u54616 \u45716  \u49324 \u46988  \u51088 \u49888 \u51012  \u51453 \u51060 \u44256 \u51088  \u54616 \u50688 \u45796 . \u48128 \u47084 \u45716  \u49457 \u44221 \u51032  \u51652 \u47532 \u47484  \u52397 \u51473 \u46308 \u51032  \u47560 \u51020 \u50640  \u49892 \u51228 \u51201 \u51004 \u47196  \u51201 \u50857 \u54624  \u49688  \u51080 \u44172  \u54644 \u51452 \u50632 \u44256 , \u44536 \u46308 \u51032  \u51396 \u47484  \u44204 \u52293 \u54616 \u44256 , \u44536 \u46308 \u51032  \u51088 \u47564 \u51012  \u51648 \u53444  (\u25351 \u24392 ) \u54616 \u44256 , \u48516 \u47749 \u54616 \u44256  \u48148 \u47480 \u47568 \u51012  \u54616 \u50688 \u51004 \u48064 \u47196  \u48152 \u45824 \u51088 \u46308 \u51032  \u48120 \u50880 \u51012  \u49324 \u44172  \u46104 \u50632 \u45796 . \u44536 \u51032  \u44592 \u48324 \u50640  \u45824 \u54616 \u50668  \u44368 \u51064 \u46308 \u51060  \u45208 \u53440 \u45240  \u48152 \u45824 \u44032  \u54616 \u47448  \u44228 \u44553 \u51032  \u49324 \u46988 \u46308 \u51012  \u45812 \u45824 \u54616 \u44172  \u54644 \u51452 \u50632 \u51004 \u48064 \u47196  \u44536 \u46308 \u51008  \u51649 \u51217 \u51201 \u51064  \u54665 \u46041 \u51012  \u52712 \u54616 \u44172  \u46104 \u50632 \u45796 . \u44536 \u47532 \u54616 \u50668  \u50896 \u49688 \u46308 \u51008  \u48128 \u47084 \u44032  \u51665 \u54924  \u51109 \u49548 \u50640 \u49436  \u45208 \u50732  \u46412  \u44536 \u47484  \u51453 \u51060 \u44592 \u47196  \u44228 \u54925 \u51012  \u49464 \u50912 \u50632 \u45796 . \u44536 \u47084 \u45208  \u54616 \u45208 \u45784 \u51032  \u52380 \u49324 \u46308 \u51008  \u44536  \u44400 \u51473 \u46308  \u49549 \u50640  \u51080 \u50632 \u44256 , \u44536  \u52380 \u49324 \u46308  \u51473  \u54616 \u45208 \u44032  \u49324 \u46988 \u51032  \u47784 \u50577 \u51004 \u47196  \u45208 \u53440 \u45208  \u51452 \u45784 \u51032  \u51333 \u51032  \u49552 \u51012  \u48537 \u51105 \u50500  \u44536  \u48516 \u45432 \u54620  \u54253 \u46020 \u46308  \u44032 \u50868 \u45936 \u49436  \u50504 \u51204 \u54616 \u44172  \u51060 \u45132 \u50612 \u45256 \u45796 . \u44536 \u51032  \u49324 \u50629 \u51060  \u50500 \u51649  \u45149 \u45208 \u51648  \u50500 \u45768 \u54616 \u50688 \u51004 \u48064 \u47196  \u49324 \u45800 \u44284  \u44536 \u51032  \u48512 \u54616 \u46308 \u51008  \u44536 \u46308 \u51032  \u47785 \u51201 \u51012  \u45804 \u49457 \u54616 \u51648  \u47803 \u54616 \u44256  \u49892 \u54056 \u54616 \u50688 \u45796 .\
\uc0\u50728 \u44054  \u48152 \u45824 \u44032  \u51080 \u51020 \u50640 \u46020  \u48520 \u44396 \u54616 \u44256  \u51116 \u47548 \u50868 \u46041 \u50640  \u45824 \u54620  \u44288 \u49900 \u51008  \u44228 \u49549 \u54616 \u50668  \u51613 \u44032 \u46104 \u50632 \u45796 . \u49688 \u49901  \u47749 \u51004 \u47196 \u48512 \u53552  \u49688 \u48177 \u51004 \u47196 , \u44536 \u47532 \u44256  \u49688 \u52380  \u47749 \u51004 \u47196  \u54924 \u51473 \u46308 \u51008  \u51613 \u44032 \u46104 \u50632 \u45796 . \u50668 \u47084  \u44368 \u54924 \u47196 \u48512 \u53552  \u52268 \u46041 \u51088 \u46308 \u51032  \u49688 \u44032  \u53356 \u44172  \u51613 \u44032 \u46104 \u50632 \u51004 \u45208  \u50620 \u47560  \u54980 \u50640 \u45716  \u44536  \u44060 \u49900 \u51088 \u46308 \u50640  \u45824 \u54620  \u48152 \u45824 \u51032  \u51221 \u49888 \u51060  \u45208 \u53440 \u45228 \u51004 \u47728 , \u47560 \u52840 \u45236 \u45716  \u48128 \u47084 \u51032  \u44204 \u54644 \u47484  \u48155 \u50500 \u46308 \u51060 \u45716  \u51088 \u47484  \u51669 \u44228  \u52376 \u48516 \u54616 \u45716  \u51068 \u51060  \u44033  \u44368 \u54924 \u50640 \u49436  \u49884 \u51089 \u46104 \u50632 \u45796 . \u44536 \u47084 \u48064 \u47196  \u48128 \u47084 \u45716  \u47560 \u52840 \u45236  \u44033  \u44368 \u54028 \u51032  \u44536 \u47532 \u49828 \u46020 \u51064 \u46308 \u51012  \u54693 \u54616 \u50668  \u47564 \u51068  \u51088 \u44592 \u44032  \u51228 \u49884 \u54616 \u45716  \u44368 \u47532 \u50640  \u51096 \u47803 \u51060  \u51080 \u51004 \u47732  \u44536  \u50724 \u47448 \u47484  \u49457 \u44221 \u51012  \u44540 \u44144 \u47196  \u51648 \u51201 \u54644  \u45804 \u46972 \u44256  \u54840 \u49548 \u54616 \u45716  \u44544 \u51012  \u48156 \u54364 \u54616 \u51648  \u50506 \u51012  \u49688  \u50630 \u50632 \u45796 .\
\'93\uc0\u44536 \u45824 \u46308  \u51088 \u49888 \u46308 \u51060  \u51064 \u51221 \u54616 \u45716 \u48148  \u54364 \u51456 , \u44263  \u50864 \u47532 \u51032  \u49888 \u50521 \u44284  \u44288 \u49845 \u51032  \u50976 \u51068 \u54620  \u54364 \u51456 \u51064  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51060  \u48127 \u51004 \u46972 \u44256  \u47749 \u47161 \u54616 \u51648  \u50506 \u51008  \u50612 \u46500  \u44163 \u51012  \u50864 \u47532 \u44032  \u48127 \u44256  \u51080 \u45716 \u44032 ? \u44053 \u45800 \u44284  \u52636 \u54032 \u47932 \u51012  \u53685 \u54616 \u50668  \u50864 \u47532 \u44032  \u44536 \u52376 \u47100  \u51648 \u46021 \u54620  \u48708 \u45212 \u51012  \u48155 \u50500 \u50556  \u54616 \u44256 , \u44536 \u45824 \u46308 \u51032  \u44368 \u54924 \u50640 \u49436  \u50864 \u47532  \u51116 \u47548 \u49888 \u51088 \u46308 \u51060  \u51228 \u47749  \u52376 \u48516 \u51012  \u48155 \u50500 \u50556  \u54624  \u47924 \u49832  \u54665 \u46041 \u51012  \u50864 \u47532 \u44032  \u54616 \u50688 \u45800  \u47568 \u51064 \u44032 ?\'94 \'93\u47564 \u51068  \u50864 \u47532 \u50640 \u44172  \u51096 \u47803 \u51060  \u51080 \u45796 \u47732  \u44536  \u51096 \u47803 \u51060  \u50612 \u46356  \u51080 \u45796 \u45716  \u44163 \u51012  \u51648 \u51201 \u54644  \u51452 \u44592 \u47484  \u48148 \u46976 \u45796 . \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u50640  \u51032 \u44144 \u54616 \u50668  \u50864 \u47532 \u51032  \u50724 \u47448 \u47484  \u51648 \u51201 \u54644  \u45804 \u46972 . \u50864 \u47532 \u45716  \u51060 \u48120  \u47566 \u51008  \u51312 \u49548 \u47484  \u48155 \u50500  \u50772 \u45796 . \u51312 \u49548 \u47196 \u50024  \u50864 \u47532 \u51032  \u51096 \u47803 \u51012  \u44648 \u50864 \u52432  \u51460  \u49688  \u50630 \u45796 . \u50724 \u51649  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u47564 \u51060  \u50864 \u47532 \u51032  \u51032 \u44204 \u51012  \u44256 \u52432  \u51460  \u49688  \u51080 \u45796 . \u50864 \u47532 \u51032  \u44208 \u4