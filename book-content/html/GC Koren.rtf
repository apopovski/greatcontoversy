\'93\uc0\u51452 \u50668  \u45572 \u44032  \u51452 \u51032  \u51060 \u47492 \u51012  \u46160 \u47140 \u50892 \u54616 \u51648  \u50500 \u45768 \u54616 \u47728  \u50689 \u54868 \u47213 \u44172  \u54616 \u51648  \u50500 \u45768 \u54616 \u50724 \u47532 \u44620  \u50724 \u51649  \u51452 \u47564  \u44144 \u47337 \u54616 \u49884 \u45768 \u51060 \u45796  \u51452 \u51032  \u51032 \u47196 \u50864 \u49888  \u51068 \u51060  \u45208 \u53440 \u45228 \u51004 \u47588  \u47564 \u44397 \u51060  \u50752 \u49436  \u51452 \u44760  \u44221 \u48176 \u54616 \u47532 \u51060 \u45796 \'94 (\u44228  15:4). \u50724 \u47019 \u46041 \u50504  \u44228 \u49549 \u46104 \u50612  \u50728  \u51652 \u47532 \u50752  \u50724 \u47448 \u50640  \u44288 \u47144 \u46108  \u47784 \u46304  \u47928 \u51228 \u45716  \u51060 \u51228  \u48516 \u47749 \u54644 \u51276 \u45796 . \u48152 \u50669 \u51032  \u44208 \u44284 , \u44263  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51012  \u44144 \u50669 \u54620  \u44208 \u44284 \u44032  \u47784 \u46304  \u51648 \u51201  \u51316 \u51116 \u51088 \u51032  \u45576 \u50526 \u50640  \u48516 \u47749 \u54644 \u51276 \u45796 . \u54616 \u45208 \u45784 \u51032  \u53685 \u52824 \u50752  \u48152 \u45824 \u46104 \u45716  \u49324 \u45800 \u51032  \u48277 \u52825 \u51060  \u49892 \u52380 \u46108  \u44208 \u44284 \u44032  \u47924 \u50631 \u51076 \u51060  \u50728  \u50864 \u51452 \u50640  \u44277 \u44060 \u46104 \u50632 \u45796 . \u49324 \u45800  \u51088 \u49888 \u51032  \u49324 \u50629 \u51060  \u44536 \u47484  \u51221 \u51396 \u54664 \u45796 . \u54616 \u45208 \u45784 \u51032  \u51648 \u54812 \u50752  \u44277 \u51032 \u50752  \u51088 \u48708 \u45716  \u50756 \u51204 \u55176  \u50745 \u54840 \u46104 \u50632 \u45796 . \u45824 \u51137 \u53804 \u47484  \u53685 \u54616 \u50668  \u54616 \u45208 \u45784 \u44760 \u49436  \u52712 \u54616 \u49888  \u52376 \u49324 \u44032  \u50724 \u47196 \u51648  \u45817 \u49888 \u51032  \u48177 \u49457 \u46308 \u51032  \u50689 \u50896 \u54620  \u54665 \u48373 \u44284  \u44536 \u48516 \u44760 \u49436  \u52285 \u51312 \u54616 \u49888  \u47784 \u46304  \u49464 \u44228 \u51032  \u50976 \u51061 \u51012  \u50948 \u54616 \u50668  \u54616 \u49888  \u51068 \u51076 \u51060  \u46300 \u47084 \u45212 \u45796 . \'93\u50668 \u54840 \u50752 \u50668  \u51452 \u51032  \u51648 \u51004 \u49888  \u47784 \u46304  \u44163 \u51060  \u51452 \u44760  \u44048 \u49324 \u54616 \u47728  \u51452 \u51032  \u49457 \u46020 \u44032  \u51452 \u47484  \u49569 \u52629 \u54616 \u47532 \u51060 \u45796 \'94 (\u49884  145:10). \u51396 \u51032  \u50669 \u49324 \u45716  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51060  \u54616 \u45208 \u45784 \u44760 \u49436  \u51648 \u51004 \u49888  \u47784 \u46304  \u47564 \u47932 \u51032  \u54665 \u48373 \u51012  \u50948 \u54616 \u50668  \u51080 \u45716  \u44163 \u51076 \u51012  \u51077 \u51613 \u54616 \u44592  \u50948 \u54616 \u50668  \u50689 \u50896 \u55176  \u45224 \u50500  \u51080 \u51012  \u44163 \u51060 \u45796 .\u52649 \u49457 \u46108  \u51088 \u50752  \u48152 \u50669 \u54620  \u51088 \u46308 \u51012  \u47561 \u47200 \u54616 \u44256  \u50728  \u50864 \u51452 \u45716  \u45824 \u51137 \u53804 \u50640  \u49549 \u54620  \u47784 \u46304  \u49324 \u49892 \u51012  \u48148 \u46972 \u48372 \u47732 \u49436  \u54620  \u47560 \u51020 \u51004 \u47196  \'93\u47564 \u44397 \u51032  \u50773 \u51060 \u49884 \u50668  \u51452 \u51032  \u44600 \u51060  \u51032 \u47213 \u44256  \u52280 \u46104 \u49884 \u46020 \u45796 \'94\u44256  \u49440 \u50616 \u54620 \u45796 .\
\uc0\u50500 \u48260 \u51648  \u54616 \u45208 \u45784 \u44284  \u50500 \u46308  \u50696 \u49688 \u45784 \u44760 \u49436  \u51064 \u47448 \u47484  \u50948 \u54616 \u50668  \u48288 \u54392 \u49888  \u53360  \u55148 \u49373 \u51060  \u48516 \u47749 \u55176  \u51228 \u49884 \u46104 \u50632 \u45796 . \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u45817 \u49888 \u51032  \u51221 \u45817 \u54620  \u51648 \u50948 \u47484  \u52264 \u51648 \u54616 \u44256 , \u51221 \u49324 \u50752  \u44428 \u49464 \u50752  \u47784 \u46304  \u51060 \u47492  \u50948 \u50640  \u46832 \u50612 \u45212  \u50689 \u44305 \u51012  \u48155 \u51004 \u49892  \u46412 \u44032  \u50772 \u45796 . \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u49901 \u51088 \u44032 \u51032  \u44404 \u50837 \u51012  \u52280 \u51004 \u49884 \u44256  \u48512 \u45124 \u47084 \u50880 \u51012  \u44060 \u51032 \u52824  \u50506 \u51004 \u49888  \u44163 \u51008  \u45817 \u49888  \u50526 \u50640  \u51080 \u45716  \u51600 \u44144 \u50880 , \u44263  \u47566 \u51008  \u50500 \u46308 \u46308 \u51012  \u50689 \u44305 \u51004 \u47196  \u51064 \u46020 \u54616 \u45716  \u51600 \u44144 \u50880 \u51012  \u50948 \u54644 \u49436 \u50688 \u45796 . \u44536  \u49836 \u54548 \u44284  \u52824 \u50837 \u51008  \u49345 \u49345 \u54624  \u49688  \u50630 \u51012  \u47564 \u53372  \u52984 \u51648 \u47564  \u44592 \u49256 \u44284  \u50689 \u44305 \u51008  \u44536 \u48372 \u45796  \u45908  \u52984 \u45796 . \u44536 \u48516 \u51008  \u44396 \u50896 \u48155 \u51008  \u51088 \u46308 \u51060  \u45817 \u49888 \u51032  \u54805 \u49345 \u51012  \u54924 \u48373 \u54616 \u44256 , \u47784 \u46304  \u47560 \u51020 \u50640  \u54616 \u45208 \u45784 \u51032  \u50756 \u51204 \u54620  \u47784 \u49845 \u51012  \u44036 \u51649 \u54616 \u44256 , \u47784 \u46304  \u50620 \u44404 \u50640  \u44536 \u46308 \u51032  \u50773 \u51032  \u54805 \u49345 \u51012  \u48152 \u50689 \u54616 \u44256  \u51080 \u51020 \u51012  \u48372 \u49888 \u45796 . \u44536 \u48516 \u51008  \u45817 \u49888 \u51032  \u49688 \u44256 \u51032  \u44208 \u44284 \u44032  \u44536 \u46308  \u44032 \u50868 \u45936  \u45208 \u53440 \u45208  \u51080 \u45716  \u44163 \u51012  \u48372 \u49884 \u44256  \u49900 \u55176  \u47564 \u51313 \u54644 \u54616 \u49888 \u45796 . \u44536 \u46412  \u44536 \u48516 \u44760 \u49436 \u45716  \u51032 \u51064 \u51032  \u47924 \u47532 \u50752  \u50501 \u51064 \u51032  \u47924 \u47532 \u44032  \u45796  \u44057 \u51060  \u46308 \u51012  \u49688  \u51080 \u45716  \u51020 \u49457 \u51004 \u47196  \u50808 \u52824 \u49888 \u45796 . \'93\u45208 \u51032  \u54588 \u47196  \u49328  \u51088 \u46308 \u51012  \u48372 \u46972 ! \u45208 \u45716  \u44536 \u46308 \u51012  \u50948 \u54616 \u50668  \u44256 \u45212 \u51012  \u48155 \u50520 \u45796 . \u45208 \u45716  \u44536 \u46308 \u51012  \u50948 \u54616 \u50668  \u51453 \u50632 \u45796 . \u45208 \u45716  \u44536 \u46308 \u51060  \u50689 \u50896 \u53664 \u47197  \u45236  \u50526 \u50640 \u49436  \u49332 \u50500 \u44032 \u44172  \u54616 \u44256 \u51088  \u44536 \u47088  \u51068 \u51012  \u45817 \u54616 \u50688 \u45796 .\'94 \u44536 \u46412  \u48372 \u51340 \u47484  \u46168 \u47084  \u51080 \u45716  \u55152 \u50743 \u51012  \u51077 \u51008  \u47924 \u47532 \u46308 \u51060  \'93\u51453 \u51076 \u51012  \u45817 \u54616 \u49888  \u50612 \u47536 \u50577 \u51060  \u45733 \u47141 \u44284  \u48512 \u50752  \u51648 \u54812 \u50752  \u55192 \u44284  \u51316 \u44480 \u50752  \u50689 \u44305 \u44284  \u52268 \u49569 \u51012  \u48155 \u51004 \u49884 \u44592 \u50640  \u54633 \u45817 \u54616 \u46020 \u45796 \'94 (\u44228  5:12) \u46972 \u44256  \u52268 \u50577 \u51032  \u45432 \u47000 \u47484  \u48512 \u47480 \u45796 .\
\uc0\u48708 \u47197  \u49324 \u45800 \u51060  \u54616 \u45208 \u45784 \u51032  \u44277 \u51032 \u47484  \u51064 \u51221 \u54616 \u44256  \u44536 \u47532 \u49828 \u46020 \u51032  \u52572 \u49345 \u44428 \u50640  \u45824 \u54616 \u50668  \u47924 \u47502 \u51012  \u44999 \u51012  \u49688 \u48150 \u50640  \u50630 \u51012 \u51648 \u46972 \u46020  \u44536 \u51032  \u54408 \u49457 \u51008  \u48320 \u54868 \u46104 \u51648  \u50506 \u45716 \u45796 . \u48152 \u50669 \u51032  \u51221 \u49888 \u51060  \u44053 \u54620  \u44553 \u47448 \u50752  \u44057 \u51060  \u45796 \u49884  \u48128 \u47140 \u50728 \u45796 . \u49324 \u45800 \u51008  \u48516 \u45432 \u47196  \u52649 \u47564 \u54644 \u51256  \u45824 \u51137 \u53804 \u50640  \u54637 \u48373 \u54616 \u51648  \u50506 \u44592 \u47196  \u44208 \u49900 \u54620 \u45796 . \u44536 \u47532 \u54616 \u50668  \u54616 \u45720  \u50773 \u50640  \u45824 \u54620  \u47560 \u51648 \u47561  \u44208 \u49324 \u51201  \u51137 \u53804 \u44032  \u51204 \u44060 \u46108 \u45796 . \u44536 \u45716  \u48512 \u54616 \u46308  \u44032 \u50868 \u45936  \u46832 \u50612  \u46308 \u50612 \u44032 \u49436 , \u48516 \u45432 \u50640  \u49324 \u47196 \u51105 \u54784  \u44536 \u46308 \u51012  \u52649 \u46041 \u49884 \u53020  \u51593 \u49884  \u51068 \u45824  \u44208 \u51204 \u51012  \u54616 \u46020 \u47197  \u45432 \u47141 \u54620 \u45796 . \u44536 \u47084 \u45208  \u44536 \u44032  \u48152 \u50669 \u54616 \u46020 \u47197  \u50976 \u54841 \u54620  \u47924 \u49688 \u54620  \u47924 \u47532  \u44032 \u50868 \u45936  \u51060 \u51228  \u44536 \u51032  \u52572 \u49345 \u44428 \u51012  \u51064 \u51221 \u54616 \u45716  \u51088 \u45716  \u54616 \u45208 \u46020  \u50630 \u45796 . \u44536 \u51032  \u44428 \u49464 \u45716  \u45149 \u45228 \u45796 . \u50501 \u51064 \u46308 \u51008  \u49324 \u45800 \u51060  \u44256 \u52712 \u54616 \u45716  \u48148 \u50752  \u46609 \u44057 \u51060  \u54616 \u45208 \u45784 \u44760  \u45824 \u54620  \u51613 \u50724 \u49900 \u51004 \u47196  \u52649 \u47564 \u54644  \u51080 \u45796 . \u44536 \u47084 \u45208  \u44536 \u46308 \u51032  \u52376 \u51648 \u44032  \u51208 \u47581 \u51201 \u51060 \u46972 \u45716  \u44163 \u44284  \u44536 \u46308 \u51060  \u50668 \u54840 \u50752 \u47484  \u44208 \u53076  \u51060 \u44600  \u49688  \u50630 \u45796 \u45716  \u44163 \u51012  \u50504 \u45796 . \u44536 \u46308 \u51032  \u44536  \u48516 \u45432 \u45716  \u49324 \u45800 \u44284 , \u44592 \u47564 \u50640  \u51080 \u50612 \u49436  \u44536 \u51032  \u45824 \u47532  \u50669 \u54624 \u51012  \u54644 \u50772 \u45912  \u51088 \u46308 \u51012  \u54693 \u54616 \u50668  \u54253 \u48156 \u46108 \u45796 . \u44536 \u46308 \u51008  \u50501 \u47560 \u50752  \u44057 \u51008  \u48516 \u45432 \u47196  \u49324 \u45800 \u44284  \u44536  \u45824 \u47532 \u51088 \u46308 \u50640 \u44172  \u45804 \u47140 \u46304 \u45796 .\
