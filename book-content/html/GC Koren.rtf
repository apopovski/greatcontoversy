\uc0\u49888 \u44368 \u51032  \u51088 \u50976 \u45716  \u48277 \u47456 \u49345 \u51004 \u47196  \u47749 \u49884 \u46104 \u50612  \u51080 \u50632 \u51004 \u48064 \u47196 , \u44060 \u54785  \u50868 \u46041 \u51012  \u50745 \u54840 \u54616 \u45716  \u51452  (\u24030 ) \u50640 \u49436 \u45716  \u44536 \u46308 \u51032  \u44428 \u47532 \u51032  \u52840 \u54644 \u47484  \u48152 \u45824 \u54616 \u45716  \u44208 \u51032 \u47484  \u54616 \u50688 \u45796 . \u47336 \u53552 \u45716  \u48372 \u47492 \u49828  \u54924 \u51032 \u51032  \u52825 \u47161 \u50640  \u51032 \u54616 \u50668  \u54028 \u47928 \u51012  \u45817 \u54616 \u44256  \u51080 \u50632 \u51004 \u48064 \u47196 , \u49828 \u54028 \u51060 \u50620 \u49828  \u54924 \u51032 \u50640  \u52636 \u49437 \u54616 \u45716  \u51068 \u51012  \u54728 \u46973 \u48155 \u51648  \u47803 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u51060 \u52376 \u47100  \u50948 \u44553 \u54620  \u46412 \u50640  \u54616 \u45208 \u45784 \u44760 \u49436  \u45817 \u49888 \u51032  \u49324 \u50629 \u51012  \u50745 \u54840 \u54616 \u44592  \u50948 \u54616 \u50668  \u51068 \u51004 \u53020  \u51452 \u49888  \u51228 \u54980 \u46308 \u44284  \u46041 \u50669 \u51088 \u46308 \u51060  \u47336 \u53552 \u47484  \u45824 \u49888 \u54616 \u50668  \u51068 \u51012  \u54616 \u50688 \u45796 . \u51204 \u50640  \u47336 \u53552 \u51032  \u50745 \u54840 \u51088 \u47196  \u51068 \u54616 \u45912  \u51089 \u49468 \u51032  \u54532 \u47532 \u46300 \u47532 \u55176  \u54980 \u45716  \u51060 \u48120  \u51453 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44536 \u51032  \u54980 \u44228 \u51088 \u51064  \u44536 \u51032  \u50500 \u50864  \u50836 \u54620  \u54980  \u46608 \u54620  \u44060 \u54785  \u49324 \u50629 \u51012  \u54872 \u50689 \u54616 \u50688 \u50632 \u45796 . \u44536 \u45716  \u54217 \u54868 \u51032  \u50528 \u54840 \u51088 \u47196 \u49436  \u49888 \u50521 \u50640  \u44288 \u54620  \u47784 \u46304  \u47928 \u51228 \u50640  \u45824 \u54616 \u50668  \u47566 \u51008  \u45432 \u47141 \u44284  \u53360  \u50857 \u44592 \u47484  \u45208 \u53440 \u45236 \u50632 \u45796 .\
\uc0\u49888 \u48512 \u46308 \u51008  \u44060 \u54785  \u49324 \u50629 \u51012  \u50857 \u51064  (\u23481 \u35469 ) \u54620  \u51452 \u46308 \u51060  \u47196 \u47560 \u51032  \u44428 \u50948 \u50640  \u51208 \u45824 \u51201 \u51004 \u47196  \u48373 \u51333 \u54616 \u44592 \u47484  \u50836 \u44396 \u54616 \u50688 \u45796 . \u48152 \u47732 \u50640  \u44060 \u54785 \u54028 \u45716  \u51060 \u48120  \u54728 \u46973 \u46108  \u51088 \u50976 \u47484  \u51452 \u51109 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u53360  \u44592 \u49256 \u51004 \u47196  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51012  \u48155 \u50500 \u46308 \u51064  \u50668 \u47084  \u51452 \u46308 \u51012  \u47196 \u47560 \u44368 \u44032  \u45796 \u49884  \u44536 \u46308 \u51032  \u51648 \u48176  \u50500 \u47000  \u46160 \u44256 \u51088  \u54616 \u45716  \u51068 \u50640  \u44208 \u53076  \u46041 \u51032 \u54616 \u51648  \u50506 \u50520 \u45796 .\
\uc0\u50500 \u51649  \u44060 \u54785  \u49324 \u50629 \u51060  \u54869 \u47549 \u46104 \u51648  \u50500 \u45768 \u54620  \u50668 \u47084  \u51452 \u50640 \u45716  \u48372 \u47492 \u49828 \u51032  \u52825 \u47161 \u51012  \u44053 \u47141 \u54616 \u44172  \u51060 \u54665 \u49884 \u53420  \u44163 , \'93\u51060  \u52825 \u47161 \u50640  \u48373 \u51333 \u52824  \u50500 \u45768 \u54616 \u45716  \u51452 , \u44263  \u51060  \u52825 \u47161 \u51012  \u44053 \u51228 \u54616 \u45716  \u44221 \u50864 \u50640  \u48152 \u46976 \u51060  \u51068 \u50612 \u45216  \u50948 \u54744 \u51060  \u51080 \u45716  \u51452 \u45716  \u52572 \u49548 \u54620  \u50612 \u46500  \u49352 \u47196 \u50868  \u44060 \u54785 \u46020  \u51068 \u51004 \u53412 \u51648  \u47568  \u44163 , \u45436 \u51137 \u51012  \u51068 \u51004 \u53420  \u51216 \u50640  \u48512 \u46378 \u55176 \u44144 \u45208  \u48120 \u49324 \u51032  \u44144 \u54665 \u50640  \u48152 \u45824 \u54616 \u51648  \u47568  \u44163 , \u50612 \u46500  \u47196 \u47560 \u44368 \u46020 \u50640 \u44172 \u46020  \u47336 \u53552 \u54028 \u51032  \u49324 \u49345 \u51012  \u45347 \u50612  \u51452 \u51648  \u47568  \u44163 \'94 (D\'92Aubigne, b.13, ch.5) \u46321 \u51032  \u53440 \u54801 \u50504 \u51060  \u51228 \u52636 \u46104 \u50632 \u45796 . \u51060  \u48277 \u50504 \u51008  \u51032 \u54924 \u47484  \u53685 \u44284 \u54616 \u50688 \u51004 \u47728  \u48277 \u50773 \u52769 \u51032  \u49888 \u48512 \u46308 \u44284  \u51452 \u44368 \u46308 \u51008  \u53356 \u44172  \u47564 \u51313 \u54616 \u50688 \u45796 .\
\uc0\u51060 \u47084 \u54620  \u52825 \u47161 \u51060  \u49884 \u54665 \u46108 \u45796 \u47732 , \'93\u44060 \u54785  \u49324 \u50629 \u51008  \u48120 \u44060 \u52377 \u51032  \u51648 \u48169 \u51004 \u47196  \u54869 \u45824 \u46112  \u49688  \u50630 \u44144 \u45768 \u50752  \u51060 \u48120  \u51204 \u54028 \u46108  \u51648 \u48169 \u50640 \u49436 \u46020  \u54869 \u44256 \u54620  \u44592 \u52488 \u47484  \u49464 \u50872  \u49688 \u44032  \u50630 \u50632 \u45796 \'94 (D\'92Aubigne, b.13, ch.5). \u50616 \u47200 \u51032  \u51088 \u50976 \u44032  \u50630 \u50612 \u51648 \u44256 , \u44060 \u51333  (\u25913 \u23447 ) \u46020  \u54728 \u46973 \u46104 \u51648  \u50506 \u51012  \u44163 \u51060 \u50632 \u45796 . \u44060 \u54785  \u49324 \u50629 \u51032  \u46041 \u51648 \u46308 \u51008  \u51060 \u47084 \u54620  \u51228 \u54620 \u44284  \u44552 \u51648  \u49324 \u54637 \u51012  \u51593 \u49884  \u49688 \u46973 \u54616 \u46020 \u47197  \u44053 \u50836 \u45817 \u54616 \u50688 \u45796 . \u51060 \u51228  \u49464 \u49345 \u51032  \u49548 \u47581 \u51008  \u44144 \u51032  \u49324 \u46972 \u51256 \u44032 \u45716  \u46319 \u54616 \u50688 \u45796 . \'93\u47196 \u47560 \u44368 \u51032  \u44368 \u44428  \u51221 \u52824 \u51032  \u51116 \u54869 \u47549 \u51008  \u54596 \u50672 \u51201 \u51004 \u47196  \u50715 \u45216 \u51032  \u50501 \u54224 \u47484  \u48512 \u54876 \u49884 \u53412 \u45716  \u44208 \u44284 \u44032  \u46112  \u44163 \u51060 \u50632 \u45796 .\'94 \u51060 \u48120  \u44305 \u49888 \u44284  \u48516 \u50676 \u47196  \u51064 \u54616 \u50668  \'93\u53356 \u44172  \u55124 \u46308 \u47532 \u44172  \u46108  \u44060 \u54785  \u49324 \u50629 \u46020  \u48148 \u50556 \u55120 \u47196  \u51204 \u47736 \u54624  \u49688 \u48150 \u50640  \u50630 \u45716  \u51648 \u44221 \u50640  \u51060 \u47480  \u44163  \u44057 \u50520 \u45796 \'94 (D\'92Aubigne, b.13, ch.5).\
