\uc0\u51060 \u47084 \u54620  \u51060 \u44368 \u50752  \u44536 \u47532 \u49828 \u46020 \u44368 \u54924  \u49324 \u51060 \u51032  \u53440 \u54801 \u51008  \u54616 \u45208 \u45784 \u51012  \u45824 \u51201 \u54616 \u44256  \u54616 \u45208 \u45784 \u48372 \u45796 \u46020  \u51088 \u44592 \u47484  \u45908  \u45458 \u51060 \u47532 \u46972 \u44256  \u50696 \u50616 \u46108  \u51396 \u50501 \u51032  \u49324 \u46988 \u51032  \u48156 \u51204 \u51012  \u52488 \u47000 \u54616 \u50688 \u45796 . \u51060 \u47084 \u54620  \u44144 \u51667  \u51333 \u44368 \u51032  \u44144 \u45824 \u54620  \u51312 \u51649 \u51008  \u49324 \u45800 \u51032  \u45733 \u47141 \u51032  \u44152 \u51089 \u54408 , \u44263  \u49828 \u49828 \u47196  \u48372 \u51340 \u50640  \u50505 \u50500 \u49436  \u51088 \u44592 \u51032  \u46907 \u45824 \u47196  \u49464 \u49345 \u51012  \u51648 \u48176 \u54616 \u44256 \u51088  \u54616 \u45716  \u44536 \u51032  \u45432 \u47141 \u51032  \u44592 \u45392 \u53457 \u51060 \u45796 .\
\uc0\u49324 \u45800 \u51008  \u44536 \u47532 \u49828 \u46020 \u50752  \u45908 \u48520 \u50612  \u53440 \u54801 \u54616 \u47140 \u44256  \u45432 \u47141 \u54620  \u51201 \u51060  \u51080 \u50632 \u45796 . \u44536 \u45716  \u49884 \u54744 \u51032  \u44305 \u50556 \u50640 \u49436  \u54616 \u45208 \u45784 \u51032  \u50500 \u46308 \u50640 \u44172  \u45208 \u53440 \u45208  \u52380 \u54616 \u47564 \u44397 \u44284  \u44536  \u50689 \u54868 \u47484  \u48372 \u51060 \u47732 \u49436  \u47564 \u51068  \u50516 \u55121 \u51032  \u50773 \u51032  \u52572 \u49345 \u44428 \u47564  \u51064 \u51221 \u54644  \u51452 \u47732  \u44536  \u47784 \u46304  \u44163 \u51012  \u44536 \u48516 \u50640 \u44172  \u51452 \u44192 \u45432 \u46972 \u44256  \u51228 \u51032 \u54616 \u50688 \u45796 . \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u44536  \u52280 \u46988 \u46108  \u50976 \u54841 \u51088 \u47484  \u44204 \u52293 \u54616 \u49884 \u44256 , \u44536 \u47484  \u51923 \u50500 \u48260 \u47532 \u49512 \u45796 . \u44536 \u47084 \u45208  \u49324 \u45800 \u51008  \u50724 \u45720 \u45216  \u47566 \u51008  \u49324 \u46988 \u46308 \u50640 \u44172  \u46609 \u44057 \u51008  \u49884 \u54744 \u51012  \u51228 \u49884 \u54616 \u50668  \u53360  \u49457 \u44277 \u51012  \u44144 \u46160 \u44256  \u51080 \u45796 . \u49464 \u49345 \u51032  \u51060 \u51061 \u44284  \u50689 \u50696 \u47484  \u50619 \u44592  \u50948 \u54616 \u50668  \u44368 \u54924 \u45716  \u49464 \u49345 \u51032  \u50948 \u45824 \u54620  \u51064 \u47932 \u46308 \u51032  \u52268 \u49457 \u44284  \u51648 \u51648 \u47484  \u44396 \u54616 \u46020 \u47197  \u51064 \u46020 \u46104 \u50632 \u51004 \u47728 , \u44536 \u47111 \u44172  \u54632 \u51004 \u47196  \u44536 \u47532 \u49828 \u46020 \u47484  \u44144 \u51208 \u54620  \u54980 \u50640 \u45716  \u49324 \u45800 \u51032  \u45824 \u54364 \u51064  \u47196 \u47560 \u44368 \u51032  \u44048 \u46021 \u50640 \u44172  \u52649 \u49457 \u54616 \u46020 \u47197  \u44428 \u50976 \u47484  \u48155 \u50520 \u4579