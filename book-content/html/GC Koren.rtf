\uc0\u49464 \u49345 \u51032  \u49845 \u44288 \u51012  \u46384 \u47484  \u44163  \u44057 \u51004 \u47732  \u44368 \u54924 \u44032  \u49464 \u49345 \u51004 \u47196  \u46028 \u50500 \u44032 \u51648  \u49464 \u49345 \u51060  \u44536 \u47532 \u49828 \u46020 \u44760 \u47196  \u46028 \u50500 \u50724 \u51648  \u50506 \u51012  \u44163 \u51060 \u45796 . \u51396 \u50752  \u52828 \u49689 \u54644 \u51648 \u47732  \u54596 \u50672 \u51201 \u51004 \u47196  \u51396 \u50640  \u45824 \u54620  \u51200 \u54637 \u51060  \u51201 \u50612 \u51652 \u45796 . \u49324 \u45800 \u51032  \u51333 \u46308 \u44284  \u44368 \u51228 \u54616 \u45716  \u44600 \u51012  \u53469 \u54616 \u45716  \u51088 \u45716  \u48120 \u44396 \u50640  \u44536 \u46308 \u51032  \u51648 \u48176 \u47484  \u46160 \u47140 \u50892 \u54616 \u51648  \u50506 \u44172  \u46112  \u44163 \u51060 \u45796 . \u45796 \u45768 \u50648 \u51060  \u50773 \u51032  \u44417 \u51221 \u50640 \u49436  \u45817 \u54620  \u44163 \u52376 \u47100  \u50864 \u47532 \u46020  \u51032 \u47924 \u47484  \u51060 \u54665 \u54616 \u44592  \u50948 \u54616 \u50668  \u49884 \u47144 \u51012  \u48155 \u51012  \u46412  \u54616 \u45208 \u45784 \u44760 \u49436  \u50864 \u47532 \u47484  \u48372 \u54840 \u54644 \u51452 \u49892  \u44163 \u51012  \u54869 \u49888 \u54624  \u49688  \u51080 \u45796 . \u44536 \u47084 \u45208  \u47564 \u51068  \u50864 \u47532  \u49828 \u49828 \u47196  \u51088 \u49888 \u51012  \u49884 \u54744 \u51012  \u48155 \u45716  \u52376 \u51648 \u50640  \u46160 \u44172  \u46104 \u47732  \u50864 \u47532 \u45716  \u51312 \u47564 \u44036 \u50640  \u45336 \u50612 \u51656  \u44163 \u51060 \u45796 .\
\uc0\u50976 \u54841 \u51088 \u45716  \u55124 \u55176  \u51088 \u44592 \u51032  \u51648 \u48176 \u47484  \u48155 \u44256  \u51080 \u45716  \u44163 \u51004 \u47196  \u44144 \u51032  \u51032 \u49900 \u48155 \u51648  \u50506 \u45716  \u51088 \u46308 \u51012  \u53685 \u54616 \u50668  \u44032 \u51109  \u49457 \u44277 \u51201 \u51004 \u47196  \u54876 \u46041 \u54620 \u45796 . \u44368 \u50977 \u51012  \u47566 \u51060  \u48155 \u44256  \u51116 \u45733  \u51080 \u45716  \u49324 \u46988 \u51008  \u55124 \u55176  \u51316 \u44221 \u44284  \u52268 \u50577 \u51012  \u48155 \u46104  \u47560 \u52824  \u44536 \u47084 \u54620  \u51088 \u44201 \u46308 \u51060  \u54616 \u45208 \u45784 \u51012  \u44221 \u50808 \u54616 \u45716  \u49373 \u44033 \u51032  \u48512 \u51313 \u51012  \u48372 \u52649 \u54644  \u51452 \u44144 \u45208  \u54616 \u45208 \u45784 \u51032  \u51008 \u52509 \u51012  \u48155 \u51012  \u51088 \u44201 \u51012  \u51452 \u45716  \u44163 \u52376 \u47100  \u49373 \u44033 \u54616 \u44592  \u49789 \u45796 . \u51116 \u45733 \u44284  \u44368 \u50577  \u51088 \u52404 \u45716  \u54616 \u45720 \u51032  \u49440 \u47932 \u51060 \u45796 . \u44536 \u47084 \u45208  \u44536 \u44163 \u46308 \u51060  \u44221 \u44148 \u51032  \u45824 \u50857 \u51060  \u46112  \u46412 , \u49324 \u46988 \u51012  \u54616 \u45208 \u45784 \u44760 \u47196  \u44032 \u44620 \u51060  \u51064 \u46020 \u54616 \u44592 \u48372 \u45796  \u44536 \u48516 \u44760 \u47196 \u48512 \u53552  \u47680 \u47532  \u46496 \u45208 \u44032 \u44172  \u54624  \u46412  \u44536 \u44163 \u46308 \u51008  \u51200 \u51452 \u50752  \u54632 \u51221 \u51060  \u46108 \u45796 . \u50696 \u47784  \u51080 \u44256  \u44256 \u49345 \u54620  \u44163 \u52376 \u47100  \u48372 \u51060 \u45716  \u47784 \u46304  \u44163 \u46308 \u51008  \u50612 \u45712  \u51032 \u48120 \u50640 \u49436  \u44536 \u47532 \u49828 \u46020 \u50752  \u44288 \u47144 \u51060  \u51080 \u45796 \u44256  \u49373 \u44033 \u54616 \u45716  \u44204 \u54644 \u47484  \u44054 \u44256  \u51080 \u45716  \u49324 \u46988 \u46308 \u51060  \u47566 \u45796 . \u44536 \u47084 \u45208  \u51060 \u48372 \u45796  \u45908  \u53360  \u51096 \u47803 \u51060  \u50630 \u45796 . \u44536 \u47088  \u53945 \u49457 \u46308 \u51060  \u47784 \u46304  \u44536 \u47532 \u49828 \u46020 \u51064 \u51032  \u54408 \u49457 \u51012  \u45800 \u51109 \u54644 \u50556  \u54620 \u45796 . \u50780 \u45264 \u54616 \u47732  \u44536 \u44163 \u46308 \u51060  \u52280  \u51333 \u44368 \u47484  \u50948 \u54616 \u50668  \u51339 \u51008  \u44048 \u54868 \u47484  \u45180 \u52824 \u44592  \u46412 \u47928 \u51060 \u45796 . \u44536 \u47084 \u45208  \u44536 \u44163 \u46308 \u51008  \u54616 \u45208 \u45784 \u44760  \u48148 \u52432 \u51256 \u50556  \u54620 \u45796 . \u44536 \u47111 \u51648  \u50506 \u51004 \u47732  \u44536 \u44163 \u46308 \u51008  \u50501 \u51012  \u50948 \u54620  \u49464 \u47141 \u51060  \u46108 \u45796 . \u49464 \u47144 \u46108  \u51648 \u49457 \u44284  \u53132 \u54876 \u54620  \u53468 \u46020 \u47484  \u44032 \u51652  \u47566 \u51008  \u49324 \u46988 \u46308 , \u44536 \u47532 \u44256  \u51068 \u48152 \u51201 \u51004 \u47196  \u48512 \u46020 \u45909 \u54620  \u44163 \u51004 \u47196  \u51064 \u51221 \u46104 \u45716  \u51068 \u44284  \u51204 \u54784  \u47924 \u44288 \u54620  \u49324 \u46988 \u46308 \u51060  \u49324 \u45800 \u51032  \u49552 \u50640 \u49436  \u45800 \u51648  \u49464 \u47144 \u46108  \u44592 \u44396 \u51032  \u50669 \u54624 \u51012  \u54620 \u45796 . \u44536 \u51032  \u50689 \u54693 \u47141 \u44284  \u47784 \u48376 \u50640  \u45208 \u53440 \u45212  \u44368 \u47896 \u54616 \u44256  \u44592 \u47564 \u51201 \u51064  \u53945 \u49457 \u51008  \u47924 \u49885 \u54616 \u44256  \u44368 \u50577  \u50630 \u45716  \u51088 \u46308 \u48372 \u45796  \u45908 \u50865  \u47566 \u51008  \u50948 \u54744 \u51012  \u54616 \u45208 \u45784 \u51032  \u49324 \u50629 \u50640  \u45180 \u52828 \u45796 .\
