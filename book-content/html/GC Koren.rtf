\uc0\u50640 \u49828 \u46972 \u49436  7\u51109 \u50640  \u51060  \u47749 \u47161 \u51060  \u44592 \u47197 \u46104 \u50612  \u51080 \u45796 . \u50756 \u49457 \u46108  \u54805 \u53468 \u51032  \u51312 \u49436 \u45716  \u44592 \u50896 \u51204  457\u45380 \u50640  \u48148 \u49324  \u50773  \u50500 \u45797 \u49324 \u49828 \u45796 \u44032  \u45236 \u47160 \u45796  (\u49828  7:12~26 \u52280 \u51312 ). \u44536 \u47084 \u45208  \u50640 \u49828 \u46972 \u49436  6\u51109  14\u51208 \u50640 \u45716  \u50696 \u47336 \u49332 \u47128 \u50640  \u51080 \u45716  \u54616 \u45208 \u45784 \u51032  \u49457 \u51204 \u51060  \'93\u48148 \u49324  \u50773  \u44256 \u47112 \u49828 \u50752  \u45796 \u47532 \u50724 \u50752  \u50500 \u45797 \u49324 \u49828 \u45796 \u51032  \u51312 \u49436 \u47484  \u51335 \u50500 \'94 \u44148 \u52629 \u46104 \u50632 \u45796 \u44256  \u44592 \u47197 \u46104 \u50612  \u51080 \u45796 . \u44536  \u49464  \u50773 \u51008  \u51312 \u49436 \u47484  \u52376 \u51020 \u51004 \u47196  \u47564 \u46308 \u44256 , \u45796 \u49884  \u54869 \u51064 \u54616 \u44256 , \u50756 \u49457 \u49884 \u53428 \u51004 \u47196  2300\u45380 \u51032  \u49884 \u51089 \u51012  \u50508 \u47140  \u51452 \u45716  \u50696 \u50616 \u51032  \u50836 \u44396 \u47484  \u50756 \u51204 \u55176  \u51060 \u47336 \u44172  \u46104 \u50632 \u45796 . \u51312 \u49436 \u44032  \u50756 \u49457 \u46108  \u44592 \u50896 \u51204  457\u45380 \u51012  \u52825 \u47161 \u51060  \u45236 \u47536  \u46412 \u47196  \u49340 \u51012  \u46412  70\u51452 \u51068 \u50640  \u44288 \u54620  \u50696 \u50616 \u51032  \u49464 \u48512 \u51201 \u51064  \u49324 \u44148 \u46308 \u51060  \u47784 \u46160  \u49457 \u52712 \u46108  \u44163 \u51012  \u48516 \u47749 \u55176  \u50508  \u49688  \u51080 \u45796 .\
\'93\uc0\u50696 \u47336 \u49332 \u47128 \u51012  \u51473 \u44148 \u54616 \u46972 \u45716  \u50689 \u51060  \u45216  \u46412 \u48512 \u53552  \u44592 \u47492  \u48512 \u51020 \u51012  \u48155 \u51008  \u51088  \u44263  \u50773 \u51060  \u51068 \u50612 \u45208 \u44592 \u44620 \u51648  \u51068 \u44273  \u51060 \u47112 \u50752  \u50977 \u49901 \u51060  \u51060 \u47112 \u44032  \u51648 \u45216  \u44163 \u51060 \u50836 .\'94 \u51593 , 69\u51452 \u51068 , \u44263  483\u45380 \u51060  \u51648 \u45212 \u45796 \u45716  \u46907 \u51060 \u45796 . \u51060  \u50500 \u45797 \u49324 \u49828 \u45796  \u50773 \u51032  \u51312 \u49436 \u44032  \u54952 \u47141 \u51012  \u48156 \u49373 \u54620  \u46412 \u45716  \u44592 \u50896 \u51204  457\u45380  \u44032 \u51012 \u51060 \u45796 . \u44536  \u46412 \u47196 \u48512 \u53552  483\u45380 \u51012  \u51648 \u45208 \u47732  \u49436 \u44592  (\u35199 \u32000 ) 27\u45380 \u51060  \u46108 \u45796 . \u44536  \u46412 \u50640  \u51060  \u50696 \u50616 \u51060  \u53952 \u47548 \u50630 \u51060  \u49457 \u52712 \u46104 \u50632 \u45796 . \u47700 \u49884 \u50556 \u46972 \u45716  \u47568 \u51008  \'93\u44592 \u47492 \u48512 \u51020 \u51012  \u48155 \u51008  \u51088 \'94\u46972 \u45716  \u46907 \u51060 \u45796 . \u44536  \u54644  \u44032 \u51012 \u50640  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u50836 \u54620 \u50640 \u44172  \u52840 \u47168 \u47484  \u48155 \u51004 \u49884 \u44256  \u49457 \u47161 \u51004 \u47196  \u44592 \u47492 \u48512 \u51020 \u51012  \u48155 \u51004 \u49512 \u45796 . \u49324 \u46020  \u48288 \u46300 \u47196 \u45716  \u51060 \u50640  \u45824 \u54616 \u50668  \'93\u54616 \u45208 \u45784 \u51060  \u45208 \u49324 \u47131  \u50696 \u49688 \u50640 \u44172  \u49457 \u47161 \u44284  \u45733 \u47141 \u51012  \u44592 \u47492  \u48531 \u46319  \u54616 \u49512 \'94 (\u54665  10:38) \u45796 \u44256  \u51613 \u44144 \u54616 \u50688 \u45796 . \u44396 \u51452 \u44760 \u49436 \u46020  \u52828 \u55176  \'93\u51452 \u51032  \u49457 \u47161 \u510