\uc0\u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u52488 \u47548 \u54616 \u49512 \u51012  \u46412  \'93\u52380 \u44397 \u48373 \u51020 \'94\u51012  \u51204 \u54028 \u54620  \u51228 \u51088 \u46308 \u51032  \u44221 \u54744 \u51008  \u44536 \u48516 \u51032  \u51116 \u47548 \u51032  \u44592 \u48324 \u51012  \u51204 \u54616 \u45716  \u49324 \u46988 \u46308 \u51032  \u44221 \u54744 \u44284  \u54988 \u47469 \u54620  \u48708 \u44368 \u44032  \u46108 \u45796 . \u47560 \u52824  \u51228 \u51088 \u46308 \u51060  \u45208 \u44032 \u49436  \'93\u46412 \u44032  \u52284 \u44256  \u54616 \u45208 \u45784  \u45208 \u46972 \u44032  \u44032 \u44620 \u50912 \'94\u45796 \u44256  \u51204 \u54028 \u54664 \u45912  \u44163 \u52376 \u47100  \u48128 \u47084 \u50752  \u44536 \u51032  \u46041 \u50669 \u51088 \u46308 \u51008  \u49457 \u44221 \u50640  \u44592 \u47197 \u46108  \u44032 \u51109  \u44600 \u44256  \u52572 \u51333 \u51201 \u51064  \u50696 \u50616 \u51201  \u44592 \u44036 \u51060  \u48148 \u50556 \u55120 \u47196  \u45149 \u45208 \u47140 \u44256  \u54620 \u45796 \u45716  \u44163 \u44284 , \u49900 \u54032 \u51032  \u45216 \u51060  \u44032 \u44620 \u50912 \u45796 \u45716  \u44163 \u44284  \u50689 \u50896 \u54620  \u45208 \u46972 \u44032  \u49464 \u50892 \u51648 \u47140  \u54620 \u45796 \u45716  \u44163 \u51012  \u51204 \u54028 \u54616 \u50688 \u45796 . \u51228 \u51088 \u46308 \u51060  \u51613 \u44144 \u54620  \'93\u46412 \'94\u45716  \u44536  \u44540 \u44144 \u47484  \u45796 \u45768 \u50648 \u49436  9\u51109 \u51032  70\u51452 \u51068 \u50640  \u46160 \u50632 \u45796 . \u44536 \u47088 \u45936  \u48128 \u47084 \u50752  \u44536 \u51032  \u46041 \u50669 \u51088 \u46308 \u51060  \u51204 \u54620  \u44592 \u48324 \u51008  70\u51452 \u51068 \u51060  \u44536  \u51068 \u48512 \u48516 \u50640  \u54644 \u45817 \u54616 \u45716  \u45796 \u45768 \u50648 \u49436  8\u51109  14\u51208 \u51032  2300\u51068 \u51032  \u45149 \u50640  \u44288 \u54620  \u44592 \u48324 \u51060 \u50632 \u45796 . \u44536 \u47084