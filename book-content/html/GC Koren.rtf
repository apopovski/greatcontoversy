\f1\b0 \cf0 \
\uc0\u44368 \u54924 \u51032  \u48149 \u54644 \u45716  \u51068 \u52380 \u51060 \u48177 \u50977 \u49901  \u45380 \u51032  \u51204  \u44592 \u44036  \u44228 \u49549 \u46104 \u51648 \u45716  \u50506 \u50520 \u45796 . \u45817 \u49888 \u51032  \u48177 \u49457 \u51012  \u44557 \u55100 \u55176  \u50668 \u44592 \u49884 \u45716  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u44537 \u47148 \u54620  \u49884 \u47144 \u51032  \u49884 \u44592 \u47484  \u45800 \u52629 \u49884 \u53412 \u49512 \u45796 . \u44396 \u51452 \u44760 \u49436 \u45716  \u44368 \u54924 \u50640  \u51076 \u54624  \'93\u53360  \u54872 \u45212 \'94\u50640  \u45824 \u54616 \u50668  \u50696 \u50616 \u54616 \u49884 \u47732 \u49436  \'93\u44536 \u45216 \u46308 \u51012  \u44048 \u54616 \u51648  \u50500 \u45768 \u54624  \u44163 \u51060 \u47732  \u47784 \u46304  \u50977 \u52404 \u44032  \u44396 \u50896 \u51012  \u50619 \u51648  \u47803 \u54624  \u44163 \u51060 \u45208  \u44536 \u47084 \u45208  \u53469 \u54616 \u49888  \u51088 \u46308 \u51012  \u50948 \u54616 \u50668  \u44536 \u45216 \u46308 \u51012  \u44048 \u54616 \u49884 \u47532 \u46972 \'94 (\u47560  24:22) \u44256  \u47568 \u50432 \u54616 \u49512 \u45796 . \u49324 \u49892 \u49345  \u48149 \u54644 \u45716  \u51333 \u44368 \u44060 \u54785 \u51032  \u50689 \u54693 \u51012  \u48155 \u50500  1798\u45380 \u51060  \u51060 \u47476 \u44592  \u51204 \u50640  \u51060 \u48120  \u45149 \u45228 \u45796 .\
\uc0\u49440 \u51648 \u51088 \u45716  \u46160  \u51613 \u51064 \u50640  \u45824 \u54616 \u50668  \'93\u51060 \u45716  \u51060  \u46405 \u51032  \u51452  \u50526 \u50640  \u49456 \u45716  \u46160  \u44048 \u46988 \u45208 \u47924 \u50752  \u46160  \u52507 \u45824 \'94 (\u44228  11:4) \u46972 \u44256  \u54616 \u50688 \u45796 . \u46608  \u49884 \u54200  \u44592 \u51088 \u45716  \'93\u51452 \u51032  \u47568 \u50432 \u51008  \u45236  \u48156 \u50640  \u46321 \u51060 \u50836  \u45236  \u44600 \u50640  \u48731 \u51060 \u45768 \u51060 \u45796 \'94 (\u49884  119:105) \u46972 \u44256  \u54616 \u50688 \u45796 . \u44536 \u47084 \u48064 \u47196  \u46160  \u51613 \u51064 \u51008  \u44396 \u50557 \u44284  \u49888 \u50557  \u49457 \u44221 \u51012  \u45824 \u54364 \u54620 \u45796 . \u44396 \u50557 \u44284  \u49888 \u50557 \u51008  \u45796  \u44057 \u51060  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51032  \u44592 \u50896 \u44284  \u50689 \u49549 \u49457  (\u27704 \u32396 \u24615 ) \u51012  \u50508 \u47140  \u51452 \u45716  \u51473 \u50836 \u54620  \u51613 \u51064 \u46308 \u51060 \u45796 . \u44536  \u46160  \u49457 \u44221 \u51008  \u46608 \u54620  \u44396 \u50896 \u51032  \u44228 \u54925 \u51012  \u51613 \u44144 \u54644  \u51456 \u45796 . \u44396 \u50557  \u49457 \u44221 \u50640  \u44592 \u47197 \u46108  \u54364 \u49345 \u44284  \u55148 \u49373  \u51228 \u46020 \u50752  \u50696 \u50616 \u46308 \u51008  \u47784 \u46160  \u51109 \u52264  \u50732  \u44396 \u51452 \u47484  \u51648 \u51201 \u54644  \u51456 \u45796 . \u44536 \u47532 \u44256  \u49888 \u50557 \u51032  \u49324 \u48373 \u51020 \u49436 \u50752  \u54200 \u51648 \u49436 \u45716  \u54364 \u49345 \u44284  \u50696 \u50616 \u51012  \u53685 \u54616 \u50668  \u48120 \u47532  \u50508 \u47140  \u51456  \u44536 \u45824 \u47196  \u51312 \u44552 \u46020  \u53952 \u47548 \u50630 \u51060  \u44053 \u47548 \u54616 \u49888  \u44396 \u51452 \u47484  \u51613 \u50616 \u54616 \u44256  \u51080 \u45796 .\
\'93\uc0\u51200 \u55148 \u44032  \u51068 \u52380 \u51060 \u48177 \u50977 \u49901 \u51068 \u51012  \u48288 \u50743 \u51012  \u51077 \u44256  \u50696 \u50616 \u54616 \u47532 \u46972 .\'94 \u44536  \u44592 \u44036 \u51032  \u45824 \u48512 \u48516 \u50640  \u54616 \u45208 \u45784 \u51032  \u51613 \u51064 \u51008  \u47784 \u54840 \u54620  \u49345 \u53468 \u50640  \u45459 \u50668  \u51080 \u50632 \u45796 . \u48277 \u50773 \u44428 \u51008  \u51652 \u47532 \u51032  \u47568 \u50432 \u51012  \u48177 \u49457 \u46308 \u47196 \u48512 \u53552  \u49704 \u44592 \u44256  \u44536 \u46308  \u50526 \u50640  \u44536  \u51613 \u50616 \u44284  \u48176 \u52824 \u46104 \u45716  \u44144 \u51667  \u51613 \u51064 \u51012  \u49464 \u50864 \u44256 \u51088  \u50528 \u47484  \u50044 \u45796  (\u48512 \u47197  20 \u52280 \u51312 ). \u49457 \u44221 \u51060  \u51333 \u44368 \u50752  \u49464 \u49549 \u51032  \u44428 \u49464 \u50640  \u51032 \u54616 \u50668  \u52628 \u48169 \u46104 \u50632 \u51012  \u46412 , \u49457 \u44221 \u51032  \u51613 \u44144 \u44032  \u44257 \u54644 \u46104 \u44256 , \u49324 \u46988 \u46308 \u44284  \u50501 \u47560 \u46308 \u51060  \u49457 \u44221 \u51004 \u47196 \u48512 \u53552  \u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u51012  \u46028 \u51060 \u53412 \u44172  \u54616 \u44256 \u51088  \u50728 \u44054  \u50672 \u44396 \u50752  \u45432 \u47141 \u51012  \u44592 \u50872 \u51060 \u44256  \u51080 \u45716  \u46041 \u50504 , \u49457 \u44221 \u51032  \u44144 \u47337 \u54620  \u51652 \u47532 \u47484  \u45824 \u45812 \u54616 \u44172  \u51613 \u44144 \u54616 \u45716  \u49324 \u46988 \u46308 \u51060  \u49688 \u49353 \u45817 \u54616 \u44256 , \u48176 \u49888 \u45817 \u54616 \u44256 , \u44256 \u47928 \u51012  \u48155 \u44256 , \u44048 \u50725 \u50640  \u44039 \u55176 \u44256 , \u48127 \u51020  \u46412 \u47928 \u50640  \u49692 \u44368 \u47484  \u45817 \u54616 \u44144 \u45208  \u44618 \u51008  \u49328 \u49549 \u44284  \u46405 \u49549 \u51032  \u46041 \u44404 \u50640  \u46020 \u54588 \u54624  \u49688 \u48150 \u50640  \u50630 \u45716  \u52376 \u51648 \u44032  \u46104 \u50632 \u51012  \u46412 , \u44536  \u52649 \u49457 \u46108  \u51613 \u51064 \u46308 \u51008  \u48288 \u50743 \u51012  \u51077 \u44256  \u50696 \u50616 \u54616 \u50688 \u45796 . \u44536 \u47532 \u44256  \u44536 \u46308 \u51008  \u51068 \u52380 \u51060 \u48177 \u50977 \u49901  \u45380 \u51032  \u51204  \u44592 \u44036 \u51012  \u53685 \u54616 \u50668  \u51613 \u44144 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u44536 \u52376 \u47100  \u44032 \u51109  \u50612 \u46160 \u50868  \u49884 \u44592 \u50640  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51012  \u49324 \u46993 \u54616 \u44256  \u44536 \u48516 \u51032  \u50689 \u44305 \u51012  \u50948 \u54616 \u50668  \u50676 \u49457 \u51012  \u45796 \u54620  \u52649 \u49457 \u46108  \u49324 \u46988 \u46308 \u51060 \u45796 . \u52649 \u49457 \u46108  \u44536  \u51333 \u46308 \u50640 \u44172 \u45716  \u44536  \u51204  \u44592 \u44036 \u50640  \u54616 \u45208 \u45784 \u51032  \u51652 \u47532 \u47484  \u49440 \u50616 \u54624  \u51648 \u54812 \u50752  \u45733 \u47141 \u44284  \u44428 \u50948 \u44032  \u48512 \u50668 \u46104 \u50632 \u45796 .\
