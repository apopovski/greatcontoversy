\f0\b \cf0 \uc0\u53804 \u51137 \u44284  \u50976 \u54792 \u51032  \u52280 \u49345 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u49324 \u46988 \u46308 \u51008  \u44536 \u46308 \u51060  \u51648 \u44552 \u44751  \u49549 \u50500 \u50728  \u44163 \u51012  \u44648 \u45803 \u45716 \u45796 . \u44536 \u46308 \u51008  \u54588 \u52264 \u44036 \u50640  \u44536 \u46308 \u51012  \u47736 \u47581 \u51004 \u47196  \u51064 \u46020 \u54616 \u50688 \u45796 \u44256  \u48708 \u45212 \u54620 \u45796 . \u44536 \u47084 \u45208  \u47784 \u46304  \u49324 \u46988 \u51008  \u50672 \u54633 \u54616 \u50668  \u47785 \u49324 \u46308 \u50640 \u44172  \u44032 \u51109  \u54841 \u46021 \u54620  \u48708 \u45212 \u51012  \u54620 \u45796 . \u48520 \u52649 \u54620  \u47785 \u49324 \u46308 \u51008  \u49692 \u53444 \u54620  \u51068 \u46308 \u47564  \u50696 \u50616 \u54644  \u50772 \u45796 . \u44536 \u46308 \u51008  \u52397 \u51473 \u46308 \u50640 \u44172  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51012  \u48260 \u47532 \u44172  \u54616 \u44256  \u50984 \u48277 \u51012  \u44144 \u47337 \u55176  \u51648 \u53412 \u45716  \u51088 \u46308 \u51012  \u54605 \u48149 \u54616 \u46020 \u47197  \u51648 \u46020 \u54664 \u45796 . \u51060 \u51228  \u44536  \u47785 \u49324 \u46308 \u51008  \u49892 \u47581 \u54620  \u45208 \u47672 \u51648  \u49464 \u49345  \u49324 \u46988 \u46308  \u50526 \u50640 \u49436  \u44536 \u46308 \u51032  \u44592 \u47564 \u51201  \u54876 \u46041 \u51012  \u44256 \u48177 \u54620 \u45796 . \u44536 \u46412  \u47924 \u47532 \u46308 \u51008  \u48516 \u45432 \u50640  \u49324 \u47196 \u51105 \u55180 \u45796 . \u44536 \u46308 \u51008  \'93\u50864 \u47532 \u45716  \u51075 \u50612 \u48260 \u47536  \u48148  \u46104 \u50632 \u45796 . \u45320 \u55148 \u46308  \u46412 \u47928 \u50640  \u50864 \u47532 \u45716  \u47736 \u47581 \u51012  \u48155 \u44172  \u46104 \u50632 \u45796 \'94\u44256  \u48512 \u47476 \u51670 \u45716 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u46308 \u51008  \u44144 \u51667  \u47785 \u49324 \u46308 \u50640 \u44172  \u45804 \u47140 \u46304 \u45796 . \u54620 \u46412  \u44536 \u46308 \u51012  \u44032 \u51109  \u51316 \u44221 \u54616 \u45912  \u48148 \u47196  \u44536  \u49324 \u46988 \u46308 \u51060  \u44032 \u51109  \u47924 \u49436 \u50868  \u51200 \u51452 \u47484  \u44536 \u46308 \u50640 \u44172  \u54140 \u48531 \u45716 \u45796 . \u54620 \u46412  \u44536 \u46308 \u50640 \u44172  \u50900 \u44228 \u44288 \u51012  \u50444 \u50864 \u45912  \u49552 \u51060  \u44536 \u46308 \u51012  \u51453 \u51060 \u44592  \u50948 \u54616 \u50668  \u46308 \u47140 \u51656  \u44163 \u51060 \u45796 . \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u51012  \u51453 \u51060 \u44592  \u50948 \u54616 \u50668  \u49324 \u50857 \u46104 \u45912  \u52860 \u51060  \u51060 \u51228 \u45716  \u44536 \u46308 \u51032  \u50896 \u49688 \u47484  \u47736 \u54616 \u45716  \u45936  \u49324 \u50857 \u46108 \u45796 . \u46020 \u52376 \u50640  \u53804 \u51137 \u44284  \u50976 \u54792 \u51032  \u52280 \u44537 \u51060  \u48268 \u50612 \u51652 \u45796 .\
\'93\uc0\u50836 \u46976 \u54620  \u49548 \u47532 \u44032  \u46405  \u45149 \u44620 \u51648  \u51060 \u47492 \u51008  \u50668 \u54840 \u50752 \u44760 \u49436  \u50676 \u44397 \u44284  \u45796 \u53804 \u49884 \u47728  \u47784 \u46304  \u50977 \u52404 \u47484  \u49900 \u54032 \u54616 \u49884 \u47728  \u50501 \u51064 \u51012  \u52860 \u50640  \u48537 \u51060 \u49900 \u51012  \u51064 \u54632 \u51060 \u46972 \'94 (\u47128  25:31). 6\u52380 \u45380  \u46041 \u50504  \u45824 \u51137 \u53804 \u45716  \u51204 \u44060 \u46104 \u50612  \u50772 \u45796 . \u54616 \u45208 \u45784 \u51032  \u50500 \u46308 \u44284  \u54616 \u45720 \u51032  \u49324 \u51088 \u46308 \u51008  \u51064 \u47448 \u47484  \u44221 \u44256 \u54616 \u44256  \u44648 \u50864 \u52824 \u44256  \u44396 \u50896 \u54616 \u44592  \u50948 \u54616 \u50668  \u50501 \u54620  \u51088 \u51032  \u49464 \u47141 \u51012  \u45824 \u54637 \u54616 \u50668  \u49912 \u50892 \u50772 \u45796 . \u51060 \u51228  \u47784 \u46304  \u49324 \u46988 \u46308 \u51008  \u44536 \u46308 \u51032  \u50948 \u52824 \u47484  \u44208 \u51221 \u54664 \u45796 . \u50501 \u54620  \u51088 \u46308 \u51008  \u54616 \u45208 \u45784 \u51012  \u45824 \u51201 \u54616 \u45716  \u49912 \u50880 \u50640 \u49436  \u49324 \u45800 \u44284  \u50756 \u51204 \u55176  \u50672 \u54633 \u54664 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436  \u51667 \u48159 \u55180  \u50984 \u48277 \u51032  \u44428 \u50948 \u47484  \u50745 \u54840 \u54616 \u49892  \u46412 \u44032  \u50772 \u45796 . \u51060 \u51228  \u49912 \u50880 \u51008  \u49324 \u45800 \u44284  \u45908 \u48520 \u50612  \u54624  \u49104 \u47564  \u50500 \u45768 \u46972  \u49324 \u46988 \u46308 \u44284 \u46020  \u54616 \u44172  \u46104 \u50632 \u45796 . \'93\u50668 \u54840 \u50752 \u44760 \u49436  \u50676 \u44397 \u44284  \u45796 \u53804 \u49884 \u47728 \'85\u50501 \u51064 \u51012  \u52860 \u50640  \u48537 \u51060 \u49900 \'94\u51060 \u46972 .\
\'93\uc0\u47784 \u46304  \u44032 \u51613 \u54620  \u51068 \u47196  \u51064 \u54616 \u50668  \u53444 \u49885 \u54616 \u47728  \u50864 \u45716  \u51088 \u51032  \u51060 \u47560 \'94\u50640 \u45716  \u44396 \u50896 \u51032  \u54364 \u44032  \u52237 \u54804 \u45796 . \u50640 \u49828 \u44180 \u51032  \u44228 \u49884 \u50640 \u49436  \u49332 \u50977 \u54616 \u45716  \u44592 \u44396 \u47484  \u44032 \u51652  \u51088 \u46308 \u51060  \'93\u45721 \u51008  \u51088 \u50752  \u51210 \u51008  \u51088 \u50752  \u52376 \u45376 \u50752  \u50612 \u47536 \u50500 \u51060 \u50752  \u48512 \u45376 \u47484  \u45796  \u51453 \u51060 \u46104  \u51060 \u47560 \u50640  \u54364  \u51080 \u45716  \u51088 \u50640 \u44172 \u45716  \u44032 \u44620 \u51060  \u47568 \u46972  \u45236  \u49457 \u49548 \u50640 \u49436  \u49884 \u51089 \u54624 \u51648 \u45768 \u46972 \'94\u45716  \u47749 \u47161 \u51012  \u48155 \u51008  \u44163 \u52376 \u47100  \u51060 \u51228  \u47736 \u47581 \u51032  \u52380 \u49324 \u44032  \u45208 \u44036 \u45796 . \u49440 \u51648 \u51088 \u45716  \'93\u44536 \u46308 \u51060  \u49457 \u51204  \u50526 \u50640  \u51080 \u45716  \u45721 \u51008  \u51088 \u46308 \u47196 \u48512 \u53552  \u49884 \u51089 \u54616 \u45908 \u46972 \'94 (\u44180  9:1~6) \u44256  \u47568 \u54620 \u45796 . \u47736 \u47581 \u49884 \u53412 \u45716  \u51068 \u51008  \u48177 \u49457 \u51032  \u50689 \u51201  \u48372 \u54840 \u51088 \u46972 \u44256  \u44277 \u50616 \u54616 \u45716  \u51088 \u46308 \u47196 \u48512 \u53552  \u49884 \u51089 \u46108 \u45796 . \u44144 \u51667  \u54028 \u49688 \u44988 \u46308 \u51060  \u47676 \u51200  \u51652 \u47736 \u45817 \u54620 \u45796 . \u50612 \u46500  \u49324 \u46988 \u46020  \u46041 \u51221 \u51012  \u48155 \u44144 \u45208  \u49332 \u50500 \u45224 \u51648  \u47803 \u54620 \u45796 . \u45224 \u51088 , \u50668 \u51088 , \u49548 \u45376 , \u50612 \u47536 \u51060 \u46308 \u51060  \u47784 \u46160  \u47736 \u47581 \u45817 \u54620 \u45796 .\
\'93\uc0\u48372 \u46972  \u50668 \u54840 \u50752 \u44760 \u49436  \u44536  \u52376 \u49548 \u50640 \u49436  \u45208 \u50724 \u49324  \u46405 \u51032  \u44144 \u48124 \u51032  \u51396 \u50501 \u51012  \u48268 \u54616 \u49892  \u44163 \u51060 \u46972  \u46405 \u51060  \u44536  \u50948 \u50640  \u51110 \u50520 \u45912  \u54588 \u47484  \u46300 \u47084 \u45236 \u44256  \u44536  \u49332 \u54644 \u45817 \u54620  \u51088 \u47484  \u45796 \u49884 \u45716  \u44032 \u47532 \u50864 \u51648  \u50500 \u45768 \u54616 \u47532 \u46972 \'94 (\u49324  26:21). \'93\u50696 \u47336 \u49332 \u47128 \u51012  \u52828  \u47784 \u46304  \u48177 \u49457 \u50640 \u44172  \u50668 \u54840 \u50752 \u44760 \u49436  \u45236 \u47532 \u49892  \u51116 \u50521 \u51060  \u51060 \u47084 \u54616 \u45768  \u44263  \u49456 \u51012  \u46412 \u50640  \u44536  \u49332 \u51060  \u50025 \u51004 \u47728  \u44536  \u45576 \u51060  \u44396 \u47693  \u49549 \u50640 \u49436  \u50025 \u51004 \u47728  \u44536  \u54784 \u44032  \u51077 \u49549 \u50640 \u49436  \u50025 \u51012  \u44163 \u51060 \u50836  \u44536 \u45216 \u50640  \u50668 \u54840 \u50752 \u44760 \u49436  \u44536 \u46308 \u47196  \u53356 \u44172  \u50836 \u46976 \u52992  \u54616 \u49884 \u47532 \u45768  \u54588 \u52264  \u49552 \u51004 \u47196  \u48537 \u51105 \u51004 \u47728  \u54588 \u52264  \u49552 \u51012  \u46308 \u50612  \u52832  \u44163 \u51060 \'94 (\u49829  14:12, 13) \u46972 . \u49324 \u46988 \u46308 \u51060  \u44201 \u54620  \u44048 \u51221 \u51004 \u47196  \u48120 \u52828  \u46319 \u51060  \u49912 \u50872  \u46412  \u51088 \u48708 \u44032  \u49438 \u51060 \u51648  \u50500 \u45768 \u54620  \u54616 \u45208 \u45784 \u51032  \u51652 \u45432 \u44032  \u45236 \u47548 \u51004 \u47196 \u50024  \u46405  \u50948 \u51032  \u50501 \u54620  \u51452 \u48124 \u46308 , \u44263  \u51228 \u49324 \u51109 \u46308 \u44284  \u53685 \u52824 \u51088 \u46308 \u44284  \u48177 \u49457 \u46308 \u44284  \u48512 \u51088 \u46308 \u44284  \u44032 \u45212 \u54620  \u51088 \u46308 \u44284  \u45458 \u51008  \u51088 \u46308 \u44284  \u45230 \u51008  \u51088 \u46308 \u51060  \u47784 \u46160  \u51453 \u44172  \u46108 \u45796 . \'93\u44536 \u45216 \u50640  \u45208  \u50668 \u54840 \u50752 \u50640 \u44172  \u49332 \u50977 \u51012  \u45817 \u54620  \u51088 \u44032  \u46405  \u51060  \u45149 \u50640 \u49436  \u51200  \u45149 \u50640  \u48120 \u52832  \u44163 \u51060 \u45208  \u44536 \u46308 \u51060  \u49836 \u54140 \u54632 \u51012  \u48155 \u51648  \u47803 \u54616 \u47728  \u50684 \u49845 \u54632 \u51012  \u51077 \u51648  \u47803 \u54616 \u47728  \u47588 \u51109 \u54632 \u51012  \u50619 \u51648  \u47803 \u54616 \u44256  \u51648 \u47732 \u50640 \u49436  \u48516 \u53664 \u44032  \u46104 \u47532 \u47196 \u45796 \'94 (\u47128  25:33).\
