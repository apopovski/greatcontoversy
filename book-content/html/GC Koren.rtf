\uc0\u44536  \u53360  \u44400 \u51473  \u44032 \u50868 \u45936 \u45716  \u54861 \u49688  \u51204 \u50640  \u51316 \u51116 \u54664 \u45912  \u51109 \u49688  (\u38263 \u22781 ) \u54620  \u51313 \u49549 \u46308 , \u44144 \u45824 \u54620  \u52404 \u44201 \u44284  \u50948 \u45824 \u54620  \u51648 \u45733 \u51012  \u44032 \u51648 \u44256 \u49436 \u46020  \u44536  \u47800 \u51012  \u53440 \u46973 \u54620  \u52380 \u49324 \u46308 \u51032  \u51648 \u48176 \u50640  \u47585 \u44200 , \u44536  \u47784 \u46304  \u44592 \u45733 \u44284  \u51648 \u45733 \u51012  \u51088 \u49888 \u51012  \u45458 \u51060 \u44592  \u50948 \u54616 \u50668  \u48148 \u52828  \u51088 \u46308 \u51060  \u51080 \u45796 . \u44536 \u46308 \u51008  \u45440 \u46972 \u50868  \u44592 \u45733 \u51012  \u44032 \u51648 \u44256  \u49464 \u49345 \u51004 \u47196  \u54616 \u50668 \u44552  \u44536 \u46308 \u51032  \u52380 \u51116 \u51201  \u51116 \u45733 \u51012  \u50864 \u49345 \u49884  \u54616 \u44172  \u54616 \u50688 \u51004 \u45208 , \u44536 \u46308 \u51032  \u51092 \u51064 \u49457 \u44284  \u49324 \u50501 \u54620  \u48156 \u47749 \u51060  \u49464 \u49345 \u51012  \u45908 \u47101 \u55176 \u44256  \u54616 \u45208 \u45784 \u51032  \u54805 \u49345 \u51012  \u55036 \u49552 \u54616 \u50688 \u44592  \u46412 \u47928 \u50640  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u44536 \u46308 \u51012  \u45817 \u49888 \u51032  \u54588 \u51312 \u47932 \u51032  \u47732 \u51204 \u50640 \u49436  \u50424 \u50612  \u48260 \u47532 \u49512 \u45796 . \u44144 \u44592 \u50640 \u45716  \u50668 \u47084  \u45208 \u46972 \u47484  \u51221 \u48373 \u54620  \u50773 \u44284  \u51109 \u44400 \u46308 \u51060  \u51080 \u44256 , \u49912 \u50880 \u53552 \u50640 \u49436  \u44208 \u53076  \u54056 \u48176 \u54644  \u48376  \u51068 \u51060  \u50630 \u45716  \u50857 \u49324 \u46308 \u51060  \u51080 \u44256 , \u51217 \u44540 \u54644  \u50732  \u46412  \u50668 \u47084  \u45208 \u46972 \u46308 \u51060  \u51204 \u50984 \u54624  \u49688 \u48150 \u50640  \u50630 \u50632 \u45912  \u44144 \u47564 \u54616 \u44256  \u50556 \u47581 \u51201 \u51064  \u51204 \u49324  (\u25136 \u22763 ) \u46308 \u51060  \u51080 \u45796 . \u44536 \u46308 \u51008  \u49324 \u47581 \u51012  \u53685 \u54616 \u50668 \u49436 \u46020  \u48320 \u54868 \u46104 \u51648  \u50506 \u50520 \u45796 . \u44536 \u46308 \u51060  \u47924 \u45924 \u50640 \u49436  \u45208 \u50732  \u46412  \u44536 \u46308 \u51032  \u49373 \u44033 \u51008  \u51453 \u51012  \u46412 \u50752  \u46609 \u44057 \u51008  \u51221 \u48373 \u50837 \u50640  \u51032 \u54616 \u50668  \u54665 \u46041 \u54620 \u45796 .\
\uc0\u49324 \u45800 \u51008  \u44536 \u51032  \u48512 \u54616 \u46308 \u44284  \u51032 \u45436 \u54616 \u44256 , \u44536  \u45796 \u51020 \u50640 \u45716  \u50773 \u46308 \u44284  \u51221 \u48373 \u51088 \u46308 \u44284  \u44053 \u47141 \u54620  \u49324 \u46988 \u46308 \u44284  \u49345 \u51032 \u54620 \u45796 . \u44536 \u46308 \u51008  \u51088 \u44592 \u46308  \u54200 \u50640  \u49549 \u54620  \u51088 \u46308 \u51032  \u49688 \u54952 \u50752  \u49464 \u47141 \u51012  \u48372 \u44256 , \u44536 \u46308 \u50640  \u48708 \u54616 \u50668  \u49457  \u50504 \u50640  \u51080 \u45716  \u44400 \u45824 \u51032  \u49688 \u44032  \u51201 \u51004 \u48064 \u47196  \u49789 \u44172  \u49849 \u47532 \u54624  \u49688  \u51080 \u45796 \u44256  \u51452 \u51109 \u54620 \u45796 . \u44536 \u46308 \u51008  \u49352  \u50696 \u47336 \u49332 \u47128 \u51032  \u48512 \u50752  \u50689 \u44305 \u51012  \u48764 \u50519 \u44592  \u50948 \u54616 \u50668  \u44228 \u54925 \u51012  \u49464 \u50868 \u45796 . \u51204 \u50896 \u51060  \u51593 \u49884  \u51204 \u53804  \u51456 \u48708 \u47484  \u44060 \u49884 \u54620 \u45796 . \u49689 \u47144 \u46108  \u44592 \u49696 \u51088 \u46308 \u51008  \u47924 \u44592 \u47484  \u51228 \u51089 \u54620 \u45796 . \u47924 \u54984 \u51060  \u54785 \u54785 \u54620  \u44400 \u45824 \u51032  \u51648 \u55064 \u44288 \u46308 \u51008  \u54840 \u51204 \u51201 \u51064  \u47924 \u47532 \u46308 \u51012  \u51473 \u45824 \u50752  \u49324 \u45800 \u51004 \u47196  \u45208 \u45572 \u50612  \u48176 \u52824 \u54620 \u45796 .\
\uc0\u46300 \u46356 \u50612  \u51652 \u44400  \u47749 \u47161 \u51060  \u45236 \u47536 \u45796 . \u49472  \u49688  \u50630 \u51060  \u47566 \u51008  \u45824 \u44400 \u51060  \u54665 \u51652 \u51012  \u49884 \u51089 \u54620 \u45796 . \u44536 \u44163 \u51008  \u51068 \u52237 \u51060  \u50612 \u46500  \u51221 \u48373 \u51088 \u46020  \u49548 \u51665 \u54620  \u51068 \u51060  \u50630 \u45716  \u45824 \u44400 , \u51060  \u51648 \u49345 \u50640  \u51204 \u51137 \u51060  \u51080 \u50612  \u50728  \u51060 \u47000  \u44033  \u49884 \u45824 \u51032  \u47784 \u46304  \u44400 \u45824 \u47484  \u47784 \u46160  \u54633 \u54624 \u51648 \u46972 \u46020  \u48708 \u44368 \u46112  \u49688  \u50630 \u51012  \u51221 \u46020 \u51032  \u53360  \u44400 \u45824 \u51060 \u45796 . \u44032 \u51109  \u44053 \u54620  \u51204 \u49324 \u51064  \u49324 \u45800 \u51060  \u44536  \u44400 \u45824 \u47484  \u51652 \u46160 \u51648 \u55064 \u54616 \u44256 , \u50501 \u54620  \u52380 \u49324 \u46308 \u51060  \u44536  \u47560 \u51648 \u47561  \u51204 \u53804 \u50640  \u55192 \u51012  \u54633 \u54620 \u45796 . \u50773 \u46308 \u44284  \u51204 \u49324 \u46308 \u51060  \u44536 \u47484  \u51335 \u44256 , \u50668 \u47084  \u44400 \u45800 \u51004 \u47196  \u51060 \u47336 \u50612 \u51652  \u53360  \u47924 \u47532 \u44032  \u44033  \u51648 \u55064 \u44288 \u46308 \u51032  \u47749 \u47161  \u50500 \u47000  \u44536 \u47484  \u46384 \u47480 \u45796 . \u44536 \u46308 \u51008  \u44400 \u45824 \u49885 \u51004 \u47196  \u51656 \u49436  \u51221 \u50672 \u54616 \u44172  \u50864 \u53812 \u46160 \u53812 \u54620  \u51648 \u49345 \u51012  \u54665 \u51652 \u54616 \u50668  \u54616 \u45208 \u45784 \u51032  \u49457 \u51004 \u47196  \u45208 \u50500 \u44036 \u45796 . \u49352  \u50696 \u47336 \u49332 \u47128 \u51032  \u47928 \u51008  \u50696 \u49688 \u45784 \u51032  \u47749 \u47161 \u51004 \u47196  \u45803 \u55180 \u45796 . \u44536 \u47084 \u51088  \u49324 \u45800 \u51032  \u44400 \u45824 \u45716  \u44536  \u49457 \u51012  \u46168 \u4