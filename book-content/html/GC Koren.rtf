\f1\b0 \cf0 \
\uc0\u51064 \u47448 \u51032  \u51473 \u48372 \u51088 \u47196 \u49436 \u51032  \u44536 \u47532 \u49828 \u46020 \u51032  \u49324 \u50629 \u51008  \'93\u49692  (\u45208 \u47924 \u51032  \u49913 ) \u51060 \u46972  \u51060 \u47492 \u54616 \u45716  \u49324 \u46988 \'94\u50640  \u45824 \u54616 \u50668  \u47568 \u54620  \u49828 \u44032 \u47028 \u51032  \u50500 \u47492 \u45796 \u50868  \u50696 \u50616 \u50640  \u45208 \u53440 \u45208  \u51080 \u45796 . \u44536 \u45716  \'93\u51088 \u44592  \u44275 \u50640 \u49436  \u46027 \u50500 \u45208 \u49436  \u50668 \u54840 \u50752 \u51032  \u51204 \u51012  \u44148 \u52629 \u54616 \u47532 \u46972  \u44536 \u44032  \u50668 \u54840 \u50752 \u51032  \u51204 \u51012  \u44148 \u52629 \u54616 \u44256  \u50689 \u44305 \u46020  \u50619 \u44256  \u44536  (\u50500 \u48260 \u51648 \u51032 ) \u50948  (\u20301 ) \u50640  \u50505 \u50500 \u49436  \u45796 \u49828 \u47540  \u44163 \u51060 \u50836  \u46608  \u51228 \u49324 \u51109 \u51060  \u51088 \u44592  \u50948 \u50640  \u51080 \u51004 \u47532 \u45768  \u51060  \u46160  \u49324 \u51060 \u50640  \u54217 \u54868 \u51032  \u51032 \u45436 \u51060  \u51080 \u51004 \u47532 \u46972 \'94 (\u49829  6:12, 13) \u44256  \u47568 \u54620 \u45796 .\
\'93\uc0\u44536 \u44032  \u50668 \u54840 \u50752 \u51032  \u51204 \u51012  \u44148 \u52629 \u54616 \'94\u47532 \u46972 . \u45817 \u49888 \u51032  \u55148 \u49373 \u44284  \u51473 \u48372 \u47484  \u53685 \u54616 \u50668  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u54616 \u45208 \u45784 \u51032  \u44368 \u54924 \u51032  \u44592 \u52488 \u50752  \u44148 \u52629 \u44032 \u44032  \u46104 \u49888 \u45796 . \u49324 \u46020  \u48148 \u50872 \u51008  \u44536 \u48516 \u51012  \'93\u47784 \u53825 \u51079 \u46028 \'94\u51060 \u46972 \u44256  \u51648 \u51201 \u54616 \u44256 , \'93\u44148 \u47932 \u47560 \u45796  \u49436 \u47196  \u50672 \u44208 \u54616 \u50668  \u51452  \u50504 \u50640 \u49436  \u49457 \u51204 \u51060  \u46104 \u50612 \'94\u44036 \u45796 \u44256  \u47568 \u54620 \u45796 . \u46608 \u54620  \'93\u45320 \u55148 \u46020  \u49457 \u47161  \u50504 \u50640 \u49436  \u54616 \u45208 \u45784 \u51032  \u44144 \u54616 \u49892  \u52376 \u49548 \u44032  \u46104 \u44592  \u50948 \u54616 \u50668  \u50696 \u49688  \u50504 \u50640 \u49436  \u51648 \u50612 \u51256  \u44032 \u45712 \u45768 \u46972 \'94 (\u50657  2:20~22) \u44256  \u54620 \u45796 .\
\'93\uc0\u50689 \u44305 \u46020  \u50619 \'94\u51004 \u47532 \u46972 . \u53440 \u46973 \u54620  \u51064 \u47448 \u47484  \u44396 \u49549 \u54616 \u49888  \u50689 \u44305 \u51008  \u44536 \u47532 \u49828 \u46020 \u44760  \u49549 \u54620  \u44163 \u51060 \u45796 . \u44396 \u49549 \u54632 \u51012  \u48155 \u51008  \u51088 \u46308 \u51060  \u50689 \u50896 \u47924 \u44417 \u53664 \u47197  \u48512 \u47484  \u45432 \u47000 \u45716  \'93\u50864 \u47532 \u47484  \u49324 \u46993 \u54616 \u49324  \u44536 \u51032  \u54588 \u47196  \u50864 \u47532  \u51396 \u50640 \u49436  \u50864 \u47532 \u47484  \u54644 \u48169 \u54616 \'85\u49888  \u44536 \u50640 \u44172  \u50689 \u44305 \u44284  \u45733 \u47141 \u51060  \u49464 \u49464 \u53664 \u47197  \u51080 \u44592 \u47484  \u50896 \u54616 \u45432 \u46972 \'94 (\u44228  1:5, 6) \u45716  \u45432 \u47000 \u44032  \u46112  \u44163 \u51060 \u45796 .\
\'93\uc0\u44536  \u50948 \u50640  \u50505 \u50500 \u49436  \u45796 \u49828 \u47540  \u44163 \u51060 \u50836  \u46608  \u51228 \u49324 \u51109 \u51060  \u51088 \u44592  \u50948 \u50640  \u51080 \u51004 \u47532 \'94\u46972 . \u50500 \u51649  \u50689 \u44305 \u51032  \u45208 \u46972 \u44032  \u49884 \u51089 \u46104 \u51648  \u50506 \u50520 \u51004 \u48064 \u47196  \u44536  \u50689 \u44305 \u51032  \u50948 \u50640  \u45208 \u50500 \u44032 \u45716  \u44163 \u51008  \u50500 \u45768 \u45796 . \u44536 \u47084 \u45208  \u50696 \u49688 \u45784 \u44760 \u49436  \u51473 \u48372 \u51088 \u47196 \u49436 \u51032  \u48393 \u49324 \u47484  \u47560 \u52824 \u49892  \u46412 \u50640  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \'93\u44536  \u51312 \u49345  \u45796 \u50967 \u51032  \u50948 \u47484  \u51200 \u50640 \u44172  \u51452 \u49892  \u44163 \u51064 \u45936 \'94 \u44536 \u44163 \u51008  \'93\u44536  \u45208 \u46972 \u44032  \u47924 \u44417 \u54616 \u47532 \u46972 \'94\u44256  \u54620  \u44536  \u45208 \u46972 \u51060 \u45796  (\u45573  1:32, 33). \u51648 \u44552  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u51228 \u49324 \u51109 \u51004 \u47196 \u49436  \u50500 \u48260 \u51648 \u50752  \u54632 \u44760  \u48372 \u51340 \u50640  \u50505 \u50500  \u44228 \u49888 \u45796  (\u44228  3:21 \u52280 \u51312 ). \u50689 \u50896 \u54616 \u49884 \u44256  \u51088 \u51316 \u54616 \u49888  \u54616 \u45208 \u45784 \u44284  \u54632 \u44760  \u48372 \u51340 \u50640  \u50505 \u50500  \u44228 \u49888  \u51452 \u45784 \u51008  \'93\u50864 \u47532 \u51032  \u51656 \u44256 \u47484  \u51648 \u44256  \u50864 \u47532 \u51032  \u49836 \u54548 \u51012  \u45817 \u54616 \'94\u49512 \u44256 , \'93\u47784 \u46304  \u51068 \u50640  \u50864 \u47532 \u50752  \u54620 \u44208 \u44057 \u51060  \u49884 \u54744 \u51012  \u48155 \u51008  \u51088 \u47196 \u46104  \u51396 \u45716  \u50630 \u51004 \u49884 \'94\u48064 \u47196  \'93\u49884 \u54744 \u48155 \u45716  \u51088 \u46308 \u51012  \u45733 \u55176  \u46020 \u50864 \u49884 \'94\u45716  \u48516 \u51060 \u49884 \u45796 . \'93\u47564 \u51068  \u45572 \u44032  \u51396 \u47484  \u48276 \u54616 \u47732  \u50500 \u48260 \u51648  \u50526 \u50640 \u49436  \u50864 \u47532 \u50640 \u44172  \u45824 \u50616 \u51088 \u44032  \u51080 \'94\u45796  (\u49324  53:4; \u55176  4:15, 2:18; \u50836 \u51068  2:1). \u44536 \u48516 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u47924 \u51396 \u54616 \u49888  \u49373 \u50528 \u50752  \u49345 \u54616 \u44256  \u52244 \u47548 \u51012  \u48155 \u51008  \u47800 \u51012  \u44032 \u51648 \u44256  \u51473 \u48372 \u54616 \u44256  \u44228 \u49888 \u45796 . \u44536 \u48516 \u44760 \u49436 \u45716  \u49345 \u54616 \u49888  \u49552 \u44284  \u52244 \u47548 \u51012  \u48155 \u51004 \u49888  \u50694 \u44396 \u47532 \u50752  \u49345 \u52376  \u45212  \u48156 \u51012  \u44032 \u51648 \u44256  \u51396 \u50640  \u48736 \u51652  \u51064 \u47448 \u47484  \u50948 \u54616 \u50668  \u53444 \u50896 \u54616 \u49888 \u45796 . \u44536 \u46308 \u51032  \u44396 \u49549 \u51008  \u44536 \u52376 \u47100  \u47924 \u54620 \u54620  \u44050 \u51012  \u52824 \u47476 \u44256  \u51060 \u47336 \u50612 \u51276 \u45796 .\
\'93\uc0\u51060  \u46160  \u49324 \u51060 \u50640  \u54217 \u54868 \u51032  \u51032 \u45436 \u51060  \u51080 \u51004 \u47532 \u46972 .\'94 \u49457 \u51088  (\u32854 \u23376 ) \u51032  \u49324 \u46993 \u48372 \u45796  \u50557 \u54616 \u51648  \u50506 \u51008  \u50500 \u48260 \u51648 \u51032  \u49324 \u46993 \u51060  \u53440 \u46973 \u54620  \u51064 \u47448 \u51032  \u44396 \u50896 \u51032  \u44592 \u52488 \u44032  \u46108 \u45796 . \u50696 \u49688 \u44760 \u49436 \u45716  \u51228 \u51088 \u46308 \u51012  \u46496 \u45208 \u44032 \u49884 \u44592  \u51204 \u50640  \u44536 \u46308 \u50640 \u44172  \'93\u45236 \u44172  \u45320 \u55148 \u47484  \u50948 \u54616 \u50668  \u50500 \u48260 \u51648 \u44760  \u44396 \u54616 \u44192 \u45796  \u54616 \u45716  \u47568 \u51060  \u50500 \u45768 \u45768 \'85\u50500 \u48260 \u51648 \u44760 \u49436  \u52828 \u55176  \u45320 \u55148 \u47484  \u49324 \u46993 \u54616 \u49900 \u51060 \u45768 \u46972 \'94 (\u50836  16:26, 27) \u44256  \u47568 \u50432 \u54616 \u49512 \u45796 . \'93\u54616 \u45208 \u45784 \u44760 \u49436  \u44536 \u47532 \u49828 \u46020  \u50504 \u50640  \u44228 \u49884 \u49324  \u49464 \u49345 \u51012  \u51088 \u44592 \u50752  \u54868 \u47785 \u54616 \u44172  \u54616 \'94 (\u44256 \u54980  5:19) \u49512 \u45796 . \u54616 \u45720  \u49457 \u49548 \u51032  \u48393 \u49324 \u47196 \u50024  \'93\u46160  \u49324 \u51060 \u50640  \u54217 \u54868 \u51032  \u51032 \u45436 \'94\u51012  \u51060 \u47336 \u49512 \u45796 . \'93\u54616 \u45208 \u45784 \u51060  \u49464 \u49345 \u51012  \u51060 \u52376 \u47100  \u49324 \u46993 \u54616 \u49324  \u46021 \u49373 \u51088 \u47484  \u51452 \u49512 \u51004 \u45768  \u51060 \u45716  \u51200 \u47484  \u48127 \u45716  \u51088 \u47560 \u45796  \u47736 \u47581 \u52824  \u50506 \u44256  \u50689 \u49373 \u51012  \u50619 \u44172  \u54616 \u47140  \u54616 \u49900 \u51060 \u45768 \u46972 \'94 (\u50836  3:16).\
\pard\pardeftab720\sa319\partightenfactor0

\f0\b \cf0 \uc0\u49457 \u49548 \u51032  \u51221 \u44208 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u49457 \u49548 \u44032  \u47924 \u50631 \u51060 \u45264 \u45716  \u51656 \u47928 \u50640  \u49457 \u44221 \u51008  \u48516 \u47749 \u54620  \u54644 \u45813 \u51012  \u51456 \u45796 . \u49457 \u44221 \u50640 \u49436  \u49324 \u50857 \u54616 \u44256  \u51080 \u45716  \u49457 \u49548 \u46972 \u45716  \u47568 \u51008  \u52395 \u51704 , \u54616 \u45720  \u49457 \u49548 \u51032  \u49885 \u50577 \u51012  \u46384 \u46972  \u47784 \u49464 \u44032  \u51648 \u51008  \u51109 \u47561 \u51012  \u44032 \u47532 \u53412 \u44256  \u46168 \u51704 , \u51648 \u49345 \u51032  \u49457 \u49548 \u44032  \u44032 \u47532 \u53412 \u45716  \u54616 \u45720 \u50640  \u51080 \u45716  \u52280  \u49457 \u49548 \u47484  \u47568 \u54620 \u45796 . \u44536 \u47532 \u49828 \u46020 \u51032  \u51453 \u51020 \u51004 \u47196  \u47784 \u54805 \u51201  \u48393 \u49324 \u45716  \u45149 \u45228 \u45796 . \u54616 \u45720 \u50640  \u51080 \u45716  \u52280  \u49457 \u49548 \u44032  \u49352  \u50616 \u50557 \u51032  \u49457 \u49548 \u51060 \u45796 . \u44536 \u47088 \u45936  \u45796 \u45768 \u50648  8\u51109  14\u51208 \u51032  \u50696 \u50616 \u51008  \u54788 \u45824 \u50640  \u49457 \u52712 \u46112  \u50696 \u50616 \u51060 \u48064 \u47196  \u44144 \u44592  \u47568 \u54620  \u49457 \u49548 \u45716  \u49352  \u50616 \u50557 \u51032  \u49457 \u49548 \u44032  \u46104 \u50612 \u50556  \u54620 \u45796 . 2300\u51452 \u50556 \u44032  \u45149 \u45208 \u45716  1844\u45380 \u50640 \u45716  \u50668 \u47084  \u49464 \u44592  \u51204 \u48512 \u53552  \u51648 \u49345 \u50640  \u51060 \u48120  \u49457 \u49548 \u44032  \u50630 \u50632 \u45796 . \u44536 \u47084 \u48064 \u47196  \'93\u51060 \u52380 \u49340 \u48177  \u51452 \u50556 \u44620 \u51648 \u45768  \u44536  \u46412 \u50640  \u49457 \u49548 \u44032  \u51221 \u44208 \u54616 \u44172  \u54632 \u51012  \u51077 \u51004 \u47532 \u46972 \'94\u44256  \u54620  \u50696 \u50616 \u51060  \u54616 \u45720 \u50640  \u51080 \u45716  \u49457 \u49548 \u47484  \u44032 \u47532 \u53412 \u45716  \u44163 \u51076 \u51008  \u51204 \u54784  \u51032 \u49900 \u54624  \u50668 \u51648 \u44032  \u50630 \u45796 .\
\uc0\u44536 \u47084 \u45208  \u49457 \u49548 \u51032  \u51221 \u44208 \u51060  \u47924 \u50631 \u51060 \u45264 \u44256  \u54616 \u45716  \u44032 \u51109  \u51473 \u50836 \u54620  \u51032 \u47928 \u51060  \u54644 \u45813 \u46104 \u51648  \u50500 \u45768 \u54620  \u52292  \u45224 \u50500  \u51080 \u45796 . \u44396 \u50557  \u49457 \u44221 \u51008  \u51648 \u49345  \u49457 \u49548 \u50752  \u44288 \u47144 \u54616 \u50668  \u49457 \u49548 \u47484  \u51221 \u44208 \u54616 \u44172  \u54616 \u45716  \u48393 \u49324 \u44032  \u51080 \u50632 \u45912  \u44163 \u51012  \u47568 \u54620 \u45796 . \u44536 \u47088 \u45936  \u54616 \u45720  \u49457 \u49548 \u50640 \u46020  \u51221 \u44208 \u52992  \u54624  \u47924 \u50631 \u51060  \u51080 \u51012 \u44620 ? \u55176 \u48652 \u47532 \u49436  9\u51109 \u50640 \u45716  \u51648 \u49345  \u49457 \u49548 \u50752  \u54616 \u45720  \u49457 \u49548 \u51032  \u51221 \u44208 \u50640  \u45824 \u54616 \u50668  \u48516 \u47749 \u55176  \u44032 \u47476 \u52432  \u51456 \u45796 . \'93\u50984 \u48277 \u51012  \u51335 \u50500  \u44144 \u51032  \u47784 \u46304  \u47932 \u44148 \u51060  \u54588 \u47196 \u50024  \u51221 \u44208 \u52992  \u46104 \u45208 \u45768  \u54588  \u55128 \u47548 \u51060  \u50630 \u51008 \u51593  \u49324 \u54632 \u51060  \u50630 \u45712 \u45768 \u46972  \u44536 \u47084 \u48064 \u47196  \u54616 \u45720 \u50640  \u51080 \u45716  \u44163 \u46308 \u51032  \u47784 \u54805 \u51008  \u51060 \u47088  \u44163 \u46308 \u47196 \u50024  \u51221 \u44208 \u52992  \u54624  \u54596 \u50836 \u44032  \u51080 \u50632 \u51004 \u45208  \u54616 \u45720 \u50640  \u51080 \u45716  \u44536 \u44163 \u46308 \u51008  \u51060 \u47088  \u44163 \u46308 \u48372 \u45796  \u45908  \u51339 \u51008  \u51228 \u47932 \u47196  \u54624 \u51648 \u45768 \u46972 \'94 (\u55176  9:22, 23). \u51339 \u51008  \u51228 \u47932 \u51008  \u44536 \u47532 \u49828 \u46020 \u51032  \u48372 \u54792 \u51060 \u45796 .\
\uc0\u47784 \u54805 \u44284  \u49892 \u52404 \u50640  \u51080 \u50612 \u49436 , \u46168  \u45796  \u51221 \u44208 \u54616 \u44172  \u54616 \u45716  \u51068 \u51008  \u54588 \u47196 \u50024  \u54616 \u45716 \u45936 , \u47676 \u51200  \u44163 \u51008  \u51664 \u49849 \u51032  \u54588 \u47196  \u54624  \u44163 \u51060 \u50836  \u45208 \u51473  \u44163 \u51008  \u44536 \u47532 \u49828 \u46020 \u51032  \u54588 \u47196  \u54644 \u50556  \u54620 \u45796 . \u49324 \u46020  \u48148 \u50872 \u51008  \u51060 \u50752  \u44057 \u51060  \u51221 \u44208 \u54616 \u44172  \u54616 \u45716  \u51068 \u51012  \u54588 \u47196 \u50024  \u54644 \u50556  \u54624  \u51060 \u50976 \u47484  \u47568 \u54616 \u47732 \u49436  \u54588 \u47484  \u55128 \u47548 \u51060  \u50630 \u51060 \u45716  \u49324 \u54632 \u51060  \u50630 \u45796 \u44256  \u54620 \u45796 . \u49324 \u50976 \u54616 \u45716  \u51068 , \u44263  \u51396 \u47484  \u50630 \u51060 \u54616 \u45716  \u51068 \u51008  \u48152 \u46300 \u49884  \u51060 \u47336 \u50612 \u51256 \u50556  \u54624  \u51068 \u51060 \u45796 . \u44536 \u47088 \u45936  \u51396 \u44032  \u50612 \u46523 \u44172  \u54616 \u45720  \u49457 \u49548 \u50752  \u51648 \u49345  \u49457 \u49548 \u50640  \u44288 \u47144 \u54616 \u50668  \u51316 \u51116 \u54624  \u49688  \u51080 \u50632 \u45716 \u44032 ? \u44536  \u49324 \u49892 \u51008  \u54364 \u49345 \u51201 \u51064  \u48393 \u49324 \u50640 \u49436  \u48176 \u50872  \u49688  \u51080 \u45796 . \u50780 \u45264 \u54616 \u47732  \u51648 \u49345 \u50640 \u49436  \u44536  \u51649 \u48516 \u51012  \u54665 \u54620  \u51228 \u49324 \u51109 \u51008  \'93\u54616 \u45720 \u50640  \u51080 \u45716  \u44163 \u51032  \u47784 \u54805 \u44284  \u44536 \u47548 \u51088 \'94 (\u55176  8:5) \u50640 \u49436  \u48393 \u49324 \u54616 \u50688 \u44592  \u46412 \u47928 \u51060 \u45796 .\
\pard\pardeftab720\sa319\partightenfactor0

\f0\b \cf0 \uc0\u51648 \u49345  \u49457 \u49548 \u51032  \u48393 \u49324 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u51648 \u49345  \u49457 \u49548 \u51032  \u48393 \u49324 \u50640 \u45716  \u46160  \u44032 \u51648 \u44032  \u51080 \u45796 . \u51228 \u49324 \u51109 \u46308 \u51008  \u47588 \u51068  \u49457 \u49548 \u50640 \u49436  \u48393 \u49324 \u54616 \u50688 \u44256 , \u45824 \u51228 \u49324 \u51109 \u51008  \u47588 \u45380  \u54620  \u48264 \u50473  \u49457 \u49548 \u51032  \u51221 \u44208 \u51012  \u50948 \u54616 \u50668  \u51648 \u49457 \u49548 \u50640 \u49436  \u53945 \u48324 \u54620  \u49549 \u51396 \u51032  \u48393 \u49324 \u47484  \u54665 \u54616 \u50688 \u45796 . \u51396 \u47484  \u45656 \u50864 \u52824 \u45716  \u51396 \u51064 \u51008  \u45216 \u47560 \u45796  \u44536 \u51032  \u51228 \u47932 \u51012  \u49457 \u47561 \u51032  \u47928 \u51004 \u47196  \u44032 \u51648 \u44256  \u50752 \u49436  \u55148 \u49373  \u51228 \u47932 \u51032  \u47672 \u47532  \u50948 \u50640  \u51088 \u44592 \u51032  \u49552 \u51012  \u50617 \u44256 , \u44536 \u51032  \u51396 \u47484  \u44256 \u48177 \u54632 \u51004 \u47196  \u44536  \u51396 \u45716  \u49345 \u51669 \u51201 \u51004 \u47196  \u51088 \u44592  \u51088 \u49888 \u50640 \u44172 \u49436  \u55136 \u50630 \u45716  \u55148 \u49373 \u51228 \u47932 \u50640 \u44172 \u47196  \u50734 \u44200 \u51276 \u45796 . \u44536 \u47088  \u45796 \u51020 \u50640  \u44536  \u51664 \u49849 \u51008  \u51453 \u51076 \u51012  \u45817 \u54616 \u50688 \u45796 . \u49324 \u46020  \u48148 \u50872 \u51008  \'93\u54588  \u55128 \u47548 \u51060  \u50630 \u51008 \u51593  \u49324 \u54632 \u51060  \u50630 \u45712 \u45768 \u46972 \'94\u44256  \u47568 \u54620 \u45796 . \'93\u50977 \u52404 \u51032  \u49373 \u47749 \u51008  \u54588 \u50640  \u51080 \u51020 \u51060 \u46972 \'94 (\u47112  17:11). \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51008  \u48276 \u51396 \u51088 \u51032  \u49373 \u47749 \u51012  \u50836 \u44396 \u54616 \u50688 \u45796 . \u51396 \u51064 \u51032  \u48764 \u50519 \u44596  \u49373 \u47749 \u51012  \u45208 \u53440 \u45236 \u45716  \u54588 , \u44263  \u51396 \u51064 \u51032  \u49373 \u47749 \u51012  \u45824 \u49888 \u54616 \u45716  \u44536  \u55148 \u49373  \u51228 \u47932 \u51032  \u54588 \u45716  \u51228 \u49324 \u51109 \u51004 \u47196  \u47568 \u48120 \u50516 \u50500  \u49457 \u49548 \u47196  \u50734 \u44200 \u51256 \u49436  \u44536  \u55064 \u51109  \u50526 \u50640  \u49100 \u47140 \u51276 \u45716 \u45936 , \u44536  \u55064 \u51109  \u45320 \u47672 \u50640 \u45716  \u44536  \u51396 \u51064 \u51060  \u48276 \u54620  \u50984 \u48277 \u51012  \u45347 \u50612 \u46164  \u48277 \u44452 \u44032  \u51080 \u50632 \u45796 . \u51060 \u47084 \u54620  \u51032 \u49885 \u51012  \u53685 \u54616 \u50668  \u51396 \u45716  \u54588 \u47484  \u53685 \u54616 \u50668  \u49345 \u51669 \u51201 \u51004 \u47196  \u49457 \u49548 \u50640  \u50734 \u44200 \u51276 \u45796 . \u46608  \u50612 \u46500  \u44221 \u50864 \u50640 \u45716  \u54588 \u47484  \u49457 \u49548 \u47196  \u44032 \u51256 \u44032 \u51648  \u50506 \u50520 \u45796 . \u44536 \u47084 \u45208  \u47784 \u49464 \u44032  \u50500 \u47200 \u51032  \u50500 \u46308 \u46308 \u50640 \u44172  \'93\u51060 \u45716  \u45320 \u55148 \u47196  \u54924 \u51473 \u51032  \u51396 \u47484  \u45812 \u45817 \u54616 \u50668  \u44536 \u46308 \u51012  \u50948 \u54616 \u50668  \u50668 \u54840 \u50752  \u50526 \u50640  \u49549 \u54616 \u44172  \u54616 \u47140 \u44256  \u45320 \u55148 \u50640 \u44172  \u51452 \u49888  \u44163 \u51060 \u45768 \u46972 \'94 (\u47112  10:17) \u44256  \u54620  \u51648 \u49884 \u45824 \u47196  \u51228 \u49324 \u51109 \u51060  \u44536  \u44256 \u44592 \u47564  \u47673 \u50632 \u45796 . \u44536  \u51032 \u49885 \u46308 \u51008  \u45796  \u44057 \u51060  \u51396 \u44032  \u54924 \u44060 \u54620  \u51088 \u50640 \u44172 \u49436  \u49457 \u49548 \u47196  \u50734 \u44200 \u51648 \u45716  \u44163 \u51012  \u49345 \u51669 \u54616 \u50688 \u45796 .\
\uc0\u44536 \u50752  \u44057 \u51008  \u51068 \u51008  \u51068  \u45380  \u45236 \u45236  \u47588 \u51068  \u51652 \u54665 \u46108  \u49324 \u50629 \u51060 \u50632 \u45796 . \u51060 \u49828 \u46972 \u50648 \u51032  \u51396 \u45716  \u49457 \u49548 \u47196  \u50734 \u44200 \u51276 \u45716 \u45936 , \u44536  \u51396 \u47484  \u46020 \u47568 \u54616 \u44592  \u50948 \u54616 \u50668  \u53945 \u48324 \u54620  \u48393 \u49324 \u44032  \u54596 \u50836 \u54616 \u50688 \u45796 . \u44536 \u47000 \u49436  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u49457 \u49548 \u50752  \u51648 \u49457 \u49548 \u47484  \u50948 \u54616 \u50668  \u49549 \u51396 \u54616 \u46972 \u44256  \u47749 \u47161 \u54616 \u49512 \u45796 . \'93\u51060 \u49828 \u46972 \u50648  \u51088 \u49552 \u51032  \u48512 \u51221 \u44284  \u44536  \u48276 \u54620  \u47784 \u46304  \u51396 \u47484  \u51064 \u54616 \u50668  \u51648 \u49457 \u49548 \u47484  \u50948 \u54616 \u50668  \u49549 \u51396 \u54616 \u44256  \u46608  \u44536 \u46308 \u51032  \u48512 \u51221 \u54620  \u51473 \u50640  \u51080 \u45716  \u54924 \u47561 \u51012  \u50948 \u54616 \u50668  \u44536 \u44057 \u51060  \u54624  \u44163 \u51060 \u50836 .\'94 \u46608 \u54620  \u45800 \u51012  \u50948 \u54616 \u50668 \u46020  \u49549 \u51396 \u44032  \u51060 \u47336 \u50612 \u51256 \u50556  \u54664 \u51004 \u48064 \u47196  \'93\u51060 \u49828 \u46972 \u50648  \u51088 \u49552 \u51032  \u48512 \u51221 \u50640 \u49436  \u45800 \u51012  \u49457 \u44208 \u52992  \u54624  \u44163 \u51060 \u50836 \'94\u46972 \u44256  \u54616 \u50688 \u45796  (\u47112  16:16, 19).\
\uc0\u45824 \u51228 \u49324 \u51109 \u51008  \u51068  \u45380 \u50640  \u54620  \u48264  \u45824 \u49549 \u51396 \u51068 \u50640  \u49457 \u49548 \u47484  \u51221 \u44208 \u52992  \u54616 \u44592  \u50948 \u54616 \u50668  \u51648 \u49457 \u49548 \u47196  \u46308 \u50612 \u44052 \u45796 . \u51060  \u48393 \u49324 \u47196  \u47568 \u48120 \u50516 \u50500  \u51068  \u45380 \u44036  \u47588 \u51068  \u54665 \u54620  \u48393 \u49324 \u44032  \u50756 \u44208 \u46104 \u45716  \u44163 \u51060 \u50632 \u45796 . \u51060  \u49549 \u51396 \u51068 \u50640  \u46160  \u47560 \u47532 \u51032  \u50684 \u49548  \u49352 \u45180 \u47484  \u49457 \u47561  \u47928 \u51004 \u47196  \u45132 \u44256  \u50752 \u49436  \u44536  \u46168 \u51012  \u51228 \u48708  \u48977 \u50500  \'93\u54620  \u51228 \u48708 \u45716  \u50668 \u54840 \u50752 \u47484  \u50948 \u54616 \u44256  \u54620  \u51228 \u48708 \u45716  \u50500 \u49324 \u49472 \u51012  \u50948 \u54616 \'94 (\u47112  16:8) \u44172  \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u50668 \u54840 \u50752 \u47484  \u50948 \u54616 \u50668  \u48977 \u55180  \u50684 \u49548 \u45716  \u48177 \u49457 \u51012  \u50948 \u54620  \u49549 \u51396 \u47932 \u47196  \u51453 \u51076 \u51012  \u45817 \u54644 \u50556  \u54616 \u50688 \u45796 . \u44536 \u47532 \u44256  \u45824 \u51228 \u49324 \u51109 \u51008  \u44536  \u54588 \u47484  \u55064 \u51109  \u50504 \u51004 \u47196  \u44032 \u51256 \u44032 \u49436  \u49549 \u51396 \u49548  \u50526 \u44284  \u44536  \u50948 \u50640  \u49100 \u47160 \u45796 . \u46608 \u54620  \u44536  \u54588 \u45716  \u55064 \u51109  \u50526 \u50640  \u51080 \u45716  \u48516 \u54693 \u45800  \u50948 \u50640 \u46020  \u49100 \u47140 \u51256 \u50556  \u54616 \u50688 \u45796 .\
\'93\uc0\u50500 \u47200 \u51008  \u46160  \u49552 \u51004 \u47196  \u49328  \u50684 \u49548 \u51032  \u47672 \u47532 \u50640  \u50504 \u49688 \u54616 \u50668  \u51060 \u49828 \u46972 \u50648  \u51088 \u49552 \u51032  \u47784 \u46304  \u48520 \u51032 \u50752  \u44536  \u48276 \u54620  \u47784 \u46304  \u51396 \u47484  \u44256 \u54616 \u44256  \u44536  \u51396 \u47484  \u50684 \u49548 \u51032  \u47672 \u47532 \u50640  \u46160 \u50612  \u48120 \u47532  \u51221 \u54620  \u49324 \u46988 \u50640 \u44172  \u47585 \u44200  \u44305 \u50556 \u47196  \u48372 \u45244 \u51648 \u45768  \u50684 \u49548 \u44032  \u44536 \u46308 \u51032  \u47784 \u46304  \u48520 \u51032 \u47484  \u51648 \u44256  \u47924 \u51064 \u51648 \u44221 \u50640  \u51060 \u47476 \u44144 \u46304  \u44536 \u45716  \u44536  \u50684 \u49548 \u47484  \u44305 \u50556 \u50640  \u45459 \u51012 \u51648 \u45768 \u46972 \'94 (\u47112  16:21, 22). \u50500 \u49324 \u49472 \u51008  \u45796 \u49884  \u51060 \u49828 \u46972 \u50648  \u51652 \u51473 \u50640  \u46028 \u50500 \u50724 \u51648  \u47803 \u54616 \u50688 \u44256 , \u44536 \u44163 \u51012  \u45132 \u44256  \u44036  \u49324 \u46988 \u51008  \u44536  \u51032 \u48373 \u51012  \u48744 \u44256  \u47785 \u50837 \u54620  \u54980 \u50640 \u50556  \u51109 \u47561 \u51004 \u47196  \u46028 \u50500 \u50772 \u45796 .\
