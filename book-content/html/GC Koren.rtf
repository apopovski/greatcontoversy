\uc0\u50689 \u50896  \u51648 \u50725 \u49444 \u47196  \u47568 \u48120 \u50516 \u50500  \u52488 \u47000 \u46104 \u50612 \u50728  \u50501 \u51008  \u49324 \u46988 \u51032  \u47560 \u51020 \u51004 \u47196  \u45733 \u55176  \u54756 \u50500 \u47540  \u49688  \u50630 \u45796 . \u49324 \u46993 \u44284  \u51088 \u48708 \u47196  \u52649 \u47564 \u54616 \u44256  \u46041 \u51221 \u51060  \u45336 \u52824 \u45716  \u49457 \u44221 \u51032  \u44032 \u47476 \u52840 \u51060  \u48120 \u49888 \u51004 \u47196  \u50612 \u46160 \u50892 \u51648 \u44256  \u44277 \u54252 \u47196  \u44032 \u47532 \u50892 \u51276 \u45796 . \u49324 \u45800 \u51060  \u54616 \u45208 \u45784 \u51032  \u54408 \u49457 \u50640  \u47932 \u46308 \u50668  \u45459 \u51008  \u44144 \u51667 \u46108  \u49353 \u44628 \u51012  \u49373 \u44033 \u54624  \u46412  \u49324 \u46988 \u46308 \u51060  \u50864 \u47532 \u51032  \u51088 \u48708 \u47196 \u50868  \u52285 \u51312 \u51452 \u47484  \u46160 \u47140 \u50892 \u54616 \u44256  \u44277 \u54252 \u51032  \u45824 \u49345 \u51004 \u47196  \u50668 \u44592 \u44256  \u49900 \u51648 \u50612  \u51613 \u50724 \u54620 \u45796 \u44256  \u54644 \u49436  \u50864 \u47532 \u44032  \u51060 \u49345 \u54616 \u44172  \u49373 \u44033 \u54624  \u44163 \u51064 \u44032 ? \u44053 \u45800 \u50640 \u49436 \u51032  \u44032 \u47476 \u52840 \u51012  \u53685 \u54616 \u50668  \u50728  \u49464 \u44228 \u50640  \u54140 \u51256  \u51080 \u45716  \u54616 \u45208 \u45784 \u44760  \u45824 \u54620  \u51060 \u47084 \u54620  \u47924 \u49436 \u50868  \u44204 \u54644 \u45716  \u49688 \u52380 , \u50500 \u45768  \u49688 \u48177 \u47564 \u51032  \u54924 \u51032 \u47200 \u51088 \u50752  \u47924 \u49888 \u47200 \u51088 \u46308 \u51012  \u47564 \u46308 \u50612  \u45236 \u50632 \u45796 .\
