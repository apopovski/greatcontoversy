\f1\b0 \cf0 \
\uc0\u44536 \u44032  18\u49464 \u50640  \u50640 \u47476 \u54392 \u47476 \u53944  \u45824 \u54617 \u50640  \u51077 \u54617 \u54616 \u50688 \u51012  \u46412  \u44536 \u51032  \u52376 \u51648 \u45716  \u48708 \u44368 \u51201  \u49692 \u53444 \u54616 \u44256  \u50976 \u45380  \u49884 \u51208 \u48372 \u45796 \u45716  \u55016 \u50476  \u50976 \u47532 \u54664 \u51004 \u47728  \u44536 \u51032  \u48120 \u47000 \u51032  \u51204 \u47581 \u51008  \u45908  \u48157 \u50520 \u45796 . \u44536 \u51032  \u48512 \u47784 \u45716  \u44540 \u44160 \u51208 \u50557 \u54616 \u50668  \u49345 \u45817 \u54620  \u51116 \u49328 \u51012  \u47784 \u50520 \u51004 \u48064 \u47196  \u44536 \u50640 \u44172  \u54596 \u50836 \u54620  \u44163 \u51012  \u45824 \u50612  \u51452 \u44592 \u50640  \u51648 \u51109 \u51060  \u50630 \u50632 \u45796 . \u44536 \u47532 \u44256  \u54620 \u54200 \u51004 \u47196  \u51339 \u51008  \u46041 \u47924 \u46308 \u51032  \u44048 \u54868 \u47196  \u44536 \u45716  \u51068 \u52237 \u51060  \u48155 \u51008  \u44368 \u50977 \u51032  \u51020 \u50872 \u54620  \u44048 \u54868 \u47484  \u50612 \u45712  \u51221 \u46020  \u44221 \u44048 \u49884 \u53420  \u49688  \u51080 \u50632 \u45796 . \u44536 \u45716  \u46608 \u54620  \u51068 \u47448 \u45824 \u44032  (\u19968 \u27969 \u22823 \u23478 ) \u46308 \u51032  \u51200 \u49436 \u46308 \u51012  \u50672 \u44396 \u54616 \u45716  \u51068 \u50640  \u47792 \u46160 \u54616 \u50688 \u51004 \u47728 , \u44536 \u46308 \u51032  \u44032 \u51109  \u51473 \u50836 \u54620  \u49324 \u49345 \u46308 \u51012  \u47784 \u50520 \u51004 \u47728  \u54788 \u51064 \u46308 \u51032  \u51648 \u54812 \u47484  \u44536 \u51032  \u44163 \u51004 \u47196  \u47564 \u46308 \u50632 \u45796 . \u50976 \u45380  \u49884 \u45824 \u51032  \u44368 \u49324 \u46308 \u47196 \u48512 \u53552  \u50628 \u54620  \u44368 \u50977 \u51012  \u48155 \u50520 \u44592  \u46412 \u47928 \u50640  \u44536 \u45716  \u49888 \u47280 \u54624  \u47564 \u54620  \u50864 \u49688 \u54620  \u51064 \u47932 \u47196  \u51088 \u46972 \u44052 \u44256 , \u51339 \u51008  \u49345 \u53468 \u50640  \u45459 \u50668  \u51080 \u45716  \u44536 \u51032  \u51221 \u49888 \u51008  \u49888 \u49549 \u55176  \u48156 \u45804 \u54616 \u50688 \u45796 . \u44536 \u47532 \u44256  \u44536 \u50640 \u44172 \u45716  \u44053 \u54620  \u44592 \u50613 \u47141 , \u53804 \u52384 \u54620  \u49345 \u49345 \u47141 , \u47749 \u54869 \u54620  \u54032 \u45800 \u47141 , \u51648 \u52832  \u51460  \u47784 \u47476 \u45716  \u50676 \u49900 \u51060  \u51080 \u50632 \u44592  \u46412 \u47928 \u50640  \u44536 \u45716  \u44263  \u54617 \u50864  \u44032 \u50868 \u45936 \u49436  \u49688 \u50948  (\u39318 \u20301 ) \u47484  \u52264 \u51648 \u54616 \u44172  \u46104 \u50632 \u45796 . \u44536 \u51032  \u51648 \u51201  \u54984 \u47144 \u51008  \u44536 \u51032  \u51060 \u54644 \u47141 \u51012  \u48156 \u45804 \u49884 \u53020  \u51452 \u50632 \u44256  \u44536 \u51032  \u49373 \u50528 \u51032  \u53804 \u51137 \u51012  \u50948 \u54616 \u50668  \u44536 \u47484  \u51456 \u48708 \u49884 \u53412 \u44256  \u51080 \u50632 \u45912  \u51221 \u49888 \u47141 \u44284  \u50696 \u48124 \u54620  \u51648 \u44033 \u51012  \u51068 \u44648 \u50892  \u51452 \u50632 \u45796 .\
\uc0\u47336 \u53552 \u51032  \u47560 \u51020 \u50640  \u51080 \u45716  \u50668 \u54840 \u50752 \u47484  \u44221 \u50808 \u54616 \u45716  \u49373 \u44033 \u51008  \u44536 \u47196  \u54616 \u50668 \u44552  \u54869 \u44256 \u54620  \u47785 \u51201 \u51012  \u44054 \u44172  \u54616 \u44256  \u54616 \u45208 \u45784  \u50526 \u50640 \u49436  \u44216 \u49552 \u54620  \u49324 \u46988 \u51060  \u46104 \u44172  \u54616 \u50688 \u45796 . \u44536 \u45716  \u54637 \u49345  \u54616 \u45208 \u45784 \u51032  \u46020 \u50864 \u49900 \u51032  \u54596 \u50836 \u47484  \u45712 \u45180 \u44256 , \u47588 \u51068  \u44592 \u46020 \u47196 \u50024  \u51068 \u51012  \u49884 \u51089 \u54616 \u44256  \u44228 \u49549 \u51201 \u51004 \u47196  \u54616 \u45208 \u45784 \u51032  \u51648 \u46020 \u50752  \u46020 \u50864 \u49900 \u51012  \u44036 \u44396 \u54616 \u50688 \u45796 . \u44536 \u45716  \u51088 \u51452  \'93\u44592 \u46020 \u47484  \u51096 \u54616 \u45716  \u44163 \u51008  \u44277 \u48512 \u51032  \u48152  \u51060 \u49345 \u51012  \u54620  \u44163 \u51060 \u45796 \'94 (D\'92Aubigne, b.2, ch.2) \u44256  \u47568 \u54616 \u50688 \u45796 .\
\uc0\u50612 \u45712  \u45216  \u47336 \u53552 \u45716  \u45824 \u54617  \u46020 \u49436 \u44288 \u50640 \u49436  \u49436 \u51201 \u51012  \u51312 \u49324 \u54616 \u45796 \u44032  \u46972 \u54004 \u50612  \u49457 \u44221 \u51012  \u48156 \u44204 \u54616 \u50688 \u45796 . \u44536 \u45716  \u51060 \u47084 \u54620  \u52293 \u51012  \u48376  \u51201 \u46020  \u50630 \u50632 \u44256 , \u44536 \u47088  \u52293 \u51060  \u51080 \u45716  \u44163 \u46020  \u50508 \u51648  \u47803 \u54616 \u50688 \u45796 . \u44536 \u45716  \u50696 \u48176  \u49884 \u44036 \u50640  \u54924 \u51473 \u50640 \u44172  \u48373 \u51020 \u49436 \u50752  \u54200 \u51648 \u49436 \u51032  \u51068 \u48512 \u47484  \u51069 \u50612  \u51452 \u45716  \u44163 \u51012  \u46308 \u50612 \u50772 \u45716 \u45936 , \u44536 \u44163 \u51060  \u49457 \u44221 \u51032  \u51204 \u48512 \u51064  \u51460 \u47196  \u49373 \u44033 \u54616 \u50688 \u45796 . \u44536 \u47088 \u45936  \u51060 \u46412 \u50640  \u52376 \u51020 \u51004 \u47196  \u44536 \u45716  \u49457 \u44221 \u51032  \u51204 \u48512 \u47484  \u48372 \u44172  \u46104 \u50632 \u45912  \u44163 \u51060 \u45796 . \u44536 \u45716  \u46160 \u47157 \u44256  \u45440 \u46972 \u50868  \u47560 \u51020 \u51004 \u47196  \u49373 \u47749 \u51032  \u47568 \u50432 \u51012  \u51069 \u50612  \u45236 \u47140 \u44052 \u45796 . \u44536 \u47532 \u44256  \u47589 \u48149 \u51060  \u48744 \u46972 \u51648 \u44256  \u44032 \u49844 \u51060  \u46160 \u44540 \u44144 \u47532 \u45716  \u44032 \u50868 \u45936  \u49373 \u47749 \u51032  \u47568 \u50432 \u51012  \u51069 \u50612  \u44032 \u45796 \u44032 \u45716  \u46412 \u46412 \u47196  \u47688 \u52628 \u44256 \u49436  \'93\u50724 , \u54616 \u45208 \u45784  \u45208 \u50640 \u44172  \u51060 \u47088  \u52293 \u51012  \u51452 \u49512 \u51004 \u47732 !\'94 (D\'92Aubigne, b.2, ch.2) \u54616 \u44256  \u48512 \u47476 \u51670 \u50632 \u45796 . \u54616 \u45720  \u52380 \u49324 \u46308 \u51060  \u44536 \u51032  \u44225 \u50640  \u51080 \u50632 \u44256 , \u54616 \u45208 \u45784 \u51032  \u48372 \u51340 \u47196 \u48512 \u53552  \u48708 \u52824 \u45716  \u48731 \u51060  \u51652 \u47532 \u51032  \u48372 \u48176 \u47484  \u44536 \u50640 \u44172  \u50508 \u47140  \u51452 \u50632 \u45796 . \u44536 \u45716  \u51648 \u44552 \u44751  \u54616 \u45208 \u45784 \u44760  \u48520 \u53132 \u55176  \u50668 \u44608 \u51012  \u48155 \u44256  \u51080 \u51648 \u45208  \u50506 \u51008 \u51648  \u46160 \u47140 \u50892 \u54616 \u44256  \u51080 \u50632 \u51004 \u45208  \u51060 \u48264 \u52376 \u47100  \u51396 \u51064 \u51004 \u47196 \u49436 \u51032  \u51088 \u49888 \u51032  \u49345 \u53468 \u47484  \u44618 \u51060  \u44648 \u45804 \u51008  \u51201 \u51008  \u50630 \u50632 \u45796 .\
\uc0\u51396 \u50640 \u49436  \u54644 \u48169 \u51012  \u48155 \u44256  \u54616 \u45208 \u45784 \u44284  \u54868 \u47785 \u54616 \u44172  \u46104 \u44256 \u51088  \u50676 \u47148 \u55176  \u49548 \u50896 \u54620  \u45208 \u47672 \u51648  \u44536 \u45716  \u47560 \u52840 \u45236  \u49688 \u46020 \u50896 \u50640  \u46308 \u50612 \u44032  \u49688 \u46020 \u51088 \u51032  \u49373 \u54876 \u50640  \u51204 \u45392 \u54616 \u50688 \u45796 . \u49688 \u46020 \u50896 \u50640 \u49436 \u45716  \u44536 \u50640 \u44172  \u44537 \u55176  \u48708 \u52380 \u54620  \u51068 \u51060  \u47585 \u44200 \u51276 \u51004 \u47728  \u47928 \u51204 \u44152 \u49885 \u51012  \u50836 \u44396 \u48155 \u50520 \u45796 . \u44536 \u45716  \u51060 \u48120  \u51088 \u51316 \u49900 \u51060  \u44053 \u54620  \u50672 \u47161 \u50640  \u45804 \u54616 \u50688 \u51004 \u48064 \u47196  \u44536 \u52376 \u47100  \u48708 \u52380 \u54620  \u51068 \u51008  \u44536 \u51032  \u53440 \u44256 \u45212  \u44048 \u51221 \u50640  \u49900 \u54620  \u44404 \u50837 \u44048 \u51012  \u51452 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u51088 \u44592 \u51032  \u51396 \u47484  \u50948 \u54644 \u49436 \u45716  \u51060 \u47084 \u54620  \u51068 \u46020  \u54596 \u50836 \u54620  \u44163 \u51060 \u46972 \u44256  \u48127 \u44256  \u51060 \u47084 \u54620  \u44404 \u50837 \u51012  \u44204 \u45984 \u45796 .\
