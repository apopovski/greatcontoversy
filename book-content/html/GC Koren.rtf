\uc0\u47196 \u47560 \u44368 \u51032  \u44288 \u54624  \u50500 \u47000  \u51080 \u45716  \u44368 \u54924 \u45716  \u50616 \u51228 \u44620 \u51648 \u46304 \u51648  \u50577 \u49900 \u51032  \u51088 \u50976 \u47484  \u45572 \u47532 \u47732 \u49436  \u50500 \u47924 \u47088  \u48169 \u54644 \u47484  \u48155 \u51648  \u50506 \u44256  \u51648 \u45244  \u49688  \u50630 \u50632 \u45796 . \u48277 \u50773 \u44428 \u51008  \u44428 \u49464 \u47484  \u51536 \u51088 \u47560 \u51088  \u44536  \u44428 \u50948 \u47484  \u51064 \u51221 \u54616 \u51648  \u50506 \u45716  \u49324 \u46988 \u46308 \u51012  \u47784 \u46160  \u50613 \u45572 \u47476 \u44256 \u51088  \u47560 \u49688 \u47484  \u48855 \u52452 \u45796 . \u44536 \u47532 \u44256  \u44368 \u54924 \u46308 \u51008  \u54616 \u45208 \u50473  \u54616 \u45208 \u50473  \u52264 \u47168 \u47196  \u44536 \u51032  \u51648 \u48176  \u50500 \u47000  \u46308 \u50612 \u44032 \u44172  \u46104 \u50632 \u45796 .\
