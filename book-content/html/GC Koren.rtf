\f1\b0 \cf0 \
\uc0\u44536 \u47532 \u49828 \u46020 \u51064 \u51008  \u50696 \u47336 \u49332 \u47128 \u51032  \u47736 \u47581  \u46412  \u54620  \u49324 \u46988 \u46020  \u51453 \u51076 \u51012  \u45817 \u54616 \u51648  \u50506 \u50520 \u45796 . \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u45817 \u49888 \u51032  \u51228 \u51088 \u46308 \u50640 \u44172  \u48120 \u47532  \u44221 \u44256 \u54616 \u49512 \u51004 \u48064 \u47196  \u44536 \u48516 \u51032  \u47568 \u50432 \u51012  \u48127 \u51008  \u47784 \u46304  \u49324 \u46988 \u51008  \u44536  \u50557 \u49549 \u51032  \u51669 \u51312 \u50640  \u50976 \u51032 \u54664 \u45796 . \u50696 \u49688 \u45784 \u44760 \u49436 \u45716  \'93\u45320 \u55148 \u44032  \u50696 \u47336 \u49332 \u47128 \u51060  \u44400 \u45824 \u46308 \u50640 \u44172  \u50640 \u50892 \u49912 \u51060 \u45716  \u44163 \u51012  \u48372 \u44144 \u46304  \u44536  \u47736 \u47581 \u51060  \u44032 \u44620 \u50868  \u51460 \u51012  \u50508 \u46972  \u44536  \u46412 \u50640  \u50976 \u45824 \u50640  \u51080 \u45716  \u51088 \u46308 \u51008  \u49328 \u51004 \u47196  \u46020 \u47581 \u54624 \u51648 \u47728  \u49457 \u45236 \u50640  \u51080 \u45716  \u51088 \u46308 \u51008  \u45208 \u44040 \u51648 \u47728 \'94 (\u45573  21:20, 21) \u46972 \u44256  \u47568 \u50432 \u54616 \u49512 \u45796 . \u47196 \u47560 \u44400 \u51008  \u49464 \u49828 \u54000 \u50864 \u49828  (Cestius) \u51032  \u51648 \u55064  \u50500 \u47000  \u44536  \u49457 \u51012  \u54252 \u50948 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u47784 \u46304  \u47732 \u50640 \u49436  \u51593 \u44033 \u51201 \u51004 \u47196  \u44277 \u44201 \u54616 \u44592 \u50640  \u50976 \u47532 \u54620  \u44163 \u52376 \u47100  \u48372 \u50688 \u51012  \u46412 \u50640  \u44536 \u46308 \u51008  \u44049 \u51088 \u44592  \u44536  \u54252 \u50948 \u47484  \u54400 \u44256  \u53748 \u44400 \u54616 \u50688 \u45796 . \u49457  \u50504 \u50640  \u54252 \u50948 \u46104 \u50612  \u51080 \u45912  \u49324 \u46988 \u46308 \u51008  \u51201 \u44400 \u51012  \u44201 \u53748 \u54624  \u49688  \u50630 \u51020 \u51012  \u50508 \u44256  \u54637 \u48373 \u54616 \u47140 \u45912  \u52272 \u45208 \u50688 \u45716 \u45936 , \u44536  \u46412 \u50640  \u50500 \u47924 \u47088  \u47749 \u48177 \u54620  \u51060 \u50976  \u50630 \u51060  \u47196 \u47560 \u51032  \u45824 \u51109 \u51008  \u44400 \u49324 \u47484  \u52384 \u49688 \u49884 \u53040 \u45796 . \u54616 \u45208 \u45784 \u51032  \u51088 \u48708 \u47196 \u50868  \u49453 \u47532 \u44032  \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u51032  \u50976 \u51061 \u51012  \u50948 \u54616 \u50668  \u49324 \u44148 \u46308 \u51012  \u51312 \u51333 \u54616 \u44256  \u44228 \u49512 \u45796 . \u50557 \u49549 \u46108  \u51669 \u51312 \u44032  \u44592 \u45796 \u47532 \u44256  \u51080 \u45716  \u44536 \u47532 \u49828 \u46020 \u51064 \u46308 \u50640 \u44172  \u51452 \u50612 \u51276 \u45796 . \u51060 \u51228  \u44396 \u51452 \u51032  \u44221 \u44256 \u47484  \u49692 \u51333 \u54616 \u44256 \u51088  \u54616 \u45716  \u47784 \u46304  \u49324 \u46988 \u46308 \u50640 \u44172  \u51060 \u46412 \u44032  \u51208 \u54840 \u51032  \u44592 \u54924 \u50688 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u50976 \u45824 \u51064 \u51060 \u45208  \u47196 \u47560 \u51064 \u51012  \u47561 \u47200 \u54616 \u44256  \u44536 \u47532 \u49828 \u46020 \u51064 \u46308 \u51060  \u46020 \u47581 \u54616 \u45716  \u51068 \u51008  \u47561 \u51012  \u49688  \u50630 \u46020 \u47197  \u49324 \u44148 \u46308 \u51012  \u44536 \u47111 \u44172  \u51312 \u51333 \u54616 \u49512 \u45796 . \u49464 \u49828 \u54000 \u50864 \u49828 \u44032  \u53748 \u44033 \u54616 \u45716  \u44163 \u51012  \u48376  \u50976 \u45824 \u44400 \u51008  \u50696 \u47336 \u49332 \u47128 \u49457 \u50640 \u49436  \u45208 \u50752 \u49436  \u47932 \u47084 \u44032 \u45716  \u51201 \u44400 \u51012  \u52628 \u44201 \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u46160  \u44400 \u45824 \u44032  \u44368 \u51204 \u54616 \u45716  \u46041