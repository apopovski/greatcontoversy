\uc0\u49457 \u44221 \u49345  \u49457 \u54868 \u47484  \u52404 \u54744 \u54620  \u49324 \u46988 \u51008  \u44216 \u49552 \u54620  \u51221 \u49888 \u51012  \u45208 \u53440 \u45244  \u44163 \u51060 \u45796 . \u49457 \u44208 \u51032  \u46160 \u47140 \u50868  \u50948 \u50628 \u51012  \u47785 \u44201 \u54620  \u49324 \u46988 \u46308 \u51008  \u47784 \u49464 \u52376 \u47100 , \u47924 \u54620 \u54616 \u49888  \u54616 \u45208 \u45784 \u51032  \u49692 \u44208 \u54616 \u49900 \u44284  \u50756 \u51204 \u54616 \u49900 \u50640  \u48708 \u54616 \u50668  \u44536 \u46308  \u51088 \u49888 \u51032  \u47924 \u44032 \u52824 \u54632 \u51012  \u44648 \u45803 \u44172  \u46108 \u45796 .\
\uc0\u49440 \u51648 \u51088  \u45796 \u45768 \u50648 \u51008  \u52280 \u46108  \u49457 \u54868 \u51032  \u47784 \u48376 \u51060 \u50632 \u45796 . \u44536 \u51032  \u44596  \u51068 \u49373 \u51008  \u44536 \u51032  \u51452 \u45784 \u51012  \u50948 \u54616 \u50668  \u48148 \u52828  \u44256 \u49345 \u54620  \u48393 \u49324 \u47196  \u44032 \u46301  \u52264 \u51080 \u50632 \u45796 . \u44536 \u45716  \u54616 \u45720 \u51032  \'93\u51008 \u52509 \u51012  \u53356 \u44172  \u48155 \u51008  \u49324 \u46988 \'94 (\u45800  10:11) \u51060 \u50632 \u45796 . \u44536 \u47084 \u45208  \u51060  \u51316 \u44221 \u48155 \u45716  \u49440 \u51648 \u51088 \u45716  \u51088 \u49888 \u51032  \u49692 \u44208 \u44284  \u49457 \u44208 \u51012  \u51452 \u51109 \u54616 \u45716  \u45824 \u49888 \u50640  \u51088 \u49888 \u51012  \u51396  \u47566 \u51008  \u51060 \u49828 \u46972 \u50648 \u51032  \u54620  \u49324 \u46988 \u51004 \u47196  \u44036 \u51452 \u54616 \u44256  \u51088 \u44592  \u48177 \u49457 \u51012  \u50948 \u54616 \u50668  \u54616 \u45208 \u45784 \u44760  \u53444 \u50896 \u54616 \u50688 \u45796 . \'93\u50864 \u47532 \u44032  \u51452 \u51032  \u50526 \u50640  \u44036 \u44396 \u54616 \u50741 \u45716  \u44163 \u51008  \u50864 \u47532 \u51032  \u51032 \u47484  \u51032 \u51648 \u54616 \u50668  \u54616 \u45716  \u44163 \u51060  \u50500 \u45768 \u50836  \u51452 \u51032  \u53360  \u44557 \u55100 \u51012  \u51032 \u51648 \u54616 \u50668  \u54632 \u51060 \'94\u45768 \u51060 \u45796 . \'93\u50864 \u47532 \u44032  \u48276 \u51396 \u54616 \u50688 \u44256  \u50501 \u51012  \u54665 \u54616 \u50688 \u45208 \u51060 \u45796 .\'94 \u44536 \u45716  \u45796 \u49884  \'93\u45236 \u44032  \u51060 \u44057 \u51060  \u47568 \u54616 \u50668  \u44592 \u46020 \u54616 \u47728  \u45236  \u51396 \u50752  \u48143  \u45236  \u48177 \u49457  \u51060 \u49828 \u46972 \u50648 \u51032  \u51396 \u47484  \u51088 \u48373 \u54616 \'94\u45208 \u51060 \u45796 \u44256  \u54616 \u50688 \u45796 . \u44536  \u54980 \u50640  \u54616 \u45208 \u45784 \u51032  \u50500 \u46308 \u51060  \u45208 \u53440 \u45208 \u49436  \u44368 \u54984 \u51012  \u51452 \u49512 \u51012  \u46412 \u50640  \u44536 \u45716  \'93\u45236  \u47800 \u50640  \u55192 \u51060  \u48736 \u51276 \u44256  \u45208 \u51032  \u50500 \u47492 \u45796 \u50868  \u48731 \u51060  \u48320 \u54616 \u50668  \u50025 \u51008  \u46319 \u54616 \u50688 \u44256  \u45208 \u51032  \u55192 \u51060  \u45796  \u50630 \u50612 \u51276 \'94\u45796 \u44256  \u54616 \u50688 \u45796  (\u45800  9:18, 15, 20, 10:8).\
\uc0\u50853 \u46020  \u54253 \u54413  \u44032 \u50868 \u45936 \u49436  \u51452 \u45784 \u51032  \u51020 \u49457 \u51012  \u46307 \u44256  \'93\u45236 \u44032  \u49828 \u49828 \u47196  \u54620 \u54616 \u44256  \u54000 \u45132 \u44284  \u51116  \u44032 \u50868 \u45936 \u49436  \u54924 \u44060 \u54616 \u45208 \u51060 \u45796 \'94 (\u50853  42:6) \u44256  \u48512 \u47476 \u51670 \u50632 \u45796 . \u46608  \u51060 \u49324 \u50556 \u45716  \u49828 \u46989 \u46308 \u51060  \u51452 \u45784 \u51032  \u50689 \u44305 \u51012  \u48372 \u44256  \'93\u44144 \u47337 \u54616 \u45796  \u44144 \u47337 \u54616 \u45796  \u44144 \u47337 \u54616 \u45796  \u47564 \u44400 \u51032  \u50668 \u54840 \u50752 \u50668 \'94 \u54616 \u44256  \u52285 \u54868 \u54616 \u45716  \u49548 \u47532 \u47484  \u46307 \u44256  \'93\u54868 \u47196 \u45796  \u45208 \u50668  \u47581 \u54616 \u44172  \u46104 \u50632 \u46020 \u45796 \'94 (\u49324  6:3, 5) \u44256  \u53356 \u44172  \u50808 \u52452 \u45796 . \u48148 \u50872 \u51008  \u49483 \u51704  \u54616 \u45720 \u47196  \u51060 \u45132 \u47140 \u44032 \u49436  \u49324 \u46988 \u51032  \u47568 \u47196  \u54364 \u54788 \u54624  \u49688  \u50630 \u45716  \u47568 \u51012  \u46308 \u51008  \u54980  \u51088 \u44592  \u51088 \u49888 \u51012  \u44032 \u47532 \u53020  \'93\u47784 \u46304  \u49457 \u46020  \u51473 \u50640  \u51648 \u44537 \u55176  \u51089 \u51008  \u51088 \u48372 \u45796  \u45908  \u51089 \u51008  \u45208 \'94 (\u44256 \u54980  12:2; \u50657  3:8) \u46972 \u44256  \u47568 \u54616 \u50688 \u45796 . \u50696 \u49688 \u45784 \u51032  \u54408 \u50640  \u50504 \u44200 \u49436  \u49324 \u46993 \u51012  \u48155 \u51008  \u50836 \u54620 \u51008  \u44536 \u48516 \u51032  \u50689 \u44305 \u51012  \u48372 \u44256  \u52380 \u49324 \u51032  \u48156  \u50526 \u50640  \u50638 \u46300 \u47084 \u51256  \u51453 \u51008  \u44163 \u44057 \u51060  \u46104 \u50632 \u45796  (\u44228  1:17 \u52280 \u51312 ).\
\uc0\u44040 \u48148 \u47532  \u49901 \u51088 \u44032 \u51032  \u44536 \u45720  \u48145 \u51012  \u44152 \u50612 \u44032 \u45716  \u49324 \u46988 \u46308 \u51008  \u51088 \u44256 \u54616 \u44144 \u45208  \u51396 \u50640 \u49436  \u54644 \u48169 \u46104 \u50632 \u45796 \u44256  \u51004 \u49828 \u45824 \u45716  \u51452 \u51109 \u51012  \u54624  \u49688  \u50630 \u45796 . \u44536 \u46308 \u51008  \u54616 \u45208 \u45784 \u51032  \u50500 \u46308 \u51032  \u49900 \u51109 \u51012  \u54028 \u50676 \u49884 \u53416  \u44256 \u45516 \u51032  \u50896 \u51064 \u51060  \u51088 \u44592 \u46308 \u51032  \u51396 \u50688 \u45796 \u45716  \u44163 \u51012  \u45712 \u45180 \u47728 , \u44536 \u47088  \u49373 \u44033 \u51060  \u44536 \u46308 \u51012  \u49828 \u49828 \u47196  \u44216 \u48708 \u54616 \u44172  \u54624  \u44163 \u51060 \u45796 . \u44536 \u47532 \u49828 \u46020 \u50752  \u44032 \u51109  \u44032 \u44620 \u51060  \u49373 \u50528 \u54616 \u45716  \u49324 \u46988 \u46308 \u51008  \u51064 \u44036 \u51032  \u51396 \u50501 \u44284  \u50557 \u51216 \u51012  \u44032 \u51109  \u48516 \u47749 \u55176  \u44648 \u45803 \u44256  \u44536 \u46308 \u51032  \u50976 \u51068 \u54620  \u55148 \u47581 \u51060  \u49901 \u51088 \u44032 \u50640 \u49436  \u46028 \u50500 \u44032 \u49512 \u45796 \u44032  \u45796 \u49884  \u48512 \u54876 \u54616 \u49888  \u44396 \u51452 \u51032  \u44277 \u47196 \u50640  \u51080 \u45796 \u45716  \u44163 \u51012  \u50508 \u44172  \u46108 \u45796 .\
\uc0\u50724 \u45720 \u45216 \u51032  \u51333 \u44368 \u44228 \u50640 \u49436  \u49457 \u54868 \u47484  \u46160 \u46300 \u47084 \u51648 \u44172  \u45436 \u51032 \u54616 \u44256  \u51080 \u51648 \u47564  \u51088 \u50500 \u47484  \u45458 \u51060 \u44256  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51012  \u47924 \u49884 \u54616 \u45716  \u51221 \u49888 \u44284  \u48337 \u54665 \u49884 \u53412 \u44256  \u51080 \u44592  \u46412 \u47928 \u50640  \u44536 \u44163 \u51060  \u49457 \u44221 \u51032  \u51333 \u44368 \u50752 \u45716  \u44144 \u47532 \u44032  \u47676  \u49345 \u53468 \u50640  \u45459 \u50668  \u51080 \u45796 . \u44536 \u47111 \u44172  \u51452 \u51109 \u54616 \u45716  \u51088 \u46308 \u51008  \u49457 \u54868 \u44032  \u49692 \u44036 \u51201 \u51064  \u44163 \u51060 \u47728  \u50724 \u51649  \u48127 \u51020 \u51004 \u47196 \u47564  \u50756 \u51204 \u54620  \u49457 \u44208 \u51012  \u50619 \u51012  \u49688  \u51080 \u45796 \u44256  \u44032 \u47476 \u52828 \u45796 . \u44536 \u46308 \u51008  \'93\u48127 \u44592 \u47564  \u54616 \u47732  \u52629 \u48373 \u51008  \u45348  \u44163 \u51060 \u45796 \'94\u44256  \u47568 \u54620 \u45796 . \u48155 \u45716  \u51088  \u54200 \u50640 \u49436 \u45716  \u44536  \u51060 \u49345 \u51032  \u45432 \u47141 \u51012  \u54624  \u54596 \u50836 \u44032  \u50630 \u45716  \u46319 \u51060  \u49373 \u44033 \u54620 \u45796 . \u46041 \u49884 \u50640  \u44536 \u46308 \u51008  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51032  \u44428 \u50948 \u47484  \u48512 \u51064 \u54616 \u44256  \u44536 \u46308 \u51060  \u44228 \u47749 \u51012  \u51648 \u53020 \u50556  \u54624  \u51032 \u47924 \u50640 \u49436  \u54644 \u48169 \u46104 \u50632 \u45796 \u44256  \u51452 \u51109 \u54620 \u45796 . \u44536 \u47084 \u45208  \u54616 \u45208 \u45784 \u44760  \u44592 \u49256 \u51012  \u46028 \u47532 \u45716  \u51068 \u51060  \u46120 \u44284  \u46041 \u49884 \u50640  \u44536 \u48516 \u51032  \u54408 \u49457 \u44284  \u46907 \u51032  \u54364 \u54788 \u51060  \u46104 \u45716  \u50896 \u52825 \u50640  \u51312 \u54868 \u46104 \u51648  \u50506 \u51004 \u47732 \u49436  \u49324 \u46988 \u51060  \u54616 \u45208 \u45784 \u51032  \u54408 \u49457 \u44284  \u46907 \u50640  \u51068 \u52824 \u54616 \u45716  \u49457 \u44208 \u51012  \u51060 \u47344  \u49688  \u51080 \u44192 \u45716 \u44032 ?\
\uc0\u50500 \u47924 \u47088  \u53804 \u51137 \u46020 , \u44537 \u44592 \u46020 , \u49464 \u49549 \u51201 \u51064  \u50612 \u47532 \u49437 \u51020 \u46020  \u48260 \u47532 \u45716  \u51068 \u51012  \u50836 \u44396 \u54616 \u51648  \u50506 \u45716  \u50504 \u51060 \u54620  \u51333 \u44368 \u47484  \u48127 \u44256 \u51088  \u54616 \u45716  \u50837 \u47581 \u51060  \u54596 \u44221  \u48127 \u51020 \u47564 \u51004 \u47196  \u51060 \u47336 \u50612 \u51652  \u44368 \u47532 , \u44263  \u53685 \u49549 \u51201 \u51064  \u48127 \u51020 \u51032  \u44368 \u47532 \u47484  \u47564 \u46308 \u50632 \u45796 . \u44536 \u47084 \u45208  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51008  \u50612 \u46523 \u44172  \u47568 \u54616 \u44256  \u51080 \u45716 \u44032 ? \u49324 \u46020  \u50556 \u44256 \u48372 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u54620 \u45796 . \'93\u45236  \u54805 \u51228 \u46308 \u50500  \u47564 \u51068  \u49324 \u46988 \u51060  \u48127 \u51020 \u51060  \u51080 \u45432 \u46972  \u54616 \u44256  \u54665 \u54632 \u51060  \u50630 \u51004 \u47732  \u47924 \u49832  \u51060 \u51061 \u51060  \u51080 \u51004 \u47532 \u50836  \u44536  \u48127 \u51020 \u51060  \u45733 \u55176  \u51088 \u44592 \u47484  \u44396 \u50896 \u54616 \u44192 \u45712 \u45264 \'85\u51060 \u50752  \u44057 \u51060  \u54665 \u54632 \u51060  \u50630 \u45716  \u48127 \u51020 \u51008  \u44536  \u51088 \u52404 \u44032  \u51453 \u51008  \u44163 \u51060 \u46972 \'85\u50864 \u47532  \u51312 \u49345  \u50500 \u48652 \u46972 \u54632 \u51060  \u44536  \u50500 \u46308  \u51060 \u49325 \u51012  \u51228 \u45800 \u50640  \u46300 \u47540  \u46412 \u50640  \u54665 \u54632 \u51004 \u47196  \u51032 \u47213 \u45796  \u54616 \u49900 \u51012  \u48155 \u51008  \u44163 \u51060  \u50500 \u45768 \u45264  \u45348 \u44032  \u48372 \u44144 \u45768 \u50752  \u48127 \u51020 \u51060  \u44536 \u51032  \u54665 \u54632 \u44284  \u54632 \u44760  \u51068 \u54616 \u44256  \u54665 \u54632 \u51004 \u47196  \u48127 \u51020 \