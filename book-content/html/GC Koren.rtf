\uc0\u51396 \u44032  \u49464 \u49345 \u50640  \u46308 \u50612 \u50724 \u44592  \u51204 \u50640  \u50500 \u45812 \u51008  \u51088 \u44592 \u51032  \u52285 \u51312 \u51452 \u50752  \u44036 \u44201  \u50630 \u45716  \u44368 \u51228 \u47484  \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u49324 \u46988 \u51060  \u48276 \u51396 \u54616 \u48064 \u47196  \u54616 \u45208 \u45784 \u44284  \u48516 \u47532 \u46104 \u51088  \u51064 \u47448 \u45716  \u44536  \u44256 \u44480 \u54620  \u53945 \u44428 \u51012  \u51075 \u50612 \u48260 \u47160 \u45796 . \u44536 \u47111 \u51648 \u47564  \u44396 \u49549 \u51032  \u44221 \u47452 \u51004 \u47196  \u51060  \u49464 \u49345 \u51032  \u49324 \u46988 \u46308 \u51008  \u50668 \u51204 \u55176  \u54616 \u45720 \u44284  \u50672 \u46973 \u54624  \u49688  \u51080 \u45716  \u44600 \u51060  \u50676 \u47160 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u49457 \u47161 \u51004 \u47196  \u49324 \u46988 \u46308 \u44284  \u44368 \u53685 \u54616 \u44172  \u46104 \u49512 \u44256 , \u54616 \u45720 \u51032  \u48731 \u51008  \u54616 \u45208 \u45784 \u51032  \u53469 \u54632  \u48155 \u51008  \u51333 \u46308 \u50640 \u44172  \u51452 \u50612 \u51652  \u44228 \u49884  (\u21843 \u31034 ) \u47484  \u53685 \u54616 \u50668  \u51060  \u49464 \u49345 \u50640  \u51204 \u45804 \u46104 \u50632 \u45796 . \u44263  \'93\u50724 \u51649  \u49457 \u47161 \u51032  \u44048 \u46041 \u54616 \u49900 \u51012  \u51077 \u51008  \u49324 \u46988 \u46308 \u51060  \u54616 \u45208 \u45784 \u44760  \u48155 \u50500  \u47568 \'94 (\u48295 \u54980  1:21) \u54616 \u44172  \u46104 \u50632 \u45796 .\
\uc0\u51064 \u47448  \u50669 \u49324 \u51032  \u52572 \u52488 \u51032  \u51060 \u52380 \u50724 \u48177  \u45380 \u44036 \u51008  \u44592 \u47197 \u46108  \u44228 \u49884 \u44032  \u54616 \u45208 \u46020  \u50630 \u50632 \u45796 . \u44536 \u47084 \u45208  \u54616 \u45208 \u45784 \u44760 \u47196 \u48512 \u53552  \u44032 \u47476 \u52824 \u49900 \u51012  \u48155 \u51008  \u49324 \u46988 \u46308 \u51008  \u44536 \u46308 \u51032  \u51648 \u49885 \u51012  \u45796 \u47480  \u49324 \u46988 \u46308 \u50640 \u44172  \u51204 \u54616 \u50668  \u51452 \u50632 \u44256 , \u44536 \u44163 \u51060  \u50500 \u48260 \u51648 \u50640 \u44172 \u49436  \u51088 \u49885 \u50640 \u44172 \u47196  \u45824 \u47484  \u51060 \u50612  \u51204 \u54616 \u50668 \u51276 \u45796 . \u47568 \u50432 \u51060  \u44592 \u47197 \u46104 \u45716  \u51068 \u51008  \u47784 \u49464 \u51032  \u49884 \u45824 \u50640  \u49884 \u51089 \u46104 \u50632 \u45796 . \u44536  \u46412 \u50640  \u50689 \u44048 \u51004 \u47196  \u51452 \u50612 \u51652  \u44228 \u49884 \u44032  \u50689 \u44048  \u48155 \u51008  \u52293 \u51012  \u51060 \u47336 \u44172  \u46104 \u50632 \u45796 . \u51060  \u49324 \u50629 \u51008  \u52285 \u51312 \u50752  \u50984 \u48277 \u51032  \u50669 \u49324 \u47484  \u44592 \u47197 \u54620  \u47784 \u49464 \u47196 \u48512 \u53552  \u49884 \u51089 \u46104 \u50612  \u48373 \u51020 \u51032  \u44032 \u51109  \u53441 \u50900 \u54620  \u51652 \u47532 \u47484  \u44592 \u47197 \u54620  \u50836 \u54620 \u50640  \u51060 \u47476 \u44592 \u44620 \u51648  \u51068 \u52380 \u50977 \u48177  \u45380 \u51032  \u44596  \u44592 \u44036 \u50640  \u44152 \u52432 \u49436  \u44228 \u49549 \u46104 \u50632 \u45796 .\
\uc0\u49457 \u44221 \u51008  \u54616 \u45208 \u45784 \u51012  \u44536  \u51200 \u51089 \u51088 \u46972 \u44256  \u47568 \u54620 \u45796 . \u44536 \u47084 \u45208  \u44536 \u44163 \u51008  \u49324 \u46988 \u51032  \u49552 \u51004 \u47196  \u47568 \u48120 \u50516 \u50500  \u44592 \u47197 \u46104 \u50632 \u45796 . \u44536 \u47532 \u44256  \u44536  \u44033  \u44428  (\u21508 \u21367 ) \u51032  \u44057 \u51648  \u50506 \u51008  \u47928 \u52404 \u45716  \u44536  \u44033  \u44592 \u51088 \u46308 \u51032  \u44057 \u51648  \u50506 \u51008  \u53945 \u49457 \u51012  \u48372 \u50668  \u51452 \u44256  \u51080 \u45796 . \u45824 \u44060  \u44228 \u49884 \u46108  \u51652 \u47532 \u45716  \u47784 \u46160  \'93\u54616 \u45208 \u45784 \u51032  \u44048 \u46041 \u51004 \u47196  \u46108  \u44163 \'94 (\u46372 \u54980  3:16) \u51060 \u45796 . \u44536 \u47084 \u45208  \u44536 \u44163 \u51008  \u49324 \u46988 \u46308 \u51032  \u47568 \u47196  \u54364 \u54788 \u46104 \u50612  \u51080 \u45796 . \u47924 \u54620 \u54616 \u49888  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u49457 \u47161 \u51012  \u53685 \u54616 \u50668  \u45817 \u49888 \u51032  \u51333 \u46308 \u51032  \u51221 \u49888 \u44284  \u47560 \u51020 \u50640  \u48731 \u51012  \u48708 \u52628 \u50612  \u51452 \u49512 \u45796 . \u44536 \u48516 \u44760 \u49436 \u45716  \u45000 \u44284  \u51060 \u49345  (\u30064 \u20687 ) \u44284  \u54364 \u49345 \u44284  \u49345 \u51669 \u51012  \u51452 \u49512 \u44256  \u51652 \u47532 \u51032  \u44228 \u49884 \u47484  \u48155 \u51008  \u49324 \u46988 \u46308 \u51008  \u44536  \u49324 \u49345 \u51012  \u44033 \u44033  \u51064 \u44036 \u51032  \u47568 \u47196  \u45208 \u53440 \u45236 \u50632 \u45796 .\
\uc0\u49901 \u44228 \u47749 \u51008  \u54616 \u45208 \u45784 \u44760 \u49436  \u52828 \u55176  \u47568 \u50432 \u54616 \u49512 \u44256  \u45817 \u49888 \u51032  \u49552 \u51004 \u47196  \u51649 \u51217  \u50416 \u49512 \u45796 . \u49901 \u44228 \u47749 \u51008  \u54616 \u45208 \u45784 \u44760 \u49436  \u49457 \u47928 \u54868  (\u25104 \u25991 \u21270 ) \u54616 \u49888  \u44163 \u51060 \u50836 , \u49324 \u46988 \u51060  \u54620  \u44163 \u51060  \u50500 \u45768 \u45796 . \u44536 \u47084 \u45208  \u54616 \u45208 \u45784 \u44760 \u49436  \u51452 \u49888  \u51652 \u47532 \u47484  \u49324 \u46988 \u51032  \u47568 \u47196  \u54364 \u54788 \u54620  \u49457 \u44221 \u51008  \u49888 \u49457  (\u31070 \u24615 ) \u44284  \u51064 \u49457  (\u20154 \u24615 ) \u51032  \u50672 \u54633 \u51012  \u45208 \u53440 \u45240 \u45796 . \u44536 \u50752  \u44057 \u51008  \u50672 \u54633 \u51008  \u54616 \u45208 \u45784 \u51032  \u50500 \u46308 \u51060 \u47732 \u49436  \u46041 \u49884 \u50640  \u49324 \u46988 \u51032  \u50500 \u46308 \u51060 \u49888  \u44536 \u47532 \u49828 \u46020 \u51032  \u48376 \u49457  \u44032 \u50868 \u45936 \u49436  \u51316 \u51116 \u54616 \u50688 \u45796 . \u44536 \u47084 \u48064 \u47196  \'93\u47568 \u50432 \u51060  \u50977 \u49888 \u51060  \u46104 \u50612  \u50864 \u47532  \u44032 \u50868 \u45936  \u44144 \u54616 \'94 (\u50836  1:14) \u49888 \u45796 \u45716  \u51652 \u47532 \u45716  \u44536 \u47532 \u49828 \u46020 \u50640 \u44172  \u54644 \u45817 \u46104 \u45716  \u44163 \u44284  \u47560 \u52268 \u44032 \u51648 \u47196  \u49457 \u44221 \u50640 \u46020  \u54644 \u45817 \u46108 \u45796 .\
\uc0\u49457 \u44221 \u51008  \u49888 \u48516 \u44284  \u51649 \u50629 , \u51648 \u51201 \'b7\u50689 \u51201  \u49548 \u50577 \u51060  \u53356 \u44172  \u45796 \u47480  \u49324 \u46988 \u46308 \u47196  \u47568 \u48120 \u50516 \u50500  \u44033 \u44592  \u45796 \u47480  \u49884 \u45824 \u50640  \u44592 \u47197 \u46104 \u50632 \u44592  \u46412 \u47928 \u50640  \u44536  \u45796 \u47336 \u50612 \u51652  \u51452 \u51228  (\u20027 \u38988 ) \u51032  \u49457 \u44201 \u50640  \u51080 \u50612 \u49436 \u45716  \u47932 \u47200 \u51060 \u50836 , \u44536  \u47928 \u52404 \u50640  \u51080 \u50612 \u49436 \u46020  \u53356 \u44172  \u45796 \u47476 \u45796 . \u44592 \u51088 \u50640  \u46384 \u46972 \u49436  \u44536  \u54364 \u54788  \u48169 \u48277 \u51060  \u44033 \u44033  \u45796 \u47476 \u47728  \u46412 \u47196 \u45716  \u44057 \u51008  \u51652 \u47532 \u46972 \u46020  \u50612 \u46500  \u44592 \u51088 \u45716  \u45796 \u47480  \u44592 \u51088 \u48372 \u45796  \u44536 \u44163 \u51012  \u45908 \u50865  \u50696 \u47532 \u54616 \u44172  \u54364 \u54788 \u54620  \u44221 \u50864 \u44032  \u51080 \u45796 . \u44536 \u47084 \u48064 \u47196  \u47751  \u49324 \u46988 \u51032  \u44592 \u51088 \u44032  \u50612 \u46500  \u47928 \u51228 \u47484  \u44033 \u44592  \u45796 \u47480  \u44288 \u51216 \u44284  \u44288 \u44228 \u50640 \u49436  \u49548 \u44060 \u54616 \u45716  \u44221 \u50864 \u50640 , \u54588 \u49345 \u51201 \u51060 \u44256  \u51452 \u51032 \u49457 \u51060  \u50630 \u44144 \u45208  \u54200 \u44204 \u51012  \u44032 \u51652  \u46021 \u51088 \u46308 \u50640 \u44172  \u49436 \u47196  \u47784 \u49692 \u46104 \u44144 \u45208  \u51068 \u52824 \u46104 \u51648  \u50506 \u45716  \u44163 \u44057 \u51060  \u49373 \u44033 \u46112 \u51648  \u47784 \u47476 \u45208  \u48157 \u51008  \u53685 \u52272 \u47141 \u51012  \u44032 \u51652  \u49324 \u47140  \u44618 \u44256  \u44221 \u44148 \u54620  \u50672 \u44396 \u51088 \u45716  \u44144 \u44592 \u50640  \u51316 \u51116 \u54616 \u44256  \u51080 \u45716  \u51312 \u54868 \u47484  \u48156 \u44204 \u54616 \u44172  \u46108 \u45796 .\
\uc0\u51652 \u47532 \u45716  \u51228 \u44033 \u44592  \u45796 \u47480  \u49324 \u46988 \u46308 \u51012  \u53685 \u54616 \u50668  \u51228 \u49884 \u46104 \u50632 \u51004 \u48064 \u47196  \u50668 \u47084  \u44032 \u51648  \u52769 \u47732 \u50640 \u49436  \u49548 \u44060 \u46104 \u50632 \u45796 . \u50612 \u46500  \u44592 \u51088 \u45716  \u54620  \u51452 \u51228 \u51032  \u50612 \u46500  \u47732 \u50640  \u45908 \u50865  \u44053 \u54620  \u44048 \u46041 \u51012  \u48155 \u44256  \u51088 \u44592 \u51032  \u52404 \u54744 \u44284  \u51060 \u54644 \u47141 \u44284  \u51064 \u49885 \u47141  \u46321 \u50640  \u48512 \u54633 \u49884 \u53020 \u49436  \u44536  \u47928 \u51228 \u47484  \u51060 \u54644 \u54616 \u44256  \u51080 \u45796 . \u46608  \u50612 \u46500  \u44592 \u51088 \u45716  \u44536 \u50752 \u45716  \u45796 \u47480  \u47732 \u51012  \u51060 \u54644 \u54616 \u44172  \u46108 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44033 \u44033  \u49457 \u47161 \u51032  \u51648 \u46020  \u50500 \u47000  \u51088 \u44592 \u51032  \u47560 \u51020 \u50640  \u44032 \u51109  \u44618 \u51060  \u44048 \u47749 \u46108  \u48148 \u47484  \u49548 \u44060 \u54616 \u44256  \u51080 \u45796 . \u44536 \u47084 \u48064 \u47196  \u51652 \u47532 \u50640  \u45824 \u54620  \u44033 \u51088 \u51032  \u44204 \u54644 \u44032  \u45796 \u47476 \u51648 \u47564  \u51204 \u52404 \u51201 \u51004 \u47196  \u48380  \u46412  \u50756 \u51204 \u54620  \u51312 \u54868 \u47484  \u51060 \u47340 \u45796 . \u51060 \u50752  \u44057 \u51060  \u44228 \u49884 \u46108  \u51652 \u47532 \u45716  \u44208 \u54633 \u54616 \u50668  \u54616 \u45208 \u51032  \u50756 \u51204 \u54620  \u53685 \u51068 \u51012  \u51060 \u47336 \u44172  \u46104 \u50612  \u49373 \u50528 \u51032  \u50728 \u44054  \u54872 \u44221 \u44284  \u44221 \u54744 \u50640  \u51080 \u50612 \u49436  \u49324 \u46988 \u46308 \u51032  \u54596 \u50836 \u47484  \u52292 \u50892  \u51452 \u44592 \u50640  \u51201 \u54633 \u54616 \u44172  \u46108 \u45796 .\
\uc0\u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u51064 \u44036  \u45824 \u47532 \u51088 \u46308 \u51012  \u53685 \u54616 \u50668  \u51652 \u47532 \u47484  \u49464 \u49345 \u50640  \u51204 \u45804 \u54616 \u49884 \u44592 \u47484  \u44592 \u48848 \u54616 \u49512 \u45796 . \u44536 \u47084 \u48064 \u47196  \u44536 \u48516 \u44760 \u49436 \u45716  \u52828 \u55176  \u45817 \u49888 \u51032  \u49457 \u47161 \u51004 \u47196  \u49324 \u46988 \u46308 \u50640 \u44172  \u51088 \u44201 \u51012  \u51452 \u49492 \u49436  \u44536  \u49324 \u50629 \u51012  \u54624  \u49688  \u51080 \u44172  \u54644 \u51452 \u49512 \u45796 . \u44536 \u48516 \u44760 \u49436 \u45716  \u47924 \u50631 \u51012  \u47568 \u54616 \u44256  \u47924 \u50631 \u51012  \u44592 \u47197 \u54624  \u44163 \u51064 \u51648  \u49440 \u53469 \u54616 \u45716  \u51068 \u50640  \u51080 \u50612 \u49436  \u49324 \u46988 \u51032  \u47560 \u51020 \u51012  \u51648 \u46020 \u54616 \u49512 \u45796 . \u48372 \u47932 \u51008  \u48708 \u47197  \u51656 \u44536 \u47495  (\u51064 \u44036 ) \u50640  \u50948 \u53441 \u46104 \u50632 \u51012 \u51648 \u46972 \u46020  \u44536 \u44163 \u51008  \u54616 \u45720 \u47196 \u48512 \u53552  \u50728  \u48372 \u47932 \u51076 \u50640  \u53952 \u47548 \u50630 \u45796 . \u44536  \u51613 \u50616  (\u35657 \u35328 ) \u51008  \u48520 \u50756 \u51204 \u54620  \u51064 \u44036 \u51032  \u47568 \u47196  \u54364 \u54788 \u46104 \u50632 \u51648 \u47564  \u44536 \u44163 \u51008  \u54616 \u45208 \u45784 \u51032  \u51613 \u50616 \u51060 \u45796 . \u44536 \u47084 \u48064 \u47196  \u50728 \u49692 \u54616 \u44256  \u48127 \u51020  \u51080 \u45716  \u54616 \u45208 \u45784 \u51032  \u51088 \u45376 \u45716  \u44536  \u51613 \u50616  \u44032 \u50868 \u45936 \u49436  \u51008 \u54812 \u50752  \u51652 \u47532 \u44032  \u52649 \u47564 \u54620  \u54616 \u45208 \u45784 \u51032  \u45733 \u47141 \u51032  \u50689 \u44305 \u51012  \u48372 \u44172  \u46108 \u45796 .\
\uc0\u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u47568 \u50432 \u51012  \u53685 \u54616 \u50668  \u44396 \u50896 \u50640  \u54596 \u50836 \u54620  \u51648 \u49885 \u51012  \u51064 \u44036 \u50640 \u44172  \u50948 \u53441 \u54616 \u49512 \u45796 . \u50864 \u47532 \u45716  \u49457 \u44221 \u51012  \u54616 \u45208 \u45784 \u51032  \u46907 \u50640  \u45824 \u54620  \u44428 \u50948  \u51080 \u44256  \u54869 \u49892 \u54620  \u44228 \u49884 \u47196  \u48155 \u50500  \u46308 \u50668 \u50556  \u54620 \u45796 . \u49457 \u44221 \u51008  \u54408 \u49457 \u51032  \u54364 \u51456 \u51060 \u50836 , \u44368 \u47532 \u51032  \u44228 \u49884 \u51088 \u50836 , \u52404 \u54744 \u51032  \u49884 \u44552 \u49437 \u51060 \u45796 . \'93\u47784 \u46304  \u49457 \u44221 \u51008  \u54616 \u45208 \u45784 \u51032  \u44048 \u46041 \u51004 \u47196  \u46108  \u44163 \u51004 \u47196  \u44368 \u54984 \u44284  \u52293 \u47581 \u44284  \u48148 \u47476 \u44172  \u54632 \u44284  \u51032 \u47196  \u44368 \u50977 \u54616 \u44592 \u50640  \u50976 \u51061 \u54616 \u45768  \u51060 \u45716  \u54616 \u45208 \u45784 \u51032  \u49324 \u46988 \u51004 \u47196  \u50728 \u51204 \u52992  \u54616 \u47728  \u47784 \u46304  \u49440 \u54620  \u51068 \u51012  \u54665 \u54616 \u44592 \u50640  \u50728 \u51204 \u52992  \u54616 \u47140  \u54632 \u51060 \u45768 \u46972 \'94 (\u46372 \u54980  3:16, 17).\
\uc0\u44536 \u47084 \u45208  \u54616 \u45208 \u45784 \u44760 \u49436  \u45817 \u49888 \u51032  \u47568 \u50432 \u51012  \u53685 \u54616 \u50668  \u45817 \u49888 \u51032  \u46907 \u51012  \u49324 \u46988 \u46308 \u50640 \u44172  \u44228 \u49884 \u54644  \u51452 \u49888  \u49324 \u49892 \u51060  \u49457 \u47161 \u51032  \u45130 \u51076 \u50630 \u45716  \u51076 \u51116  (\u63990 \u22312 ) \u50752  \u51648 \u46020 \u47484  \u48520 \u54596 \u50836 \u54616 \u44172  \u54616 \u51648 \u45716  \u50506 \u50520 \u45796 . \u50724 \u55176 \u47140  \u50864 \u47532  \u44396 \u51452 \u44760 \u49436  \u49457 \u47161 \u51012  \u54728 \u46973 \u54616 \u49888  \u44163 \u51008  \u45817 \u49888 \u51032  \u51333 \u46308 \u50640 \u44172  \u47568 \u50432 \u51012  \u48148 \u47196  \u51060 \u54644 \u49884 \u53020  \u51452 \u44256 , \u44536  \u44368 \u54984 \u51012  \u48157 \u55176  \u50508 \u44256  \u49892 \u54665 \u54616 \u44172  \u54644 \u51452 \u44592  \u50948 \u54632 \u51060 \u50632 \u45796 . \u44536 \u47532 \u44256  \u49457 \u44221 \u51008  \u54616 \u45208 \u45784 \u51032  \u49457 \u47161 \u51032  \u44048 \u46041 \u51004 \u47196  \u46108  \u44163 \u51060 \u48064 \u47196  \u49457 \u47161 \u51032  \u44368 \u54984 \u51060  \u49457 \u44221 \u51032  \u44368 \u54984 \u44284  \u48152 \u45824 \u46112  \u49688 \u45716  \u50630 \u45796 .\
\uc0\u49457 \u47161 \u51008  \u49457 \u44221 \u51012  \u45824 \u49888 \u54616 \u44592  \u50948 \u54616 \u50668  \u51452 \u50612 \u51648 \u51648  \u50506 \u50520 \u51004 \u47728 , \u46608  \u51452 \u50612 \u51656  \u49688 \u46020  \u50630 \u45796 . \u50780 \u45264 \u54616 \u47732  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51008  \u47784 \u46304  \u44368 \u54984 \u44284  \u44221 \u54744 \u51012  \u49884 \u54744 \u54616 \u44592  \u50948 \u54620  \u54364 \u51456 \u51060 \u46972 \u44256  \u49457 \u44221 \u51008  \u48516 \u47749 \u55176  \u47568 \u54616 \u44592  \u46412 \u47928 \u51060 \u45796 . \u49324 \u46020  \u50836 \u54620 \u51008  \'93\u50689 \u51012  \u45796  \u48127 \u51648  \u47568 \u44256  \u50724 \u51649  \u50689 \u46308 \u51060  \u54616 \u45208 \u45784 \u44760  \u49549 \u54616 \u50688 \u45208  \u49884 \u54744 \u54616 \u46972  \u47566 \u51008  \u44144 \u51667  \u49440 \u51648 \u51088 \u44032  \u49464 \u49345 \u50640  \u45208 \u50772 \u51020 \u51060 \u45768 \u46972 \'94 (\u50836 \u51068  4:1) \u44256  \u47568 \u54620 \u45796 . \u46608 \u54620  \u51060 \u49324 \u50556 \u45716  \'93\u47560 \u46405 \u55176  \u50984 \u48277 \u44284  \u51613 \u44144 \u51032  \u47568 \u50432 \u51012  \u51335 \u51012 \u51648 \u45768  \u44536 \u46308 \u51032  \u47568 \u54616 \u45716  \u48148 \u44032  \u51060  \u47568 \u50432 \u50640  \u47582 \u51648  \u50500 \u45768 \u54616 \u47732  \u44536 \u46308 \u51060  \u51221 \u45397 \u55176  \u50500 \u52840 \u48731 \u51012  \u48372 \u51648  \u47803 \u54616 \u47532 \u46972 \'94 (\u49324  8:20) \u44256  \u47568 \u54620 \u45796 .\
\uc0\u49457 \u47161 \u51032  \u48731 \u51012  \u48155 \u50520 \u45432 \u46972 \u44256  \u51452 \u51109 \u54616 \u47732 \u49436  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51032  \u51648 \u46020 \u47484  \u45908  \u51060 \u49345  \u48155 \u51012  \u54596 \u50836 \u44032  \u50630 \u45796 \u44256  \u51452 \u51109 \u54616 \u45716  \u51068 \u48512  \u49324 \u46988 \u46308 \u51032  \u50724 \u47448  (\u35492 \u35628 ) \u47196  \u47568 \u48120 \u50516 \u50500  \u49457 \u47161 \u51032  \u50669 \u49324  (\u24441 \u20107 ) \u50640  \u53360  \u48708 \u45212 \u51060  \u46028 \u50500 \u44052 \u45796 . \u44536 \u46308 \u51008  \u49900 \u47161  \u49549 \u50640  \u54616 \u45208 \u45784 \u51032  \u51020 \u49457 \u51004 \u47196  \u45712 \u44788 \u51648 \u45716  \u50668 \u47084  \u44032 \u51648  \u51064 \u49345  (\u21360 \u35937 ) \u51032  \u51648 \u48176 \u47484  \u48155 \u44256  \u51080 \u45796 . \u44536 \u47084 \u45208  \u44536 \u46308 \u51012  \u51648 \u48176 \u54616 \u45716  \u44536  \u50689 \u51008  \u54616 \u45208 \u45784 \u51032  \u50689 \u51060  \u50500 \u45768 \u45796 . \u49457 \u44221 \u51012  \u47924 \u49884 \u54616 \u44256  \u51064 \u49345 \u47564 \u51012  \u47609 \u51333 \u54616 \u45716  \u51068 \u51008  \u54844 \u46976 \u44284  \u44592 \u47564 \u44284  \u54028 \u47736 \u47196  \u51060 \u45132 \u50612  \u51460  \u49104 \u51060 \u45796 . \u44536 \u44163 \u51008  \u50724 \u51649  \u50501 \u47560 \u51032  \u44228 \u54925 \u51012  \u51312 \u51109 \u49884 \u53020  \u51460  \u49104 \u51060 \u45796 . \u49457 \u47161 \u51032  \u48393 \u49324 \u44032  \u44536 \u47532 \u49828 \u46020 \u51032  \u44368 \u54924 \u50640  \u44537 \u55176  \u51473 \u50836 \u54616 \u48064 \u47196  \u49324 \u45800 \u51008  \u44537 \u45800 \u47200 \u51088  (\u26997 \u31471 \u35542 \u32773 ) \u50752  \u44305 \u49888 \u51088 \u46308 \u51032  \u50724 \u47448 \u47484  \u53685 \u54616 \u50668  \u49457 \u47161 \u51032  \u50669 \u49324 \u47484  \u47784 \u46021 \u54616 \u44256  \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u46308 \u47196  \u54616 \u50668 \u44552  \u50864 \u47532  \u51452 \u44760 \u49436  \u52828 \u55176  \u51228 \u44277 \u54644  \u51452 \u49888  \u51060  \u45733 \u47141 \u51032  \u44540 \u50896 \u51012  \u46321 \u54620 \u55176  \u50668 \u44592 \u44172  \u54620 \u45796 . \u51060 \u44163 \u51060  \u49324 \u45800 \u51032  \u44228 \u52293  \u51473 \u51032  \u54616 \u45208 \u51060 \u45796 .\
\uc0\u54616 \u45208 \u45784 \u51032  \u49457 \u47161 \u51008  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u44284  \u51312 \u54868 \u47484  \u51060 \u47336 \u50612  \u48373 \u51020  \u49884 \u45824  \u46041 \u50504 \u50640  \u44228 \u49549 \u54616 \u50668  \u51068 \u51012  \u54616 \u49492 \u50556  \u54616 \u50688 \u45796 . \u44396 \u50557 \u44284  \u49888 \u50557  \u49457 \u44221 \u51060  \u44592 \u47197 \u46104 \u45716  \u44033  \u49884 \u45824  \u46041 \u50504 \u50640  \u49457 \u47161 \u51008  \u49457 \u44221 \u50640  \u54252 \u54632 \u46104 \u50612  \u51080 \u45716  \u44228 \u49884  \u50808 \u50640 \u46020  \u44033  \u44060 \u51064 \u51032  \u47560 \u51020 \u50640  \u48731 \u51012  \u51204 \u54616 \u50668  \u51452 \u45716  \u51068 \u51012  \u44536 \u52824 \u51648  \u50506 \u51004 \u49512 \u45796 . \u49457 \u44221 \u51012  \u51452 \u49884 \u45716  \u51068  \u51060 \u50808 \u50640 \u46020  \u49457 \u47161 \u51012  \u53685 \u54616 \u50668  \u49324 \u46988 \u46308 \u51060  \u50612 \u46523 \u44172  \u44221 \u44256 \u50752  \u52293 \u47581 \u44284  \u44428 \u47732 \u44284  \u44368 \u54984 \u51012  \u48155 \u44172  \u46104 \u50632 \u45716 \u51648  \u49457 \u44221  \u51088 \u52404 \u44032  \u47568 \u54616 \u44256  \u51080 \u45796 . \u46608 \u54620  \u50668 \u47084  \u49884 \u45824 \u50640  \u44152 \u52432 \u49436  \u49440 \u51648 \u51088 \u46308 \u50640  \u45824 \u54620  \u47568 \u51008  \u51080 \u51004 \u45208  \u44536 \u46308 \u51060  \u47568 \u54620  \u45236 \u50857 \u51008  \u54616 \u45208 \u46020  \u44592 \u47197 \u46104 \u50612  \u51080 \u51648  \u50506 \u51008  \u49688 \u46020  \u51080 \u45796 . \u44536 \u50752  \u47560 \u52268 \u44032 \u51648 \u47196 , \u49457 \u44221 \u51032  \u51221 \u51204  (\u27491 \u20856 ) \u51060  \u50756 \u49457 \u46108  \u54980 \u50640 \u46020  \u49457 \u47161 \u44760 \u49436 \u45716  \u50668 \u51204 \u55176  \u54616 \u45208 \u45784 \u51032  \u51088 \u45376 \u46308 \u51012  \u44228 \u47805 \u49884 \u53412 \u44256 , \u44221 \u44256 \u54616 \u44256 , \u50948 \u47196 \u54616 \u44592  \u50948 \u54616 \u50668  \u44536  \u49324 \u50629 \u51012  \u44228 \u49549 \u54616 \u49492 \u50556 \u47564  \u54616 \u50688 \u45796 .\
\uc0\u50696 \u49688 \u45784 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u51228 \u51088 \u46308 \u50640 \u44172  \'93\u48372 \u54812 \u49324  \u44263  \u50500 \u48260 \u51648 \u44760 \u49436  \u45236  \u51060 \u47492 \u51004 \u47196  \u48372 \u45236 \u49892  \u49457 \u47161  \u44536 \u44032  \u45320 \u55148 \u50640 \u44172  \u47784 \u46304  \u44163 \u51012  \u44032 \u47476 \u52824 \u49884 \u44256  \u45236 \u44032  \u45320 \u55148 \u50640 \u44172  \u47568 \u54620  \u47784 \u46304  \u44163 \u51012  \u49373 \u44033 \u45208 \u44172  \u54616 \u49884 \u47532 \u46972 \'94, \'93\u51652 \u47532 \u51032  \u49457 \u47161 \u51060  \u50724 \u49884 \u47732  \u44536 \u44032  \u45320 \u55148 \u47484  \u47784 \u46304  \u51652 \u47532  \u44032 \u50868 \u45936 \u47196  \u51064 \u46020 \u54616 \u49884 \u47532 \u45768  \u44536 \u44032  \u51088 \u51032 \u47196  \u47568 \u54616 \u51648  \u50506 \u44256  \u50724 \u51649  \u46307 \u45716  \u44163 \u51012  \u47568 \u54616 \u49884 \u47728  \u51109 \u47000  \u51068 \u51012  \u45320 \u55148 \u50640 \u44172  \u50508 \u47532 \u49884 \u47532 \u46972 \'94 (\u50836  14:26, 16:13) \u44256  \u47568 \u50432 \u54616 \u49512 \u45796 . \u44536  \u50557 \u49549 \u51008  \u49324 \u46020  \u49884 \u45824 \u50640 \u47564  \u44397 \u54620 \u46108  \u44163 \u51060  \u50500 \u45768 \u44256  \u44033  \u49884 \u45824 \u51032  \u44536 \u47532 \u49828 \u46020 \u51032  \u44368 \u54924 \u50640  \u48120 \u52824 \u44256  \u51080 \u45796 \u45716  \u44163 \u51012  \u49457 \u44221 \u51008  \u48157 \u55176  \u44032 \u47476 \u52824 \u44256  \u51080 \u45796 . \u44396 \u51452 \u44760 \u49436 \u45716  \u45817 \u49888 \u51012  \u46384 \u47476 \u45716  \u49324 \u46988 \u46308 \u50640 \u44172  \'93\u45236 \u44032  \u49464 \u49345  \u45149  \u45216 \u44620 \u51648  \u45320 \u55148 \u50752  \u54637 \u49345  \u54632 \u44760  \u51080 \u51004 \u47532 \u46972 \'94 (\u47560  28:20) \u44256  \u48372 \u51613 \u54616 \u49888 \u45796 . \u46608 \u54620  \u48148 \u50872 \u51008  \u49457 \u47161 \u51032  \u51008 \u49324 \u50752  \u49440 \u47932 \u51060  \u44368 \u54924 \u50640  \u51452 \u50612 \u51652  \u44163 \u51008  \'93\u49457 \u46020 \u47484  \u50728 \u51204 \u52992  \u54616 \u47728  \u48393 \u49324 \u51032  \u51068 \u51012  \u54616 \u44172  \u46104 \u47728  \u44536 \u47532 \u49828 \u46020 \u51032  \u47800 \u51012  \u49464 \u50864 \u47140  \u54616 \u49900 \u51060 \u46972  \u50864 \u47532 \u44032  \u45796  \u54616 \u45208 \u45784 \u51032  \u50500 \u46308 \u51012  \u48127 \u45716  \u44163 \u44284  \u50500 \u45716  \u51068 \u50640  \u54616 \u45208 \u44032  \u46104 \u50612  \u50728 \u51204 \u54620  \u49324 \u46988 \u51012  \u51060 \u47336 \u50612  \u44536 \u47532 \u49828 \u46020 \u51032  \u51109 \u49457 \u54620  \u48516 \u47049 \u51060  \u52649 \u47564 \u54620  \u45936 \u44620 \u51648  \u51060 \u47476 \'94 (\u50657  4:12, 13) \u44172  \u54616 \u44592  \u50948 \u54632 \u51060 \u46972 \u44256  \u47568 \u54616 \u50688 \u45796 .\
\uc0\u49324 \u46020  \u48148 \u50872 \u51008  \u50640 \u48288 \u49548  \u44368 \u54924 \u51032  \u49888 \u51088 \u46308 \u51012  \u50948 \u54616 \u50668  \'93\u50864 \u47532  \u51452  \u50696 \u49688  \u44536 \u47532 \u49828 \u46020 \u51032  \u54616 \u45208 \u45784 , \u50689 \u44305 \u51032  \u50500 \u48260 \u51648 \u44760 \u49436  \u51648 \u54812 \u50752  \u44228 \u49884 \u51032  \u51221 \u49888 \u51012  \u45320 \u55148 \u50640 \u44172  \u51452 \u49324  \u54616 \u45208 \u45784 \u51012  \u50508 \u44172  \u54616 \u49884 \u44256  \u45320 \u55148  \u47560 \u51020 \u45576 \u51012  \u48157 \u55176 \u49324  \u44536 \u51032  \u48512 \u47476 \u49900 \u51032  \u49548 \u47581 \u51060  \u47924 \u50631 \u51060 \u47728 \'85\u48127 \u45716  \u50864 \u47532 \u50640 \u44172  \u48288 \u54392 \u49888  \u45733 \u47141 \u51032  \u51648 \u44537 \u55176  \u53356 \u49900 \u51060  \u50612 \u46500  \u44163 \u51012  \u45320 \u55148 \u47196  \u50508 \u44172  \u54616 \u49884 \u44592 \u47484  \u44396 \u54616 \u45432 \u46972 \'94 (\u50657  1:17, 19) \u44256  \u44592 \u46020 \u54616 \u50688 \u45796 . \u48148 \u50872 \u51008  \u49888 \u51088 \u46308 \u51032  \u51060 \u54644 \u47141 \u51012  \u44228 \u48156 \u49884 \u53412 \u44256  \u54616 \u45208 \u45784 \u51032  \u44144 \u47337 \u54620  \u47568 \u50432 \u51032  \u44618 \u51008  \u46907 \u51012  \u47560 \u51020 \u50640  \u44228 \u49884 \u54644  \u51452 \u49884 \u45716  \u49457 \u47161 \u44760 \u49436  \u50669 \u49324 \u54644  \u51452 \u49884 \u46020 \u47197  \u50640 \u48288 \u49548  \u44368 \u54924 \u47484  \u50948 \u54616 \u50668  \u44036 \u44396 \u54616 \u50688 \u45796 .\
\uc0\u50724 \u49692 \u51208 \u50640  \u49457 \u47161 \u44760 \u49436  \u45440 \u46972 \u50872  \u51221 \u46020 \u47196  \u45208 \u53440 \u45208 \u49888  \u54980  \u48288 \u46300 \u47196 \u45716  \u48177 \u49457 \u46308 \u50640 \u44172  \u51396  \u49324 \u54632 \u51012  \u48155 \u44592  \u50948 \u54616 \u50668  \u54924 \u44060 \u54616 \u44256  \u44536 \u47532 \u49828 \u46020 \u51032  \u51060 \u47492 \u51004 \u47196  \u52840 \u47168 \u47484  \u48155 \u51004 \u46972 \u44256  \u44428 \u47732 \u54616 \u50688 \u45796 . \u44536 \u47532 \u44256  \u44536 \u45716  \'93\u44536 \u47532 \u54616 \u47732  \u49457 \u47161 \u51012  \u49440 \u47932 \u47196  \u48155 \u51004 \u47532 \u45768  \u51060  \u50557 \u49549 \u51008  \u45320 \u55148 \u50752  \u45320 \u55148  \u51088 \u45376 \u50752  \u47784 \u46304  \u47676  \u45936  \u49324 \u46988  \u44263  \u51452  \u50864 \u47532  \u54616 \u45208 \u45784 \u51060  \u50620 \u47560 \u46304 \u51648  \u48512 \u47476 \u49884 \u45716  \u51088 \u46308 \u50640 \u44172  \u54616 \u49888  \u44163 \u51060 \u46972 \'94 (\u54665  2:38, 39) \u44256  \u47568 \u54616 \u50688 \u45796 .\
\uc0\u54616 \u45208 \u45784 \u51032  \u53360  \u45216 \u51032  \u49324 \u44148 \u44284  \u51649 \u51217  \u44288 \u47144 \u54616 \u50668  \u51452 \u45784 \u44760 \u49436 \u45716  \u50836 \u50648  \u49440 \u51648 \u51088 \u47484  \u53685 \u54616 \u50668  \u49457 \u47161 \u44760 \u49436  \u53945 \u48324 \u55176  \u45208 \u53440 \u45208 \u49892  \u44163 \u51012  \u50557 \u49549 \u54616 \u49512 \u45796  (\u50844  2:28). \u51060  \u50696 \u50616 \u51008  \u50724 \u49692 \u51208  \u45216 \u50640  \u49457 \u47161 \u51012  \u48512 \u50612  \u51452 \u49900 \u51004 \u47196 \u50024  \u48512 \u48516 \u51201 \u51004 \u47196  \u49457 \u52712 \u46104 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44536 \u44163 \u51008  \u48373 \u51020  \u49324 \u50629 \u51012  \u47560 \u52832  \u46412  \u54616 \u45208 \u45784 \u51032  \u51008 \u54812 \u44032  \u45208 \u53440 \u45224 \u51004 \u47196  \u50756 \u51204 \u54620  \u49457 \u52712 \u47484  \u48372 \u44172  \u46112  \u44163 \u51060 \u45796 .\
\uc0\u49440 \u44284  \u50501 \u51032  \u45824 \u51137 \u53804 \u45716  \u49464 \u49345 \u51032  \u50669 \u49324 \u44032  \u45149 \u45216  \u46412 \u44620 \u51648  \u45216 \u47196  \u52824 \u50676 \u54644 \u51656  \u44163 \u51060 \u45796 . \u49324 \u45800 \u51008  \u44033  \u49884 \u45824 \u47484  \u53685 \u54616 \u50668  \u44536 \u47532 \u49828 \u46020 \u51032  \u44368 \u54924 \u50640  \u48516 \u45432 \u47484  \u45208 \u53440 \u45256 \u45796 . \u44536 \u47084 \u48064 \u47196  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u50501 \u47560 \u51032  \u49464 \u47141 \u50640  \u45824 \u54637 \u54616 \u50668  \u49444  \u49688  \u51080 \u51012  \u47564 \u53372  \u45817 \u49888 \u51032  \u48177 \u49457 \u51012  \u44053 \u54868 \u49884 \u53412 \u44256 \u51088  \u45817 \u49888 \u51032  \u51008 \u54812 \u50752  \u49457 \u47161 \u51012  \u48512 \u50612  \u51452 \u49512 \u45796 . \u44536 \u47532 \u49828 \u46020 \u51032  \u49324 \u46020 \u46308 \u51060  \u44536 \u48516 \u51032  \u48373 \u51020 \u51012  \u49464 \u49345 \u50640  \u51204 \u54616 \u44256  \u46608 \u54620  \u51109 \u52264  \u50732  \u47784 \u46304  \u49884 \u45824 \u47484  \u50948 \u54616 \u50668  \u44536  \u48373 \u51020 \u51012  \u44592 \u47197 \u54624  \u46412 , \u53945 \u48324 \u55176  \u49457 \u47161 \u51032  \u44368 \u54984 \u51012  \u48155 \u50520 \u45796 . \u44536 \u47084 \u45208  \u44368 \u54924 \u44032  \u52572 \u54980 \u51032  \u44396 \u50896 \u50640  \u44032 \u44620 \u51060  \u51060 \u47484 \u49688 \u47197  \u49324 \u45800 \u51008  \u45908 \u50865  \u53360  \u45733 \u47141 \u51004 \u47196  \u54876 \u46041 \u54616 \u44172  \u46108 \u45796 . \u44536 \u45716  \'93\u51088 \u44592 \u51032  \u46412 \u44032  \u50620 \u47560  \u47803  \u46108  \u51460 \u51012  \u50508 \u48064 \u47196  \u53356 \u44172  \u48516 \u45236 \u50612 \'94 (\u44228  12:12) \u45236 \u47140 \u50728 \u45796 . \u44536 \u45716  \'93\u47784 \u46304  \u45733 \u47141 \u44284  \u54364 \u51201 \u44284  \u44144 \u51667  \u44592 \u51201 \'94 (\u49332 \u54980  2:9) \u51004 \u47196  \u51068 \u54624  \u44163 \u51060 \u45796 . \u54620  \u46412  \u54616 \u45208 \u45784 \u51032  \u52380 \u49324  \u51473 \u50640 \u49436  \u52572 \u44256 \u51032  \u51648 \u50948 \u50640  \u51080 \u45912  \u44536  \u51452 \u47784 \u51088 \u45716  \u50977 \u52380  \u45380  \u46041 \u50504  \u44592 \u47564 \u44284  \u54028 \u47736 \u51032  \u49324 \u50629 \u50640  \u50728  \u51221 \u47141 \u51012  \u44592 \u50872 \u50668  \u50772 \u45796 . \u51060 \u50752  \u44057 \u51060  \u44033  \u49884 \u45824 \u50640  \u44152 \u52432  \u53804 \u51137 \u54616 \u45716  \u46041 \u50504 \u50640  \u50619 \u51008  \u50501 \u47560 \u51201 \u51064  \u49689 \u47144 \u44284  \u44368 \u54876 \u44284  \u44536  \u46041 \u50504 \u50640  \u45798 \u51008  \u47784 \u46304  \u51092 \u54617 \u49457 \u51060  \u52572 \u54980 \u51032  \u53804 \u51137 \u50640  \u51080 \u50612 \u49436  \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u51012  \u45824 \u54637 \u54616 \u45716  \u45936  \u54876 \u50857 \u46112  \u44163 \u51060 \u45796 . \u44536 \u47084 \u48064 \u47196  \u51060 \u50752  \u44057 \u51008  \u50948 \u44592 \u50640  \u51080 \u50612 \u49436  \u44536 \u47532 \u49828 \u46020 \u47484  \u46384 \u47476 \u45716  \u49324 \u46988 \u46308 \u51008  \u51452 \u45784 \u51032  \u51116 \u47548 \u51032  \u44221 \u44256 \u47484  \u49464 \u49345 \u50640  \u51204 \u54616 \u50668 \u50556  \u54620 \u45796 . \u44536 \u47532 \u54616 \u50668  \u51452 \u45784 \u44760 \u49436  \u50724 \u49892  \u46412 \u50640  \u44536 \u48516  \u50526 \u50640 \u49436  \'93\u51216 \u46020  \u50630 \u44256  \u55136 \u46020  \u50630 \u51060 \'94 (\u48295 \u54980  3:14) \u49444  \u49688  \u51080 \u45716  \u54620  \u48177 \u49457 \u51012  \u51456 \u48708 \u49884 \u53020 \u50556  \u54620 \u45796 . \u51060  \u49884 \u45824 \u45716  \u54616 \u45208 \u45784 \u51032  \u51008 \u54812 \u50752  \u45733 \u47141 \u51032  \u53945 \u48324 \u54620  \u49440 \u47932 \u51060  \u49324 \u46020  \u49884 \u45824 \u50752  \u44845  \u47560 \u52268 \u44032 \u51648 \u47196  \u44368 \u54924 \u50640  \u54596 \u50836 \u54616 \u45796 .\
\uc0\u49457 \u47161 \u51032  \u51312 \u47749  (\u29031 \u26126 ) \u51012  \u53685 \u54616 \u50668  \u50724 \u47019 \u46041 \u50504  \u44228 \u49549 \u46104 \u50612  \u50728  \u49440 \u50501 \u51032  \u45824 \u51137 \u53804 \u51032  \u51204 \u47784 \u44032  \u48376 \u49436 \u51032  \u51200 \u51088 \u50640 \u44172  \u44277 \u44060 \u46104 \u50632 \u45796 . \u45208 \u45716  \u46412 \u46412 \u47196  \u44033  \u49884 \u45824 \u47484  \u53685 \u54616 \u50668  \u49373 \u47749 \u51032  \u50773 \u51060 \u49884 \u47728  \u50864 \u47532 \u51032  \u44396 \u50896 \u51032  \u52285 \u49884 \u51088 \u51060 \u49888  \u44536 \u47532 \u49828 \u46020 \u50752  \u50501 \u51032  \u50773 \u51060 \u47728  \u51396 \u51032  \u52285 \u49884 \u51088 \u51060 \u47728  \u54616 \u45208 \u45784 \u51032  \u44144 \u47337 \u54620  \u50984 \u48277 \u51012  \u51228 \u51068  \u47676 \u51200  \u48276 \u54620  \u49324 \u45800 \u44284 \u51032  \u45824 \u51137 \u53804 \u51032  \u49345 \u54889 \u51012  \u48372 \u44172  \u46104 \u50632 \u45796 . \u44536 \u47532 \u49828 \u46020 \u50640  \u45824 \u54620  \u49324 \u45800 \u51032  \u51201 \u44060 \u49900 \u51008  \u44536 \u48516 \u51012  \u46384 \u47476 \u45716  \u49324 \u46988 \u46308 \u50640  \u45824 \u54620  \u44536 \u51032  \u51201 \u44060 \u49900 \u51004 \u47196  \u45208 \u53440 \u45228 \u45796 . \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51032  \u50896 \u52825 \u50640  \u45824 \u54620  \u46609 \u44057 \u51008  \u51613 \u50724 \u49900 \u44284  \u50724 \u47448 \u47484  \u51652 \u47532 \u52376 \u47100  \u48372 \u51060 \u44172  \u54616 \u44256 , \u49324 \u46988 \u51032  \u50984 \u48277 \u51004 \u47196  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51012  \u45824 \u49888 \u54616 \u44172  \u54616 \u50668  \u49324 \u46988 \u46308 \u47196  \u54616 \u50668 \u44552  \u52285 \u51312 \u51452 \u47484  \u44221 \u48176 \u54616 \u44592 \u48372 \u45796 \u45716  \u50724 \u55176 \u47140  \u54588 \u51312 \u47932 \u51012  \u44221 \u48176 \u54616 \u44172  \u54616 \u45716  \u44536  \u46041 \u51068 \u54620  \u44592 \u47564 \u51032  \u49696 \u52293 \u51008  \u44284 \u44144 \u51032  \u47784 \u46304  \u50669 \u49324 \u50640 \u49436  \u44536  \u51088 \u52712 \u47484  \u52286 \u50500 \u48380  \u49688  \u51080 \u45796 . \u49324 \u45800 \u51008  \u54616 \u45208 \u45784 \u51032  \u54408 \u49457 \u51012  \u44536 \u47495 \u46104 \u44172  \u45208 \u53440 \u45236 \u50612  \u49324 \u46988 \u46308 \u47196  \u54616 \u50668 \u44552  \u52285 \u51312 \u51452 \u50640  \u45824 \u54620  \u44536 \u47495 \u46108  \u44288 \u45392 \u51012  \u44032 \u51648 \u44172  \u54632 \u51004 \u47196  \u54616 \u45208 \u45784 \u51012  \u49324 \u46993 \u54616 \u44592 \u48372 \u45796 \u45716  \u46020 \u47532 \u50612  \u47924 \u49436 \u50892 \u54616 \u44256  \u48120 \u50892 \u54616 \u44172  \u54616 \u44256 \u51088  \u50528 \u47484  \u50044 \u44256 , \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51012  \u48260 \u47532 \u44256  \u49324 \u46988 \u46308 \u51060  \u50984 \u48277 \u51032  \u50836 \u44396 \u50640 \u49436  \u48279 \u50612 \u45212  \u44163 \u51004 \u47196  \u49373 \u44033 \u54616 \u44172  \u54616 \u47140 \u44256  \u45432 \u47141 \u54616 \u50688 \u44256 , \u44033  \u49884 \u45824 \u47484  \u53685 \u54616 \u50668  \u44536 \u51032  \u44592 \u47564 \u50640  \u54637 \u44144 \u54616 \u47140 \u45716  \u49324 \u46988 \u46308 \u51012  \u49884 \u51333  \u51068 \u44288  \u54605 \u48149 \u54644  \u50772 \u45796 . \u44536 \u47088  \u49324 \u49892 \u46308 \u51008  \u48512 \u51312 \u46308 \u44284  \u49440 \u51648 \u51088 \u46308 \u44284  \u49324 \u46020 \u46308 \u51032  \u50669 \u49324 \u50640 \u49436 , \u44536 \u47532 \u44256  \u49692 \u44368 \u51088 \u46308 \u44284  \u44060 \u54785 \u51088 \u46308 \u51032  \u50669 \u49324 \u50640 \u49436  \u52286 \u50500 \u48380  \u49688  \u51080 \u45796 .\
\uc0\u47560 \u51648 \u47561  \u45824 \u51137 \u53804 \u50640 \u49436  \u49324 \u45800 \u51008  \u51648 \u45208 \u44036  \u50668 \u47084  \u49884 \u45824 \u50640  \u54665 \u54616 \u50688 \u45912  \u44163 \u44284  \u46609 \u44057 \u51008  \u49696 \u52293 \u51012  \u50416 \u44256 , \u46609 \u44057 \u51008  \u51221 \u49888 \u51012  \u45208 \u53440 \u45236 \u44256 , \u46609 \u44057 \u51008  \u47785 \u51201 \u51012  \u50948 \u54616 \u50668  \u51068 \u54624  \u44163 \u51060 \u45796 . \u51648 \u44552 \u44620 \u51648  \u51080 \u50612  \u50728  \u51068 \u51008  \u50526 \u51004 \u47196 \u46020  \u51080 \u51012  \u44163 \u51060 \u47728 , \u50526 \u51004 \u47196  \u45796 \u44032 \u50732  \u53804 \u51137 \u51008  \u49464 \u49345  \u49324 \u46988 \u46308 \u51060  \u51060 \u51204 \u50640  \u48372 \u51648  \u47803 \u54620  \u47924 \u49453 \u44256  \u52824 \u50676 \u54620  \u44163 \u51004 \u47196  \u53945 \u49353 \u51012  \u51060 \u47344  \u44163 \u51060 \u45796 . \u49324 \u45800 \u51032  \u49549 \u51076 \u49688 \u45716  \u45908 \u50865  \u44368 \u54876 \u54644 \u51648 \u44256 , \u44536 \u51032  \u44277 \u44201 \u51008  \u45908 \u50865  \u47609 \u47148 \u54644 \u51656  \u44163 \u51060 \u45796 . \u44536 \u45716  \u54624  \u49688 \u47564  \u51080 \u51004 \u47732  \u53469 \u54616 \u49888  \u51088 \u46972 \u46020  \u48120 \u54841 \u54616 \u47140 \u44256  \u54624  \u44163 \u51060 \u45796  (\u47561  13:22).\
\uc0\u54616 \u45208 \u45784 \u51032  \u49457 \u47161 \u44760 \u49436  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51032  \u50948 \u45824 \u54620  \u51652 \u47532 \u50752  \u44284 \u44144 \u50752  \u48120 \u47000 \u51032  \u44305 \u44221 \u51012  \u45208 \u51032  \u47560 \u51020 \u50640  \u48372 \u50668  \u51452 \u49512 \u51012  \u46412 , \u45208 \u45716  \u44536 \u52376 \u47100  \u50508 \u47140 \u51652  \u44163 \u46308 \u51012  \u45796 \u47480  \u49324 \u46988 \u46308 \u50640 \u44172  \u51204 \u54644  \u51452 \u46972 \u45716  \u51648 \u49884 \u47484  \u48155 \u50520 \u45796 . \u44536  \u47785 \u51201 \u51012  \u49457 \u52712 \u54616 \u44592  \u50948 \u54616 \u50668  \u45208 \u45716  \u44368 \u54924 \u51032  \u50669 \u49324 \u50640  \u45208 \u53440 \u45212  \u49324 \u44148 \u46308 \u51012  \u49440 \u53469 \u54616 \u50668  \u48516 \u47448 \u54632 \u50640  \u51080 \u50612 \u49436  \u44033  \u49884 \u45824 \u47484  \u53685 \u54616 \u50668  \u51060  \u49464 \u49345 \u50640  \u51452 \u50612 \u51652  \u53360  \u51652 \u47532 , \u44263  \u49324 \u45800 \u51032  \u48516 \u45432 \u50752  \u49464 \u49345 \u51012  \u49324 \u46993 \u54616 \u45716  \u44368 \u54924 \u46308 \u51032  \u51201 \u44060 \u49900 \u51012  \u51068 \u51004 \u53412 \u44256 , \'93\u51453 \u44592 \u44620 \u51648  \u49373 \u47749 \u51012  \u50500 \u45180 \u51648  \u50500 \u45768 \u54616 \u45716 \'94 \u49324 \u46988 \u46308 \u51032  \u51613 \u44144 \u50640  \u51032 \u54616 \u50668  \u48372 \u51316 \u46104 \u50612  \u50728  \u53360  \u51652 \u47532 \u46308 \u51060  \u50612 \u46500  \u47784 \u50577 \u51004 \u47196  \u51204 \u44060 \u46104 \u50612  \u50772 \u45716 \u51648  \u44536  \u51088 \u52712 \u47484  \u45908 \u46316 \u50612  \u48372 \u44256 \u51088  \u45432 \u47141 \u54616 \u50688 \u45796 .\
\uc0\u51060  \u44592 \u47197 \u50640 \u49436  \u50864 \u47532 \u45716  \u51109 \u52264  \u50864 \u47532  \u50526 \u50640  \u45797 \u52432 \u50732  \u53804 \u51137 \u51032  \u51204 \u51312  (\u21069 \u20806 ) \u47484  \u48380  \u49688  \u51080 \u45796 . \u44536 \u44163 \u51012  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51032  \u48731 \u44284  \u54616 \u45208 \u45784 \u51032  \u49457 \u47161 \u51032  \u48731 \u51004 \u47196  \u48708 \u52628 \u50612 \u48380  \u46412 , \u50864 \u47532 \u45716  \u50501 \u47560 \u51032  \u52293 \u47029 \u44284  \u51452 \u44760 \u49436  \u50724 \u49892  \u46412 \u50640  \u44536 \u48516  \u50526 \u50640  \u55136  \u50630 \u51060  \u49436 \u44256 \u51088  \u54616 \u45716  \u49324 \u46988 \u46308 \u51060  \u48152 \u46300 \u49884  \u54588 \u54616 \u50668 \u50556  \u54624  \u50948 \u54744 \u51012  \u54872 \u54616 \u44172  \u45236 \u45796 \u48380  \u49688  \u51080 \u45796 .\
\uc0\u44284 \u44144 \u50640  \u51080 \u50612 \u49436  \u51333 \u44368 \u44060 \u54785 \u51032  \u48156 \u51204 \u50640  \u46384 \u46972  \u49373 \u44596  \u53360  \u49324 \u44148 \u46308 \u51008  \u50724 \u45720 \u45216  \u44060 \u49888 \u44368 \u44228 \u50640 \u49436  \u51068 \u48152 \u51201 \u51004 \u47196  \u51096  \u50508 \u44256  \u51080 \u45716  \u49324 \u49892 \u51060 \u47728 , \u44536 \u44163 \u46308 \u51008  \u45572 \u44396 \u46304 \u51648  \u48512 \u51221 \u54624  \u49688  \u50630 \u45716  \u44163 \u46308 \u51060 \u45796 . \u45208 \u45716  \u44536 \u47084 \u54620  \u50669 \u49324 \u47484  \u48376 \u49436 \u50640  \u54644 \u45817 \u46104 \u45716  \u48276 \u50948  \u50504 \u50640 \u49436  \u44036 \u47029 \u54616 \u44172  \u49548 \u44060 \u54616 \u50688 \u45796 . \u44263  \u49324 \u49892 \u51032  \u44592 \u49696 \u51012  \u51060 \u54644 \u54616 \u44592 \u50640  \u51201 \u45817 \u54616 \u47532 \u47564 \u53372 , \u46608 \u54620  \u54596 \u50836 \u54620  \u47564 \u53372 \u47564  \u44036 \u44208 \u54616 \u44172  \u52712 \u44553 \u54616 \u50688 \u45796 . \u50612 \u46500  \u50669 \u49324 \u44032 \u44032  \u51452 \u51228 \u51032  \u52509 \u44292 \u51201  \u44204 \u54644 \u47484  \u44036 \u45800 \u54616 \u44172  \u45208 \u53440 \u45236 \u44592  \u50948 \u54616 \u50668  \u49324 \u44148 \u46308 \u51012  \u48516 \u47448 \u54664 \u44144 \u45208  \u54200 \u51032 \u49345  \u49464 \u48512  (\u32048 \u37096 ) \u46308 \u51012  \u50836 \u50557 \u54664 \u51012  \u44221 \u50864 \u50640 \u45716  \u44536  \u50669 \u49324 \u44032 \u51032  \u47568 \u46308 \u51012  \u51064 \u50857 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u44163 \u51012  \u51064 \u50857 \u54620  \u44163 \u51008  \u44536  \u51200 \u51088 \u47484  \u44428 \u50948 \u51088 \u47196  \u49548 \u44060 \u54616 \u47140 \u45716  \u44163 \u51060  \u47785 \u51201 \u51060  \u50500 \u45768 \u44256  \u45796 \u47564  \u44536 \u44032  \u51452 \u51109 \u54616 \u45716  \u48148 \u44032  \u51452 \u51228 \u47484  \u49444 \u47749 \u54616 \u45716  \u51068 \u51012  \u49789 \u44172  \u54644 \u51452 \u44256  \u55192 \u51080 \u44172  \u54644 \u51452 \u44592  \u46412 \u47928 \u51060 \u45796 . \u44536 \u47084 \u48064 \u47196  \u50612 \u46500  \u44221 \u50864 \u50640 \u45716  \u44536  \u50669 \u49324 \u44032 \u51032  \u47568 \u50640  \u50500 \u47924 \u47088  \u53945 \u48324 \u54620  \u44428 \u50948 \u47484  \u48512 \u50668 \u54616 \u51648  \u50506 \u50520 \u45796 . \u46608 \u54620  \u50864 \u47532  \u49884 \u45824 \u50640  \u51333 \u44368 \u44060 \u54785  \u49324 \u50629 \u51012  \u52628 \u51652 \u54616 \u44256  \u51080 \u45716  \u49324 \u46988 \u46308 \u51032  \u44221 \u54744 \u44284  \u44204 \u54644 \u47484  \u44592 \u49696 \u54632 \u50640  \u51080 \u50612 \u49436 \u46020  \u44536 \u46308 \u51060  \u52636 \u54032 \u54620  \u51200 \u49436 \u50640  \u45824 \u54616 \u50668  \u44536 \u50752  \u48708 \u49847 \u54620  \u48169 \u48277 \u51012  \u49324 \u50857 \u54616 \u50688 \u45796 .\
\uc0\u48376 \u49436 \u51032  \u47785 \u51201 \u51008  \u51648 \u45208 \u44036  \u49884 \u45824 \u51032  \u53804 \u51137 \u50640  \u44288 \u54616 \u50668  \u49352 \u47196 \u50868  \u51652 \u47532 \u47484  \u51228 \u49884 \u54616 \u45716  \u44163 \u51060 \u46972 \u44592 \u48372 \u45796 \u45716  \u50526 \u51004 \u47196  \u45796 \u44032 \u50724 \u45716  \u49324 \u44148 \u46308 \u44284  \u44288 \u47144 \u46108  \u49324 \u49892 \u46308 \u44284  \u50896 \u52825 \u46308 \u51012  \u45208 \u53440 \u45236  \u51452 \u45716  \u45936  \u51080 \u45796 . \u44536 \u47084 \u45208  \u48731 \u44284  \u50612 \u46176 \u51032  \u49464 \u47141  \u49324 \u51060 \u50640  \u51204 \u44060 \u46104 \u45716  \u45824 \u51137 \u53804 \u51032  \u51068 \u48512 \u47196  \u48148 \u46972 \u48380  \u46412  \u44284 \u44144 \u51032  \u47784 \u46304  \u44592 \u47197 \u46308 \u51008  \u49352 \u47196 \u50868  \u51032 \u48120 \u47484  \u44032 \u51648 \u44256  \u45208 \u53440 \u45208 \u44172  \u46108 \u45796 . \u44536  \u44592 \u47197 \u46308 \u51012  \u53685 \u54616 \u50668  \u48120 \u47000 \u50640  \u48731 \u51060  \u48708 \u52628 \u50612 \u51648 \u44256 , \u44284 \u44144 \u51032  \u44060 \u54785 \u51088 \u46308 \u44284  \u44057 \u51060  \u49464 \u49345 \u51032  \u47784 \u46304  \u49548 \u50976 \u44032  \u55148 \u49373 \u46112 \u51648 \u46972 \u46020  \'93\u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u44284  \u50696 \u49688  \u44536 \u47532 \u49828 \u46020 \u51032  \u51613 \u44144 \u47484 \'94 \u51613 \u44144 \u54616 \u46020 \u47197  \u48512 \u47476 \u49900 \u51012  \u48155 \u45716  \u51088 \u46308 \u51008  \u50526 \u44600 \u50640  \u48731 \u51012  \u48155 \u44172  \u46108 \u45796 .\
