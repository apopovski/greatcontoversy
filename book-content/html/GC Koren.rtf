\f1\b0 \cf0 \
\uc0\u49548 \u46976 \u44284  \u51137 \u53804 \u50752  \u50976 \u54792  \u49324 \u53468 \u44032  \u50724 \u47019 \u46041 \u50504  \u44228 \u49549 \u46104 \u50632 \u45796 . \u50808 \u44397 \u51032  \u44400 \u45824 \u44032  \u45796 \u49884  \u48372 \u54756 \u48120 \u50500 \u50640  \u52840 \u51077 \u54616 \u50688 \u44256 , \u44397 \u45236 \u51032  \u45236 \u48516  (\u20839 \u32027 ) \u51008  \u44228 \u49549 \u51201 \u51004 \u47196  \u45208 \u46972 \u47484  \u54844 \u46976 \u54616 \u44172  \u47564 \u46308 \u50632 \u45796 . \u51060 \u47084 \u54620  \u54805 \u54200 \u50640 \u49436  \u45149 \u44620 \u51648  \u48373 \u51020 \u51012  \u50948 \u54616 \u50668  \u52649 \u49457 \u54620  \u49324 \u46988 \u46308 \u51008  \u51648 \u46021 \u54620  \u48149 \u54644 \u47484  \u45817 \u54616 \u50688 \u45796 .\
\uc0\u44536 \u46308 \u51032  \u50715 \u45216 \u51032  \u54805 \u51228 \u46308 \u51060  \u47196 \u47560 \u44368 \u50752  \u51312 \u50557 \u51012  \u47610 \u50612  \u44536  \u50724 \u47448 \u51032  \u50689 \u54693 \u51012  \u48155 \u44256  \u51080 \u51012  \u46412 , \u52488 \u44592 \u51032  \u49888 \u50521 \u51012  \u44256 \u49688 \u54616 \u44256  \u51080 \u45716  \u49324 \u46988 \u46308 \u51008  \'93\u50672 \u54633 \u46108  \u54805 \u51228 \u46308 \'94\u51060 \u46972 \u45716  \u51060 \u47492 \u51004 \u47196  \u53945 \u49688 \u54620  \u44368 \u54924 \u47484  \u51312 \u51649 \u54616 \u50688 \u45796 . \u51060 \u47196  \u51064 \u54616 \u50668  \u44536 \u46308 \u51008  \u44033 \u52789  \u49324 \u46988 \u46308 \u47196 \u48512 \u53552  \u51200 \u51452 \u47484  \u48155 \u50520 \u45796 . \u44536 \u47084 \u45208  \u44536 \u46308 \u51032  \u54869 \u44256 \u54620  \u53468 \u46020 \u45716  \u55124 \u46308 \u47532 \u51648  \u50506 \u50520 \u45796 . \u44536 \u46308 \u51008  \u49328 \u47548 \u44284  \u46041 \u44404  \u49549 \u50640 \u49436  \u54588 \u45212 \u52376 \u47484  \u52286 \u51012  \u49688 \u48150 \u50640  \u50630 \u50632 \u51648 \u47564  \u50668 \u51204 \u55176  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51012  \u51069 \u44256  \u50696 \u48176 \u46300 \u47532 \u44592  \u50948 \u54616 \u50668  \u54632 \u44760  \u47784 \u50688 \u45796 .\
\uc0\u44536 \u46308 \u51008  \u48708 \u48128 \u47532 \u50640  \u50668 \u47084  \u45208 \u46972 \u50640  \u49324 \u46988 \u46308 \u51012  \u54028 \u44204 \u54616 \u50668  \u50668 \u44592 \u51200 \u44592 \u50640  \u51652 \u47532 \u47484  \u50500 \u45716  \u51088 \u44032  \u51080 \u45716  \u44163 \u44284 , \u44536 \u46308 \u51008  \u48708 \u47197  \u49548 \u49688 \u51060 \u51648 \u47564  \u50668 \u47084  \u51021 \u44284  \u52492 \u50640  \u55145 \u50612 \u51256  \u51080 \u51004 \u47732 \u49436  \u44536 \u46308 \u52376 \u47100  \u48149 \u54644 \u51032  \u45824 \u49345 \u51060  \u46104 \u50612  \u51080 \u45796 \u45716  \u44163 \u44284 , \u46608 \u54620  \u50508 \u54532 \u49828  \u49328  \u51473 \u50640 \u45716  \u49457 \u44221 \u51012  \u44592 \u52488 \u47196  \u54616 \u50668  \u49464 \u50892 \u51652  \u44368 \u54924 \u44032  \u51080 \u51004 \u47728  \u44536  \u44275 \u50640 \u49436  \u50864 \u49345  \u49709 \u48176 \u47196  \u48512 \u54056 \u46108  \u47196 \u47560 \u47484  \u45824 \u54637 \u54616 \u44256  \u51080 \u45796 \u45716  \u49324 \u49892 \u51012  \u50508 \u50520 \u45796 \'94 (Wylie, b.3, ch.19). \u51060 \u47084 \u54620  \u51221 \u48372 \u45716  \u44536 \u46308 \u50640 \u44172  \u53360  \u44592 \u49256 \u51012  \u51452 \u50632 \u51004 \u47728 , \u44536 \u46308 \u51008  \u50760 \u45940 \u49828 \u51064 \u46308 \u44284  \u44368 \u53685 \u54616 \u44172  \u46104 \u50632 \u45796 .\
\uc0\u48372 \u54756 \u48120 \u50500 \u51064 \u46308 \u51008  \u48373 \u51020 \u51012  \u44403 \u44172  \u51648 \u53412 \u47732 \u49436  \u48149 \u54644 \u51032  \u50612 \u46160 \u50868  \u48164 \u51060  \u51648 \u45208 \u44032 \u44592 \u47484  \u44592 \u45796 \u47160 \u45796 . \u44536 \u46308 \u51008  \u44032 \u51109  \u50612 \u46160 \u50868  \u49884 \u44036 \u50640  \u50500 \u52840 \u51060  \u50724 \u44592 \u47484  \u44592 \u45796 \u47532 \u44256  \u51080 \u45716  \u49324 \u46988 \u46308 \u52376 \u47100  \u47680 \u47532  \u51648 \u54217 \u49440  \u51200 \u51901 \u51012  \u51452 \u47785 \u54616 \u50668  \u48372 \u50520 \u45796 . \'93\u44536 \u46308 \u51008  \u49892 \u47196  \u50612 \u47140 \u50868  \u49884 \u45824 \u50640  \u49332 \u50520 \u45796 . \'85\u44536 \u47084 \u45208  \u44536 \u46308 \u51008  \u54980 \u49828 \u50640 \u44172 \u49436  \u52376 \u51020 \u51004 \u47196  \u46307 \u44256 , \u51228 \u47212 \u50640 \u44172 \u49436  \u45796 \u49884  \u48152 \u48373 \u54616 \u50668  \u46308 \u51008  \u47568 , \u44263  \u49352 \u48317 \u51060  \u50724 \u47140 \u47732  \u54620  \u48177 \u45380 \u51008  \u51648 \u45208 \u50556  \u54620 \u45796 \u45716  \u47568 \u51012  \u51082 \u51648  \u50506 \u50520 \u45796 . \u44536  \u47568 \u51008  \u54980 \u49828 \u51032  \u49888 \u48393 \u51088 \u46308 \u50640 \u44172  \u51080 \u50612 \u49436  \u47560 \u52824  \u50528 \u44413 \u50640  \u49549 \u48149 \u46104 \u50612  \u51080 \u45912  \u51060 \u49828 \u46972 \u50648  \u49324 \u46988 \u46308 \u50640 \u44172  \u54620  \u50836 \u49481 \u51032  \u50976 \u50616 , \u44263  \'91\u45208 \u45716  \u51453 \u51004 \u45208  \u54616 \u45208 \u45784 \u51060  \u45320 \u55148 \u47484  \u44428 \u44256 \u54616 \u49324  \u54728 \u46973 \u54616 \u49888  \u46405 \u50640  \u46028 \u50500 \u44032 \u44172  \u54616 \u49884 \u47532 \u46972 \'92\u44256  \u54620  \u50976 \u50616 \u44284  \u44057 \u50520 \u45796 \'94 (Wylie, b.3, ch.19). \'9315\u49464 \u44592  \u47568 \u50685 \u51060  \u46104 \u51088  \'91\u50672 \u54633 \u46108  \u54805 \u51228 \u46308 \'92\u51032  \u44368 \u54924 \u45716  \u45908 \u46356 \u44592 \u45716  \u54616 \u50688 \u51004 \u45208  \u54869 \u49892 \u55176  \u48156 \u51204 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u44256 \u45212 \u51012  \u47732 \u54620  \u44163 \u51008  \u50500 \u45768 \u50632 \u51004 \u45208  \u48708 \u44368 \u51201  \u54217 \u54868 \u47484  \u45572 \u47160 \u45796 . 16\u49464 \u44592  \u52488 \u50685 \u50640 \u45716  \u48372 \u54756 \u48120 \u50500 \u50752  \u47784 \u46972 \u48708 \u50500 \u50640  \u44536 \u46308 \u51032  \u44368 \u54924 \u44032  \u50557  200\u44275  \u51221 \u46020  \u51080 \u50632 \u45796 \'94 (Ezra Hall Gillett, Life and Times of John Huss, vol.2, p.570). \'93\u44536 \u47084 \u48064 \u47196  \u48520 \u44284  \u44160 \u51032  \u47736 \u47581 \u44284  \u48516 \u45432 \u50640 \u49436  \u48279 \u50612 \u45212  \u45224 \u51008  \u51088 \u47196 \u49436  \u54980 \u49828 \u44032  \u50696 \u50616 \u54620  \u44536 \u45824 \u47196  \u49352 \u48317 \u51012  \u47582 \u51060 \u54620  \u49324 \u46988 \u46308 \u51008  \u49345 \u45817 \u55176  \u47566 \u50520 \u45796 \'94 (Wylie, b.3, ch.19).\
