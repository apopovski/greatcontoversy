\uc0\u44536  \u51020 \u49457 \u51008  \u54616 \u45720 \u44284  \u46405 \u51012  \u51652 \u46041 \u49884 \u53416 \u45796 . \u53360  \u51648 \u51652 \u51060  \u51068 \u50612 \u45212 \u45796 . \'93\u49324 \u46988 \u51060  \u46405 \u50640  \u51080 \u50612  \u50740 \u51004 \u47196  \u51060 \u44057 \u51060  \u53360  \u51648 \u51652 \u51060  \u50630 \u50632 \u45908 \u46972 \'94 (\u44228  16:18). \u54616 \u45720 \u51008  \u50676 \u47160 \u45796  \u45803 \u54804 \u45796  \u54616 \u45716  \u44163 \u44057 \u51060  \u48372 \u51064 \u45796 . \u54616 \u45208 \u45784 \u51032  \u48372 \u51340 \u50640 \u49436  \u45208 \u50724 \u45716  \u50689 \u44305 \u51060  \u49324 \u48169 \u51004 \u47196  \u54140 \u51256 \u44032 \u45716  \u44163 \u52376 \u47100  \u48372 \u51064 \u45796 . \u49328 \u46308 \u51008  \u47560 \u52824  \u48148 \u46988 \u50640  \u48520 \u47532 \u45716  \u44040 \u45824 \u50752  \u44057 \u51060  \u55124 \u46308 \u47532 \u44256  \u44144 \u52828  \u48148 \u50948 \u46308 \u51060  \u49324 \u48169 \u51004 \u47196  \u55145 \u50612 \u51652 \u45796 . \u53360  \u54253 \u54413 \u50864 \u44032  \u47792 \u47140 \u50724 \u45716  \u44163 \u44284  \u44057 \u51008  \u49548 \u47532 \u44032  \u45212 \u45796 . \u48148 \u45796 \u50640 \u49436 \u45716  \u49324 \u45208 \u50868  \u47932 \u44208 \u51060  \u49436 \u47196  \u48512 \u46378 \u52828 \u45796 . \u47560 \u52824  \u54028 \u44340  \u54665 \u50948 \u47484  \u54616 \u45716  \u50501 \u47560 \u51032  \u49548 \u47532  \u44057 \u51008  \u53468 \u54413 \u51032  \u47924 \u49436 \u50868  \u49548 \u47532 \u44032  \u46308 \u47536 \u45796 . \u50728  \u51648 \u44396 \u45716  \u48148 \u45796 \u51032  \u47932 \u44208 \u52376 \u47100  \u50500 \u47000 \u50948 \u47196  \u50836 \u46041 \u54616 \u47728  \u44536  \u54364 \u47732 \u51008  \u54028 \u44340 \u46108 \u45796 . \u46405 \u51032  \u44592 \u52488  \u51088 \u52404 \u44032  \u47924 \u45320 \u51256  \u48260 \u47532 \u45716  \u44163  \u44057 \u45796 . \u49328 \u47589 \u46308 \u51008  \u44032 \u46972 \u50505 \u44256 , \u49324 \u46988 \u46308 \u51060  \u44144 \u54616 \u45716  \u49452 \u46308 \u51008  \u51088 \u52712  \u50630 \u51060  \u49324 \u46972 \u51652 \u45796 . \u51396 \u50501 \u51004 \u47196  \u49548 \u46036 \u44284  \u44057 \u51060  \u46104 \u50612  \u48260 \u47536  \u54637 \u44396 \u46308 \u51008  \u49324 \u45208 \u50868  \u54028 \u46020 \u50640  \u55081 \u50424 \u47140  \u44036 \u45796 . \u53360  \u49457  \u48148 \u48296 \u47200 \u51008  \'93\u54616 \u45208 \u45784  \u50526 \u50640  \u44592 \u50613 \u54616 \u49888  \u48148  \u46104 \u50612  \u44536 \u51032  \u47609 \u47148 \u54620  \u51652 \u45432 \u51032  \u54252 \u46020 \u51452 \u51092 \u51012  \u48155 \'94 (\u44228  16:19, 21) \u45716 \u45796 . \u54620  \u45929 \u50612 \u47532 \u44032  \u48177 \u44540 \u52196  \u46104 \u45716  \u53360  \u50864 \u48149 \u51060  \u50143 \u50500 \u51256  \u54028 \u44340 \u54616 \u45716  \u51068 \u51012  \u54616 \u44172  \u46108 \u45796 . \u51648 \u49345 \u51032  \u50724 \u47564 \u54620  \u46020 \u49884 \u46308 \u51008  \u45230 \u50500 \u51652 \u45796 . \u49464 \u49345 \u51032  \u53360  \u51064 \u47932 \u46308 \u51060  \u44536 \u46308  \u51088 \u49888 \u50640 \u44172  \u50689 \u44305 \u51012  \u46028 \u47532 \u44592  \u50948 \u54616 \u50668  \u44536 \u46308 \u51032  \u51116 \u49328 \u51012  \u54728 \u48708 \u54616 \u50668  \u44148 \u52629 \u54620  \u54840 \u54868 \u47196 \u50868  \u44148 \u47932 \u46308 \u51060  \u44536 \u46308 \u51032  \u47785 \u51204 \u50640 \u49436  \u47924 \u45320 \u51256  \u45236 \u47536 \u45796 . \u44048 \u50725 \u51032  \u48317 \u46308 \u51008  \u47924 \u45320 \u51648 \u44256  \u48127 \u51020  \u46412 \u47928 \u50640  \u49549 \u48149 \u46104 \u50632 \u45912  \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u46308 \u51008  \u54644 \u48169 \u46108 \u45796 .\
\uc0\u47924 \u45924 \u51008  \u50676 \u47532 \u44256  \'93\u46405 \u51032  \u54000 \u45132  \u44032 \u50868 \u45936 \u49436  \u51088 \u45716  \u51088  \u51473 \u50640  \u47566 \u51060  \u44648 \u50612  \u50689 \u49373 \u51012  \u50619 \u45716  \u51088 \u46020  \u51080 \u44192 \u44256  \u49688 \u50837 \u51012  \u48155 \u50500 \u49436  \u47924 \u44417 \u55176  \u48512 \u45124 \u47084 \u50880 \u51012  \u51077 \u51012  \u51088 \u46020  \u51080 \u51012  \u44163 \u51060 \'94 (\u45800  12:2) \u45796 . \u49483 \u51704  \u52380 \u49324 \u51032  \u44592 \u48324 \u51012  \u48127 \u44256  \u51453 \u51008  \u49324 \u46988 \u46308 \u51008  \u47784 \u46160  \u50689 \u54868 \u47213 \u44172  \u46108  \u47800 \u51004 \u47196  \u47924 \u45924 \u50640 \u49436  \u45208 \u50752  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51012  \u51648 \u53416  \u51088 \u50640 \u44172  \u51452 \u45716  \u54616 \u45208 \u45784 \u51032  \u54217 \u54868 \u51032  \u50616 \u50557 \u51012  \u46307 \u45716 \u45796 . \'93\u44536 \u47484  \u52236 \u47480  \u51088 \'94 (\u44228  1:7) \u46308 , \u44536 \u47532 \u49828 \u46020 \u51032  \u51453 \u51020 \u51032  \u44256 \u53685 \u51012  \u51312 \u49548 \u54616 \u44256  \u51312 \u47217 \u54620  \u51088 \u46308 , \u44536 \u47532 \u49828 \u46020 \u51032  \u51652 \u47532 \u50752  \u44536 \u48516 \u51032  \u48177 \u49457 \u46308 \u51012  \u47801 \u49884  \u54605 \u48149 \u54620  \u51088 \u46308 \u46020  \u46608 \u54620  \u51068 \u50612 \u45208 \u49436  \u50689 \u44305 \u51473 \u50640  \u44228 \u49888  \u44536 \u48516 \u51012  \u52432 \u45796 \u48372 \u44256  \u52649 \u49457 \u46104 \u44256  \u50728 \u49692 \u54620  \u49324 \u46988 \u46308 \u50640 \u44172  \u51452 \u50612 \u51648 \u45716  \u50689 \u44305 \u51012  \u48372 \u44172  \u46108 \u45796 .\
\uc0\u51673 \u51008  \u44396 \u47492 \u51008  \u50668 \u51204 \u55176  \u54616 \u45720 \u51012  \u45934 \u44256  \u51080 \u45796 . \u44536 \u47084 \u45208  \u53468 \u50577 \u51008  \u46412 \u46412 \u47196  \u44396 \u47492 \u51012  \u46763 \u44256  \u47560 \u52824  \u50896 \u54620 \u50640  \u52268  \u50668 \u54840 \u50752 \u51032  \u45576 \u52376 \u47100  \u45208 \u53440 \u45212 \u45796 . \u47924 \u49436 \u50868  \u49452 \u44305 \u51060  \u54616 \u45720 \u50640 \u49436  \u55128 \u47084 \u45208 \u50752  \u48520 \u44867 \u51004 \u47196  \u46108  \u48372  (\u35091 ) \u52376 \u47100  \u51648 \u44396 \u47484  \u46168 \u47084 \u49916 \u45796 . \u47924 \u49436 \u50868  \u50864 \u47112  \u49548 \u47532 \u47484  \u46763 \u44256  \u49888 \u48708 \u54616 \u44256  \u46160 \u47140 \u50868  \u51020 \u49457 \u51004 \u47196  \u50501 \u51064 \u46308 \u51032  \u50868 \u47749 \u51060  \u49440 \u44256 \u46108 \u45796 . \u44536  \u47568 \u51060  \u47784 \u46304  \u49324 \u46988 \u50640 \u44172  \u51060 \u54644 \u46104 \u45716  \u44163 \u51008  \u50500 \u45768 \u51648 \u47560 \u45716  \u44144 \u51667  \u44368 \u49324 \u46308 \u51008  \u48516 \u47749 \u55176  \u51060 \u54644 \u54616 \u44172  \u46108 \u45796 . \u51312 \u44552  \u51204 \u44620 \u51648 \u46020  \u44536 \u52376 \u47100  \u47924 \u47784 \u54616 \u44256  \u44368 \u47564 \u54616 \u44256  \u46020 \u51204 \u51201 \u51060 \u47728  \u54616 \u45208 \u45784 \u51032  \u44228 \u47749 \u51012  \u51648 \u53412 \u45716  \u48177 \u49457 \u46308 \u50640 \u44172  \u51092 \u51064 \u54616 \u44172  \u54632 \u51004 \u47196 \u50024  \u51032 \u44592 \u50577 \u50577 \u54616 \u45912  \u51088 \u46308 \u51008  \u51060 \u51228  \u45440 \u46972 \u49436  \u50612 \u51796  \u51460 \u51012  \u47784 \u47476 \u44256  \u46504 \u47728  \u47924 \u49436 \u50892 \u54620 \u45796 . \u44536 \u46308 \u51060  \u53685 \u44257 \u54616 \u45716  \u49548 \u47532 \u45716  \u49324 \u48169 \u50640 \u49436  \u45208 \u45716  \u49548 \u47532 \u46308 \u51012  \u51228 \u50517 \u54616