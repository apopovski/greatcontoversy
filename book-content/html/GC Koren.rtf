\f1\b0 \cf0 \
\uc0\u48317 \u48372  \u49324 \u44148 \u51004 \u47196  \u48149 \u54644 \u51032  \u48520 \u51060  \u50500 \u51649  \u51068 \u50612 \u45208 \u44592  \u50724 \u47000  \u51204 \u50640  \u50857 \u44048 \u54616 \u44256  \u50676 \u47148 \u54620  \u54028 \u47120 \u51008  \u48520 \u44032 \u48520  \u51088 \u44592 \u51032  \u44256 \u54693 \u51012  \u54588 \u54644 \u44032 \u51648  \u50506 \u51012  \u49688  \u50630 \u50632 \u45796 . \u44536 \u45716  \u49828 \u50948 \u49828 \u47196  \u44032 \u49436  \u52768 \u48729 \u44544 \u47532 \u51032  \u49324 \u50629 \u51012  \u50896 \u51312 \u54616 \u50668  \u44060 \u54785  \u49324 \u50629 \u51012  \u50976 \u47532 \u54616 \u44172  \u54840 \u51204 \u49884 \u53412 \u44256  \u51080 \u50632 \u45796 . \u44536 \u45716  \u44536 \u51032  \u50668 \u49373 \u51012  \u44144 \u44592 \u49436  \u48372 \u45244  \u51089 \u51221 \u51060 \u50632 \u51648 \u47564  \u54532 \u46993 \u49828 \u50640 \u49436  \u51652 \u54665 \u46104 \u45716  \u51333 \u44368 \u44060 \u54785 \u51032  \u49324 \u50629 \u50640  \u44208 \u51221 \u51201 \u51064  \u50689 \u54693 \u51012  \u48120 \u52824 \u44592  \u50948 \u54616 \u50668  \u44228 \u49549 \u54644 \u49436  \u45432 \u47141 \u54616 \u50688 \u45796 . \u44536 \u51032  \u47581 \u47749  \u49373 \u54876 \u51032  \u52488 \u44592 \u50640 \u45716  \u53945 \u55176  \u51088 \u44592 \u51032  \u44256 \u44397 \u50640  \u48373 \u51020 \u51012  \u51204 \u54028 \u54616 \u44256 \u51088  \u50528 \u47484  \u50044 \u45796 . \u44536 \u45716  \u49345 \u45817 \u54620  \u44592 \u44036  \u46041 \u50504  \u44397 \u44221  \u51648 \u50669 \u50640  \u49324 \u45716  \u44256 \u44397  \u49324 \u46988 \u46308 \u50640 \u44172  \u48373 \u51020 \u51012  \u51204 \u54028 \u54616 \u44256 , \u50616 \u51228 \u45208  \u45130 \u51076 \u50630 \u51060  \u44221 \u44228 \u54616 \u47732 \u49436  \u44256 \u44397 \u51032  \u48516 \u51137 \u51012  \u51452 \u49884 \u54616 \u44256 , \u44201 \u47140 \u50752  \u44428 \u44256 \u51032  \u47568 \u47196 \u50024  \u51200 \u46308 \u51012  \u46020 \u50752 \u51452 \u50632 \u45796 . \u44536 \u45716  \u45796 \u47480  \u47581 \u47749 \u51088 \u46308 \u51032  \u46020 \u50880 \u51012  \u50619 \u50612 \u49436  \u46021 \u51068  \u44060 \u54785 \u51088 \u46308 \u51032  \u51200 \u49436 \u46308 \u51012  \u54532 \u46993 \u49828 \u50612 \u47196  \u48264 \u50669 \u54616 \u44256 , \u54532 \u46993 \u49828 \u50612  \u49457 \u44221 \u46020  \u46041 \u49884 \u50640  \u47566 \u51060  \u52636 \u54032 \u54616 \u50688 \u45796 . \u44536  \u51200 \u49436 \u46308 \u51008  \u47928 \u49436  \u51204 \u46020 \u51088 \u46308 \u51012  \u53685 \u54616 \u50668  \u54532 \u46993 \u49828  \u44397 \u45236 \u50640  \u45328 \u47532  \u51204 \u54644 \u51276 \u45796 . \u44536 \u47088 \u45936  \u47928 \u49436  \u51204 \u46020 \u51088 \u46308 \u51008  \u44536  \u51200 \u49436 \u46308 \u51012  \u49916  \u44050 \u51004 \u47196  \u44277 \u44553 \u48155 \u50520 \u51004 \u48064 \u47196  \u44536 \u46308 \u51008  \u44536  \u51060 \u46301 \u51012  \u44032 \u51648 \u44256  \u44228 \u49549 \u54644 \u49436  \u44536  \u51068 \u51012  \u54624  \u49688  \u51080 \u50632 \u45796 .\
\uc0\u54028 \u47120 \u51008  \u49828 \u50948 \u49828 \u50640 \u49436  \u54620  \u49324 \u46988 \u51032  \u44368 \u49324 \u47196 \u49436  \u51068 \u51012  \u49884 \u51089 \u54616 \u50688 \u45796 . \u44536 \u45716  \u54620 \u51201 \u54620  \u54620  \u44368 \u44396 \u47196  \u44032 \u49436  \u50500 \u46041  \u44368 \u50977 \u50640  \u47792 \u46160 \u54616 \u50688 \u45796 . \u44536 \u45716  \u54617 \u47928 \u51012  \u44032 \u47476 \u52824 \u45716  \u54620 \u54200 , \u49888 \u51473 \u54616 \u44172  \u49457 \u44221 \u51032  \u51652 \u47532 \u47484  \u49548 \u44060 \u54632 \u51004 \u47196  \u50500 \u46041 \u51012  \u53685 \u54616 \u50668  \u44536  \u48512 \u47784 \u46308 \u50640 \u44172  \u51652 \u47532 \u47484  \u51204 \u54616 \u44256 \u51088  \u55148 \u47581 \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u48127 \u45716  \u49324 \u46988 \u46308 \u51060  \u47751  \u49324 \u46988  \u49373 \u44220 \u45796 . \u44536 \u47084 \u45208  \u49888 \u48512 \u46308 \u51060  \u50752 \u49436  \u44536  \u49324 \u50629 \u51012  \u48169 \u54644 \u54616 \u44172  \u46104 \u51088  \u48120 \u49888 \u51201 \u51064  \u49884 \u44264  \u49324 \u46988 \u46308 \u51060  \u51068 \u50612 \u45208 \u49436  \u44536  \u49324 \u50629 \u51012  \u48152 \u45824 \u54616 \u44172  \u46104 \u50632 \u45796 . \'93\u44536 \u44163 \u51060  \u44536 \u47532 \u49828 \u46020 \u51032  \u48373 \u51020 \u51060  \u46112  \u49688  \u50630 \u45716  \u44163 \u51008  \u44536 \u44163 \u51012  \u51204 \u54028 \u54632 \u51004 \u47196  \u54217 \u54868 \u44032  \u50724 \u45716  \u44163 \u51060  \u50500 \u45768 \u45796 . \u51204 \u51137 \u51060  \u50724 \u45716  \u44163 \u51012  \u48372 \u47732  \u50508  \u49688  \u51080 \u45796 \'94 (Wylie, b.14, ch.3) \u44256  \u49888 \u48512 \u46308 \u51008  \u51452 \u51109 \u54616 \u50688 \u45796 . \u44536 \u45716  \u52488 \u44592 \u51032  \u51228 \u51088 \u46308 \u52376 \u47100 , \u51060  \u49457 \u51021 \u50640 \u49436  \u48149 \u54644 \u47484  \u47564 \u45208 \u47732  \u51200  \u49457 \u51021 \u51004 \u47196  \u54588 \u54616 \u50668  \u45796 \u45396 \u45796 . \u44536 \u45716  \u52628 \u50948 \u50752  \u54588 \u44260 \u51012  \u47924 \u47493 \u50416 \u44256  \u51060  \u47560 \u51012 \u50640 \u49436  \u51200  \u47560 \u51012 \u47196 , \u51060  \u49457  \u51200  \u49457 \u51004 \u47196  \u44152 \u50612  \u45796 \u45396 \u45716 \u45936  \u50612 \u46356 \u47484  \u44032 \u46304 \u51648  \u44536 \u51032  \u49373 \u47749 \u51008  \u50948 \u54801 \u51012  \u48155 \u44256  \u51080 \u50632 \u45796 . \u44536 \u45716  \u49884 \u51109 \u50640 \u49436 , \u44368 \u54924 \u50640 \u49436  \u46412 \u47196 \u45716  \u49457 \u51204 \u51032  \u49444 \u44368 \u45800 \u50640 \u49436  \u51652 \u47532 \u47484  \u51204 \u54616 \u50688 \u45796 . \u50612 \u46500  \u46412 \u50640 \u45716  \u52397 \u51473 \u51060  \u54620  \u49324 \u46988 \u46020  \u50630 \u51012  \u46412 \u46020  \u51080 \u50632 \u44256 , \u50612 \u46500  \u46412 \u50640 \u45716  \u49444 \u44368 \u54616 \u45716  \u51473 \u50640  \u44256 \u54632  \u49548 \u47532 \u50752  \u51312 \u47217 \u51004 \u47196  \u48169 \u54644 \u47484  \u48155 \u51008  \u51201 \u46020  \u51080 \u50632 \u51004 \u47728 , \u49900 \u51648 \u50612 \u45716  \u49444 \u44368 \u45800 \u50640 \u49436  \u45212 \u54253 \u54616 \u44172  \u45132 \u47140  \u45236 \u47140 \u50724 \u45716  \u48393 \u48320 \u46020  \u45817 \u54616 \u50688 \u45796 . \u50668 \u47084  \u48264  \u54253 \u46020 \u46308 \u51032  \u44277 \u44201 \u51012  \u48155 \u50500  \u44144 \u51032  \u51453 \u51012  \u51221 \u46020 \u47196  \u47588 \u47484  \u47582 \u51008  \u51068 \u46020  \u51080 \u50632 \u45796 . \u44536 \u47092 \u51648 \u46972 \u46020  \u44536 \u45716  \u50526 \u51004 \u47196  \u51204 \u51652 \u54616 \u50688 \u45796 . \u46412 \u46412 \u47196  \u48176 \u52377 \u51012  \u45817 \u54616 \u50688 \u51012 \u51648 \u46972 \u46020  \u47932 \u47084 \u49436 \u51648  \u50500 \u45768 \u54616 \u44256  \u44277 \u44201 \u50640  \u45824 \u54637 \u54616 \u50668  \u44032 \u45716  \u46041 \u50504 \u50640  \u51216 \u52264 \u47196  \u48277 \u50773 \u44368 \u51032  \u50836 \u49352 \u47196  \u46104 \u50612  \u51080 \u45912  \u49457 \u51021 \u46308 \u51060  \u48373 \u51020 \u50640  \u45824 \u54616 \u50668  \u44536 \u46308 \u51032  \u47928 \u54840 \u47484  \u44060 \u48169 \u54616 \u44172  \u46104 \u50632 \u45796 . \u52376 \u51020 \u50640  \u44536 \u44032  \u54876 \u46041 \u54616 \u50688 \u45912  \u51089 \u51008  \u44368 \u44396 \u45716  \u50724 \u47000 \u51648  \u50506 \u50500 \u49436  \u44060 \u49888 \u44368 \u51032  \u49888 \u50521 \u51012  \u48155 \u50500 \u46308 \u50688 \u45796 . \u47784 \u46972  (Morat), \u45684 \u49324 \u53588  (Neuchatel) \u46321 \u51032  \u46020 \u49884 \u46308 \u46020  \u47196 \u47560 \u44368 \u51032  \u51032 \u49885 \u46308 \u51012  \u48260 \u47532 \u44256  \u50864 \u49345 \u51012  \u51228 \u44144 \u54644  \u48260 \u47160 \u45796 .\
\uc0\u54028 \u47120 \u51008  \u51228 \u45348 \u48148 \u50640  \u44060 \u49888 \u44368 \u51032  \u44611 \u48156 \u51012  \u44866 \u44256 \u51088  \u50724 \u47019 \u46041 \u50504  \u50676 \u47581 \u54644  \u50772 \u45796 . \u44536  \u44275 \u50640  \u51652 \u47532 \u44032  \u51204 \u54028 \u46104 \u47732 , \u44536  \u44275 \u51008  \u54532 \u46993 \u49828 \u50752  \u49828 \u50948 \u49828 \u50752  \u51060 \u53468 \u47532 \u47484  \u50948 \u54620  \u51333 \u44368 \u44060 \u54785 \u51032  \u51473 \u49900 \u51648 \u44032  \u46112  \u44163 \u51060 \u50632 \u45796 . \u44536 \u45716  \u44536  \u47785 \u51201 \u51012  \u50948 \u54616 \u50668  \u44984 \u51456 \u55176  \u45432 \u47141 \u54620  \u44208 \u44284 \u47196  \u44536  \u51452 \u50948 \u51032  \u47566 \u51008  \u46020 \u49884 \u46308 \u44284  \u51089 \u51008  \u47560 \u51012 \u46308 \u51012  \u50619 \u44172  \u46104 \u50632 \u45796 . \u44536  \u54980 \u50640  \u44536 \u45716  \u54620  \u49324 \u46988 \u51032  \u46041 \u47308 \u47564 \u51012  \u45936 \u47532 \u44256  \u51228 \u45348 \u48148 \u47196  \u46308 \u50612 \u44052 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u46160  \u48264  \u48150 \u50640 \u45716  \u49444 \u44368 \u54624  \u44592 \u54924 \u47484  \u50619 \u51648  \u47803 \u54616 \u50688 \u45796 . \u49888 \u48512 \u46308 \u51008  \u51221 \u48512 \u51032  \u44428 \u50948 \u47484  \u44032 \u51648 \u44256  \u44536 \u47484  \u51221 \u51396 \u53076 \u51088  \u54616 \u50688 \u51004 \u45208  \u44536  \u51068 \u51060  \u54728 \u51648 \u47196  \u46028 \u50500 \u44032 \u44172  \u46104 \u51088 , \u44536 \u47484  \u49457 \u51649 \u51088 \u46308 \u51032  \u54924 \u51032 \u50640  \u48520 \u47084  \u45459 \u44256  \u47924 \u44592 \u47484  \u44048 \u52628 \u44256  \u44032 \u49436  \u44536 \u47484  \u51453 \u51060 \u47140 \u44256  \u54616 \u50688 \u45796 . \u44536  \u54924 \u51032 \u51109  \u48150 \u50640 \u45716  \u44201 \u45432 \u54620  \u54253 \u46020 \u46308 \u51060  \u44260 \u48393 \u44284  \u44160 \u51012  \u44032 \u51648 \u44256  \u45824 \u44592 \u54616 \u44256  \u51080 \u50632 \u51004 \u47728 , \u47564 \u51068  \u44536 \u44032  \u54924 \u51032  \u51109 \u49548 \u50640 \u49436  \u54588 \u54616 \u50668  \u45208 \u50724 \u44172  \u46104 \u47732  \u44536 \u47484  \u49332 \u54644 \u54616 \u44256 \u51088  \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u51648 \u49324  (\u30693 \u20107 ) \u50752  \u47924 \u51109 \u54620  \u44400 \u45824 \u50640  \u51032 \u54616 \u50668  \u44396 \u50896 \u51012  \u48155 \u50520 \u45796 . \u51060 \u53951 \u45216  \u50500 \u52840  \u51068 \u52237  \u44536 \u45716  \u51088 \u44592 \u51032  \u46041 \u47308 \u50752  \u54632 \u44760  \u54840 \u49688  \u44148 \u45320 \u54200 \u51032  \u50504 \u51204 \u51648 \u45824 \u47196  \u50504 \u45236 \u46104 \u50632 \u45796 . \u44536 \u47532 \u54616 \u50668  \u51228 \u45348 \u48148 \u47484  \u48373 \u51020 \u54868 \u49884 \u53412 \u44256 \u51088  \u54620  \u44536 \u51032  \u52395  \u48264 \u51704  \u54876 \u46041 \u51008  \u45149 \u45228 \u45796 .\
