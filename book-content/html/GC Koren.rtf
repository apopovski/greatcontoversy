\uc0\u50920 \u49836 \u47532 \u45716  \u44536 \u51032  \u51452 \u45784 \u52376 \u47100  \u54616 \u45208 \u45784 \u51032  \u48373 \u51020 \u51012  \u51204 \u54616 \u45716  \u54620 \u54200  \'93\u50984 \u48277 \u51012  \u53356 \u44172  \u54616 \u47728  \u51316 \u44480 \u52992  \u54616 \'94\u44592  \u50948 \u54616 \u50668  \u45432 \u47141 \u54616 \u50688 \u45796 . \u44536 \u45716  \u54616 \u45208 \u45784 \u44760 \u49436  \u47585 \u44200  \u51452 \u49888  \u49324 \u50629 \u51012  \u52649 \u49892 \u55176  \u44048 \u45817 \u54616 \u50688 \u51004 \u48064 \u47196  \u50689 \u44305 \u49828 \u47084 \u50868  \u44208 \u44284 \u47484  \u48372 \u44172  \u46104 \u50632 \u45796 . \u44536 \u45716  \u45208 \u51060  80\u49464 \u44032  \u45336 \u51008  \u47564 \u45380 \u50640  \u44032 \u49436 , \u44263  \u48152 \u49464 \u44592  \u51060 \u49345 \u51032  \u48393 \u49324 \u51032  \u49373 \u50528 \u47484  \u53685 \u54616 \u50668  50\u47564 \u47749  \u51060 \u49345 \u51032  \u50689 \u54844 \u46308 \u51012  \u49888 \u51088 \u47196  \u50619 \u50632 \u45796 . \u44536 \u47532 \u44256  \u44536 \u51032  \u48393 \u49324 \u47484  \u53685 \u54616 \u50668  \u53440 \u46973 \u44284  \u47736 \u47581 \u51032  \u44396 \u45929 \u51060 \u50640 \u49436  \u44256 \u49345 \u54616 \u44256  \u49692 \u44208 \u54620  \u49373 \u50528 \u47196  \u46308 \u50612 \u44036  \u47924 \u47532 \u46308 \u44284  \u44536 \u51032  \u44368 \u54984 \u51004 \u47196  \u47568 \u48120 \u50516 \u50500  \u45908 \u50865  \u44618 \u44256  \u54413 \u48512 \u54620  \u52404 \u54744 \u51012  \u50619 \u51008  \u49324 \u46988 \u46308 \u51032  \u49688 \u45716  \u44396 \u49549 \u48155 \u51008  \u44032 \u51313 \u51060  \u54616 \u45208 \u45784 \u51032  \u45208 \u46972 \u50640  \u47784 \u51068  \u44536  \u46412 \u50640  \u44032 \u49436 \u50556  \u48708 \u47196 \u49548  \u48157 \u55176  \u50508 \u47140 \u51656  \u44163 \u51060 \u45796 . \u44536 \u51032  \u49373 \u50528 \u45716  \u47784 \u46304  \u44536 \u47532 \u49828 \u46020 \u51064 \u46308 \u50640 \u44