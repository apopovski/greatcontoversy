\uc0\u52649 \u49892 \u54620  \u44368 \u49324 \u46308 \u51060  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51012  \u49444 \u47749 \u54616 \u47732 , \u44536  \u47749 \u48177 \u54620  \u44368 \u47532 \u47484  \u51060 \u45800 \u51060 \u46972 \u44256  \u48708 \u45212 \u54632 \u51004 \u47196  \u51652 \u47532 \u47484  \u53456 \u44396 \u54616 \u44256 \u51088  \u54616 \u45716  \u49324 \u46988 \u46308 \u51012  \u46028 \u50500 \u49436 \u44172  \u54616 \u47732 \u49436 \u46020  \u49457 \u44221 \u51012  \u50500 \u45432 \u46972 \u44256  \u49828 \u49828 \u47196  \u51452 \u51109 \u54616 \u45716  \u47785 \u49324 \u46308 \u44284  \u54617 \u51088 \u46308 \u51060  \u51068 \u50612 \u45208 \u44256  \u51080 \u45796 . \u47564 \u51068  \u48148 \u48296 \u47200 \u51032  \u49696 \u47196  \u52712 \u54616 \u44172  \u54616 \u45716  \u51208 \u47581 \u51201 \u51064  \u51068 \u51060  \u49464 \u49345 \u50640  \u50630 \u50632 \u51012  \u44163  \u44057 \u51004 \u47732  \u47749 \u48177 \u54616 \u44256  \u50696 \u47532 \u54620  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51032  \u51652 \u47532 \u47196  \u47568 \u48120 \u50516 \u50500  \u51396 \u47484  \u44648 \u45803 \u44256  \u54924 \u44060 \u54616 \u45716  \u49324 \u46988 \u46308 \u51060  \u47924 \u49688 \u55176  \u47566 \u50520 \u51012  \u44163 \u51060 \u45796 . \u44536 \u47084 \u45208  \u51333 \u44368 \u51201  \u49888 \u51312 \u50640  \u50668 \u47084  \u44032 \u51648  \u54844 \u46976 \u44284  \u49345 \u54840 \u44036 \u50640  \u47784 \u49692 \u51060  \u51080 \u50632 \u51004 \u48064 \u47196  \u49324 \u46988 \u46308 \u51008  \u50612 \u46500  \u44163 \u51012  \u51652 \u47532 \u47196  \u48127 \u50612 \u50556  \u54624 \u51648  \u47784 \u47476 \u44172  \u46104 \u50632 \u45796 . \u49464 \u49345  \u49324 \u46988 \u51060  \u54924 \u44060 \u54616 \u51648  \u50506 \u45716  \u51396 \u45716  \u44368 \u54924 \u44032  \u52293 \u51076 \u51012  \u51256 \u50556  \u54620 \u45796 .\
\uc0\u50836 \u54620 \u44228 \u49884 \u47197  14\u51109 \u51032  \u46168 \u51704  \u52380 \u49324 \u51032  \u44592 \u48324 \u51008  1844\u45380  \u50668 \u47492 \u50640  \u52376 \u51020 \u51004 \u47196  \u51204 \u54028 \u46104 \u50632 \u45796 . \u44536 \u47088 \u45936  \u44536  \u44592 \u48324 \u51008  \u44536  \u49900 \u54032 \u51032  \u44221 \u44256 \u44032  \u51228 \u51068  \u45328 \u47532  \u51204 \u54028 \u46104 \u44256 , \u51228 \u51068  \u48372 \u54200 \u51201 \u51004 \u47196  \u44144 \u51208 \u45817 \u54616 \u44256 , \u46608 \u54620  \u44368 \u54924 \u44032  \u44032 \u51109  \u44553 \u49549 \u46020 \u47196  \u53440 \u46973 \u54616 \u44172  \u46108  \u48513 \u48120  \u54633 \u51473 \u44397 \u51032  \u44368 \u54924 \u46308 \u50640 \u44172  \u44032 \u51109  \u51649 \u51217 \u51201 \u51004 \u47196  \u51201 \u50857 \u46104 \u50632 \u45796 . \u44536 \u47084 \u45208  \u46168 \u51704  \u52380 \u49324 \u51032  \u44592 \u48324 \u51008  1844\u45380 \u50640  \u50756 \u51204 \u55176  \u49457 \u52712 \u46104 \u51648  \u47803 \u54616 \u50688 \u45796 . \u45817 \u49884 \u51032  \u44368 \u54924 \u46308 \u51060  \u51116 \u47548 \u44592 \u48324 \u51032  \u48731 \u51012  \u44144 \u51208 \u54620  \u44208 \u44284 \u47196  \u46020 \u45909 \u51201  \u53440 \u46973 \u51012  \u44221 \u54744 \u54616 \u50688 \u51004 \u45208  \u44536  \u53440 \u46973 \u51008  \u44537 \u46020 \u50640  \u45804 \u54620  \u44163 \u51060  \u50500 \u45768 \u50632 \u45796 . \u44536 \u46308 \u51008  \u44536  \u49884 \u45824 \u51032  \u53945 \u49688 \u54620  \u51652 \u47532 \u47484  \u44144 \u51208 \u54632 \u51004 \u47196  \u45908 \u50865 \u45908  \u44618 \u51060  \u53440 \u46973 \u54616 \u44172  \u46104 \u50632 \u45796 . \u44536 \u47084 \u45208  \'93\u47924 \u45320 \u44220 \u46020 \u45796  \u53360 \u49457  \u48148 \u48296 \u47200 \u51060 \u50668  \u47784 \u46304  \u45208 \u46972 \u47484  \u44536  \u51020 \u54665 \u51004 \u47196  \u51064 \u54616 \u50668  \u51652 \u45432 \u51032  \u54252 \u46020 \u51452 \u47196  \u