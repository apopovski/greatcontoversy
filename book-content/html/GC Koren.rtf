\uc0\u44536 \u47084 \u47732  \u51060 \u52376 \u47100  \u49457 \u44221 \u51012  \u44257 \u54644 \u54616 \u45716  \u51088 \u45716  \u50612 \u46356 \u50640 \u49436  \u51088 \u49888 \u51032  \u44208 \u47200 \u51012  \u45132 \u50612 \u50724 \u45716 \u44032 ? \u44536 \u45716  \u45796 \u50967 \u51060  \u54616 \u45208 \u45784 \u51032  \u49453 \u47532 \u50640  \u49692 \u51333 \u54616 \u45716  \u47560 \u51020 \u51012  \u45208 \u53440 \u45240  \u45800  \u54616 \u45208 \u51032  \u47928 \u51109 \u50640 \u49436  \u44536  \u44208 \u47200 \u51012  \u52712 \u54620 \u45796 . \'93\u45796 \u50967  \u50773 \u51032  \u47560 \u51020 \u51060  \u50517 \u49332 \u47212 \u50640 \u44172  \u54693 \u54616 \u50668  \u44036 \u51208 \u54616 \u45768  \u50516 \u45436 \u51008  \u51060 \u48120  \u51453 \u50632 \u51004 \u48064 \u47196  \u50773 \u51060  \u50948 \u47196 \u47484  \u48155 \u50520 \u51020 \u51060 \u45908 \u46972 .\'94 \u44536 \u51032  \u49836 \u54548 \u51032  \u44053 \u46020  (\u24378 \u24230 ) \u45716 , \u49884 \u44036 \u51060  \u51648 \u45224 \u50640  \u46384 \u46972  \u50557 \u54644 \u51256 \u49436  \u44536 \u51032  \u47560 \u51020 \u51008  \u51453 \u51008  \u51088 \u50640 \u44172 \u49436  \u49328  \u50500 \u46308 , \u44263  \u51396 \u51032  \u54805 \u48268 \u51012  \u46160 \u47140 \u50892 \u54616 \u50668  \u49828 \u49828 \u47196  \u46020 \u47581 \u44036  \u50500 \u46308  \u50517 \u49332 \u47212 \u50640 \u44172 \u47196  \u46028 \u50500 \u44052 \u45796 . \u44536 \u47088 \u45936  \u51060  \u44396 \u51208 \u51060  \u44540 \u52828 \u49345 \u44036  (\u36817 \u35242 \u30456 \u23014 ) \u51032  \u51396 \u47484  \u48276 \u54620  \u49696 \u51452 \u51221 \u48197 \u51060  \u50516 \u45436 \u51060  \u51453 \u51008  \u51593 \u49884  \u48373 \u46108  \u44275 \u51004 \u47196  \u44032 \u49436  \u44144 \u44592 \u49436  \u49692 \u44208 \u54644 \u51648 \u44256  \u51396  \u50630 \u45716  \u52380 \u49324 \u46308 \u44284  \u44368 \u51228 \u54624  \u51088 \u44201 \u51012  \u50619 \u44172  \u46108  \u51613 \u44144 