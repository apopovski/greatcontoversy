\f1\b0 \cf0 \
\uc0\u44536 \u47532 \u49828 \u46020 \u51032  \u51116 \u47548 \u50640  \u44288 \u54620  \u44368 \u47532 \u50752  \u49444 \u44368 \u44032  \u51068 \u48152  \u44368 \u54924 \u50640 \u49436  \u54872 \u50689 \u51012  \u48155 \u51648  \u47803 \u54616 \u45716  \u51060 \u50976 \u44032  \u47924 \u50631 \u51064 \u44032 ? \u44536 \u44163 \u51008  \u51116 \u47548 \u51060  \u51032 \u51064 \u50640 \u44172 \u45716  \u55148 \u47581 \u44284  \u44592 \u49256 \u51060  \u46104 \u51648 \u47560 \u45716  \u50501 \u51064 \u50640 \u44172 \u45716  \u48520 \u54665 \u44284  \u47736 \u47581 \u51060  \u46104 \u44592  \u46412 \u47928 \u51060 \u45796 . \u51060  \u50948 \u45824 \u54620  \u51652 \u47532 \u45716  \u44033  \u49884 \u45824 \u47484  \u53685 \u54616 \u50668  \u54616 \u45208 \u45784 \u51032  \u52649 \u49892 \u54620  \u48177 \u49457 \u46308 \u50640 \u44172 \u45716  \u50948 \u50504 \u51060  \u46104 \u50632 \u45796 . \u44536 \u47084 \u45208  \u47560 \u52824  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u50976 \u45824 \u51064 \u50640 \u44172  \'93\u44144 \u52824 \u45716  \u46028 \u44284  \u44152 \u47532 \u45716  \u48152 \u49437 \'94\u51060  \u46108  \u44163 \u52376 \u47100  \u49548 \u50948  \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u51060 \u46972 \u44256  \u44277 \u50616 \u54616 \u45716  \u48177 \u49457 \u50640 \u44172 \u46020  \'93\u44144 \u52824 \u45716  \u46028 \u44284  \u44152 \u47532 \u45716  \u48152 \u49437 \'94\u51060  \u46108  \u44163 \u51060 \u45796 . \u50864 \u47532  \u44396 \u51452 \u44760 \u49436 \u45716  \u52828 \u55176  \u44536  \u51228 \u51088 \u46308 \u50640 \u44172  \'93\u44032 \u49436  \u45320 \u55148 \u47484  \u50948 \u54616 \u50668  \u52376 \u49548 \u47484  \u50696 \u48708 \u54616 \u47732  \u45236 \u44032  \u45796 \u49884  \u50752 \u49436  \u45320 \u55148 \u47484  \u45236 \u44172 \u47196  \u50689 \u51217 \u54616 \u50668  \u45208  \u51080 \u45716  \u44275 \u50640  \u45320 \u55148 \u46020  \u51080 \u44172  \u54616 \u47532 \u46972 \'94 (\u50836  14:3) \u44256  \u50557 \u49549 \u54616 \u49512 \u45796 . \u46041 \u51221 \u49900 \u51060  \u47566 \u51004 \u49888  \u44396 \u51452 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u51228 \u51088 \u46308 \u51032  \u44256 \u46021 \u54616 \u44256  \u49836 \u54536  \u49900 \u51221 \u51012  \u49373 \u44033 \u54616 \u50668  \u52380 \u49324 \u46308 \u50640 \u44172  \u47749 \u54616 \u50668  \u44536 \u46308 \u51012  \u50948 \u47196 \u54616 \u44172  \u54616 \u49884 \u44256 , \u45817 \u49888 \u44760 \u49436  \u49849 \u52380 \u54616 \u49888  \u44163 \u44284  \u44057 \u51008  \u47784 \u50577 \u51004 \u47196  \u45796 \u49884  \u50724 \u49892  \u44163 \u51060 \u46972 \u45716  \u48372 \u51613 \u51012  \u54616 \u44172  \u54616 \u49512 \u45796 . \u51228 \u51088 \u46308 \u51060  \u49436 \u49436  \u54616 \u45720 \u51012  \u50864 \u47084 \u47084  \u44536 \u46308 \u51060  \u49324 \u46993 \u54616 \u45716  \u50696 \u49688 \u45784 \u51032  \u47560 \u51648 \u47561  \u47784 \u49845 \u51012  \u51452 \u47785 \u54616 \u44256  \u51080 \u51012  \u46412 , \u44536 \u46308 \u51008  \'93\u44040 \u47540 \u47532  \u49324 \u46988 \u46308 \u50500  \u50612 \u52236 \u54616 \u50668  \u49436 \u49436  \u54616 \u45720 \u51012  \u52432 \u45796 \u48372 \u45712 \u45264  \u45320 \u55148  \u44032 \u50868 \u45936 \u49436  \u54616 \u45720 \u47196  \u50732 \u47532 \u50864 \u49888  \u51060  \u50696 \u49688 \u45716  \u54616 \u45720 \u47196  \u44032 \u49900 \u51012  \u48376  \u44536 \u45824 \u47196  \u50724 \u49884 \u47532 \u46972 \'94 (\u54665  1:11) \u45716  \u51020 \u49457 \u51012  \u46308 \u50632 \u45796  \u44536  \u52380 \u49324 \u51032  \u47568 \u51012  \u46307 \u51088  \u51228 \u51088 \u46308 \u51032  \u55148 \u47581 \u51008  \u49352 \u47196 \u50892 \u51276 \u45796 . \u51228 \u51088 \u46308 \u51008  \'93\u53360  \u44592 \u49256 \u51004 \u47196  \u50696 \u47336 \u49332 \u47128 \u50640  \u46028 \u50500 \u44032  \u45720  \u49457 \u51204 \u50640  \u51080 \u50612  \u54616 \u45208 \u45784 \u51012  \u52268 \u49569 \u54616 \u50688 \u45796 \'94 (\u45573  24:52, 53). \u44536 \u46308 \u51008  \u50696 \u49688 \u45784 \u44760 \u49436  \u51200 \u55148 \u47484  \u46496 \u45208 \u44032 \u49512 \u44256 , \u51200 \u55148 \u46308 \u47564 \u51004 \u47196  \u49464 \u49345 \u51032  \u44256 \u45212 \u44284  \u49884 \u54744 \u51012  \u45824 \u54637 \u54616 \u50668  \u49912 \u50864 \u44172  \u46104 \u50632 \u44592  \u46412 \u47928 \u50640  \u44592 \u48848 \u54620  \u44163 \u51060  \u50500 \u45768 \u46972  \u51452 \u44760 \u49436  \u45796 \u49884  \u50724 \u49888 \u45796 \u45716  \u52380 \u49324 \u51032  \u48372 \u51613 \u51012  \u46308 \u50632 \u44592  \u46412 \u47928 \u50640  \u44592 \u48848 \u54616 \u50688 \u45796 .\
\uc0\u44536 \u47532 \u49828 \u46020 \u51032  \u51116 \u47548 \u51032  \u44592 \u48324 \u51008  \u50715 \u51201 \u50640  \u52380 \u49324 \u46308 \u51060  \u48288 \u46308 \u47112 \u54772 \u51032  \u47785 \u51088 \u46308 \u50640 \u44172  \u51204 \u54620  \u49548 \u49885 \u44284  \u44057 \u51060  \u50724 \u45720 \u45216 \u50640 \u46020  \u53360  \u44592 \u49256 \u51032  \u51339 \u51008  \u49548 \u49885 \u51060  \u46104 \u50612 \u50556  \u54624  \u44163 \u51060 \u45796 . \u51652 \u51221 \u51004 \u47196  \u44396 \u51452 \u47484  \u49324 \u46993 \u54616 \u45716  \u49324 \u46988 \u46308 \u51008  \u50689 \u49373 \u51032  \u49548 \u47581 \u51032  \u51473 \u49900 \u51060  \u46104 \u45716  \u51452 \u45784 \u44760 \u49436  \u45796 \u49884  \u50724 \u49884 \u46104 , \u52488 \u47548 \u51032  \u46412 \u50752  \u44057 \u51060  \u51312 \u47217 \u44284  \u47736 \u49884 \u50752  \u44144 \u51208 \u51012  \u45817 \u54616 \u45716  \u47784 \u49845 \u51004 \u47196 \u44032  \u50500 \u45768 \u46972  \u50689 \u44305 \u44284  \u44428 \u45733 \u51012  \u44032 \u51648 \u44256  \u45817 \u49888 \u51032  \u48177 \u49457 \u51012  \u44396 \u49549 \u54616 \u49884 \u44256 \u51088  \u50724 \u49888 \u45796 \u45716  \u49548 \u49885 \u51012  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51012  \u44540 \u44144 \u47196  \u49440 \u54252 \u54624  \u46412  \u44536  \u49548 \u49885 \u51012  \u54872 \u50689 \u54616 \u51648  \u50500 \u45768 \u54624  \u49688  \u50630 \u45796 . \u44396 \u51452 \u44760 \u49436  \u50724 \u49884 \u51648  \u50506 \u44592 \u47484  \u50896 \u54616 \u45716  \u51088 \u46308 \u51008  \u51452 \u45784 \u51012  \u49324 \u46993 \u54616 \u51648  \u50506 \u51008  \u51088 \u46308 \u51060 \u45796 . \u44536 \u47532 \u44256  \u44368 \u54924 \u44032  \u54616 \u45720 \u47196 \u48512 \u53552  \u50728  \u44592 \u48324 \u50640  \u45824 \u54616 \u50668  \u48516 \u45432 \u50752  \u51613 \u50724 \u49900 \u51012  \u54408 \u45716  \u44163 \u48372 \u45796  \u44368 \u54924 \u44032  \u54616 \u45208 \u45784 \u44760 \u47196 \u48512 \u53552  \u45908 \u50865 \u45908  \u47680 \u47532  \u46496 \u45212  \u49324 \u49892 \u51012  \u51613 \u47749 \u54616 \u45716  \u44163 \u51008  \u50630 \u51012  \u44163 \u51060 \u45796 .\
\uc0\u51116 \u47548 \u51032  \u44368 \u47532 \u47484  \u48155 \u50500 \u46308 \u51064  \u49324 \u46988 \u46308 \u51008  \u44536 \u46308 \u51060  \u47560 \u46405 \u55176  \u54616 \u45208 \u45784  \u50526 \u50640  \u54924 \u44060 \u54616 \u44256  \u44216 \u48708 \u54616 \u50668 \u50556  \u54624  \u44163 \u51012  \u51088 \u44033 \u54616 \u50688 \u45796 . \u44536 \u46308  \u51473 \u51032  \u47566 \u51008  \u49324 \u46988 \u51008  \u50724 \u47019 \u46041 \u50504  \u49464 \u49345 \u44284  \u44536 \u47532 \u49828 \u46020  \u49324 \u51060 \u50640 \u49436  \u47672 \u47943 \u44144 \u47532 \u44256  \u51080 \u50632 \u51004 \u45208  \u51060 \u51228 \u45716  \u44536 \u46308 \u51032  \u51077 \u51109 \u51012  \u48516 \u47749 \u55176  \u54364 \u47749 \u54644 \u50556  \u54624  \u49884 \u44592 \u44032  \u46108  \u44163 \u51012  \u45712 \u44808 \u45796 . \'93\u50689 \u50896 \u54620  \u44163 \u51060  \u44536 \u46308 \u50640 \u44172 \u45716  \u51204 \u50640  \u50630 \u51060  \u51652 \u49892 \u54620  \u44163 \u51060  \u46104 \u50632 \u45796 . \u54616 \u45720 \u51008  \u44032 \u44620 \u50892 \u51276 \u44256 , \u44536 \u46308 \u51008  \u54616 \u45208 \u45784  \u50526 \u50640 \u49436  \u51396 \u47484  \u51088 \u44033 \u54616 \u50688 \u45796 \'94 (S.Bliss, Memoirs of Wm.Miller p.146). \u44536 \u47532 \u49828 \u46020 \u51064 \u46308 \u51008  \u49352 \u47196 \u50868  \u50689 \u51201  \u49373 \u47749 \u51060  \u50557 \u46041 \u54632 \u51012  \u52404 \u54744 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u49884 \u44036 \u51060  \u47588 \u50864  \u51687 \u45796 \u45716  \u44163 \u51012  \u44648 \u45804 \u50520 \u51004 \u47728 , \u44536 \u46308 \u51032  \u46041 \u54252 \u50640  \u45824 \u54620  \u44536 \u46308 \u51032  \u51032 \u47924 \u47484  \u49549 \u55176  \u51060 \u54665 \u54616 \u50668 \u50556  \u54624  \u44163 \u51012  \u51208 \u49892 \u55176  \u45712 \u44808 \u45796 . \u44536 \u46308 \u50640 \u44172 \u45716  \u47560 \u52824  \u46405 \u51060  \u50630 \u50612 \u51648 \u44256  \u50689 \u50896 \u54620  \u49464 \u44228 \u44032  \u44536 \u46308 \u51032  \u45576 \u50526 \u50640  \u51204 \u44060 \u46108  \u44163 \u52376 \u47100  \u45712 \u44788 \u51276 \u45796 . \u44536 \u47532 \u54616 \u50668  \u50689 \u50896 \u54620  \u48373 \u46973 \u44284  \u48520 \u54665 \u51060  \u44032 \u47492 \u46104 \u45716  \u44396 \u50896  \u47928 \u51228 \u44032  \u47784 \u46304  \u44163 , \u44263  \u51060  \u49464 \u49345 \u51032  \u50612 \u46500  \u44163 \u48372 \u45796 \u46020  \u45908 \u50865  \u51473 \u50836 \u54620  \u44163 \u51076 \u51012  \u44648 \u45804 \u50520 \u45796 . \u54616 \u45208 \u45784 \u51032  \u49457 \u47161 \u44760 \u49436  \u44536 \u46308 \u50640 \u44172  \u51076 \u54644 \u49436  \u51396 \u51064 \u46308 \u50640 \u44172 \u49104 \u47564  \u50500 \u45768 \u46972  \u44536 \u46308 \u51032  \u54805 \u51228 \u46308 \u50640 \u44172 \u44620 \u51648 \u46020  \u54616 \u45208 \u45784 \u51032  \u45216 \u51012  \u50948 \u54616 \u50668  \u51456 \u48708 \u54616 \u46020 \u47197  \u50676 \u47148 \u55176  \u54840 \u49548 \u54624  \u55192 \u51012  \u50619 \u50632 \u45796 . \u44536 \u46308 \u51032  \u51068 \u49345  \u49373 \u50528 \u47484  \u53685 \u54616 \u50668  \u45208 \u53440 \u45240  \u47924 \u50616 \u51032  \u51613 \u44144 \u45716  \u54805 \u49885 \u51201 \u51060 \u50836  \u54732 \u49888 \u54616 \u51648  \u50500 \u45768 \u54620  \u49888 \u51088 \u46308 \u50640 \u44172  \u45130 \u51076 \u50630 \u45716  \u44204 \u52293 \u51060  \u46104 \u50632 \u45796 . \u44536 \u50752  \u44057 \u51008  \u51068 \u51060  \u44536 \u46308 \u51060  \u52628 \u44396 \u54616 \u44256  \u51080 \u45716  \u49464 \u49345 \u51032  \u53132 \u46973 \u44284  \u46024 \u51012  \u47784 \u51004 \u44592  \u50948 \u54620  \u44536 \u46308 \u51032  \u50676 \u49457 \u44284  \u49464 \u49549 \u51201  \u44277 \u47749 \u49900 \u51012  \u55124 \u46308 \u50612  \u45459 \u51648  \u50506 \u44592 \u47484  \u48148 \u46992 \u45796 . \u44536 \u47084 \u48064 \u47196  \u51116 \u47548 \u51012  \u48127 \u45716  \u49888 \u50521 \u44284  \u44536 \u44163 \u51012  \u51204 \u54616 \u45716  \u49324 \u46988 \u46308 \u51012  \u48152 \u45824 \u54616 \u45716  \u51201 \u51032  (\u25973 \u24847 ) \u50752  \u48152 \u44048 \u51012  \u45908 \u50865  \u44201 \u48156 \u49884 \u53040 \u45796 .\
