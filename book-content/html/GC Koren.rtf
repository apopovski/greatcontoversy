\f1\b0 \cf0 \
\uc0\u44536 \u45716  \u44618 \u51008  \u55141 \u48120 \u47484  \u44032 \u51648 \u44256  \u45796 \u45768 \u50648 \u49436 \u50752  \u50836 \u54620 \u44228 \u49884 \u47197 \u51012  \u50672 \u44396 \u54616 \u50688 \u45796 . \u44536 \u45716  \u44536  \u47568 \u50432 \u46308 \u46020  \u45796 \u47480  \u49457 \u44221  \u44396 \u51208 \u46308 \u51012  \u50672 \u44396 \u54616 \u45716  \u44163 \u44284  \u44057 \u51008  \u48169 \u48277 \u51004 \u47196  \u54616 \u50688 \u45716 \u45936 , \u44144 \u44592  \u45208 \u53440 \u45212  \u50668 \u47084  \u44032 \u51648  \u50696 \u50616 \u51201  \u49345 \u51669  (\u35937 \u24501 ) \u51012  \u51060 \u54644 \u54624  \u49688  \u51080 \u45796 \u45716  \u44163 \u51012  \u48156 \u44204 \u54664 \u51012  \u46412  \u44536 \u51032  \u44592 \u49256 \u51008  \u47568 \u47196  \u54364 \u54788 \u54624  \u49688  \u50630 \u50632 \u45796 . \u44536 \u45716  \u51060 \u48120  \u49457 \u52712 \u46108  \u50696 \u50616 \u46308 \u51060  \u49324 \u49892 \u49345  \u47928 \u51088  \u44536 \u45824 \u47196  \u49457 \u52712 \u46108  \u49324 \u49892 \u44284 , \u44536  \u50668 \u47084  \u44032 \u51648  \u54364 \u49345  (\u34920 \u35937 ), \u51008 \u50976  (\u38577 \u21929 ), \u48708 \u50976  (\u27604 \u21929 ), \u51649 \u50976  (\u30452 \u21929 ) \u46321 \u51008  \u47784 \u46160  \u44536  \u51204 \u54980 \u51032  \u49457 \u44221  \u44396 \u51208 \u46308 \u51060  \u44536 \u44163 \u46308 \u51012  \u49444 \u47749 \u54644 \u51452 \u44256  \u51080 \u45796 \u45716  \u44163 \u44284 , \u44144 \u44592  \u45208 \u53440 \u45212  \u50857 \u50612 \u46308 \u51008  \u45796 \u47480  \u49457 \u44221  \u44396 \u51208 \u47196  \u51221 \u51032  (\u23450 \u32681 ) \u47484  \u45236 \u47540  \u49688  \u51080 \u45796 \u45716  \u44163 \u51012  \u50508 \u50520 \u45796 . \u44536 \u47532 \u44256  \u44536 \u44032  \u44536 \u50752  \u44057 \u51008  \u48169 \u48277 \u51004 \u47196  \u54644 \u49437 \u54624  \u46412 , \u47928 \u51088  \u44536 \u45824 \u47196  \u51060 \u54644 \u54624  \u49688  \u51080 \u50632 \u45796 . \u44536 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u54664 \u45796 . \'93\u51060 \u47532 \u54616 \u50668  \u45208 \u45716  \u49457 \u44221 \u51060  \u54616 \u45208 \u45784 \u44760 \u47196 \u48512 \u53552  \u44228 \u49884 \u46108  \u51652 \u47532 \u51032  \u54620  \u53360  \u52404 \u44228 \u47196 \u50024  \u45572 \u44396 \u46304 \u51648 , \u48708 \u47197  \u50864 \u47588 \u54620  \u51088 \u46972 \u46020  \u44536 \u44163 \u51012  \u50724 \u54644 \u54624  \u54596 \u50836 \u44032  \u50630 \u46020 \u47197  \u45800 \u49692 \u54616 \u44256  \u47749 \u47308 \u54616 \u44172  \u44592 \u47197 \u46108  \u44163 \u50640  \u45824 \u54616 \u50668  \u47564 \u51313 \u54616 \u44172  \u46104 \u50632 \u45796 \'94 (S.Bliss, Memoirs of Wm.Miller, p.70). \u44536 \u44032  \u50696 \u50616 \u51032  \u53360  \u49324 \u49836 \u51012  \u54616 \u45208 \u54616 \u45208  \u54400 \u50612  \u44032 \u45716  \u46041 \u50504 \u50640  \u44536 \u51032  \u45432 \u47141 \u50640  \u46384 \u46972  \u51652 \u47532 \u51032  \u49324 \u49836 \u51060  \u54616 \u45208 \u50473  \u52264 \u47168 \u47196  \u54400 \u47140 \u51256 \u49436  \u44536 \u51032  \u45432 \u47141 \u51008  \u48372 \u49345 \u51012  \u48155 \u50520 \u45796 . \u52380 \u49324 \u46308 \u51008  \u44536 \u51032  \u47560 \u51020 \u51012  \u51648 \u46020 \u54616 \u50668  \u49457 \u44221  \u44396 \u51208 \u46308 \u51012  \u51060 \u54644 \u54624  \u49688  \u51080 \u46020 \u47197  \u50676 \u50612  \u51452 \u50632 \u45796 .\
\uc0\u44284 \u44144 \u50640  \u50668 \u47084  \u44032 \u51648  \u50696 \u50616 \u46308 \u51060  \u51221 \u54869 \u54616 \u44172  \u49457 \u52712 \u46108  \u48169 \u49885 \u46308 \u51012  \u54364 \u51456 \u51004 \u47196  \u54616 \u50668  \u50500 \u51649  \u51109 \u47000 \u50640  \u49549 \u54616 \u45716  \u47784 \u46304  \u50696 \u50616 \u51032  \u49457 \u52712 \u47484  \u54032 \u45800 \u54644  \u48380  \u46412  \u44536 \u47532 \u49828 \u46020 \u51032  \u50689 \u51201  \u53685 \u52824 \u50640  \u45824 \u54620  \u51068 \u48152 \u51201  \u44204 \u54644 , \u44263  \u49464 \u49345 \u51032  \u45149 \u51060  \u50724 \u44592  \u51204 \u50640  \u51080 \u51012  \u51060  \u49464 \u49345 \u50640 \u49436 \u51032  \u48373 \u52380 \u45380 \u51008  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u50640  \u51032 \u54616 \u50668  \u49373 \u44596  \u44368 \u47532 \u44032  \u50500 \u45784 \u51012  \u44536 \u45716  \u44648 \u45803 \u44256  \u45225 \u46301 \u54616 \u44172  \u46104 \u50632 \u45796 . \u51452 \u45784 \u44760 \u49436  \u51116 \u47548 \u54616 \u49884 \u44592  \u51204 \u50640  \u51032 \u50752  \u54217 \u54868 \u51032  1\u52380 \u45380 \u51060  \u51080 \u45796 \u44256  \u44032 \u47476 \u52824 \u45716  \u44368 \u47532 \u45716  \u54616 \u45208 \u45784 \u51032  \u45216 \u51032  \u46160 \u47140 \u50880 \u51012  \u47680 \u47532  \u48176 \u44201 \u54644  \u48260 \u47532 \u44172  \u46108 \u45796 . \u51060  \u44368 \u47532 \u45716  \u46307 \u45716  \u51088 \u46308 \u50640 \u44172  \u44592 \u49256 \u51012  \u51460 \u51648 \u45716  \u47792 \u46972 \u46020 , \u44536 \u44163 \u51008  \u50508 \u44257 \u44284  \u44032 \u46972 \u51648 \u47484  \u49464 \u49345  \u45149 \u51032  \u52628 \u49688  \u46412 \u44620 \u51648  \u54632 \u44760  \u51088 \u46972 \u44172  \u54620 \u45796 \u45716  \u44536 \u47532 \u49828 \u46020 \u50752  \u44536 \u48516 \u51032  \u49324 \u46020 \u46308 \u51032  \u44368 \u54984 \u44284 \u45716  \u48152 \u45824 \u46108 \u45796  (\u47560  13:30, 38~41 \u52280 \u51312 ). \u44263  \'93\u50501 \u54620  \u49324 \u46988 \u46308 \u44284  \u49549 \u51060 \u45716  \u51088 \u46308 \u51008  \u45908 \u50865  \u50501 \u54644 \u51256 \u49436 \'94 \'93\u47568 \u49464 \u50640  \u44256 \u53685 \u54616 \u45716  \u46412 \'94 (\u46372 \u54980  3:13, 1) \u44620 \u51648  \u51060 \u47476 \u44256 , \u50516 \u55121 \u51032  \u50773 \u44397 \u51008  \u50864 \u47532  \u51452 \u45784 \u44760 \u49436  \u51116 \u47548 \u54616 \u49892  \u46412 \u44620 \u51648  \u44228 \u49549 \u46104 \u44256 , \u47560 \u52840 \u45236  \u50864 \u47532  \u51452 \u45784 \u51032  \u51077  \u44592 \u50868 \u51004 \u47196  \u47784 \u46160  \u49324 \u47476 \u50612 \u51648 \u44256  \u44536 \u48516 \u51032  \u50724 \u49884 \u45716  \u50689 \u44305 \u51004 \u47196  \u47736 \u47581 \u45817 \u54616 \u47532 \u46972 \u45716  \u44536 \u47532 \u49828 \u46020 \u50752  \u44536 \u48516 \u51032  \u49324 \u46020 \u46308 \u51032  \u44032 \u47476 \u52840 \u44284 \u45716  \u48152 \u45824 \u46108 \u45796  (\u49332 \u54980  2:8 \u52280 \u51312 ).\
\uc0\u50728  \u49464 \u44228 \u44032  \u45796  \u54924 \u44060 \u54616 \u44256  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u50689 \u51201 \u51004 \u47196  \u53685 \u52824 \u54616 \u49888 \u45796 \u45716  \u44368 \u47532 \u45716  \u52488 \u45824  \u44368 \u54924 \u50640  \u51032 \u54616 \u50668  \u51452 \u51109 \u46108  \u44368 \u47532 \u44032  \u50500 \u45768 \u50632 \u45796 . \u44536  \u44368 \u47532 \u45716  18\u49464 \u44592  \u52488 \u50685 \u50640  \u51060 \u47476 \u47084  \u48708 \u47196 \u49548  \u44536 \u47532 \u49828 \u46020 \u51064 \u46308 \u51060  \u51068 \u48152 \u51201 \u51004 \u47196  \u48155 \u50500 \u46308 \u51060 \u44172  \u46104 \u50632 \u45796 . \u44536 \u44163 \u51008  \u47784 \u46304  \u45796 \u47480  \u50724 \u47448 \u50752  \u47560 \u52268 \u44032 \u51648 \u47196  \u44536  \u44208 \u44284 \u44032  \u47588 \u50864  \u50976 \u54644 \u54616 \u50688 \u45796 . \u44536 \u44163 \u51008  \u49324 \u46988 \u46308 \u50640 \u44172  \u51452 \u51032  \u51116 \u47548 \u51012  \u50500 \u51452  \u47676  \u51109 \u47000 \u50640  \u51080 \u51012  \u51068 \u47196  \u49373 \u44033 \u54616 \u44172  \u54644 \u51452 \u44256 , \u46608 \u54620  \u51116 \u47548 \u51060  \u44032 \u44620 \u50880 \u51012  \u50508 \u47140  \u51452 \u45716  \u51669 \u51312 \u46308 \u50640  \u50976 \u51032 \u54616 \u51648  \u50506 \u46020 \u47197  \u48169 \u54644 \u54616 \u50688 \u45796 . \u44536 \u44163 \u51008  \u44540 \u44144  \u50630 \u45716  \u51088 \u49888  (\u33258 \u20449 ) \u44284  \u50504 \u51204 \u44048 \u51012  \u44032 \u51648 \u44172  \u54644 \u51452 \u50632 \u44256 , \u47566 \u51008  \u49324 \u46988 \u46308 \u47196  \u54616 \u50668 \u44552  \u44536 \u46308 \u51032  \u51452 \u45784 \u51012  \u47564 \u45208 \u45716  \u45936  \u54596 \u50836 \u46104 \u45716  \u51456 \u48708 \u47484  \u46321 \u54620 \u55176  \u54616 \u44172  \u54616 \u50688 \u45796 .\
