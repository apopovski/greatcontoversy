\f1\b0 \cf0 \
\uc0\u44536 \u45716  \u51088 \u44592 \u44032  \u51652 \u47532 \u47484  \u48512 \u51064 \u54620  \u49324 \u49892 \u50640  \u51088 \u52293 \u44048 \u51012  \u45712 \u45180 \u47732 \u49436  \u44228 \u49549 \u54644 \u49436  \u47568 \u54616 \u50688 \u45796 . \'93\u52397 \u45380  \u49884 \u45824  \u51060 \u54980 \u47196  \u45236 \u44032  \u48276 \u54620  \u47784 \u46304  \u51396 \u50501  \u51473 \u50640 \u49436  \u45208 \u51032  \u47560 \u51020 \u51012  \u44032 \u51109  \u44340 \u47213 \u44172  \u54620  \u44163 \u51008  \u45236 \u44032  \u51060  \u55113 \u50501 \u54620  \u51109 \u49548 \u50640 \u49436  \u48276 \u54620  \u51396 \u51060 \u45796 . \u51060 \u44275 \u50640 \u49436  \u45208 \u45716  \u45208 \u51032  \u49828 \u49849 \u51060 \u50836  \u52828 \u44396 \u51064  \u44144 \u47337 \u54620  \u49692 \u44368 \u51088  \u50560  \u54980 \u49828 \u50752  \u50948 \u53364 \u47532 \u54532 \u50640  \u45824 \u54616 \u50668  \u45236 \u47536  \u44036 \u50501 \u54620  \u49440 \u44256 \u47484  \u49884 \u51064 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u45208 \u45716  \u52649 \u49900 \u51004 \u47196  \u44536  \u51068 \u51012  \u52280 \u54924 \u54620 \u45796 . \u45208 \u45716  \u48520 \u47749 \u50696 \u49828 \u47101 \u44172 \u46020  \u51453 \u51020 \u51012  \u46160 \u47140 \u50892 \u54616 \u50668  \u46160  \u49324 \u46988 \u51032  \u44368 \u47532 \u47484  \u48512 \u51064 \u54620  \u44163 \u51012  \u44256 \u48177 \u54620 \u45796 . \'85\u44536 \u47084 \u48064 \u47196  \u51204 \u45733 \u54616 \u49888  \u54616 \u45208 \u45784 \u44760 \u49436  \u45208 \u51032  \u50668 \u47084  \u44032 \u51648  \u51396 \u47484  \u50857 \u49436 \u54644  \u51452 \u49884 \u46104 , \u44032 \u51613 \u54620  \u51060  \u51396 \u47484  \u49324 \u54644  \u51452 \u49884 \u44592 \u47484  \u44036 \u50896 \u54616 \u45716  \u48148 \u51060 \u45796 .\'94 \u44536 \u47532 \u44256  \u44536 \u45716  \u51116 \u54032 \u44288 \u46308 \u51012  \u44032 \u47532 \u53412 \u47732 \u49436  \u50628 \u49689 \u54616 \u44172  \u47568 \u54616 \u50688 \u45796 . \'93\u45320 \u55148 \u46308 \u51008  \u50948 \u53364 \u47532 \u54532 \u50752  \u50560  \u54980 \u49828 \u50640 \u44172  \u51221 \u51396 \u51032  \u49440 \u44256 \u47484  \u45236 \u47160 \u45716 \u45936 , \u44536 \u46308 \u51060  \u44368 \u54924 \u51032  \u44368 \u47532 \u47484  \u52840 \u54644 \u54620  \u50672 \u44256 \u50640 \u49436 \u44032  \u50500 \u45768 \u44256 , \u44536 \u46308 \u51060  \u49457 \u51649 \u51088 \u46308 \u51032  \u48708 \u54665 \u44284  \u52628 \u47928 , \u44263  \u44536 \u46308 \u51032  \u54728 \u49885 \u44284  \u44368 \u47564 , \u51452 \u44368 \u50752  \u49888 \u48512 \u46308 \u51032  \u50728 \u44054  \u51396 \u50501 \u46308 \u51012  \u51201 \u48156 \u54616 \u50668  \u44277 \u44201 \u54616 \u50688 \u44592  \u46412 \u47928 \u51060 \u50632 \u45796 . \u50948 \u53364 \u47532 \u54532 \u50752  \u54980 \u49828 \u44032  \u47568 \u54620  \u48152 \u48149 \u54624  \u49688  \u50630 \u45716  \u49324 \u49892 \u50640  \u45824 \u54616 \u50668  \u45208  \u50669 \u49884  \u45320 \u55148 \u46308 \u51012  \u44508 \u53444 \u54616 \u45716  \u48148 \u51060 \u45796 .\'94\
\uc0\u44536 \u51032  \u47568 \u51008  \u51200 \u51648 \u46104 \u50632 \u45796 . \u51452 \u44368 \u46308 \u51008  \u44201 \u48516 \u54616 \u50668  \u46504 \u47732 \u49436  \'93\u51060  \u51060 \u49345  \u47924 \u49832  \u51613 \u44144 \u44032  \u45908  \u54596 \u50836 \u54620 \u44032 ? \u50864 \u47532 \u45716  \u50864 \u47532 \u51032  \u45576 \u51004 \u47196  \u44032 \u51109  \u50756 \u44256 \u54620  \u51060 \u45800 \u51088 \u47484  \u51649 \u51217  \u47785 \u44201 \u54616 \u44256  \u51080 \u45796 \'94\u44256  \u48512 \u47476 \u51670 \u50632 \u45796 .\
\uc0\u51228 \u47212 \u51008  \u49548 \u46976 \u54620  \u51473 \u50640 \u49436 \u46020  \u54869 \u44256 \u54620  \u53468 \u46020 \u47196  \u47568 \u54616 \u50688 \u45796 . \'93\u45320 \u55148 \u46308 \u51008  \u45236 \u44032  \u51453 \u51020 \u51012  \u46160 \u47140 \u50892 \u54624  \u51460 \u47196  \u49373 \u44033 \u54616 \u45712 \u45264 ? \u45320 \u55148 \u46308 \u51008  \u44284 \u44144  1\u45380  \u46041 \u50504  \u51453 \u51020 \u48372 \u45796  \u45908 \u50865  \u52280 \u54841 \u54616 \u44256  \u47924 \u49436 \u50868  \u44048 \u50725  \u49549 \u50640  \u45208 \u47484  \u44032 \u46160 \u50632 \u45796 . \u45320 \u55148 \u46308 \u51008  \u45208 \u47484  \u53552 \u53412  \u49324 \u46988 \u46308 \u44284  \u50976 \u45824 \u51064 \u46308 \u44284  \u51060 \u44368 \u46020 \u46308 \u48372 \u45796  \u45908 \u50865  \u51092 \u54841 \u54616 \u44172  \u52712 \u44553 \u54616 \u50688 \u51004 \u48064 \u47196  \u45208 \u51032  \u49332 \u51060  \u49324 \u49892 \u49345  \u50025 \u50612 \u49436  \u45208 \u51032  \u48904 \u50640 \u49436  \u46504 \u50612 \u51256  \u45208 \u44052 \u45796 . \u44536 \u47084 \u45208  \u45208 \u45716  \u48520 \u54217 \u54616 \u51648  \u50506 \u45716 \u45796 . \u50780 \u45264 \u54616 \u47732  \u53444 \u49885 \u51008  \u47560 \u51020 \u44284  \u51221 \u49888 \u51012  \u48337 \u50557 \u54616 \u44172  \u54644 \u51452 \u44592  \u46412 \u47928 \u51060 \u45796 . \u44536 \u47084 \u45208  \u45208 \u45716  \u54620  \u44536 \u47532 \u49828 \u46020 \u51064 \u50640  \u45824 \u54616 \u50668  \u44536 \u52376 \u47100  \u49900 \u54620  \u47564 \u54665  (\u34875 \u34892 ) \u51012  \u44048 \u54665 \u54616 \u45716  \u45936  \u45440 \u46972 \u50880 \u51012  \u44552 \u54616 \u51648  \u50506 \u51012  \u49688  \u50630 \u45796 \'94 (Bonnechose, vol.2, p.151~153).\
\uc0\u45796 \u49884  \u49548 \u46041 \u51060  \u51068 \u50612 \u45228 \u51004 \u48064 \u47196  \u51228 \u47212 \u51008  \u44553 \u55176  \u44048 \u50725 \u51004 \u47196  \u51060 \u49569 \u46104 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44536  \u46412 \u50640  \u47784 \u50688 \u45912  \u49324 \u46988 \u46308  \u51473 \u50640 \u45716  \u44536 \u51032  \u47568 \u51012  \u46307 \u44256  \u44618 \u51008  \u44048 \u46041 \u51012  \u48155 \u44256 , \u44536 \u51032  \u49373 \u47749 \u51012  \u44396 \u50896 \u54616 \u47140 \u45716  \u49324 \u46988 \u46308 \u51060  \u47751  \u47749  \u51080 \u50632 \u45796 . \u51228 \u47212 \u51008  \u44368 \u54924 \u51032  \u44428 \u47141 \u51088 \u46308 \u51032  \u48169 \u47928 \u51012  \u48155 \u44256 , \u45824 \u54924 \u51032 \u51032  \u44208 \u51221 \u50640  \u48373 \u51333 \u54616 \u46972 \u45716  \u44428 \u44256 \u47484  \u48155 \u50520 \u45796 . \u47196 \u47560 \u44368 \u50640  \u45824 \u54620  \u48152 \u45824 \u47484  \u52712 \u49548 \u54620 \u45796 \u47732 , \u44536  \u48372 \u49345 \u51004 \u47196  \u44536 \u51032  \u50526 \u50640  \u44032 \u51109  \u48157 \u51008  \u51204 \u47581 \u51060  \u51228 \u49884 \u46104 \u50632 \u45796 . \u44536 \u47084 \u45208  \u49464 \u49345 \u51032  \u50689 \u54868 \u44032  \u51452 \u50612 \u51648 \u51088  \u51228 \u47212 \u51008  \u44536 \u51032  \u51452 \u45784 \u52376 \u47100  \u44536 \u44163 \u51012  \u54869 \u44256 \u54616 \u44172  \u47932 \u47532 \u52452 \u45796 .\
\'93\uc0\u49457 \u44221 \u51004 \u47196  \u45208 \u51032  \u50724 \u47448 \u47484  \u51648 \u51201 \u54644  \u51456 \u45796 \u47732 , \u45208 \u45716  \u44536 \u44163 \u51012  \u44144 \u47532 \u45196  \u50630 \u51060  \u48260 \u47532 \u44192 \u45796 \'94\u44256  \u44536 \u45716  \u45800 \u50616 \u54616 \u50688 \u45796 . \'93\u49457 \u44221 \u51060 \u46972 \u44256 ? \u44536 \u47111 \u45796 \u47732  \u47564 \u49324 \u47484  \u45796  \u44536 \u44163 \u51004 \u47196 \u47564  \u54032 \u45800 \u54644 \u50556  \u46108 \u45800  \u47568 \u51060 \u45264 ? \u44368 \u54924 \u44032  \u49457 \u44221 \u51012  \u54644 \u49437 \u54616 \u51648  \u50500 \u45768 \u54616 \u47732  \u45572 \u44032  \u44536 \u44163 \u51012  \u51060 \u54644 \u54624  \u49688  \u51080 \u44192 \u45716 \u44032 ?\'94\u44256  \u44536 \u47484  \u50976 \u54841 \u54616 \u45716  \u51088 \u46308  \u51473 \u51032  \u54620  \u49324 \u46988 \u51008  \u48512 \u47476 \u51670 \u50632 \u45796 . \u51060 \u50640  \u45824 \u54616 \u50668  \u51228 \u47212 \u51008  \u45824 \u45813 \u54616 \u50688 \u45796 . \'93\u50864 \u47532  \u44396 \u51452 \u51032  \u48373 \u51020 \u48372 \u45796 \u46020  \u49324 \u46988 \u51032  \u50976 \u51204 \u51060  \u49888 \u50521 \u49345 \u51004 \u47196  \u45908  \u44032 \u52824 \u44032  \u51080 \u45796 \u44256  \u54624  \u49688  \u51080 \u45712 \u45264 ? \u48148 \u50872 \u51008  \u51088 \u44592 \u51032  \u54200 \u51648 \u47484  \u48155 \u51012  \u49324 \u46988 \u46308 \u50640 \u44172  \u49324 \u46988 \u51032  \u50976 \u51204 \u51012  \u46308 \u51004 \u46972 \u44256  \u44428 \u54616 \u51648  \u50506 \u44256 , \u46020 \u47532 \u50612  \'91\u49457 \u44221 \u51012  \u49345 \u44256 \u54616 \u46972 \'92\u44256  \u47568 \u54616 \u50688 \u45796 .\'94\
\'93\uc0\u51060 \u45800 \u51060 \u45796 \'94\u46972 \u45716  \u48512 \u47476 \u51670 \u51020 \u51060  \u51068 \u50612 \u45228 \u45796 . \'93\u51648 \u44552 \u44620 \u51648  \u45320 \u47484  \u50948 \u54616 \u50668  \u44536 \u52376 \u47100  \u50724 \u47019 \u46041 \u50504  \u50528 \u50896 \u54620  \u44163 \u51012  \u45208 \u45716  \u54980 \u54924 \u54620 \u45796 . \u45348 \u44032  \u50501 \u47560 \u51032  \u52649 \u46041 \u51012  \u48155 \u44256  \u51080 \u45796 \u45716  \u44163 \u51012  \u45208 \u45716  \u50508 \u50520 \u45796 \'94 (Wylie, b.3, ch.10).\
\uc0\u46300 \u46356 \u50612  \u44536 \u45716  \u51221 \u51396 \u51032  \u49440 \u44256 \u47484  \u48155 \u50520 \u45796 . \u44536 \u45716  \u54980 \u49828 \u44032  \u51453 \u51076 \u51012  \u45817 \u54620  \u48148 \u47196  \u44536  \u51109 \u49548 \u47196  \u45132 \u47140  \u45208 \u44052 \u45796 . \u44536 \u45716  \u45432 \u47000 \u47484  \u48512 \u47476 \u47732 \u49436  \u45208 \u44052 \u45716 \u45936 , \u44536 \u51032  \u50620 \u44404 \u51008  \u54217 \u54868 \u50752  \u44592 \u49256 \u51004 \u47196  \u48731 \u45208 \u44256  \u51080 \u50632 \u45796 . \u44536 \u45716  \u44536 \u47532 \u49828 \u46020 \u47484  \u51452 \u47785 \u54616 \u44256  \u51080 \u50632 \u51004 \u48064 \u47196  \u44536 \u50640 \u44172 \u45716  \u51453 \u51020 \u51032  \u46160 \u47140 \u50880 \u51060  \u50630 \u50632 \u45796 . \u49324 \u54805  \u51665 \u54665 \u51088 \u44032  \u48520 \u51012  \u48537 \u51060 \u47140 \u44256  \u44536 \u51032  \u46244 \u47196  \u46028 \u50500 \u44032 \u51088 , \u44536  \u49692 \u44368 \u51088 \u45716  \'93\u44732 \u47540  \u44163  \u50630 \u51060  \u50526 \u51004 \u47196  \u45208 \u50752 \u49436  \u45208 \u51032  \u45576 \u50526 \u50640 \u49436  \u48520 \u51012  \u48537 \u50668 \u46972 . \u45236 \u44032  \u46160 \u47140 \u50892 \u54664 \u45796 \u47732  \u50668 \u44592 \u50640  \u50724 \u51648  \u50506 \u50520 \u51012  \u44163 \u51060 \u45796 \'94\u46972 \u44256  \u48512 \u47476 \u51670 \u50632 \u45796 .\
\uc0\u54868 \u50684 \u51060  \u44536 \u47484  \u46168 \u47084 \u49912 \u51088  \u44536 \u45716  \u52572 \u54980 \u51032  \u44592 \u46020 \u47484  \u46300 \u47160 \u45796 . \'93\u51452 \u50668 , \u51204 \u45733 \u54616 \u49888  \u50500 \u48260 \u51648 \u50668 , \u45208 \u47484  \u48520 \u49933 \u55176  \u50668 \u44592 \u49324  \u45236  \u51396 \u47484  \u49324 \u54616 \u50668  \u51452 \u50741 \u49548 \u49436 . \u45236 \u44032  \u50616 \u51228 \u45208  \u45817 \u49888 \u51032  \u51652 \u47532 \u47484  \u49324 \u46993 \u54616 \u45716  \u51460 \u51012  \u45817 \u49888 \u51060  \u50500 \u49884 \u45208 \u51060 \u45796 \'94 (Bon-nechose, vol.2, p.168) \u44256  \u44536 \u45716  \u50808 \u52452 \u45796 . \u47560 \u52840 \u45236  \u44536 \u51032  \u49548 \u47532 \u45716  \u44536 \u52452 \u51004 \u45208  \u44592 \u46020 \u54616 \u45716  \u44536 \u51032  \u51077 \u49696 \u51008  \u44536 \u52824 \u51648  \u50506 \u44256  \u50880 \u51649 \u51060 \u44256  \u51080 \u50632 \u45796 . \u48520 \u44600 \u51060  \u44536 \u52824 \u51088  \u44536  \u49692 \u44368 \u51088 \u51032  \u51116 \u45716  \u44144 \u44592 \u50640  \u45224 \u50500  \u51080 \u45716  \u55129 \u44284  \u54632 \u44760  \u54980 \u49828 \u51032  \u51116 \u52376 \u47100  \u46972 \u51064  \u44053 \u50640  \u45912 \u51256 \u51276 \u45796 .\
\uc0\u51060 \u50752  \u44057 \u51060  \u54616 \u45208 \u45784 \u51032  \u52649 \u49457 \u46108  \u51613 \u51064 \u46308 \u51008  \u51453 \u51076 \u51012  \u45817 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u46308 \u51060  \u51204 \u54028 \u54620  \u51652 \u47532 \u51032  \u48731 , \u44536 \u46308 \u51032  \u50689 \u50885 \u51201 \u51064  \u47784 \u48376 \u51004 \u47196  \u45224 \u44596  \u44305 \u52292 \u45716  \u49548 \u47736 \u46112  \u49688  \u50630 \u50632 \u45796 . \u48148 \u50556 \u55120 \u47196  \u49464 \u49345 \u50640  \u45796 \u44032 \u50724 \u44256  \u51080 \u45716  \u50668 \u47749  (\u40654 \u26126 ) \u51012  \u47561 \u51004 \u47140 \u45716  \u44163 \u51008  \u47560 \u52824  \u49324 \u46988 \u51060  \u53468 \u50577 \u51012  \u46028 \u50500 \u44032 \u45716  \u44452 \u46020 \u50640 \u49436  \u50669 \u51204  (\u36870 \u36681 ) \u49884 \u53412 \u47140 \u45716  \u44163 \u44284  \u47560 \u52268 \u44032 \u51648 \u47196  \u47924 \u47784 \u54620  \u44163 \u51060 \u50632 \u45796 .\
\pard\pardeftab720\sa319\partightenfactor0

\f0\b \cf0 \uc0\u51648 \u49828 \u52852  \u51109 \u44400 \u51032  \u48516 \u44592  (\u22894 \u36215 )\
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u54980 \u49828 \u51032  \u52376 \u54805  (\u34389 \u21009 ) \u51008  \u48372 \u54756 \u48120 \u50500 \u50640  \u48516 \u45432 \u50752  \u44277 \u54252 \u51032  \u48520 \u44600 \u51012  \u51068 \u51004 \u53040 \u45796 . \u50728  \u44397 \u48124 \u46308 \u51008  \u54980 \u49828 \u44032  \u49849 \u47140 \u46308 \u51032  \u51201 \u51032  (\u25973 \u24847 ) \u50752  \u54889 \u51228 \u51032  \u48176 \u49888 \u51004 \u47196  \u55148 \u49373 \u46104 \u50632 \u45796 \u45716  \u44163 \u51012  \u50508 \u44172  \u46104 \u50632 \u45796 . \u44536 \u45716  \u52649 \u49457 \u46108  \u51652 \u47532 \u51032  \u44368 \u49324 \u50688 \u51020 \u51060  \u49324 \u46988 \u46308 \u50640 \u44172  \u50508 \u47140 \u51276 \u51004 \u47728  \u44536 \u50640 \u44172  \u49324 \u54805  \u50616 \u46020 \u47484  \u45236 \u47536  \u45824 \u54924 \u51032 \u45716  \u49332 \u51064 \u51396 \u47484  \u48276 \u54616 \u50688 \u45796 \u45716  \u48708 \u45212 \u51012  \u48155 \u50520 \u45796 . \u44536 \u51032  \u44368 \u47532 \u45716  \u50612 \u45712  \u46412 \u48372 \u45796  \u45908 \u50865  \u53360  \u44288 \u49900 \u51012  \u45132 \u50632 \u45796 . \u48277 \u50773 \u51008  \u50948 \u53364 \u47532 \u54532 \u51032  \u51200 \u49436 \u46308 \u51012  \u51221 \u51396 \u54616 \u44256  \u48520 \u53468 \u50892  \u48260 \u47532 \u46972 \u45716  \u51312 \u49436 \u47484  \u45236 \u47160 \u50632 \u45796 . \u44536 \u47084 \u45208  \u51060 \u51228  \u49324 \u46988 \u46308 \u51008  \u44536  \u51200 \u49436 \u46308  \u51473 \u50640 \u49436  \u49548 \u47736 \u46104 \u51648  \u50506 \u44256  \u45224 \u50500  \u51080 \u45716  \u44163 \u46308 \u51012  \u44536 \u44163 \u46308 \u51060  \u49704 \u44200 \u51256  \u51080 \u45912  \u44275 \u50640 \u49436  \u44032 \u51256 \u50752  \u49457 \u44221 \u51204 \u49436 \u45208  \u54841 \u51008  \u49324 \u46988 \u51060  \u44396 \u54624  \u49688  \u51080 \u45716  \u49457 \u44221  \u51473 \u51032  \u50612 \u46500  \u51068 \u48512 \u48516 \u44284  \u45824 \u51312 \u54616 \u50668  \u50672 \u44396 \u54616 \u50688 \u51004 \u47728 , \u44536  \u44208 \u44284 \u47196  \u47566 \u51008  \u49324 \u46988 \u46308 \u51060  \u44060 \u54785 \u51088 \u46308 \u51032  \u49888 \u50521 \u51012  \u48155 \u50500 \u46308 \u51060 \u44172  \u46104 \u50632 \u45796 .\
\uc0\u54980 \u49828 \u47484  \u51453 \u51064  \u51088 \u46308 \u51008  \u44536 \u51032  \u50868 \u46041 \u51060  \u49849 \u47532 \u54616 \u45716  \u44163 \u51012  \u51312 \u50857 \u55176  \u48372 \u44256 \u47564  \u51080 \u51648  \u50506 \u50520 \u45796 . \u48277 \u50773 \u44284  \u54889 \u51228 \u44032  \u50672 \u54633 \u54616 \u50668  \u51060  \u50868 \u46041 \u51012  \u51652 \u50517 \u54616 \u47140  \u54616 \u50688 \u51004 \u47728 , \u49884 \u44592 \u49828 \u47928 \u53944 \u51032  \u44400 \u45824 \u45716  \u48372 \u54756 \u48120 \u50500 \u47484  \u54693 \u54616 \u50668  \u47792 \u47140 \u50772 \u45796 .\
\uc0\u44536 \u47088 \u45936  \u51060 \u46412 \u50640  \u54620  \u44396 \u50896 \u51088 \u44032  \u45208 \u53440 \u45228 \u45796 . \u44536 \u45716  \u44060 \u51204  \u51649 \u54980 \u50640  \u46160  \u45576 \u51012  \u45796  \u51075 \u50612 \u48260 \u47536  \u51648 \u49828 \u52852  (Ziska) \u47196 \u49436  \u45817 \u49884 \u50640  \u44032 \u51109  \u54988 \u47469 \u54620  \u51109 \u44400  \u51473 \u51032  \u54620  \u49324 \u46988 \u51004 \u47196 \u49436  \u48372 \u54756 \u48120 \u50500 \u44400 \u51032  \u51648 \u55064 \u44288 \u51060 \u50632 \u45796 . \u54616 \u45208 \u45784 \u51032  \u46020 \u50864 \u49900 \u44284  \u44536 \u46308 \u51032  \u49324 \u50629 \u51032  \u51221 \u45817 \u49457 \u51012  \u49888 \u47280 \u54616 \u47732 \u49436  \u49324 \u46988 \u46308 \u51008  \u52840 \u44277 \u54644  \u50724 \u45716  \u44032 \u51109  \u44053 \u47141 \u54620  \u44400 \u45824 \u50752  \u47582 \u49436  \u49912 \u50912 \u45796 . \u54889 \u51228 \u45716  \u50668 \u47084  \u48264  \u44144 \u46317 \u54616 \u50668  \u49352 \u47196 \u50868  \u44400 \u45824 \u47484  \u48372 \u45236 \u50612  \u48372 \u54756 \u48120 \u50500 \u47484  \u44277 \u44201 \u54616 \u50688 \u51004 \u45208  \u44404 \u50837 \u51201 \u51060 \u44172 \u46020  \u44201 \u53748 \u47484  \u45817 \u54624  \u49104 \u51060 \u50632 \u45796 . \u54980 \u49828 \u51032  \u49888 \u48393 \u51088 \u46308 \u51008  \u51453 \u51020 \u51032  \u46160 \u47140 \u50880 \u51012  \u52488 \u50900 \u54620  \u49324 \u46988 \u46308 \u51060 \u50632 \u51004 \u48064 \u47196  \u50500 \u47924 \u46020  \u44536 \u46308 \u51012  \u45824 \u51201 \u54624  \u49688  \u50630 \u50632 \u45796 . \u44060 \u51204  \u54980  \u48520 \u44284  \u49688 \u45380  \u47564 \u50640  \u44536  \u50857 \u44048 \u54620  \u51109 \u44400  \u51648 \u49828 \u52852 \u45716  \u51453 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44536 \u50752  \u47560 \u52268 \u44032 \u51648 \u47196  \u50857 \u44048 \u54620 , \u50500 \u45768  \u50612 \u46500  \u51216 \u51004 \u47196 \u45716  \u44536 \u48372 \u45796 \u46020  \u45908 \u50865  \u54988 \u47469 \u54620  \u51109 \u44400 \u51064  \u54532 \u47196 \u53076 \u54588 \u50864 \u49828  (Procopius) \u44032  \u44536 \u51032  \u51088 \u47532 \u47484  \u45824 \u49888 \u54616 \u50688 \u45796 .\
\uc0\u48372 \u54756 \u48120 \u50500 \u51064 \u51032  \u50896 \u49688 \u46308 \u51008  \u44536  \u45576 \u47676  \u50857 \u49324 \u51032  \u51453 \u51020 \u51012  \u50508 \u44172  \u46104 \u51088 , \u44536 \u46308 \u51060  \u51075 \u50632 \u45912  \u47784 \u46304  \u44163 \u51012  \u54924 \u48373 \u54624  \u49688  \u51080 \u45716  \u51339 \u51008  \u44592 \u54924 \u44032  \u50728  \u51460 \u47196  \u48127 \u50632 \u45796 . \u48277 \u50773 \u51008  \u54980 \u49828 \u51032  \u49888 \u48393 \u51088 \u46308 \u51012  \u44277 \u44201 \u54616 \u44592  \u50948 \u54616 \u50668  \u49901 \u51088 \u44400 \u51012  \u48372 \u45244  \u44163 \u51012  \u54252 \u44256 \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u45796 \u49884  \u44553 \u55176  \u47566 \u51008  \u44400 \u45824 \u47484  \u48372 \u54756 \u48120 \u50500 \u47196  \u53804 \u51077 \u49884 \u53040 \u51004 \u45208  \u44208 \u44397 \u51008  \u50628 \u52397 \u45212  \u54056 \u48176 \u47484  \u45817 \u54624  \u49104 \u51060 \u50632 \u45796 . \u46608 \u45796 \u49884  \u49901 \u51088 \u44400 \u51032  \u54028 \u44204 \u51060  \u49440 \u54252 \u46104 \u50632 \u45796 . \u50976 \u47101 \u50640 \u49436  \u48277 \u50773 \u51012  \u51648 \u51648 \u54616 \u45716  \u47784 \u46304  \u45208 \u46972 \u46308 \u47196 \u48512 \u53552  \u51204 \u51137 \u51012  \u50948 \u54616 \u50668  \u49324 \u46988 \u44284  \u51088 \u44552 \u44284  \u44400 \u49688 \u54408 \u46308 \u51012  \u47784 \u50520 \u45796 . \u54728 \u45796 \u54620  \u47924 \u47532 \u46308 \u51060  \u48277 \u50773 \u51032  \u44611 \u48156  \u50500 \u47000  \u47784 \u50668 \u49436  \u47560 \u52840 \u45236  \u54980 \u49828 \u51032  \u49888 \u48393 \u51088 \u46308 \u51064  \u51060 \u45800 \u51012  \u47736 \u51208 \u49884 \u53412 \u44192 \u45432 \u46972 \u44256  \u50557 \u49549 \u54616 \u50688 \u45796 . \u54596 \u49849 \u51032  \u49888 \u45392 \u51004 \u47196  \u47566 \u51008  \u44400 \u49324 \u46308 \u51060  \u48372 \u54756 \u48120 \u50500 \u47196  \u52432 \u46308 \u50612 \u44052 \u45796 . \u48372 \u54756 \u48120 \u50500 \u51032  \u48177 \u49457 \u46308 \u46020  \u44536 \u46308 \u51012  \u44201 \u53748 \u49884 \u53412 \u44592  \u50948 \u54616 \u50668  \u51665 \u44208 \u54616 \u50688 \u45796 . \u46160  \u44400 \u45824 \u44032  \u44053 \u51012  \u49324 \u51060 \u50640  \u46160 \u44256  \u45824 \u52824  (\u23565 \u23769 ) \u54616 \u50688 \u45796 . \'93\u49901 \u51088 \u44400 \u51008  \u50900 \u46321 \u54616 \u44172  \u50864 \u49464 \u54620  \u44400 \u45824 \u50688 \u51004 \u47728 , \u54980 \u49828 \u51032  \u49888 \u48393 \u51088 \u46308 \u51012  \u53664 \u48268 \u54616 \u44592  \u50948 \u54616 \u50668  \u52280 \u51004 \u47196  \u47676  \u44144 \u47532 \u50640 \u49436 \u48512 \u53552  \u50772 \u44592 \u50640  \u44536  \u49884 \u45236 \u47484  \u44148 \u45320 \u49436  \u44553 \u55176  \u46028 \u51652 \u54616 \u44144 \u45208 , \u44536 \u46308 \u44284  \u51217 \u51204 \u54616 \u44592 \u48372 \u45796 \u45716  \u51312 \u50857 \u55176  \u49436 \u49436  \u49345 \u45824 \u48169 \u51032  \u51204 \u49324 \u46308 \u51012  \u51452 \u47785 \u54616 \u50668  \u48148 \u46972 \u48372 \u44592 \u47564  \u54616 \u50688 \u45796 \'94 (Wylie, b.3, ch.17). \u44536  \u46412 \u50640  \u44536 \u46308 \u51008  \u44049 \u51088 \u44592  \u44592 \u51060 \u54620  \u44277 \u54252 \u44048 \u51012  \u45712 \u45180 \u44172  \u46104 \u50632 \u45796 . \u44536 \u46308 \u51008  \u47560 \u52824  \u48372 \u51060 \u51648  \u50506 \u45716  \u50612 \u46500  \u49464 \u47141 \u50640  \u51032 \u54616 \u50668  \u51923 \u44200  \u44032 \u46319 \u51060  \u54620  \u48264  \u44277 \u44201 \u54644  \u48372 \u51648 \u46020  \u47803 \u54616 \u44256 , \u44536  \u45824 \u44400 \u51008  \u44648 \u50612 \u51648 \u44256  \u55145 \u50612 \u51276 \u45796 . \u47924 \u49688 \u54620  \u44400 \u49324 \u46308 \u51060  \u46020 \u47581 \u54616 \u45796 \u44032  \u44536 \u46308 \u51012  \u51923 \u50500 \u44036  \u48372 \u54756 \u48120 \u50500 \u44400 \u50640 \u44172  \u49332 \u50977 \u51012  \u45817 \u54616 \u44256 , \u47561 \u45824 \u54620  \u51204 \u47532 \u54408 \u51060  \u49849 \u47532 \u51088 \u46308 \u51032  \u49552 \u50640  \u46028 \u50500 \u44052 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536  \u51204 \u51137 \u51008  \u48372 \u54756 \u48120 \u50500  \u49324 \u46988 \u46308 \u51012  \u44260 \u44417 \u50640  \u48736 \u46888 \u47532 \u44592 \u45716 \u52964 \u45397  \u50724 \u55176 \u47140  \u48512 \u50836 \u54616 \u44172  \u54644 \u51452 \u50632 \u45796 .\
