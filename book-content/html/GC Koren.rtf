\f1\b0 \cf0 \
\uc0\u51060 \u46412 \u50640  \u44060 \u54785  \u49324 \u50629 \u51008  \u53360  \u50948 \u44592 \u47484  \u47582 \u51060 \u54616 \u50688 \u45796 . \u48277 \u50773 \u51008  \u51228 \u45348 \u48148 \u50640  \u45824 \u54616 \u50668  \u54028 \u47928 \u51032  \u49440 \u44256 \u47484  \u45236 \u47160 \u44256 , \u44053 \u44397 \u46308 \u51008  \u51228 \u45348 \u48148 \u47484  \u47736 \u47581 \u49884 \u53412 \u44192 \u45796 \u44256  \u50948 \u54801 \u54616 \u50688 \u45796 . \u55124 \u55176  \u50773 \u46308 \u44284  \u54889 \u51228 \u46308 \u44620 \u51648 \u46020  \u44053 \u51228 \u47196  \u44404 \u48373 \u49884 \u53412 \u45912  \u44536  \u44053 \u47141 \u54620  \u44368 \u51649  \u51221 \u52824 \u47484  \u51060  \u51089 \u51008  \u46020 \u49884 \u44032  \u50612 \u52236  \u45733 \u55176  \u45824 \u54637 \u54624  \u49688  \u51080 \u51004 \u47728 , \u44536 \u44163 \u51060  \u49464 \u49345 \u51012  \u51221 \u48373 \u54620  \u53360  \u44400 \u45824 \u46308 \u51012  \u50612 \u46523 \u44172  \u51200 \u54637 \u54624  \u49688  \u51080 \u51012 \u44620 ?\
\uc0\u47784 \u46304  \u44536 \u47532 \u49828 \u46020 \u44368 \u44397 \u50640 \u49436  \u44060 \u49888 \u44368 \u45716  \u55113 \u50501 \u54620  \u50896 \u49688 \u46308 \u50640 \u44172  \u50948 \u54801 \u51012  \u45817 \u54616 \u50688 \u45796 . \u44060 \u54785  \u49324 \u50629 \u51032  \u52572 \u52488 \u51032  \u49849 \u47532 \u45716  \u51648 \u45208 \u44052 \u45796 . \u47196 \u47560 \u44368 \u45716  \u44060 \u54785  \u49324 \u50629 \u51012  \u51652 \u47736 \u49884 \u53412 \u44592  \u50948 \u54616 \u50668  \u49352  \u49464 \u47141 \u46308 \u51012  \u44396 \u52629 \u54616 \u50688 \u45796 . \u51060 \u46412 \u50640  \u48277 \u50773 \u44368 \u51032  \u53804 \u49324 \u46308  \u44032 \u50868 \u45936  \u44032 \u51109  \u51092 \u51064 \u54616 \u44256 , \u47924 \u48277 \u54616 \u44256 , \u44053 \u47141 \u54620  \u51228 \u49688 \u51060 \u53944 \u45817 \u51060  \u51312 \u51649 \u46104 \u50632 \u45796 . \u44536 \u46308 \u51008  \u54792 \u50672 \u51201  \u44288 \u44228 \u50752  \u51064 \u44036 \u51201  \u49324 \u47532 \u46020  \u47924 \u49884 \u54616 \u44256 , \u51064 \u51221 \u51032  \u50836 \u44396 \u50752  \u51060 \u49457  (\u63972 \u24615 ) \u44284  \u50577 \u49900 \u50640 \u46020  \u47924 \u44048 \u44033 \u54616 \u50668  \u44536 \u44163 \u46308 \u51012  \u50756 \u51204 \u55176  \u48176 \u52377 \u54644  \u48260 \u47532 \u44256 , \u44508 \u50984 \u44284  \u50976 \u45824  \u44288 \u44228 \u46020  \u47924 \u49884 \u54616 \u44256 , \u50724 \u51649  \u51200 \u46308 \u51032  \u44508 \u52825 \u50640  \u51032 \u51648 \u54616 \u50668  \u51088 \u44592 \u46308 \u51032  \u49464 \u47141 \u51012  \u54869 \u51109 \u54616 \u45716  \u45936 \u47564  \u51652 \u47141 \u54616 \u50688 \u45796  (\u48512 \u47197  17 \u52280 \u51312 ). \u44536 \u47532 \u49828 \u46020 \u51032  \u48373 \u51020 \u51008 , \u44536 \u44163 \u51012  \u44256 \u49688 \u54616 \u45716  \u49324 \u46988 \u46308 \u47196  \u54616 \u50668 \u44552  \u50948 \u54744 \u51012  \u47924 \u47493 \u50416 \u44256  \u44256 \u45212 \u51012  \u52280 \u44172 \u54616 \u44256 , \u52628 \u50948 \u50752  \u51452 \u47548 \u44284  \u49688 \u44256 \u50752  \u48712 \u44260 \u46020  \u44161 \u45236 \u51648  \u50506 \u44172  \u54616 \u44256 , \u44256 \u47928 \u45824 \u50752  \u44048 \u50725 \u44284  \u54868 \u54805 \u51452  \u50526 \u50640 \u49436 \u46020  \u51652 \u47532 \u51032  \u44611 \u48156 \u51012  \u45458 \u51060  \u46308 \u44172  \u54616 \u50668  \u51452 \u50632 \u45796 . \u44536 \u47088 \u45936  \u51060  \u49464 \u47141 \u51012  \u45824 \u54637 \u54616 \u44592  \u50948 \u54616 \u50668  \u51228 \u49688 \u51060 \u53944 \u45817 \u51008  \u44536  \u52628 \u51333 \u51088 \u46308 \u50640 \u44172  \u44305 \u49888 \u51012  \u48520 \u47084 \u51068 \u51004 \u53020 \u49436  \u50728 \u44054  \u50948 \u54744 \u46308 \u51012  \u44204 \u46364  \u49688  \u51080 \u44172  \u54616 \u44256 , \u44033 \u51333  \u44592 \u47564 \u51032  \u47924 \u44592 \u46308 \u47196  \u51652 \u47532 \u51032  \u49464 \u47141 \u51012  \u48152 \u45824 \u54616 \u44172  \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u50500 \u47924 \u47532  \u53360  \u51396 \u46972 \u46020  \u48276 \u54624  \u49688  \u51080 \u50632 \u44256 , \u50500 \u47924 \u47532  \u51200 \u44553 \u54620  \u44144 \u51667 \u46020  \u54665 \u54624  \u49688  \u51080 \u50632 \u44256 , \u50612 \u46500  \u44032 \u51109  (\u20551 \u35037 ) \u46020  \u50612 \u47140 \u50880  \u50630 \u51060  \u44984 \u48128  \u49688  \u51080 \u50632 \u45796 . \u54637 \u44396 \u51201 \u51064  \u48712 \u44260 \u44284  \u44160 \u49548 \u54620  \u49373 \u54876 \u51012  \u47609 \u49464 \u54616 \u50688 \u51648 \u47564 , \u44536 \u46308 \u51032  \u47785 \u51201 \u51008  \u48512 \u50752  \u44428 \u47141 \u51012  \u50619 \u44256 , \u44060 \u49888 \u44368 \u47484  \u51204 \u48373 \u49884 \u53412 \u44256 , \u48277 \u50773 \u51032  \u52572 \u49345 \u44428 \u51012  \u51116 \u44592 \u49884 \u53412 \u45716  \u45936  \u51080 \u50632 \u45796 .\
\uc0\u44536 \u46308 \u51032  \u45800 \u52404 \u50640  \u49549 \u54620  \u45817 \u50896 \u51032  \u51077 \u51109 \u50640  \u49444  \u46412 \u50640 , \u44536 \u46308 \u51008  \u44144 \u47337 \u54620  \u51032 \u48373 \u51012  \u51077 \u50632 \u44256 , \u44536 \u46308 \u51008  \u44048 \u50725 \u44284  \u48337 \u50896 \u51012  \u48169 \u47928 \u54616 \u47732 \u49436  \u48337 \u51088 \u50752  \u48520 \u49933 \u54620  \u49324 \u46988 \u46308 \u50640 \u44172  \u48393 \u49324 \u54616 \u44256 , \u49464 \u49345 \u51012  \u48260 \u47160 \u45432 \u46972 \u44256  \u44277 \u50616 \u54616 \u50688 \u44256  \u46160 \u47336  \u45796 \u45768 \u47728  \u52265 \u54620  \u51068 \u51012  \u54665 \u54616 \u49888  \u50696 \u49688 \u45784 \u51032  \u44144 \u47337 \u54616 \u49888  \u51060 \u47492 \u51004 \u47196  \u44536 \u47088  \u51068 \u51012  \u54616 \u45432 \u46972 \u44256  \u47568 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u50808 \u47784 \u47196 \u45716  \u50500 \u47924 \u47088  \u55136 \u46020  \u50630 \u51060  \u48372 \u51060 \u45716  \u44536 \u46308 \u51060  \u46412 \u46412 \u47196  \u44032 \u51109  \u51396 \u50501 \u51201 \u51060 \u50836 , \u52824 \u47749 \u51201 \u51064  \u47785 \u51201 \u51012  \u44048 \u52628 \u44256  \u51080 \u50632 \u45796 . \u47785 \u51201 \u51060  \u49688 \u45800 \u51012  \u51221 \u45817 \u54868 \u49884 \u53416 \u45796 \u45716  \u44163 \u51060  \u44536  \u45800 \u52404 \u51032  \u44540 \u48376  \u50896 \u52825 \u51060 \u50632 \u45796 . \u51060  \u50896 \u52825 \u50640  \u51032 \u54616 \u50668  \u44144 \u51667 \u47568 , \u46020 \u51201 \u51656 , \u44144 \u51667  \u51613 \u44144 , \u50516 \u49332  \u44057 \u51008  \u44163 \u46020  \u44536 \u44163 \u51060  \u44368 \u54924 \u47484  \u51060 \u47213 \u44172  \u54616 \u45716  \u51068 \u51068  \u46412  \u50857 \u49436 \u48155 \u51012  \u49688  \u51080 \u45716  \u51068 \u51068  \u49104 \u47564  \u50500 \u45768 \u46972  \u50724 \u55176 \u47140  \u52845 \u52268 \u48155 \u51012  \u47564 \u54620  \u51068 \u51060  \u46104 \u50632 \u45796 . \u51228 \u49688 \u51060 \u53944  \u45817 \u50896 \u46308 \u51008  \u50668 \u47084  \u44032 \u51648  \u47784 \u50577 \u51004 \u47196  \u44032 \u51109 \u54616 \u50668  \u45208 \u46972 \u51032  \u44277 \u51649 \u51088 \u46308 \u51060  \u46104 \u44256  \u50773 \u51032  \u44256 \u47928 \u44288 \u46308 \u51032  \u51648 \u50948 \u50640 \u46020  \u50732 \u46972 \u44032 \u49436  \u45208 \u46972 \u51032  \u51221 \u52293 \u51012  \u49464 \u50864 \u45716  \u51068 \u46308 \u51012  \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u51221 \u53456 \u44988  \u45432 \u47495 \u51012  \u54616 \u44592  \u50948 \u54616 \u50668  \u45224 \u51032  \u51333 \u46020  \u46104 \u50632 \u45796 . \u44536 \u46308 \u51008  \u50773 \u51313 \u46308 \u44284  \u44480 \u51313 \u46308 \u51012  \u50948 \u54620  \u45824 \u54617 \u46308 \u44284  \u54217 \u48124 \u46308 \u51012  \u50948 \u54620  \u54617 \u44368 \u46308 \u51012  \u49464 \u50892 \u49436  \u44060 \u49888 \u44368 \u46020 \u46308 \u51032  \u51088 \u45376 \u46308 \u47196  \u54616 \u50668 \u44552  \u48277 \u50773 \u44368 \u51032  \u51032 \u47168  (\u20736 \u31150 ) \u47484  \u51648 \u53412 \u46020 \u47197  \u54616 \u50688 \u45796 . \u50808 \u44288 \u49345 \u51004 \u47196  \u54868 \u47140 \u54616 \u44256  \u52268 \u46976 \u54644  \u48372 \u51060 \u45716  \u47196 \u47560 \u44368 \u51032  \u51032 \u49885 \u46308 \u51008  \u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u51012  \u54844 \u46976 \u54616 \u44172  \u47564 \u46308 \u44256  \u49345 \u49345 \u47141 \u51012  \u54788 \u54841 \u49884 \u53040 \u45796 . \u44536 \u47084 \u48064 \u47196  \u51312 \u49345 \u46308 \u51060  \u49688 \u44256 \u54616 \u44256  \u54588  \u55128 \u47140  \u50619 \u51008  \u51088 \u50976 \u47484  \u44536  \u51088 \u45376 \u46308 \u51008  \u48176 \u48152 \u54616 \u50688 \u45796 . \u51228 \u49688 \u51060 \u53944 \u45817 \u51008  \u44553 \u44201 \u55176  \u50728  \u50976 \u47101 \u50640  \u54140 \u51276 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u46308 \u51060  \u44032 \u45716  \u44275 \u50640 \u45716  \u50612 \u46356 \u46304 \u51648  \u48277 \u50773 \u44368 \u51032  \u48512 \u55141 \u51060  \u46244 \u46384 \u46992 \u45796 .\
