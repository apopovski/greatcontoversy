\uc0\u51333 \u44368 \u44060 \u54785  \u51060 \u51204 \u50640 \u45716  \u44537 \u55176  \u51201 \u51008  \u48512 \u49688 \u51032  \u49457 \u44221 \u48150 \u50640  \u50630 \u50632 \u51004 \u45208  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u47568 \u50432 \u51060  \u50756 \u51204 \u55176  \u50630 \u50612 \u51648 \u46020 \u47197  \u54728 \u46973 \u51648  \u50500 \u45768 \u54616 \u49512 \u45796 . \u49457 \u44221 \u51032  \u51652 \u47532 \u44032  \u50689 \u50896 \u55176  \u49704 \u44200 \u51648 \u51648 \u45716  \u50506 \u51012  \u44163 \u51060 \u50632 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436  \u44048 \u50725 \u51032  \u47928 \u44284  \u52384 \u47928 \u51012  \u50676 \u50612 \u49436  \u45817 \u49888 \u51032  \u51333 \u46308 \u51012  \u49789 \u44172  \u54644 \u48169 \u49884 \u53020  \u51452 \u49892  \u49688  \u51080 \u50632 \u45912  \u44163 \u52376 \u47100  \u44536 \u48516 \u44760 \u49436 \u45716  \u49373 \u47749 \u51032  \u47568 \u50432 \u46020  \u49789 \u44172  \u54644 \u48169 \u49884 \u53420  \u49688  \u51080 \u51004 \u49512 \u45796 . \u50976 \u47101 \u51032  \u50668 \u47084  \u45208 \u46972 \u50640 \u49436  \u49324 \u46988 \u46308 \u51060  \u54616 \u45208 \u45784 \u51032  \u49457 \u47161 \u51032  \u44048 \u46041 \u54616 \u49900 \u51012  \u51077 \u50612  \u44048 \u52628 \u51064  \u48372 \u54868 \u47484  \u52286 \u46319 \u51060  \u51652 \u47532 \u47484  \u53456 \u44396 \u54616 \u44592  \u49884 \u51089 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u54616 \u45208 \u45784 \u51032  \u49453 \u47532  \u50500 \u47000  \u49457 \u47161 \u51032  \u51648 \u46020 \u47484  \u48155 \u44256 , \u48708 \u49345 \u54620  \u55141 \u48120 \u47484  \u44032 \u51648 \u44256  \u44144 \u47337 \u54620  \u47568 \u50432 \u51012  \u50672 \u44396 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u50612 \u46500  \u55148 \u49373 \u51012  \u47924 \u47493 \u50416 \u44256 \u46972 \u46020  \u48731 \u51012  \u48155 \u44256 \u51088  \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u47784 \u46304  \u44163 \u51012  \u48516 \u47749 \u55176  \u44648 \u45803 \u51648 \u45716  \u47803 \u54664 \u51648 \u47564  \u50724 \u47000  \u47931 \u54784  \u51080 \u50632 \u45912  \u47566 \u51008  \u51652 \u47532 \u47484  \u51060 \u54644 \u54624  \u49688  \u51080 \u50632 \u45796 . \u44536 \u46308 \u51008  \u54616 \u45720 \u51032  \u49324 \u51088 \u46308 \u47196  \u54028 \u44204 \u46104 \u50612 , \u50724 \u47448 \u50752  \u48120 \u49888 \u51032  \u49632 \u49324 \u49836 \u51012  \u45130 \u50612  \u48260 \u47532 \u44256 , \u50724 \u47019 \u46041 \u50504  \u49549 \u48149 \u46104 \u50612  \u51080 \u45716  \u49324 \u46988 \u46308 \u50640 \u44172  \u51088 \u50976 \u47484  \u50619 \u51004 \u46972 \u44256  \u48512 \u47476 \u51670 \u50632 \u45796 .\
\uc0\u50760 \u45940 \u49828 \u51064 \u46308 \u51012  \u51228 \u50808 \u54616 \u44256  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51008  \u50976 \u49885 \u54620  \u49324 \u46988 \u46308 \u47564  \u50508  \u49688  \u51080 \u45716  \u50616 \u50612 \u47196  \u50668 \u47084  \u49884 \u45824  \u46041 \u50504  \u44592 \u47197 \u46104 \u50612  \u51080 \u50632 \u45796 . \u44536 \u47084 \u45208  \u49457 \u44221 \u51060  \u48264 \u50669 \u46104 \u50612  \u47784 \u46304  \u49324 \u46988 \u46308 \u51060  \u51088 \u44397 \u50612 \u47196  \u46108  \u49457 \u44221 \u51012  \u44032 \u51656  \u49688  \u51080 \u45716  \u49884 \u45824 \u44032  \u50772 \u45796 . \u49464 \u49345 \u51008  \u44618 \u51008  \u48164 \u51473 \u51012  \u51648 \u45256 \u45796 . \u55121 \u50516 \u51032  \u49884 \u45824 \u45716  \u51648 \u45208 \u44032 \u44256 , \u47566 \u51008  \u45208 \u46972 \u46308 \u50640 \u49436 \u45716  \u45216 \u51060  \u49352 \u45716  \u51669 \u51312 \u46308 \u51060  \u45208 \u53440 \u45228 \u45796 .\
14\uc0\u49464 \u44592 \u50640  \u50689 \u44397 \u50640 \u49436  \u51333 \u44368 \u44060 \u54785 \u51032  \u49371 \u48324 \u51060  \u45208 \u53440 \u45228 \u45796 . \u51316  \u50948 \u53364 \u47532 \u54532  (John Wycliffe) \u45716  \u50689 \u44397 \u49104  \u50500 \u45768 \u46972  \u47784 \u46304  \u44536 \u47532 \u49828 \u46020 \u44368 \u44397 \u51012  \u50948 \u54620  \u44060 \u54785 \u51032  \u49440 \u44396 \u51088 \u50688 \u45796 . \u44536 \u44032  \u54728 \u46973 \u51012  \u48155 \u50500  \u47196 \u47560 \u44368 \u50640  \u51228 \u44592 \u54620  \u53360  \u54637 \u51032 \u45716  \u44208 \u53076  \u52840 \u47925 \u49884 \u53420  \u49688  \u50630 \u51012  \u44163 \u51060 \u50632 \u45796 . \u44536  \u54637 \u51032 \u45716  \u47560 \u52840 \u45236  \u44060 \u51064 \u44284  \u44368 \u54924 \u50752  \u44397 \u44032 \u51032  \u54644 \u48169 \u51012  \u52488 \u47000 \u54616 \u44172  \u46112  \u53804 \u51137 \u51012  \u48730 \u50612 \u45256 \u45796 .\
