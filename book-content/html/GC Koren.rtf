\uc0\u44032 \u51313 \u46308 \u51060  \u44536 \u51032  \u44256 \u53685 \u51012  \u47785 \u44201 \u54616 \u51648  \u47803 \u54616 \u46020 \u47197  \u54616 \u44592  \u50948 \u54616 \u50668  \u44536 \u46308 \u51012  \u44536  \u51109 \u49548 \u50640 \u49436  \u46496 \u45208 \u48372 \u45240  \u54980  \u50556 \u44273 \u51008  \u54616 \u45208 \u45784 \u44760  \u53444 \u50896 \u54616 \u44592  \u50948 \u54616 \u50668  \u54848 \u47196  \u45224 \u50520 \u45796 . \u44536 \u45716  \u51088 \u44592 \u51032  \u51396 \u47484  \u51088 \u48373 \u54616 \u44256  \u51088 \u44592 \u50640 \u44172  \u48288 \u54392 \u49888  \u54616 \u45208 \u45784 \u51032  \u51008 \u54812 \u47484  \u44048 \u49324 \u54620  \u47560 \u51020 \u51004 \u47196  \u51064 \u51221 \u54620 \u45796 . \u46041 \u49884 \u50640  \u44536 \u45716  \u47588 \u50864  \u44216 \u49552 \u54620  \u47560 \u51020 \u51004 \u47196  \u54616 \u45208 \u45784 \u44760 \u49436  \u44536 \u51032  \u51312 \u49345 \u46308 \u44284  \u47610 \u51004 \u49888  \u50616 \u50557 \u44284 , \u48295 \u50648 \u50640 \u49436  \u51060 \u49345  (\u30064 \u20687 ) \u51012  \u48372 \u45912  \u48164 \u50640 , \u46608 \u54620  \u50976 \u46993 \u54616 \u45716  \u46405 \u50640 \u49436  \u44536 \u50640 \u44172  \u51452 \u49888  \u50557 \u49549 \u51012  \u49457 \u52712 \u49884 \u53020  \u45804 \u46972 \u44256  \u54616 \u45208 \u45784 \u44760  \u53444 \u50896 \u54620 \u45796 . \u44536 \u51032  \u49373 \u50528 \u50640  \u50948 \u44592 \u44032  \u45796 \u44032 \u50772 \u45796 . \u47784 \u46304  \u44163 \u51060  \u50948 \u54744 \u50640  \u52376 \u54644  \u51080 \u45796 . \u50612 \u46176 \u44284  \u50808 \u47196 \u50880  \u49549 \u50640 \u49436  \u44536 \u45716  \u54616 \u45208 \u45784  \u50526 \u50640  \u51088 \u49888 \u51012  \u45230 \u52628 \u44256  \u44592 \u46020 \u47484  \u44228 \u49549 \u54616 \u44256  \u51080 \u45796 . \u44049 \u51088 \u44592  \u50612 \u46500  \u49552 \u51060  \u44536 \u51032  \u50612 \u44648 \u47484  \u48537 \u51105 \u45716 \u45796 . \u44536 \u45716  \u44536 \u51032  \u50896 \u49688 \u44032  \u51088 \u44592 \u51032  \u49373 \u47749 \u51012  \u48764 \u50519 \u51004 \u47140 \u44256  \u54616 \u45716  \u51460 \u47196  \u49373 \u44033 \u54620 \u45796 . \u44536 \u45716  \u51453 \u51012  \u55192 \u51012  \u45796 \u54616 \u50668  \u44536  \u44277 \u44201 \u51088 \u50752  \u50472 \u47492 \u51012  \u54620 \u45796 . \u45216 \u51060  \u49360  \u47924 \u47157 \u51060  \u46104 \u51088  \u44536  \u45231 \u49440  \u49324 \u46988 \u51008  \u52488 \u51064 \u44036 \u51201 \u51064  \u55192 \u51012  \u48156 \u55064 \u54620 \u45796 . \u54620  \u48264  \u44148 \u46300 \u47532 \u51088  \u55192 \u51060  \u44053 \u54620  \u50556 \u44273 \u51008  \u47560 \u52824  \u47560 \u48708 \u46108  \u44163 \u52376 \u47100  \u46104 \u50612  \u48260 \u47536 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u45716  \u45336 \u50612 \u51256 \u48260 \u47532 \u44256  \u49549 \u51208 \u50630 \u45716  \u49345 \u53468 \u50640 \u49436  \u51221 \u52404 \u48520 \u47749 \u51032  \u44536  \u51201 \u45824 \u51088 \u51032  \u47785 \u51012  \u45132 \u50612 \u50504 \u44256  \u50872 \u47732 \u49436  \u50528 \u50896 \u54620 \u45796 . \u50556 \u44273 \u51008  \u48169 \u44552  \u51088 \u44592 \u44032  \u49912 \u50868  \u49345 \u45824 \u44032  \u50616 \u50557 \u51032  \u52380 \u49324 \u51076 \u51012  \u51060 \u51228  \u44648 \u45803 \u45716 \u45796 . \u44144 \u51032  \u47784 \u46304  \u44592 \u47141 \u51060  \u48736 \u51648 \u44256  \u44537 \u49900 \u54620  \u44256 \u53685 \u51012  \u45817 \u54616 \u47732 \u49436 \u46020  \u44536 \u45716  \u44536 \u51032  \u47785 \u51201 \u51012  \u54252 \u44592 \u54616 \u51648  \u50506 \u45716 \u45796 . \u44536 \u45716  \u51088 \u44592 \u51032  \u51396  \u46412 \u47928 \u50640  \u50724 \u47019 \u46041 \u50504  \u44260 \u46976 \u44284  \u51088 \u52293 \u44284  \u44256 \u53685 \u51012  \u52280 \u50500 \u50772 \u45796 . \u51060 \u51228  \u44536 \u45716  \u44536 \u44163 \u51060  \u50857 \u49436 \u48155 \u50520 \u45796 \u45716  \u54869 \u51613 \u51012  \u50619 \u50612 \u50556  \u54620 \u45796 . \u44536  \u44144 \u47337 \u54620  \u48169 \u47928 \u51088 \u45716  \u48148 \u50556 \u55120 \u47196  \u46496 \u45208 \u44040  \u44163 \u52376 \u47100  \u48372 \u51064 \u45796 . \u44536 \u47084 \u45208  \u50556 \u44273 \u51008  \u44536 \u50640 \u44172  \u47588 \u45804 \u47140 \u49436  \u52629 \u48373 \u54644  \u45804 \u46972 \u44256  \u53444 \u50896 \u54620 \u45796 . \u44536  \u52380 \u49324 \u45716  \'93\u45216 \u51060  \u49352 \u47140  \u54616 \u45768  \u45208 \u47196  \u44032 \u44172  \u54616 \u46972 \'94\u44256  \u44053 \u44428 \u54620 \u45796 . \u44536 \u47084 \u45208  \u44536  \u51313 \u51109 \u51008  \'93\u45817 \u49888 \u51060  \u45236 \u44172  \u52629 \u48373 \u54616 \u51648  \u50500 \u45768 \u54616 \u47732  \u44032 \u44172  \u54616 \u51648  \u50500 \u45768 \u54616 \u44192 \u45208 \u51060 \u45796 \'94\u44256  \u50808 \u52828 \u45796 . \u50620 \u47560 \u45208  \u45440 \u46972 \u50868  \u54869 \u49888 \u44284  \u44403 \u49468  \u51032 \u51648 \u50752  \u51064 \u45236 \u47141 \u51060  \u50668 \u44592 \u50640  \u47896 \u49324 \u46104 \u50612  \u51080 \u45716 \u44032 ! \u44536 \u44163 \u51060  \u47564 \u51068  \u50724 \u47564 \u54616 \u44256  \u52280 \u46988 \u46108  \u50836 \u44396 \u50688 \u45796 \u47732  \u50556 \u44273 \u51008  \u51593 \u49884  \u47736 \u47581 \u45817 \u54664 \u51012  \u44163 \u51060 \u45796 . \u44536 \u47084 \u45208  \u44536 \u51032  \u44036 \u44396 \u45716  \u44536 \u44032  \u51088 \u49888 \u51032  \u50557 \u54616 \u44256  \u47924 \u44032 \u52824 \u54620  \u44163 \u51012  \u44256 \u48177 \u54616 \u44256  \u45908 \u50865 \u51060  \u50616 \u50557 \u51012  \u51648 \u53412 \u49884 \u45716  \u54616 \u45208 \u45784 \u51032  \u51008 \u54812 \u50640  \u51032 \u51648 \u54616 \u45716  \u51088 \u51076 \u51012  \u45208 \u53440 \u45236 \u45716  \u51613 \u44144 \u50688 \u45796 .\
\uc0\u44536 \u45716  \'93\u52380 \u49324 \u50752  \u55192 \u51012  \u44200 \u47336 \u50612  \u51060 \u44592 \'94 (\u54840  12:4) \u50632 \u45796 . \u44216 \u48708 \u50752  \u54924 \u44060 \u50752  \u54637 \u48373 \u51012  \u53685 \u54616 \u50668  \u51396 \u50752  \u49892 \u49688 \u44032  \u47566 \u51008  \u51060  \u49324 \u46988 \u51008  \u54616 \u45720 \u51032  \u44428 \u50948 \u51088 \u47196  \u45908 \u48520 \u50612  \u50472 \u47492 \u54616 \u50668  \u51060 \u44220 \u45796 . \u44536 \u45716  \u54616 \u45208 \u45784 \u51032  \u50557 \u49549 \u51012  \u51088 \u49888 \u51032  \u46504 \u47532 \u45716  \u49552 \u51004 \u47196  \u44403 \u44172  \u48537 \u51105 \u50520 \u45796 . \u44536 \u47084 \u48064 \u47196  \u47924 \u54620 \u54616 \u49888  \u49324 \u46993 \u51032  \u47560 \u51020 \u51012  \u44032 \u51648 \u49888  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u44536  \u51396 \u51064 \u51032  \u44036 \u44396 \u47484  \u47932 \u47532 \u52832  \u49688  \u50630 \u51004 \u49512 \u45796 . \u44536 \u51032  \u49849 \u47532 \u51032  \u51613 \u44144 \u47196 \u49436  \u46608 \u54620  \u44536 \u51032  \u48376 \u51012  \u46384 \u47476 \u45716  \u49324 \u46988 \u46308 \u51012  \u44428 \u51109 \u54616 \u47140  \u54616 \u45716  \u54364 \u47196 \u49436  \u44536 \u51032  \u51060 \u47492 \u51008  \u44536 \u51032  \u51396 \u47484  \u54924 \u49345 \u52992  \u54616 \u45716  \u51060 \u47492 \u50640 \u49436  \u49849 \u47532 \u47484  \u44592 \u45392 \u54616 \u45716  \u44163 \u51004 \u47196  \u48148 \u45068 \u50612 \u51276 \u45796 . \u50556 \u44273 \u51060  \u54616 \u45208 \u45784 \u44284  \u44200 \u47336 \u50612  \u51060 \u44220 \u45796 \u45716  \u44163 \u51008  \u44536 \u44032  \u49324 \u46988 \u50640 \u44172 \u46020  \u51060 \u44600  \u49688  \u51080 \u45796 \u45716  \u54616 \u45208 \u51032  \u48372 \u51613 \u51060 \u50632 \u45796 . \u44536 \u45716  \u50640 \u49436 \u51032  \u48516 \u45432 \u47484  \u45908  \u51060 \u49345  \u46160 \u47140 \u50880 \u51004 \u47196  \u47582 \u51060 \u54616 \u51648  \u50506 \u44172  \u46104 \u50632 \u45796 . \u50780 \u45264 \u54616 \u47732  \u54616 \u45208 \u45784 \u44760 \u49436  \u44536 \u47484  \u48372 \u54840 \u54616 \u50668  \u51452 \u49512 \u44592  \u46412 \u47928 \u51060 \u50632 \u45796 .\
\uc0\u49324 \u45800 \u51008  \u52380 \u49324 \u46308  \u50526 \u50640 \u49436  \u50556 \u44273 \u51012  \u48708 \u45212 \u54616 \u44256  \u44536 \u44032  \u44536  \u51088 \u49888 \u51032  \u51396  \u46412 \u47928 \u50640  \u47736 \u47581 \u48155 \u51020 \u51060  \u45817 \u50672 \u54616 \u45796 \u44256  \u51452 \u51109 \u54616 \u50688 \u45796 . \u44536 \u45716  \u50640 \u49436 \u47484  \u52649 \u46041 \u54616 \u50668  \u50556 \u44273 \u51012  \u54693 \u54616 \u50668  \u51652 \u44400 \u54644  \u50724 \u44172  \u54616 \u50688 \u45796 . \u44536 \u47532 \u44256  \u44536  \u48127 \u51020 \u51032  \u51313 \u51109 \u51060  \u44592 \u46020 \u47196  \u48164 \u51012  \u49352 \u50872  \u46412  \u49324 \u45800 \u51008  \u44536 \u50640 \u44172  \u48276 \u51396 \u54620  \u44163 \u51012  \u44648 \u45803 \u44172  \u54616 \u50668  \u44536 \u47484  \u45209 \u49900 \u52992  \u54616 \u44256  \u54616 \u45208 \u45784 \u51012  \u48537 \u46304  \u49552 \u51012  \u45459 \u52432 \u48260 \u47532 \u44172  \u54616 \u44256 \u51088  \u45432 \u47141 \u54616 \u50688 \u45796 . \u50556 \u44273 \u51008  \u44144 \u51032  \u51208 \u47581 \u54624  \u51648 \u44221 \u51004 \u47196  \u46504 \u50612 \u51276 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u54616 \u45720 \u51032  \u46020 \u50880 \u51060  \u50630 \u51060 \u45716  \u47736 \u47581 \u54624  \u49688 \u48150 \u50640  \u50630 \u45796 \u45716  \u44163 \u51012  \u44648 \u45804 \u50520 \u45796 . \u44536 \u47532 \u54616 \u50668  \u50556 \u44273 \u51008  \u51652 \u51221 \u51004 \u47196  \u51088 \u44592 \u51032  \u51396 \u47484  \u54924 \u44060 \u54616 \u44256 , \u54616 \u45208 \u45784 \u51032  \u51088 \u48708 \u47484  \u48155 \u44256 \u51088  \u53444 \u50896 \u54616 \u50688 \u45796 . \u44536 \u45716  \u44536 \u51032  \u47785 \u51201 \u51012  \u46028 \u51060 \u53412 \u51648  \u50506 \u50520 \u45796 . \u44536 \u45716  \u52380 \u49324 \u47484  \u44403 \u44172  \u48537 \u46308 \u44256  \u50676 \u47148 \u54616 \u44256  \u44256 \u48124  \u50612 \u47536  \u5