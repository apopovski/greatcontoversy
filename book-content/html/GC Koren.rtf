\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u53080 \u49828 \u53444 \u49828  \u49457 \u50640  \u46020 \u52265 \u54616 \u51088 , \u54980 \u49828 \u50640 \u44172 \u45716  \u50756 \u51204 \u54620  \u51088 \u50976 \u44032  \u54728 \u46973 \u46104 \u50632 \u45796 . \u54889 \u51228 \u51032  \u53685 \u54665 \u44428 \u50640 \u45716  \u45796 \u49884  \u48277 \u50773 \u51032  \u44060 \u51064 \u51201 \u51064  \u48372 \u51613 \u51060  \u52392 \u48512 \u46104 \u50632 \u45796 . \u44536 \u47084 \u45208  \u51060  \u50628 \u49689 \u54616 \u44172  \u48152 \u48373 \u46108  \u48372 \u51613 \u46020  \u47924 \u49884 \u46104 \u44256 , \u50620 \u47560  \u54980 \u50640  \u44536  \u44060 \u54785 \u51088 \u45716  \u48277 \u50773 \u44284  \u52628 \u44592 \u44221 \u46308 \u51032  \u47749 \u47161 \u51004 \u47196  \u52404 \u54252 \u46104 \u50632 \u45796 . \u44536 \u45716  \u44263  \u48520 \u44208 \u54616 \u44256  \u51020 \u52840 \u54620  \u44048 \u50725 \u50640  \u44039 \u55176 \u44172  \u46104 \u50632 \u45796 . \u44536  \u54980 \u50640  \u44536 \u45716  \u46972 \u51064  \u44053  \u44148 \u45320 \u54200 \u50640  \u51080 \u45716  \u53948 \u53948 \u54620  \u49457 \u50504 \u51004 \u47196  \u51060 \u49569 \u46104 \u50612  \u51396 \u49688 \u47196  \u49688 \u44048 \u46104 \u50632 \u45796 . \u51060 \u47084 \u54620  \u48277 \u50773 \u51032  \u48176 \u48152 \u51008  \u48277 \u50773  \u51088 \u49888 \u50640 \u44172 \u46020  \u50976 \u51061 \u51060  \u46104 \u51648  \u47803 \u54616 \u50688 \u51004 \u47728 , \u50724 \u47000 \u51648  \u50500 \u45768 \u54616 \u50668  \u44536  \u48277 \u50773 \u46020  \u46608 \u54620  \u44536  \u46041 \u51068 \u54620  \u51109 \u49548 \u50640  \u44039 \u55176 \u44172  \u46104 \u50632 \u45796  (Bonnechose, vol.1, pp.247). \u44536 \u45716  \u54924 \u51032 \u49437 \u49345 \u50640 \u49436  \u49332 \u51064 , \u49457 \u51649  \u47588 \u47588 , \u44036 \u51020 , \u44536  \u50808 \u50640 \u46020  \u47568 \u54624  \u49688  \u50630 \u51060  \u45908 \u47084 \u50868  \u51396 \u50501 \u51012  \u48276 \u54620  \u44163 \u51060  \u48157 \u54784 \u51276 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u45716  \u54924 \u51032 \u51032  \u49440 \u44256 \u47196  \u49340 \u52789  \u47732 \u47448 \u44288 \u51012  \u48149 \u53448 \u45817 \u54616 \u44256 , \u46041 \u49884 \u50640  \u50725 \u50640  \u44039 \u55176 \u44172  \u46104 \u50632 \u45796 . \u44536 \u47532 \u44256  \u52280 \u52845  \u48277 \u50773 \u46308 \u46020  \u54224 \u50948 \u45817 \u54616 \u44256  \u49352 \u47196 \u50868  \u48277 \u50773 \u51060  \u49440 \u51221 \u46104 \u50632 \u45796 .\
\uc0\u54980 \u49828 \u44032  \u44060 \u54785 \u51012  \u50836 \u44396 \u54616 \u47728  \u49888 \u48512 \u46308 \u51012  \u48708 \u45212 \u54644  \u50772 \u45912  \u51396 \u46308 \u48372 \u45796  \u45908  \u53360  \u51396 \u47484  \u48277 \u50773  \u51088 \u49888 \u51060  \u48276 \u54664 \u51648 \u47564 , \u48277 \u50773 \u51012  \u54028 \u47732 \u49884 \u53416  \u48148 \u47196  \u44536  \u46041 \u51068 \u54620  \u54924 \u51032 \u45716  \u51060 \u51228  \u51060  \u44060 \u54785 \u51088 \u47484  \u52376 \u52824 \u54644  \u48260 \u47532 \u44592 \u47196  \u54616 \u50688 \u45796 . \u54980 \u49828 \u51032  \u53804 \u50725 \u51008  \u48372 \u54756 \u48120 \u50500  \u49324 \u46988 \u46308 \u51032  \u53360  \u48516 \u45432 \u47484  \u51068 \u51004 \u53040 \u45796 . \u50976 \u47141 \u54620  \u44480 \u51313 \u46308 \u51060  \u45824 \u54924 \u51032  \u49437 \u49345 \u50640 \u49436  \u51060 \u47084 \u54620  \u54945 \u54252 \u54620  \u54665 \u50948 \u50640  \u45824 \u54616 \u50668  \u51060 \u51032  (\u30064 \u35696 ) \u47484  \u51228 \u44592 \u54616 \u50688 \u45796 . \u51088 \u44592 \u44032  \u48156 \u54665 \u54620  \u53685 \u54665 \u44428 \u51060  \u52840 \u54644 \u45817 \u54616 \u45716  \u44163 \u51012  \u51339 \u50500 \u54616 \u51648  \u50506 \u45716  \u54889 \u51228 \u45716  \u54980 \u49828 \u50640  \u45824 \u54620  \u51312 \u52824 \u50640  \u48152 \u45824 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44060 \u54785 \u51088 \u51032  \u50896 \u49688 \u46308 \u51008  \u50501 \u46021 \u54616 \u44256  \u50756 \u44256 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u54889 \u51228 \u51032  \u54200 \u44204 \u44284  \u44536 \u51032  \u44277 \u54252 \u49900 \u44284  \u44368 \u54924 \u50640  \u45824 \u54620  \u44536 \u51032  \u50676 \u49457  \u46321 \u51012  \u46308 \u50612  \u54889 \u51228 \u50640 \u44172  \u54840 \u49548 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \'93\u48708 \u47197  \u54889 \u51228 \u45208  \u44397 \u50773 \u51004 \u47196 \u48512 \u53552  \u53685 \u54665 \u44428 \u51012  \u48155 \u51008  \u51088 \u51068 \u51648 \u46972 \u46020  \u44536 \u44032  \u51060 \u45800 \u51060 \u44144 \u45208  \u51060 \u45800 \u51032  \u54800 \u51032 \u47484  \u48155 \u51008  \u51088 \u51068  \u44221 \u50864 \u50640 \u45716  \u44536 \u47196  \u45908 \u48520 \u50612  \u47610 \u51008  \u50557 \u49549 \u51060  \u51060 \u54665 \u46112  \u49688  \u50630 \u45796 \'94 (Jacques Lenfant, His-tory of the Council of Constance, vol.1, p.516) \u45716  \u44163 \u51012  \u51077 \u51613 \u54616 \u44592  \u50948 \u54616 \u50668  \u51109 \u54889 \u54620  \u51060 \u47200 \u51012  \u54196 \u45459 \u50520 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u46308 \u51060  \u46301 \u51032 \u54664 \u45796 .\
\uc0\u44048 \u48169 \u51032  \u49845 \u44592 \u50752  \u48520 \u44208 \u54620  \u44277 \u44592  \u46412 \u47928 \u50640  \u50676 \u48337 \u50640  \u44152 \u47140 \u49436  \u44144 \u51032  \u51453 \u51020  \u51649 \u51204 \u50640  \u45459 \u50668  \u51080 \u50632 \u51648 \u47564  \u47560 \u52840 \u45236  \u54980 \u49828 \u45716  \u45824 \u54924 \u51032 \u50640  \u45132 \u47140 \u45208 \u50772 \u45796 . \u44536 \u45716  \u47924 \u44144 \u50868  \u49632 \u49324 \u49836 \u50640  \u47588 \u51064  \u52292 \u47196  \u54889 \u51228  \u50526 \u50640  \u49456 \u45796 . \u51060  \u54889 \u51228 \u45716  \u51068 \u52237 \u51060  \u51088 \u44592 \u51032  \u47749 \u50696 \u50752  \u54988 \u47469 \u54620  \u49888 \u50521 \u51004 \u47196  \u54980 \u49828 \u47484  \u48372 \u54840 \u54644  \u51452 \u44592 \u47196  \u49436 \u50557 \u54620  \u48148 \u47196  \u44536  \u49324 \u46988 \u51060 \u50632 \u45796 . \u44596  \u49900 \u47928 \u51012  \u53685 \u54616 \u50668  \u54980 \u49828 \u45716  \u54869 \u44256 \u48512 \u46041 \u54616 \u44172  \u51652 \u47532 \u47484  \u51452 \u51109 \u54616 \u50688 \u45796 . \u44536 \u45716  \u51060 \u51228  \u44536  \u44275 \u50640  \u50676 \u49437 \u54620  \u44368 \u54924 \u50752  \u51221 \u48512 \u51032  \u44256 \u44288 \u46308  \u50526 \u50640 \u49436  \u44144 \u47532 \u45196  \u50630 \u51060  \u44368 \u44428 \u51032  \u48512 \u54056 \u47484  \u44508 \u53444 \u54616 \u50688 \u45796 . \u51088 \u44592 \u51032  \u44368 \u47532 \u47484  \u52712 \u49548 \u54616 \u46304 \u51648  \u51453 \u51020 \u51012  \u53469 \u54616 \u46304 \u51648  \u46168  \u51473 \u51032  \u54616 \u45208 \u47484  \u49440 \u53469 \u54616 \u46972 \u44256  \u54664 \u51012  \u46412 , \u44536 \u45716  \u49692 \u44368 \u51088 \u51032  \u50868 \u47749 \u51012  \u49688 \u46973 \u54616 \u50688 \u45796 .\
\uc0\u54616 \u45208 \u45784 \u51032  \u51008 \u54812 \u44032  \u44536 \u47484  \u48537 \u46308 \u50632 \u45796 . \u44536 \u44032  \u52572 \u54980 \u51032  \u49440 \u44256 \u47484  \u48155 \u44592  \u51204 \u50640  \u51080 \u51008  \u44256 \u45212 \u51032  \u47751  \u51452 \u51068  \u46041 \u50504 \u50640  \u44536 \u50640 \u44172 \u45716  \u54616 \u45720 \u51032  \u54217 \u54868 \u44032  \u47560 \u51020 \u50640  \u52649 \u47564 \u54616 \u50668 \u51276 \u45796 . \u44536 \u45716  \u54620  \u52828 \u44396 \u50640 \u44172  \u45796 \u51020 \u44284  \u44057 \u51060  \u54200 \u51648 \u54616 \u50688 \u45796 . \'93\u45208 \u45716  \u50725 \u51473 \u50640 \u49436  \u45236 \u51068  \u49324 \u54805  \u49440 \u44256 \u44032  \u45236 \u47540  \u44163 \u51012  \u44592 \u45796 \u47532 \u47732 \u49436  \u49632 \u49324 \u49836 \u50640  \u47588 \u51064  \u49552 \u51004 \u47196  \u51060  \u54200 \u51648 \u47484  \u50420 \u45796 . \u50864 \u47532 \u44032  \u44536 \u47532 \u49828 \u46020 \u51032  \u46020 \u50864 \u49900 \u51004 \u47196  \u45236 \u49464 \u51032  \u44480 \u54620  \u54868 \u54217  \u51473 \u50640 \u49436  \u45796 \u49884  \u47564 \u45208 \u44172  \u46112  \u46412 , \u44536 \u45824 \u45716  \u54616 \u45208 \u45784 \u44760 \u49436  \u45208 \u47484  \u50948 \u54616 \u50668  \u50612 \u45712  \u51221 \u46020 \u51032  \u51088 \u48708 \u47484  \u48288 \u54392 \u49888  \u44163 \u44284  \u45236 \u44032  \u45817 \u54620  \u49884 \u54744 \u44284  \u49884 \u47144  \u51473 \u50640 \u49436  \u50620 \u47560 \u45208  \u54952 \u44284 \u51201 \u51004 \u47196  \u45208 \u47484  \u46020 \u50864 \u49512 \u45716 \u44032 \u47484  \u50508 \u44172  \u46112  \u44163 \u51060 \u45796 \'94 (Bonnechose, vol.2, p.67).\
\uc0\u51020 \u49328 \u54620  \u50725 \u51473 \u50640 \u49436  \u44536 \u45716  \u52280 \u46108  \u49888 \u50521 \u51032  \u49849 \u47532 \u47484  \u48120 \u47532  \u48372 \u50520 \u45796 . \u45000  \u44032 \u50868 \u45936  \u44536 \u45716  \u51088 \u44592 \u44032  \u48373 \u51020 \u51012  \u51204 \u54616 \u45912  \u54532 \u46972 \u54616 \u51032  \u44368 \u54924 \u45817 \u51004 \u47196  \u46028 \u50500 \u44032 \u49436  \u44536 \u44032  \u48317 \u50640  \u44536 \u47160 \u45912  \u44536 \u47532 \u49828 \u46020 \u51032  \u44536 \u47548 \u46308 \u51012  \u48277 \u50773 \u44284  \u51452 \u44368 \u46308 \u51060  \u51648 \u50892  \u48260 \u47532 \u45716  \u44163 \u51012  \u48372 \u50520 \u45796 . \'93\u51060  \u44305 \u44221 \u51008  \u44536 \u47484  \u44340 \u47213 \u44172  \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536  \u45796 \u51020 \u45216 \u50640  \u44536 \u45716  \u45908 \u50865  \u47566 \u51008  \u54868 \u44032 \u46308 \u51060  \u45908 \u50865  \u52268 \u46976 \u54620  \u52292 \u49353 \u51004 \u47196  \u45908 \u50865  \u47566 \u51008  \u44536 \u47548 \u46308 \u51012  \u44536 \u47532 \u44256  \u51080 \u45716  \u44163 \u51012  \u48372 \u50520 \u45796 . \u51068 \u51012  \u47560 \u52824 \u51088 \u47560 \u51088  \u44536  \u54868 \u44032 \u46308 \u51008  \u49688 \u47566 \u51008  \u49324 \u46988 \u46308 \u50640 \u44172  \u46168 \u47084 \u49912 \u50668  \'91\u51088  \u51060 \u51228 \u45716  \u48277 \u50773 \u51060 \u46304 \u51648  \u44048 \u46021 \u51060 \u46304 \u51648  \u50752  \u48372 \u46972 . \u44536 \u46308 \u51060  \u45908  \u51060 \u49345  \u45796 \u49884 \u45716  \u51060  \u44536 \u47548 \u46308 \u51012  \u51648 \u50864 \u51648  \u47803 \u54624  \u44163 \u51060 \u45796 \'92\u44256  \u48512 \u47476 \u51670 \u50632 \u45796 . \u44060 \u54785 \u51088 \u45716  \u44536 \u44032  \u44988  \u45000 \u50640  \u44288 \u54616 \u50668  \'91\u45208 \u45716  \u44536 \u47532 \u49828 \u46020 \u51032  \u49345  (\u20687 ) \u51012  \u44208 \u45800 \u53076  \u51648 \u50892  \u48260 \u47540  \u49688  \u50630 \u45796 \u45716  \u44163 \u51012  \u54869 \u49888 \u54620 \u45796 . \u44536 \u46308 \u51008  \u44536 \u44163 \u51012  \u49548 \u47736 \u49884 \u53020  \u48260 \u47532 \u44256 \u51088  \u54664 \u51648 \u47564  \u45208 \u48372 \u45796  \u55016 \u50476  \u45908  \u50976 \u47141 \u54620  \u51204 \u46020 \u51088 \u46308 \u47196  \u47568 \u48120 \u50516 \u50500  \u44536 \u44163 \u51008  \u47784 \u46304  \u49324 \u46988 \u51032  \u47560 \u51020 \u50640  \u49352 \u47213 \u44172  \u44536 \u47140 \u51656  \u44163 \u51060 \u45796 \'92\u44256  \u47568 \u54616 \u50688 \u45796 \'94 (D\'92Aubigne, b.1, ch.6).\
