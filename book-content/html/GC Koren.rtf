\uc0\u50696 \u47336 \u49332 \u47128 \u50640  \u45824 \u54620  \u54616 \u45208 \u45784 \u51032  \u50724 \u47000  \u52280 \u51004 \u49900 \u51008  \u50976 \u45824 \u51064 \u51032  \u50756 \u44256 \u54620  \u44256 \u51665 \u51012  \u45908 \u50865  \u53356 \u44172  \u54644 \u51460  \u46384 \u47492 \u51060 \u50632 \u45796 . \u44536 \u46308 \u51008  \u50696 \u49688 \u45784 \u51032  \u51228 \u51088 \u46308 \u51012  \u48120 \u50892 \u54616 \u44256  \u54617 \u45824 \u54632 \u51004 \u47196  \u47560 \u52840 \u45236  \u47560 \u51648 \u47561 \u51004 \u47196  \u51452 \u50612 \u51652  \u51088 \u48708 \u44620 \u51648 \u46020  \u44144 \u51208 \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u54616 \u45208 \u45784 \u44760 \u49436  \u45817 \u49888 \u51032  \u48372 \u54840 \u51032  \u49552 \u51012  \u44536 \u46308 \u50640 \u44172 \u49436  \u44144 \u46160 \u49884 \u44256  \u49324 \u45800 \u44284  \u44536  \u49324 \u51088 \u46308 \u51012  \u50613 \u51228 \u54616 \u45912  \u45733 \u47141 \u51012  \u44536 \u46308 \u50640 \u44172 \u49436  \u44144 \u46160 \u49884 \u48064 \u47196  \u44536  \u48177 \u49457 \u51008  \u51088 \u44592 \u46308 \u51032  \u53469 \u54620  \u51648 \u46020 \u51088 \u51032  \u51648 \u48176 \u50640  \u48260 \u47140 \u51652  \u48148  \u46104 \u50632 \u45796 . \u51060 \u49828 \u46972 \u50648  \u51088 \u49552 \u46308 \u51008  \u44536 \u46308 \u50640 \u44172  \u44536 \u46308 \u51032  \u50501 \u54620  \u52649 \u46041 \u51012  \u51228 \u50612 \u54624  \u45733 \u47141 \u51012  \u51460  \u49688  \u51080 \u50632 \u45912  \u44536 \u47532 \u49828 \u46020 \u51032  \u51008 \u54812 \u47484  \u44144 \u51208 \u54616 \u50688 \u51004 \u48064 \u47196  \u51060 \u51228 \u45716  \u44536  \u50501 \u54620  \u52649 \u46041 \u46308 \u51060  \u44536 \u46308 \u51012  \u51221 \u48373 \u54616 \u50688 \u45796 . \u49324 \u45800 \u51008  \u49324 \u46988 \u51032  \u44032 \u51109  \u44201 \u47148 \u54616 \u44256 \u46020  \u48708 \u50676 \u54620  \u51221 \u50837 \u51012  \u48520 \u47084  \u51068 \u51004 \u53040 \u45796 . \u49324 \u46988 \u46308 \u51008  \u49884 \u48708 \u47484  \u44032 \u47532 \u51648  \u50506 \u44256 , \u51060 \u49457  (\u63972 \u24615 ) \u51012  \u46496 \u45208 \u49436  \u52649 \u46041 \u44284  \u47609 \u47785 \u51201 \u51064  \u44201 \u51221  (\u28608 \u24773 ) \u51032  \u51648 \u48176 \u47484  \u48155 \u50520 \u45796 . \u44536 \u46308 \u51032  \u51092 \u51064 \u49457 \u51008  \u50501 \u47560 \u50752  \u44057 \u50520 \u45796 . \u44032 \u51221 \u50640 , \u48177 \u49457 \u46308  \u49324 \u51060 \u50640 , \u49345 \u47448  \u44228 \u44553 \u44284  \u54616 \u47448  \u44228 \u44553 \u46308  \u44036 \u50640  \u54620 \u44208 \u44057 \u51060  \u51032 \u49900 , \u51656 \u53804 , \u50896 \u54620 , \u48520 \u54868 , \u47784 \u48152 , \u49332 \u50977 \u51060  \u54200 \u47564 \u54616 \u50688 \u45796 . \u50612 \u45712  \u44275 \u46020  \u50504 \u51204 \u54616 \u51648  \u50506 \u50520 \u45796 . \u48512 \u47784 \u45716  \u51088 \u45376 \u47484 , \u51088 \u45376 \u45716  \u48512 \u47784 \u47484  \u49332 \u54644 \u54616 \u50688 \u45796 . \u50948 \u51221 \u51088 \u46308 \u51008  \u51088 \u44592  \u51088 \u49888 \u46308 \u51012  \u45796 \u49828 \u47540  \u55192 \u51060  \u50630 \u50632 \u45796 . \u47560 \u51020 \u51012  \u50613 \u51228 \u54624  \u49688  \u50630 \u50632 \u51004 \u48064 \u47196  \u44536 \u46308 \u51008  \u54253 \u44400 \u51060  \u46104 \u50632 \u45796 . \u50976 \u45824 \u51064 \u46308 \u51008  \u55136  \u50630 \u45716  \u54616 \u45208 \u45784 \u51032  \u50500 \u46308 \u51012  \u51221 \u51396 \u54616 \u44592  \u50948 \u54616 \u50668  \u44144 \u51667  \u51613 \u50616 \u51012  \u48155 \u50500 \u46308 \u50688 \u45796 . \u51060 \u51228 \u45716  \u44144 \u51667  \u44256 \u49548 \u44032  \u44536 \u46308  \u51088 \u49888 \u46308 \u51032  \u49373 \u47749 \u51012  \u48520 \u54869 \u49892 \u54616 \u44172  \u47564 \u46308 \u50632 \u45796 . \u44536 \u46308 \u51008  \u50724 \u47019 \u46041 \u50504  \u44536 \u46308 \u51032  \u54665 \u46041 \u51012  \u53685 \u54616 \u50668  \'93\u51060 \u49828 \u46972 \u50648 \u51032  \u44144 \u47337 \u54616 \u49888  \u51088 \u47196  \u50864 \u47532  \u50526 \u50640 \u49436  \u46496 \u45208 \u49884 \u44172  \u54616 \u46972 \'94 (\u49324  30:11) \u44256  \u47568 \u54644  \u50772 \u50632 \u45796 . \u51060 \u51228 \u45716  \u44536 \u46308 \u51032  \u49548 \u50896 \u51060  \u49457 \u52712 \u46104 \u50632 \u45796 . \u54616 \u45208 \u45784 \u50640  \u45824 \u54620  \u46160 \u47140 \u50880 \u51060  \u44536 \u46308 \u51012  \u45908  \u51060 \u49345  \u44340 \u47213 \u55176 \u51648  \u50506 \u50520 \u45796 . \u49324 \u45800 \u51008  \u45208 \u46972 \u51032  \u49688 \u47161 \u51060  \u46104 \u44256 , \u44397 \u44032 \u50752  \u51333 \u44368 \u51032  \u52572 \u44256  \u44428 \u50948 \u51088 \u46308 \u51008  \u47784 \u46160  \u44536 \u50640 \u44172  \u51648 \u48176 \u46104 \u50632 \u45796 .\
\uc0\u49436 \u47196  \u51201 \u45824 \u51201 \u51064  \u54028 \u45817 \u51032  \u51648 \u46020 \u51088 \u46308 \u51060  \u46412 \u46412 \u47196  \u48520 \u49933 \u54620  \u49324 \u46988 \u46308 \u51012  \u48149 \u54644 \u54616 \u44256  \u50557 \u53448 \u54616 \u45716  \u51068 \u50640  \u44208 \u53441 \u54616 \u50688 \u44256 , \u45796 \u49884  \u44536 \u46308 \u45180 \u47532  \u49912 \u50864 \u44256  \u47924 \u51088 \u48708 \u54616 \u44172  \u49332 \u50977 \u54616 \u50688 \u45796 . \u49888 \u49457 \u54620  \u49457 \u51204 \u50640 \u49436 \u44620 \u51648 \u46020  \u44536 \u46308 \u51008  \u54252 \u50501 \u47924 \u46020 \u54620  \u51068 \u51012  \u54665 \u54616 \u50688 \u45796 . \u50696 \u48176 \u54616 \u45912  \u49324 \u46988 \u46308 \u51060  \u51228 \u45800  \u50526 \u50640 \u49436  \u51453 \u51076 \u51012  \u45817 \u54616 \u44256 , \u49457 \u49548 \u45716  \u44536  \u49884 \u52404 \u46308 \u47196  \u45908 \u47101 \u54784 \u51276 \u45796 . \u44536 \u47100 \u50640 \u46020  \u48520 \u44396 \u54616 \u44256  \u44536  \u55113 \u50501 \u54620  \u49324 \u44148 \u51032  \u49440 \u46041 \u51088 \u46308 \u51008  \u50696 \u47336 \u49332 \u47128 \u51060  \u54616 \u45208 \u45784 \u51032  \u46020 \u49457 \u51060 \u48064 \u47196  \u47736 \u47581 \u46112  \u50684 \u47140 \u44032  \u50630 \u45796 \u45716  \u44536 \u46308 \u51032  \u47609 \u47785 \u51201 \u51060 \u47728  \u47784 \u46021 \u51201 \u51064  \u50613 \u52769 \u51012  \u44277 \u44277 \u50672 \u54616 \u44172  \u51452 \u51109 \u54616 \u50688 \u45796 . \u44536 \u47532 \u44256  \u44536 \u46308 \u51032  \u49464 \u47141 \u51012  \u45908 \u50865  \u54869 \u44256 \u54616 \u44172  \u44396 \u52629 \u54616 \u44592  \u50948 \u54616 \u50668  \u44536 \u46308 \u51008  \u44144 \u51667  \u49440 \u51648 \u51088 \u47484  \u47588 \u49688 \u54616 \u50668 , \u48708 \u47197  \u49457 \u51204 \u51060  \u47196 \u47560 \u44400 \u50640 \u44172  \u54252 \u50948 \u46104 \u50612  \u51080 \u51020 \u50640 \u46020  \u48520 \u44396 \u54616 \u44256  \u48177 \u49457 \u46308 \u50640 \u44172  \u54616 \u45208 \u45784 \u51032  \u44396 \u50896 \u51012  \u44592 \u45796 \u47140 \u50556  \u54620 \u45796 \u44256  \u44277 \u54252 \u54616 \u44172  \u54616 \u50688 \u45796 . \u44536 \u47084 \u48064 \u47196  \u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u52572 \u54980 \u44620 \u51648  \u51648 \u44537 \u55176  \u45458 \u51004 \u49888  \u54616 \u45208 \u45784 \u44760 \u49436  \u44060 \u51077 \u54616 \u49492 \u49436  \u44536 \u46308 \u51032  \u50896 \u49688 \u46308 \u51012  \u47924 \u52244 \u47084  \u51452 \u49892  \u44163 \u51060 \u46972 \u45716  \u49888 \u45392 \u51012  \u44873  \u48537 \u51105 \u50520 \u45796 . \u44536 \u47084 \u45208  \u51060 \u49828 \u46972 \u50648 \u51060  \u44144 \u47337 \u54616 \u49888  \u54616 \u45208 \u45784 \u51032  \u48372 \u54840 \u47484  \u44144 \u51208 \u54616 \u50688 \u51004 \u48064 \u47196  \u51060 \u51228  \u44536 \u46308 \u50640 \u44172 \u45716  \u50500 \u47924 \u47088  \u48169 \u48708 \u44032  \u50630 \u50632 \u45796 . \u48520 \u54665 \u54620  \u50696 \u47336 \u49332 \u47128 \u51060 \u50668 ! \u45236 \u48516  (\u20839 \u32027 ) \u51004 \u47196  \u52258 \u44200 \u51648 \u44256 , \u54588 \u52264 \u51032  \u49552 \u51004 \u47196  \u51453 \u51076 \u51012  \u45817 \u54620  \u51088 \u45376 \u46308 \u51032  \u54588 \u47196 \u50024  \u44144 \u47532 \u45716  \u48521 \u44172  \u47932 \u46308 \u44256  \u44536  \u50836 \u49352  (\u35201 \u22622 ) \u45716  \u51060 \u48169 \u51064 \u46308 \u50640 \u44172  \u54028 \u44340 \u46104 \u44256 , \u50857 \u49324 \u46308 \u51008  \u51453 \u51076 \u51012  \u45817 \u54620  \u48520 \u54665 \u54620  \u50696 \u47336 \u49332 \u47128 \u51060 \u50668 !\
\uc0\u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u54616 \u49888  \u50696 \u47336 \u49332 \u47128 \u51032  \u47736 \u47581 \u50640  \u44288 \u54620  \u50696 \u50616 \u51008  \u44544 \u51088  \u44536 \u45824 \u47196  \u49457 \u52712 \u46104 \u50632 \u45796 . \u50976 \u45824 \u51064 \u46308 \u51008  \'93\u45320 \u55148 \u51032  \u48708 \u54032 \u54616 \u45716  \u44536  \u48708 \u54032 \u51004 \u47196  \u45320 \u55148 \u44032  \u48708 \u54032 \u51012  \u48155 \u51012  \u44163 \u51060 \u50836 \'94 (\u47560  7:2) \u46972 \u44256  \u54616 \u49888  \u44536 \u47532 \u49828 \u46020 \u51032  \u44221 \u44256 \u51032  \u47568 \u50432 \u51060  \u51652 \u47532 \u51076 \u51012  \u44221 \u54744 \u54616 \u50688 \u45796 .\
\uc0\u51116 \u45212 \u44284  \u47736 \u47581 \u51032  \u51204 \u51312 \u44032  \u46104 \u45716  \u51669 \u51312 \u50752  \u44592 \u49324 \u46308 \u51060  \u45208 \u53440 \u45228 \u45796 . \u44618 \u51008  \u48164 \u51473 \u50640  \u54620  \u51460 \u44592 \u51032  \u51060 \u49345 \u54620  \u48731 \u51060  \u49457 \u51204 \u44284  \u51228 \u45800  \u50948 \u50640  \u45208 \u53440 \u45228 \u45796 . \u54644 \u44032  \u51656  \u47924 \u47157 \u50640 \u45716  \u44396 \u47492  \u50948 \u50640  \u49912 \u50880 \u53552 \u47196  \u47784 \u50668 \u46300 \u45716  \u44400 \u49324 \u46308 \u44284  \u51204 \u52264  (\u25136 \u36554 ) \u46308 \u51032  \u44305 \u44221 \u51060  \u45208 \u53440 \u45228 \u45796 . \u48164 \u50640  \u49457 \u49548 \u50640 \u49436  \u48393 \u49324 \u54616 \u45912  \u51228 \u49324 \u51109 \u46308 \u51060  \u49888 \u48708 \u54620  \u49548 \u47532 \u47484  \u46307 \u44256  \u44277 \u54252 \u50640  \u51656 \u47160 \u45796 . \u46405 \u51060  \u51652 \u46041 \u54616 \u50688 \u44256 , \'93\u50864 \u47532 \u44032  \u50668 \u44592 \u49436  \u46496 \u45208 \u44032 \u51088 \'94\u44256  \u54616 \u45716  \u44400 \u51473 \u51032  \u50808 \u52840 \u51060  \u46308 \u47160 \u45796 . 20\u47749 \u51060  \u55192 \u51012  \u54633 \u54616 \u51648  \u50506 \u51004 \u47732  \u50676  \u49688  \u50630 \u45716  \u50977 \u51473 \u54616 \u44256  \u44204 \u44256 \u54620  \u51452 \u52647 \u46028 \u50640  \u44618 \u51060  \u48149 \u54784  \u51080 \u45716  \u52384 \u48727 \u51109 \u51004 \u47196  \u44403 \u44172  \u45803 \u55180  \u46041 \u47928  (\u26481 \u38272 ) \u51032  \u47928 \u51677 \u51060  \u50500 \u47924 \u47088  \u51064 \u51201  (\u20154 \u36857 ) \u46020  \u50630 \u51060  \u48164 \u51473 \u50640  \u50676 \u47160 \u45796  (Milman, The History of the Jews, book 13).\
\uc0\u44536 \u47532 \u44256  7\u45380  \u46041 \u50504  \u50696 \u47336 \u49332 \u47128 \u51032  \u49884 \u44032 \u47484  \u50724 \u47476 \u45236 \u47532 \u47728  \u49457 \u46020  (\u32854 \u37117 ) \u50640  \u51116 \u50521 \u51060  \u45236 \u47540  \u44163 \u51012  \u49440 \u54252 \u54620  \u54620  \u45224 \u51088 \u44032  \u51080 \u50632 \u45796 . \u44536 \u45716  \u48164 \u45230 \u51004 \u47196  \u49836 \u54536  \u45432 \u47000 \u47484  \u48520 \u47104 \u45796 . \u44536 \u45716  \'93\u46041 \u54200 \u50640 \u49436  \u54620  \u49548 \u47532 \u44032 , \u49436 \u54200 \u50640 \u49436  \u54620  \u49548 \u47532 \u44032 , \u49324 \u48169 \u50640 \u49436  \u54620  \u49548 \u47532 \u44032 , \u50696 \u47336 \u49332 \u47128 \u44284  \u49457 \u51204 \u51012  \u52293 \u47581 \u54616 \u45716  \u54620  \u49548 \u47532 \u44032 , \u49888 \u46993 \u44284  \u49888 \u48512 \u47484  \u52293 \u47581 \u54616 \u45716  \u54620  \u49548 \u47532 \u44032 , \u50728  \u48177 \u49457 \u51012  \u52293 \u47581 \u54616 \u45716  \u54620  \u49548 \u47532 \u44032 \'94 (Milman, The History of the Jews, book 13) \u45212 \u45796 \u44256  \u50808 \u52452 \u45796 . \u44536  \u49688 \u49345 \u54620  \u49324 \u46988 \u51008  \u50725 \u50640  \u44039 \u55176 \u50612  \u48268 \u51012  \u48155 \u50520 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u54620  \u47560 \u46356 \u51032  \u50896 \u47581 \u46020  \u54616 \u51648  \u50506 \u50520 \u45796 . \u44536 \u45716  \u50728 \u44054  \u45733 \u50837 \u44284  \u47784 \u50837 \u51012  \u45817 \u54616 \u47732 \u49436 \u46020 , \'93\u54868  \u51080 \u51012 \u51652 \u51200 , \u54868  \u51080 \u51012 \u51652 \u51200  \u50696 \u47336 \u49332 \u47128 \u51060 \u50668 , \u54868  \u51080 \u51012 \u51652 \u51200 , \u54868  \u51080 \u51012 \u51652 \u51200  \u44536  \u44144 \u48124 \u46308 \u51060 \u50668 \'94\u46972 \u44256  \u47568 \u54624  \u49104 \u51060 \u50632 \u45796 . \u44536 \u51032  \u44221 \u44256 \u51032  \u50808 \u52840 \u51008  \u44536  \u51088 \u49888 \u51060  \u50696 \u50616 \u54620  \u44536 \u45824 \u47196  \u50696 \u47336 \u49332 \u47128 \u51060  \u54252 \u50948 \u46104 \u50612  \u44536 \u44032  \u51453 \u45716  \u49692 \u44036 \u44620 \u51648  \u44536 \u52824 \u51648  \u50500 \u45768 \u54616 \u50688 \u45796 .\
