\uc0\u47560 \u53468 \u48373 \u51020  25\u51109 \u51032  \u50676  \u52376 \u45376 \u51032  \u48708 \u50976  \u50669 \u49884  \u51116 \u47548 \u49888 \u46020 \u46308 \u51032  \u44221 \u54744 \u51012  \u51096  \u49444 \u47749 \u54644 \u51456 \u45796 . \u47560 \u53468 \u48373 \u51020  24\u51109 \u50640 \u49436  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u51116 \u47548 \u44284  \u49464 \u49345  \u45149 \u50640  \u51080 \u51012  \u51669 \u51312 \u50640  \u44288 \u54620  \u51228 \u51088 \u46308 \u51032  \u51656 \u47928 \u50640  \u45824 \u45813 \u54616 \u49884 \u47732 \u49436  \u45817 \u49888 \u51032  \u52488 \u47548 \u50640 \u49436  \u51116 \u47548 \u50640  \u51060 \u47476 \u44592 \u44620 \u51648  \u44368 \u54924 \u50752  \u49464 \u44228 \u51032  \u50669 \u49324 \u50640 \u49436  \u51068 \u50612 \u45216  \u44032 \u51109  \u51473 \u50836 \u54620  \u49324 \u44148 \u46308 \u51012  \u51648 \u51201 \u54616 \u49512 \u45796 . \u44536 \u48516 \u44760 \u49436 \u45716  \u50696 \u47336 \u49332 \u47128 \u51032  \u47736 \u47581 , \u51060 \u44368  \u47196 \u47560 \u50752  \u48277 \u50773  \u47196 \u47560 \u51032  \u54605 \u48149  \u50500 \u47000  \u45817 \u54624  \u44368 \u54924 \u51032  \u53360  \u54872 \u45212 , \u54644 \u50752  \u45804 \u51060  \u50612 \u46160 \u50892 \u51648 \u44256  \u48324 \u51060  \u46504 \u50612 \u51648 \u45716  \u49324 \u44148 \u46308 \u51012  \u47568 \u50432 \u54616 \u49512 \u45796 . \u44536  \u54980 \u50640  \u44536 \u48516 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u45208 \u46972 \u47484  \u44148 \u49444 \u54616 \u44592  \u50948 \u54616 \u50668  \u50724 \u49892  \u44163 \u51012  \u47568 \u50432 \u54616 \u49884 \u44256  \u45817 \u49888 \u51032  \u45208 \u53440 \u45208 \u49900 \u51012  \u49324 \u47784 \u54616 \u45716  \u46160  \u48512 \u47448 \u51032  \u51333 \u46308 \u51012  \u47896 \u49324 \u54616 \u45716  \u48708 \u50976 \u47484  \u47568 \u50432 \u54616 \u49512 \u45796 . \u47560 \u53468 \u48373 \u51020  25\u511