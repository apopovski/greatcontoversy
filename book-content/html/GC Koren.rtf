\'93\uc0\u47924 \u51200 \u44081 \u51004 \u47196 \u48512 \u53552  \u50732 \u46972 \u50724 \u45716  \u51664 \u49849 \u51060  \u51200 \u55148 \u47196  \u45908 \u48520 \u50612  \u51204 \u51137 \u51012  \u51068 \u51004 \u53020  \u51200 \u55148 \u47484  \u51060 \u44592 \u44256  \u51200 \u55148 \u47484  \u51453 \u51060 \u47532 \u46972 .\'94 \u54532 \u46993 \u49828  \u54785 \u47749 \u44284  \u44277 \u54252  \u49884 \u45824  \u46041 \u50504 \u50640  \u54532 \u46993 \u49828 \u47484  \u51648 \u48176 \u54616 \u44256  \u51080 \u45912  \u47924 \u49888 \u47200 \u51032  \u49464 \u47141 \u51008  \u54616 \u45208 \u45784 \u44284  \u44536 \u48516 \u51032  \u44144 \u47337 \u54620  \u47568 \u50432 \u50640  \u45824 \u54616 \u50668  \u49912 \u50880 \u51012  \u48268 \u50688 \u45716 \u45936 , \u44536 \u44163 \u51008  \u49464 \u44228 \u44032  \u51068 \u52237 \u51060  \u47785 \u44201 \u54616 \u51648  \u47803 \u54616 \u45912  \u51068 \u51060 \u50632 \u45796 . \u44397 \u54924 \u45716  \u54616 \u45208 \u45784 \u51012  \u50696 \u48176 \u54616 \u51648  \u47803 \u54616 \u46020 \u47197  \u44552 \u51648 \u49884 \u53040 \u45796 . \u44536 \u47532 \u44256  \u49457 \u44221 \u51012  \u47784 \u50500 \u45796 \u44032  \u46112  \u49688  \u51080 \u45716  \u45824 \u47196  \u47784 \u47736 \u51201 \u51064  \u53468 \u46020 \u47484  \u48372 \u51060 \u47732 \u49436  \u44277 \u51473  \u50526 \u50640 \u49436  \u48520 \u53468 \u50892  \u48260 \u47160 \u45796 . \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51008  \u50976 \u47536 \u45817 \u54616 \u44256  \u49457 \u44221 \u50640  \u47749 \u49884 \u46108  \u51228 \u46020 \u46308 \u51008  \u54224 \u51648 \u46104 \u50632 \u45796 . \u47588 \u51452 \u51032  \u55092 \u51068 \u51008  \u44221 \u49884 \u46104 \u50612  \u48260 \u47160 \u44256  \u44536  \u45824 \u49888 \u50640  10\u51068 \u47560 \u45796  \u55092 \u49885 \u54616 \u46104 , \u44536 \u45216 \u51008  \u50672 \u46973 \u54616 \u44256  \u47784 \u46021 \u51201 \u51064  \u51068 \u51012  \u54616 \u45716  \u45936  \u48148 \u52432 \u51276 \u45796 . \u52840 \u47168 \u49885 \u44284  \u49457 \u52268  \u50696 \u49885 \u51008  \u44552 \u51648 \u46104 \u50632 \u44256 , \u47896 \u51648 \u50640 \u45716  \u45576 \u50640  \u46916 \u44172 , \u49324 \u47581 \u51008  \u50689 \u50896 \u54620  \u51104 \u51060 \u46972 \u45716  \u54364 \u51648 \u44032  \u48537 \u50668 \u51276 \u45796 .\
\uc0\u54616 \u45208 \u45784 \u51012  \u44221 \u50808 \u54616 \u45716  \u44163 \u51060  \u51648 \u49885 \u51032  \u44540 \u48376 \u51060 \u46972 \u45716  \u47568 \u50432 \u44284 \u45716  \u51204 \u50672  \u45796 \u47476 \u44172  \u44536 \u44163 \u51012  \u50612 \u47532 \u49437 \u51020 \u51032  \u44540 \u48376 \u51060 \u46972 \u44256  \u54616 \u50688 \u45796 . \u51088 \u50976 \u50752  \u44397 \u44032 \u47484  \u50696 \u48176 \u54616 \u45716  \u51068  \u51060 \u50808 \u50640 \u45716  \u47784 \u46304  \u50696 \u48176 \u44032  \u44552 \u51648 \u46104 \u50632 \u45796 . \'93\u54028 \u47532 \u51032  \u54620  \u51452 \u44368 \u45716  \u44397 \u48124 \u51032  \u45824 \u54364 \u46308  \u50526 \u50640 \u49436  \u50672 \u52636 \u54620  \u44032 \u51109  \u44148 \u51204 \u52824  \u47803 \u54616 \u44256  \u52628 \u51105 \u54620  \u50672 \u44537 \u51032  \u51452 \u50669  \u48176 \u50864 \u47196  \u52636 \u50672 \u54616 \u50688 \u45796 . \'85\u44536 \u45716  \u47592  \u50526 \u50640  \u45208 \u50752 \u49436  \u54924 \u51473 \u51012  \u54693 \u54616 \u50668  \u49440 \u50616 \u54616 \u44592 \u47484  \u51088 \u44592 \u44032  \u50724 \u45720 \u45216 \u44620 \u51648  \u50668 \u47084  \u54644  \u46041 \u50504  \u44032 \u47476 \u52432  \u50728  \u44163 \u51008  \u50612 \u45712  \u51216 \u51004 \u47196  \u48372 \u46304 \u51648  \u54620 \u44051  \u51333 \u44368 \u51201  \u52293 \u47029 \u51060 \u50632 \u44256  \u50669 \u49324 \u45208  \u44144 \u47337 \u54620  \u51652 \u47532 \u50640  \u44540 \u44144 \u47484  \u46164  \u44163 \u51060  \u50500 \u45768 \u50632 \u45796 \u44256  \u54616 \u50688 \u45796 . \u44536 \u45716  \u51221 \u51473 \u54616 \u44256  \u47749 \u48177 \u54620  \u50612 \u51312 \u47196  \u54616 \u45208 \u45784 \u51032  \u49892 \u51316 \u51012  \u48512 \u51064 \u54616 \u44256 , \u51648 \u44552 \u44620 \u51648 \u45716  \u54616 \u45208 \u45784 \u51012  \u50696 \u48176 \u54616 \u45716  \u51068 \u50640  \u54732 \u49888 \u54616 \u50668  \u50772 \u51004 \u45208  \u51109 \u47000 \u50640 \u45716  \u51088 \u50976 \u50752  \u54217 \u46321 \u44284  \u46020 \u51032 \u47484  \u49709 \u48176 \u54616 \u45716  \u51068 \u50640  \u51088 \u49888 \u51012  \u48148 \u52824 \u44192 \u45432 \u46972 \u44256  \u47609 \u49464 \u54616 \u50688 \u45796 . \u44536 \u45716  \u51088 \u44592 \u44032  \u52264 \u44256  \u51080 \u45716  \u51452 \u44368 \u51032  \u51109 \u49885 \u47932 \u46308 \u51012  \u46524 \u50612 \u49436  \u52293 \u49345  \u50948 \u50640  \u45459 \u44256 , \u44536  \u54924 \u47484  \u51452 \u52572 \u54620  \u54924 \u51109 \u44284  \u51061 \u49332 \u49828 \u47084 \u50868  \u54252 \u50745 \u51012  \u54616 \u50688 \u45796 . \u46608  \u47751  \u49324 \u46988 \u51032  \u48176 \u44368 \u54620  \u49888 \u48512 \u46308 \u51060  \u44536  \u51452 \u44368 \u51032  \u48376 \u51012  \u46384 \u46992 \u45796 \'94 (Scott, vol.1, ch.17).\
\'93\uc0\u51060  \u46160  \u49440 \u51648 \u51088 \u44032  \u46405 \u50640  \u44144 \u54616 \u45716  \u51088 \u46308 \u51012  \u44340 \u47213 \u44172  \u54620  \u44256 \u47196  \u46405 \u50640  \u44144 \u54616 \u45716  \u51088 \u46308 \u51060  \u51200 \u55148 \u51032  \u51453 \u51020 \u51012  \u51600 \u44144 \u50892 \u54616 \u44256  \u44592 \u48848 \u54616 \u50668  \u49436 \u47196  \u50696 \u47932 \u51012  \u48372 \u45236 \u47532 \u46972 .\'94 \u47924 \u49888 \u47200 \u51032  \u54532 \u46993 \u49828 \u45716  \u54616 \u45208 \u45784 \u51032  \u46160  \u51613 \u51064 \u51032  \u52293 \u47581 \u54616 \u45716  \u49548 \u47532 \u47484  \u52840 \u47925 \u49884 \u53020  \u48260 \u47160 \u45796 . \u51652 \u47532 \u51032  \u44144 \u47337 \u54620  \u47568 \u50432 \u51008  \u49884 \u52404 \u44032  \u46104 \u50612  \u44536  \u44600 \u44144 \u47532 \u50640  \u45336 \u50612 \u51256  \u51080 \u50632 \u44256 , \u54616 \u45208 \u45784 \u51032  \u51228 \u51116 \u50752  \u50836 \u44396 \u47484  \u49899 \u50612 \u54616 \u45716  \u49324 \u46988 \u46308 \u51008  \u44592 \u48848  \u45216 \u46832 \u50632 \u45796 . \u49324 \u46988 \u46308 \u51008  \u44277 \u44277 \u50672 \u54616 \u44172  \u54616 \u45720 \u51032  \u50773 \u51012  \u47784 \u46021 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u50715 \u45216 \u51032  \u51396 \u51064 \u46308 \u52376 \u47100  \'93\u54616 \u45208 \u45784 \u51060  \u50612 \u52236  \u50508 \u47028  \u51648 \u44537 \u55176  \u45458 \u51008  \u51088 \u50640 \u44172  \u51648 \u49885 \u51060  \u51080 \u51004 \u47028 \'94 (\u49884  73:11) \u44256  \u48512 \u47476 \u51670 \u50632 \u45796 .\
\uc0\u49352 \u47196 \u50868  \u51228 \u46020 \u50640  \u51032 \u54616 \u50668  \u51076 \u47749 \u46108  \u54620  \u49849 \u47140 \u45716  \u44144 \u51032  \u48127 \u51012  \u49688  \u50630 \u51012  \u47564 \u53372  \u47784 \u46021 \u51201 \u51064  \u50616 \u49324 \u47196  \u47568 \u54616 \u50688 \u45796 . \'93\u54616 \u45208 \u45784 \u51060 \u50668 , \u47564 \u51068  \u45817 \u49888 \u51060  \u52280 \u51004 \u47196  \u51316 \u51116 \u54616 \u47732  \u45817 \u49888 \u51032  \u55036 \u49552 \u46108  \u51060 \u47492 \u51012  \u50948 \u54616 \u50668  \u48373 \u49688 \u54644  \u48372 \u46972 . \u45208 \u45716  \u45817 \u49888 \u44760  \u46020 \u51204 \u54620 \u45796 . \u45817 \u49888 \u51008  \u52840 \u47925 \u51012  \u51648 \u53412 \u44256  \u51080 \u44396 \u47140 . \u45817 \u49888 \u51008  \u44048 \u55176  \u44201 \u45432 \u52824  \u47803 \u54616 \u45716 \u44400 . \u51060 \u51228  \u54980 \u47196  \u45572 \u44032  \u45817 \u49888 \u51032  \u51316 \u51116 \u47484  \u48127 \u44192 \u45716 \u44032 ?\'94 (Lacretelle, History, vol.11.p.309; in Sir Archivald Alison, History of Europe, vol.1, ch.10). \u44536 \u44163 \u51008  \'93\u50668 \u54840 \u50752 \u44032  \u45572 \u44396 \u44288 \u45824  \u45236 \u44032  \u44536  \u47568 \u51012  \u46308 \u51004 \u47532 \u50724  \u50668 \u54840 \u50752 \u45716  \u45208 \u51032  \u50508  \u48148  \u50500 \u45768 \u46972 \'94\u44256  \u54620  \u48148 \u47196 \u51032  \u47568 \u51060  \u44536 \u45824 \u47196  \u48152 \u54693 \u46108  \u44163 \u51060  \u50500 \u45768 \u44256  \u47924 \u50631 \u51060 \u44192 \u45716 \u44032 ?\
\'93\uc0\u50612 \u47532 \u49437 \u51008  \u51088 \u45716  \u44536  \u47560 \u51020 \u50640  \u51060 \u47476 \u44592 \u47484  \u54616 \u45208 \u45784 \u51060  \u50630 \u45796  \u54616 \u46020 \u45796 \'94 (\u49884  14:1). \u44536 \u47084 \u45208  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u51652 \u47532 \u47484  \u50780 \u44257 \u49884 \u53412 \u45716  \u51088 \u46308 \u50640  \u45824 \u54616 \u50668  \'93\u51200 \u55148 \u44032  \u45908  \u45208 \u44032 \u51648  \u47803 \u54624  \u44163 \u51008  \u51200  \u46160  \u49324 \u46988 \u51032  \u46108  \u44163 \u44284  \u44057 \u51060  \u51200 \u55148  \u50612 \u47532 \u49437 \u51020 \u51060  \u46300 \u47084 \u45216  \u44163 \u51076 \u51060 \u46972 \'94 (\u46372 \u54980  3:9) \u44256  \u47568 \u50432 \u54616 \u49888 \u45796 . \u54532 \u46993 \u49828 \u45716  \'93\u51648 \u51316  \u47924 \u49345 \u54616 \u47728  \u50689 \u50896 \u55176  \u44144 \u54616 \'94 (\u49324  57:15) \u47728  \u49332 \u50500  \u44228 \u49888  \u54616 \u45208 \u45784 \u51012  \u44221 \u48176 \u54616 \u45716  \u51068 \u51012  \u44144 \u51208 \u54620  \u51648  \u50724 \u47000 \u51648  \u50500 \u45768 \u54616 \u50668  \u49548 \u50948  \u51060 \u49457  (\u63972 \u24615 ) \u51032  \u50668 \u49888 \u51060 \u46972 \u45716  \u50676 \u46321 \u54620  \u50864 \u49345 \u49709 \u48176 \u47196  \u51204 \u46973 \u54616 \u50688 \u45716 \u45936 , \u48169 \u53461 \u54620  \u54620  \u50668 \u51088 \u44032  \u44536  \u50668 \u49888 \u51060  \u46104 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44536  \u51068 \u51008  \u44397 \u48124 \u51032  \u45824 \u54364 \u51201  \u51665 \u54924 \u50640 \u49436 , \u54665 \u51221  \u48143  \u51077 \u48277 \u51032  \u52572 \u44256 \u51032  \u44428 \u50948 \u50640  \u51032 \u54616 \u50668  \u44208 \u51221 \u46104 \u50632 \u45912  \u44163 \u51060 \u45796 . \u50612 \u45712  \u50669 \u49324 \u44032 \u45716  \u51060 \u47111 \u44172  \u47568 \u54616 \u50688 \u45796 . \'93\u51060  \u44305 \u46976  (\u29378 \u20098 ) \u51032  \u49884 \u45824 \u50640  \u54665 \u54620  \u51032 \u49885  (\u20736 \u24335 ) \u51473 \u51032  \u54616 \u45208 \u45716  \u54728 \u47581 \u54620  \u51068 \u44284  \u48520 \u44221 \u54620  \u51068 \u51012  \u54844 \u54633 \u49884 \u53416  \u51216 \u50640 \u49436  \u45804 \u47532  \u50976 \u47168 \u47484  \u52286 \u51012  \u49688  \u50630 \u45796 . \u51020 \u50501 \u45824 \u47484  \u49440 \u46160 \u50640  \u46164  \u46020 \u49884 \u51032  \u44288 \u47532 \u46308 \u51008  \u54876 \u51677  \u50676 \u47536  \u51032 \u51109  (\u35696 \u22580 ) \u51032  \u47928 \u51012  \u53685 \u54616 \u50668  \u51109 \u51473 \u54620  \u54665 \u47148 \u51012  \u51648 \u50612  \u45208 \u50752 \u49436  \u51088 \u50976 \u51032  \u45432 \u47000 \u47484  \u45458 \u51060  \u48512 \u47476 \u47732 \u49436  \u44536 \u46308 \u51060  \u48148 \u50556 \u55120 \u47196  \u44221 \u48176 \u54616 \u47140 \u45716  \u45824 \u49345 , \u44263  \u44536 \u46308 \u51060  \u51060 \u49457 \u51032  \u50668 \u49888 \u51060 \u46972 \u44256  \u48512 \u47476 \u45716  \u47732 \u49324 \u54252 \u47484  \u50420  \u54620  \u50668 \u51088 \u47484  \u49688 \u54665 \u54616 \u50688 \u45796 . \u44536  \u54665 \u47148 \u51060  \u49885 \u51109  \u50504 \u50640  \u46308 \u50612 \u44032 \u51088  \u51060 \u49457 \u51032  \u50668 \u49888 \u51008  \u47732 \u49324 \u54252 \u47484  \u48279 \u50612  \u51060 \u44163 \u51012  \u54924 \u51109  (\u26371 \u38263 ) \u51032  \u50724 \u47480 \u54200 \u50640  \u46160 \u50632 \u45796 . \u44536  \u46412 \u50640  \u50668 \u51088 \u45716  \u50724 \u54168 \u46972 \u45800 \u51032  \u54620  \u47924 \u55148 \u47196  \u48157 \u54784 \u51276 \u45796 . \'85\u54532 \u46993 \u49828 \u51032  \u44397 \u48124  \u51032 \u54924 \u45716  \u44536  \u50668 \u51088 \u47484  \u44536 \u46308 \u51060  \u49709 \u48176 \u54616 \u44592 \u50640  \u44032 \u51109  \u51201 \u54633 \u54620  \u51060 \u49457 \u51060 \u46972 \u44256  \u54616 \u50668  \u44536 \u50640 \u44172  \u44277 \u51201 \u51064  \u44221 \u48176 \u47484  \u54616 \u50688 \u45796 .\'94\
\'93\uc0\u51060  \u48520 \u44221 \u44148 \u54616 \u44256  \u50612 \u47532 \u49437 \u51008  \u51032 \u49885 \u51008  \u53945 \u49688 \u54620  \u54805 \u49885 \u51004 \u47196  \u51652 \u54665 \u46104 \u50632 \u45796 . \u44536 \u47532 \u54616 \u50668  \u51060 \u49457 \u51032  \u50668 \u49888 \u51032  \u51228 \u47561 \u49885 \u51008  \u51204 \u44397 \u51201 \u51004 \u47196  \u48372 \u44553 \u46104 \u50612  \u54785 \u47749 \u51032  \u47784 \u46304  \u49464 \u47141 \u50640  \u44277 \u47749 \u54620 \u45796 \u45716  \u46907 \u51012  \u54364 \u49884 \u54616 \u44256 \u51088  \u54616 \u45716  \u49324 \u46988 \u46308 \u51060  \u49324 \u45716  \u44275 \u50640 \u49436 \u45716  \u50612 \u46356 \u50640 \u49436 \u45208  \u44536 \u44163 \u51012  \u51116 \u50672 \u54616 \u44144 \u45208  \u47784 \u48169 \u54644 \u49436  \u44144 \u54665 \u54616 \u50688 \u45796 \'94 (Scott, vol.1, ch.17).\
