\f0\b \cf0 \uc0\u50948 \u53364 \u47532 \u54532 \u51032  \u49888 \u50521 \u44284  \u49457 \u44221 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u50948 \u53364 \u47532 \u54532 \u45716  \u51088 \u44592 \u44032  \u54616 \u45208 \u45784 \u44760  \u44228 \u49549 \u54644 \u49436  \u52649 \u49457 \u54620 \u45796 \u47732  \u51088 \u44592 \u51032  \u49373 \u47749 \u51060  \u55148 \u49373 \u45817 \u54624  \u44163 \u51060 \u46972 \u44256  \u44618 \u51060  \u49373 \u44033 \u54616 \u44256  \u51080 \u50632 \u45796 . \u50773 \u44284  \u48277 \u50773 \u44284  \u44048 \u46021 \u46308 \u51060  \u47784 \u46160  \u55192 \u51012  \u54633 \u54616 \u50668  \u44536 \u47484  \u51453 \u51060 \u47140 \u44256  \u54616 \u50688 \u51004 \u48064 \u47196  \u44536 \u45716  \u45734 \u50612 \u46020  \u49688 \u44060 \u50900  \u54980 \u50640 \u45716  \u53952 \u47548 \u50630 \u51060  \u54868 \u54805 \u50640  \u52376 \u54616 \u44172  \u46112  \u44163 \u52376 \u47100  \u48372 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u51032  \u50857 \u44592 \u45716  \u51312 \u44552 \u46020  \u55124 \u46308 \u47532 \u51648  \u50500 \u45768 \u54616 \u50688 \u45796 . \u44536 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u54616 \u50688 \u45796 . \'93\u50612 \u52236 \u54616 \u50668  \u45320 \u55148 \u46308 \u51008  \u49692 \u44368 \u51088 \u51032  \u47732 \u47448 \u44288 \u51012  \u47680 \u47532 \u49436  \u52286 \u44256  \u51080 \u45432 \u46972 \u44256  \u47568 \u54616 \u45712 \u45264 ? \u44536 \u47532 \u49828 \u46020 \u51032  \u48373 \u51020 \u51012  \u51200  \u44368 \u47564 \u54620  \u51452 \u44368 \u46308 \u50640 \u44172  \u51204 \u54616 \u46972 . \u44536 \u47532 \u54616 \u47732  \u49692 \u44368 \u45716  \u53952 \u47548 \u50630 \u51060  \u50724 \u44256  \u47568  \u44163 \u51060 \u45796 . \u49332 \u50500 \u49436  \u52840 \u47925 \u51012  \u51648 \u53412 \u44256  \u51080 \u50612 \u50556  \u54620 \u45796 \u44256 ? \u44208 \u45800 \u53076  \u50504  \u46112  \u47568 \u51060 \u45796 . \u53444 \u50517 \u54616 \u47140 \u44144 \u46304  \u54644 \u48372 \u46972 . \u45208 \u45716  \u44536  \u51068 \u51060  \u51080 \u44592 \u47484  \u44592 \u45796 \u47532 \u44256  \u51080 \u45796 \'94 (D\'92Aubigne, b.17, ch.8).\
\uc0\u44536 \u47084 \u45208  \u54616 \u45208 \u45784 \u51032  \u49453 \u47532 \u45716  \u50668 \u51204 \u55176  \u45817 \u49888 \u51032  \u51333 \u51012  \u48372 \u54840 \u54616 \u50688 \u45796 . \u51088 \u44592 \u51032  \u50728  \u49373 \u50528 \u47484  \u53685 \u54616 \u50668  \u45216 \u47560 \u45796  \u49373 \u47749 \u51032  \u50948 \u54744 \u51012  \u47924 \u47493 \u50416 \u44256  \u45812 \u45824 \u55176  \u51652 \u47532 \u47484  \u50745 \u54840 \u54616 \u44256  \u51080 \u45716  \u51060  \u49324 \u46988 \u51008  \u50896 \u49688 \u46308 \u51032  \u51613 \u50724 \u51032  \u55148 \u49373 \u47932 \u47196  \u50416 \u47084 \u51656  \u44163 \u51060  \u50500 \u45768 \u50632 \u45796 . \u50948 \u53364 \u47532 \u54532 \u45716  \u51204 \u54784  \u51088 \u44592  \u51088 \u49888 \u51012  \u48372 \u54840 \u54616 \u44256 \u51088  \u54616 \u51648  \u50500 \u45768 \u54616 \u50688 \u51648 \u47564  \u51452 \u45784 \u44760 \u49436  \u44536 \u51032  \u48372 \u54840 \u51088 \u44032  \u46104 \u49512 \u45796 . \u48148 \u50556 \u55120 \u47196  \u44536 \u51032  \u50896 \u49688 \u46308 \u51060  \u53952 \u47548 \u50630 \u51060  \u44536 \u47484  \u55148 \u49373  \u51228 \u47932 \u47196  \u49340 \u51012  \u49688  \u51080 \u45796 \u44256  \u45712 \u45184  \u48148 \u47196  \u44536  \u49692 \u44036 \u50640 , \u54616 \u45208 \u45784 \u51032  \u49552 \u51008  \u44536 \u46308 \u51032  \u49552 \u51060  \u48120 \u52824 \u51648  \u47803 \u54624  \u44275 \u51004 \u47196  \u44536 \u47484  \u50734 \u44592 \u49512 \u45796 . \u44536 \u45716  \u47336 \u53552 \u50892 \u46300 \u50640  \u51080 \u45716  \u51088 \u44592 \u51032  \u44368 \u54924 \u50640 \u49436  \u49457 \u52268 \u49885 \u51012  \u51665 \u47168 \u54616 \u47140 \u44256  \u54616 \u45796 \u44032  \u44049 \u51088 \u44592  \u51473 \u54413 \u48337 \u51004 \u47196  \u50416 \u47084 \u51276 \u45716 \u45936  \u44536  \u50620 \u47560  \u54980 \u50640  \u49324 \u47581 \u54616 \u50688 \u45796 .\
\uc0\u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u50948 \u53364 \u47532 \u54532 \u50640 \u44172  \u44536 \u51032  \u49324 \u50629 \u51012  \u51648 \u51221 \u54644  \u51452 \u49512 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u44536 \u51032  \u51077 \u50640  \u51652 \u47532 \u51032  \u47568 \u50432 \u51012  \u51452 \u49884 \u44256 , \u44536  \u47568 \u50432 \u51060  \u48177 \u49457 \u46308 \u50640 \u44172  \u51204 \u54644 \u51648 \u44172  \u54616 \u49884 \u44256 \u51088  \u44536 \u51032  \u49888 \u48320 \u51012  \u51648 \u53412 \u49512 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44060 \u54785 \u51032  \u50948 \u45824 \u54620  \u49324 \u50629 \u51012  \u50948 \u54620  \u44592 \u52488 \u44032  \u45459 \u51068  \u46412 \u44620 \u51648  \u44536 \u51032  \u49373 \u47749 \u51008  \u48372 \u54840 \u46104 \u44256 , \u44536 \u51032  \u54876 \u46041 \u51008  \u50672 \u51109 \u46104 \u50632 \u45796 .\
\uc0\u50948 \u53364 \u47532 \u54532 \u45716  \u50516 \u55121 \u49884 \u45824 \u51032  \u55121 \u50516  \u49549 \u50640 \u49436  \u45208 \u53440 \u45228 \u45796 . \u44536 \u50752  \u44057 \u51060  \u44060 \u54785  \u49324 \u50629 \u51032  \u44592 \u52488 \u47484  \u45459 \u51008  \u49324 \u46988 \u51060  \u44536  \u51204 \u50640 \u45716  \u54620  \u49324 \u46988 \u46020  \u50630 \u50632 \u45796 . \u52840 \u47168  \u50836 \u54620 \u44284  \u44057 \u51060  \u44536 \u45716  \u53945 \u49688 \u54620  \u49324 \u47749 \u51012  \u49688 \u54665 \u54616 \u44592  \u50948 \u54616 \u50668  \u51068 \u50612 \u45212  \u49352  \u49884 \u45824 \u51032  \u49440 \u44396 \u51088 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u44032  \u48157 \u54784 \u45240  \u51652 \u47532 \u51032  \u52404 \u44228 \u45716  \u44536  \u54980 \u51032  \u44060 \u54785 \u51088 \u46308 \u51060  \u48120 \u52824 \u51648  \u47803 \u54624  \u49104  \u50500 \u45768 \u46972  \u50612 \u46500  \u44163 \u46308 \u51008  \u44536  \u54980  \u48177 \u45380 \u51060  \u51648 \u45208 \u49436 \u46020  \u48120 \u52832  \u49688  \u50630 \u51012  \u47564 \u53372  \u53685 \u51068 \u49457 \u44284  \u50756 \u51204 \u49457 \u51060  \u51080 \u50632 \u45796 . \u44536  \u44592 \u52488 \u45716  \u45331 \u44256  \u44618 \u51004 \u47728 , \u44536  \u44396 \u51312 \u45716  \u53948 \u53948 \u54616 \u44256  \u50756 \u51204 \u54616 \u48064 \u47196  \u44536  \u54980 \u50640  \u45208 \u53440 \u45212  \u49324 \u46988 \u46308 \u51060  \u44536 \u44163 \u51012  \u51116 \u44148 \u54624  \u54596 \u50836 \u44032  \u50630 \u50632 \u45796 .\
\uc0\u50948 \u53364 \u47532 \u54532 \u44032  \u52265 \u49688 \u54620  \u50948 \u45824 \u54620  \u50868 \u46041 , \u44263  \u50577 \u49900 \u44284  \u51648 \u49457 \u51012  \u54644 \u48169 \u49884 \u53020  \u51452 \u44256 , \u51656 \u44257  (\u26702 \u26767 ) \u50640  \u49549 \u48149 \u46104 \u50612  \u51080 \u45912  \u50668 \u47084  \u45208 \u46972 \u46308 \u50640 \u44172  \u51088 \u50976 \u47484  \u51456  \u50868 \u46041 \u51032  \u44540 \u50896 \u51008  \u49457 \u44221 \u51060 \u45796 . 14\u49464 \u44592  \u51060 \u47000  \u44033  \u49884 \u45824 \u47484  \u53685 \u54616 \u50668  \u47560 \u52824  \u49373 \u47749 \u49688 \u52376 \u47100  \u55128 \u47084 \u45236 \u47536  \u52629 \u48373 \u51032  \u44540 \u50896 \u51008  \u48148 \u47196  \u49457 \u44221 \u51060 \u50632 \u45796 . \u50948 \u53364 \u47532 \u54532 \u45716  \u45800 \u49692 \u54620  \u47560 \u51020 \u51004 \u47196  \u49457 \u44221 \u51012  \u54616 \u45208 \u45784 \u51032  \u46907 \u50640  \u45824 \u54620  \u50689 \u44048 \u51032  \u44228 \u49884 \u50836 , \u48127 \u51020 \u44284  \u54665 \u49892 \u51032  \u50756 \u51204 \u54620  \u54364 \u51456 \u51004 \u47196  \u48155 \u50500 \u46308 \u50688 \u45796 . \u44536 \u45716  \u51068 \u52237 \u51060  \u47196 \u47560 \u44368 \u54924 \u47484  \u44144 \u47337 \u54616 \u44256  \u51208 \u45824  \u47924 \u47448 \u51032  \u44428 \u50948 \u47484  \u44032 \u51652  \u44368 \u54924 \u47196  \u50668 \u44592 \u44256 , \u52380 \u50668  \u45380  \u46041 \u50504 \u50640  \u44152 \u52432 \u49436  \u54869 \u47549 \u46108  \u44536  \u44368 \u47532 \u50752  \u44288 \u49845 \u51012  \u51208 \u45824 \u51201 \u51064  \u51316 \u44221 \u49900 \u51004 \u47196  \u48155 \u50500 \u46308 \u50668 \u50556  \u54620 \u45796 \u45716  \u44368 \u50977 \u51012  \u48155 \u50520 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u54616 \u45208 \u45784 \u51032  \u44144 \u47337 \u54620  \u47568 \u50432 \u51012  \u49692 \u51333 \u54616 \u44592  \u50948 \u54616 \u50668  \u51060  \u47784 \u46304  \u44163 \u46308 \u47196 \u48512 \u53552  \u46028 \u50500 \u49456 \u45796 . \u51060  \u44144 \u47337 \u54620  \u47568 \u50432 \u51008  \u44536 \u44032  \u48177 \u49457 \u46308 \u47196  \u54616 \u50668 \u44552  \u44648 \u45803 \u44172  \u54616 \u44256 \u51088  \u50669 \u49444 \u54620  \u44428 \u50948 \u51032  \u47568 \u50432 \u51060 \u50632 \u45796 . \u50976 \u51068 \u51032  \u52280  \u44428 \u50948 \u45716  \u48277 \u50773 \u51012  \u53685 \u54616 \u50668  \u47568 \u54616 \u44256  \u51080 \u45716  \u44368 \u54924 \u44032  \u50500 \u45768 \u46972 , \u49457 \u44221 \u51012  \u53685 \u54616 \u50668  \u47568 \u50432 \u54616 \u49884 \u45716  \u54616 \u45208 \u45784 \u51032  \u51020 \u49457 \u51060 \u46972 \u44256  \u44536 \u45716  \u51452 \u51109 \u54616 \u50688 \u45796 . \u44536 \u47532 \u44256  \u44536 \u45716  \u49457 \u44221 \u51060  \u54616 \u45208 \u45784 \u51032  \u46907 \u51032  \u50756 \u51204 \u54620  \u44228 \u49884 \u51064  \u46041 \u49884 \u50640 , \u49457 \u47161 \u44760 \u49436  \u49457 \u44221 \u51032  \u50976 \u51068 \u54620  \u54644 \u49437 \u51088 \u51060 \u48064 \u47196  \u47784 \u46304  \u49324 \u46988 \u46308 \u51008  \u49457 \u44221 \u51032  \u44032 \u47476 \u52840 \u51012  \u50672 \u44396 \u54616 \u50668  \u49828 \u49828 \u47196  \u51088 \u44592 \u51032  \u48376 \u48516 \u51012  \u44648 \u45804 \u50500 \u50556  \u54620 \u45796 \u44256  \u44032 \u47476 \u52452 \u45796 . \u44536 \u47111 \u44172  \u54616 \u50668  \u44536 \u45716  \u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u51012  \u48277 \u50773 \u44284  \u47196 \u47560 \u44368 \u54924 \u47196 \u48512 \u53552  \u49457 \u44221  \u47568 \u50432 \u51004 \u47196  \u46028 \u51060 \u53040 \u45796 .\
