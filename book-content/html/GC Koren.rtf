\uc0\u44201 \u45432 \u54620  \u54253 \u46020 \u46308 \u50640 \u44172 \u49436  \u44148 \u51664 \u51012  \u48155 \u51008  \u44221 \u50864 \u46308  \u51473 \u51032  \u54620  \u44032 \u51648 \u50640  \u45824 \u54616 \u50668  \u50920 \u49836 \u47532 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u54616 \u50688 \u45796 . \'93\u50864 \u47532 \u44032  \u48120 \u45124 \u47084 \u51648 \u44592  \u49772 \u50868  \u48708 \u53448 \u44600 \u51012  \u53685 \u54616 \u50668  \u44152 \u50612  \u45236 \u47140 \u44032 \u44256  \u51080 \u45716  \u46041 \u50504 , \u47566 \u51008  \u49324 \u46988 \u46308 \u51060  \u45208 \u47484  \u50500 \u47000 \u47196  \u46504 \u50612 \u46888 \u47532 \u44256 \u51088  \u50528 \u47484  \u50044 \u45796 . \u47564 \u51068  \u45236 \u44032  \u51068 \u45800  \u45336 \u50612 \u51276 \u51012  \u44163  \u44057 \u51004 \u47732 , \u50500 \u47560 \u46020  \u45208 \u45716  \u45796 \u49884  \u51068 \u50612 \u45216  \u49688  \u50630 \u50632 \u51012  \u44163 \u51060 \u46972 \u44256  \u49373 \u44033 \u54620 \u45796 . \u44536 \u47084 \u45208  \u45208 \u45716  \u54620  \u48264 \u46020  \u48708 \u53952 \u44144 \u47532 \u44144 \u45208  \u48120 \u45124 \u47084 \u51648 \u51648  \u50506 \u44256  \u50756 \u51204 \u55176  \u44536 \u46308 \u51032  \u49552 \u50640 \u49436  \u48736 \u51256 \u45208 \u50772 \u45796 . \'85\u48708 \u47197  \u47566 \u51008  \u49324 \u46988 \u46308 \u51060  \u45208 \u51032  \u52860 \u46972 \u50752  \u50743 \u51012  \u48537 \u51105 \u44256  \u45336 \u50612 \u46888 \u47532 \u47140 \u44256  \u50528 \u47484  \u50044 \u51004 \u45208  \u44536 \u46308 \u51008  \u44208 \u44397  \u45800 \u45800 \u55176  \u48537 \u46308  \u49688  \u50630 \u50632 \u45796 . \u50724 \u51649  \u54620  \u49324 \u46988 \u51060  \u45208 \u51032  \u54840 \u51452 \u47672 \u45768  \u46748 \u44753 \u51012  \u45800 \u45800 \u55176  \u48537 \u51105 \u50520 \u45716 \u45936  \u44536  \u48512 \u48516 \u47564  \u44536 \u51032  \u49552 \u50640  \u46895 \u44200 \u51648 \u44256  \u47568 \u50520 \u45796 . \u44536 \u47532 \u44256  \u45796 \u47480  \u51901  \u54840 \u51452 \u47672 \u45768 \u50640 \u45716  \u51008 \u54665  \u49688 \u54364 \u44032  \u46308 \u50612  \u51080 \u50632 \u45716 \u45936 , \u51452 \u47672 \u45768  \u46748 \u44753 \u51032  \u51208 \u48152 \u47564 \u51060  \u52258 \u50612 \u51648 \u44256  \u47568 \u50520 \u45796 . \'85\u48148 \u47196  \u45236  \u46244 \u50640  \u51080 \u45912  \u44148 \u51109 \u54620  \u49324 \u46988 \u51060  \u53360  \u52280 \u45208 \u47924  \u47805 \u46181 \u51060 \u47196  \u45208 \u47484  \u50668 \u47084  \u52264 \u47168  \u46412 \u47160 \u45796 . \u44536 \u44032  \u47564 \u51068  \u44536 \u44163 \u51004 \u47196  \u45208 \u51032  \u46244 \u53685 \u49688 \u47484  \u46412 \u47160 \u45912 \u46308  \u45208 \u45716  \u44536 \u47564  \u51453 \u50632 \u51012  \u44163 \u51060 \u45796 . \u44536 \u47084 \u45208  \u47924 \u49832  \u44620 \u45805 \u51064 \u51648 \u45716  \u47792 \u46972 \u46020  \u46412 \u47540  \u46412 \u47560 \u45796  \u44536  \u47805 \u46181 \u51060 \u45716  \u48727 \u45208 \u44052 \u45796 . \u45208 \u45716  \u44536  \u46412 \u50640  \u51340 \u47196 \u45208  \u50864 \u47196  \u47800 \u51012  \u50880 \u51649 \u51068  \u49688  \u50630 \u50632 \u50632 \u45796 . \u46608  \u54620  \u49324 \u46988 \u51060  \u44400 \u51473 \u51012  \u54756 \u52824 \u44256  \u45804 \u47140 \u50752 \u49436  \u51452 \u47673 \u51004 \u47196  \u45208 \u47484  \u54980 \u47140 \u52452 \u45796 . \u44536 \u47084 \u45208  \u44536 \u51032  \u51452 \u47673 \u51008  \u44200 \u50864  \u45208 \u51032  \u47672 \u47532 \u47484  \u51312 \u44552  \u49828 \u52452 \u51012  \u49104 \u51060 \u50632 \u45796 . \u44536 \u45716  \'91\u51060  \u49324 \u46988 \u51032  \u47672 \u47532 \u52860 \u51060  \u50612 \u52236  \u51060 \u47111 \u44172 \u46020  \u48512 \u46300 \u47084 \u50872 \u44620 \'92\u46972 \u44256  \u47568 \u54616 \u50688 \u45796 . \'85\u48148 \u47196  \u52376 \u51020 \u51004 \u47196  \u54924 \u44060 \u54620  \u49324 \u46988 \u46308 \u51008  \u44536  \u49884 \u44032 \u51032  \u44641 \u54056  \u46160 \u47785 \u46308 \u51060 \u47728 , \u44536 \u46308  \u51473 \u51032  \u54620  \u49324 \u46988 \u51008  \u49884 \u45124 \u47084 \u50868  \u49324 \u53468 \u44032  \u49373 \u44600  \u46412 \u50640  \u46024 \u51012  \u48155 \u44256  \u49912 \u50864 \u45716  \u51068 \u51012  \u51648 \u44552 \u44751  \u54644 \u50724 \u44256  \u51080 \u50632 \u45796 .\
\uc0\u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u46907 \u45824 \u47196  \u51456 \u48708 \u49884 \u53412 \u44592  \u50948 \u54616 \u50668  \u50620 \u47560 \u45208  \u48512 \u46300 \u47084 \u50868  \u48169 \u48277 \u51012  \u49324 \u50857 \u54616 \u49884 \u45716 \u51648 ! 2\u45380  \u51204 \u50640 \u45716  \u54620  \u44060 \u51032  \u48317 \u46028  \u51312 \u44033 \u51060  \u45208 \u51032  \u50612 \u44648 \u47484  \u49828 \u52824 \u44256  \u51648 \u45208 \u44052 \u45796 . \u44536  \u54980  1\u45380 \u51060  \u51648 \u45208 \u49436 \u45716  \u46028 \u51060  \u45208 \u51032  \u50577 \u48120 \u44036 \u51012  \u47582 \u54804 \u45796 . \u51648 \u45212 \u45804 \u50640 \u45716  \u54620  \u48264  \u47588 \u47484  \u47582 \u44256  \u50724 \u45720  \u51200 \u45377 \u50640 \u45716  \u49457 \u50640  \u46308 \u50612 \u50724 \u47732 \u49436  \u54620  \u48264 , \u45208 \u44032 \u47732 \u49436  \u54620  \u48264 , \u46160  \u48264 \u51012  \u47582 \u50520 \u51004 \u45208  \u47784 \u46160  \u50500 \u47924 \u47088  \u51068 \u51060  \u50630 \u50632 \u45796 . \u54620  \u49324 \u46988 \u51008  \u51080 \u45716  \u55192 \u51012  \u45796 \u54644 \u49436  \u45208 \u51032  \u44032 \u49844 \u51012  \u52452 \u44256 , \u46608  \u45796 \u47480  \u49324 \u46988 \u51008  \u54588 \u44032  \u50143 \u50500 \u51648 \u47532  \u47564 \u53372  \u55192  \u51080 \u44172  \u45208 \u51032  \u51077 \u51012  \u52452 \u45796 . \u44536 \u47084 \u45208  \u45208 \u45716  \u44536  \u50612 \u46500  \u44163 \u50640  \u45824 \u54616 \u50668 \u49436 \u46020  \u45796 \u47564  \u48335 \u51674 \u51004 \u47196  \u45208 \u47484  \u52824 \u45716  \u51221 \u46020  \u51060 \u49345 \u51032  \u50500 \u54548 \u51008  \u45712 \u45180 \u51648  \u50506 \u50520 \u45796 \'94 (John Wesley, Works, Vol.3, pp.297, 298).\
