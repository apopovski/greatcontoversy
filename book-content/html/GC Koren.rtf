\uc0\u54616 \u45208 \u45784 \u44760 \u49436  \u53945 \u48324 \u55176  \u44536  \u49884 \u45824 \u50640  \u51201 \u54633 \u54620  \u51652 \u47532 \u47484  \u51613 \u44144 \u54616 \u44592  \u50948 \u54616 \u50668  \u49324 \u50857 \u54616 \u49884 \u45716  \u47784 \u46304  \u49324 \u46988 \u51008  \u48152 \u45824 \u47484  \u45817 \u54616 \u44172  \u46104 \u50612  \u51080 \u45796 . \u47336 \u53552 \u51032  \u49884 \u45824 \u50640 \u45716  \u44536  \u49884 \u45824 \u50640  \u53945 \u48324 \u55176  \u50836 \u44596 \u54620  \u54788 \u45824  \u51652 \u47532 \u44032  \u51080 \u50632 \u45796 . \u44536 \u50752  \u47560 \u52268 \u44032 \u51648 \u47196  \u50724 \u45720 \u45216 \u51032  \u44368 \u54924 \u50640 \u46020  \u54788 \u45824  \u51652 \u47532 \u44032  \u51080 \u45796 . \u47784 \u46304  \u44163 \u51012  \u45817 \u49888 \u51032  \u46907 \u51012  \u46384 \u46972  \u54665 \u54616 \u49884 \u45716  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u49324 \u46988 \u46308 \u51012  \u45796 \u50577 \u54620  \u54872 \u44221  \u50500 \u47000  \u46160 \u49884 \u44256 , \u44536 \u46308 \u51060  \u49373 \u54876 \u54616 \u45716  \u49884 \u45824 \u50752  \u44536 \u46308 \u51060  \u52376 \u54620  \u49345 \u54889 \u50640  \u51201 \u54633 \u54620  \u51032 \u47924 \u46308 \u51012  \u49688 \u54665 \u54616 \u44592 \u47484  \u48148 \u46972 \u49888 \u45796 . \u47564 \u51068  \u44536 \u46308 \u51060  \u48155 \u51008 \u48148  \u51652 \u47532 \u47484  \u51316 \u51473 \u54624  \u44163  \u44057 \u51004 \u47732 , \u45908 \u50865  \u45331 \u51008  \u51652 \u47532 \u51032  \u49884 \u50556 \u44032  \u44536 \u46308  \u50526 \u50640  \u50676 \u47140 \u51656  \u44163 \u51060 \u45796 . \u44536 \u47084 \u45208  \u51652 \u47532 \u45716  \u48277 \u50773 \u44368 \u46020 \u46308 \u51060  \u47336 \u53552 \u47484  \u48152 \u45824 \u54664 \u45912  \u44163 \u52376 \u47100  \u50724 \u45720 \u45216  \u45824 \u45796 \u49688 \u51032  \u49324 \u46988 \u46308 \u50640 \u44172  \u54872 \u50689 \u51012  \u48155 \u51648  \u47803 \u54616 \u44256  \u51080 \u45796 . \u50724 \u45720 \u45216 \u46020  \u50715 \u45216 \u52376 \u47100  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432  \u45824 \u49888 \u50640  \u49324 \u46988 \u46308 \u51032  \u51060 \u47200 \u44284  \u51204 \u49444 \u51012  \u48155 \u50500 \u46308 \u51060 \u45716  \u46041 \u51068 \u54620  \u44221 \u54693 \u51060  \u51080 \u45796 . \u51060  \u49884 \u45824 \u47484  \u50948 \u54620  \u51652 \u47532 \u47484  \u51613 \u44144 \u54616 \u45716  \u49324 \u46988 \u46308 \u51008  \u52488 \u44592 \u51032  \u44060 \u54785 \u51088 \u46308 \u48372 \u45796  \u45908  \u53360  \u54872 \u50689 \u51012  \u48155 \u51012  \u44163 \u51060 \u46972 \u44256  \u44592 \u45824 \u54644 \u49436 \u45716  \u50504  \u46108 \u45796 . \u51652 \u47532 \u50752  \u50724 \u47448 , \u44536 \u47532 \u49828 \u46020 \u50752  \u49324 \u45800 \u44284 \u51032  \u45824 \u51137 \u53804 \u45716  \u51060  \u49464 \u49345  \u50669 \u49324 \u51032  \u51333 \u47568 \u51060  \u44032 \u44620 \u50872 \u49688 \u47197  \u45908 \u50865  \u44201 \u47148 \u54644 \u51656  \u44163 \u51060 \u45796 .\
