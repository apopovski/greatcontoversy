\f1\b0 \cf0 \
\uc0\u44536 \u46308 \u50640 \u44172  \u45908 \u50865  \u53360  \u44428 \u47141 \u51012  \u51452 \u44592  \u50948 \u54616 \u50668  \u51333 \u44368  \u51116 \u54032 \u49548 \u47484  \u45796 \u49884  \u49464 \u50864 \u46972 \u45716  \u44368 \u49436 \u44032  \u45236 \u47160 \u45796  (\u48512 \u47197  18 \u52280 \u51312 ). \u51068 \u48152  \u49324 \u46988 \u46308 \u51060  \u44032 \u51613 \u54616 \u44172  \u50668 \u44220 \u51012  \u49104 \u47564  \u50500 \u45768 \u46972  \u52380 \u51452 \u44368  \u44397 \u44032 \u46308 \u50640 \u49436 \u44620 \u51648 \u46020  \u48512 \u45817 \u54616 \u44172  \u50668 \u44220 \u51020 \u50640 \u46020  \u48520 \u44396 \u54616 \u44256  \u44536  \u47924 \u49436 \u50868  \u51116 \u54032 \u49548 \u44032  \u48277 \u50773 \u44368 \u51032  \u50948 \u51221 \u51088 \u46308 \u47196  \u47568 \u48120 \u50516 \u50500  \u49444 \u52824 \u46104 \u44256 , \u48177 \u51452 \u50640 \u45716  \u45320 \u47924  \u47924 \u49436 \u50892 \u49436  \u52264 \u47560  \u48380  \u49688  \u50630 \u45716  \u44256 \u47928 \u51060  \u50500 \u47924 \u46020  \u48380  \u49688  \u50630 \u45716  \u50725 \u51473 \u50640 \u49436  \u48152 \u48373 \u54616 \u50668  \u44048 \u54665 \u46104 \u50632 \u45796 . \u47566 \u51008  \u45208 \u46972 \u50640 \u49436  \u44397 \u44032 \u51032  \u44867 \u51060 \u46972 \u44256  \u54624  \u47564 \u54620  \u49324 \u46988 \u46308 , \u49692 \u44208 \u54616 \u44256  \u44256 \u49345 \u54620  \u49324 \u46988 \u46308 , \u44032 \u51109  \u51648 \u49457 \u51201 \u51060 \u44256  \u45458 \u51008  \u44368 \u50977 \u51012  \u48155 \u51008  \u49324 \u46988 \u46308 , \u44221 \u44148 \u54616 \u44256  \u54732 \u49888 \u51201 \u51064  \u47785 \u49324 \u46308 , \u48512 \u51648 \u47088 \u54616 \u44256  \u50528 \u44397 \u51201 \u51064  \u49884 \u48124 \u46308 , \u53441 \u50900 \u54620  \u54617 \u51088 \u46308 , \u52380 \u51116 \u51201 \u51064  \u50696 \u49696 \u44032 \u46308 , \u44592 \u49696  \u51080 \u45716  \u51649 \u44277 \u46308 \u51060  \u49688 \u52380  \u47749 , \u50500 \u45768  \u49688 \u47564  \u47749 \u51060  \u51453 \u51076 \u51012  \u45817 \u54616 \u44144 \u45208  \u45796 \u47480  \u45208 \u46972 \u47196  \u47581 \u47749 \u54616 \u51648  \u50506 \u51012  \u49688  \u50630 \u50632 \u45796 .\
\uc0\u47196 \u47560 \u44368 \u45716  \u51333 \u44368 \u44060 \u54785 \u51032  \u48731 \u51012  \u44732 \u48260 \u47532 \u44256 , \u51064 \u47448 \u50640 \u44172 \u49436  \u49457 \u44221 \u51012  \u48764 \u50519 \u44256 , \u50516 \u55121 \u49884 \u45824 \u51032  \u47924 \u51648 \u50752  \u48120 \u49888 \u51004 \u47196  \u45796 \u49884  \u46028 \u50500 \u44032 \u44172  \u54616 \u44592  \u50948 \u54616 \u50668  \u44536 \u50752  \u44057 \u51008  \u50668 \u47084  \u44032 \u51648  \u48169 \u52293 \u46308 \u51012  \u44053 \u44396 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u54616 \u45208 \u45784 \u51032  \u52629 \u48373 \u44284  \u54616 \u45208 \u45784 \u44760 \u49436  \u47336 \u53552 \u47484  \u51060 \u50612 \u49436  \u51068 \u51004 \u53020  \u51452 \u49888  \u44256 \u44480 \u54620  \u49324 \u46988 \u46308 \u51032  \u45432 \u47141 \u51004 \u47196  \u47568 \u48120 \u50516 \u50500  \u44060 \u49888 \u44368 \u45716  \u51204 \u48373 \u46104 \u51648  \u50500 \u45768 \u54616 \u50688 \u45796 . \u44060 \u49888 \u44368 \u51032  \u55192 \u51008  \u50773 \u51313 \u46308 \u51032  \u54840 \u51032 \u45208  \u44428 \u47141 \u50640 \u49436  \u45208 \u50728  \u44163 \u51060  \u50500 \u45768 \u50632 \u45796 . \u44032 \u51109  \u51089 \u44256  \u48708 \u52380 \u54616 \u44256  \u47924 \u47141 \u54620  \u45208 \u46972 \u46308 \u51060  \u44536  \u50836 \u49352  (\u35201 \u22622 ) \u44032  \u46104 \u50632 \u45796 . \u51333 \u44368 \u44060 \u54785 \u51032  \u49849 \u47532 \u47484  \u50619 \u51008  \u45208 \u46972 \u46308 \u51008  \u47736 \u47581 \u51012  \u46020 \u47784 \u54616 \u44256  \u51080 \u45716  \u44053 \u54620  \u50896 \u49688 \u46308 \u50640 \u44172  \u46168 \u47140  \u51080 \u45716  \u51089 \u51008  \u46020 \u49884  \u51228 \u45348 \u48148 , \u45817 \u49884 \u50640  \u44032 \u51109  \u53356 \u44256  \u48512 \u50836 \u54616 \u50688 \u45912  \u49828 \u54168 \u51064 \u51032  \u54617 \u51221 \u50640  \u54637 \u44144 \u54616 \u44256  \u51080 \u45912  \u45348 \u45916 \u46976 \u46300 , \u54889 \u47049 \u54616 \u44256  \u47700 \u47560 \u47480  \u49828 \u50948 \u49828  \u46321 \u51060 \u50632 \u45796 .\
\uc0\u52860 \u48712 \u51008  \u50557  30\u45380 \u44036  \u51228 \u45348 \u48148 \u50640 \u49436  \u54876 \u46041 \u54616 \u50688 \u45796 . \u44144 \u44592 \u49436  \u52376 \u51020 \u50640 \u45716  \u49457 \u44221 \u49345  \u50896 \u52825 \u51012  \u44256 \u49688 \u54616 \u45716  \u44368 \u54924 \u47484  \u49464 \u50864 \u45716  \u51068 \u51012  \u50948 \u54616 \u50668 , \u44536  \u45796 \u51020 \u50640 \u45716  \u50728  \u50976 \u47101 \u50640  \u51333 \u44368 \u44060 \u54785 \u51012  \u52489 \u51652 \u49884 \u53412 \u44592  \u50948 \u54616 \u50668  \u54876 \u46041 \u54616 \u50688 \u45796 . \u44277 \u51201  \u51648 \u46020 \u51088 \u47196 \u49436 \u51032  \u44536 \u51032  \u54665 \u50948 \u50752  \u44536 \u51032  \u44032 \u47476 \u52840 \u50640 \u45716  \u44536 \u47495 \u46120 \u51060  \u51204 \u54784  \u50630 \u45716  \u44163 \u51008  \u50500 \u45768 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u45817 \u49884 \u51032  \u49464 \u44228 \u50640  \u54596 \u50836 \u54620  \u51652 \u47532 \u47484  \u44277 \u54252 \u54616 \u44256 , \u48277 \u50773 \u44368 \u51032  \u44144 \u49468  \u47932 \u44208 \u51012  \u44144 \u49836 \u47084 \u49436  \u44060 \u49888 \u44368 \u51032  \u50896 \u52825 \u51012  \u51648 \u53489 \u54616 \u44256 , \u47196 \u47560 \u44368 \u51032  \u44368 \u47532 \u50640 \u49436  \u51088 \u46972 \u45212  \u44368 \u47564 \u44284  \u48512 \u54056  \u45824 \u49888 \u50640  \u45800 \u49692 \u54616 \u44256  \u49692 \u44208 \u54620  \u49373 \u47749 \u51012  \u44060 \u54785  \u44368 \u54924 \u50640  \u48512 \u49885 \u49884 \u53020  \u51452 \u45716  \u46020 \u44396 \u44032  \u46104 \u50632 \u45796 .\
\uc0\u51228 \u45348 \u48148 \u50640 \u49436 \u48512 \u53552  \u52636 \u54032 \u47932 \u46308 \u44284  \u44368 \u49324 \u46308 \u51060  \u44060 \u49888 \u44368 \u51032  \u44368 \u47532 \u47484  \u54869 \u49328 \u49884 \u53412 \u44592  \u50948 \u54616 \u50668  \u45208 \u44052 \u45796 . \u44144 \u44592 \u50640 \u49436  \u44033 \u44397 \u51032  \u54605 \u48149 \u51088 \u46308 \u51008  \u44368 \u54984 \u44284  \u44428 \u47732 \u44284  \u44201 \u47140 \u47484  \u44592 \u45824 \u54616 \u50688 \u45796 . \u52860 \u48712 \u51032  \u49884  (\u24066 ) \u51228 \u45348 \u48148 \u45716  \u51923 \u44200  \u45796 \u45768 \u45912  \u49436 \u50976 \u47101 \u51032  \u44060 \u54785 \u51088 \u46308 \u51032  \u54588 \u45212 \u52376 \u44032  \u46104 \u50632 \u45796 . \u47751  \u49464 \u44592 \u50640  \u44152 \u52432 \u49436  \u44228 \u49549 \u46108  \u47924 \u49436 \u50868  \u54253 \u54413 \u51012  \u54588 \u54616 \u50668  \u47581 \u47749 \u51088 \u46308 \u51008  \u51228 \u45348 \u48148 \u47484  \u52286 \u50500 \u50772 \u45796 . \u44406 \u51452 \u47532 \u44256 , \u49345 \u52376 \u48155 \u44256 , \u51665 \u44284  \u52828 \u51313 \u51012  \u51075 \u51008  \u49324 \u46988 \u46308 \u51060  \u51060 \u44275 \u50640 \u49436  \u46384 \u46907 \u54620  \u50689 \u51217 \u51012  \u48155 \u44256  \u52828 \u51208 \u54620  \u48372 \u54840 \u47484  \u48155 \u50520 \u45796 . \u44536 \u47532 \u54616 \u50668  \u51060 \u44275 \u50640 \u49436  \u50504 \u49885 \u52376 \u47484  \u48156 \u44204 \u54620  \u44536 \u46308 \u51008  \u44536 \u46308 \u51032  \u44592 \u45733 \u44284  \u54617 \u49885 \u44284  \u49888 \u50521 \u51012  \u54876 \u50857 \u54632 \u51004 \u47196  \u44536  \u46020 \u49884 \u47484  \u48373 \u46104 \u44172  \u54616 \u50688 \u45796 . \u44536 \u47532 \u44256  \u50668 \u44592 \u50640 \u49436  \u54588 \u45212 \u52376 \u47484  \u48156 \u44204 \u54664 \u45912  \u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u47196 \u47560 \u44368 \u51032  \u54617 \u51221 \u51012  \u51200 \u54637 \u54616 \u44592  \u50948 \u54616 \u50668  \u45796 \u49884  \u48376 \u44397 \u51004 \u47196  \u46028 \u50500 \u44052 \u45796 . \u49828 \u53076 \u53952 \u47004 \u46300 \u51032  \u50948 \u45824 \u54620  \u44060 \u54785 \u51088  \u51316  \u45433 \u49828 , \u50689 \u44397 \u51032  \u47566 \u51008  \u52397 \u44368 \u46020 \u46308 , \u45348 \u45916 \u46976 \u46300 \u50752  \u49828 \u54168 \u51064 \u51032  \u49888 \u44368 \u46020 \u46308 , \u54532 \u46993 \u49828 \u51032  \u50948 \u44536 \u45432 \u44368 \u46020 \u46308 \u51008  \u47784 \u46160  \u50516 \u55121 \u54620  \u48376 \u44397 \u46308 \u51012  \u48157 \u55176 \u44592  \u50948 \u54616 \u50668  \u51228 \u45348 \u48148 \u50640 \u49436  \u51652 \u47532 \u51032  \u54915 \u48520 \u51012  \u46308 \u44256  \u45208 \u44052 \u45796 .\
