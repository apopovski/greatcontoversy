\uc0\u47336 \u53552 \u51032  \u51060 \u54644 \u54624  \u49688  \u50630 \u45716  \u49892 \u51333 \u51008  \u46021 \u51068  \u51204 \u50669 \u51012  \u44221 \u50501 \u49884 \u53040 \u45796 . \u50612 \u46356 \u47484  \u44032 \u46304 \u51648  \u44536 \u50640  \u45824 \u54620  \u51032 \u47928 \u51060  \u54868 \u51228 \u50640  \u50732 \u46992 \u45796 . \u44592 \u44340 \u54620  \u49548 \u47928 \u46308 \u51060  \u54140 \u51256  \u45208 \u44052 \u44256 , \u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u44536 \u44032  \u49332 \u54644 \u46104 \u50632 \u45796 \u44256  \u48127 \u50632 \u45796 . \u54364 \u47732 \u50640  \u45208 \u49440  \u52828 \u44396 \u46308 \u49104  \u50500 \u45768 \u46972  \u51648 \u44552 \u44620 \u51648  \u44060 \u54785  \u50868 \u46041 \u50640  \u44277 \u44277 \u50672 \u54616 \u44172  \u44032 \u45812 \u54616 \u51648  \u50506 \u50520 \u45912  \u47566 \u51008  \u49324 \u46988 \u46308 \u44620 \u51648 \u46020  \u53356 \u44172  \u49836 \u54140 \u54616 \u50668  \u53444 \u49885 \u54616 \u50688 \u45796 . \u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u44536 \u51032  \u51453 \u51020 \u50640  \u45824 \u54616 \u50668  \u48373 \u49688 \u47484  \u54616 \u44256 \u50556  \u47568 \u44192 \u45796 \u45716  \u47609 \u49464 \u47196 \u50024  \u49828 \u49828 \u47196 \u47484  \u49549 \u48149 \u49884 \u53040 \u45796 .\
\uc0\u47196 \u47560 \u44368 \u51032  \u51648 \u46020 \u51088 \u46308 \u51008  \u44536 \u46308 \u50640  \u45824 \u54620  \u49324 \u46988 \u46308 \u51032  \u44048 \u51221 \u51060  \u50612 \u45712  \u51221 \u46020  \u50501 \u54868 \u46104 \u50632 \u45716 \u51648 \u47484  \u50508 \u44256  \u53356 \u44172  \u46160 \u47140 \u50892 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u47336 \u53552 \u44032  \u51453 \u51008  \u51460 \u47196  \u49373 \u44033 \u54616 \u44256  \u52376 \u51020 \u50640 \u45716  \u44592 \u48848 \u54616 \u50688 \u51648 \u47560 \u45716 , \u51060 \u51228 \u45716  \u49324 \u46988 \u46308 \u51032  \u48516 \u45432 \u47484  \u54588 \u54644 \u50556 \u44192 \u45796 \u44256  \u49373 \u44033 \u54616 \u50688 \u45796 . \u47336 \u53552 \u51032  \u50896 \u49688 \u46308 \u51008  \u47336 \u53552 \u44032  \u44536 \u46308  \u44032 \u50868 \u45936 \u49436  \u50500 \u47924 \u47532  \u45824 \u45812 \u54620  \u54665 \u46041 \u51012  \u54616 \u50688 \u51012  \u46412 \u50640 \u46972 \u46020  \u44536 \u44032  \u51333 \u51201 \u51012  \u44048 \u52628 \u44172  \u46108  \u51648 \u44552 \u52376 \u47100  \u44260 \u46976 \u51012  \u45817 \u54616 \u51648  \u50506 \u50520 \u45796 . \u44201 \u48516 \u54620  \u45208 \u47672 \u51648  \u50857 \u44048 \u54620  \u44060 \u54785 \u51088 \u47484  \u51453 \u50668  \u48260 \u47532 \u47140 \u44256 \u44620 \u51648  \u44928 \u54616 \u45912  \u44536 \u46308 \u46020  \u44536  \u44060 \u54785 \u51088 \u44032  \u51088 \u50976 \u47213 \u51648  \u47803 \u54620  \u47800 \u51060  \u46104 \u50612  \u51080 \u45716  \u51648 \u44552 \u50640 \u45716  \u53360  \u44277 \u54252 \u47484  \u45712 \u45180 \u50632 \u45796 . \'93\u50864 \u47532 \u47484  \u50504 \u51204 \u54616 \u44172  \u54616 \u45716  \u50976 \u51068 \u54620  \u48169 \u48277 \u51008  \u54915 \u48520 \u51012  \u53020  \u44032 \u51648 \u44256  \u50728  \u49464 \u49345 \u51012  \u46244 \u51256 \u49436 \u46972 \u46020  \u47336 \u53552 \u47484  \u52286 \u50500 \u45236 \u50612 , \u44536 \u47484  \u52286 \u44256  \u51080 \u45716  \u45208 \u46972 \u50640  \u46028 \u47140 \u51452 \u45716  \u51068 \u51060 \u45796 \'94 (D\'92Aubigne, b.9, ch.1) \u44256  \u47568 \u54616 \u44592 \u44620 \u51648  \u46104 \u50632 \u45796 . \u54889 \u51228 \u51032  \u52825 \u47161 \u46020  \u44536  \u50948 \u47141 \u51060  \u46405 \u50640  \u46504 \u50612 \u51652  \u44163 \u52376 \u47100  \u48372 \u50688 \u45796 . \u48277 \u50773 \u51032  \u49324 \u51208 \u46308 \u51008  \u49324 \u46988 \u46308 \u51032  \u44288 \u49900 \u51060  \u54889 \u51228 \u51032  \u52825 \u47161 \u50640 \u48372 \u45796 \u45716  \u47336 \u53552 \u51032  \u50868 \u47749 \u50640  \u45908 \u50865  \u44053 \u54616 \u44172  \u51665 \u51473 \u46104 \u50612  \u51080 \u45716  \u44163 \u51012  \u48372 \u44256  \u47588 \u50864  \u45432 \u54616 \u50688 \u45796 .\
\uc0\u44536 \u44032  \u54252 \u47196 \u51032  \u47800 \u51004 \u47196  \u51080 \u51012 \u51648 \u46972 \u46020  \u50504 \u51204 \u54616 \u44172  \u51080 \u45796 \u45716  \u49548 \u49885 \u51012  \u46307 \u51088 , \u49324 \u46988 \u46308 \u51032  \u50684 \u47140 \u45716  \u51652 \u51221 \u46104 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44536 \u50640  \u45824 \u54620  \u50676 \u49457 \u51008  \u54620 \u52789  \u45908  \u45458 \u50500 \u51276 \u45796 . \u44536 \u51032  \u51200 \u49436 \u45716  \u51204 \u48372 \u45796  \u45908 \u50865  \u53360  \u50676 \u49900 \u51004 \u47196  \u51069 \u54784 \u51276 \u45796 . \u44536 \u52376 \u47100  \u46160 \u47140 \u50868  \u44277 \u44201 \u51012  \u48155 \u51004 \u47732 \u49436 \u46020  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51012  \u50745 \u54840 \u54616 \u50668  \u50728  \u44536  \u50689 \u50885  \u54200 \u50640  \u44032 \u45812 \u54616 \u45716  \u49324 \u46988 \u46308 \u51032  \u49688 \u45716  \u45216 \u47196  \u51613 \u44032 \u46104 \u50612  \u44032 \u44256  \u51080 \u50632 \u45796 . \u44060 \u54785  \u50868 \u46041 \u51008  \u51216 \u52264 \u47196  \u49464 \u47141 \u51012  \u50619 \u50612  \u44032 \u44256  \u51080 \u50632 \u45796 . \u47336 \u53552 \u44032  \u49100 \u47536  \u50472 \u45716  \u44033  \u44275 \u50640 \u49436  \u49913 \u51060  \u45228 \u45796 . \u44536 \u44032  \u51080 \u51012  \u46412  \u51060 \u47336 \u50612 \u51648 \u51648  \u50506 \u50520 \u45912  \u51068 \u51060  \u44536 \u44032  \u50630 \u45716  \u46041 \u50504 \u50640  \u50756 \u49457 \u46104 \u50632 \u45796 . \u45796 \u47480  \u46041 \u50669 \u51088 \u46308 \u51008  \u44536 \u46308 \u51032  \u50948 \u45824 \u54620  \u51648 \u46020 \u51088 \u44032  \u50630 \u50612 \u51652  \u51648 \u44552 \u50640  \u49352 \u47196 \u50868  \u52293 \u51076 \u44048 \u51012  \u45712 \u44808 \u45796 . \u44536 \u46308 \u51008  \u49352 \u47196 \u50868  \u49888 \u50521 \u44284  \u50676 \u49900 \u51004 \u47196  \u51060 \u48120  \u49884 \u51089 \u46108  \u44256 \u44480 \u54620  \u49324 \u50629 \u51060  \u51473 \u45800 \u46104 \u51648  \u50506 \u46020 \u47197  \u44536 \u46308 \u51032  \u50728  \u55192 \u51012  \u45796 \u54616 \u50668  \u52628 \u51652 \u54644  \u45208 \u44052 \u45796 .\
\uc0\u44536 \u47084 \u45208  \u49324 \u45800 \u46020  \u44208 \u53076  \u44032 \u47564 \u55176  \u49436 \u49436  \u48372 \u44256  \u51080 \u51648 \u45716  \u50506 \u50520 \u45796 . \u44536 \u45716  \u51060 \u51228  \u50728 \u44054  \u44060 \u54785  \u49324 \u50629 \u50640 \u49436  \u49884 \u54744 \u54644  \u48376  \u44163 \u51012  \u49324 \u50857 \u54616 \u44256 \u51088  \u54616 \u50688 \u45796 . \u44536 \u45716  \u52280 \u46108  \u44060 \u54785  \u49324 \u50629  \u45824 \u49888 \u51004 \u47196  \u44144 \u51667  \u44163 \u51012  \u51068 \u51004 \u53020 \u49436  \u49324 \u46988 \u46308 \u51012  \u49549 \u51060 \u44256  \u47736 \u47581 \u49884 \u53412 \u44256 \u51088  \u54664 \u45796 . \u47560 \u52824  \u44536 \u47532 \u49828 \u46020 \u44368 \u54924 \u51032  \u51228 1\u49464 \u44592 \u50640  \u47566 \u51008  \u44144 \u51667  \u44536 \u47532 \u49828 \u46020 \u44032  \u51068 \u50612 \u45228 \u45912  \u44163 \u52376 \u47100  16\u49464 \u44592 \u50640 \u46020  \u54728 \u45796 \u54620  \u44144 \u51667  \u49440 \u51648 \u51088 \u46308 \u51060  \u45208 \u53440 \u45228 \u45796 .\
\uc0\u51333 \u44368 \u44228 \u50640  \u51068 \u50612 \u45212  \u46041 \u50836 \u47196  \u44618 \u51008  \u44048 \u46041 \u51012  \u48155 \u51008  \u49548 \u49688 \u51032  \u49324 \u46988 \u46308 \u51060  \u54616 \u45720 \u47196 \u48512 \u53552  \u53945 \u48324 \u54620  \u44228 \u49884 \u47484  \u48155 \u51008  \u44163 \u51004 \u47196  \u49373 \u44033 \u54616 \u44256 , \u47336 \u53552 \u44032  \u48120 \u50557 \u54616 \u44172  \u49884 \u51089 \u54620  \u44060 \u54785  \u49324 \u50629 \u51012  \u50756 \u49457 \u54616 \u44592  \u50948 \u54616 \u50668  \u54616 \u45208 \u45784 \u44760 \u47196 \u48512 \u53552  \u51076 \u47749 \u51012  \u48155 \u50520 \u45432 \u46972 \u44256  \u51452 \u51109 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u49324 \u49892 \u49345  \u44536 \u46308 \u51008  \u47336 \u53552 \u44032  \u51060 \u47336 \u50612  \u45459 \u51008  \u48148 \u47196  \u44536  \u49324 \u50629 \u51012  \u54736 \u50612  \u48260 \u47532 \u45716  \u51068 \u51012  \u54616 \u44256  \u51080 \u50632 \u45796 . \u44536 \u46308 \u51008  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51060  \u49888 \u50521 \u44284  \u54665 \u50948 \u51032  \u50756 \u51204 \u54620  \u54364 \u51456 \u51060  \u46108 \u45796 \u45716  \u44060 \u54785  \u49324 \u50629 \u51032  \u48148 \u47196  \u44592 \u52488 \u44032  \u46104 \u45716  \u50948 \u45824 \u54620  \u50896 \u52825 \u51012  \u48512 \u51064 \u54616 \u44256 , \u44536 \u47084 \u54620  \u44284 \u50724  \u50630 \u45716  \u51648 \u46020  \u50896 \u52825  \u45824 \u49888 \u50640  \u44536 \u46308 \u51032  \u48320 \u54616 \u44592  \u49789 \u44256  \u54869 \u49892 \u49457 \u51060  \u50630 \u45716  \u44048 \u51221 \u44284  \u49373 \u44033 \u51012  \u46384 \u46992 \u45796 . \u44536 \u47532 \u44256  \u51060 \u52376 \u47100  \u50724 \u47448 \u50752  \u44592 \u47564 \u51012  \u46300 \u47084 \u45236 \u51452 \u45716  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51012  \u46321 \u54620 \u55176  \u54644  \u48260 \u47532 \u45716  \u54665 \u46041 \u50640  \u51032 \u54616 \u50668  \u49324 \u45800 \u51060  \u47560 \u51020 \u45824 \u47196  \u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u51012  \u51648 \u48176 \u54624  \u49688  \u51080 \u45716  \u44600 \u51060  \u50676 \u47532 \u44172  \u46104 \u50632 \u45796 .\
