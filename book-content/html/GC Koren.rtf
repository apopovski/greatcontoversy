\uc0\u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51032  \u51613 \u50616 \u51008  \u51060 \u50752  \u44057 \u51060  \u49324 \u46988 \u51012  \u50976 \u54841 \u50640  \u48736 \u46888 \u47532 \u45716  \u54665 \u54632 \u51060  \u50630 \u45716  \u48127 \u51020 \u51032  \u44368 \u47532 \u47484  \u48152 \u45824 \u54620 \u45796 . \u51008 \u54812 \u47484  \u48155 \u45716  \u45936  \u54596 \u50836 \u54620  \u51312 \u44148 \u51012  \u51060 \u54665 \u54616 \u51648  \u50506 \u51004 \u47732 \u49436  \u54616 \u45208 \u45784 \u51032  \u51008 \u52509 \u51012  \u48155 \u44192 \u45796 \u44256  \u51452 \u51109 \u54616 \u45716  \u44163 \u51008  \u48127 \u51020 \u51060  \u50500 \u45768 \u46972  \u52280 \u46988 \u46108  \u50613 \u52769 \u51060 \u45796 . \u50780 \u45264 \u54616 \u47732  \u52280 \u46108  \u48127 \u51020 \u51008  \u49457 \u44221 \u51032  \u50557 \u49549 \u44284  \u48277 \u46020 \u50640  \u44540 \u44144 \u47484  \u46160 \u44256  \u51080 \u44592  \u46412 \u47928 \u51060 \u45796 .\
\uc0\u54616 \u45208 \u45784 \u51032  \u50836 \u44396  \u51473  \u54620  \u44032 \u51648 \u47484  \u44256 \u51032 \u51201 \u51004 \u47196  \u48276 \u54616 \u47732 \u49436  \u44144 \u47337 \u54644 \u51656  \u49688  \u51080 \u45796 \u45716  \u49888 \u51312 \u47484  \u44032 \u51648 \u44256  \u49828 \u49828 \u47196  \u49549 \u51648  \u47568 \u46972 . \u51396 \u51064  \u51460  \u50508 \u47732 \u49436  \u48276 \u54616 \u44172  \u46104 \u47732  \u44648 \u50864 \u52432  \u51452 \u45716  \u49457 \u47161 \u51032  \u51020 \u49457 \u51012  \u52840 \u47925 \u52992  \u54616 \u44256  \u51088 \u49888 \u51012  \u54616 \u45208 \u45784 \u50640 \u44172 \u49436  \u46496 \u45208 \u44032 \u44172  \u54620 \u45796 . \'93\u51396 \u45716  \u48520 \u48277 \u51060 \u47728 \'94 \'93\u48276 \u51396 \u54616 \u45716  \u51088 \u47560 \u45796  \u44536 \u47484  \u48372 \u51648 \u46020  \u47803 \u54616 \u50688 \u44256  \u44536 \u47484  \u50508 \u51648 \u46020  \u47803 \u54616 \u50688 \'94 (\u50836 \u51068  3:4, 6) \u45796 . \u50836 \u54620 \u51008  \u44536 \u51032  \u54200 \u51648 \u49436 \u46308 \u51012  \u53685 \u54616 \u50668  \u49324 \u46993 \u51012  \u52649 \u48516 \u54616 \u44172  \u47896 \u49324 \u54616 \u44256  \u51080 \u51648 \u47564  \u44536 \u45716  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51012  \u48276 \u54616 \u45716  \u49373 \u50528 \u47484  \u54616 \u47732 \u49436 \u46020  \u44144 \u47337 \u54616 \u44172  \u46112  \u49688  \u51080 \u45432 \u46972 \u44256  \u51452 \u51109 \u54616 \u45716  \u48512 \u47448 \u50640  \u49549 \u54620  \u49324 \u46988 \u46308 \u51032  \u52280  \u47784 \u49845 \u51012  \u45208 \u53440 \u45236 \u44592 \u50640  \u51452 \u51200 \u54616 \u51648  \u50500 \u45768 \u54620 \u45796 . \'93\u51200 \u47484  \u50500 \u45432 \u46972  \u54616 \u44256  \u44536 \u51032  \u44228 \u47749 \u51012  \u51648 \u53412 \u51648  \u50500 \u45768 \u54616 \u45716  \u51088 \u45716  \u44144 \u51667 \u47568 \u54616 \u45716  \u51088 \u50836  \u51652 \u47532 \u44032  \u44536  \u49549 \u50640  \u51080 \u51648  \u50500 \u45768 \u54616 \u46104  \u45572 \u44396 \u46304 \u51648  \u44536 \u51032  \u47568 \u50432 \u51012  \u51648 \u53412 \u45716  \u51088 \u45716  \u54616 \u45208 \u45784 \u51032  \u49324 \u46993 \u51060  \u52280 \u51004 \u47196  \u44536  \u49549 \u50640 \u49436  \u50728 \u51204 \u52992  \u46104 \u50632 \'94 (\u50836 \u51068  2:4, 5) \u45712 \u45768 \u46972 . \u50668 \u44592 \u50640  \u47784 \u46304  \u49324 \u46988 \u51032  \u49888 \u50521  \u44256 \u48177 \u51012  \u44160 \u53664 \u54644  \u48380  \u49688  \u51080 \u45716  \u49884 \u44552 \u49437 \u51060  \u51080 \u45796 . \u50864 \u47532 \u45716  \u54616 \u45208 \u45784 \u44760 \u49436  \u54616 \u45720 \u44284  \u46405 \u50640 \u49436  \u49457 \u44208 \u51032  \u54364 \u51456 \u51004 \u47196  \u51221 \u54644  \u51452 \u49888  \u50976 \u51068 \u51032  \u52377 \u46020 \u47196  \u51116 \u50612  \u48372 \u51648  \u50506 \u44256 \u49436 \u45716  \u50612 \u46500  \u49324 \u46988 \u46020  \u49457 \u44208 \u54616 \u45796 \u44256  \u54624  \u49688  \u50630 \u45796 . \u46020 \u45909 \u51201  \u50984 \u48277 \u51032  \u44032 \u52824 \u47484  \u45712 \u45180 \u51648  \u50506 \u45716  \u51088 \u46308 , \u54616 \u45208 \u45784 \u51032  \u44228 \u47749 \u51012  \u49548 \u54848 \u55176  \u54616 \u44144 \u45208  \u46321 \u54620 \u55176  \u50668 \u44592 \u45716  \u51088 \u46308 , \u44228 \u47749  \u51473 \u51032  \u51648 \u44537 \u55176  \u51089 \u51008  \u44163  \u54616 \u45208 \u46972 \u46020  \u48276 \u54616 \u44256  \u46608  \u44536 \u47111 \u44172  \u45224 \u51012  \u44032 \u47476 \u52824 \u45716  \u51088 \u46308 \u51008  \u54616 \u45208 \u45784 \u51032  \u45576 \u50640  \u51316 \u51473 \u55176  \u50668 \u44200 \u51656  \u49688  \u50630 \u45796 . \u44536 \u47084 \u48064 \u47196  \u50864 \u47532 \u45716  \u44536 \u46308 \u51032  \u51452 \u51109 \u51060  \u44540 \u44144  \u50630 \u45716  \u44163 \u51076 \u51012  \u50508  \u49688  \u51080 \u45796 .\
\uc0\u51396 \u44032  \u50630 \u45432 \u46972 \u44256  \u51452 \u51109 \u54616 \u45716  \u44536  \u51088 \u52404 \u44032  \u49457 \u44208 \u50640 \u49436  \u52280 \u51004 \u47196  \u47680 \u47532  \u46504 \u50612 \u51256  \u51080 \u45796 \u45716  \u51613 \u44144 \u44032  \u46108 \u45796 . \u49324 \u46988 \u51060  \u54616 \u45208 \u45784 \u51032  \u47924 \u54620 \u54616 \u49888  \u49692 \u44208 \u44284  \u49457 \u44208 \u50640  \u45824 \u54620  \u51652 \u51221 \u54620  \u44060 \u45392 \u51012  \u51060 \u54644 \u54616 \u51648  \u47803 \u54616 \u44256 , \u44536 \u46308 \u51060  \u48152 \u46300 \u49884  \u54616 \u45208 \u45784 \u51032  \u54408 \u49457 \u44284  \u51068 \u52824 \u46104 \u45716  \u49324 \u46988 \u46308 \u51060  \u46104 \u50612 \u50556  \u54620 \u45796 \u45716  \u44163 \u51012  \u50508 \u51648  \u47803 \u54624  \u46412 , \u46608 \u54620  \u50696 \u49688 \u45784 \u51032  \u49692 \u44208 \u44284  \u44256 \u49345 \u54620  \u47784 \u49845 , \u44536 \u47532 \u44256  \u49324 \u50501 \u54616 \u44256  \u51648 \u46021 \u54620  \u51396 \u51032  \u49457 \u51656 \u50640  \u45824 \u54616 \u50668  \u51652 \u51221 \u54620  \u44060 \u45392 \u51012  \u44648 \u45803 \u51648  \u47803 \u54624  \u46412 , \u49324 \u46988 \u46308 \u51008  \u51088 \u44592  \u51088 \u49888 \u51012  \u49457 \u44208 \u54616 \u45796 \u44256  \u49373 \u44033 \u54624  \u49688  \u51080 \u45796 . \u49324 \u46988 \u51060  \u51088 \u44592 \u50752  \u44536 \u47532 \u49828 \u46020 \u50752 \u51032  \u44144 \u47532 \u47484  \u47680 \u47532 \u54616 \u47732  \u54624 \u49688 \u47197 , \u54616 \u45208 \u45784 \u51032  \u54408 \u49457 \u44284  \u44536 \u48516 \u51032  \u50836 \u44396 \u50640  \u45824 \u54620  \u44060 \u45392 \u51060  \u48512 \u51313 \u54616 \u47732  \u48512 \u51313 \u54624 \u49688 \u47197 , \u51088 \u49888 \u51060  \u51088 \u44592  \u51088 \u49888 \u51032  \u45576 \u50640  \u51032 \u47213 \u44172  \u48372 \u51064 \u45796 .\
\uc0\u49457 \u44221 \u50640 \u49436  \u49444 \u47749 \u54620  \u49457 \u54868 \u45716  \u51204 \u51064 , \u44263  \u50689 \u44284  \u54844 \u44284  \u47800 \u51012  \u45796  \u54252 \u54632 \u54620 \u45796 . \u48148 \u50872 \u51008  \u45936 \u49332 \u47196 \u45768 \u44032 \u51064 \u46308 \u50640 \u44172  \u48372 \u45240  \u54200 \u51648 \u50640 \u49436  \'93\u45320 \u55148  \u50728  \u50689 \u44284  \u54844 \u44284  \u47800 \u51060  \u50864 \u47532  \u51452  \u50696 \u49688  \u44536 \u47532 \u49828 \u46020  \u44053 \u47548 \u54616 \u49892  \u46412 \u50640  \u55136  \u50630 \u44172  \u48372 \u51204 \u46104 \u44592 \u47484  \u50896 \u54616 \u45432 \u46972 \'94 (\u49332 \u51204  5:23) \u44256  \u44592 \u46020 \u54616 \u50688 \u45796 . \u44536 \u45716  \u46608 \u54620  \'93\u45236 \u44032  \u54616 \u45208 \u45784 \u51032  \u47784 \u46304  \u51088 \u48708 \u54616 \u49900 \u51004 \u47196  \u45320 \u55148 \u47484  \u44428 \u54616 \u45432 \u45768  \u45320 \u55148  \u47800 \u51012  \u54616 \u45208 \u45784 \u51060  \u44592 \u48848 \u54616 \u49884 \u45716  \u44144 \u47337 \u54620  \u49328  \u51228 \u49324 \u47196  \u46300 \u47532 \u46972  \u51060 \u45716  \u45320 \u55148 \u51032  \u46300 \u47540  \u50689 \u51201  \u50696 \u48176 \u45768 \u46972 \'94 (\u47212  12:1) \u44256  \u54200 \u51648 \u54616 \u50688 \u45796 . \u44256 \u45824  \u51060 \u49828 \u46972 \u50648  \u49884 \u45824 \u50640  \u54616 \u45208 \u45784 \u44760  \u46300 \u47532 \u45716  \u47784 \u46304  \u55148 \u49373  \u51228 \u47932 \u46308 \u51008  \u47784 \u46160  \u50628 \u48128 \u55176  \u44160 \u49324 \u46104 \u50632 \u45796 . \u47564 \u51068  \u51228 \u47932 \u47196  \u46300 \u47140 \u51652  \u51664 \u49849 \u50640 \u44172 \u49436  \u50612 \u46500  \u44208 \u51216 \u51060  \u48156 \u44204 \u46104 \u47732  \u44536 \u44163 \u51008  \u44144 \u51208 \u45817 \u54616 \u50688 \u45796 . \u50780 \u45264 \u54616 \u47732  \u51228 \u47932 \u51008  \'93\u55136  \u50630 \u45716 \'94 \u44163 \u51004 \u47196  \u46300 \u47532 \u46972 \u44256  \u54616 \u45208 \u45784 \u44760 \u49436  \u47749 \u47161 \u54616 \u49512 \u44592  \u46412 \u47928 \u51060 \u45796 . \u44536 \u50752  \u44057 \u51060  \u44536 \u47532 \u49828 \u46020 \u51064 \u46308 \u51008  \'93\u45320 \u55148  \u47800 \u51012  \u54616 \u45208 \u45784 \u51060  \u44592 \u48848 \u54616 \u49884 \u45716  \u44144 \u47337 \u54620  \u49328  \u51228 \u49324 \u47196  \u46300 \u47532 \u46972 \'94\u45716  \u47749 \u47161 \u51012  \u48155 \u44256  \u51080 \u45796 . \u51060  \u47785 \u51201 \u51012  \u51060 \u47336 \u44592  \u50948 \u54616 \u50668  \u44536 \u46308 \u51008  \u51088 \u49888 \u46308 \u51032  \u47784 \u46304  \u45733 \u47141 \u46308 \u51012  \u52572 \u49440 \u44751  \u50577 \u54840 \u54620  \u49345 \u53468 \u47196  \u50976 \u51648 \u54616 \u50668 \u50556  \u54620 \u45796 . \u47560 \u51020 \u44284  \u47800 \u51032  \u45733 \u47141 \u51012  \u50557 \u54868 \u49884 \u53412 \u45716  \u47784 \u46304  \u54665 \u50948 \u45716  \u49324 \u46988 \u51004 \u47196  \u54616 \u50668 \u44552  \u44536 \u51032  \u52285 \u51312 \u51452 \u47484  \u50948 \u54620  \u48393 \u49324 \u50640  \u48512 \u51201 \u45817 \u54616 \u44172  \u47564 \u46304 \u45796 . \u44536 \u47084 \u47732  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u49324 \u46988 \u51060  \u46300 \u47540  \u49688  \u51080 \u45716  \u52572 \u49440 \u51032  \u44163 \u51060  \u50500 \u45772  \u44163 \u51012  \u46300 \u47540  \u46412 \u50640  \u44592 \u48848 \u54616 \u49892 \u44620 ? \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \'93\u45348  \u47560 \u51020 \u51012 \'85\u45796 \u54616 \u50668  \u51452  \u45320 \u51032  \u54616 \u45208 \u45784 \u51012  \u49324 \u46993 \u54616 \u46972 \'94\u44256  \u47568 \u50432 \u54616 \u49512 \u45796 . \u47560 \u51020 \u51012  \u45796 \u54616 \u50668  \u54616 \u45208 \u45784 \u51012  \u49324 \u46993 \u54616 \u45716  \u49324 \u46988 \u46308 \u51008  \u44536 \u46308 \u51032  \u49373 \u50528 \u47196 \u50024  \u54616 \u45208 \u45784 \u44760  \u52572 \u49440 \u51032  \u48393 \u49324 \u47484  \u54616 \u44256 \u51088  \u54624  \u44163 \u51060 \u45796 . \u44536 \u47532 \u44256  \u44536 \u46308 \u51008  \u54616 \u45208 \u45784 \u51032  \u46907 \u51012  \u54665 \u54624  \u45733 \u47141 \u51012  \u52489 \u51652 \u49884 \u53020  \u51460  \u50984 \u48277 \u44284  \u51312 \u54868 \u46104 \u44256 \u51088  \u44536 \u46308 \u51032  \u47784 \u46304  \u50669 \u47049 \u51012  \u45796 \u54616 \u50668  \u45130 \u51076 \u50630 \u51060  \u45432 \u47141 \u54624  \u44163 \u51060 \u45796 . \u44536 \u46308 \u51008  \u51221 \u50837 \u51060 \u45208  \u49885 \u50837 \u50640  \u48736 \u51664 \u51004 \u47196 \u50024  \u54616 \u45208 \u45784  \u50500 \u48260 \u51648 \u44760  \u46300 \u47532 \u45716  \u51228 \u47932 \u51012  \u50557 \u54868 \u49884 \u53412 \u44144 \u45208  \u45908 \u47101 \u55176 \u51648  \u50500 \u45768 \u54624  \u44163 \u51060 \u45796 .\
