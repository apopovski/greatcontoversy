\uc0\u53468 \u52488 \u50640  \u51396  \u50630 \u51060  \u52285 \u51312 \u46108  \u50501 \u47161 \u46308 \u51008  \u44536  \u48376 \u49457 \u44284  \u44428 \u45733 \u44284  \u50689 \u44305 \u51060  \u51648 \u44552  \u54616 \u45208 \u45784 \u51032  \u49324 \u51088 \u47196  \u48393 \u49324 \u54616 \u45716  \u51088 \u46308 \u44284  \u44057 \u50520 \u45796 . \u44536 \u47084 \u45208  \u44536 \u46308 \u51060  \u51396  \u46412 \u47928 \u50640  \u53440 \u46973 \u54616 \u44172  \u46104 \u51088  \u44536 \u46308 \u51008  \u54616 \u45208 \u45784 \u51012  \u50837 \u46104 \u44172  \u54616 \u44256  \u51064 \u47448 \u47484  \u47736 \u47581 \u49884 \u53412 \u45716  \u51068 \u50640  \u45800 \u54633 \u54616 \u50668  \u51080 \u45796 . \u44536 \u46308 \u51008  \u49324 \u45800 \u51032  \u48152 \u50669 \u50640  \u44032 \u45812 \u54616 \u50668  \u44536 \u50752  \u54632 \u44760  \u54616 \u45720 \u50640 \u49436  \u51923 \u44200 \u45228 \u51004 \u47728  \u44033  \u49884 \u45824 \u47484  \u53685 \u54616 \u50668  \u49324 \u45800 \u44284  \u50672 \u54633 \u54616 \u50668  \u54616 \u45208 \u45784 \u51032  \u44428 \u50948 \u47484  \u45824 \u54637 \u54616 \u50668  \u49912 \u50864 \u44256  \u51080 \u45796 . \u50864 \u47532 \u45716  \u49457 \u44221 \u50640 \u49436  \u44536 \u46308 \u51032  \u46041 \u47609 \u44284  \u51221 \u48512 , \u50668 \u47084  \u44032 \u51648  \u44228 \u44553 , \u44536 \u46308 \u51032  \u51648 \u54812 \u50752  \u44368 \u54876 , \u51064 \u47448 \u51032  \u54217 \u54868 \u50752  \u54665 \u48373 \u51012  \u54028 \u44340 \u54616 \u44592  \u50948 \u54620  \u50501 \u51032 \u46308 \u51012  \u50508 \u44256  \u51080 \u45796 .\
\uc0\u44396 \u50557 \u51032  \u50669 \u49324 \u45716  \u50501 \u47161 \u46308 \u51032  \u51316 \u51116 \u50752  \u54876 \u46041 \u50640  \u45824 \u54616 \u50668  \u51060 \u46384 \u44552  \u50616 \u44553 \u54616 \u44256  \u51080 \u45796 . \u44536 \u47084 \u45208  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u49464 \u49345 \u50640  \u44228 \u49892  \u45817 \u49884 \u47564 \u53372  \u50501 \u47161 \u46308 \u51060  \u44032 \u51109  \u50501 \u46980 \u54616 \u44172  \u54876 \u46041 \u54620  \u51201 \u51008  \u50630 \u45796 . \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u51064 \u47448 \u47484  \u44396 \u49549 \u54616 \u45716  \u44228 \u54925 \u51012  \u49892 \u52380 \u54616 \u44592  \u50948 \u54616 \u50668  \u50724 \u49512 \u45796 . \u44536 \u47084 \u48064 \u47196  \u49324 \u45800 \u51008  \u51088 \u44592 \u50640 \u44172  \u49464 \u44228 \u47484  \u51648 \u48176 \u54624  \u44428 \u47532 \u44032  \u51080 \u45796 \u45716  \u44163 \u51012  \u51452 \u51109 \u54616 \u44256 \u51088  \u44208 \u49900 \u54616 \u50688 \u45796 . \u49324 \u45800 \u51008  \u54036 \u47112 \u49828 \u54004 \u51012  \u51228 \u50808 \u54620  \u50728  \u49464 \u49345 \u51032  \u44033  \u44275 \u50640 \u49436  \u50864 \u49345 \u51012  \u49709 \u48176 \u52992  \u54616 \u45716  \u51068 \u50640  \u49457 \u44277 \u51012  \u44144 \u46160 \u50632 \u45796 . \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u49324 \u45800 \u51060  \u50500 \u51649  \u50756 \u51204 \u55176  \u51648 \u48176 \u54616 \u51648  \u47803 \u54620  \u50976 \u51068 \u54620  \u46405 \u50640  \u54616 \u45720 \u51032  \u48731 \u51012  \u48708 \u52628 \u49884 \u44592  \u50948 \u54616 \u50668  \u50724 \u49512 \u45796 . \u50668 \u44592 \u49436  \u49436 \u47196  \u44221 \u51137 \u54616 \u45716  \u46160  \u49464 \u47141 \u51008  \u52572 \u49345 \u44428 \u51012  \u51452 \u51109 \u54616 \u44172  \u46104 \u50632 \u45796 . \u50696 \u49688 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u49324 \u46993 \u51032  \u54036 \u51012  \u54196 \u44256  \u45817 \u49888  \u50504 \u50640 \u49436  \u50857 \u49436 \u50752  \u54868 \u54217 \u51012  \u50619 \u44256 \u51088  \u54616 \u45716  \u47784 \u46304  \u49324 \u46988 \u51012  \u48512 \u47476 \u49512 \u45796 . \u55121 \u50516 \u51032  \u44400 \u45824 \u45716  \u44536 \u46308 \u51060  \u47924 \u54620 \u54620  \u51648 \u48176 \u44428 \u51012  \u44032 \u51648 \u51648  \u47803 \u54664 \u45796 \u45716  \u44163 \u51012  \u50508 \u50520 \u45796 . \u44536 \u47532 \u44256  \u44536 \u46308 \u51008  \u47564 \u51068  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u44536 \u48516 \u51032  \u49324 \u47749 \u51012  \u50756 \u51204 \u55176  \u49688 \u54665 \u54616 \u49884 \u47732  \u44536 \u46308 \u51032  \u51648 \u48176 \u46020  \u48120 \u44396 \u50640  \u45149 \u45216  \u44163 \u51012  \u51060 \u54644 \u54664 \u45796 . \u44536 \u47084 \u48064 \u47196  \u49324 \u45800 \u51008  \u49632 \u51460 \u50640  \u44208 \u48149 \u46108  \u49324 \u51088 \u52376 \u47100  \u48516 \u45432 \u54616 \u50668  \u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u44284  \u47800 \u51012  \u51648 \u48176 \u54616 \u45716  \u51068 \u50640  \u51088 \u49888 \u51032  \u55192 \u51012  \u47924 \u51228 \u54620 \u51004 \u47196  \u48156 \u55064 \u54664 \u45796 .\
\uc0\u47560 \u44480 \u50640 \u44172  \u49324 \u47196 \u51105 \u55180  \u49324 \u46988 \u46308 \u51060  \u51080 \u50632 \u45796 \u45716  \u49324 \u49892 \u51008  \u49888 \u50557  \u49457 \u44221 \u50640  \u48516 \u47749 \u55176  \u50616 \u44553 \u46104 \u50612  \u51080 \u45796 . \u44536 \u44163  \u46412 \u47928 \u50640  \u44256 \u53685 \u45817 \u54616 \u45716  \u49324 \u46988 \u46308 \u51008  \u45800 \u49692 \u55176  \u48372 \u53685  \u51656 \u48337 \u51004 \u47196  \u44256 \u53685 \u54616 \u45716  \u44163 \u44284 \u45716  \u45804 \u46992 \u45796 . \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u45817 \u49888 \u51060  \u52712 \u44553 \u54616 \u44256  \u51080 \u45716  \u44163 \u50640  \u45824 \u54616 \u50668  \u50756 \u51204 \u55176  \u51060 \u54644 \u54616 \u49512 \u45796 . \u44536 \u47532 \u44256  \u44536 \u48516 \u51008  \u50501 \u47161 \u51032  \u49892 \u51228 \u51201  \u51316 \u51116 \u50752  \u54876 \u46041 \u51012  \u51064 \u51221 \u54616 \u49512 \u45796 .\
\uc0\u50501 \u47161 \u51032  \u49688 \u54952 \u50752  \u50948 \u47141 \u44284  \u50501 \u51032 \u50640  \u48708 \u54616 \u50668  \u44536 \u47532 \u49828 \u46020 \u51032  \u45733 \u47141 \u44284  \u51088 \u48708 \u44032  \u50620 \u47560 \u45208  \u45824 \u51312 \u51201 \u51064 \u51648 \u47484  \u50508 \u47140  \u51452 \u45716  \u46748 \u47159 \u54620  \u50696 \u51613 \u51008  \u44144 \u46972 \u49324 \u51032  \u49324 \u44480 \u46308 \u47536  \u51088 \u46308 \u51012  \u44256 \u52432 \u51452 \u49884 \u45716  \u49457 \u44221 \u51032  \u51060 \u50556 \u44592 \u50640  \u45208 \u53440 \u45208  \u51080 \u45796 . \u44536  \u44032 \u47144 \u54620  \u48120 \u52824 \u44305 \u51060 \u46308 \u51008  \u47784 \u46304  \u49549 \u48149 \u51012  \u45912 \u51256  \u48260 \u47532 \u44256  \u47800 \u51012  \u48708 \u53952 \u44256  \u51077 \u50640  \u44144 \u54408 \u51012  \u47932 \u44256  \u54868 \u47484  \u45236 \u44256  \u49548 \u47532 \u47484  \u51648 \u47476 \u47732 \u49436  \u51088 \u54617 \u54616 \u44256  \u44032 \u44620 \u51060  \u51217 \u44540 \u54616 \u45716  \u47784 \u46304  \u49324 \u46988 \u51012  \u50948 \u54801 \u54664 \u45796 . \u55121 \u50516 \u51032  \u50773 \u51008  \u54588 \u53804 \u49457 \u51060 \u44032  \u46108  \u44536 \u46308 \u51032  \u49345 \u54620  \u47800 \u44284  \u44536 \u46308 \u51032  \u54844 \u46976 \u54620  \u47560 \u51020 \u51012  \u44592 \u49240 \u44172  \u48148 \u46972 \u48372 \u50520 \u45796 . \u44536  \u44256 \u53685 \u54616 \u45716  \u49324 \u46988 \u46308 \u51012  \u51648 \u48176 \u54616 \u44256  \u51080 \u45912  \u54620  \u49324 \u44480 \u45716  \'93\u45236  \u51060 \u47492 \u51008  \u44400 \u45824 \u45768  \u50864 \u47532 \u44032  \u47566 \u51020 \u51060 \u45768 \u51060 \u45796 \'94 (\u47561  5:9) \u46972 \u44256  \u49548 \u47532 \u52452 \u45796 . \u47196 \u47560  \u44400 \u45824 \u50640 \u49436 \u45716  \u54620  \u44400 \u45800 \u51060  3\u52380  \u45236 \u51648  5\u52380 \u47749 \u51004 \u47196  \u46104 \u50612  \u51080 \u50632 \u45796 . \u49324