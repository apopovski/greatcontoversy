\uc0\u44536 \u46308 \u51032  \u51076 \u47924 \u50640  \u52649 \u49892 \u54620  \u54616 \u45720 \u51032  \u54028 \u49688 \u48337 \u46308 \u51008  \u44228 \u49549 \u54616 \u50668  \u44648 \u50612  \u51080 \u45796 . \u48708 \u47197  \u44228 \u47749 \u51012  \u51648 \u53412 \u45716  \u51088 \u46308 \u51012  \u51453 \u51060 \u44256 \u51088  \u54616 \u45716  \u49884 \u44036 \u51012  \u51221 \u54644  \u45459 \u50520 \u51012 \u51648 \u46972 \u46020  \u44536 \u46308 \u51032  \u50896 \u49688 \u46308 \u51008  \u44221 \u50864 \u50640  \u46384 \u46972  \u44536  \u48277 \u47161 \u51032  \u49892 \u54665 \u51012  \u52489 \u51652 \u49884 \u53412 \u44592  \u50948 \u54616 \u50668  \u44536  \u44208 \u51221 \u46108  \u45216 \u51676 \u48372 \u45796  \u48120 \u47532  \u44536 \u46308 \u51032  \u49373 \u47749 \u51012  \u48764 \u50519 \u44256 \u51088  \u45432 \u47141 \u54624  \u44163 \u51060 \u45796 . \u44536 \u47084 \u45208  \u50500 \u47924 \u46020  \u44536  \u52649 \u49457 \u46108  \u44033  \u49324 \u46988 \u51012  \u46168 \u47084  \u51652 \u52824 \u44256  \u51080 \u45716  \u44053 \u54620  \u49688 \u54840 \u51088 \u46308 \u51032  \u44221 \u44228 \u47581 \u51012  \u44648 \u46888 \u47540  \u49688  \u50630 \u45796 . \u50612 \u46500  \u49324 \u46988 \u46308 \u51008  \u46020 \u49884 \u50752  \u52492 \u46973 \u46308 \u50640 \u49436  \u54588 \u54644  \u44032 \u45796 \u44032  \u44277 \u44201 \u51012  \u48155 \u45716 \u45796 . \u44536 \u47084 \u45208  \u44536 \u46308 \u51012  \u54644 \u54616 \u44256 \u51088  \u45458 \u51060  \u46308 \u47140 \u51652  \u44160  (\u21133 ) \u51008  \u47560 \u52824  \u51648 \u54392 \u46972 \u44592 \u52376 \u47100  \u47924 \u47141 \u54616 \u44172  \u44734 \u50668  \u55192 \u50630 \u51060  \u46504 \u50612 \u51652 \u45796 . \u46608  \u50612 \u46500  \u49324 \u46988 \u46308 \u51008  \u51204 \u49324  (\u25136 \u22763 ) \u51032  \u47784 \u50577 \u51012  \u54620  \u52380 \u49324 \u46308 \u50640  \u51032 \u54616 \u50668  \u48372 \u54840 \u47484  \u48155 \u45716 \u45796 .\
\uc0\u44033  \u49884 \u45824 \u50640  \u44152 \u52432  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u44144 \u47337 \u54620  \u52380 \u49324 \u46308 \u51012  \u53685 \u54644  \u45817 \u49888 \u51032  \u48177 \u49457 \u46308 \u51012  \u46020 \u50864 \u49884 \u44256  \u44396 \u50896 \u54616 \u49512 \u45796 . \u52380 \u49324 \u46308 \u51008  \u49324 \u46988 \u46308 \u51032  \u50629 \u47924 \u50640  \u51201 \u44537 \u51201 \u51004 \u47196  \u52280 \u50668 \u54644  \u50772 \u45796 . \u44536 \u46308 \u51008  \u48264 \u44060 \u50752  \u44057 \u51060  \u48731 \u45208 \u45716  \u50743 \u51012  \u51077 \u44256  \u45208 \u53440 \u45228 \u45716 \u44032  \u54616 \u47732 , \u47676  \u44600 \u51012  \u50668 \u54665 \u54616 \u45716  \u54665 \u51064 \u51032  \u47784 \u49845 \u51004 \u47196  \u45208 \u53440 \u45208 \u44592 \u46020  \u54664 \u45796 . \u52380 \u49324 \u46308 \u51008  \u51064 \u44036 \u51032  \u47784 \u50577 \u51004 \u47196  \u44221 \u44148 \u54620  \u49324 \u46988 \u46308 \u50640 \u44172  \u45208 \u53440 \u45208 \u44592 \u46020  \u54664 \u45796 . \u44536 \u46308 \u51008  \u47560 \u52824  \u54588 \u44260 \u54620  \u44163 \u52376 \u47100  \u51221 \u50724 \u50640  \u49345 \u49688 \u47532 \u45208 \u47924  \u50500 \u47000 \u49436  \u49772 \u44592 \u46020  \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u49324 \u46988 \u51032  \u51665 \u50640  \u50689 \u51217 \u46104 \u50612  \u45824 \u51217 \u51012  \u48155 \u44592 \u46020  \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u44600  \u51200 \u47928  \u54665 \u51064 \u46308 \u51032  \u50504 \u45236 \u51088 \u46020  \u46104 \u50632 \u45796 . \u44536 \u46308 \u51008  \u44536 \u46308 \u51032  \u49552 \u51004 \u47196  \u51649 \u51217  \u51228 \u45800 \u51032  \u48520 \u51012  \u48537 \u51060 \u44592 \u46020  \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u44048 \u50725 \u51032  \u47928 \u51012  \u50676 \u44256  \u51452 \u45784 \u51032  \u51333 \u46308 \u51012  \u45459 \u50500  \u51452 \u44592 \u46020  \u54616 \u5068