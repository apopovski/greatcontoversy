\uc0\u49324 \u45800 \u51032  \u54028 \u44340  \u54665 \u50948 \u45716  \u50689 \u50896 \u55176  \u45149 \u45212 \u45796 . \u50977 \u52380  \u45380  \u46041 \u50504  \u44536 \u45716  \u51228  \u47560 \u51020 \u45824 \u47196  \u48520 \u54665 \u51004 \u47196  \u46405 \u51012  \u52649 \u47564 \u52992  \u54616 \u44256  \u50728  \u50864 \u51452 \u47484  \u49836 \u54532 \u44172  \u54616 \u50688 \u45796 . \u47784 \u46304  \u54588 \u51312 \u47932 \u51008  \u54632 \u44760  \u53444 \u49885 \u54616 \u47728  \u54632 \u44760  \u44256 \u53685 \u45817 \u54644  \u50772 \u45796 . \u44536 \u47084 \u45208  \u51060 \u51228  \u54616 \u45208 \u45784 \u51032  \u54588 \u51312 \u47932 \u46308 \u51008  \u49324 \u45800 \u51032  \u51316 \u51116 \u50752  \u50976 \u54841 \u50640 \u49436  \u50689 \u50896 \u55176  \u48279 \u50612 \u45212 \u45796 . \'93\u50728  \u46405 \u51060  \u54217 \u50504 \u54616 \u44256  \u51221 \u50728 \u54616 \u45768  \u47924 \u47532 \u44032  \u49548 \u47532 \u51656 \u47084  \u45432 \u47000 \u54616 \u45716 \u46020 \u45796 \'94 (\u49324  14:7). \u52268 \u49569 \u44284  \u49849 \u47532 \u51032  \u54632 \u49457 \u51060  \u52649 \u49457 \u46108  \u50728  \u50864 \u51452 \u50640 \u49436  \u53552 \u51256  \u45208 \u50728 \u45796 . \'93\u54728 \u45796 \u54620  \u47924 \u47532 \u51032  \u51020 \u49457 \u46020  \u44057 \u44256  \u47566 \u51008  \u47932 \u49548 \u47532 \u46020  \u44057 \u44256  \u53360  \u45516 \u49457 \u46020  \u44057 \'94\u51008  \u49548 \u47532 \u47196  \'93\u54624 \u47120 \u47336 \u50556  \u51452  \u50864 \u47532  \u54616 \u45208 \u45784  \u44263  \u51204 \u45733 \u54616 \u49888  \u51060 \u44032  \u53685 \u52824 \u54616 \u49884 \u46020 \u45796 \'94 (\u44228  19:6) \u46972 \u44256  \u45432 \u47000 \u54620 \u45796 .\
\uc0\u46405 \u51060  \u47736 \u47581 \u51032  \u48520 \u50640  \u49912 \u50668  \u51080 \u45716  \u46041 \u50504  \u51032 \u51064 \u46308 \u51008  \u44144 \u47337 \u54620  \u49457  \u50504 \u50640 \u49436  \u50504 \u51204 \u54616 \u44172  \u51080 \u45796 . \u46168 \u51704  \u49324 \u47581 \u51008  \u52395 \u51704  \u48512 \u54876 \u50640  \u52280 \u50668 \u54620  \u51088 \u46308 \u51012  \u45796 \u49828 \u47540  \u44428 \u49464 \u44032  \u50630 \u45796 . \u54616 \u45208 \u45784 \u51060  \u50501 \u51064 \u50640 \u44172 \u45716  \u53468 \u50864 \u45716  \u48520 \u51060  \u46104 \u51648 \u47564  \u45817 \u49888 \u51032  \u48177 \u49457 \u50640 \u44172 \u45716  \u54644 \u50752  \u48169 \u54056 \u44032  \u46104 \u49888 \u45796  (\u44228  20:6; \u49884  84:11 \u52280 \u51312 ).\
\'93\uc0\u45236 \u44032  \u49352  \u54616 \u45720 \u44284  \u49352  \u46405 \u51012  \u48372 \u45768  \u52376 \u51020  \u54616 \u45720 \u44284  \u52376 \u51020  \u46405 \u51060  \u50630 \u50612 \u51276 \u44256  \u48148 \u45796 \u46020  \u45796 \u49884  \u51080 \u51648  \u50506 \u45908 \u46972 \'94 (\u44228  21:1). \u50501 \u51064 \u51012  \u53468 \u50864 \u45716  \u48520 \u51008  \u46405 \u51012  \u51221 \u44208 \u52992  \u54620 \u45796 . \u47784 \u46304  \u51200 \u51452 \u51032  \u55124 \u51201 \u51008  \u51068 \u49548 \u46108 \u45796 . \u44396 \u50896 \u48155 \u51008  \u49324 \u46988 \u46308 \u50640 \u44172  \u51396 \u51032  \u47924 \u49436 \u50868  \u44208 \u44284 \u47484  \u50616 \u51228 \u45208  \u49373 \u44033 \u45208 \u44172  \u54644 \u51460  \u50689 \u50896 \u55176  \u48520 \u53440 \u45716  \u51648 \u50725 \u51008  \u50630 \u45796 .\
\uc0\u50724 \u51649  \u54620  \u44032 \u51648  \u44592 \u45392 \u47932 \u51008  \u45224 \u44172  \u46108 \u45796 . \u50864 \u47532  \u44396 \u51452 \u44760 \u49436 \u45716  \u49901 \u51088 \u44032 \u51032  \u54364 \u47484  \u50689 \u50896 \u55176  \u50616 \u51228 \u45208  \u44036 \u51649 \u54616 \u49892  \u44163 \u51060 \u45796 . \u44536 \u48516 \u51032  \u49345 \u54616 \u49888  \u47672 \u47532 \u50752  \u50694 \u44396 \u47532 \u50752  \u49552 \u48156 \u50640 \u45716  \u51396 \u44032  \u48730 \u50612 \u45459 \u51008  \u51092 \u51064 \u54620  \u50976 \u51068 \u51032  \u55124 \u51201 \u51060  \u45224 \u44172  \u46108 \u45796 . \u49440 \u51648 \u51088  \u54616 \u48149 \u44397 \u51008  \u50689 \u44305 \u51032  \u44536 \u47532 \u49828 \u46020 \u47484  \u48148 \u46972 \u48372 \u44256  \'93\u44305 \u49440 \u51060  \u44536  \u50694 \u44396 \u47532  [\u50689 \u50612  \u49457 \u44221  \'97 \u48169 \u51452 ] \u50640 \u49436  \u45208 \u50724 \u45768  \u44536  \u44428 \u45733 \u51060  \u44536  \u49549 \u50640  \u44048 \u52712 \u50632 \u46020 \u45796 \'94 (\u54633  3:4) \u44256  \u47568 \u54620 \u45796 . \u51064 \u47448 \u47484  \u54616 \u45208 \u45784 \u44284  \u54868 \u47785 \u54616 \u44172  \u54616 \u49884 \u44592  \u50948 \u54616 \u50668  \u48521 \u51008  \u54588 \u47484  \u55128 \u47536  \u44536  \u50694 \u44396 \u47532 \u45716  \u44396 \u51452 \u51032  \u50689 \u44305 \u51060  \u45208 \u53440 \u45208 \u44256 , \'93\u44428 \u45733 \u51060  \u44536  \u49549 \u50640  \u44048 \'94\u52628 \u51064  \u44275 \u51060 \u45796 . \u49549 \u51396 \u51032  \u55148 \u49373  \u51228 \u47932 \u51060  \u46104 \u49900 \u51004 \u47196  \u44396 \u50896 \u54616 \u44592 \u50640  \u45733 \u54616 \u49512 \u45912  \u44536 \u48516 \u44760 \u49436 \u45716  \u54616 \u45208 \u45784 \u51032  \u51088 \u48708 \u47484  \u47736 \u49884 \u54620  \u51088 \u46308 \u50640 \u44172  \u44277 \u51032 \u47484  \u54665 \u54616 \u45716  \u51068 \u50640 \u46020  \u44053 \u54616 \u49512 \u45796 . \u44536 \u48516 \u51032  \u44404 \u50837 \u51032  \u54364 \u45716  \u44536 \u48516 \u51032  \u44032 \u51109  \u53360  \u50689 \u44305 \u51060 \u45796 . \u44040 \u48148 \u47532 \u50640 \u49436  \u49345 \u54620  \u55124 \u51201 \u51008  \u50689 \u50896 \u54620  \u49884 \u45824 \u47484  \u53685 \u54616 \u50668  \u51452 \u45784 \u44760  \u45824 \u54620  \u52268 \u50577 \u51012  \u48520 \u47084 \u51068 \u51004 \u53412 \u44256  \u44536 \u48516 \u51032  \u45733 \u47141 \u51012  \u47568 \u54644  \u51460  \u44163 \u51060 \u45796 .\
\'93\uc0\u45320  \u50577 \u46524 \u51032  \u47581 \u45824 \u50836  \u46392  \u49884 \u50728 \u51032  \u49328 \u51060 \u50668  \u51060 \u51204  \u44428 \u45733  \u44263  \u46392  \u50696 \u47336 \u49332 \u47128 \u51032  \u45208 \u46972 \u44032  \u45348 \u44172 \u47196  \u46028 \u50500 \u50724 \u47532 \u46972 \'94 (\u48120  4:8). \u54868 \u50684 \u44160 \u51060  \u50640 \u45940 \u46041 \u49328 \u50640 \u49436  \u52572 \u52488 \u51032  \u48512 \u48512 \u47484  \u45236 \u51923 \u51008  \u51060 \u47000  \u49457 \u46020 \u46308 \u51060  \'93\u44536  \u50619 \u51004 \u49888  \u44163 \u51012  \u44396 \u49549 \'94 (\u50657  1:14) \u54624  \u49884 \u44592 \u47484  \u50676 \u47148 \u54616 \u44172  \u49324 \u47784 \u54644  \u50728  \u44536 \u46412 \u44032  \u50772 \u45796 . \u50896 \u47000  \u49324 \u46988 \u50640 \u44172  \u44536 \u51032  \u45208 \u46972 \u47196  \u51452 \u50612 \u51276 \u51004 \u45208  \u49324 \u45800 \u51032  \u49552 \u51004 \u47196  \u45336 \u50612 \u44032 \u49436  \u50724 \u47019 \u46041 \u50504  \u44053 \u54620  \u50896 \u49688 \u50640 \u44172  \u51216 \u47161 \u45817 \u54644  \u51080 \u45912  \u46405 \u51008  \u50948 \u45824 \u54620  \u44396 \u49549 \u51032  \u44228 \u54925 \u51004 \u47196  \u47568 \u48120 \u50516 \u50500  \u45796 \u49884  \u49324 \u46988 \u50640 \u44172 \u47196  \u46028 \u50500 \u50772 \u45796 . \u51396 \u47196  \u47568 \u48120 \u50516 \u50500  \u51075 \u50612 \u48260 \u47536  \u47784 \u46304  \u44163 \u51060  \u54924 \u48373 \u46104 \u50632 \u45796 . \'93\u46405 \u46020 \'85\u54747 \u46104 \u51060  \u52285 \u51312 \u52824  \u50500 \u45768 \u54616 \u49884 \u44256  \u49324 \u46988 \u51004 \u47196  \u44144 \u54616 \u44172  \u51648 \u51004 \'94 (\u49324  45:18) \u49512 \u45796 . \u46405 \u51060  \u44396 \u49549 \u48155 \u51008  \u51088 \u46308 \u51032  \u50689 \u50896 \u54620  \u44144 \u52376 \u44032  \u46112  \u46412  \u54616 \u45208 \u45784 \u44760 \u49436  \u46405 \u51012  \u52285 \u51312 \u54616 \u49888  \u48376 \u47000 \u51032  \u47785 \u51201 \u51060  \u49457 \u52712 \u46108 \u45796 . \'93\u51032 \u51064 \u51060  \u46405 \u51012  \u52264 \u51648 \u54632 \u51060 \u50668  \u44144 \u44592  \u50689 \u50689 \u55176  \u44144 \u54616 \u47532 \u47196 \u45796 \'94 (\u49884  37:29).\
