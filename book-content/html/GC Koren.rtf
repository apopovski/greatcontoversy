\uc0\u48708 \u47197  \u51060  \u49464 \u49345 \u51032  \u50948 \u51221 \u51088 \u46308 \u51060  \u44648 \u45803 \u51648  \u47803 \u54624 \u51648 \u46972 \u46020  \u44536 \u46308 \u51032  \u54924 \u51032 \u50640  \u52380 \u49324 \u46308 \u51060  \u45824 \u48320 \u51088 \u47196  \u52280 \u44032 \u54616 \u45716  \u51068 \u51060  \u51333 \u51333  \u51080 \u45796 . \u49324 \u46988 \u51032  \u45576 \u51004 \u47196  \u44536 \u46308 \u51012  \u47785 \u44201 \u54616 \u44256 , \u49324 \u46988 \u51032  \u44480 \u47196  \u44536 \u46308 \u51032  \u54840 \u49548 \u47484  \u46307 \u44256 , \u49324 \u46988 \u51032  \u51077 \u49696 \u47196  \u44536 \u46308 \u51032  \u51228 \u51032 \u47484  \u48152 \u45824 \u54616 \u44256 , \u44536 \u46308 \u51032  \u44428 \u44256 \u47484  \u51312 \u47217 \u54616 \u44256 , \u49324 \u46988 \u51032  \u49552 \u51004 \u47196  \u44536 \u46308 \u51012  \u47784 \u50837 \u54616 \u44256  \u47736 \u49884 \u54644  \u50772 \u45796 . \u51032 \u54924 \u50752  \u48277 \u51221 \u50640  \u51080 \u50612 \u49436  \u51060  \u54616 \u45720 \u51032  \u49324 \u51088 \u46308 \u51008  \u51064 \u47448  \u50669 \u49324 \u47484  \u51096  \u50508 \u44256  \u51080 \u51020 \u51012  \u48372 \u50668  \u51452 \u44256 , \u44536 \u46308  \u51088 \u49888 \u51060  \u50517 \u48149 \u51012  \u48155 \u45716  \u51088 \u46308 \u51012  \u50948 \u54616 \u50668  \u44032 \u51109  \u50976 \u45733 \u54616 \u44256  \u45733 \u48320 \u51201 \u51064  \u50745 \u54840 \u51088  \u51060 \u49345 \u51004 \u47196  \u54840 \u49548 \u54624  \u49688  \u51080 \u51020 \u51012  \u51077 \u51613 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u54616 \u45208 \u45784 \u51032  \u49324 \u50629 \u51012  \u53356 \u44172  \u51648 \u50672 \u49884 \u53412 \u44256  \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u50640 \u44172  \u53360  \u44256 \u53685 \u51012  \u51452 \u44172  \u46112  \u44536 \u47084 \u54620  \u47785 \u51201 \u46308 \u51012  \u44648 \u46888 \u47532 \u44256  \u50501 \u51012  \u51228 \u51648 \u49884 \u53