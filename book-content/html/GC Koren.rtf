\f1\b0 \cf0 \
\uc0\u44536  \u53356 \u44256  \u46160 \u47140 \u50868  \u45216 \u50640  \u45824 \u54616 \u50668  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51008  \u44032 \u51109  \u50628 \u49689 \u54616 \u44256  \u44048 \u46041 \u51201 \u51064  \u47568 \u47196 \u50024  \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u46308 \u50640 \u44172  \u44536 \u46308 \u51032  \u50689 \u51201  \u54844 \u49688 \u49345 \u53468 \u50640 \u49436  \u44648 \u50612  \u54924 \u44060 \u50752  \u44216 \u49552 \u51004 \u47196  \u54616 \u45208 \u45784 \u51032  \u51088 \u48708 \u47484  \u44396 \u54616 \u46972 \u44256  \u54840 \u49548 \u54620 \u45796 . \'93\u49884 \u50728 \u50640 \u49436  \u45208 \u54036 \u51012  \u48520 \u47728  \u45208 \u51032  \u49457 \u49328 \u50640 \u49436  \u54840 \u44033 \u51012  \u48520 \u50612  \u51060  \u46405  \u44144 \u48124 \u51004 \u47196  \u45796  \u46504 \u44172  \u54624 \u51648 \u45768  \u51060 \u45716  \u50668 \u54840 \u50752 \u51032  \u45216 \u51060  \u51060 \u47476 \u44172  \u46120 \u51060 \u45768 \u46972  \u51060 \u51228  \u51076 \u48149 \u54616 \u50688 \u51004 \u45768 \'94, \'93\u44144 \u47337 \u54620  \u44552 \u49885 \u51068 \u51012  \u51221 \u54616 \u44256  \u49457 \u54924 \u47484  \u49440 \u44256 \u54616 \u44256  \u48177 \u49457 \u51012  \u47784 \u50500  \u44536  \u54924 \u47484  \u44144 \u47337 \u52992  \u54616 \u44256  \u51109 \u47196 \u47484  \u47784 \u51004 \u47728  \u49548 \u50500 \u50752  \u51222  \u47673 \u45716  \u51088 \u47484  \u47784 \u51004 \u47728  \u49888 \u46993 \u51012  \u44536  \u48169 \u50640 \u49436  \u45208 \u50724 \u44172  \u54616 \u47728  \u49888 \u48512 \u47196  \u44536  \u44264 \u48169 \u50640 \u49436  \u45208 \u50724 \u44172  \u54616 \u44256  \u50668 \u54840 \u50752 \u44760  \u49688 \u51333 \u46300 \u45716  \u51228 \u49324 \u51109 \u46308 \u51008  \u45229 \u49892 \u44284  \u45800  \u49324 \u51060 \u50640 \u49436  \u50872 \u47728 \'94, \'93\u45320 \u55148 \u45716  \u51060 \u51228 \u46972 \u46020  \u44552 \u49885 \u54616 \u47728  \u50872 \u47728  \u50528 \u53685 \u54616 \u44256  \u47560 \u51020 \u51012  \u45796 \u54616 \u50668  \u45236 \u44172 \u47196  \u46028 \u50500 \u50724 \u46972  \u54616 \u49512 \u45208 \u45768  \u45320 \u55148 \u45716  \u50743 \u51012  \u52258 \u51648  \u47568 \u44256  \u47560 \u51020 \u51012  \u52258 \u44256  \u45320 \u55148  \u54616 \u45208 \u45784  \u50668 \u54840 \u50752 \u44760 \u47196  \u46028 \u50500 \u50732 \u51648 \u50612 \u45796  \u44536 \u45716  \u51008 \u54812 \u47196 \u50864 \u49884 \u47728  \u51088 \u48708 \u47196 \u50864 \u49884 \u47728  \u45432 \u54616 \u44592 \u47484  \u45908 \u46356 \u54616 \u49884 \u47728  \u51064 \u50528 \u44032  \u53356 \u49884 \'94 (\u50844  2:1, 15~17, 12, 13) \u46020 \u45796 .\
\uc0\u54616 \u45208 \u45784 \u51032  \u45216 \u50640  \u49444  \u49688  \u51080 \u45716  \u48177 \u49457 \u46308 \u51012  \u51456 \u48708 \u49884 \u53412 \u44592  \u50948 \u54616 \u50668 \u49436 \u45716  \u54616 \u45208 \u51032  \u53360  \u44060 \u54785 \u51060  \u51060 \u47336 \u50612 \u51256 \u50556  \u54624  \u44163 \u51060 \u50632 \u45796 . \u45817 \u49888 \u51032  \u48177 \u49457 \u51060 \u46972 \u44256  \u44277 \u50616 \u54616 \u45716  \u49324 \u46988 \u46308  \u51473 \u51032  \u45824 \u48512 \u48516 \u51060  \u50689 \u50896 \u54620  \u44163 \u51012  \u50948 \u54616 \u50668  \u51456 \u48708 \u54616 \u51648  \u50506 \u44256  \u51080 \u51020 \u51012  \u48372 \u49888  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u51088 \u48708 \u47196 \u50024  \u44536 \u46308 \u51012  \u54844 \u49688 \u49345 \u53468 \u50640 \u49436  \u44648 \u50892  \u51452 \u45784 \u51032  \u51116 \u47548 \u51012  \u50948 \u54616 \u50668  \u51456 \u48708 \u47484  \u44054 \u52628 \u44172  \u54616 \u49884 \u44256 \u51088  \u44221 \u44256 \u51032  \u44592 \u48324 \u51012  \u48372 \u45236 \u49892  \u50696 \u51221 \u51060 \u50632 \u45796 .\
\uc0\u44536  \u44221 \u44256 \u51032  \u44592 \u48324 \u51008  \u50836 \u54620 \u44228 \u49884 \u47197  14\u51109 \u50640  \u44592 \u47197 \u46104 \u50612  \u51080 \u45796 . \u44144 \u44592 \u50640  \u54616 \u45720 \u51032  \u52380 \u49324 \u46308 \u50640  \u51032 \u54616 \u50668  \u51204 \u54028 \u46104 \u45716  \u49340 \u51473  (\u19977 \u37325 ) \u44592 \u48324 \u51060  \u44592 \u47197 \u46104 \u50612  \u51080 \u45796 . \u44536 \u47532 \u44256  \u44536  \u45796 \u51020 \u51004 \u47196  \u51593 \u49884  \u51064 \u51088 \u44032  \u50752 \u49436  \u46405 \u51032  \u51061 \u51008  \u44257 \u49885 \u51012  \u44144 \u46160 \u50612 \u46308 \u51060 \u45716  \u49324 \u44148 \u51060  \u51204 \u44060 \u46104 \u44256  \u51080 \u45796 . \u44221 \u44256 \u51032  \u52395 \u51704  \u44592 \u48324 \u51008  \u49900 \u54032 \u51060  \u51076 \u48149 \u54616 \u50688 \u45796 \u45716  \u44163 \u51012  \u49440 \u54252 \u54620 \u45796 . \u49440 \u51648 \u51088 \u45716  \u44277 \u51473 \u51012  \u45216 \u50500 \u44032 \u45716  \u54620  \u52380 \u49324 \u47484  \u48372 \u50520 \u45796 . \u44536 \u45716  \'93\u46405 \u50640  \u44144 \u54616 \u45716  \u51088 \u46308  \u44263  \u50668 \u47084  \u45208 \u46972 \u50752  \u51313 \u49549 \u44284  \u48169 \u50616 \u44284  \u48177 \u49457 \u50640 \u44172  \u51204 \u54624  \u50689 \u50896 \u54620  \u48373 \u51020 \u51012  \u44032 \u51276 \u45908 \u46972  \u44536 \u44032  \u53360  \u51020 \u49457 \u51004 \u47196  \u44032 \u47196 \u46104  \u54616 \u45208 \u45784 \u51012  \u46160 \u47140 \u50892 \u54616 \u47728  \u44536 \u50640 \u44172  \u50689 \u44305 \u51012  \u46028 \u47532 \u46972  \u51060 \u45716  \u44536 \u51032  \u49900 \u54032 \u54616 \u49892  \u49884 \u44036 \u51060  \u51060 \u47476 \u47104 \u51020 \u51060 \u45768  \u54616 \u45720 \u44284  \u46405 \u44284  \u48148 \u45796 \u50752  \u47932 \u46308 \u51032  \u44540 \u50896 \u51012  \u47564 \u46300 \u49888  \u51060 \u47484  \u44221 \u48176 \u54616 \u46972  \u54616 \u45908 \u46972 \'94 (\u44228  14:6, 7).\
\uc0\u51060  \u44592 \u48324 \u51008  \u50689 \u50896 \u54620  \u48373 \u51020 \u51032  \u54620  \u48512 \u48516 \u51004 \u47196  \u51204 \u54028 \u46104 \u50612 \u50556  \u54620 \u45796 . \u48373 \u51020 \u51032  \u51204 \u54028 \u45716  \u52380 \u49324 \u50640 \u44172  \u50948 \u51076 \u46108  \u44163 \u51060  \u50500 \u45768 \u44256  \u49324 \u46988 \u50640 \u44172  \u50948 \u51076 \u46108  \u44163 \u51060 \u45796 . \u44144 \u47337 \u54620  \u52380 \u49324 \u46308 \u51008  \u48373 \u51020  \u51204 \u54028 \u51032  \u49324 \u50629 \u51012  \u51648 \u46020 \u54624  \u52293 \u51076 \u51012  \u47585 \u50500  \u51064 \u47448 \u51032  \u44396 \u50896 \u51012  \u50948 \u54620  \u53360  \u50868 \u46041 \u51012  \u45812 \u45817 \u54616 \u44256  \u51080 \u45796 . \u44536 \u47084 \u45208  \u49892 \u51228 \u51201 \u51004 \u47196  \u48373 \u51020 \u51012  \u51204 \u54028 \u54616 \u45716  \u51068 \u51008  \u51648 \u49345 \u50640  \u51080 \u45716  \u44536 \u47532 \u49828 \u46020 \u51032  \u51333 \u46308 \u51012  \u53685 \u54616 \u50668  \u51060 \u47336 \u50612 \u51652 \u45796 .\
\uc0\u54616 \u45208 \u45784 \u51032  \u49457 \u47161 \u51032  \u44048 \u46041 \u44284  \u44536 \u48516 \u51032  \u47568 \u50432 \u51032  \u44368 \u54984 \u51012  \u49692 \u51333 \u54620  \u52649 \u49457 \u46108  \u51333 \u46308 \u51008  \u51060  \u44221 \u44256 \u47484  \u49464 \u49345 \u50640  \u51204 \u54028 \u54616 \u50668 \u50556  \u54664 \u45796 . \u44536 \u46308 \u51008  \'93\u50612 \u46160 \u50868  \u45936  \u48708 \u52712 \u45716  \u46321 \u48520 \'94\u44284  \u44057 \u51060  \'93\u49371 \u48324 \u51060 \'85\u47560 \u51020 \u50640  \u46496 \u50724 \u47476 \u44592 \u44620 \u51648 \'94 (\u48295 \u54980  1:19) \u54869 \u49892 \u54620  \u50696 \u50616 \u50640  \u50976 \u51032 \u54616 \u45716  \u49324 \u46988 \u46308 \u51060 \u50632 \u45796 . \u44536 \u46308 \u51008  \u54616 \u45208 \u45784 \u51032  \u51648 \u49885 \u51012  \u44048 \u52628 \u51064  \u47784 \u46304  \u48372 \u54868 \u48372 \u45796 \u46020  \u45908 \u50865  \u44050 \u51652  \u44163 \u51004 \u47196  \u52286 \u50500  \u44396 \u54616 \u44256  \'93\u51648 \u54812 \u47484  \u50619 \u45716  \u44163 \u51060  \u51008 \u51012  \u50619 \u45716  \u44163 \u48372 \u45796  \u45227 \u44256  \u44536  \u51060 \u51061 \u51060  \u51221 \u44552 \u48372 \u45796  \u45208 \u51020 \u51060 \u45768 \u46972 \'94 (\u51104  3:14) \u44256  \u49373 \u44033 \u54616 \u45716  \u49324 \u46988 \u46308 \u51060 \u50632 \u45796 . \u44536 \u47084 \u48064 \u47196  \u50668 \u54840 \u50752 \u44760 \u49436 \u45716  \u44536 \u46308 \u50640 \u44172  \u54616 \u45720 \u45208 \u46972 \u51032  \u50948 \u45824 \u54620  \u51068 \u46308 \u51012  \u48372 \u51060 \u49512 \u45796 . \'93\u50668 \u54840 \u50752 \u51032  \u52828 \u48128 \u54632 \u51060  \u44221 \u50808 \u54616 \u45716  \u51088 \u50640 \u44172  \u51080 \u51020 \u51060 \u50668  \u44536  \u50616 \u50557 \u51012  \u51200 \u55148 \u50640 \u44172  \u48372 \u51060 \u49884 \u47532 \u47196 \u45796 \'94 (\u49884  25:14).\
\uc0\u51116 \u47548 \u51032  \u51652 \u47532 \u47484  \u51060 \u54644 \u54616 \u44256  \u44536  \u51652 \u47532 \u47484  \u51204 \u54616 \u45716  \u51068 \u50640  \u54732 \u49888 \u54620  \u49324 \u46988 \u46308 \u51008  \u49548 \u50948  \u54617 \u47928 \u51201 \u51064  \u47732 \u50640 \u49436  \u49888 \u54617 \u51088 \u46308 \u51008  \u50500 \u45768 \u50632 \u45796 . \u47564 \u51068  \u49888 \u54617 \u51088 \u46308 \u51060  \u50676 \u47148 \u54616 \u44256  \u44221 \u44148 \u54616 \u44172  \u49457 \u44221 \u51012  \u50672 \u44396 \u54616 \u45716  \u52649 \u49892 \u54620  \u54028 \u49688 \u44988 \u46308 \u51060 \u50632 \u45796 \u47732 , \u44536 \u46308 \u51008  \u50612 \u46176 \u51032  \u49884 \u44592 \u47484  \u48152 \u46300 \u49884  \u44648 \u45804 \u50520 \u51012  \u44163 \u51060 \u50632 \u45796 . \u50696 \u50616 \u51008  \u44536 \u46308 \u50640 \u44172  \u48148 \u50556 \u55120 \u47196  \u51068 \u50612 \u45216  \u49324 \u44148 \u51012  \u50508 \u47140  \u51452 \u50632 \u51012  \u44163 \u51060 \u45796 . \u44536 \u47084 \u45208  \u44536 \u46308 \u51008  \u44536 \u50752  \u44057 \u51008  \u50948 \u52824 \u50640  \u49436 \u51648  \u50506 \u50520 \u51004 \u48064 \u47196  \u44592 \u48324 \u51008  \u48372 \u45796  \u48708 \u52380 \u54620  \u49324 \u46988 \u46308 \u50640 \u44172  \u51452 \u50612 \u51276 \u45796 . \u50696 \u49688 \u45784 \u44760 \u49436 \u45716  \'93\u48731 \u51060  \u51080 \u51012  \u46041 \u50504 \u50640  \u45796 \u45376  \u50612 \u46176 \u50640  \u48537 \u51105 \u55176 \u51648  \u50506 \u44172  \u54616 \u46972 \'94 (\u50836  12:35) \u44256  \u47568 \u50432 \u54616 \u49512 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436  \u51452 \u49888  \u48731 \u51012  \u44144 \u51208 \u54616 \u44144 \u45208  \u44536 \u46308 \u51060  \u48155 \u50500 \u46308 \u51068  \u49688  \u51080 \u45716  \u48276 \u50948  \u50504 \u50640  \u51080 \u45716  \u48731 \u51012  \u52286 \u45716  \u51068 \u51012  \u46321 \u54620 \u55176  \u54616 \u45716  \u51088 \u45716  \u50516 \u55121  \u44032 \u50868 \u45936  \u48260 \u47140 \u51652 \u45796 . \u44536 \u47084 \u45208  \u44396 \u51452 \u44760 \u49436 \u45716  \'93\u45208 \u47484  \u46384 \u47476 \u45716  \u51088 \u45716  \u50612 \u46176 \u50640  \u45796 \u45768 \u51648  \u50500 \u45768 \u54616 \u44256  \u49373 \u47749 \u51032  \u48731 \u51012  \u50619 \u51004 \u47532 \u46972 \'94 (\u50836  8:12) \u44256  \u47568 \u50432 \u54616 \u49888 \u45796 . \u51204 \u49900 \u51004 \u47196  \u54616 \u45208 \u45784 \u51032  \u46907 \u51012  \u54665 \u54616 \u44256 \u51088  \u54616 \u44256  \u51060 \u48120  \u51452 \u50612 \u51652  \u48731 \u51012  \u50676 \u49900 \u51004 \u47196  \u53456 \u44396 \u54616 \u45716  \u49324 \u46988 \u51008  \u45572 \u44396 \u46304 \u51648  \u48372 \u45796  \u53360  \u48731 \u51012  \u48155 \u44172  \u46112  \u44163 \u51060 \u45796 . \u44536 \u50752  \u44057 \u51008  \u49324 \u46988 \u50640 \u44172 \u45716  \u47784 \u46304  \u51652 \u47532  \u44032 \u50868 \u45936 \u47196  \u44536 \u47484  \u51064 \u46020 \u54644  \u51460  \u54616 \u45720 \u51032  \u44305 \u55064 \u47484  \u51648 \u45772  \u50612 \u46500  \u48324 \u46308 \u51060  \u48372 \u45252 \u51012  \u51077 \u51012  \u44163 \u51060 \u45796 .\
