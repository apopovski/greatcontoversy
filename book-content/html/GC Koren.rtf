\'93\uc0\u47564 \u51068  \u45572 \u44396 \u46304 \u51648  \u51200 \u55148 \u47484  \u54644 \u54616 \u44256 \u51088  \u54620 \u51593  \u51200 \u55148  \u51077 \u50640 \u49436  \u48520 \u51060  \u45208 \u49436  \u44536  \u50896 \u49688 \u47484  \u49548 \u47736 \u54624 \u51648 \u45768  \u45572 \u44396 \u46304 \u51648  \u54644 \u54616 \u47140  \u54616 \u47732  \u48152 \u46300 \u49884  \u51060 \u50752  \u44057 \u51060  \u51453 \u51076 \u51012  \u45817 \u54616 \u47532 \u46972 \'94 (\u44228  11:5). \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51012  \u51667 \u48159 \u45716  \u51088 \u46308 \u51008  \u48268 \u51012  \u48155 \u51648  \u50506 \u51012  \u49688  \u50630 \u45796 . \u51060  \u46160 \u47140 \u50868  \u49440 \u44256 \u51032  \u51032 \u48120 \u45716  \u50836 \u54620 \u44228 \u49884 \u47197  \u47560 \u51648 \u47561  \u51109 \u50640  \u48157 \u54784 \u51256  \u51080 \u45796 . \'93\u45236 \u44032  \u51060  \u52293 \u51032  \u50696 \u50616 \u51032  \u47568 \u50432 \u51012  \u46307 \u45716  \u44033 \u51064 \u50640 \u44172  \u51613 \u44144 \u54616 \u45432 \u45768  \u47564 \u51068  \u51060 \u44163 \u46308  \u50808 \u50640  \u45908 \u54616 \u47732  \u54616 \u45208 \u45784 \u51060  \u51060  \u52293 \u50640  \u44592 \u47197 \u46108  \u51116 \u50521 \u46308 \u51012  \u44536 \u50640 \u44172  \u45908 \u54616 \u49892  \u53552 \u51060 \u50836  \u47564 \u51068  \u45572 \u44396 \u46304 \u51648  \u51060  \u52293 \u51032  \u50696 \u50616 \u51032  \u47568 \u50432 \u50640 \u49436  \u51228 \u54616 \u50668  \u48260 \u47532 \u47732  \u54616 \u45208 \u45784 \u51060  \u51060  \u52293 \u50640  \u44592 \u47197 \u46108  \u49373 \u47749 \u45208 \u47924 \u50752  \u48143  \u44144 \u47337 \u54620  \u49457 \u50640  \u52280 \u50668 \u54632 \u51012  \u51228 \u54616 \u50668  \u48260 \u47532 \u49884 \u47532 \u46972 \'94 (\u44228  22:18, 19).\
\uc0\u44536 \u44163 \u51008  \u54616 \u45208 \u45784 \u44760 \u49436  \u44228 \u49884 \u54616 \u49512 \u44144 \u45208  \u47749 \u47161 \u54616 \u49888  \u44163 \u51008  \u50612 \u46496 \u54620  \u49885 \u51004 \u47196 \u46304 \u51648  \u48320 \u44221 \u54616 \u51648  \u47803 \u54616 \u46020 \u47197  \u44221 \u44228 \u54616 \u49884 \u44256 \u51088  \u49324 \u46988 \u46308 \u50640 \u44172  \u51452 \u49888  \u44221 \u44256 \u51060 \u45796 . \u44536  \u50628 \u49689 \u54620  \u49440 \u50616 \u51008  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51012  \u44221 \u49884 \u54616 \u46020 \u47197  \u50689 \u54693 \u51012  \u45180 \u52824 \u45716  \u47784 \u46304  \u49324 \u46988 \u46308 \u50640 \u44172  \u51201 \u50857 \u46108 \u45796 . \u50864 \u47532 \u44032  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u50640  \u49692 \u51333 \u54616 \u45712 \u45264  \u54616 \u51648  \u50506 \u45712 \u45264  \u54616 \u45716  \u44163 \u51060  \u48324 \u47196  \u45824 \u49688 \u47213 \u51648  \u50506 \u51008  \u47928 \u51228 \u46972 \u44256  \u44221 \u48149 \u54616 \u44172  \u47568 \u54616 \u45716  \u51088 \u46308 \u51008  \u44536  \u49440 \u44256  \u50526 \u50640  \u46504 \u44256  \u46160 \u47140 \u50892 \u54616 \u50668 \u50556  \u54624  \u44163 \u51060 \u45796 . \u54616 \u45208 \u45784 \u51032  \u44228 \u49884 \u48372 \u45796 \u46020  \u51088 \u44592  \u51088 \u49888 \u51032  \u51032 \u44204 \u51012  \u45458 \u51060 \u45716  \u47784 \u46304  \u51088 \u46308 , \u51088 \u44592 \u51032  \u54200 \u51032 \u47484  \u46020 \u47784 \u54616 \u44144 \u45208  \u49464 \u49549 \u44284  \u53440 \u54801 \u54616 \u44592  \u50948 \u54616 \u50668  \u49457 \u44221 \u51032  \u48516 \u47749 \u54620  \u51032 \u48120 \u47484  \u48320 \u44060 \u53076 \u51088  \u54616 \u45716  \u51088 \u46308 \u51008  \u47784 \u46160  \u51088 \u44592  \u51088 \u49888 \u50640 \u44172  \u46160 \u47140 \u50868  \u44208 \u44284 \u47484  \u44032 \u51256 \u50724 \u45716  \u51088 \u46308 \u51060 \u45796 . \u44592 \u47197 \u46108  \u47568 \u50432 , \u44263  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51008  \u47784 \u46304  \u51064 \u47448 \u51032  \u54408 \u49457 \u51012  \u51200 \u50872 \u51656 \u54616 \u44256  \u44536  \u44536 \u47495 \u46120 \u51060  \u50630 \u45716  \u49884 \u54744 \u50640  \u51032 \u54616 \u50668  \u48512 \u51313 \u54632 \u51060  \u46300 \u47084 \u45208 \u45716  \u47784 \u46304  \u51088 \u46308 \u50640 \u44172  \u51221 \u51396 \u51032  \u49440 \u44256 \u47484  \u45236 \u47532 \u44172  \u46112  \u44163 \u51060 \u45796 .\
\'93\uc0\u51200 \u55148 \u44032  \u44536  \u51613 \u44144 \u47484  \u47560 \u52832  \u46412 \'94 \u44263  \u46160  \u51613 \u51064 \u51060  \u48288 \u50743 \u51012  \u51077 \u44256  \u50696 \u50616 \u51012  \u54644 \u50556  \u54624  \u49884 \u44592 \u45716  1798\u45380 \u50640  \u47560 \u52452 \u45796 . \u44536  \u46160  \u51613 \u51064 \u51060  \u48708 \u48128 \u47532 \u50640  \u44536 \u46308 \u51032  \u49324 \u50629 \u51012  \u47560 \u52432  \u44040  \u46412 \u50640  \'93\u47924 \u51200 \u44081 \u50640 \u49436  \u50732 \u46972 \u50724 \u45716  \u51664 \u49849 \'94\u51004 \u47196  \u54364 \u49345 \u46108  \u49464 \u47141 \u51060  \u44536 \u46308 \u51012  \u54693 \u54616 \u50668  \u49912 \u50880 \u51012  \u54616 \u44172  \u46112  \u44163 \u51060 \u50632 \u45796 . \u50668 \u47084  \u49464 \u44592  \u46041 \u50504 \u50640  \u50976 \u47101 \u51032  \u47566 \u51008  \u45208 \u46972 \u46308 \u50640 \u49436  \u44368 \u54924 \u50752  \u44397 \u44032 \u47484  \u51648 \u48176 \u54620  \u49464 \u47141 \u46308 \u51008  \u48277 \u50773 \u44428 \u51012  \u47588 \u44060 \u52404 \u47196  \u49324 \u50857 \u54620  \u49324 \u45800 \u50640  \u51032 \u54616 \u50668  \u53685 \u51228 \u46104 \u50612  \u50772 \u45796 . \u44536 \u47084 \u45208  \u50668 \u44592 \u50640 \u49436  \u49324 \u45800 \u51032  \u49464 \u47141 \u51060  \u49352 \u47196  \u45208 \u53440 \u45208 \u45716  \u44163 \u51012  \u48372 \u44172  \u46108 \u45796 .\
\uc0\u47196 \u47560 \u44368 \u45716  \u49457 \u44221 \u51012  \u51316 \u51473 \u54616 \u45432 \u46972 \u44256  \u44277 \u50616 \u54616 \u47732 \u49436  \u51068 \u48152  \u49324 \u46988 \u46308 \u51060  \u50508  \u49688  \u50630 \u45716  \u50616 \u50612 \u47196  \u44536 \u44163 \u51012  \u44032 \u46160 \u50612  \u48260 \u47532 \u44256  \u49704 \u44200 \u48260 \u47532 \u45716  \u51068 \u51012  \u44536 \u46308 \u51032  \u48169 \u52840 \u51004 \u47196  \u49340 \u50520 \u45796 . \u44536 \u47084 \u48064 \u47196  \u47196 \u47560 \u44368 \u51032  \u51648 \u48176  \u50500 \u47000  \u44536  \u51613 \u51064 \u46308 \u51008  \'93\u48288 \u50743 \u51012  \u51077 \u44256 \'94 \u50696 \u50616 \u54616 \u50688 \u45796 . \u44536 \u47088 \u45936  \u51060 \u51228  \u46608  \u54616 \u45208 \u51032  \u45796 \u47480  \u49464 \u47141 , \u44263  \u47924 \u51200 \u44081 \u50640 \u49436  \u50732 \u46972 \u50728  \u51664 \u49849 \u51060  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51012  \u45824 \u54637 \u54616 \u50668  \u44277 \u44277 \u50672 \u54616 \u44172  \u49912 \u50864 \u44256 \u51088  \u51068 \u50612 \u45228 \u45796 .\
\uc0\u44536  \u51613 \u51064 \u46308 \u51060  \u51453 \u51076 \u51012  \u45817 \u54616 \u50668  \u44536  \u49884 \u52404 \u44032  \u44144 \u47532 \u50640  \u45459 \u50668  \u51080 \u45716  \u44536  \u53360  \u49457 \u51008  \'93\u50689 \u51201 \u51004 \u47196 \'94 \u50528 \u44413 \u51060 \u50632 \u45796 . \u49457 \u44221 \u51032  \u50669 \u49324 \u50640  \u44592 \u47197 \u46108  \u47784 \u46304  \u45208 \u46972  \u44032 \u50868 \u45936 \u49436  \u50528 \u44413 \u52376 \u47100  \u45824 \u45812 \u54616 \u44172  \u49332 \u50500  \u44228 \u49888  \u54616 \u45208 \u45784 \u51032  \u49892 \u51316 \u51012  \u48512 \u51064 \u54616 \u44256  \u44536 \u48516 \u51032  \u47749 \u47161 \u51012  \u44144 \u50669 \u54620  \u45208 \u46972 \u45716  \u50630 \u45796 . \u46608 \u54620  \u50528 \u44413 \u51032  \u50773 \u52376 \u47100  \u54616 \u45208 \u45784 \u51032  \u44428 \u50948 \u50640  \u45824 \u54616 \u50668  \u45432 \u44264 \u51201 \u51060 \u44256 \u46020  \u50724 \u47564 \u54620  \u53468 \u46020 \u47196  \u48152 \u54637 \u54620  \u51076 \u44552 \u51008  \u50630 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436  \u47784 \u49464 \u47484  \u53685 \u54616 \u50668  \u50668 \u54840 \u50752 \u51032  \u51060 \u47492 \u51004 \u47196  \u48148 \u47196 \u50640 \u44172  \u44592 \u48324 \u51012  \u48372 \u45256 \u51012  \u46412  \u48148 \u47196 \u45716  \'93\u50668 \u54840 \u50752 \u44032  \u45572 \u44396 \u44288 \u45824  \u45236 \u44032  \u44536  \u47568 \u51012  \u46307 \u44256  \u51060 \u49828 \u46972 \u50648 \u51012  \u48372 \u45236 \u44192 \u45712 \u45264  \u45208 \u45716  \u50668 \u54840 \u50752 \u47484  \u50508 \u51648  \u47803 \u54616 \u45768  \u51060 \u49828 \u46972 \u50648 \u46020  \u48372 \u45236 \u51648  \u50500 \u45768 \u54616 \u47532 \u46972 \'94 (\u52636  5:2) \u44256  \u50724 \u47564 \u54616 \u44172  \u47568 \u54616 \u50688 \u45796 . \u44536 \u44163 \u51008  \u47924 \u49888 \u47200 \u51060 \u45796 . \u44536 \u47084 \u48064 \u47196  \u50528 \u44413 \u51004 \u47196  \u54364 \u49345 \u46108  \u45208 \u46972 \u45716  \u49332 \u50500  \u44228 \u49888  \u54616 \u45208 \u45784 \u51032  \u47749 \u47161 \u51012  \u48512 \u51221 \u54616 \u45716  \u51068 \u50640  \u50528 \u44413 \u44284  \u50976 \u49324 \u54620  \u47568 \u51012  \u54616 \u44256 , \u50528 \u44413 \u44284  \u47560 \u52268 \u44032 \u51648 \u51032  \u48520 \u49888 \u44284  \u48152 \u50669  \u51221 \u49888 \u51012  \u45208 \u53440 \u45236 \u44172  \u46112  \u44163 \u51060 \u45796 . \u46608  \'93\u44536  \u53360  \u49457 \'94\u51008  \'93\u50689 \u51201 \u51004 \u47196 \'94 \u49548 \u46036 \u50640  \u48708 \u50976 \u46104 \u44256  \u51080 \u45796 . \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51012  \u48276 \u54616 \u45716  \u45936  \u51080 \u50612 \u49436 \u51032  \u49548 \u46036 \u51032  \u48512 \u54056 \u45716  \u53945 \u48324 \u55176  \u51020 \u46976 \u51004 \u47196  \u45208 \u53440 \u45228 \u45796 . \u44536 \u47084 \u48064 \u47196  \u51060  \u49457 \u44221 \u51032  \u44592 \u47197 \u51012  \u49457 \u52712 \u49884 \u53420  \u45208 \u46972 \u51032  \u46748 \u47159 \u54620  \u53945 \u49457 \u51008  \u46608 \u54620  \u49548 \u46036 \u44284  \u46609 \u44057 \u51008  \u51396 \u44032  \u51080 \u50612 \u50556  \u54624  \u44163 \u51060 \u50632 \u45796 .\
