\uc0\u51060 \u50752  \u47560 \u52268 \u44032 \u51648 \u47196  \u51116 \u47548 \u50640  \u44288 \u54620  \u54364 \u49345 \u46020  \u44536  \u49345 \u51669 \u51201  \u48393 \u49324 \u44032  \u51648 \u51201 \u54620  \u49884 \u44592 \u44032  \u46104 \u47732  \u49457 \u52712 \u46104 \u44256 \u50556  \u47568  \u44163 \u51060 \u50632 \u45796 . \u47784 \u49464 \u51032  \u44508 \u47168 \u50640  \u51080 \u50612 \u49436  \u49457 \u49548 \u47484  \u51221 \u44208 \u52992  \u54616 \u45716  \u45824 \u49549 \u51396 \u51068 \u51008  \u50976 \u45824 \u47141 \u51004 \u47196  7\u50900  10\u51068 \u51060 \u50632 \u45716 \u45936 , \u44536 \u45216 \u50640  \u51228 \u49324 \u51109 \u51060  \u47784 \u46304  \u51060 \u49828 \u46972 \u50648  \u48177 \u49457 \u51012  \u50948 \u54616 \u50668  \u49549 \u51396 \u54616 \u44256  \u44536 \u46308 \u51032  \u51396 \u47484  \u49457 \u49548 \u50640 \u49436  \u51228 \u54616 \u50668  \u48260 \u47536  \u54980 \u50640  \u45208 \u50752 \u49436  \u48177 \u49457 \u46308 \u51012  \u50948 \u54616 \u50668  \u48373 \u51012  \u48716 \u50632 \u45796  (\u47112  16:9~34 \u52280 \u51312 ). \u44536 \u50752  \u44057 \u51060  \u50864 \u47532 \u51032  \u45824 \u51228 \u49324 \u51109  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u46020  \u49464 \u49345 \u51012  \u51221 \u44208 \u52992  \u54616 \u44592  \u50948 \u54616 \u50668  \u45208 \u53440 \u45208 \u49324  \u51396 \u50752  \u51396 \u51064 \u46308 \u51012  \u47736 \u54616 \u50668  \u48260 \u47536  \u54980 \u50640  \u45817 \u49888 \u51012  \u44592 \u45796 \u47532 \u44256  \u51080 \u45716  \u48177 \u49457 \u46308 \u50640 \u44172  \u50689 \u49373 \u51004 \u47196  \u52629 \u48373 \u54644  \u51452 \u49892  \u44163 \u51060 \u46972 \u44256  \u48127 \u50632 \u45796 . 7\u50900  10\u51068 , \u44263  \u49457 \u49548 \u47484  \u51221 \u44208 \u52992  \u54616 \u45716  \u45824 \u49549 \u51396 \u51068 \u51008  1844\u45380  10\u50900  22\u51068 \u50640  \u54644 \u45817 \u46104 \u50632 \u51004 \u48064 \u47196  \u44536 \u45216 \u51060  \u51452 \u45784 \u51032  \u51116 \u47548 \u51032  \u45216 \u47196  \u44036 \u51452 \u46104 \u50632 \u45796 . \u51060 \u44163 \u51008  2300\u51452 \u50556 \u44032  \u44536  \u54644  \u44032 \u51012 \u50640  \u47560 \u52432 \u51652 \u45796 \u44256  \u51060 \u48120  \u47568 \u54620  \u51613 \u44144 \u50752  \u51068 \u52824 \u46104 \u48064 \u47196  \u44536  \u44208 \u47200 \u51008  \u50880 \u51649 \u51068  \u49688  \u50630 \u45716  \u44163 \u51004 \u47196  \u49373 \u44033 \u46104 \u50632 \u45796 .\
\uc0\u47560 \u53468 \u48373 \u51020  25\u51109 \u51032  \u48708 \u50976 \u50640 \u45716  \u44592 \u45796 \u47532 \u45716  \u49884 \u44592 \u50752  \u51312 \u45716  \u51068 \u51060  \u51080 \u51008  \u54980 \u50640  \u49888 \u46993 \u51060  \u50724 \u45716  \u44163 \u51004 \u47196  \u46104 \u50612  \u51080 \u45796 . \u44536 \u44163  \u50669 \u49884  \u51060 \u48120  \u50676 \u44144 \u54620  \u50696 \u50616 \u44284  \u54364 \u49345 \u50640  \u51032 \u54620  \u51613 \u44144 \u50752  \u51068 \u52824 \u46104 \u50632 \u45796 . \u44536 \u46308 \u51008  \u44536  \u54869 \u49892 \u49457 \u50640  \u45824 \u54616 \u50668  \u44053 \u54620  \u54869 \u49888 \u51012  \u44032 \u51648 \u44172  \u46104 \u50632 \u51004 \u47728 , \u47560 \u52840 \u45236  \u47924 \u49688 \u54620  \u49888 \u51088 \u46308 \u51060  \'93\u48164 \u51473  \u49548 \u47532 \'94\u47484  \u50808 \u52824 \u44172  \u46104 \u50632 \u45796 .\
\uc0\u51060  \u50868 \u46041 \u51008  \u51312 \u49688 \u50752  \u44057 \u51060  \u44033  \u44275 \u51004 \u47196  \u54140 \u51256 \u44052 \u45796 . \u51060  \u46020 \u49884 \u50640 \u49436  \u51200  \u46020 \u49884 \u47196 , \u51060  \u47560 \u51012 \u50640 \u49436  \u51200  \u47560 \u51012 \u47196 , \u44536 \u44163 \u51008  \u47680 \u47532  \u46504 \u50612 \u51652  \u48317 \u52492 \u50640  \u51060 \u47476 \u44592 \u44620 \u51648  \u54140 \u51256  \u44032 \u49436  \u44592 \u45796 \u47532 \u44256  \u51080 \u45716  \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u46308 \u51012  \u50756 \u51204 \u55176  \u44648 \u50864 \u52452 \u45796 . \u46496 \u50724 \u47476 \u45716  \u54663 \u48731  \u50526 \u50640  \u49324 \u46972 \u51648 \u45716  \u51060 \u47480  \u50500 \u52840 \u51032  \u49436 \u47532 \u50752  \u44057 \u51060  \u44305 \u49888 \u51088 \u46308 \u46020  \u44536 \u50752  \u44057 \u51008  \u49440 \u54252  \u50526 \u50640 \u49436  \u51088 \u52712 \u47484  \u44048 \u52628 \u50632 \u45796 . \u49888 \u51088 \u46308 \u51008  \u44536 \u46308 \u51032  \u51032 \u49900 \u44284  \u51032 \u54841 \u51060  \u49324 \u46972 \u51652  \u44163 \u51012  \u44648 \u45804 \u50520 \u51004 \u47728 , \u55148 \u47581 \u44284  \u50857 \u44592 \u47196  \u47560 \u51020 \u50640  \u54876 \u44592 \u44032  \u45336 \u52452 \u45796 . \u51060  \u50868 \u46041 \u51008  \u55124 \u55176  \u44221 \u54744 \u54616 \u45716  \u48148 \u50752  \u44057 \u51060  \u55141 \u48516 \u51201 \u51064  \u44163 \u50640 \u47564  \u51032 \u51316 \u54616 \u44256  \u54616 \u45208 \u45784 \u51032  \u49457 \u47161 \u51032  \u53685 \u51228 \u47141 \u51060  \u50630 \u51020 \u51004 \u47196  \u49373 \u44592 \u45716  \u44537 \u45800 \u51201 \u51064  \u51068 \u51008  \u51204 \u54784  \u50500 \u45768 \u50632 \u45796 . \u44536 \u44163 \u51008  \u50715 \u51201  \u51060 \u49828 \u46972 \u50648  \u49324 \u46988 \u46308 \u51060  \u54616 \u45208 \u45784 \u51032  \u51333 \u51012  \u53685 \u54616 \u50668  \u44204 \u52293 \u51032  \u44592 \u4