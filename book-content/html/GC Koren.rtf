\u49688  \u51080 \u45716  \u51456 \u48708 \u44032  \u51060 \u47336 \u50612 \u51276 \u45796 . \u44536 \u47532 \u44256  \u44536 \u45716  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u50640 \u49436  \u50619 \u51008  \u47924 \u44592 \u47484  \u49324 \u50857 \u54624  \u49688  \u51080 \u50632 \u51012  \u49104 \u47564  \u50500 \u45768 \u46972  \u54617 \u44368 \u50640 \u49436  \u51648 \u51201  \u54984 \u47144 \u51012  \u49939 \u50520 \u44592  \u46412 \u47928 \u50640  \u54617 \u51088 \u46308 \u51032  \u49688 \u48277  (\u25163 \u27861 ) \u46020  \u50508 \u44256  \u51080 \u50632 \u45796 . \u44536 \u51032  \u52380 \u48512  (\u22825 \u36070 ) \u51032  \u51116 \u45733 \u44284  \u44618 \u44256  \u45331 \u51008  \u51648 \u49885 \u51008  \u46041 \u47308 \u46308 \u44284  \u50896 \u49688 \u46308 \u51032  \u51316 \u44221 \u51012  \u48155 \u50520 \u45796 . \u44536 \u51032  \u51648 \u51648 \u51088 \u46308 \u51008  \u44536 \u46308 \u51032  \u53804 \u49324 \u44032  \u45817 \u49884 \u51032  \u44397 \u45236 \u51032  \u51648 \u46020 \u51088 \u46308  \u44032 \u50868 \u45936 \u49436  \u52395 \u51704 \u44032 \u45716  \u49324 \u46988 \u51064  \u44163 \u51012  \u47564 \u51313 \u54616 \u44172  \u50668 \u44592 \u44256  \u51080 \u50632 \u44256 , \u44536 \u51032  \u50896 \u49688 \u46308 \u51008  \u44060 \u54785 \u51012  \u51648 \u51648 \u54616 \u45716  \u49324 \u46988 \u46308 \u51032  \u47924 \u51648 \u50752  \u50557 \u51216 \u51012  \u54253 \u47196 \u54632 \u51004 \u47196  \u44048 \u55176  \u44060 \u54785  \u49324 \u50629 \u51012  \u47736 \u49884 \u54616 \u47140 \u44256  \u54616 \u51648  \u47803 \u54616 \u50688 \u45796 .\
