\uc0\u49828 \u53076 \u53952 \u47004 \u46300 \u51032  \u50668 \u50773 \u51012  \u51649 \u51217  \u45824 \u47732 \u54664 \u51012  \u46412  \u44060 \u54785 \u54028 \u51032  \u51648 \u46020 \u51088 \u46308  \u51473 \u50640 \u45716  \u44536 \u46308 \u51032  \u50676 \u49457 \u51012  \u51453 \u50668  \u48260 \u47536  \u51088 \u44032  \u51201 \u51648  \u50506 \u50520 \u51004 \u45208  \u51316  \u45433 \u49828 \u45716  \u51652 \u47532 \u47484  \u50948 \u54616 \u50668  \u54869 \u44256 \u55176  \u51613 \u44144 \u54616 \u50688 \u45796 . \u44536 \u45716  \u47924 \u47560 \u52293 \u51004 \u47196  \u47588 \u49688 \u45817 \u54616 \u51648  \u50506 \u50520 \u44256 , \u50948 \u54801 \u51004 \u47196  \u50948 \u52629 \u45817 \u54616 \u51648 \u46020  \u50506 \u50520 \u45796 . \u50668 \u50773 \u51008  \u44536 \u50640 \u44172  \u51060 \u45800 \u51088 \u46972 \u45716  \u51396 \u47484  \u49440 \u44256 \u54616 \u50688 \u45796 . \u50668 \u50773 \u51008  \u44536 \u44032  \u44397 \u44032 \u50640 \u49436  \u44552 \u51648 \u54616 \u45716  \u51333 \u44368 \u47484  \u48155 \u50500 \u46308 \u51060 \u46020 \u47197  \u49324 \u46988 \u46308 \u51012  \u44032 \u47476 \u52452 \u51004 \u47728 , \u44536 \u47196  \u51064 \u54616 \u50668  \u50948 \u50640  \u51080 \u45716  \u51088 \u47484  \u49692 \u51333 \u54616 \u46972 \u45716  \u54616 \u45208 \u45784 \u51032  \u47749 \u47161 \u51012  \u50612 \u44596  \u44163 \u51060 \u46972 \u44256  \u51452 \u51109 \u54616 \u50688 \u45796 . \u44536 \u47084 \u51088  \u45433 \u49828 \u45716  \u54869 \u49892 \u54616 \u44172  \u45824 \u45813 \u54616 \u50688 \u45796 .\
\'93\uc0\u48148 \u47480  \u51333 \u44368 \u45716  \u49464 \u49345  \u51076 \u44552 \u50640 \u44172 \u49436  \u49464 \u47141 \u51060 \u45208  \u44428 \u50948 \u47484  \u48155 \u45716  \u44163 \u51060  \u50500 \u45768 \u44256  \u50724 \u51649  \u50689 \u50896 \u54616 \u49888  \u54616 \u45208 \u45784 \u44760 \u47196 \u48512 \u53552  \u48155 \u45716  \u44163 \u51060 \u48064 \u47196  \u50612 \u46500  \u48177 \u49457 \u46308 \u46020  \u51088 \u44592 \u46308 \u51032  \u51333 \u44368 \u47484  \u51076 \u44552 \u51032  \u44592 \u54840 \u50640  \u46384 \u46972  \u51221 \u54624  \u49688 \u45716  \u50630 \u49845 \u45768 \u45796 . \u44536  \u51060 \u50976 \u45716  \u51076 \u44552 \u46308  \u51473 \u50640 \u45716  \u54616 \u45208 \u45784 \u51032  \u52280  \u51333 \u44368 \u50640  \u45824 \u54616 \u50668  \u45796 \u47480  \u49324 \u46988 \u46308 \u48372 \u45796 \u46020  \u54620 \u52789  \u45908  \u47924 \u51648 \u54620  \u49324 \u46988 \u51060  \u55124 \u55176  \u51080 \u44592  \u46412 \u47928 \u51077 \u45768 \u45796 . \'85\u47564 \u51068  \u50500 \u48652 \u46972 \u54632 \u51032  \u54980 \u49552 \u51060  \u47784 \u46160  \u50724 \u47019 \u46041 \u50504  \u49549 \u54616 \u50668  \u51080 \u45912  \u48148 \u47196 \u51032  \u51333 \u44368 \u47484  \u48155 \u50500 \u46308 \u50688 \u51012  \u44163  \u44057 \u51004 \u47732  \u51060  \u49464 \u49345 \u50640 \u45716  \u50612 \u46496 \u54620  \u51333 \u44368 \u44032  \u45224 \u50500  \u51080 \u44192 \u49845 \u45768 \u44620 ? \u54841 \u51008  \u49324 \u46020  \u49884 \u45824 \u51032  \u47784 \u46304  \u49324 \u46988 \u51060  \u47196 \u47560  \u54889 \u51228 \u51032  \u51333 \u44368 \u47484  \u48155 \u50500 \u46308 \u50688 \u45796 \u47732  \u50724 \u45720 \u45216 \u51032  \u49464 \u49345 \u50640 \u45716  \u50612 \u46496 \u54620  \u51333 \u44368 \u44032  \u51080 \u44172  \u46104 \u50632 \u44192 \u49845 \u45768 \u44620 ? \'85\u48708 \u47197  \u48177 \u49457 \u46308 \u51008  \u51076 \u44552 \u46308 \u50640 \u44172  \u49692 \u51333 \u54616 \u46972 \u45716  \u47749 \u47161 \u51012  \u48155 \u44256  \u51080 \u51012 \u51648 \u46972 \u46020  \u50668 \u50773  \u51204 \u54616 \u50668 , \u49888 \u44368  (\u20449 \u25934 ) \u50640  \u51080 \u50612 \u49436 \u45716  \u48177 \u49457 \u46308 \u51060  \u44536  \u50773 \u46308 \u51032  \u51333 \u44368 \u50640  \u47588 \u50668  \u51080 \u51648  \u50506 \u51020 \u51012  \u51064 \u51221 \u54644  \u51452 \u49884 \u44592  \u48148 \u46989 \u45768 \u45796 .\'94\
\uc0\u50668 \u50773  \u47700 \u47532 \u45716  \u47568 \u54616 \u50688 \u45796 . \'93\u45320 \u45716  \u49457 \u44221 \u51012  \u51060 \u47088  \u51032 \u48120 \u47196  \u54644 \u49437 \u54616 \u44256 , \u44536 \u46308  (\u47196 \u47560 \u44368 \u51032  \u44368 \u49324 \u46308 ) \u51008  \u46608  \u45796 \u47480  \u51032 \u48120 \u47196  \u54644 \u49437 \u54620 \u45796 . \u44536 \u47084 \u47732  \u45208 \u45716  \u45572 \u44396 \u47484  \u48127 \u50612 \u50556  \u54616 \u47728 , \u45572 \u44032  \u54032 \u45800 \u51012  \u54644 \u51460  \u44163 \u51064 \u44032 ?\'94\
\'93\uc0\u50668 \u50773  \u51204 \u54616 \u44760 \u49436 \u45716  \u49457 \u44221 \u51060  \u48157 \u55176  \u47568 \u54620  \u54616 \u45208 \u45784 \u51012  \u48127 \u51004 \u49884 \u47732  \u44536 \u47564 \u51077 \u45768 \u45796 . \u44144 \u47337 \u54620  \u47568 \u50432 \u51060  \u50668 \u50773 \u51012  \u44032 \u47476 \u52824 \u45716  \u44163  \u51060 \u50808 \u50640 \u45716  \u51060 \u54200  \u47568 \u51060 \u45208  \u51200 \u54200  \u47568 \u51060 \u45208  \u48127 \u51012  \u54596 \u50836 \u44032  \u50630 \u49845 \u45768 \u45796 . \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51008  \u44536  \u51088 \u52404 \u44032  \u48516 \u47749 \u54633 \u45768 \u45796 . \u47564 \u51068  \u50528 \u47588 \u54620  \u51216 \u51060  \u51080 \u45716  \u44163 \u52376 \u47100  \u49373 \u44033 \u46112  \u44221 \u50864 \u50640 \u46972 \u46020  \u54616 \u45208 \u45784 \u44284  \u44208 \u53076  \u49345 \u52824 \u46104 \u51648  \u50506 \u45716  \u49457 \u47161 \u44760 \u49436 \u45716  \u49457 \u44221 \u51032  \u45796 \u47480  \u48512 \u48516 \u50640 \u49436  \u44536  \u51216 \u51012  \u48516 \u47749 \u55176  \u50508 \u47140  \u51452 \u49901 \u45768 \u45796 . \u44536 \u47084 \u48064 \u47196  \u49324 \u46988 \u51060  \u51664 \u51667  \u47560 \u51020 \u51012  \u50756 \u50501 \u54616 \u44172  \u54616 \u50668  \u47924 \u51648 \u54620  \u45936  \u47931 \u55176 \u51648  \u50506 \u45716  \u54620  \u51032 \u49900 \u51008  \u44208 \u53076  \u50630 \u51012  \u44163 \u51077 \u45768 \u45796 \'94 (David Laing, The Collected Works of John Knox, vol.2, pp.281, 284).\
\uc0\u44536  \u44060 \u54785 \u51088 \u45716  \u49373 \u47749 \u51032  \u50948 \u54744 \u51012  \u47924 \u47493 \u50416 \u44256  \u50773 \u51032  \u50526 \u50640 \u49436  \u44536 \u50752  \u44057 \u51008  \u51652 \u47532 \u47484  \u47568 \u54616 \u50688 \u45796 . \u44536 \u45716  \u46609 \u44057 \u51008  \u48520 \u44404 \u51032  \u50857 \u44592 \u47484  \u44032 \u51648 \u44256  \u47785 \u51201 \u51012  \u54693 \u54616 \u50668  \u45208 \u50500 \u44052 \u44256 , \u49828 \u53076 \u53952 \u47004 \u46300 \u44032  \u48277 \u50773 \u44428 \u51004 \u47196 \u48512 \u53552  \u54644 \u48169 \u46104 \u45716  \u45216 \u44620 \u51648  \u44592 \u46020 \u54616 \u47732 \u49436  \u44144 \u47337 \u54620  \u49912 \u50880 \u51012  \u44228 \u49549 \u54616 \u50688 \u45796 .\
