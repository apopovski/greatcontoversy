\f1\b0 \cf0 \
\uc0\u51060  \u44275 \u51060  \u49324 \u45800 \u44284  \u50501 \u54620  \u52380 \u49324 \u46308 \u51060  \u51068 \u52380  \u45380 \u44036  \u44144 \u54624  \u44275 \u51060 \u45796 . \u49324 \u45800 \u51008  \u51648 \u44396 \u50640  \u44039 \u54784 \u49436  \u45796 \u47480  \u49464 \u44228 \u50640  \u51217 \u44540 \u54616 \u50668  \u44208 \u53076  \u53440 \u46973 \u54620  \u51201 \u51060  \u50630 \u45716  \u51088 \u46308 \u51012  \u50976 \u54841 \u54616 \u44256  \u44340 \u47213 \u55184  \u49688  \u50630 \u44172  \u46112  \u44163 \u51060 \u45796 . \u44536 \u44032  \u44208 \u48149 \u45817 \u54620 \u45796 \u45716  \u44163 \u51008  \u51060 \u47084 \u54620  \u51032 \u48120 \u50640 \u49436  \u54616 \u45716  \u47568 \u51060 \u45796 . \u44536 \u44032  \u49464 \u47141 \u51012  \u54665 \u49324 \u54624  \u45824 \u49345 \u51088 \u45716  \u54620  \u49324 \u46988 \u46020  \u45224 \u50500  \u51080 \u51648  \u50506 \u45796 . \u50668 \u47084  \u49464 \u44592  \u46041 \u50504  \u50724 \u47196 \u51648  \u44536 \u51032  \u44592 \u49256 \u51060  \u46104 \u50612  \u50728  \u44592 \u47564 \u44284  \u54028 \u44340  \u54665 \u50948 \u50640 \u49436  \u44536 \u45716  \u50756 \u51204 \u55176  \u48516 \u47532 \u46104 \u50612  \u51080 \u45796 .\
\uc0\u49440 \u51648 \u51088  \u51060 \u49324 \u50556 \u45716  \u49324 \u45800 \u51060  \u54056 \u48176 \u45817 \u54616 \u45716  \u46412 \u47484  \u48120 \u47532  \u48372 \u44256  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u54616 \u50688 \u45796 . \'93\u45320  \u50500 \u52840 \u51032  \u50500 \u46308  \u44228 \u47749 \u49457 \u51060 \u50668  \u50612 \u52236  \u44536 \u47532  \u54616 \u45720 \u50640 \u49436  \u46504 \u50612 \u51276 \u51004 \u47728  \u45320  \u50676 \u44397 \u51012  \u50638 \u51008  \u51088 \u50668  \u50612 \u52236  \u44536 \u47532  \u46405 \u50640  \u52237 \u54804 \u45716 \u44256  \u45348 \u44032  \u45348  \u47560 \u51020 \u50640  \u51060 \u47476 \u44592 \u47484  \u45236 \u44032  \u54616 \u45720 \u50640  \u50732 \u46972  \u54616 \u45208 \u45784 \u51032  \u47943 \u48324  \u50948 \u50640  \u45208 \u51032  \u48372 \u51340 \u47484  \u45458 \u51060 \u47532 \u46972 \'85\u51648 \u44537 \u55176  \u45458 \u51008  \u51088 \u50752  \u48708 \u44592 \u47532 \u46972  \u54616 \u46020 \u45796  \u44536 \u47084 \u45208  \u51060 \u51228  \u45348 \u44032  \u51020 \u48512  \u44263  \u44396 \u45929 \u51060 \u51032  \u47592  \u48145 \u50640  \u48736 \u52824 \u50864 \u47532 \u47196 \u45796  \u45320 \u47484  \u48372 \u45716  \u51088 \u44032  \u51452 \u47785 \u54616 \u50668  \u45320 \u47484  \u51088 \u49464 \u55176  \u49332 \u54196 \u48372 \u47728  \u47568 \u54616 \u44592 \u47484  \u51060  \u49324 \u46988 \u51060  \u46405 \u51012  \u51652 \u46041 \u49884 \u53412 \u47728  \u50676 \u44397 \u51012  \u44201 \u46041 \u49884 \u53412 \u47728  \u49464 \u44228 \u47484  \u54889 \u47924 \u52992 \u54616 \u47728  \u49457 \u51021 \u51012  \u54028 \u44340 \u54616 \u47728  \u49324 \u47196 \u51105 \u55180  \u51088 \u47484  \u44536  \u51665 \u51004 \u47196  \u45459 \u50500  \u48372 \u45236 \u51648  \u50506 \u45912  \u51088 \u44032  \u50500 \u45768 \u45544  \u54616 \u47532 \u47196 \u45796 \'94 (\u49324  14:12~17).\
\uc0\u50977 \u52380  \u45380 \u44036  \u49324 \u45800 \u51032  \u48152 \u50669  \u54665 \u50948 \u45716  \'93\u46405 \u51012  \u51652 \u46041 \'94\u49884 \u53040 \u45796 . \u44536 \u45716  \'93\u49464 \u44228 \u47484  \u54889 \u47924 \u52992  \u54616 \u47728  \u49457 \u51021 \u51012  \u54028 \u44340 \u54616 \u47728 \'94 \'93\u49324 \u47196 \u51105 \u55180  \u51088 \u47484  \u44536  \u51665 \u51004 \u47196  \u45459 \u50500  \u48372 \u45236 \u51648  \u50506 \'94\u50520 \u45796 . \u44536 \u45716  \u50977 \u52380  \u45380 \u44036  \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u46308 \u51012  \u44536 \u51032  \u44048 \u50725 \u50640  \u44032 \u46160 \u50612  \u46160 \u50632 \u45796 . \u49324 \u45800 \u51008  \u44536 \u46308 \u51012  \u50689 \u50896 \u55176  \u44032 \u46160 \u50612  \u46160 \u44256 \u51088  \u54616 \u50688 \u51004 \u45208  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u44536 \u51032  \u49549 \u48149 \u51012  \u44648 \u46888 \u47532 \u49884 \u44256  \u44039 \u55180  \u51088 \u46308 \u51012  \u51088 \u50976 \u47213 \u44172  \u45459 \u50500  \u51452 \u49512 \u45796 .\
\uc0\u51060 \u51228  \u50501 \u51064 \u46308 \u44620 \u51648 \u46020  \u49324 \u45800 \u51032  \u49464 \u47141 \u51060  \u48120 \u52824 \u51648  \u47803 \u54616 \u45716  \u44275 \u50640  \u51080 \u45796 . \u44536 \u47084 \u48064 \u47196  \u44536 \u45716  \u44536 \u51032  \u50501 \u54620  \u52380 \u49324 \u46308 \u44284  \u54632 \u44760  \u45224 \u50500 \u51080 \u51004 \u47732 \u49436  \u51396 \u50501 \u51060  \u44032 \u51256 \u50728  \u51200 \u51452 \u51032  \u44208 \u44284 \u44032  \u50612 \u46496 \u54620  \u44163 \u51064 \u51648  \u44648 \u45803 \u44172  \u46108 \u45796 . \'93\u50676 \u48169 \u51032  \u50773 \u46308 \u51008  \u47784 \u46160  \u44033 \u44033  \u51088 \u44592  \u51665 \u50640 \u49436  \u50689 \u44305 \u51473 \u50640  \u51088 \u44148 \u47560 \u45716  \u50724 \u51649  \u45320 \u45716  \u51088 \u44592  \u47924 \u45924 \u50640 \u49436  \u45236 \u50612  \u51923 \u44220 \u51004 \u45768 \'85\u45348 \u44032  \u51088 \u44592  \u46405 \u51012  \u47581 \u52992  \u54616 \u50688 \u44256  \u51088 \u44592  \u48177 \u49457 \u51012  \u51453 \u50688 \u51004 \u48064 \u47196  \u44536 \u46308 \u44284  \u51068 \u48152 \u51004 \u47196  \u50504 \u51109 \u54632 \u51012  \u50619 \u51648  \u47803 \u54616 \'94 (\u49324  14:18~20) \u45712 \u45768 \u46972 .\
\uc0\u51068 \u52380  \u45380 \u44036  \u49324 \u45800 \u51008  \u44536  \u54889 \u54224 \u46108  \u46405 \u50640 \u49436  \u48169 \u54889 \u54616 \u47728  \u44536 \u44032  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51012  \u44144 \u49836 \u47084  \u48152 \u50669 \u54620  \u44208 \u44284 \u47484  \u48148 \u46972 \u48376 \u45796 . \u44536  \u44592 \u44036 \u50640  \u45817 \u54616 \u45716  \u49324 \u45800 \u51032  \u44256 \u53685 \u51008  \u52280 \u51004 \u47196  \u53356 \u45796 . \u53440 \u46973 \u54620  \u51060 \u54980 \u47196  \u44536 \u45716  \u45130 \u51076 \u50630 \u45716  \u54876 \u46041  \u46412 \u47928 \u50640  \u48152 \u49457 \u54624  \u50668 \u50976 \u47484  \u50619 \u51648  \u47803 \u54664 \u45796 . \u44536 \u47084 \u45208  \u51060 \u51228  \u44536 \u45716  \u44536 \u51032  \u49464 \u47141 \u51012  \u48764 \u50519 \u44592 \u44256  \u52376 \u51020 \u50640  \u54616 \u45720  \u51221 \u48512 \u47484  \u48152 \u50669 \u54620  \u51060 \u47000  \u44536 \u44032  \u45812 \u45817 \u54644  \u50728  \u50669 \u54624 \u51012  \u44618 \u51060  \u49373 \u44033 \u54616 \u44172  \u46104 \u50632 \u45796 . \u44536 \u45716  \u51088 \u44592 \u44032  \u51088 \u54665 \u54620  \u47784 \u46304  \u51396 \u50501  \u46412 \u47928 \u50640  \u44256 \u53685 \u51012  \u48155 \u50500 \u50556  \u54616 \u44256 , \u44536 \u44032  \u48276 \u54616 \u46020 \u47197  \u50976 \u54841 \u54620  \u51396 \u50640  \u45824 \u54616 \u50668  \u54805 \u48268 \u51012  \u48155 \u50500 \u50556  \u54616 \u45716  \u47924 \u49436 \u50868  \u51109 \u47000 \u47484  \u45236 \u45796 \u48372 \u47732 \u49436  \u46160 \u47140 \u50892  \u46500 \u45796 .\
