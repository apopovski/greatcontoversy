\uc0\u54532 \u46976 \u49884 \u49828  1\u49464 \u45716  16\u49464 \u44592  \u52488 \u50685 \u50640  \u51068 \u50612 \u45212  \u47928 \u50696 \u48512 \u55141  \u50868 \u46041 \u51032  \u51648 \u46020 \u51088 \u47196 \u49436 \u51032  \u50689 \u50696 \u47484  \u44032 \u51648 \u44256  \u51080 \u50632 \u45796 . \u44536 \u45716  \u54617 \u51088 \u46308 \u51012  \u44033  \u45208 \u46972 \u50640 \u49436  \u51088 \u44592 \u51032  \u44417 \u51204 \u51004 \u47196  \u47784 \u51004 \u44592 \u47484  \u51339 \u50500 \u54616 \u50688 \u45796 . \u44536 \u44032  \u51333 \u44368  \u44060 \u54785 \u54028 \u50640  \u50612 \u45712  \u51221 \u46020  \u49888 \u50521 \u51032  \u51088 \u50976 \u47484  \u54728 \u50857 \u54620  \u44163 \u51008  \u44536 \u44032  \u54617 \u47928 \u51012  \u49324 \u46993 \u54616 \u44256 , \u49849 \u47140 \u46308 \u51032  \u47924 \u51648 \u50752  \u48120 \u49888 \u51012  \u44221 \u47736 \u55176  \u50668 \u44596  \u44163 \u51060  \u44536  \u46041 \u44592 \u51032  \u51068 \u48512 \u44032  \u46104 \u50632 \u51020 \u51012  \u48512 \u51064 \u54616 \u51648  \u47803 \u54624  \u44163 \u51060 \u45796 . \u44536 \u47084 \u45208  \u54617 \u47928 \u51012  \u49709 \u49345 \u54616 \u45912  \u44536  \u49324 \u46988 \u46020  \u51068 \u45800  \u51060 \u45800  \u48149 \u47736 \u51032  \u50676 \u51221 \u50640  \u49324 \u47196 \u51105 \u55176 \u51088  \u46300 \u46356 \u50612  \u54532 \u46993 \u49828  \u51204 \u44397 \u50640  \u52636 \u54032 \u51012  \u44552 \u51648 \u54616 \u45716  \u52825 \u47161 \u51012  \u45236 \u47160 \u45796 . \u54532 \u46976 \u49884 \u49828  1\u49464 \u45716  \u51648 \u51201  \u44368 \u50577 \u51060  \u51333 \u44368 \u51201  \u54200 \u44204 \u44284  \u54605 \u48149 \u51012  \u48169 \u50612 \u54644  \u51452 \u45716  \u48372 \u54840 \u51032  \u49688 \u45800 \u51060  \u50504  \u46108 \u45796 \u45716  \u49324 \u49892 \u51012  \u51077 \u51613 \u54644  \u51452 \u45716  \u47566 \u51008  \u49892 \u47168  \u51473 \u51032  \u54616 \u45208 \u47484  \u48372 \u50668  \u51456 \u45796 .\
\uc0\u54532 \u46993 \u49828 \u45716  \u50628 \u49689 \u54616 \u44256  \u44277 \u44277 \u50672 \u54620  \u51032 \u49885 \u51012  \u53685 \u54616 \u50668  \u54532 \u47196 \u53580 \u49828 \u53444 \u53944 \u51452 \u51032 \u47484  \u48149 \u47736 \u54616 \u44592 \u50640  \u51204 \u47141 \u51012  \u44592 \u50872 \u51060 \u44172  \u46104 \u50632 \u45796 . \u49888 \u48512 \u46308 \u51008  \u44060 \u54785 \u54028 \u46308 \u51060  \u48120 \u49324 \u47484  \u51221 \u51396 \u54632 \u51004 \u47196  \u45458 \u51004 \u49888  \u54616 \u45208 \u45784 \u51012  \u47784 \u50837 \u54620  \u44163 \u51012  \u54588 \u47196 \u50024  \u49549 \u54644 \u50556  \u54620 \u45796 \u44256  \u51452 \u51109 \u54664 \u45796 . \u44536 \u47532 \u44256  \u51060 \u47484  \u50948 \u54616 \u50668 \u49436 \u45716  \u50773 \u51060  \u44397 \u48124 \u51012  \u45824 \u49888 \u54616 \u50668  \u51060 \u47084 \u54620  \u51204 \u50984 \u54624  \u54665 \u50948 \u47484  \u44277 \u51473  \u50526 \u50640 \u49436  \u51116 \u44032 \u54644  \u45804 \u46972 \u44256  \u50836 \u44396 \u54616 \u50688 \u45796 .\
\uc0\u46300 \u46356 \u50612  1535\u45380  1\u50900  21\u51068 \u50640  \u44536  \u47924 \u49436 \u50868  \u51032 \u49885 \u51060  \u51665 \u54665 \u46104 \u46020 \u47197  \u51221 \u54644 \u51276 \u45796 . \u48120 \u49888 \u51201 \u51064  \u44277 \u54252 \u50752  \u50997 \u53685 \u49457  \u50630 \u45716  \u51613 \u50724 \u49900 \u51060  \u50728  \u44397 \u48124 \u51032  \u47560 \u51020 \u49549 \u50640 \u49436  \u51068 \u50612 \u45228 \u45796 . \u54028 \u47532 \u45716  \u48512 \u44540 \u51032  \u44033  \u51021 \u50640 \u49436  \u47792 \u47140 \u50728  \u44400 \u51473 \u46308 \u47196  \u44032 \u46301  \u52284 \u45796 . \u45817 \u51068 \u50640 \u45716  \u45817 \u45817 \u54620  \u51068 \u45824  \u54665 \u51652 \u51012  \u44144 \u54665 \u54624  \u50696 \u51221 \u51060 \u50632 \u45796 . \'93\u54665 \u47148 \u51060  \u51648 \u45208 \u44032 \u45716  \u51665 \u46308 \u50640 \u45716  \u49345 \u51109  (\u21930 \u31456 ) \u51060  \u45236 \u50612  \u44152 \u47532 \u44256  \u44275 \u44275 \u50640  \u51228 \u45800 \u51060  \u49444 \u52824 \u46104 \u50632 \u45796 .\'94 \u47784 \u46304  \u51665  \u47928  \u50526 \u50640 \u45716  \u44144 \u47337 \u54620  \u51032 \u49885 \u50640  \u45824 \u54616 \u50668  \u44221 \u51032 \u47484  \u54364 \u54616 \u45716  \u54915 \u48520 \u51060  \u49464 \u50892 \u51256  \u51080 \u50632 \u45796 . \u45216 \u51060  \u49352 \u44592  \u51204 \u50640  \u50773 \u44417 \u50640 \u49436  \u54665 \u51652 \u51032  \u45824 \u50676 \u51060  \u54805 \u49457 \u46104 \u50632 \u45796 . \'93\u49440 \u46160 \u50640 \u45716  \u44033  \u44368 \u44396 \u51032  \u44611 \u48156 \u46308 \u44284  \u49901 \u51088 \u44032 \u46308 \u51060  \u49436 \u44256 , \u44536  \u45796 \u51020 \u50640 \u45716  \u49884 \u48124 \u46308 \u51060  \u46160  \u49324 \u46988 \u50473  \u51677 \u51012  \u51648 \u50612  \u54915 \u48520 \u51012  \u46308 \u44256  \u46384 \u46972 \u44052 \u45796 .\'94 \u44536  \u46244 \u50640 \u45716  \u45348  \u44228 \u44553 \u51032  \u44368 \u45800 \u49849  (\u25934 \u22296 \u20711 ) \u51060  \u44033 \u51088  \u46021 \u53945 \u54620  \u49849 \u51032  (\u20711 \u34915 ) \u47484  \u51077 \u44256  \u46384 \u46972 \u44032 \u44256  \u51080 \u50632 \u45796 . \u44536 \u47532 \u44256  \u44032 \u51648 \u44033 \u49353 \u51032  \u44144 \u47337 \u54620  \u50976 \u47932 \u46308 \u51012  \u44032 \u51648 \u44256  \u44052 \u44256 , \u51088 \u49353 \u44284  \u54861 \u49353  \u50743 \u51012  \u51077 \u44256  \u48372 \u49437 \u51004 \u47196  \u45800 \u51109 \u54620  \u50948 \u54413 \u45817 \u45817 \u54620  \u49457 \u51649 \u51088 \u46308 \u51060  \u46384 \u46992 \u45796 .\
\'93\uc0\u49457 \u48337  (\u32854 \u39200 ) \u51008  \u54028 \u47532 \u51032  \u44048 \u46021 \u51060  \u44032 \u51648 \u44256  \u44052 \u45716 \u45936 , \u45348  \u49324 \u46988 \u51032  \u50773 \u51313 \u51060  \u54868 \u47140 \u54620  \u51068 \u49328  (\u26085 \u20632 ) \u51004 \u47196  \u44536  \u50948 \u47484  \u44032 \u47532 \u44256  \u51080 \u50632 \u45796 . \u50773 \u51008  \u44536  \u49457 \u48337 \u51032  \u46244 \u47484  \u46384 \u46992 \u45796 . \u54532 \u46976 \u49884 \u49828  1\u49464 \u45716  \u44536 \u45216 \u50640  \u50773 \u44288 \u44284  \u50773 \u48373 \u51012  \u52265 \u50857 \u54616 \u51648  \u50500 \u45768 \u54616 \u50688 \u45796 . \u47672 \u47532 \u50640  \u50500 \u47924 \u44163 \u46020  \u50416 \u51648  \u50506 \u44256 , \u46405 \u51012  \u45236 \u47140 \u45796 \u48372 \u44256 , \u49552 \u50640  \u51089 \u51008  \u52507 \u48520 \u51012  \u46308 \u44256  \u44032 \u45716  \u54532 \u46976 \u49884 \u49828  \u50773 \u51008  \u52280 \u54924 \u51088 \u51032  \u47784 \u49845 \u51012  \u44536 \u45824 \u47196  \u45208 \u53440 \u45236 \u44256  \u51080 \u50632 \u45796 \'94 (Wylie, b.13, ch.21). \u44536 \u45716  \u51228 \u45800  \u50526 \u50640  \u51060 \u47484  \u46412 \u47560 \u45796  \u47800 \u51012  \u44413 \u54784  \u44999 \u50612  \u50638 \u46300 \u47160 \u45716 \u45936 , \u51060 \u45716  \u44536 \u51032  \u47560 \u51020 \u51012  \u45908 \u47101 \u55180  \u51396 \u50501 \u51060 \u45208 , \u44536 \u51032  \u49552 \u51012  \u45908 \u47101 \u55180  \u47924 \u51396 \u54620  \u51088 \u51032  \u54588  \u46412 \u47928 \u50640 \u49436 \u44032  \u50500 \u45768 \u44256  \u45824 \u45812 \u54616 \u44172 \u46020  \u48120 \u49324 \u47484  \u51221 \u51396 \u54620  \u51088 \u44592 \u51032  \u49888 \u54616 \u46308 \u51032  \u47924 \u49436 \u50868  \u51396  \u46412 \u47928 \u50640 \u49436 \u50688 \u45796 . \u50773 \u48708 \u50752  \u44397 \u44032 \u51032  \u44256 \u44288 \u46308 \u51008  \u46160  \u49324 \u46988 \u50473  \u45208 \u46976 \u55176  \u49436 \u49436  \u44033 \u44033  \u54915 \u48520 \u51012  \u49552 \u50640  \u46308 \u44256  \u44536 \u51032  \u46244 \u47484  \u46384 \u47476 \u44256  \u51080 \u50632 \u45796 .\
\uc0\u44536 \u45216 \u51032  \u54665 \u49324 \u51032  \u54616 \u45208 \u47196 \u49436  \u50773 \u51008  \u44048 \u46021 \u51032  \u51200 \u53469 \u51032  \u45331 \u51008  \u48169 \u50640 \u49436  \u44397 \u45236 \u51032  \u44256 \u44288 \u46308 \u50640 \u44172  \u51068 \u51109  \u50672 \u49444 \u51012  \u54616 \u50688 \u45796 . \u44536 \u45716  \u50620 \u44404 \u50640  \u49836 \u54536  \u48731 \u51012  \u46944 \u44256  \u44536 \u46308 \u51032  \u50526 \u50640  \u45208 \u53440 \u45208  \u49324 \u46988 \u51032  \u47560 \u51020 \u51012  \u44048 \u46041 \u49884 \u53412 \u45716  \u50885 \u48320 \u51004 \u47196  \u44536  \u45208 \u46972 \u50640  \u45796 \u44032 \u50728  \'93\u48276 \u51396 \u50752  \u47784 \u46021 \u44284  \u49836 \u54548 \u44284  \u52824 \u50837 \u51032  \u45216 \'94\u50640  \u45824 \u54616 \u50668  \u44618 \u51060  \u53444 \u49885 \u54616 \u50688 \u45796 . \u44536 \u47532 \u44256  \u44536 \u45716  \u54532 \u46993 \u49828 \u47484  \u47736 \u47581 \u49884 \u53412 \u44256 \u51088  \u50948 \u54801 \u54616 \u44256  \u51080 \u45716  \u44536  \u54028 \u44340 \u51201 \u51064  \u51060 \u45800 \u51012  \u48149 \u47736 \u54616 \u45716  \u45936  \u51080 \u50612 \u49436  \u47784 \u46304  \u52649 \u49457 \u46108  \u49888 \u54616 \u46308 \u50640 \u44172  \u51312 \u47141 \u54644  \u51460  \u44163 \u51012  \u54840 \u49548 \u54616 \u50688 \u45796 . \'93\u50668 \u47084 \u48516 ! \u45236 \u44032  \u50668 \u47084 \u48516 \u46308 \u51032  \u51076 \u44552 \u46120 \u51060  \u49324 \u49892 \u51064  \u44163 \u52376 \u47100 , \u47564 \u51068  \u45208 \u51032  \u49324 \u51648  \u51473 \u51032  \u54616 \u45208 \u44032  \u51060  \u45908 \u47101 \u44256  \u52628 \u50501 \u54620  \u51060 \u45800 \u49444 \u47196  \u45908 \u47084 \u50892 \u51276 \u44144 \u45208  \u50025 \u50632 \u45796 \u45716  \u44163 \u51012  \u50508 \u50520 \u51012  \u44163  \u44057 \u51004 \u47732  \u45208 \u45716  \u44536 \u44163 \u51012  \u44734 \u50612 \u48260 \u47532 \u46020 \u47197  \u50668 \u47084 \u48516 \u46308 \u50640 \u44172  \u45236 \u50612  \u47585 \u44592 \u47532 \u46972 . \'85\u46608 \u54620  \u44536 \u49104  \u50500 \u45768 \u46972  \u45208 \u51032  \u51088 \u45376  \u51473 \u51032  \u54616 \u45208 \u44032  \u44536 \u50752  \u44057 \u51008  \u48337 \u50640  \u44048 \u50684 \u46108  \u44163 \u51012  \u48156 \u44204 \u54620 \u45796 \u47732  \u45208 \u45716  \u44536 \u47484  \u44208 \u45800 \u53076  \u50500 \u45180 \u51648  \u50500 \u45768 \u54616 \u47532 \u46972 . \'85\u45208 \u45716  \u51649 \u51217  \u44536 \u47484  \u51105 \u50500 \u49436  \u54616 \u45208 \u45784 \u44760  \u55148 \u49373  \u51228 \u47932 \u47196  \u46300 \u47532 \u47532 \u46972 \'94\u44256  \u44536 \u45716  \u47568 \u54616 \u50688 \u45796 . \u45576 \u47932 \u51060  \u50773 \u51032  \u47568 \u47928 \u51012  \u47561 \u50520 \u45796 . \u44536 \u47084 \u51088  \u50728  \u54924 \u51473 \u51008  \u44048 \u44201 \u54616 \u50668  \u50872 \u47732 \u49436  \u45796  \u44057 \u51008  \u47560 \u51020 \u51004 \u47196  \'93\u50864 \u47532 \u45716  \u44032 \u53672 \u47533 \u44368 \u47484  \u50948 \u54616 \u50668  \u49332 \u44256  \u44032 \u53672 \u47533 \u44368 \u47484  \u50948 \u54616 \u50668  \u51453 \u44192 \u49845 \u45768 \u45796 \'94 (D\'92Aubigne, b.4, ch.12) \u44256  \u50808 \u52452 \u45796 .\
