\uc0\u44228 \u49549 \u54616 \u50668  \u51068 \u50612 \u45208 \u45716  \u51116 \u50521 \u51004 \u47196  \'93\u54644 \u44032  \u44428 \u49464 \u47484  \u48155 \u50500  \u48520 \u47196  \u49324 \u46988 \u46308 \u51012  \u53468 \u50864 \u45768  \u49324 \u46988 \u46308 \u51060  \u53356 \u44172  \u53468 \u50880 \u50640  \u53468 \u50892 \u51652 \u51648 \u46972 \'94 (\u44228  16:8, 9). \u51060  \u47924 \u49436 \u50868  \u49884 \u44592 \u50640  \u51080 \u51012  \u51648 \u49345 \u51032  \u54805 \u54200 \u50640  \u45824 \u54616 \u50668  \u49440 \u51648 \u51088 \u46308 \u51008  \u45796 \u51020 \u44284  \u44057 \u51060  \u47896 \u49324 \u54620 \u45796 . \'93\u48173 \u51060  \u54889 \u47924 \u54616 \u44256  \u53664 \u51648 \u44032  \u52376 \u47049 \u54616 \u45768 \'85\u48173 \u51032  \u49548 \u49328 \u51060  \u45796  \u50630 \u50612 \u51276 \u51020 \u51060 \u47196 \u45796 .\'94 \'93\u47784 \u46304  \u45208 \u47924 \u44032  \u45796  \u49884 \u46308 \u50632 \u51004 \u45768  \u51060 \u47084 \u48064 \u47196  \u51064 \u44036 \u51032  \u55148 \u46973 \u51060  \u47568 \u46992 \u46020 \u45796 .\'94 \'93\u50472 \u44032  \u55129 \u45929 \u51060  \u50500 \u47000 \u49436  \u50025 \u50612 \u51276 \u44256  \u52285 \u44256 \u44032  \u48708 \u50632 \u44256 \'94 \'93\u49373 \u52629 \u51060  \u53444 \u49885 \u54616 \u44256  \u49548 \u46524 \u44032  \u48124 \u47581 \u54644  \u54616 \u45768  \u51060 \u45716  \u44852 \u51060  \u50630 \u51020 \u51060 \u46972  \u50577 \u46524 \u46020  \u54588 \u44260 \u54616 \u46020 \u45796 \'85\u49884 \u45236 \u44032  \u45796  \u47568 \u46992 \u44256  \u46308 \u51032  \u54400 \u51060  \u48520 \u50640  \u53460 \u51020 \u51060 \u45768 \u51060 \u45796 .\'94 \'93\u44417 \u51204 \u51032  \u45432 \u47000 \u44032  \u50528 \u44257 \u51004 \u47196  \u48320 \u54624  \u44163 \u51060 \u47728  \u49884 \u52404 \u44032  \u47566 \u50500 \u49436  \u49324 \u46988 \u51060  \u51104 \u51104 \u55176  \u52376 \u52376 \u50640  \u45236 \u50612  \u48260 \u47532 \u47532 \u46972  \u51060 \u45716