\uc0\u49324 \u46988 \u46308 \u51008  \u47560 \u52824  \u46020 \u52712 \u46108  \u44163 \u52376 \u47100  \u44536  \u49444 \u44368 \u47484  \u46308 \u50632 \u45796 . \u49373 \u47749 \u51032  \u46497 \u51008  \u51452 \u47536  \u50689 \u54844 \u46308 \u50640 \u44172  \u45208 \u45572 \u50612 \u51276 \u45796 . \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u44536 \u46308  \u50526 \u50640  \u48277 \u50773 \u51060 \u45208  \u48277 \u50773 \u51032  \u49324 \u51208 \u51060 \u45208  \u50773 \u46308 \u48372 \u45796 \u46020  \u45908 \u50865  \u45458 \u51060  \u46308 \u47532 \u50892 \u51276 \u45796 . \u47336 \u53552 \u45716  \u51088 \u44592  \u51088 \u49888 \u51032  \u50948 \u44553 \u54620  \u49345 \u53468 \u50640  \u45824 \u54616 \u50668  \u47568 \u54616 \u51648  \u50506 \u50520 \u45796 . \u44536 \u45716  \u51088 \u49888 \u51012  \u49373 \u44033 \u44284  \u46041 \u51221 \u51032  \u45824 \u49345 \u51004 \u47196  \u47564 \u46308 \u44256 \u51088  \u54616 \u51648  \u50506 \u50520 \u45796 . \u44536 \u45716  \u44536 \u47532 \u49828 \u46020 \u47484  \u51452 \u47785 \u54620  \u45208 \u47672 \u51648  \u51088 \u44592  \u51088 \u49888 \u51012  \u51082 \u50612 \u48260 \u47160 \u45796 . \u44536 \u45716  \u44040 \u48148 \u47532 \u51032  \u49324 \u46988  \u46244 \u50640  \u49704 \u50612 \u49436  \u50696 \u49688 \u45784 \u51012  \u51396 \u51064 \u51032  \u44396 \u49549 \u51088 \u47196  \u45208 \u53440 \u45236 \u44592  \u50948 \u54616 \u50668  \u55192 \u50044 \u45796 .\
\uc0\u44060 \u54785 \u51088 \u44032  \u50668 \u54665 \u51012  \u44228 \u49549 \u54616 \u45716  \u46041 \u50504 , \u44536 \u45716  \u46020 \u52376 \u50640 \u49436  \u53360  \u44288 \u49900 \u51004 \u47196  \u50689 \u51217 \u51012  \u48155 \u50520 \u45796 . \u50676 \u49900  \u51080 \u45716  \u47566 \u51008  \u47924 \u47532 \u46308 \u51008  \u44536 \u50640 \u44172  \u47792 \u47140 \u50752 \u49436  \u44536 \u50640 \u44172  \u45824 \u54620  \u47196 \u47560 \u44368 \u51032  \u47785 \u51201 \u51060  \u47924 \u50631 \u51064 \u51648  \u52828 \u51208 \u54616 \u44172  \u50508 \u47140  \u51452 \u50632 \u45796 . \u50612 \u46500  \u49324 \u46988 \u46308 \u51008  \'93\u44536 \u46308 \u51008  \u50560  \u54980 \u49828 \u50640 \u44172  \u54620  \u44163 \u44284  \u44057 \u51060  \u45817 \u49888 \u51012  \u54868 \u54805 \u49884 \u53020  \u45817 \u49888 \u51032  \u47800 \u51012  \u51116 \u47196  \u47564 \u46308 \u47140 \u44256  \u54633 \u45768 \u45796 \'94\u44256  \u47568 \u54616 \u50688 \u45796 . \u44536 \u47084 \u51088  \u47336 \u53552 \u45716  \u45824 \u45813 \u54616 \u50688 \u45796 . \'93\u44536 \u46308 \u51060  \u48372 \u47492 \u49828 \u47196 \u48512 \u53552  \u48708 \u53584 \u48288 \u47476 \u53356 \u50640  \u51060 \u47476 \u45716  \u44600 \u50640  \u48520 \u51012  \u51656 \u47084  \u44536  \u48520 \u44867 \u51060  \u54616 \u45720 \u50640  \u45823 \u45716 \u45796  \u54624 \u51648 \u46972 \u46020  \u45208 \u45716  \u51452 \u45784 \u51032  \u51060 \u47492 \u51004 \u47196  \u44536  \u44032 \u50868 \u45936 \u47484  \u53685 \u44284 \u54616 \u50668  \u44536 \u46308  \u50526 \u50640  \u49444  \u44163 \u51077 \u45768 \u45796 . \u45208 \u45716  \u44536  \u47609 \u49688 \u51032  \u51077 \u50504 \u51004 \u47196  \u46308 \u50612 \u44032 \u49436  \u44536  \u51060 \u47484  \u48512 \u49688 \u44256  \u51452  \u50696 \u49688  \u44536 \u47532 \u49828 \u46020 \u47484  \u51613 \u44144 \u54616 \u47157 \u45768 \u45796 \'94 (D\'92Aubigne, b.7, ch.7).\
\uc0\u47336 \u53552 \u44032  \u48372 \u47492 \u49828 \u47196  \u44032 \u44620 \u51060  \u50724 \u44256  \u51080 \u45796 \u45716  \u49548 \u47928 \u51060  \u46308 \u47532 \u51088  \u53360  \u49548 \u46041 \u51060  \u51068 \u50612 \u45228 \u45796 . \u44536 \u51032  \u52828 \u44396 \u46308 \u51008  \u44536 \u51032  \u50504 \u51204 \u51012  \u50948 \u54616 \u50668  \u50684 \u47140 \u54616 \u44256 , \u44536 \u51032  \u50896 \u49688 \u46308 \u51008  \u44536 \u46308 \u51032  \u49324 \u50629 \u51032  \u49457 \u44277 \u50640  \u45824 \u54616 \u50668  \u46160 \u47140 \u50892 \u54616 \u50688 \u45796 . \u44536 \u44032  \u49457 \u50640  \u46308 \u50612 \u44032 \u51648  \u47803 \u54616 \u46020 \u47197  \u54616 \u44592  \u50948 \u54616 \u50668  \u50676 \u49457 \u44751  \u50528 \u50416 \u45716  \u49324 \u46988 \u46308 \u46020  \u51080 \u50632 \u45796 . \u48277 \u50773 \u45817 \u51032  \u49324 \u51452  \u50500 \u47000  \u44536 \u45716  \u54620  \u52828 \u51208 \u54620  \u44592 \u49324  (\u39438 \u22763 ) \u51032  \u51200 \u53469 \u51004 \u47196  \u44032 \u51088 \u45716  \u44036 \u52397 \u51012  \u48155 \u44256 , \u44536  \u44275 \u50640 \u49436 \u45716  \u47784 \u46304  \u50612 \u47140 \u50880 \u51060  \u50864 \u54840 \u51201 \u51004 \u47196  \u51312 \u51221 \u46112  \u49688  \u51080 \u45796 \u45716  \u47568 \u46020  \u46307 \u44172  \u46104 \u50632 \u45796 . \u52828 \u44396 \u46308 \u51008  \u44536 \u47484  \u50948 \u54801 \u54616 \u44256  \u51080 \u45716  \u50948 \u54744 \u46308 \u51012  \u47568 \u54644  \u51468 \u51004 \u47196  \u44536 \u51032  \u44277 \u54252 \u49900 \u51012  \u51088 \u44537 \u54616 \u44256 \u51088  \u45432 \u47141 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u46308 \u51032  \u47784 \u46304  \u45432 \u47141 \u51008  \u49892 \u54056 \u54616 \u50688 \u45796 . \u47336 \u53552 \u45716  \u55124 \u46308 \u47532 \u51648  \u50506 \u44256 , \'93\u48372 \u47492 \u49828  \u49884 \u45236 \u51032  \u50501 \u47560 \u44032  \u48708 \u47197  \u51648 \u48533  \u50948 \u51032  \u44592 \u50771 \u51109 \u52376 \u47100  \u47566 \u51012 \u51648 \u46972 \u46020  \u45208 \u45716  \u48152 \u46300 \u49884  \u46308 \u50612 \u44032 \u47532 \u46972 \'94 (D\'92Aubigne, b.7, ch.7) \u44256  \u45800 \u50616 \u54616 \u50688 \u45796 .\
\uc0\u44536 \u44032  \u48372 \u47492 \u49828 \u50640  \u46020 \u52265 \u54616 \u51088  \u47566 \u51008  \u47924 \u47532 \u44032  \u44536 \u47484  \u50689 \u51217 \u54616 \u44256 \u51088  \u49457 \u47928 \u50640  \u47784 \u50668  \u51080 \u50632 \u45796 . \u54889 \u51228  \u51088 \u49888 \u51012  \u50689 \u51217 \u54616 \u44592  \u50948 \u54644 \u49436 \u46020  \u44536 \u52376 \u47100  \u47566 \u51008  \u47924 \u47532 \u44032  \u47784 \u51060 \u51648  \u50506 \u50520 \u50632 \u45796 . \u55141 \u48516 \u51008  \u49900 \u54616 \u50688 \u51004 \u47728 , \u47924 \u47532 \u46308  \u44032 \u50868 \u45936 \u45716  \u47336 \u53552 \u50640 \u44172  \u44536 \u47484  \u44592 \u45796 \u47532 \u44256  \u51080 \u45716  \u50868 \u47749 \u51012  \u44221 \u44256 \u54616 \u44592  \u50948 \u54616 \u50668  \u51109 \u47168 \u49885 \u50640  \u48512 \u47476 \u45716  \u47564 \u44032  (\u36627 \u27468 ) \u47484  \u48708 \u44048 \u54620  \u47785 \u49548 \u47532 \u47196  \u48512 \u47476 \u45716  \u49324 \u46988 \u46020  \u51080 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u47560 \u52264 \u50640 \u49436  \u45236 \u47140 \u49436 \u47732 \u49436  \'93\u54616 \u45208 \u45784 \u51008  \u45208 \u51032  \u49328 \u49457 \u51060 \u49884 \u45796 \'94\u44256  \u47568 \u54616 \u50688 \u45796 .\
\uc0\u48277 \u50773 \u45817 \u51008  \u47336 \u53552 \u44032  \u50948 \u54744 \u51012  \u47924 \u47493 \u50416 \u44256  \u48372 \u47492 \u49828 \u50640  \u45208 \u53440 \u45216  \u44163 \u51060 \u46972 \u44256 \u45716  \u48127 \u51648  \u50506 \u50520 \u50632 \u45796 . \u44536 \u44032  \u48372 \u47492 \u49828 \u50640  \u46020 \u52265 \u54616 \u50688 \u51004 \u48064 \u47196  \u44536 \u46308 \u51008  \u45440 \u46992 \u45796 . \u54889 \u51228 \u45716  \u51593 \u49884  \u51032 \u50896 \u46308 \u51012  \u49548 \u51665 \u54616 \u50668  \u45824 \u52293 \u51012  \u44053 \u44396 \u54616 \u44592  \u50948 \u54616 \u50668  \u54801 \u51032 \u54616 \u50688 \u45796 . \u48277 \u50773 \u45817 \u51032  \u50756 \u44256 \u54620  \u51452 \u44368  \u51473 \u51032  \u54620  \u49324 \u46988 \u51008  \u45796 \u51020 \u44284  \u44057 \u51060  \u51452 \u51109 \u54616 \u50688 \u45796 . \'93\u50864 \u47532 \u45716  \u51060  \u47928 \u51228 \u50640  \u45824 \u54616 \u50668  \u51060 \u48120  \u50724 \u47019 \u46041 \u50504  \u51032 \u45436 \u54616 \u50688 \u49845 \u45768 \u45796 . \u44536 \u47084 \u48064 \u47196  \u54224 \u54616 \u44760 \u49436 \u45716  \u44536  \u49324 \u46988 \u51012  \u51593 \u49884  \u52376 \u52824 \u54644  \u48260 \u47532 \u49901 \u49884 \u50724 . \u51060 \u48120  \u49884 \u44592 \u49828 \u47928 \u53944  \u54889 \u51228 \u44760 \u49436 \u46020  \u50560  \u54980 \u49828 \u47484  \u54868 \u54805 \u50640  \u52376 \u54616 \u51648  \u50506 \u50520 \u49845 \u45768 \u44620 ? \u50864 \u47532 \u45716  \u51060 \u45800 \u51088 \u51032  \u53685 \u54665 \u44428 \u50640  \u44396 \u50528 \u46112  \u54596 \u50836 \u44032  \u50630 \u49845 \u45768 \u45796 .\'94 \u54889 \u51228 \u45716  \'93\u44536 \u47111 \u51648  \u50506 \u49845 \u45768 \u45796 . \u50864 \u47532 \u45716  \u50557 \u49549 \u51012  \u51648 \u53412 \u51648  \u50506 \u51004 \u47732  \u50504  \u46121 \u45768 \u45796 \'94 (D\'92Aubigne, b.7, ch.8) \u44256  \u45824 \u45813 \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44060 \u54785 \u51088 \u51032  \u47568 \u51012  \u46307 \u46020 \u47197  \u54620 \u45796 \u45716  \u44208 \u51221 \u51060  \u45236 \u47160 \u45796 .\
\uc0\u50728  \u46020 \u49457 \u51008  \u51060  \u45440 \u46972 \u50868  \u49324 \u46988 \u51012  \u48372 \u44592  \u50948 \u54616 \u50668  \u50676 \u44305 \u54616 \u50688 \u44256 , \u44536 \u51032  \u49689 \u49548 \u45716  \u48169 \u47928 \u44061 \u51004 \u47196  \u52264 \u44256  \u45336 \u52452 \u45796 . \u47336 \u53552 \u45716  \u52572 \u44540 \u50640  \u50515 \u50500 \u50724 \u45912  \u48337 \u50640 \u49436  \u50756 \u51204 \u55176  \u54924 \u48373 \u46104 \u51648  \u47803 \u54616 \u50688 \u51004 \u47728 , \u46160  \u51452 \u51068 \u51060 \u45208  \u44228 \u49549 \u46108  \u50668 \u54665 \u50640  \u51648 \u52432  \u51080 \u50632 \u44256 , \u45236 \u51068 \u51032  \u51473 \u45824  \u49324 \u44148 \u51012  \u50948 \u54616 \u50668  \u51456 \u48708 \u46020  \u54644 \u50556  \u46104 \u50632 \u51004 \u48064 \u47196  \u50504 \u51221 \u44284  \u55092 \u49885 \u51060  \u54596 \u50836 \u54616 \u50688 \u45796 . \u44536 \u47484  \u47564 \u45208 \u44256 \u51088  \u54616 \u45716  \u49324 \u46988 \u46308 \u51032  \u50676 \u47581  \u46412 \u47928 \u50640  \u44536 \u45716  \u46160 \u50612  \u49884 \u44036 \u48150 \u50640  \u49688 \u47732 \u51012  \u52712 \u54616 \u51648  \u47803 \u54616 \u50688 \u45716 \u45936 , \u44536  \u46412 \u50640  \u44480 \u51313 \u46308 \u44284  \u44592 \u49324  (\u39438 \u22763 ) \u46308 \u44284  \u49888 \u48512 \u46308 \u44284  \u49884 \u48124 \u46308 \u51060  \u50676 \u44305 \u51201 \u51004 \u47196  \u46608  \u47784 \u50668 \u46308 \u50632 \u45796 . \u44536  \u51473 \u50640 \u45716  \u44368 \u54924 \u51032  \u50501 \u54224 \u47484  \u44060 \u54785 \u54624  \u44163 \u51012  \u54889 \u51228 \u50640 \u44172  \u45812 \u45824 \u55176  \u51652 \u50616 \u54620  \u44480 \u51313 \u46308 \u46020  \u47566 \u51060  \u51080 \u50632 \u45796 . \u47336 \u53552 \u45716  \u44536 \u46308 \u50640  \u45824 \u54616 \u50668  \'93\u45236 \u44032  \u51204 \u54620  \u48373 \u51020 \u51004 \u47196  \u44536 \u46308 \u51008  \u45796  \u51088 \u50976 \u47484  \u50619 \u50632 \u45796 \'94 (Martyn, p.39) \u44256  \u47568 \u54616 \u50688 \u45796 . \u52828 \u44396 \u46308 \u51008  \u47932 \u47200 \u51060 \u50836  \u50896 \u49688 \u46308 \u46020  \u51060  \u45824 \u45812 \u54616 \u44256  \u44404 \u54624  \u51460  \u47784 \u47476 \u45716  \u49849 \u47140 \u47484  \u48372 \u44592  \u50948 \u54616 \u50668  \u50772 \u45796 . \u44536 \u45716  \u44536 \u46308 \u51012  \u52264 \u48516 \u54616 \u44256  \u50504 \u51221 \u46108  \u47560 \u51020 \u51004 \u47196  \u47582 \u51060 \u54616 \u50688 \u44256 , \u47784 \u46304  \u47568 \u50640  \u45824 \u54616 \u50668  \u44428 \u50948 \u50752  \u51648 \u54812 \u47484  \u44032 \u51648 \u44256  \u45824 \u45813 \u54616 \u50688 \u45796 . \u44536 \u51032  \u53468 \u46020 \u45716  \u54869 \u44256 \u54616 \u44256  \u50857 \u44048 \u54616 \u50688 \u45796 . \u44536 \u51032  \u52285 \u48177 \u54616 \u44256  \u54028 \u47532 \u54620  \u50620 \u44404 \u50640 \u45716  \u49688 \u44256 \u50752  \u51656 \u48337 \u51032  \u55124 \u51201 \u51060  \u51080 \u50632 \u51004 \u45208  \u50724 \u55176 \u47140  \u52828 \u51208 \u54616 \u44256  \u51600 \u44144 \u50868  \u54364 \u51221 \u51060 \u50632 \u45796 . \u50628 \u49689 \u54616 \u44256  \u50676 \u47148 \u54620  \u44536 \u51032  \u47568 \u51008  \u44536 \u50640 \u44172  \u44428 \u45733 \u51012  \u51452 \u50632 \u51004 \u47728 , \u44536 \u51032  \u50896 \u49688 \u46308 \u51008  \u44536  \u44428 \u45733 \u51012  \u51200 \u54637 \u54624  \u49688  \u50630 \u50632 \u45796 . \u52828 \u44396 \u46308 \u44284  \u50896 \u49688 \u46308 \u51008  \u45796  \u44057 \u51060  \u47588 \u50864  \u45440 \u46992 \u45796 . \u50612 \u46500  \u49324 \u46988 \u46308 \u51008  \u44144 \u47337 \u54620  \u55192 \u51060  \u44536 \u50640 \u44172  \u51076 \u54616 \u50688 \u45796 \u44256  \u54869 \u49888 \u54616 \u50688 \u44256 , \u46608  \u45796 \u47480  \u49324 \u46988 \u46308 \u51008  \u50715 \u45216  \u48148 \u47532 \u49352  \u44368 \u51064 \u46308 \u51060  \u50696 \u49688 \u45784 \u44760  \u45824 \u54616 \u50668  \u47568 \u54620  \u44163 \u52376 \u47100  \u49324 \u44480 \u44032  \u46308 \u47160 \u45796 \u44256  \u54616 \u50688 \u45796 .\
