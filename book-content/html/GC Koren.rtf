\uc0\u50689 \u44397 \u51032  \u51333 \u44368  \u44060 \u54785 \u51088 \u46308 \u51008  \u47196 \u47560 \u44368 \u51032  \u44368 \u47532 \u45716  \u48260 \u47160 \u51012 \u51648 \u46972 \u46020  \u44536  \u44368 \u47532 \u51032  \u50668 \u47084  \u44032 \u51648  \u54805 \u49885 \u51008  \u44036 \u51649 \u54616 \u44256  \u51080 \u50632 \u45796 . \u48708 \u47197  \u47196 \u47560 \u44368 \u51032  \u44428 \u50948 \u50752  \u49888 \u51312 \u45716  \u48512 \u51221 \u46104 \u50632 \u51012 \u51648 \u46972 \u46020  \u44536  \u44288 \u49845 \u44284  \u51032 \u49885 \u51008  \u50689 \u44397  \u44368 \u54924 \u51032  \u50696 \u48176 \u50640  \u51201 \u51648  \u50506 \u44172  \u54844 \u54633 \u46104 \u50612  \u51080 \u50632 \u45796 . \u44536 \u47532 \u44256  \u44536 \u47084 \u54620  \u44163 \u46308 \u51008  \u50577 \u49900 \u51032  \u47928 \u51228 \u44032  \u50500 \u45768 \u47728 , \u49457 \u44221 \u50640  \u53945 \u48324 \u55176  \u47749 \u47161 \u46104 \u50612  \u51080 \u45716  \u44163 \u51008  \u50500 \u45768 \u51648 \u47564  \u44845  \u54596 \u50836 \u54620  \u44163 \u46020  \u50500 \u45768 \u47728  \u44536 \u47111 \u45796 \u44256  \u44552 \u51648 \u46104 \u50612  \u51080 \u45716  \u44163 \u46020  \u50500 \u45768 \u50632 \u51004 \u48064 \u47196  \u50896 \u52825 \u51201 \u51004 \u47196  \u45208 \u49244  \u44163 \u51060  \u50500 \u45768 \u46972 \u44256  \u51452 \u51109 \u46104 \u50632 \u45796 . \u46608  \u44536 \u46308 \u51060  \u44536 \u50752  \u44057 \u51008  \u44163 \u46308 \u51012  \u51648 \u53428 \u51004 \u47196  \u47196 \u47560 \u44368 \u50752  \u44060 \u49888 \u44368 \u50752 \u51032  \u44036 \u44201 \u51012  \u51329 \u55176 \u45716  \u46041 \u49884 \u50640  \u47196 \u47560 \u44368 \u47196  \u54616 \u50668 \u44552  \u49888 \u44368 \u47484  \u48155 \u50500 \u46308 \u51060 \u44592  \u49789 \u44172  \u47564 \u46300 \u45716  \u44163 \u51060 \u46972 \u44256 \u46020  \u54644 \u49437 \u46104 \u50632 \u45796 .\
\uc0\u48372 \u49688 \u51201 \u51060 \u50836  \u53440 \u54801 \u51201 \u51064  \u49324 \u46988 \u46308 \u50640 \u44172 \u45716  \u51060 \u47084 \u54620  \u45436 \u51613 \u46308 \u51060  \u54869 \u49892 \u54620  \u44163 \u52376 \u47100  \u48372 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u47111 \u44172  \u54032 \u45800 \u54616 \u51648  \u50506 \u45716  \u49324 \u46988 \u46308 \u51060  \u51080 \u50632 \u45796 . \u44536 \u46308 \u51008  \u44536 \u50752  \u44057 \u51008  \u44288 \u49845 \u51012  \u44536 \u45824 \u47196  \u51648 \u53412 \u44172  \u46104 \u47732  \'93\u47196 \u47560 \u44368 \u50752  \u51333 \u44368  \u44060 \u54785 \u54028  \u49324 \u51060 \u50640  \u49373 \u44596  \u44618 \u51008  \u44396 \u45929 \u51060 \u50640  \u45796 \u47532 \u47484  \u45459 \u45716  \u44163 \u44284  \u44057 \u51008  \u44163 \'94 (Martyn, vol.5, p.22) \u51060 \u46972 \u45716  \u44288 \u51216 \u50640 \u49436  \u44536 \u44163 \u51012  \u45800 \u50672 \u55176  \u48152 \u45824 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u44536 \u47084 \u54620  \u51032 \u49885 \u46308 \u51012 , \u44144 \u44592 \u50640 \u49436  \u54644 \u48169 \u46108  \u54980  \u45796 \u49884  \u46104 \u46028 \u50500 \u44040  \u47560 \u51020 \u51312 \u52264  \u50630 \u45716  \u45432 \u50696  \u51228 \u46020 \u51032  \u55064 \u51109 \u51060 \u46972 \u44256  \u48372 \u50520 \u45796 . \u44536 \u46308 \u51008  \u54616 \u45208 \u45784 \u44760 \u49436  \u51060 \u48120  \u45817 \u49888 \u51032  \u47568 \u50432 \u51012  \u53685 \u54616 \u50668  \u50696 \u48176 \u50640  \u44288 \u54620  \u44508 \u52825 \u51012  \u51221 \u54616 \u50668  \u51452 \u49512 \u51004 \u48064 \u47196  \u49324 \u46988 \u46308 \u51060  \u44144 \u44592 \u50640  \u45908 \u54616 \u44144 \u45208  \u44048 \u54624  \u51088 \u50976 \u44032  \u50630 \u45796 \u44256  \u50669 \u49444 \u54616 \u50688 \u45796 . \u53360  \u48176 \u44368 \u51032  \u48156 \u45800 \u51008  \u48148 \u47196  \u54616 \u45208 \u45784 \u51032  \u44428 \u50948 \u50640  \u44368 \u54924 \u51032  \u44428 \u50948 \u47484  \u52392 \u44032 \u54616 \u47140 \u44256  \u49884 \u46020 \u54616 \u45716  \u45936  \u51080 \u50632 \u45796 . \u47196 \u47560 \u44368 \u45716  \u54616 \u45208 \u45784 \u44760 \u49436  \u44552 \u54616 \u51648  \u50500 \u45768 \u54620  \u44163 \u51012  \u54616 \u46972 \u44256  \u47749 \u47161 \u54632 \u51004 \u47196  \u49884 \u51089 \u46104 \u50632 \u44256 , \u54616 \u45208 \u45784 \u44760 \u49436  \u48516 \u47749 \u55176  \u47749 \u47161 \u54616 \u49888  \u44163 \u51012  \u44552 \u51648 \u54632 \u51004 \u47196  \u45149 \u51012  \u47610 \u50632 \u45796 .\
\uc0\u47566 \u51008  \u49324 \u46988 \u51008  \u52488 \u45824  \u44368 \u54924 \u51032  \u53945 \u51669 \u51060 \u50632 \u45912  \u49692 \u44208 \u44284  \u45800 \u49692 \u49457 \u51004 \u47196  \u46028 \u50500 \u44032 \u44256 \u51088  \u50676 \u47581 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u50689 \u44397  \u44368 \u54924 \u44032  \u49464 \u50868  \u45824 \u48512 \u48516 \u51032  \u44288 \u49845 \u46308 \u51012  \u50864 \u49345  \u49709 \u48176 \u51032  \u50976 \u47932 \u51060 \u46972 \u44256  \u51064 \u51221 \u54664 \u44592  \u46412 \u47928 \u50640 , \u50577 \u49900 \u51201 \u51004 \u47196  \u50689 \u44397  \u44368 \u54924 \u51032  \u50696 \u48176 \u50640  \u50672 \u54633 \u54624  \u49688  \u50630 \u50632 \u45796 . \u44536 \u47088 \u45936  \u44368 \u54924 \u45716  \u44397 \u44032 \u51032  \u44428 \u47141 \u50640  \u51032 \u54616 \u50668  \u50976 \u51648 \u46104 \u44256  \u51080 \u50632 \u51004 \u48064 \u47196  \u44368 \u54924 \u51032  \u51032 \u49885 \u50640  \u48152 \u45824 \u54616 \u45716  \u51068 \u51060  \u50857 \u45225 \u46112  \u49688  \u50630 \u50632 \u45796 . \u50696 \u48176 \u50640  \u52636 \u49437 \u54616 \u45716  \u51068 \u51008  \u48277 \u47456 \u47196 \u50024  \u50836 \u44396 \u46104 \u50632 \u51004 \u47728 , \u54728 \u44032  \u50630 \u51060  \u51333 \u44368 \u51201  \u50696 \u48176 \u47484  \u50948 \u54620  \u51665 \u54924 \u47484  \u50668 \u45716  \u51068 \u51008  \u44552 \u51648 \u46104 \u50612  \u51080 \u50632 \u44256 , \u44536 \u44163 \u51012  \u48276 \u54616 \u45716  \u51088 \u45716  \u53804 \u50725 , \u52628 \u48169 , \u49324 \u54805  \u46321 \u51032  \u54805 \u48268 \u51012  \u48155 \u44172  \u46104 \u50612  \u51080 \u50632 \u45796 .\
17\uc0\u49464 \u44592 \u51032  \u52488 \u50685 \u50640  \u50689 \u44397 \u51032  \u54620  \u50773 \u51008  \u51593 \u50948 \u54616 \u51088 \u47560 \u51088  \u52397 \u44368 \u46020 \u46308 \u51012  \u48373 \u51333 \u49884 \u53412 \u46304 \u51648  \u44340 \u47213 \u54784  \u44536  \u46405 \u50640 \u49436  \u45236 \u51923 \u46304 \u51648  \u54841 \u51008  \u44536 \u48372 \u45796  \u45908  \u49900 \u54620  \u54805 \u48268 \u51012  \u48155 \u44172  \u54616 \u46304 \u51648  \u54616 \u44192 \u45796 \u45716  \u51088 \u49888 \u51032  \u45800 \u54840 \u54620  \u44208 \u49900 \u51012  \u54364 \u47749 \u54616 \u50688 \u45796  (Georgr Bancroft, History of the United States of America, pt.1, ch.12, par.6). \u49688 \u49353 \u45817 \u54616 \u44256 , \u52628 \u48169 \u45817 \u54616 \u44256 , \u48149 \u54644 \u47484  \u48155 \u51008  \u44536 \u46308 \u51008  \u44536 \u46308 \u51032  \u51109 \u47000 \u44032  \u45908  \u45208 \u50500 \u51656  \u44163 \u51060 \u46972 \u45716  \u51204 \u47581 \u51012  \u48148 \u46980  \u49688  \u50630 \u50632 \u45796 . \u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u50577 \u49900 \u51012  \u46384 \u46972  \u54616 \u45208 \u45784 \u51012  \u49452 \u44592 \u47140 \u47732  \'93\u50689 \u44397 \u51008  \u51060 \u48120  \u50689 \u44396 \u51201 \u51004 \u47196  \u44144 \u51452 \u54624  \u47564 \u54620  \u44275 \u51060  \u46104 \u51648  \u47803  \u54620 \u45796 \'94 (J.G.Palfrey, History of New England, ch.3, par.43) \u45716  \u54869 \u49888 \u51012  \u44054 \u44172  \u46104 \u50632 \u45796 . \u44536  \u50612 \u46500  \u49324 \u46988 \u46308 \u51008  \u47560 \u52840 \u45236  \u45348 \u45916 \u46976 \u46300 \u50640 \u49436  \u54588 \u45212 \u52376 \u47484  \u52286 \u44256 \u51088  \u44208 \u49900 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u50612 \u47140 \u50880 \u44284  \u49552 \u49892 \u44284  \u53804 \u50725  \u46321 \u51012  \u45817 \u54616 \u50688 \u45796 . \u44208 \u44397  \u44536 \u46308 \u51032  \u47785 \u51201 \u51008  \u51340 \u51208 \u45817 \u54616 \u44256 , \u44536 \u46308 \u51008  \u50896 \u49688 \u51032  \u49688 \u51473 \u50640  \u46308 \u50612 \u44032 \u44172  \u46104 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44404 \u54616 \u51648  \u50506 \u44256  \u52280 \u44256  \u44204 \u46360  \u44208 \u44284 \u47196  \u47560 \u52840 \u45236  \u44536 \u46308 \u51008  \u45348 \u45916 \u46976 \u46300  \u44277 \u54868 \u44397 \u51004 \u47196  \u51060 \u51452 \u54616 \u44172  \u46104 \u50632 \u45716 \u45936 , \u44144 \u44592 \u49436  \u50864 \u54840 \u51201 \u51064  \u50689 \u51217 \u51012  \u48155 \u44172  \u46104 \u50632 \u45796 .\
