\f1\b0 \cf0 \
\uc0\u50689 \u44397 \u51004 \u47196  \u46028 \u50500 \u50724 \u51088  \u50920 \u49836 \u47532 \u45716  \u47784 \u46972 \u48708 \u50500  \u44368 \u46020 \u51032  \u51204 \u46020 \u51088 \u51032  \u44368 \u54984  \u50500 \u47000  \u49457 \u44221 \u49345  \u49888 \u50521 \u51012  \u45908 \u50865  \u48516 \u47749 \u55176  \u51060 \u54644 \u54616 \u44172  \u46104 \u50632 \u45796 . \u44536 \u45716  \u44396 \u50896 \u51012  \u50619 \u44592  \u50948 \u54616 \u50668  \u51088 \u44592 \u51032  \u54665 \u54632 \u51012  \u51032 \u51648 \u54616 \u45912  \u44163 \u51012  \u47784 \u46160  \u48260 \u47532 \u44256  \'93\u49464 \u49345  \u51396 \u47484  \u51648 \u44256  \u44032 \u45716  \u54616 \u45208 \u45784 \u51032  \u50612 \u47536 \u50577 \'94\u51012  \u50728 \u51204 \u55176  \u49888 \u47280 \u54616 \u50668 \u50556  \u54620 \u45796 \u45716  \u44163 \u51012  \u44648 \u45804 \u50520 \u45796 . \u47088 \u45912 \u50640 \u49436  \u51080 \u51008  \u47784 \u46972 \u48708 \u50500  \u44368 \u46020 \u46308 \u51032  \u54620  \u51665 \u54924 \u50640 \u49436  \u54616 \u45208 \u45784 \u51032  \u50689 \u51060  \u48127 \u45716  \u49324 \u46988 \u51032  \u47560 \u51020 \u50640  \u50669 \u49324 \u54616 \u50668  \u48320 \u54868 \u47484  \u51068 \u51004 \u53416 \u45796 \u45716  \u45236 \u50857 \u51004 \u47196  \u46108  \u47336 \u53552 \u51032  \u44544 \u51060  \u45229 \u46021 \u46104 \u50632 \u45796 . \u44536  \u47568 \u51012  \u46307 \u51088  \u50920 \u49836 \u47532 \u51032  \u47560 \u51020 \u49549 \u50640 \u45716  \u49888 \u50521 \u51032  \u48520 \u51060  \u53440 \u50732 \u46992 \u45796 . \u44536 \u45716  \u47568 \u54616 \u50688 \u45796 . \'93\u45208 \u45716  \u47560 \u51020 \u51060  \u51060 \u49345 \u54616 \u44172  \u46888 \u44144 \u50892 \u51648 \u45716  \u44163 \u51012  \u45712 \u44808 \u45796 . \u45208 \u45716  \u44396 \u50896 \u51012  \u50619 \u44592  \u50948 \u54616 \u50668  \u44536 \u47532 \u49828 \u46020 , \u50724 \u51649  \u44536 \u47532 \u49828 \u46020 \u47564 \u51012  \u49888 \u47280 \u54644 \u50556  \u54620 \u45796 \u44256  \u45712 \u44808 \u45796 . \u44536 \u47532 \u44256  \u44536  \u46412 \u50640  \u54620  \u44032 \u51648  \u54869 \u51613  \u44263  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u45208 \u51032  \u51396 , \u49900 \u51648 \u50612  \u45236  \u51088 \u49888 \u44620 \u51648 \u46020  \u51228 \u44144 \u54644  \u48260 \u47532 \u49884 \u44256 , \u45208 \u47484  \u51396 \u50752  \u49324 \u47581 \u51032  \u48277 \u50640 \u49436  \u44396 \u50896 \u54616 \u50668  \u51452 \u49888  \u45936  \u45824 \u54620  \u54869 \u51613 \u51012  \u50619 \u50632 \u45796 \'94 (John Whitehead, Life of the Rev.John Wesley, p.52).\
\uc0\u44340 \u47213 \u44256  \u50424 \u50424 \u54620  \u44256 \u53804 \u51032  \u44596  \u49464 \u50900 , \u50628 \u44201 \u54620  \u44537 \u44592 \u50752  \u51088 \u52293 \u44284  \u44216 \u48708 \u51032  \u44596  \u49464 \u50900 \u51012  \u53685 \u54616 \u50668  \u50920 \u49836 \u47532 \u45716  \u54616 \u45208 \u45784 \u51012  \u52286 \u51004 \u47140 \u45716  \u54620  \u44032 \u51648 \u51032  \u47785 \u51201 \u50640  \u44403 \u44172  \u49324 \u47196 \u51105 \u54784  \u51080 \u50632 \u45796 . \u51060 \u51228  \u44536 \u45716  \u54616 \u45208 \u45784 \u51012  \u52286 \u50520 \u45796 . \u44536 \u47532 \u44256  \u44536 \u45716  \u44592 \u46020 \u50752  \u44552 \u49885 \u44284  \u51088 \u49440  \u49324 \u50629 \u44284  \u51088 \u44592 \u55148 \u49373 \u51004 \u47196  \u50619 \u51004 \u47140 \u44256  \u50528 \u50420  \u51008 \u54812 \u44032  \u49892 \u49345 \u51008  \u54616 \u45208 \u45784 \u44760 \u49436  \'93\u44050 \u50630 \u51060 \'94 \u51452 \u49884 \u45716  \u49440 \u47932 \u51076 \u51012  \u44648 \u45804 \u50520 \u45796 .\
\uc0\u51068 \u45800  \u44536 \u47532 \u49828 \u46020 \u51032  \u48127 \u51020  \u50504 \u50640  \u44403 \u44172  \u49436 \u51088  \u44536 \u51032  \u50728  \u47560 \u51020 \u51008  \u54616 \u45208 \u45784 \u51032  \u51008 \u54812 \u51032  \u48373 \u51020 \u50640  \u44288 \u54620  \u51648 \u49885 \u51012  \u50612 \u45712  \u44275 \u50640 \u46304 \u51648  \u51204 \u54616 \u44256 \u51088  \u54616 \u45716  \u50837 \u47581 \u51004 \u47196  \u48520 \u53460 \u45796 . \u44536 \u45716  \'93\u45208 \u45716  \u50728  \u49464 \u44228 \u47484  \u45208 \u51032  \u44368 \u44396 \u46972 \u44256  \u49373 \u44033 \u54620 \u45796 . \u50612 \u46496 \u54620  \u51648 \u48169 \u50640 \u49436 \u46304 \u51648  \u44396 \u50896 \u51032  \u44592 \u49244  \u49548 \u49885 \u51012  \u46307 \u44256 \u51088  \u54616 \u45716  \u47784 \u46304  \u49324 \u46988 \u50640 \u44172  \u48373 \u51020 \u51012  \u51204 \u54616 \u45716  \u44163 \u51060  \u47560 \u46405 \u55176  \u54644 \u50556  \u54624  \u45208 \u51032  \u48376 \u48516 \u51060 \u46972 \u44256  \u49373 \u44033 \u54620 \u45796 \'94 (John Whitehead, Life of the Rev.John Wesley, p.74).\
\uc0\u44536 \u45716  \u50628 \u44201 \u54620  \u44537 \u44592 \u51032  \u49373 \u50528 \u47484  \u44228 \u49549 \u54664 \u45716 \u45936 , \u51060 \u51228 \u45716  \u44536 \u44163 \u51060  \u49888 \u50521 \u51032  \u44540 \u44144 \u44032  \u50500 \u45768 \u44256  \u44208 \u44284 \u50688 \u51004 \u47728  \u49457 \u44208 \u51032  \u44592 \u52488 \u44032  \u50500 \u45768 \u44256  \u50676 \u47588 \u50688 \u45796 . \u44536 \u47532 \u49828 \u46020  \u50504 \u50640  \u51080 \u45716  \u54616 \u45208 \u45784 \u51032  \u51008 \u54812 \u45716  \u44536 \u47532 \u49828 \u46020 \u51064 \u51032  \u49548 \u47581 \u51032  \u44592 \u52488 \u51060 \u47728 , \u44536  \u51008 \u54812 \u45716  \u49692 \u51333 \u51004 \u47196  \u45208 \u53440 \u45216  \u44163 \u51060 \u45796 . \u50920 \u49836 \u47532 \u51032  \u49373 \u50528 \u45716  \u44536 \u44032  \u48155 \u51008  \u50948 \u45824 \u54620  \u51652 \u47532 , \u44263  \u44536 \u47532 \u49828 \u46020 \u51032  \u49549 \u51396 \u51032  \u54588 \u47484  \u48127 \u51020 \u51004 \u47196  \u47568 \u48120 \u50516 \u45716  \u51032 , \u47560 \u51020 \u49549 \u50640 \u49436  \u50669 \u49324 \u54616 \u45716  \u49457 \u47161 \u51032  \u49352 \u47213 \u44172  \u54616 \u45716  \u45733 \u47141 , \u44536 \u47532 \u49828 \u46020 \u51032  \u47784 \u48376 \u51012  \u46384 \u46972  \u49373 \u50528 \u50640  \u51060 \u47336 \u50612 \u51648 \u45716  \u50676 \u47588  \u46321 \u50640  \u44288 \u54620  \u51652 \u47532 \u47484  \u51204 \u54616 \u45716  \u51068 \u50640  \u48148 \u52452 \u45796 .\
\uc0\u55083 \u54596 \u46300 \u50752  \u50920 \u49836 \u47532  \u54805 \u51228 \u45716  \u51088 \u44592 \u46308 \u51032  \u49548 \u47581  \u50630 \u45716  \u49345 \u53468 \u50640  \u45824 \u54616 \u50668  \u50724 \u47019 \u46041 \u50504  \u49900 \u44033 \u54616 \u44172  \u45712 \u45196 \u51004 \u47196 \u50024  \u44536 \u46308 \u51032  \u49324 \u50629 \u51012  \u50948 \u54620  \u51456 \u48708 \u47484  \u44054 \u52628 \u50632 \u45796 . \u44536 \u46308 \u51060  \u45824 \u54617  \u49884 \u51208 \u44284  \u51204 \u46020  \u49324 \u50629 \u51012  \u52265 \u49688 \u54620  \u45817 \u49884 \u50640  \u48155 \u51008  \u47736 \u49884 \u50752  \u51312 \u47217 \u44284  \u48149 \u54644 \u51032  \u44201 \u47148 \u54620  \u49884 \u47144 \u51008  \u44536 \u46308 \u47196  \u54616 \u50668 \u44552  \u44536 \u47532 \u49828 \u46020 \u51032  \u44400 \u48337 \u51004 \u47196 \u49436  \u50612 \u47140 \u50880 \u51012  \u44204 \u46364  \u49688  \u51080 \u44172  \u54616 \u50688 \u45796 . \u44536 \u46308 \u44284  \u44536 \u46308 \u50640 \u44172  \u46041 \u51312 \u54664 \u45912  \u49548 \u49688 \u51032  \u45796 \u47480  \u49324 \u46988 \u46308 \u51008  \u44221 \u44148 \u52824  \u50506 \u51008  \u46041 \u47308  \u54617 \u49373 \u46308 \u47196 \u48512 \u53552  \u47700 \u49548 \u46356 \u49828 \u53944  (Methodists \'97 \u44508 \u52825  \u51456 \u49688 \u51088 ) \u46972 \u45716  \u47784 \u47736 \u51201 \u51064  \u52845 \u54840 \u47484  \u48155 \u50520 \u45796 . \u44536 \u47084 \u45208  \u50724 \u45720 \u45216 \u50640 \u45716  \u44536  \u52845 \u54840 \u44032  \u50689 \u44397 \u44284  \u48120 \u44397 \u50640 \u49436  \u44032 \u51109  \u49464 \u47141  \u51080 \u45716  \u44368 \u54028 \u51032  \u54616 \u45208 \u47196  \u47749 \u50696 \u47196 \u50868  \u51060 \u47492 \u51060  \u46104 \u50632 \u45796 .\
