\uc0\u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51060  \u44144 \u48512 \u46104 \u47732  \u51396 \u44032  \u49324 \u50501 \u54616 \u44172  \u48372 \u51060 \u51648  \u50506 \u44256  \u51032 \u44032  \u48148 \u46988 \u51649 \u54620  \u44163 \u51004 \u47196  \u45208 \u53440 \u45208 \u51648  \u50506 \u44172  \u46108 \u45796 . \u54616 \u45208 \u45784 \u51032  \u51221 \u48512 \u50640  \u49692 \u51333 \u54616 \u44592 \u47484  \u44144 \u51208 \u54616 \u45716  \u51088 \u46308 \u51008  \u51088 \u44592  \u51088 \u49888 \u46308 \u51012  \u51648 \u48176 \u54616 \u44592 \u50640  \u51204 \u54784  \u51201 \u54633 \u54616 \u51648  \u50506 \u44172  \u46108 \u45796 . \u44536 \u46308 \u51032  \u50948 \u54744 \u54620  \u44032 \u47476 \u52840 \u51012  \u53685 \u54616 \u50668  \u48376 \u49457 \u51201 \u51004 \u47196  \u51648 \u48176 \u48155 \u44592 \u47484  \u51339 \u50500 \u54616 \u51648  \u50506 \u45716  \u52397 \u49548 \u45380 \u46308 \u51032  \u49900 \u51473 \u50640  \u48520 \u49692 \u51333 \u51032  \u51221 \u49888 \u51060  \u48512 \u49885 \u46104 \u50612  \u47924 \u51656 \u49436 \u54616 \u44256  \u48169 \u51333 \u54620  \u49324 \u54924  \u49345 \u53468 \u47484  \u52488 \u47000 \u54616 \u44172  \u46108 \u45796 . \u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u54616 \u45208 \u45784 \u51032  \u50836 \u44396 \u50640  \u49692 \u51333 \u54616 \u45716  \u49324 \u46988 \u46308 \u51032  \u53468 \u46020 \u47484  \u51312 \u49548 \u54616 \u45716  \u54620 \u54200  \u49324 \u45800 \u51032  \u49549 \u51076 \u49688 \u45716  \u50676 \u44305 \u51201 \u51004 \u47196  \u48155 \u50500 \u46308 \u51064 \u45796 . \u44536 \u46308 \u51032  \u51221 \u50837 \u45824 \u47196  \u54665 \u46041 \u54616 \u50668  \u51060 \u44368 \u46020 \u46308 \u50640 \u44172  \u49900 \u54032 \u51012  \u52488 \u47000 \u54620  \u44536  \u51396 \u50501 \u51012  \u51088 \u54665 \u54616 \u44256  \u51080 \u45796 .\
\uc0\u49324 \u46988 \u46308 \u50640 \u44172  \u54616 \u45208 \u45784 \u51032  \u44228 \u47749 \u51012  \u44221 \u54616 \u44172  \u50668 \u44592 \u46020 \u47197  \u44032 \u47476 \u52824 \u45716  \u51088 \u46308 \u51008  \u48520 \u49692 \u51333 \u51012  \u44144 \u46160 \u44592  \u50948 \u54616 \u50668  \u48520 \u49692 \u51333 \u51032  \u50472 \u47484  \u49900 \u44256  \u51080 \u45796 . \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51004 \u47196  \u44284 \u54644 \u51652  \u51228 \u51116 \u44032  \u50756 \u51204 \u55176  \u51228 \u44144 \u46104 \u47732  \u48120 \u44396 \u50640  \u51064 \u44036 \u51032  \u48277 \u47456 \u46020  \u47924 \u49884 \u46112  \u44163 \u51060 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436  \u48512 \u51221 \u51649 \u54620  \u54665 \u50948 \u50752  \u53456 \u49900 \u44284  \u44144 \u51667 \u47568 \u44284  \u49549 \u51076 \u49688 \u47484  \u44552 \u54616 \u49884 \u44592  \u46412 \u47928 \u50640  \u49324 \u46988 \u46308 \u51008  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51060  \u44536 \u46308 \u51032  \u49464 \u49549 \u51201  \u48264 \u50689 \u50640  \u48169 \u54644 \u44032  \u46104 \u45716  \u44163 \u51004 \u47196  \u50668 \u44592 \u44256  \u44536 \u44163 \u51012  \u50976 \u47536 \u54616 \u47140  \u54620 \u45796 . \u44536 \u47084 \u45208  \u44536  \u50984 \u48277 \u51012  \u48260 \u47536  \u44208 \u44284 \u47196  \u44536 \u46308 \u51060  \u50696 \u44592 \u54616 \u51648  \u47803 \u54620  \u51068 \u51060  \u49373 \u44600  \u44163 \u51060 \u45796 . \u50984 \u48277 \u51060  \u54952 \u47141 \u51012  \u51075 \u50612 \u48260 \u47532 \u47732  \u45572 \u44032  \u48276 \u51396 \u54616 \u44592 \u47484  \u46160 \u47140 \u50892 \u54624  \u44163 \u51064 \u44032 ? \u51116 \u49328 \u51008  \u45908  \u51060 \u49345  \u50504 \u51204 \u54616 \u51648  \u47803 \u54624  \u44163 \u51060 \u45796 . \u49324 \u46988 \u46308 \u51008  \u54253 \u47141 \u51004 \u47196  \u51060 \u50883 \u51032  \u49548 \u50976 \u47484  \u50557 \u53448 \u54616 \u44172  \u46112  \u44163 \u51060 \u48064 \u47196  \u44053 \u54620  \u51088 \u44032  \u51228 \u51068  \u53360  \u48512 \u51088 \u44032  \u46112  \u44163 \u51060 \u45796 . \u49373 \u47749  \u44536  \u51088 \u52404 \u46020  \u51316 \u51473 \u55176  \u50668 \u44200 \u51648 \u51648  \u50506 \u51012  \u44163 \u51060 \u45796 . \u44208 \u54844  \u49436 \u50557 \u46020  \u45908  \u51060 \u49345  \u44032 \u51221 \u51012  \u48372 \u54840 \u54644  \u51452 \u45716  \u44144 \u47337 \u54620  \u48169 \u54840 \u48317 \u51060  \u46104 \u51648  \u47803 \u54624  \u44163 \u51060 \u45796 . \u55192  \u51080 \u45716  \u51088 \u45716  \u50896 \u54616 \u44592 \u47564  \u54616 \u47732  \u44536  \u51060 \u50883 \u51032  \u50500 \u45236 \u47484  \u54253 \u47141 \u51004 \u47196  \u48764 \u50519 \u44172  \u46112  \u44163 \u51060 \u45796 . \u45796 \u49455 \u51704  \u44228 \u47749 \u51008  \u45367 \u51704  \u44228 \u47749 \u52376 \u47100  \u47924 \u49884 \u46112  \u44163 \u51060 \u45796 . \u51088 \u45376 \u46308 \u51060  \u44536 \u46308 \u51032  \u48512 \u47784 \u51032  \u49373 \u47749 \u51012  \u48764 \u50519 \u51020 \u51004 \u47196 \u50024  \u44536 \u46308 \u51032  \u53440 \u46973 \u54620  \u47560 \u51020 \u51032  \u50837 \u47581 \u51012  \u51060 \u47344  \u49688  \u51080 \u45796 \u47732  \u44536 \u46308 \u51008  \u44536 \u47088  \u51068 \u46020  \u49436 \u49844 \u51648  \u50506 \u51012  \u44163 \u51060 \u45796 . \u47928 \u47749  \u49464 \u44228 \u45716  \u51208 \u46020 \u50752  \u50516 \u49332 \u51088 \u51032  \u49548 \u44404 \u51060  \u46104 \u44256  \u54217 \u54868 \u50752  \u50504 \u49885 \u44284  \u54665 \u48373 \u51008  \u51648 \u49345 \u50640 \u49436  \u49324 \u46972 \u51656  \u44163 \u51060 \u45796 .\
\uc0\u49324 \u46988 \u51060  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u50640  \u49692 \u51333 \u54624  \u51032 \u47924 \u50640 \u49436  \u54644 \u48169 \u46104 \u50632 \u45796 \u45716  \u44368 \u47532 \u45716  \u51060 \u48120  \u49324 \u46988 \u46308 \u51032  \u46020 \u45909 \u44288 \u45392 \u51012  \u50557 \u54868 \u49884 \u53412 \u44256  \u51060  \u49464 \u49345 \u50640  \u51396 \u50501 \u51032  \u47932 \u44208 \u51060  \u46308 \u50612 \u50732  \u49688 \u47928 \u51012  \u50676 \u50612  \u45459 \u50520 \u45796 . \u48520 \u48277 \u44284  \u48169 \u53461 \u44284  \u53440 \u46973 \u51008  \u44151 \u51105 \u51012  \u49688  \u50630 \u45716  \u51312 \u49688 \u52376 \u47100  \u50864 \u47532 \u47484  \u55081 \u50424 \u44256  \u51080 \u45796 . \u49324 \u45800 \u51008  \u44032 \u51221 \u50640 \u49436  \u54876 \u46041 \u54616 \u44256  \u51080 \u45796 . \u49900 \u51648 \u50612  \u44536 \u47532 \u49828 \u46020 \u51064  \u44032 \u51221 \u51060 \u46972 \u44256  \u44277 \u50616 \u54616 \u45716  \u44275 \u50640 \u44620 \u51648  \u44536 \u51032  \u44611 \u48156 \u51060  \u55064 \u45216 \u47532 \u44256  \u51080 \u45796 . \u51656 \u53804 , \u49884 \u44592 , \u50948 \u49440 , \u51060 \u44036 , \u44221 \u51137 , \u48520 \u54868 , \u49888 \u49457 \u54620  \u51032 \u47924 \u50640  \u45824 \u54620  \u48176 \u48152 , \u50977 \u50837 \u51032  \u48169 \u51333  \u46321 \u51060  \u51080 \u45796 . \u49324 \u54924 \u49373 \u54876 \u51032  \u44592 \u52488 \u50752  \u48904 \u45824 \u44032  \u46104 \u50612 \u50556  \u54624  \u51333 \u44368 \u51201  \u50896 \u52825 \u51032  \u51204 \u52404 \u51201  \u52404 \u44228 \u50752  \u44368 \u47532 \u45716  \u47560 \u52824  \u55124 \u46308 \u44144 \u47532 \u45716  \u45929 \u50612 \u47532 \u52376 \u47100  \u48148 \u50556 \u55120 \u47196  \u48512 \u49436 \u51256  \u50630 \u50612 \u51648 \u47140  \u54620 \u45796 . \u44032 \u51109  \u53440 \u46973 \u54620  \u48276 \u51396 \u51088 \u46308 \u51060  \u44536 \u46308 \u51032  \u48276 \u51396 \u47196  \u53804 \