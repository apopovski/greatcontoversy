\f1\b0 \cf0 \
\uc0\u50724 \u45720 \u45216  \u44060 \u49888 \u44368 \u50640 \u49436 \u45716  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u51068 \u50836 \u51068 \u50640  \u48512 \u54876 \u54616 \u49512 \u51004 \u48064 \u47196  \u44536 \u45216 \u51060  \u44536 \u47532 \u49828 \u46020 \u51064 \u51032  \u50504 \u49885 \u51068 \u51060  \u46104 \u50632 \u45796 \u44256  \u51452 \u51109 \u54620 \u45796 . \u44536 \u47084 \u45208  \u44144 \u44592 \u50640  \u44288 \u54620  \u49457 \u44221 \u49345  \u51613 \u44144 \u45716  \u51204 \u54784  \u50630 \u45796 . \u44536 \u47532 \u49828 \u46020 \u50752  \u44536 \u48516 \u51032  \u51228 \u51088 \u46308 \u51008  \u44536 \u45216 \u51012  \u44536 \u50752  \u44057 \u51060  \u45458 \u51060 \u51648  \u50506 \u50520 \u45796 . \u44536 \u47532 \u49828 \u46020 \u44368 \u51032  \u51228 \u46020 \u47196 \u50024  \u51068 \u50836 \u51068 \u51012  \u51456 \u49688 \u54616 \u44172  \u46108  \u45800 \u49436 \u45716  \u51060 \u48120  \u48148 \u50872 \u51032  \u49884 \u45824 \u50640  \u54876 \u46041 \u51012  \u49884 \u51089 \u54620  \'93\u48520 \u48277 \u51032  \u48708 \u48128 \'94 (\u49332 \u54980  2:7) \u50640 \u49436  \u52286 \u51012  \u49688  \u51080 \u45796 . \u50864 \u47532  \u51452 \u45784 \u44760 \u49436  \u50616 \u51228  \u50612 \u46356 \u49436  \u51060  \u48277 \u50773 \u44428 \u51032  \u49548 \u49373  (\u25152 \u29983 ) \u51012  \u50577 \u51088 \u47196  \u49340 \u51004 \u49512 \u45716 \u44032 ? \u49457 \u44221 \u51060  \u51064 \u51221 \u54616 \u51648  \u50506 \u45716  \u51060 \u50752  \u44057 \u51008  \u48320 \u44221 \u50640  \u45824 \u54616 \u50668  \u50612 \u46496 \u54620  \u53440 \u45817 \u54620  \u51060 \u50976 \u47484  \u45832  \u49688  \u51080 \u44192 \u45716 \u44032 ?\
6\uc0\u49464 \u44592 \u50640  \u48277 \u50773 \u44428 \u51008  \u54869 \u44256 \u54616 \u44172  \u54869 \u47549 \u46104 \u50632 \u45796 . \u44536 \u51032  \u44428 \u51340 \u45716  \u47196 \u47560 \u50640  \u50948 \u52824 \u54616 \u44172  \u46104 \u50632 \u44256 , \u47196 \u47560 \u51032  \u44048 \u46021 \u51008  \u47784 \u46304  \u44368 \u54924 \u51032  \u47672 \u47532 \u44032  \u46108 \u45796 \u44256  \u44277 \u54252 \u46104 \u50632 \u45796 . \u51060 \u44368 \u45716  \u44536 \u51032  \u51648 \u50948 \u47484  \u48277 \u50773 \u50640 \u44172  \u45336 \u44200 \u51452 \u50632 \u45796 . \u44263  \u50857 \u51060  \u51664 \u49849 \u50640 \u44172  \'93\u51088 \u44592 \u51032  \u45733 \u47141 \u44284  \u48372 \u51340 \u50752  \u53360  \u44428 \u49464 \'94 (\u44228  13:2) \u47484  \u51452 \u50632 \u45796  (\u48512 \u47197  5 \u52280 \u51312 ). \u51060 \u47532 \u54616 \u50668  \u45796 \u45768 \u50648 \u49436 \u50752  \u50836 \u54620 \u44228 \u49884 \u47197 \u50640 \u49436  \u50696 \u50616 \u54620  1260\u45380 \u44036 \u51032  \u48277 \u50773 \u44428 \u51032  \u48149 \u54644 \u44032  \u49884 \u51089 \u46104 \u50632 \u45796  (\u45800  7:25; \u44228  13:5~7 \u52280 \u51312 ). \u44536 \u47532 \u49828 \u46020 \u51064 \u46308 \u51008  \u48127 \u51020 \u51032  \u51208 \u44060 \u47484  \u48260 \u47532 \u44256  \u48277 \u50773 \u44368 \u51032  \u51032 \u49885 \u44284  \u50696 \u48176 \u47484  \u48155 \u50500 \u46308 \u51060 \u46304 \u51648 , \u51648 \u54616  \u44048 \u50725 \u50640  \u44039 \u55176 \u44144 \u45208  \u44256 \u47928 \u45824  (\u25335 \u21839 \u33274 ) \u50752  \u54868 \u54805  (\u28779 \u21009 ) \u44284  \u52280 \u54805  (\u26028 \u21009 ) \u51665 \u54665 \u51088 \u51032  \u52860 \u50640  \u49373 \u47749 \u51012  \u48764 \u50519 \u44592 \u46304 \u51648 , \u44536  \u50612 \u45712  \u44163  \u54616 \u45208 \u47484  \u49440 \u53469 \u54624  \u49688 \u48150 \u50640  \u50630 \u44172  \u46104 \u50632 \u45796 . \'93\u49900 \u51648 \u50612  \u48512 \u47784 \u50752  \u54805 \u51228 \u50752  \u52828 \u52377 \u44284  \u48279 \u51060  \u45320 \u55148 \u47484  \u45336 \u44200 \u51452 \u50612  \u45320 \u55148  \u51473 \u50640  \u47751 \u51012  \u51453 \u51060 \u44172  \u54616 \u44192 \u44256  \u46608  \u45320 \u55148 \u44032  \u45236  \u51060 \u47492 \u51012  \u51064 \u54616 \u50668  \u47784 \u46304  \u49324 \u46988 \u50640 \u44172  \u48120 \u50880 \u51012  \u48155 \u51012  \u44163 \u51060 \'94 (\u45573  21:16, 17) \u46972 \u44256  \u54616 \u49888  \u50696 \u49688 \u45784 \u51032  \u47568 \u50432 \u51060  \u49457 \u52712 \u46104 \u50632 \u45796 . \u48149 \u54644 \u45716  \u51204 \u50640  \u50630 \u51060  \u54620 \u52789  \u45908  \u44201 \u47148 \u54616 \u44172  \u52649 \u49457 \u46108  \u49324 \u46988 \u46308 \u50640 \u44172  \u51076 \u54616 \u50688 \u51004 \u48064 \u47196  \u49464 \u49345 \u51008  \u54616 \u45208 \u51032  \u53360  \u51204 \u51137 \u53552 \u44032  \u46104 \u50612  \u48260 \u47160 \u45796 . \u44536  \u54980  \u49688 \u48177  \u45380 \u44036  \u44536 \u47532 \u49828 \u46020 \u44368 \u54924 \u45716  \u51064 \u44032 \u44032  \u50630 \u45716  \u44417 \u48317 \u54620  \u44275 \u50640 \u49436  \u54588 \u45212 \u52376 \u47484  \u52286 \u50520 \u45796 . \u49440 \u51648 \u51088 \u45716  \u51060  \u51068 \u50640  \u45824 \u54616 \u50668  \'93\u50668 \u51088 \u44032  \u44305 \u50556 \u47196  \u46020 \u47581 \u54616 \u47588  \u44144 \u44592 \u49436  1260\u51068  \u46041 \u50504  \u51200 \u47484  \u50577 \u50977 \u54616 \u44592  \u50948 \u54616 \u50668  \u54616 \u45208 \u45784 \u51032  \u50696 \u48708 \u54616 \u49888  \u44275 \u51060  \u51080 \u45908 \u46972 \'94 (\u44228  12:6) \u44256  \u50696 \u50616 \u54616 \u44256  \u51080 \u45796 .\
