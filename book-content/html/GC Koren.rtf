\uc0\u51088 \u49888 \u51032  \u49696 \u52293 \u51060  \u50864 \u47532 \u50640 \u44172  \u50508 \u47140 \u51648 \u45716  \u44163 \u48372 \u45796  \u45824 \u44592 \u47564 \u51088  \u49324 \u45800 \u51060  \u45908  \u46160 \u47140 \u50892 \u54616 \u45716  \u44163 \u51008  \u50630 \u45796 . \u44536 \u45716  \u45908 \u50865  \u51096  \u51088 \u49888 \u51032  \u51221 \u52404 \u50752  \u47785 \u51201 \u51012  \u49704 \u44608 \u51004 \u47196  \u45796 \u47564  \u51312 \u49548 \u50752  \u48708 \u45212 \u51032  \u45824 \u49345 \u51004 \u47196 \u49436 \u47564  \u49324 \u46988 \u46308 \u50640 \u44172  \u51452 \u47785 \u46104 \u46020 \u47197  \u51088 \u49888 \u51012  \u45208 \u53440 \u45236  \u50772 \u45796 . \u44536 \u45716  \u51088 \u44592 \u44032  \u48152 \u49688  \u48152 \u51064  (\u21322 \u29560 \u21322 \u20154 ) \u51032  \u44592 \u54805 \u51201 \u51060 \u47728  \u55113 \u52825 \u49828 \u47084 \u50868  \u44163 \u51004 \u47196  \u54364 \u54788 \u46104 \u45716  \u44163 \u51012  \u44592 \u48848 \u54620 \u45796 . \u44536 \u45716  \u49828 \u49828 \u47196 \u44032  \u51648 \u54812 \u47213 \u44256  \u51648 \u49457 \u51201 \u51064  \u49324 \u46988 \u51004 \u47196  \u51088 \u52376 \u54616 \u45716  \u51088 \u46308 \u47196  \u47568 \u48120 \u50516 \u50500  \u51088 \u49888 \u51032  \u51060 \u47492 \u51060  \u50883 \u51020 \u44284  \u51312 \u47217 \u44144 \u47532 \u47196  \u49324 \u50857 \u46104 \u45716  \u47568 \u51012  \u46307 \u44256 \u49436  \u44592 \u48848 \u54620 \u45796 .\
\'93\uc0\u44536 \u47088  \u51316 \u51116 \u44032  \u52280 \u51004 \u47196  \u51316 \u51116 \u54616 \u45716 \u44032 ?\'94\u46972 \u45716  \u47568 \u51012  \u50612 \u46356 \u49436 \u45208  \u46307 \u45716  \u44163 \u51008  \u44536 \u44032  \u52280 \u51004 \u47196  \u44368 \u47896 \u54616 \u44172  \u44032 \u47732 \u51012  \u51096  \u50416 \u44256  \u51080 \u44592  \u46412 \u47928 \u51060 \u45796 . \u44536 \u47532 \u44256  \u51068 \u48152  \u51333 \u44368 \u44228 \u50640 \u49436 \u46020  \u44032 \u51109  \u48516 \u47749 \u54620  \u49457 \u44221 \u51032  \u51613 \u50616 \u44284  \u51204 \u50672  \u48152 \u45824 \u46104 \u45716  \u51060 \u47200 \u51060  \u51068 \u48152 \u51201 \u51004 \u47196  \u50857 \u51064 \u46104 \u44256  \u51080 \u45716  \u49324 \u49892 \u51008  \u48148 \u47196  \u44536 \u44032  \u49457 \u44277 \u51012  \u44144 \u46160 \u44256  \u51080 \u45796 \u45716  \u51613 \u44144 \u51060 \u45796 . \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51060  \u44536 \u51032  \u55113 \u50501 \u54620  \u50669 \u49324 \u50640  \u45824 \u54620  \u47566 \u51008  \u49892 \u47168 \u47484  \u50676 \u44144 \u54616 \u44256  \u44536 \u51032  \u51008 \u48128 \u54620  \u49464 \u47141 \u51012  \u50864 \u47532 \u50640 \u44172  \u54253 \u47196 \u54644  \u51452 \u44256  \u44536 \u51032  \u44277 \u44201 \u50640  \u45824 \u54616 \u50668  \u50864 \u47532 \u47484  \u44221 \u44228 \u54616 \u44172  \u54616 \u45716  \u44163 \u51008  \u44536 \u51032  \u50689 \u54693 \u51012  \u44648 \u45803 \u51648  \u47803 \u54616 \u45716  \u51088 \u46308 \u51032  \u47560 \u51020 \u51060  \u44032 \u51109  \u49789 \u44172  \u49324 \u45800 \u50640 \u44172  \u51648 \u48176 \u46112  \u49688  \u51080 \u44592  \u46412 \u47928 \u51060 \u45796 .\
\uc0\u50864 \u47532 \u44032  \u47564 \u51068  \u52488 \u50900 \u54616 \u49888  \u44396 \u51452 \u51032  \u45733 \u47141 \u51004 \u47196  \u44396 \u50896 \u44284  \u48372 \u54840 \u47484  \u48155 \u51648  \u47803 \u54624  \u44163  \u44057 \u51004 \u47732 , \u49324 \u45800 \u44284  \u44536  \u48512 \u54616 \u46308 \u51032  \u49464 \u47141 \u44284  \u50501 \u51032 \u50640  \u45440 \u46972 \u45716  \u44163 \u51060  \u45817 \u50672 \u54624  \u44163 \u51060 \u45796 . \u50864 \u47532 \u45716  \u51665 \u50640  \u48727 \u51109 \u51012  \u52292 \u50864 \u44256  \u51088 \u47932 \u49632 \u47484  \u51104 \u44552 \u51004 \u47196  \u50501 \u54620  \u51088 \u46308 \u51032  \u49552 \u50640 \u49436  \u50864 \u47532 \u51032  \u49373 \u47749 \u44284  \u51116 \u49328 \u51012  \u48372 \u54840 \u54616 \u45716  \u51068 \u50640  \u47588 \u50864  \u51452 \u51032 \u54620 \u45796 . \u44536 \u47084 \u45208  \u50864 \u47532 \u45716  \u51088 \u49888 \u51032  \u55192 \u44284  \u49688 \u45800 \u51004 \u47196 \u50024 \u45716  \u44536  \u44277 \u44201 \u50640  \u51200 \u54637 \u54624  \u49688  \u50630 \u45716  \u50501 \u54620  \u52380 \u49324 \u46308 \u51060  \u45130 \u51076 \u50630 \u51060  \u50864 \u47532 \u50640 \u44172  \u51217 \u44540 \u54644  \u50732 \u51648 \u46972 \u46020  \u44144 \u44592 \u50640  \u45824 \u54616 \u50668  \u49373 \u44033 \u54616 \u45716  \u51068 \u51008  \u48324 \u48152  \u50630 \u45796 . \u47564 \u51068  \u49324 \u45800 \u50640 \u44172  \u47585 \u44200 \u51652 \u45796 \u47732  \u44536 \u45716  \u50864 \u47532 \u51032  \u47560 \u51020 \u51012  \u48120 \u52824 \u44172  \u54616 \u44256  \u50864 \u47532 \u51032  \u50977 \u52404 \u47484  \u47581 \u44032 \u46888 \u47532 \u44256  \u44256 \u53685 \u49828 \u47101 \u44172  \u54616 \u47728  \u49373 \u47749 \u44284  \u51116 \u49328 \u51012  \u54028 \u44340 \u54624  \u44163 \u51060 \u45796 . \u44536 \u46308 \u51032  \u50976 \u51068 \u51032  \u44592 \u49256 \u51008  \u48520 \u54665 \u44284  \u54028 \u47736 \u50640  \u51080 \u45796 . \u546