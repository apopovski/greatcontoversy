\uc0\u54532 \u46993 \u49828  \u53685 \u52824 \u51088 \u46308 \u51008  \u51060  \u52824 \u47749 \u51201 \u51064  \u51221 \u52293 \u51032  \u44208 \u44284 \u47484  \u44144 \u51032  \u45236 \u45796 \u48372 \u51648  \u47803 \u54616 \u50688 \u45796 . \u49457 \u44221 \u51032  \u44368 \u54984 \u51008  \u44277 \u54217 , \u51208 \u51228 , \u51652 \u47532 , \u54217 \u46321 , \u51088 \u50528 \u51032  \u50896 \u52825 \u46308 \u51012  \u48177 \u49457 \u46308 \u51032  \u47560 \u51020 \u50640  \u49900 \u50612  \u51460  \u44163 \u51060 \u50632 \u45716 \u45936 , \u44536 \u47084 \u54620  \u48120 \u45909 \u46308 \u51008  \u44397 \u44032 \u47484  \u48264 \u50689 \u52992  \u54616 \u45716  \u50976 \u51068 \u54620  \u52488 \u49437 \u51060 \u45796 . \'93\u51032 \u45716  \u45208 \u46972 \u47196  \u50689 \u54868 \u47213 \u44172  \u54616 \u44256 \'94, \'93\u44536  \u48372 \u51340 \u44032  \u44277 \u51032 \u47196  \u47568 \u48120 \u50516 \u50500  \u44403 \u44172  \u49452 \u51060 \u45768 \u46972 \'94 (\u51104  14:34, 16:12). \'93\u51032 \u51032  \u44277 \u54952 \u45716  \u54868 \u54217 \u51060 \u50836  \u51032 \u51032  \u44208 \u44284 \u45716  \u50689 \u50896 \u54620  \u54217 \u50504 \u44284  \u50504 \u51204 \u51060 \u46972 \'94 (\u49324  32:17). \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51012  \u49692 \u51333 \u54616 \u45716  \u49324 \u46988 \u51008  \u44397 \u44032 \u51032  \u48277 \u47456 \u46020  \u44032 \u51109  \u49457 \u49892 \u54616 \u44172  \u49692 \u51333 \u54616 \u44172  \u46112  \u44163 \u51060 \u45796 . \u54616 \u45208 \u45784 \u51012  \u46160 \u47140 \u50892 \u54616 \u45716  \u49324 \u46988 \u51008  \u51221 \u45817 \u54616 \u44256  \u54633 \u48277 \u51201 \u51064  \u50728 \u44054  \u44428 \u50948 \u47484  \u54665 \u49324 \u54616 \u45716  \u45208 \u46972 \u51032  \u50773 \u51012  \u44277 \u44221 \u54616 \u44172  \u46112  \u44163 \u51060 \u45796 . \u44536 \u47088 \u45936  \u54532 \u46993 \u49828 \u45716  \u48520 \u54665 \u55176 \u46020  \u49457 \u44221 \u51012  \u44552 \u51648 \u54616 \u50688 \u44256 , \u44536 \u44163 \u51012  \u48127 \u45716  \u49324 \u46988 \u46308 \u51012  \u54028 \u47928 \u54616 \u50688 \u45796 . \u50668 \u47084  \u49464 \u44592 \u50640  \u44152 \u52432 \u49436  \u50896 \u52825 \u44284  \u49888 \u51312 \u50640  \u44403 \u49468  \u49324 \u46988 \u46308 , \u50696 \u48124 \u54620  \u51648 \u47141 \u44284  \u46020 \u45909 \u51201  \u45733 \u47141 \u51012  \u44054 \u52632  \u49324 \u46988 \u46308 , \u51088 \u44592 \u51032  \u50577 \u49900 \u51012  \u44144 \u49828 \u47476 \u51648  \u50506 \u44256  \u51652 \u47532 \u47484  \u50948 \u54616 \u50668  \u44256 \u45212  \u48155 \u44592 \u47484  \u46160 \u47140 \u50892 \u54616 \u51648  \u50506 \u45716  \u48127 \u51020 \u44284  \u50857 \u44592 \u51032  \u49324 \u46988 \u46308 , \u44536 \u46308 \u51008  \u44068 \u47532 \u49440 \u51032  \u45432 \u50696 \u47196  \u44256 \u50669 \u51012  \u45817 \u54616 \u44144 \u45208  \u54868 \u54805 \u51012  \u45817 \u54616 \u44144 \u45208  \u44048 \u50725  \u49549 \u50640 \u49436  \u49888 \u51020 \u54616 \u50688 \u45796 . \u46608 \u54620  \u49688 \u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u47676  \u44275 \u51004 \u47196  \u54588 \u54616 \u50668  \u44036 \u49888 \u55176  \u50504 \u51204 \u54620  \u44275 \u51004 \u47196  \u44052 \u45796 . \u51060 \u50752  \u44057 \u51008  \u49345 \u53468 \u45716  \u51333 \u44368 \u44060 \u54785 \u51060  \u49884 \u51089 \u46108  \u54980  250\u45380 \u44036  \u44228 \u49549 \u46104 \u50632 \u45796 .\
\'93\uc0\u50724 \u47004  \u44592 \u44036  \u46041 \u50504 \u50640  \u48149 \u54644 \u51088 \u46308 \u51032  \u44305 \u51201 \u51064  \u48516 \u45432 \u47484  \u54588 \u54616 \u50668  \u44036  \u48373 \u51020 \u51032  \u49324 \u46020 \u46308 \u51060  \u51068 \u48152 \u51201 \u51004 \u47196  \u54788 \u51200 \u55176  \u46832 \u50612 \u45212  \u51648 \u45733 , \u48120 \u49696 , \u44277 \u50629 , \u51656 \u49436  \u51080 \u45716  \u49373 \u54876  \u46321 \u51012  \u53685 \u54616 \u50668  \u44536 \u46308 \u51060  \u54588 \u45212  \u50728  \u44536  \u51648 \u48169 \u51012  \u48512 \u50836 \u54616 \u44172  \u54620  \u49324 \u49892 \u46308 \u51012  \u54532 \u46993 \u49828  \u49324 \u46988 \u46308 \u51008  \u48372 \u51648  \u47803 \u54620  \u49464 \u45824 \u44032  \u44144 \u51032  \u50630 \u50632 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u46308 \u51060  \u51060 \u50752  \u44057 \u51060  \u54988 \u47469 \u54620  \u51116 \u45733 \u51012  \u44032 \u51648 \u44256  \u45796 \u47480  \u45208 \u46972 \u47196  \u51060 \u51452 \u54616 \u50668  \u44032 \u45716  \u51068 \u44284  \u48708 \u47168 \u54616 \u50668  \u44536 \u46308 \u51032  \u45208 \u46972 \u50640 \u45716  \u44536 \u47088  \u51116 \u44036  \u51080 \u45716  \u49324 \u46988 \u46308 \u51060  \u52264 \u52784  \u51460 \u50612  \u44052 \u45796 . \u47564 \u51068  \u51060 \u48120  \u44032  \u48260 \u47536  \u44536  \u49324 \u46988 \u46308 \u51060  \u47784 \u46160  \u54532 \u46993 \u49828 \u50640  \u45224 \u50500  \u51080 \u50632 \u45796 \u47732 , \u47564 \u51068  \u44536  3\u48177  \u45380  \u46041 \u50504 \u50640  \u52628 \u48169 \u46108  \u44536  \u49324 \u46988 \u46308 \u51032  \u44277 \u50629  \u44592 \u49696 \u47196 \u50024  \u54532 \u46993 \u49828  \u44397 \u53664 \u47484  \u48156 \u51204 \u49884 \u53040 \u45796 \u47732 , \u46608 \u54620  \u44536 \u46308 \u51032  \u50696 \u49696 \u51201  \u49548 \u51656 \u47196 \u50024  \u52285 \u51089 \u50640  \u55192 \u50044 \u51012  \u44163  \u44057 \u51004 \u47732 , \u47564 \u51068  \u44536 \u46308 \u51032  \u52380 \u51116 \u51201 \u51064  \u52285 \u51089 \u47141 \u44284  \u48516 \u49437 \u54616 \u45716  \u45733 \u47141 \u51012  \u44032 \u51648 \u44256  \u44536  \u47928 \u54617 \u51012  \u48156 \u45804 \u49884 \u53412 \u44256  \u44284 \u54617 \u51012  \u50977 \u49457 \u49884 \u53040 \u51012  \u44163  \u44057 \u51004 \u47732 , \u47564 \u50557  \u44536 \u46308 \u51032  \u51648 \u54812 \u47196 \u50024  \u51032 \u54924 \u47484  \u51648 \u46020 \u54616 \u44256  \u44536 \u46308 \u51032  \u50857 \u47609 \u51004 \u47196  \u49912 \u50864 \u44256 , \u44536 \u46308 \u51032  \u44277 \u51032 \u47196  \u45208 \u46972 \u51032  \u48277 \u47456 \u51012  \u51228 \u51221 \u54616 \u44256 , \u49457 \u44221 \u51032  \u51333 \u44368 \u47196  \u48177 \u49457 \u46308 \u51032  \u51648 \u45733 \u51012  \u44228 \u48156 \u49884 \u53412 \u44256 , \u50577 \u49900 \u51012  \u45796 \u49828 \u47532 \u44172  \u54616 \u50688 \u45908 \u46972 \u47732 , \u50724 \u45720 \u45216  \u50620 \u47560 \u45208  \u52268 \u46976 \u54620  \u50689 \u44305 \u51060  \u54532 \u46993 \u49828 \u47484  \u46160 \u47476 \u44256  \u51080 \u51012  \u44163 \u51064 \u44032 ? \u54532 \u46993 \u49828 \u45716  \u50620 \u47560 \u45208  \u50948 \u45824 \u54616 \u44256 , \u48264 \u50689 \u46104 \u44256  \u54665 \u48373 \u46108  \u45208 \u46972 \u44032  \u46104 \u50632 \u51012 \u44620 ? \u44536  \u45208 \u46972 \u45716  \u47566 \u51008  \u45208 \u46972 \u46308 \u51032  \u47784 \u48376 \u51060  \u46104 \u50632 \u51012  \u44163 \u51060 \u45796 .\
\uc0\u44536 \u47084 \u45208  \u47609 \u47785 \u51201 \u51060 \u50836 , \u50756 \u44256 \u54616 \u44256  \u44256 \u51665 \u49828 \u47084 \u50868  \u54532 \u46993 \u49828 \u45716  \u47784 \u46304  \u45909 \u47581  \u51080 \u45716  \u44368 \u49324 \u46308 \u44284  \u51656 \u49436 \u47484  \u51096  \u51648 \u53412 \u45716  \u50864 \u49688 \u54620  \u49324 \u46988 \u46308 \u44284  \u50773 \u50948 \u47484  \u52649 \u49457 \u49828 \u47101 \u44172  \u50745 \u54840 \u54644  \u51452 \u45716  \u49324 \u46988 \u46308 \u51012  \u45208 \u46972  \u48150 \u51004 \u47196  \u47792 \u50500 \u45256 \u45796 . \u44536 \u46308 \u51032  \u45208 \u46972 \u47484  \u49464 \u49345 \u50640 \u49436  \u47749 \u49457  \u51080 \u44256  \u50689 \u44305 \u49828 \u47084 \u50868  \u45208 \u46972 \u47196  \u47564 \u46308 \u50612  \u51460  \u49324 \u46988 \u46308 \u50640 \u44172  \u54868 \u54805 \u51060  \u50500 \u45768 \u47732  \u52628 \u48169 \u51012  \u53469 \u54616 \u46972 \u44256  \u44053 \u50836 \u54616 \u50688 \u45796 . \u46300 \u46356 \u50612  \u44397 \u44032 \u51032  \u49632 \u53748 \u45716  \u44537 \u46020 \u50640  \u45804 \u54616 \u50668 , \u52628 \u48169 \u46112  \u47564 \u54620  \u50577 \u49900 \u51012  \u44032 \u51652  \u49324 \u46988 \u46308 \u51060  \u45908  \u51060 \u49345  \u45224 \u51648  \u50500 \u45768 \u54616 \u50688 \u44256 , \u54868 \u54805 \u51452 \u47196  \u45132 \u47140 \u44040  \u47564 \u54620  \u49888 \u50521 \u51012  \u44032 \u51652  \u49324 \u46988 \u46308 \u46020  \u50630 \u50612 \u51276 \u44256 , \u45208 \u46972  \u48150 \u51004 \u47196  \u52628 \u48169 \u54624  \u47564 \u54620  \u50528 \u44397 \u51088 \u46308 \u46020  \u45908  \u51060 \u49345  \u48380  \u49688  \u50630 \u44172  \u46104 \u50632 \u45796 \'94 (Wylie, b.13, ch.20). \u44536 \u47532 \u54616 \u50668  \u47560 \u52840 \u45236  \u47924 \u49436 \u50868  \u54785 \u47749 \u51060  \u51068 \u50612 \u45208 \u45716  \u44208 \u44284 \u47484  \u52488 \u47000 \u54616 \u50688 \u45796 .\
