\uc0\u50956 \u47532 \u50628  \u48128 \u47084 \u50752  \u44536 \u51032  \u46041 \u50669 \u51088 \u46308 \u50640 \u44172  \u48120 \u44397 \u50640 \u49436  \u44221 \u44256 \u51032  \u44592 \u48324 \u51012  \u51204 \u54616 \u46020 \u47197  \u49324 \u47749 \u51060  \u51452 \u50612 \u51276 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536  \u45208 \u46972 \u45716  \u50948 \u45824 \u54620  \u51116 \u47548 \u50868 \u46041 \u51032  \u51473 \u49900 \u51648 \u44032  \u46104 \u50632 \u45796 . \u50668 \u44592 \u50640 \u49436  \u52395 \u51704  \u52380 \u49324 \u51032  \u44592 \u48324 \u50640  \u45824 \u54620  \u50696 \u50616 \u51060  \u44032 \u51109  \u51649 \u51217 \u51201 \u51004 \u47196  \u49457 \u52712 \u46104 \u50632 \u45796 . \u48128 \u47084 \u50752  \u44536 \u51032  \u46041 \u50669 \u51088 \u46308 \u51032  \u51200 \u49436 \u45716  \u45328 \u47532  \u47676  \u51648 \u48169 \u50640 \u44620 \u51648  \u51204 \u54644 \u51276 \u45796 . \u50728  \u49464 \u44228 \u51032  \u50612 \u45712  \u44275 \u51060 \u45208  \u49440 \u44368 \u49324 \u46308 \u51060  \u45208 \u44036  \u44275 \u50640 \u45716  \u44536 \u47532 \u49828 \u46020 \u51032  \u51116 \u47548 \u51060  \u51076 \u48149 \u54616 \u50688 \u45796 \u45716  \u44592 \u49244  \u49548 \u49885 \u51060  \u51204 \u54616 \u50668 \u51276 \u45796 . \'93\u54616 \u45208 \u45784 \u51012  \u46160 \u47140 \u50892 \u54616 \u47728  \u44536 \u50640 \u44172  \u50689 \u44305 \u51012  \u46028 \u47532 \u46972  \u51060 \u45716  \u44536 \u51032  \u49900 \u54032 \u54616 \u49892  \u49884 \u44036 \u51060  \u51060 \u47476 \u47104 \u51020 \'94\u51060 \u46972 \u45716  \u50689 \u50896 \u54620  \u48373 \u51020 \u51032  \u44592 \u48324 \u51008  \u47680 \u47532 , \u44536 \u47532 \u44256  \u45328 \u47532  \u51204 \u54028 \u46104 \u50632 \u45796 .\
1844\uc0\u45380  \u48388 \u50640  \u44536 \u47532 \u49828 \u46020 \u51032  \u51116 \u47548 \u51060  \u51080 \u51012  \u44163 \u51004 \u47196  \u51648 \u51201 \u54644  \u51452 \u45716  \u46319 \u51060  \u48372 \u50688 \u45912  \u50696 \u50616 \u51032  \u51613 \u44144 \u45716  \u48177 \u49457 \u46308 \u51032  \u47560 \u51020 \u50640  \u44618 \u51008  \u44048 \u47749 \u51012  \u51452 \u50632 \u45796 . \u44536  \u44592 \u48324 \u51008  \u51060  \u51452  (\u24030 ) \u50640 \u49436  \u51200  \u51452 \u47196  \u51204 \u54028 \u46120 \u50640  \u46384 \u46972  \u50612 \u46356 \u49436 \u45208  \u53360  \u55141 \u48120 \u47484  \u51068 \u51004 \u53040 \u45796 . \u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u44536  \u50696 \u50616 \u51201  \u44592 \u44036 \u50640  \u45824 \u54620  \u45436 \u51613  (\u63809 \u35657 ) \u51060  \u51221 \u54869 \u54632 \u51012  \u54869 \u49888 \u54616 \u50668  \u51088 \u44592 \u46308 \u51032  \u44368 \u47564 \u54620  \u51032 \u44204 \u46308 \u51012  \u48260 \u47532 \u44256  \u44592 \u44732 \u51060  \u44536  \u51652 \u47532 \u47484  \u48155 \u50500 \u46308 \u50688 \u45796 . \u50612 \u46500  \u47785 \u49324 \u46308 \u51008  \u44536 \u46308 \u51032  \u51333 \u54028 \u51201  \u44204 \u54644 \u50752  \u44048 \u51221 \u51012  \u48260 \u47532 \u44256 , \u48393 \u44553 \u46020  \u44368 \u54924 \u46020  \u45796  \u48260 \u47532 \u44256 , \u50696 \u49688 \u45784 \u51032  \u51116 \u47548 \u51012  \u51204 \u54028 \u54616 \u45716  \u51068 \u50640  \u50672 \u54633 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u49457 \u51649 \u51088 \u46308  \u51473 \u50640 \u49436  \u44592 \u48324 \u51012  \u48155 \u51008  \u49324 \u46988 \u51008  \u48708 \u44368 \u51201  \u49548 \u49688 \u50688 \u51004 \u48064 \u47196  \u44592 \u48324 \u51012  \u51204 \u54616 \u45716  \u51068 \u51008  \u51452 \u47196  \u54217 \u49888 \u46020 \u46308 \u50640 \u44172  \u47585 \u44200 \u51276 \u45796 . \u45453 \u48512 \u46308 \u51008  \u44536 \u46308 \u51032  \u45453 \u51109 \u51012 , \u51649 \u44277 \u51008  \u44536 \u46308 \u51032  \u46020 \u44396 \u46308 \u51012 , \u49345 \u51064 \u51008  \u44536 \u46308 \u51032  \u49345 \u54408 \u51012 , \u51204 \u47928 \u51649 \u50640  \u51080 \u45716  \u49324 \u46988 \u46308 \u51008  \u44536 \u46308 \u51032  \u51649 \u47924 \u47484  \u48260 \u47532 \u44256  \u51060  \u51068 \u50640  \u44032 \u45812 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u49457 \u52712 \u46104 \u50612 \u50556  \u54624  \u51068 \u51032  \u48516 \u47049 \u50640  \u48708 \u54616 \u47732 , \u51068 \u44988 \u51032  \u49688 \u54952 \u45716  \u45320 \u47924  \u51201 \u50632 \u45796 . \u48520 \u44221 \u44148 \u54620  \u44368 \u54924 \u50752  \u51396 \u50501  \u51473 \u50640 \u49436  \u51088 \u44256  \u51080 \u45716  \u51060  \u49464 \u49345  \u54805 \u54200 \u51008  \u52280 \u46108  \u54028 \u49688 \u44988 \u51032  \u51649 \u48516 \u51012  \u54665 \u54616 \u45716  \u49324 \u46988 \u46308 \u51032  \u51664 \u51012  \u47924 \u44161 \u44172  \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u46308 \u51008  \u49324 \u46988 \u46308 \u51012  \u54924 \u44060 \u49884 \u53020  \u44396 \u50896 \u51004 \u47196  \u51064 \u46020 \u54616 \u44592  \u50948 \u54616 \u50668  \u54872 \u45212 \u44284  \u44417 \u54605 \u44284  \u44256 \u45212 \u51012  \u52280 \u50520 \u45796 . \u49324 \u45800 \u51032  \u48152 \u45824 \u47484  \u48155 \u51012 \u51648 \u46972 \u46020  \u44536  \u49324 \u50629 \u51008  \u44984 \u51456 \u55176  \u50526 \u51004 \u47196  \u45208 \u50500 \u44052 \u44256 , \u47924 \u49688 \u54620  \u49324 \u46988 \u46308 \u51060  \u51116 \u47548 \u51032  \u51652 \u47532 \u47484  \u48155 \u50500 \u46308 \u51060 \u44172  \u46104 \u50632 \u45796 .\
\uc0\u46020 \u52376 \u50640 \u49436  \u50628 \u49689 \u54620  \u51613 \u44144 \u51032  \u49548 \u47532 \u44032  \u46308 \u47160 \u44256 , \u51396 \u51064 \u46308 \u51012  \u44221 \u44256 \u54616 \u44256 , \u49464 \u49345  \u49324 \u46988 \u46308 \u44284  \u44368 \u51064 \u46308 \u50640 \u44172  \u45796  \u44057 \u51060  \u51109 \u52264  \u50732  \u51652 \u45432 \u47484  \u54588 \u54616 \u46972 \u45716  \u44221 \u44256 \u44032  \u51452 \u50612 \u51276 \u45796 . \u51204 \u46020 \u51088 \u46308 \u51008  \u44536 \u47532 \u49828 \u46020 \u51032  \u49440 \u44396 \u51088  (\u20808 \u39493 \u32773 ) \u52840 \u47168  \u50836 \u54620 \u52376 \u47100  \u45208 \u47924 \u49100 \u47532 \u50640  \u46020 \u45180 \u47484  \u45459 \u44256  \u54924 \u44060 \u50640  \u54633 \u45817 \u54620  \u50676 \u47588 \u47484  \u47610 \u51004 \u46972 \u44256  \u44428 \u44256 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51032  \u44048 \u46041 \u51201 \u51064  \u54840 \u49548 \u45716  \u51068 \u48152  \u44053 \u45800 \u50640 \u49436  \u51204 \u54644 \u51648 \u45716  \u54217 \u54868 \u50752  \u50504 \u51204 \u51012  \u48372 \u51613 \u54616 \u45716  \u49444 \u44368 \u50752 \u45716  \u54788 \u51200 \u54620  \u45824 \u51312 \u47484  \u51060 \u47336 \u50632 \u45796 . \u44536 \u47532 \u54616 \u50668  \u48373 \u51020 \u51012  \u51204 \u54620  \u44275 \u50640 \u49436 \u45716  \u50612 \u46356 \u49436 \u45208  \u49324 \u46988 \u46308 \u51060  \u44048 \u46041 \u51012  \u48155 \u50520 \u45796 . \u45800 \u49692 \u54616 \u44256  \u51649 \u51217 \u51201 \u51064  \u49457 \u44221  \u47568 \u50432 \u51032  \u51613 \u50616 \u51008  \u49457 \u47161 \u51032  \u45733 \u47141 \u51004 \u47196  \u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u50640  \u49352 \u44200 \u51276 \u44256 , \u46020 \u51200 \u55176  \u54637 \u44144 \u54624  \u49688  \u50630 \u45716  \u54869 \u49888 \u51012  \u44032 \u51256 \u45796 \u51452 \u50632 \u45796 . \u49888 \u50521 \u51064 \u51060 \u46972 \u44256  \u44277 \u50616 \u54616 \u45912  \u49324 \u46988 \u46308 \u51060  \u44144 \u51667 \u46108  \u50504 \u51068  \u49345 \u53468 \u50640 \u49436  \u51068 \u50612 \u45208 \u44172  \u46104 \u50632 \u45796 . \u44536 \u46308 \u51008  \u51088 \u44592 \u46308 \u51032  \u53440 \u46973 , \u49549 \u54868  (\u20439 \u21270 ), \u48520 \u49888 , \u51088 \u51316 \u49900 , \u51060 \u44592 \u49900 \u46308 \u51012  \u44648 \u45804 \u50520 \u45796 . \u47566 \u51008  \u49324 \u46988 \u46308 \u51060  \u54924 \u44060 \u54616 \u44256  \u44216 \u49552 \u54620  \u47560 \u51020 \u51004 \u47196  \u51452 \u45784 \u51012  \u52286 \u50520 \u45796 . \u44536 \u46308 \u51008  \u51648 \u44552 \u44620 \u51648  \u50724 \u47019 \u46041 \u50504  \u49464 \u49345 \u50640  \u46160 \u50632 \u45912  \u50528 \u51221 \u51012  \u54616 \u45720 \u50640  \u46160 \u44172  \u46104 \u50632 \u45796 . \u54616 \u45208 \u45784 \u51032  \u49457 \u47161 \u44760 \u49436  \u44536 \u46308 \u50640 \u44172  \u51076 \u54616 \u49512 \u51004 \u47728 , \u44536 \u46308 \u51008  \u48512 \u46300 \u47101 \u44256  \u49692 \u51333 \u54616 \u45716  \u47560 \u51020 \u51004 \u47196  \'93\u54616 \u45208 \u45784 \u51012  \u46160 \u47140 \u50892 \u54616 \u47728  \u44536 \u50640 \u44172  \u50689 \u44305 \u51012  \u46028 \u47532 \u46972  \u51060 \u45716  \u44536 \u51032  \u49900 \u54032 \u54616 \u49892  \u49884 \u44036 \u51060  \u51060 \u47476 \u47104 \'94\u45796 \u45716  \u44592 \u48324 \u51012  \u51204 \u54616 \u45716  \u51068 \u50640  \u46041 \u52280 \u54616 \u50688 \u45796 .\
\uc0\u51396 \u51064 \u46308 \u51008  \u50872 \u47732 \u49436  \'93\u45236 \u44032  \u50612 \u46523 \u44172  \u54616 \u50668 \u50556  \u44396 \u50896 \u51012  \u50619 \u51004 \u47532 \u51060 \u44620 \'94\u46972 \u44256  \u51656 \u47928 \u54616 \u50688 \u45796 . \u48512 \u51221 \u51649 \u54620  \u49373 \u50528 \u47484  \u54616 \u50668  \u50728  \u49324 \u46988 \u46308 \u51008  \u51088 \u44592 \u46308 \u51060  \u51077 \u55180  \u49552 \u54644 \u47484  \u48372 \u49345 \u54616 \u44256 \u51088  \u50676 \u47581 \u54616 \u50688 \u45796 . \u44536 \u47532 \u49828 \u46020  \u50504 \u50640 \u49436  \u54868 \u54217 \u51012  \u48156 \u44204 \u54620  \u49324 \u46988 \u46308 \u51008  \u44536  \u52629 \u48373 \u51012  \u45796 \u47480  \u49324 \u46988 \u46308 \u50640 \u44172  \u45208 \u45572 \u50612  \u51452 \u44592 \u47484  \u50896 \u54616 \u50688 \u45796 . \u48512 \u47784 \u51032  \u47560 \u51020 \u51008  \u44536  \u51088 \u45376 \u50640 \u44172 \u47196 , \u51088 \u45376 \u51032  \u47560 \u51020 \u51008  \u44536  \u48512 \u47784 \u50640 \u44172 \u47196  \u46028 \u50500 \u44052 \u45796 . \u51088 \u51316 \u49900 \u44284  \u51109 \u48317 \u51008  \u50630 \u50612 \u51276 \u45796 . \u51652 \u49900 \u51004 \u47196  \u51396 \u47484  \u44256 \u48177 \u54616 \u50688 \u44256 , \u44032 \u51313 \u46308 \u51008  \u47784 \u46160  \u44032 \u51109  \u44032 \u44637 \u44256  \u44032 \u51109  \u49324 \u46993 \u54616 \u45716  \u49324 \u46988 \u46308 \u51012  \u44396 \u50896 \u54616 \u44592  \u50948 \u54616 \u50668  \u45432 \u47141 \u54616 \u50688 \u45796 . \u51060 \u46384 \u44552  \u44032 \u51109  \u50676 \u47148 \u54616 \u44172  \u45796 \u47480  \u49324 \u46988 \u51012  \u50948 \u54616 \u50668  \u44592 \u46020 \u54616 \u45716  \u49548 \u47532 \u44032  \u46308 \u47160 \u45796 . \u50612 \u46356 \u49436 \u45208  \u53685 \u54924 \u54616 \u45716  \u47560 \u51020 \u51004 \u47196  \u54616 \u45208 \u45784 \u44760  \u53444 \u50896 \u54616 \u45716  \u49324 \u46988 \u46308 \u51060  \u51080 \u50632 \u45796 . \u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u51088 \u44592 \u46308 \u51032  \u51396 \u44032  \u49324 \u54632 \u51012  \u48155 \u50520 \u45796 \u45716  \u54869 \u51613 \u51012  \u50619 \u44592  \u50948 \u54616 \u50668 , \u46608 \u54620  \u44536 \u46308 \u51032  \u52828 \u52377 \u44284  \u51060 \u50883  \u49324 \u46988 \u46308 \u51012  \u54924 \u44060 \u49884 \u53412 \u44256 \u51088  \u48164 \u51012  \u49352 \u50864 \u47732 \u49436  \u44592 \u46020 \u51032  \u50472 \u47492 \u51012  \u54616 \u50688 \u45796 .\
\uc0\u44033 \u44228 \u44033 \u52789 \u51032  \u49324 \u46988 \u46308 \u51060  \u51116 \u47548 \u49888 \u46020 \u51032  \u54924 \u51665 \u50640  \u47784 \u50668  \u50772 \u45796 . \u48712 \u48512 \u44480 \u52380 \u51012  \u47561 \u47200 \u54616 \u44256  \u50668 \u47084  \u44032 \u51648  \u46041 \u44592 \u50640 \u49436  \u44033 \u44592  \u51116 \u47548 \u50640  \u45824 \u54620  \u44368 \u47532 \u47484  \u46307 \u44256 \u51088  \u44040 \u47581 \u54616 \u50688 \u45796 . \u51452 \u45784 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u51333 \u46308 \u51060  \u44536 \u46308 \u51032  \u49888 \u50521 \u51032  \u51060 \u50976 \u47484  \u49444 \u47749 \u54616 \u45716  \u46041 \u50504  \u48152 \u45824 \u51032  \u51221 \u49888 \u51060  \u51068 \u50612 \u45208 \u51648  \u50506 \u46020 \u47197  \u47561 \u51004 \u49512 \u45796 . \u46412 \u46412 \u47196  \u49324 \u50857 \u46104 \u45716  \u46020 \u44396 \u45716  \u50672 \u50557 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u54616 \u45208 \u45784 \u51032  \u49457 \u47161 \u44760 \u49436  \u45817 \u49888 \u51032  \u51652 \u47532 \u50640  \u44428 \u45733 \u51012  \u45908 \u54616 \u49512 \u45796 . \u44536 \u47088  \u51665 \u54924 \u50640 \u49436 \u45716  \u52380 \u49324 \u46308 \u51032  \u51076 \u51116 \u47484  \u45712 \u45188  \u49688  \u51080 \u50632 \u51004 \u47728 , \u49888 \u51088 \u46308 \u51060  \u45216 \u47560 \u45796  \u47566 \u51060  \u51613 \u44032 \u46104 \u50632 \u45796 . \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u49549 \u55176  \u51116 \u47548 \u54616 \u49892  \u44163 \u50640  \u45824 \u54620  \u51613 \u44144 \u44032  \u48152 \u48373  \u49444 \u47749 \u46112  \u46412 \u50640  \u47566 \u51008  \u44400 \u51473 \u46308 \u51008  \u49704 \u49548 \u47532 \u47484  \u51453 \u51060 \u44256  \u44536  \u50628 \u49689 \u54620  \u47568 \u50432 \u50640  \u44480 \u47484  \u44592 \u50872 \u50688 \u45796 . \u54616 \u45720 \u44284  \u46405 \u51060  \u44032 \u44620 \u50892 \u51652  \u44163 \u52376 \u47100  \u45712 \u44788 \u51276 \u45796 . \u54616 \u45208 \u45784 \u51032  \u44428 \u45733 \u51012  \u52397 \u45380 \u44284  \u51473 \u45380 \u44284  \u45432 \u45380 \u46308 \u51060  \u47784 \u46160  \u45712 \u45180 \u44172  \u46104 \u50632 \u45796 . \u49324 \u46988 \u46308 \u51008  \u51077 \u51004 \u47196  \u52268 \u49569 \u54616 \u47732 \u49436  \u51088 \u44592  \u51665 \u51004 \u47196  \u46028 \u50500 \u44052 \u44256 , \u44536  \u44592 \u49244  \u49548 \u47532 \u45716  \u51312 \u50857 \u54620  \u48164 \u54616 \u45720 \u50640  \u50872 \u47140  \u54140 \u51276 \u45796 . \u44536 \u47088  \u54924 \u51665 \u50640  \u52280 \u49437 \u54664 \u45912  \u49324 \u46988 \u46308 \u51008  \u44536  \u44048 \u47749  \u44618 \u51008  \u44305 \u44221 \u51012  \u50689 \u50896 \u55176  \u51082 \u51012  \u49688  \u50630 \u50632 \u45796 .\
