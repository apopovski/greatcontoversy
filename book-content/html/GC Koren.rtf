\uc0\u49324 \u46020 \u46308 \u51032  \u47784 \u50577 \u51004 \u47196  \u44032 \u51109 \u54616 \u44256  \u45208 \u53440 \u45208 \u45716  \u51060  \u49549 \u51060 \u45716  \u50689 \u46308 \u51008  \u49324 \u46020 \u46308 \u51060  \u49464 \u49345 \u50640  \u51080 \u51012  \u46412  \u49457 \u47161 \u51032  \u51648 \u46020 \u47196  \u44592 \u47197 \u54620  \u48148 \u50752 \u45716  \u51204 \u54784  \u48152 \u45824 \u46104 \u45716  \u47568 \u46308 \u51012  \u54620 \u45796 . \u44536  \u50689 \u46308 \u51008  \u49457 \u44221 \u51060  \u54616 \u45208 \u45784 \u44760 \u49436  \u51452 \u49888  \u47568 \u50432 \u51076 \u51012  \u48512 \u51064 \u54632 \u51004 \u47196  \u44536 \u47532 \u49828 \u46020 \u51064 \u51032  \u49548 \u47581 \u51032  \u44592 \u52488 \u47484  \u47924 \u45320 \u46888 \u47532 \u44256  \u54616 \u45720  \u44032 \u45716  \u44600 \u51012  \u48372 \u50668  \u51452 \u45716  \u48731 \u51012  \u44732 \u48260 \u47536 \u45796 . \u49324 \u45800 \u51008  \u49457 \u44221 \u51060  \u47564 \u46308 \u50612 \u45240  \u51060 \u50556 \u44592 \u50640  \u48520 \u44284 \u54620  \u44163 \u51060 \u44144 \u45208  \u51064 \u47448  \u50669 \u49324 \u51032  \u52488 \u44592 \u50640 \u45716  \u54841 \u49884  \u51201 \u45817 \u54616 \u50688 \u51012 \u51648  \u47784 \u47476 \u51648 \u47564  \u51060 \u51228 \u45716  \u49457 \u44221 \u51012  \u44221 \u49884 \u54616 \u44256  \u50424 \u47784 \u50630 \u45716  \u44163 \u51004 \u47196  \u48260 \u47140 \u50556  \u54624  \u44163 \u51060 \u46972 \u45716  \u54869 \u49888 \u51012  \u49464 \u49345  \u49324 \u46988 \u46308 \u50640 \u44172  \u51452 \u44256  \u51080 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u45716  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51012  \u45824 \u49888 \u54616 \u44592  \u50948 \u54616 \u50668  \u44592 \u51060 \u54620  \u51060 \u51201 \u51012  \u54665 \u54620 \u45796 . \u44053 \u49888 \u49696 \u51008  \u49324 \u45800 \u51060  \u47560 \u51020 \u45824 \u47196  \u54624  \u49688  \u51080 \u45716  \u44163 \u51060 \u4