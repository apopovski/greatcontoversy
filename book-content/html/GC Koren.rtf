\uc0\u49324 \u46988 \u46308 \u51032  \u49373 \u50528 \u50752  \u54408 \u49457 \u51060  \u50728  \u49464 \u44228 \u51032  \u51116 \u54032 \u51109 \u51060 \u49888  \u54616 \u45208 \u45784  \u50526 \u50640  \u54204 \u52432 \u51256 \u49436  \u44033  \u49324 \u46988 \u51060  \u51088 \u44592 \u51032  \u54665 \u50948 \u47484  \u46384 \u46972  \u48372 \u51025 \u51012  \u48155 \u44172  \u46112  \u44536  \u50628 \u49689 \u54616 \u44256  \u53360  \u45216 \u51032  \u44305 \u44221 \u51060  \u44536 \u50752  \u44057 \u51060  \u49440 \u51648 \u51088 \u51032  \u44228 \u49884 \u50640  \u45208 \u53440 \u45228 \u45796 . \u50715 \u51201 \u48512 \u53552  \u54637 \u49345  \u44228 \u49888  \u51060 \u45716  \u50500 \u48260 \u51648  \u54616 \u45208 \u45784 \u51060 \u49884 \u45796 . \u49884 \u54200  \u44592 \u51088 \u45716  \'93\u49328 \u51060  \u49373 \u44592 \u44592  \u51204 , \u46405 \u44284  \u49464 \u44228 \u46020  \u51452 \u44760 \u49436  \u51312 \u49457 \u54616 \u49884 \u44592  \u51204  \u44263  \u50689 \u50896 \u48512 \u53552  \u50689 \u50896 \u44620 \u51648  \u51452 \u45716  \u54616 \u45208 \u45784 \u51060 \u49884 \u45768 \u51060 \u45796 \'94 (\u49884  90:2) \u44256  \u47568 \u54620 \u45796 . \u49900 \u54032 \u51012  \u51452 \u51116 \u54616 \u49884 \u45716  \u48516 \u51008  \u47564 \u47932 \u51032  \u44540 \u50896 \u51060 \u49884 \u47728 , \u47784 \u46304  \u48277 \u52825 \u51032  \u44540 \u48376 \u51060  \u46104 \u49884 \u45716  \u54616 \u45208 \u45784 \u51060 \u49884 \u45796 . \'93\u52380 \u52380 \u47564 \u47564 \'94\u51032  \u44144 \u47337 \u54620  \u52380 \u49324 \u46308 \u51060  \u49688 \u51333 \u54616 \u45716  \u51088 \u50752  \u51613 \u51064 \u46308 \u47196 \u49436  \u44536  \u53360  \u48277 \u51221 \u50640  \u50676 \u49437 \u54616 \u44172  \u46108 \u45796 .\
\'93\uc0\u45236 \u44032 \'85\u48372 \u50520 \u45716 \u45936  \u51064 \u51088  \u44057 \u51008  \u51060 \u44032  \u54616 \u45720  \u44396 \u47492 \u51012  \u53440 \u44256  \u50752 \u49436  \u50715 \u51201 \u48512 \u53552  \u54637 \u49345  \u44228 \u49888  \u51088 \u50640 \u44172  \u45208 \u50500 \u50752  \u44536  \u50526 \u50640  \u51064 \u46020 \u46104 \u47588  \u44536 \u50640 \u44172  \u44428 \u49464 \u50752  \u50689 \u44305 \u44284  \u45208 \u46972 \u47484  \u51452 \u44256  \u47784 \u46304  \u48177 \u49457 \u44284  \u45208 \u46972 \u46308 \u44284  \u44033  \u48169 \u50616 \u54616 \u45716  \u51088 \u47196  \u44536 \u47484  \u49452 \u44592 \u44172  \u54616 \u50688 \u51004 \u45768  \u44536  \u44428 \u49464 \u45716  \u50689 \u50896 \u54620  \u44428 \u49464 \u46972  \u50734 \u44592 \u51648  \u50500 \u45768 \u54624  \u44163 \u51060 \u50836  \u44536  \u45208 \u46972 \u45716  \u54224 \u54616 \u51648  \u50500 \u45768 \u54624  \u44163 \u51060 \u45768 \u46972 \'94 (\u45800  7:13, 14). \u50668 \u44592  \u47896 \u49324 \u46108  \u44536 \u48516 \u51032  \u50724 \u49900 \u51008  \u51060  \u49464 \u49345 \u50640  \u51116 \u47548 \u54616 \u49900 \u51060  \u50500 \u45768 \u45796 . \u44536 \u48516 \u44760 \u49436 \u45716  \u51473 \u48372 \u51088 \u47196 \u49436 \u51032  \u45817 \u49888 \u51032  \u48393 \u49324 \u47484  \u47560 \u52824 \u49892  \u46412  \u45817 \u49888 \u44760  \u51452 \u50612 \u51656  \u45208 \u46972 \u50752  \u50689 \u44305 \u44284  \u44428 \u49464 \u47484  \u48155 \u51004 \u49884 \u44592  \u50948 \u54616 \u50668  \u50715 \u51201 \u48512 \u53552  \u54637 \u49345  \u44228 \u49888  \u54616 \u45208 \u45784  \u50500 \u48260 \u51648  \u50526 \u51004 \u47196  \u45208 \u50500 \u44032 \u49888 \u45796 . \u50696 \u50616  \u51473 \u50640  2300\u51452 \u50556 \u51032  \u45149 \u51060  \u46104 \u45716  1844\u45380 \u50640  \u51068 \u50612 \u45216  \u44163 \u51004 \u47196  \u48120 \u47532  \u50508 \u47140 \u51256  \u51080 \u45716  \u44163 \u46020  \u51060 \u46412 \u51032  \u50724 \u49900 \u51012  \u44032 \u47532 \u53412 \u45716  \u44163 \u51060 \u50836  \u51116 \u47548 \u51012  \u44032 \u47532 \u53412 \u45716  \u44163 \u51060  \u50500 \u45768 \u45796 . \u44536  \u46412 \u50640  \u50864 \u47532 \u51032  \u45824 \u51228 \u49324 \u51109 \u44760 \u49436 \u45716  \u54616 \u45720  \u52380 \u49324 \u46308 \u51032  \u49884 \u50948  \u50500 \u47000  \u51648 \u49457 \u49548 \u50640  \u46308 \u50612 \u44032  \u54616 \u45208 \u45784  \u50526 \u50640  \u49436 \u49436  \u51064 \u47448 \u47484  \u50948 \u54620  \u47560 \u51648 \u47561  \u48393 \u49324 \u47484  \u54616 \u49884 \u44172  \u46108 \u45796 . \u44263  \u51452 \u45784 \u44760 \u49436  \u51060 \u46412 \u50640  \u51312 \u49324  \u49900 \u54032 \u51012  \u54616 \u49884 \u44256  \u49549 \u51396 \u51032  \u51008 \u49324 \u47484  \u51077 \u51012  \u51088 \u44201 \u51060  \u51080 \u45716  \u47784 \u46304  \u49324 \u46988 \u46308 \u51012  \u50948 \u54616 \u50668  \u49549 \u51396  \u49324 \u50629 \u51012  \u54616 \u49884 \u44172  \u46108 \u45796 .\
\uc0\u49345 \u51669 \u51201  \u51032 \u49885 \u50640 \u45716  \u51396 \u47484  \u54924 \u44060 \u54616 \u44256  \u44256 \u48177 \u54632 \u51004 \u47196  \u54616 \u45208 \u45784  \u50526 \u50640  \u45208 \u50728  \u49324 \u46988 \u46308 , \u44263  \u44536 \u46308 \u51032  \u51396 \u44032  \u49549 \u51396  \u51228 \u47932 \u51032  \u54588 \u47484  \u53685 \u54616 \u50668  \u49457 \u49548 \u47196  \u50734 \u44200 \u51652  \u51088 \u46308 \u47564 \u51060  \u45824 \u49549 \u51396 \u51068 \u51032  \u48393 \u49324 \u50640  \u52280 \u50668 \u54624  \u49688  \u51080 \u50632 \u45796 . \u44536 \u50752  \u47560 \u52268 \u44032 \u51648 \u47196  \u47560 \u51648 \u47561  \u45824 \u49549 \u51396 \u50752  \u51312 \u49324  \u49900 \u54032 \u51032  \u45216 \u50640 \u45716  \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u51060 \u46972 \u44256  \u44277 \u50616 \u54616 \u45716  \u49324 \u46988 \u46308 \u51032  \u49324 \u44148 \u47564 \u51012  \u45796 \u47336 \u44172  \u46108 \u45796 . \u50501 \u51064 \u46308 \u51032  \u49900 \u54032 \u51008  \u50756 \u51204 \u55176  \u44396 \u48324 \u46104 \u50612  \u51080 \u51004 \u47728  \u44536 \u44163 \u51008  \u44536  \u54980 \u50640  \u51665 \u54665 \u46108 \u45796 . \'93\u54616 \u45208 \u45784  \u51665 \u50640 \u49436  \u49900 \u54032 \u51012  \u49884 \u51089 \u54624  \u46412 \u44032  \u46104 \u50632 \u45208 \u45768  \u47564 \u51068  \u50864 \u47532 \u50640 \u44172  \u47676 \u51200  \u54616 \u47732  \u54616 \u45208 \u45784 \u51032  \u48373 \u51020 \u51012  \u49692 \u51333 \u52824  \u50500 \u45768 \u54616 \u45716  \u51088 \u46308 \u51032  \u44536  \u47560 \u51648 \u47561 \u51060  \u50612 \u46496 \'94 (\u48295 \u51204  4:17) \u54624  \u44163 \u51064 \u44032 .\
