\uc0\u44536 \u44163 \u51008  \u54616 \u45208 \u45784 \u51032  \u50689 \u44760 \u49436  \u50669 \u49324 \u54616 \u49888  \u44208 \u44284 \u51060 \u45796 . \u44060 \u54785 \u51060  \u46384 \u47476 \u51648  \u50506 \u51004 \u47732  \u52280 \u46108  \u54924 \u44060 \u44032  \u50500 \u45768 \u45796 . \u51396 \u51064 \u51060  \u49436 \u50557 \u54620  \u44163 \u51012  \u51060 \u54665 \u54616 \u44256 , \u46020 \u46161 \u51656 \u54620  \u44163 \u51012  \u46028 \u47140 \u51452 \u44256 , \u51396 \u47484  \u44256 \u48177 \u54616 \u44256 , \u54616 \u45208 \u45784 \u44284  \u46041 \u47308  \u51064 \u44036 \u51012  \u49324 \u46993 \u54616 \u44172  \u46104 \u47732  \u44536 \u45716  \u54616 \u45208 \u45784 \u44284  \u54868 \u52828 \u54620  \u51613 \u44144 \u47484  \u48372 \u51064  \u49480 \u51060 \u45796 . \u51060 \u51204 \u50640  \u51080 \u50632 \u45912  \u51333 \u44368 \u51201  \u44033 \u49457 \u50640  \u46244 \u46384 \u46992 \u45912  \u44208 \u44284 \u46308 \u51008  \u51060 \u47084 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51060  \u47610 \u51008  \u50676 \u47588 \u47196 \u50024  \u44536 \u46308 \u51008  \u49324 \u46988 \u51012  \u44396 \u50896 \u54616 \u44256  \u51064 \u47448 \u47484  \u54693 \u49345 \u49884 \u53412 \u45716  \u51068 \u50640  \u51080 \u50612 \u49436  \u54616 \u45208 \u45784 \u51032  \u52629 \u48373 \u51012  \u48155 \u51008  \u49324 \u46988 \u46308 \u47196  \u50508 \u47140 \u51276 \u45796 .\
\uc0\u44536 \u47084 \u45208  \u44540 \u47000 \u50640  \u54665 \u54616 \u50668 \u51648 \u45716  \u49888 \u50521  \u48512 \u55141 \u51008  \u54616 \u45208 \u45784 \u51032  \u51333 \u46308 \u51032  \u54876 \u46041 \u50640  \u49688 \u48152 \u46104 \u50632 \u45912  \u54616 \u45208 \u45784 \u51032  \u51008 \u54812 \u51032  \u54364 \u54788 \u44284 \u45716  \u50500 \u51452  \u54788 \u44201 \u54620  \u45824 \u51312 \u47484  \u51060 \u47336 \u44256  \u51080 \u45796 . \u44305 \u48276 \u50948 \u54616 \u44172  \u55141 \u48120 \u44032  \u44256 \u51312 \u46104 \u44256 , \u47566 \u51008  \u49324 \u46988 \u51060  \u54924 \u49900 \u51012  \u44256 \u48177 \u54616 \u44256  \u44368 \u54924 \u50640  \u45208 \u50724 \u45716  \u49324 \u46988 \u46308 \u46020  \u47566 \u50500 \u51652  \u44163 \u51060  \u49324 \u49892 \u51060 \u45796 . \u44536 \u47084 \u45208  \u52280 \u46108  \u50689 \u51201  \u49373 \u47749 \u51060  \u44536 \u47564 \u53372  \u54693 \u49345 \u46108  \u44163 \u51012  \u48372 \u51613 \u54624  \u47564 \u54620  \u44208 \u44284 \u44032  \u45208 \u53440 \u45208 \u51648  \u50506 \u45716 \u45796 . \u51068 \u49884 \u51201 \u51004 \u47196  \u53440 \u50724 \u47476 \u45716  \u48520 \u44600 \u51008  \u50724 \u47000 \u51648  \u50506 \u50500  \u44732 \u51256  \u48260 \u47532 \u44256  \u55121 \u50516 \u51008  \u50724 \u55176 \u47140  \u51204 \u48372 \u45796  \u45908 \u50865  \u49900 \u54644 \u51652 \u45796 .\
\uc0\u51064 \u44592  \u51080 \u45716  \u49888 \u50521  \u48512 \u55141 \u51008  \u45320 \u47924 \u46020  \u55124 \u55176  \u49324 \u46988 \u51032  \u49345 \u49345 \u47141 \u50640  \u54840 \u49548 \u54616 \u44256  \u44048 \u51221 \u51012  \u51088 \u44537 \u54616 \u47728  \u49352 \u47213 \u44256  \u45440 \u46980  \u47564 \u54620  \u44163 \u50640  \u45824 \u54620  \u54840 \u44592 \u49900 \u51012  \u47564 \u51313 \u49884 \u53412 \u45716  \u48169 \u48277 \u51004 \u47196  \u51060 \u47336 \u50612 \u51652 \u45796 . \u44536 \u47088  \u49345 \u54889 \u50640 \u49436  \u54924 \u44060 \u54620  \u51088 \u46308 \u51008  \u49457 \u44221 \u51032  \u51652 \u47532 \u50640  \u48324 \u48152  \u44480 \u47484  \u44592 \u50872 \u51060 \u44256 \u51088  \u50500 \u45768 \u54616 \u44256  \u49440 \u51648 \u51088 \u50752  \u49324 \u46020 \u46308 \u51032  \u51613 \u50616 \u50640  \u48324  \u55141 \u48120 \u47484  \u45712 \u45180 \u51648  \u50500 \u45768 \u54620 \u45796 . \u51333 \u44368  \u51665 \u54924 \u50640  \u44048 \u51221 \u51012  \u51088 \u44537 \u54616 \u45716  \u50612 \u46500  \u53945 \u49457 \u51060  \u50630 \u51004 \u47732  \u44536 \u46308 \u51008  \u47588 \u47141 \u51012  \u45712 \u45180 \u51648  \u50506 \u45716 \u45796 . \u45257 \u52384 \u54620  \u51060 \u49457 \u50640  \u54840 \u49548 \u54616 \u45716  \u44592 \u48324 \u51008  \u44536 \u46308 \u50640 \u44172  \u50500 \u47924 \u47088  \u48152 \u51025 \u51012  \u51068 \u51004 \u53412 \u51648  \u47803 \u54620 \u45796 . \u44536 \u46308 \u51032  \u50689 \u50896 \u54620  \u50976 \u51061 \u44284  \u51649 \u51217  \u44288 \u47144 \u46104 \u45716  \u48516 \u47749 \u54620  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51032  \u44221 \u44256 \u50640 \u46020  \u44536 \u46308 \u51008  \u50976 \u51032 \u54616 \u51648  \u50506 \u45716 \u45796 .\
