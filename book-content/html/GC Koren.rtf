\uc0\u44536 \u45716  \u51060 \u44057 \u51008  \u49345 \u53468 \u50640 \u49436  \u47751  \u45804 \u51012  \u51648 \u45256 \u45796 . \u44536 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u54616 \u50688 \u45796 . \'93\u44049 \u51088 \u44592  \u54620  \u44396 \u51452 \u51032  \u54408 \u49457 \u51060  \u45236  \u47560 \u51020 \u50640  \u49373 \u49373 \u54620  \u44048 \u47749 \u51012  \u51452 \u50632 \u45796 . \u50864 \u47532 \u51032  \u51396 \u47484  \u49549 \u54616 \u44256  \u50864 \u47532 \u44032  \u48155 \u51012  \u51396 \u51032  \u54805 \u48268 \u50640 \u49436  \u50864 \u47532 \u47484  \u44396 \u50896 \u54624  \u51064 \u51088 \u54616 \u44256  \u46041 \u51221 \u51060  \u47566 \u51008  \u44396 \u51452 \u44760 \u49436  \u44228 \u49892  \u44163 \u52376 \u47100  \u49373 \u44033 \u46104 \u50632 \u45796 . \u45208 \u45716  \u51593 \u49884  \u44536 \u48516 \u51060  \u50620 \u47560 \u45208  \u45796 \u51221 \u54620  \u48516 \u51060 \u49892 \u44620  \u54616 \u44256  \u49373 \u44033 \u54644  \u48372 \u50520 \u45796 . \u44536 \u47084 \u45208  \u44536  \u46412 \u50640  \u45208 \u50640 \u44172 \u45716  \u44536 \u47084 \u54620  \u48516 \u51060  \u44228 \u49884 \u45796 \u45716  \u44163 \u51012  \u50612 \u46523 \u44172  \u51613 \u47749 \u54624  \u49688  \u51080 \u51012 \u44620  \u54616 \u45716  \u51032 \u47928 \u51060  \u49373 \u44220 \u45796 . \u45208 \u45716  \u49457 \u44221 \u51012  \u51228 \u50808 \u54616 \u44256 \u45716  \u44536 \u47084 \u54620  \u44396 \u51452 \u44760 \u49436  \u44228 \u49884 \u45796 \u45716  \u44163 \u44284  \u45236 \u49464 \u50640  \u45824 \u54616 \u50668  \u51613 \u47749 \u54624  \u49688  \u51080 \u45716  \u44600 \u51060  \u50630 \u45796 \u45716  \u44163 \u51012  \u44648 \u45804 \u50520 \u45796 . \'85\
\uc0\u45208 \u45716  \u49457 \u44221 \u51060  \u45236 \u44172  \u54596 \u50836 \u54620  \u48148 \u47196  \u44536 \u47088  \u44396 \u51452 \u47484  \u48372 \u50668  \u51452 \u44256  \u51080 \u45796 \u45716  \u49324 \u49892 \u51012  \u50508 \u44172  \u46104 \u50632 \u45796 . \u45208 \u45716  \u53440 \u46973 \u54620  \u49464 \u44228 \u51032  \u50836 \u44396 \u47484  \u51060 \u52376 \u47100  \u50756 \u51204 \u54616 \u44172  \u52292 \u50892  \u51452 \u45716  \u50896 \u52825 \u46308 \u51012  \u51228 \u49884 \u54616 \u45716  \u52293 \u51060  \u50689 \u44048  (\u38728 \u24863 ) \u48155 \u51648  \u50506 \u51008  \u52293 \u51060 \u46972 \u44256  \u49373 \u44033 \u54624  \u49688  \u50630 \u50632 \u45796 . \u45208 \u45716  \u49457 \u44221 \u51060  \u54616 \u45208 \u45784 \u44760 \u47196 \u48512 \u53552  \u50728  \u44228 \u49884 \u46972 \u45716  \u44163 \u51012  \u49884 \u51064 \u54624  \u49688 \u48150 \u50640  \u50630 \u50632 \u45796 . \u49457 \u44221 \u51008  \u45236 \u44172  \u51600 \u44144 \u50880 \u51060  \u46104 \u50632 \u44256 , \u45208 \u45716  \u50696 \u49688 \u45784  \u50504 \u50640 \u49436  \u54620  \u52828 \u44396 \u47484  \u48156 \u44204 \u54616 \u50688 \u45796 . \u44396 \u51452 \u44760 \u49436 \u45716  \u45208 \u50640 \u44172  \u51080 \u50612 \u49436  \'93\u47564  \u49324 \u46988 \u50640  \u46832 \u50612 \u45212 \'94 (\u50500  5:10) \u48516 \u51060  \u46104 \u49512 \u44256 , \u51204 \u50640 \u45716  \u50516 \u55121 \u44284  \u47784 \u49692 \u53804 \u49457 \u51060 \u50688 \u45912  \u49457 \u44221 \u51060  \u51060 \u51228 \u45716  \u45236  \u48156 \u50640  \u46321 \u51060 \u50836 , \u45236  \u44600 \u50640  \u48731 \u51060  \u46104 \u50632 \u45796 . \u45208 \u51032  \u47560 \u51020 \u51008  \u50504 \u51221 \u46104 \u44256  \u47564 \u51313 \u54644 \u51276 \u45796 . \u45208 \u45716  \u50668 \u54840 \u50752  \u54616 \u45208 \u45784 \u44760 \u49436  \u51064 \u49373 \u51060 \u46972 \u45716  \u45824 \u50577 \u50640 \u49436  \u48152 \u49437 \u51060  \u46104 \u49888 \u45796 \u45716  \u44163 \u51012  \u48156 \u44204 \u54616 \u50688 \u45796 . \u51060 \u51228  \u49457 \u44221 \u51008  \u45236 \u44172  \u51473 \u50836 \u54620  \u50672 \u44396  \u45824 \u49345 \u51060  \u46104 \u50632 \u45796 . \u44536 \u47084 \u48064 \u47196  \u45208 \u45716  \u47588 \u50864  \u53360  \u44592 \u49256 \u51004 \u47196  \u44536 \u44163 \u51012  \u53456 \u44396 \u54616 \u50688 \u45432 \u46972 \u44256  \u51652 \u49900 \u51004 \u47196  \u47568 \u54624  \u49688  \u51080 \u45796 . \u44536 \u47532 \u54616 \u50668  \u45236 \u44032  \u51204 \u50640  \u46308 \u51008  \u44163 \u51008  \u44536  \u51208 \u48152 \u46020  \u47803  \u46108 \u45796 \u45716  \u44163 \u51012  \u44648 \u45804 \u50520 \u45796 . \u45208 \u45716  \u50612 \u52236 \u54616 \u50668  \u51060 \u51204 \u50640  \u49457 \u44221 \u51032  \u50500 \u47492 \u45796 \u50880 \u44284  \u50689 \u44305 \u51012  \u50508 \u51648  \u47803 \u54616 \u50688 \u45716 \u51648  \u51032 \u50500 \u54616 \u44172  \u49373 \u44033 \u46104 \u50632 \u44256 , \u45236 \u44032  \u50612 \u52236 \u54616 \u50668  \u51204 \u50640  \u44536 \u44163 \u51012  \u44144 \u51208 \u54616 \u50688 \u45716 \u51648  \u51060 \u49345 \u55176  \u50668 \u44592 \u44172  \u46104 \u50632 \u45796 . \u45208 \u45716  \u44536 \u44163 \u51060  \u45208 \u51032  \u47560 \u51020 \u50640  \u47784 \u46304  \u49548 \u50896 \u51012  \u52292 \u50892  \u51452 \u44256  \u47560 \u51020 \u51032  \u47784 \u46304  \u48337 \u51012  \u44256 \u52432  \u51452 \u45716  \u44163 \u51012  \u44648 \u45803 \u44172  \u46104 \u50632 \u45796 . \u45208 \u45716  \u47784 \u46304  \u45796 \u47480  \u52293 \u50640  \u45824 \u54620  \u55141 \u48120 \u47484  \u51075 \u50612 \u48260 \u47532 \u44256 , \u50724 \u51649  \u54616 \u45208 \u45784 \u44760 \u47196 \u48512 \u53552  \u51648 \u54812 \u47484  \u50619 \u44256 \u51088  \u45208 \u51032  \u50728  \u47560 \u51020 \u51012  \u50143 \u50520 \u45796 \'94 (S.Bliss, Memoirs of Wm.Miller, pp.65~67).\
\uc0\u48128 \u47084 \u45716  \u51648 \u44552 \u44620 \u51648  \u44536 \u44032  \u44221 \u47736 \u54616 \u44172  \u50668 \u44200 \u50728  \u51333 \u44368 \u50640  \u45824 \u54620  \u49888 \u50521 \u51012  \u50668 \u47084  \u49324 \u46988  \u50526 \u50640  \u44256 \u48177 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u51032  \u48127 \u51648  \u50506 \u45716  \u52828 \u44396 \u46308 \u51008  \u44536 \u44032  \u51060 \u51204 \u50640  \u51088 \u51452  \u49457 \u44221 \u51032  \u44428 \u50948 \u50640  \u45824 \u54616 \u50668  \u55192  \u51080 \u44172  \u48152 \u45824 \u54616 \u50668  \u50728  \u48148 \u47196  \u44536  \u47784 \u46304  \u45436 \u51613 \u46308 \u51012  \u51648 \u52404  \u50630 \u51060  \u51228 \u49884 \u54616 \u50688 \u45796 . \u44536  \u46412 \u50640  \u44536 \u45716  \u44536  \u49324 \u46988 \u46308 \u50640 \u44172  \u45824 \u45813 \u54624  \u49688 \u44032  \u50630 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u49457 \u44221 \u51060  \u54616 \u45208 \u45784 \u51032  \u44228 \u49884 \u51068  \u44163  \u44057 \u51004 \u47732  \u48152 \u46300 \u49884  \u44536  \u51088 \u52404 \u50640  \u47784 \u49692 \u51060  \u50630 \u50612 \u50556  \u54616 \u44256 , \u44536 \u44163 \u51060  \u51064 \u47448 \u51032  \u44368 \u54984 \u51004 \u47196  \u51452 \u50612 \u51276 \u45796 \u47732  \u49324 \u46988 \u51060  \u51060 \u54644 \u54624  \u49688  \u51080 \u50612 \u50556  \u54624  \u44163 \u51060 \u46972 \u44256  \u49373 \u44033 \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u45716  \u51088 \u49888 \u51012  \u50948 \u54616 \u50668  \u49457 \u44221 \u51012  \u50672 \u44396 \u54616 \u46104 , \u47784 \u49692 \u46108  \u44163 \u52376 \u47100  \u48372 \u51060 \u45716  \u51216 \u46308 \u51060  \u51312 \u54868 \u47484  \u51060 \u47344  \u49688 \u45716  \u50630 \u45716 \u51648  \u50672 \u44396 \u54644  \u48372 \u44592 \u47196  \u44208 \u49900 \u54616 \u50688 \u45796 .\
\uc0\u44536 \u45716  \u47784 \u46304  \u49440 \u51077 \u44204  (\u20808 \u20837 \u35211 ) \u51012  \u48260 \u47532 \u44256 \u51088  \u55192 \u50416 \u45716  \u54620 \u54200 , \u49457 \u44221 \u51032  \u51452 \u49437 \u46308 \u51012  \u52280 \u44256 \u54616 \u51648  \u50506 \u44256 , \u44288 \u51452 \u50752  \u49457 \u44396  \u49324 \u51204  (\u32854 \u21477 \u36781 \u20856 ) \u51012  \u51060 \u50857 \u54616 \u50668  \u49457 \u44221 \u51032  \u44396 \u51208 \u44284  \u44396 \u51208 \u51012  \u48708 \u44368 \u54632 \u51004 \u47196  \u50672 \u44396 \u54616 \u50688 \u45796 . \u44536 \u45716  \u44536  \u50672 \u44396 \u47484  \u44537 \u55176  \u44508 \u52825 \u51201 \u51004 \u47196 , \u51312 \u51649 \u51201 \u51004 \u47196  \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u45716  \u52285 \u49464 \u44592 \u50640 \u49436  \u49884 \u51089 \u54616 \u50668  \u49457 \u44221  \u44396 \u51208  \u54620  \u51208  \u54620  \u51208 \u51012  \u51069 \u50612 \u44032 \u47732 \u49436  \u44536  \u51032 \u48120 \u44032  \u48516 \u47749 \u55176  \u51060 \u54644 \u46104 \u44592  \u51204 \u50640 \u45716  \u50526 \u51004 \u47196  \u45208 \u50500 \u44032 \u51648  \u50506 \u50520 \u45796 . \u44536 \u45716  \u48324 \u47196  \u47784 \u49692 \u51060 \u45208  \u51032 \u47928 \u51060  \u50630 \u51060  \u51060 \u54644 \u54624  \u49688  \u51080 \u44256  \u44144 \u44592  \u44288 \u47144 \u46104 \u45716  \u45796 \u47480  \u49457 \u44221  \u44396 \u51208 \u51012  \u48708 \u44368 \u54616 \u50668  \u51088 \u44592 \u51032  \u44204 \u54644 \u50752  \u51068 \u52824 \u46104 \u45716  \u46412 \u50640 \u45716  \u45796 \u51020  \u49457 \u44221  \u44396 \u51208 \u47196  \u45336 \u50612 \u44052 \u51648 \u47564  \u47564 \u51068  \u48516 \u47749 \u54616 \u51648  \u47803 \u54620  \u51216 \u51012  \u48156 \u44204 \u54624  \u46412 \u50640 \u45716  \u50616 \u51228 \u46304 \u51648  \u44536  \u47928 \u51228 \u50640  \u44288 \u54620  \u45796 \u47480  \u47784 \u46304  \u49457 \u44221  \u44396 \u51208 \u51012  \u45824 \u51312  \u50672 \u44396 \u54616 \u50688 \u45796 . \u44536 \u47111 \u44172  \u54632 \u51004 \u47196  \u50612 \u47157 \u44172  \u48372 \u51060 \u45912  \u44163 \u51060  \u50630 \u50612 \u51256  \u44052 \u45796 . \u44536 \u45716  \u51060 \u54644 \u54616 \u44592  \u50612 \u47140 \u50868  \u44396 \u51208 \u51012  \u47564 \u45208 \u47732  \u45796 \u47480  \u49457 \u44221  \u44396 \u51208 \u50640 \u49436  \u44536  \u54644 \u49437 \u51012  \u52286 \u50500  \u48156 \u44204 \u54616 \u50688 \u45796 . \u44536 \u44032  \u54616 \u45208 \u45784 \u51032  \u44648 \u50864 \u52432  \u51452 \u49900 \u51012  \u50948 \u54616 \u50668  \u50676 \u47148 \u55176  \u44592 \u46020 \u54616 \u47732 \u49436  \u50672 \u44396 \u54624  \u46412 , \u51060 \u51204 \u50640  \u51060 \u54644 \u54624  \u49688  \u50630 \u51004 \u47532 \u47564 \u53372  \u50612 \u46177 \u44172  \u48372 \u51060 \u45912  \u44163 \u46308 \u51060  \u48516 \u47749 \u54644 \u51276 \u45796 . \u44536 \u46412 \u50640  \u44536 \u45716  \'93\u51452 \u51032  \u47568 \u50432 \u51012  \u50676 \u48064 \u47196  \u50864 \u46164 \u54620  \u51088 \u50640 \u44172  \u48708 \u52712 \u50612  \u44648 \u45803 \u44172  \u54616 \u45208 \u51060 \u45796 \'94 (\u49884  119:130) \u44256  \u54620  \u49884 \u51064 \u51032  \u47568 \u51012  \u44648 \u45803 \u44172  \u46104 \u50632 \u45796 .\
