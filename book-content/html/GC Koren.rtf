\uc0\u47336 \u53552 \u44032  \u44403 \u44172  \u44256 \u49688 \u54644  \u50728  \u50896 \u52825 \u46308  \u51473 \u51032  \u54616 \u45208 \u45716  \u44060 \u54785  \u49324 \u50629 \u51012  \u50976 \u51648 \u54616 \u44592  \u50948 \u54616 \u50668  \u49464 \u49549 \u51201  \u44428 \u47141 \u50640  \u54840 \u49548 \u54616 \u44144 \u45208  \u44536  \u49324 \u50629 \u51012  \u50745 \u54840 \u54616 \u44592  \u50948 \u54616 \u50668  \u47924 \u47141 \u50640  \u54840 \u49548 \u54616 \u45716  \u51068 \u51060  \u51080 \u50612 \u49436 \u45716  \u50504  \u46108 \u45796 \u45716  \u44163 \u51060 \u50632 \u45796 . \u44536 \u45716  \u44397 \u45236 \u51032  \u44480 \u51313 \u46308 \u51060  \u48373 \u51020 \u50640  \u45824 \u54620  \u49888 \u50521 \u51012  \u44256 \u48177 \u54620  \u44163 \u51012  \u44592 \u48848 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u46308 \u51060  \u48373 \u51020  \u50745 \u54840  \u50672 \u47609 \u44284  \u44057 \u51008  \u44163 \u51012  \u51312 \u51649 \u54616 \u44256 \u51088  \u51228 \u50504 \u54616 \u51088  \u44536 \u45716  \u48516 \u47749 \u55176  \u47568 \u54616 \u50688 \u45796 . \'93\u48373 \u51020 \u51032  \u44368 \u47532 \u45716  \u54616 \u45208 \u45784  \u54620  \u48516 \u51012  \u53685 \u54616 \u50668 \u49436 \u47564  \u50745 \u54840 \u46104 \u50612 \u50556  \u54620 \u45796 . \'85\u49324 \u46988 \u46308 \u51060  \u44144 \u47337 \u54620  \u49324 \u50629 \u50640  \u51201 \u44172  \u44036 \u49453 \u54616 \u47732  \u54624 \u49688 \u47197  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u45908 \u50865  \u47566 \u51060  \u44536  \u49324 \u50629 \u50640  \u44288 \u50668 \u54616 \u49884 \u45716  \u44163 \u51060 \u45796 . \u50612 \u46496 \u54620  \u51221 \u52293 \u51201 \u51064  \u47896 \u50504 \u51012  \u49324 \u50857 \u54624 \u51648 \u46972 \u46020  \u44536 \u44163 \u51008  \u50424 \u45936 \u50630 \u45716  \u44277 \u54252 \u50752  \u51396 \u50501 \u51201  \u48520 \u49888 \u51012  \u51312 \u51109 \u54624  \u49104 \u51060 \u45796 \'94 (D\'92Aubigne, b.10, ch.14).\
\uc0\u44053 \u47141 \u54620  \u50896 \u49688 \u46308 \u51060  \u50728  \u55192 \u51012  \u54633 \u54616 \u50668  \u44060 \u54785 \u54028 \u51032  \u49888 \u50521 \u51012  \u46244 \u51665 \u50612 \u50638 \u51004 \u47140  \u54616 \u44256 , \u47924 \u49688 \u54620  \u52860 \u51060  \u52860 \u51665 \u50640 \u49436  \u48977 \u54784 \u51648 \u47140  \u54624  \u46412 \u50640  \u47336 \u53552 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u44592 \u47197 \u54616 \u50688 \u45796 . \'93\u49324 \u45800 \u51008  \u48516 \u45432 \u47484  \u45208 \u53440 \u45236 \u44256  \u51080 \u45796 . \u44221 \u44148 \u52824  \u50506 \u51008  \u49849 \u47140 \u46308 \u51008  \u44277 \u47784 \u54616 \u44256  \u51080 \u51004 \u47728 , \u50864 \u47532 \u45716  \u51204 \u51137 \u51032  \u50948 \u54801 \u51012  \u45817 \u54616 \u44256  \u51080 \u45796 . \u44536 \u47084 \u45208  \u50864 \u47532 \u45716  \u48127 \u51020 \u44284  \u44592 \u46020 \u47196 \u50024  \u45812 \u45824 \u55176  \u54616 \u45208 \u45784 \u51032  \u48372 \u51340  \u50526 \u51004 \u47196  \u45208 \u50500 \u44032 \u46972 \u44256  \u49324 \u46988 \u46308 \u51012  \u44428 \u54624  \u44163 \u51060 \u45796 . \u44536 \u47532 \u54616 \u47732  \u50896 \u49688 \u46308 \u51008  \u54616 \u45208 \u45784 \u51032  \u49457 \u47161 \u51004 \u47196  \u47568 \u48120 \u50516 \u50500  \u51221 \u48373 \u46104 \u50612  \u51104 \u51104 \u54616 \u44172  \u46112  \u44163 \u51060 \u45796 . \u50864 \u47532 \u50640 \u44172  \u44032 \u51109  \u54596 \u50836 \u54616 \u44256  \u44553 \u54620  \u44163 \u51008  \u44592 \u46020 \u51060 \u45796 . \u49324 \u46988 \u46308 \u47196  \u54616 \u50668 \u44552  \u44536 \u46308 \u51060  \u51648 \u44552  \u49324 \u45800 \u51032  \u52860 \u45216  \u50500 \u47000  \u51080 \u45796 \u45716  \u44163 \u44284  \u49324 \u45800 \u51060  \u48516 \u45432 \u54616 \u44256  \u51080 \u45796 \u45716  \u44163 \u51012  \u50508 \u47140  \u51452 \u44256  \u44592 \u46020 \u54616 \u44172  \u54624  \u44163 \u51060 \u45796 \'94 (D\'92Aubigne, b.10, ch.14).\
\uc0\u44536  \u54980 \u50640  \u44060 \u54785 \u54028 \u51032  \u49440 \u54980 \u46308 \u51060  \u50672 \u47609 \u51012  \u51312 \u51649 \u54616 \u47140  \u54616 \u50688 \u51012  \u46412 \u50640  \u45796 \u49884  \u47336 \u53552 \u45716  \u51060  \u49912 \u50880 \u50640  \u49324 \u50857 \u46104 \u50612 \u50556  \u54624  \u47924 \u44592 \u45716  \u50724 \u51649  \'93\u49457 \u47161 \u51032  \u44160 \'94\u49104 \u51060 \u46972 \u44256  \u48157 \u55176  \u47568 \u54616 \u50688 \u45796 . \u44536 \u45716  \u51089 \u49468 \u51032  \u49440 \u54980 \u50640 \u44172  \u54200 \u51648 \u54616 \u50688 \u45796 . \'93\u50864 \u47532 \u45716  \u50577 \u49900 \u49345 \u51004 \u47196  \u50672 \u47609 \u50640  \u45824 \u54620  \u51228 \u50504 \u50640  \u52268 \u46041 \u54624  \u49688  \u50630 \u49845 \u45768 \u45796 . \u50864 \u47532 \u51032  \u48373 \u51020  \u46412 \u47928 \u50640  \u54620  \u48169 \u50872 \u51032  \u54588 \u46972 \u46020  \u55128 \u47140 \u50556  \u54616 \u45716  \u51068 \u51012  \u48372 \u44592 \u48372 \u45796 \u45716  \u52264 \u46972 \u47532  \u50676  \u48264 \u51060 \u46972 \u46020  \u51453 \u45716  \u44163 \u51060  \u45227 \u44192 \u49845 \u45768 \u45796 . \u50864 \u47532 \u44032  \u45812 \u45817 \u54644 \u50556  \u54624  \u51068 \u51008  \u49324 \u51648 \u47196  \u45132 \u47140 \u44032 \u45716  \u50612 \u47536 \u50577 \u44284  \u44057 \u50500 \u50556  \u54633 \u45768 \u45796 . \u44536 \u47532 \u49828 \u46020 \u51032  \u49901 \u51088 \u44032 \u47484  \u51256 \u50556  \u54633 \u45768 \u45796 . \u49440 \u54980  \u51204 \u54616 \u50668 , \u46160 \u47140 \u50892 \u54616 \u51648  \u47560 \u49901 \u49884 \u50724 . \u50864 \u47532 \u45716  \u50864 \u47532 \u51032  \u44592 \u46020 \u47196 \u50024 , \u50864 \u47532 \u51032  \u50896 \u49688 \u46308 \u51060  \u51088 \u46993 \u54616 \u45716  \u44163 \u48372 \u45796  \u45908 \u50865  \u53360 \u51068 \u51012  \u54624  \u44163 \u51077 \u45768 \u45796 . \u50864 \u47532  \u54805 \u51228 \u46308 \u51032  \u54588 \u47196 \u50024  \u51204 \u54616 \u51032  \u49552 \u51012  \u45908 \u47101 \u55176 \u51648  \u47560 \u49901 \u49884 \u50724 . \u47564 \u51068  \u54889 \u51228 \u44760 \u49436  \u50864 \u47532 \u47484  \u44536 \u51032  \u48277 \u51221 \u50640  \u45336 \u44200 \u51452 \u46020 \u47197  \u50836 \u44396 \u54616 \u49888 \u45796 \u47732  \u50864 \u47532 \u45716  \u52636 \u46160 \u54624  \u51456 \u48708 \u44032  \u46104 \u50612  \u51080 \u49845 \u45768 \u45796 . \u51204 \u54616 \u44032  \u50864 \u47532 \u51032  \u48127 \u51020 \u51012  \u51648 \u53020  \u51460  \u49688 \u45716  \u50630 \u49845 \u45768 \u45796 . \u45572 \u44396 \u46304 \u51648  \u50948 \u44592 \u47484  \u45817 \u54616 \u47732  \u51088 \u44592 \u51032  \u48127 \u51020 \u51008  \u51088 \u44592 \u44032  \u51648 \u53020 \u50556  \u54616 \u45716  \u44163 \u51077 \u45768 \u45796 \'94 (D\'92Aubigne, b.14, ch.1).\
