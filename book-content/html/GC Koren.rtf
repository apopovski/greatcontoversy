\uc0\u48288 \u46300 \u47196 \u45716  \'93\u50689 \u54844 \u51012  \u44144 \u49828 \u47140  \u49912 \u50864 \u45716  \u50977 \u52404 \u51032  \u51221 \u50837 \u51012  \u51228 \u50612 \u54616 \u46972 \'94 (\u48295 \u51204  2:11) \u44256  \u47568 \u54620 \u45796 . \u51396 \u50501 \u51201 \u51064  \u44040 \u47581 \u51012  \u47564 \u51313 \u49884 \u53420  \u46412 \u47560 \u45796  \u49888 \u52404 \u51032  \u44592 \u45733 \u51060  \u47560 \u48708 \u46104 \u44256  \u50689 \u51201 \'b7\u51648 \u51201  \u44048 \u44033 \u47141 \u51060  \u51453 \u44256  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432  \u54841 \u51008  \u49457 \u47161 \u51032  \u44048 \u54868 \u45716  \u47560 \u51020 \u50640  \u48712 \u50557 \u54620  \u51064 \u49345 \u51012  \u45180 \u52832  \u49688 \u48150 \u50640  \u50630 \u44172  \u46108 \u45796 . \u48148 \u50872 \u51008  \u44256 \u47536 \u46020  \u49324 \u46988 \u46308 \u50640 \u44172  \'93\u50864 \u47532 \u44032  \u54616 \u45208 \u45784 \u51012  \u46160 \u47140 \u50892 \u54616 \u45716  \u44032 \u50868 \u45936  \u44144 \u47337 \u54632 \u51012  \u50728 \u51204 \u55176  \u51060 \u47336 \u50612  \u50977 \u44284  \u50689 \u51032  \u50728 \u44054  \u45908 \u47084 \u50868  \u44163 \u50640 \u49436  \u51088 \u49888 \u51012  \u44648 \u45143 \u52992  \u54616 \u51088 \'94 (\u44256 \u54980  7:1) \u44256  \u47568 \u54664 \u45796 . \u44536 \u45716  \u46608 \u54620  \'93\u49324 \u46993 \u44284  \u55148 \u46973 \u44284  \u54868 \u54217 \u44284  \u50724 \u47000  \u52280 \u51020 \u44284  \u51088 \u48708 \u50752  \u50577 \u49440 \u44284  \u52649 \u49457 \u44284  \u50728 \u50976 \'94 (\u44040  5:22, 23) \u50752  \u44057 \u51008  \u49457 \u47161 \u51032  \u50676 \u47588 \u50640  \'93\u51208 \u51228 \'94\u47484  \u48512 \u44032 \u49884 \u53040 \u45796 .\
\uc0\u50689 \u44048 \u51004 \u47196  \u46108  \u51060 \u47088  \u47568 \u50432 \u46308 \u51060  \u51080 \u51020 \u50640 \u46020  \u48520 \u44396 \u54616 \u44256  \u44536 \u47532 \u49828 \u46020 \u51064 \u51060 \u46972 \u44256  \u44277 \u50616 \u54616 \u45716  \u52280 \u51004 \u47196  \u47566 \u51008  \u49324 \u46988 \u46308 \u51060  \u44536 \u46308 \u51032  \u51060 \u51061 \u51012  \u52628 \u44396 \u54616 \u44256  \u50976 \u54665 \u51012  \u46384 \u47476 \u44592 \u50640  \u44553 \u44553 \u54620  \u45208 \u47672 \u51648  \u44536 \u46308 \u51032  \u45733 \u47141 \u51012  \u50557 \u54868 \u49884 \u53412 \u44256  \u51080 \u45796 . \u46608 \u54620  \u52280 \u51004 \u47196  \u47566 \u51008  \u49324 \u46988 \u46308 \u51060  \u53456 \u49885 \u44284  \u51020 \u51452 \u50752  \u44552 \u51648 \u46108  \u53132 \u46973 \u51012  \u53685 \u54616 \u50668  \u44536 \u46308 \u51032  \u44256 \u49345 \u54620  \u51064 \u44036 \u49457 \u51012  \u53440 \u46973 \u49884 \u53412 \u44256  \u51080 \u45796 . \u44536 \u47532 \u44256  \u44368 \u54924 \u45716  \u51060 \u47484  \u44204 \u52293 \u54616 \u45716  \u45824 \u49888 \u50640  \u50724 \u55176 \u47140  \u49885 \u50837 \u51012  \u46027 \u50864 \u50612  \u51452 \u44256  \u47932 \u50837 \u44284  \u50672 \u46973 \u51012  \u49324 \u46993 \u54616 \u45716  \u47560 \u51020 \u51012  \u51068 \u51004 \u53020  \u51452 \u44256  \u44536 \u47532 \u49828 \u46020 \u47484  \u49324 \u46993 \u54616 \u45716  \u47560 \u51020 \u47564 \u51004 \u47196  \u44277 \u44553 \u54624  \u49688  \u50630 \u45716  \u44368 \u54924 \u51032  \u51088 \u44552 \u51012  \u48372 \u52649 \u54616 \u44592  \u50948 \u54616 \u50668  \u45320 \u47924 \u46020  \u55124 \u55176  \u50501 \u51012  \u44428 \u51109 \u54620 \u45796 . \u47564 \u51068  \u50696 \u49688 \u45784 \u44760 \u49436  \u50724 \u45720 \u45216 \u51032  \u44368 \u54924 \u50640  \u50724 \u49492 \u49436  \u51333 \u44368 \u46972 \u45716  \u48120 \u47749  \u50500 \u47000  \u54665 \u54644 \u51648 \u44256  \u51080 \u45716  \u50672 \u54924 \u50752  \u48512 \u51221 \u54620  \u44144 \u47000 \u46308 \u51012  \u48372 \u49888 \u45796 \u47732  \u44536 \u48516 \u44760 \u49436 \u45716  \u51068 \u52237 \u51060  \u49457 \u51204 \u50640 \u49436  \u46024  \u48148 \u44984 \u45716  \u51088 \u46308 \u51012  \u45236 \u51923 \u51004 \u49888  \u44163 \u44284  \u44057 \u51060  \u54616 \u45208 \u45784 \u51012  \u47784 \u46021 \u54616 \u45716  \u51060 \u47088  \u51088 \u46308 \u51012  \u45236 \u51923 \u51648  \u50500 \u45768 \u54616 \u49884 \u44192 \u45716 \u44032 ?\
\uc0\u49324 \u46020  \u50556 \u44256 \u48372 \u45716  \u50948 \u47196 \u48512 \u53552  \u50724 \u45716  \u51648 \u54812 \u45716  \'93\u52395 \u51704  \u49457 \u44208 \'94\u54616 \u45796 \u44256  \u47568 \u54620 \u45796 . \u47564 \u51068  \u44536 \u48516 \u44760 \u49436  \u45812 \u48176 \u47196  \u45908 \u47084 \u50892 \u51652  \u51077 \u49696 \u47196 \u50024  \u50696 \u49688 \u45784 \u51032  \u44480 \u54616 \u49888  \u51060 \u47492 \u51012  \u48512 \u47476 \u45716  \u51088 , \u45812 \u48176 \u51032  \u50501 \u52712 \u47196  \u44536  \u51077 \u44608 \u44284  \u51204 \u49888 \u51060  \u45908 \u47084 \u50892 \u51256  \u51080 \u45716  \u51088 , \u54616 \u45720 \u51032  \u44277 \u44592 \u47484  \u45908 \u47101 \u55176 \u44256  \u44536 \u50752  \u51217 \u52489 \u54616 \u45716  \u47784 \u46304  \u49324 \u46988 \u46308 \u50640 \u44172  \u44536  \u46021 \u44592 \u47484  \u47560 \u49884 \u44172  \u54616 \u45716  \u51088 \u46308 \u51012  \u47564 \u45208 \u49888 \u45796 \u47732 , \u44263  \u48373 \u51020 \u51032  \u49692 \u44208 \u49457 \u44284  \u51204 \u50672  \u48152 \u45824 \u46104 \u45716  \u54665 \u50948 \u47484  \u54616 \u45716  \u51088 \u46308 \u44284  \u47564 \u45208 \u49888 \u45796 \u47732 , \u44536 \u46308 \u51012  \'93\u49464 \u49345 \u51201 \u51060 \u50836  \u51221 \u50837 \u51201 \u51060 \u50836  \u47560 \u44480 \u51201 \u51060 \u46972 \'94\u44256  \u44204 \u52293 \u54616 \u51648  \u50500 \u45768 \u54616 \u49884 \u44192 \u45716 \u44032 ? \u45812 \u48176 \u51032  \u51333 \u51060  \u46104 \u50612  \u51080 \u51004 \u47732 \u49436 \u46020  \u50756 \u51204 \u54620  \u49457 \u54868 \u51032  \u52629 \u48373 \u51012  \u48155 \u50520 \u45432 \u46972 \u44256  \u51452 \u51109 \u54616 \u47728  \u54616 \u45720 \u51032  \u49548 \u47581 \u51012  \u44032 \u51276 \u45432 \u46972 \u44256  \u47568 \u54620 \u45796 . \u44536 \u47084 \u45208  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51008  \u48516 \u47749 \u55176  \'93\u47924 \u50631 \u51060 \u46304 \u51648  \u49549 \u46108  