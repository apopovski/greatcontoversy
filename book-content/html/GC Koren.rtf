\uc0\u48372 \u51060 \u45716  \u49464 \u44228 \u50752  \u48372 \u51060 \u51648  \u50506 \u45716  \u49464 \u44228 \u50752 \u51032  \u44288 \u44228 , \u54616 \u45208 \u45784 \u51032  \u52380 \u49324 \u46308 \u51032  \u48393 \u49324 , \u50501 \u47161  \u54876 \u46041 \u51008  \u49457 \u44221 \u50640  \u48516 \u47749 \u55176  \u44592 \u47197 \u46104 \u50612  \u51080 \u51004 \u47728  \u51064 \u47448  \u50669 \u49324 \u50752  \u48520 \u44032 \u48516 \u51032  \u44288 \u44228 \u47484  \u44032 \u51648 \u44256  \u51080 \u45796 . \u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u50501 \u47161 \u51032  \u51316 \u51116 \u47484  \u48127 \u51648  \u50506 \u45716  \u44221 \u54693 \u51060  \u51080 \u51012  \u49104  \u50500 \u45768 \u46972  \'93\u44396 \u50896  \u50619 \u51012  \u54980 \u49324 \u46308 \u51012  \u50948 \u54616 \u50668  \u49452 \u44592 \u46972 \u44256  \u48372 \u45236 \u49900 \'94 (\u55176  1:14) \u51012  \u51077 \u51008  \u52380 \u49324 \u46308 \u51012  \u51453 \u51008  \u51088 \u51032  \u50689 \u51004 \u47196  \u49373 \u44033 \u54620 \u45796 . \u44536 \u47084 \u45208  \u49457 \u44221 \u51008  \u49440 \u54620  \u52380 \u49324 \u50752  \u50501 \u54620  \u52380 \u49324 \u46308 \u51060  \u50977 \u52404 \u47484  \u46496 \u45212  \u51453 \u51008  \u51088 \u51032  \u50689 \u51060  \u50500 \u45784 \u51012  \u48516 \u47749 \u55176  \u51613 \u47749 \u54644  \u51456 \u45796 .\
\uc0\u52380 \u49324 \u46308 \u51008  \u51064 \u47448 \u44032  \u52285 \u51312 \u46104 \u44592  \u51204 \u50640  \u48268 \u50024  \u51080 \u50632 \u45796 . \u46405 \u51032  \u44592 \u52488 \u44032  \u45459 \u51068  \u46412  \'93\u49352 \u48317 \u48324 \u46308 \u51060  \u54632 \u44760  \u45432 \u47000 \u54616 \u47728  \u54616 \u45208 \u45784 \u51032  \u50500 \u46308 \u46308 \u51060  \u45796  \u44592 \u49240 \u44172  \u49548 \u47532 \u54616 \u50688 \'94 (\u50853  38:7) \u44592  \u46412 \u47928 \u51060 \u45796 . \u46608 \u54620  \u51064 \u47448 \u44032  \u53440 \u46973 \u54620  \u54980 \u50640  \u49373 \u47749 \u45208 \u47924 \u47484  \u51648 \u53412 \u44592  \u50948 \u54616 \u50668  \u52380 \u49324 \u44032  \u54028 \u44204 \u46104 \u50632 \u45716 \u45936 , \u44536 \u46412 \u45716  \u50500 \u51649  \u54620  \u49324 \u46988 \u46020  \u51453 \u44592  \u51204 \u51032  \u51068 \u51060 \u50632 \u45796 . \u52380 \u49324 \u45716  \u44536  \u48376 \u49457 \u51060  \u49324 \u46988 \u48372 \u45796  \u50864 \u49688 \u54616 \u45796 . \u44536 \u47084 \u48064 \u47196  \u49884 \u54200  \u44592 \u51088 \u45716  \'93\u51200  (\u49324 \u46988 ) \u47484  \u52380 \u49324 \u48372 \u45796  \u51312 \u44552  \u47803 \u54616 \u44172  \u54616 \u49884 \u44256 \'94 (\u49884  8:5) \u46972 \u44256  \u47568 \u54620 \u45796 .\
\uc0\u49457 \u44221 \u51008  \u54616 \u45720  \u44144 \u48124 \u51032  \u49688 \u50752  \u44536  \u45733 \u47141 \u44284  \u50689 \u44305 \u50640  \u45824 \u54616 \u50668  \u46608 \u54620  \u44536 \u46308 \u44284  \u54616 \u45208 \u45784 \u51032  \u51221 \u48512 \u50752 \u51032  \u44288 \u44228 , \u44536 \u47532 \u44256  \u46608 \u54620  \u49549 \u51396  \u49324 \u50629 \u44284 \u51032  \u44288 \u44228 \u50640  \u45824 \u54616 \u50668  \u50508 \u47140  \u51456 \u45796 . \'93\u50668 \u54840 \u50752 \u44760 \u49436  \u44536  \u48372 \u51340 \u47484  \u54616 \u45720 \u50640  \u49464 \u50864 \u49884 \u44256  \u44536  \u51221 \u44428 \u51004 \u47196  \u47564 \u50976 \u47484  \u53685 \u52824 \u54616 \u49884 \u46020 \u45796 .\'94 \u46608  \u49440 \u51648 \u51088 \u45716  \'93\u45236 \u44032  \u46608  \u48372 \u44256  \u46308 \u51004 \u47588  \u48372 \u51340 \u50752  \u49373 \u47932 \u46308 \u44284  \u51109 \u47196 \u46308 \u51012  \u46168 \u47084 \u49440  \u47566 \u51008  \u52380 \u49324 \u51032  \u51020 \u49457 \u51060  \u51080 \u51004 \u45768 \'94\u46972 \u44256  \u47568 \u54620 \u45796 . \u47564 \u50773 \u51032  \u50773  \u50526 \u50640 \u49436  \u49884 \u50948 \u54616 \u45716 , \'93\u45733 \u47141 \u51060  \u51080 \'94\u45716  \u52380 \u49324 \u46308 \u51008  \'93\u50668 \u54840 \u50752 \u47484  \u48393 \u49324 \u54616 \u50668  \u44536  \u46907 \u51012  \u54665 \u54616 \'94\u44256  \u44536  \'93\u47568 \u50432 \u51012  \u51060 \u47336 \u47728  \u44536  \u47568 \u50432 \u51032  \u49548 \u47532 \u47484  \u46307 \u45716 \'94 (\u49884  103:19~21; \u44228  5:11) \u51088 \u46308 \u51060 \u45796 . \'93\u49440 \u51648 \u51088  \u45796 \u45768 \u50648 \u51008  \u52380 \u52380 \u47564 \u47564 \u51032  \u52380 \u49324 \u46308 \u51012  \u48372 \u50520 \u45796 \'94 (\u45800  7:1). \u49324 \u46020  \u48148 \u50872 \u51008  \u44536 \u46308 \u51012  \'93\u52380 \u47564  \u52380 \u49324 \'94 (\u55176  12:22) \u46972 \u44256  \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u54616 \u45208 \u45784 \u51032  \u49324 \u51088 \u47196 \u49436  \'93\u50773 \u47000 \u44032  \u48264 \u44060 \u44057 \u51060  \u48736 \u47476 \'94 (\u44180  1:14) \u45796 . \u44536 \u46308 \u51008  \u44305 \u55064  \u52268 \u46976 \u54620  \u51204 \u44305  (\u38651 \u20809 ) \u52376 \u47100  \u48736 \u47476 \u45796 . \u44396 \u51452 \u51032  \u47924 \u45924 \u50640  \u45208 \u53440 \u45212  \u52380 \u49324 \u45716  \'93\u44536  \u54805 \u49345 \u51060  \u48264 \u44060  \u44057 \u44256  \u44536  \u50743 \u51008  \u45576 \u44057 \u51060  \u55148 \'94\u50632 \u51004 \u47728  \'93\u49688 \u51649 \u54616 \u45912  \u51088 \u46308 \u51060  \u51200 \u47484  \u47924 \u49436 \u50892 \u54616 \u50668  \u46504 \u47728  \u51453 \u51008  \u49324 \u46988 \u44284  \u44057 \u51060 \'94 (\u47560  28:3, 4) \u46104 \u50632 \u45796 . \u44144 \u47564 \u54620  \u50519 \u49688 \u47476  \u49324 \u46988  \u49328 \u54756 \u47549 \u51060  \u54616 \u45208 \u45784 \u51012  \u55036 \u48169 \u54616 \u44256  \u51312 \u47217 \u54616 \u47732 \u49436  \u51060 \u49828 \u46972 \u50648 \u51012  \u51652 \u47736 \u54616 \u44192 \u45796 \u44256  \u50948 \u54801 \u54624  \u46412  \'93\u48164 \u50640  \u50668 \u54840 \u50752 \u51032  \u49324 \u51088 \u44032  \u45208 \u50752 \u49436  \u50519 \u49688 \u47476  \u51652 \u50640 \u49436  \u44400 \u49324  \u49901 \u54036 \u47564  \u50724 \u52380 \u51012  \u52828 \u51648 \u46972 .\'94 \u49328 \u54756 \u47549 \u51032  \u44400 \u45824 \u51032  \'93\u47784 \u46304  \u53360  \u50857 \u49324 \u50752  \u45824 \u51109 \u44284  \u51109 \u44288 \u46308 \u51012  \u47736 \u54616 \u49888 \u51648 \u46972  \u50519 \u49688 \u47476  \u50773 \u51060  \u50620 \u44404 \u51060  \u46888 \u46907 \u54616 \u50668  \u44536  \u44256 \u44397 \u51004 \u47196  \u46028 \u50500 \'94 (\u50773 \u54616  19:35; \u45824 \u54616  32:21) \u44052 \u45796 .\
