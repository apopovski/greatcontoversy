\uc0\u51068 \u48152 \u51201 \u51004 \u47196  \u49324 \u44480  \u46308 \u47536  \u49324 \u46988 \u46308 \u51008  \u49900 \u54616 \u44172  \u44256 \u53685 \u54616 \u50688 \u51004 \u45208  \u50696 \u50808 \u47196  \u44536 \u47111 \u51648  \u50500 \u45768 \u54620  \u44221 \u50864 \u46020  \u51080 \u50632 \u45796 . \u52488 \u51088 \u50672 \u51201  \u45733 \u47141 \u51012  \u50619 \u44592  \u50948 \u54616 \u50668  \u50612 \u46500  \u49324 \u46988 \u46308 \u51008  \u49324 \u45800 \u51032  \u50689 \u54693 \u51012  \u51032 \u46020 \u51201 \u51004 \u47196  \u48155 \u50520 \u45796 . \u44536 \u46308 \u51060  \u49324 \u44480 \u50752  \u49912 \u50864 \u51648  \u50500 \u45768 \u54624  \u44163 \u51060  \u45817 \u50672 \u54616 \u45796 . \u44536 \u47088  \u48512 \u47448 \u51032  \u49324 \u46988 \u46308 \u51008  \u51216 \u52824 \u45716  \u44480 \u49888 \u50640  \u51217 \u54620  \u51088 \u46308 \u51060 \u45796 . \u47560 \u49696 \u51137 \u51060  \u49884 \u47788 , \u48149 \u49688  \u50648 \u47336 \u47560 , \u48716 \u47549 \u48372 \u50640 \u49436  \u48148 \u50872 \u44284  \u49892 \u46972 \u51032  \u46244 \u47484  \u46384 \u47480  \u50668 \u51333  \u46321 \u51060  \u50668 \u44592 \u50640  \u49549 \u54620 \u45796  (\u54665  8:9, 13:8, 16:6 \u52280 \u51312 ).\
\uc0\u54869 \u49892 \u54616 \u44256  \u52649 \u48516 \u54620  \u49457 \u44221 \u49345  \u51613 \u44144 \u44032  \u51080 \u51020 \u50640 \u46020  \u48520 \u44396 \u54616 \u44256  \u49324 \u45800 \u44284  \u50501 \u54620  \u52380 \u49324 \u46308 \u51032  \u51316 \u51116 \u50752  \u54876 \u46041 \u51012  \u48512 \u51064 \u54616 \u45716  \u51088 \u46308 \u52376 \u47100  \u50501 \u47161 \u51032  \u50689 \u54693 \u51012  \u48155 \u45716  \u51068 \u50640  \u51080 \u50612 \u49436  \u45908  \u50948 \u54744 \u54620  \u52376 \u51648 \u50640  \u51080 \u45716  \u51088 \u46308 \u51008  \u50630 \u45796 . \u50864 \u47532 \u44032  \u50501 \u47161 \u46308 \u51032  \u44036 \u44228 \u47484  \u50508 \u51648  \u47803 \u54616 \u47732  \u44536 \u46308 \u51008  \u44144 \u51032  \u49345 \u49345 \u54624  \u49688  \u50630 \u51012  \u51221 \u46020 \u51032  \u50976 \u51061 \u51012  \u50619 \u44256  \u51080 \u45796 . \u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u44536 \u46308 \u51060  \u44536 \u46308  \u51088 \u49888 \u51032  \u51648 \u54812 \u44032  \u47749 \u54616 \u45716  \u45824 \u47196  \u46384 \u47476 \u44256  \u51080 \u45796 \u44256  \u49373 \u44033 \u54616 \u45716  \u46041 \u50504  \u50501 \u47161 \u51032  \u51228 \u50504 \u51012  \u48155 \u50500 \u46308 \u51060 \u44256  \u51080 \u45796 . \u44536 \u47111 \u44592  \u46412 \u47928 \u50640  \u49324 \u45800 \u51008  \u45149 \u51060  \u44032 \u44620 \u50872 \u49688 \u47197  \u49324 \u46988 \u46308 \u51012  \u49549 \u51060 \u44256  \u47736 \u47581 \u49884 \u53412 \u44592  \u50948 \u54616 \u50668  \u45908 \u50865  \u53360  \u49464 \u47141 \u51004 \u47196  \u54876 \u46041 \u54616 \u50668  \u49324 \u45800 \u51060  \u51316 \u51116 \u54616 \u51648  \u50506 \u45716 \u45796 \u45716  \u49888 \u45392 \u51012  \u46020 \u52376 \u50640  \u54140 \u46888 \u47536 \u45796 . \u44536 \u47532 \u44256  \u51088 \u44592  \u51088 \u49888 \u44284  \u51088 \u49888 \u51032  \u54876 \u46041  \u48169 \u48277 \u51012  \u44048 \u52628 \u45716  \u44163 \u51060  \u49324