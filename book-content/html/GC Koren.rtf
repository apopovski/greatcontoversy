\'93\uc0\u44536 \u44032  \u51109 \u52264  \u47566 \u51008  \u49324 \u46988 \u51004 \u47196  \u45908 \u48520 \u50612  \u54620  \u51060 \u47112  \u46041 \u50504 \u51032  \u50616 \u50557 \u51012  \u44403 \u44172  \u51221 \u54616 \'94 (\u45800  9:27) \u47532 \u46972 . \u51060  1\u51452 \u51068 \u51008  70\u51452 \u51068 \u51032  \u47560 \u51648 \u47561  1\u51452 \u51068 \u51060 \u45796 . \u44536 \u44163 \u51008  \u53945 \u48324 \u55176  \u50976 \u45824 \u51064 \u50640 \u44172  \u48176 \u51221 \u46108  \u52572 \u54980 \u51032  7\u45380 \u44036 \u51012  \u51032 \u48120 \u54620 \u45796 . \u51060  \u44592 \u44036 , \u44263  \u49436 \u44592  27\u45380 \u50640 \u49436  34\u45380 \u44620 \u51648 \u51032  \u44592 \u44036 \u50640  \u44536 \u47532 \u49828 \u46020  \u51088 \u49888 \u51060 , \u54980 \u50640 \u45716  \u44536 \u48516 \u51032  \u51228 \u51088 \u46308 \u51060  \u53945 \u48324 \u55176  \u50976 \u45824 \u51064 \u50640 \u44172  \u48373 \u51020 \u51032  \u52488 \u52397 \u51012  \u54616 \u50688 \u45796 . \u49324 \u46020 \u46308 \u51060  \u52380 \u44397 \u51032  \u44592 \u49244  \u49548 \u49885 \u51012  \u51204 \u54616 \u47084  \u45208 \u44040  \u46412 \u50640  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \'93\u51060 \u48169 \u51064 \u51032  \u44600 \u47196 \u46020  \u44032 \u51648  \u47568 \u44256  \u49324 \u47560 \u47532 \u50500 \u51064 \u51032  \u44256 \u51012 \u50640 \u46020  \u46308 \u50612 \u44032 \u51648  \u47568 \u44256  \u52264 \u46972 \u47532  \u51060 \u49828 \u46972 \u50648  \u51665 \u51032  \u51075 \u50612 \u48260 \u47536  \u50577 \u50640 \u44172 \u47196  \u44032 \u46972 \'94 (\u47560  10:5, 6) \u44256  \u47749 \u47161 \u54616 \u49512 \u45796 .\
\'93\uc0\u51060 \u47112 \u51032  \u51208 \u48152 \u50640  \u51228 \u49324 \u50752  \u50696 \u47932 \u51012  \u44552 \u51648 \u54624  \u44163 \u51060 \'94\u45796 . \u52840 \u47168 \u47484  \u48155 \u51004 \u49888  \u51648  3\u45380  \u48152 \u51060  \u51648 \u45212  \u49436 \u44592  31\u45380 \u50640  \u51452 \u45784 \u44760 \u49436 \u45716  \u49901 \u51088 \u44032 \u50640  \u47803  \u48149 \u55176 \u49512 \u45796 . \u44040 \u48148 \u47532 \u50640 \u49436  \u46300 \u47532 \u49888  \u44536  \u50948 \u45824 \u54620  \u55148 \u49373 \u51004 \u47196  \u47568 \u48120 \u50516 \u50500  \u44284 \u44144  4000\u45380 \u44036  \u54616 \u45208 \u45784 \u51032  \u50612 \u47536 \u50577 \u51012  \u54364 \u49345 \u54620  \u55148 \u49373  \u51228 \u46020 \u45716  \u45149 \u45228 \u45796 . \u47784 \u54805  (\u27169 \u22411 ) \u51008  \u49892 \u52404 \u50752  \u47564 \u45228 \u44256 , \u47784 \u46304  \u55148 \u49373  \u51228 \u46020 \u50752  \u51228 \u47932 \u50640  \u44288 \u54620  \u51032 \u47168  (\u20736 \u31150 ) \u50752  \u51032 \u49885 \u51008  \u45149 \u45208 \u44172  \u46104 \u50632 \u45796 .\
\uc0\u50976 \u45824 \u51064 \u51012  \u50948 \u54616 \u50668  \u48176 \u45817 \u46108  70\u51452 \u51068 , \u44263  490\u45380 \u51008  \u50864 \u47532 \u44032  \u49332 \u54196 \u48376  \u44163 \u52376 \u47100  \u49436 \u44592  34\u45380 \u50640  \u45149 \u45228 \u45796 . \u44536  \u46412 \u50640  \u50976 \u45824 \u51032  \u49328 \u54756 \u46300 \u47536 \u51060  \u52712 \u54620  \u53468 \u46020 , \u44263  \u49828 \u45936 \u48152 \u51012  \u51453 \u51060 \u44256  \u44536 \u47532 \u49828 \u46020 \u47484  \u46384 \u47476 \u45716  \u49324 \u46988 \u46308 \u51012  \u48149 \u54644 \u54632 \u51004 \u47196  \u48373 \u51020 \u51012  \u44144 \u51208 \u54620  \u44163 \u51008  \u44397 \u44032 \u47196 \u49436  \u44536 \u46308 \u51032  \u50868 \u47749 \u51012  \u44208 \u51221 \u51667 \u45716  \u51068 \u51060  \u46104 \u50632 \u45796 . \u44536 \u47532 \u54616 \u50668  \u48373 \u51020 \u51008  \u44536  \u53469 \u54632  \u48155 \u51008  \u44397 \u48124 \u50640 \u44172 \u47564  \u51228 \u54620 \u46104 \u51648  \u50506 \u44256 , \u50728  \u49464 \u44228 \u50640  \u51204 \u54028 \u46104 \u50632 \u45796 . \u51228 \u51088 \u46308 \u51008  \u48149 \u54644  \u46412 \u47928 \u50640  \u48512 \u46301 \u51060  \u50696 \u47336 \u49332 \u47128 \u50640 \u49436  \u46020 \u47581 \u54616 \u50668  \'93\u44536  \u55145 \u50612 \u51652  \u49324 \u46988 \u46308 \u51060  \u46160 \u47336  \u45796 \u45768 \u47728  \u48373 \u51020 \u51032  \u47568 \u50432 \u51012  \u51204 \'94 (\u54665 8:4, 5) \u54616 \u50688 \u45796 . \u48716 \u47549 \u51008  \'93\u49324 \u47560 \u47532 \u50500  \u49457 \u50640  \u45236 \u47140 \u44032  \u44536 \u47532 \u49828 \u46020 \u47484  \u48177 \u49457 \u50640 \u44172  \u51204 \u54028 \'94\u54616 \u50688 \u45796 . \u46608 \u54620  \u48288 \u46300 \u47196 \u45716  \u54616 \u45208 \u45784 \u51032  \u51064 \u46020 \u54616 \u49900 \u51012  \u46384 \u46972  \u44032 \u51060 \u49324 \u47028 \u50640  \u49324 \u45716  \u48177 \u48512 \u51109 , \u54616 \u45208 \u45784 \u51012  \u44221 \u50808 \u54616 \u45716  \u44221 \u44148 \u54620  \u44256 \u45356 \u47308 \u50640 \u44172  \u48373 \u51020 \u51032  \u47928 \u51012  \u50676 \u50612  \u51452 \u50632 \u45796 . \u44536 \u47532 \u49828 \u46020 \u51032  \u48127 \u51020 \u51012  \u48155 \u50500 \u46308 \u51064  \u50676 \u47148 \u54620  \u48148 \u50872 \u51008  \u44536  \u44592 \u49244  \u49548 \u49885 \u51012  \'93\u47680 \u47532  \u51060 \u48169 \u51064 \'94 (\u54665  22:21) \u50640 \u44172  \u51204 \u54616 \u46972 \u45716  \u49324 \u47749 \u51012  \u48155 \u44172  \u46104 \u50632 \u45796 .\
\uc0\u51060 \u50752  \u44057 \u51060  \u50696 \u50616 \u50640  \u50676 \u44144 \u46108  \u49324 \u44148 \u46308 \u51008  \u45440 \u46972 \u50872  \u51221 \u46020 \u47196  \u47784 \u46160  \u49457 \u52712 \u46104 \u50632 \u45796 . \u44536 \u47532 \u44256  70\u51452 \u51068 \u51008  \u51032 \u49900 \u54624  \u50668 \u51648 \u50630 \u51060  \u44592 \u50896 \u51204  457\u45380 \u50640  \u49884 \u51089 \u46104 \u50612  \u49436 \u44592  34\u45380 \u50640  \u45149 \u45228 \u45796 . \u51060  \u49324 \u49892 \u51012  \u44540 \u44144 \u47196  2300\u51068 \u51032  \u45149 \u51012  \u52286 \u50500 \u45236 \u44592 \u46976  \u50612 \u47140 \u50868  \u51068 \u51060  \u50500 \u45768 \u50632 \u45796 . 2300\u51068 \u50640 \u49436  70\u51452 \u51068 , \u44263  490\u51068 \u51012  \u46524 \u50612 \u45236 \u47732  1810\u51068 \u51060  \u45224 \u45716 \u45796 . 490\u51068  \u54980 \u50640  \u44228 \u49549 \u54616 \u50668  1810\u51068 \u46020  \u49457 \u52712 \u46104 \u50612 \u50556  \u54624  \u44163 \u51060 \u45796 . \u49436 \u44592  34\u45380 \u50640 \u45796  1810\u45380 \u51012  \u44032 \u54616 \u47732  1844\u45380 \u51060  \u46108 \u45796 . \u44536 \u47084 \u48064 \u47196  \u45796 \u45768 \u50648 \u49436  8\u51109  14\u51208 \u51032  2300\u51068 \u51008  \u49436 \u44592  1844\u45380 \u50640  \u47560 \u52824 \u44172  \u46108 \u45796 . \u44536 \u47088 \u45936  \u51060  \u44596  \u50696 \u50616 \u51201  \u44592 \u44036 \u51032  \u45149 \u50640  \'93\u49457 \u49548 \u44032  \u51221 \u44208 \u54616 \'94\u50668 \u51648 \u47532 \u46972 \u44256  \u54616 \u45208 \u45784 \u51032  \u52380 \u49324 \u45716  \u51613 \u44144 \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u51068 \u48152 \u51201 \u51004 \u47196  \u50696 \u49688 \u45784 \u51032  \u51116 \u47548  \u46412 \u50640  \u49457 \u52712 \u46112  \u44163 \u51004 \u47196  \u48127 \u44256  \u51080 \u45716  \'93\u49457 \u49548 \u44032  \u51221 \u44208 \u54616 \'94\u50668 \u51648 \u47532 \u46972 \u45716  \u49884 \u44592 \u44032  \u51060 \u51228  \u54869 \u49892 \u55176  \u46300 \u47084 \u45208 \u44172  \u46104 \u50632 \u45796 .\
