\f0\b \cf0 \uc0\u54980 \u49828 \u51032  \u46244 \u47484  \u46384 \u47480  \u51228 \u47212 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u44263  \u44536 \u45716  \u45796 \u49884  \u54924 \u51032 \u50640  \u45132 \u47140 \u45208 \u50772 \u45796 . \u44536 \u51032  \u51116 \u54032 \u44288 \u46308 \u51008  \u44536 \u51032  \u44404 \u48373 \u51004 \u47196  \u47564 \u51313 \u54616 \u51648  \u47803 \u54616 \u50688 \u45796 . \u54588 \u50640  \u47785 \u47560 \u47480  \u51200 \u46308 \u51008  \u54980 \u49828 \u51032  \u51453 \u51020 \u51004 \u47196  \u51088 \u44537 \u51012  \u48155 \u50500  \u49352 \u47196 \u50868  \u55148 \u49373 \u51088 \u47484  \u50836 \u44396 \u54616 \u44172  \u46104 \u50632 \u45796 . \u51228 \u47212 \u51008  \u51652 \u47532 \u47484  \u50756 \u51204 \u55176  \u48260 \u47532 \u51648  \u50506 \u51004 \u47732  \u49373 \u47749 \u51012  \u48372 \u51316 \u54624  \u49688  \u50630 \u44172  \u46104 \u50632 \u45796 . \u44536 \u47084 \u45208  \u51228 \u47212 \u51008  \u44536  \u49888 \u50521 \u51012  \u44256 \u48177 \u54616 \u45716  \u46041 \u49884 \u50640  \u51088 \u44592 \u51032  \u54805 \u51228  \u49692 \u44368 \u51088 \u51032  \u46244 \u47484  \u46384 \u46972  \u54868 \u54805 \u51012  \u45817 \u54616 \u44592 \u47196  \u44403 \u44172  \u44208 \u49900 \u54616 \u50688 \u45796 .\
\uc0\u44536 \u45716  \u51648 \u45212 \u48264 \u51032  \u47568 \u51012  \u52712 \u49548 \u54616 \u44256 , \u51453 \u51020 \u51012  \u44033 \u50724 \u54620  \u49324 \u46988 \u51004 \u47196 \u49436  \u48320 \u47749 \u54624  \u44592 \u54924 \u47484  \u45804 \u46972 \u44256  \u50628 \u49689 \u55176  \u50836 \u44396 \u54616 \u50688 \u45796 . \u44536 \u51032  \u47568 \u51060  \u45180 \u52824 \u44172  \u46112  \u50689 \u54693 \u51012  \u46160 \u47140 \u50892 \u54620  \u51452 \u44368 \u46308 \u51008  \u44536 \u50640 \u44172  \u45824 \u54620  \u44256 \u49548 \u50640  \u45824 \u54644 \u49436 \u47564  \u44032 \u48512 \u44036 \u50640  \u45824 \u45813 \u54616 \u46972 \u44256  \u44053 \u50836 \u54616 \u50688 \u45796 . \u51228 \u47212 \u51008  \u51060 \u50752  \u44057 \u51060  \u51092 \u54841 \u54616 \u44256  \u48520 \u51032 \u54620  \u51068 \u50640  \u45824 \u54616 \u50668  \u45796 \u51020 \u44284  \u44057 \u51060  \u54637 \u51032 \u54616 \u50688 \u45796 . \'93\u45320 \u55148 \u46308 \u51008  \u45208 \u47484  \u47924 \u49436 \u50868  \u44048 \u50725 , \u48520 \u44208 \u54616 \u44256  \u50501 \u52712 \u44032  \u53076 \u47484  \u52236 \u47476 \u45716  \u44275 \u50640 \u49436  \u54596 \u50836 \u54620  \u44163 \u51008  \u50500 \u47924 \u44163 \u46020  \u51452 \u51648  \u50506 \u51008  \u52292  3, 40\u51068 \u44036  \u44396 \u44552 \u54616 \u50688 \u45796 . \u44536 \u47532 \u44256  \u45208 \u47484  \u45320 \u55148  \u50526 \u50640  \u45132 \u50612 \u45236 \u50612  \u45208 \u47484  \u51453 \u51060 \u47140 \u45716  \u50896 \u49688 \u46308 \u51032  \u47568 \u51008  \u46308 \u50612  \u51452 \u47732 \u49436  \u45208 \u51032  \u51613 \u50616 \u50640 \u45716  \u44480 \u47484  \u44592 \u50872 \u51060 \u51648  \u50500 \u45768 \u54616 \u50688 \u45796 . \u47564 \u51068  \u45320 \u55148 \u46308 \u51060  \u51652 \u51221 \u51004 \u47196  \u54788 \u47749 \u54620  \u49324 \u46988 \u46308 \u51060 \u44256  \u51204  \u49464 \u44228 \u51032  \u44305 \u47749 \u51060 \u46972  \u51088 \u52376 \u54620 \u45796 \u47732  \u51221 \u51032 \u50640  \u45824 \u54616 \u50668  \u48276 \u51396 \u52824  \u50506 \u46020 \u47197  \u51312 \u49900 \u54616 \u46972 . \u45208 \u45716  \u45796 \u47564  \u54616 \u45208 \u51032  \u50672 \u50557 \u54620  \u51064 \u44036 \u51060 \u45796 . \u45208 \u51032  \u49373 \u47749 \u51008  \u48324 \u47196  \u51473 \u50836 \u54616 \u51648  \u50506 \u45796 . \u45236 \u44032  \u48520 \u51032 \u54620  \u49440 \u44256 \u47484  \u54616 \u51648  \u50506 \u46020 \u47197  \u45320 \u55148 \u46308 \u50640 \u44172  \u44428 \u44256 \u54616 \u45716  \u44163 \u51008  \u45208  \u51088 \u49888 \u51012  \u50948 \u54616 \u50668  \u54616 \u45716  \u44163 \u48372 \u45796  \u45320 \u55148 \u46308 \u51012  \u50948 \u54616 \u50668  \u54616 \u45716  \u44163 \u51060 \u45796 \'94 (Bonnechose, vol.2, p.146, 147).\
\uc0\u44536 \u51032  \u50836 \u44396 \u45716  \u47560 \u52840 \u45236  \u49688 \u46973 \u46104 \u50632 \u45796 . \u51228 \u47212 \u51008  \u51116 \u54032 \u44288 \u46308  \u50526 \u50640 \u49436  \u47924 \u47502 \u51012  \u44999 \u44256  \u49457 \u47161 \u51060  \u51088 \u44592 \u51032  \u49373 \u44033 \u44284  \u47568 \u51012  \u51228 \u50612 \u54644  \u51452 \u49900 \u51004 \u47196 \u50024  \u51452 \u45784 \u51012  \u50837 \u46104 \u44172  \u54616 \u44144 \u45208  \u54620  \u47560 \u46356 \u46972 \u46020  \u51652 \u47532 \u50640  \u50612 \u44536 \u47084 \u51648 \u45716  \u47568 \u51012  \u54616 \u51648  \u50506 \u44172  \u54644  \u45804 \u46972 \u44256  \u54616 \u45208 \u45784 \u44760  \u44592 \u46020 \u54616 \u50688 \u45796 . \u51060 \u45216 \u50640  \u44536 \u50640 \u44172 \u45716  \u52488 \u45824  \u44368 \u54924 \u51032  \u49324 \u46020 \u46308 \u50640 \u44172  \u51452 \u49888 \u48148  \u50616 \u50557 , \u44263  \'93\u45320 \u55148 \u44032  \u45208 \u47484  \u51064 \u54616 \u50668  \u52509 \u46021 \u46308 \u44284  \u51076 \u44552 \u46308  \u50526 \u50640  \u45132 \u47140 \u44032 \u47532 \u45768  \u51060 \u45716  \u51200 \u55148 \u50752  \u51060 \u48169 \u51064 \u46308 \u50640 \u44172  \u51613 \u44144 \u44032  \u46104 \u44172  \u54616 \u47140  \u54616 \u49900 \u51060 \u46972  \u45320 \u55148 \u47484  \u45336 \u44200 \u51460  \u46412 \u50640  \u50612 \u46523 \u44172  \u46608 \u45716  \u47924 \u50631 \u51012  \u47568 \u54624 \u44620  \u50684 \u47140 \u54616 \u51648  \u47568 \u46972  \u44536  \u46412 \u50640  \u47924 \u49832  \u47568 \u54624  \u44163 \u51012  \u51452 \u49884 \u47532 \u45768  \u47568 \u54616 \u45716  \u51060 \u45716  \u45320 \u55148 \u44032  \u50500 \u45768 \u46972  \u45320 \u55148  \u49549 \u50640 \u49436  \u47568 \u50432 \u54616 \u49884 \u45716  \u51088  \u44263  \u45320 \u55148  \u50500 \u48260 \u51648 \u51032  \u49457 \u47161 \u51060 \u49884 \u45768 \u46972 \'94 (\u47560  10:18~20) \u44256  \u54616 \u49888  \u44536  \u50616 \u50557 \u51060  \u49457 \u52712 \u46104 \u50632 \u45796 .\
\uc0\u51228 \u47212 \u51032  \u47568 \u51008  \u44536 \u51032  \u50896 \u49688 \u46308 \u44620 \u51648 \u46020  \u44221 \u53444 \u52992  \u54616 \u44256  \u45440 \u46972 \u44172  \u54664 \u45796 . \u44536 \u45716  \u44537 \u49900 \u54620  \u50977 \u52404 \u51201  \u44256 \u53685 \u44284  \u51221 \u49888 \u51201  \u48264 \u48124  \u49549 \u50640 \u49436  1\u45380  \u46041 \u50504  \u44048 \u50725 \u50640  \u44039 \u55180  \u52292 \u47196  \u48372 \u51648 \u46020  \u47803 \u54616 \u44256  \u51069 \u51648 \u46020  \u47803 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u51032  \u47568 \u51008  \u47560 \u52824  \u44536 \u44032  \u50500 \u47924 \u47088  \u48149 \u54644 \u46020  \u48155 \u51648  \u50506 \u44256  \u44228 \u49549 \u54644 \u49436  \u50672 \u44396 \u54624  \u49688  \u51080 \u45716  \u44592 \u54924 \u47484  \u44032 \u51276 \u45912  \u44163 \u52376 \u47100  \u48516 \u47749 \u54616 \u44256  \u45733 \u47141 \u51060  \u51080 \u50632 \u45796 . \u44536 \u45716  \u52397 \u51473 \u46308 \u50640 \u44172  \u48520 \u51032 \u54620  \u51116 \u54032 \u44288 \u46308 \u50640  \u51032 \u54616 \u50668  \u51221 \u51396 \u51032  \u49440 \u44256 \u47484  \u48155 \u50520 \u45912  \u49457 \u46020 \u46308 \u51012  \u51068 \u51068 \u51060  \u50676 \u44144 \u54616 \u50688 \u45796 . \u44536 \u45716  \u50612 \u46496 \u54620  \u49884 \u45824 \u50640 \u46304 \u51648  \u44536  \u49884 \u45824 \u51032  \u48177 \u49457 \u46308 \u51012  \u44228 \u47805 \u54616 \u47140 \u44256  \u55192 \u50420  \u51088 \u46308 \u51060  \u48708 \u45212 \u51012  \u48155 \u44256  \u48176 \u52377 \u51012  \u45817 \u54616 \u50688 \u51004 \u45208  \u54980 \u50640 \u45716  \u50689 \u44305 \u51012  \u48155 \u51008  \u44163 \u44284  \u44536 \u47532 \u49828 \u46020  \u51088 \u49888 \u46020  \u48520 \u51032 \u54620  \u48277 \u44288 \u50640 \u44172  \u50501 \u51064 \u51004 \u47196  \u51221 \u51396 \u47484  \u48155 \u51004 \u49888  \u49324 \u49892 \u51012  \u51648 \u51201 \u54616 \u50688 \u45796 .\
\uc0\u49888 \u50521 \u51012  \u52712 \u49548 \u54616 \u50688 \u51012  \u46412  \u51228 \u47212 \u51008  \u54980 \u49828 \u44032  \u51221 \u51396 \u47484  \u48155 \u51008  \u44163 \u51012  \u45817 \u50672 \u54616 \u45796 \u44256  \u46041 \u51032 \u54664 \u50632 \u45796 . \u44536 \u47084 \u45208  \u51060 \u51228  \u44536 \u45716  \u51088 \u49888 \u51032  \u54924 \u44060 \u47484  \u49440 \u54252 \u54616 \u50688 \u51004 \u47728  \u44536  \u49692 \u44368 \u51088 \u51032  \u47924 \u51396 \u50752  \u49457 \u44208 \u51012  \u45796 \u51020 \u44284  \u44057 \u51060  \u51613 \u50616 \u54616 \u50688 \u45796 . \'93\u45208 \u45716  \u44536 \u47484  \u50612 \u47160 \u51012  \u46412 \u48512 \u53552  \u50508 \u50520 \u45796 . \u44536 \u45716  \u51032 \u47213 \u44256  \u44144 \u47337 \u54616 \u47728  \u44032 \u51109  \u53441 \u50900 \u54620  \u49324 \u46988 \u51060 \u50632 \u45796 . \u44536 \u45716  \u50500 \u47924  \u51396  \u50630 \u51060  \u50976 \u51396  \u49440 \u44256 \u47484  \u48155 \u50520 \u45796 . \'85\u45208  \u50669 \u49884  \u51453 \u51020 \u51012  \u44033 \u50724 \u54616 \u44256  \u51080 \u45796 . \u50616 \u51232 \u44032 \u45716  \u50500 \u47924 \u46020  \u49549 \u51068  \u49688  \u50630 \u45716  \u53356 \u49888  \u54616 \u45208 \u45784  \u50526 \u50640 \u49436  \u44536 \u46308 \u51032  \u44592 \u47564 \u50640  \u45824 \u54616 \u50668  \u49900 \u54032 \u51012  \u48155 \u44172  \u46112  \u45208 \u51032  \u50896 \u49688 \u46308 \u44284  \u44144 \u51667  \u51613 \u51064 \u46308 \u51060  \u47560 \u47144 \u54644  \u45459 \u51008  \u44256 \u53685 \u51012  \u45208 \u45716  \u46160 \u47140 \u50892 \u54616 \u51648  \u50506 \u51012  \u44163 \u51060 \u45796 \'94 (Bonnechose, vol.2, p.151).\
