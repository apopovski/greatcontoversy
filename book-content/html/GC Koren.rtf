\uc0\u49457 \u44221 \u50640  \u44536 \u52376 \u47100  \u48516 \u47749 \u55176  \u48157 \u54784 \u51256  \u51080 \u45716  \u51652 \u47532 \u47484  \u54869 \u49888 \u54616 \u44172  \u46108  \u48148 \u47484  \u45796 \u47480  \u49324 \u46988 \u46308 \u50640 \u44172  \u50508 \u47140  \u51452 \u50612 \u50556  \u54616 \u44192 \u45796 \u45716  \u52293 \u51076 \u44048 \u51060  \u49352 \u47196 \u50868  \u55192 \u51004 \u47196  \u44536 \u50640 \u44172  \u48128 \u47140 \u50772 \u45796 . \u44536  \u46412 \u51032  \u51068 \u51012  \u44536 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u54924 \u49345 \u54616 \u50688 \u45796 . \'93\u45236 \u44032  \u45208 \u51032  \u49324 \u49324 \u47196 \u50868  \u51068 \u51012  \u54616 \u44256 \u51088  \u54616 \u47732  \u50616 \u51228 \u45208  \'91\u44032 \u49436  \u49464 \u49345 \u50640  \u44536  \u50948 \u54744 \u51012  \u44221 \u44256 \u54644  \u51452 \u46972 \'92\u45716  \u49548 \u47532 \u44032  \u45208 \u51032  \u44480 \u50640  \u46308 \u47160 \u45796 . \u44536 \u47532 \u44256  \u45796 \u51020 \u51032  \u49457 \u44221  \u47568 \u50432 \u51060  \u54637 \u49345  \u49373 \u44033 \u45228 \u45796 . \'91\u44032 \u47161  \u45236 \u44032  \u50501 \u51064 \u50640 \u44172  \u51060 \u47476 \u44592 \u47484  \u50501 \u51064 \u50500  \u45320 \u45716  \u51221 \u45397  \u51453 \u51004 \u47532 \u46972  \u54616 \u50688 \u45796  \u54616 \u51088  \u45348 \u44032  \u44536  \u50501 \u51064 \u50640 \u44172  \u47568 \u47196  \u44221 \u44256 \u54616 \u50668  \u44536  \u44600 \u50640 \u49436  \u46496 \u45208 \u44172  \u50500 \u45768 \u54616 \u47732  \u44536  \u50501 \u51064 \u51008  \u51088 \u44592  \u51396 \u50501  \u51473 \u50640 \u49436  \u51453 \u51004 \u47140 \u45768 \u50752  \u45236 \u44032  \u44536  \u54588 \u47484  \u45348  \u49552 \u50640 \u49436  \u52286 \u51004 \u47532 \u46972  \u44536 \u47084 \u45208  \u45320 \u45716  \u50501 \u51064 \u50640 \u44172  \u44221 \u44256 \u54616 \u50668  \u46028 \u51060 \u53020  \u44536  \u44600 \u50640 \u49436  \u46496 \u45208 \u46972 \u44256  \u54616 \u46104  \u44536 \u44032  \u44536  \u44600 \u50640 \u49436  \u46496 \u45208 \u51648  \u50500 \u45768 \u54616 \u47732  \u44536 \u45716  \u51088 \u44592  \u51396 \u50501  \u51473 \u50640 \u49436  \u51453 \u51004 \u47140 \u45768 \u50752  \u45320 \u45716  \u45348  \u49373 \u47749 \u51012  \u48372 \u51204 \u54616 \u47532 \u46972 \'92 (\u44180  33:8, 9). \u47564 \u51068  \u45236 \u44032  \u50501 \u54620  \u51088 \u46308 \u51012  \u52649 \u48516 \u55176  \u44221 \u44256 \u54624  \u44163  \u44057 \u51004 \u47732  \u44536 \u46308  \u51473 \u51032  \u47566 \u51008  \u49324 \u46988 \u46308 \u51060  \u54924 \u44060 \u54616 \u44172  \u46112  \u44163 \u51060 \u47728 , \u47564 \u51068  \u44536 \u46308 \u51060  \u44221 \u44256 \u47484  \u48155 \u51648  \u47803 \u54616 \u47732  \u44536 \u46308 \u51032  \u54588 \u45716  \u48152 \u46300 \u49884  \u45236  \u49552 \u50640 \u49436  \u52286 \u51012  \u44163 \u51060 \u46972 \u44256  \u45208 \u45716  \u45712 \u44808 \u45796 \'94 (S.Bliss, Memoirs of Wm.Miller, p.92).\
\uc0\u48128 \u47084 \u45716  \u44592 \u54924 \u47484  \u50619 \u45716  \u45824 \u47196  \u44060 \u51064 \u51201 \u51004 \u47196  \u51088 \u44592 \u51032  \u44204 \u54644 \u47484  \u54588 \u47141 \u54632 \u44284  \u46041 \u49884 \u50640  \u50612 \u46500  \u51204 \u46020 \u51088 \u44032  \u44536  \u51652 \u47532 \u47484  \u48155 \u50500 \u46308 \u51060 \u44256  \u44536 \u44163 \u51012  \u51204 \u54616 \u45716  \u51068 \u50640  \u54732 \u49888 \u54616 \u44172  \u46104 \u44592 \u47484  \u44592 \u46020 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u51088 \u44592  \u51088 \u49888 \u51060  \u44221 \u44256 \u54624  \u51032 \u47924 \u44032  \u51080 \u45796 \u45716  \u51088 \u44033 \u51012  \u54252 \u44592 \u54624  \u49688 \u45716  \u50630 \u50632 \u45796 . \u44536 \u51032  \u47560 \u51020 \u50640 \u45716  \'93\u44032 \u49436  \u51060 \u44163 \u51012  \u49464 \u49345 \u50640  \u44256 \u54616 \u46972 . \u44536 \u47111 \u51648  \u50500 \u45768 \u54616 \u47732  \u45236 \u44032  \u44536 \u46308 \u51032  \u54588 \u47484  \u45348  \u49552 \u50640 \u49436  \u52286 \u51004 \u47532 \u46972 \'94\u45716  \u47568 \u50432 \u51060  \u44536 \u51032  \u47560 \u51020 \u50640  \u45130 \u51076 \u50630 \u51060  \u46496 \u50732 \u46992 \u45796 . \u44536 \u45716  9\u45380  \u46041 \u50504  \u44592 \u45796 \u47160 \u45796 . \u44536 \u47084 \u45208  \u47924 \u44144 \u50868  \u51664 \u51008  \u50668 \u51204 \u55176  \u44536 \u51032  \u47560 \u51020 \u51012  \u45572 \u47476 \u44256  \u51080 \u50632 \u45796 . \u44536 \u45716  \u47560 \u52840 \u45236  1831\u45380 \u50640  \u52376 \u51020 \u51004 \u47196  \u44277 \u51473  \u50526 \u50640 \u49436  \u51088 \u44592 \u51032  \u48127 \u51020 \u51032  \u51060 \u50976 \u47484  \u51613 \u44144 \u54616 \u44172  \u46104 \u50632 \u45796 .\
\uc0\u47560 \u52824  \u50715 \u45216  \u50648 \u47532 \u49324 \u44032  \u44536 \u51032  \u49548 \u47484  \u47792 \u44256  \u48173 \u44032 \u45716  \u51068 \u51012  \u48260 \u47532 \u44256  \u54732 \u49888 \u51032  \u46160 \u47336 \u47560 \u44592 \u47484  \u48155 \u51020 \u51004 \u47196  \u49440 \u51648 \u51088 \u51032  \u51649 \u48516 \u51012  \u48155 \u46020 \u47197  \u48512 \u47476 \u49900 \u51012  \u51077 \u50632 \u45912  \u44163 \u52376 \u47100  \u50956 \u47532 \u50628  \u48128 \u47084 \u46020  \u44536 \u51032  \u51137 \u44592 \u47484  \u48260 \u47532 \u44256  \u49324 \u46988 \u46308 \u50640 \u44172  \u54616 \u45208 \u45784  \u45208 \u46972 \u51032  \u50724 \u47896 \u54620  \u51060 \u52824 \u47484  \u44032 \u47476 \u52824 \u46020 \u47197  \u48512 \u47476 \u49900 \u51012  \u48155 \u50520 \u45796 . \u44536 \u45716  \u46504 \u47532 \u45716  \u47560 \u51020 \u51004 \u47196  \u51088 \u49888 \u51032  \u49324 \u50629 \u50640  \u52265 \u49688 \u54616 \u50688 \u44256 , \u52397 \u51473 \u46308 \u51012  \u52264 \u52784 \u52264 \u52784  \u44536  \u50696 \u50616 \u51201  \u44592 \u44036 \u51012  \u53685 \u54616 \u50668  \u44536 \u47532 \u49828 \u46020 \u51032  \u51116 \u47548 \u51004 \u47196  \u51060 \u45132 \u44256  \u44052 \u45796 . \u44536 \u45716  \u49324 \u46988 \u46308 \u51032  \u55141 \u48120 \u44032  \u53356 \u44172  \u51068 \u50612 \u45208 \u45716  \u44163 \u51012  \u48388 \u50640  \u46384 \u46972  \u47784 \u46304  \u51068 \u50640  \u45733 \u47141 \u44284  \u50857 \u44592 \u47484  \u50619 \u50632 \u45796 .\
\uc0\u48128 \u47084 \u44032  \u51088 \u49888 \u51032  \u44204 \u54644 \u47484  \u51068 \u48152  \u49324 \u46988 \u46308 \u50640 \u44172  \u48156 \u54364 \u54616 \u44592 \u47196  \u44208 \u51221 \u54616 \u44172  \u46108  \u44163 \u51008  \u44536 \u51032  \u54805 \u51228 \u46308 \u51032  \u44428 \u44256 \u50640 \u49436  \u54616 \u45208 \u45784 \u51032  \u48512 \u47476 \u49900 \u51012  \u46308 \u50632 \u44592  \u46412 \u47928 \u51060 \u50632 \u45796 . \u44536 \u45716  \u44536  \u45817 \u49884 \u50640  \u45208 \u51060  50\u49464 \u47196 \u49436  \u44277 \u51473  \u50526 \u50640 \u49436  \u44053 \u50672 \u51060 \u45208  \u49444 \u44368 \u47484  \u54644 \u48376  \u44221 \u54744 \u51060  \u50630 \u50632 \u51004 \u48064 \u47196 , \u44536  \u49324 \u50629 \u50640  \u51201 \u51076 \u51088 \u44032  \u50500 \u45768 \u46972 \u45716  \u49373 \u44033 \u50640 \u49436  \u53360  \u48512 \u45812 \u51012  \u45712 \u44808 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u52376 \u51020 \u48512 \u53552  \u53360  \u52629 \u48373 \u51012  \u48155 \u50500  \u47566 \u51008  \u50689 \u54844 \u51060  \u44396 \u50896 \u51012  \u50619 \u44172  \u46104 \u50632 \u45796 . \u44536 \u51032  \u52572 \u52488 \u51032  \u44053 \u50672 \u51008  \u53360  \u51333 \u44368 \u51201  \u44033 \u49457 \u51012  \u51068 \u51004 \u53020  \u51452 \u50632 \u51004 \u48064 \u47196  \u50676 \u49464  \u44032 \u51221 \u50640 \u49436  \u46160  \u49324 \u46988 \u51012  \u51228 \u50808 \u54616 \u44256  \u47784 \u46160  \u54924 \u44060 \u54616 \u44172  \u46104 \u50632 \u45796 . \u44536 \u45716  \u51593 \u49884 \u47196  \u45796 \u47480  \u44275 \u50640 \u49436  \u47568 \u54644  \u45804 \u46972 \u45716  \u48512 \u53441 \u51012  \u48155 \u44172  \u46104 \u50632 \u44256 , \u44144 \u51032  \u47784 \u46304  \u44275 \u50640 \u49436  \u44536 \u51032  \u54876 \u46041 \u51008  \u54616 \u45208 \u45784 \u51032  \u49324 \u50629 \u51012  \u48512 \u55141 \u49884 \u53412 \u45716  \u44208 \u44284 \u47484  \u44032 \u51256 \u50772 \u45796 . \u51396 \u51064 \u46308 \u51008  \u54924 \u44060 \u54616 \u44256 , \u49888 \u51088 \u46308 \u51008  \u45908 \u50865  \u44618 \u51060  \u54732 \u49888 \u54616 \u44256 , \u54924 \u51032 \u47200 \u51088  (\u25079 \u30097 \u35542 \u32773 ) \u50752  \u48520 \u49888 \u51088 \u46308 \u44620 \u51648 \u46020  \u44536 \u47532 \u49828 \u46020 \u44368 \u50752  \u49457 \u44221 \u51032  \u51652 \u47532 \u47484  \u49884 \u51064 \u54616 \u44172  \u46104 \u50632 \u45796 . \u44536 \u51032  \u54876 \u46041 \u51032  \u45824 \u49345 \u51060  \u46104 \u50632 \u45912  \u49324 \u46988 \u46308 \u51008  \'93\u45796 \u47480  \u49444 \u44368 \u51088 \u46308 \u50640 \u44172 \u49436  \u44048 \u54868 \u47484  \u48155 \u51648  \u47803 \u54616 \u45912  \u49324 \u46988 \u46308 \u46020  \u48128 \u47084 \u50640  \u51032 \u54616 \u50668  \u44048 \u46041 \u51012  \u48155 \u50520 \u45796 \'94 (S.Bliss, Memoirs of Wm.Miller, p.138). \u44256  \u51613 \u50616 \u54616 \u50688 \u45796 . \u44536 \u51032  \u49444 \u44368 \u45716  \u51068 \u48152  \u45824 \u51473 \u46308 \u50640 \u44172  \u51333 \u44368 \u51201  \u53360  \u49324 \u44148 \u50640  \u45824 \u54616 \u50668  \u44033 \u49457 \u49884 \u53040 \u44256 , \u44536  \u45817 \u49884 \u51032  \u49464 \u49549 \u51201 \u51064  \u44163 \u44284  \u53440 \u46973 \u51032  \u54413 \u51312 \u47484  \u48169 \u51648 \u54644  \u51452 \u50632 \u45796 .\
