\uc0\u51652 \u47532 \u47484  \u44144 \u51208 \u54632 \u51004 \u47196  \u49324 \u46988 \u46308 \u51008  \u44536  \u51652 \u47532 \u51032  \u44540 \u50896 \u46104 \u49884 \u45716  \u54616 \u45208 \u45784 \u51012  \u44144 \u51208 \u54616 \u44172  \u46108 \u45796 . \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51012  \u50976 \u47536 \u54632 \u51004 \u47196  \u44536 \u46308 \u51008  \u50984 \u48277 \u51012  \u51452 \u49888  \u54616 \u45208 \u45784 \u51032  \u44428 \u50948 \u47484  \u48512 \u51064 \u54616 \u44172  \u46108 \u45796 . \u44144 \u51667  \u44368 \u47532 \u50752  \u51060 \u47200 \u51032  \u50864 \u49345 \u51012  \u47564 \u46300 \u45716  \u44163 \u51008  \u47560 \u52824  \u46028 \u51060 \u45208  \u45208 \u47924 \u47196  \u50864 \u49345 \u51012  \u47564 \u46300 \u45716  \u44163 \u47564 \u53372 \u51060 \u45208  \u49772 \u50868  \u51068 \u51060 \u45796 . \u49324 \u45800 \u51008  \u54616 \u45208 \u45784 \u51032  \u49549 \u49457 \u51012  \u51096 \u47803  \u45208 \u53440 \u45252 \u51004 \u47196  \u49324 \u46988 \u46308 \u50640 \u44172  \u54616 \u45208 \u45784 \u51012  \u44144 \u51667 \u46108  \u54408 \u49457 \u51012  \u44032 \u51648 \u49888  \u48516 \u51004 \u47196  \u48127 \u44172  \u54620 \u45796 . \u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u50668 \u54840 \u50752 \u44760 \u49436  \u51340 \u51221 \u54644  \u44228 \u49892  \u47560 \u51020 \u51032  \u51088 \u47532 \u50640  \u52384 \u54617 \u51201  \u50864 \u49345 \u51012  \u50505 \u54784 \u46160 \u44256  \u51080 \u45796 . \u54620 \u54200  \u49332 \u50500  \u44228 \u49888  \u54616 \u45208 \u45784 \u51008  \u45817 \u49888 \u51032  \u47568 \u50432 \u51004 \u47196 , \u44536 \u47532 \u49828 \u46020 \u47484  \u53685 \u54616 \u50668 , \u46608 \u54620  \u52285 \u51312 \u51032  \u50629 \u51201 \u51004 \u47196  \u45817 \u49888 \u51012  \u44228 \u49884 \u54616 \u44256  \u44228 \u49900 \u50640 \u46020  \u48520 \u44396 \u54616 \u44256  \u48520 \u44284  \u49548 \u49688 \u51032  \u49324 \u46988 \u46308 \u47564 \u51060  \u44536 \u48516 \u51012  \u44221 \u48176 \u54620 \u45796 . \u47566 \u51008  \u49324 \u46988 \u46308 \u51060  \u52380 \u50672 \u44228 \u51032  \u54616 \u45208 \u45784 \u51008  \u48512 \u51064 \u54616 \u47732 \u49436  \u52380 \u50672 \u44228 \u47484  \u49888 \u44284  \u44057 \u51060  \u49709 \u48176 \u54620 \u45796 . \u48708 \u47197  \u44536  \u54805 \u49885 \u51008  \u45796 \u47484 \u51648 \u46972 \u46020  \u50715 \u45216  \u50648 \u47532 \u50556  \u45817 \u49884 \u51032  \u44256 \u45824  \u51060 \u49828 \u46972 \u50648  \u49324 \u46988 \u46308  \u49324 \u51060 \u50640  \u51080 \u45912  \u44163 \u44284  \u46609 \u44057 \u51008  \u50864 \u49345 \u49709 \u48176 \u44032  \u50724 \u45720 \u45216 \u51032  \u44536 \u47532 \u49828 \u46020 \u44368 \u44228 \u50640 \u46020  \u51316 \u51116 \u54620 \u45796 . \u49548 \u50948  \u54788 \u47749 \u54616 \u45796 \u44256  \u51088 \u52376 \u54616 \u45716  \u49324 \u46988 \u46308 \u51032  \u49888 , \u52384 \u54617 \u51088 \u50752  \u49884 \u51064 \u44284  \u51221 \u52824 \u44032 \u50752  \u47928 \u54596 \u44032 \u46308 \u51032  \u49888 , \u44368 \u50577  \u51080 \u45716  \u49345 \u47448  \u44228 \u44553 \u51032  \u49888 , \u47566 \u51008  \u45824 \u54617 \u44284  \u49900 \u51648 \u50612  \u50612 \u46500  \u49888 \u54617 \u44368 \u51032  \u49888 \u46308 \u51008  \u54168 \u45768 \u53412 \u50500 \u51032  \u53468 \u50577 \u49888  \u48148 \u50508 \u48372 \u45796  \u48324 \u47196  \u45208 \u51012  \u44163 \u51060  \u50630 \u45796 .\
\uc0\u50724 \u45720 \u45216  \u49888 \u49549 \u55176  \u53664 \u45824 \u47484  \u44396 \u52629 \u54616 \u44256  \u51080 \u45716  \u54788 \u45824 \u51201  \u44368 \u47532 , \u44263  \u49324 \u46988 \u46308 \u51060  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51012  \u45908  \u51060 \u49345  \u51648 \u53420  \u51032 \u47924 \u44032  \u50630 \u45796 \u45716  \u44368 \u47532 \u45716  \u44536 \u47532 \u49828 \u46020 \u44368 \u44228 \u50640 \u49436  \u48155 \u50500 \u46308 \u51064  \u44032 \u51109  \u53360  \u50724 \u47448 \u47196 \u49436 , \u44536 \u44163 \u48372 \u45796  \u54616 \u45208 \u45784 \u51032  \u44428 \u50948 \u47484  \u45908 \u50865  \u45824 \u45812 \u54616 \u44172  \u44277 \u44201 \u54616 \u45716  \u44163 \u51060  \u50630 \u44256  \u44536 \u44163 \u48372 \u45796  \u51060 \u49457  (\u63972 \u24615 ) \u51032  \u47749 \u47161 \u51012  \u45908 \u50865  \u51221 \u47732 \u51004 \u47196  \u48152 \u45824 \u54616 \u45716  \u44163 \u51008  \u50630 \u51004 \u47728  \u44536  \u44208 \u44284 \u48372 \u45796  \u45908 \u50865  \u52824 \u47749 \u51201 \u51064  \u44163 \u51008  \u50630 \u45796 . \u47784 \u46304  \u45208 \u46972 \u50640 \u45716  \u48277 \u47456 \u51060  \u51080 \u50612  \u44536 \u44163 \u51012  \u51316 \u51473 \u54616 \u44256  \u44144 \u44592 \u50640  \u49692 \u51333 \u54616 \u44592 \u47484  \u50836 \u44396 \u54620 \u45796 . \u50612 \u46500  \u51221 \u48512 \u46020  \u48277 \u47456 \u51060  \u50630 \u51004 \u47732  \u51316 \u51116 \u54616 \u51648  \u47803 \u54620 \u45796 . \u44536 \u47111 \u45796 \u47732  \u52380 \u51648 \u51032  \u52285 \u51312 \u51452 \u44760 \u49436  \u45817 \u49888 \u51060  \u47564 \u46300 \u49888  \u54588 \u51312 \u47932 \u46308 \u51012  \u45796 \u49828 \u47540  \u50984 \u48277 \u51012  \u44032 \u51648 \u51648  \u50506 \u51004 \u49512 \u45796 \u44256  \u49373 \u44033 \u54624  \u49688  \u51080 \u45716 \u44032 ? \u50976 \u47749 \u54620  \u47785 \u49324 \u46308 \u51060  \u45208 \u46972 \u47484  \u45796 \u49828 \u47532 \u44256  \u48177 \u49457 \u51032  \u44428 \u47532 \u47484  \u48372 \u54840 \u54616 \u45716  \u48277 \u44508 \u50640  \u45824 \u54616 \u50668  \u44536 \u44163 \u51060  \u48177 \u49457 \u51032  \u51088 \u50976 \u47484  \u44396 \u49549 \u54620 \u45796 \u45716  \u51060 \u50976 \u47196  \u44397 \u48277 \u51012  \u51456 \u49688 \u54624  \u54596 \u50836 \u44032  \u50630 \u45796 \u44256  \u44277 \u44277 \u50672 \u54616 \u44172  \u44032 \u47476 \u52452 \u45796 \u44256  \u49373 \u44033 \u54616 \u47732  \u44536 \u47088  \u49324 \u46988 \u46308 \u51060  \u50620 \u47560 \u45208  \u50724 \u47019 \u46041 \u50504  \u49457 \u51649 \u51088 \u51032  \u51649 \u48516 \u51012  \u50976 \u51648 \u54624  \u49688  \u51080 \u44192 \u45716 \u44032 ? \u44397 \u44032 \u51032  \u48277 \u47456 \u51012  \u47924 \u49884 \u54616 \u50668 \u46020  \u53360  \u48276 \u51396 \u44032  \u46104 \u45716 \u45936  \u47784 \u46304  \u51221 \u48512 \u51032  \u44592 \u52488 \u44032  \u46104 \u45716  \u54616 \u45208 \u45784 \u51032  \u48277 \u51012  \u50976 \u47536 \u54616 \u45716  \u51396 \u45716  \u45908 \u50865  \u51473 \u54616 \u51648  \u50506 \u44192 \u45716 \u44032 ?\
\uc0\u44397 \u44032 \u47196 \u49436 \u46020  \u44536  \u48277 \u47456 \u51012  \u50630 \u50528  \u48260 \u47532 \u44256  \u44397 \u48124 \u51012  \u51228 \u44033 \u44592  \u50896 \u54616 \u45716  \u45824 \u47196  \u54665 \u46041 \u54616 \u46020 \u47197  \u50857 \u45225 \u54624  \u49688  \u50630 \u45716 \u45936  \u50864 \u51452 \u51032  \u53685 \u52824 \u51088 \u51060 \u49888  \u54616 \u45208 \u45784 \u44760 \u49436  \u45817 \u49888 \u51032  \u50984 \u48277 \u51012  \u54224 \u51648 \u54616 \u49884 \u44256  \u51396 \u51064 \u51012  \u51221 \u51396 \u54616 \u44256  \u49692 \u51333 \u54616 \u45716  \u51088 \u47484  \u51032 \u47213 \u45796 \u44256  \u51064 \u51221 \u54616 \u45716  \u54364 \u51456 \u51012  \u50630 \u50528 \u48260 \u47536 \u45796 \u45716  \u44163 \u51008  \u52280 \u51004 \u47196  \u53360  \u47784 \u49692 \u51060  \u50500 \u45776  \u49688  \u50630 \u45796 . \u50864 \u47532 \u45716  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51012  \u54224 \u44592 \u54644  \u48260 \u47532 \u45716  \u44208 \u44284 \u44032  \u50612 \u46496 \u54616 \u45796 \u45716  \u44163 \u51012  \u50508 \u44256  \u51080 \u51648  \u50506 \u51008 \u44032 ? \u44536  \u44208 \u44284 \u45716  \u51060 \u48120  \u51077 \u51613 \u46104 \u50632 \u45796 . \u47924 \u49888 \u47200 \u51060  \u51648 \u48176 \u44428 \u51012  \u51109 \u50501 \u54664 \u45912  \u45817 \u49884 \u51032  \u54532 \u46993 \u49828 \u50640 \u49436  \u51068 \u50612 \u45212  \u51109 \u47732 \u46308 \u51008  \u47924 \u49436 \u50868  \u44163 \u51060 \u50632 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436  \u51221 \u54616 \u49888  \u51228 \u54620 \u50640 \u49436  \u48279 \u50612 \u45208 \u47732  \u44032 \u51109  \u51092 \u51064 \u54620  \u54253 \u44400 \u51032  \u51648 \u48176 \u47484  \u48155 \u44172  \u46108 \u45796 \u45716  \u44163 \u51060  \u44536  \u45817 \u49884 \u51032  \u49464 \u49345 \u50640  \u51613 \u47749 \u46104 \u50632 \u45796 . \u51032 \u51032  \u54364 \u51456 \u51060  \u51228 \u44144 \u46112  \u46412  \u50501 \u