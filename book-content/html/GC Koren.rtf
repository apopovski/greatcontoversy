\uc0\u48148 \u50872 \u51008  \u44264 \u47196 \u49352 \u51064 \u46308 \u50640 \u44172  \u48372 \u45236 \u45716  \u54200 \u51648 \u50640 \u49436  \u54616 \u45208 \u45784 \u51032  \u51088 \u45376 \u46308 \u50640 \u44172  \u51452 \u49888  \u54413 \u49457 \u54620  \u52629 \u48373 \u51012  \u48157 \u54804 \u45796 . \'93\u50864 \u47532 \u46020 \'85\u45320 \u55148 \u47484  \u50948 \u54616 \u50668  \u44592 \u46020 \u54616 \u44592 \u47484  \u44536 \u52824 \u51648  \u50500 \u45768 \u54616 \u44256  \u44396 \u54616 \u45432 \u45768  \u45320 \u55148 \u47196  \u54616 \u50668 \u44552  \u47784 \u46304  \u49888 \u47161 \u54620  \u51648 \u54812 \u50752  \u52509 \u47749 \u50640  \u54616 \u45208 \u45784 \u51032  \u46907 \u51012  \u50500 \u45716  \u44163 \u51004 \u47196  \u52292 \u50864 \u44172  \u54616 \u49884 \u44256  \u51452 \u44760  \u54633 \u45817 \u55176  \u54665 \u54616 \u50668  \u48276 \u49324 \u50640  \u44592 \u49240 \u49884 \u44172  \u54616 \u44256  \u47784 \u46304  \u49440 \u54620  \u51068 \u50640  \u50676 \u47588 \u47484  \u47610 \u44172  \u54616 \u49884 \u47728  \u54616 \u45208 \u45784 \u51012  \u50500 \u45716  \u44163 \u50640  \u51088 \u46972 \u44172  \u54616 \u49884 \u44256  \u44536  \u50689 \u44305 \u51032  \u55192 \u51012  \u51335 \u50500  \u47784 \u46304  \u45733 \u47141 \u51004 \u47196  \u45733 \u54616 \u44172  \u54616 \u49884 \u47728  \u44592 \u49256 \u51004 \u47196  \u47784 \u46304  \u44204 \u46372 \u44284  \u50724 \u47000  \u52280 \u51020 \u50640  \u51060 \u47476 \u44172 \'85\u54616 \u49884 \u44592 \u47484  \u50896 \u54616 \u45432 \u46972 \'94 (\u44264  1:9~11).\
