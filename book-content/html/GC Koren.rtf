\f1\b0 \cf0 \
\uc0\u49440 \u54980  \u54532 \u47532 \u46300 \u47532 \u55176 \u45716  \u47336 \u53552 \u44032  \u54924 \u51032 \u51109 \u50640  \u45208 \u53440 \u45208 \u45716  \u44163 \u51012  \u52488 \u51312 \u55176  \u44592 \u45796 \u47160 \u45796 . \u44536 \u47532 \u44256  \u44536 \u45716  \u44536 \u51032  \u51652 \u49696 \u50640  \u44618 \u51008  \u44048 \u46041 \u51012  \u48155 \u50520 \u45796 . \u44536 \u45716  \u44592 \u49256 \u44284  \u51088 \u46993 \u49828 \u47084 \u50868  \u47560 \u51020 \u51004 \u47196  \u47336 \u53552 \u51032  \u50857 \u44592 \u50752  \u52840 \u52265 \u49457 \u44284  \u54869 \u44256 \u48512 \u46041 \u54620  \u53468 \u46020 \u47484  \u48148 \u46972 \u48372 \u44256 , \u44536 \u47484  \u50745 \u54840 \u54624  \u44208 \u49900 \u51012  \u45908 \u50865  \u44403 \u44172  \u54616 \u50688 \u45796 . \u44536 \u45716  \u45436 \u51137 \u54624  \u46412  \u46160  \u54200 \u51012  \u45824 \u51312 \u54616 \u50668  \u48372 \u44256 , \u48277 \u50773 \u44284  \u50773 \u46308 \u44284  \u51452 \u44368 \u46308 \u51032  \u51648 \u54812 \u46020  \u51652 \u47532 \u51032  \u45733 \u47141  \u50526 \u50640 \u45716  \u50500 \u47924 \u44163 \u46020  \u50500 \u45768 \u46972 \u45716  \u44163 \u51012  \u50508 \u50520 \u45796 . \u51060 \u46412 \u50640  \u48277 \u50773 \u44368 \u45716  \u44536  \u54980  \u44033  \u49884 \u45824 \u47484  \u53685 \u54616 \u50668  \u50668 \u47084  \u45208 \u46972 \u50640  \u50689 \u54693 \u51012  \u45180 \u52832  \u47564 \u53372  \u48516 \u47749 \u54620  \u54056 \u48176 \u47484  \u45817 \u54616 \u50688 \u45796 .\
\uc0\u48277 \u50773 \u51032  \u49324 \u51208 \u51008  \u47336 \u53552 \u51032  \u51652 \u49696 \u47196  \u47568 \u48120 \u50516 \u50500  \u45208 \u53440 \u45212  \u50689 \u54693 \u51012  \u44648 \u45803 \u44256 , \u51204 \u50640  \u50630 \u51060  \u46160 \u47140 \u50892 \u54616 \u50688 \u44256 , \u47196 \u47560 \u51032  \u49464 \u47141 \u51012  \u48372 \u51316 \u54616 \u44592  \u50948 \u54616 \u50668 , \u54624  \u49688  \u51080 \u45716  \u47784 \u46304  \u49688 \u45800 \u51012  \u44053 \u44396 \u54616 \u50668  \u44536  \u44060 \u54785 \u51088 \u47484  \u47736 \u47581 \u49884 \u53412 \u47140 \u44256  \u45432 \u47141 \u54616 \u50688 \u45796 . \u44536 \u45716  \u51088 \u44592 \u51032  \u46021 \u53945 \u54620  \u50885 \u48320 \u44284  \u46832 \u50612 \u45212  \u50808 \u44368 \u51201  \u49688 \u50756 \u51012  \u48156 \u55064 \u54616 \u50668 , \u54620  \u48120 \u52380 \u54620  \u49849 \u47140  \u46412 \u47928 \u50640  \u49464 \u47141  \u51080 \u45716  \u48277 \u50773 \u52397 \u51032  \u50864 \u51032 \u50752  \u51648 \u51648 \u47484  \u55148 \u49373 \u54616 \u45716  \u51068 \u51008  \u50864 \u47588 \u54616 \u44256 \u46020  \u50948 \u54744 \u54620  \u51068 \u51060 \u46972 \u44256  \u51210 \u51008  \u54889 \u51228 \u50640 \u44172  \u50669 \u49444 \u54616 \u50688 \u45796 .\
\uc0\u44536 \u51032  \u47568 \u51008  \u54952 \u44284 \u47484  \u44144 \u46160 \u50632 \u45796 . \u47336 \u53552 \u51032  \u45813 \u48320 \u51060  \u51080 \u51008  \u45796 \u51020 \u45216 , \u52852 \u50508 \u51008  \u49440 \u51312  (\u20808 \u31062 ) \u46308 \u51032  \u51221 \u52293 \u50640  \u46384 \u46972  \u44032 \u53672 \u47533 \u51012  \u51648 \u51648 \u54616 \u44256  \u50745 \u54840 \u54624  \u44208 \u49900 \u51012  \u50508 \u47532 \u45716  \u51088 \u49888 \u51032  \u44368 \u49436 \u47484  \u51032 \u54924 \u50640  \u51228 \u52636 \u54664 \u45796 . \u47336 \u53552 \u44032  \u51088 \u44592 \u51032  \u50724 \u47448 \u50640  \u45824 \u54620  \u52712 \u49548 \u47484  \u44144 \u51208 \u54616 \u50688 \u51004 \u48064 \u47196 , \u44536 \u50752  \u44536 \u44032  \u44032 \u47476 \u52828  \u51060 \u45800 \u49444 \u50640  \u45824 \u54616 \u50668  \u44032 \u51109  \u44053 \u47141 \u54620  \u51312 \u52824 \u44032  \u52712 \u54616 \u50668 \u51656  \u44163 \u51060 \u50632 \u45796 . \'93\u51088 \u44592  \u51088 \u49888 \u51032  \u50612 \u47532 \u49437 \u51020  \u46412 \u47928 \u50640  \u44536 \u47495  \u51064 \u46020 \u46108  \u51068 \u44060  \u49849 \u47140 \u44032  \u44536 \u47532 \u49828 \u46020 \u44368 \u44397 \u51032  \u49888 \u50521 \u51012  \u45824 \u54637 \u54616 \u50668  \u51068 \u50612 \u49456 \u45796 . \u44536 \u47088  \u48520 \u44221 \u44148 \u54620  \u54665 \u50948 \u47484  \u50613 \u51228 \u54616 \u44592  \u50948 \u54616 \u50668  \u45208 \u45716  \u45208 \u51032  \u50689 \u53664 \u50752  \u45208 \u51032  \u51116 \u51221 \u44284  \u45208 \u51032  \u52828 \u44396 \u50752  \u45208 \u51032  \u50977 \u52404 \u50752  \u45208 \u51032  \u54588 \u50752  \u45208 \u51032  \u50689 \u54844 \u44284  \u45208 \u51032  \u49373 \u47749 \u51012  \u55148 \u49373 \u54624  \u44163 \u51060 \u45796 . \u45208 \u45716  \u47676 \u51200  \u50500 \u50864 \u44396 \u49828 \u54000 \u45572 \u49828  \u44368 \u45800 \u51032  \u47336 \u53552 \u47484  \u52628 \u48169 \u54616 \u50668  \u45208 \u46972 \u51032  \u51656 \u49436 \u47484  \u47928 \u46976 \u54616 \u44172  \u54616 \u51648  \u50506 \u46020 \u47197  \u54252 \u44256 \u54620  \u54980 , \u44536 \u50752  \u44536 \u51032  \u51648 \u51648 \u51088 \u46308 \u51012  \u50756 \u44256 \u54620  \u51060 \u45800 \u51004 \u47196  \u44508 \u51221 \u54616 \u50668  \u54028 \u47928 \u54632 \u51004 \u47196  \u44536 \u46308 \u51032  \u49324 \u50629 \u51012  \u51473 \u45800 \u49884 \u53420  \u49104  \u50500 \u45768 \u46972  \u50728 \u44054  \u48169 \u48277 \u51012  \u45796 \u54616 \u50668  \u44536 \u46308 \u51012  \u50630 \u50528 \u48260 \u47532 \u44256 \u51088  \u54620 \u45796 . \u45208 \u45716  \u47784 \u46304  \u51032 \u50896 \u46308 \u51060  \u52649 \u49892 \u54620  \u44536 \u47532 \u49828 \u46020 \u51064 \u51004 \u47196  \u54665 \u46041 \u54644  \u51460  \u44163 \u51012  \u50836 \u44396 \u54616 \u45716  \u48148 \u51060 \u45796 \'94 (D\'92Aubigne, b.7, ch.9). \u44536 \u47111 \u51648 \u47560 \u45716  \u54889 \u51228 \u45716  \u47336 \u53552 \u51032  \u53685 \u54665 \u44428 \u51008  \u48152 \u46300 \u49884  \u51316 \u51473 \u55176  \u50668 \u44200 \u51256 \u50556  \u54624  \u44163 \u51060 \u47728 , \u44536 \u50640  \u45824 \u54620  \u52376 \u48516 \u51060  \u49884 \u54665 \u46104 \u44592  \u51204 \u50640  \u44536 \u44032  \u50504 \u51204 \u54616 \u44172  \u51088 \u44592 \u51032  \u51665 \u51004 \u47196  \u46028 \u50500 \u44032 \u46020 \u47197  \u54728 \u46973 \u46104 \u50612 \u50556  \u54624  \u44163 \u51060 \u46972 \u44256  \u49440 \u50616 \u54616 \u50688 \u45796 .\
\uc0\u51060 \u51228  \u51032 \u50896 \u46308  \u44032 \u50868 \u45936 \u49436 \u45716  \u51204 \u50672  \u48152 \u45824 \u46104 \u45716  \u46160  \u44032 \u51648  \u51452 \u51109 \u51060  \u45824 \u46160 \u46104 \u50632 \u45796 . \u49324 \u51208 \u44284  \u48277 \u50773 \u52769 \u51032  \u45824 \u54364 \u51088 \u46308 \u51008  \u47336 \u53552 \u51032  \u53685 \u54665 \u44428 \u51060  \u47924 \u49884 \u46104 \u50612 \u50556  \u54620 \u45796 \u44256  \u51452 \u51109 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u47560 \u52824  \u48177  \u45380  \u51204 \u51032  \'93\u50560  \u54980 \u49828 \u52376 \u47100  \u44536 \u51032  \u47800 \u51012  \u53468 \u50868  \u51116 \u47484  \u46972 \u51064 \u44053 \u50640  \u49100 \u47140 \u50556  \u54620 \u45796 \'94 (D\'92Aubigne, b.7, ch.9) \u44256  \u44053 \u47141 \u55176  \u51452 \u51109 \u54616 \u50688 \u45796 . \u44536 \u47088 \u45936  \u46021 \u51068 \u51032  \u51228 \u54980  (\u35576 \u20399 ) \u46308 \u51008  \u48708 \u47197  \u48277 \u50773 \u45817 \u51060 \u50836  \u47336 \u53552 \u47484  \u45824 \u51201 \u54616 \u45716  \u49324 \u46988 \u46308 \u51060 \u50632 \u51648 \u47560 \u45716 , \u51060 \u50752  \u44057 \u51008  \u51312 \u52824 \u44032  \u45208 \u46972 \u51032  \u47749 \u50696 \u47484  \u49688 \u52824 \u49828 \u47101 \u44172  \u54616 \u45716  \u51068 \u51060 \u46972  \u54616 \u50668  \u44536 \u52376 \u47100  \u44277 \u51473 \u51032  \u49888 \u51032 \u47484  \u47924 \u49884 \u54616 \u45716  \u51068 \u51012  \u48152 \u45824 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u54980 \u49828 \u44032  \u51453 \u51008  \u54980 \u50640  \u44228 \u49549 \u54616 \u50668  \u51068 \u50612 \u45212  \u51116 \u45212 \u46308 \u51012  \u51648 \u51201 \u54616 \u44256 , \u51060 \u50752  \u44057 \u51008  \u46160 \u47140 \u50868  \u51116 \u45212 \u51060  \u46021 \u51068  \u45208 \u46972 \u50752  \u44536 \u46308 \u51032  \u50672 \u49548 \u54620  \u54889 \u51228 \u50640 \u44172  \u48152 \u48373 \u46104 \u45716  \u44163 \u51012  \u51339 \u50500 \u54616 \u51648  \u50506 \u45716 \u45796 \u44256  \u47568 \u54616 \u50688 \u45796 .\
\uc0\u52852 \u50508  \u51088 \u49888 \u46020  \u44536  \u51320 \u47148  (\u25305 \u21155 ) \u54620  \u51228 \u51032 \u50640  \u45824 \u54616 \u50668  \u51060 \u47111 \u44172  \u45824 \u45813 \u54616 \u50688 \u45796 . \'93\u48708 \u47197  \u50728  \u49464 \u44228 \u50640 \u49436  \u49888 \u51032 \u50752  \u47749 \u50696 \u44032  \u44536  \u44536 \u47548 \u51088 \u51312 \u52264  \u50630 \u50612 \u51276 \u45796  \u54624 \u51648 \u46972 \u46020 , \u51060  \u46160  \u44032 \u51648 \u45716  \u50773 \u54980  (\u29579 \u20399 ) \u50752  \u50689 \u51452 \u46308 \u51032  \u49900 \u51473 \u50640 \u49436  \u54588 \u45212 \u52376 \u47484  \u52286 \u50500 \u50556  \u54624  \u44163 \u51060 \u45796 \'94 (D\'92Aubigne, b.7, ch.9). \u47336 \u53552 \u51032  \u44053 \u44221 \u54620  \u50896 \u49688 \u46308 \u51064  \u48277 \u50773  \u52769 \u50640 \u49436 \u45716  \u49884 \u44592 \u49828 \u47928 \u53944 \u44032  \u54980 \u49828 \u50640 \u44172  \u54665 \u54620  \u44163 \u52376 \u47100  \u47336 \u53552 \u47484  \u52376 \u52824 \u54616 \u46020 \u47197  \u44368 \u54924 \u51032  \u52376 \u49324 \u50640  \u51068 \u51076 \u54644 \u51452 \u44592 \u47484  \u54889 \u51228 \u50640 \u44172  \u50668 \u51204 \u55176  \u44053 \u52397 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u52852 \u50508  5\u49464 \u45716  \u54980 \u49828 \u44032  \u44277 \u51473  \u50526 \u50640 \u49436  \u51088 \u44592 \u47484  \u44208 \u48149 \u54620  \u49324 \u49836 \u51012  \u44032 \u47532 \u53412 \u47732 \u49436  \u54889 \u51228 \u50640 \u44172  \u49888 \u51076 \u54624  \u49688  \u50630 \u45716  \u44536 \u51032  \u52376 \u49324 \u47484  \u49373 \u44033 \u45208 \u44172  \u54664 \u45912  \u44305 \u44221 \u51012  \u49345 \u49345 \u54616 \u44256 , \'93\u45208 \u45716  \u49884 \u44592 \u49828 \u47928 \u53944 \u52376 \u47100  \u50620 \u44404 \u51060  \u48521 \u50612 \u51648 \u44592 \u47484  \u50896 \u52824  \u50506 \u45716 \u45796 \'94 (Lenfant, vol.1, p.422) \u44256  \u50616 \u47749 \u54616 \u50688 \u45796 .\
\uc0\u44536 \u47084 \u45208  \u52852 \u50508 \u51008  \u47336 \u53552 \u44032  \u51228 \u49884 \u54644  \u51456  \u51652 \u47532 \u47484  \u44256 \u51032 \u51201 \u51004 \u47196  \u44144 \u51208 \u54616 \u50688 \u45796 . \u44536 \u47532 \u44256  \u44536 \u45716  \'93\u45208 \u45716  \u49440 \u51312 \u46308 \u51032  \u47784 \u48376 \u51012  \u46384 \u47476 \u44592 \u47196  \u44403 \u44172  \u44208 \u49900 \u54616 \u45432 \u46972 \'94 (D\'92Aubigne, b.7, ch.9) \u44256  \u44592 \u47197 \u54616 \u50688 \u45796 . \u44536 \u45716  \u51333 \u47000 \u50640  \u54665 \u54616 \u50668  \u50724 \u45912  \u44288 \u49845 \u50640 \u49436  \u54620  \u44152 \u51020 \u46020  \u48279 \u50612 \u45208 \u44592 \u47484  \u50896 \u52824  \u50506 \u51012  \u49104  \u50500 \u45768 \u46972 , \u51652 \u47532 \u50752  \u51221 \u51032 \u51032  \u44600 \u51012  \u46384 \u47476 \u45716  \u45936  \u51080 \u50612 \u49436 \u44620 \u51648 \u46020  \u44536 \u47111 \u44172  \u54616 \u44592 \u47196  \u44208 \u49900 \u54616 \u50688 \u45796 . \u44536 \u45716  \u44536 \u51032  \u49440 \u51312 \u46308 \u51060  \u44536 \u47111 \u44172  \u54616 \u50688 \u44592  \u46412 \u47928 \u50640 , \u48708 \u47197  \u48277 \u50773 \u44368 \u44032  \u51092 \u51064 \u54616 \u44256  \u48512 \u54056 \u54616 \u50688 \u45908 \u46972 \u46020  \u44536 \u44163 \u51012  \u51025 \u50896 \u54624  \u44208 \u49900 \u51012  \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u45716  \u44536 \u51032  \u49440 \u51312 \u46308 \u51060  \u48155 \u50500 \u46308 \u51064  \u44163 \u48372 \u45796  \u54620  \u44152 \u51020  \u45908  \u50526 \u49436 \u49436  \u48731 \u51012  \u48155 \u50500 \u46308 \u51060 \u51648 \u46020  \u50506 \u44256 , \u44536 \u46308 \u51060  \u54665 \u54616 \u51648  \u50506 \u51008  \u50612 \u46500  \u51032 \u47924 \u47484  \u54665 \u54616 \u51648 \u46020  \u50506 \u44192 \u45796 \u45716  \u53468 \u46020 \u47484  \u52712 \u54616 \u50688 \u45796 .\
\pard\pardeftab720\sa319\partightenfactor0

\f0\b \cf0 \uc0\u51652 \u47532 \u47484  \u48512 \u51064 \u54620  \u52852 \u50508  5\u49464 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u50724 \u45720 \u45216 \u46020  \u44536 \u50752  \u44057 \u51060  \u49440 \u51312 \u46308 \u51032  \u44288 \u49845 \u44284  \u51204 \u53685 \u51012  \u44403 \u44172  \u51648 \u53412 \u45716  \u51088 \u46308 \u51060  \u47566 \u45796 . \u51452 \u45784 \u44760 \u49436  \u44536 \u46308 \u50640 \u44172  \u45908 \u50865  \u44305 \u47749 \u54620  \u48731 \u51012  \u48708 \u52656 \u51452 \u49892  \u46412 \u50640  \u44536 \u46308 \u51008  \u44536 \u44163 \u51012  \u48155 \u50500 \u46308 \u51060 \u44592 \u47484  \u44144 \u48512 \u54620 \u45796 . \u44536 \u46308 \u51008  \u44536 \u46308 \u51032  \u49440 \u51312 \u46308 \u51060  \u44536  \u48731 \u51012  \u48155 \u50500 \u46308 \u51060 \u51648  \u50506 \u50520 \u45796 \u45716  \u51060 \u50976 \u50640 \u49436  \u44536 \u47111 \u44172  \u54620 \u45796 . \u50864 \u47532 \u45716  \u44536 \u47084 \u54620  \u49440 \u51312 \u46308 \u51032  \u52376 \u51648 \u47196  \u46028 \u50500 \u44032 \u49436 \u45716  \u50504  \u46108 \u45796 . \u50864 \u47532 \u46308 \u51032  \u51032 \u47924 \u50752  \u52293 \u51076 \u51008  \u44536 \u46308 \u51032  \u44163 \u44284  \u46041 \u51068 \u54620  \u44163 \u51060  \u50500 \u45768 \u45796 . \u51652 \u47532 \u51032  \u47568 \u50432 \u51012  \u50864 \u47532  \u49828 \u49828 \u47196  \u53456 \u44396 \u54644  \u48372 \u51648  \u50506 \u44256  \u50724 \u47196 \u51648  \u44536  \u49440 \u51312 \u46308 \u51032  \u47784 \u48376 \u50640  \u51032 \u54616 \u50668  \u51088 \u44592 \u51032  \u51032 \u47924 \u50752  \u52293 \u51076 \u51012  \u51060 \u54665 \u54616 \u47140 \u45716  \u51088 \u46308 \u51008  \u54616 \u45208 \u45784 \u51032  \u44592 \u48848 \u54616 \u49900 \u51012  \u51077 \u51012  \u49688 \u44032  \u50630 \u45796 . \u50864 \u47532 \u46308 \u51032  \u51032 \u47924 \u50752  \u52293 \u51076 \u51008  \u49440 \u51312 \u46308 \u51032  \u44163 \u48372 \u45796  \u54620 \u52789  \u45908  \u51473 \u54616 \u45796 . \u50864 \u47532 \u45716  \u49440 \u51312 \u46308 \u47196 \u48512 \u53552  \u47932 \u47140 \u48155 \u51008  \u48731 \u50640  \u45824 \u54616 \u50668 \u46020  \u52293 \u51076 \u51060  \u51080 \u51648 \u47564  \u45908 \u50865 \u51060  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51012  \u53685 \u54616 \u50668  \u50864 \u47532 \u50640 \u44172  \u48708 \u52712 \u44256  \u51080 \u45716  \u45908 \u50865  \u48157 \u51008  \u48731 \u50640  \u45824 \u54616 \u50668  \u52293 \u51076 \u51060  \u51080 \u45796 .\
\uc0\u48127 \u51648  \u50506 \u45716  \u50976 \u45824 \u51064 \u46308 \u50640 \u44172  \u50696 \u49688 \u45784 \u44760 \u49436 \u45716  \'93\u45236 \u44032  \u50752 \u49436  \u51200 \u55148 \u50640 \u44172  \u47568 \u54616 \u51648  \u50500 \u45768 \u54616 \u50688 \u45908 \u47732  \u51396 \u44032  \u50630 \u50632 \u51004 \u47140 \u45768 \u50752  \u51648 \u44552 \u51008  \u44536  \u51396 \u47484  \u54609 \u44228 \u54624  \u49688  \u50630 \u45712 \u45768 \u46972 \'94 (\u50836  15:22) \u44256  \u47568 \u50432 \u54616 \u49512 \u45796 . \u44536  \u44057 \u51008  \u44144 \u47337 \u54620  \u45733 \u47141 \u51008  \u47336 \u53552 \u47484  \u53685 \u54616 \u50668  \u46021 \u51068 \u51032  \u54889 \u51228 \u50752  \u51228 \u54980 \u46308 \u50640 \u44172 \u46020  \u51204 \u54616 \u50668 \u51276 \u45796 . \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51060  \u48731 \u51012  \u48708 \u52628 \u44172  \u46104 \u51088  \u49457 \u47161 \u44760 \u49436 \u45716  \u44144 \u44592 \u50640  \u47784 \u51064  \u47566 \u51008  \u49324 \u46988 \u46308 \u50640 \u44172  \u47560 \u51648 \u47561 \u51004 \u47196  \u53444 \u50896 \u54616 \u49512 \u45796 . \u47560 \u52824  \u48716 \u46972 \u46020 \u44032  \u52380 \u50668  \u45380  \u51204 \u50640  \u51088 \u44592 \u51032  \u51088 \u51316 \u49900 \u51012  \u50976 \u51648 \u54616 \u44256  \u51064 \u47581 \u51012  \u50619 \u44592  \u50948 \u54616 \u50668  \u47560 \u51020 \u51032  \u47928 \u51012  \u45803 \u44256  \u44396 \u51452 \u51032  \u47568 \u50432 \u51012  \u51200 \u48260 \u47536  \u44163 \u52376 \u47100 , \u48296 \u47533 \u49828 \u44032  \u46160 \u47140 \u50892  \u46504 \u47732 \u49436  \'93\u49884 \u48169 \u51008  \u44032 \u46972  \u45236 \u44032  \u53960 \u51060  \u51080 \u51004 \u47732  \u45320 \u47484  \u48512 \u47476 \u47532 \u46972 \'94 (\u54665  24:25) \u44256  \u51652 \u47532 \u51032  \u49324 \u51088 \u50640 \u44172  \u47568 \u54620  \u44163 \u52376 \u47100 , \u44368 \u47564 \u54620  \u50500 \u44536 \u47549 \u48148 \u44032  \'93\u45208 \u47484  \u44428 \u54616 \u50668  \u44536 \u47532 \u49828 \u46020 \u51064 \u51060  \u46104 \u44172  \u54616 \u47140  \u54616 \u45716 \u46020 \u45796 \'94 (\u54665  26:28) \u44256  \u44256 \u48177 \u54616 \u47732 \u49436  \u54616 \u45720 \u51060  \u48372 \u45240  \u44592 \u48324 \u51012  \u48176 \u52377 \u54620  \u44163 \u52376 \u47100 , \u52852 \u50508  5\u49464 \u46020  \u49464 \u49549 \u51201  \u51088 \u51316 \u49900 \u44284  \u51221 \u52293 \u49345  \u54596 \u50836 \u50640  \u46384 \u46972  \u51652 \u47532 \u51032  \u48731 \u51012  \u44144 \u48512 \u54616 \u44592 \u47196  \u51089 \u51221 \u54616 \u50688 \u45796 .\
