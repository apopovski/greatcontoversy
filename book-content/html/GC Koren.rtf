\f0\b \cf0 \uc0\u51032 \u54924 \u50640  \u45208 \u50724 \u46972 \u45716  \u47749 \u47161 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u48708 \u47197  \u47336 \u53552  \u51088 \u49888 \u51060  \u44144 \u44592 \u50640  \u51080 \u50632 \u45908 \u46972 \u46020  \u47196 \u47560 \u44368 \u51032  \u50501 \u54224 \u50640  \u45824 \u54616 \u50668  \u51060 \u52376 \u47100  \u51201 \u44537 \u51201 \u51060 \u44256  \u44053 \u47141 \u54620  \u44277 \u44201 \u51012  \u54624  \u49688  \u50630 \u50632 \u51012  \u44163 \u51060 \u45796 . \u44536 \u47088 \u45936  \u44536  \u50672 \u49324 \u45716  \u44060 \u54785 \u51088 \u51032  \u44053 \u47141 \u54620  \u50896 \u49688 \u50688 \u51004 \u48064 \u47196  \u44536 \u51032  \u47568 \u51008  \u54620 \u52789  \u45908  \u53360  \u54952 \u44284 \u47484  \u45236 \u50632 \u45796 .\
\uc0\u47564 \u51068  \u51060  \u46412 \u50640  \u54924 \u51473 \u51032  \u45576 \u51060  \u50676 \u47532 \u50632 \u45796 \u47732 , \u44536 \u46308 \u51008  \u54616 \u45208 \u45784 \u51032  \u52380 \u49324 \u46308 \u51060  \u44536 \u46308  \u51473 \u50640  \u49436 \u49436  \u50724 \u47448 \u51032  \u50516 \u55121 \u51012  \u47932 \u47532 \u52432  \u48260 \u47532 \u44256  \u44305 \u47749 \u54620  \u48731 \u51012  \u48372 \u45236 \u50612  \u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u51012  \u51652 \u47532 \u47484  \u47582 \u50500 \u46308 \u51060 \u46020 \u47197  \u50676 \u50612  \u51452 \u45716  \u44305 \u44221 \u51012  \u48372 \u50520 \u51012  \u44163 \u51060 \u45796 . \u44060 \u54785  \u49324 \u50629 \u51032  \u48152 \u45824 \u51088 \u46308 \u44620 \u51648 \u46020  \u51648 \u48176 \u54616 \u50668 , \u48148 \u50556 \u55120 \u47196  \u49457 \u52712 \u46104 \u47140 \u45716  \u45824 \u49324 \u50629 \u51032  \u44600 \u51012  \u50696 \u48708 \u54620  \u44163 \u51008  \u51652 \u47532 \u50752  \u51648 \u54812 \u51032  \u44540 \u50896 \u46104 \u49884 \u45716  \u54616 \u45208 \u45784 \u51032  \u45733 \u47141 \u51060 \u50632 \u45796 . \u47560 \u54004  \u47336 \u53552 \u45716  \u44536  \u51088 \u47532 \u50640  \u52280 \u49437 \u54616 \u51648  \u50500 \u45768 \u54616 \u50688 \u51004 \u45208  \u47336 \u53552 \u48372 \u45796  \u45908 \u50865  \u50948 \u45824 \u54616 \u49888  \u54616 \u45208 \u45784 \u51032  \u49548 \u47532 \u44032  \u44536  \u54924 \u51032 \u51109 \u50640  \u46308 \u47160 \u45912  \u44163 \u51060 \u45796 .\
\uc0\u51032 \u54924 \u45716  \u48277 \u50773 \u44368 \u44032  \u46021 \u51068  \u44397 \u48124 \u50640 \u44172  \u44284 \u54620  \u47561 \u51473 \u54620  \u50613 \u50517  \u49345 \u54889 \u51012  \u51312 \u49324 \u54624  \u51032 \u50896 \u46308 \u51012  \u51593 \u49884  \u51076 \u47749 \u54616 \u50688 \u45796 . \u48177  \u54620  \u44032 \u51648 \u51032  \u51312 \u47785 \u51004 \u47196  \u46108  \u47749 \u49464 \u49436 \u44032  \u44536  \u50501 \u54224 \u47484  \u51593 \u49884  \u44368 \u51221 \u54644  \u45804 \u46972 \u44256  \u50836 \u52397 \u54616 \u45716  \u49436 \u47448 \u50752  \u54632 \u44760  \u54889 \u51228 \u50640 \u44172  \u51228 \u52636 \u46104 \u50632 \u45796 . \u44536  \u53444 \u50896 \u51088 \u46308 \u51008  \u45796 \u51020 \u44284  \u44057 \u51060  \u51652 \u49696 \u54616 \u50688 \u45796 . \'93\u44536 \u47532 \u49828 \u46020 \u44368 \u44397 \u51032  \u50689 \u51201  \u47672 \u47532 \u44032  \u44536 \u52376 \u47100  \u52628 \u47928  \u44032 \u50868 \u45936  \u47931 \u54784  \u51080 \u45796 \u45716  \u44163 \u51008  \u44536 \u47532 \u49828 \u46020 \u51064 \u46308 \u51032  \u50689 \u54844 \u50640  \u50620 \u47560 \u45208  \u53360  \u49552 \u49892 \u51060 \u47728  \u52840 \u54644 \u51077 \u45768 \u44620 ! \u50864 \u47532  \u48124 \u51313 \u51032  \u54028 \u47736 \u44284  \u52824 \u50837 \u51012  \u48169 \u51648 \u54616 \u45716  \u44163 \u51060  \u50864 \u47532 \u51032  \u51032 \u47924 \u51077 \u45768 \u45796 . \u44536 \u47084 \u48064 \u47196  \u50864 \u47532 \u45716  \u54224 \u54616 \u44760 \u49436  \u51204 \u48152 \u51201 \u51064  \u44060 \u54785 \u51012  \u47749 \u47161 \u54644  \u51452 \u49884 \u44256 , \u44536  \u51060 \u54665 \u51012  \u48372 \u51613 \u54616 \u50668  \u51452 \u49884 \u44592 \u47484  \u44032 \u51109  \u44216 \u49552 \u54616 \u44256  \u44036 \u51208 \u54616 \u44172  \u53444 \u50896 \u54616 \u45716  \u48148 \u51077 \u45768 \u45796 \'94 (D\'92Aubigne, b.7, ch.4).\
\uc0\u51032 \u54924 \u45716  \u51060 \u51228  \u47336 \u53552 \u50640 \u44172  \u44536 \u46308  \u50526 \u50640  \u52636 \u46160 \u54616 \u46972 \u44256  \u50836 \u44396 \u54616 \u50688 \u45796 . \u50508 \u47532 \u50504 \u45908 \u51032  \u53444 \u50896 \u44284  \u48152 \u45824 \u50752  \u50948 \u54801 \u50640 \u46020  \u48520 \u44396 \u54616 \u44256 , \u47560 \u52840 \u45236  \u54889 \u51228 \u45716  \u44144 \u44592 \u50640  \u46041 \u51032 \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u47336 \u53552 \u45716  \u51032 \u54924 \u50640  \u52636 \u46160 \u54616 \u46020 \u47197  \u49548 \u54872 \u46104 \u50632 \u45796 . \u44536 \u47532 \u44256  \u47336 \u53552 \u45716  \u49548 \u54872  \u47749 \u47161 \u51012  \u48155 \u45716  \u46041 \u49884 \u50640  \u50504 \u51204 \u54620  \u51109 \u49548 \u47196  \u46028 \u50500 \u44032 \u45716  \u51068 \u51012  \u48372 \u51613 \u54644  \u51452 \u45716  \u53685 \u54665 \u44428 \u46020  \u48155 \u50520 \u45796 . \u51060  \u53685 \u54665 \u44428 \u51008  \u44536 \u47484  \u48372 \u47492 \u49828 \u47196  \u45936 \u47532 \u44256  \u50732  \u49324 \u47749 \u51012  \u48155 \u51008  \u51204 \u47161 \u44288 \u51012  \u53685 \u54616 \u50668  \u48708 \u53584 \u48288 \u47476 \u53356 \u50640  \u51204 \u45804 \u46104 \u50632 \u45796 .\
\uc0\u47336 \u53552 \u51032  \u52828 \u44396 \u46308 \u51008  \u47588 \u50864  \u45440 \u46972 \u44256  \u44256 \u48124 \u54616 \u44172  \u46104 \u50632 \u45796 . \u44536 \u46308 \u51008  \u47336 \u53552 \u44032  \u54200 \u44204 \u44284  \u51201 \u51032  (\u25973 \u24847 ) \u47484  \u48155 \u44256  \u51080 \u45716  \u44163 \u51012  \u50508 \u48064 \u47196  \u48708 \u47197  \u44536 \u44032  \u53685 \u54665 \u44428 \u51012  \u44032 \u51276 \u45796  \u54616 \u45908 \u46972 \u46020  \u44536 \u44163 \u51060  \u47924 \u49884 \u45817 \u54616 \u51648  \u50506 \u51012 \u44620  \u50684 \u47140 \u54616 \u50668  \u44536 \u50640 \u44172  \u49373 \u47749 \u51012  \u50948 \u53468 \u47213 \u44172  \u54616 \u51648  \u47568 \u46972 \u44256  \u44036 \u50896 \u54616 \u50688 \u45796 . \u44536 \u47084 \u51088  \u44536 \u45716  \u45824 \u45813 \u54616 \u50688 \u45796 . \'93\u48277 \u50773 \u45817 \u51060  \u48148 \u46972 \u45716  \u44163 \u51008  \u45236 \u44032  \u48372 \u47492 \u49828 \u50640  \u44032 \u45716  \u44163 \u51060  \u50500 \u45768 \u46972  \u45208 \u51032  \u51221 \u51396 \u50752  \u45208 \u51032  \u51453 \u51020 \u51060 \u45796 . \u44536 \u47084 \u45208  \u44536 \u44163 \u51008  \u47928 \u51228 \u44032  \u46104 \u51648  \u50506 \u45716 \u45796 . \u45208 \u47484  \u50948 \u54616 \u50668  \u44592 \u46020 \u54616 \u51648  \u47568 \u44256 , \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51012  \u50948 \u54616 \u50668  \u44592 \u46020 \u54616 \u46972 . \'85\u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u49457 \u47161 \u51012  \u45236 \u44172  \u51452 \u49492 \u49436  \u44536  \u50724 \u47448 \u51032  \u49324 \u51088 \u46308 \u51012  \u51060 \u44592 \u44172  \u54616 \u49892  \u44163 \u51060 \u45796 . \u45208 \u45716  \u45208 \u51032  \u51068 \u49373 \u51012  \u53685 \u54616 \u50668  \u44536 \u46308 \u51012  \u47736 \u49884 \u54620 \u45796 . \u45208 \u45716  \u51453 \u51020 \u51004 \u47196 \u50024  \u44536 \u46308 \u50640 \u44172  \u49849 \u47532 \u54624  \u44163 \u51060 \u45796 . \u44536 \u46308 \u51008  \u48372 \u47492 \u49828 \u50640 \u49436  \u45236 \u44172  \u49888 \u50521 \u51032  \u52712 \u49548 \u47484  \u44053 \u50836 \u54616 \u44592  \u50948 \u54616 \u50668  \u44305 \u48516 \u54616 \u44256  \u51080 \u45796 . \u45208 \u51032  \u52712 \u49548 \u45716  \u45796 \u51020 \u44284  \u44057 \u51012  \u44163 \u51060 \u45796 . \u45208 \u45716  \u51204 \u50640  \u48277 \u50773 \u51012  \u44536 \u47532 \u49828 \u46020 \u51032  \u45824 \u47532 \u51088 \u46972 \u44256  \u47568 \u54616 \u50688 \u51648 \u47564  \u51060 \u51228 \u48512 \u53552  \u45208 \u45716  \u48277 \u50773 \u51008  \u50864 \u47532  \u51452 \u45784 \u51032  \u45824 \u51201 \u51060 \u50836 , \u47560 \u44480 \u51032  \u49324 \u46020 \u46972 \u44256  \u51452 \u51109 \u54620 \u45796 \'94 (D\'92Aubigne, b.7, ch.6).\
\uc0\u47336 \u53552 \u45716  \u54844 \u51088 \u49436  \u44536  \u50948 \u54744 \u54620  \u50668 \u54665 \u51012  \u54616 \u51648 \u45716  \u50506 \u44172  \u46112  \u44163 \u51060 \u50632 \u45796 . \u54889 \u51228 \u51032  \u51204 \u47161 \u44288  \u50808 \u50640  \u51652 \u49892 \u54620  \u49464  \u52828 \u44396 \u44032  \u44536 \u50752  \u46041 \u54665 \u54616 \u44592 \u47196  \u44208 \u49900 \u54616 \u50688 \u45796 . \u47708 \u46976 \u55176 \u53668 \u46020  \u51068 \u54665 \u50640  \u52280 \u44032 \u54616 \u44592 \u47484  \u50676 \u47581 \u54616 \u50688 \u45796 . \u44536 \u51032  \u47560 \u51020 \u51008  \u47336 \u53552 \u51032  \u47560 \u51020 \u44284  \u44208 \u54633 \u46104 \u50612  \u51080 \u50632 \u51004 \u48064 \u47196  \u44536 \u45716  \u47336 \u53552 \u50752  \u46041 \u54665 \u54616 \u44592 \u47484  \u44036 \u51208 \u55176  \u48148 \u46992 \u51004 \u47728 , \u44221 \u50864 \u50640  \u46384 \u46972 \u49436 \u45716  \u50725 \u50640  \u44039 \u55176 \u44144 \u45208  \u51453 \u45716  \u44163 \u44620 \u51648 \u46020  \u44048 \u49688 \u54616 \u44592 \u47196  \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u51032  \u44036 \u52397 \u51008  \u54728 \u46973 \u46104 \u51648  \u50500 \u45768 \u54616 \u50688 \u45796 . \u47336 \u53552 \u44032  \u51453 \u51004 \u47732  \u44060 \u54785  \u49324 \u50629 \u51032  \u55148 \u47581 \u51008  \u44536 \u51032  \u51210 \u51008  \u46041 \u50669 \u51088 \u50640 \u44172  \u45804 \u47140  \u51080 \u50632 \u45796 . \u47336 \u53552 \u46020  \u47708 \u46976 \u55176 \u53668 \u44284  \u51089 \u48324 \u54616 \u47732 \u49436  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u54616 \u50688 \u45796 . \'93\u47564 \u51068  \u45208 \u51032  \u50896 \u49688 \u46308 \u51060  \u45208 \u47484  \u51453 \u51060 \u48064 \u47196  \u45236 \u44032  \u45796 \u49884  \u46028 \u50500 \u50724 \u51648  \u47803 \u54624 \u51648 \u46972 \u46020 , \u44536 \u45824 \u45716  \u44228 \u49549 \u54644 \u49436  \u51652 \u47532 \u47484  \u49444 \u47749 \u54616 \u44256 , \u51652 \u47532 \u50640  \u44403 \u44172  \u49436 \u50556  \u54620 \u45796 . \u45208 \u47484  \u45824 \u49888 \u54616 \u50668  \u51068 \u54644  \u51452 \u44172 . \'85\u44536 \u45824 \u44032  \u49332 \u50500  \u51080 \u44592 \u47564  \u54616 \u47732 , \u45208 \u51032  \u51453 \u51020 \u51008  \u48324 \u48152  \u45824 \u49688 \u47213 \u51648  \u47803 \u54620  \u44163 \u51060  \u46112  \u44163 \u51060 \u45796 \'94 (D\'92Aubigne, b.7, ch.7). \u47336 \u53552 \u44032  \u46496 \u45208 \u45716  \u44163 \u51012  \u48372 \u44592  \u50948 \u54616 \u50668  \u47784 \u50688 \u45912  \u54617 \u49373 \u46308 \u44284  \u49884 \u48124 \u46308 \u51008  \u44618 \u51008  \u44048 \u46041 \u51012  \u48155 \u50520 \u45796 . \u48373 \u51020 \u51004 \u47196  \u47568 \u48120 \u50516 \u50500  \u44048 \u46041 \u46108  \u47924 \u49688 \u54620  \u49324 \u46988 \u46308 \u51008  \u45576 \u47932 \u51012  \u55128 \u47532 \u47732 \u49436  \u44536 \u50752  \u51089 \u48324  \u51064 \u49324 \u47484  \u54616 \u50688 \u45796 . \u51060 \u47532 \u54616 \u50668  \u44060 \u54785 \u51088 \u50752  \u44536 \u51032  \u51068 \u54665 \u51008  \u48708 \u53584 \u48288 \u47476 \u53356 \u47484  \u46496 \u45228 \u45796 .\
