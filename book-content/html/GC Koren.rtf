\f0\b \cf0 \uc0\u47532 \u49828 \u48376  \u45824 \u51648 \u51652  (\u51116 \u47548 \u51032  \u51669 \u51312  1)\
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u50696 \u50616 \u51008  \u44536 \u47532 \u49828 \u46020 \u51032  \u51116 \u47548 \u51032  \u47785 \u51201 \u44284  \u44305 \u44221 \u51012  \u47568 \u54644  \u51460  \u49104  \u50500 \u45768 \u46972  \u44536  \u49324 \u44148 \u51060  \u44032 \u44620 \u51060  \u50724 \u44256  \u51080 \u45796 \u45716  \u44163 \u51012  \u49324 \u46988 \u46308 \u50640 \u44172  \u50508 \u47140  \u51452 \u45716  \u51669 \u51312 \u46020  \u45208 \u53440 \u45236  \u51456 \u45796 . \u50696 \u49688 \u44760 \u49436 \u45716  \u46608 \u54620  \'93\u51068 \u50900 \u49457 \u49888 \u50640 \u45716  \u51669 \u51312 \u44032  \u51080 \u44192 \u44256 \'94 (\u45573  21:25), \'93\u54644 \u44032  \u50612 \u46160 \u50892 \u51648 \u47728  \u45804 \u51060  \u48731 \u51012  \u45236 \u51648  \u50500 \u45768 \u54616 \u47728  \u48324 \u46308 \u51060  \u54616 \u45720 \u50640 \u49436  \u46504 \u50612 \u51648 \u47728  \u54616 \u45720 \u50640  \u51080 \u45716  \u44428 \u45733 \u46308 \u51060  \u55124 \u46308 \u47532 \u47532 \u46972  \u44536  \u46412 \u50640  \u51064 \u51088 \u44032  \u44396 \u47492 \u51012  \u53440 \u44256  \u53360  \u44428 \u45733 \u44284  \u50689 \u44305 \u51004 \u47196  \u50724 \u45716  \u44163 \u51012  \u49324 \u46988 \u46308 \u51060  \u48372 \u47532 \u46972 \'94 (\u47561  13:24~26) \u44256  \u47568 \u50432 \u54616 \u49512 \u45796 . \u50836 \u54620 \u44228 \u49884 \u47197 \u51032  \u44592 \u51088 \u51064  \u50836 \u54620 \u51008  \u51116 \u47548  \u51204 \u50640  \u45208 \u53440 \u45216  \u52395 \u51704  \u51669 \u51312 \u47196  \'93\u53360  \u51648 \u51652 \u51060  \u45208 \u47728  \u54644 \u44032  \u52509 \u45812 \u44057 \u51060  \u44160 \u50612 \u51648 \u44256  \u50728  \u45804 \u51060  \u54588 \u44057 \u51060  \u46104 \u47728  \'85\'94 (\u44228  6:12) \u46972 \u44256  \u44592 \u47197 \u54616 \u50688 \u45796 .\
\uc0\u51060  \u51669 \u51312 \u46308 \u51008  19\u49464 \u44592 \u44032  \u49884 \u51089 \u46104 \u44592  \u51204 \u50640  \u45208 \u53440 \u45228 \u45796 . \u44536  \u50696 \u50616 \u51032  \u49457 \u52712 \u47196 \u49436  1755\u45380 \u50640  \u51068 \u52237 \u51060  \u44592 \u47197 \u46108  \u44163  \u51473 \u50640 \u49436  \u44032 \u51109  \u47924 \u49436 \u50868  \u51648 \u51652 \u51060  \u51068 \u50612 \u45228 \u45796 . \u51068 \u48152 \u51201 \u51004 \u47196  \u47532 \u49828 \u48376  \u45824 \u51648 \u51652 \u51060 \u46972 \u44256  \u50508 \u47140 \u51256  \u51080 \u51648 \u47564  \u44536  \u48276 \u50948 \u45716  \u50976 \u47101 \u51032  \u47566 \u51008  \u48512 \u48516 \u44284  \u50500 \u54532 \u47532 \u52852 \u50752  \u48120 \u44397 \u50640 \u44620 \u51648  \u54869 \u45824 \u46104 \u50632 \u45796 . \u44536 \u44163 \u51008  \u44536 \u47536 \u47004 \u46300 \u50752  \u49436 \u51064 \u46020 \u51228 \u46020 \u50752  \u47560 \u45936 \u51060 \u46972 \u46020  (\u23798 ) \u50752  \u45432 \u47476 \u50920 \u51060 \u50752  \u49828 \u50920 \u45940 \u44284  \u50500 \u51068 \u47004 \u46300 \u50640 \u49436 \u46020  \u44048 \u51652 \u46104 \u50632 \u45796 . \u44536 \u44163 \u51008  4\u48177 \u47564  \u54217 \u48169 \u47560 \u51068 \u51032  \u51648 \u50669 \u50640  \u48120 \u52452 \u45796 . \u50500 \u54532 \u47532 \u52852 \u50640 \u45716  \u50976 \u47101 \u50640 \u49436 \u50752  \u44144 \u51032  \u44057 \u51012  \u51221 \u46020 \u47196  \u44201 \u47148 \u54620  \u51652 \u46041 \u51060  \u51080 \u50632 \u45796 . \u50508 \u51648 \u50612 \u51592 \u45716  \u47566 \u51008  \u48512 \u48516 \u51060  \u54028 \u44340 \u46104 \u50632 \u45796 . \u44536 \u47532 \u44256  \u47784 \u47196 \u53076 \u50640 \u49436  \u47680 \u51648  \u50506 \u51008  \u47560 \u51012 , \u51064 \u44396  8\u52380  \u45236 \u51648  1\u47564  \u48120 \u47564  \u51221 \u46020 \u51032  \u54620  \u47560 \u51012 \u51008  \u51204 \u48512  \u54632 \u47792 \u46104 \u44256  \u47568 \u50520 \u45796 . \u49828 \u54168 \u51064 \u44284  \u50500 \u54532 \u47532 \u52852  \u54644 \u50504  \u51068 \u45824 \u50640 \u45716  \u53360  \u54644 \u51068 \u51060  \u51068 \u50612 \u45208  \u47566 \u51008  \u46020 \u49884 \u46308 \u51060  \u55081 \u50424 \u47140  \u45208 \u44052 \u44256 , \u53360  \u54028 \u47736 \u51060  \u51068 \u50612 \u45228 \u45796 .\
\uc0\u51648 \u51652 \u51060  \u44032 \u51109  \u44201 \u49900 \u54664 \u45912  \u44275 \u51008  \u49828 \u54168 \u51064 \u44284  \u54252 \u47476 \u53804 \u44040 \u51060 \u50632 \u45796 . \u52852 \u46356 \u51592  \u49884 \u50640 \u45716  \u48128 \u47140 \u50728  \u54028 \u46020 \u51032  \u45458 \u51060 \u44032  60\u54588 \u53944 \u45208  \u46104 \u50632 \u45796 \u44256  \u54620 \u45796 . \'93\u54252 \u47476 \u53804 \u44040 \u51032  \u44032 \u51109  \u45458 \u51008  \u49328 \u46308  \u51473 \u51032  \u50612 \u46500  \u44163 \u46308 \u51008  \u48148 \u47196  \u44592 \u52488 \u48512 \u53552  \u44201 \u47148 \u54616 \u44172  \u55124 \u46308 \u47160 \u44256 , \u50612 \u46500  \u49328 \u46308 \u51008  \u49328 \u44845 \u45824 \u44592 \u44032  \u53552 \u51256 \u49436  \u45440 \u46972 \u50868  \u47784 \u50577 \u51004 \u47196  \u44032 \u44620 \u50868  \u49328 \u44264 \u51676 \u44592 \u47196  \u44144 \u45824 \u54620  \u46405  \u45929 \u50612 \u47532 \u44032  \u47924 \u45320 \u51256  \u45236 \u47140 \u50772 \u45796 . \u46608  \u44536 \u47088  \u49328 \u46308 \u47196 \u48512 \u53552  \u48520 \u44867 \u51060  \u49567 \u44396 \u52432  \u45208 \u50772 \u45796 \u44256  \u51204 \u54644 \u51648 \u44256  \u51080 \u45796 \'94 (Sir Charles Lyell, Principles of Geology, p.495).\
\uc0\u47532 \u49828 \u48376 \u50640 \u49436 \u45716  \'93\u50864 \u47112  \u44057 \u51008  \u49548 \u47532 \u44032  \u46405 \u49549 \u50640 \u49436  \u46308 \u47140 \u50772 \u44256 , \u44536  \u54980 \u50640  \u51593 \u49884  \u51068 \u50612 \u45212  \u49900 \u54620  \u51652 \u46041 \u51004 \u47196  \u47568 \u48120 \u50516 \u50500  \u44536  \u46020 \u49884 \u51032  \u45824 \u48512 \u48516 \u51060  \u47924 \u45320 \u51256  \u48260 \u47160 \u45796 . \u50557  6\u48516  \u47564 \u50640  6\u47564  \u47749 \u51032  \u49324 \u46988 \u51060  \u51453 \u50632 \u45796 . \u48148 \u45796 \u45716  \u52376 \u51020 \u50640 \u45716  \u47932 \u51060  \u45208 \u44032 \u49436  \u47784 \u47000 \u48173 \u51060  \u46300 \u47084 \u45228 \u51004 \u45208  \u51104 \u49884  \u54980 \u50640 \u45716  \u48372 \u53685  \u46412 \u51032  \u49688 \u47732 \u48372 \u45796  50\u54588 \u53944  \u46608 \u45716  \u44536  \u51060 \u49345 \u51032  \u45458 \u51008  \u53360  \u47932 \u44208 \u51060  \u48128 \u47140 \u46308 \u50632 \u45796 .\'94 \'93\u44536  \u53360  \u51116 \u45212 \u51004 \u47196  \u47532 \u49828 \u48376  \u49884 \u44032  \u45817 \u54620  \u47924 \u49436 \u50868  \u49324 \u44148 \u46308  \u51473 \u51032  \u54616 \u45208 \u45716  \u47561 \u45824 \u54620  \u48708 \u50857 \u51012  \u46308 \u50668  \u49352 \u47196  \u47564 \u46304  \u45824 \u47532 \u49437  \u48512 \u46160 \u44032  \u54632 \u47792 \u46108  \u51068 \u51060 \u50632 \u45796 . \u47566 \u51008  \u44400 \u51473 \u46308 \u51008  \u44536  \u48512 \u46160 \u47484  \u54028 \u47736 \u51060  \u48120 \u52824 \u51648  \u50506 \u51012  \u50504 \u51204 \u51648 \u45824 \u46972 \u44256  \u49373 \u44033 \u54616 \u50668  \u44536  \u44275 \u51004 \u47196  \u47792 \u47140 \u50752  \u51080 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44536  \u48512 \u46160 \u45716  \u44049 \u51088 \u44592  \u47784 \u46304  \u49324 \u46988 \u46308 \u51012  \u49892 \u51008  \u44536 \u45824 \u47196  \u44032 \u46972 \u50505 \u50500  \u48260 \u47160 \u45716 \u45936 , \u44536  \u46244 \u50640  \u45800  \u54620  \u49324 \u46988 \u51032  \u49884 \u52404 \u46020  \u46496 \u50724 \u47476 \u51648  \u50506 \u50520 \u45796 \'94 (Sir Charles Lyell, Principles of Geology, p.495).\
\'93\uc0\u51648 \u51652 \u51032  \u51652 \u46041  (\u38663 \u21205 ) \u51060  \u51080 \u51088  \u44263  \u51060 \u50612  \u44368 \u54924 \u45817 \u44284  \u49688 \u46020 \u50896 , \u44144 \u51032  \u47784 \u46304  \u44256 \u52789  \u44148 \u47932 \u46308 \u51008  \u47924 \u45320 \u51256  \u48260 \u47160 \u44256 , \u49884 \u44032 \u51032  \u44148 \u47932  4\u48516 \u51032  1 \u51060 \u49345 \u51060  \u54028 \u44340 \u46104 \u50632 \u45796 . \u51648 \u51652  \u54980  \u50557  \u46160  \u49884 \u44036  \u51221 \u46020  \u51648 \u45208 \u44172  \u46104 \u51088  \u44033  \u44275 \u50640 \u49436  \u54868 \u51116 \u44032  \u51068 \u50612 \u45208 \u49436  \u44144 \u51032  3 \u51068 \u44036  \u44151 \u51105 \u51012  \u49688  \u50630 \u51060  \u47609 \u47148 \u54620  \u48520 \u44600 \u51012  \u49116 \u51008  \u44208 \u44284 \u47196  \u49884 \u44032 \u45716  \u50756 \u51204 \u55176  \u54889 \u54224 \u52992  \u46104 \u50632 \u45796 . \u51648 \u51652 \u51008  \u49457 \u51068 \u50640  \u51068 \u50612 \u45228 \u51004 \u48064 \u47196  \u44368 \u54924 \u50752  \u49849 \u50896 \u46308 \u50640 \u45716  \u49324 \u46988 \u46308 \u51060  \u44032 \u46301  \u52264  \u51080 \u45716 \u45936  \u44536 \u46308  \u51473 \u50640 \u49436  \u51453 \u51020 \u51012  \u47784 \u47732 \u54620  \u49324 \u46988 \u51008  \u44144 \u51032  \u50630 \u50632 \u45796 \'94[Encyclopedia Ameri-cana, art.\'93Lisbon,\'94 note (ed.1831) ].\
\uc0\u49324 \u46988 \u46308 \u51032  \u46160 \u47140 \u50880 \u51008  \u47568 \u54624  \u49688  \u50630 \u50632 \u44256 , \u50500 \u47924 \u46020  \u50864 \u45716  \u51088 \u44032  \u50630 \u50632 \u45796 . \u49324 \u49892 \u49345  \u50500 \u47924 \u46020  \u50872  \u49688 \u44032  \u50630 \u50632 \u45796 . \u44536 \u46308 \u51008  \u44277 \u54252 \u50752  \u45440 \u46972 \u50880 \u51004 \u47196  \u51060 \u47532 \u51200 \u47532  \u46832 \u50612 \u45796 \u45768 \u47732 \u49436  \u51088 \u44592 \u46308 \u51032  \u50620 \u44404 \u44284  \u44032 \u49844 \u51012  \u52824 \u47732 \u49436  \'93\u54616 \u45208 \u45784 \u51060 \u50668  \u48520 \u49933 \u55176  \u50668 \u44592 \u49548 \u49436 , \u49464 \u49345  \u45149 \u51060  \u46104 \u50632 \u45208 \u51060 \u45796 \'94\u46972 \u44256  \u48512 \u47476 \u51670 \u50632 \u45796 . \u50612 \u47672 \u45768 \u46308 \u51008  \u50500 \u44592 \u46308 \u51012  \u51082 \u50612 \u48260 \u47532 \u44256  \u49901 \u51088 \u44032 \u50640  \u47588 \u45804 \u47140  \u51080 \u45716  \u44536 \u47532 \u49828 \u46020 \u51032  \u49345  (\u20687 ) \u51452 \u48320 \u51004 \u47196  \u47792 \u47140 \u46308 \u50632 \u45796 . \u48520 \u54665 \u55176 \u46020  \u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u44368 \u54924 \u45817 \u51004 \u47196  \u54588 \u45212 \u54616 \u50668  \u48372 \u54840 \u47484  \u48155 \u44256 \u51088  \u54616 \u50688 \u51004 \u45208  \u49457 \u52268 \u51012  \u52712 \u54616 \u50668 \u46020  \u50500 \u47924  \u49548 \u50857 \u50630 \u45716  \u51068 \u51060 \u50632 \u45796 . \u44032 \u47144 \u54620  \u50689 \u54844 \u46308 \u51008  \u51228 \u45800 \u51012  \u48537 \u46308 \u50632 \u51648 \u47564  \u50424 \u45936 \u50630 \u45716  \u51068 \u51060 \u50632 \u45796 . \u49457 \u49345  (\u32854 \u20687 ) \u44284  \u49888 \u48512 \u46308 \u44284  \u48177 \u49457 \u46308 \u51008  \u45796  \u44057 \u51060  \u54028 \u47736  \u49549 \u50640  \u47588 \u47792 \u46104 \u44256  \u47568 \u50520 \u45796 . \u44536  \u47924 \u49436 \u50868  \u45216 \u50640  \u49373 \u47749 \u51012  \u48764 \u50519 \u44596  \u49324 \u46988 \u51008  9\u47564  \u47749 \u51004 \u47196  \u52628 \u49328 \u46104 \u44256  \u51080 \u45796 .\
