\uc0\u44536 \u47084 \u45208  \u49324 \u46988 \u51032  \u50504 \u47785 \u51004 \u47196  \u48380  \u46412  \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u46308 \u51008  \u44536 \u46308 \u48372 \u45796  \u50526 \u49436  \u44036  \u49692 \u44368 \u51088 \u46308 \u52376 \u47100  \u44263  \u44536 \u46308 \u51032  \u54588 \u47196 \u50024  \u44536 \u46308 \u51032  \u51613 \u44144 \u47484  \u51064  \u52432 \u50556  \u54624  \u44163 \u44057 \u51060  \u48372 \u51068  \u44163 \u51060 \u45796 . \u44536 \u46308 \u51008  \u51452 \u45784 \u44760 \u49436  \u44536 \u46308 \u51012  \u46496 \u45208 \u44032 \u44256  \u44536 \u46308 \u51060  \u50896 \u49688 \u46308 \u51032  \u49688 \u51473 \u51004 \u47196  \u45336 \u50612 \u44032 \u51648  \u50506 \u51012  \u44163 \u51064 \u51648  \u46160 \u47140 \u50892 \u54616 \u44592  \u49884 \u51089 \u54620 \u45796 . \u44536 \u44163 \u51008  \u47924 \u49436 \u50868  \u44256 \u45516 \u51032  \u49884 \u44592 \u51060 \u45796 . \u44536 \u46308 \u51008  \u48164 \u45230 \u51004 \u47196  \u54616 \u45208 \u45784 \u44760  \u44396 \u50896 \u51012  \u54840 \u49548 \u54620 \u45796 . \u50501 \u54620  \u51088 \u46308 \u51008  \u44592 \u48848  \u45216 \u46832 \u47728  \u51312 \u47217 \u54620 \u45796 . \'93\u51060 \u51228  \u45320 \u55148 \u51032  \u48127 \u51020 \u51060  \u50612 \u46356  \u51080 \u45712 \u45264 ? \u45320 \u55148 \u44032  \u51652 \u51221 \u51004 \u47196  \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u51060 \u46972 \u47732  \u50612 \u52236 \u54616 \u50668  \u54616 \u45208 \u45784 \u44760 \u49436  \u45320 \u55148 \u47484  \u50864 \u47532  \u49552 \u50640 \u49436  \u44148 \u51256 \u45236 \u51648  \u50506 \u51004 \u49884 \u45712 \u45264 ?\'94 \u44536 \u47084 \u45208  \u44396 \u50896 \u51012  \u44592 \u45796 \u47532 \u45716  \u51088 \u46308 \u51008  \u50696 \u49688 \u45784 \u44760 \u49436  \u44040 \u48148 \u47532 \u51032  \u49901 \u51088 \u44032 \u50640 \u49436  \u46028 \u50500 \u44032 \u49892  \u46412  \u51228 \u49324 \u51109 \u46308 \u44284  \u5