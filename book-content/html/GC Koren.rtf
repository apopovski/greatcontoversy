\uc0\u50668 \u54840 \u50752 \u44760 \u49436 \u45716  \u47568 \u50432 \u54616 \u49888 \u45796 . \'93\u45348  \u47560 \u51020 \u51060  \u54616 \u45208 \u45784 \u51032  \u47560 \u51020  \u44057 \u51008  \u52404 \u54616 \u50688 \u51004 \u45768  \u44536 \u47088 \u51593  \u45236 \u44032  \u50808 \u51064  \u44263  \u50676 \u44397 \u51032  \u44053 \u54252 \u54620  \u51088 \u47484  \u44144 \u45712 \u47532 \u44256  \u50752 \u49436  \u45320 \u47484  \u52824 \u47532 \u45768  \u44536 \u46308 \u51060  \u52860 \u51012  \u48764 \u50612  \u45348  \u51648 \u54812 \u51032  \u50500 \u47492 \u45796 \u50868  \u44163 \u51012  \u52824 \u47728  \u45348  \u50689 \u54868 \u47484  \u45908 \u47101 \u55176 \u47728  \u46608  \u45320 \u47484  \u44396 \u45929 \u51060 \u50640  \u48736 \u46888 \'94\u47532 \u47532 \u46972 . \'93\u45320  \u45934 \u45716  \u44536 \u47353 \u50500  \u44536 \u47084 \u48064 \u47196  \u45236 \u44032  \u45320 \u47484 \'85\u54868 \u44305 \u49437  \u49324 \u51060 \u50640 \u49436  \u47736 \u54616 \u50688 \u46020 \u45796 \'85\u45236 \u44032  \u45320 \u47484  \u46405 \u50640  \u45912 \u51256  \u50676 \u50773  \u50526 \u50640  \u46160 \u50612  \u44536 \u46308 \u51032  \u44396 \u44221 \u44144 \u47532 \u44032  \u46104 \u44172  \u54616 \u50688 \u46020 \u45796 \'85\u45320 \u47484  \u47785 \u46020 \u54616 \u45716  \u47784 \u46304  \u51088  \u50526 \u50640 \u49436  \u45320 \u47196  \u46405  \u50948 \u50640  \u51116 \u44032  \u46104 \u44172  \u54616 \u50688 \u46020 \u45796 \'85\u45320 \u47484  \u50500 \u45716  \u51088 \u44032  \u45320 \u47196  \u51064 \u54616 \u50668  \u45796  \u45440 \u46980  \u44163 \u51076 \u51060 \u50668  \u45348 \u44032  \u44221 \u44228 \u44144 \u47532 \u44032  \u46104 \u44256  \u45348 \u44032  \u50689 \u50896 \u55176  \u45796 \u49884  \u51080 \u51648  \u47803 \u54616 \u47532 \u47196 \u45796 \'94 (\u44180  28:6~8, 16~19).\
\'93\uc0\u50612 \u51648 \u47084 \u51060  \u49912 \u50864 \u45716  \u44400 \u51064 \u51032  \u44049 \u50743 \u44284  \u54588  \u47931 \u51008  \u48373 \u51109 \u51060  \u48520 \u50640  \u49462 \u44057 \u51060  \u49332 \u46972 \u51648 \u47532 \u45768 \'94, \'93\u50668 \u54840 \u50752 \u44760 \u49436  \u47564 \u44397 \u51012  \u54693 \u54616 \u50668  \u51652 \u45432 \u54616 \u49884 \u47728  \u44536 \u46308 \u51032  \u47564 \u44400 \u51012  \u54693 \u54616 \u50668  \u48516 \u45236 \u49324  \u44536 \u46308 \u51012  \u51652 \u47736 \u54616 \u49884 \u47728  \u49332 \u50977 \u52992  \u54616 \u49512 \'94 (\u49324  9:5, 34:2) \u46020 \u45796 . \'93\u50501 \u51064 \u50640 \u44172  \u44536 \u47932 \u51012  \u45236 \u47140 \u52824 \u49884 \u47532 \u45768  \u48520 \u44284  \u50976 \u54889 \u44284  \u53468 \u50864 \u45716  \u48148 \u46988 \u51060  \u51200 \u55148  \u51092 \u51032  \u49548 \u46301 \u51060  \u46104 \u47532 \u47196 \u45796 \'94 (\u49884  11:6). \u48520 \u51060  \u54616 \u45720 \u50640 \u49436  \u54616 \u45208 \u45784 \u44760 \u47196 \u48512 \u53552  \u45236 \u47140 \u50728 \u45796 . \u46405 \u51060  \u44648 \u50612 \u51652 \u45796 . \u46405 \u51032  \u44618 \u51008  \u44275 \u50640  \u44048 \u52628 \u50632 \u45912  \u47924 \u44592 \u46308 \u51060  \u53552 \u51256  \u45208 \u50728 \u45796 . \u46405 \u51032  \u44648 \u50612 \u51652  \u47784 \u46304  \u53960 \u50640 \u49436  \u47609 \u47148 \u54620  \u54868 \u50684 \u51060  \u53552 \u51256  \u45208 \u50728 \u45796 . \u47784 \u46304  \u48148 \u50948 \u44032  \u48520 \u51060  \u46108 \u45796 . \u54400 \u47924 \u48520 \u52376 \u47100  \u48520 \u53440 \u45716  \u45216 \u51060  \u47560 \u52840 \u45236  \u50772 \u45796 . \u52404 \u51656 \u51060  \u46888 \u44144 \u50868  \u48520 \u50640  \u54400 \u50612 \u51648 \u44256  \u46405 \u44284  \u44536  \u51473 \u50640  \u51080 \u45716  \u44163 \u46308 \u51060  \u53440  \u48260 \u47536 \u45796  (\u47568  4:1; \u48295 \u54980  3:10 \u52280 \u51312 ). \u46405 \u51032  \u54364 \u47732 \u51008  \u47560 \u52824  \u50857 \u54644 \u46108  \u54616 \u45208 \u51032  \u45929 \u50612 \u47532 , \u44263  \u54616 \u45208 \u51032  \u44144 \u45824 \u54620  \u45139 \u45716  \u53360  \u48520 \u47803 \u52376 \u47100  \u46108 \u45796 . \u51060 \u46412 \u45716  \u44221 \u44148 \u52824  \u50506 \u51008  \u51088 \u46308 \u51032  \u54805 \u48268 \u44284  \u47736 \u47581 \u51032  \u46412 \u51060 \u45796 . \'93\u51060 \u44163 \u51008  \u50668 \u54840 \u50752 \u51032  \u48372 \u49688 \u54624  \u45216 \u51060 \u50836  \u49884 \u50728 \u51032  \u49569 \u49324 \u47484  \u50948 \u54616 \u50668  \u49888 \u50896 \u54616 \u49892  \u54644 \'94 (\u49324  34:8) \u51060 \u45796 .\
\uc0\u50501 \u51064 \u46308 \u51008  \u46405 \u50640 \u49436  \u44536 \u46308 \u51032  \u48372 \u51025 \u51012  \u48155 \u45716 \u45796  (\u51104  11:31 \u52280 \u51312 ). \'93\u47564 \u44400 \u51032  \u50668 \u54840 \u50752 \u44032  \u51060 \u47476 \u45432 \u46972  \u48372 \u46972  \u44537 \u47148 \u54620  \u54400 \u47924 \u48520 \u44057 \u51008  \u45216 \u51060  \u51060 \u47476 \u47532 \u45768 \'85\u44536  \u51060 \u47476 \u45716  \u45216 \u51060  \u44536 \u46308 \u51012 \'94 (\u47568  4:1) \u49324 \u47484  \u44163 \u51060 \u45796 . \u50612 \u46500  \u51088 \u46308 \u51008  \u54620  \u49692 \u44036 \u50640  \u47736 \u47581 \u45817 \u54616 \u51648 \u47564  \u50612 \u46500  \u51088 \u46308 \u51008  \u50668 \u47084  \u45216  \u46041 \u50504  \u44256 \u53685 \u51012  \u48155 \u45716 \u45796 . \u47784 \u46304  \u49324 \u46988 \u51008  \'93\u44536 \u46308 \u51032  \u54665 \u50948 \u45824 \u47196 \'94 \u54805 \u48268 \u51012  \u48155 \u45716 \u45796 . \u51032 \u51064 \u46308 \u51032  \u51396 \u45716  \u49324 \u45800 \u50640 \u44172  \u50734 \u44200 \u51652 \u45796 . \u44536 \u45716  \u51088 \u44592  \u51088 \u49888 \u51032  \u48152 \u50669 \u51032  \u51396 \u49104 \u47564  \u50500 \u45768 \u46972  \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u46308 \u47196  \u54616 \u50668 \u44552  \u48276 \u54616 \u44172  \u54664 \u45912  \u47784 \u46304  \u51396  \u46412 \u47928 \u50640 \u46020  \u44256 \u53685 \u51012  \u48155 \u45716 \u45796 . \u49324 \u45800 \u51032  \u54805 \u48268 \u51008  \u44536 \u50640 \u44172  \u49549 \u51008  \u51088 \u46308 \u51060  \u48155 \u45716  \u54805 \u48268 \u48372 \u45796  \u55016 \u50476  \u45908  \u53356 \u45796 . \u44536 \u51032  \u44592 \u47564 \u51004 \u47196  \u53440 \u46973 \u54620  \u51088 \u46308 \u51060  \u47784 \u46160  \u47736 \u47581 \u45817 \u54620  \u54980 \u50640 \u46020  \u44536 \u45716  \u50668 \u51204 \u55176  \u51453 \u51648  \u50506 \u44256  \u44228 \u49549 \u54616 \u50668  \u44256 \u53685 \u51012  \u48155 \u45716 \u45796 . \u51221 \u44208 \u52992  \u54616 \u45716  \u44536  \u48520 \u47196 \u50024  \u50501 \u51064 \u46308 \u51008  \u49100 \u47532 \u50752  \u44032 \u51648 , \u44263  \u49100 \u47532 \u44032  \u46104 \u45716  \u49324 \u45800 \u44284  \u44032 \u51648 \u44032  \u46104 \u45716  \u44536 \u47484  \u46384 \u47476 \u45716  \u51088 \u46308 \u51060  \u47560 \u52840 \u45236  \u50756 \u51204 \u55176  \u47736 \u47581 \u45817 \u54620 \u45796 . \u50984 \u48277 \u51032  \u54805 \u48268 \u51060  \u50756 \u51204 \u55176  \u51665 \u54665 \u46104 \u44256 , \u44277 \u51032 \u51032  \u50836 \u44396 \u44032  \u52649 \u51313 \u46104 \u47732  \u54616 \u45720 \u44284  \u46405 \u51008  \u50668 \u54840 \u50752 \u51032  \u51032 \u47484  \u48148 \u46972 \u48372 \u44256  \u52268 \u49569 \u54616 \u44172  \u46108 \u45796 .\
