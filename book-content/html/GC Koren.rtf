\uc0\u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u46308 \u51060  \u44536 \u46308 \u51012  \u51453 \u51060 \u44256 \u51088  \u50676 \u44305 \u54616 \u45716  \u50896 \u49688 \u46308 \u50640 \u44172  \u50640 \u50892 \u49912 \u51068 \u51648 \u46972 \u46020  \u44536 \u46308 \u51060  \u44202 \u45716  \u44256 \u48124 \u51008  \u51652 \u47532 \u47484  \u50948 \u54616 \u50668  \u45817 \u54616 \u45716  \u54605 \u48149 \u51012  \u46160 \u47140 \u50892 \u54616 \u44592  \u46412 \u47928 \u50640  \u49373 \u44596  \u44163 \u51060  \u50500 \u45768 \u45796 . \u44536 \u46308 \u51008  \u50500 \u51649 \u44751  \u47784 \u46304  \u51396 \u47484  \u45796  \u54924 \u44060 \u54616 \u51648  \u47803 \u54616 \u51648 \u45208  \u50506 \u50520 \u45716 \u44032 , \u54841 \u51008  \u44536 \u46308 \u51032  \u50612 \u46500  \u44208 \u51216  \u46412 \u47928 \u50640  \'93\u45348 \u44032  \u45208 \u51032  \u51064 \u45236 \u51032  \u47568 \u50432 \u51012  \u51648 \u53040 \u51008 \u51593  \u45236 \u44032  \u46608 \u54620  \u45320 \u47484  \u51648 \u53412 \u50612  \u49884 \u54744 \u51032  \u46412 \u47484  \u47732 \u54616 \u44172  \u54616 \u47532 \'94 (\u44228  3:10) \u46972 \u44256  \u54616 \u49888  \u44396 \u51452 \u51032  \u50557 \u49549 \u51012  \u49457 \u52712 \u49884 \u53412 \u51648  \u47803 \u54616 \u51648 \u45208  \u50506 \u51012 \u44620  \u54616 \u44256  \u46160 \u47140 \u50892 \u54620 \u45796 . \u47564 \u51068  \u44536 \u46308 \u51060  \u50857 \u49436 \u47484  \u48155 \u50520 \u45796 \u45716  \u48372 \u51613 \u51012  \u50619 \u51012  \u49688 \u47564  \u51080 \u45796 \u47732  \u44536 \u46308 \u51008  \u44256 \u47928 \u51060 \u45208  \u51453 \u51020  \u50526 \u50640 \u49436 \u46020  \u50948 \u52629 \u45817 \u54616 \u51648  \u50506 \u51012  \u44163 \u51060 \u45796 . \u44536 \u47084 \u45208  \u44536 \u46308 \u51060  \u47564 \u51068  \u47924 \u44032 \u52824 \u54632 \u51060  \u51077 \u51613 \u46104 \u44256  \u44536 \u46308  \u51088 \u49888 \u51032  \u54408 \u49457 \u51032  \u44208 \u54632  \u46412 \u