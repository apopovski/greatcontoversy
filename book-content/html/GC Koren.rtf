\uc0\u44032 \u50864 \u49468 \u51008  \u54532 \u46993 \u49828 \u50612 \u47484  \u47568 \u54616 \u45716  \u51204 \u46020 \u51088  \u51473  \u44032 \u51109  \u50976 \u47749 \u54616 \u44256  \u51316 \u44221 \u51012  \u48155 \u45912  \u49324 \u46988 \u51060 \u50632 \u51004 \u45208  \u50620 \u47560  \u54980 \u50640  \u44536 \u45716  \u54620 \u44051  \u54633 \u47532 \u51452 \u51032  (\u21512 \u29702 \u20027 \u32681 ) \u51032  \u44368 \u48376 \u50640  \u48520 \u44284 \u54616 \u44256  \u51201 \u44537 \u51201  \u49888 \u50521 \u51060  \u44144 \u51032  \u44208 \u50668 \u46104 \u50612  \u51080 \u45716  \u44368 \u54924 \u51032  \u47928 \u45813 \u49436 \u47484  \u49324 \u50857 \u54616 \u51648  \u50506 \u44256  \u49457 \u44221 \u51012  \u44032 \u51648 \u44256  \u52397 \u45380 \u46308 \u51012  \u44032 \u47476 \u52452 \u45796 \u45716  \u51396 \u47785 \u51004 \u47196  \u44368 \u50669 \u51649 \u50640 \u49436  \u47732 \u51649 \u46104 \u50632 \u45796 . \u44536  \u54980 \u50640  \u44536 \u45716  \u49888 \u54617 \u44368 \u51032  \u44368 \u49324 \u44032  \u46104 \u50632 \u45716 \u45936 , \u51068 \u50836 \u51068 \u50640 \u45716  \u51204 \u46020 \u51088 \u47196 \u49436  \u54876 \u46041 \u51012  \u44228 \u49549 \u54616 \u50668  \u50500 \u51060 \u46308 \u51012  \u49345 \u45824 \u47196  \u49457 \u44221 \u51012  \u44032 \u47476 \u52452 \u45796 . \u44536 \u44032  \u51200 \u49696 \u54620  \u50696 \u50616 \u50640  \u44288 \u54620  \u49436 \u51201 \u51008  \u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u50640  \u47566 \u51008  \u55141 \u48120 \u47484  \u51068 \u51004 \u53040 \u45796 . \u44536 \u45716  \u44368 \u49688 \u51032  \u50948 \u52824 \u50640 \u49436  \u46608 \u45716  \u51064 \u49604 \u47932 \u51012  \u53685 \u54616 \u50668 , \u54841 \u51008  \u44536 \u44032  \u44032 \u51109  \u51339 \u50500 \u54616 \u45716  \u50612 \u47536 \u51060 \u46308 \u51032  \u44368 \u49324 \u47196 \u49436  \u50668 \u47084  \u54644  \u46041 \u50504  \u44228 \u49549 \u51201 \u51004 \u47196  \u45331 \u51008  \u48276 \