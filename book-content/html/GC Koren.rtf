\f0\b \cf0 \uc0\u51116 \u47548 \u51012  \u47582 \u51060 \u54624  \u51456 \u48708 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u49324 \u46988 \u46308 \u51060  \u44536 \u47532 \u49828 \u46020 \u47484  \u44256 \u45824 \u54616 \u44256  \u51080 \u45716  \u51613 \u44144 \u45716  \u48372 \u51060 \u51648  \u50506 \u44256  \u49373 \u47749 \u51032  \u50773 \u51012  \u50689 \u51217 \u54624  \u51456 \u48708 \u46020  \u46104 \u50612  \u51080 \u51648  \u50506 \u50520 \u45796 . \u44536 \u50752  \u44057 \u51008  \u49345 \u53468 \u50640  \u45440 \u46976  \u52380 \u49324 \u45716  \u44536  \u48512 \u45124 \u47084 \u50868  \u49548 \u49885 \u51012  \u44032 \u51648 \u44256  \u54616 \u45720 \u47196  \u46028 \u50500 \u44032 \u47140 \u44256  \u54616 \u50688 \u45796 . \u44536 \u47088 \u45936  \u44536  \u46412 \u50640  \u44536 \u45716  \u54620  \u47924 \u47532 \u51032  \u47785 \u51088 \u46308 \u51060  \u48324 \u51060  \u52509 \u52509 \u54620  \u48164 \u54616 \u45720 \u51012  \u48148 \u46972 \u48372 \u47732 \u49436  \u47700 \u49884 \u50556 \u44032  \u49464 \u49345 \u50640  \u50724 \u49892  \u50696 \u50616 \u51012  \u47749 \u49345 \u54616 \u44256  \u49464 \u49345 \u51032  \u44396 \u49549 \u51088 \u44032  \u50724 \u49892  \u51068 \u51012  \u49324 \u47784 \u54616 \u47732 \u49436  \u48164 \u50640  \u44536 \u46308 \u51032  \u50577 \u46524 \u47484  \u51648 \u53412 \u44256  \u51080 \u45716  \u44163 \u51012  \u48156 \u44204 \u54616 \u50688 \u45796 . \u50668 \u44592 \u50640  \u48148 \u47196  \u54616 \u45720 \u51032  \u44592 \u48324 \u51012  \u48155 \u44256 \u51088  \u51456 \u48708 \u46108  \u47924 \u47532 \u44032  \u51080 \u50632 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44049 \u51088 \u44592  \u51452 \u45784 \u51032  \u49324 \u51088 \u45716  \u45208 \u53440 \u45208 \u49436  \u53360  \u44592 \u49256 \u51032  \u51339 \u51008  \u49548 \u49885 \u51012  \u51204 \u54616 \u50688 \u45796 . \u54616 \u45720 \u51032  \u50689 \u44305 \u51060  \u50728  \u46308 \u54032 \u51012  \u46160 \u47336  \u48708 \u52628 \u50632 \u45796 . \u47560 \u52824  \u54620  \u52380 \u49324 \u44032  \u44536  \u49548 \u49885 \u51012  \u51204 \u54616 \u44592 \u50640 \u45716  \u45320 \u47924  \u48512 \u51313 \u54620 \u46319 \u51060  \u47924 \u49688 \u54620  \u52380 \u49324 \u46308 \u51060  \u45208 \u53440 \u45208 \u49436  \u53360 \u49548 \u47532 \u47196  \u51109 \u52264  \u44396 \u50896 \u48155 \u51008  \u49324 \u46988 \u46308 \u51060  \u48512 \u47484  \u44536  \u45432 \u47000 \u47484  \u54633 \u52285 \u54616 \u50688 \u45796 . \'93\u51648 \u44537 \u55176  \u45458 \u51008  \u44275 \u50640 \u49436 \u45716  \u54616 \u45208 \u45784 \u44760  \u50689 \u44305 \u51060 \u50836  \u46405 \u50640 \u49436 \u45716  \u44592 \u48848 \u54616 \u49900 \u51012  \u51077 \u51008  \u49324 \u46988 \u46308  \u51473 \u50640  \u54217 \u54868 \u47196 \u45796 \'94 (\u45573  2:14).\
\uc0\u48288 \u46308 \u47112 \u54772 \u51032  \u44536  \u45440 \u46972 \u50868  \u51060 \u50556 \u44592 \u50640 \u45716  \u52280 \u51004 \u47196  \u54988 \u47469 \u54620  \u44368 \u54984 \u51060  \u51080 \u51648  \u50506 \u45716 \u44032 ! \u44536 \u44163 \u51008  \u50864 \u47532 \u51032  \u48520 \u49888 \u44284  \u50724 \u47564 \u44284  \u51088 \u48512 \u49900 \u51012  \u51652 \u51221 \u51004 \u47196  \u44204 \u52293 \u54644  \u51452 \u44256  \u51080 \u51648  \u50506 \u45716 \u44032 . \u44536 \u44163 \u51008  \u50864 \u47532 \u50640 \u44172  \u51396 \u49828 \u47084 \u50868  \u47924 \u44288 \u49900  \u46412 \u47928 \u50640  \u49884 \u45824 \u51032  \u51669 \u51312 \u47484  \u48516 \u48324 \u52824  \u47803 \u54632 \u51004 \u47196  \u44428 \u44256  (\u30519 \u39015 ) \u54616 \u49884 \u45716  \u45216 \u51012  \u44648 \u45803 \u51648  \u47803 \u54616 \u45716  \u51068 \u51060  \u50630 \u46020 \u47197  \u44648 \u50864 \u52432  \u51452 \u45716  \u44221 \u44256 \u44032  \u46104 \u51648  \u50506 \u45716 \u44032 .\
\uc0\u52380 \u49324 \u46308 \u51060  \u47700 \u49884 \u50556 \u51032  \u50724 \u49900 \u51012  \u50948 \u54616 \u50668  \u44648 \u50612  \u51080 \u45716  \u49324 \u46988 \u51004 \u47196  \u48156 \u44204 \u54620  \u51088 \u46308 \u51008  \u50976 \u45824  \u46405 \u51032  \u50616 \u45909 \u50640 \u49436  \u50577 \u51012  \u52824 \u45912  \u47785 \u51088 \u46308 \u47564 \u51060  \u50500 \u45768 \u50632 \u45796 . \u51060 \u48169  \u45208 \u46972 \u50640 \u46020  \u44536 \u48516 \u51032  \u50724 \u49900 \u51012  \u44592 \u45796 \u47532 \u44256  \u51080 \u45716  \u49324 \u46988 \u46308 \u51060  \u51080 \u50632 \u45796 . \u44536 \u46308 \u51008  \u51648 \u54812  \u51080 \u44256  \u44256 \u49345 \u54620  \u46041 \u48169 \u51032  \u52384 \u54617 \u51088 \u46308 \u51060 \u50632 \u45796 . \u52380 \u50672 \u44228 \u47484  \u53456 \u44396 \u54616 \u45716  \u54617 \u51088 \u46308 \u51064  \u46041 \u48169  \u48149 \u49324 \u46308 \u51008  \u54616 \u45208 \u45784 \u51032  \u49564 \u50472 \u47484  \u53685 \u54616 \u50668  \u54616 \u45208 \u45784 \u51012  \u44648 \u45804 \u50520 \u45796 . \u55176 \u48652 \u47532 \u51064 \u51032  \u49457 \u44221 \u50640 \u49436  \u44536 \u46308 \u51008  \u50556 \u44273 \u50640 \u44172 \u49436  \u48324 \u51060  \u51068 \u50612 \u45216  \u44163 \u51012  \u50508 \u50520 \u45796 . \u44536 \u46308 \u51008  \'93\u51060 \u49828 \u46972 \u50648 \u51032  \u50948 \u47196 \'94\u44032  \u46112  \u49104 \u47564  \u50500 \u45768 \u46972  \'93\u51060 \u48169 \u51012  \u48708 \u52712 \u45716  \u48731 \'94\u51060  \u46104 \u44256 , \'93\u46405  \u45149 \u44620 \u51648  \u44396 \u50896 \'94\u54616 \u49892  \u48516 \u51060  \u50724 \u49892  \u44163 \u51012  \u50676 \u47148 \u55176  \u49324 \u47784 \u54616 \u44256  \u51080 \u50632 \u45796  (\u45573  2:25, 32; \u54665  13:47). \u44536 \u46308 \u51008  \u48731 \u51012  \u52286 \u45716  \u49324 \u46988 \u46308 \u51060 \u50632 \u51004 \u48064 \u47196  \u54616 \u45208 \u45784 \u51032  \u48372 \u51340 \u50640 \u49436  \u45208 \u50724 \u45716  \u48731 \u51060  \u44536 \u46308 \u51032  \u50526 \u44600 \u51012  \u48708 \u52628 \u50612  \u51452 \u50632 \u45796 . \u51652 \u47532 \u51032  \u50745 \u54840 \u51088 \u50836  \u54644 \u49437 \u51088 \u47196  \u51076 \u47749 \u46108  \u50696 \u47336 \u49332 \u47128 \u51032  \u51228 \u49324 \u51109 \u46308 \u44284  \u46989 \u48708 \u46308 \u51060  \u50612 \u46176 \u50640  \u47931 \u54784  \u51080 \u45716  \u46041 \u50504 , \u54616 \u45720 \u50640 \u49436  \u48372 \u45240  \u44536  \u48324 \u51008  \u44536  \u51060 \u48169  \u49324 \u46988 \u46308 \u51012  \u49352 \u47196  \u53468 \u50612 \u45212  \u50773 \u50640 \u44172 \u47196  \u51064 \u46020 \u54616 \u50688 \u45796 .\
\uc0\u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u44396 \u50896 \u50640  \u51060 \u47476 \u44172  \u54616 \u44592  \u50948 \u54616 \u50668  \'93\u51396 \u50752  \u49345 \u44288 \u50630 \u51060  \u51088 \u44592 \u47484  \u48148 \u46972 \u45716  \u51088 \u46308 \u50640 \u44172  \u46160  \u48264 \u51704  \u45208 \u53440 \u45208 \'94 (\u55176  9:28) \u49892  \u44163 \u51060 \u45796 . \u44396 \u51452 \u51032  \u53444 \u49373 \u50640  \u45824 \u54620  \u49548 \u49885 \u44284  \u44057 \u51060  \u44536 \u48516 \u51032  \u51116 \u47548 \u50640  \u45824 \u54620  \u44592 \u48324 \u51008  \u51068 \u48152  \u48177 \u49457 \u46308 \u51032  \u51333 \u44368 \u51201  \u51648 \u46020 \u51088 \u46308 \u50640 \u44172  \u50948 \u53441 \u46104 \u51648  \u50506 \u50520 \u45796 . \u44536 \u46308 \u51008  \u54616 \u45208 \u45784 \u44284 \u51032  \u50672 \u44208 \u51012  \u51648 \u49549 \u54616 \u51648  \u47803 \u54616 \u44256 , \u54616 \u45720 \u47196 \u48512 \u53552  \u50728  \u48731 \u51012  \u44144 \u51208 \u54616 \u50688 \u45796 . \u44536 \u47084 \u48064 \u47196  \u44536 \u46308 \u51008  \u49324 \u46020  \u48148 \u50872 \u51060  \'93\u54805 \u51228 \u46308 \u50500  \u45320 \u55148 \u45716  \u50612 \u46176 \u50640  \u51080 \u51648  \u50500 \u45768 \u54616 \u47588  \u44536 \u45216 \u51060  \u46020 \u51201 \u44057 \u51060  \u45320 \u55148 \u50640 \u44172  \u51076 \u54616 \u51648  \u47803 \u54616 \u47532 \u45768  \u45320 \u55148 \u45716  \u45796  \u48731 \u51032  \u50500 \u46308 \u51060 \u50836  \u45230 \u51032  \u50500 \u46308 \u51060 \u46972  \u50864 \u47532 \u44032  \u48164 \u51060 \u45208  \u50612 \u46176 \u50640  \u49549 \u54616 \u51648  \u50500 \u45768 \u54616 \u45208 \u45768 \'94 (\u49332 \u51204  5:4, 5) \u46972 \u44256  \u47568 \u54620  \u47924 \u47532 \u46308 \u50640 \u44172  \u49549 \u54616 \u51648  \u50500 \u45768 \u54616 \u50688 \u45796 .\
\uc0\u49884 \u50728 \u49457  \u50948 \u50640  \u51080 \u45716  \u54028 \u49688 \u44988 \u46308 \u51008  \u47592  \u47676 \u51200  \u44396 \u51452 \u51032  \u52488 \u47548 \u50640  \u45824 \u54620  \u49548 \u49885 \u51012  \u46307 \u44256 , \u44536 \u48516 \u44760 \u49436  \u44032 \u44620 \u51060  \u50724 \u49888 \u45796 \u45716  \u49548 \u49885 \u51012  \u51204 \u54616 \u45716  \u51068 \u50640  \u44536 \u46308 \u51032  \u51020 \u49457 \u51012  \u45458 \u51068  \u48177 \u49457 \u46308 \u50640 \u44172  \u44536  \u51068 \u51012  \u50948 \u54616 \u50668  \u51456 \u48708 \u54616 \u46972 \u44256  \u51228 \u51068  \u47676 \u51200  \u44221 \u44256 \u54664 \u50612 \u50556  \u54624  \u44163 \u51060 \u50632 \u45796 . \u44536 \u47084 \u45208  \u48177 \u49457 \u46308 \u51060  \u51396 \u50501  \u44032 \u50868 \u45936 \u49436  \u51320 \u44256  \u51080 \u45716  \u46041 \u50504 , \u44536 \u46308 \u51008  \u54217 \u54868 \u50752  \u50504 \u46973 \u51012  \u45000 \u44984 \u47732 \u49436  \u50504 \u51068 \u54620  \u44032 \u50868 \u45936  \u47931 \u54784  \u51080 \u50632 \u45796 . \u50696 \u49688 \u45784 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u44368 \u54924 \u44032  \u47560 \u52824  \u50676 \u47588  \u50630 \u45716  \u47924 \u54868 \u44284 \u45208 \u47924 \u52376 \u47100  \u51086 \u51008  \u47588 \u50864  \u47924 \u49457 \u54616 \u51648 \u47564  \u44480 \u51473 \u54620  \u50676 \u47588 \u45716  \u50630 \u45716  \u44163 \u51012  \u50500 \u49512 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436  \u44592 \u44732 \u51060  \u48155 \u51004 \u49892  \u49688  \u51080 \u45716  \u50696 \u48176 \u50640  \u54596 \u49688 \u51201 \u51064  \u52280 \u46108  \u44216 \u48708 \u50752  \u51064 \u45236 \u50752  \u49888 \u50521 \u51032  \u51221 \u49888 \u51008  \u44208 \u54605 \u46104 \u50612  \u51080 \u51004 \u47732 \u49436 \u46020  \u51333 \u44368 \u51201  \u54805 \u49885 \u51008  \u51088 \u46993 \u49828 \u47101 \u44172  \u51456 \u49688 \u54616 \u45716  \u51068 \u51060  \u44144 \u44592 \u50640  \u51080 \u50632 \u45796 . \u49457 \u47161 \u51032  \u51008 \u54812  \u45824 \u49888 \u50640  \u44368 \u47564 , \u54805 \u49885 , \u54728 \u50689 , \u51060 \u44592 \u49900 , \u50517 \u51228 \u46308 \u51060  \u45208 \u53440 \u45208 \u44256  \u51080 \u50632 \u45796 . \u53440 \u46973 \u54620  \u44368 \u54924 \u45716  \u49884 \u45824 \u51032  \u51669 \u51312 \u50640  \u45824 \u54616 \u50668  \u45576 \u51012  \u44048 \u50520 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u44536 \u46308 \u51012  \u48260 \u47532 \u44144 \u45208  \u45817 \u49888 \u51032  \u49457 \u49892 \u54616 \u49900 \u51012  \u44536 \u52824 \u51648  \u50506 \u51004 \u49512 \u45796 . \u44536 \u47084 \u45208  \u44536 \u46308 \u51008  \u54616 \u45208 \u45784 \u51012  \u46496 \u45208 \u44052 \u44256  \u44536 \u48516 \u51032  \u49324 \u46993 \u50640 \u49436  \u51088 \u49888 \u46308 \u51012  \u48516 \u47532 \u49884 \u53040 \u45796 . \u44536 \u46308 \u51060  \u51312 \u44148 \u46308 \u51012  \u51060 \u54665 \u54616 \u45716  \u51068 \u51012  \u44144 \u51208 \u54616 \u50688 \u51004 \u48064 \u47196  \u54616 \u45208 \u45784 \u51032  \u50557 \u49549 \u51060  \u44536 \u46308 \u50640 \u44172  \u49457 \u52712 \u46104 \u51648  \u47803 \u54616 \u50688 \u45796 .\
\uc0\u44536 \u50752  \u44057 \u51008  \u51068 \u51008  \u54616 \u45208 \u45784 \u44760 \u49436  \u51452 \u49888  \u48731 \u44284  \u53945 \u44428 \u51012  \u44648 \u45803 \u44256  \u51060 \u50857 \u54616 \u45716  \u51068 \u51012  \u46321 \u54620 \u55176  \u54620  \u48516 \u47749 \u54620  \u44208 \u44284 \u51060 \u45796 . \u44368 \u54924 \u44032  \u54616 \u45208 \u45784 \u51032  \u48516 \u47749 \u54620  \u49453 \u47532 \u47484  \u51335 \u51648  \u50506 \u44256  \u47784 \u46304  \u48731 \u51012  \u48155 \u50500 \u46308 \u51060 \u51648  \u50500 \u45768 \u54616 \u44256 , \u51228 \u49884 \u46108  \u47784 \u46304  \u51032 \u47924 \u47484  \u51060 \u54665 \u54616 \u51648  \u50506 \u45716  \u54620  \u51333 \u44368 \u45716  \u45796 \u48516 \u55176  \u54805 \u49885 \u54868 \u46104 \u50612  \u48260 \u47532 \u44256  \u49373 \u47749 \u47141 \u51060  \u45336 \u52824 \u45716  \u44221 \u44148 \u51032  \u51221 \u49888 \u51008  \u49324 \u46972 \u51256  \u48260 \u47540  \u44163 \u51060 \u45796 . \u51060  \u49324 \u49892 \u51008  \u44368 \u54924 \u51032  \u50669 \u49324 \u47484  \u53685 \u54644 \u49436  \u50668 \u47084  \u48264  \u48152 \u48373 \u54616 \u50668  \u45208 \u53440 \u45228 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u48177 \u49457 \u46308 \u50640 \u44172  \u51452 \u49888  \u52629 \u48373 \u44284  \u53945 \u44428 \u50640  \u48512 \u54633 \u46104 \u45716  \u48127 \u51020 \u44284  \u49692 \u51333 \u51012  \u45208 \u53440 \u45236 \u46020 \u47197  \u50836 \u44396 \u54616 \u49888 \u45796 . \u49692 \u51333 \u51008  \u55148 \u49373 \u51012  \u50836 \u44396 \u54616 \u47728  \u49901 \u51088 \u44032 \u44032  \u49688 \u48152 \u46108 \u45796 . \u44536 \u47084 \u48064 \u47196  \u44536 \u47532 \u49828 \u46020 \u51064 \u51060 \u46972 \u44256  \u44277 \u50616 \u54616 \u45716  \u47566 \u51008  \u49324 \u46988 \u46308 \u51060  \u54616 \u45720 \u47196 \u48512 \u53552  \u50724 \u45716  \u48731 \u51012  \u44144 \u51208 \u54616 \u44172  \u46104 \u44256 , \