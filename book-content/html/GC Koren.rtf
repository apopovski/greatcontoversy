\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\'93\uc0\u51060  \u50976 \u47749 \u54620  \u54637 \u51032 \u49436 \u44032  \u45812 \u44256  \u51080 \u45716  \u47784 \u46304  \u50896 \u52825 \u51008  \u54532 \u47196 \u53580 \u49828 \u53444 \u53944  (Protestant) \u51032  \u48376 \u51656 \u51012  \u51060 \u47336 \u44256  \u51080 \u45796  [\u54532 \u47196 \u53580 \u49828 \u53444 \u53944 \u46972 \u45716  \u47568 \u51032  \u51032 \u48120 \u45716  \'91\u54637 \u51032 \u51088 \'92\u51060 \u45796  \'97 \u50669 \u51088  \u51452 ]. \u51060  \u54637 \u51032 \u49436 \u45716  \u49888 \u50521 \u51032  \u47928 \u51228 \u50640 \u49436  \u49324 \u46988 \u51032  \u46160  \u44032 \u51648  \u50501 \u54224 \u50640  \u45824 \u54616 \u50668  \u54637 \u51032 \u54616 \u50688 \u45796 . \u44536  \u54616 \u45208 \u45716  \u50948 \u51221 \u51088 \u51032  \u44053 \u50836 \u51060 \u47728 , \u46608  \u54616 \u45208 \u45716  \u44368 \u44428 \u51032  \u45224 \u50857 \u51060 \u45796 . \u51060 \u47084 \u54620  \u50501 \u54224  \u45824 \u49888 \u50640  \u54532 \u47196 \u53580 \u49828 \u53444 \u53944 \u51452 \u51032 \u45716  \u51221 \u44428  \u50948 \u50640  \u50577 \u49900 \u51032  \u55192 \u51012  \u48372 \u51060 \u45716  \u51648 \u49345 \u51032  \u44368 \u54924  \u50948 \u50640  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51032  \u44428 \u50948 \u47484  \u45459 \u50520 \u45796 . \u52395 \u51704 \u47196  \u54532 \u47196 \u53580 \u49828 \u53444 \u53944 \u51452 \u51032 \u45716  \u49888 \u47161 \u54620  \u49324 \u47932 \u50640  \u51080 \u50612 \u49436  \u49464 \u49549 \u51201  \u44428 \u49464 \u47484  \u44144 \u48512 \u54616 \u44256  \u49440 \u51648 \u51088 \u50752  \u49324 \u46020 \u46308 \u52376 \u47100  \'91\u49324 \u46988 \u48372 \u45796  \u54616 \u45208 \u45784 \u51012  \u49692 \u51333 \u54616 \u45716  \u44163 \u51060  \u47560 \u46405 \u54616 \u45768 \u46972 \'92 (\u54665  5:29) \u44256  \u47568 \u54620 \u45796 . \u44536 \u44163 \u51008  \u52852 \u50508  5\u49464 \u51032  \u50773 \u44288  \u50526 \u50640 \u49436  \u50696 \u49688  \u44536 \u47532 \u49828 \u46020 \u51032  \u50773 \u44288 \u51012  \u45458 \u51060 \u44256  \u51080 \u45796 . \u44536 \u44163 \u51008  \u46608 \u54620  \u54620  \u44152 \u51020  \u45908  \u45208 \u50500 \u44032 \u44256  \u51080 \u45796 . \u44536 \u44163 \u51008  \u49324 \u46988 \u51032  \u50728 \u44054  \u44368 \u54984 \u51060  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u50640  \u50696 \u49549 \u46104 \u50612 \u50556  \u54620 \u45796 \u45716  \u50896 \u52825 \u51012  \u54869 \u47549 \u54644  \u51456 \u45796 \'94 (D\'92Aubigne, b.13, ch.6). \u44536 \u49104  \u50500 \u45768 \u46972  \u44536  \u54637 \u51032 \u51088 \u46308 \u51008  \u51652 \u47532 \u46972 \u44256  \u54869 \u49888 \u54616 \u45716  \u48148 \u47484  \u51088 \u50976 \u47213 \u44172  \u51060 \u50556 \u44592 \u54624  \u44428 \u47532 \u44032  \u51080 \u45796 \u44256  \u51452 \u51109 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u50640 \u49436  \u48157 \u54784 \u51652  \u48148 \u47484  \u48127 \u44256  \u49692 \u51333 \u54624  \u49104  \u50500 \u45768 \u46972  \u44032 \u47476 \u52432 \u50556  \u54620 \u45796 \u44256  \u51452 \u51109 \u54616 \u44256 , \u49849 \u47140 \u45208  \u51221 \u44428 \u51060  \u51060 \u47484  \u44036 \u49453 \u54624  \u44428 \u54620 \u51060  \u50630 \u45796 \u44256  \u54616 \u50688 \u45796 . \u49828 \u54028 \u51060 \u50620 \u49828 \u51032  \u54637 \u51032 \u45716  \u51333 \u44368 \u51201  \u51088 \u50976 \u47484  \u50613 \u50517 \u54616 \u45716  \u45936  \u45824 \u54620  \u50628 \u49689 \u54620  \u48152 \u51613  (\u21453 \u35657 ) \u51064  \u46041 \u49884 \u50640  \u50728  \u51064 \u47448 \u45716  \u51088 \u44592 \u51032  \u50577 \u49900 \u51032  \u51648 \u49884 \u47484  \u46384 \u46972  \u54616 \u45208 \u45784 \u51012  \u44221 \u48176 \u54624  \u44428 \u47532 \u44032  \u51080 \u45796 \u45716  \u51452 \u51109 \u51060 \u50632 \u45796 .\
\uc0\u44536  \u49440 \u50616 \u51008  \u48152 \u54252 \u46104 \u50632 \u45796 . \u44536 \u44163 \u51008  \u47566 \u51008  \u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u50640  \u49352 \u44200 \u51276 \u44256 , \u49324 \u46988 \u51032  \u55192 \u51004 \u47196  \u44208 \u53076  \u51648 \u50892  \u48260 \u47540  \u49688  \u50630 \u45716  \u54616 \u45720 \u51032  \u52293 \u50640 \u46020  \u44592 \u47197 \u46104 \u50632 \u45796 . \u46021 \u51068 \u51032  \u47784 \u46304  \u48373 \u51020  \u49888 \u46020 \u46308 \u51008  \u44536  \u54637 \u51032 \u49436 \u47484  \u49888 \u50521  \u44256 \u48177 \u51004 \u47196  \u52292 \u53469 \u54616 \u50688 \u45796 . \u44033  \u44275 \u50640 \u49436  \u49324 \u46988 \u46308 \u51008  \u51060  \u49440 \u50616 \u50640 \u49436  \u45908 \u50865  \u54988 \u47469 \u54620  \u49352  \u49884 \u45824 \u51032  \u50557 \u49549 \u51012  \u48148 \u46972 \u48372 \u50520 \u45796 . \u51228 \u54980 \u46308  \u44032 \u50868 \u45936  \u54620  \u49324 \u46988 \u51008  \u49828 \u54028 \u51060 \u50620 \u49828 \u51032  \u54532 \u47196 \u53580 \u49828 \u53444 \u53944 \u46308 \u51012  \u54693 \u54616 \u50668  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u54616 \u50688 \u45796 . \'93\u44536 \u45824 \u46308 \u47196  \u54616 \u50668 \u44552  \u51060 \u52376 \u47100  \u45824 \u45812 \u54616 \u44256 , \u51088 \u50976 \u47213 \u44256 , \u50473 \u50473 \u54616 \u44172  \u48127 \u51020 \u51012  \u44256 \u48177 \u54616 \u44172  \u54616 \u49888  \u51204 \u45733 \u54616 \u49888  \u54616 \u45208 \u45784 \u44760 \u49436  \u50689 \u50896 \u44620 \u51648  \u44536 \u45824 \u46308 \u51012  \u54869 \u44256 \u54620  \u44536 \u47532 \u49828 \u46020 \u51064 \u51004 \u47196  \u45224 \u50500 \u51080 \u46020 \u47197  \u48372 \u51316 \u54644  \u51452 \u49884 \u44592 \u47484  \u48148 \u46972 \u45432 \u46972 \'94 (D\'92Aubigne, b.13, ch.6).\
\uc0\u47564 \u51068  \u44060 \u54785  \u49324 \u50629 \u51060  \u50612 \u45712  \u51221 \u46020 \u51032  \u49457 \u44277 \u51012  \u44144 \u46164  \u54980 \u50640  \u49464 \u49549 \u51201  \u50689 \u44305 \u51012  \u50619 \u44592  \u50948 \u54616 \u50668  \u49464 \u49345  \u54413 \u51312 \u47484  \u46384 \u47476 \u45716  \u51068 \u50640  \u46041 \u51032 \u54664 \u45796 \u47732 , \u44536 \u44163 \u51008  \u54616 \u45208 \u45784 \u51012  \u48176 \u48152 \u54616 \u45716  \u46041 \u49884 \u50640  \u44060 \u54785  \u44536  \u51088 \u52404 \u50640 \u46020  \u50612 \u44555 \u45208 \u45716  \u44163 \u51060  \u46104 \u50612  \u47560 \u52840 \u45236  \u51088 \u47736 \u54616 \u44172  \u46104 \u50632 \u51012  \u44163 \u51060 \u45796 . \u44536 \u52376 \u47100  \u44256 \u44208 \u54620  \u44060 \u54785 \u51088 \u46308 \u51032  \u44221 \u54744 \u51008  \u44536  \u54980  \u44033  \u49884 \u45824 \u51032  \u48177 \u49457 \u46308 \u50640 \u44172  \u54620  \u44032 \u51648  \u44368 \u54984 \u51012  \u45224 \u44200  \u51452 \u50632 \u45796 . \u54616 \u45208 \u45784 \u44284  \u44536 \u48516 \u51032  \u47568 \u50432 \u50640  \u45824 \u54620  \u49324 \u45800 \u51032  \u44277 \u44201  \u48169 \u48277 \u51008  \u48320 \u54616 \u51648  \u50506 \u50520 \u45796 . \u44536 \u45716  \u50724 \u45720 \u45216 \u50640 \u46020  16\u49464 \u44592 \u50640  \u51080 \u50612 \u49436 \u50752  \u47560 \u52268 \u44032 \u51648 \u47196  \u49457 \u44221 \u51012  \u51064 \u49373 \u51032  \u51648 \u52840 \u51004 \u47196  \u49340 \u45716  \u51068 \u51012  \u48152 \u45824 \u54616 \u44256  \u51080 \u45796 . \u50724 \u45720 \u45216 \u51008  \u44060 \u54785 \u51088 \u46308 \u51032  \u44368 \u54984 \u44284  \u47784 \u48376 \u50640 \u49436  \u47680 \u47532  \u46496 \u45208  \u51080 \u45796 . \u44536 \u47084 \u48064 \u47196  \u50724 \u51649  \u49457 \u44221 \u47564 \u51012  \u49888 \u50521 \u44284  \u54665 \u50948 \u51032  \u54364 \u51456 \u51004 \u47196  \u49340 \u50520 \u45912  \u50948 \u45824 \u54620  \u54532 \u47196 \u53580 \u49828 \u53444 \u53944 \u51032  \u50896 \u52825 \u51004 \u47196  \u46028 \u50500 \u44040  \u54596 \u50836 \u44032  \u51080 \u45796 . \u49324 \u45800 \u51008  \u50724 \u45720 \u45216 \u46020  \u50668 \u51204 \u55176  \u49888 \u50521 \u51032  \u51088 \u50976 \u47484  \u54028 \u44340 \u54616 \u44592  \u50948 \u54616 \u50668  \u54624  \u49688  \u51080 \u45716  \u50728 \u44054  \u49688 \u45800 \u51012  \u45796  \u49324 \u50857 \u54616 \u44256  \u51080 \u45796 . \u49828 \u54028 \u51060 \u50620 \u49828  \u54637 \u51032 \u51088 \u46308 \u51060  \u48176 \u52377 \u54620  \u48152 \u44536 \u47532 \u49828 \u46020 \u44368 \u51032  \u49464 \u47141 \u51008  \u50724 \u45720 \u45216  \u49352 \u47196 \u50868  \u55192 \u51004 \u47196  \u51075 \u50612 \u48260 \u47160 \u45912  \u52572 \u49345 \u44428 \u51012  \u54924 \u48373 \u54616 \u44592  \u50948 \u54616 \u50668  \u45432 \u47141 \u54616 \u44256  \u51080 \u45796 . \u44536 \u47084 \u48064 \u47196  \u44060 \u54785  \u49324 \u50629 \u51060  \u50948 \u44592 \u50640  \u45459 \u50688 \u51012  \u46412  \u54620  \u44163 \u52376 \u47100  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u50640  \u44403 \u44172  \u51665 \u52265 \u54616 \u45716  \u44163 , \u44536 \u44163 \u47564 \u51060  \u50724 \u45720 \u45216 \u51032  \u44060 \u54785  \u49324 \u50629 \u51032  \u50976 \u51068 \u54620  \u55148 \u47581 \u51060 \u45796 .\
