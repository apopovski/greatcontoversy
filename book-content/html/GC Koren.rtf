\uc0\u49324 \u45800 \u51008  \'93\u54805 \u51228 \u46308 \u51012  \u52280 \u49548 \u54616 \u45912  \u51088 \'94\u51060 \u48064 \u47196  \u49324 \u46988 \u46308 \u47196  \u54616 \u50668 \u44552  \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u51032  \u51096 \u47803 \u44284  \u44208 \u51216 \u51012  \u44288 \u52272 \u54616 \u44172  \u54616 \u44256 , \u44536 \u44163 \u46308 \u51012  \u49324 \u46988 \u46308 \u51032  \u45576 \u50640  \u46916 \u44172  \u54616 \u45716  \u48152 \u47732 \u50640  \u44536 \u46308 \u51032  \u51339 \u51008  \u54665 \u50948 \u45716  \u47568 \u50630 \u51060  \u51648 \u45208 \u52432  \u48260 \u47532 \u46020 \u47197  \u54616 \u47140 \u45716  \u44163 \u51060  \u44536 \u51032  \u51221 \u49888 \u51060 \u45796 . \u44536 \u45716  \u54616 \u45208 \u45784 \u44760 \u49436  \u50689 \u54844 \u51012  \u44396 \u50896 \u54616 \u45716  \u49324 \u50629 \u51012  \u54616 \u44256  \u44228 \u49884 \u45716  \u46041 \u50504  \u50616 \u51228 \u45208  \u54876 \u46041 \u54616 \u44256  \u51080 \u45796 . \u54616 \u45208 \u45784 \u51032  \u50500 \u46308 \u46308 \u51060  \u50668 \u54840 \u50752  \u50526 \u50640  \u50732  \u46412 \u50640  \u49324 \u45800 \u46020  \u46608 \u54620  \u44144 \u44592  \u54632 \u44760  \u52280 \u50668 \u54620 \u45796 . \u47784 \u46304  \u49888 \u50521  \u48512 \u55141 \u51060  \u51068 \u50612 \u45216  \u46412 \u47560 \u45796  \u44536 \u45716  \u44536  \u44032 \u50868 \u45936  \u47560 \u51020 \u51060  \u44648 \u45143 \u54616 \u51648  \u47803 \u54616 \u44256  \u51221 \u49888 \u51060  \u44148 \u51204 \u52824  \u47803 \u54620  \u51088 \u46308 \u51060  \u46308 \u50612 \u50724 \u44172  \u54620 \u45796 . \u44536 \u47088  \u49324 \u46988 \u46308 \u51060  \u51652 \u47532 \u51032  \u50612 \u46500  \u51068 \u48512 \u47484  \u48155 \u50500 \u46308 \u51060 \u44256  \u49888 \u51088 \u51032  \u51088 \u47532 \u47484  \u52264 \u51648 \u54616 \u44172  \u46104 \u47732  \u49324 \u45800 \u51008  \u51593 \u49884  \u44536 \u46308 \u51012  \u53685 \u54616 \u50668  \u4422