\f1\b0 \cf0 \
\uc0\u50948 \u44536 \u45432  \u44368 \u46020 \u46308 \u51032  \u46020 \u54588 \u50752  \u54632 \u44760  \u51068 \u48152 \u51201 \u51064  \u49632 \u53748 \u44032  \u54532 \u46993 \u49828 \u47484  \u50628 \u49845 \u54616 \u50688 \u45796 . \u48264 \u54868 \u54616 \u45912  \u49373 \u49328  \u46020 \u49884 \u45716  \u53440 \u46973 \u54620  \u46020 \u49884 \u47196  \u51204 \u46973 \u46104 \u44256 , \u48708 \u50725 \u54616 \u45912  \u51648 \u48169 \u51008  \u50896 \u49884 \u51201 \u51064  \u54889 \u47924 \u51648 \u47196  \u48148 \u45068 \u44256 , \u51060 \u49345 \u54620  \u51652 \u48372 \u47484  \u48372 \u51064  \u44592 \u44036  \u54980 \u47196  \u51648 \u51201  \u48512 \u51652 \u44284  \u46020 \u45909 \u51201  \u53748 \u54224 \u44032  \u44228 \u49549 \u46104 \u50632 \u45796 . \u54028 \u47532 \u45716  \u54616 \u45208 \u51032  \u44144 \u45824 \u54620  \u44396 \u48712 \u50896  (\u25937 \u36007 \u38498 ) \u51060  \u46104 \u50632 \u51004 \u47728 , \u54785 \u47749 \u51060  \u51068 \u50612 \u45208 \u45912  \u45817 \u49884 \u50640  \u50557  20\u47564  \u47749 \u51032  \u44144 \u51648 \u46308 \u51060  \u50773 \u51032  \u49552 \u51004 \u47196  \u44396 \u51228 \u47484  \u48155 \u44256  \u51080 \u50632 \u45796 . \u44536 \u47084 \u45208  \u51228 \u49688 \u51060 \u53944  \u45817 \u50896 \u46308 \u47564 \u51008  \u49632 \u53748 \u54616 \u50668  \u44032 \u45716  \u45208 \u46972 \u50640 \u49436  \u54868 \u47140 \u54620  \u49373 \u54876 \u51012  \u54616 \u44256  \u44368 \u54924 \u50752  \u54617 \u44368 \u50752  \u44048 \u50725 \u44284  \u45432 \u50696 \u46308 \u51060  \u45432 \u47484  \u51219 \u45716  \u44068 \u47532 \u49440 \u50640 \u49436  \u47924 \u49436 \u50868  \u46021 \u51116 \u47484  \u54665 \u49324 \u54616 \u50688 \u45796 .\
\uc0\u54532 \u46993 \u49828 \u51032  \u49457 \u51649 \u51088 \u46308 , \u50773 , \u51077 \u48277 \u51088 \u46308 \u51032  \u49688 \u50756 \u51004 \u47196 \u46020  \u50612 \u51796  \u49688  \u50630 \u44172  \u46104 \u50612  \u47560 \u52840 \u45236  \u50728  \u45208 \u46972 \u44032  \u47924 \u51221 \u48512  \u49345 \u53468 \u50752  \u54028 \u47736 \u47196  \u46308 \u50612 \u44032 \u44172  \u47564 \u46304  \u44536  \u45208 \u46972 \u51032  \u49324 \u54924 \u51201 , \u51221 \u52824 \u51201  \u47928 \u51228 \u46308 \u50640  \u45824 \u54620  \u54644 \u44208 \u51008  \u48373 \u51020 \u51060  \u44032 \u51256 \u45796  \u51460  \u49688  \u51080 \u50632 \u51012  \u44163 \u51060 \u50632 \u45796 . \u44536 \u47084 \u45208  \u47196 \u47560 \u51032  \u51648 \u48176  \u50500 \u47000  \u51080 \u45716  \u48177 \u49457 \u46308 \u51008  \u44396 \u51452 \u44760 \u49436  \u44032 \u47476 \u52432  \u51452 \u49888  \u51088 \u50500  \u55148 \u49373 \u44284  \u47924 \u50500  (\u28961 \u25105 ) \u51032  \u49324 \u46993 \u51032  \u44480 \u54620  \u44368 \u54984 \u51012  \u51082 \u50612 \u48260 \u47160 \u45796 . \u44536 \u46308 \u51008  \u45796 \u47480  \u49324 \u46988 \u46308 \u51032  \u48373 \u47532 \u47484  \u50948 \u54616 \u50668  \u44537 \u44592 \u47484  \u49892 \u54665 \u54616 \u51648  \u50506 \u44172  \u46104 \u50632 \u45796 . \u48512 \u51088 \u44032  \u44032 \u45212 \u54620  \u51088 \u46308 \u51012  \u50517 \u51228 \u54616 \u50668 \u46020  \u50500 \u47924 \u47088  \u48708 \u45212 \u51012  \u48155 \u51648  \u50506 \u50520 \u44256 , \u44032 \u45212 \u54620  \u51088 \u46308 \u51008  \u44536 \u46308 \u51032  \u44256 \u50669 \u44284  \u50517 \u48149 \u50640  \u45824 \u54616 \u50668  \u50500 \u47924 \u47088  \u46020 \u50880 \u46020  \u48155 \u51012  \u49688  \u50630 \u50632 \u45796 . \u48512 \u50836 \u54616 \u44256  \u44428 \u47141  \u51080 \u45716  \u49324 \u46988 \u46308 \u51032  \u51060 \u44592 \u49900 \u51008  \u45908 \u50865  \u44537 \u49900 \u54616 \u44256  \u50613 \u50517 \u51201 \u51004 \u47196  \u45208 \u53440 \u45228 \u45796 . \u50668 \u47084  \u49464 \u44592 \u50640  \u44152 \u52432 \u49436  \u45208 \u53440 \u45212  \u44480 \u51313 \u46308 \u51032  \u53456 \u50837 \u44284  \u48169 \u53461 \u51008  \u45453 \u48124 \u46308 \u51012  \u50557 \u53448 \u54616 \u44256  \u52265 \u52712 \u54616 \u44592 \u50640  \u51060 \u47476 \u47104 \u45796 . \u48512 \u51088 \u45716  \u44032 \u45212 \u54620  \u51088 \u47484  \u54617 \u45824 \u54616 \u44256  \u44032 \u45212 \u54620  \u51088 \u45716  \u48512 \u51088 \u47484  \u48120 \u50892 \u54664 \u45796 .\
\uc0\u47566 \u51008  \u51648 \u48169 \u50640 \u49436  \u53664 \u51648 \u46308 \u51008  \u44480 \u51313 \u46308 \u51060  \u52264 \u51648 \u54616 \u50688 \u44256 , \u45432 \u46041  \u44228 \u44553 \u50640  \u49549 \u54616 \u45716  \u49324 \u46988 \u46308 \u51008  \u49548 \u51089 \u51012  \u54616 \u45716  \u45936  \u48520 \u44284 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u51088 \u44592 \u46308 \u51032  \u51648 \u51452 \u51032  \u51088 \u48708 \u50640  \u51032 \u51316 \u46104 \u50632 \u44256 , \u44536 \u46308 \u51032  \u51648 \u45208 \u52828  \u50836 \u44396 \u50640 \u46020  \u48373 \u51333 \u54616 \u51648  \u50500 \u45768 \u54616 \u47732  \u50504  \u46104 \u50632 \u45796 . \u44368 \u54924 \u50752  \u44397 \u44032 \u47484  \u50976 \u51648 \u54616 \u44592  \u50948 \u54620  \u48512 \u45812 \u51008  \u51473 \u47448 \u50752  \u54616 \u47448  \u44228 \u44553 \u50640 \u49436  \u48512 \u45812 \u54616 \u50688 \u51004 \u48064 \u47196 , \u44536 \u46308 \u50640 \u44172 \u45716  \u51665 \u44428 \u51088 \u50752  \u49457 \u51649 \u51088 \u46308 \u47196 \u48512 \u53552  \u47566 \u51008  \u49464 \u44032  \u48512 \u44284 \u46104 \u50632 \u45796 . \'93\u44480 \u51313 \u46308 \u51008  \u53132 \u46973 \u51012  \u51228 \u51068 \u47196  \u49373 \u44033 \u54616 \u50688 \u44256 , \u45453 \u48512 \u46308 \u51060  \u44406 \u50612  \u51453 \u45716  \u44163 \u50640 \u45716  \u51204 \u50672  \u44288 \u49900 \u51060  \u50630 \u50632 \u45796 . \'85\u48177 \u49457 \u46308 \u51008  \u50616 \u51228 \u45208  \u44536 \u46308 \u51032  \u51648 \u51452 \u51032  \u51204 \u51201 \u51064  \u51060 \u51061 \u51012  \u46020 \u47784 \u54616 \u50668  \u51452 \u51648  \u50506 \u51012  \u49688  \u50630 \u50632 \u45796 . \u45453 \u48512 \u46308 \u51032  \u49373 \u54876 \u51008  \u49892 \u47196  \u45130 \u51076 \u50630 \u45716  \u49688 \u44256 \u50752  \u47568 \u54624  \u49688  \u50630 \u51060  \u48708 \u52280 \u54620  \u49373 \u54876 \u51060 \u50632 \u45796 . \u44536 \u46308 \u51060  \u48520 \u54217 \u51012  \u47568 \u54616 \u47732  \u44536 \u44163 \u51008  \u50724 \u47564 \u54620  \u47784 \u50837 \u51004 \u47196  \u52712 \u44553 \u46104 \u50632 \u45796 . \u48277 \u51221 \u50640 \u49436 \u45716  \u50616 \u51228 \u45208  \u45453 \u48124 \u46308 \u51032  \u54840 \u49548 \u48372 \u45796 \u45716  \u44480 \u51313 \u46308 \u51032  \u47568 \u50640  \u44480 \u47484  \u44592 \u50872 \u50688 \u45796 . \u51116 \u54032 \u44288 \u46308 \u51060  \u45516 \u47932 \u51012  \u48155 \u45716  \u44163 \u51008  \u45572 \u44396 \u45208  \u45796  \u50500 \u45716  \u49324 \u49892 \u51060 \u50632 \u45796 . \u51068 \u48152  \u49324 \u54924 \u51032  \u51228 \u46020 \u44032  \u48512 \u54056 \u46120 \u51004 \u47196  \u47568 \u48120 \u50516 \u50500  \u44480 \u51313 \u46308 \u51032  \u48320 \u45909 \u49828 \u47084 \u50868  \u51452 \u51109 \u51060  \u48277 \u47456 \u44284  \u44057 \u51008  \u55192 \u51012  \u44054 \u44172  \u46104 \u50632 \u45796 . \u54217 \u48124 \u46308 \u51008  \u54620 \u54200 \u51004 \u47196  \u49464 \u49549 \u51201  \u44428 \u47141 \u51088 \u50640 \u44172 , \u45796 \u47480  \u54620 \u54200 \u51004 \u47196  \u49457 \u51649 \u51088 \u46308 \u50640 \u44172  \u49464 \u44552 \u51012  \u48148 \u52824 \u44172  \u46104 \u50632 \u45716 \u45936 , \u44536  \u49464 \u44552 \u51032  \u51208 \u48152 \u46020  \u50773 \u49892 \u51060 \u45208  \u44368 \u54924 \u51032  \u44552 \u44256 \u47196  \u46308 \u50612 \u44032 \u51648  \u50500 \u45768 \u54616 \u50688 \u45796 . \u44536  \u46024 \u51032  \u45208 \u47672 \u51648  \u48512 \u48516 \u51008  \u48169 \u53461 \u54620  \u51088 \u50500  \u48169 \u51333 \u50640  \u45229 \u48708 \u46104 \u50632 \u45796 . \u44536 \u47532 \u44256  \u51060 \u50752  \u44057 \u51060  \u51088 \u44592 \u46308 \u51032  \u46041 \u51313 \u46308 \u51012  \u44417 \u54605 \u54616 \u44172  \u47564 \u46300 \u45716  \u44536  \u49324 \u46988 \u46308 \u51008  \u50724 \u55176 \u47140  \u45225 \u49464 \u47484  \u47732 \u51228 \u48155 \u44256 , \u44397 \u44032 \u51032  \u48277 \u47456 \u44284  \u44288 \u47168 \u50640  \u46384 \u46972  \u50668 \u47084  \u44032 \u51648  \u51473 \u51649 \u50640 \u49436  \u44428 \u47532 \u47484  \u54665 \u49324 \u54616 \u50688 \u45796 . \u44536 \u50752  \u44057 \u51008  \u53945 \u44428 \u44228 \u44553 \u51032  \u49324 \u46988 \u46308 \u51008  \u50557  15\u47564  \u47749 \u51060 \u45208  \u46104 \u50632 \u45716 \u45936 , \u44536 \u46308 \u51032  \u50837 \u47581 \u51012  \u52649 \u51313 \u49884 \u53020  \u51452 \u44592  \u50948 \u54616 \u50668  \u49688 \u48177 \u47564  \u47749 \u51032  \u49324 \u46988 \u46308 \u51060  \u51208 \u47581 \u51201 \u51060 \u47728  \u48708 \u52280 \u54620  \u49373 \u54876 \u51012  \u54624  \u49688 \u48150 \u50640  \u50630 \u50632 \u45796 \'94 (\u48512 \u47197  22 \u52280 \u51312 ).\
