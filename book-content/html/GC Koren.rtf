\uc0\u48731 \u51008  \u54532 \u46993 \u49828 \u50752  \u49828 \u50948 \u49828 \u50640 \u46020  \u48708 \u52628 \u50612 \u51276 \u45796 . \u51068 \u52237 \u51060  \u54028 \u47120 \u44284  \u52860 \u48712 \u51060  \u51333 \u44368 \u44060 \u54785 \u51032  \u51652 \u47532 \u47484  \u49440 \u54252 \u54664 \u45912  \u51228 \u45348 \u48148 \u50640 \u49436  \u44032 \u50864 \u49468 \u51060  \u51116 \u47548  \u44592 \u48324 \u51012  \u51204 \u54616 \u50688 \u45796 . \u54617 \u49373 \u49884 \u51208 \u50640  \u44032 \u50864 \u49468 \u51008  18\u49464 \u44592  \u47568 \u50685 \u48512 \u53552  19\u49464 \u44592  \u52488 \u50685 \u50640  \u51060 \u47476 \u44592 \u44620 \u51648  \u50728  \u50976 \u47101 \u51012  \u55081 \u50424 \u44256  \u51080 \u45912  \u54633 \u47532 \u51452 \u51032  \u49324 \u49345  (\u21512 \u29702 \u20027 \u32681 \u24605 \u24819 ) \u44284  \u51217 \u52489 \u54620  \u51201 \u51060  \u51080 \u51004 \u47728 , \u44536 \u44032  \u51649 \u51217  \u51204 \u46020 \u50640  \u51333 \u49324 \u54616 \u44172  \u46112  \u46412 \u50640  \u44536 \u45716  \u50500 \u51649  \u52280 \u46108  \u49888 \u50521 \u51012  \u50508 \u51648  \u47803 \u54616 \u50688 \u51012  \u49104  \u50500 \u45768 \u46972  \u54924 \u51032 \u47200  (\u25079 \u30097 \u35542 ) \u51032  \u44221 \u54693 \u51012  \u44032 \u51648 \u44256  \u51080 \u50632 \u45796 . \u44536 \u47084 \u45208  \u47204 \u47536 \u51060  \u51200 \u49696 \u54620  \'93\u44256 \u45824  \u50669 \u49324 \'94\u47484  \u51069 \u51008  \u54980 , \u44536 \u45716  \u45796 \u45768 \u50648 \u49436  2\u51109 \u51032  \u47568 \u50432 \u51012  \u51452 \u47785 \u54616 \u44172  \u46104 \u50632 \u44256 , \u44536  \u49324 \u44032  (\u21490 \u23478 ) \u44032  \u44592 \u47197 \u54620  \u44536 \u45824 \u47196  \u49457 \u44221 \u51032  \u50696 \u50616 \u51060  \u45440 \u46972 \u50872  \u51221 \u46020 \u47196  \u51221 \u54869 \u55176  \u49457 \u52712 \u46108  \u44163 \u51012  \u48372 \u44256  \u44048 \u53444 \u54616 \u50688 \u45796 . \u49892 \u47196  \u44536 \u44163 \u51060  \u54980 \u45380 \u50640  \u44536 \u44032  \u50948 \u54744  \u51473 \u50640  \u52376 \u54624  \u46412  \u44403 \u49468  \u45819 \u51032  \u50669 \u54624 \u51012  \u54644 \u51452 \u50632 \u44256 , \u49457 \u44221 \u51060  \u50689 \u44048 \u51004 \u47196  \u44592 \u47197 \u46104 \u50632 \u45796 \u45716  \u54869 \u49888 \u51012  \u51452 \u50632 \u45796 . \u46300 \u46356 \u50612  \u44536 \u45716  \u54633 \u47532 \u51452 \u51032  \u49324 \u49345 \u50640  \u47564 \u51313 \u54624  \u49688  \u50630 \u44172  \u46104 \u50632 \u44256 , \u49457 \u44221 \u51012  \u50672 \u44396 \u54632 \u51004 \u47196  \u45908 \u50865  \u48516 \u47749 \u54620  \u48731 \u51012  \u44648 \u45803 \u44172  \u46104 \u50632 \u45796 . \u44536 \u45716  \u44208 \u44397  \u51201 \u44537 \u51201  \u49888 \u50521 \u51012  \u44032 \u51648 \u44172  \u46104 \u50632 \u45796 .\
\uc0\u44536 \u45716  \u50696 \u50616 \u51012  \u50672 \u44396 \u54616 \u45716  \u51473 \u50640  \u51452 \u45784 \u51032  \u51116 \u47548 \u51060  \u51208 \u48149 \u54616 \u50688 \u45796 \u45716  \u44163 \u51012  \u54869 \u49888 \u54616 \u44172  \u46104 \u50632 \u45796 . \u44536  \u50948 \u45824 \u54620  \u51652 \u47532 \u51032  \u50628 \u49689 \u54616 \u44256  \u51473 \u45824 \u54632 \u51012  \u51208 \u49892 \u55176  \u45712 \u45184  \u44536 \u45716  \u44536 \u44163 \u51012  \u48177 \u49457 \u46308 \u50640 \u44172  \u51204 \u54616 \u44256 \u51088  \u50676 \u47581 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u45817 \u49884 \u50640  \u45796 \u45768 \u50648 \u51032  \u50696 \u50616 \u51008  \u50724 \u47896 \u54620  \u44163 \u51060 \u48064 \u47196  \u44648 \u45804 \u51012  \u49688  \u50630 \u45796 \u45716  \u44163 \u51060  \u51068 \u48152 \u51201 \u51064  \u44204 \u54644 \u50688 \u44592  \u46412 \u47928 \u50640  \u44536 \u51032  \u49324 \u50629 \u51008  \u53360  \u51109 \u50528 \u47484  \u47564 \u45228 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u45716  \u51068 \u52237 \u51060  \u54028 \u47120 \u51060  \u51228 \u45348 \u48148 \u50640 \u49436  \u51204 \u46020 \u54624  \u46412  \u49324 \u50857 \u54620  \u48169 \u48277 , \u44263  \u47676 \u51200  \u50612 \u47536 \u51060 \u46308 \u50640 \u44172  \u51204 \u46020 \u54616 \u50668  \u44536 \u46308 \u51012  \u53685 \u54616 \u50668  \u48512 \u47784 \u46308 \u50640 \u44172  \u44288 \u49900 \u51012  \u45132 \u44172  \u54616 \u45716  \u48169 \u48277 \u51012  \u50416 \u44592 \u47196  \u44208 \u49900 \u54616 \u50688 \u45796 .\
\uc0\u54999 \u45216 \u50640  \u44536 \u45716  \u45817 \u49884 \u50640  \u49324 \u50857 \u54664 \u45912  \u48169 \u48277 \u50640  \u45824 \u54616 \u50668  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u54616 \u50688 \u45796 . \'93\u45208 \u45716  \u45796  \u50500 \u45716  \u48169 \u48277 \u51004 \u47196  \u51652 \u47532 \u47484  \u51204 \u54616 \u44256 \u51088  \u51089 \u51221 \u54616 \u44256  \u50500 \u51060 \u46308 \u50640 \u44172  \u51652 \u47532 \u47484  \u47568 \u54616 \u44172  \u46104 \u50632 \u45716 \u45936 , \u44536 \u44163 \u51008  \u51473 \u50836 \u49457 \u51060  \u51089 \u44592  \u46412 \u47928 \u50640 \u49436 \u44032  \u50500 \u45768 \u44256  \u50724 \u55176 \u47140  \u44536  \u51652 \u47532 \u51032  \u44032 \u52824 \u44032  \u52984 \u44592  \u46412 \u47928 \u51060 \u50632 \u51020 \u51012  \u51060 \u54644 \u54616 \u44592  \u48148 \u46976 \u45796 . \u45208 \u45716  \u45208 \u51032  \u47568 \u51012  \u46308 \u50612 \u51452 \u44592 \u47484  \u55148 \u47581 \u54616 \u50688 \u51648 \u47560 \u45716  \u45236 \u44032  \u52376 \u51020 \u48512 \u53552  \u51109 \u49457 \u54620  \u49324 \u46988 \u46308 \u51012  \u49345 \u45824 \u47196  \u47568 \u54616 \u51648  \u50500 \u45768 \u54620  \u44163 \u51008  \u44536 \u46308 \u51060  \u46308 \u50612 \u51452 \u51648  \u50500 \u45768 \u54624 \u44620  \u50684 \u47140 \u54620  \u46412 \u47928 \u51060 \u50632 \u45796 .\'94 \'93\u44536 \u47532 \u54616 \u50668  \u45208 \u45716  \u50500 \u51452  \u50612 \u47536 \u50500 \u51060 \u46308 \u50640 \u44172  \u44032 \u44592 \u47196  \u44208 \u49900 \u54616 \u50688 \u45796 . \u47676 \u51200  \u50500 \u51060 \u46308 \u51012  \u52397 \u51473 \u51004 \u47196  \u47784 \u51004 \u44592 \u47196  \u54616 \u50688 \u44256 , \u44536  \u52397 \u51473 \u51032  \u49688 \u54952 \u44032  \u47566 \u50500 \u51648 \u44256  \u46608  \u44536 \u46308 \u51060  \u45208 \u51032  \u47568 \u51012  \u46307 \u44256  \u44592 \u48848 \u54616 \u44256  \u55141 \u48120  \u51080 \u44172  \u47928 \u51228 \u47484  \u51060 \u54644 \u54616 \u44256  \u49444 \u47749 \u54616 \u44592 \u44620 \u51648  \u46104 \u47732 , \u45208 \u45716  \u48120 \u44396 \u50640  \u44536  \u45796 \u51020  \u45800 \u44228 \u51032  \u54876 \u46041  \u48516 \u50556 \u44032  \u51204 \u44060 \u46112  \u44163 \u51012  \u54869 \u49888 \u54616 \u50688 \u45796 . \u44536  \u45796 \u51020 \u50640 \u45716  \u50612 \u47480 \u46308 \u51060  \u52280 \u49437 \u54616 \u50668  \u50672 \u44396 \u54624  \u44032 \u52824 \u44032  \u51080 \u45796 \u45716  \u44163 \u51012  \u44648 \u45803 \u44172  \u46112  \u44163 \u51012  \u51032 \u49900 \u54616 \u51648  \u50506 \u50520 \u45796 . \u44536 \u47111 \u44172 \u47564  \u46104 \u47732  \u51060  \u51068 \u51008  \u49457 \u44277 \u54616 \u44172  \u46108 \u45796 \'94 (L.Gaussen, Daniel the Prophet, vol.2, Preface).\
\uc0\u44536  \u54876 \u46041 \u51008  \u49457 \u44277 \u54616 \u50688 \u45796 . \u44536 \u44032  \u50500 \u51060 \u46308 \u50640 \u44172  \u47568 \u54616 \u44256  \u51080 \u51012  \u46412 \u50640  \u50612 \u47480 \u46308 \u46020  \u46308 \u51004 \u47084  \u50772 \u45796 . \u44536 \u51032  \u44368 \u54924 \u51032  \u51340 \u49437 \u46308 \u51008  \u51452 \u51032  \u44618 \u44172  \u44221 \u52397 \u54616 \u45716  \u52397 \u51473 \u46308 \u47196  \u47564 \u50896 \u51060  \u46104 \u50632 \u45796 . \u44536  \u52397 \u51473  \u44032 \u50868 \u45936 \u45716  \u51648 \u50948 \u44032  \u45458 \u51008  \u49324 \u46988 \u46308 \u44284  \u54617 \u49885  \u51080 \u45716  \u49324 \u46988 \u46308 \u46020  \u51080 \u50632 \u44256 , \u51228 \u45348 \u48148 \u47484  \u52286 \u50500 \u50728  \u45208 \u44536 \u45348 \u46308 \u44284  \u50808 \u44397  \u49324 \u46988 \u46308 \u46020  \u51080 \u50632 \u51004 \u48064 \u47196  \u44536 \u46308 \u51060  \u46308 \u51008  \u44592 \u48324 \u51008  \u45796 \u47480  \u51648 \u48169 \u51004 \u47196  \u51204 \u54644 \u51276 \u45796 .\
\uc0\u51060 \u50752  \u44057 \u51008  \u49457 \u44277 \u51004 \u47196  \u50857 \u44592 \u47484  \u50619 \u51008  \u44032 \u50864 \u49468 \u51008  \u54532 \u46993 \u49828 \u50612 \u47484  \u47568 \u54616 \u45716  \u44368 \u54924 \u46308 \u50640 \u44172  \u50696 \u50616 \u49436 \u51032  \u50672 \u44396 \u47484  \u51109 \u47140 \u54624  \u47785 \u51201 \u51004 \u47196  \u44536 \u44032  \u44032 \u47476 \u52828  \u45236 \u50857 \u51012  \u52636 \u54032 \u54616 \u50688 \u45796 . \u50500 \u51060 \u46308 \u50640 \u44172  \u46308 \u47140 \u51456  \u44368 \u54984 \u51012  \u52636 \u54032 \u54620  \u51060 \u50976 \u45716  \u51060 \u54644 \u54616 \u44592  \u50612 \u47157 \u45796 \u45716  \u44396 \u49892 \u47196  \u51060 \u47088  \u51333 \u47448 \u51032  \u52293 \u46308 \u51012  \u55124 \u55176  \u46321 \u54620 \u55176  \u50668 \u44592 \u45716  \u50612 \u47480 \u46308 \u50640 \u44172  \'91\u50500 \u51060 \u46308 \u46020  \u51060 \u54644 \u54616 \u45716  \u44163 \u51012  \u50612 \u52236  \u51060 \u54644 \u54616 \u44592  \u50612 \u47157 \u45796 \u44256  \u47568 \u54624  \u49688  \u51080 \u44192 \u45712 \u45264 ?\'92\u44256  \u51452 \u51109 \u54616 \u44592  \u50948 \u54632 \u51060 \u50632 \u45796 . \u44536 \u45716  \u44228 \u49549 \u54616 \u50668  \u47568 \u54616 \u50688 \u45796 . \'93\u45208 \u45716  \u54624  \u49688  \u51080 \u45716  \u45824 \u47196  \u50864 \u47532  \u49888 \u51088 \u46308 \u50640 \u44172  \u50696 \u50616 \u51032  \u51648 \u49885 \u51012  \u44032 \u47476 \u52432  \u51452 \u47140 \u44256  \u53356 \u44172  \u50676 \u47581 \u54620 \u45796 .\'94 \'93\u50724 \u45720 \u45216  \u50696 \u50616 \u51032  \u50672 \u44396 \u48372 \u45796  \u45908  \u54596 \u50836 \u54620  \u44163 \u51008  \u50630 \u45796 .\'94 \'93\u44536 \u44163 \u51004 \u47196  \u50864 \u47532 \u45716  \u51208 \u48149 \u54620  \u54872 \u45212 \u51012  \u50948 \u54616 \u50668  \u51456 \u48708 \u54616 \u44256 , \u50696 \u49688  \u44536 \u47532 \u49828 \u46020 \u47484  \u48148 \u46972 \u48372 \u44256  \u4459