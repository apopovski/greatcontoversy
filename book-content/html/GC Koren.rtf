\uc0\u49332 \u50500 \u45224 \u51008  \u51032 \u51064 \u46308 \u51008  \'93\u49692 \u49885 \u44036 \u50640  \u54848 \u50672 \u55176  \u45796  \u48320 \u54868 \'94\u46108 \u45796 . \u54616 \u45208 \u45784 \u51032  \u51020 \u49457 \u51004 \u47196  \u44536 \u46308 \u51008  \u50689 \u44305 \u49828 \u47084 \u50868  \u47800 \u51004 \u47196  \u48320 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u51060 \u51228  \u51453 \u51648  \u50506 \u51012  \u47800 \u51004 \u47196  \u48148 \u45068 \u50612 \u51256  \u48512 \u54876 \u54620  \u49457 \u46020 \u46308 \u44284  \u54632 \u44760  \u45132 \u47140  \u50732 \u46972 \u44032  \u44277 \u51473 \u50640 \u49436  \u51452 \u45784 \u51012  \u50689 \u51217 \u54620 \u45796 . \u52380 \u49324 \u46308 \u51008  \'93\u44536  \u53469 \u54616 \u49888  \u51088 \u46308 \u51012  \u54616 \u45720  \u51060  \u45149 \u50640 \u49436  \u51200  \u45149 \u44620 \u51648  \u49324 \u48169 \u50640 \u49436  \u47784 \'94\u51008 \u45796 . \u50612 \u47536 \u50500 \u51060 \u46308 \u51008  \u52380 \u49324 \u46308 \u50640  \u51032 \u54616 \u50668  \u50612 \u47672 \u45768 \u46308 \u51032  \u54036 \u50640  \u50504 \u44596 \u45796 . \u49324 \u47581 \u51004 \u47196  \u50724 \u47019 \u46041 \u50504  \u54756 \u50612 \u51276 \u45912  \u52828 \u44396 \u46308 \u51060  \u45796 \u49884  \u47564 \u45208  \u45796 \u49884 \u45716  \u54756 \u50612 \u51648 \u51648  \u50506 \u44172  \u46104 \u47728  \u44536 \u46308 \u51008  \u54632 \u44760  \u51600 \u44144 \u50868  \u45432 \u47000 \u47484  \u48512 \u47476 \u47732 \u49436  \u54616 \u45208 \u45784 \u51032  \u46020 \u49457 \u51004 \u47196  \u50732 \u46972 \u44036 \u45796 .\
\uc0\u44396 \u47492 \u49688 \u47112 \u51032  \u50577 \u51901 \u50640 \u45716  \u45216 \u44060 \u44032  \u51080 \u44256 , \u44536  \u50500 \u47000 \u45716  \u49328  \u48148 \u53300 \u44032  \u51080 \u45796 . \u49688 \u47112 \u44032  \u50948 \u47484  \u54693 \u54616 \u50668  \u44404 \u47084 \u44040  \u46412 \u47560 \u45796  \u48148 \u53300 \u45716  \'93\u44144 \u47337 \u54616 \u45796 \'94\u44256  \u49548 \u47532 \u47484  \u45240 \u45796 . \u45216 \u44060  \u50669 \u49884  \u50880 \u51649 \u51068  \u46412 \u47560 \u45796  \'93\u44144 \u47337 \u54616 \u45796 \'94\u44256  \u48512 \u47476 \u51670 \u45716 \u45796 . \u49688 \u54665 \u54616 \u45716  \u52380 \u49324 \u46308 \u46020  \'93\u44144 \u47337 \u54616 \u45796 , \u44144 \u47337 \u54616 \u45796 , \u44144 \u47337 \u54616 \u45796 , \u51452  \u54616 \u45208 \u45784  \u44263  \u51204 \u45733 \u54616 \u49888  \u51060 \u50668 \'94 \u54616 \u44256  \u48512 \u47476 \u51670 \u45716 \u45796 . \u44536 \u47532 \u44256  \u49688 \u47112 \u44032  \u51216 \u51216  \u49352  \u50696 \u47336 \u49332 \u47128 \u51012  \u54693 \u54616 \u50668  \u50732 \u46972 \u44040  \u46412  \u44396 \u50896 \u48155 \u51008  \u49324 \u46988 \u46308 \u51008  \u54624 \u47120 \u47336 \u50556 !\'94\u46972 \u44256  \u50808 \u52828 \u45796 .\
\uc0\u54616 \u45208 \u45784 \u51032  \u46020 \u49457 \u50640  \u46308 \u50612 \u44032 \u44592  \u51204 \u50640  \u44396 \u51452 \u44760 \u49436 \u45716  \u45817 \u49888 \u51012  \u46384 \u47480  \u51088 \u46308 \u50640 \u44172  \u49849 \u47532 \u51032  \u55064 \u51109 \u51012  \u51452 \u49884 \u44256  \u50773 \u51313 \u51004 \u47196 \u49436 \u51032  \u49888 \u48516 \u51032  \u54364 \u47484  \u51452 \u49888 \u45796 . \u44536  \u44305 \u55064  \u52268 \u46976 \u54620  \u54665 \u47148 \u51008  \u44536 \u46308 \u51032  \u50773  \u51452 \u50948 \u50640  \u46181 \u44536 \u47111 \u44172  \u46168 \u47084 \u49440 \u45796 . \u51452 \u45784 \u51008  \u47784 \u46304  \u49457 \u46020 \u50752  \u52380 \u49324 \u46308 \u48372 \u45796  \u45908 \u50865  \u50948 \u50628 \u51060  \u51080 \u44256  \u53360  \u47784 \u49845 \u51004 \u47196  \u45208 \u53440 \u45208 \u44256  \u44536 \u48516 \u51032  \u50620 \u44404 \u50640 \u49436  \u55128 \u47084 \u45208 \u50724 \u45716  \u48731 \u51008  \u50728 \u54868 \u54620  \u49324 \u46993 \u51004 \u47196  \u45336 \u52828 \u45796 . \u44396 \u50896 \u48155 \u51008  \u49472  \u49688  \u50630 \u51060  \u53360  \u47924 \u47532 \u46308 \u51008  \u47784 \u46160  \u51452 \u45784 \u51012  \u51452 \u47785 \u54616 \u44256  \u51068 \u52237 \u51060  \'93\u44536  \u50620 \u44404 \u51060  \u53440 \u51064 \u48372 \u45796  \u49345 \u54616 \u50688 \u44256  \u44536  \u47784 \u50577 \u51060  \u51064 \u49373 \u48372 \u45796  \u49345 \u54616 \u50688 \'94\u45912  \u51452 \u45784 \u51032  \u50689 \u44305 \u51012  \u52432 \u45796 \u48376 \u45796 . \u50696 \u49688 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u50724 \u47480 \u49552 \u51004 \u47196  \u49849 \u47532 \u51088 \u46308 \u51032  \u47672 \u47532 \u50640  \u50689 \u44305 \u51032  \u44288 \u51012  \u50444 \u50892 \u51452 \u49888 \u45796 . \u44033  \u49324 \u46988 \u50640 \u44172  \u44288 \u51060  \u51452 \u50612 \u51648 \u45716 \u45936 , \u44144 \u44592 \u45716  \'93\u49352  \u51060 \u47492 \'94\u51060  \u49352 \u44200 \u51256  \u51080 \u44256 , \'93\u50668 \u54840 \u50752 \u44760  \u49457 \u44208 \'94\u51060 \u46972 \u44256  \u44592 \u47197 \u46104 \u50612  \u51080 \u45796 . \u47784 \u46304  \u49324 \u46988 \u51032  \u49552 \u50640 \u45716  \u49849 \u47532 \u51032  \u51333 \u47140 \u44032 \u51648 \u50752  \u48731 \u45208 \u45716  \u44144 \u47928 \u44256 \u44032  \u51536 \u50612 \u51652 \u45796 . \u44536 \u47532 \u54616 \u50668  \u51648 \u55064 \u54616 \u45716  \u52380 \u49324 \u44032  \u51020 \u51012  \u47582 \u52628 \u51088  \u47784 \u46304  \u49552 \u51008  \u54988 \u47469 \u54616 \u44172  \u44144 \u47928 \u44256 \u47484  \u53020 \u44172  \u46104 \u44256 , \u50500 \u47492 \u45813 \u44256  \u54413 \u48512 \u54620  \u51020 \u51312 \u44032  \u55128 \u47084 \u45208 \u50724 \u44172  \u46108 \u45796 . \u47784 \u46304  \u49324 \u46988 \u51032  \u47560 \u51020 \u51008  \u47568 \u54624  \u49688  \u50630 \u45716  \u44048 \u44201 \u50640  \u49324 \u47196 \u51105 \u54784  \u47784 \u46160  \u44048 \u49324 \u51032  \u52268 \u48120 \u47484  \u48512 \u47480 \u45796 . \'93\u50864 \u47532 \u47484  \u49324 \u46993 \u54616 \u49324  \u44536 \u51032  \u54588 \u47196  \u50864 \u47532  \u51396 \u50640 \u49436  \u50864 \u47532 \u47484  \u54644 \u48169 \u54616 \u49884 \u44256  \u44536  \u50500 \u48260 \u51648  \u54616 \u45208 \u45784 \u51012  \u50948 \u54616 \u50668  \u50864 \u47532 \u47484  \u45208 \u46972 \u50752  \u51228 \u49324 \u51109 \u51004 \u47196  \u49340 \u51004 \u49888  \u44536 \u50640 \u44172  \u50689 \u44305 \u44284  \u45733 \u47141 \u51060  \u49464 \u49464 \u53664 \u47197  \u51080 \u44592 \u47484  \u50896 \u54616 \u45432 \u46972 \'94 (\u44228  1:5, 6).\
\uc0\u49549 \u47049  \u48155 \u51008  \u47924 \u47532 \u46308  \u50526 \u50640 \u45716  \u44144 \u47337 \u54620  \u49457 \u51060  \u45208 \u53440 \u45212 \u45796 . \u50696 \u49688 \u44760 \u49436 \u45716  \u51652 \u51452 \u47928 \u51012  \u45331 \u44172  \u50668 \u49884 \u44256  \u51652 \u47532 \u47484  \u51648 \u53416  \u48177 \u49457 \u46308 \u51012  \u51064 \u46020 \u54616 \u50668  \u46308 \u50612 \u44032 \u44172  \u54616 \u49888 \u45796 . \u44144 \u44592 \u49436  \u44536 \u46308 \u51008  \u54616 \u45208 \u45784 \u51032  \u45209 \u50896 , \u44263  \u50500 \u45812 \u51060  \u49692 \u44208 \u54664 \u45912  \u49884 \u51208 \u51032  \u48376 \u54693 \u51012  \u48376 \u45796 . \u44536 \u46412  \u44536 \u46308 \u51008  \u49324 \u46988 \u51032  \u44480 \u47196  \u51068 \u52237 \u51060  \u46308 \u50612 \u48376  \u50612 \u46500  \u51020 \u50501 \u48372 \u45796  \u45908 \u50865  \u54988 \u47469 \u54620  \u51020 \u49457 \u51012  \u46307 \u45716 \u45796 . \'93\u45320 \u55148  \u49912 \u50880 \u51008  \u45149 \u45228 \u45796 \'94, \'93\u45236  \u50500 \u48260 \u51648 \u44760  \u48373  \u48155 \u51012  \u51088 \u46308 \u51060 \u50668 , \u45208 \u50500 \u50752  \u52285 \u49464 \u47196 \u48512 \u53552  \u45320 \u55148 \u47484  \u50948 \u54616 \u50668  \u50696 \u48708 \u46108  \u45208 \u46972 \u47484  \u49345 \u49549 \u54616 \u46972 .\'94 \u44396 \u51452 \u44760 \u49436  \u51228 \u51088 \u46308 \u51012  \u50948 \u54616 \u50668  \u46300 \u47536  \u44592 \u46020 \u44032  \u51060 \u51228  \u49457 \u52712 \u46108 \u45796 . \'93\u50500 \u48260 \u51648 \u50668  \u45236 \u44172  \u51452 \u49888  \u51088 \u46020  \u45208  \u51080 \u45716  \u44275 \u50640  \u45208 \u50752  \u54632 \u44760  \u51080 \'85\u44592 \u47484  \u50896 \u54616 \u50741 \u45208 \u51060 \u45796 .\'94 \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u54588 \u47196  \u49549 \u47049 \u54620  \u51088 \u46308 \u51012  \'93\u55136 \u51060  \u50630 \u51060  \u51600 \u44144 \u50880 \u51004 \u47196 \'94 (\u50976  24) \u50500 \u48260 \u51648 \u50640 \u44172  \u48372 \u50668  \u51452 \u49884 \u47732 \u49436  \u47568 \u50432 \u54616 \u49888 \u45796 . \'93\u50668 \u44592 \u50640  \u45236 \u44032  \u51080 \u51004 \u47728  \u50500 \u48260 \u51648 \u44760 \u49436  \u45236 \u44172  \u51452 \u49888  \u51088 \u45376 \u46308 \u46020  \u51080 \u49845 \u45768 \u45796 .\'94 \'93\u45236 \u44172  \u51452 \u49888  \u51200 \u55148 \u47484  \u48372 \u51204 \u54616 \u50752  \u51648 \u53412 \u50632 \u45208 \u51060 \u45796 .\'94 \u50500 , \u50620 \u47560 \u45208  \u45440 \u46972 \u50868  \u49549 \u51396 \u51032  \u49324 \u46993 \u51064 \u44032 ! \u50500 \u48260 \u51648  \u54616 \u45208 \u45784 \u44760 \u49436  \u49549 \u47049  \u48155 \u51008  \u51088 \u46308 \u51012  \u52432 \u45796 \u48372 \u49884 \u44256  \u44536 \u46308 \u50640 \u44172  \u45817 \u49888 \u51032  \u54805 \u49345 \u51060  \u48152 \u50689 \u46104 \u50612  \u51080 \u45716  \u44163 \u44284  \u51396 \u51032  \u55124 \u51201 \u44284  \u50516 \u50689  (\u26263 \u24433 ) \u51060  \u51228 \u44144 \u46104 \u50612  \u51064 \u47448 \u44032  \u45796 \u49884  \u54616 \u45208 \u45784 \u44284  \u51312 \u54868 \u46108  \u44163 \u51012  \u48372 \u49892  \u46412 \u45716  \u47568 \u47196  \u54364 \u54788 \u54624  \u49688  \u50630 \u45716  \u44592 \u49244  \u49692 \u44036 \u51060  \u46108 \u45796 !\
\uc0\u50696 \u49688 \u44760 \u49436 \u45716  \u47568 \u54624  \u49688  \u50630 \u45716  \u49324 \u46993 \u51004 \u47196  \u45817 \u49888 \u44760  \u52649 \u49457 \u54620  \u51088 \u46308 \u51012  \'93\u51452 \u51064 \u51032  \u51600 \u44144 \u50880 \'94\u50640  \u52280 \u50668 \u54616 \u46020 \u47197  \u54872 \u50689 \u54616 \u49888 \u45796 . \u44396 \u51452 \u51032  \u51600 \u44144 \u50880 \u51008  \u45817 \u49888 \u51032  \u44256 \u53685 \u44284  \u44404 \u50837 \u51004 \u47196  \u44396 \u50896 \u54620  \u50689 \u54844 \u46308 \u51012  \u50689 \u44305 \u51032  \u45208 \u46972 \u50640 \u49436  \u48372 \u45716  \u44163 \u51060 \u45796 . \u46608 \u54620  \u44396 \u49549 \u48155 \u51008  \u51088 \u46308 \u46020  \u44536 \u46308 \u51032  \u44592 \u46020 \u50752  \u49688 \u44256 \u50752  \u55148 \u49373 \u51012  \u53685 \u54616 \u50668  \u44536 \u47532 \u49828 \u46020 \u44760  \u51064 \u46020 \u54620  \u51088 \u46308 \u51012  \u44536  \u52629 \u48373 \u48155 \u51008  \u47924 \u47532  \u51473 \u50640 \u49436  \u48372 \u44172  \u46112  \u46412 , \u51452 \u45784 \u51032  \u44592 \u49256 \u50640  \u54632 \u44760  \u52280 \u50668 \u54616 \u45716  \u51088 \u46308 \u51060  \u46112  \u44163 \u51060 \u45796 . \u44536 \u46308 \u51060  \u53356 \u44256  \u55152  \u48372 \u51340  \u51452 \u50948 \u50640  \u47784 \u51068  \u46412  \u47568 \u54624  \u49688  \u50630 \u45716  \u44592 \u49256 \u51060  \u44536 \u46308 \u51032  \u47560 \u51020 \u51012  \u52292 \u50864 \u44172  \u46112  \u44163 \u51060 \u45796 . \u46608 \u54620  \u44536 \u46308 \u51008  \u44536  \u46412 \u50640  \u44536 \u47532 \u49828 \u46020 \u47484  \u50948 \u54616 \u50668  \u51064 \u46020 \u54620  \u51088 \u46308 \u51012  \u48372 \u44172  \u46104 \u44256 , \u44536  \u51064 \u46020 \u47484  \u48155 \u51008  \u51088 \u46308 \u51060  \u46608  \u45796 \u47480  \u49324 \u46988 \u46308 \u51012  \u51064 \u46020 \u54616 \u44256 , \u44536  \u45796 \u47480  \u49324 \u46988 \u46308 \u51060  \u46608 \u54620  \u45796 \u49884  \u45796 \u47480  \u49324 \u46988 \u46308 \u51012  \u51064 \u46020 \u54616 \u50668  \u44536 \u46308 \u51060  \u47784 \u46160  \u50504 \u49885 \u51032  \u54616 \u45720 \u50640  \u46308 \u50612 \u50724 \u44172  \u46108  \u44163 \u51012  \u48372 \u44172  \u46104 \u50612 , \u44536 \u46308 \u51008  \u51452 \u45784 \u51032  \u48156 \u50500 \u47000  \u44536 \u46308 \u51032  \u47732 \u47448 \u44288 \u51012  \u45912 \u51648 \u44256  \u50689 \u50896 \u55176  \u51452 \u45784 \u51012  \u52268 \u49569 \u54616 \u44172  \u46108 \u45796 .\
