\uc0\u44536 \u47532 \u49828 \u46020 \u47484  \u46384 \u47476 \u45716  \u49324 \u46988 \u46308 \u51008  \u49324 \u45800 \u44284  \u44536 \u51032  \u48512 \u54616 \u46308 \u51060  \u44536 \u46308 \u50640  \u45824 \u54616 \u50668  \u44984 \u48120 \u44256  \u51080 \u45716  \u51020 \u47784 \u47484  \u48324 \u47196  \u50508 \u51648  \u47803 \u54620 \u45796 . \u44536 \u47084 \u45208  \u54616 \u45720 \u50640  \u51340 \u51221 \u54644  \u44228 \u49888  \u54616 \u45208 \u45784 \u51008  \u45817 \u49888 \u51032  \u50896 \u45824 \u54620  \u44228 \u54925 \u51012  \u51060 \u47336 \u49884 \u44592  \u50948 \u54616 \u50668  \u44536 \u47088  \u44036 \u44228 \u46308 \u51012  \u47784 \u46160  \u51228 \u50517 \u54644  \u48260 \u47532 \u49892  \u44163 \u51060 \u45796 . \u51452 \u45784 \u44760 \u49436  \u45817 \u49888 \u51032  \u48177 \u49457 \u46308 \u51060  \u49900 \u54620  \u49884 \u47144 \u51012  \u48155 \u46020 \u47197  \u54728 \u46973 \u54616 \u49884 \u45716  \u44163 \u51008  \u44536 \u48516 \u44760 \u49436  \u44536 \u46308 \u51060  \u48155 \u45716  \u48264 \u48124 \u44284  \u44256 \u53685 \u51012  \u44592 \u48848 \u54616 \u49884 \u44592  \u46412 \u47928 \u50640 \u49436 \u44032  \u50500 \u45768 \u44256  \u44536 \u46308 \u51032  \u52572 \u54980  \u49849 \u47532 \u50640  \u44536 \u47088  \u44284 \u51221 \u51060  \u54596 \u50836 \u54616 \u44592  \u46412 \u47928 \u50640 \u49436 \u51060 \u45796 . \u44536 \u48516 \u44760 \u49436 \u45716  \u49884 \u51333  \u50668 \u51068 \u54616 \u44172  \u45817 \u49888  \u51088 \u49888 \u51032  \u50689 \u44305 \u51004 \u47196  \u44536 \u46308 \u51012  \u50976 \u54841 \u50640 \u49436  \u48372 \u54840 \u54616 \u49892  \u49688 \u45716  \u50630 \u51004 \u49884 \u45796 . \u50780 \u45264 \u54616 \u47732  \u49884 \u47144 \u51032  \u52280  \u47785 \u51201 \u51008  \u47784 \u46304  \u50501 \u51032  \u50976 \u54841 \u51012  \u45824 \u51201 \u54624  \u49688  \u51080 \u46020 \u47197  \u44536 \u46308 \u51012  \u51456 \u48708 \u49884 \u53412 \u45716  \u45936  \u51080 \u4