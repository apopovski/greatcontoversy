\uc0\u51396 \u51032  \u49884 \u51089 \u44284  \u44536  \u51316 \u51116  \u51060 \u50976 \u45716  \u47566 \u51008  \u49324 \u46988 \u46308 \u50640 \u44172  \u53360  \u49688 \u49688 \u44760 \u45180 \u44032  \u46104 \u50612  \u51080 \u45796 . \u44536 \u46308 \u51008  \u50501 \u51032  \u49548 \u50948  (\u25152 \u29234 ) \u50752  \u44536  \u47924 \u49436 \u50868  \u44208 \u44284 \u47196  \u49373 \u44592 \u45716  \u48520 \u54665 \u44284  \u54028 \u47736 \u51012  \u47785 \u44201 \u54620 \u45796 . \u44536 \u47532 \u44256  \u44536 \u46308 \u51008  \u47924 \u54620 \u54620  \u51648 \u54812 \u50752  \u45733 \u47141 \u44284  \u49324 \u46993 \u51060  \u47924 \u54620 \u54616 \u49888  \u54616 \u45208 \u45784 \u51032  \u53685 \u52824  \u50500 \u47000  \u51060 \u47088  \u51068 \u51060  \u50612 \u46523 \u44172  \u51316 \u51116 \u54624  \u49688  \u51080 \u45716 \u44032  \u51032 \u49900 \u54620 \u45796 . \u50668 \u44592 \u50640  \u44536 \u46308 \u51060  \u49444 \u47749 \u54624  \u49688  \u50630 \u45716  \u49888 \u48708 \u44032  \u51080 \u45796 . \u48520 \u49888 \u44284  \u51032 \u49900 \u50640  \u49912 \u50668  \u51080 \u44592  \u46412 \u47928 \u50640  \u44536 \u46308 \u51008  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432  \u44032 \u50868 \u45936  \u48516 \u47749 \u55176  \u45208 \u53440 \u45208  \u51080 \u44256  \u44396 \u50896 \u50640  \u54596 \u49688 \u51201 \u51064  \u51652 \u47532 \u50640  \u45824 \u54616 \u50668  \u45576 \u51060  \u47680 \u50612  \u51080 \u45796 . \u51396 \u51032  \u51316 \u51116 \u50640  \u44288 \u54616 \u50668  \u51656 \u47928 \u54616 \u47732 \u49436  \u54616 \u45208 \u45784 \u44760 \u49436  \u44208 \u53076  \u44228 \u49884 \u54616 \u51648  \u50506 \u51004 \u49888  \u44163 \u44620 \u51648  \u50508 \u50500 \u45236 \u44256 \u51088  \u45432 \u47141 \u54616 \u45716  \u51088 \u46308 \u51060  \u51080 \u45796 . \u44536 \u47084 \u48064 \u47196  \u44536 \u46308 \u51008  \u44536 \u46308 \u51060  \u44032 \u51652  \u50612 \u47140 \u50880 \u51012  \u54644 \u44208 \u54616 \u51648  \u47803 \u54620 \u45796 . \u51032 \u49900 \u54616 \u44256  \u53944 \u51665  \u51105 \u44592 \u47484  \u51339 \u50500 \u54616 \u45716  \u44592 \u51656 \u50640  \u51032 \u54616 \u50668  \u54665 \u46041 \u54616 \u45716  \u51088 \u46308 \u51008  \u44536 \u44163 \u51012  \u44396 \u49892 \u47196  \u49457 \u44221 \u51032  \u47568 \u50432 \u51012  \u44144 \u51208 \u54644  \u48260 \u47536 \u45796 . \u44536 \u47084 \u45208  \u50612 \u46500  \u49324 \u46988 \u46308 \u51008  \u50976 \u51204 \u44284  \u44536 \u47495 \u46108  \u54644 \u49437 \u51060  \u54616 \u45208 \u45784 \u51032  \u54408 \u49457 \u44284  \u44536 \u48516 \u51032  \u51221 \u48512 \u51032  \u49457 \u44201 \u44284  \u54616 \u45208 \u45784 \u44760 \u49436  \u51396 \u47484  \u52376 \u47532 \u54616 \u45716  \u50896 \u52825  \u46321 \u50640  \u44288 \u54620  \u49457 \u44221 \u51032  \u44368 \u54984 \u51012  \u47784 \u54840 \u54616 \u44172  \u47564 \u46308 \u50612  \u48260 \u47536  \u44620 \u45805 \u50640  \u50501 \u50640  \u44288 \u54620  \u53360  \u47928 \u51228 \u50640  \u45824 \u54616 \u50668  \u47564 \u51313 \u54616 \u44172  \u51060 \u54644 \u54616 \u51648  \u47803 \u54620 \u45796 .\
\uc0\u51396 \u50501 \u51032  \u49884 \u51089 \u51008  \u44536  \u51316 \u51116  \u51060 \u50976 \u50752  \u47560 \u52268 \u44032 \u51648 \u47196  \u49444 \u47749 \u54624  \u49688  \u50630 \u45796 . \u44536 \u47084 \u45208  \u51396 \u51032  \u49884 \u51089 \u44284  \u51396 \u51032  \u52572 \u51333 \u51201 \u51064  \u52376 \u48516 , \u50501 \u51012  \u52376 \u47532 \u54616 \u45716  \u45936  \u51080 \u50612 \u49436  \u54616 \u45208 \u45784 \u51032  \u51088 \u48708 \u50752  \u44277 \u51032 \u44032  \u50756 \u51204 \u55176  \u45208 \u53440 \u45208 \u44172  \u46104 \u45716  \u44163 \u50640  \u45824 \u54616 \u50668 \u49436 \u45716  \u52649 \u48516 \u55176  \u51060 \u54644 \u54624  \u49688  \u51080 \u45796 . \u49457 \u44221 \u50640  \u47924 \u50631 \u48372 \u45796  \u48516 \u47749 \u55176  \u50508 \u47140 \u51256  \u51080 \u45716  \u44163 \u51008  \u54616 \u45208 \u45784 \u44760 \u49436  \u51396 \u44032  \u46308 \u50612 \u50728  \u44163 \u50640  \u45824 \u54616 \u50668  \u51204 \u54784  \u52293 \u51076 \u51060  \u50630 \u51004 \u49884 \u45796 \u45716  \u44163 , \u54616 \u45208 \u45784 \u51032  \u51221 \u48512 \u50640 \u45716  \u48152 \u50669 \u51012  \u51068 \u51004 \u53420  \u51312 \u44148 \u51060  \u46112  \u47564 \u54620  \u50500 \u47924 \u47088  \u44208 \u54632 \u51060  \u50630 \u44256  \u54616 \u45208 \u45784 \u44760 \u49436  \u45817 \u49888 \u51032  \u51008 \u54812 \u47484  \u44053 \u51228 \u51201 \u51004 \u47196  \u44144 \u46160 \u50612  \u48260 \u47536  \u51068 \u51060  \u50630 \u45796 \u45716  \u44163  \u46321 \u51060 \u45796 . \u51396 \u45716  \u54616 \u45208 \u51032  \u47924 \u45800  \u52840 \u51077 \u51088 \u51060 \u45796 . \u44536 \u44163 \u51060  \u45208 \u53440 \u45208 \u44172  \u46108  \u45936 \u45716  \u50500 \u47924 \u47088  \u51060 \u50976 \u44032  \u50630 \u45796 . \u51396 \u45716  \u50724 \u47896 \u54620  \u44163 \u51060 \u47728 , \u49444 \u47749 \u54624  \u49688  \u50630 \u45716  \u44163 \u51060 \u45796 . \u44536 \u44163 \u51012  \u49444 \u47749 \u5461