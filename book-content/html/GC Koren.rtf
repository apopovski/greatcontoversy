\uc0\u54000 \u53804 \u49828 \u45716  \u44400 \u49324 \u46308 \u51032  \u48516 \u45432 \u47484  \u51652 \u51221 \u49884 \u53420  \u49688  \u50630 \u51020 \u51012  \u50508 \u44256  \u51109 \u44368  (\u23559 \u26657 ) \u46308 \u44284  \u54632 \u44760  \u47800 \u49548  \u49457 \u51204  \u45236 \u48512 \u47484  \u51312 \u49324 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u44536  \u49457 \u51204 \u51032  \u51109 \u47140  (\u22767 \u40599 ) \u54632 \u44284  \u54868 \u47140 \u54632 \u50640  \u45440 \u46972 \u51648  \u50506 \u51012  \u49688  \u50630 \u50632 \u45796 . \u50500 \u51649  \u49457 \u49548 \u44620 \u51648 \u45716  \u48520 \u44600 \u51060  \u48120 \u52824 \u51648  \u50500 \u45768 \u54616 \u50688 \u51004 \u48064 \u47196  \u44536 \u45716  \u44536 \u44163 \u51012  \u44396 \u54644 \u45236 \u44592  \u50948 \u54616 \u50668  \u51080 \u45716  \u55192 \u51012  \u45796 \u54616 \u50668  \u45432 \u47141 \u54616 \u50688 \u45796 . \u44536 \u47532 \u44256  \u44536 \u45716  \u46832 \u50612 \u45208 \u50724 \u47732 \u49436 , \u48520 \u44600 \u51012  \u47561 \u51004 \u46972 \u44256  \u44400 \u49324 \u46308 \u51012  \u46021 \u47140 \u54616 \u50688 \u45796 . \u48177 \u48512 \u51109  \u47532 \u48288 \u46980 \u47532 \u49828  (Liberalis) \u45716  \u44536 \u51032  \u52280 \u47784  \u51109 \u44368 \u46308 \u44284  \u54632 \u44760  \u44536 \u51032  \u47749 \u47161 \u50640  \u48373 \u51333 \u52992  \u54616 \u47140 \u44256  \u55192 \u50024  \u48372 \u50520 \u45796 . \u44536 \u47084 \u45208  \u47196 \u47560  \u54889 \u51228 \u50640  \u45824 \u54620  \u44400 \u49324 \u46308 \u51032  \u51316 \u44221 \u49900 \u51312 \u52264 \u46020  \u50976 \u45824 \u51064 \u46308 \u50640  \u45824 \u54620  \u49900 \u54620  \u48516 \u45432 , \u51204 \u53804 \u51032  \u44201 \u47148 \u54620  \u55141 \u48516 , \u44536 \u47532 \u44256  \u53456 \u50837 \u49828 \u47084 \u50868  \u50557 \u53448 \u50640 \u51032  \u44040 \u47581 \u51012  \u47561 \u51012  \u49688  \u50630 \u50632 \u45796 . \u44400 \u51064 \u46308 \u51008  \u51088 \u44592 \u46308 \u51032  \u51452 \u50948 \u50640  \u51080 \u45716  \u47784 \u46304  \u44163 \u46308 \u51060  \u44552 \u51004 \u47196  \u52268 \u46976 \u54616 \u44172  \u48731 \u45208 \u45716  \u44163 \u51012  \u48372 \u50520 \u45716 \u45936  \u44536 \u44163 \u51008  \u53440 \u50724 \u47476 \u45716  \u54868 \u50684 \u50640  \u48152 \u49324 \u46104 \u50612  \u45576 \u51060  \u48512 \u49884 \u46020 \u47197  \u48731 \u45228 \u45796 . \u44536 \u46308 \u51008  \u49457 \u49548  \u50504 \u50640 \u45716  \u54756 \u50500 \u47540  \u49688  \u50630 \u45716  \u48372 \u54868 \u44032  \u44048 \u52656 \u51256  \u51080 \u51012  \u44163 \u51004 \u47196  \u49373 \u44033 \u54616 \u50688 \u45796 . \u46300 \u46356 \u50612  \u54620  \u49324 \u48337 \u51060  \u50500 \u47924 \u46020  \u47784 \u47476 \u44172  \u49457 \u49548 \u51032  \u47928 \u51032  \u46028 \u51788 \u44480 \u46308  \u49324 \u51060 \u47196  \u48520 \u48537 \u51008  \u54915 \u48520 \u51012  \u45912 \u51256  \u45347 \u51088 , \u50728  \u44148 \u47932 \u51008  \u49341 \u49884 \u44036 \u50640  \u54868 \u50684 \u50640  \u49912 \u50668  \u48260 \u47160 \u45796 . \u51088 \u50865 \u54620  \u50672 \u44592 \u50752  \u48520 \u44600  \u46412 \u47928 \u50640  \u51109 \u44368 \u46308 \u44284  \u44400 \u49324 \u46308 \u51008  \u48512 \u46301 \u51060  \u47932 \u47084 \u45208 \u50724 \u44172  \u46104 \u50632 \u44256 , \u47560 \u52840 \u45236  \u44536  \u54988 \u47469 \u54620  \u44148 \u47932 \u51008  \u54028 \u47736 \u45817 \u54616 \u44256  \u47568 \u50520 \u45796 .\
\uc0\u44536 \u44163 \u51060  \u47196 \u47560 \u44400 \u50640 \u44172  \u44536 \u52376 \u47100  \u49548 \u47492 \u45180 \u52824 \u45716  \u44305 \u44221 \u51060  \u46104 \u50632 \u45796 \u47732  \u50976 \u45824 \u51064 \u50640 \u44172  \u51080 \u50612 \u49436 \u45716  \u50620 \u47560 \u45208  \u45908 \u50865  \u44536 \u47084 \u54664 \u44192 \u45716 \u44032 ! \u50728  \u49457 \u51060  \u45236 \u47140 \u45796 \u48372 \u51060 \u45716  \u49328 \u44845 \u45824 \u44592  \u51204 \u52404 \u45716  \u54616 \u45208 \u51032  \u54876 \u54868 \u49328  (\u27963 \u28779 \u23665 ) \u52376 \u47100  \u48520 \u53440 \u44256  \u51080 \u50632 \u45796 . \u44148 \u47932 \u46308 \u51008  \u44361 \u51020 \u44284  \u54632 \u44760  \u54616 \u45208 \u50473  \u54616 \u45208 \u50473  \u52264 \u47168 \u47196  \u45336 \u50612 \u51256  \u48520 \u44396 \u45929 \u51060  \u49549 \u51004 \u47196  \u49340 \u53020 \u51648 \u44256  \u47568 \u50520 \u45796 . \u48177 \u54693 \u47785  \u51648 \u48533 \u51008  \u48520 \u48537 \u51008  \u51333 \u51079 \u51109 \u46308 \u44284  \u44057 \u50520 \u44256 , \u46020 \u44552 \u54620  \u52392 \u53457  (\u23574 \u22612 ) \u46308 \u51008  \u49352 \u48744 \u44036  \u49632 \u44844 \u52313 \u51060 \u52376 \u47100  \u48731 \u45228 \u44256 , \u53457 \u47336  (\u22612 \u27155 ) \u45716  \u45458 \u51008  \u48520 \u44284  \u50672 \u44592  \u44592 \u46181 \u51060  \u46104 \u50612  \u48260 \u47160 \u45796 . \u44032 \u44620 \u51060  \u51080 \u45716  \u49328 \u46308 \u51008  \u48520 \u48731 \u50640  \u48708 \u52712 \u50612  \u54872 \u54616 \u44172  \u46300 \u47084 \u45228 \u44256 , \u44536  \u47736 \u47581 \u51032  \u44284 \u51221 \u51012  \u44277 \u54252 \u50640  \u51656 \u47536  \u52292  \u50684 \u47140 \u54616 \u47732 \u49436  \u51452 \u49884 \u54616 \u44256  \u51080 \u45716  \u45209 \u45812 \u54620  \u47924 \u47532 \u46308 \u51060  \u48520 \u48731 \u50640  \u46300 \u47084 \u45228 \u45796 . \u44536 \u47532 \u44256  \u49457 \u48317  \u50948 \u50640 \u50752  \u49457  \u51473  \u45458 \u51008  \u44275 \u46308 \u51008  \u49324 \u46988 \u46308 \u47196  \u48264 \u51105 \u51012  \u51060 \u47336 \u50632 \u45716 \u45936  \u44536  \u51473 \u50640 \u45716  \u51208 \u47581 \u51201 \u51064  \u44256 \u48124 \u51004 \u47196  \u49352 \u54028 \u46999 \u44172  \u51656 \u47536  \u49324 \u46988 \u46308 \u46020  \u51080 \u50632 \u44256 , \u54620 \u54200 \u51004 \u47196 \u45716  \u47924 \u51061 \u54620  \u48373 \u49688 \u49900 \u51004 \u47196  \u50620 \u44404 \u51012  \u52236 \u54392 \u47536  \u49324 \u46988 \u46308 \u46020  \u51080 \u50632 \u45796 . \u46832 \u50612 \u45796 \u45768 \u45716  \u47196 \u47560  \u48337 \u51221 \u46308 \u51032  \u54632 \u49457 , \u48520 \u50640  \u53440 \u49436  \u51453 \u50612 \u44032 \u45716  \u49324 \u46988 \u46308 \u51032  \u50528 \u52376 \u47196 \u50868  \u48512 \u47476 \u51670 \u51020 \u51060  \u48520 \u48537 \u45716  \u49548 \u47532 \u50752  \u44148 \u47932 \u51032  \u51116 \u47785 \u46308 \u51060  \u47924 \u45320 \u51256  \u45236 \u47140 \u50505 \u45716  \u53360  \u49548 \u47532 \u50752  \u46244 \u49438 \u50668  \u46308 \u47160 \u45796 . \u44536 \u47532 \u44256  \u44536  \u49548 \u47532 \u46308 \u51008  \u49324 \u46988 \u46308 \u51032  \u50872 \u48512 \u51670 \u45716  \u49548 \u47532 \u50752  \u54633 \u54616 \u50668  \u49328 \u50872 \u47548 \u51060  \u46104 \u50612  \u46028 \u50500 \u50772 \u45796 \u44032 \u45716  \u45796 \u49884  \u46028 \u50500 \u44052 \u45796 . \u49457 \u48317  \u50948 \u50640 \u46020  \u48708 \u47749 \u44284  \u53685 \u44257 \u51032  \u49548 \u47532 \u44032  \u46244 \u49438 \u50688 \u51004 \u47728 , \u51452 \u47140 \u49436  \u44144 \u51032  \u51453 \u44172  \u46108  \u49324 \u46988 \u46308 \u46020  \u44536 \u46308 \u51032  \u45224 \u51008  \u44592 \u50868 \u51012  \u45796 \u54616 \u50668  \u44256 \u48124 \u44284  \u48708 \u53444 \u51032  \u48512 \u47476 \u51670 \u51020 \u51012  \u48156 \u54616 \u44256  \u51080 \u50632 \u45796 .\
\uc0\u49457 \u45236 \u51032  \u49332 \u50977 \u51008  \u49457  \u48150 \u51032  \u44536 \u44163 \u48372 \u45796 \u46020  \u45908 \u50865  \u48708 \u52280 \u54616 \u50688 \u45796 . \u45224 \u51088 \u45208 , \u50668 \u51088 \u45208 , \u45721 \u51008 \u51060 \u45208  \u51210 \u51008 \u51060 , \u54253 \u46020 \u45208  \u51228 \u49324 \u51109 , \u49912 \u50864 \u45716  \u51088 \u45208  \u51088 \u48708 \u47484  \u44396 \u54616 \u45716  \u51088 \u45208  \u47924 \u52264 \u48324 \u54616 \u44172  \u54617 \u49332 \u51012  \u45817 \u54616 \u50688 \u45796 . \u51453 \u51076 \u51012  \u45817 \u54620  \u51088 \u46308 \u51032  \u49688 \u54952 \u45716  \u51453 \u51060 \u45716  \u51088 \u46308 \u51032  \u49688 \u54952 \u48372 \u45796  \u55016 \u50476  \u45908  \u47566 \u50520 \u45796 . \u47196 \u47560  \u44400 \u51064 \u46308 \u51008  \u46020 \u47449 \u54616 \u45716  \u51068 \u51012  \u54616 \u44592  \u50948 \u54616 \u50668  \u44536  \u51452 \u44160 \u51032  \u47924 \u45908 \u44592 \u47484  \u44592 \u50612  \u50732 \u46972 \u44032 \u50556  \u54664 \u45796  (Milman, The History of the Jews, book 16).\
\uc0\u49457 \u51204 \u51060  \u54028 \u44340 \u46108  \u54980 \u50640  \u50728  \u49457 \u51008  \u44263  \u47196 \u47560 \u44400 \u51032  \u49688 \u51473 \u50640  \u46308 \u50612 \u44032 \u44256  \u47568 \u50520 \u45796 . \u50976 \u45824 \u51032  \u51648 \u46020 \u51088 \u46308 \u51008  \u45212 \u44277 \u48520 \u46973 \u51060 \u46972 \u44256  \u49373 \u44033 \u54616 \u45912  \u44536 \u46308 \u51032  \u48372 \u47336  (\u22561 \u22744 ) \u47484  \u45236 \u50612 \u48260 \u47532 \u44256  \u45804 \u50500 \u45228 \u51004 \u48064 \u47196  \u54000 \u53804 \u49828 \u44032  \u44144 \u44592  \u51060 \u47476 \u47104 \u51012  \u46412 \u50640 \u45716  \u50724 \u51649  \u51201 \u47561 \u49104 \u51060 \u50632 \u45796 . \u44536 \u45716  \u44536  \u48372 \u47336 \u46308 \u51012  \u48372 \u44256  \u45440 \u46992 \u51004 \u47728  \u54616 \u45208 \u45784 \u44760 \u49436  \u44536 \u44163 \u46308 \u51012  \u51088 \u44592 \u50640 \u44172  \u51452 \u49512 \u45796 \u44256  \u47568 \u54616 \u50688 \u45796 . \u50780 \u45264 \u54616 \u47732  \u50500 \u47924 \u47532  \u44053 \u47141 \u54620  \u51201 \u44400 \u51068 \u51648 \u46972 \u46020  \u45733 \u55176  \u51060 \u50752  \u44057 \u51060  \u44144 \u45824 \u54620  \u48372 \u47336 \u46308 \u51012  \u45824 \u54637 \u54616 \u50668  \u51216 \u47161 \u54624  \u49688  \u50630 \u45716  \u44620 \u45805 \u51060 \u50632 \u45796 . \u44536 \u47084 \u45208  \u51060 \u51228 \u45716  \u44536  \u46020 \u49457 \u44284  \u49457 \u51204 \u51060  \u50756 \u51204 \u55176  \u54028 \u44340 \u46104 \u50612  \u44536  \u44144 \u47337 \u54620  \u49457 \u51204 \u51032  \u53552 \u45716  \'93\u48173 \u44057 \u51060  \u44221 \u51089 \u54632 \u51012  \u45817 \u54616 \u50688 \u45796 \'94 (\u47128  26:18). \u44536  \u49457 \u51032  \u54252 \u50948 \u50752  \u46244 \u51060 \u51008  \u54617 \u49332  \u46412 \u47928 \u50640  \u47785 \u49704 \u51012  \u51075 \u51008  \u51088 \u46308 \u51008  \u49688 \u48177 \u47564 \u50640  \u45804 \u54616 \u50688 \u44256 , \u45224 \u51008  \u51088 \u46308 \u51008  \u54252 \u47196 \u44032  \u46104 \u50612  \u44052 \u44144 \u45208  \u51333 \u51004 \u47196  \u54036 \u47140  \u44032 \u44172  \u46104 \u50632 \u51004 \u47728 , \u49849 \u47532 \u51088 \u51032  \u44060 \u49440 \u51012  \u50689 \u44305 \u49828 \u47101 \u44172  \u54616 \u44592  \u50948 \u54616 \u50668  \u47196 \u47560 \u47196  \u45132 \u47140 \u44032 \u49436  \u50896 \u54805 \u44537 \u51109 \u50640 \u49436  \u51664 \u49849 \u51032  \u48165 \u51060  \u46104 \u44592 \u46020  \u54616 \u44256 , \u54841 \u51008  \u50976 \u46993 \u51032  \u48177 \u49457 \u51060  \u46104 \u50612  \u49324 \u48169 \u51004 \u47196  \u50976 \u47532 \u54616 \u45716  \u51088 \u44032  \u46104 \u44592 \u46020  \u54616 \u50688 \u45796 .\
\uc0\u50976 \u45824 \u51064 \u46308 \u51008  \u44536 \u46308 \u51060  \u52272  \u52264 \u44844 \u47484  \u49828 \u49828 \u47196  \u47564 \u46308 \u50632 \u44256 , \u44536 \u46308 \u51060  \u47560 \u49892  \u48373 \u49688 \u51032  \u51092 \u51012  \u49828 \u49828 \u47196  \u52292 \u50912 \u45796 . \u44536 \u46308 \u51060  \u44397 \u44032 \u51201 \u51004 \u47196  \u45817 \u54620  \u50756 \u51204 \u54620  \u47736 \u47581 \u51060 \u45208 , \u44536 \u46308 \u51032  \u48169 \u54889 \u54616 \u45716  \u52376 \u51648 \u50640 \u49436  \u48155 \u51008  \u51200 \u51452 \u45716  \u44536 \u46308  \u51088 \u49888 \u51032  \u49552 \u51004 \u47196  \u49100 \u47536  \u44163 \u51012  \u44144 \u46160 \u45716  \u45936  \u48520 \u44284 \u54664 \u45796 . \u49440 \u51648 \u51088 \u45716  \'93\u51060 \u49828 \u46972 \u50648 \u50500  \u45348 \u44032  \u54056 \u47581 \u54616 \u50688 \u45208 \u45768 \'94, \'93\u45348 \u44032  \u48520 \u51032 \u54632 \u51012  \u51064 \u54616 \u50668  \u50638 \u46300 \u47084 \u51276 \u45712 \u45768 \u46972 \'94 (\u54840  13:9, 14:1) \u44256  \u47568 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51060  \u45817 \u54620  \u44256 \u45212 \u51012  \u54616 \u45208 \u45784 \u44760 \u49436  \u51649 \u51217  \u45236 \u47532 \u49888  \u51669 \u48268 \u47196  \u55124 \u55176 \u46308  \u51060 \u50556 \u44592 \u54620 \u45796 . \u45824 \u44592 \u47564 \u51088 \u45716  \u51060 \u50752  \u44057 \u51060  \u54616 \u50668  \u51088 \u44592 \u44032  \u54665 \u54620  \u51068 \u51012  \u49704 \u44592 \u47140 \u44256  \u50528 \u50420 \u45796 . \u54616 \u45208 \u45784 \u51032  \u51088 \u48708 \u47484  \u50756 \u44053 \u54616 \u44172  \u44144 \u51208 \u54632 \u51004 \u47196  \u47568 \u48120 \u50516 \u50500  \u50976 \u45824 \u51064 \u46308 \u51008  \u44536 \u46308 \u50640 \u44172 \u49436  \u54616 \u45208 \u45784 \u51032  \u48372 \u54840 \u54616 \u49900 \u51060  \u46496 \u45208 \u44032 \u44172  \u54616 \u50688 \u51004 \u47728  \u49324 \u45800 \u51008  \u44536 \u46308 \u51012  \u47560 \u51020 \u45824 \u47196  \u51452 \u44288 \u54616 \u46020 \u47197  \u54728 \u46973 \u48155 \u50520 \u45912  \u44163 \u51060 \u45796 . \u50696 \u47336 \u49332 \u47128 \u51032  \u47736 \u47581 \u50640  \u45208 \u53440 \u45212  \u47924 \u49453 \u44256  \u51092 \u54841 \u54620  \u47784 \u46304  \u49324 \u44148 \u46308 \u51008  \u51088 \u49888 \u51012  \u49324 \u45800 \u51032  \u51648 \u48176 \u50640  \u47585 \u44592 \u45716  \u51088 \u46308 \u50640 \u44172  \u49324 \u45800 \u51060  \u50620 \u47560 \u45208  \u47924 \u49436 \u50868  \u47560 \u47141  (\u39764 \u21147 ) \u51012  \u55064 \u46160 \u47476 \u45716 \u51648 \u47484  \u48372 \u50668 \u51452 \u45716  \u54616 \u45208 \u51032  \u49892 \u47168 \u51060 \u45796 .\
\uc0\u50864 \u47532 \u45716  \u50864 \u47532 \u44032  \u45572 \u47532 \u45716  \u54217 \u50504 \u44284  \u50504 \u51204 \u50640  \u45824 \u54616 \u50668  \u44536 \u47532 \u49828 \u46020 \u44760  \u50620 \u47560 \u45208  \u53360  \u48730 \u51012  \u51648 \u44256  \u51080 \u45716 \u51648  \u50508  \u49688  \u50630 \u45796 . \u49324 \u46988 \u46308 \u51012  \u49324 \u45800 \u51032  \u51648 \u48176 \u50640  \u50756 \u51204 \u55176  \u48736 \u51648 \u51648  \u50506 \u46020 \u47197  \u54644 \u51452 \u45716  \u44163 \u51008  \u54616 \u45208 \u45784 \u51032  \u50613 \u51228 \u54616 \u49884 \u45716  \u45733 \u47141 \u51060 \u45796 . \u48520 \u49692 \u51333 \u54616 \u44256  \u48176 \u51008 \u47581 \u45909 \u54620  \u51088 \u51068 \u51648 \u46972 \u46020  \u50501 \u54620  \u51088 \u51032  \u51092 \u51064 \u54616 \u44256  \u49324 \u50501 \u54620  \u49464 \u47141 \u51012  \u47561 \u50500  \u51452 \u49884 \u45716  \u54616 \u45208 \u45784 \u51032  \u51088 \u48708 \u50752  \u50724 \u47000  \u52280 \u51004 \u49900 \u50640  \u45824 \u54616 \u50668  \u44048 \u49324 \u54616 \u50668 \u50556  \u54624  \u53360  \u51060 \u50976 \u44032  \u51080 \u45796 . \u44536 \u47084 \u45208  \u49324 \u46988 \u51060  \u54616 \u45208 \u45784 \u51032  \u50724 \u47000  \u52280 \u51004 \u49900 \u51032  \u54620 \u44228 \u47484  \u48279 \u50612 \u45208 \u44172  \u46104 \u47732  \u44536 \u50752  \u44057 \u51008  \u44204 \u51228  (\u29309 \u21046 ) \u45716  \u51228 \u44144 \u46108 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u48276 \u51396 \u50640  \u45824 \u54620  \u54032 \u44208 \u51012  \u51665 \u54665 \u54616 \u49884 \u45716  \u48516 \u51004 \u47196  \u51396 \u51064  \u50526 \u50640  \u49436 \u51648  \u50506 \u51004 \u49888 \u45796 . \u44536 \u47084 \u45208  \u44536 \u48516 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u51088 \u48708 \u47484  \u44144 \u51208 \u54616 \u45716  \u51088 \u46308 \u51012  \u48260 \u47140  \u46160 \u49884 \u49324  \u44536 \u46308  \u49828 \u49828 \u47196  \u49900 \u51008  \u44163 \u51012  \u44144 \u46160 \u44172  \u54616 \u49888 \u45796 . \u47784 \u46304  \u51652 \u47532 \u51032  \u48731 \u51012  \u44144 \u51208 \u54620  \u44163 , \u47784 \u46304  \u44221 \u44256 \u47484  \u47736 \u49884 \u54616 \u44256  \u50976 \u51032 \u54616 \u51648  \u50500 \u45768 \u54620  \u44163 , \u50728 \u44054  \u51221 \u50837 \u50640  \u48736 \u51652  \u44163 , \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51012  \u48276 \u54620  \u44163  \u46321 \u51008  \u53952 \u47548 \u50630 \u51060  \u49100 \u47536  \u45824 \u47196  \u49688 \u54869 \u54616 \u44172  \u46112  \u50472 \u51060 \u45796 . \u54616 \u45208 \u45784 \u51032  \u49888 \u51008  \u50756 \u44256 \u54616 \u44172  \u44144 \u51208 \u54616 \u45716  \u51396 \u51064 \u50640 \u44172 \u49436  \u47560 \u52840 \u45236  \u46496 \u45208 \u49888 \u45796 . \u44536 \u47111 \u44172  \u46112  \u46412 , \u50689 \u54844 \u51032  \u50501 \u54620  \u51221 \u50837 \u51012  \u51228 \u50612 \u54624  \u45733 \u47141 \u51060  \u50630 \u50612 \u51648 \u44256  \u49324 \u45800 \u51032  \u50896 \u54620 \u44284  \u51201 \u51032  (\u25973 \u24847 ) \u47196 \u48512 \u53552  \u48372 \u54840 \u47484  \u48155 \u51648  \u47803 \u54616 \u44172  \u46108 \u45796 . \u50696 \u47336 \u49332 \u47128 \u51032  \u47736 \u47581 \u51008  \u54616 \u45208 \u45784 \u44760 \u49436  \u51452 \u49884 \u45716  \u44144 \u47337 \u54620  \u51008 \u54812 \u47484  \u49548 \u54848 \u55176  \u50668 \u44592 \u44256  \u54616 \u45208 \u45784 \u51032  \u51088 \u48708 \u51032  \u54840 \u49548 \u47484  \u44144 \u49828 \u47476 \u45716  \u47784 \u46304  \u49324 \u46988 \u46308 \u50640  \u45824 \u54620  \u46160 \u47157 \u44256 \u46020  \u50628 \u49689 \u54620  \u44221 \u44256 \u51060 \u45796 . \u51396 \u50640  \u45824 \u54620  \u54616 \u45208 \u45784 \u51032  \u51613 \u50724 \u50752  \u51396 \u51064 \u51060  \u48155 \u51012  \u48516 \u47749 \u54620  \u54805 \u48268 \u50640  \u45824 \u54616 \u50668  \u51060 \u48372 \u45796  \u45908  \u44208 \u51221 \u51201 \u51064  \u51613 \u50616 \u51012  \u51452 \u49888  \u46412 \u45716  \u51068 \u52237 \u51060  \u50630 \u50632 \u45796 .\
