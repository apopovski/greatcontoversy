\uc0\u47084 \u54168 \u48652 \u47476 \u51032  \u47928 \u54616 \u49373 \u46308  \u44032 \u50868 \u45936 \u45716  \u44536 \u51032  \u47568 \u50640  \u50676 \u49900 \u55176  \u44480 \u47484  \u44592 \u50872 \u51060 \u45716  \u50557 \u44036 \u51032  \u54617 \u49373 \u46308 \u51060  \u51080 \u50632 \u45716 \u45936 , \u44536 \u46308 \u51008  \u47084 \u54168 \u48652 \u47476 \u44032  \u51453 \u51008  \u54980  \u44536 \u51032  \u46244 \u47484  \u51060 \u50612  \u51652 \u47532 \u47484  \u44228 \u49549 \u54644 \u49436  \u51204 \u54624  \u44163 \u51060 \u50632 \u45796 . \u50956 \u47532 \u50516  \u54028 \u47120  (William Farel) \u51008  \u44536 \u46308  \u51473 \u51032  \u54620  \u49324 \u46988 \u51060 \u50632 \u45796 . \u44536 \u45716  \u44221 \u44148 \u54620  \u48512 \u47784 \u51032  \u50500 \u46308 \u47196 \u49436  \u44368 \u54924 \u51032  \u44032 \u47476 \u52840 \u51012  \u51204 \u49900 \u51004 \u47196  \u48155 \u50500 \u46308 \u51060 \u46020 \u47197  \u44368 \u50977 \u51012  \u48155 \u50500  \u50772 \u45796 . \u44536 \u45716  \u49324 \u46020  \u48148 \u50872 \u44284  \u44057 \u51060  \u51088 \u44592 \u47484  \u44032 \u47532 \u53020  \'93\u50864 \u47532  \u51333 \u44368 \u51032  \u44032 \u51109  \u50628 \u54620  \u54028 \u47484  \u51335 \u50500  \u48148 \u47532 \u49352 \u51064 \u51032  \u49373 \u54876 \u51012  \u54616 \u50688 \u45796 \'94 (\u54665  26:5) \u44256  \u47568 \u54624  \u49688  \u51080 \u45716  \u49324 \u46988 \u51060 \u50632 \u45796 . \u44536 \u45716  \u50676 \u47148 \u54620  \u47196 \u47560 \u44368 \u46020 \u47196 \u49436  \u44368 \u47532 \u47484  \u48152 \u45824 \u54616 \u45716  \u51088 \u45716  \u47784 \u46160  \u47736 \u51208 \u49884 \u53020  \u48260 \u47140 \u50556  \u54620 \u45796 \u45716  \u50676 \u49457 \u51004 \u47196  \u48520 \u53440  \u51080 \u50632 \u45796 . \u44536 \u45716  \u54980 \u45380 \u50640  \u45817 \u49884 \u51032  \u51088 \u44592 \u51032  \u49373 \u50528 \u50640  \u45824 \u54616 \u50668  \'93\u48277 \u50773 \u51012  \u48152 \u45824 \u54616 \u45716  \u47568 \u51012  \u46308 \u51012  \u46412 \u50640  \u45208 \u45716  \u47560 \u52824  \u49324 \u45208 \u50868  \u51060 \u47532 \u52376 \u47100  \u51060 \u47484  \u44040 \u50520 \u45796 \'94 (Wylie, b.13, ch.2) \u44256  \u47568 \u54616 \u50688 \u45796 . \u44536 \u45716  \u46608 \u54620  \u49457 \u46020 \u47484  \u49709 \u48176 \u54616 \u45716  \u51068 \u50640  \u47588 \u50864  \u50676 \u47148 \u54616 \u50688 \u51004 \u48064 \u47196  \u47084 \u54168 \u48652 \u47476 \u50752  \u54632 \u44760  \u54028 \u47532 \u51032  \u50668 \u47084  \u44368 \u54924 \u47484  \u49692 \u54924 \u54616 \u47732 \u49436  \u44033  \u44368 \u54924 \u51032  \u51228 \u45800 \u50640 \u49436  \u50696 \u48176 \u54616 \u44256 , \u50696 \u47932 \u51012  \u46300 \u47140  \u49457 \u45817 \u46308 \u51012  \u51109 \u49885 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u50752  \u44057 \u51008  \u54665 \u50948 \u44032  \u44536 \u51032  \u47560 \u51020 \u50640  \u54868 \u54217 \u51012  \u51460  \u49688  \u50630 \u50632 \u45796 . \u44536 \u50640 \u44172  \u48537 \u50612 \u45796 \u45768 \u45716  \u51396  \u51032 \u49885  (\u24847 \u35672 ) \u51008  \u44536 \u44032  \u49892 \u52380 \u54620  \u44256 \u54665 \u51004 \u47196  \u51228 \u44144 \u54644  \u48260 \u47540  \u49688  \u50630 \u50632 \u45796 . \u44536  \u46412  \u44060 \u54785 \u51088 \u51032  \u45796 \u51020 \u44284  \u44057 \u51008  \u47568 \u46308 \u51008  \u44536 \u50640 \u44172  \u54616 \u45720 \u50640 \u49436  \u50724 \u45716  \u51020 \u49457 \u52376 \u47100  \u46308 \u47160 \u45796 . \'93\u44396 \u50896 \u51008  \u51008 \u54812 \u47196  \u47568 \u48120 \u50516 \u50500  \u50619 \u45716 \u45796 .\'94 \'93\u47924 \u51396 \u54620  \u48516 \u51008  \u51221 \u51396 \u47484  \u48155 \u44256 , \u51396 \u51064 \u51008  \u45459 \u51076 \u51012  \u48155 \u45716 \u45796 .\'94 \'93\u54616 \u45720 \u51032  \u47928 \u51012  \u50676 \u50612  \u51452 \u44256 , \u51020 \u48512 \u51032  \u47928 \u51012  \u45803 \u50500  \u51452 \u45716  \u44163 \u51008  \u50724 \u51649  \u44536 \u47532 \u49828 \u46020 \u51032  \u49901 \u51088 \u44032 \u49104 \u51060 \u45796 \'94 (Wylie, b.13, ch.2).\
\uc0\u54028 \u47120 \u51008  \u44592 \u49244  \u47560 \u51020 \u51004 \u47196  \u51652 \u47532 \u47484  \u48155 \u50500 \u46308 \u50688 \u45796 . \u48148 \u50872 \u51032  \u54924 \u44060 \u52376 \u47100  \u54924 \u44060 \u54632 \u51004 \u47196 , \u44536 \u45716  \u50976 \u51204 \u51032  \u47693 \u50640 \u47484  \u48260 \u47532 \u44256  \u54616 \u45208 \u45784 \u51032  \u50500 \u46308 \u47196 \u49436 \u51032  \u51088 \u50976 \u50640  \u46308 \u50612 \u44052 \u45796 . \u44536 \u45716  \'93\u48277 \u50773 \u50640 \u44172 \u49436  \u50728 \u51204 \u55176  \u47560 \u51020 \u51012  \u46028 \u51060 \u53020 \u49436  \u44536  \u47560 \u51020 \u51012  \u50696 \u49688  \u44536 \u47532 \u49828 \u46020 \u50640 \u44172  \u48148 \u52840 \u51004 \u47196  \u48512 \u47476 \u51670 \u45716  \u51060 \u47532 \u50752  \u44057 \u51060  \u49332 \u44592 \u46321 \u46321 \u54620  \u47560 \u51020 \u51008  \u49324 \u46972 \u51648 \u44256  \u55136  \u50630 \u44256  \u50976 \u49692 \u54620  \u50612 \u47536 \u50577 \u44284  \u44057 \u51060  \u46104 \u50632 \u45796 \'94 (D\'92Aubigne, b.12, ch.3) \u46972 \u44256  \u47568 \u54616 \u50688 \u45796 .\
\uc0\u47084 \u54168 \u48652 \u47476 \u45716  \u44536 \u51032  \u51228 \u51088 \u46308 \u50640 \u44172 \u47564  \u48731 \u51012  \u51204 \u54616 \u50688 \u51648 \u47560 \u45716  \u54028 \u47120 \u51008  \u48277 \u50773 \u51032  \u49324 \u50629 \u50640  \u50676 \u47148 \u54664 \u45912  \u44163 \u44284  \u46609 \u44057 \u51008  \u50676 \u49457 \u51004 \u47196  \u44536 \u47532 \u49828 \u46020 \u51032  \u44144 \u47337 \u54620  \u49324 \u50629 \u50640  \u50676 \u49457 \u51012  \u45796 \u54616 \u50688 \u44256 , \u44536 \u45716  \u45208 \u50500 \u44032  \u51652 \u47532 \u47484  \u44277 \u51473 \u50640 \u44172  \u51204 \u54028 \u54616 \u50688 \u45796 . \u50620 \u47560  \u54980 \u50640  \u44368 \u54924 \u51032  \u54620  \u44256 \u50948  \u49457 \u51649 \u51088 \u51064  \u47784 \u50724  (Meaux) \u51032  \u44048 \u46021 \u51060  \u44536 \u46308 \u44284  \u50672 \u54633 \u54616 \u50688 \u45796 . \u51116 \u44036 \u44284  \u54617 \u49885 \u51004 \u47196  \u45458 \u51076 \u51012  \u48155 \u44256  \u51080 \u45716  \u44368 \u49688 \u46308 \u46020  \u48373 \u51020 \u51012  \u51204 \u54616 \u45716  \u44536  \u51068 \u50640  \u54633 \u49464 \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u50948 \u47196 \u45716  \u44417 \u51204 \u50640 \u49436 \u48512 \u53552  \u50500 \u47000 \u47196 \u45716  \u45432 \u46041 \u51088 \u50752  \u45453 \u48512 \u51032  \u44032 \u51221 \u50640  \u51060 \u47476 \u44592 \u44620 \u51648  \u44033  \u44228 \u44553 \u51032  \u49324 \u46988 \u46308 \u51060  \u48373 \u51020 \u51032  \u50745 \u54840 \u51088 \u44032  \u46104 \u50632 \u45796 . \u45817 \u49884 \u50640  \u50773 \u51004 \u47196  \u53685 \u52824 \u54616 \u44256  \u51080 \u45912  \u54532 \u46976 \u49884 \u49828  1\u49464 \u51032  \u45572 \u51060 \u44620 \u51648 \u46020  \u44060 \u54785  \u49888 \u50521 \u51012  \u48155 \u50500 \u46308 \u50688 \u45796 . \u46608 \u54620  \u50773  \u51088 \u49888 \u46020  \u47784 \u54980  (\u27597 \u21518 ) \u50752  \u54632 \u44760  \u54620  \u46412 \u45716  \u44144 \u44592 \u50640  \u54840 \u51032 \u47484  \u48372 \u50688 \u51004 \u48064 \u47196  \u44060 \u54785 \u51088 \u46308 \u51008  \u53360  \u55148 \u47581 \u51012  \u44032 \u51648 \u44256  \u54532 \u46993 \u49828 \u44032  \u48373 \u51020 \u54868  (\u31119 \u38899 \u21270 ) \u46112  \u46412 \u47484  \u44592 \u45824 \u54616 \u50688 \u45796 .\
\uc0\u44536 \u47084 \u45208  \u44536 \u46308 \u51032  \u55148 \u47581 \u51008  \u49892 \u54788 \u46104 \u51648  \u50506 \u50520 \u45796 . \u49884 \u47144 \u44284  \u48149 \u54644 \u44032  \u44536 \u47532 \u49828 \u46020 \u51032  \u51228 \u51088 \u46308 \u51012  \u44592 \u45796 \u47532 \u44256  \u51080 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44536 \u44163 \u51008  \u51008 \u54812 \u47213 \u44172 \u46020  \u44536 \u46308 \u51032  \u45576 \u50640  \u49704 \u44592 \u50612 \u51256  \u51080 \u50632 \u45796 . \u54253 \u54413 \u50640  \u45824 \u51025 \u54624  \u47564 \u54620  \u55192 \u51012  \u44536 \u46308 \u50640 \u44172  \u50977 \u49457 \u49884 \u53020  \u51452 \u44592  \u50948 \u54616 \u50668  \u54217 \u54868 \u47196 \u50868  \u54620  \u46412 \u44032  \u54728 \u46973 \u46104 \u50632 \u45912  \u44163 \u51060 \u45796 . \u44536  \u46041 \u50504 \u50640  \u44060 \u54785  \u49324 \u50629 \u51008  \u49888 \u49549 \u55176  \u48156 \u51204 \u54616 \u50688 \u45796 . \u47784 \u50724 \u51032  \u44048 \u46021 \u51008  \u49457 \u51649 \u51088 \u50752  \u48177 \u49457 \u51012  \u44032 \u47476 \u52824 \u44592  \u50948 \u54616 \u50668  \u51088 \u44592 \u51032  \u44368 \u44396  \u50504 \u50640 \u49436  \u50676 \u49900 \u55176  \u54876 \u46041 \u54616 \u50688 \u45796 . \u44536  \u44208 \u44284 \u47196  \u47924 \u51648 \u54616 \u44256  \u48512 \u46020 \u45909 \u54620  \u49849 \u47140 \u46308 \u51008  \u51228 \u44144 \u46104 \u44256 , \u51648 \u49885 \u51060  \u51080 \u44256  \u44221 \u44148 \u54620  \u49324 \u46988 \u46308 \u47196  \u45824 \u52824 \u46104 \u50632 \u45796 . \u44536  \u44048 \u46021 \u51008  \u49324 \u46988 \u46308 \u51060  \u51088 \u51652 \u54616 \u50668  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51012  \u48155 \u50500 \u46308 \u51060 \u44592 \u47484  \u44036 \u51208 \u55176  \u48148 \u46992 \u45716 \u45936 , \u44536  \u51068 \u51060  \u44263  \u49457 \u52712 \u46104 \u50632 \u45796 . \u47084 \u54168 \u48652 \u47476 \u45716  \u49888 \u50557  \u49457 \u44221 \u51032  \u48264 \u50669 \u50640  \u52265 \u49688 \u54616 \u50688 \u45796 . \u44536 \u47088 \u45936  \u47336 \u53552 \u51032  \u46021 \u51068 \u50612  \u49457 \u44221 \u51060  \u48708 \u53584 \u48288 \u47476 \u53356 \u50640 \u49436  \u48156 \u44204 \u46104 \u45912  \u48148 \u47196  \u44536  \u46412 \u50640  \u54532 \u46993 \u49828 \u50612  \u49888 \u50557  \u49457 \u44221 \u46020  \u47784 \u50724 \u50640 \u49436  \u52636 \u54032 \u46104 \u50632 \u45796 . \u44536  \u44048 \u46021 \u51008  \u45432 \u47141 \u44284  \u48708 \u50857 \u51012  \u50500 \u45180 \u51648  \u50506 \u44256  \u51088 \u44592 \u51032  \u44368 \u44396  (\u25934 \u21312 ) \u50504 \u50640  \u44536  \u49457 \u44221 \u51012  \u48372 \u44553 \u49884 \u53040 \u51004 \u48064 \u47196  \u46300 \u46356 \u50612  \u47784 \u50724 \u51032  \u45453 \u48512 \u46308 \u44620 \u51648 \u46020  \u49457 \u44221 \u51012  \u44032 \u51648 \u44172  \u46104 \u50632 \u45796 .\
\uc0\u47560 \u52824  \u44040 \u51613 \u51004 \u47196  \u51453 \u50612  \u44032 \u45716  \u45208 \u44536 \u45348 \u44032  \u49373 \u47749 \u51032  \u49368 \u47932 \u51012  \u44592 \u49256 \u51004 \u47196  \u48155 \u50500 \u46308 \u51060 \u45716  \u44163 \u52376 \u47100  \u50689 \u54844 \u46308 \u51008  \u54616 \u45720 \u51032  \u44592 \u48324 \u51012  \u48155 \u50500 \u46308 \u50688 \u45796 . \u46308 \u50640 \u49436  \u51068 \u51012  \u54616 \u45716  \u49324 \u46988 \u46308 \u44284  \u51089 \u50629 \u51109 \u50640 \u49436  \u45432 \u46041 \u54616 \u45716  \u49324 \u46988 \u46308 \u51008  \u49457 \u44221 \u51032  \u51652 \u47532 \u47484  \u51060 \u50556 \u44592 \u54632 \u51004 \u47196  \u45216 \u47560 \u45796  \u51600 \u44144 \u51060  \u51068 \u51012  \u54624  \u49688  \u51080 \u50632 \u45796 . \u44536 \u46308 \u51008  \u48164 \u51060 \u47732  \u49696 \u51665 \u50640  \u44032 \u45716  \u45824 \u49888 \u50640  \u51060 \u50883 \u45180 \u47532  \u54620  \u51665 \u50640  \u47784 \u50668 \u49436  \u49457 \u44221 \u51012  \u51069 \u44256  \u54632 \u44760  \u44592 \u46020 \u54616 \u44256  \u52268 \u48120 \u47484  \u48520 \u47104 \u45796 . \u44263  \u44536 \u46308 \u51032  \u51648 \u50669  \u49324 \u54924 \u50640  \u54616 \u45208 \u51032  \u53360  \u48320 \u54868 \u44032  \u51068 \u50612 \u45228 \u45796 . \u48708 \u47197  \u48708 \u52380 \u54620  \u44228 \u44553 \u50640  \u49549 \u54616 \u45716  \u47924 \u49885 \u54616 \u44256  \u44256 \u46108  \u45432 \u46041 \u50640  \u49884 \u45804 \u47532 \u45716  \u45453 \u48512 \u46308 \u51060 \u50632 \u51648 \u47564  \u44536 \u46308 \u51032  \u49373 \u54876 \u50640 \u45716  \u44060 \u54785 \u44284  \u54693 \u49345 \u51004 \u47196  \u51064 \u46020 \u54616 \u45716  \u44144 \u47337 \u54620  \u45733 \u47141 \u51060  \u45208 \u53440 \u45228 \u45796 . \u44536 \u46308 \u51008  \u44216 \u49552 , \u49457 \u44208 , \u49324 \u46993 \u51032  \u51613 \u44144 \u51088 \u47196 \u49436  \u48373 \u51020 \u51012  \u52649 \u49900 \u51004 \u47196  \u48155 \u50500 \u46308 \u51068  \u46412 \u50640  \u44536 \u44163 \u51060  \u50612 \u46496 \u54620  \u51068 \u51012  \u51060 \u47336 \u50612  \u51452 \u45716 \u51648 \u47484  \u51077 \u51613 \u54644  \u51452 \u50632 \u45796 .\
\uc0\u47784 \u50724 \u50640 \u49436  \u48157 \u54784 \u51652  \u48731 \u51008  \u47680 \u47532 \u44620 \u51648  \u48708 \u52824 \u50632 \u45796 . \u54924 \u44060 \u54616 \u45716  \u49324 \u46988 \u51032  \u49688 \u45716  \u47588 \u51068  \u51613 \u44032 \u46104 \u50612  \u44052 \u45796 . \u49849 \u47140 \u46308 \u51032  \u50756 \u44256 \u54620  \u44256 \u51665 \u51012  \u49899 \u50612 \u54620  \u50773  \u46412 \u47928 \u50640  \u49457 \u51649 \u51088 \u45800 \u51032  \u48516 \u45432  (\u24575 \u24594 ) \u45716  \u54620  \u46412  \u44204 \u51228 \u46104 \u50632 \u45796 . \u44536 \u47084 \u45208  \u47560 \u52840 \u45236  \u48277 \u50773 \u52769 \u51032  \u51648 \u46020 \u51088 \u46308 \u51060  \u49464 \u47141 \u51012  \u50619 \u50632 \u45796 . \u51060 \u51228  \u54868 \u54805 \u51452 \u44032  \u49464 \u50892 \u51276 \u45796 . \u47784 \u50724 \u51032  \u44048 \u46021 \u51008  \u54868 \u54805 \u51012  \u48155 \u46304 \u51648  \u49888 \u50521 \u51012  \u52712 \u49548 \u54616 \u46304 \u51648  \u46168  \u51473  \u54616 \u45208 \u47484  \u53469 \u54616 \u46972 \u45716  \u44053 \u50836 \u47484  \u48155 \u44172  \u46104 \u50632 \u45796 . \u44536 \u45716  \u48372 \u45796  \u50504 \u46973 \u54620  \u44600 \u51012  \u53469 \u54616 \u50688 \u45796 . \u51060 \u50752  \u44057 \u51060  \u51648 \u46020 \u51088 \u44032  \u45336 \u50612 \u51276 \u51020 \u50640 \u46020  \u48520 \u44396 \u54616 \u44256  \u49888 \u51088 \u46308 \u51008  \u54869 \u44256 \u54616 \u44172  \u45224 \u50500  \u51080 \u50632 \u45796 . \u47566 \u51008  \u49324 \u46988 \u51060  \u54868 \u54805 \u51452 \u51032  \u48520 \u44867  \u44032 \u50868 \u45936 \u49436  \u51652 \u47532 \u47484  \u51613 \u44144 \u54616 \u50688 \u45796 . \u51060 \u47084 \u54620  \u44216 \u49552 \u54620  \u44536 \u47532 \u49828 \u46020 \u51064 \u46308 \u51008  \u54868 \u54805 \u51452 \u50640 \u49436 \u44620 \u51648  \u52649 \u49457 \u44284  \u50857 \u44592 \u47484  \u51075 \u51648  \u50506 \u51004 \u48064 \u47196  \u54217 \u50504 \u54624  \u46412 \u50640  \u44536 \u46308 \u51032  \u51613 \u44144 \u47484  \u44208 \u53076  \u46308 \u50612 \u48372 \u51648  \u47803 \u54664 \u45912  \u47924 \u49688 \u54620  \u49324 \u46988 \u46308 \u50640 \u44172  \u48373 \u51020 \u51012  \u51204 \u54616 \u50688 \u45796 .\
