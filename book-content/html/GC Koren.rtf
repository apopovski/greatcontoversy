\uc0\u52488 \u52285 \u44592 \u51032  \u47700 \u49548 \u46356 \u49828 \u53944  \u44368 \u51064 \u46308 \u51008  \u51204 \u46020 \u51088 \u46308 \u44284  \u51068 \u48152  \u49888 \u46020 \u46308 \u51012  \u47561 \u47200 \u54616 \u44256  \u44397 \u44368 \u51064 \u46308 \u44284  \u54841 \u51008  \u44397 \u44368 \u51064 \u46308 \u51032  \u47924 \u44256 \u47196  \u47568 \u48120 \u50516 \u50500  \u44201 \u48516 \u54620  \u48520 \u49888 \u51088 \u46308 \u47196 \u48512 \u53552  \u51312 \u47217 \u44284  \u48149 \u54644 \u47484  \u48155 \u44256  \u44536 \u44163 \u51012  \u44204 \u46356 \u50632 \u45796 . \u44536 \u46308 \u51008  \u48277 \u51221 \u50640 \u46020  \u51060 \u45132 \u47140  \u45208 \u44052 \u45716 \u45936 , \u45817 \u49884 \u51032  \u48277 \u51221 \u51008  \u50976 \u47749 \u47924 \u49892 \u54616 \u50668  \u51221 \u45817 \u54620  \u51116 \u54032 \u51060  \u50630 \u50632 \u45796 . \u44536 \u47084 \u48064 \u47196  \u44536 \u46308 \u51008  \u48149 \u54644 \u51088 \u46308 \u51032  \u54253 \u54665 \u51004 \u47196  \u51088 \u51452  \u44256 \u53685 \u51012  \u45817 \u54616 \u50688 \u45796 . \u54253 \u46020 \u46308 \u51008  \u51665 \u51665 \u47560 \u45796  \u52286 \u50500 \u45796 \u45768 \u47732 \u49436  \u44592 \u44396 \u50752  \u47932 \u54408 \u46308 \u51012  \u54028 \u44340 \u54616 \u44256  \u44536 \u46308 \u51060  \u51339 \u50500 \u54616 \u45716  \u44163 \u46308 \u51012  \u50557 \u53448 \u54616 \u50688 \u44256 , \u45224 \u45376 \u46308 \u44284  \u50612 \u47536 \u51060 \u46308 \u51012  \u51092 \u51064 \u54616 \u44172  \u52712 \u44553 \u54616 \u50688 \u45796 . \u50612 \u46500  \u44221 \u50864 \u50640 \u45716  \u47700 \u49548 \u46356 \u49828 \u53944 \u46308 \u51032  \u51665 \u51012  \u54028 \u44340 \u54616 \u44256  \u50557 \u53448 \u54616 \u47140 \u45716  \u51088 \u45716  \u50612 \u45712  \u46412  \u50612 \u45712  \u44275 \u51004 \u47196  \u47784 \u51060 \u46972 \u45716  \u44305 \u44256 \u47484  \u44277 \u44277 \u50672 \u54616 \u44172  \u50024  \u48537 \u51060 \u44592 \u46020  \u54616 \u50688 \u45796 . \u51060 \u52376 \u47100  \u44277 \u44277 \u50672 \u54616 \u44172  \u44397 \u44032 \u51032  \u48277 \u47456 \u44284  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51012  \u50948 \u48152 \u54616 \u50668 \u46020  \u50500 \u47924 \u47088  \u51228 \u51116 \u47484  \u48155 \u51648  \u50500 \u45768 \u54616 \u50688 \u45796 . \u47700 \u49548 \u46356 \u49828 \u53944 \u46308 \u51008  \u51396 \u51064 \u46308 \u51012  \u47736 \u47581 \u51032  \u44600 \u50640 \u49436  \u49457 \u44208 \u51032  \u44600 \u47196  \u46028 \u51060 \u53412 \u44256 \u51088  \u55192 \u51012  \u50044 \u44592  \u46412 \u47928 \u50640  \u51060 \u52376 \u47100  \u52384 \u51200 \u54620  \u48149 \u54644 \u47484  \u48155 \u50520 \u45796 .\
\uc0\u51316  \u50920 \u49836 \u47532 \u45716  \u51088 \u44592 \u50752  \u51088 \u44592 \u51032  \u46041 \u47308 \u46308 \u51012  \u48708 \u45212 \u54616 \u45716  \u45936  \u45824 \u54616 \u50668  \u47568 \u54616 \u50688 \u45796 . \'93\u50612 \u46500  \u49324 \u46988 \u46308 \u51008  \u51060  \u49324 \u46988 \u46308 \u51060  \u44032 \u47476 \u52824 \u45716  \u44368 \u47532 \u44032  \u54728 \u50948 \u50836 , \u50724 \u47448 \u50836 , \u44305 \u49888 \u51060 \u46972 \u44256  \u51452 \u51109 \u54620 \u45796 . \u44536 \u46308 \u51008  \u44536 \u44163 \u46308 \u51060  \u51648 \u44552 \u44620 \u51648  \u46308 \u50612  \u48372 \u51648  \u47803 \u54620  \u49352 \u47196 \u50868  \u44368 \u47532 \u51060 \u47728 , \u53272 \u51060 \u52964 \u51452 \u51032 \u50836  \u44305 \u49888 \u51060 \u47728  \u48277 \u50773 \u44368 \u46972 \u44256  \u54620 \u45796 . \u44536  \u47784 \u46304  \u44396 \u49892 \u46308 \u51008  \u51060 \u48120  \u44536  \u49100 \u47532 \u44620 \u51648  \u47784 \u46160  \u48977 \u55180  \u44163 \u51060 \u45796 . \u51060  \u44368 \u47532 \u51032  \u47784 \u46304  \u48512 \u48516 \u51008  \u50864 \u47532  \u51088 \u49888 \u46308 \u51032  \u44368 \u54924 \u44032  \u54644 \u49437 \u54616 \u45716  \u49457 \u44221 \u51032  \u48516 \u47749 \u54620  \u44368 \u47532 \u51060 \u45796 . \u44536 \u47084 \u48064 \u47196  \u47564 \u51068  \u49457 \u44221 \u51060  \u52280 \u46108  \u44163 \u51060 \u46972 \u47732  \u44536  \u44368 \u47532 \u44032  \u54728 \u50948 \u45208  \u50724 \u47448 \u51068  \u49688 \u45716  \u50630 \u45796 . \u46608  \u45796 \u47480  \u51060 \u46308 \u51008  \'91\u44536 \u46308 \u51032  \u44368 \u47532 \u44032  \u45320 \u47924  \u50628 \u44201 \u54616 \u50668  \u54616 \u45720 \u47196  \u44032 \u45716  \u44600 \u51012  \u51648 \u45208 \u52824 \u44172  \u51329 \u44172  \u47564 \u46304 \u45796 \'92\u44256  \u51452 \u51109 \u54620 \u45796 . \u51060 \u44163 \u51008  \u44540 \u48376 \u51201 \u51064  \u48152 \u45824  \u51060 \u47200 \u51060 \u47728  (\u50724 \u47019 \u46041 \u50504  \u51060  \u47928 \u51228 \u47196  \u44277 \u44201 \u51012  \u48155 \u50500 \u50772 \u44592  \u46412 \u47928 \u51060 \u45796 ), \u51008 \u50672 \u51473 \u50640  \u50668 \u47084  \u44032 \u51648  \u54805 \u53468 \u47196  \u45208 \u53440 \u45212  \u47566 \u51008  \u48152 \u45824  \u51060 \u47200 \u51032  \u44592 \u52488 \u44032  \u46104 \u44256  \u51080 \u45796 . \u44536 \u47084 \u45208  \u44536 \u46308 \u51060  \u50864 \u47532  \u51452 \u45784 \u44284  \u44536 \u48516 \u51032  \u49324 \u46020 \u46308 \u51060  \u47564 \u46304  \u51060 \u49345 \u51004 \u47196  \u54616 \u45720 \u44032 \u45716  \u44600 \u51012  \u51329 \u44172  \u47564 \u46308 \u50632 \u45716 \u44032 ? \u44284 \u50672  \u44536 \u46308 \u51032  \u44368 \u47532 \u44032  \u49457 \u44221 \u51032  \u44032 \u47476 \u52840 \u48372 \u45796 \u46020  \u45908 \u50865  \u50628 \u44201 \u54620 \u44032 ? \u47751  \u44396 \u51208 \u51032  \u47749 \u48177 \u54620  \u49457 \u44221 \u51208 \u46308 \u51012  \u49373 \u44033 \u54644  \u48372 \u51088 . \'91\u45348  \u47560 \u51020 \u51012  \u45796 \u54616 \u47728  \u49457 \u54408 \u51012  \u45796 \u54616 \u47728  \u46907 \u51012  \u45796 \u54616 \u47728  \u55192 \u51012  \u45796 \u54616 \u50668  \u51452  \u45320 \u51032  \u54616 \u45208 \u45784 \u51012  \u49324 \u46993 \u54616 \u46972 \'92 \'91\u49324 \u46988 \u51060  \u47924 \u49832  \u47581 \u47161 \u46108  \u47568 \u51012  \u54616 \u46304 \u51648  \u49900 \u54032  \u45216 \u50640  \u51060 \u47196  \u51064 \u54616 \u50668  \u49900 \u47928 \u51012  \u48155 \u51004 \u47532 \u45768 \'92 \'91\u45320 \u55148 \u44032  \u47673 \u46304 \u51648  \u47560 \u49884 \u46304 \u51648  \u47924 \u50631 \u51012  \u54616 \u46304 \u51648  \u45796  \u54616 \u45208 \u45784 \u51032  \u50689 \u44305 \u51012  \u50948 \u54616 \u50668  \u54616 \u46972 \'92\u44256  \u54616 \u50688 \u45796 .\
\uc0\u47564 \u51068  \u44536 \u46308 \u51032  \u44368 \u47532 \u44032  \u51060 \u48372 \u45796  \u45908 \u50865  \u50628 \u44201 \u54624  \u44163  \u44057 \u51004 \u47732 , \u44536 \u46308 \u51008  \u52293 \u47581 \u51012  \u48155 \u50500 \u50556  \u54620 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45824 \u46308 \u51008  \u44536 \u45824 \u46308 \u51032  \u50577 \u49900 \u50640  \u48708 \u52628 \u50612  \u44536 \u47111 \u51648  \u50506 \u45796 \u45716  \u44163 \u51012  \u50508  \u44163 \u51060 \u45796 . \u46608 \u54620  \u45572 \u44032  \u45733 \u55176  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51012  \u45908 \u47101 \u55176 \u51648  \u50506 \u44256  \u44536  \u50628 \u44201 \u54632 \u51012  \u51312 \u44552 \u51060 \u46972 \u46020  \u45734 \u52628 \u50612  \u45459 \u51012  \u49688  \u51080 \u44192 \u45716 \u44032 ? \u54616 \u45208 \u45784 \u51032  \u50724 \u47896 \u54620  \u51652 \u47532 \u47484  \u47585 \u51008  \u50612 \u46500  \u52397 \u51648 \u44592 \u46972 \u46020  \u44536  \u44144 \u47337 \u54620  \u50948 \u53441 \u47932 \u51032  \u50612 \u46500  \u48512 \u48516 \u51012  \u48320 \u44221 \u54624  \u44163  \u44057 \u51004 \u47732  \u44536 \u47484  \u52649 \u49892 \u54620  \u52397 \u51648 \u44592 \u46972 \u44256  \u54624  \u49688  \u51080 \u44192 \u45716 \u44032 ? \u44208 \u53076  \u44536 \u47092  \u49688  \u50630 \u45796 . \u52397 \u51648 \u44592 \u45716  \u54616 \u45208 \u46020  \u44048 \u54624  \u49688 \u44032  \u50630 \u44256  \u50557 \u54868 \u49884 \u53420  \u49688 \u46020  \u50630 \u45796 . \u44536 \u45716  \u47784 \u46304  \u49324 \u46988 \u50640 \u44172  \'91\u45208 \u45716  \u44536 \u45824 \u46308 \u51032  \u44592 \u54840 \u50640  \u47582 \u46020 \u47197  \u49457 \u44221 \u51032  \u54364 \u51456 \u51012  \u45230 \u52636  \u49688 \u45716  \u50630 \u45796 . \u44536 \u45824 \u46308 \u51008  \u48152 \u46300 \u49884  \u44536  \u54364 \u51456 \u50640 \u44620 \u51648  \u50732 \u46972 \u44032 \u50556  \u54624  \u44163 \u51060 \u45768  \u44536 \u47111 \u51648  \u50506 \u51004 \u47732  \u50689 \u50896 \u55176  \u47736 \u47581 \u54624  \u44163 \u49104 \u51060 \u45796 \'92\u46972 \u44256  \u49440 \u54252 \u54624  \u49688 \u48150 \u50640  \u50630 \u45796 . \u51060 \u44163 \u51060  \u48148 \u47196  \u51068 \u48152 \u51201 \u51004 \u47196  \'91\u51060  \u49324 \u46988 \u46308 \u51008  \u49324 \u46993 \u51060  \u50630 \u45796 \'92\u44256  \u54217 \u44032 \u54616 \u45716  \u52280 \u46108  \u51060 \u50976 \u51060 \u45796 . \u44284 \u50672  \u44536 \u46308 \u51008  \u49324 \u46993 \u51060  \u50630 \u45716 \u44032 ? \u44536 \u47111 \u45796 \u47732  \u50612 \u46500  \u51216 \u50640  \u51080 \u50612 \u49436  \u44536 \u47084 \u54620 \u44032 ? \u44536 \u46308 \u51060  \u51452 \u47536  \u49324 \u46988 \u46308 \u51012  \u47673 \u51060 \u51648  \u50506 \u44256  \u54736 \u48279 \u51008  \u49324 \u46988 \u46308 \u51012  \u51077 \u55176 \u51648  \u50506 \u45716 \u44032 ? \'91\u44536 \u44163 \u51008  \u51204 \u54784  \u47928 \u51228 \u47196  \u49340 \u51012  \u44163 \u51060  \u50630 \u45796 . \u51060  \u51216 \u50640  \u51080 \u50612 \u49436  \u44536 \u46308 \u51008  \u50500 \u47924 \u47088  \u48512 \u51313 \u51060  \u50630 \u45796 . \u44536 \u47084 \u45208  \u44536 \u46308 \u51008  \u54032 \u45800 \u47141 \u50640  \u51080 \u50612 \u49436  \u45320 \u47924 \u45208  \u45257 \u51221 \u54616 \u45796 . \u44536 \u46308 \u51008  \u44536 \u46308 \u51032  \u48169 \u48277 \u45824 \u47196  \u54616 \u51648  \u50500 \u45768 \u54616 \u47732  \u50500 \u47924 \u46020  \u44396 \u50896 \u51012  \u50619 \u51012  \u49688  \u50630 \u45796 \u44256  \u49373 \u44033 \u54620 \u45796 .\'92\'94 (John Wesley, Works, Vol.3, pp.152, 153).\
\uc0\u50920 \u49836 \u47532  \u49884 \u45824  \u51649 \u51204 \u50640  \u50689 \u44397 \u50640  \u45208 \u53440 \u45212  \u50689 \u51201  \u49632 \u53748 \u45716  \u45824 \u52404 \u47196  \u50984 \u48277  \u47924 \u50857 \u47200 \u51032  \u44368 \u47532 \u44032  \u48730 \u50612  \u45240  \u44208 \u44284 \u50688 \u45796 . \u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u46020 \u45909 \u47456 \u51012  \u54224 \u51648 \u54616 \u49512 \u51004 \u48064 \u47196  \u44536 \u47532 \u49828 \u46020 \u51064 \u46308 \u51060  \u50984 \u48277 \u51012  \u51648 \u53420  \u51032 \u47924 \u50640 \u49436  \u48279 \u50612 \u45228 \u44256 , \'93\u49440 \u51012  \u54665 \u54644 \u50556  \u54624  \u52293 \u51076 \u44048 \'94\u50640 \u49436 \u46020  \u54644 \u48169 \u46104 \u50632 \u45796 \u44256  \u51452 \u51109 \u54616 \u50688 \u45796 . \u44536 \u47532 \u44256  \u45796 \u47480  \u49324 \u46988 \u46308 \u51008  \u50984 \u48277 \u51032  \u50689 \u50896 \u49457 \u51012  \u51064 \u51221 \u54616 \u47732 \u49436 \u46020  \u47785 \u49324 \u46308 \u51060  \u49324 \u46988 \u46308 \u50640 \u44172  \u50984 \u48277 \u51012  \u49692 \u51333 \u54616 \u46972 \u44256  \u44428 \u47732 \u54616 \u45716  \u44163 \u51060  \u47924 \u50857 \u54620  \u51068 \u51060 \u46972 \u44256  \u51452 \u51109 \u54616 \u50688 \u45796 . \u50780 \u45264 \u54616 \u47732  \u54616 \u45208 \u45784 \u44760 \u49436  \u44396 \u50896 \u54616 \u49884 \u44256 \u51088  \u53469 \u54620  \u49324 \u46988 \u46308 \u51008  \u51200 \u54637 \u54624  \u49688  \u50630 \u45716  \u54616 \u45208 \u45784 \u51032  \u51008 \u54812 \u47196  \u44221 \u44148 \u44284  \u45909 \u49457 \u51012  \u49892 \u52380 \u54616 \u44172  \u46104 \u44256 , \u51060 \u50752  \u48152 \u45824 \u47196  \u50689 \u50896 \u55176  \u48260 \u47548 \u51012  \u48155 \u51008  \u51088 \u46308 \u51008  \'93\u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51012  \u49692 \u51333 \u54624  \u45733 \u47141 \u51012  \u44032 \u51648 \u51648  \u47803 \u54616 \u45716  \u44163 \u51060 \u45796 \'94\u46972 \u44256  \u51452 \u51109 \u54616 \u50688 \u44592  \u46412 \u47928 \u51060 \u45796 .\
\uc0\u46608 \u54620  \u45796 \u47480  \u49324 \u46988 \u46308 \u51008  \'93\u53469 \u54632 \u51012  \u48155 \u51008  \u51088 \u46308 \u51008  \u51008 \u54812 \u47484  \u48155 \u51648  \u47803 \u54616 \u44144 \u45208  \u54616 \u45208 \u45784 \u51032  \u51008 \u52509 \u51012  \u48149 \u53448 \u45817 \u54624  \u49688  \u50630 \u45796 \'94\u44256  \u51452 \u51109 \u54616 \u50688 \u45796 . \'93\u44536 \u47532 \u54616 \u50668  \u53469 \u54632 \u51012  \u48155 \u51008  \u51088 \u46308 \u51060  \u48276 \u54616 \u45716  \u50501 \u54665 \u51008  \u52280 \u46108  \u48276 \u51396 \u44032  \u50500 \u45768 \u47728  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51012  \u48276 \u54616 \u45716  \u44163 \u51004 \u47196  \u50668 \u44600  \u44163 \u46020  \u50500 \u45768 \u48064 \u47196  \u44536 \u47088  \u49324 \u46988 \u46308 \u51008  \u44536 \u46308 \u51032  \u51396 \u47484  \u44256 \u48177 \u54616 \u44144 \u45208  \u54924 \u44060 \u47196 \u50024  \u44536 \u47088  \u51396 \u47484  \u45130 \u50612 \u48260 \u47540  \u54596 \u50836 \u46020  \u50630 \u45796 \'94 (Mclintock and Strong, Encyclopedia, art. \'93Antinomians\'94) \u44256  \u54616 \u45716  \u47588 \u50864  \u46160 \u47140 \u50868  \u44208 \u47200 \u51012  \u45236 \u47160 \u45796 . \u44536 \u47084 \u48064 \u47196  \u44536 \u46308 \u51008  \u51068 \u51333 \u51032  \u44032 \u51109  \u48708 \u50676 \u54620  \u51396 , \u44263  \'93\u51068 \u48152 \u51201 \u51004 \u47196  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u50640  \u45824 \u54620  \u53360  \u50948 \u48152 \u51060 \u46972 \u44256  \u49373 \u44033 \u46104 \u45716  \u44163 \u51060 \u46972 \u46020 \'94 \u47564 \u51068  \u53469 \u54632 \u51012  \u51077 \u51008  \u51088 \u44032  \u48276 \u54620  \u44163 \u51068  \u46412 \u50640 \u45716  \'93\u54616 \u45208 \u45784 \u44760 \u49436  \u51396 \u47196  \u44036 \u51452 \u54616 \u51648  \u50500 \u45768 \u54616 \u49888 \u45796 \'94\u44256  \u50669 \u49444 \u54616 \u50688 \u45796 . \u50780 \u45264 \u54616 \u47732  \'93\u53469 \u54632 \u51012  \u51077 \u51008  \u51088 \u45716  \u54616 \u45208 \u45784 \u51012  \u45432 \u50685 \u44172  \u54616 \u44144 \u45208  \u50984 \u48277 \u50640  \u44552 \u51648 \u46108  \u44163 \u51008  \u50612 \u46500  \u44163 \u51060 \u45208  \u54665 \u54624  \u49688  \u50630 \u45716  \u44163 \u51060  \u44536 \u46308 \u51032  \u48376 \u51656 \u51201 \u51060 \u50836  \u46748 \u47159 \u54620  \u53945 \u51669 \u51060  \u46104 \u44592  \u46412 \u47928 \u51060 \u45796 \'94\u46972 \u44256  \u51452 \u51109 \u54616 \u50688 \u45796 .\
\uc0\u51060  \u44340 \u49345 \u54620  \u44368 \u47532 \u45716  \u48376 \u51656 \u51201 \u51004 \u47196  \u54980 \u49464 \u51032  \u51068 \u48152  \u44368 \u50977 \u51088 \u50752  \u49888 \u54617 \u51088 \u51032  \u44032 \u47476 \u52840 \u44284  \u46609 \u44057 \u51008  \u44163 \u51060 \u50632 \u45796 . \u44536 \u46308 \u51008  \u51032 \u51032  \u54364 \u51456 \u51064  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51060  \u44208 \u53076  \u48520 \u48320  (\u63847 \u35722 ) \u51032  \u44163 \u51060  \u50500 \u45768 \u46972  \u46020 \u45909 \u51032  \u54364 \u51456 \u51060  \u49324 \u54924  \u51088 \u52404 \u51032  \u54788 \u49892 \u50640  \u51032 \u54616 \u50668  \u51060 \u47336 \u50612 \u51648 \u45716  \u44163 \u51060 \u48064 \u47196  \u54637 \u49345  \u48320 \u54616 \u45716  \u44163 \u51060 \u46972 \u44256  \u54616 \u50688 \u45796 . \u51060  \u47784 \u46304  \u49324 \u49345 \u51008  \u45796  \u49324 \u45800 \u51032  \u51221 \u49888 \u50640 \u49436  \u50728  \u44163 \u51060 \u47728 , \u44536 \u45716  \u51396  \u50630 \u45716  \u54616 \u45720 \u51032  \u44144 \u48124 \u46308  \u44032 \u50868 \u45936 \u49436 \u46020  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51032  \u51221 \u45817 \u54620  \u51228 \u51116 \u47484  \u50630 \u50528  \u48260 \u47532 \u44592  \u50948 \u54620  \u44536 \u51032  \u49324 \u50629 \u51012  \u52265 \u49688 \u54616 \u50688 \u45912  \u44163 \u51060 \u45796 .\
\uc0\u49324 \u46988 \u51032  \u49457 \u44201 \u51012  \u48320 \u44221 \u54624  \u49688  \u50630 \u46020 \u47197  \u44256 \u51221 \u49884 \u53040 \u45796 \u45716  \u54616 \u45208 \u45784 \u51032  \u49440 \u44256 \u50640  \u45824 \u54620  \u44368 \u47532 \u45716  \u47566 \u51008  \u49324 \u46988 \u46308 \u47196  \u54616 \u50668 \u44552  \u49324 \u49892 \u49345  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51012  \u44144 \u48512 \u54616 \u44172  \u47564 \u46308 \u50632 \u45796 . \u50920 \u49836 \u47532 \u45716  \u44536 \u50752  \u44057 \u51008  \u50984 \u48277  \u47924 \u50857 \u47200 \u51088 \u46308 \u51032  \u44536 \u47495 \u46108  \u51032 \u44204 \u51012  \u45800 \u54840 \u54616 \u44172  \u48152 \u45824 \u54616 \u44256 , \u50984 \u48277  \u47924 \u50857 \u47200 \u51004 \u47196  \u51060 \u45132 \u50612 \u44032 \u45716  \u44368 \u47532 \u45716  \u49457 \u44221 \u44284  \u48176 \u52824 \u46108  \u44163 \u51076 \u51012  \u51613 \u47749 \u54616 \u50688 \u45796 . \'93\u47784 \u46304  \u49324 \u46988 \u50640 \u44172  \u44396 \u50896 \u51012  \u51452 \u49884 \u45716  \u54616 \u45208 \u45784 \u51032  \u51008 \u54812 \u44032  \u45208 \u53440 \u45208 \'94, \'93\u51060 \u44163 \u51060  \u50864 \u47532  \u44396 \u51452  \u54616 \u45208 \u45784  \u50526 \u50640  \u49440 \u54616 \u44256  \u48155 \u51004 \u49892  \u47564 \u54620  \u44163 \u51060 \u45768  \u54616 \u45208 \u45784 \u51008  \u47784 \u46304  \u49324 \u46988 \u51060  \u44396 \u50896 \u51012  \u48155 \u51004 \u47728  \u51652 \u47532 \u47484  \u50500 \u45716  \u45936  \u51060 \u47476 \u44592 \u47484  \u50896 \u54616 \u49884 \u45712 \u45768 \u46972  \u54616 \u45208 \u45784 \u51008  \u54620  \u48516 \u51060 \u49884 \u50836  \u46608  \u54616 \u45208 \u45784 \u44284  \u49324 \u46988  \u49324 \u51060 \u50640  \u51473 \u48372 \u46020  \u54620  \u48516 \u51060 \u49884 \u45768  \u44263  \u49324 \u46988 \u51060 \u49888  \u44536 \u47532 \u49828 \u46020  \u50696 \u49688 \u46972  \u44536 \u44032  \u47784 \u46304  \u49324 \u46988 \u51012  \u50948 \u54616 \u50668  \u51088 \u44592 \u47484  \u49549 \u51204 \u51004 \u47196  \u51452 \u49512 \u51004 \u45768  \'85\'94 (\u46363  2:11; \u46372 \u51204  2:3~6). \u47784 \u46304  \u49324 \u46988 \u51060  \u44396 \u50896 \u51012  \u50619 \u51012  \u49688  \u51080 \u46020 \u47197  \u54616 \u45208 \u45784 \u51032  \u49457 \u47161 \u51008  \u44050 \u50630 \u51060  \u51452 \u50612 \u51276 \u45796 . \'93\u52280  \u48731 \'94, \u44263  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \'93\u49464 \u49345 \u50640  \u50752 \u49436  \u44033  \u49324 \u46988 \u50640 \u44172  \u48708 \u52712 \'94 (\u50836  1:9) \u49888 \u45796 . \u44536 \u47084 \u48064 \u47196  \u49324 \u46988 \u51060  \u44396 \u50896 \u51012  \u50619 \u51648  \u47803 \u54616 \u45716  \u44163 \u51008  \u49373 \u47749 \u51032  \u49440 \u47932 \u51012  \u49828 \u49828 \u47196  \u44144 \u48512 \u54616 \u44592  \u46412 \u47928 \u51060 \u45796 .\
