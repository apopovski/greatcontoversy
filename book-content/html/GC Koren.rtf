\f1\b0 \cf0 \
\uc0\u52380 \u49324 \u46308 \u51008  \u54616 \u45208 \u45784 \u51032  \u51088 \u45376 \u46308 \u50640 \u44172  \u51088 \u48708 \u51032  \u49324 \u47749 \u51012  \u45796 \u54616 \u44592  \u50948 \u54616 \u50668  \u48372 \u45252 \u51012  \u48155 \u45716 \u45796 . \u52380 \u49324 \u45716  \u52629 \u48373 \u51032  \u50557 \u49549 \u51012  \u44032 \u51648 \u44256  \u50500 \u48652 \u46972 \u54632 \u50640 \u44172 , \u51032 \u51064  \u47215 \u51012  \u47609 \u47148 \u54620  \u48520 \u47196  \u51064 \u54620  \u47736 \u47581 \u50640 \u49436  \u44396 \u50896 \u54644 \u45236 \u44592  \u50948 \u54616 \u50668  \u48372 \u45252 \u51012  \u48155 \u50520 \u45796 . \u46608 \u54620  \u51452 \u47548 \u44284  \u54588 \u44260 \u51004 \u47196  \u44305 \u50556 \u50640 \u49436  \u51453 \u44172  \u46108  \u50648 \u47532 \u50556 \u50640 \u44172 , \u51201 \u44400 \u50640 \u44172  \u54252 \u50948 \u46104 \u50612  \u51080 \u45716  \u51089 \u51008  \u46020 \u49457 \u50640  \u48520 \u47568 \u44284  \u48520 \u48337 \u44144 \u50752  \u54632 \u44760  \u50648 \u47532 \u49324 \u50640 \u44172  \u52380 \u49324 \u44032  \u50772 \u45796 . \u51060 \u48169  \u44417 \u51221 \u50640 \u49436  \u54616 \u45208 \u45784 \u51032  \u51648 \u54812 \u47484  \u44396 \u54624  \u46412 \u50752  \u49324 \u51088 \u44404 \u50640  \u45912 \u51664 \u51012  \u48155 \u50520 \u51012  \u46412 \u51032  \u45796 \u45768 \u50648 \u50640 \u44172 , \u54756 \u47215 \u51032  \u50725 \u50640  \u44039 \u55180  \u48288 \u46300 \u47196 \u50640 \u44172 , \u48716 \u47549 \u48372 \u51032  \u50725 \u50640  \u44039 \u55180  \u51396 \u49688 \u46308 \u50640 \u44172 , \u48164 \u51473 \u50640  \u54644 \u49345 \u50640 \u49436  \u54253 \u54413 \u51012  \u47564 \u45212  \u48148 \u50872 \u44284  \u44536  \u46041 \u54665 \u51088 \u46308 \u50640 \u44172 , \u47560 \u51020 \u51012  \u50676 \u50612  \u48373 \u51020 \u51012  \u48155 \u50500 \u46308 \u51060 \u44172  \u54616 \u44256 \u51088  \u44256 \u45356 \u47308 \u50640 \u44172 , \u51060 \u48169 \u51064  \u49324 \u51088 \u50640 \u44172  \u44396 \u50896 \u51032  \u49548 \u49885 \u51012  \u51204 \u54616 \u44172  \u54616 \u44256 \u51088  \u48288 \u46300 \u47196 \u50640 \u44172  \u52380 \u49324 \u44032  \u48372 \u45236 \u49900 \u51012  \u48155 \u50520 \u45796 . \u51060 \u50752  \u44057 \u51060  \u52380 \u49324 \u46308 \u51008  \u44033  \u49884 \u45824 \u47484  \u47561 \u47200 \u54616 \u44256  \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u46308 \u50640 \u44172  \u48393 \u49324 \u54644  \u50772 \u45796 .\
\uc0\u48372 \u54840 \u54616 \u45716  \u54620  \u52380 \u49324 \u44032  \u44536 \u47532 \u49828 \u46020 \u47484  \u46384 \u47476 \u45716  \u44033  \u49324 \u46988 \u50640 \u44172  \u51648 \u51221 \u46104 \u50612  \u51080 \u45796 . \u44536  \u54616 \u45720 \u51032  \u48372 \u54840 \u51088 \u46308 \u51008  \u51032 \u51064 \u51012  \u50501 \u54620  \u51088 \u51032  \u49464 \u47141 \u50640 \u49436  \u51648 \u53020  \u51456 \u45796 . \u51060  \u49324 \u49892 \u51008  \u49324 \u45800  \u51088 \u49888 \u46020  \u49884 \u51064 \u54664 \u45796 . \u44536 \u45716  \'93\u50853 \u51060  \u50612 \u52236  \u44620 \u45805  \u50630 \u51060  \u54616 \u45208 \u45784 \u51012  \u44221 \u50808 \u54616 \u47532 \u51060 \u44620  \u51452 \u44760 \u49436  \u44536 \u50752  \u44536  \u51665 \u44284  \u44536  \u47784 \u46304  \u49548 \u50976 \u47932 \u51012  \u49328 \u50872 \u47196  \u46160 \u47476 \u49900 \u51060  \u50500 \u45768 \u45768 \u51060 \u44620 \'94 (\u50853  1:9, 10) \u46972 \u44256  \u54620  \u47568 \u51008  \u44536  \u49324 \u49892 \u51012  \u47568 \u54644 \u51456 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436  \u45817 \u49888 \u51032  \u48177 \u49457 \u51012  \u48372 \u54840 \u54644  \u51452 \u49884 \u45716  \u45936  \u49324 \u50857 \u54616 \u49884 \u45716  \u51316 \u51116 \u44032  \u49884 \u54200  \u44592 \u51088 \u51032  \u47568 \u50640  \u45208 \u53440 \u45208  \u51080 \u45796 . \'93\u50668 \u54840 \u50752 \u51032  \u49324 \u51088 \u44032  \u51452 \u47484  \u44221 \u50808 \u54616 \u45716  \u51088 \u47484  \u46168 \u47084  \u51652 \u52824 \u44256  \u51200 \u55148 \u47484  \u44148 \u51648 \u49884 \u45716 \u46020 \u45796 \'94 (\u49884  34:7). \u44396 \u51452 \u44760 \u49436 \u45716  \u45817 \u49888 \u51012  \u48127 \u45716  \u51088 \u46308 \u50640  \u44288 \u54616 \u50668  \'93\u49340 \u44032  \u51060  \u49548 \u51088  \u51473 \u50640  \u54616 \u45208 \u46020  \u50629 \u49888 \u50668 \u44592 \u51648  \u47568 \u46972  \u45320 \u55148 \u50640 \u44172  \u47568 \u54616 \u45432 \u45768  \u51200 \u55148  \u52380 \u49324 \u46308 \u51060  \u54616 \u45720 \u50640 \u49436  \u54616 \u45720 \u50640  \u44228 \u49888  \u45236  \u50500 \u48260 \u51648 \u51032  \u50620 \u44404 \u51012  \u54637 \u49345  \u48456 \u50741 \u45712 \u45768 \u46972 \'94 (\u47560  18:10) \u44256  \u47568 \u50432 \u54616 \u49512 \u45796 . \u54616 \u45208 \u45784 \u51032  \u51088 \u45376 \u46308 \u50640 \u44172  \u48393 \u49324 \u54616 \u46020 \u47197  \u51648 \u51221 \u46108  \u52380 \u49324 \u46308 \u51008  \u50616 \u51228 \u46304 \u51648  \u54616 \u45208 \u45784  \u50526 \u50640  \u45208 \u44040  \u49688  \u51080 \u45796 .\
\uc0\u51060 \u50752  \u44057 \u51060  \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u46308 \u51008  \u50516 \u55121 \u51032  \u50773 \u51032  \u48512 \u45800 \u54620  \u50501 \u51032 \u50752  \u44592 \u47564 \u47141 \u51032  \u49845 \u44201 \u51012  \u48155 \u44256  \u50501 \u51032  \u49464 \u47141 \u44284  \u49912 \u50872 \u51648 \u46972 \u46020  \u54616 \u45720 \u51032  \u52380 \u49324 \u46308 \u51032  \u45130 \u51076 \u50630 \u45716  \u48372 \u54840 \u44032  \u48372 \u51613 \u46104 \u50612  \u51080 \u45796 . \u54596 \u50836  \u50630 \u51060  \u44536 \u47088  \u48372 \u51613 \u51060  \u51452 \u50612 \u51656  \u49688  \u50630 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436  \u45817 \u49888 \u51032  \u51088 \u45376 \u46308 \u50640 \u44172  \u51008 \u54812 \u50752  \u48372 \u54840 \u51032  \u50557 \u49549 \u51012  \u54616 \u49888  \u44163 \u51008  \u44536 \u46308 \u51060  \u44053 \u54620  \u50501 \u51032  \u49464 \u47141 \u44284  \u45824 \u44208 \u54624  \u44163 \u51060 \u50632 \u44592  \u46412 \u47928 \u51060 \u45796 . \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u46308  \u50526 \u50640 \u45716  \u47924 \u49688 \u54616 \u44172  \u47566 \u44256 , \u44403 \u49464 \u44256 , \u51648 \u52832  \u51460  \u47784 \u47476 \u45716  \u50501 \u54620  \u49464 \u47141 \u46308 \u51060  \u51080 \u45716 \u45936 , \u44536 \u46308 \u51032  \u50501 \u51032 \u50752  \u49464 \u47141 \u51012  \u44648 \u45803 \u51648  \u47803 \u54616 \u44144 \u45208  \u50976 \u51032 \u54616 \u51648  \u50506 \u51004 \u47732  \u50500 \u47924 \u46020  \u50504 \u51204 \u54644 \u51656  \u49688  \u50630 \u45796 \
