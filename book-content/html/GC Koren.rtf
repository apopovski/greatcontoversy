\uc0\u51060 \u44163 \u51060  \u49324 \u45800 \u51060  \u45804 \u49457 \u54616 \u44256 \u51088  \u54616 \u45716  \u47785 \u51201 \u51060 \u45796 . \u49324 \u46988 \u46308 \u50640 \u44172 \u49436  \u54616 \u45208 \u45784 \u44284  \u44536 \u48516 \u51032  \u47568 \u50432 \u50640  \u45824 \u54620  \u48127 \u51020 \u51012  \u51075 \u50612 \u48260 \u47532 \u44172  \u54616 \u45716  \u44163 \u48372 \u45796  \u49324 \u45800 \u51060  \u45908  \u48148 \u46972 \u45716  \u44163 \u51008  \u50630 \u45796 . \u49324 \u45800 \u51008  \u54924 \u51032 \u51452 \u51032 \u51088 \u46308 \u51032  \u53360  \u44400 \u45824 \u51032  \u49440 \u46160 \u50640  \u49436 \u49436  \u49324 \u46988 \u46308 \u51012  \u49549 \u50668  \u51088 \u44592 \u51032  \u54200 \u50640  \u44032 \u45812 \u49884 \u53412 \u44172  \u54616 \u44256 \u51088  \u51204 \u47141 \u51012  \u45796 \u54616 \u44256  \u51080 \u45796 . \u50724 \u45720 \u45216 \u51008  \u51032 \u49900 \u54616 \u45716  \u51068 \u51060  \u50976 \u54665 \u54616 \u44256  \u51080 \u45796 . \u49457 \u44221 \u51060  \u49324 \u46988 \u46308 \u51032  \u51396 \u47484  \u52293 \u47581 \u54616 \u44256  \u51221 \u51396 \u54616 \u44592  \u46412 \u47928 \u50640  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51012  \u44536  \u51200 \u51088 \u51064  \u54616 \u45208 \u45784 \u44760  \u45824 \u54620  \u44163 \u44284  \u44057 \u51008  \u51060 \u50976 \u47196  \u48520 \u49888 \u54616 \u45716  \u48512 \u47448 \u51032  \u49324 \u46988 \u46308 \u51060  \u47566 \u45796 . \u49457 \u44221 \u51032  \u50836 \u44396 \u50640  \u49692 \u51333 \u54616 \u44592 \u47484  \u51339 \u50500 \u54616 \u51648  \u50506 \u45716  \u51088 \u46308 \u51008  \u49457 \u44221 \u51032  \u44428 \u50948 \u47484  \u51204 \u48373 \u54616 \u44256 \u51088  \u45432 \u47141 \u54620 \u45796 . \u44536 \u46308 \u51008  \u45800 \u49692 \u55176  \u49457 \u44221 \u50640 \u49436 , \u54841 \u51008  \u49444 \u44368 \u50640 \u49436  \u47924 \u49832  \u44208 \u51216 \u51012  \u52286 \u50500 \u45236 \u44592  \u50948 \