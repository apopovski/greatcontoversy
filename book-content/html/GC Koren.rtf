\uc0\u50620 \u47560  \u54980 \u50640  \u54532 \u46972 \u54616 \u51032  \u49548 \u46041 \u51060  \u51652 \u51221 \u46104 \u51088 , \u54980 \u49828 \u45716  \u51088 \u44592 \u44032  \u47585 \u51008  \u48288 \u46308 \u47112 \u54772 \u51032  \u54924 \u45817 \u51004 \u47196  \u46028 \u50500 \u44032 \u49436  \u45908 \u50865  \u53360  \u50676 \u49900 \u44284  \u50857 \u44592 \u47196 \u50024  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51012  \u44228 \u49549 \u54616 \u50668  \u51204 \u54616 \u50688 \u45796 . \u44536 \u51032  \u50896 \u49688 \u46308 \u51008  \u54876 \u48156 \u54616 \u44256  \u44053 \u47141 \u54616 \u50688 \u51648 \u47564 , \u50773 \u54980 \u50752  \u47566 \u51008  \u44480 \u51313 \u46308 \u51060  \u44536 \u51032  \u52828 \u44396 \u44032  \u46104 \u50632 \u44256 , \u47566 \u51008  \u48177 \u49457 \u46308 \u51060  \u44536 \u47484  \u51648 \u51648 \u54616 \u50688 \u45796 . \u44536 \u51032  \u49692 \u44208 \u54616 \u44256  \u44256 \u49345 \u54620  \u44368 \u54984 \u44284  \u44221 \u44148 \u54620  \u49373 \u50528 \u47484  \u47196 \u47560  \u44368 \u46020 \u46308 \u51060  \u51204 \u54616 \u45716  \u53440 \u46973 \u54620  \u44368 \u47532 \u50752  \u44536 \u46308 \u51032  \u53456 \u50837 \u51201 \u51060 \u44256 \u46020  \u48169 \u53461 \u54620  \u54665 \u46041 \u44284  \u48708 \u44368 \u54624  \u46412 \u50640  \u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u54980 \u49828 \u51032  \u54200 \u50640  \u44032 \u45812 \u54616 \u45716  \u44163 \u51012  \u47749 \u50696 \u47196 \u50868  \u51068 \u47196  \u50668 \u44220 \u45796 .\
\uc0\u51648 \u44552 \u44620 \u51648  \u54980 \u49828 \u45716  \u45800 \u46021 \u51004 \u47196  \u54876 \u46041 \u54616 \u50668  \u50772 \u45796 . \u44536 \u47084 \u45208  \u51060 \u51228  \u50689 \u44397 \u50640  \u52404 \u47448 \u54644  \u51080 \u45716  \u46041 \u50504  \u50948 \u53364 \u47532 \u54532 \u51032  \u44032 \u47476 \u52840 \u51012  \u48155 \u50500 \u46308 \u51064  \u51228 \u47212 \u51060  \u44060 \u54785  \u49324 \u50629 \u50640  \u52280 \u44032 \u54616 \u50688 \u45796 . \u44536  \u54980 \u47196 \u48512 \u53552  \u44536  \u46160  \u49324 \u46988 \u51008  \u50756 \u51204 \u55176  \u50672 \u54633 \u46108  \u49373 \u54876 \u51012  \u54616 \u50688 \u51004 \u47728 , \u49324 \u47581 \u46020  \u44536 \u46308 \u51012  \u54756 \u50612 \u51648 \u44172  \u54624  \u49688  \u50630 \u50632 \u45796 . \u45824 \u51473 \u51032  \u51064 \u44592 \u47484  \u45124 \u45716  \u51116 \u44036 \u51012  \u44032 \u51652  \u51228 \u47212 \u51008  \u52380 \u51116 \u51201 \u51064  \u46160 \u45516 \u47484  \u44032 \u51276 \u44256 , \u47568 \u51012  \u51096 \u54616 \u44256 , \u54617 \u49885 \u51060  \u46832 \u50612 \u45228 \u45796 . \u44536 \u47084 \u45208  \u52280 \u46108  \u51064 \u44201 \u51012  \u54805 \u49457 \u54616 \u45716  \u51088 \u51656  (\u36039 \u36074 ) \u51012  \u44396 \u48708 \u54620  \u51216 \u50640  \u51080 \u50612 \u49436 \u45716  \u54980 \u49828 \u44032  \u54620 \u52789  \u45908  \u53441 \u50900 \u54616 \u50688 \u45796 . \u44536 \u51032  \u45257 \u51221 \u54620  \u54032 \u45800 \u47141 \u51060  \u51228 \u47212 \u51032  \u52649 \u46041 \u51201 \u51064  \u51221 \u49888 \u51012  \u51228 \u50612 \u54644  \u51452 \u45716  \u50669 \u54624 \u51012  \u51096 \u54616 \u50688 \u45796 . \u54620 \u54200  \u51228 \u47212 \u51008  \u52280 \u51004 \u47196  \u44216 \u49552 \u54616 \u44172  \u54980 \u49828 \u51032  \u51652 \u44032  (\u30494 \u20729 ) \u47484  \u51064 \u51221 \u54616 \u44256  \u44536 \u51032  \u44428 \u47732 \u51012  \u51096  \u48155 \u50500 \u46308 \u50688 \u45796 . \u4