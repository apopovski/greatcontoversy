\uc0\u51060 \u53951 \u45216  \u47336 \u53552 \u45716  \u51032 \u54924 \u50640  \u52636 \u46160 \u54616 \u46972 \u45716  \u47749 \u47161 \u51012  \u48155 \u50520 \u45796 . \u54889 \u49892 \u51032  \u54620  \u44288 \u47532 \u44032  \u44536 \u47484  \u51032 \u54924 \u47196  \u51064 \u46020 \u54616 \u50688 \u45716 \u45936 , \u44536 \u45716  \u44536  \u51109 \u49548 \u44620 \u51648  \u44032 \u45716  \u45936  \u50612 \u47140 \u50880 \u51012  \u44202 \u50632 \u45796 . \u47784 \u46304  \u44600 \u51008  \u47196 \u47560 \u51032  \u44428 \u50948 \u47484  \u50857 \u44048 \u54616 \u44172  \u45824 \u54637 \u54620  \u51060  \u49849 \u47140 \u47484  \u48372 \u44592  \u50948 \u54616 \u50668  \u50676 \u44305 \u54616 \u45716  \u44400 \u51473 \u46308 \u47196  \u52264 \u44256  \u45336 \u52452 \u45796 .\
\uc0\u47336 \u53552 \u44032  \u51116 \u54032 \u44288  \u50526 \u50640  \u49436 \u47140 \u44256  \u54624  \u44536  \u46412 \u50640  \u47566 \u51008  \u51204 \u51137 \u50640 \u49436  \u50857 \u47609 \u51012  \u46504 \u52828  \u54620  \u45721 \u51008  \u51109 \u44400 \u51060  \u44536 \u50640 \u44172  \u52828 \u51208 \u54616 \u44172  \u47568 \u54616 \u50688 \u45796 . \'93\u44032 \u47144 \u54620  \u49849 \u47140 \u50668 ! \u44032 \u47144 \u54620  \u49849 \u47140 \u50668 ! \u44536 \u45824 \u45716  \u51648 \u44552  \u45208 \u50752  \u45208  \u50808 \u51032  \u50612 \u46500  \u51109 \u44400 \u46308 \u51060  \u44032 \u51109  \u44201 \u47148 \u54620  \u51204 \u51137 \u50640 \u49436 \u46020  \u44221 \u54744 \u54616 \u51648  \u47803 \u54620  \u45908 \u50865  \u44256 \u49345 \u54620  \u53804 \u51137 \u51012  \u51649 \u47732 \u54616 \u44256  \u51080 \u45796 . \u47564 \u51068  \u44536 \u45824 \u44032  \u54616 \u45716  \u51068 \u51060  \u48148 \u47476 \u44256 , \u44144 \u44592 \u50640  \u45824 \u54616 \u50668  \u44536 \u45824 \u44032  \u54869 \u49888 \u51012  \u44032 \u51648 \u44256  \u51080 \u45796 \u47732 , \u44536 \u45824 \u45716  \u54616 \u45208 \u45784 \u51032  \u51060 \u47492 \u51004 \u47196  \u51204 \u51652 \u54616 \u46972 . \u44536 \u47532 \u44256  \u46160 \u47140 \u50892  \u47568 \u46972 . \u54616 \u45208 \u45784 \u44760 \u49436  \u44536 \u45824 \u47484  \u44208 \u53076  \u48260 \u47532 \u51648  \u50500 \u45768 \u54616 \u49892  \u44163 \u51060 \u45796 \'94 (D\'92Aubigne, b.7, ch.8).\
\uc0\u46300 \u46356 \u50612  \u47336 \u53552 \u45716  \u54924 \u51032 \u51109 \u50640  \u49456 \u45796 . \u54889 \u51228 \u45716  \u48372 \u51340 \u50640  \u50505 \u44256 , \u44397 \u45236 \u51032  \u44032 \u51109  \u44256 \u44480 \u54620  \u51064 \u47932 \u46308 \u51060  \u44536  \u51452 \u50948 \u50640  \u50676 \u49437 \u54664 \u45796 . \u47560 \u54004  \u47336 \u53552 \u44032  \u44536 \u51032  \u49888 \u50521 \u51012  \u48320 \u54840 \u54616 \u44592  \u50948 \u54616 \u50668  \u51032 \u54924 \u50640  \u52636 \u49437 \u54616 \u50688 \u45912  \u44536  \u46412 \u52376 \u47100  \u51109 \u50628 \u54620  \u51032 \u54924 \u45716  \u51068 \u52237 \u51060  \u50630 \u50632 \u45796 . \'93\u44536  \u44305 \u44221  \u51088 \u52404 \u44032  \u48277 \u50773 \u44368 \u50640  \u45824 \u54620  \u47336 \u53552 \u51032  \u48516 \u47749 \u54620  \u49849 \u47532 \u47484  \u48372 \u50668  \u51452 \u50632 \u45796 . \u51060 \u48120  \u48277 \u50773 \u51008  \u44536 \u47484  \u51221 \u51396 \u54616 \u50688 \u51648 \u47564  \u51221 \u51396 \u45817 \u54620  \u44536  \u49324 \u46988 \u51008  \u51648 \u44552  \u51116 \u54032 \u51221 \u50640  \u49436  \u51080 \u45796 . \u51060  \u49324 \u49892 \u51008  \u51032 \u54924 \u44032  \u48277 \u50773 \u44428  \u50948 \u50640  \u51080 \u45796 \u45716  \u44163 \u51012  \u45208 \u53440 \u45236 \u50632 \u45796 . \u48277 \u50773 \u51008  \u44536 \u47484  \u54028 \u47928 \u54616 \u50668  \u47784 \u46304  \u51064 \u44036  \u49324 \u54924 \u50640 \u49436  \u45130 \u50612  \u48260 \u47160 \u51648 \u47560 \u45716 , \u51316 \u44221 \u54616 \u45716  \u47568 \u47196  \u49548 \u54872 \u45817 \u54616 \u50668  \u51060  \u49464 \u49345 \u50640 \u49436  \u44032 \u51109  \u54988 \u47469 \u54620  \u51032 \u54924 \u51032  \u50689 \u51217 \u51012  \u48155 \u50520 \u45796 . \u48277 \u50773 \u51008  \u44536 \u50640 \u44172  \u50689 \u50896 \u55176  \u52840 \u47925 \u51012  \u51648 \u53412 \u46020 \u47197  \u49440 \u44256 \u54616 \u50688 \u51648 \u47564 , \u44536 \u45716  \u51060 \u51228  \u47680 \u47532  \u46504 \u50612 \u51652  \u44536 \u47532 \u49828 \u46020 \u44368 \u44397 \u51032  \u50668 \u47084  \u44275 \u50640 \u49436  \u47784 \u50668 \u46304  \u50676 \u47148 \u54616 \u44256  \u47924 \u49688 \u54620  \u52397 \u51473  \u50526 \u50640  \u49436 \u49436  \u47568 \u51012  \u54616 \u47140 \u44256  \u54620 \u45796 . \u51060 \u48120  \u45440 \u46980  \u47564 \u54620  \u44060 \u54785 \u51060  \u47336 \u53552 \u46972 \u45716  \u46020 \u44396 \u47484  \u53685 \u54616 \u50668  \u51060 \u47336 \u50612 \u51276 \u45796 . \u51060 \u46412 \u50640  \u51060 \u48120  \u47196 \u47560 \u45716  \u44536  \u48372 \u51340 \u47196 \u48512 \u53552  \u45236 \u47532 \u47561 \u44600 \u51012  \u44151 \u44256  \u51080 \u50632 \u45796 . \u47196 \u47560 \u47484  \u51060 \u47084 \u54620  \u49345 \u53468 \u50640  \u48736 \u46888 \u47536  \u44163 \u51008  \u51068 \u44060  \u49849 \u47140 \u51032  \u51020 \u49457 \u51060 \u50632 \u45796 \'94 (D\'92Aubigne, b.7, ch.8).\
\uc0\u51060 \u52376 \u47100  \u50976 \u47141 \u54616 \u44256  \u50976 \u47749 \u54620  \u51032 \u54924  \u50526 \u50640  \u49436 \u44172  \u46104 \u51088  \u48708 \u52380 \u54620  \u44228 \u44553 \u51032  \u52636 \u49888 \u51064  \u44060 \u54785 \u51088 \u45716  \u46160 \u47140 \u50892 \u54616 \u44256  \u45817 \u54889 \u54616 \u45716  \u46319 \u51060  \u48372 \u50688 \u45796 . \u47751  \u49324 \u46988 \u51032  \u50689 \u51452  (\u63924 \u20027 ) \u46308 \u51008  \u44536 \u51032  \u53468 \u46020 \u47484  \u48372 \u44256  \u44032 \u44620 \u51060  \u50752 \u49436  \'93\u47800 \u51008  \u51453 \u50668 \u46020  \u50689 \u54844 \u51008  \u45733 \u55176  \u51453 \u51060 \u51648  \u47803 \u54616 \u45716  \u51088 \u46308 \u51012  \u46160 \u47140 \u50892 \u54616 \u51648  \u47568 \u46972 \'94 (\u47560  10:28) \u44256  \u49549 \u49325 \u50688 \u45796 . \u46608  \u45796 \u47480  \u49324 \u46988 \u46308 \u51008  \'93\u45208 \u47484  \u51064 \u54616 \u50668  \u52509 \u46021 \u46308 \u44284  \u51076 \u44552 \u46308  \u50526 \u50640  \u45132 \u47140 \u44032 \u47532 \u45768  \u51060 \u45716  \u51200 \u55148 \u50752  \u51060 \u48169 \u51064 \u46308 \u50640 \u44172  \u51613 \u44144 \u44032  \u46104 \u44172  \u54616 \u47140  \u54616 \u49900 \u51060 \u46972  \u45320 \u55148 \u47484  \u45336 \u44200 \u51460  \u46412 \u50640  \u50612 \u46523 \u44172  \u46608 \u45716  \u47924 \u50631 \u51012  \u47568 \u54624 \u44620  \u50684 \u47140 \u54616 \u51648  \u47568 \u46972  \u44536  \u46412 \u50640  \u47924 \u49832  \u47568 \u54624  \u44163 \u51012  \u51452 \u49884 \u47532 \u45768  \u47568 \u54616 \u45716  \u51060 \u45716  \u45320 \u55148 \u44032  \u50500 \u45768 \u46972  \u45320 \u55148  \u49549 \u50640 \u49436  \u47568 \u50432 \u54616 \u49884 \u45716  \u51088  \u44263  \u45320 \u55148  \u50500 \u48260 \u51648 \u51032  \u49457 \u47161 \u51060 \u45768 \u46972 \'94 (\u47560  10:18~20) \u44256  \u47568 \u54616 \u50688 \u45796 . \u51060 \u50752  \u44057 \u51060  \u44536 \u47532 \u49828 \u46020 \u51032  \u47568 \u50432 \u51008  \u49464 \u49345 \u51032  \u50948 \u45824 \u54620  \u49324 \u46988 \u46308 \u51012  \u53685 \u54616 \u50668  \u49884 \u47144  \u51473 \u50640  \u51080 \u45716  \u44536 \u48516 \u51032  \u51333 \u51012  \u44201 \u47140 \u54616 \u50688 \u45796 .\
\uc0\u47336 \u53552 \u45716  \u54889 \u51228 \u51032  \u48372 \u51340  \u48148 \u47196  \u50526 \u50640  \u49436 \u44172  \u46104 \u50632 \u45796 . \u52840 \u47925 \u51060  \u50728  \u54924 \u51032 \u51109 \u51012  \u50628 \u49845 \u54616 \u50688 \u45796 . \u54889 \u49892 \u51032  \u44288 \u47532 \u44032  \u51068 \u50612 \u49436 \u49436  \u44225 \u50640  \u49939 \u50500  \u45459 \u51008  \u47336 \u53552 \u51032  \u51200 \u49436 \u46308 \u51012  \u44032 \u47532 \u53412 \u47732 \u49436  \u47336 \u53552 \u50640 \u44172  \u46160  \u44032 \u51648  \u51656 \u47928 \u50640  \u45824 \u54616 \u50668  \u45824 \u45813 \u54616 \u46972 \u44256  \u50836 \u44396 \u54616 \u50688 \u45796 . \u44536  \u47784 \u46304  \u51200 \u49436 \u46308 \u51012  \u51088 \u44592 \u51032  \u44163 \u51004 \u47196  \u49884 \u51064 \u54616 \u45712 \u45264 \u45716  \u51656 \u47928 \u44284  \u44536  \u51200 \u49436 \u46308  \u49549 \u50640 \u49436  \u45208 \u53440 \u45240  \u51452 \u51109 \u46308 \u51012  \u52712 \u49548 \u54616 \u44192 \u45712 \u45264 \u45716  \u51656 \u47928 \u51060 \u50632 \u45796 . \u52264 \u47168 \u47196  \u51200 \u49436 \u46308 \u51032  \u51060 \u47492 \u51060  \u48520 \u47532 \u50892 \u51648 \u51088 , \u47336 \u53552 \u45716  \u52395 \u51704  \u51656 \u47928 \u50640  \u45824 \u54616 \u50668  \u44536  \u51200 \u49436 \u46308 \u51060  \u45796  \u51088 \u44592 \u51032  \u44163 \u51076 \u51012  \u49884 \u51064 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u46168 \u51704  \u51656 \u47928 \u50640  \u45824 \u54616 \u50668  \u44536 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u54616 \u50688 \u45796 . \'93\u44536 \u44163 \u51008  \u48127 \u51020 \u44284  \u50689 \u54844 \u51032  \u44396 \u50896 \u50640  \u44288 \u54620  \u44163 \u51060 \u47728  \u45908 \u50865 \u51060  \u54616 \u45720 \u44284  \u46405 \u50640 \u49436  \u44032 \u51109  \u50948 \u45824 \u54616 \u44256  \u44480 \u51473 \u54620  \u48372 \u48176 \u51064  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u50640  \u44288 \u44228 \u46104 \u45716  \u44163 \u51060 \u48064 \u47196  \u45208 \u45716  \u44618 \u51060  \u49373 \u44033 \u54620  \u46244 \u50640  \u49888 \u51473 \u54616 \u44172  \u45824 \u45813 \u54616 \u44192 \u49845 \u45768 \u45796 . \u51652 \u47532 \u44032  \u50836 \u44396 \u54616 \u45716  \u45824 \u47196  \u54616 \u51648  \u50506 \u44256  \u54872 \u44221 \u50640  \u46384 \u46972  \u54665 \u46041 \u54616 \u48064 \u47196  \'91\u45572 \u44396 \u46304 \u51648  \u49324 \u46988  \u50526 \u50640 \u49436  \u45208 \u47484  \u48512 \u51064 \u54616 \u47732  \u45208 \u46020  \u54616 \u45720 \u50640  \u44228 \u49888  \u45236  \u50500 \u48260 \u51648  \u50526 \u50640 \u49436  \u51200 \u47484  \u48512 \u51064 \u54616 \u47532 \u46972 \'92 (\u47560  10:33) \u44256  \u54616 \u49888  \u44536 \u47532 \u49828 \u46020 \u51032  \u47568 \u50432 \u50640  \u51200 \u52489 \u46112 \u44620  \u46160 \u47140 \u50892 \u54616 \u45208 \u51060 \u45796 . \u44536 \u47084 \u48064 \u47196  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u50640  \u51200 \u52489 \u46104 \u51648  \u50506 \u44256  \u45824 \u45813 \u54624  \u49688  \u51080 \u46020 \u47197  \u51316 \u44221 \u54616 \u45716  \u51204 \u54616 \u44760 \u49436  \u51104 \u49884  \u50976 \u50696 \u51032  \u49884 \u44036 \u51012  \u54728 \u46973 \u54616 \u50668  \u51452 \u49884 \u44592 \u47484  \u51652 \u49900 \u51004 \u47196  \u44036 \u50896 \u54616 \u45208 \u51060 \u45796 \'94 (D\'92Aubigne, b.7, ch.8).\
