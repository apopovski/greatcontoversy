\f0\b \cf0 \uc0\u46021 \u51068 \u50612  \u49457 \u44221 \u51032  \u50756 \u49457 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u47336 \u53552 \u45716  \u48148 \u47476 \u53944 \u48512 \u47476 \u53356 \u50640 \u49436  \u46028 \u50500 \u50724 \u51088  \u49888 \u50557  \u49457 \u44221 \u51032  \u48264 \u50669 \u51012  \u50756 \u49457 \u54616 \u50668 , \u46021 \u51068  \u44397 \u48124 \u51004 \u47196  \u54616 \u50668 \u44552  \u51088 \u44397 \u50612 \u47196  \u46108  \u48373 \u51020 \u49436 \u47484  \u44032 \u51656  \u49688  \u51080 \u44172  \u54616 \u50688 \u45796 . \u51060  \u48264 \u50669 \u51008  \u51652 \u47532 \u47484  \u49324 \u46993 \u54616 \u45716  \u47784 \u46304  \u49324 \u46988 \u46308 \u50640  \u51032 \u54616 \u50668  \u53360  \u44592 \u49256 \u51004 \u47196  \u54872 \u50689 \u51012  \u48155 \u50520 \u45796 . \u44536 \u47084 \u45208  \u44536 \u44163 \u51008  \u49324 \u46988 \u51032  \u51204 \u49444 \u44284  \u49324 \u46988 \u51032  \u44228 \u47749 \u51012  \u53469 \u54620  \u49324 \u46988 \u46308 \u47196 \u48512 \u53552  \u49900 \u54620  \u48176 \u52377 \u51012  \u48155 \u50520 \u45796 .\
\uc0\u49888 \u48512 \u46308 \u51008  \u51068 \u48152  \u49324 \u46988 \u46308 \u51060  \u51060 \u51228  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u50640  \u45824 \u54616 \u50668  \u44536 \u46308 \u44284  \u53664 \u47200 \u54624  \u49688  \u51080 \u44172  \u46104 \u50632 \u51004 \u48064 \u47196  \u44536 \u46308 \u51032  \u47924 \u51648 \u44032  \u54253 \u47196 \u46112 \u44620  \u46160 \u47140 \u50892 \u49436  \u44161 \u45236 \u51648  \u50506 \u51012  \u49688  \u50630 \u50632 \u45796 . \u44536 \u46308 \u51032  \u51064 \u44036 \u51201 \u51064  \u51060 \u47200 \u51032  \u47924 \u44592 \u45716  \u49457 \u47161 \u51032  \u44160 \u51012  \u45824 \u54637 \u54616 \u44592 \u50640 \u45716  \u47924 \u47141 \u54616 \u50688 \u45796 . \u47196 \u47560 \u45716  \u49457 \u44221 \u51032  \u48372 \u44553 \u51012  \u48169 \u54644 \u54616 \u44592  \u50948 \u54616 \u50668  \u50728  \u44428 \u47141 \u51012  \u45796  \u46041 \u50896 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u52825 \u47161 \u44284  \u54028 \u47928 \u44284  \u44256 \u47928 \u51008  \u45796  \u54728 \u51648 \u47196  \u46028 \u50500 \u44052 \u45796 . \u49457 \u44221 \u51012  \u48708 \u45212 \u54616 \u44256  \u44552 \u51648 \u54616 \u47732  \u54624 \u49688 \u47197  \u49457 \u44221 \u51032  \u52280 \u46907 \u51012  \u50508 \u44256 \u51088  \u54616 \u45716  \u49324 \u46988 \u46308 \u51032  \u50676 \u49900 \u51008  \u45908 \u50865  \u51613 \u44032 \u46104 \u50632 \u45796 . \u44544 \u51012  \u51069 \u51012  \u49688  \u51080 \u45716  \u49324 \u46988 \u51008  \u47784 \u46160  \u51088 \u44592  \u49828 \u49828 \u47196  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51012  \u50676 \u49900 \u55176  \u50672 \u44396 \u54616 \u44172  \u46104 \u50632 \u45796 . \u44536 \u46308 \u51008  \u49457 \u44221 \u51012  \u44032 \u51648 \u44256  \u45796 \u45768 \u47732 \u49436  \u44536 \u44163 \u51012  \u51069 \u44256  \u46608  \u51069 \u50632 \u51004 \u47728 , \u47560 \u52840 \u45236  \u49457 \u44221 \u51032  \u45824 \u48512 \u48516 \u51012  \u50516 \u49569 \u54616 \u44256 \u49436 \u50556  \u47564 \u51313 \u54616 \u50688 \u45796 . \u49888 \u50557  \u49457 \u44221 \u51060  \u53356 \u44172  \u54872 \u50689 \u51012  \u48155 \u45716  \u44163 \u51012  \u48376  \u47336 \u53552 \u45716  \u51593 \u49884  \u44396 \u50557  \u49457 \u44221 \u51032  \u48264 \u50669 \u50640 \u46020  \u52265 \u49688 \u54616 \u50668  \u48264 \u50669 \u46104 \u45716  \u45824 \u47196  \u44536 \u44163 \u51012  \u47751  \u44428 \u51004 \u47196  \u45208 \u45572 \u50612  \u52636 \u54032 \u54616 \u50688 \u45796 .\
