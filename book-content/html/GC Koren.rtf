\uc0\u44536 \u48516 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u48156 \u44152 \u51020 \u51060  \u51648 \u44552  \u50612 \u46356 \u47484  \u54693 \u54616 \u44256  \u51080 \u45716 \u51648  \u51096  \u50500 \u49512 \u51004 \u45208  \u44536 \u48516 \u51032  \u45576 \u47932 \u51008  \u44536 \u48516  \u51088 \u49888 \u51012  \u50948 \u54620  \u44163 \u51060  \u50500 \u45768 \u50632 \u45796 . \u44536 \u48516 \u51032  \u50526 \u50640 \u45716  \u44191 \u49464 \u47560 \u45348  \u44263  \u45796 \u44032 \u50724 \u45716  \u44256 \u45516 \u51032  \u51109 \u47732 \u51060  \u54204 \u52432 \u51256  \u51080 \u50632 \u45796 . \u50668 \u47084  \u49464 \u44592  \u46041 \u50504 \u50640  \u48264 \u51228  \u46300 \u47540  \u50577 \u46308 \u51060  \u51648 \u45208 \u44036  \u47928 , \u51060 \u51228 \u45716  \u46608 \u54620  \'93\u46020 \u49688 \u51109 \u51004 \u47196  \u45132 \u47140 \u44032 \u45716  \u50612 \u47536 \u50577 \'94 (\u49324  53:7) \u51060 \u49888  \u44536 \u48516 \u44760 \u49436  \u51648 \u45208 \u44040  \u50577 \u47928 \u46020  \u48372 \u50688 \u45796 . \u49901 \u51088 \u44032 \u50640  \u47803  \u48149 \u55176 \u49892  \u51109 \u49548 \u51064  \u44040 \u48148 \u47532 \u46020  \u47680 \u51648  \u50506 \u51008  \u44275 \u50640  \u51080 \u50632 \u45796 . \u50724 \u47000 \u51648  \u50506 \u50500 \u49436  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u44152 \u50612 \u44032 \u49892  \u44536  \u44600  \u50948 \u50640 \u45716  \u51109 \u52264  \u45817 \u49888 \u51032  \u50689 \u54844 \u51060  \u49549 \u51396  \u51228 \u47932 \u47196  \u46300 \u47140 \u51656  \u46412 \u50640  \u47924 \u49436 \u50868  \u53360  \u50516 \u55121 \u51060  \u51076 \u54624  \u44163 \u51060 \u50632 \u45796 . \u44536 \u47084 \u45208  \u51060  \u51600 \u44144 \u50868  \u46412 \u50640  \u44536 \u48516 \u51032  \u47560 \u51020 \u51012  \u50612 \u46177 \u44172  \u54620  \u44163 \u51008  \u51060 \u47088  \u51109 \u47732 \u46308 \u51012  \u47749 \u49345 \u54632 \u51004 \u47196 \u44032  \u50500 \u45768 \u50632 \u45796 . \u51088 \u49888 \u50640 \u44172  \u48120 \u52824 \u47532 \u46972 \u44256  \u50696 \u49345 \u46104 \u45716  \u52488 \u51064 \u44036 \u51201 \u51064  \u44256 \u45516 \u46020  \u44536 \u48516 \u51032  \u47924 \u50500  (\u28961 \u25105 ) \u51032  \u51221 \u49888 \u50640  \u44396 \u47492 \u51060  \u45180 \u44172  \u54624  \u49688 \u45716  \u50630 \u50632 \u45796 . \u44536 \u48516 \u44760 \u49436 \u45716  \u47736 \u47581  \u48155 \u51012  \u50868 \u47749 \u50640  \u52376 \u54620  \u50696 \u47336 \u49332 \u47128 \u51032  \u47924 \u49688 \u54620  \u48177 \u49457 \u46308 \u51012  \u50948 \u54616 \u50668  \u50864 \u49512 \u45796 . \u44263  \u44536 \u48516 \u44760 \u49436  \u52629 \u48373 \u54616 \u49884 \u44256  \u44396 \u50896 \u54616 \u44592  \u50948 \u54616 \u50668  \u50724 \u49888  \u44536  \u48177 \u49457 \u46308 \u51032  \u47924 \u51648 \u50752  \u44256 \u51665  \u46412 \u47928 \u51060 \u50632 \u45796 .\
\uc0\u50696 \u49688 \u45784 \u51032  \u45576 \u50526 \u50640 \u45716  \u54616 \u45208 \u45784 \u51032  \u53945 \u48324 \u54620  \u51008 \u52509 \u44284  \u48372 \u54840 \u47484  \u51077 \u51008  \u53469 \u54620  \u48177 \u49457 \u46308 \u51032  \u52380 \u50668  \u45380 \u44036 \u51032  \u50669 \u49324 \u44032  \u54204 \u52432 \u51256  \u51080 \u50632 \u45796 . \u44144 \u44592 \u50640 \u45716  \u54616 \u45208 \u45784 \u51032  \u50500 \u46308 \u51032  \u55148 \u49373 \u51012  \u49345 \u51669 \u54616 \u45716  \u50616 \u50557 \u51032  \u50500 \u46308 \u51060  \u50500 \u47924 \u47088  \u48152 \u54637  \u50630 \u51060  \u51228 \u47932 \u47196 \u49436  \u51228 \u45800 \u50640  \u47926 \u51060 \u50612  \u51080 \u45912  \u47784 \u47532 \u50500  \u49328 \u51060  \u48372 \u50688 \u45796 . \u51060 \u44275 \u51060 \u50556 \u47568 \u47196  \u52629 \u48373 \u51032  \u50616 \u50557 , \u44263  \u47700 \u49884 \u50556 \u50640  \u45824 \u54620  \u50689 \u44305 \u49828 \u47084 \u50868  \u54728 \u46973 \u51060  \u48127 \u51020 \u51032  \u51312 \u49345 \u50640 \u44172  \u54869 \u51613 \u46104 \u50632 \u45912  \u44275 \u51060 \u45796 . \u51060 \u44275 \u51060 \u50556 \u47568 \u47196  \u51396 \u51064 \u51012  \u50948 \u54620  \u44396 \u51452 \u51032  \u55148 \u49373 \u44284  \u51473 \u48372 \u47484  \u51201 \u51208 \u55176  \u49345 \u51669 \u54616 \u45716  \u48264 \u51228 \u51032  \u48520 \u44867 \u51060  \u50724 \u47476 \u45212 \u51032  \u53440 \u51089 \u47560 \u45817 \u51004 \u47196 \u48512 \u53552  \u54616 \u45720 \u47196  \u50732 \u46972 \u44048 \u51004 \u47196 \u50024  \u44536  \u47736 \u47581 \u49884 \u53412 \u45716  \u52380 \u49324 \u51032  \u44160 \u51012  \u51228 \u51648 \u49884 \u53416  \u44275 \u51060 \u45796  (\u45824 \u49345  21\u51109  \u52280 \u51312 ). \u50696 \u47336 \u49332 \u47128 \u51008  \u49464 \u49345 \u51032  \u50612 \u46500  \u44275 \u48372 \u45796 \u46020  \u54616 \u45208 \u45784 \u51032  \u51008 \u52509 \u51012  \u45908 \u50865  \u47566 \u51060  \u51077 \u44256  \u51080 \u50632 \u45796 . \'93\u50668 \u54840 \u50752 \u44760 \u49436  \u49884 \u50728 \u51012  \u53469 \u54616 \u49884 \u44256  \u51088 \u44592  \u44144 \u52376 \u47484  \u49340 \u44256 \u51088 \'94 (\u49884  132:13) \u54616 \u49512 \u45796 . \u44536  \u44275 \u51008  \u50668 \u47084  \u49884 \u45824  \u46041 \u50504 \u50640  \u44144 \u47337 \u54620  \u49440 \u51648 \u51088 \u46308 \u51060  \u44221 \u44256 \u51032  \u44592 \u48324 \u51012  \u51204 \u54620  \u44275 \u51060 \u50836 , \u51228 \u49324 \u51109 \u46308 \u51060  \u54693 \u47196 \u47484  \u44032 \u51648 \u44256  \u48516 \u54693 \u54616 \u45912  \u44275 \u51060 \u50836 , \u54693 \u50672 \u51060  \u50696 \u48176 \u54616 \u45716  \u51088 \u46308 \u51032  \u44592 \u46020 \u50752  \u54632 \u44760  \u54616 \u45208 \u45784  \u50526 \u50640  \u49345 \u45804 \u46104 \u45912  \u44275 \u51060 \u50632 \u45796 . \u44536  \u44275 \u51008  \u54616 \u45208 \u45784 \u51032  \u50612 \u47536 \u50577 \u51012  \u49345 \u51669 \u54616 \u45716  \u50612 \u47536 \u50577 \u51012  \u51105 \u50500  \u45216 \u47560 \u45796  \u44536  \u54588 \u47484  \u46300 \u47532 \u45912  \u44275 \u51060 \u50836 , \u50668 \u54840 \u50752 \u44760 \u49436  \u49549 \u51396 \u49548  \u50948 \u50640  \u51080 \u45716  \u50689 \u44305 \u51032  \u44396 \u47492 \u51004 \u47196  \u45817 \u49888 \u51032  \u51076 \u51116 \u47484  \u45208 \u53440 \u45236 \u49884 \u45912  \u44275 \u51060 \u50632 \u45796 . \u44536  \u44275 \u51008  \u54616 \u45720 \u44284  \u46405 \u51060  \u50672 \u44208 \u46104 \u50612  \u44536  \u50948 \u47196  \u54616 \u45208 \u45784 \u51032  \u49324 \u51088 \u44032  \u50724 \u47476 \u46973 \u45236 \u47532 \u46973 \u54616 \u44256 , \u51648 \u49457 \u49548 \u47196  \u46308 \u50612 \u44032 \u45716  \u44600 \u51012  \u51060  \u49464 \u49345 \u50640  \u50676 \u50612  \u51456  \u49888 \u48708 \u47196 \u50868  \u49324 \u45796 \u47532 \u44032  \u45459 \u50668  \u51080 \u45912  \u44275 \u51060 \u45796  (\u52285  28:12; \u50836  1:51 \u52280 \u51312 ). \u44536 \u47084 \u48064 \u47196  \u51060 \u49828 \u46972 \u50648 \u51060  \u54620  \u44397 \u44032 \u47196 \u49436  \u54616 \u45208 \u45784 \u44760  \u52649 \u49457 \u51012  \u45796 \u54616 \u50688 \u50632 \u45908 \u46972 \u47732 , \u50696 \u47336 \u49332 \u47128 \u51008  \u54616 \u45208 \u45784 \u51032  \u53469 \u54620  \u44275 \u51004 \u47196  \u50689 \u50896 \u55176  \u45224 \u50500  \u51080 \u50632 \u51012  \u44163 \u51060 \u45796 . \u44536 \u47084 \u45208  \u44536 \u52376 \u47100  \u51008 \u52509  \u48155 \u51008  \u48177 \u49457 \u51032  \u50669 \u49324 \u44032  \u48176 \u44368 \u50752  \u48152 \u50669 \u51032  \u44592 \u47197 \u51004 \u47196  \u51216 \u52384 \u46104 \u50632 \u45796 . \u44536 \u46308 \u51008  \u54616 \u45208 \u45784 \u51032  \u51008 \u54812 \u47484  \u44144 \u51208 \u54616 \u44256 , \u44536 \u46308 \u51032  \u53945 \u44428 \u51012  \u45224 \u50857 \u54616 \u44256  \u44536 \u46308 \u51032  \u44592 \u54924 \u47484  \u44221 \u55176  \u50668 \u44220 \u45796 .\
\uc0\u48708 \u47197  \u51060 \u49828 \u46972 \u50648  \u48177 \u49457 \u46308 \u51060  \'93\u54616 \u45208 \u45784 \u51032  \u49324 \u51088 \u47484  \u48708 \u50883 \u44256  \u47568 \u50432 \u51012  \u47736 \u49884 \u54616 \u47728  \u44536  \u49440 \u51648 \u51088 \u47484  \u50837 \u54616 \'94 (\u45824 \u54616  36:16) \u50688 \u51012 \u51648 \u46972 \u46020 , \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u50668 \u51204 \u55176  \u44536 \u46308 \u50640 \u44172  \u45817 \u49888 \u51012  \'93\u51088 \u48708 \u47213 \u44256  \u51008 \u54812 \u47213 \u44256  \u45432 \u54616 \u44592 \u47484  \u45908 \u46356 \u54616 \u44256  \u51064 \u51088 \u50752  \u51652 \u49892 \u51060  \u47566 \u51008  \u54616 \u45208 \u45784 \'94 (\u52636  34:6) \u51004 \u47196  \u45208 \u53440 \u45236 \u49512 \u45796 . \u44144 \u46317 \u46104 \u45716  \u48176 \u48152 \u50640 \u46020  \u48520 \u44396 \u54616 \u44256  \u44536 \u48516 \u51032  \u51088 \u48708 \u45716  \u44536 \u46308 \u51060  \u54924 \u44060 \u54616 \u44592 \u47484  \u44228 \u49549  \u53444 \u50896 \u54616 \u50688 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u50500 \u48708 \u44032  \u44536  \u51088 \u49885 \u51012  \u48520 \u49933 \u55176  \u50668 \u44592 \u45716  \u44163 \u48372 \u45796  \u45908 \u54620  \u49324 \u46993 \u51004 \u47196  \'93\u44536  \u48177 \u49457 \u44284  \u44536  \u44144 \u54616 \u49884 \u45716  \u44275 \u51012  \u50500 \u45180 \u49324  \u48512 \u51648 \u47088 \u55176  \u44536  \u49324 \u51088 \u46308 \u51012  \u44536  \u48177 \u49457 \u50640 \u44172  \u48372 \u45236 \'94 (\u45824 \u54616  36:15) \u49512 \u45796 . \u47560 \u52840 \u45236  \u47784 \u46304  \u44428 \u44256 \u50752  \u44221 \u44228 \u50752  \u44204 \u52293 \u51060  \u54728 \u51648 \u47196  \u46028 \u50500 \u44032 \u51088  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u54616 \u45720 \u51032  \u44032 \u51109  \u44480 \u54620  \u49440 \u47932 \u51012  \u48372 \u45236  \u51452 \u49512 \u45716 \u48148 , \u44536 \u48516 \u44760 \u49436 \u45716  \u44536  \u54616 \u45208 \u51032  \u49440 \u47932 \u51012  \u53685 \u54616 \u50668  \u54616 \u45720 \u51032  \u47784 \u46304  \u44163 \u51012  \u45796  \u51452 \u49512 \u45796 .\
