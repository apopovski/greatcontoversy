\uc0\u49324 \u46020  \u48148 \u50872 \u51008  \u45936 \u49332 \u47196 \u45768 \u44032  \u44368 \u51064 \u46308 \u50640 \u44172  \u48372 \u45240  \u46168 \u51704  \u54200 \u51648 \u50640 \u49436  \u48277 \u50773 \u44428 \u51032  \u54869 \u47549 \u51012  \u52488 \u47000 \u54624  \u53360  \u48176 \u46020 \u47484  \u50696 \u50616 \u54616 \u50688 \u45796 . \u44536 \u45716  \'93\u47676 \u51200  \u48176 \u46020 \u54616 \u45716  \u51068 \u51060  \u51080 \u44256  \u51200  \u48520 \u48277 \u51032  \u49324 \u46988  \u44263  \u47736 \u47581 \u51032  \u50500 \u46308 \u51060  \u45208 \u53440 \u45208 \u44592  \u51204 \u50640 \u45716  \u51060 \u47476 \u51648  \u50500 \u45768 \u54616 \u47532 \u45768  \u51200 \u45716  \u45824 \u51201 \u54616 \u45716  \u51088 \u46972  \u48276 \u49324 \u50640  \u51068 \u52971 \u45716  \u54616 \u45208 \u45784 \u51060 \u45208  \u49709 \u48176 \u54632 \u51012  \u48155 \u45716  \u51088  \u50948 \u50640  \u46832 \u50612 \u45208  \u51088 \u51316 \u54616 \u50668  \u54616 \u45208 \u45784  \u49457 \u51204 \u50640  \u50505 \u50500  \u51088 \u44592 \u47484  \u48372 \u50668  \u54616 \u45208 \u45784 \u51060 \u46972  \u54616 \'94 (\u49332 \u54980  2:3, 4) \u47532 \u46972 \u44256  \u47568 \u54616 \u50688 \u45796 . \u44536 \u45716  \u46608 \u54620  \u44228 \u49549 \u54616 \u50668  \'93\u48520 \u48277 \u51032  \u48708 \u48128 \u51060  \u51060 \u48120  \u54876 \u46041 \u54616 \u50688 \'94 (\u49332 \u54980  2:7) \u45796 \u44256  \u54805 \u51228 \u46308 \u50640 \u44172  \u44221 \u44256 \u54616 \u44256  \u51080 \u45796 . \u44536 \u45716  \u52488 \u52285 \u44592 \u50640  \u51060 \u48120  \u44368 \u54924  \u50504 \u50640  \u50724 \u47448 \u46308 \u51060  \u47792 \u47000  \u46308 \u50612 \u50752 \u49436  \u48277 \u50773 \u44428 \u51060  \u51088 \u46972 \u45216  \u44600 \u51060  \u51456 \u48708 \u46104 \u44256  \u51080 \u45716  \u49324 \u49892 \u51012  \u48372 \u50520 \u45796 .\
\'93\uc0\u48520 \u48277 \u51032  \u48708 \u48128 \'94\u51008  \u52376 \u51020 \u50640 \u45716  \u51312 \u44552 \u50473  \u51312 \u44552 \u50473  \u48708 \u48128 \u47532 \u50640  \u44536 \u47532 \u44256  \u51312 \u50857 \u55176 , \u44536 \u47532 \u44256  \u45208 \u51473 \u50640 \u45716  \u49464 \u47141 \u51060  \u52964 \u51648 \u44256  \u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u51012  \u51648 \u48176 \u54616 \u44172  \u46104 \u51088  \u45908 \u50865  \u44277 \u44277 \u50672 \u54616 \u44172  \u44536 \u51032  \u44592 \u47564 \u51201 \u51060 \u50836 , \u52280 \u46988 \u46108  \u51068 \u51012  \u51652 \u52377 \u49884 \u53040 \u45796 . \u51060 \u44368 \u51032  \u44288 \u49845 \u51008  \u44144 \u51032  \u46300 \u47084 \u45208 \u51648  \u50506 \u44172  \u51312 \u44552 \u50473  \u51312 \u44552 \u50473  \u44536 \u47532 \u49828 \u46020 \u44368 \u54924  \u50504 \u51004 \u47196  \u52840 \u53804 \u54644  \u46308 \u50612 \u50772 \u45796 . \u50577 \u48372 \u50752  \u49692 \u51025 \u51452 \u51032 \u51201  \u51221 \u49888 \u51008  \u44368 \u54924 \u44032  \u51060 \u44368  \u50500 \u47000 \u49436  \u44204 \u45964 \u45240  \u47609 \u47148 \u54620  \u48149 \u54644 \u47196  \u47568 \u48120 \u50516 \u50500  \u54620 \u46041 \u50504  \u48169 \u52824 \u46104 \u50632 \u50632 \u45796 . \u44536 \u47084 \u45208  \u51060 \u51228  \u48149 \u54644 \u44032  \u44536 \u52824 \u44256  \u44536 \u47532 \u49828 \u46020 \u44368 \u44032  \u50773 \u44417  \u50504 \u51004 \u47196  \u46308 \u50612 \u44032 \u44172  \u46104 \u51088 , \u44368 \u54924 \u45716  \u44536 \u47532 \u49828 \u46020 \u50752  \u44536 \u48516 \u51032  \u49324 \u46020 \u46308 \u51032  \u44216 \u49552 \u54620  \u45800 \u49692 \u49457 \u51012  \u48260 \u47532 \u44256  \u51060 \u44368 \u51032  \u51228 \u49324 \u51109 \u51060 \u45208  \u48169 \u48177  (\u26041 \u20271 ) \u46308 \u51032  \u44368 \u47564 \u44284  \u54728 \u49885  (\u34395 \u39166 ) \u51012  \u46384 \u47476 \u44172  \u46104 \u50632 \u51004 \u47728  \u54616 \u45208 \u45784 \