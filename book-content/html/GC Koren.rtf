\f1\b0 \cf0 \
\uc0\u47000 \u54000 \u47672  (Latimer) \u45716  \u49457 \u44221 \u51012  \u51088 \u44592  \u45208 \u46972 \u51032  \u47568 \u47196  \u51069 \u51012  \u49688  \u51080 \u44172  \u54644 \u50556  \u54620 \u45796 \u44256  \u49444 \u44368 \u45800 \u50640 \u49436  \u55192 \u51080 \u44172  \u51452 \u51109 \u54616 \u50688 \u45796 . \u44536 \u45716  \u49457 \u44221 \u51032  \u51200 \u51088 \u45716  \'93\u54616 \u45208 \u45784  \u51088 \u49888 \u51060 \u47728 \'94, \u49457 \u44221 \u51008  \u44536  \u51200 \u51088 \u51032  \u45733 \u47141 \u44284  \u50689 \u50896 \u49457 \u51012  \u44036 \u51649 \u54616 \u44256  \u51080 \u45796 \u44256  \u47568 \u54616 \u50688 \u45796 . \'93\u50612 \u46500  \u50773 \u51060 \u45208  \u54889 \u51228 \u45208  \u51109 \u44288 \u51060 \u45208  \u53685 \u52824 \u51088 \u46304 \u51648  \u54616 \u45208 \u45784 \u51032  \u44144 \u47337 \u54620  \u47568 \u50432 \u51012  \u49692 \u51333 \u54624  \u51032 \u47924 \u50640 \u49436  \u48279 \u50612 \u45212  \u49324 \u46988 \u51008  \u54616 \u45208 \u46020  \u50630 \u45796 .\'94 \'93\u50864 \u47532 \u45716  \u44225 \u44600 \u47196  \u46308 \u50612 \u44032 \u51648  \u47568 \u44256 , \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51004 \u47196  \u51064 \u46020 \u47484  \u48155 \u46020 \u47197  \u54616 \u51088 . \'85\u50864 \u47532 \u45716  \u50864 \u47532 \u51032  \u49440 \u51312 \u46308 \u51060  \u44036  \u44600 \u51060 \u45208  \u54665 \u54620  \u51068 \u51012  \u46384 \u47476 \u44144 \u45208  \u54665 \u54616 \u44256 \u51088  \u54624  \u44163 \u51060  \u50500 \u45768 \u46972  \u45796 \u47564  \u44536 \u46308 \u51060  \u47560 \u46405 \u55176  \u54664 \u50612 \u50556  \u54624  \u51068 \u51012  \u54616 \u50668 \u50556  \u54620 \u45796 \'94 (Hugh Latimer, \'93First Sermon Preached Before King Edward VI\'94).\
\uc0\u54004 \u45916 \u51032  \u52828 \u44396  \u48152 \u51592  (Barnes) \u50752  \u54532 \u47532 \u46300  (Frith) \u44032  \u51652 \u47532 \u47484  \u50745 \u54840 \u54616 \u44592  \u50948 \u54616 \u50668  \u51068 \u50612 \u45228 \u45796 . \u44536 \u47532 \u44256  \u47532 \u46308 \u47532 \u51592  (Ridleys) \u50752  \u53356 \u47004 \u47672  (Cranmer) \u44032  \u46608  \u44536  \u46244 \u47484  \u51060 \u50612  \u51068 \u50612 \u45228 \u45796 . \u50689 \u44397 \u51032  \u51333 \u44368 \u44060 \u54785 \u51032  \u51648 \u46020 \u51088 \u46308 \u51008  \u54617 \u49885  \u51080 \u45716  \u49324 \u46988 \u46308 \u51060 \u50632 \u51004 \u47728 , \u44536 \u46308  \u51473 \u51032  \u45824 \u48512 \u48516 \u51060  \u47196 \u47560 \u44368 \u50640 \u49436  \u50676 \u49457 \u44284  \u44221 \u44148 \u51004 \u47196  \u53356 \u44172  \u51316 \u44221 \u51012  \u48155 \u51008  \u49324 \u46988 \u46308 \u51060 \u50632 \u45796 . \u44536 \u46308 \u51060  \u48277 \u50773 \u44368 \u47484  \u48152 \u45824 \u54616 \u44172  \u46108  \u44163 \u51008  \u48277 \u50773 \u52397 \u51032  \u51096 \u47803 \u51012  \u50504  \u44208 \u44284 \u50688 \u45796 . \u44536 \u46308 \u51008  \u48148 \u48296 \u47200 \u51032  \u48708 \u48128 \u51012  \u51096  \u50508 \u44256  \u51080 \u50632 \u51004 \u48064 \u47196  \u45908 \u50865  \u53360  \u45733 \u47141 \u51004 \u47196  \u44536 \u44163 \u50640  \u54637 \u44144 \u54616 \u45716  \u51613 \u50616 \u51012  \u54616 \u50688 \u45796 .\
\uc0\u47000 \u54000 \u47672 \u45716  \u47568 \u54616 \u50688 \u45796 . \'93\u45208 \u45716  \u51648 \u44552  \u54616 \u45208 \u51032  \u51060 \u49345 \u54620  \u51656 \u47928 \u51012  \u54616 \u44192 \u45796 . \u50728  \u50689 \u44397 \u50640 \u49436  \u45572 \u44032  \u44032 \u51109  \u52649 \u49457 \u49828 \u47084 \u50868  \u51452 \u44368 \u51060 \u47728  \u44048 \u46021 \u51060 \u45264 ?\'85\u45236 \u44032  \u48512 \u47476 \u45716  \u49324 \u46988 \u51032  \u51060 \u47492 \u51012  \u47749 \u49900 \u54644 \u49436  \u46308 \u50612 \u46972 . \'85\u45208 \u45716  \u47568 \u54616 \u45432 \u45768  \u44536 \u45716  \u50501 \u47560 \u51060 \u45796 . \'85\u44536 \u45716  \u44536 \u51032  \u44368 \u44396  \u48150 \u51012  \u44208 \u53076  \u45208 \u44032 \u51648  \u50506 \u45716 \u45796 . \u50616 \u51228 \u46304 \u51648  \u48512 \u47476 \u44256  \u49910 \u51012  \u46412 \u50640  \u44536 \u47484  \u48520 \u47084 \u48372 \u46972 . \u44536 \u45716  \u54637 \u49345  \u51665 \u50640  \u51080 \u45796 . \'85\u44536 \u45716  \u50616 \u51228 \u45208  \u51068 \u51012  \u54616 \u44256  \u51080 \u45796 . \u44536 \u45824 \u45716  \u44536 \u44032  \u44172 \u51004 \u47492 \u51012  \u54588 \u50864 \u44256  \u51080 \u45716  \u44163 \u51012  \u44208 \u53076  \u48380  \u49688  \u50630 \u51004 \u47532 \u46972 \u44256  \u45208 \u45716  \u48372 \u51613 \u54620 \u45796 . \'85\u50501 \u47560 \u44032  \u49324 \u45716  \u44275 \u50640 \u49436 \u45716 \'85\u52293 \u51012  \u52824 \u50892  \u48260 \u47532 \u44256  \u52507 \u45824 \u47484  \u45459 \u44256  \u51080 \u51004 \u47728  \u49457 \u44221 \u51012  \u52824 \u50892  \u48260 \u47532 \u44256  \u50684 \u51452 \u47484  \u49464 \u44256  \u51080 \u51004 \u47728  \u48373 \u51020 \u51032  \u48731 \u51012  \u48260 \u47532 \u44256  \u45824 \u45230 \u50640 \u46020  \u52507 \u48520 \u51012  \u45458 \u51060  \u46308 \u47728 ,\'85\u44536 \u47532 \u49828 \u46020 \u51032  \u49901 \u51088 \u44032 \u47484  \u45336 \u50612 \u46888 \u47532 \u44256  \u46024 \u51012  \u48764 \u50519 \u45716  \u50672 \u50725  (\u63891 \u29508 ) \u51012  \u49464 \u50864 \u47728 ,\'85\u54736 \u48279 \u44256 , \u44032 \u45212 \u54616 \u44256 , \u47924 \u47141 \u54620  \u49324 \u46988 \u46308 \u50640 \u44172  \u50743 \u51012  \u51077 \u55176 \u45716  \u45824 \u49888 \u50640  \u50668 \u47084  \u44032 \u51648  \u51116 \u47308 \u50752  \u48372 \u49437 \u51004 \u47196  \u50864 \u49345 \u51012  \u51109 \u49885 \u54616 \u47728 , \u54616 \u45208 \u45784 \u51032  \u51204 \u53685 \u44284  \u44536 \u48516 \u51032  \u44032 \u51109  \u44144 \u47337 \u54620  \u47568 \u50432 \u51012  \u48260 \u47532 \u44256  \u49324 \u46988 \u51032  \u50976 \u51204 \u44284  \u50984 \u48277 \u51012  \u45458 \u51064 \u45796 . \'85\u50500 ! \u50864 \u47532 \u51032  \u49849 \u47140 \u46308 \u46020  \u47560 \u52824  \u49324 \u45800 \u51060  \u51105 \u52488 \u50752  \u44032 \u46972 \u51648 \u47484  \u49100 \u47532 \u47140 \u44256  \u48512 \u51648 \u47088 \u55176  \u50528 \u50416 \u45716  \u44163 \u52376 \u47100  \u51339 \u51008  \u44368 \u47532 \u51032  \u50472 \u47484  \u48512 \u51648 \u47088 \u55176  \u49100 \u47536 \u45796 \u47732  \u50620 \u47560 \u45208  \u51339 \u51012 \u44620 !\'94 (Hugh Latimer, \'93Sermon of the plough\'94).\
\uc0\u44536  \u44060 \u54785 \u51088 \u46308 \u51060  \u51452 \u51109 \u54620  \u50948 \u45824 \u54620  \u50896 \u52825 \u51008  \u50760 \u45940 \u49828 \u51064 \u46308 \u44284  \u50948 \u53364 \u47532 \u54532 \u50752  \u50560  \u54980 \u49828 \u50752  \u47336 \u53552 \u50752  \u52768 \u48729 \u44544 \u47532 \u50752  \u44536 \u46308 \u44284  \u50672 \u54633 \u54664 \u45912  \u46041 \u51648 \u46308 \u51060  \u51452 \u51109 \u54620  \u50896 \u52825 \u46308 \u44284  \u46609 \u44057 \u51008  \u44163 \u51004 \u47196 , \u44536 \u44163 \u51008  \u49888 \u50521 \u44284  \u54665 \u50948 \u51032  \u54364 \u51456 \u51060  \u46104 \u45716  \u49457 \u44221 \u51060  \u51208 \u45824 \u47924 \u47448  (\u32118 \u23565 \u28961 \u35628 ) \u51032  \u44428 \u50948 \u47484  \u44032 \u51648 \u44256  \u51080 \u45796 \u45716  \u50896 \u52825 \u51060 \u50632 \u45796 . \u44536 \u46308 \u51008  \u48277 \u50773 \u44284  \u51333 \u44368  \u54924 \u51032 \u50752  \u44368 \u48512 \u46308 \u44284  \u50773 \u46308 \u51060  \u51333 \u44368  \u47928 \u51228 \u47196  \u49324 \u46988 \u51032  \u50577 \u49900 \u51012  \u51648 \u48176 \u54624  \u49688  \u51080 \u45716  \u44428 \u47532 \u44032  \u51080 \u45796 \u45716  \u44163 \u51012  \u48512 \u51064 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51032  \u44428 \u50948 \u45716  \u49457 \u44221 \u51060 \u50632 \u51004 \u48064 \u47196  \u44536 \u46308 \u51008  \u49457 \u44221 \u51032  \u44032 \u47476 \u52840 \u50640  \u51032 \u54616 \u50668  \u47784 \u46304  \u44368 \u47532 \u50752  \u47784 \u46304  \u51452 \u51109 \u51012  \u49884 \u54744 \u54616 \u50688 \u45796 . \u44536  \u44144 \u47337 \u54620  \u49324 \u46988 \u46308 \u51008  \u49324 \u54805 \u45824 \u51032  \u51060 \u49836 \u47196  \u49324 \u46972 \u51648 \u47732 \u49436 \u46020  \u54616 \u45208 \u45784 \u44284  \u49457 \u44221  \u47568 \u50432 \u50640  \u45824 \u54620  \u48127 \u51020 \u51004 \u47196  \u51648 \u53489 \u46104 \u50632 \u45796 . \u47000 \u54000 \u47672 \u45716  \u44536 \u50752  \u54632 \u4