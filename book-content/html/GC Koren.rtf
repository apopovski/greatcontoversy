\uc0\u51060  \u49884 \u45824 \u51032  \u49324 \u46988 \u46308 \u51060  \u52712 \u54616 \u45716  \u47609 \u47785 \u51201 \u51064  \u51068 \u51008  \u54364 \u54788 \u54624  \u49688  \u50630 \u51012  \u47564 \u53372  \u51060 \u49345 \u54616 \u45796 . \u49688 \u47566 \u51008  \u49324 \u46988 \u46308 \u51060  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51008  \u48127 \u51012  \u44032 \u52824 \u44032  \u50630 \u45716  \u44163 \u51060 \u46972  \u54616 \u50668  \u44144 \u51208 \u54616 \u47732 \u49436  \u49324 \u45800 \u51032  \u44592 \u47564 \u51008  \u50676 \u44305 \u51201 \u51064  \u54869 \u49888 \u51012  \u44032 \u51648 \u44256  \u48155 \u50500 \u46308 \u51064 \u45796 . \u54924 \u51032 \u47200 \u51088 \u50752  \u51312 \u47217 \u54616 \u45716  \u51088 \u46308 \u51008  \u49324 \u46020 \u46308 \u44284  \u49440 \u51648 \u51088 \u46308 \u44284  \u48127 \u51020 \u51012  \u50948 \u54616 \u50668  \u49912 \u50864 \u44256  \u51080 \u45716  \u49324 \u46988 \u46308 \u51012  \u50756 \u44256 \u54616 \u45796 \u44256  \u48708 \u45212 \u54616 \u44256 , \u44536 \u47532 \u49828 \u46020 \u50752  \u44396 \u50896 \u51032  \u44221 \u47452 \u44284  \u51652 \u47532 \u47484  \u44144 \u51208 \u54620  \u51088 \u46308 \u51060  \u48155 \u51012  \u54805 \u48268 \u50640  \u44288 \u54620  \u49457 \u44221 \u51032  \u50628 \u49689 \u54620  \u49440 \u50616 \u51012  \u51312 \u47217 \u54632 \u51004 \u47196 \u50024  \u49828 \u49828 \u47196  \u50948 \u47196 \u47484  \u48155 \u45716 \u45796 . \u44536 \u46308 \u51008  \u54616 \u45208 \u45784 \u51032  \u51452 \u51109 \u51012  \u51064 \u51221 \u54616 \u44256  \u44536 \u48516 \u51032  \u50984 \u48277 \u51032  \u50836 \u44396 \u50640  \u49692 \u51333 \u54616 \u45716  \u44163 \u51060  \u47588 \u50864  \u54200 \u54801 \u54616 \u44256  \u50612 \u47532 \u49437 \u44256  \u48120 \u49888 \u51201 \u51064  \u51068 \u51060 \u46972  \u54616 \u50668  \u44536 \u47088  \u51060 \u46308 \u51012  \u50724 \u55176 \u47140  \u44032 \u47144 \u54616 \u44172  \u49373 \u44033 \u5462