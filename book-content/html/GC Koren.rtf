\uc0\u44144 \u51032  \u47784 \u46304  \u46020 \u49884 \u50640 \u49436  \u44536 \u51032  \u49444 \u44368 \u51032  \u44208 \u44284 \u47196  \u49688 \u49901  \u47749 \u51060 , \u50612 \u46500  \u46020 \u49884 \u50640 \u49436 \u45716  \u49688 \u48177  \u47749 \u51060  \u54924 \u44060 \u54616 \u50688 \u45796 . \u47566 \u51008  \u44275 \u50640 \u49436  \u44060 \u49888 \u44368 \u51032  \u44144 \u51032  \u47784 \u46304  \u44368 \u54028 \u44032  \u44536  \u47928 \u46308 \u51012  \u50676 \u50612  \u45459 \u44172  \u46104 \u50632 \u44256 , \u51068 \u48152 \u51201 \u51004 \u47196  \u50668 \u47084  \u44368 \u54924 \u51032  \u47785 \u49324 \u46308 \u51008  \u44536 \u47484  \u52488 \u52397 \u54616 \u50668  \u49444 \u44368 \u54644  \u45804 \u46972 \u44256  \u54616 \u50688 \u45796 . \u44536 \u45716  \u52488 \u52397 \u51012  \u48155 \u51648  \u50500 \u45768 \u54620  \u44275 \u50640 \u49436 \u45716  \u50612 \u46356 \u50640 \u49436 \u45208  \u54876 \u46041 \u54616 \u51648  \u50506 \u44592 \u47196  \u54616 \u50688 \u51004 \u45208  \u44536 \u50640 \u44172  \u49604 \u46020 \u54644  \u50724 \u45716  \u50836 \u44396 \u51032  \u51208 \u48152 \u46020  \u51025 \u54624  \u49688  \u50630 \u45796 \u45716  \u44163 \u51012  \u44263  \u44648 \u45804 \u50520 \u45796 . \u51116 \u47548 \u51032  \u48516 \u47749 \u54620  \u49884 \u44592 \u47484  \u51221 \u54616 \u45716  \u44536 \u51032  \u44204 \u54644 \u47484  \u48155 \u50500 \u46308 \u51060 \u51648  \u50500 \u45768 \u54620  \u47566 \u51008  \u49324 \u46988 \u46308 \u46020  \u44536 \u47532 \u49828 \u46020 \u51032  \u51116 \u47548 \u51032  \u54869 \u49892 \u49457 \u44284  \u44596 \u48149 \u49457 \u51012  \u44648 \u45804 \u50520 \u51004 \u47728 , \u44536  \u53360  \u49324 \u44148 \u51012  \u50948 \u54616 \u50668  \u51456 \u48708 \u54624  \u54596 \u50836 \u49457 \u51012  \u54869 \u49888 \u54616 \u50688 \u45796 . \u50612 \u46500  \u53360  \u46020 \u49884 \u46308 \u50640 \u49436 \u45716  \u44536 \u51032  \u49324 \u50629 \u51060  \u45440 \u46972 \u50868  \u50689 \u54693 \u51012  \u48120 \u52452 \u45796 . \u51452 \u47448  \u54032 \u47588 \u50629 \u51088 \u46308 \u51060  \u44536 \u46308 \u51032  \u49324 \u50629 \u51012  \u48260 \u47532 \u44256  \u44536  \u51452 \u51216  (\u37202 \u24215 ) \u46308 \u51012  \u51665 \u54924 \u49548 \u47196  \u45236 \u45459 \u50520 \u51004 \u47728 , \u46020 \u48149 \u51109 \u51008  \u54224 \u49604 \u46104 \u44256 , \u47924 \u49888 \u47200 \u51088 , \u51088 \u50672 \u49888 \u44368 \u46020  (\u33258 \u28982 \u31070 \u25934 \u24466 ), \u48372 \u54200  \u44396 \u50896 \u47200 \u51088 , \u49900 \u51648 \u50612  \u44032 \u51109  \u53440 \u46973 \u54620  \u53461 \u50500 \u46308 \u44620 \u51648  \u49373 \u54876 \u51012  \u44060 \u54785 \u54616 \u50688 \u45716 \u45936 , \u44536 \u46308  \u51473 \u51032  \u50612 \u46500  \u49324 \u46988 \u46308 \u51008  \u50668 \u47084  \u54644  \u46041 \u50504  \u44368 \u54924 \u50640  \u48156 \u51012  \u46308 \u50668 \u45459 \u51648  \u50506 \u45912  \u51088 \u46308 \u51060 \u50632 \u45796 . \u44033  \u44368 \u54028 \u50640 \u49436 \u45716  \u44592 \u46020 \u54924 \u47484  \u50676 \u46104 , \u44033  \u44275 \u50640 \u49436  \u44144 \u51032  \u47588  \u49884 \u44036  \u50676 \u50632 \u44256 , \u49324 \u50629 \u44032 \u46308 \u46020  \u51221 \u50724 \u50640 \u45716  \u44592 \u46020 \u54616 \u44256  \u52268 \u48120 \u54616 \u44592  \u50948 \u54616 \u50668  \u54632 \u44760  \u47784 \u50688 \u45796 . \u44536 \u47084 \u45208  \u49324 \u46988 \u46308 \u51008  \u44305 \u51201  (\u29378 \u30340 ) \u55141 \u48516 \u50640 \u49436 \u44032  \u50500 \u45768 \u44256 , \u47588 \u50864  \u50628 \u49689 \u54620  \u49373 \u44033 \u51004 \u47196  \u44536  \u51068 \u51012  \u54616 \u50688 \u45796 . \u44536 \u51032  \u54876 \u46041 \u51008  \u45800 \u51648  \u44048 \u51221 \u51201 \u51004 \u47196  \u55141 \u48516 \u51012  \u51068 \u51004 \u53412 \u44592 \u48372 \u45796 \u45716  \u52488 \u44592 \u51032  \u51333 \u44368  \u44060 \u54785 \u51088 \u46308 \u52376 \u47100  \u45257 \u51221 \u54620  \u51060 \u51648  (\u63972 \u26234 ) \u47196  \u54032 \u45800 \u52992  \u54616 \u44256  \u50577 \u49900 \u51012  \u44033 \u49457 \u49884 \u53412 \u45716  \u51068 \u51060 \u50632 \u45796 .\
1833\uc0\u45380 \u50640  \u48128 \u47084 \u45716  \u44536 \u44032  \u49549 \u54616 \u44256  \u51080 \u45912  \u52840 \u47168 \u44368 \u54924 \u47196 \u48512 \u53552  \u49444 \u44368 \u47484  \u54624  \u49688  \u51080 \u45716  \u51613 \u47749 \u49436 \u47484  \u48155 \u50520 \u45796 . \u44536  \u44368 \u54028 \u51032  \u47566 \u51008  \u47785 \u49324 \u46308 \u46020  \u44536 \u51032  \u49324 \u50629 \u51012  \u51064 \u51221 \u54616 \u50688 \u51004 \u48064 \u47196  \u44536 \u45716  \u51221 \u49885 \u51004 \u47196  \u51068 \u51012  \u44228 \u49549 \u54624  \u49688  \u51080 \u44172  \u46104 \u50632 \u45796 . \u48708 \u47197  \u44536 \u51032  \u49324 \u50629 \u51008  \u51452 \u47196  \u45684 \u51081 \u44544 \u47004 \u46300 \u50752  \u51473 \u48512  \u51648 \u48169 \u50640  \u44397 \u54620 \u46104 \u50612  \u51080 \u50632 \u51648 \u47560 \u45716  \u44536 \u45716  \u45130 \u51076 \u50630 \u51060  \u50668 \u54665 \u54616 \u44256  \u49444 \u44368 \u54616 \u50688 \u45796 . \u52376 \u51020  \u49688 \u45380  \u46041 \u50504  \u44536 \u45716  \u47784 \u46304  \u48708 \u50857 \u51012  \u51088 \u49888 \u51060  \u48512 \u45812 \u54616 \u50688 \u51004 \u47728 , \u44536  \u54980 \u50640 \u46020  \u44536 \u44032  \u52488 \u52397  \u48155 \u51008  \u51648 \u48169 \u44620 \u51648  \u44032 \u45716  \u45936  \u54596 \u50836 \u54620  \u47564 \u53372  \u52649 \u48516 \u54620  \u48708 \u50857 \u51012  \u48155 \u51008  \u51201 \u51060  \u50630 \u50632 \u45796 . \u44536 \u50752  \u44057 \u51060  \u44536 \u51032  \u44277 \u51473  \u51204 \u46020 \u45716  \u44552 \u51204 \u49345 \u51032  \u54812 \u53469 \u44284 \u45716  \u45320 \u47924 \u45208  \u44144 \u47532 \u44032  \u47680 \u50632 \u51004 \u48064 \u47196  \u54596 \u44221  \u44536 \u51032  \u51116 \u49328 \u50640  \u47924 \u44144 \u50868  \u48512 \u45812 \u51060  \u46104 \u50632 \u51004 \u47728 , \u44536  \u49324 \u50629 \u51012  \u54616 \u45716  \u46041 \u50504 \u50640  \u44536 \u51032  \u51116 \u49328 \u51008  \u52264 \u52784  \u51460 \u50612 \u51256  \u44052 \u45796 . \u44536 \u45716  \u45824 \u44032 \u51313 \u51032  \u44032 \u51109 \u51060 \u50632 \u45716 \u45936 , \u44536 \u51032  \u44032 \u51313 \u46308 \u51060  \u47784 \u46160  \u44160 \u49548 \u54616 \u44256  \u44540 \u47732 \u54616 \u50688 \u51004 \u48064 \u47196 , \u44536 \u51032  \u45453 \u53664 \u45716  \u44536 \u50752  \u44536 \u51032  \u44032 \u51313 \u51060  \u50416 \u44592 \u50640  \u51313 \u54620  \u49548 \u52636 \u51012  \u45236 \u51452 \u50632 \u45796 .\
