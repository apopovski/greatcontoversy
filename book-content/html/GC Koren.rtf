\'93\uc0\u44060 \u44397  \u51060 \u47000 \u47196  \u44536 \u46412 \u44620 \u51648  \u50630 \u45912  \u54872 \u45212 \'94\u51032  \u46412 \u44032  \u44263  \u50864 \u47532 \u50640 \u44172  \u45797 \u52432 \u50732  \u44163 \u51060 \u45796 . \u44536 \u47084 \u48064 \u47196  \u50864 \u47532 \u45716  \u54788 \u51116  \u44221 \u54744 \u54616 \u44256  \u51080 \u51648  \u47803 \u54620  \u44221 \u54744  \u51593  \u49324 \u46988 \u46308 \u51060  \u50619 \u44592 \u47484  \u45320 \u47924 \u46020  \u44172 \u51012 \u47532  \u54616 \u44256  \u51080 \u45716  \u54620  \u44032 \u51648  \u44221 \u54744 \u51012  \u50619 \u50612 \u50556  \u54624  \u54596 \u50836 \u44032  \u51080 \u45796 . \u50696 \u49345 \u54664 \u45912  \u44163 \u48372 \u45796  \u49892 \u51228 \u47196  \u45817 \u54616 \u45716  \u54872 \u45212 \u51060  \u44032 \u48316 \u50868  \u44163 \u51060  \u49345 \u47168 \u51060 \u51648 \u47564  \u50864 \u47532  \u50526 \u50640  \u51080 \u45716  \u50948 \u44592 \u45716  \u44536 \u47111 \u51648  \u50506 \u45796 . \u44032 \u51109  \u51088 \u49464 \u54616 \u44172  \u47896 \u49324 \u54616 \u50668 \u46020  \u44536  \u49884 \u47144 \u51032  \u53356 \u44592 \u47484  \u50668 \u49892 \u54616 \u44172  \u54364 \u54788 \u54624  \u49688  \u50630 \u45796 . \u44536  \u54872 \u45212 \u51032  \u46412 \u50640  \u44033  \u49324 \u46988 \u51008  \u51088 \u49888 \u51032  \u55192 \u51004 \u47196  \u54616 \u45208 \u45784  \u50526 \u50640  \u49436 \u50556  \u54620 \u45796 . \'93\u48708 \u47197  \u45432 \u50500 , \u45796 \u45768 \u50648 , \u50853 \u51060  \u44144 \u44592  \u51080 \u51012 \u51648 \u46972 \u46020  \u45208 \u51032  \u49334 \u51012  \u46160 \u44256  \u47609 \u49464 \u54616 \u45432 \u45768  \u44536 \u46308 \u51008  \u51088 \u45376 \u46020  \u44148 \u51648 \u51648  \u47803 \u54616 \u44256  \u51088 \u44592 \u51032  \u51032 \u47196  \u51088 \u44592 \u51032  \u49373 \u47749 \u47564  \u44148 \u51648 \u47532 \u46972 \'94 (\u44180  14:20).\
\uc0\u50864 \u47532 \u51032  \u45824 \u51228 \u49324 \u51109 \u44760 \u49436  \u50864 \u47532 \u47484  \u50948 \u54616 \u50668  \u49549 \u51396 \u54616 \u44256  \u44228 \u49884 \u45716  \u50724 \u45720 \u45216 , \u50864 \u47532 \u45716  \u44536 \u47532 \u49828 \u46020  \u50504 \u50640 \u49436  \u50756 \u51204 \u54616 \u50668 \u51648 \u44256 \u51088  \u45432 \u47141 \u54644 \u50556  \u54620 \u45796 . \u50864 \u47532  \u44396 \u51452 \u44760 \u49436 \u45716  \u48708 \u47197  \u49373 \u44033 \u51004 \u47196 \u46972 \u46020  \u50976 \u54841 \u51032  \u55192 \u50640  \u44404 \u48373 \u45817 \u54616 \u51648  \u50506 \u51004 \u49512 \u45796 . \u49324 \u45800 \u51008  \u49324 \u46988 \u51032  \u47560 \u51020  \u44032 \u50868 \u45936  \u44536 \u44032  \u48156 \u51012  \u48537 \u51068  \u50612 \u46500  \u44275 \u51060  \u51080 \u45716 \u51648  \u52286 \u45716 \u45796 . \u44536 \u47084 \u45912  \u51473  \u50612 \u46500  \u51396 \u46108  \u50837 \u47581 \u51012  \u54408 \u44172  \u46104 \u47732  \u44536 \u44163 \u51012  \u48156 \u54032 \u51004 \u47196  \u49340 \u50500  \u50976 \u54841 \u51032  \u55192 \u51012  \u48156 \u55064 \u54620 \u45796 . \u44536 \u47084 \u45208  \u50696 \u49688 \u45784 \u44760 \u49436 \u45716  \'93\u51060  \u49464 \u49345  \u51076 \u44552 \u51060  \u50724 \u44192 \u51020 \u51060 \u46972  \u44536 \u47084 \u45208  \u51200 \u45716  \u45236 \u44172  \u44288 \u44228 \u54624  \u44163 \u51060  \u50630 \u51004 \u45768 \'94 (\u50836  14:30) \u46972 \u44256  \u52828 \u55176  \u47568 \u50432 \u54616 \u49512 \u45796 . \u49324 \u45800 \u51008  \u54616 \u45208 \u45784 \u51032  \u50500 \u46308 \u50640 \u44172  \u49849 \u47532 \u47484  \u50619 \u51012  \u49688  \u51080 \u45716  \u44600 \u51012  \u51204 \u54784  \u48156 \u44204 \u54624  \u49688  \u50630 \u50632 \u45796 . \u50696 \u49688 \u45784 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u50500 \u48260 \u51648 \u51032  \u44228 \u47749 \u51012  \u51648 \u53412 \u49512 \u45796 . \u44536 \u47084 \u48064 \u47196  \u44536 \u48516 \u50640 \u44172 \u45716  \u49324 \u45800 \u51060  \u51060 \u50857 \u54624  \u49688  \u51080 \u45716  \u51396 \u44032  \u51204 \u54784  \u50630 \u50632 \u45796 . \u44536 \u44163 \u51008  \u54872 \u45212 \u51032  \u46412 \u50640  \u49436 \u44172  \u46112  \u49324 \u46988 \u46308 \u50640 \u44172  \u48152 \u46300 \u49884  \u45208 \u53440 \u45208 \u50556  \u54624  \u49345 \u53468 \u51060 \u45796 .\
\uc0\u50864 \u47532 \u45716  \u51060  \u46405 \u50640  \u49324 \u45716  \u46041 \u50504  \u44536 \u47532 \u49828 \u46020 \u51032  \u49549 \u51396 \u51032  \u54588 \u47484  \u48127 \u45716  \u48127 \u51020 \u51012  \u53685 \u54616 \u50668  \u51396 \u50752  \u48516 \u47532 \u46104 \u50612 \u50556  \u54620 \u45796 . \u50864 \u47532 \u51032  \u44480 \u54616 \u49888  \u44396 \u51452 \u44760 \u49436 \u45716  \u50864 \u47532  \u51088 \u49888 \u51012  \u45817 \u49888 \u44760  \u50672 \u54633 \u49884 \u53412 \u46020 \u47197  \u52488 \u52397 \u54616 \u49884 \u46104  \u50864 \u47532 \u51032  \u50672 \u50557 \u54632 \u51012  \u45817 \u49888 \u51032  \u45733 \u47141 \u50640 , \u50864 \u47532 \u51032  \u47924 \u51648 \u47484  \u45817 \u49888 \u51032  \u51648 \u54812 \u50640 , \u50864 \u47532 \u51032  \u47924 \u44032 \u52824 \u54632 \u51012  \u45817 \u49888 \u51032  \u44277 \u47196 \u50640  \u50672 \u54633 \u49884 \u53412 \u44592 \u47484  \u44036 \u52397 \u54616 \u49888 \u45796 . \u54616 \u45208 \u45784 \u51032  \u49453 \u47532 \u47196  \u50864 \u47532 \u50640 \u44172  \u51452 \u50612 \u51648 \u45716  \u44221 \u54744 \u46308 \u51008  \u50864 \u47532 \u44032  \u47560 \u46405 \u55176  \u48176 \u50892 \u50556  \u54624  \u50696 \u49688 \u45784 \u51032  \u50728 \u50976 \u50752  \u44216 \u49552 \u51012  \u44032 \u47476 \u52432  \u51452 \u45716  \u54617 \u44368 \u51060 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u50616 \u51228 \u45208  \u50864 \u47532  \u50526 \u50640  \u45908 \u50865  \u50504 \u51060 \u54616 \u44256  \u51600 \u44144 \u50892  \u48372 \u51060 \u45716  \u44600 , \u44263  \u50864 \u47532 \u44032  \u53469 \u54616 \u44592 \u47484  \u51339 \u50500 \u54624  \u44536 \u47088  \u44600 \u51060  \u50500 \u45768 \u46972  \u49373 \u50528 \u51032  \u51652 \u51221 \u54620  \u47785 \u51201 \u51060  \u46104 \u45716  \u44600 \u51012  \u51228 \u49884 \u54644  \u51452 \u49888 \u45796 . \u44536 \u47084 \u48064 \u47196  \u50864 \u47532 \u51032  \u54408 \u49457 \u51012  \u44536  \u44144 \u47337 \u54616 \u49888  \u47784 \u48376 \u51012  \u46384 \u46972  \u51060 \u47336 \u45716  \u49324 \u50629 \u50640  \u51080 \u50612 \u49436  \u54616 \u45208 \u45784 \u44760 \u49436  \u49324 \u50857 \u54616 \u49884 \u45716  \u45824 \u47532 \u51088 \u46308 \u44284  \u54801 \u47141 \u54616 \u45716  \u51068 \u51060  \u50864 \u47532 \u50640 \u44172  \u48512 \u44284 \u46104 \u50612  \u51080 \u45796 . \u51060  \u51068 \u51012  \u44172 \u51012 \u47532  \u54616 \u44144 \u45208  \u51648 \u50672 \u49884 \u53412 \u45716  \u51088 \u46308 \u51008  \u45572 \u44396 \u45208  \u44536 \u46308 \u51032  \u50689 \u54844 \u51012  \u44032 \u51109  \u47924 \u49436 \u50868  \u50948 \u54744 \u50640  \u48736 \u46888 \u47540  \u49688 \u48150 \u50640  \u50630 \u45796 .\
\uc0\u49324 \u46020  \u50836 \u54620 \u51008  \u44228 \u49884  \u51473 \u50640  \u54616 \u45720 \u50640 \u49436  \u53360  \u51020 \u49457 \u51004 \u47196  \'93\u54616 \u45720 \u44284  \u44536  \u44032 \u50868 \u45936  \u44144 \u54616 \u45716  \u51088 \u46308 \u51008  \u51600 \u44144 \u50892 \u54616 \u46972  \u44536 \u47084 \u45208  \u46405 \u44284  \u48148 \u45796 \u45716  \u54868  \u51080 \u51012 \u51652 \u51200  \u51060 \u45716  \u47560 \u44480 \u44032  \u51088 \u44592 \u51032  \u46412 \u44032  \u50620 \u47560  \u47803 \u46108  \u51460 \u51012  \u50508 \u48064 \u47196  \u53356 \u44172  \u48516  \u45236 \u50612  \u45320 \u55148 \u50640 \u44172  \u45236 \u47140 \u44052 \u51020 \u51060 \u46972 \'94 (\u44228  12:12) \u44256  \u48512 \u47476 \u51670 \u45716  \u49548 \u47532 \u47484  \u46308 \u50632 \u45796 . \u54616 \u45720 \u51032  \u51020 \u49457 \u51004 \u47196  \u51060 \u50752  \u44057 \u51060  \u53356 \u44172  \u48512 \u47476 \u51670 \u45716  \u51109 \u47732 \u51008  \u50620 \u47560 \u45208  \u46160 \u47140 \u50868 \u44032 . \u49324 \u45800 \u51032  \u48516 \u45432 \u45716  \u44536 \u51032  \u49884 \u44036 \u51060  \u45800 \u52629 \u46104 \u50612  \u44048 \u50640  \u46384 \u46972  \u44201 \u47148 \u54644 \u51652 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u51032  \u44592 \u47564 \u44284  \u54028 \u44340  \u54665 \u50948 \u45716  \u54872 \u45212 \u51032  \u46412 \u50640  \u44536  \u51208 \u51221 \u50640  \u51060 \u47484  \u44163 \u51060 \u45796 .\
