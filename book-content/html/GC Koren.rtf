\uc0\u44536 \u50752  \u50976 \u49324 \u54620  \u49892 \u47168 \u46308 \u51060  \u49457 \u44221 \u50640  \u44592 \u47197 \u46104 \u50612  \u51080 \u45796 . \u50696 \u49688 \u45784 \u51008  \u49688 \u47196 \u48372 \u45768 \u44172  \u51313 \u49549 \u51032  \u54620  \u50668 \u51064 \u51032  \u46392 \u51060  \u45908 \u47084 \u50868  \u44480 \u49888 \u51060  \u46308 \u47140  \u44256 \u49373 \u54616 \u45716  \u44163 \u51012  \u48372 \u49884 \u44256  \u45817 \u49888 \u51032  \u47568 \u50432 \u51004 \u47196  \u44536  \u44480 \u49888 \u51012  \u51923 \u50500 \u45236 \u49512 \u45796  (\u47561  7:26~30 \u52280 \u51312 ). \'93\u44480 \u49888 \u46308 \u47140  \u45576 \u47680 \u44256  \u48281 \u50612 \u47532 \u46108  \u51088 \'94 (\u47560  12:22), \'93\u44480 \u49888 \u51060  \u51200 \u47484  \u51453 \u51060 \u47140 \u44256  \u48520 \u44284  \u47932 \u50640  \u51088 \u51452  \u45912 \'94 (\u47561  9:22) \u51652  \u51088 , \u50504 \u49885 \u51068 \u50640  \u44032 \u48260 \u45208 \u50880  \u54924 \u45817 \u51012  \u49548 \u46976 \u52992  \u54616 \u45912  \'93\u45908 \u47084 \u50868  \u44480 \u49888 \u46308 \u47536  \u49324 \u46988 \'94 (\u45573  4:33), \u44536  \u47784 \u46304  \u49324 \u46988 \u46308 \u51012  \u51064 \u51088 \u54616 \u49888  \u51452 \u45784 \u44760 \u49436  \u44256 \u52432  \u51452 \u49512 \u45796 . \u50696 \u49688 \u44760 \u49436 \u45716  \u44144 \u51032  \u50616 \u51228 \u46304 \u51648  \u47560 \u52824  \u49324 \u46988 \u50640 \u44172  \u47568 \u50432 \u54616 \u49884 \u46319 \u51060  \u44480 \u49888 \u51012  \u54693 \u54616 \u50668  \u44536 \u50640 \u44172 \u49436  \u45208 \u50724 \u44256  \u45796 \u49884  \u44536 \u47484  \u44340 \u47213 \u44172  \u54616 \u51648  \u47568 \u46972 \u44256  \u47749 \u47161 \u54616 \u49512 \u45796 . \u44536  \u46412  \u44032 \u48260 \u45208 \u50880  \u49324 \u46988 \u46308 \u51008  \u44536 \u51032  \u50948 \u45824 \u54620  \u45733 \u47141 \u51012  \u47785 \u44201 \u54616 \u44256  \u45796  \u45440 \u46972  \'93\u51060  \u50612 \u4649