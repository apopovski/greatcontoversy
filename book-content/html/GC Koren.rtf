\uc0\u51652 \u47532 \u47484  \u48120 \u50892 \u54616 \u44256  \u48152 \u45824 \u54616 \u45716  \u46041 \u51068 \u54620  \u51221 \u49888 \u51060  \u44033  \u49884 \u45824 \u47484  \u53685 \u54616 \u50668  \u54616 \u45208 \u45784 \u51032  \u50896 \u49688 \u46308 \u51012  \u52649 \u46041 \u49884 \u53020  \u50772 \u45796 . \u44536 \u47532 \u44256  \u54616 \u45208 \u45784 \u51032  \u51333 \u46308 \u50640 \u44172 \u45716  \u44221 \u44228 \u50752  \u52649 \u49457 \u51060  \u50836 \u44396 \u46104 \u50612  \u50772 \u45796 . \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u52572 \u52488 \u51032  \u51228 \u51088 \u46308 \u50640 \u44172  \u54616 \u49888  \u47568 \u50432 \u51008  \u47568 \u49464 \u50640  \u49324 \u45716  \u44536 \u48516 \u51032  \u51228 \u51088 \u46308 \u50640 \u44172 \u46020  \u51201 \u50857 \u46104 \u45716  \u47568 \u50432 \u51060 \u45796 . \u44536 \u48516 \u44760 \u49436 \u45716  \'93\u44648 \u50612  \u51080 \u51004 \u46972  \u45236 \u44032  \u45320 \u55148 \u50640 \u44172  \u54616 \u45716  \u51060  \u47568 \u51060  \u47784 \u46304  \u49324 \u46988 \u50640 \u44172  \u54616 \u45716  \u47568 \u51060 \u45768 \u46972 \'94 (\u47561  13:37) \u44256  \u47568 \u50432 \u54616 \u49888 \u45796 .\
\uc0\u50516 \u55121 \u51008  \u51216 \u51216  \u45908  \u51673 \u50612 \u51648 \u45716  \u46319 \u51060  \u48372 \u50688 \u45796 . \u50864 \u49345  \u49709 \u48176 \u45716  \u45908 \u50865 \u45908  \u48372 \u54200 \u54868 \u46104 \u50632 \u45796 . \u50864 \u49345  \u50526 \u50640 \u49436  \u52507 \u48520 \u51012  \u53020 \u44256  \u44592 \u46020 \u47484  \u50732 \u47160 \u45796 . \u44032 \u51109  \u48520 \u54633 \u47532 \u54616 \u44256  \u48120 \u49888 \u51201 \u51064  \u54413 \u49845 \u46308 \u51060  \u45328 \u47532  \u48372 \u44553 \u46104 \u50632 \u45796 . \u49324 \u46988 \u46308 \u51032  \u51221 \u49888 \u51008  \u50756 \u51204 \u55176  \u48120 \u49888 \u50640  \u49324 \u47196 \u51105 \u54784 \u49436  \u51060 \u49457  (\u63972 \u24615 ) \u51008  \u44536  \u44592 \u45733 \u51012  \u51075 \u51008  \u46319 \u54616 \u50688 \u45796 . \u49888 \u48512 \u50752  \u51452 \u44368  \u51088 \u49888 \u46308 \u51060  \u54693 \u46973 \u51012  \u51600 \u44592 \u44256 , \u50977 \u50837 \u51201 \u51060 \u47728  \u53440 \u46973 \u50640  \u48736 \u51256  \u51080 \u50632 \u51004 \u48064 \u47196  \u44536 \u46308 \u51012  \u51648 \u46020 \u51088 \u47196  \u50864 \u47084 \u47084 \u48372 \u45716  \u49324 \u46988 \u46308 \u51060  \u47924 \u51648 \u50752  \u50501 \u45909 \u50640  \u48736 \u51648 \u51648  \u50506 \u51004 \u47532 \u46972 \u44256  \u44592 \u45824 \u54624  \u49688  \u51080 \u44192 \u45716 \u44032 ?\
\uc0\u48277 \u50773 \u51032  \u52280 \u46988 \u46108  \u54665 \u50948 \u45716  \u54620  \u44152 \u51020  \u45908  \u45208 \u50500 \u44052 \u45796 . 11\u49464 \u44592 \u50640  \u48277 \u50773  \u44536 \u47112 \u44256 \u47532 \u50864 \u49828  7\u49464  (Gregory \u8550 ) \u45716  \u47196 \u47560 \u44368 \u54924 \u44032  \u50756 \u51204 \u54616 \u45796 \u44256  \u49440 \u54252 \u54616 \u50688 \u45796 . \u44536 \u51032  \u51452 \u51109  \u51473 \u51032  \u54616 \u45208 \u45716  \u49457 \u44221 \u50640  \u51032 \u54616 \u47732  \u44368 \u54924 \u45716  \u54620  \u48264 \u46020  \u44536 \u47495 \u46108  \u51068 \u51012  \u54620  \u51201 \u51060  \u50630 \u44256 , \u46608  \u51109 \u47000 \u50640 \u46020  \u51096 \u47803 \u46112  \u49688  \u50630 \u45796 \u45716  \u44163 \u51060 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44536 \u51032  \u51452 \u51109 \u51012  \u51648 \u51648 \u54644  \u51452 \u45716  \u49457 \u44221 \u49345  \u51613 \u44144 \u45716  \u51228 \u49884 \u46104 \u51648  \u50506 \u50520 \u45796 . \u44144 \u47564 \u54620  \u48277 \u50773 \u51008  \u46608 \u54620  \u54889 \u51228 \u46308 \u51012  \u54224 \u50948 \u49884 \u53420  \u44428 \u49464 \u44032  \u51088 \u44592 \u50640 \u44172  \u51080 \u45432 \u46972 \u44256  \u51452 \u51109 \u54616 \u44256 , \u51088 \u44592 \u44032  \u49440 \u54252 \u54620  \u49440 \u44256 \u45716  \u50500 \u47924 \u46020  \u51060 \u47484  \u54224 \u44592  (\u24290 \u26820 ) \u54624  \u49688  \u50630 \u51648 \u47564  \u51088 \u44592 \u50640 \u44172 \u45716  \u45796 \u47480  \u47784 \u46304  \u49324 \u46988 \u46308 \u51032  \u44208 \u51221 \u51012  \u48320 \u44221 \u49884 \u53420  \u49688  \u51080 \u45716  \u44428 \u54620 \u51060  \u51080 \u45796 \u44256  \u51452 \u51109 \u54616 \u50688 \u45796  (\u48512 \u47197  7 \u52280 \u51312 ).\
\uc0\u51208 \u45824  \u47924 \u47448  (\u32118 \u23565 \u28961 \u35628 ) \u47484  \u51452 \u51109 \u54616 \u45716  \u48277 \u50773 \u51032  \u54252 \u50501 \u54620  \u53945 \u49457 \u51012  \u48372 \u50668 \u51456  \u54788 \u51200 \u54620  \u49892 \u47168 \u45716  \u46021 \u51068  \u54889 \u51228  \u54616 \u51064 \u47532 \u55176  4\u49464  (Heinrich \u8547 ) \u50640 \u44172  \u54665 \u54620  \u51312 \u52824 \u50688 \u45796 . \u54616 \u51064 \u47532 \u55176 \u45716  \u48277 \u50773 \u51032  \u44428 \u50948 \u47484  \u44048 \u55176  \u47924 \u49884 \u54616 \u50688 \u44592  \u46412 \u47928 \u50640  \u54028 \u47928  (\u30772 \u38272 ) \u51012  \u45817 \u54616 \u50688 \u51012  \u49104 \u47564  \u50500 \u45768 \u46972  \u54224 \u50948 \u51032  \u49440 \u44256 \u44620 \u51648  \u48155 \u50520 \u45796 . \u54616 \u51064 \u47532 \u55176  4\u49464 \u45716  \u48277 \u50773 \u51032  \u47749 \u47161 \u50640  \u51032 \u54616 \u50668  \u51088 \u44592 \u47484  \u48176 \u48152 \u54616 \u46020 \u47197  \u52489 \u44396  \u48155 \u51008  \u51088 \u44592 \u51032  \u51228 \u54980  (\u35576 \u20399 ) \u46308 \u51032  \u48176 \u52377 \u44284  \u54801 \u48149 \u50640  \u46160 \u47140 \u50880 \u51012  \u45712 \u45180 \u44256  \u48277 \u50773 \u44284  \u54868 \u54644 \u54644 \u50556  \u54624  \u54596 \u50836 \u47484  \u44648 \u45803 \u44172  \u46104 \u50632 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u45716  \u48277 \u50773  \u50526 \u50640  \u45208 \u50500 \u44032  \u50857 \u49436 \u47484  \u44396 \u54616 \u44256 \u51088  \u54889 \u54980 \u50752  \u52649 \u49892 \u54620  \u54620  \u49884 \u51333 \u51012  \u45936 \u47532 \u44256  \u54620 \u44200 \u50872 \u50640  \u54744 \u54620  \u50508 \u54532 \u49828  \u49328 \u51012  \u45336 \u50612 \u44052 \u45796 . \u44536 \u47532 \u54616 \u50668  \u45817 \u49884  \u44536 \u47112 \u44256 \u47532 \u50864 \u49828  \u48277 \u50773 \u51060  \u50976 \u54616 \u44256  \u51080 \u45716  \u49457 \u50640  \u46020 \u52265 \u54616 \u51088  \u54840 \u50948 \u48337  \u54616 \u45208  \u50630 \u51060  \u44417 \u51204 \u51032  \u50808 \u50896  (\u22806 \u33489 ) \u50640  \u51060 \u45132 \u47140  \u45208 \u44032 , \u47672 \u47532 \u50640 \u45716  \u50500 \u47924 \u44163 \u46020  \u50416 \u51648  \u47803 \u54616 \u44256  \u47800 \u50640 \u45716  \u48320 \u48320 \u52824  \u47803 \u54620  \u50743 \u51012  \u51077 \u51008  \u52292  \u47592 \u48156 \u47196  \u52628 \u50948 \u50640  \u46504 \u47732 \u49436  \u48277 \u50773 \u51032  \u47732 \u54924 \u44032  \u54728 \u46973 \u46104 \u44592 \u47484  \u44592 \u45796 \u47532 \u44256  \u51080 \u50632 \u45796 . 3\u51068  \u46041 \u50504 \u51032  \u44552 \u49885 \u44284  \u51088 \u48373 \u51060  \u51080 \u51008  \u54980 \u50640 \u50556  \u48277 \u50773 \u51008  \u44536 \u47484  \u49324 \u47732 \u54616 \u50688 \u45796 . \u44536 \u44163 \u46020  \u50773 \u44428 \u51012  \u45208 \u53440 \u45236 \u45716  \u55064 \u51109  (\u24509 \u31456 ) \u51012  \u45804 \u44144 \u45208  \u50773 \u51032  \u44428 \u47532 \u47484  \u54665 \u49324 \u54616 \u44172  \u46112  \u46412 \u50640 \u45716  \u47676 \u51200  \u48277 \u50773 \u51032  \u50980 \u54728  (\u20801 \u35377 ) \u47484  \u48155 \u50500 \u50556  \u54620 \u45796 \u45716  \u51312 \u44148 \u51060  \u48537 \u50612  \u51080 \u50632 \u45796 . \u51060 \u50640  \u44536 \u47112 \u44256 \u47532 \u50864 \u49828 \u45716  \u51032 \u44592 \u50577 \u50577 \u54616 \u50668  \u44400 \u51452 \u46308 \u51032  \u44368 \u47564 \u51012  \u44734 \u50612  \u51452 \u45716  \u44163 \u51060  \u51088 \u44592 \u51032  \u51032 \u47924 \u46972 \u44256  \u51088 \u46993 \u54616 \u50688 \u45796 .\
\uc0\u51060 \u52376 \u47100  \u50724 \u47564  \u48520 \u49552 \u54620  \u48277 \u50773 \u51032  \u53468 \u46020 \u47484  \u47560 \u51020  \u47928  \u48150 \u50640  \u49436 \u49436  \u47928 \u51012  \u50676 \u50612  \u51452 \u44592 \u47484  \u44592 \u45796 \u47532 \u44256  \u44228 \u49884 \u45716  \u44536 \u47532 \u49828 \u46020 , \u51228 \u51088 \u46308 \u50640 \u44172  \'93\u51004 \u46904 \u51060  \u46104 \u44256 \u51088  \u54616 \u45716  \u51088 \u45716  \u45320 \u55148  \u51333 \u51060  \u46104 \u50612 \u50556  \u54616 \u47532 \u46972 \'94 (\u47560  20:27) \u44256  \u44032 \u47476 \u52824 \u49888  \u44536 \u47532 \u49828 \u46020 \u51032  \u50728 \u50976 \u54616 \u44256  \u44216 \u49552 \u54616 \u49888  \u53468 \u46020 \u50752  \u48708 \u44368 \u54644  \u48372 \u47732  \u50620 \u47560 \u45208  \u45824 \u51312 \u51201 \u51064 \u44032 !\
\uc0\u49464 \u44592 \u44032  \u51648 \u45208 \u44040 \u49688 \u47197  \u44536 \u47495 \u46108  \u44368 \u47532 \u44032  \u47196 \u47560 \u47196 \u48512 \u53552  \u45130 \u51076 \u50630 \u51060  \u45208 \u50772 \u45796 . \u48277 \u50773 \u44428 \u51060  \u54869 \u47549 \u46104 \u44592  \u51204 \u50640  \u51060 \u48120  \u51060 \u44368 \u51032  \u52384 \u54617 \u51088 \u46308 \u51032  \u44032 \u47476 \u52840 \u51060  \u51452 \u47785 \u51012  \u48155 \u50520 \u51004 \u47728 , \u44368 \u54924  \u45236 \u50640  \u50689 \u54693 \u51012  \u48120 \u52432 \u50772 \u45796 . \u44060 \u51333 \u54664 \u45432 \u46972 \u44256  \u51088 \u52845 \u54616 \u45716  \u49324 \u46988 \u46308  \u51473 \u50640 \u45716  \u44536 \u46308 \u51032  \u51060 \u44368 \u51201  \u52384 \u54617 \u49444 \u51012  \u51452 \u51109 \u54616 \u47728  \u49828 \u49828 \u47196  \u44536 \u44163 \u51012  \u44228 \u49549  \u50672 \u44396 \u54624  \u49104 \u47564  \u50500 \u45768 \u46972  \u51060 \u44368 \u46020 \u46308 \u44284  \u51217 \u52489 \u54616 \u45716  \u49688 \u45800 \u51060  \u46108 \u45796 \u45716  \u44396 \u49892 \u47196  \u45796 \u47480  \u49324 \u46988 \u46308 \u50640 \u44172 \u44620 \u51648  \u44536 \u44163 \u51012  \u44053 \u50836 \u54616 \u45716  \u51088 \u44032  \u51080 \u50632 \u45796 . \u51060 \u47532 \u54616 \u50668  \u49900 \u44033 \u54620  \u50724 \u47448 \u44032  \u44536 \u47532 \u49828 \u46020 \u44368  \u49888 \u50521  \u50504 \u51004 \u47196  \u46308 \u50612 \u50772 \u45796 . \u49324 \u46988 \u51008  \u48376 \u47000  \u48520 \u49324  \u48520 \u47736  (\u63847 \u27515 \u63847 \u28357 ) \u51032  \u48376 \u49457 \u51012  \u44032 \u51276 \u51004 \u48064 \u47196  \u51453 \u51008  \u54980 \u50640 \u46020  \u51032 \u49885  (\u24847 \u35672 ) \u51060  \u51080 \u45796 \u45716  \u49444 \u51008  \u44536 \u50752  \u44057 \u51008  \u50724 \u47448  \u44032 \u50868 \u45936  \u45824 \u54364 \u51201 \u51064  \u44163 \u51060 \u45796 . \u47196 \u47560 \u44368 \u54924 \u44032  \u54869 \u47549 \u54620  \u49457 \u46020 \u51032  \u51473 \u48372 , \u46041 \u51221 \u45376  \u47560 \u47532 \u50500  \u49709 \u48176  \u44057 \u51008  \u44163 \u51060  \u45796  \u51060 \u47084 \u54620  \u44368 \u47532 \u47484  \u44592 \u52488 \u47196  \u49373 \u44220 \u45796 . \u46608 \u54620  \u51068 \u52237 \u48512 \u53552  \u48277 \u50773 \u44368  \u49888 \u50521 \u50640  \u53685 \u54633 \u46108  \u44368 \u47532 \u47196 \u49436  \u45149 \u45149 \u45236  \u48127 \u51648  \u50506 \u45716  \u51088 \u45716  \u50689 \u50896 \u53664 \u47197  \u44256 \u53685 \u51012  \u45817 \u54624  \u44163 \u51060 \u46976  \u51060 \u45800 \u49444 \u46020  \u50669 \u49884  \u51060 \u50752  \u44057 \u51008  \u44368 \u47532 \u50640 \u49436  \u45208 \u50728  \u44163 \u51060 \u45796 .\
\pard\pardeftab720\sa319\partightenfactor0

\f0\b \cf0 \uc0\u51060 \u44368 \u51201  \u48120 \u49888 \u51060  \u44368 \u54924 \u50640  \u46308 \u50612 \u50740 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u44536 \u47532 \u54616 \u50668  \u51060 \u44368 \u50640 \u49436  \u44984 \u47728 \u45240  \u46608  \u45796 \u47480  \u51060 \u45800 \u49444 \u51060  \u46308 \u50612 \u50732  \u44600 \u51060  \u51456 \u48708 \u46104 \u50632 \u45796 . \u47196 \u47560 \u45716  \u44536 \u44163 \u51012  \u50672 \u50725 \u51004 \u47196  \u47749 \u47749 \u54616 \u50688 \u51004 \u47728 , \u49789 \u49324 \u47532  \u48127 \u45716  \u48120 \u49888 \u51201 \u51064  \u47566 \u51008  \u49324 \u46988 \u46308 \u51012  \u46160 \u47157 \u44172  \u54616 \u44592  \u50948 \u54616 \u50668  \u44536 \u44163 \u51012  \u49324 \u50857 \u54616 \u50688 \u45796 . \u51060  \u51060 \u45800 \u49444 \u47196  \u47568 \u48120 \u50516 \u50500  \u50689 \u50896 \u54620  \u54805 \u48268 \u51012  \u48155 \u51012  \u51221 \u46020 \u44620 \u51648  \u51060 \u47476 \u51648  \u50500 \u45768 \u54620  \u50689 \u54844 \u51060  \u44536  \u48276 \u54620  \u51396 \u50640  \u45824 \u54616 \u50668  \u54805 \u48268 \u51012  \u48155 \u50500 \u50556  \u54624  \u44275 , \u44536 \u47532 \u44256  \u44144 \u44592 \u49436  \u47784 \u46304  \u48512 \u51221 \u54620  \u44163 \u51060  \u50491 \u44200 \u51276 \u51012  \u46412  \u52380 \u44397 \u50640  \u46308 \u50612 \u44032 \u45716  \u44163 \u51060  \u54728 \u50857 \u46112  \u44256 \u53685 \u51032  \u51109 \u49548 \u44032  \u51080 \u45796 \u45716  \u44163 \u51060  \u44557 \u51221 \u46104 \u50632 \u45796  (\u48512 \u47197  8 \u52280 \u51312 ).\
\uc0\u44536  \u49888 \u51088 \u46308 \u51032  \u44277 \u54252 \u49900 \u44284  \u50501 \u54665 \u51012  \u51060 \u50857 \u54616 \u50668  \u51060 \u51061 \u51012  \u50619 \u44172  \u54616 \u45716  \u44163 \u51012  \u47196 \u47560 \u47196  \u44032 \u45733 \u52992  \u54616 \u44592  \u50948 \u54616 \u50668  \u46608  \u45796 \u47480  \u45216 \u51312 \u44032  \u54596 \u50836 \u46104 \u50632 \u45796 . \u44536 \u44163 \u51008  \u44263  \u47732 \u51396  (\u20813 \u32618 ) \u50640  \u44288 \u54620  \u44368 \u47532 \u50688 \u45796 . \u48277 \u50773 \u44400  (\u27861 \u29579 \u36557 ) \u50640  \u49549 \u54616 \u50668  \u44536  \u50689 \u53664 \u47484  \u45331 \u55176 \u44256 , \u44368 \u54924 \u51032  \u51201  (\u36969 ) \u51012  \u51669 \u48268 \u54616 \u44256 , \u48277 \u50773 \u51032  \u50689 \u51201  \u52572 \u49345 \u44428 \u51012  \u48512 \u51064 \u54616 \u45716  \u51088 \u46308 \u51012  \u48149 \u47736 \u54616 \u45716  \u51088 \u45716  \u44284 \u44144 , \u54788 \u51116 , \u48120 \u47000 \u51032  \u47784 \u46304  \u51396 \u51032  \u49324 \u50976 \u47484  \u48155 \u44256 , \u47560 \u46405 \u55176  \u48155 \u50500 \u50556  \u54624  \u44256 \u53685 \u44284  \u54805 \u48268 \u50640 \u49436  \u47732 \u51396 \u46108 \u45796 \u44256  \u50557 \u49549 \u46104 \u50632 \u45796 . \u44536 \u47532 \u44256  \u44368 \u54924 \u50640  \u46024 \u51012  \u45236 \u47732  \u51396 \u50640 \u49436  \u54644 \u48169 \u46104 \u44256 , \u46608 \u54620  \u51088 \u44592  \u51088 \u49888 \u49104 \u47564  \u50500 \u45768 \u46972  \u54788 \u51116  \u51453 \u50612 \u49436  \u50672 \u50725 \u51032  \u48520 \u50640  \u48736 \u51256  \u51080 \u45716  \u49324 \u48324 \u54620  \u50689 \u54844 \u44620 \u51648 \u46020  \u44396 \u50896 \u54624  \u49688  \u51080 \u45796 \u44256  \u44032 \u47476 \u52452 \u45796 . \u51060 \u47084 \u54620  \u49688 \u45800 \u51004 \u47196  \u47196 \u47560 \u44368 \u45716  \u44552 \u44256 \u47484  \u52292 \u50864 \u44172  \u46104 \u50632 \u44256 , \u47672 \u47532  \u46168  \u44275 \u46020  \u50630 \u45796 \u44256  \u54616 \u49888  \u51060 \u47484  \u45824 \u54364 \u54620 \u45796 \u45716  \u51088 \u51032  \u54840 \u49324  (\u35946 \u22882 ) \u50752  \u50501 \u54665 \u51012  \u51648 \u53489 \u54644  \u51452 \u50632 \u45796  (\u48512 \u47197  9 \u52280 \u51312 ).\
\uc0\u49457 \u44221 \u49345  \u51032 \u49885  (\u20736 \u24335 ) \u51064  \u51452 \u51032  \u47564 \u52268 \u46020  \u48120 \u49324 \u46972 \u45716  \u50864 \u49345  \u49709 \u48176 \u51201  \u51228 \u46020 \u47196  \u45824 \u52824 \u46104 \u50632 \u45796 . \u47196 \u47560 \u44368 \u51032  \u49324 \u51228 \u46308 \u51008  \u44536 \u46308 \u51032  \u47924 \u51032 \u48120 \u54620  \u50556 \u45800 \u49828 \u47088  \u51032 \u49885 \u51012  \u53685 \u54616 \u50668  \u45800 \u49692 \u54620  \u46497 \u44284  \u54252 \u46020 \u51452 \u44032  \u51221 \u47568 \u47196  \'93\u44536 \u47532 \u49828 \u46020 \u51032  \u49332 \u44284  \u54588 \'94 (Cardinal Wiseman, The Real Presence of the Body and Blood of Our Lord Jesus Christ in the Blessed Eucharist Proved From Scripture, Lecture 8, sec.3, par.26) \u47196  \u48148 \u45068 \u45716  \u44163 \u52376 \u47100  \u47568 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u44536 \u50752  \u44057 \u51060  \u54616 \u45208 \u45784 \u51012  \u47784 \u46021  (\u20882 \u28678 ) \u54616 \u45716  \u52280 \u46988 \u46108  \u50616 \u54665 \u51004 \u47196  \u44536 \u46308 \u51060  \u47564 \u47932 \u51032  \u52285 \u51312 \u51088 \u51060 \u49888  \u54616 \u45208 \u45784 \u51012  \u52285 \u51312 \u54624  \u44428 \u45733 \u51060  \u51080 \u51020 \u51012  \u44277 \u44277 \u50672 \u54616 \u44172  \u51452 \u51109 \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u47532 \u49828 \u46020 \u51064 \u46308 \u51008  \u51453 \u51020 \u51032  \u50948 \u54801  \u50500 \u47000 \u49436  \u54616 \u45720 \u51012  \u47784 \u46021 \u54616 \u45716  \u45140 \u52237 \u54620  \u51060 \u45800 \u51012  \u48127 \u45432 \u46972 \u44256  \u44256 \u48177 \u54616 \u46020 \u47197  \u50836 \u44396 \u48155 \u50520 \u45796 . \u51060 \u47484  \u44144 \u48512 \u54620  \u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u54868 \u54805 \u51012  \u48155 \u50520 \u45796  (\u48512 \u47197  10 \u52280 \u51312 ).\
13\uc0\u49464 \u44592 \u50640  \u48277 \u50773 \u51032  \u47784 \u46304  \u46020 \u44396  \u51473 \u50640 \u49436  \u44032 \u51109  \u47924 \u49436 \u50868  \u51228 \u46020  \u51593  \u51333 \u44368  \u51116 \u54032 \u49548 \u44032  \u49444 \u47549 \u46104 \u50632 \u45796 . \u55121 \u50516 \u51032  \u50773 \u51060  \u48277 \u50773 \u44368 \u51032  \u51648 \u46020 \u51088 \u46308 \u44284  \u54632 \u44760  \u51068 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51032  \u48708 \u48128 \u54924 \u51032 \u50640 \u49436  \u49324 \u45800 \u44284  \u44536 \u51032  \u48512 \u54616 \u46308 \u51008  \u50501 \u51064 \u46308 \u51032  \u47560 \u51020 \u51012  \u51648 \u48176 \u54616 \u50688 \u45796 . \u44536 \u50752  \u46041 \u49884 \u50640  \u45576 \u50640  \u48372 \u51060 \u51648  \u50506 \u45716  \u54616 \u45208 \u45784 \u51032  \u52380 \u49324 \u46308 \u51060  \u44536 \u46308  \u44032 \u50868 \u45936  \u49436 \u49436  \u44536 \u46308 \u51032  \u51396 \u50501 \u51201 \u51064  \u47749 \u47161 \u51032  \u45440 \u46972 \u50868  \u44163 \u46308 \u51012  \u44592 \u47197 \u54616 \u44256  \u49324 \u46988 \u51032  \u45576 \u51004 \u47196  \u52264 \u47560  \u48380  \u49688  \u50630 \u45716  \u47924 \u49436 \u50868  \u54665 \u50948 \u50640  \u45824 \u54620  \u50669 \u49324 \u47484  \u44592 \u47197 \u54616 \u50688 \u45796 . \'93\u53360  \u49457  \u48148 \u48296 \u47200 \'94\u51008  \'93\u49457 \u46020 \u46308 \u51032  \u54588 \u50640  \u52712 \'94\u54616 \u50688 \u45796 . \u50668 \u47084  \u53664 \u47561 \u51004 \u47196  \u51096 \u47532 \u50892 \u51652  \u49688 \u48177 \u47564 \u51032  \u49692 \u44368 \u51088 \u46308 \u51008  \u44536  \u48176 \u44368 \u51201  \u49464 \u47141 \u50640  \u45824 \u54616 \u50668  \u49888 \u50896  (\u20280 \u23491 ) \u54616 \u50668  \u51452 \u49884 \u44592 \u47484  \u54616 \u45208 \u45784 \u44760  \u48512 \u47476 \u51670 \u50632 \u45796 .\
\uc0\u48277 \u50773 \u51008  \u51204 \u49464 \u44228 \u51032  \u46021 \u51116  \u44400 \u51452 \u44032  \u46104 \u50632 \u45796 . \u50773 \u46308 \u44284  \u54889 \u51228 \u46308 \u51008  \u47196 \u47560  \u48277 \u50773 \u51032  \u47749 \u47161 \u50640  \u48373 \u51333 \u54616 \u50688 \u45796 . \u51064 \u47448 \u51032  \u50868 \u47749 \u51008  \u54788 \u49464 \u50752  \u45236 \u49464 \u47484  \u47561 \u47200 \u54616 \u44256  \u47784 \u46160  \u44536 \u51032  \u44288 \u47532  \u50500 \u47000  \u51080 \u45716  \u44163 \u52376 \u47100  \u48372 \u50688 \u45796 . \u49688 \u48177  \u45380  \u46041 \u50504  \u47196 \u47560 \u44368 \u51032  \u44368 \u47532 \u46308 \u51008  \u44305 \u48276 \u50948 \u54616 \u44172  \u44536 \u47532 \u44256  \u51208 \u45824 \u51201 \u51064  \u44163 \u51004 \u47196  \u45328 \u47532  \u51064 \u51221 \u46104 \u44256 , \u44536  \u51032 \u49885 \u46308 \u51008  \u50628 \u49689 \u55176  \u44144 \u54665 \u46104 \u44256 , \u44536  \u52629 \u51228 \u51068 \u46308 \u51008  \u45328 \u47532  \u51456 \u49688 \u46104 \u50632 \u45796 . \u49849 \u47140 \u46308 \u46020  \u51316 \u44221 \u51012  \u48155 \u44256 , \u54413 \u51313 \u54616 \u44172  \u49332 \u44172  \u46104 \u50632 \u45796 . \u50500 \u47560  \u51060  \u46412 \u52376 \u47100  \u47196 \u47560 \u44368 \u44032  \u50948 \u50628 \u44284  \u49464 \u47141 \u51012  \u54200  \u49884 \u45824 \u45716  \u50630 \u50632 \u51012  \u44163 \u51060 \u45796 .\
\uc0\u44536 \u47084 \u45208  \'93\u48277 \u50773 \u44368 \u51032  \u45824 \u45230 \u51008  \u48148 \u47196  \u49464 \u49345 \u51032  \u54620 \u48164 \u51473 \u51060 \u50632 \u45796 \'94 (J.A.Wylie, The History of Protestan-tism, b.I, ch.4). \u49457 \u44221 \u51008  \u51068 \u48152  \u49324 \u46988 \u46308 \u50640 \u44172  \u49104 \u47564  \u50500 \u45768 \u46972  \u49888 \u48512 \u46308 \u50640 \u44172 \u44620 \u51648 \u46020  \u44144 \u51032  \u50508 \u47140 \u51648 \u51648  \u47803 \u54616 \u50688 \u45796 . \u50715 \u45216 \u51032  \u48148 \u47532 \u49352 \u51064 \u46308 \u52376 \u47100  \u47196 \u47560 \u44368 \u51032  \u51648 \u46020 \u51088 \u46308 \u51008  \u44536 \u46308 \u51032  \u51396 \u50501 \u51012  \u54253 \u47196 \u49884 \u53020  \u51460  \u48731 \u51012  \u49899 \u50612 \u54616 \u50688 \u45796 . \u51032 \u51032  \u54364 \u51456 \u51064  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51060  \u51228 \u44144 \u46104 \u51088  \u44536 \u46308 \u51008  \u44428 \u49464 \u47484  \u54620 \u47049 \u50630 \u51060  \u48512 \u47532 \u44256 , \u50728 \u45817 \u52824  \u50506 \u51008  \u54665 \u46041 \u51012  \u44144 \u52840 \u50630 \u51060  \u54616 \u50688 \u45796 . \u49324 \u44592 , \u53456 \u50837 , \u48169 \u53461 \u51060  \u49464 \u49345 \u50640  \u46160 \u47336  \u54140 \u51276 \u45796 . \u49324 \u46988 \u46308 \u51008  \u51116 \u47932 \u44284  \u51648 \u50948 \u47484  \u50619 \u44592  \u50948 \u54644 \u49436 \u45716  \u50612 \u46496 \u54620  \u48276 \u51396 \u46972 \u46020  \u49436 \u49844 \u51648  \u50506 \u50520 \u45796 . \u48277 \u50773 \u44284  \u51452 \u44368 \u46308 \u51032  \u51200 \u53469 \u46308 \u51008  \u44537 \u55176  \u48708 \u50676 \u54620  \u51396 \u50501 \u51032  \u51109 \u49548 \u44032  \u46104 \u50632 \u45796 . \u50612 \u46500  \u54788 \u51649  \u48277 \u50773 \u44284  \u51452 \u44368 \u46308 \u51008  \u45320 \u47924 \u45208  \u51648 \u45208 \u52824 \u44172  \u48708 \u51064 \u46020 \u51201 \u51064  \u51396 \u47484  \u48276 \u54616 \u50688 \u51004 \u48064 \u47196  \u49464 \u49345 \u51032  \u53685 \u52824 \u51088 \u46308 \u46020  \u52264 \u47560  \u44536 \u45285  \u46168  \u49688 \u44032  \u50630 \u50612 \u49436  \u44536 \u46308 \u51012  \u44537 \u50501 \u47924 \u46020 \u54620  \u49324 \u46988 \u51004 \u47196  \u48372 \u44256  \u44368 \u54924 \u51032  \u45458 \u51008  \u51648 \u50948 \u50640 \u49436  \u46504 \u50612 \u46888 \u47532 \u44256 \u51088  \u45432 \u47141 \u54620  \u51068 \u44620 \u51648  \u51080 \u50632 \u45796 . \u49688 \u49464 \u44592  \u46041 \u50504  \u50976 \u47101 \u50640 \u49436 \u45716  \u54617 \u47928 , \u50696 \u49696 , \u47928 \u54868 \u51032  \u44033  \u48169 \u47732 \u50640  \u51080 \u50612 \u49436  \u50500 \u47924 \u47088  \u51652 \u48372 \u46020  \u48380  \u49688  \u50630 \u50632 \u45796 . \u44536 \u47532 \u49828 \u46020 \u44368 \u44397 \u51008  \u46020 \u45909 \u51201 , \u51648 \u51201 \u51004 \u47196  \u47560 \u48708  \u49345 \u53468 \u50640  \u48736 \u51276 \u45796 .\
\uc0\u47196 \u47560 \u44368 \u51032  \u44428 \u49464  \u50500 \u47000  \u51080 \u45716  \u49464 \u44228 \u51032  \u49345 \u53468 \u45716  \u49440 \u51648 \u51088  \u54840 \u49464 \u50500 \u51032  \u47568 \u51060  \u48516 \u47749 \u55176  \u49457 \u52712 \u46108  \u49324 \u49892 \u51012  \u49892 \u51613 \u54616 \u50688 \u45796 . \'93\u45236  \u48177 \u49457 \u51060  \u51648 \u49885 \u51060  \u50630 \u51004 \u48064 \u47196  \u47581 \u54616 \u45716 \u46020 \u45796  \u45348 \u44032  \u51648 \u49885 \u51012  \u48260 \u47160 \u51004 \u45768  \u45208 \u46020  \u45320 \u47484  \u48260 \u47140  \u45236  \u51228 \u49324 \u51109 \u51060  \u46104 \u51648  \u47803 \u54616 \u44172  \u54624  \u44163 \u51060 \u50836  \u45348 \u44032  \u45348  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51012  \u51082 \u50632 \u51004 \u45768  \u45208 \u46020  \u45348  \u51088 \u45376 \u46308 \u51012  \u51082 \u50612  \u48260 \u47532 \u47532 \u46972 \'94, \'93\u51060  \u46405 \u50640 \u45716  \u51652 \u49892 \u46020  \u50630 \u44256  \u51064 \u50528 \u46020  \u50630 \u44256  \u54616 \u45208 \u45784 \u51012  \u50500 \u45716  \u51648 \u49885 \u46020  \u50630 \u44256  \u50724 \u51649  \u51200 \u51452 \u50752  \u49324 \u50948 \u50752  \u49332 \u51064 \u44284  \u53804 \u51208 \u44284  \u44036 \u51020 \u49104 \u51060 \u50836  \u44053 \u54252 \u54616 \u50668  \u54588 \u44032  \u54588 \u47484  \u46244 \u45824 \u51076 \u51060 \u46972 \'94 (\u54840  4:6, 1, 2). \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51012  \u48260 \u47536  \u44208 \u44284 \u45716  \u51060 \u47084 \u54616 \u50688 \u45796 .\
