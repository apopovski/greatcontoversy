\uc0\u52488 \u45824 \u44368 \u54924 \u51032  \u50669 \u49324 \u45716  \u44396 \u51452 \u51032  \u47568 \u50432 \u51060  \u49457 \u52712 \u46108  \u44163 \u51012  \u51077 \u51613 \u54616 \u50688 \u45796 . \u49464 \u49345 \u44284  \u51020 \u48512  (\u38512 \u24220 ) \u51032  \u44428 \u49464 \u45716  \u51204 \u47141 \u51012  \u45796 \u54616 \u50668  \u44536 \u48516 \u51012  \u46384 \u47476 \u45716  \u49324 \u46988 \u46308 \u51012  \u54605 \u48149 \u54632 \u51004 \u47196  \u44536 \u47532 \u49828 \u46020 \u47484  \u45824 \u51201 \u54616 \u50688 \u45796 . \u51060 \u44368  (\u30064 \u25934 ) \u45716  \u47564 \u51068  \u48373 \u51020 \u51060  \u49849 \u47532 \u47484  \u50619 \u45716 \u45796 \u47732  \u44536 \u46308 \u51032  \u49888 \u51204  (\u31070 \u27583 ) \u44284  \u51228 \u45800 \u51008  \u51068 \u49548  (\u19968 \u25475 ) \u46104 \u47532 \u46972 \u45716  \u44163 \u51012  \u50696 \u44204 \u54616 \u50688 \u45796 . \u44536 \u47084 \u48064 \u47196  \u51060 \u44368 \u45716  \u44536 \u47532 \u49828 \u46020 \u44368 \u47484  \u48149 \u47736 \u54616 \u44256 \u51088  \u51204 \u47141 \u51012  \u44592 \u50872 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u48149 \u54644 \u51032  \u48520 \u44600 \u51060  \u53440 \u50732 \u46992 \u45796 . \u44536 \u47532 \u49828 \u46020 \u51064 \u46308 \u51008  \u51116 \u49328 \u51012  \u48764 \u50519 \u44592 \u44256  \u51665 \u50640 \u49436  \u45236 \u50612  \u51923 \u44220 \u45796 . \u44536 \u46308 \u51008  \'93\u44256 \u45212 \u51032  \u53360  \u49912 \u50880 \u50640  \u52280 \'94\u44256 , \'93\u55148 \u47217 \u44284  \u52292 \u52237 \u51656 \u49104  \u50500 \u45768 \u46972  \u44208 \u48149 \u44284  \u50725 \u50640  \u44039 \u55176 \u45716  \u49884 \u54744 \u46020  \u48155 \u50520 \'94 (\u55176  10:32, 11:36) \u45796 . \u44536 \u47532 \u44256  \u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u44536 \u46308 \u51032  \u51613 \u44144 \u47484  \u44536 \u46308 \u51032  \u54588 \u47196 \u50024  \u51064  \u52452 \u45796 . \u48712 \u48512 \u50752