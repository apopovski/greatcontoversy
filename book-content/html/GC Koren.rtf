\uc0\u50500 \u45812 \u44284  \u54616 \u50752 \u45716  \u51060 \u48120  \u51060  \u50948 \u54744 \u54620  \u50896 \u49688 \u50640  \u45824 \u54616 \u50668  \u44221 \u44256 \u47484  \u48155 \u50500 \u50772 \u51004 \u48064 \u47196  \u47564 \u51068  \u49324 \u45800 \u51060  \u51088 \u49888 \u51032  \u51221 \u52404 \u47484  \u44536 \u45824 \u47196  \u45208 \u53440 \u45256 \u45796 \u47732  \u44536 \u45716  \u51593 \u49884  \u44144 \u51208 \u45817 \u54616 \u50688 \u51012  \u44163 \u51060 \u50632 \u45796 . \u44536 \u47084 \u45208  \u49324 \u45800 \u51008  \u44536 \u51032  \u47785 \u51201 \u51012  \u45908 \u50865  \u54952 \u44284 \u51201 \u51004 \u47196  \u49457 \u52712 \u54616 \u44592  \u50948 \u54616 \u50668  \u51088 \u44592 \u51032  \u47785 \u51201 \u51012  \u49704 \u44592 \u44256  \u50516 \u50516 \u47532 \u50640  \u54876 \u46041 \u54664 \u45796 . \u44536 \u45716  \u45817 \u49884 \u50640  \u44032 \u51109  \u50500 \u47492 \u45796 \u50868  \u46041 \u47932 \u51060 \u45912  \u48192 \u51012  \u44536 \u51032  \u47588 \u44060 \u47932 \u47196  \u51060 \u50857 \u54616 \u50668  \u54616 \u50752 \u50640 \u44172  \u47568 \u54664 \u45796 . \'93\u54616 \u45208 \u45784 \u51060  \u52280 \u51004 \u47196  \u45320 \u55148 \u45908 \u47084  \u46041 \u49328  \u47784 \u46304  \u45208 \u47924 \u51032  \u49892 \u44284 \u47484  \u47673 \u51648  \u47568 \u46972  \u54616 \u49884 \u45908 \u45264 \'94 (\u52285  3:1). \u47564 \u51068  \u54616 \u50752 \u44032  \u44536  \u50976 \u54841 \u51088 \u50752  \u47568 \u51012  \u44368 \u54872 \u54616 \u51648  \u50506 \u50520 \u45796 \u47732  \u44536 \u45716  \u50504 \u51204 \u54616 \u50688 \u51012  \u44163 \u51060 \u45796 . \u44536 \u47084 \u45208  \u44536 \u45716  \u44048 \u55176  \u44536  \u50976 \u54841 \u51088 \u50752  \u51060 \u50556 \u44592 \u54616 \u44256 \u51088  \u54632 \u51004 \u47196  \u44536 \u51032  \u44036 \u44228 \u50640  \u48736 \u51256 \u48260 \u47160 \u45796 . \u51648 \u44552 \u46020  \u50668 \u51204 \u55176  \u47566 \u51008  \u49324 \u46988 \u4