\f0\b \cf0 \uc0\u50516 \u55121 \u51068  (\u51116 \u47548 \u51032  \u51669 \u51312  2)\
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u54644 \u50752  \u45804 \u51060  \u50612 \u46160 \u50892 \u51648 \u47532 \u46972 \u45716  \u50696 \u50616 \u51032  \u46168 \u51704  \u51669 \u51312 \u45716  25\u45380  \u54980 \u50640  \u51068 \u50612 \u45228 \u45796 . \u44536 \u47532 \u44256  \u45908 \u50865  \u45440 \u46972 \u50868  \u44163 \u51008  \u44536  \u51068 \u51060  \u49457 \u52712 \u46108  \u49884 \u44592 \u44032  \u50696 \u50616 \u50640 \u49436  \u51648 \u51201 \u54620  \u44163 \u44284  \u53952 \u47548 \u50630 \u51060  \u51068 \u52824 \u46108 \u45796 \u45716  \u51216 \u51060 \u45796 . \u44396 \u51452 \u44760 \u49436 \u45716  \u44048 \u46988 \u49328  \u50948 \u50640 \u49436  \u51228 \u51088 \u46308 \u50640 \u44172  \u44368 \u54924 \u44032  \u50724 \u47004  \u44592 \u44036 \u51032  \u49884 \u47144 \u44592  \u44263 , \u51068 \u52380 \u51060 \u48177 \u50977 \u49901  \u45380 \u44036  \u48277 \u50773 \u44428 \u51032  \u48149 \u54644 \u47484  \u45817 \u54624  \u44163 \u51012  \u47568 \u50432 \u54616 \u49884 \u44256  \u44536  \u54872 \u45212  \u45216 \u51012  \u44048 \u54624  \u44163 \u51012  \u50557 \u49549 \u54616 \u49888  \u54980  \u51116 \u47548  \u51204 \u50640  \u51080 \u51012  \u47751  \u44032 \u51648  \u49324 \u44148 \u51012  \u47568 \u50432 \u54616 \u49884 \u47732 \u49436  \u44536  \u52395 \u51704  \u49324 \u44148 \u51060  \u50616 \u51228  \u51068 \u50612 \u45216  \u44163 \u51012  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u50432 \u54616 \u49512 \u45796 . \'93\u44536  \u46412 \u50640  \u44536  \u54872 \u45212  \u54980  \u54644 \u44032  \u50612 \u46160 \u50892 \u51648 \u47728  \u45804 \u51060  \u48731 \u51012  \u45236 \u51648  \u50500 \u45768 \u54616 \'94 (\u47561  13:24) \u47532 \u46972 . \u51068 \u52380 \u51060 \u48177 \u50977 \u49901 \u51068 , \u44263  \u51068 \u52380 \u51060 \u48177 \u50977 \u49901  \u45380 \u51008  \u44592 \u50896  1798\u45380 \u50640  \u47560 \u52452 \u45796  (\u51228 15\u51109 \u44284  \u51228 25\u51109  \u52280 \u51312 ). \u48149 \u54644 \u45716  \u44536 \u48372 \u45796  25\u45380  \u51204 \u50640  \u44144 \u51032  \u45796  \u45149 \u45228 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u47568 \u50432 \u54616 \u49888  \u45824 \u47196  \u44536  \u48149 \u54644 \u44032  \u45149 \u45212  \u46244 \u47484  \u51060 \u50612 \u49436  \u54644 \u44032  \u50612 \u46160 \u50892 \u51656  \u44163 \u51060 \u50632 \u45796 . \u51060  \u50696 \u50616 \u51008  1780\u45380  5\u50900  19\u51068 \u50640  \u49457 \u52712 \u46104 \u50632 \u45796 .\
\'93\uc0\u51060 \u47088  \u51333 \u47448 \u51032  \u47784 \u46304  \u54788 \u49345  \u51473 \u50640 \u49436  \u44032 \u51109  \u49888 \u48708 \u54616 \u44256  \u49444 \u47749 \u54624  \u49688  \u50630 \u45716  \u54788 \u49345 \u51008  1780\u45380  5\u50900  19\u51068 \u51032  \u50516 \u55121 \u51068 \u51060 \u50632 \u45716 \u45936 , \u44536 \u45216 \u50640  \u48120 \u44397 \u51032  \u45684 \u51081 \u44544 \u47004 \u46300  \u51648 \u50669 \u50640 \u45716  \u45576 \u51004 \u47196  \u48380  \u49688  \u51080 \u45716  \u50728  \u54616 \u45720 \u44284  \u44277 \u51473 \u51060  \u51204 \u50672  \u54644 \u49437 \u54624  \u49688  \u50630 \u45716  \u50516 \u55121 \u51004 \u47196  \u46244 \u45934 \u50688 \u45796 \'94 (R.M.Devens, Our First Century, p.89).\
\uc0\u51060 \u50640  \u45824 \u54616 \u50668  \u47588 \u49324 \u52628 \u49464 \u52768  \u51452 \u51032  \u54620  \u47785 \u44201 \u51088 \u45716  \u51060 \u47111 \u44172  \u47568 \u54616 \u50688 \u45796 . \'93\u50500 \u52840 \u50640  \u54644 \u44032  \u46496 \u50724 \u47484  \u46412 \u50640 \u45716  \u47569 \u44256  \u49440 \u47749 \u54616 \u50688 \u51004 \u45208  \u51104 \u49884  \u54980  \u54616 \u45720 \u51008  \u50612 \u46160 \u50892 \u51276 \u45796 . \u44396 \u47492 \u51060  \u51216 \u51216  \u45230 \u50500 \u51648 \u45908 \u45768  \u54744 \u50501 \u54644 \u51276 \u44256  \u51060 \u50612 \u49436  \u48264 \u44060 \u44032  \u52824 \u44256  \u50864 \u47112  \u49548 \u47532 \u44032  \u45208 \u44256  \u48708 \u46020  \u50557 \u44036  \u45236 \u47160 \u45796 . \u50724 \u51204  \u50500 \u54857  \u49884  \u44221 \u51060  \u46104 \u51088  \u44396 \u47492 \u51008  \u50679 \u50612 \u51276 \u51004 \u45208  \u50728  \u54616 \u45720 \u51060  \u44396 \u47551 \u48731 \u52376 \u47100  \u48521 \u50612 \u51276 \u45716 \u45936 , \u44536  \u51060 \u49345 \u54620  \u48731  \u46412 \u47928 \u50640  \u46405 \u44284 , \u48148 \u50948 \u46308 , \u45208 \u47924 \u46308 , \u44148 \u47932 \u46308 , \u49324 \u46988 \u51032  \u47784 \u50577  \u46321 \u51060  \u47784 \u46160  \u50756 \u51204 \u55176  \u48320 \u54620  \u44163 \u52376 \u47100  \u48372 \u50688 \u45796 . \u44536 \u47532 \u44256  \u51104 \u44624  \u54980 \u50640  \u49352 \u44620 \u47564  \u44396 \u47492 \u51060  \u51648 \u54217 \u49440  \u50948 \u50640  \u51329 \u45796 \u46976  \u49440  (\u32218 ) \u47564  \u45224 \u44592 \u44256  \u50728  \u54616 \u45720 \u51012  \u45934 \u50612  \u48260 \u47160 \u45796 . \u44536 \u47532 \u54616 \u50668  \u51068 \u48152 \u51201 \u51004 \u47196  \u50668 \u47492 \u52384 \u51032  \u51200 \u45377  \u50500 \u54857  \u49884  \u47564 \u53372 \u51032  \u50612 \u46176 \u51060  \u46104 \u50612  \u48260 \u47160 \u45796 . \'85\
\uc0\u46160 \u47140 \u50880 \u44284  \u50684 \u47140 \u50752  \u47924 \u49436 \u50868  \u49373 \u44033 \u51060  \u52264 \u52784  \u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u51012  \u50628 \u49845 \u54616 \u50688 \u45796 . \u48512 \u51064 \u46308 \u51008  \u47928 \u44036 \u50640  \u49436 \u49436  \u50612 \u46160 \u50868  \u54413 \u44221 \u51012  \u51452 \u47785 \u54616 \u50668  \u48372 \u50520 \u45796 . \u45453 \u48512 \u46308 \u51008  \u48173 \u50640 \u49436  \u46028 \u50500 \u50724 \u44256 , \u47785 \u49688 \u50752  \u45824 \u51109 \u51109 \u51060 \u45716  \u51068 \u49552 \u51012  \u47688 \u52628 \u44256 , \u51109 \u49324 \u44988 \u46308 \u51008  \u51216 \u54252 \u47484  \u44151 \u50612 \u52824 \u50912 \u45796 . \u54617 \u44368 \u46308 \u51008  \u49688 \u50629 \u51012  \u51473 \u45800 \u54616 \u50668  \u54616 \u54617 \u54616 \u44256 , \u50500 \u46041 \u46308 \u51008  \u47924 \u49436 \u50892 \u49436  \u51665 \u51004 \u47196  \u46832 \u50612 \u50772 \u45796 . \u54665 \u51064 \u46308 \u51008  \u44032 \u44620 \u50868  \u45453 \u44032 \u47196  \u54588 \u54616 \u50668  \u46308 \u50612 \u44052 \u45796 . \'91\u45824 \u44288 \u51208  \u50612 \u52236 \u46108  \u51068 \u51064 \u44032 ?\'92 \u47784 \u46304  \u49324 \u46988 \u51032  \u47560 \u51020 \u44284  \u51077 \u50640 \u49436  \u44536 \u47088  \u51032 \u47928 \u46308 \u51060  \u49352 \u50612  \u45208 \u50772 \u45796 . \u47560 \u52824  \u53468 \u54413 \u51060  \u46405 \u50640  \u47792 \u47140 \u50732  \u44163 \u52376 \u47100 , \u47564 \u47932 \u51032  \u51333 \u47568 \u51060  \u45796 \u44032 \u50732  \u44163 \u52376 \u47100  \u48372 \u50688 \u45796 .\
\uc0\u52507 \u48520 \u51012  \u53040 \u45796 . \u45212 \u47196 \u51032  \u48520 \u46308 \u51008  \u47560 \u52824  \u45804  \u50630 \u45716  \u44032 \u51012 \u48164 \u51012  \u48708 \u52628 \u45716  \u44163  \u44057 \u50520 \u45796 . \'85\u45805 \u46308 \u51008  \u54896 \u50640  \u50732 \u46972 \u44032  \u51096  \u51456 \u48708 \u47484  \u54616 \u44256  \u44032 \u52629 \u46308 \u51008  \u47785 \u51109 \u51032  \u54620  \u54200  \u44396 \u49437 \u51004 \u47196  \u47792 \u47140 \u49436  \u50872 \u44256  \u51080 \u50632 \u45796 . \u44060 \u44396 \u47532 \u44032  \u50872 \u44256  \u51089 \u51008  \u49352 \u46308 \u46020  \u51200 \u45377  \u45432 \u47000 \u47484  \u48520 \u47104 \u51004 \u47728 , \u48149 \u51536 \u46308 \u51008  \u48150 \u51004 \u47196  \u45208 \u50752 \u49436  \u45216 \u50500 \u45796 \u45396 \u45796 . \u50500 \u51649  \u48164 \u51060  \u50500 \u45768 \u46972 \u45716  \u44163 \u51012  \u50508 \u44256  \u51080 \u45716  \u44163 \u51008  \u49324 \u46988 \u49104 \u51060 \u50632 \u45796 . \'85\
\uc0\u51060 \u46412 \u50640  \u49464 \u51068 \u47100 \u50640  \u51080 \u45716  \u53468 \u48260 \u45320 \u53364  \u44368 \u54924 \u51032  \u47785 \u49324  \u45208 \u45796 \u45208 \u50648  \u55064 \u53580 \u51060 \u52964  \u48149 \u49324 \u44032  \u50696 \u48176 \u45817 \u50640 \u49436  \u51333 \u44368  \u51665 \u54924 \u47484  \u50676 \u44256  \u51080 \u50632 \u45716 \u45936 , \u44536 \u45716  \u49444 \u44368 \u54616 \u45716  \u51473 \u50640  \u44536  \u50516 \u55121 \u51060  \u52488 \u51088 \u50672 \u51201  \u54788 \u49345 \u51060 \u46972 \u44256  \u51452 \u51109 \u54616 \u50688 \u45796 . \u54924 \u51473 \u46308 \u51008  \u47566 \u51008  \u44275 \u50640 \u49436  \u47784 \u50668 \u46308 \u50632 \u45796 . \u44536 \u47088 \u45936  \u51593 \u49437  \u49444 \u44368 \u47484  \u50948 \u54644  \u49440 \u53469 \u46108  \u49457 \u44221  \u44396 \u51208 \u46308 \u51008  \u54620 \u44208 \u44057 \u51060  \u44536  \u50516 \u55121 \u51060  \u49457 \u44221 \u51032  \u50696 \u50616 \u50640  \u51068 \u52824 \u54620 \u45796 \u45716  \u44163 \u51012  \u51648 \u51201 \u54644  \u51452 \u45716  \u46319 \u51060  \u48372 \u51060 \u45716  \u44163 \u46308 \u51060 \u50632 \u45796 . \'85\u44536  \u50516 \u55121 \u51008  \u50676 \u54620 \u49884 \u44032  \u51312 \u44552  \u51648 \u45208 \u51088  \u44032 \u51109  \u49900 \u54644 \u51276 \u45796 \'94 (The Essex Antiquarian, April, 1899, vol.3, No.4, pp.53, 54). \'93\u44536  \u45208 \u46972 \u51032  \u45824 \u48512 \u48516 \u51032  \u51648 \u50669 \u51008  \u54620 \u45230 \u50640  \u55121 \u50516 \u51060  \u45320 \u47924 \u46020  \u49900 \u54616 \u50688 \u44592  \u46412 \u47928 \u50640  \u49324 \u46988 \u46308 \u51008  \u52507 \u48520 \u51060  \u50630 \u51060 \u45716  \u49552 \u47785 \u49884 \u44228 \u45208  \u48317 \u49884 \u44228 \u47484  \u48380  \u49688  \u50630 \u50632 \u44256 , \u48165 \u51012  \u47673 \u44144 \u45208  \u51665 \u50504 \u51068 \u51012  \u54624  \u49688 \u46020  \u50630 \u50632 \u45796 . \'85\
\uc0\u44536  \u50516 \u55121 \u51032  \u48276 \u50948 \u45716  \u49900 \u55176  \u45331 \u50632 \u45796 . \u46041 \u51901 \u51004 \u47196 \u45716  \u54064 \u47672 \u46300 \u44620 \u51648  \u48120 \u52824 \u44256 , \u49436 \u51901 \u51004 \u47196 \u45716  \u53076 \u45348 \u54000 \u52983  \u51452 \u51032  \u44032 \u51109  \u47676  \u51648 \u50669 \u44284  \u50536 \u48148 \u45768  \u49884 \u44620 \u51648  \u48120 \u52452 \u45796 . \u45224 \u51901 \u51004 \u47196 \u45716  \u54644 \u50504 \u51012  \u46384 \u47480  \u47784 \u46304  \u51648 \u48169 \u44284  \u48513 \u51901 \u51004 \u47196 \u45716  \u48120 \u44397  \u51648 \u50669 \u51032  \u52572 \u48513 \u45800 \u44620 \u51648  \u48120 \u52452 \u45796 \'94 (William Gordon, History of the Rise, Progress, and Establishment of the Independence of the U.S.A., vol.3, p.57).\
\uc0\u45230  \u46041 \u50504 \u51032  \u51673 \u51008  \u50516 \u55121 \u51008  \u51460 \u44263  \u44228 \u49549 \u46104 \u50632 \u45796 . \u44536 \u47532 \u44256  \u51200 \u45377 \u46412 \u51032  \u54620 \u46160  \u49884 \u44036 \u52196  \u54616 \u45720 \u51060  \u50620 \u47560 \u52196  \u48157 \u50500 \u51256 \u49436  \u53468 \u50577 \u51060  \u45208 \u53440 \u45228 \u45796 . \u44536 \u47084 \u45208  \u53468 \u50577 \u51008  \u50668 \u51204 \u55176  \u44160 \u44256  \u48765 \u48765 \u54620  \u50504 \u44060 \u50640  \u44032 \u47532 \u50892  \u55148 \u48120 \u54616 \u50688 \u45796 . \'93\u54644 \u44032  \u51652  \u54980 \u50640  \u44396 \u47492 \u51008  \u45796 \u49884  \u45934 \u50668 \u49436  \u49692 \u49885 \u44036 \u50640  \u50516 \u55121 \u51060  \u49900 \u54616 \u50668 \u51276 \u45796 .\'94 \'93\u44536 \u45216  \u48164 \u51032  \u50612 \u46176 \u51008  \u45230  \u46041 \u50504 \u51032  \u50612 \u46176 \u48372 \u45796  \u45908 \u50865  \u49900 \u54616 \u50688 \u51004 \u47728 , \u51060 \u49345 \u54616 \u44256  \u47924 \u49436 \u50868  \u55121 \u50516 \u51060 \u50632 \u45796 . \u44144 \u51032  \u47564 \u50900 \u51060 \u50632 \u51648 \u47564  \u46321 \u48520 \u51032  \u46020 \u50880 \u51060  \u50630 \u51060 \u45716  \u50500 \u47924 \u47088  \u47932 \u52404 \u46020  \u48516 \u44036 \u54624  \u49688 \u44032  \u50630 \u50632 \u45796 . \u44536  \u46321 \u48520 \u46020  \u51060 \u50883 \u51665 \u50640 \u49436 \u45208  \u51312 \u44552  \u44144 \u47532 \u44032  \u46504 \u50612 \u51256  \u51080 \u45716  \u44275 \u50640 \u49436  \u48372 \u47732  \u50528 \u44413 \u50640  \u45208 \u53440 \u45228 \u45912  \u50516 \u55121 \u52376 \u47100  \u44305 \u49440 \u51060  \u45040 \u46763 \u51012  \u49688  \u50630 \u45716  \u50516 \u55121 \u51012  \u53685 \u54616 \u50668  \u48372 \u45716  \u44163  \u44057 \u50520 \u45796 \'94[Isaiah Thomas, Massachusetts Spy;or, American Oracle of Liberty, vol.10, No.472 (May 25, 1780) ]. \u45817 \u49884 \u51032  \u54620  \u47785 \u44201 \u51088 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u54616 \u50688 \u45796 . \'93\u45208 \u45716  \u44536  \u46412 \u50640  \u50864 \u51452 \u51032  \u48156 \u44305 \u52404  (\u30332 \u20809 \u39636 ) \u44032  \u47784 \u46160  \u46763 \u44256  \u45208 \u50732  \u49688  \u50630 \u45716  \u50516 \u55121 \u50640  \u49912 \u50688 \u44144 \u45208 , \u50630 \u50612 \u51256  \u48260 \u47160 \u51012  \u44163 \u51060 \u46972 \u44256  \u49373 \u44033 \u54624  \u49688 \u48150 \u50640  \u50630 \u50632 \u45796 . \u44536 \u47111 \u51648  \u50506 \u44256 \u49436 \u50556  \u44536 \u52376 \u47100  \u50516 \u55121 \u51060  \u49900 \u54624  \u49688 \u45716  \u50630 \u50632 \u45796 \'94[Letter by Dr. Samuel Tenney, of Exeter, New Hampshire, December, 1785 (in Massachuestts Historical Society Collections, 1792, 1st Series, vol.1, p.97) ]. \u44536 \u45216  \u48164  9\u49884 \u50640  \u45804 \u51008  \u50756 \u51204 \u55176  \u46496 \u50732 \u46992 \u51004 \u45208  \'93\u51060  \u51453 \u51020 \u51032  \u44536 \u45720 \u44284  \u44057 \u51008  \u50612 \u46176 \u51012  \u51204 \u54784  \u51228 \u44144 \u54644  \u48260 \u47540  \u49688  \u50630 \u50632 \u45796 .\'94 \u48164 \u51473 \u51060  \u46104 \u51088  \u50516 \u55121 \u51008  \u49324 \u46972 \u51648 \u44256 , \u45804 \u51012  \u52376 \u51020 \u51004 \u47196  \u48372 \u44172  \u46104 \u50632 \u45716 \u45936 , \u44536 \u44163 \u51008  \u47560 \u52824  \u54607 \u48731 \u44284  \u44057 \u50520 \u45796 .\
1780\uc0\u45380  5\u50900  19\u51068 \u51008  \u50669 \u49324 \u49345  \u50516 \u55121 \u51068 \u47196  \u50508 \u47140 \u51256  \u51080 \u45796 . \u47784 \u49464  \u49884 \u45824  \u51060 \u54980 \u47196  \u44536 \u52376 \u47100  \u44537 \u49900 \u54616 \u44256  \u44305 \u48276 \u50948 \u54616 \u44256  \u51109 \u49884 \u44036 \u50640  \u44152 \u52432  \u51080 \u50632 \u45912  \u50516 \u55121 \u51008  \u48380  \u49688  \u50630 \u50632 \u45796 . \u44536 \u47084 \u45208  \u49892 \u51228 \u47196  \u51060  \u50516 \u55121 \u51068 \u51012  \u47785 \u44201 \u54620  \u49324 \u46988 \u46308 \u51032  \u44592 \u47197 \u51008  \u49440 \u51648 \u51088  \u50836 \u50648 \u51060  \u51060 \u48120  \u44536  \u49324 \u44148 \u51060  \u49457 \u52712 \u46104 \u44592  \u51060 \u52380 \u50724 \u48177  \u45380  \u51204 \u50640  \u44592 \u47197 \u54620  \u49457 \u44221  \u47568 \u50432 \u51012  \u46104 \u54400 \u51060 \u54620  \u45936  \u48520 \u44284 \u54616 \u45796 . \'93\u50668 \u54840 \u50752 \u51032  \u53356 \u44256  \u46160 \u47140 \u50868  \u45216 \u51060  \u51060 \u47476 \u44592  \u51204 \u50640  \u54644 \u44032  \u50612 \u46160 \u50892 \u51648 \u44256  \u45804 \u51060  \u54607 \u48731 \u44057 \u51060  \u48320 \u54616 \'94 (\u50844  2:31) \u47532 \u46972 .\
