\f0\b \cf0 \uc0\u45812 \u45824 \u54620  \u47336 \u53552 \u51032  \u53468 \u46020 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u47336 \u53552 \u45716  \u46021 \u51068 \u50612 \u47196  \u47568 \u54616 \u50688 \u45796 . \u44536 \u45716  \u45796 \u49884  \u46972 \u54004 \u50612 \u47196  \u44057 \u51008  \u47568 \u51012  \u48152 \u48373 \u54616 \u46972 \u45716  \u50836 \u44396 \u47484  \u48155 \u50520 \u45796 . \u44536 \u45716  \u45320 \u47924  \u50528 \u47484  \u50044 \u44592  \u46412 \u47928 \u50640  \u44592 \u51652 \u47589 \u51652 \u54616 \u50688 \u51648 \u47564 , \u44536  \u50836 \u44396 \u45824 \u47196  \u45796 \u49884  \u52395  \u48264 \u44284  \u44057 \u51060  \u50676 \u47148 \u54616 \u44256  \u48516 \u47749 \u54616 \u44172  \u51652 \u49696 \u54616 \u50688 \u45796 . \u54616 \u45208 \u45784 \u51032  \u49453 \u47532 \u44032  \u44536  \u51068 \u51012  \u51648 \u46020 \u54616 \u50688 \u45796 . \u50668 \u47084  \u51228 \u54980 \u46308 \u51032  \u47560 \u51020 \u51008  \u50724 \u47448 \u50752  \u48120 \u49888 \u51004 \u47196  \u50612 \u46160 \u50892 \u51256  \u51080 \u50632 \u51004 \u48064 \u47196  \u52395  \u48264 \u51704  \u51652 \u49696 \u50640 \u49436 \u45716  \u47336 \u53552 \u51032  \u45436 \u51613 \u51012  \u52649 \u48516 \u55176  \u44648 \u45803 \u51648  \u47803 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u46160  \u48264 \u51704  \u48152 \u48373 \u54616 \u48064 \u47196  \u44536 \u46308 \u51008  \u47336 \u53552 \u44032  \u50669 \u49444 \u54616 \u45716  \u50836 \u51648 \u44032  \u50612 \u46356 \u50640  \u51080 \u45796 \u45716  \u44163 \u51012  \u50508  \u49688  \u51080 \u44172  \u46104 \u50632 \u45796 .\
\uc0\u50756 \u44256 \u54616 \u44172 \u46020  \u45576 \u51012  \u44048 \u50500  \u48731 \u51012  \u48372 \u51648  \u50500 \u45768 \u54616 \u44256  \u51652 \u47532 \u47484  \u44648 \u45803 \u51648  \u50506 \u44256 \u51088  \u51089 \u51221 \u54620  \u51088 \u46308 \u51008  \u47336 \u53552 \u51032  \u55192  \u51080 \u45716  \u47568 \u50640  \u45824 \u54616 \u50668  \u48516 \u44201 \u54616 \u50688 \u45796 . \u44536 \u51032  \u51652 \u49696 \u51060  \u45149 \u45208 \u51088  \u51032 \u54924 \u51032  \u45824 \u48320 \u51064 \u51008  \u54868 \u47484  \u45236 \u50612  \u47568 \u54616 \u50688 \u45796 . \'93\u45320 \u45716  \u51452 \u50612 \u51652  \u51656 \u47928 \u50640  \u45824 \u54616 \u50668 \u45716  \u45824 \u45813 \u54616 \u51648  \u50506 \u50520 \u45796 . \'85\u45320 \u45716  \u48516 \u47749 \u54616 \u44256  \u51221 \u54869 \u54620  \u45813 \u48320 \u51012  \u54644 \u50556  \u54620 \u45796 . \u45320 \u45716  \u52712 \u49548 \u54616 \u44192 \u45712 \u45264 , \u44536 \u47111 \u51648  \u50506 \u51004 \u47732  \u52712 \u49548 \u54616 \u51648  \u50506 \u44192 \u45712 \u45264 ?\'94\
\uc0\u44060 \u54785 \u51088 \u45716  \u45824 \u45813 \u54616 \u50688 \u45796 . \'93\u51648 \u51316 \u54616 \u49888  \u54224 \u54616 \u50752  \u44256 \u44480 \u54616 \u49888  \u50773 \u54980  (\u29579 \u20399 ) \u51228 \u50948 \u44760 \u49436  \u48376 \u51064 \u50640 \u44172  \u44036 \u45800 \u54616 \u44256 , \u47749 \u47308 \u54616 \u44256 , \u54869 \u49892 \u54620  \u45813 \u48320 \u51012  \u50836 \u44396 \u54616 \u49512 \u49845 \u45768 \u45796 . \u51060 \u51228  \u48376 \u51064 \u51008  \u45824 \u45813 \u54616 \u44192 \u49845 \u45768 \u45796 . \u48376 \u51064 \u51008  \u48376 \u51064 \u51032  \u49888 \u50521 \u51012  \u48277 \u50773 \u51060 \u45208  \u51032 \u54924 \u50640  \u44404 \u48373 \u49884 \u53420  \u49688  \u50630 \u49845 \u45768 \u45796 . \u44536  \u51060 \u50976 \u45716  \u51060  \u46168 \u51008  \u45572 \u52264  \u51096 \u47803 \u51012  \u48276 \u54616 \u50688 \u51004 \u47728  \u54588 \u52264 \u44036 \u50640  \u47784 \u49692 \u46104 \u50632 \u45796 \u45716  \u44163 \u51060  \u48516 \u47749 \u55176  \u48157 \u54784 \u51256  \u51080 \u44592  \u46412 \u47928 \u51077 \u45768 \u45796 . \u44536 \u47084 \u48064 \u47196  \u49457 \u44221 \u51032  \u51613 \u50616 \u44284  \u44032 \u51109  \u48516 \u47749 \u54620  \u45436 \u47532 \u47196 \u50024  \u48376 \u51064 \u51012  \u49444 \u48373 \u49884 \u53420  \u49688  \u50630 \u45716  \u54620 , \u46608 \u54620  \u48376 \u51064 \u51060  \u51064 \u50857 \u54620  \u49457 \u44221  \u44396 \u51208 \u50640  \u45824 \u54616 \u50668  \u48376 \u51064 \u51012  \u49444 \u48373 \u49884 \u53420  \u49688  \u50630 \u45716  \u54620 , \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51004 \u47196  \u48376 \u51064 \u51032  \u50577 \u49900 \u51012  \u49849 \u48373  (\u25215 \u26381 ) \u49884 \u53420  \u49688  \u50630 \u45716  \u54620  \u48376 \u51064 \u51008  \u52712 \u49548 \u54624  \u49688 \u46020  \u50630 \u44256  \u52712 \u49548 \u54616 \u51648 \u46020  \u50506 \u44192 \u49845 \u45768 \u45796 . \u50780 \u45264 \u54616 \u47732  \u44536 \u47532 \u49828 \u46020 \u51064 \u51060  \u51088 \u44592 \u51032  \u50577 \u49900 \u51012  \u44144 \u49836 \u47084  \u47568 \u54616 \u45716  \u44163 \u51008  \u50504 \u51204 \u54616 \u51648  \u47803 \u54616 \u44592  \u46412 \u47928 \u51077 \u45768 \u45796 . \u51228 \u44032  \u50668 \u44592  \u51080 \u45208 \u51060 \u45796 . \u51200 \u45716  \u44536  \u50808 \u50640  \u50500 \u47924 \u44163 \u46020  \u54624  \u49688  \u50630 \u49845 \u45768 \u45796 . \u54616 \u45208 \u45784 \u51060 \u50668 , \u45208 \u47484  \u46020 \u50752 \u51452 \u49884 \u50741 \u49548 \u49436 ! \u50500 \u47704 \'94 (D\'92Aubigne, b.7, ch.8).\
\uc0\u51060 \u50752  \u44057 \u51060  \u44536  \u51032 \u51064 \u51008  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51032  \u54869 \u49892 \u54620  \u44592 \u52488  \u50948 \u50640  \u49436  \u51080 \u50632 \u45796 . \u54616 \u45720 \u51032  \u48731 \u51060  \u44536 \u51032  \u50620 \u44404 \u51012  \u48708 \u52628 \u50632 \u45796 . \u44536 \u51032  \u50948 \u45824 \u54616 \u44256  \u44208 \u48177 \u54620  \u51064 \u44201 , \u44536 \u51032  \u47560 \u51020 \u51032  \u54868 \u54217 \u44284  \u44592 \u49256 \u51008  \u44536 \u44032  \u50724 \u47448 \u51032  \u49464 \u47141 \u51012  \u45824 \u54637 \u54616 \u50668  \u51613 \u50616 \u54616 \u44256 , \u49464 \u49345 \u51012  \u51060 \u44592 \u45716  \u48127 \u51020 \u51032  \u53441 \u50900 \u49457 \u51012  \u51077 \u51613 \u54616 \u50688 \u51012  \u46412  \u47784 \u46304  \u49324 \u46988 \u50640 \u44172  \u48372 \u50688 \u45796 .\
\uc0\u51104 \u49884  \u46041 \u50504  \u50728  \u54924 \u51473 \u51008  \u44221 \u53444 \u54620  \u45208 \u47672 \u51648  \u51312 \u50857 \u54644 \u51276 \u45796 . \u52395  \u48264 \u51704  \u45824 \u45813 \u50640 \u49436  \u47336 \u53552 \u45716  \u44277 \u49552 \u54616 \u44256 , \u44144 \u51032  \u44404 \u50837 \u51201 \u51064  \u53468 \u46020 \u47484  \u52712 \u54616 \u50668  \u50500 \u51452  \u45230 \u51008  \u51020 \u49457 \u51004 \u47196  \u47568 \u54616 \u50688 \u45796 . \u47196 \u47560 \u44368 \u46020 \u46308 \u51008  \u44536 \u44163 \u51012  \u44536 \u51032  \u50857 \u44592 \u44032  \u44734 \u51060 \u44256  \u51080 \u45716  \u51613 \u44144 \u46972 \u44256  \u48372 \u50520 \u45796 . \u46608 \u54620  \u44536 \u46308 \u51008  \u47336 \u53552 \u44032  \u50976 \u50696 \u51032  \u49884 \u44036 \u51012  \u45804 \u46972 \u44256  \u50836 \u52397 \u54620  \u44163 \u51008  \u44536 \u51032  \u49888 \u50521 \u51012  \u52712 \u49548 \u54624  \u51204 \u51312 \u46972 \u44256  \u48372 \u50520 \u45796 . \u52852 \u50508  \u51088 \u49888 \u46020  \u44536  \u49849 \u47140 \u51032  \u51648 \u52828  \u47784 \u49845 , \u44536 \u51032  \u54728 \u49696 \u54620  \u51032 \u48373 , \u44536 \u51032  \u44984 \u48136 \u50630 \u45716  \u51652 \u49696 \u46308 \u51012  \u48372 \u44256 , \u48152 \u52196  \u47736 \u49884 \u54616 \u45716  \u53468 \u46020 \u47196  \'93\u51060  \u49849 \u47140 \u44032  \u45208 \u47484  \u51060 \u45800 \u51088 \u47196  \u47564 \u46308 \u51648 \u45716  \u47803 \u54624  \u44163 \u51060 \u45796 \'94\u44256  \u47568 \u54616 \u50688 \u45796 . \u44536 \u47088 \u45936  \u51060 \u51228  \u44536 \u51032  \u55192  \u51080 \u44256  \u48516 \u47749 \u54620  \u51060 \u47200 \u51008  \u47932 \u47200 \u51060 \u50836  \u44536 \u44032  \u45208 \u53440 \u45240  \u50857 \u44592 \u50752  \u44204 \u51064 \u48520 \u48156 \u51032  \u53468 \u46020 \u45716  \u51109 \u45236 \u51032  \u47784 \u46304  \u49324 \u46988 \u46308 \u51012  \u45440 \u46972 \u44172  \u54616 \u50688 \u45796 . \u54889 \u51228 \u46020  \u44048 \u44201 \u54616 \u50668  \'93\u51060  \u49849 \u47140 \u45716  \u52280 \u51004 \u47196  \u45824 \u45800 \u54620  \u45812 \u47141 \u44284  \u55124 \u46308 \u47532 \u51648  \u50506 \u45716  \u50857 \u44592 \u47484  \u44032 \u51648 \u44256  \u47568 \u54620 \u45796 \'94\u44256  \u54616 \u50688 \u45796 . \u46021 \u51068 \u51032  \u51228 \u54980 \u46308 \u51008  \u51088 \u44592 \u46308 \u51032  \u45208 \u46972 \u47484  \u45824 \u54364 \u54616 \u50668  \u51452 \u45716  \u44536 \u51032  \u53468 \u46020 \u50640  \u45824 \u54616 \u50668  \u51068 \u51333 \u51032  \u51088 \u46993 \u44284  \u44592 \u49256 \u51012  \u45712 \u45180 \u50632 \u45796 .\
