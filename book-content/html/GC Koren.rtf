\uc0\u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u44536  \u53360  \u55148 \u49373 \u51012  \u52824 \u47476 \u49884 \u44256  \u49849 \u52380 \u54616 \u49512 \u45796 . \u44536 \u45716  \u52380 \u49324 \u46308 \u51032  \u44221 \u48176  \u48155 \u44592 \u47484  \u44144 \u51208 \u54616 \u44256  \'93\u50500 \u48260 \u51648 \u50668  \u45236 \u44172  \u51452 \u49888  \u51088 \u46020  \u45208  \u51080 \u45716  \u44275 \u50640  \u45208 \u50752  \u54632 \u44760  \u51080 \'85\u44592 \u47484  \u50896 \u54616 \u50741 \u45208 \u51060 \u45796 \'94 (\u50836  17:24) \u44256  \u47676 \u51200  \u44036 \u52397 \u54616 \u49512 \u45796 . \u44536  \u46412 \u50640  \u54616 \u45720  \u50500 \u48260 \u51648 \u51032  \u48372 \u51340 \u50640 \u49436 \u45716  \u47924 \u54620 \u54620  \u49324 \u46993 \u44284  \u45733 \u47141 \u51004 \u47196  \u45796 \u51020 \u44284  \u44057 \u51008  \u45824 \u45813 \u51060  \u45208 \u50772 \u45796 . \'93\u54616 \u45208 \u45784 \u51032  \u47784 \u46304  \u52380 \u49324 \u44032  \u51200 \u50640 \u44172  \u44221 \u48176 \u54624 \u51648 \u50612 \u45796 \'94 (\u55176  1:6). \u50696 \u49688 \u44760 \u49436 \u45716  \u54620  \u51216 \u51032  \u55136 \u46020  \u50630 \u51004 \u49512 \u45796 . \u44536 \u48516 \u51032  \u44216 \u48708 \u44032  \u45149 \u45208 \u44256  \u55148 \u49373 \u51060  \u51060 \u47336 \u50612 \u51276 \u51004 \u48064 \u47196  \u44536 \u48516 \u50640 \u44172 \u45716  \u47784 \u46304  \u51060 \u47492  \u50948 \u50640  \u46832 \u50612 \u45212  \u51060 \u47492 \u51060  \u51452 \u50612 \u51276 \u45796 .\
\uc0\u51060 \u51228  \u49324 \u45800 \u51032  \u51396 \u45716  \u50500 \u47924 \u47088  \u54609 \u44228 \u54624  \u50668 \u51648 \u50630 \u51060  \u47749 \u48177 \u54616 \u44172  \u46300 \u47084 \u45228 \u45796 . \u44536 \u45716  \u44144 \u51667 \u47568 \u51137 \u51060 \u50836  \u49332 \u51064 \u51088 \u47196 \u49436 \u51032  \u50732 \u48148 \u47480  \u48376 \u49457 \u51012  \u46300 \u47084 \u45256 \u45796 . \u47564 \u51068  \u44536 \u44032  \u54616 \u45720  \u44144 \u48124 \u51012  \u51648 \u48176 \u54624  \u44428 \u49464 \u47484  \u50619 \u50632 \u51012  \u44163  \u44057 \u51004 \u47732  \u51088 \u44592 \u51032  \u44428 \u49464  \u50500 \u47000  \u51080 \u45716  \u51064 \u47448 \u47484  \u51648 \u48176 \u54620  \u44163 \u44284  \u46609 \u44057 \u51008  \u51221 \u49888 \u51004 \u47196  \u54616 \u45720  \u44144 \u48124 \u46308 \u51012  \u51648 \u48176 \u54616 \u50688 \u51012  \u44163 \u51060 \u46972 \u45716  \u49324 \u49892 \u51060  \u48516 \u47749 \u55176  \u45208 \u53440 \u45228 \u45796 . \u44536 \u45716  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51012  \u50948 \u48152 \u54632 \u51004 \u47196  \u51088 \u50976 \u50752  \u45458 \u51076 \u51012  \u50619 \u51012  \u49688  \u51080 \u45796 \u44256  \u51452 \u51109 \u54616 \u50668  \u50772 \u45796 . \u44536 \u47084 \u45208  \u44536  \u51068 \u51060  \u49549 \u48149 \u44284  \u53440 \u46973 \u51012  \u52488 \u47000 \u54620 \u45796 \u45716  \u44163 \u51060  \u46300 \u47084 \u45228 \u45796 .\
\uc0\u49324 \u45800 \u51060  \u54616 \u45208 \u45784 \u51032  \u54408 \u49457 \u44284  \u51221 \u48512 \u47484  \u44144 \u51667 \u51004 \u47196  \u48708 \u45212 \u54616 \u44256  \u51080 \u45716  \u49324 \u49892 \u51060  \u51652 \u49345  \u44536 \u45824 \u47196  \u46300 \u47084 \u45228 \u45796 . \u44536 \u45716  \u54616 \u45208 \u45784 \u44760 \u49436  \u54588 \u51312 \u47932 \u46308 \u50640 \u44172  \u48373 \u51333 \u44284  \u49692 \u51333 \u51012  \u50836 \u44396 \u54632 \u51004 \u47196  \u45817 \u49888  \u51088 \u49888 \u51012  \u45458 \u51060 \u45716  \u51068 \u47564  \u55192 \u50416 \u44256  \u51080 \u45796 \u44256  \u48708 \u45212 \u54616 \u50688 \u45796 . \u44536 \u47532 \u44256  \u44536 \u45716  \u52285 \u51312 \u51452 \u44760 \u49436  \u45796 \u47480  \u47784 \u46304  \u51316 \u51116 \u46308 \u50640 \u44172  \u44537 \u44592 \u54616 \u46972 \u44256  \u44053 \u50836 \u54616 \u47732 \u49436  \u51088 \u49888 \u51008  \u50500 \u47924 \u47088  \u55148 \u49373 \u46020  \u54616 \u51648  \u50506 \u45716 \u45796 \u44256  \u51452 \u51109 \u54644  \u50772 \u45796 . \u44536 \u47084 \u45208  \u51060 \u51228  \u53440 \u46973 \u54620  \u51064 \u47448 \u47484  \u44396 \u50896 \u54616 \u44592  \u50948 \u54616 \u50668  \u50864 \u51452 \u51032  \u53685 \u52824 \u51088 \u44760 \u49436  \u49324 \u46993 \u51004 \u47196  \u54624  \u49688  \u51080 \u45716  \u52572 \u45824 \u51032  \u55148 \u49373 \u51012  \u54616 \u49888  \u44163 \u51060  \u45208 \u53440 \u45228 \u45796 . \u50780 \u45264 \u54616 \u47732  \'93\u54616 \u45208 \u45784 \u44760 \u49436  \u44536 \u47532 \u49828 \u46020  \u50504 \u50640  \u44228 \u49884 \u49324  \u49464 \u49345 \u51012  \u51088 \u44592 \u50752  \u54868 \u47785 \u54616 \u44172  \u54616 \'94 (\u44256 \u54980  5:19) \u49512 \u44592  \u46412 \u47928 \u51060 \u45796 . \u46608 \u54620  \u47336 \u49828 \u48296 \u51008  \u50689 \u44305 \u44284  \u52572 \u49345 \u44428 \u51012  \u50619 \u44592  \u50948 \u54616 \u50668  \u51396 \u44032  \u46308 \u50612 \u50724 \u46020 \u47197  \u47928 \u51012  \u50676 \u50612  \u45459 \u51008  \u48152 \u47732 , \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u51396 \u47484  \u47736 \u54616 \u44592  \u50948 \u54616 \u50668  \u49828 \u49828 \u47196  \u45230 \u52628 \u49884 \u44256  \u51453 \u44592 \u44620 \u51648  \u48373 \u51333 \u54616 \u49888  \u44163 \u51060  \u46300 \u47084 \u45228 \u45796 .\
