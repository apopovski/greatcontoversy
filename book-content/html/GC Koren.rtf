\uc0\u51652 \u47532 \u51032  \u48731 \u51008  \u48372 \u54756 \u48120 \u50500 \u50640 \u49436  \u46021 \u51068 \u47196  \u51204 \u54028 \u46104 \u50632 \u45796 . \u50780 \u45264 \u54616 \u47732  \u54532 \u46972 \u54616  \u45824 \u54617 \u51032  \u49548 \u46041 \u51004 \u47196  \u49688 \u48177  \u47749 \u51032  \u46021 \u51068  \u54617 \u49373 \u46308 \u51060  \u44256 \u44397 \u51004 \u47196  \u46028 \u50500 \u44052 \u44592  \u46412 \u47928 \u51060 \u50632 \u45796 . \u44536 \u46308  \u51473 \u51032  \u47566 \u51008  \u54617 \u49373 \u46308 \u51060  \u54980 \u49828 \u50640 \u44172 \u49436  \u52376 \u51020 \u51004 \u47196  \u49457 \u44221 \u51032  \u51648 \u49885 \u51012  \u48176 \u50912 \u45716 \u45936 , \u44536 \u46308 \u51008  \u46028 \u50500 \u44032 \u49436  \u44033 \u51088  \u51088 \u44592  \u45208 \u46972 \u51032  \u50668 \u47084  \u44275 \u50640  \u48373 \u51020 \u51012  \u51204 \u54028 \u54616 \u50688 \u45796 .\
\uc0\u54532 \u46972 \u54616 \u50640 \u49436  \u51068 \u50612 \u45212  \u51068 \u50640  \u45824 \u54620  \u49548 \u49885 \u51060  \u47196 \u47560 \u50640  \u51204 \u54644 \u51648 \u51088  \u54980 \u49828 \u45716  \u44263  \u48277 \u50773 \u51032  \u49548 \u54872  \u47749 \u47161 \u51012  \u48155 \u50520 \u45796 . \u44536  \u47749 \u47161 \u50640  \u51025 \u54616 \u45716  \u44163 \u51008  \u51088 \u44592 \u51032  \u47800 \u51012  \u51453 \u51020 \u50640  \u45236 \u50612  \u51452 \u45716  \u44163 \u51060 \u50632 \u45796 . \u44536 \u47084 \u48064 \u47196  \u48372 \u54756 \u48120 \u50500 \u51032  \u50773 \u44284  \u50773 \u54980 \u50752  \u45824 \u54617 \u44284  \u44480 \u51313 \u44284  \u51221 \u48512 \u51032  \u44256 \u44288 \u46308 \u51060  \u50672 \u54633 \u54616 \u50668  \u54980 \u49828 \u45716  \u54532 \u46972 \u54616 \u50640  \u47672 \u47932 \u47084  \u51080 \u44172  \u54616 \u44256 , \u45824 \u47532 \u51088 \u47484  \u47196 \u47560 \u50640  \u54028 \u44204 \u49884 \u53020  \u45824 \u45813 \u54616 \u46020 \u47197  \u54728 \u46973 \u54644  \u45804 \u46972 \u44256  \u48277 \u50773 \u50640 \u44172  \u50528 \u49548 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u48277 \u50773 \u51008  \u44536  \u50836 \u44396 \u47484  \u49688 \u46973 \u54616 \u45716  \u45824 \u49888 \u50640  \u46020 \u47532 \u50612  \u54980 \u49828 \u50640 \u44172  \u45824 \u54616 \u50668 \u45716  \u49900 \u47928  \u49440 \u44256 \u47484  \u45236 \u47532 \u44256  \u54532 \u46972 \u54616  \u49884 \u47484  \u54028 \u47928  (\u30772 \u38272 ) \u50640  \u52376 \u54620 \u45796 \u44256  \u49440 \u54252 \u54616 \u50688 \u45796 .\
\uc0\u44536  \u45817 \u49884 \u50640  \u51080 \u50612 \u49436  \u51060 \u50752  \u44057 \u51008  \u49440 \u44256 \u45716  \u50616 \u51228 \u45208  \u53360  \u44277 \u54252 \u47484  \u51068 \u51004 \u53040 \u45796 . \u44144 \u44592 \u50640  \u46384 \u47476 \u45716  \u51032 \u49885 \u46308 \u51008  \u48277 \u50773 \u51012  \u54616 \u45208 \u45784 \u51032  \u45824 \u54364 \u51088 \u47196  \u51316 \u44221 \u54616 \u44256 , \u44536 \u47484  \u52380 \u44397 \u44284  \u51648 \u50725 \u51032  \u50676 \u49632 \u47484  \u44032 \u51648 \u44256  \u50689 \u51201  \u49900 \u54032 \u51008  \u47932 \u47200 \u51060 \u50836 , \u49464 \u49549 \u51201  \u49900 \u54032 \u44620 \u51648  \u54665 \u54624  \u44428 \u45733 \u51012  \u44032 \u51652  \u51088 \u47196  \u50508 \u44256  \u51080 \u45716  \u48177 \u49457 \u46308 \u51012  \u44277 \u54252 \u50640  \u51656 \u47532 \u44172  \u54624  \u49688  \u51080 \u46020 \u47197  \u51096  \u44984 \u47728 \u51276 \u45796 . \u54028 \u47928 \u51032  \u49440 \u44256 \u47484  \u48155 \u51008  \u51648 \u48169 \u50640 \u45716  \u54616 \u45720 \u51032  \u47928 \u51060  \u45803 \u54784 \u51648 \u48064 \u47196  \u48277 \u50773 \u51060  \u44536 \u44163 \u51012  \u50676 \u44592 \u44620 \u51648 \u45716  \u51453 \u51008  \u51088 \u44032  \u52380 \u44397 \u50640  \u46308 \u50612 \u44032 \u51648  \u47803 \u54616 \u44172  \u46108 \u45796 \u44256  \u48127 \u50632 \u45796 . \u44536 \u47532 \u44256  \u51060 \u52376 \u47100  \u46160 \u47140 \u50868  \u51116 \u45212 \u51032  \u51613 \u44144 \u47196 \u49436  \u50728 \u44054  \u51333 \u44368 \u51201  \u51032 \u49885 \u51008  \u51221 \u51648 \u46104 \u44256 , \u44368 \u54924 \u45716  \u54224 \u49604 \u46104 \u44256 , \u44208 \u54844 \u49885 \u51008  \u44368 \u54924 \u45817 \u51032  \u46896  \u50526 \u50640 \u49436  \u44144 \u54665 \u46104 \u44256 , \u51453 \u51008  \u51088 \u45716  \u49457 \u48324 \u46108  \u47896 \u51648 \u50640  \u47588 \u51109 \u46104 \u51648  \u47803 \u54616 \u44256  \u51109 \u47168 \u49885  \u50630 \u51060  \u46020 \u46993 \u51060 \u45208  \u48268 \u54032 \u50640  \u47588 \u51109 \u46104 \u50632 \u45796 . \u47196 \u47560 \u45716  \u49324 \u46988 \u51032  \u49345 \u49345 \u47141 \u50640  \u51088 \u44537 \u51012  \u51452 \u45716  \u51060 \u47088  \u51333 \u47448 \u51032  \u52376 \u49324 \u47484  \u53685 \u54616 \u50668  \u49324 \u46988 \u51032  \u50577 \u49900 \u51012  \u51648 \u48176 \u54616 \u44256 \u51088  \u54616 \u50688 \u45796 .\
\uc0\u54532 \u46972 \u54616 \u50640 \u45716  \u53360  \u49548 \u46041 \u51060  \u51068 \u50612 \u45228 \u45796 . \u47566 \u51008  \u49324 \u46988 \u46308 \u51060  \u51060 \u47084 \u54620  \u51116 \u45212 \u51012  \u47564 \u45212  \u44163 \u51008  \u50724 \u47196 \u51648  \u54980 \u49828  \u46412 \u47928 \u51060 \u46972 \u44256  \u44536 \u47484  \u44508 \u53444 \u54616 \u50688 \u45796 . \u44536 \u47532 \u44256  \u47196 \u47560 \u51032  \u51669 \u48268 \u50640  \u49888 \u49549 \u55176  \u45336 \u44592 \u46972 \u44256  \u50836 \u44396 \u54616 \u50688 \u45796 . \u49548 \u46041 \u51012  \u51652 \u51221 \u49884 \u53412 \u44592  \u50948 \u54616 \u50668  \u54980 \u49828 \u45716  \u51104 \u49884  \u46041 \u50504  \u44256 \u54693 \u51004 \u47196  \u46028 \u50500 \u44032  \u51080 \u50632 \u45796 . \u54532 \u46972 \u54616 \u50640  \u45224 \u44200  \u45459 \u44256  \u50728  \u52828 \u44396 \u46308 \u50640 \u44172  \u44536 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u54200 \u51648 \u47484  \u48372 \u45256 \u45796 . \'93\u45236 \u44032  \u44536 \u45824 \u46308 \u51012  \u46496 \u45208 \u50728  \u44163 \u51008  \u45208 \u49244  \u47560 \u51020 \u51012  \u54408 \u51008  \u51088 \u46308 \u50640 \u44172  \u50689 \u50896 \u54620  \u51396 \u51032  \u49440 \u44256 \u47484  \u51088 \u52712 \u54616 \u51648  \u50506 \u46020 \u47197  \u54616 \u44256 , \u44221 \u44148 \u54620  \u49324 \u46988 \u46308 \u50640 \u44172 \u45716  \u44256 \u45212 \u44284  \u48149 \u54644 \u44032  \u51060 \u47476 \u51648  \u50506 \u46020 \u47197  \u54616 \u44592  \u50948 \u54616 \u50668  \u50696 \u49688 \u45784 \u51032  \u44368 \u54984 \u44284  \u47784 \u48376 \u51012  \u46384 \u46972 \u49436  \u54665 \u54620  \u44163 \u49104 \u51060 \u45796 . \u44536 \u47532 \u44256  \u45208 \u45716  \u44221 \u44148 \u52824  \u50506 \u51008  \u49888 \u48512 \u46308 \u51060  \u44536 \u45824 \u46308  \u44032 \u50868 \u45936 \u49436  \u45908  \u50724 \u47019 \u46041 \u50504  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51012  \u44228 \u49549 \u54616 \u50668  \u44552 \u51648 \u54624 \u51648 \u46020  \u47784 \u47480 \u45796 \u44256  \u50684 \u47140 \u54620  \u45208 \u47672 \u51648  \u51104 \u49884  \u46041 \u50504  \u47932 \u47084 \u45208 \u50728  \u44163 \u49104 \u51060 \u45796 . \u45208 \u45716  \u44144 \u47337 \u54620  \u51652 \u47532 \u47484  \u44144 \u51208 \u54616 \u48064 \u47196  \u44536 \u45824 \u46308 \u51012  \u46496 \u45208 \u50728  \u44163 \u51060  \u50500 \u45768 \u45796 . \u45208 \u45716  \u54616 \u45208 \u45784 \u51032  \u46020 \u50864 \u49900 \u51004 \u47196  \u51652 \u47532 \u47484  \u50948 \u54616 \u50668 \u49436 \u45716  \u51453 \u51020 \u46020  \u49324 \u50577 \u52824  \u50500 \u45768 \u54620 \u45796 \'94 (Bonnechose, The Refor-mers Before the Reformation, vol.1, p.87). \u44536 \u47084 \u45208  \u54980 \u49828 \u45716  \u51088 \u44592 \u51032  \u54876 \u46041 \u51012  \u44536 \u52824 \u51648  \u50500 \u45768 \u54616 \u44256  \u44033 \u51648 \u47196  \u45796 \u45768 \u47728  \u51652 \u47532 \u47484  \u44040 \u44553 \u54616 \u45716  \u49324 \u46988 \u46308 \u50640 \u44172  \u48373 \u51020 \u51012  \u51204 \u54616 \u50688 \u45796 . \u48277 \u50773 \u51060  \u48373 \u51020 \u51012  \u44048 \u52628 \u50612  \u48260 \u47532 \u44256 \u51088  \u52712 \u54620  \u51312 \u52824 \u45716  \u46020 \u47532 \u50612  \u44536 \u44163 \u51012  \u45908  \u45328 \u47532  \u51204 \u54028 \u54616 \u45716  \u48169 \u54200 \u51060  \u46104 \u50632 \u45796 . \'93\u50864 \u47532 \u45716  \u51652 \u47532 \u47484  \u44144 \u49828 \u47140  \u50500 \u47924 \u44163 \u46020  \u54624  \u49688  \u50630 \u44256  \u50724 \u51649  \u51652 \u47532 \u47484  \u50948 \u54624  \u49104 \u51060 \'94 (\u44256 \u54980  13:8) \u45796 .\
\'93\uc0\u44536  \u45817 \u49884 \u51032  \u54980 \u49828 \u51032  \u47560 \u51020 \u50640 \u45716  \u51068 \u51333 \u51032  \u48264 \u48124 \u51060  \u51080 \u50632 \u51012  \u44163 \u51060 \u45796 . \u48708 \u47197  \u44368 \u54924 \u45716  \u50948 \u54801 \u51004 \u47196  \u44536 \u47484  \u50613 \u45572 \u47476 \u44256 \u51088  \u54664 \u51648 \u47564 , \u44536 \u45716  \u50500 \u51649 \u44620 \u51648  \u44368 \u54924 \u51032  \u44428 \u50948 \u47484  \u48512 \u51064 \u54616 \u51648  \u50506 \u50520 \u45796 . \u44536 \u50640 \u44172  \u51080 \u50612 \u49436  \u47196 \u47560  \u44368 \u54924 \u45716  \u50668 \u51204 \u55176  \u44536 \u47532 \u49828 \u46020 \u51032  \u48176 \u50864 \u51088 \u50836 , \u48277 \u50773 \u51008  \u54616 \u45208 \u45784 \u51032  \u45824 \u54364 \u51088 \u50836  \u45824 \u47532 \u51088 \u50688 \u45796 . \u54980 \u49828 \u44032  \u49912 \u50880 \u51032  \u45824 \u49345 \u51004 \u47196  \u49340 \u44256  \u51080 \u45716  \u44163 \u51008  \u44428 \u50948 \u51032  \u50501 \u50857 \u51060 \u50632 \u51648  \u50896 \u52825  \u44536  \u51088 \u52404 \u45716  \u50500 \u45768 \u50632 \u45796 . \u51060  \u49324 \u49892 \u51008  \u44536 \u44032  \u44032 \u51648 \u44256  \u51080 \u45716  \u49888 \u45392 \u44284  \u44536 \u51032  \u50577 \u49900 \u51032  \u51452 \u51109  \u49324 \u51060 \u50640  \u47924 \u49436 \u50868  \u44040 \u46321 \u51012  \u51068 \u51004 \u53040 \u45796 . \u51088 \u44592 \u44032  \u44536 \u47111 \u45796 \u44256  \u48127 \u51008  \u45824 \u47196  \u47196 \u47560 \u44368 \u51032  \u44428 \u50948 \u44032  \u51221 \u45817 \u54616 \u44256  \u44536 \u47495 \u46120 \u51060  \u50630 \u45716  \u44163 \u51060 \u46972 \u47732  \u50612 \u52236 \u54616 \u50668  \u44144 \u44592 \u50640  \u48520 \u49692 \u51333 \u54644 \u50556  \u54620 \u45796 \u44256  \u45712 \u44788 \u51648 \u45716 \u44032 ? \u44536 \u45716  \u48373 \u51333 \u54616 \u45716  \u44163 \u51060  \u51396 \u44032  \u46108 \u45796 \u45716  \u49324 \u49892 \u51012  \u44648 \u45804 \u5