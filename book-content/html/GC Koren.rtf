\uc0\u50864 \u47532 \u45716  \u49457 \u44221 \u51012  \u50672 \u44396 \u54616 \u45716  \u51068 \u50640  \u51221 \u49888 \u47141 \u51012  \u45796  \u49324 \u50857 \u54616 \u44256  \u54616 \u45208 \u45784 \u51032  \u50724 \u47896 \u47484  \u51060 \u54644 \u54616 \u44592  \u50948 \u54616 \u50668  \u49324 \u46988 \u51004 \u47196  \u54624  \u49688  \u51080 \u45716  \u45936 \u44620 \u51648  \u50864 \u47532 \u51032  \u51060 \u54644 \u47141 \u51012  \u50024 \u50556  \u54620 \u45796 . \u44536 \u47084 \u45208  \u50612 \u47536 \u50500 \u51060 \u44057 \u51060  \u50728 \u49692 \u54616 \u44256  \u49692 \u51333 \u54616 \u45716  \u47560 \u51020 \u51060  \u48176 \u50864 \u45716  \u51088 \u51032  \u51652 \u51221 \u54620  \u51221 \u49888 \u51076 \u51012  \u51082 \u50612 \u49436 \u45716  \u50504  \u46108 \u45796 . \u49457 \u44221 \u49345  \u50612 \u47140 \u50868  \u47928 \u51228 \u46308 \u51008  \u52384 \u54617 \u51201 \u51064  \u47928 \u51228 \u46308 \u51012  \u51060 \u54644 \u54616 \u44592  \u50948 \u54616 \u50668  \u49324 \u50857 \u54616 \u45716  \u44163 \u44284  \u46041 \u51068 \u54620  \u48169 \u48277 \u51004 \u47196 \u45716  \u44208 \u53076  \u54644 \u44208 \u54624  \u49688  \u50630 \u45796 . \u50864 \u47532 \u45716  \u44284 \u54617 \u51032  \u48516 \u50556 \u50640 \u49436  \u47566 \u51008  \u49324 \u46988 \u46308 \u51060  \u44036 \u51649 \u54616 \u45716  \u44163 \u44284  \u46041 \u51068 \u54620  \u51088 \u48512 \u49900 \u51012  \u44032 \u51648 \u44256  \u49457 \u44221 \u51012  \u50672 \u44396 \u54644 \u49436 \u45716  \u50504  \u46108 \u45796 . \u50724 \u55176 \u47140  \u50864 \u47532 \u45716  \u54616 \u45208 \u45784 \u44760  \u44221 \u44148 \u54616 \u44172  \u51032 \u51648 \u54616 \u44256  \u54616 \u45208 \u45784 \u51032  \u46907 \u51012  \u50508 \u44256 \u51088  \u54616 \u45716  \u51652 \u51221 \u54620  \u49548 \u50896 \u51012  \u44032 \u51648 \u44256  \u50672 \u44396 \u54644 \u50556  \u54620 \u45796 . \u50864 \u47532 \u45716  \u44216 \u49552 \u54616 \u44256  \u44032 \u47476 \u