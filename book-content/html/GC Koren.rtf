\uc0\u54616 \u45720  \u49457 \u49548 \u45716  \u51648 \u49345  \u49457 \u49548 \u47484  \u53685 \u54616 \u50668  \u46160  \u52856 \u51004 \u47196  \u46104 \u50612  \u51080 \u45716  \u44163 \u51004 \u47196  \u45208 \u53440 \u45208  \u51080 \u45796 . \u49324 \u46020  \u50836 \u54620 \u51060  \u44228 \u49884  \u51473 \u50640  \u54616 \u45720 \u50640  \u51080 \u45716  \u54616 \u45208 \u45784 \u51032  \u51204 \u51012  \u48372 \u46020 \u47197  \u54728 \u46973 \u46104 \u50632 \u51012  \u46412  \u44536 \u45716  \u44144 \u44592 \u49436  \'93\u51068 \u44273  \u46321 \u48520  \u53024  \u44163 \'94 (\u44228  4:5) \u51012  \u48372 \u50520 \u45796 . \u44536 \u45716  \u46608 \u54620  \u54620  \u52380 \u49324 \u44032  \'93\u44552 \u54693 \u47196 \u47484  \u44032 \u51648 \u44256  \u47566 \u51008  \u54693 \u51012  \u48155 \u44256 \'85\u47784 \u46304  \u49457 \u46020 \u51032  \u44592 \u46020 \u46308 \u44284  \u54633 \u54616 \u50668  \u48372 \u51340  \u50526  \u44552 \u45800 \u50640 \'94 (\u44228  8:3) \u45459 \u45716  \u44163 \u51012  \u48372 \u50520 \u45796  \u50668 \u44592 \u50640 \u49436  \u49440 \u51648 \u51088 \u45716  \u54616 \u45720 \u50640  \u51080 \u45716  \u49457 \u49548 \u51032  \u52395 \u51704  \u52856 \u51012  \u48372 \u46020 \u47197  \u54728 \u46973 \u46104 \u50632 \u45796 . \u44536 \u47532 \u44256  \u44536 \u45716  \u44144 \u44592 \u49436  \'93\u51068 \u44273  \u46321 \u48520  \u53024  \u44163 \'94\u44284  \u54693 \u45800 \u51012  \u48372 \u50520 \u45716 \u45936 , \u44536 \u44163 \u46308 \u51008  \u51648 \u49345  \u49457 \u49548 \u50640 \u49436  \u44552 \u46321 \u45824 \u50752  \u54693 \u45800 \u51004 \u47196  \u54364 \u49884 \u46108  \u44163 \u46308 \u51060 \u50632 \u45796 . \u50836 \u54620 \u51008  \u46608 \u54620  \'93\u54616 \u45720 \u50640  \u51080 \u45716  \u54616 \u45208 \u45784 \u51032  \u49457 \u51204 \u51060  \u50676 \u47532 \'94 (\u44228  11:19) \u45716  \u44305 \u44221 \u51012  \u48372 \u50520 \u45796 . \u44536 \u45716  \u44536  \u46412 \u50640  \u55064 \u51