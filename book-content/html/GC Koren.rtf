\f0\b \cf0 \uc0\u49901 \u51088 \u44400 \u51032  \u54028 \u47736 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u49688 \u45380  \u54980 \u50640  \u45796 \u47480  \u48277 \u50773 \u51060  \u49901 \u51088 \u44400 \u51012  \u45796 \u49884  \u51068 \u51004 \u53040 \u45796 . \u51204 \u44284  \u44057 \u51060  \u44400 \u45824 \u50752  \u51088 \u44552 \u51060  \u48277 \u50773 \u44428  \u54616 \u50640  \u51080 \u45716  \u50728  \u50976 \u47101  \u44033 \u44397 \u50640 \u49436  \u51669 \u51665 \u46104 \u50632 \u45796 . \u51060  \u50948 \u54744 \u54620  \u51068 \u50640  \u44032 \u45812 \u49884 \u53412 \u44256 \u51088  \u44428 \u50976 \u54616 \u45716  \u50868 \u46041 \u51060  \u53356 \u44172  \u51204 \u44060 \u46104 \u50632 \u45796 . \u49901 \u51088 \u44400 \u50640  \u52280 \u44032 \u54616 \u45716  \u51088 \u45716  \u45572 \u44396 \u46304 \u51648  \u50500 \u47924 \u47532  \u44032 \u51613 \u54620  \u51396 \u47484  \u48276 \u54616 \u50668 \u46020  \u50756 \u51204 \u55176  \u50857 \u49436 \u48155 \u45716 \u45796 \u45716  \u44163 \u51060  \u48372 \u51613 \u46104 \u50632 \u45796 . \u51204 \u51137 \u50640 \u49436  \u51453 \u45716  \u51088 \u46308 \u51008  \u54616 \u45720 \u50640 \u49436 \u51032  \u53360  \u49345 \u51060  \u50557 \u49549 \u46104 \u50632 \u44256  \u49332 \u50500 \u45224 \u45716  \u51088 \u46308 \u51008  \u44536  \u51204 \u51137 \u53552 \u50640 \u49436  \u47749 \u50696 \u50752  \u51116 \u47932 \u51012  \u50619 \u44172  \u46112  \u44163 \u51060 \u46972 \u44256  \u48372 \u51613 \u46104 \u50632 \u45796 . \u45796 \u49884 \u44552  \u45824 \u44400 \u51060  \u51669 \u47784 \u46104 \u50612  \u44397 \u44221 \u51012  \u45336 \u50612  \u48372 \u54756 \u48120 \u50500 \u47196  \u52432 \u46308 \u50612 \u50772 \u45796 . \u54980 \u49828 \u51032  \u49888 \u48393 \u51088 \u46308 \u51008  \u44536  \u45824 \u44400  \u50526 \u50640 \u49436  \u53748 \u44033 \u54616 \u50668  \u52840 \u47029 \u51088 \u46308 \u51012  \u44397 \u45236 \u47196  \u44618 \u49689 \u51060  \u50976 \u51064 \u54616 \u50668  \u46308 \u51060 \u44256 , \u44536 \u46308 \u47196  \u54616 \u50668 \u44552  \u51060 \u48120  \u49849 \u47532 \u54620  \u51460 \u47196  \u49373 \u44033 \u54616 \u44172  \u54616 \u50688 \u45796 . \u46300 \u46356 \u50612  \u54532 \u47196 \u53076 \u54588 \u50864 \u49828 \u51032  \u44400 \u45824 \u45716  \u53748 \u44033 \u51012  \u51221 \u51648 \u54616 \u44256 , \u50896 \u49688 \u46308 \u51012  \u54693 \u54616 \u50668  \u46028 \u50500 \u49436 \u49436  \u44536 \u46308 \u50640 \u44172  \u49912 \u50880 \u51012  \u44152 \u50632 \u45796 . \u49901 \u51088 \u44400 \u51008  \u44536 \u51228 \u50556  \u44536 \u46308 \u51032  \u49892 \u52293 \u51012  \u44648 \u45803 \u44256 , \u44400 \u45824 \u47484  \u47688 \u52628 \u44256  \u44536  \u51088 \u47532 \u50640 \u49436  \u51201 \u44400 \u51060  \u44277 \u44201 \u54644  \u50724 \u44592 \u47484  \u44592 \u45796 \u47532 \u44256  \u51080 \u50632 \u45796 . \u44536 \u47088 \u45936  \u49901 \u51088 \u44400 \u46308 \u51008  \u51201 \u44400 \u51060  \u51217 \u44540 \u54644 \u50724 \u45716  \u49548 \u47532 \u47484  \u46307 \u51088  \u54980 \u49828 \u54028 \u51032  \u44400 \u45824 \u47484  \u48372 \u44592 \u46020  \u51204 \u50640  \u45796 \u49884  \u44277 \u54252 \u50640  \u55081 \u49912 \u50688 \u45796 . \u50773 \u51313 \u46308 \u44284  \u51109 \u44400 \u46308 \u44284  \u51068 \u48152  \u44400 \u49324 \u46308 \u51008  \u44536 \u46308 \u51032  \u47924 \u44592 \u47484  \u45236 \u50612  \u48260 \u47532 \u44256  \u49324 \u48169 \u51004 \u47196  \u46020 \u47581 \u54616 \u50688 \u45796 . \u52840 \u47029 \u44400 \u51032  \u52509 \u51648 \u55064 \u51088 \u51064  \u48277 \u50773 \u51032  \u49324 \u51208 \u51008  \u44277 \u54252 \u44048 \u50640  \u45580 \u47140  \u55145 \u50612 \u51652  \u44400 \u49324 \u46308 \u51012  \u47784 \u51004 \u44256 \u51088  \u50528 \u47484  \u50044 \u51648 \u47564  \u54747 \u49688 \u44256 \u50688 \u45796 . \u44536 \u45716  \u50728 \u44054  \u45432 \u47141 \u51012  \u45796  \u54616 \u50688 \u51648 \u47564  \u47560 \u52840 \u45236  \u44536  \u51088 \u49888 \u46020  \u46020 \u47581 \u54616 \u45716  \u47924 \u47532 \u46308 \u50640 \u44172  \u55081 \u50424 \u47140 \u44032 \u44256  \u51080 \u50632 \u45796 . \u52840 \u47029 \u44400 \u51008  \u50756 \u51204 \u55176  \u54056 \u48176 \u45817 \u54616 \u50688 \u44256 , \u47561 \u45824 \u54620  \u51204 \u47532 \u54408 \u51060  \u45796 \u49884  \u49849 \u47532 \u51088 \u51032  \u49552 \u50640  \u46308 \u50612 \u44052 \u45796 .\
\uc0\u51060 \u47532 \u54616 \u50668  \u50976 \u47101 \u51032  \u44032 \u51109  \u44053 \u47141 \u54620  \u45208 \u46972 \u46308 \u47196 \u48512 \u53552  \u54028 \u44204 \u46108  \u50857 \u44048 \u54616 \u44256  \u54840 \u51204 \u51201 \u51060 \u47728 , \u51204 \u51137 \u51012  \u50948 \u54616 \u50668  \u54984 \u47144 \u48155 \u44256  \u47924 \u51109 \u54620  \u47924 \u47532 \u47196  \u51060 \u47336 \u50612 \u51652  \u46160  \u48264 \u51704 \u51032  \u45824 \u44400 \u51008  \u54620  \u48264  \u49912 \u50892  \u48372 \u51648 \u46020  \u47803 \u54620  \u52292  \u54620  \u50672 \u50557 \u54620  \u44397 \u48124 \u51004 \u47196  \u54200 \u49457 \u46108  \u49548 \u49688 \u51032  \u48169 \u50948 \u44400  \u50526 \u50640 \u49436  \u44452 \u47736 \u46104 \u44256  \u47568 \u50520 \u45796 . \u50668 \u44592 \u50640  \u54616 \u45208 \u45784 \u51032  \u45733 \u47141 \u51060  \u45208 \u53440 \u45228 \u45796 . \u52840 \u47029 \u44400 \u51008  \u52488 \u51088 \u50672 \u51201 \u51064  \u44277 \u54252 \u44048 \u50640  \u49324 \u47196 \u51105 \u54804 \u45912  \u44163 \u51060 \u45796 . \u54861 \u54644 \u50640 \u49436  \u48148 \u47196 \u51032  \u44400 \u45824 \u47484  \u44452 \u47736 \u49884 \u53412 \u44256  \u44592 \u46300 \u50728 \u44284  \u49340 \u48177  \u47749 \u51032  \u50857 \u49324  \u50526 \u50640 \u49436  \u48120 \u46356 \u50504  \u44400 \u45824 \u47484  \u46020 \u47581 \u54616 \u44172  \u54616 \u49884 \u47728 , \u54616 \u47355 \u48164  \u49324 \u51060 \u50640  \u44368 \u47564 \u54620  \u50519 \u49884 \u47532 \u50500  \u44400 \u45824 \u47484  \u52432 \u48512 \u49688 \u49888  \u54616 \u45208 \u45784 \u44760 \u49436  \u50613 \u50517 \u51088 \u51032  \u49464 \u47141 \u51012  \u44734 \u51004 \u49884 \u44592  \u50948 \u54616 \u50668  \u45817 \u49888 \u51032  \u49552 \u51012  \u45796 \u49884  \u54620  \u48264  \u54196 \u49512 \u45912  \u44163 \u51060 \u50632 \u45796 . \'93\u51200 \u55148 \u44032  \u46160 \u47140 \u50880 \u51060  \u50630 \u45716  \u44275 \u50640 \u49436  \u53356 \u44172  \u46160 \u47140 \u50892 \u54616 \u50688 \u51004 \u45768  \u45320 \u47484  \u45824 \u54616 \u50668  \u51652  \u52828  \u51200 \u55148 \u51032  \u48904 \u47484  \u54616 \u45208 \u45784 \u51060  \u55145 \u51004 \u49900 \u51060 \u46972  \u54616 \u45208 \u45784 \u51060  \u51200 \u55148 \u47484  \u48260 \u47532 \u49888  \u44256 \u47196  \u45348 \u44032  \u51200 \u55148 \u47196  \u49688 \u52824 \u47484  \u45817 \u52992  \u54616 \u50688 \u46020 \u45796 \'94 (\u49884  53:5).\
\uc0\u48277 \u50773 \u44368 \u51032  \u51648 \u46020 \u51088 \u46308 \u51008  \u47924 \u47141 \u51004 \u47196  \u51221 \u48373 \u54616 \u45716  \u51068 \u51012  \u45800 \u45392 \u54616 \u44256 , \u46300 \u46356 \u50612  \u44428 \u47784 \u49696 \u49688  (\u27402 \u35584 \u34899 \u25976 ) \u47484  \u50416 \u44172  \u46104 \u50632 \u45796 . \u54364 \u47732 \u51004 \u47196 \u45716  \u48372 \u54756 \u48120 \u50500 \u51064 \u46308 \u51032  \u50577 \u49900 \u51032  \u51088 \u50976 \u47484  \u54728 \u46973 \u54616 \u45432 \u46972 \u44256  \u44277 \u50616 \u54616 \u47732 \u49436  \u49892 \u51648 \u47196 \u45716  \u44536 \u46308 \u51012  \u47196 \u47560 \u51032  \u44428 \u47141 \u50640  \u45336 \u44200 \u51452 \u45716  \u53440 \u54801 \u52293 \u51012  \u50416 \u44172  \u46104 \u50632 \u45796 . \u48372 \u54756 \u48120 \u50500  \u49324 \u46988 \u46308 \u51008  \u47196 \u47560 \u50752  \u54868 \u54644 \u54616 \u45716  \u51312 \u44148 \u51004 \u47196  \u45796 \u51020 \u51032  \u45348  \u44032 \u51648  \u51216 \u51012  \u48516 \u47749 \u55176  \u48157 \u54804 \u45796 . \u49457 \u44221 \u51012  \u44053 \u47200 \u54616 \u45716  \u51088 \u50976 , \u47784 \u46304  \u44368 \u51064 \u46308 \u51060  \u49457 \u47564 \u52268  \u50696 \u49885 \u50640  \u52280 \u49437 \u54616 \u50668  \u46497 \u44284  \u54252 \u46020 \u51609 \u51012  \u45208 \u45580  \u49688  \u51080 \u44256  \u50696 \u48176  \u49884 \u44036 \u50640  \u44033 \u44033  \u51088 \u44397 \u50612 \u47484  \u49324 \u50857 \u54624  \u49688  \u51080 \u45716  \u44428 \u47532 , \u49457 \u51649 \u51088 \u44032  \u47784 \u46304  \u49464 \u49549 \u51201 \u51064  \u51649 \u50948 \u50752  \u44428 \u47141 \u50640 \u49436  \u51228 \u50808 \u46104 \u45716  \u51068 , \u48276 \u51396  \u54665 \u50948 \u50640  \u45824 \u54644 \u49436 \u45716  \u51068 \u48152  \u48277 \u51221 \u51032  \u49324 \u48277 \u44428 \u51060  \u49457 \u51649 \u51088 \u45208  \u51068 \u48152 \u51064 \u51012  \u47561 \u47200 \u54616 \u44256  \u46041 \u51068 \u54616 \u44172  \u52712 \u44553 \u54616 \u45716  \u51068  \u46321 \u51060 \u50632 \u45796 . \u46300 \u46356 \u50612  \u48277 \u50773 \u52769 \u51008  \'93\u54980 \u49828 \u51032  \u49888 \u48393 \u51088 \u46308 \u51060  \u51228 \u52636 \u54620  \u45348  \u44032 \u51648  \u51312 \u44148 \u50640  \u46041 \u51032 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536  \u51312 \u47928 \u51032  \u47749 \u54869 \u54620  \u51032 \u48120 \u47484  \u44208 \u51221 \u54616 \u45716  \u54644 \u49437 \u44428 \u51008  \u51333 \u44368  \u54924 \u51032  \u51593  \u48277 \u50773 \u44284  \u54889 \u51228 \u51032  \u44428 \u54620 \u50640  \u49549 \u54616 \u45716  \u44163 \u51060 \u46972 \u44256  \u44508 \u51221 \u54616 \u50688 \u45796 \'94 (Wylie, b.3, ch.18). \u51060 \u47084 \u54620  \u51312 \u44148  \u50500 \u47000  \u51312 \u50557 \u51008  \u47610 \u50612 \u51648 \u44256 , \u47196 \u47560 \u45716  \u53804 \u51137 \u51004 \u47196  \u50619 \u51648  \u47803 \u54620  \u44163 \u51012  \u54728 \u50948 \u50752  \u49324 \u44592 \u47196  \u50619 \u44172  \u46104 \u50632 \u45796 . \u50780 \u45264 \u54616 \u47732  \u44536 \u46308 \u51008  \u54980 \u49828 \u51032  \u49888 \u48393 \u51088 \u46308 \u51060  \u51228 \u49884 \u54620  \u51312 \u44148 \u46308 \u50640  \u45824 \u54616 \u50668 \u49436 \u46020  \u49457 \u44221 \u50640  \u45824 \u54644 \u49436  \u44536 \u47084 \u54664 \u45912  \u44163 \u52376 \u47100  \u51200 \u46308 \u51060  \u46021 \u51088 \u51201 \u51064  \u54644 \u49437 \u51012  \u45236 \u47548 \u51004 \u47196 \u50024  \u44536 \u46308  \u51088 \u49888 \u51032  \u47785 \u51201 \u50640  \u48512 \u54633 \u54616 \u46020 \u47197  \u44536  \u51312 \u47928 \u46308 \u51032  \u51032 \u48120 \u47484  \u50780 \u44257 \u49884 \u53420  \u49688  \u51080 \u50632 \u44592  \u46412 \u47928 \u51060 \u50632 \u45796 .\
\uc0\u45824 \u48512 \u48516 \u51032  \u48372 \u54756 \u48120 \u50500 \u51064 \u46308 \u51008  \u44536  \u51312 \u50557 \u51060  \u44536 \u46308 \u51032  \u51088 \u50976 \u47484  \u48149 \u53448 \u54616 \u45716  \u44163 \u51060 \u46972 \u44256  \u49373 \u44033 \u54616 \u50688 \u51004 \u48064 \u47196  \u44536 \u44163 \u50640  \u46041 \u51032 \u54624  \u49688  \u50630 \u50632 \u45796 . \u44536 \u47532 \u54616 \u50668  \u48520 \u54868 \u50752  \u48516 \u50676 \u51060  \u49373 \u44592 \u44256  \u45208 \u51473 \u50640 \u45716  \u53804 \u51137 \u44284  \u50976 \u54792  \u49324 \u53468 \u44620 \u51648  \u48730 \u50612 \u51276 \u45796 . \u51060  \u45236 \u46976 \u51004 \u47196  \u51064 \u54616 \u50668  \u44256 \u49345 \u54620  \u54532 \u47196 \u53076 \u54588 \u50864 \u49828  \u51109 \u44400 \u51008  \u51453 \u44256 , \u48372 \u54756 \u48120 \u50500 \u51064 \u51032  \u51088 \u50976 \u45716  \u50630 \u50612 \u51276 \u45796 .\
\uc0\u54980 \u49828 \u50752  \u51228 \u47212 \u51012  \u48176 \u48152 \u54620  \u49884 \u44592 \u49828 \u47928 \u53944 \u44032  \u48372 \u54756 \u48120 \u50500 \u51032  \u50773 \u51060  \u46104 \u50632 \u51004 \u47728 , \u44536 \u45716  \u48372 \u54756 \u48120 \u50500 \u51064 \u51032  \u44428 \u47532 \u47484  \u50745 \u54840 \u54616 \u44192 \u45432 \u46972 \u44256  \u54620  \u51088 \u49888 \u51032  \u49436 \u50557 \u50640 \u46020  \u48520 \u44396 \u54616 \u44256  \u48277 \u50773 \u44428 \u51032  \u54869 \u47549 \u50640  \u51652 \u47141 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u44032  \u47196 \u47560 \u47484  \u52628 \u51333 \u54616 \u48064 \u47196  \u50619 \u51008  \u44163 \u51008  \u48324 \u47196  \u50630 \u50632 \u45796 . 20\u45380 \u44036 \u51032  \u44536 \u51032  \u49373 \u50528 \u45716  \u49688 \u44256 \u50752  \u50948 \u54744 \u51004 \u47196  \u52649 \u47564 \u54616 \u50688 \u45796 . \u50724 \u47019 \u46041 \u50504 \u51032  \u50424 \u45936 \u50630 \u45716  \u51204 \u53804 \u47196  \u44536 \u51032  \u44400 \u45824 \u45716  \u49632 \u51092 \u54616 \u50668 \u51276 \u44256 , \u44536 \u51032  \u51116 \u47932 \u51008  \u44256 \u44040 \u46104 \u50632 \u45796 . \u44536 \u45716  1\u45380 \u51012  \u53685 \u52824 \u54620  \u54980 \u50640  \u44397 \u44032 \u47484  \u45236 \u46976  \u51068 \u48372  \u51649 \u51204 \u50640  \u48260 \u47140 \u46164  \u52292  \u48520 \u47749 \u50696 \u47196  \u45209 \u51064 \u52237 \u55180  \u51060 \u47492 \u51012  \u54980 \u49552 \u46308 \u50640 \u44172  \u47932 \u47140 \u51452 \u47732 \u49436  \u51453 \u50632 \u45796 .\
