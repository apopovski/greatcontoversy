\u51032  \u47800 \u50640 \u49436  \u45572 \u44032  \u45208 \u47484  \u44148 \u51256 \u45236 \u47028 \'94\u44256  \u48512 \u47476 \u51670 \u50632 \u45796 . \u49324 \u46988 \u46308 \u51032  \u51396 \u47484  \u50948 \u54616 \u50668  \u47924 \u54620 \u54620  \u55148 \u49373 \u51012  \u51648 \u48520 \u54620  \u44040 \u48148 \u47532 \u51032  \u49901 \u51088 \u44032 \u44032  \u48516 \u47749 \u55176  \u45208 \u53440 \u45208 \u51088  \u44536 \u46308 \u51008  \u44536 \u47532 \u49828 \u46020 \u51032  \u44277 \u47196 \u47564 \u51060  \u44536 \u46308 \u51032  \u51396 \u47484  \u52649 \u48516 \u55176  \u49549  (\u36118 ) \u54624  \u49688  \u51080 \u44256 , \u46608 \u54620  \u54616 \u45208 \u45784 \u44284  \u49324 \u46988 \u51012  \u54868 \u47785 \u54616 \u44172  \u54624  \u49688  \u51080 \u51020 \u51012  \u44648 \u45804 \u50520 \u45796 . \u44536 \u46308 \u51008  \u48127 \u51020 \u44284  \u44216 \u49552 \u51004 \u47196  \u49464 \u49345  \u51396 \u47484  \u51648 \u44256  \u44032 \u45716  \u54616 \u45208 \u45784 \u51032  \u50612 \u47536 \u50577 \u51012  \u48155 \u50500 \u46308 \u50688 \u45796 . \u44536 \u47532 \u49828 \u46020 \u51032  \u54588 \u47196  \u47568 \u48120 \u50516 \u50500  \u44536 \u46308 \u51008  \'93\u51204 \u50640  \u51648 \u51008  \u51396 \u47484  \u44036 \u44284 \u54616 \u49900 \'94\u51012  \u48155 \u50520 \u45796 .\
\uc0\u44536  \u49324 \u46988 \u46308 \u51008  \u54924 \u44060 \u50640  \u54633 \u45817 \u54620  \u50676 \u47588 \u47484  \u47610 \u50632 \u45796 . \u44536 \u46308 \u51008  \u48127 \u44256  \u52840 \u47168 \u47484  \u48155 \u50520 \u51004 \u47728 , \u44536 \u47532 \u49828 \u46020  \u50504 \u50640 \u49436  \u49352 \u47196 \u50868  \u54588 \u51312 \u47932 \u51060  \u46104 \u50612  \u49352  \u49373 \u50528 \u47484  \u54616 \u44592  \u50948 \u54616 \u50668  \u51068 \u50612 \u45228 \u45796 . \u44536 \u46308 \u51008  \u51204 \u50640  \u54665 \u54616 \u45912  \u44536 \u46308 \u51032  \u51221 \u50837 \u51012  \u46384 \u46972  \u51088 \u44592  \u51088 \u49888 \u46308 \u51012  \u44852  \u51667 \u51648  \u50506 \u44256  \u54616 \u45208 \u45784 \u51032  \u50500 \u46308 \u51012  \u48127 \u45716  \u48127 \u51020 \u51004 \u47196  \u47568 \u48120 \u50516 \u50500  \u51452 \u45784 \u51032  \u48156 \u51088 \u52712 \u47484  \u46384 \u47476 \u44256 , \u51452 \u45784 \u51032  \u54408 \u49457 \u51012  \u48152 \u49324 \u54616 \u47728 , \u44536 \u48516 \u51032  \u44648 \u45143 \u54616 \u49900 \u44284  \u44057 \u51060  \u44536 \u46308  \u51088 \u49888 \u51012  \u44648 \u45143 \u54616 \u44172  \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u51204 \u50640  \u48120 \u50892 \u54616 \u45912  \u44163 \u51012  \u51060 \u51228 \u45716  \u49324 \u46993 \u54616 \u44256 , \u51204 \u50640  \u49324 \u46993 \u54616 \u45912  \u44163 \u51012  \u51060 \u51228 \u45716  \u48120 \u50892 \u54616 \u44172  \u46104 \u50632 \u45796 . \u44368 \u47564 \u54616 \u44256  \u51088 \u44592  \u51452 \u51109 \u47564  \u54616 \u45912  \u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u51060  \u50728 \u50976 \u54616 \u44256  \u44216 \u49552 \u54616 \u44172  \u46104 \u50632 \u45796 . \u54728 \u50689 \u51201 \u51060 \u44256  \u44368 \u47564 \u54620  \u49324 \u46988 \u46308 \u51060  \u52265 \u49892 \u54616 \u44256  \u51312 \u49900 \u49457  \u51080 \u44172  \u46104 \u50632 \u45796 . \u48520 \u44221  (\u63847 \u25964 ) \