\uc0\u50728  \u49464 \u44228 \u47484  \u46041 \u50836 \u49884 \u53416  \u50948 \u45824 \u54620  \u51333 \u44368 \u44060 \u54785 \u51032  \u53360  \u45733 \u47141 \u51008  \u48128 \u49892  (\u23494 \u23460 ) \u51032  \u44592 \u46020 \u50640 \u49436  \u45208 \u50772 \u45796 . \u54616 \u45208 \u45784 \u51032  \u51333 \u46308 \u51008  \u51008 \u48128 \u54620  \u44275 \u50640 \u49436  \u44536 \u48516 \u51032  \u50616 \u50557 \u51032  \u48152 \u49437  \u50948 \u50640  \u53948 \u53948 \u55176  \u49456 \u45796 . \u50500 \u50864 \u53356 \u49828 \u48512 \u47476 \u53356 \u51032  \u53804 \u51137 \u51032  \u46412 \u50640 \u46020  \u47336 \u53552 \u45716  \'93\u51201 \u50612 \u46020  \u54616 \u47336  \u49464  \u49884 \u44036  \u44592 \u46020 \u54616 \u51648  \u50506 \u51008  \u45216 \u51060  \u50630 \u50632 \u45796 . \u44536 \u47532 \u44256  \u44536 \u44163 \u46020  \u50672 \u44396 \u54616 \u44592 \u50640  \u44032 \u51109  \u51339 \u51008  \u49884 \u44036 \u51012  \u44536 \u47111 \u44172  \u54616 \u50688 \u45796 .\'94 \u51008 \u48128 \u54620  \u44536 \u51032  \u48169 \u50640 \u49436  \'93\u51316 \u44221  (\u23562 \u25964 ) \u44284  \u46160 \u47140 \u50880 \u44284  \u55148 \u47581 \u50640  \u45336 \u52824 \u45716  \u47568 \u47196 \u50024  \u47560 \u52824  \u52828 \u44396 \u50752  \u51060 \u50556 \u44592 \u54616 \u46319 \u51060 \'94 \u54616 \u45208 \u45784  \u50526 \u50640  \u44536  \u47560 \u51020 \u51012  \u53664 \u47196 \u54616 \u45716  \u51020 \u49457 \u51012  \u49324 \u46988 \u46308 \u51008  \u46307 \u44172  \u46104 \u50632 \u45796 . \'93\u45817 \u49888 \u51008  \u50864 \u47532  \u50500 \u48260 \u51648 \u49884 \u50836 , \u50864 \u47532  \u54616 \u45208 \u45784 \u51060 \u49884 \u48064 \u47196  \u45817 \u49888 \u51032  \u51088 \u45376 \u51032  \u54605 \u48149 \u51088 \u46308 \u51012  \u55145 \u50612 \u48260 \u47532 \u49892  \u51460 \u51012  \u51060  \u51333 \u51008  \u50508 \u44256  \u51080 \u49845 \u45768 \u45796 . \u51060 \u45716  \u50500 \u48260 \u51648 \u44760 \u49436 \u46020  \u50864 \u47532 \u50752  \u54632 \u44760  \u50612 \u47140 \u50880 \u51012  \u45817 \u54616 \u44256  \u44228 \u49884 \u44592  \u46412 \u47928 \u51077 \u45768 \u45796 . \u51060  \u47784 \u46304  \u51068 \u51008  \u50500 \u48260 \u51648 \u51032  \u49324 \u50629 \u51077 \u45768 \u45796 . \u50864 \u47532 \u45716  \u45796 \u47564  \u50500 \u48260 \u51648 \u51032  \u44053 \u44428 \u50640  \u47803  \u51060 \u44200  \u44536  \u49324 \u50629 \u50640  \u51068 \u54616 \u44172  \u46108  \u44163 \u49104 \u51077 \u45768 \u45796 . \u44536 \u47084 \u48064 \u47196  \u50500 \u48260 \u51648 \u50668 , \u50864 \u47532 \u47484  \u48372 \u54840 \u54644  \u51452 \u50741 \u49548 \u49436 \'94 (D\'92Aubigne, b.14, ch.6).\
\uc0\u47708 \u46976 \u55176 \u53668 \u51060  \u48264 \u48124 \u44284  \u44277 \u54252 \u51032  \u51664 \u50640  \u45580 \u47140  \u51080 \u51012  \u46412 \u50640  \u47336 \u53552 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u54200 \u51648 \u54616 \u50688 \u45796 . \'93\u44536 \u47532 \u49828 \u46020  \u50504 \u50640  \u51080 \u45716  \u51008 \u54812 \u50752  \u54217 \u44053 , \u49464 \u49345 \u50640  \u51080 \u45716  \u44163 \u51060  \u50500 \u45768 \u44256  \u44536 \u47532 \u49828 \u46020  \u50504 \u50640  \u51080 \u45716  \u51008 \u54812 \u50752  \u54217 \u44053 \u51060  \u44536 \u45824 \u50640 \u44172  \u51080 \u44592 \u47484  \u50896 \u54633 \u45768 \u45796 . \u50500 \u47704 . \u45208 \u45716  \u44536 \u45824 \u44032  \u45817 \u54616 \u44256  \u51080 \u45716  \u49900 \u54620  \u50684 \u47140 \u47484  \u47801 \u49884  \u49899 \u50612 \u54633 \u45768 \u45796 . \u47564 \u51068  \u51060  \u49324 \u50629 \u51060  \u51221 \u45817 \u54616 \u51648  \u47803 \u54616 \u44144 \u46304  \u44536 \u44163 \u51012  \u48260 \u47532 \u49901 \u49884 \u50724 . \u47564 \u51068  \u44536  \u49324 \u50629 \u51060  \u51221 \u45817 \u54616 \u45796 \u47732  \u50612 \u52236 \u54616 \u50668  \u50864 \u47532 \u50640 \u44172  \u50684 \u47140  \u47568 \u44256  \u51088 \u46972 \u44256  \u47749 \u47161 \u54616 \u49888  \u51452 \u45784 \u51032  \u54728 \u46973 \u51012  \u48127 \u51648  \u50506 \u49845 \u45768 \u44620 ?\'85\u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u44277 \u51032 \u50752  \u51652 \u47532 \u51032  \u49324 \u50629 \u50640  \u44417 \u54605 \u54616 \u51648  \u50500 \u45768 \u54616 \u49892  \u44163 \u51077 \u45768 \u45796 . \u44536 \u48516 \u44760 \u49436  \u49332 \u50500 \u45208 \u49884 \u44256 , \u44536 \u48516 \u44760 \u49436 \u45716  \u53685 \u52824 \u54616 \u44256  \u44228 \u49901 \u45768 \u45796 . \u44536 \u47111 \u45796 \u47732  \u50864 \u47532 \u44032  \u47924 \u50631  \u46412 \u47928 \u50640  \u46160 \u47140 \u50892 \u54644 \u50556  \u54633 \u45768 \u44620 ?\'94 (D\'92Aubigne, b.14, ch.6).\
\uc0\u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u51333 \u46308 \u51032  \u48512 \u47476 \u51670 \u51020 \u51012  \u46308 \u51004 \u49512 \u45796 . \u44536 \u48516 \u44760 \u49436 \u45716  \u44480 \u51313 \u46308 \u44284  \u47785 \u49324 \u46308 \u50640 \u44172  \u51060  \u50612 \u46176 \u51032  \u49464 \u49345  \u51452 \u44288 \u51088 \u46308 \u51012  \u45824 \u54637 \u54616 \u50668  \u51652 \u47532 \u47484  \u51648 \u53489 \u54624  \u51008 \u54812 \u50752  \u50857 \u44592 \u47484  \u51452 \u49512 \u45796 . \u51452 \u45784 \u44760 \u49436 \u45716  \'93\u48372 \u46972  \u45236 \u44032  \u53469 \u54620  \u48372 \u48176 \u47213 \u44256  \u50836 \u44596 \u54620  \u47784 \u53825 \u51060  \u46028 \u51012  \u49884 \u50728 \u50640  \u46160 \u45432 \u45768  \u51200 \u47484  \u48127 \u45716  \u51088 \u45716  \u48512 \u45124 \u47084 \u50880 \u51012  \u45817 \u52824  \u50500 \u45768 \u54616 \u47532 \u46972 \'94 (\u48295 \u51204  2:6) \u44256  \u47568 \u50432 \u54616 \u49512 \u45796 . \u54532 \u47196 \u53580 \u49828 \u53444 \u53944 \u51032  \u44060 \u54785 \u51088 \u46308 \u51008  \u44536 \u47532 \u49828 \u46020  \u50948 \u50640  \u44204 \u44256 \u55176  \u49456 \u45796 . \u44536 \u47084 \u48064 \u47196  \u51020 \u48512 \u51032  \u44428 \u49464 \u44032  \u44536 \u46308 \u51012  \u51060 \u44600  \u49688  \u50630 \u50632 \u45796 .\
