\uc0\u47336 \u53552 \u44032  \u44060 \u54785 \u51088 \u47196 \u49436  \u51068 \u48152 \u50640 \u44172  \u50508 \u47140 \u51648 \u44592  \u51204 \u50640  \u54532 \u46993 \u49828 \u50640 \u49436 \u45716  \u51060 \u48120  \u45216 \u51060  \u48157 \u50500  \u50724 \u44592  \u49884 \u51089 \u54664 \u45796 . \u48731 \u51012  \u44648 \u45804 \u51008  \u52572 \u52488 \u51032  \u49324 \u46988 \u51008  \u54028 \u47532  \u45824 \u54617 \u51032  \u48149 \u49885 \u54620  \u44368 \u49688  \u47084 \u54168 \u48652 \u47476  (Lefevre) \u50688 \u45716 \u45936 , \u44536 \u45716  \u45208 \u51060  \u47566 \u51008  \u49324 \u46988 \u51004 \u47196 \u49436  \u50676 \u49457 \u51060  \u51080 \u44256  \u51652 \u49892 \u54620  \u48277 \u50773 \u44368 \u46020 \u50688 \u45796 . \u44536 \u45716  \u44256 \u45824  \u47928 \u54617 \u51012  \u50672 \u44396 \u54616 \u45716  \u51473 \u50640  \u49457 \u44221 \u50640  \u47560 \u51020 \u51060  \u45132 \u47160 \u44256 , \u44536 \u44163 \u51012  \u54617 \u49373 \u46308 \u50640 \u44172  \u49548 \u44060 \u54616 \u50688 \u45796 .\
\uc0\u47084 \u54168 \u48652 \u47476 \u45716  \u50676 \u49900  \u51080 \u45716  \u49457 \u46020  \u49709 \u48176 \u51088 \u50688 \u51004 \u47728 , \u44536 \u45716  \u49457 \u46020 \u50752  \u49692 \u44368 \u51088 \u46308 \u51032  \u50669 \u49324 \u47484  \u54200 \u51665 \u54644 \u49436  \u44368 \u54924 \u51032  \u49457 \u46020 \u51204  (\u32854 \u24466 \u20659 ) \u51012  \u47564 \u46308 \u44256 \u51088  \u44228 \u54925 \u54616 \u50688 \u45796 . \u44536  \u51068 \u51008  \u50628 \u52397 \u45212  \u45432 \u47141 \u51060  \u46300 \u45716  \u51068 \u51060 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44536  \u51068 \u51060  \u49345 \u45817 \u55176  \u51652 \u52377 \u46104 \u50632 \u51012  \u46412 \u50640 , \u49457 \u44221 \u50640 \u49436  \u50976 \u47141 \u54620  \u46020 \u50880 \u51012  \u50619 \u51012  \u49688  \u51080 \u51012  \u44163 \u51060 \u46972 \u45716  \u49373 \u44033 \u51060  \u45208 \u49436  \u44536 \u45716  \u44536 \u47088  \u47785 \u51201 \u51004 \u47196  \u49457 \u44221 \u51012  \u50672 \u44396 \u54616 \u44592  \u49884 \u51089 \u54616 \u50688 \u45796 . \u44536 \u45716  \u49457 \u44221 \u50640 \u49436  \u47566 \u51008  \u49457 \u46020 \u46308 \u51012  \u52286 \u50500 \u48380  \u49688  \u51080 \u50632 \u51004 \u45208  \u47932 \u47200  \u47196 \u47560 \u44368 \u51032  \u49457 \u46020 \u51032  \u47785 \u47197 \u50640  \u44592 \u47197 \u46108  \u49324 \u46988 \u46308 \u51008  \u50500 \u45768 \u50632 \u45796 . \u54616 \u45720 \u51032  \u48731 \u51008  \u54861 \u49688 \u52376 \u47100  \u44536 \u51032  \u47560 \u51020 \u50640  \u45336 \u52432 \u55128 \u47104 \u45796 . \u44536 \u45716  \u45440 \u46988 \u44284  \u54800 \u50724 \u44048 \u50640  \u49324 \u47196 \u51105 \u54784 \u49436  \u51333 \u47000 \u50640  \u54616 \u45912  \u51068 \u51012  \u45236 \u50612 \u48260 \u47532 \u44256  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51012  \u50672 \u44396 \u54616 \u45716  \u45936  \u47792 \u46160 \u54616 \u50688 \u45796 . \u44536 \u45716  \u44144 \u44592 \u49436  \u52286 \u51008  \u44480 \u51473 \u54620  \u51652 \u47532 \u47484  \u51593 \u49884  \u44032 \u47476 \u52824 \u44592  \u49884 \u51089 \u54616 \u50688 \u45796 .\
1512\uc0\u45380 , \u50500 \u51649 \u46020  \u47336 \u53552 \u45208  \u52768 \u48729 \u44544 \u47532 \u44032  \u44060 \u54785  \u49324 \u50629 \u50640  \u49552 \u51012  \u45824 \u44592  \u51204 \u50640  \u47084 \u54168 \u48652 \u47476 \u45716  \'93\u48127 \u51020 \u51004 \u47196  \u47568 \u48120 \u50516 \u50500  \u50864 \u47532 \u50640 \u44172  \u51452 \u45716  \u51032 , \u44263  \u51008 \u54812 \u47196  \u47568 \u48120 \u50516 \u50500  \u51032 \u47213 \u45796  \u54616 \u49884 \u44256  \u50689 \u49373 \u50640  \u51060 \u47476 \u44172  \u54616 \u49884 \u45716  \u51032 \u47484  \u51452 \u49884 \u45716  \u48516 \u51008  \u54616 \u45208 \u45784 \u51060 \u49884 \u45796 \'94 (Wylie, b.13, ch.1) \u46972 \u44256  \u44592 \u47197 \u54616 \u50688 \u45796 . \u44536 \u45716  \u46608  \u44396 \u50896 \u51032  \u50724 \u47896 \u54620  \u51060 \u52824 \u47484  \u44648 \u45803 \u44256  \u45796 \u51020 \u44284  \u44057 \u51060  \u48512 \u47476 \u51670 \u50632 \u45796 . \'93\u50500 \u50500 , \u51060  \u50620 \u47560 \u45208  \u47568 \u54624  \u49688  \u50630 \u51060  \u45440 \u46972 \u50868  \u44368 \u54872 \u51060 \u45264 ? \u47924 \u51396 \u54620  \u48516 \u51060  \u51396 \u51064 \u51004 \u47196  \u49440 \u44256 \u47484  \u48155 \u44256 , \u51396 \u51064 \u51060  \u51088 \u50976 \u51032  \u47800 \u51012  \u50619 \u44172  \u46108 \u45796 . \u52629 \u48373 \u48155 \u51008  \u48516 \u51060  \u51200 \u51452 \u47484  \u48155 \u44256 , \u51200 \u51452 \u47484  \u48155 \u51008  \u51088 \u44032  \u52629 \u48373 \u51012  \u48155 \u45716 \u45796 . \u49373 \u47749 \u51032  \u51076 \u44552 \u51060  \u51453 \u44256 , \u51453 \u51008  \u51088 \u44032  \u49332 \u50500 \u45212 \u45796 . \u50689 \u44305 \u51032  \u51452 \u44760 \u49436  \u50516 \u55121  \u49549 \u50640  \u51104 \u44592 \u49884 \u44256  \u54728 \u47932 \u44284  \u52824 \u50837 \u48150 \u50640  \u50508 \u51648  \u47803 \u54616 \u45716  \u51088 \u44032  \u44536  \u50620 \u44404 \u50640  \u50689 \u44305 \u51012  \u45208 \u53440 \u45236 \u44172  \u46108 \u45796 \'94 (D\'92Aubigne, Lundon ed., b.12, ch.2).\
\uc0\u44396 \u50896 \u51032  \u50689 \u44305 \u51008  \u50728 \u51204 \u55176  \u54616 \u45208 \u45784 \u44760  \u49549 \u54620  \u44163 \u51060 \u46972 \u45716  \u49324 \u49892 \u51012  \u44032 \u47476 \u52824 \u45716  \u54620 \u54200  \u44536 \u45716  \u46608 \u54620  \u49692 \u51333 \u51032  \u51032 \u47924 \u44032  \u49324 \u46988 \u50640 \u44172  \u51648 \u50892 \u51256  \u51080 \u45796 \u45716  \u44163 \u51012  \u44053 \u51312 \u54664 \u45796 . \'93\u47564 \u51068  \u44536 \u45824 \u44032  \u44536 \u47532 \u49828 \u46020 \u51032  \u44368 \u54924 \u50640  \u49549 \u54620  \u44368 \u51064 \u51060 \u46972 \u47732 , \u44536 \u45824 \u45716  \u44536 \u48516 \u51032  \u47800 \u51032  \u54620  \u51648 \u52404 \u51060 \u45796 . \u47564 \u51068  \u44536 \u45824 \u44032  \u44536 \u48516 \u51032  \u47800 \u51032  \u51648 \u52404 \u46972 \u47732  \u44536 \u45824 \u45716  \u54616 \u45208 \u45784 \u51032  \u54408 \u49457 \u51004 \u47196  \u52649 \u47564 \u54620  \u49324 \u46988 \u51060 \u45796 . \'85\u50500 , \u49324 \u46988 \u46308 \u51060  \u47564 \u51068  \u51060  \u53945 \u44428 \u51012  \u51060 \u54644 \u54616 \u44172  \u46108 \u45796 \u47732 , \u44536 \u46308 \u51008  \u50620 \u47560 \u45208  \u44648 \u45143 \u54616 \u44256  \u49692 \u44208 \u54616 \u44256 , \u44144 \u47337 \u54616 \u44172  \u49332  \u44163 \u51064 \u44032 ! \u44536 \u47532 \u44256  \u44536 \u46308 \u51008  \u51088 \u44592 \u46308 \u51032  \u47560 \u51020 \u49549 \u50640  \u51080 \u45716  \u50689 \u44305 , \u44263  \u50977 \u49888 \u51032  \u45576 \u51004 \u47196  \u48380  \u49688  \u50630 \u45716  \u50689 \u44305 \u50640  \u48708 \u54616 \u50668  \u51060  \u49464 \u49345 \u51032  \u47784 \u46304  \u50689 \u44305 \u51008  \u52280 \u51004 \u47196  \u54616 \u51096 \u44163 \u50630 \u45716  \u44163 \u51004 \u47196  \u50668 \u44592 \u44172  \u46112  \u44163 \u51060 \u45796 \'94 (D\'92Aubigne, b.12, ch.2).\
