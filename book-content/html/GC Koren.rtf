\uc0\u44033  \u44228 \u44553 \u51032  \u49324 \u46988 \u46308 \u51008  \u49457 \u44221 \u51012  \u49552 \u50640  \u46308 \u44256  \u51333 \u44368 \u44060 \u54785 \u51032  \u44368 \u47532 \u47484  \u50745 \u54840 \u54616 \u44172  \u46104 \u50632 \u45796 . \u49457 \u44221  \u50672 \u44396 \u47484  \u49888 \u48512 \u50752  \u49849 \u47140 \u46308 \u50640 \u44172 \u47564  \u51032 \u53441 \u54616 \u50688 \u45912  \u48277 \u50773 \u45817 \u51008  \u51060 \u47084 \u54620  \u49352 \u47196 \u50868  \u44032 \u47476 \u52840 \u51012  \u48152 \u48149 \u54644  \u45804 \u46972 \u44256  \u44536 \u46308 \u50640 \u44172  \u50836 \u44396 \u54616 \u50688 \u45796 . \u44536 \u47088 \u45936  \u54616 \u45208 \u45784 \u51032  \u44428 \u45733 \u44284  \u49457 \u44221 \u50640  \u45824 \u54616 \u50668  \u51204 \u50672  \u47924 \u51648 \u54620  \u49888 \u48512 \u50752  \u53441 \u48156 \u49849 \u46308 \u51008  \u44536 \u46308 \u51060  \u47924 \u51648 \u54620  \u51060 \u45800 \u51060 \u46972 \u44256  \u44277 \u44201 \u54616 \u45912  \u44536  \u49324 \u46988 \u46308 \u47196 \u48512 \u53552  \u50724 \u55176 \u47140  \u54056 \u48176 \u47484  \u45817 \u54616 \u50688 \u45796 . \u51060 \u50640  \u45824 \u54616 \u50668  \u54620  \u44032 \u53672 \u47533 \u51032  \u51200 \u49696 \u44032 \u45716  \'93\u48520 \u54665 \u55176 \u46020  \u47336 \u53552 \u45716  \u49457 \u44221  \u51060 \u50808 \u51032  \u50612 \u46500  \u44228 \u49884 \u46020  \u48127 \u51648  \u47568 \u46972 \u44256  \u44536 \u47484  \u46384 \u47476 \u45716  \u49324 \u46988 \u46308 \u50640 \u44172  \u51068 \u47084 \u46160 \u50632 \u45796 \'94 (D\'92Aubigne, b.9, ch.11) \u44256  \u44592 \u47197 \u54616 \u50688 \u45796 . \u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u48324 \u48152  \u44368 \u50977 \u51012  \u48155 \u51648  \u47803 \u54620  \u49324 \u46988 \u46308 \u51060  \u48320 \u54840 \u54616 \u45716  \u51652 \u47532 \u51032  \u47568 \u50432 , \u54617 \u49885 \u51060  \u47566 \u44256  \u45733 \u48320 \u51201 \u51064  \u49888 \u54617 \u51088 \u46308 \u44284  \u44536 \u46308 \u51060  \u53664 \u47200 \u54616 \u45716  \u47568 \u51012  \u46307 \u44592  \u50948 \u54616 \u50668  \u47784 \u50668 \u46308 \u44260  \u54616 \u50688 \u45796 . \u51060  \u50948 \u45824 \u54620  \u49324 \u46988 \u46308 \u51060  \u49457 \u44221 \u51032  \u45800 \u49692 \u54620  \u44368 \u47532 \u50640  \u51032 \u54616 \u50668  \u45436 \u48149 \u51012  \u48155 \u51012  \u46412 \u50640  \u44536 \u46308 \u51032  \u47924 \u51648 \u44032  \u53444 \u47196  \u45228 \u45796 . \u45432 \u46041 \u51088 \u46308 \u44284  \u44400 \u51064 \u46308 \u44284  \u48512 \u51064 \u46308 \u44284  \u50612 \u47536 \u50500 \u51060 \u46308 \u51060  \u49888 \u48512 \u46308 \u44284  \u48149 \u49885 \u54620  \u48149 \u49324 \u46308 \u48372 \u45796  \u49457 \u44221 \u51032  \u44368 \u54984 \u51012  \u45908 \u50865  \u51096  \u50508 \u50520 \u45796 .\
\uc0\u48373 \u51020 \u51032  \u51228 \u51088 \u46308 \u44284  \u48277 \u50773 \u44368 \u51032  \u48120 \u49888 \u51012  \u51648 \u51648 \u54616 \u45716  \u51088 \u46308 \u44284 \u51032  \u54788 \u44201 \u54620  \u52264 \u51060 \u45716  \u54617 \u51088  \u44228 \u44553 \u46308  \u49324 \u51060 \u50640 \u49436  \u49104 \u47564  \u50500 \u45768 \u46972  \u51068 \u48152  \u49324 \u46988  \u49324 \u51060 \u50640 \u49436 \u46020  \u46748 \u47159 \u54616 \u44172  \u45208 \u53440 \u45228 \u45796 . \'93\u50612 \u54617  \u50672 \u44396 \u50752  \u47928 \u54617 \u51032  \u49548 \u50577 \u51012  \u46321 \u54620 \u55176  \u54616 \u45716  \u44368 \u44428  (\u25934 \u27402 ) \u51032  \u45721 \u51008  \u51204 \u49324  (\u25136 \u22763 ) \u46308 \u51012  \u45824 \u54637 \u54616 \u50668  \u51068 \u50612 \u49440  \u49324 \u46988 \u46308  \u44032 \u50868 \u45936 \u45716  \u44256 \u44208 \u54620  \u47560 \u51020 \u51012  \u44032 \u51652  \u52397 \u45380 \u46308 \u51060  \u51080 \u50632 \u51004 \u47728 , \u44536 \u46308 \u51008  \u49457 \u44221 \u51012  \u50672 \u44396 \u54616 \u44592 \u50640  \u55192 \u50416 \u44256 , \u44256 \u51204 \u50640  \u49549 \u54620  \u47749 \u51089 \u46308 \u51012  \u51096  \u50508 \u44256  \u51080 \u50632 \u45796 . \u50696 \u48124 \u54620  \u46160 \u45516 \u50752  \u44256 \u49345 \u54620  \u49900 \u47161 \u44284  \u50857 \u44048 \u54620  \u53804 \u51648 \u47141 \u51012  \u44032 \u51652  \u44536  \u52397 \u45380 \u46308 \u51008  \u50500 \u47924 \u46020  \u45817 \u54644  \u45244  \u49688  \u50630 \u51012  \u47564 \u54620  \u51648 \u49885 \u51012  \u49548 \u50976 \u54616 \u44256  \u51080 \u50632 \u45796 . \'85\u46384 \u46972 \u49436  \u51060 \u50752  \u44057 \u51060  \u44060 \u54785  \u49324 \u50629 \u51012  \u51648 \u51648 \u54616 \u45716  \u51210 \u51008 \u51060 \u46308 \u51008  \u50612 \u45712  \u54924 \u54633 \u50640 \u49436 \u45208  \u47196 \u47560 \u44368 \u51032  \u54617 \u51088 \u46308 \u51012  \u47564 \u45208 \u44172  \u46104 \u47732  \u54869 \u49888 \u51012  \u44032 \u51648 \u44256  \u44536 \u46308 \u51012  \u50857 \u51060 \u54616 \u44172  \u44277 \u44201 \u54616 \u50668  \u51652 \u47532 \u50640  \u47924 \u49885 \u54620  \u44536 \u46308 \u51012  \u45229 \u54056 \u52992  \u54616 \u44256 , \u47943 \u49324 \u46988 \u46308 \u51032  \u44221 \u47736 \u51012  \u48155 \u51012  \u49688 \u48150 \u50640  \u50630 \u46020 \u47197  \u47564 \u46308 \u50632 \u45796 \'94 (D\'92Aubigne, b.9, ch.11).\
\uc0\u48277 \u50773 \u45817 \u51032  \u49457 \u51649 \u51088 \u46308 \u51008  \u44368 \u51064 \u46308 \u51032  \u49688 \u44032  \u44049 \u51088 \u44592  \u51460 \u50612 \u51664 \u51012  \u48372 \u50520 \u51004 \u48064 \u47196  \u44288 \u54732 \u51032  \u55192 \u50640  \u54840 \u49548 \u54616 \u50688 \u44256 , \u50728 \u44054  \u49688 \u45800 \u51012  \u45796 \u54616 \u50668  \u44536 \u46308 \u51032  \u44368 \u51064 \u46308 \u51012  \u45796 \u49884  \u46028 \u50500 \u50724 \u44172  \u54616 \u44256 \u51088  \u55192 \u50044 \u45796 . \u44536 \u47084 \u45208  \u49352 \u47196 \u50868  \u44368 \u47532 \u50640  \u44536 \u46308 \u51032  \u49900 \u47161 \u51032  \u44208 \u54605 \u51012  \u52292 \u50892  \u51452 \u45716  \u44163 \u51060  \u51080 \u45796 \u45716  \u44163 \u51012  \u48156 \u44204 \u54620  \u49324 \u46988 \u46308 \u51008  \u45796 \u45380 \u44036  \u48120 \u49888 \u51201 \u51064  \u51032 \u47168  (\u20736 \u31150 ) \u45208  \u51204 \u49444  \u44057 \u51008  \u47924 \u44032 \u52824 \u54620  \u44749 \u51656 \u47564 \u51004 \u47196  \u44536 \u46308 \u51012  \u47673 \u50668  \u51452 \u45912  \u49324 \u46988 \u46308 \u51012  \u48260 \u47532 \u44256  \u46496 \u45208 \u44052 \u45796 .\
\uc0\u51652 \u47532 \u51032  \u44368 \u49324 \u46308 \u50640  \u45824 \u54616 \u50668  \u48149 \u54644 \u51032  \u48520 \u44600 \u51060  \u51068 \u50612 \u45208 \u51088 , \u44536 \u46308 \u51008  \'93\u51060  \u46041 \u45348 \u50640 \u49436  \u45320 \u55148 \u47484  \u54605 \u48149 \u54616 \u44144 \u46304  \u51200  \u46041 \u45348 \u47196  \u54588 \u54616 \u46972 \'94 (\u47560  10:23) \u44256  \u54616 \u49888  \u44536 \u47532 \u49828 \u46020 \u51032  \u47568 \u50432 \u51012  \u49692 \u51333 \u54616 \u50688 \u45796 . \u44536 \u47084 \u48064 \u47196  \u48731 \u51008  \u44033  \u44275 \u51004 \u47196  \u51204 \u54028 \u46104 \u50632 \u45796 . \u50976 \u46993 \u51088 \u46308 \u51008  \u50612 \u46356 \u50640 \u49436 \u45208  \u44536 \u46308 \u51012  \u50689 \u51217 \u54644  \u51452 \u45716  \u49324 \u46988 \u46308 \u51012  \u48156 \u44204 \u54616 \u50668  \u44536 \u46308 \u51032  \u51665 \u50640 \u49436  \u50976 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u46412 \u46412 \u47196  \u44368 \u54924 \u50640 \u49436  \u44536 \u47532 \u49828 \u46020 \u47484  \u51204 \u54616 \u50688 \u44256 , \u47564 \u51068  \u44368 \u54924 \u50640 \u49436  \u54728 \u46973 \u54616 \u51648  \u50506 \u51004 \u47732 , \u49324 \u44032  (\u31169 \u23478 ) \u50640 \u49436 , \u54841 \u51008  \u50725 \u50808 \u50640 \u49436  \u51204 \u54616 \u50688 \u45796 . \u50612 \u46356 \u50640 \u49436 \u45208  \u46307 \u45716  \u51088 \u47564  \u51080 \u51004 \u47732  \u44536  \u44275 \u51060  \u44536 \u46308 \u50640 \u44172 \u45716  \u44144 \u47337 \u54620  \u49457 \u51204 \u51060 \u50632 \u45796 . \u51060 \u52376 \u47100  \u54869 \u49888 \u51012  \u44032 \u51648 \u44256  \u50676 \u49900 \u51004 \u47196  \u51204 \u54616 \u50688 \u51004 \u48064 \u47196  \u51652 \u47532 \u45716  \u51200 \u54637 \u54624  \u49688  \u50630 \u45716  \u44428 \u45733 \u51004 \u47196  \u45328 \u47532  \u51204 \u54028 \u46104 \u50632 \u45796 .\
\uc0\u44368 \u54924 \u50752  \u44397 \u44032 \u44032  \u44536  \u51060 \u45800 \u51012  \u48149 \u47736 \u54616 \u47140 \u44256  \u54620 \u44208 \u44057 \u51060  \u45432 \u47141 \u54664 \u51648 \u47564  \u54747 \u49688 \u44256 \u44032  \u46104 \u44256  \u47568 \u50520 \u45796 . \u53804 \u50725 , \u44256 \u47928 , \u54868 \u54805 , \u44160  \u46321 \u51004 \u47196  \u52376 \u45800 \u54616 \u50688 \u51648 \u47560 \u45716 , \u47784 \u46160 \u44032  \u50424 \u45936 \u50630 \u45716  \u51068 \u51060 \u50632 \u45796 . \u47924 \u49688 \u54620  \u49888 \u51088 \u46308 \u51008  \u51088 \u44592 \u46308 \u51032  \u54588 \u47196 \u50024  \u44536 \u46308 \u51032  \u49888 \u50521 \u51012  \u51064  \u52452 \u45796 . \u44536 \u47092 \u51648 \u46972 \u46020  \u44536  \u49324 \u50629 \u51008  \u44228 \u49549 \u54644 \u49436  \u48156 \u51204 \u54616 \u50688 \u45796 . \u48149 \u54644 \u45716  \u51652 \u47532 \u47484  \u48372 \u44553 \u49884 \u53412 \u45716  \u45936  \u46020 \u50880 \u51060  \u46104 \u50632 \u51012  \u49104 \u51060 \u45796 . \u49324 \u45800 \u51060  \u51652 \u47532 \u50752  \u54633 \u47448 \u49884 \u53412 \u44256 \u51088  \u45432 \u47141 \u54620  \u44305 \u49888 \u51008  \u49324 \u45800 \u51032  \u49324 \u50629 \u44284  \u54616 \u45208 \u45784 \u51032  \u49324 \u50629 \u44284 \u47484  \u45908 \u50865 \u45908  \u48516 \u47749 \u54616 \u44172  \u44396 \u48324  \u51648 \u50612  \u51452 \u50632 \u51012  \u49104 \u51060 \u50632 \u45796 .\
