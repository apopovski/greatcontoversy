\f0\b \cf0 \uc0\u48380 \u54532 \u51032  \u47784 \u54744 \u51201  \u49440 \u44368  \u54876 \u46041 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
1821\uc0\u45380 \u48512 \u53552  1845\u45380 \u44620 \u51648  24\u45380 \u44036  \u48380 \u54532 \u45716  \u45331 \u51008  \u48276 \u50948 \u50640  \u44152 \u52432  \u50668 \u54665 \u54616 \u50688 \u45796 . \u44536 \u45716  \u50500 \u54532 \u47532 \u52852 \u51032  \u51060 \u51665 \u53944 \u50752  \u50500 \u48708 \u49884 \u45768 \u50500 , \u50500 \u49884 \u50500 \u51032  \u54036 \u47112 \u49828 \u54004 , \u49884 \u47532 \u50500 , \u54168 \u47476 \u49380 , \u48372 \u52852 \u46972 , \u51064 \u46020  \u46321 \u51032  \u50668 \u47084  \u45208 \u46972 \u47484  \u49692 \u47141  (\u24033 \u27511 ) \u54616 \u50688 \u45796 . \u44536 \u47532 \u44256  \u44536 \u45716  \u48513 \u48120  \u54633 \u51473 \u44397 \u46020  \u48169 \u47928 \u54616 \u50688 \u45716 \u45936 , \u51648 \u45208 \u45716  \u44600 \u50640  \u49464 \u51064 \u53944  \u54764 \u47112 \u45208  \u49452 \u50640 \u49436  \u51204 \u46020 \u54616 \u50688 \u45796 . \u44536 \u45716  1837\u45380  8\u50900 \u50640  \u45684 \u50837  \u49884 \u50640  \u46020 \u52265 \u54616 \u50668  \u44536  \u46020 \u49884 \u50640 \u49436  \u49444 \u44368 \u54616 \u50688 \u45796 . \u44536  \u54980 \u50640  \u45796 \u49884  \u54596 \u46972 \u45944 \u54588 \u50500  \u49884 \u50752  \u48380 \u54000 \u47784 \u50612  \u49884 \u50640 \u49436  \u49444 \u44368 \u54616 \u44256 , \u47560 \u51648 \u47561 \u51004 \u47196  \u50892 \u49905 \u53556  \u49884 \u50640 \u44620 \u51648  \u44052 \u45796 . \u44144 \u44592 \u49436  \u44536 \u45716  \u47568 \u54616 \u50688 \u45796 . \'93\u54620  \u51032 \u54924 \u50640 \u49436  \u51204  \u45824 \u53685 \u47161  \u51316  \u53304 \u49884  \u50528 \u45924 \u51592  \u50472 \u44032  \u51228 \u51032 \u54620  \u46041 \u51032 \u50640  \u51032 \u54616 \u50668  \u45236 \u44032  \u44397 \u54924  \u51032 \u49324 \u45817 \u50640 \u49436  \u44053 \u50672 \u51012  \u54616 \u46020 \u47197  \u47564 \u51109 \u51068 \u52824 \u47196  \u44032 \u44208 \u46104 \u50632 \u45796 . \u44536 \u47532 \u54616 \u50668  \u45208 \u45716  \u50612 \u45712  \u53664 \u50836 \u51068 \u50640  \u51204 \u52404  \u51032 \u50896 \u44284  \u48260 \u51648 \u45768 \u50500 \u51032  \u44048 \u46021 \u44284  \u49457 \u51649 \u51088 \u46308 \u44284  \u50892 \u49905 \u53556  \u49884 \u48124 \u46308 \u51060  \u52280 \u49437 \u54620  \u45936 \u49436  \u44053 \u50672 \u54616 \u45716  \u50689 \u44305 \u51012  \u45572 \u47160 \u45796 . \u44536 \u50752  \u44057 \u51008  \u50689 \u44305 \u51008  \u45684 \u51200 \u51648  \u51452 \u50752  \u54172 \u49892 \u48288 \u51060 \u45768 \u50500  \u51452 \u50640 \u49436 \u46020  \u45208 \u50640 \u44172  \u51452 \u50612 \u51276 \u45716 \u45936 , \u44144 \u44592 \u49436  \u45208 \u45716  \u50500 \u49884 \u50500 \u50640 \u49436  \u54620  \u45208 \u51032  \u50672 \u44396 \u50640  \u45824 \u54616 \u50668  \u51060 \u50556 \u44592 \u54616 \u46104 , \u50696 \u49688  \u44536 \u47532 \u49828 \u46020 \u51032  \u44060 \u51064 \u51201  \u53685 \u52824 \u50640  \u45824 \u54616 \u50668  \u47568 \u54616 \u50688 \u45796 \'94 (Journal of the Rev.Joseph Wolff, pp.398, 399).\
\uc0\u48380 \u54532  \u48149 \u49324 \u45716  \u50976 \u47101 \u51032  \u50612 \u46500  \u44428 \u50948 \u51032  \u48372 \u54840 \u46020  \u48155 \u51648  \u50506 \u44256  \u47566 \u51008  \u44256 \u45212 \u44284  \u50728 \u44054  \u50948 \u54744 \u51012  \u45817 \u54616 \u47732 \u49436  \u45824 \u48512 \u48516 \u51032  \u50556 \u47564  \u45208 \u46972 \u46308 \u51012  \u46160 \u47336  \u45796 \u45396 \u45796 . \u44536 \u45716  \u47588 \u47484  \u47582 \u44592 \u46020  \u54616 \u44256 , \u51452 \u47532 \u44592 \u46020  \u54616 \u44256 , \u45432 \u50696 \u47196  \u54036 \u47532 \u44592 \u46020  \u54616 \u50688 \u45796 . \u44536 \u47532 \u44256  \u44536 \u45716  \u49464  \u48264 \u51060 \u45208  \u49324 \u54805  \u49440 \u44256 \u47484  \u48155 \u50520 \u45796 . \u46020 \u51201 \u46308 \u50640 \u44172  \u54252 \u50948 \u45817 \u54620  \u51068 \u46020  \u51080 \u50632 \u44256 , \u44592 \u44040 \u47196  \u44144 \u51032  \u51453 \u51012  \u48852 \u54620  \u51068 \u46020  \u51080 \u50632 \u45796 . \u46608  \u54620  \u48264 \u51008  \u47800 \u50640  \u51648 \u45768 \u44256  \u51080 \u45912  \u44163 \u51012  \u47784 \u46160  \u48764 \u50519 \u44592 \u44256 , \u44152 \u50612 \u49436  \u49328 \u51012  \u45336 \u50612  \u49688 \u48177  \u47560 \u51068 \u51012  \u44040  \u49688 \u48150 \u50640  \u50630 \u50632 \u45716 \u45936 , \u50620 \u44404 \u50640  \u45576 \u51012  \u47582 \u51004 \u47732 \u49436  \u50620 \u51020 \u51004 \u47196  \u45934 \u51064  \u46405 \u51012  \u47592 \u48156 \u47196  \u44152 \u50632 \u44592  \u46412 \u47928 \u50640  \u48156 \u51060  \u44048 \u44033 \u51012  \u51075 \u44172  \u46108  \u51068 \u46020  \u51080 \u50632 \u45796 .\
\uc0\u50556 \u47564 \u51064 \u44284  \u54840 \u51204 \u51201 \u51064  \u51333 \u51313 \u46308 \u50640 \u44172  \u47924 \u51109 \u51012  \u54616 \u51648  \u50506 \u44256  \u44032 \u45716  \u44163 \u51060  \u50948 \u54744 \u54616 \u45796 \u45716  \u44221 \u44256 \u47484  \u48155 \u44172  \u46104 \u51088  \u44536 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u45824 \u45813 \u54616 \u50688 \u45796 . \'93\u47924 \u51109 \u54616 \u50688 \u45796 . \u44592 \u46020 \u50752  \u44536 \u47532 \u49828 \u46020 \u50640  \u45824 \u54620  \u50676 \u49900 \u44284  \u54616 \u45208 \u45784 \u51032  \u46020 \u50864 \u49900 \u50640  \u45824 \u54620  \u49888 \u47280 \u47196 \u50024  \u47924 \u51109 \u54616 \u50688 \u45796 .\'94 \u44536 \u45716  \'93\u45208 \u45716  \u46608 \u54620  \u47560 \u51020 \u50640 \u45716  \u54616 \u45208 \u45784 \u44284  \u51060 \u50883 \u50640  \u45824 \u54620  \u49324 \u46993 \u51012  \u44032 \u51648 \u44256  \u49552 \u50640 \u45716  \u49457 \u44221 \u51012  \u44032 \u51648 \u44256  \u51080 \u45796 \'94 (W.H.D.Adams, In Perils Oft, p.192) \u44256  \u47568 \u54616 \u50688 \u45796 .\'94 \u44536 \u45716  \u50612 \u46356 \u47484  \u44032 \u46304 \u51648  \u55176 \u48652 \u47532 \u50612 \u50752  \u50689 \u50612  \u49457 \u44221 \u51012  \u44032 \u51648 \u44256  \u44052 \u45796 . \u44536  \u54980 \u50640  \u44536 \u44032  \u50668 \u54665 \u54620  \u54620  \u44032 \u51648  \u44221 \u54744 \u50640  \u45824 \u54616 \u50668  \u47568 \u54616 \u50688 \u45796 . \'93\u45208 \u45716  \u49457 \u44221 \u51012  \u54196  \u46308 \u50632 \u45716 \u45936 , \u52293  \u49549 \u50640  \u55192 \u51060  \u51080 \u50612 \u49436  \u44536 \u44163 \u51060  \u45208 \u47484  \u48537 \u46308 \u50612  \u51452 \u45716  \u44163  \u44057 \u50520 \u45796 \'94 (W.H.D.Adams, In Perils Oft, p.201).\
\uc0\u51060 \u50752  \u44057 \u51060  \u44536 \u45716  \u49900 \u54032 \u51032  \u44592 \u48324 \u51060  \u49324 \u46988 \u51060  \u44144 \u51452 \u54616 \u45716  \u51648 \u44396 \u49345 \u51032  \u45824 \u48512 \u48516 \u50640  \u51204 \u54028 \u46104 \u44592 \u44620 \u51648  \u44536 \u51032  \u54876 \u46041 \u51012  \u51473 \u51648 \u54616 \u51648  \u50506 \u50520 \u45796 . \u50976 \u45824 \u51064 , \u53552 \u53412 \u51064  \u48176 \u54868 \u44368 \u46020  (\u25308 \u28779 \u25934 \u24466 ), \u55180 \u46160 \u44368 \u46020 , \u44536  \u48150 \u51032  \u50668 \u47084  \u51333 \u51313 \u44284  \u48124 \u51313  \u49324 \u51060 \u50640 \u49436  \u44536 \u45716  \u44536  \u51648 \u48169 \u46308 \u51032  \u50616 \u50612 \u47196 \u50024  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u51012  \u51613 \u44144 \u54616 \u44256 , \u50724 \u47000 \u51648  \u50500 \u45768 \u54616 \u50668  \u47700 \u49884 \u50556 \u51032  \u50773 \u44397 \u51060  \u44148 \u49444 \u46112  \u44163 \u51012  \u51204 \u54028 \u54616 \u50688 \u45796 .\
\pard\pardeftab720\sa319\partightenfactor0

\f0\b \cf0 \uc0\u49436 \u48512  \u50500 \u49884 \u50500  \u51648 \u50669 \u51032  \u54200 \u47141 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u44536 \u45716  \u48372 \u52852 \u46972 \u47484  \u50668 \u54665 \u54616 \u45912  \u51473 \u50640  \u50612 \u46500  \u50976 \u48317  (\u24189 \u20731 ) \u54620  \u51648 \u48169 \u50640  \u49324 \u45716  \u54620  \u48512 \u46973 \u48124 \u51060  \u51116 \u47548 \u51032  \u44368 \u47532 \u47484  \u48127 \u44256  \u51080 \u45716  \u44163 \u51012  \u48156 \u44204 \u54616 \u50688 \u45796 . \u44536 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u54616 \u50688 \u45796 . \'93\u51060  \u50696 \u47704 \u50640  \u51080 \u45716  \u50500 \u46972 \u48708 \u50500  \u51064 \u46308 \u51008  \u49464 \u50640 \u46972  (Seera) \u46972 \u44256  \u54616 \u45716  \u52293 \u51012  \u44032 \u51648 \u44256  \u51080 \u50632 \u45716 \u45936 , \u44144 \u44592 \u50640 \u45716  \u44536 \u47532 \u49828 \u46020 \u51032  \u51116 \u47548 \u44284  \u44536 \u48516 \u44760 \u49436  \u50689 \u44305 \u51473 \u50640  \u53685 \u52824 \u54616 \u49892  \u49324 \u49892 \u51060  \u44592 \u47197 \u46104 \u50612  \u51080 \u50632 \u45796 . \u44536 \u47532 \u44256  \u44536 \u46308 \u51008  1840\u45380 \u50640  \u53360  \u49324 \u44148 \u51060  \u51068 \u50612 \u45216  \u44163 \u51060 \u46972 \u44256  \u50696 \u44592 \u54616 \u44256  \u51080 \u50632 \u45796 \'94 (Journal of the Rev.Joseph Wolff, p.377). \'93\u45208 \u45716  \u50696 \u47704 \u50640 \u49436  \u47112 \u44049 \u51032  \u54980 \u49552 \u46308 \u44284  \u54632 \u44760  6\u51068 \u44036 \u51012  \u51648 \u45256 \u45796 . \u44536 \u46308 \u51008  \u49696 \u46020  \u47560 \u49884 \u51648  \u50506 \u44256  \u54252 \u46020 \u50896 \u46020  \u51116 \u48176 \u54616 \u51648  \u50506 \u44256  \u44257 \u49885 \u46020  \u49900 \u51648  \u50506 \u50520 \u45796 . \u44536 \u46308 \u51008  \u52380 \u47561 \u50640  \u49332 \u47728 , \u47112 \u44049 \u51032  \u50500 \u46308  \u49440 \u54620  \u50668 \u54840 \u45208 \u45813 \u51012  \u44592 \u50613 \u54620 \u45796 . \u45208 \u45716  \u46608 \u54620  \u51060  \u51313 \u49549  \u51473 \u50640  \u47700 \u49884 \u50556 \u44760 \u49436  \u49549 \u55176  \u54616 \u45720 \u51032  \u44396 \u47492 \u51012  \u53440 \u44256  \u50724 \u49884 \u44592 \u47484  \u47112 \u44049 \u51032  \u51088 \u49552 \u44284  \u54632 \u44760  \u44256 \u45824 \u54616 \u44256  \u51080 \u45716  \u45800  \u51313 \u49549 \u51064  \u51060 \u49828 \u46972 \u50648 \u51064 \u51032  \u54980 \u49552 \u51060  \u51080 \u51020 \u51012  \u48372 \u50520 \u45796 \'94 (Journal of the Rev.Joseph Wolff, p.377).\
\uc0\u50612 \u46500  \u45796 \u47480  \u49440 \u44368 \u49324 \u45716  \u44536 \u50752  \u48708 \u49847 \u54620  \u49888 \u50521 \u51012  \u44032 \u51652  \u51088 \u44032  \u53440 \u53440 \u47476  (Tatary) \u51648 \u48169 \u50640 \u46020  \u51080 \u51020 \u51012  \u48156 \u44204 \u54616 \u50688 \u45796 . \u53440 \u53440 \u47476 \u51032  \u54620  \u49849 \u47140 \u45716  \u44536  \u49440 \u44368 \u49324 \u50640 \u44172  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u50612 \u45712  \u46412 \u52196  \u51116 \u47548 \u54616 \u49892  \u44163 \u51060 \u45264 \u44256  \u51656 \u47928 \u54616 \u50688 \u45796 . \u44536 \u47084 \u51088  \u44536  \u49440 \u44368 \u49324 \u45716  \u44536  \u51068 \u50640  \u45824 \u54616 \u50668  \u50500 \u47924 \u44163 \u46020  \u45824 \u45813 \u54624  \u49688  \u50630 \u45796 \u44256  \u47568 \u54616 \u50688 \u45908 \u45768  \u44536  \u49849 \u47140 \u45716  \u49457 \u44221 \u51012  \u44032 \u47476 \u52824 \u45432 \u46972 \u44256  \u44277 \u50616 \u54616 \u45716  \u49324 \u46988 \u51060  \u44536  \u49324 \u44148 \u51012  \u47784 \u47480 \u45796 \u45716  \u44163 \u50640  \u45824 \u54616 \u50668  \u53356 \u44172  \u45440 \u46972 \u50880 \u51012  \u45208 \u53440 \u45256 \u45796 . \u44536 \u47532 \u44256  \u44536 \u45716  \u50696 \u50616 \u51012  \u44540 \u44144 \u47196  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  1844\u45380 \u44221 \u50640  \u51116 \u47548 \u54616 \u49884 \u47532 \u46972 \u45716  \u51088 \u49888 \u51032  \u49548 \u49888 \u51012  \u47568 \u54616 \u50688 \u45796 .\
\pard\pardeftab720\sa319\partightenfactor0

\f0\b \cf0 \uc0\u50689 \u44397 \u50640 \u49436 \u51032  \u51116 \u47548 \u50868 \u46041 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u51068 \u52237 \u51060  \u50689 \u44397 \u50640 \u49436 \u45716  1826\u45380 \u50640  \u51116 \u47548 \u44592 \u48324 \u51060  \u51204 \u54028 \u46104 \u44592  \u49884 \u51089 \u54616 \u50688 \u45796 . \u51060 \u44275 \u51032  \u50868 \u46041 \u51008  \u48120 \u44397 \u44284  \u44057 \u51060  \u44536 \u47111 \u44172  \u48516 \u47749 \u54620  \u54805 \u53468 \u47484  \u52712 \u54616 \u51648 \u45716  \u50506 \u50520 \u45796 . \u51116 \u47548 \u51032  \u51221 \u54869 \u54620  \u49884 \u51068 \u51008  \u51068 \u48152 \u51201 \u51004 \u47196  \u44536 \u52376 \u47100  \u44032 \u47476 \u52432 \u51648 \u51648  \u50500 \u45768 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u50689 \u44305 \u44284  \u44428 \u49464 \u47484  \u44032 \u51648 \u44256  \u48120 \u44396 \u50640  \u51076 \u54616 \u49888 \u45796 \u45716  \u53360  \u51652 \u47532 \u44032  \u45328 \u47532  \u51204 \u54028 \u46104 \u50632 \u45796 . \u44536  \u51652 \u47532 \u45716  \u45796 \u47564  \u48708 \u44397 \u44368 \u46020  (\u38750 \u22283 \u25934 \u24466 ) \u49324 \u51060 \u50640 \u49436 \u47564  \u51204 \u54028 \u46108  \u44163 \u51060  \u50500 \u45768 \u50632 \u45796 . \u50689 \u44397 \u51032  \u51200 \u49696 \u44032  \u47924 \u46976 \u53944  \u48652 \u47196 \u53356 \u45716  \u50557  700\u47749 \u51032  \u50689 \u44397  \u44397 \u44368 \u54924  \u49457 \u51649 \u51088 \u46308 \u46020  \u51060  \'93\u52380 \u44397 \u48373 \u51020 \'94\u51012  \u51204 \u54028 \u54616 \u45716  \u51068 \u50640  \u50672 \u54633 \u54616 \u50688 \u45796 \u44256  \u47568 \u54616 \u50688 \u45796 . \u46608 \u54620  1844\u45380 \u51012  \u51116 \u47548 \u51032  \u46412 \u46972 \u44256  \u50508 \u47140  \u51452 \u45716  \u44592 \u48324 \u46020  \u45824 \u50689  \u51228 \u44397 \u50640 \u49436  \u51204 \u54028 \u46104 \u50632 \u45796 . \u48120 \u44397 \u50640 \u49436  \u44148 \u45320 \u50728  \u51116 \u47548 \u50640  \u45824 \u54620  \u44036 \u54665 \u47932 \u46308 \u51060  \u45328 \u47532  \u48176 \u54252 \u46104 \u50632 \u51004 \u47728 , \u50689 \u44397 \u50640 \u49436 \u46020  \u47566 \u51008  \u49436 \u51201 \u44284  \u51105 \u51648 \u46308 \u51012  \u51116 \u48156 \u54665 \u54616 \u50688 \u45796 . \u44536 \u47532 \u44256  1842\u45380 \u50640 \u45716  \u48120 \u44397 \u50640 \u49436  \u51116 \u47548  \u49888 \u50521 \u51012  \u48155 \u50500 \u46308 \u51064  \u47196 \u48260 \u53944  \u50952 \u53552 \u46972 \u45716  \u50689 \u44397 \u51064 \u51060  \u48376 \u44397 \u51004 \u47196  \u46028 \u50500 \u50752 \u49436  \u51452 \u45784 \u51032  \u51116 \u47548 \u51012  \u51204 \u54028 \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u47566 \u51008  \u49324 \u46988 \u46308 \u51060  \u44536 \u51032  \u49324 \u50629 \u50640  \u50672 \u54633 \u54616 \u50688 \u51004 \u47728 , \u49900 \u54032 \u50640  \u44288 \u54620  \u44592 \u48324 \u51060  \u50689 \u44397  \u44033 \u52376 \u50640  \u51204 \u54028 \u46104 \u50632 \u45796 .\
\uc0\u50500 \u51649  \u48120 \u44060 \u54620  \u52292  \u47196 \u47560 \u44368 \u51032  \u51221 \u47029  (\u25919 \u30053 ) \u50640  \u49324 \u47196 \u51105 \u54784  \u51080 \u45912  \u45224 \u48120 \u51452 \u50640 \u46020  \u54620  \u49828 \u54168 \u51064 \u51064 \u51060 \u47728  \u50696 \u49688 \u54924  \u54924 \u50896 \u51064  \u46972 \u53220 \u51088 \u46972 \u45716  \u49324 \u46988 \u51060  \u49457 \u44221 \u51012  \u50672 \u44396 \u54616 \u50668  \u44536 \u47532 \u49828 \u46020 \u51032  \u51116 \u47548 \u51060  \u44032 \u44620 \u50912 \u45796 \u45716  \u44163 \u51012  \u44648 \u45803 \u44172  \u46104 \u50632 \u45796 . \u44536 \u45716  \u44221 \u44256 \u47484  \u54616 \u51648  \u50500 \u45768 \u54624  \u49688  \u50630 \u45796 \u45716  \u49324 \u47749 \u44048 \u51012  \u45712 \u44808 \u51004 \u45208  \u47196 \u47560 \u44368 \u51032  \u44204 \u52293 \u51060  \u46160 \u47140 \u50892 \u49436  \u51088 \u44592 \u51032  \u51060 \u47492 \u51012  \u46989 \u48708 \u48292  \u50640 \u49828 \u46972 \u46972 \u44256  \u44256 \u52432 \u49436  \u47560 \u52824  \u44060 \u51333 \u54620  \u50976 \u45824 \u51064 \u51064  \u44163 \u52376 \u47100  \u44984 \u47728  \u44032 \u51648 \u44256  \u51088 \u44592 \u51032  \u44204 \u54644 \u47484  \u52636 \u54032 \u54616 \u50688 \u45796 . \u46972 \u53220 \u51088 \u45716  18\u49464 \u44592 \u51032  \u49324 \u46988 \u51060 \u50632 \u51004 \u45208  \u44536 \u51032  \u51200 \u49436 \u44032  \u47088 \u45912 \u51004 \u47196  \u44032 \u49436  \u50689 \u50612 \u47196  \u48264 \u50669 \u46104 \u44592 \u45716  1825\u45380 \u44221 \u51032  \u51068 \u51060 \u50632 \u45796 . \u51060  \u52293 \u51032  \u48156 \u54665 \u51008  \u50689 \u44397 \u50640  \u51080 \u50612 \u49436  \u51060 \u48120  \u51116 \u47548 \u47928 \u51228 \u50640  \u45576 \u51012  \u46892  \u49324 \u46988 \u46308 \u51032  \u44288 \u49900 \u51012  \u44618 \u44172  \u54616 \u45716  \u45936  \u47588 \u50864  \u53360  \u50669 \u54624 \u51012  \u54616 \u50688 \u45796 .\
