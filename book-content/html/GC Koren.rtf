\uc0\u44053 \u49888 \u49696 \u51012  \u53685 \u54616 \u50668  \u45208 \u53440 \u45212  \u51060 \u51201 \u51012  \u54665 \u54616 \u45716  \u45733 \u47141 \u51008  \u49324 \u46988 \u51012  \u49692 \u51333 \u54616 \u44592 \u48372 \u45796 \u45716  \u54616 \u45208 \u45784 \u51012  \u49692 \u51333 \u54616 \u44592 \u47196  \u44208 \u49900 \u54620  \u51088 \u46308 \u51012  \u45824 \u51201 \u54616 \u45716  \u45936  \u50689 \u54693 \u51012  \u45180 \u52824 \u44172  \u46112  \u44163 \u51060 \u45796 . \u50689 \u46308 \u44284  \u44368 \u53685 \u54616 \u45716  \u51088 \u46308 \u51008  \u51068 \u50836 \u51068 \u51012  \u44144 \u51208 \u54616 \u45716  \u51088 \u46308 \u50640 \u44172  \u44536 \u46308 \u51032  \u51096 \u47803 \u51012  \u44648 \u50864 \u52432  \u51452 \u44592  \u50948 \u54616 \u50668  \u54616 \u45208 \u45784 \u44760 \u47196 \u48512 \u53552  \u48372 \u45236 \u49900 \u51012  \u48155 \u50520 \u45796 \u44256  \u51452 \u51109 \u54616 \u44256  \u44397 \u44032 \u51032  \u48277 \u47456 \u51012  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u44284  \u46609 \u44057 \u51060  \u49692 \u51333 \u54644 \u50556  \u54620 \u45796 \u44256  \u44053 \u51312 \u54624  \u44163 \u51060 \u45796 . \u44536 \u46308 \u51008  \u49464 \u49345 \u50640  \u51080 \u45716  \u53360  \u51396 \u50501 \u51012  \u54620 \u53444 \u54616 \u44256  \u46020 \u45909 \u51201  \u53440 \u46973 \u51032  \u49345 \u53468 \u44032  \u51068 \u50836 \u51068 \u51012  \u47784 \u46021 \u54616 \u50688 \u44592  \u46412 \u47928 \u51060 \u46972 \u44256  \u54616 \u45716  \u51333 \u44368  \u51648 \u46020 \u51088 \u46308 \u51032  \u51613 \u50616 \u51012  \u51648 \u51648 \u54624  \u44163 \u51060 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u47084 \u54620  \u51613 \u50616 \u51012  \u48155 \u50500 \u46308 \u51060 \u51648  \u50506 \u51008  \u51088 \u46308 \u50640  \u45824 \u54616 \u50668  \u53360  \u48516 \u45432 \u44032  \u44201 \u48156 \u46112  \u44163 \u51060 \u45796 .\
