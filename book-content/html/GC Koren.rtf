\uc0\u46608 \u54620  \u54616 \u45720 \u50640 \u45716  \u49324 \u46988 \u46308 \u51032  \u51060 \u47492 \u44284  \u44536  \u54665 \u50948 \u47484  \u44592 \u47197 \u54620  \u52293 \u46308 \u51060  \u51080 \u45716 \u45936 , \u44536 \u44163 \u46308 \u50640  \u51032 \u54616 \u50668  \u49900 \u54032 \u51032  \u54032 \u44208 \u51060  \u44208 \u51221 \u46108 \u45796 . \u45796 \u45768 \u50648 \u51008  \'93\u49900 \u54032 \u51012  \u48288 \u54392 \u45716 \u45936  \u52293 \u46308 \u51060  \u54196  \u45459 \u50688 \u45908 \u46972 \'94\u44256  \u47568 \u54620 \u45796 . \u50836 \u54620 \u51008  \u44536  \u44057 \u51008  \u44305 \u44221 \u51012  \u47896 \u49324 \u54616 \u47732 \u49436  \'93\u46608  \u45796 \u47480  \u52293 \u51060  \u54196 \u51276 \u51004 \u45768  \u44263  \u49373 \u47749 \u52293 \u51060 \u46972  \u51453 \u51008  \u51088 \u46308 \u51060  \u51088 \u44592  \u54665 \u50948 \u47484  \u46384 \u46972  \u52293 \u46308 \u50640  \u44592 \u47197 \u46108  \u45824 \u47196  \u49900 \u54032 \u51012  \u48155 \u51004 \u45768 \'94 (\u44228  20:12) \u46972 \u44256  \u47568 \u54620 \u45796 .\
\uc0\u49373 \u47749 \u52293 \u50640 \u45716  \u54616 \u45208 \u45784 \u51012  \u48320 \u54632 \u50630 \u51060  \u49452 \u44200 \u50728  \u47784 \u46304  \u49324 \u46988 \u46308 \u51032  \u51060 \u47492 \u51060  \u44592 \u47197 \u46104 \u50612  \u51080 \u45796 . \u50696 \u49688 \u45784 \u44760 \u49436 \u45716  \u51228 \u51088 \u46308 \u50640 \u44172  \'93\u45320 \u55148  \u51060 \u47492 \u51060  \u54616 \u45720 \u50640  \u44592 \u47197 \u46108  \u44163 \u51004 \u47196  \u44592 \u48848 \u54616 \u46972 \'94 (\u45573  10:20) \u44256  \u47568 \u50432 \u54616 \u49512 \u45796 . \u48148 \u50872 \u51008  \u44536 \u51032  \u49457 \u49892 \u54620  \u46041 \u50669 \u51088 \u46308 \u50640  \u45824 \u54616 \u50668  \'93\u44536  \u51060 \u47492 \u46308 \u51060  \u49373 \u47749 \u52293 \u50640  \u51080 \u45712 \u45768 \u46972 \'94 (\u48716  4:3) \u44256  \u47568 \u54620 \u45796 . \u45796 \u45768 \u50648 \u51008  \'93\u44060 \u44397  \u51060 \u47000 \u47196  \u44536  \u46412 \u44620 \u51648  \u50630 \u45912 \'94 \u54872 \u45212 \u51032  \u46412 \u47484  \u48120 \u47532  \u48372 \u47732 \u49436  \'93\u47924 \u47495  \u52293 \u50640  \u44592 \u47197 \u46108  \u47784 \u46304  \u51088 \u44032  \u44396 \u50896 \u51012  \u50619 \u51012  \u44163 \u51060 \u46972 \'94 (\u45800  12:1) \u44256  \u47568 \u54632 \u51004 \u47196 \u50024  \u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u51060  \u44396 \u50896 \u51012  \u50619 \u51012  \u44163 \u51012  \u47568 \u54620 \u45796 . \u44536 \u47532 \u44256  \u50836 \u54620 \u51008  \u44536  \u51060 \u47492 \u51060  \'93\u50612 \u47536 \u50577 \u51032  \u49373 \u47749 \u52293 \u50640  \u44592 \u47197 \u46108  \u51088 \u46308 \'94 (\u44228  21:27) \u47564 \u51060  \u54616 \u45208 \u45784 \u51032  \u49457 \u50640  \u46308 \u50612 \u44040  \u49688  \u51080 \u45796 \u44256  \u47568 \u54620 \u45796 .\
\uc0\u54616 \u45208 \u45784  \u50526 \u50640 \u45716  \'93\u44592 \u45392 \u52293 \'94\u51060  \u51080 \u51004 \u47728 , \u44144 \u44592 \u50640 \u45716  \'93\u50668 \u54840 \u50752 \u47484  \u44221 \u50808 \u54616 \u45716  \u51088 \u50752  \u44536  \u51060 \u47492 \u51012  \u51316 \u51473 \u55176  \u49373 \u44033 \u54616 \u45716  \u51088 \'94 (\u47568  3:16) \u46308 \u51032  \u49440 \u54620  \u54665 \u49892 \u51060  \u44592 \u47197 \u46104 \u50612  \u51080 \u45796 . \u48127 \u51020 \u50640 \u49436  \u45208 \u50728  \u44536 \u46308 \u51032  \u47568 , \u49324 \u46993 \u51032  \u54665 \u50948 \u44032  \u45796  \u54616 \u45720 \u50640  \u44592 \u47197 \u46108 \u45796 . \u51060 \u50640  \u45824 \u54616 \u50668  \u45712 \u54756 \u48120 \u50556 \u44032  \'93\u45236  \u54616 \u45208 \u45784 \u51060 \u50668  \u51060  \u51068 \u51012  \u51064 \u54616 \u50668  \u45208 \u47484  \u44592 \u50613 \u54616 \u50741 \u49548 \u49436  \u45236  \u54616 \u45208 \u45784 \u51032  \u51204 \u44284  \u44536  \u47784 \u46304  \u51649 \u47924 \u47484  \u50948 \u54616 \u50668  \u45208 \u51032  \u54665 \u54620  \u49440 \u54620  \u51068 \u51012  \u46020 \u47568 \u54616 \u51648  \u47560 \u50741 \u49548 \u49436 \'94 (\u45712  13:14) \u46972 \u44256  \u47568 \u54624  \u46412  \u44536 \u45716  \u51060  \u49324 \u49892 \u50640  \u45824 \u54616 \u50668  \u50616 \u44553 \u54620 \u45796 . \u54616 \u45208 \u45784 \u51032  \u44592 \u45392 \u52293 \u50640 \u45716  \u51032 \u47196 \u50868  \u54665 \u50948 \u44032  \u48736 \u51664 \u51060  \u50630 \u51060  \u50689 \u50896 \u55176  \u44592 \u47197 \u46108 \u45796 . \u44144 \u44592 \u50640 \u45716  \u50976 \u54841 \u51012  \u47932 \u47532 \u52828  \u44163 , \u50501 \u51012  \u51060 \u44596  \u44163 , \u48512 \u46300 \u47084 \u50868  \u51088 \u48708 \u47196  \u54364 \u54788 \u54620  \u47568 \u51060  \u47784 \u46160  \u51088 \u49464 \u55176  \u44592 \u47197 \u46108 \u45796 . \u44536 \u47532 \u44256  \u47784 \u46304  \u55148 \u49373 \u51201  \u54665 \u50948 \u50752  \u44536 \u47532 \u49828 \u46020 \u47484  \u50948 \u54616 \u50668  \u48155 \u51008  \u44256 \u45212 \u44284  \u49836 \u54548 \u51060  \u47784 \u46160  \u44592 \u47197 \u46108 \u45796 . \u49884 \u54200  \u44592 \u51088 \u45716  \'93\u45208 \u51032  \u50976 \u47532 \u54632 \u51012  \u51452 \u44760 \u49436  \u44228 \u49688 \u54616 \u49512 \u51004 \u45768  \u45208 \u51032  \u45576 \u47932 \u51012  \u51452 \u51032  \u48337 \u50640  \u45812 \u51004 \u49548 \u49436  \u51060 \u44163 \u51060  \u51452 \u51032  \u52293 \u50640  \u44592 \u47197 \u46104 \u51648  \u50500 \u45768 \u54616 \u50688 \u45208 \u51060 \u44620 \'94 (\u49884  56:8) \u46972 \u44256  \u47568 \u54620 \u45796 .\
\uc0\u44144 \u44592 \u50640 \u45716  \u46608 \u54620  \u49324 \u46988 \u46308 \u51032  \u51396 \u50501 \u51012  \u44592 \u47197 \u54616 \u45716  \u52293 \u51060  \u51080 \u45796 . \'93\u54616 \u45208 \u45784 \u51008  \u47784 \u46304  \u54665 \u50948 \u50752  \u47784 \u46304  \u51008 \u48128 \u54620  \u51068 \u51012  \u49440 \u50501 \u44036 \u50640  \u49900 \u54032 \u54616 \u49884 \u47532 \u46972 \'94 (\u51204  12:14). \u44396 \u51452 \u44760 \u49436 \u45716  \'93\u49324 \u46988 \u51060  \u47924 \u49832  \u47924 \u51061 \u54620  \u47568 \u51012  \u54616 \u46304 \u51648  \u49900 \u54032 \u45216 \u50640  \u51060 \u50640  \u45824 \u54616 \u50668  \u49900 \u47928 \u51012  \u48155 \u51004 \u47532 \u45768  \u45348  \u47568 \u47196  \u51032 \u47213 \u45796  \u54632 \u51012  \u48155 \u44256  \u45348  \u47568 \u47196  \u51221 \u51396 \u54632 \u51012  \u48155 \u51004 \u47532 \u46972 \'94 (\u47560  12:36, 37) \u44256  \u47568 \u50432 \u54616 \u49888 \u45796 . \u51008 \u48128 \u54620  \u47785 \u51201 \u44284  \u46041 \u44592 \u46020  \u49892 \u49688 \u54632 \u51060  \u50630 \u45716  \u44592 \u47197 \u50640 \u45716  \u48736 \u51656  \u49688  \u50630 \u45796 . \u50780 \u45264 \u54616 \u47732  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \'93\u50612 \u46176 \u50640  \u44048 \u52628 \u51064  \u44163 \u46308 \u51012  \u46300 \u47084 \u45236 \u44256  \u47560 \u51020 \u51032  \u46907 \u51012  \u45208 \u53440 \u45236 \u49884 \'94 (\u44256 \u51204  4:5) \u44592  \u46412 \u47928 \u51060 \u45796 . \'93\u48372 \u46972  \u51060 \u44163 \u51060  \u45236  \u50526 \u50640  \u44592 \u47197 \u46104 \u50632 \u51004 \u45768  \u45236 \u44032  \u51104 \u51104 \u52824  \u50500 \u45768 \u54616 \u44256  \u48152 \u46300 \u49884  \u48372 \u51025 \u54616 \u46104 \'85\u45320 \u55148 \u51032  \u51396 \u50501 \u44284  \u45320 \u55148  \u50676 \u51312 \u51032  \u51396 \u50501 \u51012  \u54632 \u44760  \u54616 \u47532 \'94 (\u49324  65:6, 7) \u46972 .\
