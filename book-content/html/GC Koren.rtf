\uc0\u44536 \u47084 \u45208  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u44536  \u52380 \u49324 \u50640 \u44172  \'93\u51060  \u51060 \u49345 \u51012  \u51060  \u49324 \u46988 \u50640 \u44172  \u44648 \u45803 \u44172  \u54616 \u46972 \'94 (\u45800  8:16) \u44256  \u47749 \u47161 \u54616 \u49512 \u45796 . \u44536  \u49324 \u47749 \u51008  \u50756 \u49688 \u46104 \u50612 \u50556  \u54624  \u44163 \u51060 \u50632 \u45796 . \u52380 \u49324 \u45716  \u44536  \u47749 \u47161 \u51012  \u46384 \u46972  \u50620 \u47560  \u54980 \u50640  \u45796 \u49884  \u45796 \u45768 \u50648 \u50640 \u44172  \u50752 \u49436  \'93\u45796 \u45768 \u50648 \u50500  \u45236 \u44032  \u51060 \u51228  \u45348 \u44172  \u51648 \u54812 \u50752  \u52509 \u47749 \u51012  \u51452 \u47140 \u44256  \u45208 \u50772 \u45208 \u45768 \'94 \'93\u44536 \u47088 \u51593  \u45320 \u45716  \u51060  \u51068 \u51012  \u49373 \u44033 \u54616 \u44256  \u44536  \u51060 \u49345 \u51012  \u44648 \u45804 \u51012 \u51648 \u45768 \u46972 \'94 (\u45800  9:22, 23) \u44256  \u47568 \u54616 \u50688 \u45796 . \u45796 \u45768 \u50648 \u49436  8\u51109 \u50640 \u49436  \u54644 \u49437 \u46104 \u51648  \u50506 \u44256  \u45224 \u50500  \u51080 \u45716  \u51473 \u50836 \u54620  \u54620  \u44032 \u51648  \u51216 \u51008  \u51593 , \u46412 \u50640  \u44288 \u54620  \u44163 , \u44263  2300\u51068 \u51032  \u44592 \u44036 \u50640  \u44288 \u54620  \u44163 \u51060 \u50632 \u45796 . \u44536 \u47084 \u48064 \u47196  \u52380 \u49324 \u44032  \u44536  \u54644 \u49444 \u51012  \u45796 \u49884  \u54624  \u46412  \u44536 \u45716  \u46412 \u50640  \u44288 \u54620  \u47928 \u51228 \u50640  \u52824 \u51473 \u54616 \u44172  \u46104 \u50632 \u45796 .\
