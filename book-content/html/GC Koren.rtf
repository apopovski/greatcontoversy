\uc0\u50689 \u44397 \u50640 \u49436 \u45716  \u44060 \u49888 \u44368 \u47484  \u44397 \u44368 \u47196  \u54620  \u44208 \u44284  \u48149 \u54644 \u51032  \u49464 \u47141 \u51060  \u48120 \u50557 \u54616 \u50668 \u51648 \u44592 \u45716  \u54616 \u50688 \u51004 \u45208  \u51204 \u50672  \u50630 \u50612 \u51648 \u51648 \u45716  \u50506 \u50520 \u45796 . \u47196 \u47560 \u44368 \u51032  \u44368 \u47532 \u45716  \u45824 \u48512 \u48516  \u54224 \u51648 \u46104 \u50632 \u51004 \u45208  \u44536  \u54805 \u49885 \u46308 \u51060  \u51201 \u51648  \u50506 \u44172  \u44536 \u45824 \u47196  \u45224 \u50500  \u51080 \u50632 \u45796 . \u48277 \u50773 \u51032  \u51208 \u45824 \u44428 \u51008  \u48512 \u51064 \u46104 \u50632 \u51004 \u45208  \u44536  \u45824 \u49888 \u50640  \u51076 \u44552 \u51060  \u44368 \u54924 \u51032  \u47672 \u47532 \u44032  \u46104 \u50632 \u45796 . \u44368 \u54924 \u51032  \u50696 \u48176 \u45716  \u50668 \u51204 \u55176  \u48373 \u51020 \u51032  \u49692 \u44208 \u49457 \u44284  \u45800 \u49692 \u49457 \u50640 \u49436  \u47680 \u47532  \u46496 \u45208  \u51080 \u50632 \u45796 . \u51333 \u44368  \u51088 \u50976 \u51032  \u45824 \u50896 \u52825 \u46020  \u50500 \u51649 \u44620 \u51648  \u51060 \u54644 \u46104 \u51648  \u47803 \u54616 \u44256  \u51080 \u50632 \u45796 . \u48708 \u47197  \u44060 \u54785 \u51452 \u51032 \u47484  \u49888 \u48393 \u54616 \u45716  \u44397 \u50773 \u46308 \u51008  \u47196 \u47560 \u44368 \u44032  \u51068 \u52237 \u51060  \u51060 \u45800 \u50640  \u45824 \u54616 \u50668  \u44284 \u54620  \u44536 \u47084 \u54620  \u51092 \u54841 \u54620  \u51068 \u51008  \u54616 \u51648  \u50506 \u50520 \u51012 \u51648 \u46972 \u46020  \u44033  \u49324 \u46988 \u51060  \u51088 \u44592 \u51032  \u50577 \u49900 \u51032  \u51648 \u49884 \u50640  \u46384 \u46972  \u54616 \u45208 \u45784 \u51012  \u44221 \u48176 \u54624  \u44428 \u47532 \u44032  \u51080 \u45796 \u45716  \u44163 \u51012  \u51064 \u51221 \u54616 \u44592 \u50640 \u45716  \u51060 \u47476 \u51648  \u50500 \u45768 \u54616 \u50688 \u45796 . \u47784 \u46304  \u49324 \u46988 \u51008  \u44397 \u44368 \u44032  \u51221 \u54620  \u44368 \u47532 \u47484  \u51064 \u51221 \u54616 \u44256  \u44536  \u50696 \u48176  \u54805 \u49885 \u51012  \u51456 \u49688 \u54616 \u46020 \u47197  \u50836 \u44396 \u47484  \u48155 \u44256  \u51080 \u50632 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44397 \u44368 \u50640  \u48152 \u45824 \u54616 \u45716  \u49324 \u46988 \u46308 \u51008  \u49688 \u48177  \u45380  \u46041 \u50504  \u48149 \u54644 \u47196  \u51064 \u54616 \u50668  \u51201 \u51648  \u50506 \u51008  \u44256 \u45212 \u51012  \u45817 \u54664 \u45796 .\
17\uc0\u49464 \u44592 \u50640 \u45716  \u49688 \u52380  \u47749 \u51032  \u47785 \u49324 \u46308 \u51060  \u54644 \u51649 \u46104 \u50632 \u45796 . \u49324 \u46988 \u46308 \u51008  \u44368 \u54924 \u50640 \u49436  \u51064 \u51221 \u54620  \u44163  \u51060 \u50808 \u51032  \u50612 \u46496 \u54620  \u51333 \u44368  \u51665 \u54924 \u50640 \u46020  \u52280 \u49437 \u54616 \u51648  \u47803 \u54616 \u46020 \u47197  \u44552 \u51648 \u45817 \u54616 \u50688 \u45716 \u45936 , \u44536  \u51068 \u51012  \u48276 \u54616 \u45716  \u46412 \u50640 \u45716  \u51473 \u54620  \u48268 \u44552 \u44284  \u53804 \u50725 \u44284  \u52628 \u48169 \u51032  \u50612 \u47140 \u50880 \u51012  \u45817 \u54616 \u50688 \u45796 . \u54616 \u45208 \u45784 \u51012  \u44221 \u48176 \u54616 \u44592  \u50948 \u54616 \u50668  \u47784 \u51060 \u45716  \u44163 \u51012  \u54924 \u54588 \u54624  \u49688  \u50630 \u50632 \u45912  \u52649 \u49457 \u46108  \u49324 \u46988 \u46308 \u51008  \u50612 \u46160 \u50868  \u46263 \u44264 \u47785 , \u52840 \u52840 \u54620  \u45796 \u46973 , \u48164 \u51473 \u51032  \u49688 \u54400  \u49549  \u46321 \u50640 \u49436  \u47784 \u51068  \u49688 \u48150 \u50640  \u50630 \u50632 \u45796 . \u49324 \u48169 \u50640 \u49436  \u48149 \u54644 \u47484  \u48155 \u45912  \u51452 \u45784 \u51032  \u51088 \u45376 \u46308 \u51008  \u44618 \u51008  \u49328 \u47548  \u49549 , \u44263  \u54616 \u45208 \u45784 \u44760 \u49436  \u52828 \u55176  \u47560 \u47144 \u54616 \u49888  \u49457 \u51204 \u50640  \u47784 \u50668  \u44536 \u46308 \u51032  \u47560 \u51020 \u51012  \u50676 \u50612  \u45459 \u44256  \u44592 \u46020 \u54616 \u47728  \u52268 \u48120 \u47484  \u48520 \u47104 \u45796 . \u44536 \u47084 \u45208  \u44536 \u52376 \u47100  \u51312 \u49900 \u54616 \u50688 \u51648 \u47564  \u47566 \u51008  \u49324 \u46988 \u51060  \u48127 \u51020  \u46412 \u47928 \u50640  \u44256 \u45212 \u51012  \u45817 \u54616 \u50688 \u45796 . \u44048 \u50725 \u51008  \u44873  \u52284 \u44256 , \u44032 \u51313 \u46308 \u51008  \u54756 \u50612 \u51276 \u45796 . \u46608  \u47566 \u51008  \u49324 \u46988 \u46308 \u51060  \u50808 \u44397 \u51004 \u47196  \u52628 \u48169 \u46104 \u50632 \u45796 . \u44536 \u47084 \u45208  \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u45817 \u49888 \u51032  \u48177 \u49457 \u46308 \u44284  \u54632 \u44760  \u54616 \u49512 \u45796 . \u44536 \u47084 \u48064 \u47196  \u54605 \u48149 \u51060  \u44536 \u46308 \u51032  \u51613 \u50616 \u51012  \u52840 \u47925 \u49884 \u53420  \u49688  \u50630 \u50632 \u45796 . \u47566 \u51008  \u49324 \u46988 \u51060  \u45824 \u49436 \u50577  \u44148 \u45320 \u54200  \u48120 \u44397 \u51004 \u47196  \u51923 \u44200 \u44052 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u46308 \u51008  \u44536  \u44275 \u50640 \u49436  \u51648 \u44552 \u44751  \u44536  \u45208 \u46972 \u51032  \u50689 \u44305 \u44284  \u48372 \u47336 \u47196  \u49340 \u50500 \u50728  \u51221 \u52824 \u50752  \u51333 \u44368 \u51032  \u51088 \u50976 \u50640  \u45824 \u54620  \u44592 \u52488 \u47484  \u45459 \u50520 \u45796 .\
\uc0\u49324 \u46020  \u49884 \u45824 \u50752  \u44057 \u51060  \u48149 \u54644 \u45716  \u45796 \u49884 \u44552  \u48373 \u51020 \u51032  \u48156 \u51204 \u51012  \u46037 \u45716  \u49688 \u45800 \u51060  \u46104 \u50632 \u45796 . \u50728 \u44054  \u48169 \u53461 \u51088 \u50752  \u47924 \u49436 \u50868  \u51396 \u51064 \u46308 \u51060  \u49438 \u50668  \u51080 \u45716  \u45572 \u52628 \u54620  \u50725 \u51473 \u50640 \u49436 \u46020  \u51316  \u48264 \u50672  (John Bunyan) \u51008  \u48148 \u47196  \u52380 \u44397 \u51032  \u48516 \u50948 \u44592 \u47484  \u54840 \u55137 \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u45716  \u47736 \u47581 \u51032  \u49464 \u49345 \u50640 \u49436  \u52380 \u44397  \u46020 \u49457 \u50640 \u44620 \u51648  \u51060 \u47476 \u45716  \u49692 \u47168 \u51088 \u51032  \u50668 \u54665 \u50640  \u44288 \u54620  \u50948 \u45824 \u54620  \u51060 \u50556 \u44592 \u47484  \u51200 \u49696 \u54616 \u50688 \u45796 . \u44536  \u54980  2\u48177 \u45380 \u51060  \u45336 \u46020 \u47197  \u48288 \u46300 \u54252 \u46300  (Bedford) \u50725 \u51473 \u50640 \u49436  \u45208 \u50728  \u44536  \u49548 \u47532 \u45716  \u53360  \u45733 \u47141 \u51004 \u47196  \u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u51012  \u44048 \u46041 \u49884 \u53412 \u44256  \u51080 \u45796 . \u48264 \u50672 \u51032  \u46160  \u51200 \u49436  \'93\u52380 \u47196 \u50669 \u51221 \'94\u44284  \'93\u51396 \u51064 \u51032  \u44340 \u49688 \u50640 \u44172  \u45336 \u52824 \u45716  \u51008 \u54812 \'94\u45716  \u47566 \u51008  \u49324 \u46988 \u46308 \u51012  \u49373 \u47749 \u51032  \u44600 \u47196  \u51064 \u46020 \u54616 \u44256  \u51080 \u45796 .\
\uc0\u48149 \u49828 \u53552  (Baxter), \u54540 \u47000 \u48660  (Flavel), \u50732 \u47536  (Alleine), \u44536  \u48150 \u50640  \u51116 \u45733  \u51080 \u44256  \u44368 \u50577  \u51080 \u44256  \u44618 \u51008  \u44536 \u47532 \u49828 \u46020 \u51064  \u44221 \u54744 \u51012  \u44032 \u51652  \u49324 \u46988 \u46308 \u51060  \u49457 \u46020 \u46308 \u50640 \u44172  \u45800 \u48264 \u50640  \u51452 \u49888  \u48127 \u51020 \u51012  \u49688 \u54840 \u54616 \u44592  \u50948 \u54616 \u50668  \u50857 \u44048 \u54616 \u44172  \u51068 \u50612 \u49456 \u45796 . \u44536  \u49324 \u46988 \u46308 \u51060  \u51060 \u47340  \u50629 \u51201 \u51008  \u48708 \u47197  \u51060  \u49464 \u49345 \u51032  \u50948 \u51221 \u51088 \u46308 \u50640 \u44172 \u49436 \u45716  \u48176 \u52377 \u51012  \u48155 \u44256  \u46020 \u50808 \u49884 \u46104 \u50612 \u46020  \u44208 \u53076  \u50630 \u50612 \u51656  \u49688  \u50630 \u45796 . \u54540 \u47000 \u48660 \u51060  \u51200 \u49696 \u54620  \'93\u49373 \u47749 \u51032  \u49368 \'94\u44284  \'93\u51008 \u54812 \u51032  \u50669 \u49324 \'94\u45716  \u49688 \u52380  \u47749 \u51032  \u49324 \u46988 \u46308 \u50640 \u44172  \u49900 \u47161 \u51012  \u44536 \u47532 \u49828 \u46020 \u44760  \u44228 \u49549 \u51201 \u51004 \u47196  \u48148 \u52824 \u45716  \u48169 \u48277 \u51012  \u44032 \u47476 \u52432  \u51452 \u50632 \u45796 . \u48149 \u49828 \u53552 \u51032  \u51200 \u49436  \'93\u44060 \u54785  \u47785 \u49324 \'94\u45716  \u54616 \u45208 \u45784 \u51032  \u49324 \u50629 \u51032  \u48512 \u55141 \u51012  \u50676 \u47581 \u54616 \u45716  \u47566 \u51008  \u49324 \u46988 \u46308 \u50640 \u44172  \u52629 \u48373 \u51004 \u47196  \u51064 \u51221 \u46104 \u50632 \u44256 , \u46608 \u54620  \u44536 \u51032  \u51200 \u49436  \'93\u49457 \u46020 \u51032  \u50689 \u50896 \u54620  \u50504 \u49885 \'94\u51008  \u50689 \u54844 \u46308 \u51012  \'93\u54616 \u45208 \u45784 \u51032  \u48177 \u49457 \u51012  \u50948 \u54616 \u50668  \u45224 \u44200  \u46164  \u50504 \u49885 \'94\u51004 \u47196  \u51064 \u46020 \u54616 \u45716  \u50669 \u54624 \u51012  \u54616 \u50688 \u45796 .\
