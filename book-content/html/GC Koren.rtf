\f0\b \cf0 \uc0\u48380 \u54532 \u50752  \u51116 \u47548 \u47928 \u51228 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u48380 \u54532 \u45716  \u51116 \u47548 \u51060  \u48149 \u46160 \u54616 \u50688 \u45796 \u45716  \u49324 \u49892 \u51012  \u48127 \u50632 \u45796 . \u50696 \u50616 \u51201  \u44592 \u44036 \u50640  \u45824 \u54620  \u44536 \u51032  \u54644 \u49437 \u50640  \u51032 \u54616 \u47732 , \u44536  \u50948 \u45824 \u54620  \u49548 \u50896 \u51060  \u49457 \u52712 \u46104 \u45716  \u45216 \u51008  \u48128 \u47084 \u44032  \u51648 \u51201 \u54620  \u48148 \u50752  \u44057 \u51060  \u48520 \u44284  \u47751  \u45380 \u48150 \u50640  \u50504  \u45224 \u50520 \u45796 . \'93\u44536 \u45216 \u44284  \u44536  \u46412 \u45716  \u50500 \u47924 \u46020  \u47784 \u47476 \u45208 \u45768 \'94\u46972 \u45716  \u49457 \u44221  \u47568 \u50432 \u51012  \u44032 \u51648 \u44256  \u51116 \u47548 \u51032  \u51076 \u48149 \u49457 \u50640  \u44288 \u54616 \u50668  \u50500 \u47924 \u44163 \u46020  \u50508  \u49688  \u50630 \u45796 \u44256  \u51452 \u51109 \u54616 \u45716  \u49324 \u46988 \u46308 \u50640  \u45824 \u54616 \u50668  \u48380 \u54532 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u45824 \u45813 \u54616 \u50688 \u45796 . \'93\u51452 \u45784 \u44760 \u49436  \u44284 \u50672  \u44536 \u45216 \u44284  \u44536  \u46412 \u47484  \u44208 \u53076  \u50508  \u49688  \u50630 \u45796 \u44256  \u47568 \u50432 \u54616 \u49512 \u45716 \u44032 ? \u51452 \u45784 \u44760 \u49436 \u45716  \u47560 \u52824  \u47924 \u54868 \u44284 \u45208 \u47924 \u51032  \u51086 \u49324 \u44480 \u44032  \u45208 \u47732  \u50668 \u47492 \u51060  \u44032 \u44620 \u50868  \u51460 \u51012  \u50500 \u45716  (\u47560  24:32) \u44163 \u52376 \u47100  \u50864 \u47532 \u50640 \u44172  \u51116 \u47548 \u51032  \u51208 \u48149 \u54632 \u51012  \u50508 \u47140  \u51452 \u44592  \u50948 \u54616 \u50668  \u46412 \u51032  \u51669 \u51312 \u46308 \u51012  \u51452 \u49884 \u51648  \u50500 \u45768 \u54616 \u49512 \u45716 \u44032 ? \u44536 \u47532 \u44256  \u51452 \u45784 \u44760 \u49436 \u45716  \u50864 \u47532 \u46308 \u47196  \u54616 \u50668 \u44552  \u45796 \u45768 \u50648 \u49436 \u47484  \u51069 \u44256  \u44536 \u44163 \u51012  \u51060 \u54644 \u54616 \u46972 \u44256  \u47568 \u50432 \u54616 \u49512 \u45716 \u45936 , \u50864 \u47532 \u44032  \u44536  \u44592 \u44036 \u51008  \u44208 \u53076  \u51060 \u54644 \u54624  \u49688  \u50630 \u51012  \u44163 \u51064 \u44032 ? \u44536 \u47532 \u44256  \u45796 \u45768 \u50648 \u49436 \u50640 \u49436 \u45716  \'91\u47560 \u51648 \u47561  \u46412 \u44620 \u51648 \'85\u51060  \u44544 \u51012  \u48393 \u54632 \u54616 \u46972 \'92 (\u44536 \u44163 \u51008  \u44536 \u51032  \u49884 \u45824 \u47484  \u44032 \u47532 \u53428 ) \u44256  \u54616 \u50688 \u44256 , \u44536  \u46412 \u50640  \u47566 \u51008  \u49324 \u46988 \u51060  \u48744 \u47532  \u50773 \u47000 \u54616 \u47728 \'92 (\u49884 \u45824 \u47484  \u44288 \u52272 \u54616 \u44256  \u49373 \u44033 \u54616 \u44172  \u54616 \u45716  \u55176 \u48652 \u47532 \u50612 \u51032  \u54620  \u54364 \u54788  \u48169 \u48277 ) \'91\u51648 \u49885 \u51060  (\u49884 \u45824 \u50640  \u44288 \u54620 ) \u45908 \u54616 \u47532 \u46972 \'92 (\u45800  12:4) \u44256  \u44592 \u47197 \u46104 \u50612  \u51080 \u51648  \u50506 \u45716 \u44032 ? \u45908 \u50865 \u51060  \u50864 \u47532  \u51452 \u45784 \u44760 \u49436  \u44536 \u47111 \u44172  \u47568 \u50432 \u54616 \u49888  \u44163 \u51008  \u44208 \u53076  \u46412 \u44032  \u44032 \u44620 \u50880 \u51012  \u50508  \u49688  \u50630 \u45796 \u45716  \u46907 \u51060  \u50500 \u45768 \u44256  \u45796 \u47564  \u51221 \u54869 \u54620  \'91\u44536 \u45216 \u44284  \u44536 \u46412 \u47484  \u50500 \u47924 \u46020  \u47784 \'92\u47480 \u45796 \u45716  \u46907 \u51060 \u45796 . \u45432 \u50500 \u44032  \u48169 \u51452 \u47484  \u51456 \u48708 \u54620  \u44163 \u52376 \u47100  \u50864 \u47532 \u47196  \u54616 \u50668 \u44552  \u51116 \u47548 \u51012  \u51456 \u48708 \u54616 \u46020 \u47197  \u46412 \u51032  \u51669 \u51312 \u47484  \u50508  \u49688  \u51080 \u44172  \u54616 \u49884 \u44256 \u51088  \u44536 \u48516 \u44760 \u49436  \u47568 \u50432 \u54616 \u49888  \u44163 \u51060 \u45796 \'92 (Wolff, Researches and Mis-sionary Labor, pp.404, 405).\
\uc0\u49457 \u44221 \u50640  \u45824 \u54620  \u53685 \u49549 \u51201 \u51064  \u54644 \u49437 \u48169 \u48277 \u44284  \u51096 \u47803  \u54644 \u49437 \u54616 \u45716  \u54224 \u45800 \u50640  \u45824 \u54616 \u50668  \u48380 \u54532 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u44592 \u47197 \u54616 \u50688 \u45796 . \'93\u44536 \u47532 \u49828 \u46020 \u44368 \u51032  \u45824 \u48512 \u48516 \u51008  \u49457 \u44221 \u51032  \u48516 \u47749 \u54620  \u51032 \u48120 \u50640 \u49436  \u48279 \u50612 \u45208 \u49436  \u48520 \u44368 \u46020 \u46308 \u51032  \u54872 \u50689 \u51201  (\u24187 \u24433 \u30340 ) \u51064  \u52404 \u44228 \u47196  \u46028 \u50500 \u49456 \u45796 . \u48520 \u44368 \u46020 \u46308 \u51008  \u51064 \u47448 \u51032  \u48120 \u47000 \u51032  \u54665 \u48373 \u51060  \u54728 \u44277 \u50640  \u46181 \u46181  \u46496 \u45796 \u45768 \u45716  \u44163 \u51004 \u47196  \u44396 \u49457 \u46112  \u44163 \u51060 \u46972 \u44256  \u48127 \u44256  \u51080 \u45796 . \u44536 \u46308 \u51008  \u50976 \u45824 \u51064 \u51060 \u46972 \u45716  \u47568 \u51012  \u51069 \u51004 \u47732  \u51060 \u48169 \u51064 \u51012  \u51060 \u54644 \u54644 \u50556  \u54616 \u44256 , \u50696 \u47336 \u49332 \u47128 \u51060 \u46972 \u44256  \u54616 \u47732  \u44368 \u54924 \u47196  \u54644 \u49437 \u54620 \u45796 . \u46608  \u51648 \u49345  (\u22320 \u19978 ) \u51060 \u46972 \u44256  \u54616 \u47732  \u44277 \u51473  (\u31354 \u20013 ) \u51004 \u47196  \u50508 \u44256  \u51452 \u45784 \u51032  \u51116 \u47548 \u51060 \u46972 \u44256  \u54616 \u47732  \u44033  \u51204 \u46020  \u49324 \u50629  \u45800 \u52404 \u51032  \u48156 \u51204 \u51004 \u47196  \u50508 \u44256 , \u50668 \u54840 \u50752 \u51032  \u51665 , \u49328 \u50640  \u50724 \u47480 \u45796 \u44256  \u54616 \u47732  \u44048 \u47532 \u44368 \u51064 \u46308 \u51032  \u53360  \u52509 \u54924 \u52376 \u47100  \u54644 \u49437 \u54620 \u45796 \'94 (Journal of the Rev.Joseph Wolff, p.96).\
