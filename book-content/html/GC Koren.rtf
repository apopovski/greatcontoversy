\uc0\u50976 \u50900 \u51208  \u50577 \u51012  \u51105 \u45716  \u44163 \u51008  \u44536 \u47532 \u49828 \u46020 \u51032  \u51453 \u51004 \u49900 \u51012  \u54364 \u49345 \u54616 \u45716  \u44163 \u51060 \u50632 \u45796 . \u48148 \u50872 \u51008  \'93\u50864 \u47532 \u51032  \u50976 \u50900 \u51208  \u50577  \u44263  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436  \u55148 \u49373 \u51060  \u46104 \u49512 \u45712 \u45768 \u46972 \'94 (\u44256 \u51204  5:17) \u44256  \u47568 \u54620 \u45796 . \u50976 \u50900 \u51208 \u50640  \u50668 \u54840 \u50752  \u50526 \u50640  \u55124 \u46308 \u50612  \u46300 \u47536  \u52376 \u51020  \u51061 \u51008  \u44257 \u49885 \u45800 \u51008  \u44536 \u47532 \u49828 \u46020 \u51032  \u48512 \u54876 \u51012  \u54364 \u49345 \u54616 \u50688 \u45796 . \u48148 \u50872 \u51008  \u51452 \u45784 \u51032  \u48512 \u54876 \u44284  \u44536 \u48516 \u51032  \u48177 \u49457 \u46308 \u51032  \u48512 \u54876 \u51012  \u47568 \u54616 \u47732 \u49436  \'93\u47676 \u51200 \u45716  \u52395  \u50676 \u47588 \u51064  \u44536 \u47532 \u49828 \u46020 \u50836  \u45796 \u51020 \u50640 \u45716  \u44536 \u47532 \u49828 \u46020  \u44053 \u47548 \u54616 \u49892  \u46412 \u50640  \u44536 \u50640 \u44172  \u48537 \u51008  \u51088 \'94 (\u44256 \u51204  15:23) \u46972 \u44256  \u54620 \u45796 . \u52628 \u49688 \u54616 \u44592  \u51204 \u50640  \u44144 \u46160 \u50612  \u50836 \u51228  (\u25622 \u31085 ) \u47196  \u46300 \u47140 \u51652  \u52376 \u51020  \u51061 \u51008  \u44257 \u49885 \u45800 \u52376 \u47100  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u51109 \u52264  \u48512 \u54876 \u51032  \u46412 \u50640  \u54616 \u45208 \u45784 \u51032  \u52285 \u44256 \u50640  \u46308 \u50612 \u44032 \u44172  \u46112  \u44396 \u49549 \u48155 \u51008  \u51088 \u46308 \u51032  \u50689 \u50896 \u54620  \u52628 \u49688 \u50640  \u51080 \u50612 \u49436  \u52376 \u51020  \u51061 \u51008  \u44257 \u49885 \u51060 \u49884 \u45796 . \u51060  \u54364 \u49345 \u51008  \u49324 \u44148 \u50640  \u51080 \u50612 \u49436 \u49104 \u47564  \u50500 \u45768 \u46972  \u44536  \u49884 \u44592 \u50640  \u51080 \u50612 \u49436 \u46020  \u49457 \u52712 \u46104 \u50632 \u45796 . \u50976 \u45824 \u47141 \u51032  \u52395 \u51704  \u45804  14\u51068 , \u44263  1500\u45380 \u44036 \u51032  \u51109 \u44396 \u54620  \u49464 \u50900 \u50640  \u44152 \u52432  \u50976 \u50900 \u51208  \u50577 \u51012  \u51105 \u50500 \u50724 \u45912  \u48148 \u47196  \u44536  \u45804  \u44536 \u45216 \u50640  \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \u51228 \u51088 \u46308 \u44284  \u54632 \u44760  \u50976 \u50900 \u51208  \u51092 \u52824 \u47484  \u51105 \u49688 \u49888  \u54980 \u50640  \'93\u49464 \u49345  \u51396 \u47484  \u51648 \u44256  \u44032 \u45716  \u54616 \u45208 \u45784 \u51032  \u50612 \u47536 \u50577 \'94\u51060 \u49888  \u45817 \u49888 \u51032  \u51453 \u51020 \u51012  \u44592 \u45392 \u54616 \u45716  \u44536  \u51032 \u49885 \u51012  \u51228 \u51221 \u54616 \u49512 \u45796 . \u48148 \u47196  \u44536 \u45216  \u48164 \u50640  \u44536 \u48516 \u44760 \u49436 \u45716  \u49901 \u51088 \u44032 \u50640  \u47803  \u48149 \u54784  \u46028 \u50500 \u44032 \u49884 \u44592  \u50948 \u54616 \u50668  \u50501 \u54620  \u51088 \u46308 \u51032  \u49552 \u50640  \u48537 \u51105 \u55176 \u49512 \u45796 . \u44536 \u47532 \u54616 \u50668  \u50864 \u47532  \u51452 \u45784 \u44760 \u49436 \u45716  \u50836 \u51228 \u51032  \u44257 \u49885 \u45800 \u51060  \u54364 \u49345 \u54620  \u49892 \u52404  (\u23526 \u39636 ) \u47196 \u49436  \u51228 \u49340 \u51068 \u50640  \'93\u51453 \u51008  \u51088  \u44032 \u50868 \u45936 \u49436  \u45796 \u49884  \u49332 \u50500  \u51104 \u51088 \u45716  \u51088 \u46308 \u51032  \u52395  \u50676 \u47588 \'94 (\u44256 \u51204  15:20), \u44263  \'93\u50864 \u47532 \u51032  \u45230 \u51008  \u47800 \u51012  \u51088 \u44592  \u50689 \u44305 \u51032  \u47800 \u51032  \u54805 \u52404 \u50752  \u44057 \u51060  \u48320 \u52992  \u54616 \'94 (\u4