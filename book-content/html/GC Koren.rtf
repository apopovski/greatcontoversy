\uc0\u51060  \u44060 \u54785 \u51088 \u44032  \u50724 \u47004  \u49884 \u51068 \u51012  \u46160 \u44256  \u45800 \u54840 \u54620  \u53804 \u51137 \u51032  \u45824 \u49345 \u51004 \u47196  \u49340 \u50500  \u50728  \u46608  \u54616 \u45208 \u51032  \u50501 \u54224 \u45716  \u53441 \u48156 \u49849 \u45800  (\u25176 \u37474 \u20711 \u22296 ) \u51228 \u46020 \u50688 \u45796 . \u51060  \u53441 \u48156 \u49849 \u46308 \u51008  \u50689 \u44397  \u50504 \u50640  \u45320 \u47924  \u47566 \u51060  \u51080 \u50632 \u51004 \u48064 \u47196  \u44397 \u44032 \u51032  \u48264 \u50689 \u50640  \u53360  \u51109 \u50528 \u44032  \u46104 \u44256  \u51080 \u50632 \u45796 . \u49328 \u50629 , \u44368 \u50977 , \u46020 \u45909 \u51060  \u47784 \u46160  \u44536  \u49632 \u53748 \u51032  \u50689 \u54693 \u51012  \u51077 \u44256  \u51080 \u50632 \u45796 . \u49849 \u47140 \u46308 \u51032  \u44172 \u51004 \u47480  \u49373 \u54876 \u44284  \u44396 \u44152 \u51008  \u49324 \u46988 \u46308 \u50640 \u44172  \u51116 \u51221 \u51201 \u51004 \u47196  \u47561 \u45824 \u54620  \u49552 \u49892 \u51012  \u51452 \u50632 \u51012  \u49104  \u50500 \u45768 \u46972  \u50976 \u50857 \u54620  \u45432 \u46041 \u51012  \u47736 \u49884 \u54616 \u45716  \u44208 \u44284 \u47484  \u52488 \u47000 \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u52397 \u45380 \u46308 \u51008  \u48512 \u46020 \u45909 \u54616 \u44256  \u53440 \u46973 \u54616 \u44172  \u46104 \u50632 \u45796 . \u47566 \u51008  \u49324 \u46988 \u46308 \u51060  \u53441 \u48156 \u49849 \u51032  \u50689 \u54693 \u51004 \u47196  \u49688 \u46020 \u50896 \u50640  \u46308 \u50612 \u44032 \u49436  \u51008 \u46164  \u49373 \u54876  (\u38577 \u36929 \u29983 \u27963 ) \u50640  \u47800 \u51012  \u48148 \u52824 \u46020 \u47197  \u44428 \u50976 \u47484  \u48155 \u50520 \u45796 . \u44536 \u46308 \u51008  \u48512 \u47784 \u50752  \u54633 \u51032 \u54616 \u51648 \u46020  \u50506 \u44256  \u48512 \u47784 \u50640 \u44172  \u50508 \u47532 \u51648 \u46020  \u50506 \u44256  \u44536 \u46308 \u51032  \u47749 \u47161 \u51012  \u44144 \u49828 \u47476 \u44256  \u51008 \u46164  \u49373 \u54876 \u50640  \u46308 \u50612 \u44052 \u45796 . \u52488 \u45824  \u47196 \u47560 \u44368 \u51032  \u50612 \u46500  \u44368 \u48512  (\u25934 \u29238 ) \u45716  \u51088 \u45376 \u47196 \u49436 \u51032  \u49324 \u46993 \u51060 \u45208  \u51032 \u47924 \u50640  \u45824 \u54620  \u51032 \u47532 \u48372 \u45796 \u46020  \u49688 \u46020  \u49373 \u54876  (\u20462 \u36947 \u29983 \u27963 ) \u51060  \u45908 \u50865  \u51473 \u50836 \u54632 \u51012  \u45796 \u51020 \u44284  \u44057 \u51060  \u44053 \u51312 \u54616 \u50688 \u45796 . \'93\u48708 \u47197  \u45320 \u51032  \u50500 \u48260 \u51648 \u44032  \u45320 \u51032  \u47928  \u50526 \u50640  \u45572 \u50892 \u49436  \u50872 \u44256  \u49836 \u54140 \u54624 \u51648 \u46972 \u46020 , \u45320 \u51032  \u50612 \u47672 \u45768 \u44032  \u45320 \u47484  \u45235 \u50520 \u45912  \u47800 \u44284  \u45320 \u47484  \u51222 \u47673 \u51060 \u45912  \u44032 \u49844 \u51012  \u48372 \u51068 \u51648 \u46972 \u46020 , \u45320 \u45716  \u44536 \u46308 \u51012  \u48156 \u47196  \u51667 \u48159 \u50500  \u48260 \u47532 \u44256  \u44536 \u47532 \u49828 \u46020 \u50640 \u44172 \u47196  \u44263 \u51109  \u45804 \u47140 \u44032 \u50556  \u54620 \u45796 .\'94 \u54980 \u51068 \u50640  \u47336 \u53552 \u45716  \u51060 \u50640  \u45824 \u54616 \u50668  \u51060 \u47088  \'93\u47924 \u49436 \u50868  \u48708 \u51064 \u46020 \u51201  \u54665 \u50948 \u45716  \u44536 \u47532 \u49828 \u46020 \u51064 \u44284  \u49324 \u46988 \u51032  \u54665 \u50948 \u46972 \u44592 \u48372 \u45796 \u45716  \u52264 \u46972 \u47532  \u51060 \u47532 \u45208  \u54253 \u44400 \u51032  \u54665 \u50948 \'94 (Barnas Sears, The Life of Luther, pp.70, 69) \u47196  \u49373 \u44033 \u46108 \u45796 \u44256  \u47568 \u54616 \u50688 \u45796 . \u51060 \u47088  \u51068 \u46308 \u51060  \u51088 \u45376 \u46308 \u51032  \u47560 \u51020 \u51012  \u48512 \u47784 \u50640  \u45824 \u54616 \u50668  \u47924 \u51221 \u54616 \u44172  \u47564 \u46308 \u50632 \u45796 . \u51060 \u47532 \u54616 \u50668  \u48277 \u50773 \u44368 \u51032  \u51648 \u46020 \u51088 \u46308 \u51008  \u50715 \u45216  \u48148 \u47532 \u49352 \u44368 \u51064 \u46308 \u52376 \u47100  \u44536 \u46308 \u51032  \u50976 \u51204 \u51004 \u47196  \u54616 \u45208 \u45784 \u51032  \u44228 \u47749 \u51012  \u47924 \u47141 \u54616 \u44172  \u47564 \u46308 \u50632 \u45796 . \u46384 \u46972 \u49436  \u44032 \u51221 \u46308 \u51008  \u54889 \u54224 \u46104 \u50632 \u51004 \u47728  \u48512 \u47784 \u46308 \u51008  \u44536 \u46308 \u51032  \u51088 \u45376 \u46308 \u44284 \u51032  \u44368 \u51228 \u47484  \u51075 \u50612 \u48260 \u47532 \u44172  \u46104 \u50632 \u45796 .\
\uc0\u49900 \u51648 \u50612  \u45824 \u54617 \u44368 \u51032  \u54617 \u49373 \u46308 \u44620 \u51648 \u46020  \u49849 \u47140 \u46308 \u51032  \u44144 \u51667 \u46108  \u47568 \u50640  \u49549 \u50500 \u49436  \u44536 \u46308 \u51032  \u45824 \u50676 \u50640  \u44032 \u45812 \u54616 \u44172  \u46104 \u50632 \u45796 . \u44536 \u47088  \u54980 \u50640  \u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u51088 \u44592 \u46308 \u51032  \u49373 \u50528 \u47484  \u54644 \u47213 \u44172  \u54616 \u44256  \u48512 \u47784 \u50640 \u44172  \u49836 \u54548 \u51012  \u50504 \u44200 \u51456  \u44163 \u51012  \u50508 \u44256  \u54980 \u54924 \u54616 \u44172  \u46104 \u50632 \u51004 \u45208  \u51068 \u45800  \u50732 \u47924 \u50640  \u45800 \u45800 \u55176  \u44152 \u47536  \u45796 \u51020 \u50640 \u45716  \u45796 \u49884  \u51088 \u50976 \u47484  \u52286 \u51012  \u49688  \u50630 \u50632 \u45796 . \u47566 \u51008  \u48512 \u47784 \u46308 \u51008  \u49849 \u47140 \u46308 \u51032  \u50689 \u54693 \u51012  \u46160 \u47140 \u50892 \u54616 \u50668  \u44536 \u46308 \u51032  \u50500 \u46308 \u46308 \u51012  \u45824 \u54617 \u51004 \u47196  \u48372 \u45236 \u51648  \u50506 \u50520 \u45796 . \u44536 \u47532 \u54616 \u50668  \u54617 \u47928 \u51032  \u50948 \u45824 \u54620  \u51473 \u49900 \u51648 \u50640  \u47784 \u50668 \u46300 \u45716  \u54617 \u49373  \u49688 \u45716  \u54788 \u51200 \u54616 \u44172  \u51460 \u50612 \u46308 \u44256  \u51080 \u50632 \u45796 . \u54617 \u44368 \u46308 \u51008  \u49632 \u53748 \u54616 \u50668  \u44052 \u44256  \u47924 \u51648  (\u28961 \u30693 ) \u45716  \u54200 \u47564 \u54616 \u44172  \u46104 \u50632 \u45796 .\
\uc0\u48277 \u50773 \u51008  \u49849 \u47140 \u46308 \u50640 \u44172  \u49324 \u46988 \u46308 \u51032  \u51088 \u48373 \u51012  \u46307 \u44256  \u50857 \u49436 \u54644  \u51452 \u45716  \u44428 \u49464 \u47484  \u51452 \u50632 \u45796 . \u51060 \u44163 \u51060  \u46608 \u54620  \u51396 \u50501 \u51032  \u53360  \u50896 \u51064 \u51060  \u46104 \u50632 \u45796 . \u49849 \u47140 \u46308 \u51008  \u44536 \u46308 \u51032  \u49324 \u48373 \u51012  \u52292 \u50864 \u44592  \u50948 \u54616 \u50668  \u49324 \u46988 \u46308 \u51060  \u50612 \u46496 \u54620  \u51396 \u50501 \u51012  \u44256 \u48177 \u54616 \u46304 \u51648  \u44263  \u49324 \u47732 \u54616 \u50668  \u51452 \u48064 \u47196  \u44536  \u44208 \u44284 \u47196  \u44032 \u51109  \u50501 \u54620  \u51396 \u50501 \u51060  \u44553 \u44201 \u55176  \u51613 \u44032 \u54616 \u44172  \u46104 \u50632 \u45796 . \u48337 \u51088 \u50752  \u44032 \u45212 \u54620  \u51088 \u46308 \u51008  \u46028 \u50500 \u48372 \u51648  \u50506 \u51004 \u47732 \u49436  \u47560 \u46405 \u55176  \u44536 \u46308 \u51032  \u44417 \u54605 \u51012  \u51228 \u44144 \u54616 \u45716  \u51068 \u50640  \u50416 \u50668 \u51256 \u50556  \u54624  \u49440 \u47932 \u46308 \u51008  \u49849 \u47140 \u46308 \u50640 \u44172 \u47196  \u45336 \u50612 \u44052 \u45796 . \u49849 \u47140 \u46308 \u51008  \u50948 \u54801 \u51004 \u47196  \u49324 \u46988 \u46308 \u51032  \u49884 \u50668  (\u26045 \u33287 ) \u47484  \u44053 \u50836 \u54616 \u50688 \u44256 , \u44536  \u51068 \u51012  \u44144 \u51208 \u54616 \u50668  \u44592 \u48512 \u54616 \u51648  \u50506 \u45716  \u51088 \u50640 \u44172 \u45716  \u48520 \u50728 \u54620  \u47568 \u51012  \u54616 \u47728  \u48708 \u45212 \u54616 \u50688 \u45796 . \u54364 \u47732 \u49345 \u51004 \u47196 \u45716  \u48712 \u44260 \u54616 \u45796 \u44256  \u47568 \u54616 \u51648 \u47564 , \u49849 \u47140 \u46308 \u51032  \u51116 \u49328 \u51008  \u44228 \u49549 \u54644 \u49436  \u51613 \u44032 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51032  \u54988 \u47469 \u54620  \u51200 \u53469 \u44284  \u49324 \u52824 \u49828 \u47084 \u50868  \u49885 \u53441 \u51008  \u48177 \u49457 \u46308 \u51032  \u48712 \u44260 \u51012  \u45908 \u50865  \u49900 \u54616 \u44172  \u54644 \u51452 \u50632 \u45796 . \u44536 \u46308  \u51088 \u49888 \u51008  \u54693 \u46973 \u44284  \u49324 \u52824 \u50640  \u48736 \u51256  \u49884 \u44036 \u51012  \u48372 \u45236 \u47732 \u49436 , \u44592 \u44340 \u54620  \u51060 \u50556 \u44592 \u50752  \u50715  \u51204 \u49444 \u44284  \u48177 \u49457 \u46308 \u51012  \u44221 \u48149 \u54616 \u44172  \u47564 \u46308 \u50612  \u51452 \u45716  \u45453 \u45812 \u46308 \u48150 \u50640  \u54624  \u49688  \u50630 \u45716  \u47924 \u51648 \u54620  \u49324 \u46988 \u46308 \u51012  \u44536 \u46308  \u45824 \u49888  \u48372 \u45236 \u50612  \u49324 \u46988 \u46308 \u51012  \u45908 \u50865  \u50756 \u51204 \u55176  \u49849 \u47140 \u46308 \u51032  \u49549 \u51076 \u49688 \u50640  \u45336 \u50612 \u44032 \u44172  \u54616 \u50688 \u45796 . \u44536 \u47100 \u50640 \u46020  \u48520 \u44396 \u54616 \u44256  \u48120 \u49888 \u51201 \u51064  \u51068 \u48152  \u49324 \u46988 \u46308 \u51008  \u44536 \u47084 \u54620  \u49849 \u47140 \u46308 \u51012  \u51648 \u51648 \u54616 \u44256 , \u48277 \u50773 \u51032  \u51208 \u45824 \u44428 \u51012  \u51064 \u51221 \u54616 \u44256 , \u49457 \u46020 \u47484  \u49709 \u48176 \u54616 \u44256 , \u49849 \u47140 \u46308 \u50640 \u44172  \u49440 \u47932 \u51012  \u46300 \u47532 \u48064 \u47196  \u51333 \u44368 \u51201  \u51032 \u47924 \u47484  \u50756 \u51204 \u55176  \u45796 \u54616 \u45716  \u44163 \u51004 \u47196  \u49373 \u44033 \u54616 \u44256 , \u44536 \u47111 \u44172  \u54632 \u51004 \u47196  \u52380 \u44397 \u50640  \u46308 \u50612 \u44032 \u44592 \u50640  \u45321 \u45321 \u54620  \u51088 \u44201 \u51012  \u50619 \u44172  \u46108 \u45796 \u44256  \u48127 \u50632 \u45796 .\
\uc0\u54617 \u49885  \u51080 \u44256  \u44221 \u44148 \u54620  \u47566 \u51008  \u49324 \u46988 \u46308 \u51060  \u51060 \u47084 \u54620  \u53441 \u48156 \u49849 \u51032  \u51228 \u46020 \u47484  \u44060 \u54785 \u54616 \u44256 \u51088  \u49688 \u52264  \u49884 \u46020 \u54616 \u50688 \u51004 \u45208  \u54747 \u49688 \u44256 \u44032  \u46104 \u44256  \u47568 \u50520 \u45796 . \u44536 \u47084 \u45208  \u50696 \u48124 \u54620  \u53685 \u52272 \u47141 \u51012  \u44032 \u51652  \u50948 \u53364 \u47532 \u54532 \u45716  \u44536  \u51228 \u46020  \u51088 \u52404 \u44032  \u44144 \u51667 \u46108  \u44163 \u51060 \u48064 \u47196  \u54224 \u51648 \u46104 \u50612 \u50556  \u54620 \u45796 \u44256  \u49440 \u54252 \u54616 \u47732 \u49436  \u50501 \u51032  \u49100 \u47532 \u47484  \u44277 \u44201 \u54616 \u50688 \u45796 . \u53664 \u47200 \u44284  \u51032 \u47928 \u51060  \u49324 \u48169 \u50640 \u49436  \u51068 \u50612 \u45228 \u45796 . \u49849 \u47140 \u46308 \u51060  \u48277 \u50773 \u51032  \u47732 \u51396 \u48512  (\u20813 \u32618 \u31526 ) \u47484  \u54036 \u47732 \u49436  \u44033 \u52376 \u47196  \u46028 \u50500 \u45796 \u45768 \u45716  \u44163 \u51012  \u48376  \u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u44284 \u50672  \u46024 \u51004 \u47196  \u51396 \u49324 \u54632 \u51012  \u50619 \u51012  \u49688  \u51080 \u51012  \u44163 \u51064 \u51648 \u50640  \u45824 \u54616 \u50668  \u51032 \u49900 \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u46308 \u51008  \u47196 \u47560  \u48277 \u50773 \u50640 \u44172 \u48372 \u45796 \u45716  \u50724 \u55176 \u47140  \u54616 \u45208 \u45784 \u44760  \u51396 \u49324 \u54632 \u51012  \u44396 \u54616 \u50668 \u50556  \u54624  \u44163 \u51060  \u50500 \u45768 \u45264 \u44256  \u51656 \u47928 \u54616 \u50688 \u45796 . \u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u44208 \u53076  \u47564 \u51313 \u54624  \u51460  \u47784 \u47476 \u45716  \u44163 \u52376 \u47100  \u48372 \u51060 \u45716  \u53441 \u48156 \u49849  (\u25176 \u37474 \u20711 ) \u46308 \u51032  \u53456 \u50837 \u50640  \u45440 \u46992 \u45796 . \u44536 \u46308 \u51008  \'93\u47196 \u47560 \u51032  \u49849 \u47140 \u50752  \u49888 \u48512 \u46308 \u51060  \u50516  (\u30284 ) \u52376 \u47100  \u50864 \u47532 \u47484  \u51328 \u47673 \u44256  \u51080 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436  \u50864 \u47532 \u47484  \u44396 \u50896 \u54616 \u49884 \u51648  \u50506 \u51004 \u47732  \u48177 \u49457 \u46308 \u51008  \u47736 \u47581 \u54624  \u44163 \u51060 \u45796 \'94 (D\'92Aubigne, b.17, ch.7) \u46972 \u44256  \u47568 \u54616 \u50688 \u45796 . \u44396 \u44152 \u54616 \u47732 \u49436  \u45796 \u45768 \u45716  \u44536  \u49849 \u47140 \u46308 \u51008  \u51088 \u44592 \u46308 \u51032  \u53456 \u50837 \u51012  \u44048 \u52628 \u44592  \u50948 \u54616 \u50668  \u50696 \u49688 \u45784 \u44284  \u44536 \u48516 \u51032  \u51228 \u51088 \u46308 \u51060  \u48177 \u49457 \u46308 \u51032  \u51088 \u49440 \u50640  \u51032 \u54616 \u50668  \u49373 \u54876 \u54616 \u50688 \u45796 \u44256  \u51452 \u51109 \u54616 \u48064 \u47196  \u44536 \u46308 \u51008  \u44396 \u51452 \u51032  \u47784 \u48376 \u51012  \u46384 \u46972 \u44032 \u44256  \u51080 \u45432 \u46972 \u44256  \u54616 \u50688 \u45796 . \u44536 \u50752  \u44057 \u51008  \u51452 \u51109 \u51008  \u44536 \u46308 \u51032  \u49324 \u50629 \u50640  \u54644 \u47196 \u50868  \u44208 \u44284 \u47484  \u44032 \u51256 \u50772 \u45796 . \u50780 \u45264 \u54616 \u47732  \u44536 \u47196  \u51064 \u54616 \u50668  \u47566 \u51008  \u49324 \u46988 \u46308 \u51060  \u51652 \u47532 \u47484  \u48176 \u50864 \u44592  \u50948 \u54616 \u50668  \u49457 \u44221 \u51004 \u47196  \u46028 \u50500 \u44032 \u44172  \u46104 \u50632 \u45716 \u45936 , \u44536 \u44163 \u51008  \u50612 \u46500  \u51068 \u48372 \u45796  \u47196 \u47560 \u44032  \u44032 \u51109  \u49899 \u50612 \u54616 \u45716  \u51068 \u51060 \u50632 \u44592  \u46412 \u47928 \u51060 \u45796 . \u47566 \u51008  \u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u51008  \u48148 \u47196  \u47196 \u47560 \u44368 \u44032  \u49704 \u44592 \u44256 \u51088  \u54616 \u45716  \u51652 \u47532 \u51032  \u44540 \u50896 \u51012  \u52286 \u50500  \u45208 \u50500 \u44032 \u44172  \u46104 \u50632 \u45796 .\
\uc0\u50948 \u53364 \u47532 \u54532 \u45716  \u53441 \u48156 \u49849 \u45800 \u51012  \u48152 \u45824 \u54616 \u45716  \u49548 \u52293 \u51088 \u47484  \u51200 \u49696 \u54616 \u44592  \u49884 \u51089 \u54616 \u50688 \u45716 \u45936 , \u44536 \u44163 \u51008  \u44536 \u46308 \u44284  \u45436 \u51137 \u54616 \u44592  \u50948 \u54644 \u49436 \u44032  \u50500 \u45768 \u44256  \u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u51012  \u49457 \u44221 \u44284  \u44536  \u51200 \u51088  \u46104 \u49884 \u45716  \u54616 \u45208 \u45784 \u51032  \u44368 \u54984 \u51004 \u47196  \u51064 \u46020 \u54616 \u44592  \u50948 \u54632 \u51060 \u50632 \u45796 . \u44536 \u45716  \u48277 \u50773 \u51032  \u49324 \u47732 \u54616 \u44144 \u45208  \u54028 \u47928 \u54616 \u45716  \u44428 \u49464 \u44032  \u48372 \u53685  \u49888 \u48512  \u51060 \u49345 \u51032  \u44428 \u49464 \u44032  \u46112  \u49688  \u50630 \u45796 \u44256  \u51452 \u51109 \u54616 \u44256 , \u49324 \u46988 \u51060  \u54616 \u45208 \u45784 \u44760 \u47196 \u48512 \u53552  \u47676 \u51200  \u51221 \u51396 \u51032  \u49440 \u44256 \u47484  \u48155 \u51648  \u50506 \u45716  \u54620  \u50500 \u47924 \u46020  \u52280 \u51004 \u47196  \u54028 \u47928 \u46112  \u49688  \u50630 \u45796 \u44256  \u49440 \u50616 \u54616 \u50688 \u45796 . \u51060  \u51068 \u51008  \u49688 \u47566 \u51008  \u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u44284  \u47800 \u51012  \u49549 \u48149 \u54616 \u44592  \u50948 \u54616 \u50668  \u48277 \u50773 \u51060  \u51228 \u51221 \u54620  \u50689 \u51201  \u48143  \u49464 \u49549 \u51201 \u51064  \u44144 \u45824 \u54620  \u51312 \u51649 \u52404 \u47484  \u54028 \u44340 \u54616 \u45716  \u45936  \u51080 \u50612 \u49436  \u45908 \u54624  \u49688  \u50630 \u51060  \u54952 \u44284 \u51201 \u51064  \u48169 \u48277 \u51060  \u46104 \u50632 \u45796 .\
