\uc0\u47566 \u51008  \u44060 \u49888 \u44368 \u54924 \u46308 \u51008  \u47196 \u47560 \u44368 \u44032  \'93\u46405 \u51032  \u51076 \u44552 \u46308 \'94\u44284  \u48520 \u51032 \u51032  \u44288 \u44228 \u47484  \u47610 \u51008  \u44536  \u48376 \u51012  \u46384 \u47476 \u44256  \u51080 \u45716 \u45936 , \u44397 \u44368 \u46308 \u51008  \u45208 \u46972 \u51032  \u51221 \u48512 \u50752  \u49552 \u51012  \u47560 \u51452 \u51105 \u44256 , \u44536 \u48150 \u50640  \u45796 \u47480  \u44368 \u54028 \u46308 \u51008  \u49464 \u49345 \u51032  \u52509 \u50528 \u47484  \u48155 \u44256 \u51088  \u50528 \u50416 \u44256  \u51080 \u45796 . \u44536 \u47532 \u54616 \u50668  \u48148 \u48296 \u47200 , \u44263  \u54844 \u51105 \u51060 \u46972 \u45716  \u47568 \u51008  \u44536 \u47088  \u47784 \u46304  \u45800 \u52404 \u46308 , \u45796 \u49884  \u47568 \u54616 \u47732  \u44536 \u46308 \u51032  \u44368 \u47532 \u44032  \u49457 \u44221 \u50640 \u49436  \u45208 \u50772 \u45796 \u44256  \u54616 \u47732 \u49436 \u46020  \u50724 \u55176 \u47140  \u47568 \u54624  \u49688  \u50630 \u51060  \u47566 \u51008  \u49688 \u54952 \u51032  \u44368 \u54028 \u47196  \u45208 \u45656 \u44256  \u44033 \u44033  \u49436 \u47196  \u50857 \u45225 \u54624  \u49688  \u50630 \u45716  \u49888 \u51312 \u50752  \u51060 \u47200 \u51012  \u44032 \u51652  \u44536  \u50668 \u47084  \u45800 \u52404 \u46308 \u50640 \u44172  \u51089 \u50857 \u46104 \u44592 \u50640  \u44845  \u50508 \u47582 \u45796 .\
\uc0\u49548 \u50948  \u47196 \u47560 \u44368 \u50640 \u49436  \u48516 \u47532 \u46104 \u50612  \u45208 \u50772 \u45796 \u45716  \u44368 \u54924 \u46308 \u51060  \u50724 \u55176 \u47140  \u49464 \u49345 \u51004 \u47196  \u45908 \u48520 \u50612  \u51396 \u50501 \u51201 \u51064  \u44208 \u54633 \u51012  \u44228 \u49549 \u54624  \u49104  \u50500 \u45768 \u46972 , \u44536 \u46308  \u49828 \u49828 \u47196 \u44032  \u47196 \u47560 \u44368 \u51032  \u45796 \u47480  \u53945 \u49457 \u46308 \u51012  \u45208 \u53440 \u45236 \u44256  \u51080 \u45796 .\
\uc0\u47196 \u47560 \u44368 \u51032  \u54620  \u51200 \u49436 \u45716  \'93\u47564 \u51068  \u47196 \u47560 \u44368 \u44032  \u49457 \u46020 \u46308 \u44284 \u51032  \u44288 \u44228 \u50640  \u51080 \u50612 \u49436  \u50864 \u49345  \u49709 \u48176 \u51032  \u51396 \u47484  \u48276 \u54616 \u50688 \u45796 \u44256  \u54624  \u44163  \u44057 \u51004 \u47732 , \u50676  \u44060 \u51032  \u44368 \u54924 \u47484  \u47560 \u47532 \u50500 \u50640 \u44172  \u48148 \u52824 \u44256  \u54620  \u44060 \u51032  \u44368 \u54924 \u47484  \u44536 \u47532 \u49828 \u46020 \u44760  \u48148 \u52828  \u47196 \u47560 \u44368 \u51032  \u46392 , \u50689 \u44397  \u44368 \u54924 \u46020  \u46609 \u44057 \u51008  \u51396 \u47484  \u48276 \u54616 \u44256  \u51080 \u45796 \'94 (Richard Chal-loner, The Catholic Christian Instructed, Preface, pp 21, 22) \u44256  \u51452 \u51109 \u54620 \u45796 .\
\uc0\u46608 \u54620  \u54857 \u53416 \u51592  \u48149 \u49324 \u45716  \u52380 \u45380 \u44592 \u50640  \u45824 \u54620  \u45436 \u47928 \u50640 \u49436  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u54620 \u45796 . \'93\u47196 \u47560 \u44368 \u47564  \u51201 \u44536 \u47532 \u49828 \u46020 \u51032  \u51221 \u49888 \u44284  \u54665 \u46041 \u51012  \u44032 \u51648 \u44256  \u51080 \u45796 \u44256  \u44508 \u51221 \u54624  \u51060 \u50976 \u45716  \u51312 \u44552 \u46020  \u50630 \u45796 . \u44060 \u49888 \u44368 \u46020 \u46308 \u46020  \u51201 \u44536 \u47532 \u49828 \u46020 \u51201  \u50836 \u49548 \u47484  \u44536 \u46308  \u51088 \u52404  \u50504 \u50640  \u44032 \u51648 \u44256  \u51080 \u51004 \u48064 \u47196  \u44536 \u46308 \u51060  \u48512 \u54056 \u50752  \u51396 \u50501 \u50640 \u49436 \'85\u50756 \u51204 \u55176  \u48279 \u50612 \u45228 \u45796 \u44256  \u48380  \u49688  \u50630 \u45796 \'94 (Samuel Hopkins, Works, vol, 2, p.328).\
\uc0\u51109 \u47196 \u44368 \u44032  \u47196 \u47560 \u44368 \u50640 \u49436  \u48516 \u47532 \u46108  \u45936  \u45824 \u54616 \u50668  \u44144 \u46300 \u47532  \u48149 \u49324 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u44592 \u47197 \u54616 \u50688 \u45796 . \'93300\u45380  \u51204 \u50640  \u50864 \u47532  \u44368 \u54924 \u45716  \u54204 \u52432 \u51652  \u49457 \u44221 \u51012  \u44400 \u44592 \u47196  \u49340 \u44256 , \'91\u49457 \u44221 \u51012  \u53456 \u44396 \u54616 \u46972 \'92\u45716  \u54364 \u50612 \u47484  \u45236 \u44152 \u44256  \u47196 \u47560 \u44368 \u51032  \u47928 \u50640 \u49436 \u48512 \u53552  \u54665 \u44400 \u54616 \u50668  \u45208 \u50772 \u45796 .\'94 \u44536  \u45796 \u51020 \u50640  \u44536 \u45716  \'93\u44536 \u47084 \u45208  \u44536 \u46308 \u51060  \u48148 \u48296 \u47200 \u50640 \u49436 \u48512 \u53552  \u50756 \u51204 \u55176  \u45208 \u50772 \u45716 \u44032 ?\'94 (Thomas Guthrie, The Gospel in Ezekiel, p, 237) \u54616 \u45716  \u51032 \u48120 \u49900 \u51109 \u54620  \u51656 \u47928 \u51012  \u54616 \u50688 \u45796 .\
\uc0\u49828 \u54148 \u51204 \u51008  \u47568 \u54616 \u50688 \u45796 . \'93\u50689 \u44397  \u44368 \u54924 \u45716  \u52384 \u46160 \u52384 \u48120 \u54616 \u44172  \u54805 \u49885 \u51452 \u51032 \u50640  \u48736 \u51256 \u46308 \u50612  \u44036  \u46319 \u51060  \u48372 \u51064 \u45796 . \u44536 \u47084 \u45208  \u48708 \u44397 \u44368 \u54028 \u46020  \u44536 \u50640  \u47803 \u51648 \u50506 \u44172  \u52384 \u54617 \u51201  \u48520 \u49888 \u50521  \u53804 \u49457 \u51060 \u51064  \u44163 \u44057 \u51060  \u48372 \u51064 \u45796 . \u50864 \u47532 \u44032  \u51339 \u44172  \u49373 \u44033 \u54664 \u45912  \u44536 \u46308 \u51060  \u44228 \u49549 \u54616 \u50668  \u54616 \u45208 \u50473  \u54616 \u45208 \u50473  \u49888 \u50521 \u51032  \u44592 \u52488 \u50640 \u49436  \u46496 \u45208 \u44032 \u44256  \u51080 \u45796 . \u50724 \u45720 \u45216  \u50689 \u44397 \u51032  \u51473 \u49900 \u48512 \u45716  \u44053 \u45800 \u50640 \u49436  \u49444 \u44368 \u47484  \u54632 \u51004 \u47196  \u49828 \u49828 \u47196  \u44536 \u47532 \u49828 \u46020 \u51064 \u51060 \u46972 \u44256  \u51452 \u51109 \u54616 \u45716  \u44032 \u51613 \u54620  \u48520 \u49888 \u51088 \u46308 \u51032  \u49548 \u44404 \u51060  \u46104 \u50612 \u51080 \u45796 \u44256  \u45208 \u45716  \u45800 \u51221 \u54616 \u45716  \u48148 \u51060 \u45796 .\'94\
\uc0\u44536 \u47084 \u47732  \u53360  \u48176 \u44368 \u51032  \u48156 \u45800 \u51008  \u47924 \u50631 \u51064 \u44032 ? \u50612 \u46523 \u44172  \u44368 \u54924 \u44032  \u48373 \u51020 \u51032  \u49692 \u49688 \u49457 \u50640 \u49436  \u46496 \u45208 \u44032 \u44172  \u46104 \u50632 \u45716 \u44032 ? \u44536 \u44163 \u51008  \u45796 \u49888 \u44368 \u51032  \u49845 \u44288 \u51012  \u46384 \u47492 \u51004 \u47196  \u51060 \u44368 \u46020 \u47196  \u54616 \u50668 \u44552  \u44536 \u47532 \u49828 \u46020 \u44368 \u47484  \u48155 \u50500 \u46308 \u51060 \u44592  \u49789 \u46020 \u47197  \u47564 \u46304  \u45936  \u44536  \u50896 \u51064 \u51060  \u51080 \u45796 . \u49324 \u46020  \u48148 \u50872 \u51008  \u48268 \u50024  \u44536 \u51032  \u49884 \u45824 \u50640  \'93\u48520 \u48277 \u51032  \u48708 \u48128 \u51060  \u51060 \u48120  \u54876 \u46041 \u54616 \u50688 \'94 (\u49332 \u54980  2:7) \u45796 \u44256  \u47568 \u54616 \u50688 \u45796 . \u47932 \u47200  \u49324 \u46020 \u46308 \u51060  \u49373 \u51316 \u54616 \u50668  \u51080 \u45912  \u45817 \u49884 \u51032  \u44368 \u54924 \u45716  \u48708 \u44368 \u51201  \u49692 \u44208 \u51012  \u48372 \u51316 \u54616 \u44256  \u51080 \u50632 \u45796 . \u44536 \u47084 \u45208  \'93\u51228 2\u49464 \u44592 \u51032  \u47568 \u50685 \u50640  \u51060 \u47476 \u47084  \u45824 \u45796 \u49688 \u51032  \u44368 \u54924 \u46308 \u51008  \u49352 \u47196 \u50868  \u54805 \u49885 \u51012  \u48155 \u50500 \u46308 \u51076 \u51004 \u47196  \u52488 \u52285 \u44592 \u51032  \u49692 \u49688 \u49457 \u51012  \u51075 \u50612 \u48260 \u47532 \u44172  \u46104 \u50632 \u45796 . \u44536 \u47532 \u44256  \u49324 \u46020 \u46308 \u51060  \u47924 \u45924 \u50640  \u46308 \u50612 \u44032  \u49772 \u44172  \u46104 \u51088  \u44536  \u54980 \u49552 \u46308 \u51060  \u49352 \u47196  \u54924 \u44060 \u54616 \u45716  \u49324 \u46988 \u46308 \u47196  \u45908 \u48520 \u50612  \u44368 \u54924 \u51032  \u44040  \u44600 \u51012  \u49352 \u47196 \u50868  \u54805 \u53468 \u47196  \u48148 \u44984 \u50612  \u48260 \u47532 \u44172  \u46104 \u50632 \u45796 \'94 (Robert Robinson, Ecclesiastical Researches, ch.6, par.17, p.51). \u49352  \u49888 \u51088 \u46308 \u51012  \u50948 \u54616 \u50668  \u44536 \u47532 \u49828 \u46020 \u51064  \u49888 \u50521 \u51032  \u45458 \u51008  \u54364 \u51456 \u51012  \u45230 \u52628 \u50612 \u48260 \u47536  \u44208 \u44284 \u47196  \'93\u51060 \u44368 \u44032  \u54861 \u49688 \u52376 \u47100  \u44368 \u54924  \u50504 \u51004 \u47196  \u48128 \u47140 \u46308 \u50612 \u50752  \u44536  \u54413 \u49549 , \u49845 \u44288 , \u50864 \u49345  \u46321 \u51060  \u48152 \u51077 \u46104 \u50632 \u45796 \'94 (Gavazzi, Lectures, p.278). \u44536 \u47532 \u49828 \u46020  \u44368 \u54924 \u44032  \u49464 \u49549 \u51201  \u50948 \u51221 \u51088 \u46308 \u51032  \u54840 \u51032 \u50752  \u51648 \u51648 \u47484  \u54925 \u46301 \u54632 \u51004 \u47196  \u54364 \u47732 \u49345 \u51004 \u47196 \u45716  \u47566 \u51008  \u49324 \u46988 \u46308 \u51032  \u51064 \u51221 \u51012  \u48155 \u44172  \u46104 \u50632 \u45796 . \u44536 \u47084 \u45208  \u50808 \u44204 \u49345 \u51004 \u47196  \u44536 \u47532 \u49828 \u46020 \u51064 \u52376 \u47100  \u48372 \u50688 \u51012 \u51648 \u46972 \u46020 , \u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \'93\u49324 \u49892 \u49345  \u51060 \u44368 \u46020 \u47196 \u49436  \u51008 \u48128 \u55176  \u44536 \u46308 \u51032  \u50864 \u49345 \u51012  \u49709 \u48176 \u54616 \u45716  \u52376 \u51648 \u50640  \u47672 \u47932 \u47084  \u51080 \u50632 \u45796 \'94 (Gavazzi, Lectures, p.278).\
