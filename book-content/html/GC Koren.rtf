\uc0\u49324 \u46988 \u51060  \u50612 \u46523 \u44172  \u48127 \u46304 \u51648  \u44536 \u44163 \u51060  \u48324 \u48152  \u51473 \u50836 \u54620  \u47928 \u51228 \u44032  \u50500 \u45768 \u46972 \u45716  \u53468 \u46020 \u45716  \u49324 \u45800 \u51032  \u44032 \u51109  \u49457 \u44277 \u51201 \u51064  \u44592 \u47564  \u51473  \u54616 \u45208 \u51060 \u45796 . \u49324 \u45800 \u51008 , \u49324 \u46993  \u44032 \u50868 \u45936 \u49436  \u48155 \u50500 \u46308 \u50668 \u51652 \u48148  \u46104 \u47732  \u51652 \u47532 \u44032  \u44536 \u44163 \u51012  \u48155 \u50500 \u46308 \u51064  \u51088 \u51032  \u49900 \u47161 \u51012  \u49457 \u44208 \u54616 \u44172  \u54616 \u50668  \u51456 \u45796 \u45716  \u44163 \u51012  \u50504 \u45796 . \u44536 \u47084 \u48064 \u47196  \u44536 \u45716  \u44144 \u51667  \u44368 \u47532 , \u51648 \u50612 \u45240  \u47568 , \u45796 \u47480  \u48373 \u51020  \u46321 \u51004 \u47196  \u45824 \u52824 \u54616 \u47140 \u44256  \u45130 \u51076 \u50630 \u51060  \u45432 \u47141 \u54620 \u45796 . \u52376 \u51020 \u48512 \u53552  \u54616 \u45208 \u45784 \u51032  \u51333 \u46308 \u51008  \u44144 \u51667  \u44368 \u49324 \u46308 \u44284  \u49912 \u50892 \u50772 \u45796 . \u44536 \u46308 \u51008  \u44536  \u49324 \u46988 \u46308 \u51012  \u45800 \u49692 \u55176  \u48512 \u46020 \u45909 \u54620 \u51088 \u46308 \u47196 \u49436 \u49104 \u47564  \u50500 \u45768 \u46972  \u50689 \u54844 \u50640 \u44172  \u52824 \u47749 \u51201 \u51064  \u44144 \u51667 \u51012  \u44032 \u47476 \u52824 \u45716  \u51088 \u47196 \u49436  \u49912 \u50892 \u50772 \u45796 . \u50648 \u47532 \u50556 \u50752  \u50696 \u47112 \u48120 \u50556 \u50752  \u48148 \u50872 \u51008  \u54869 \u44256 \u54616 \u44256  \u46160 \u47140 \u50880  \u50630 \u51060  \u49324 \u46988 \u46308 \u51012  \u54616 \u45208 \u45784 \u51032  \u47568 \u50432 \u50640 \u49436  \u46496 \u45208 \u44172  \u54616 \u45716  \u51088 \u46308 \u51012  \u44508 \u53444 \u54616 \u50688 \u45796 . \u51060  \u44144 \u47337 \u54620  \u51652 \u47532 \u51032  \u50745 \u54840 \u51088 \u46308 \u51008  \u48127 \u45716  \u49888 \u51312 \u44032  \u48148 \u47476 \u51648  \u50506 \u50500 \u46020  \u49345 \u44288 \u50630 \u45796 \u45716  \u49324 \u49345 \u51012  \u48155 \u50500 \u46308 \u51060 \u51648  \u50500 \u45768 \u54616 \u50688 \u45796 .\
\uc0\u51068 \u48152  \u44536 \u47532 \u49828 \u46020 \u44368 \u44228 \u50640 \u49436  \u48156 \u44204 \u54624  \u49688  \u51080 \u45716  \u48148 \u50752  \u44057 \u51060  \u49457 \u44221  \u47568 \u50432 \u50640  \u45824 \u54620  \u50528 \u47588 \u54616 \u44256  \u51060 \u49345 \u54620  \u54644 \u49437 \u44284  \u51333 \u44368 \u51201  \u49888 \u50521 \u50640  \u44288 \u54620  \u50668 \u47084  \u44032 \u51648  \u47784 \u49692 \u46108  \u51060 \u47200 \u51008 , \u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u51012  \u54844 \u46976 \u52992  \u54616 \u47728  \u51652 \u47532 \u47484  \u44648 \u45803 \u51648  \u47803 \u54616 \u44172  \u54616 \u44592  \u50948 \u54616 \u50668  \u50864 \u47532 \u51032  \u53360  \u50896 \u49688 \u44032  \u54616 \u45716  \u49548 \u54665 \u51060 \u45796 . \u44536 \u47532 \u49828 \u46020 \u44368 \u44228 \u51032  \u50668 \u47084  \u44368 \u54924 \u50640  \u51316 \u51116 \u54616 \u45716  \u48520 \u54868 \u50752  \u48516 \u50676 \u51008  \u51452 \u47196  \u51339 \u50500 \u54616 \u45716  \u51060 \u47200 \u51012  \u51648 \u51648 \u54616 \u44592  \u50948 \u54616 \u50668  \u49457 \u44221 \u51012  \u44257 \u54644 \u54616 \u45716  \u51068 \u48152 \u51201  \u49845 \u44288 \u50640  \u44592 \u51064 \u46104 \u50612  \u51080 \u45796 . \u47566 \u51008  \u49324 \u46988 \u46308 \u51008  \u54616 \u45208 \u45784 \u51032  \u46907 \u51012  \u50508 \u44592  \u50948 \u54616 \u50668  \u44216 \u49552 \u54620  \u47560 \u51020 \u51004 \u47196  \u49457 \u44221 \u51012  \u51452 \u51032  \u44618 \u51060  \u50672 \u44396 \u54616 \u51648  \u50500 \u45768 \u54616 \u44256  \u45796 \u47564  \u49352 \u47213 \u44256  \u44592 \u51060 \u54620  \u44163 \u51012  \u48156 \u44204 \u54616 \u44592  \u50948 \u54616 \u50668  \u50672 \u44396 \u54620 \u45796 .\
