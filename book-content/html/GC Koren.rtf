\uc0\u54620  \u44152 \u51020  \u54620  \u44152 \u51020  \u44060 \u54785  \u49324 \u50629 \u51008  \u52712 \u47532 \u55176 \u50640 \u49436  \u48156 \u51204 \u46104 \u50632 \u45796 . \u50896 \u49688 \u46308 \u51008  \u45440 \u46972 \u49436  \u51201 \u44537 \u51201 \u51004 \u47196  \u48152 \u45824 \u54616 \u50688 \u45796 . \u51068  \u45380  \u51204 \u50640  \u48708 \u53584 \u48288 \u47476 \u53356 \u51032  \u54620  \u49849 \u47140 \u45716  \u48372 \u47492 \u49828 \u50640 \u49436  \u54889 \u51228 \u50752  \u48277 \u50773 \u50640 \u44172  \'93\u50500 \u45768 \u46972 \'94\u45716  \u47568 \u51012  \u54616 \u50688 \u45716 \u45936 , \u51060 \u51228  \u52712 \u47532 \u55176 \u50640 \u49436 \u46020  \u47784 \u46304  \u51068 \u50640  \u51080 \u50612 \u49436  \u48277 \u50773 \u51032  \u51452 \u51109 \u50640  \u48152 \u45824 \u54616 \u45716  \u46319 \u54620  \u44221 \u54693 \u51060  \u49373 \u44592 \u44172  \u46104 \u50632 \u45796 . \u52768 \u48729 \u44544 \u47532 \u47484  \u54693 \u54616 \u50668  \u44277 \u44201 \u51060  \u44144 \u46317 \u46104 \u50632 \u45796 . \u48277 \u50773 \u51032  \u49464 \u47141 \u51060  \u51648 \u48176 \u54616 \u44256  \u51080 \u45716  \u51648 \u48169 \u50640 \u49436 \u45716  \u46412 \u46412 \u47196  \u48373 \u51020 \u51032  \u49324 \u46020 \u44032  \u54868 \u54805 \u50640  \u52376 \u54644 \u51276 \u45796 . \u44536 \u47084 \u45208  \u44536 \u44163 \u51004 \u47196  \u47564 \u51313 \u54616 \u51648  \u50506 \u44256 , \u44536 \u46308 \u51008  \u51060 \u45800 \u51032  \u44368 \u49324 \u47484  \u52840 \u47925 \u49884 \u53020 \u50556 \u47564  \u54664 \u45796 . \u47560 \u52840  \u44536  \u46412 \u50640  \u53080 \u49828 \u53444 \u49828 \u51032  \u44048 \u46021 \u51008  \u49464  \u49324 \u46988 \u51032  \u49324 \u51208 \u51012  \u52712 \u47532 \u55176 \u51032  \u51032 \u54924 \u50640  \u54028 \u44204 \u49884 \u53020  \u52768 \u48729 \u44544 \u47532 \u44032  \u44368 \u54924 \u51032  \u48277 \u44508 \u47484  \u48276 \u54616 \u46020 \u47197  \u49324 \u46988 \u46308 \u51012  \u44032 \u47476 \u52840 \u51004 \u47196  \u49324 \u54924 \u51032  \u50504 \u45397 \u44284  \u51656 \u49436 \u47484  \u50948 \u53468 \u47213 \u44172  \u54616 \u44256  \u51080 \u45796 \u44256  \u44256 \u49548 \u54616 \u50688 \u45796 . \u44536 \u45716  \u47564 \u51068  \u44368 \u54924 \u51032  \u44428 \u50948 \u44032  \u47924 \u49884 \u46104 \u47732 , \u47924 \u51221 \u48512  \u49345 \u53468 \u44032  \u52488 \u47000 \u46112  \u44163 \u51060 \u46972 \u44256  \u50669 \u49444 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u52768 \u48729 \u44544 \u47532 \u45716  \u44536 \u44032  \u44284 \u44144  4\u45380 \u44036  \u52712 \u47532 \u55176 \u50640 \u49436  \u48373 \u51020 \u51012  \u51204 \u54028 \u54616 \u50688 \u45716 \u45936 , \'93\u52712 \u47532 \u55176 \u45716  \u44536  \u50672 \u54633 \u44397  \u50504 \u51032  \u50612 \u46500  \u45796 \u47480  \u46020 \u49884 \u48372 \u45796  \u51312 \u50857 \u54616 \u44256  \u54217 \u50504 \u54616 \u45796 \'94\u44256  \u45824 \u45813 \u54616 \u50688 \u45796 . \u44536 \u47532 \u44256  \u44536 \u45716  \u44228 \u49549 \u54616 \u50668  \'93\u44536 \u47084 \u48064 \u47196  \u44536 \u47532 \u49828 \u46020 \u44368 \u45716  \u51068 \u48152  \u49324 \u54924 \u51032  \u50504 \u45397 \u44284  \u51656 \u49436 \u47484  \u44032 \u51109  \u51096  \u48372 \u51316 \u54644  \u51452 \u51648  \u50506 \u45712 \u45264 \'94 (Wylie, b.8, ch.11) \u44256  \u47568 \u54616 \u50688 \u45796 .\
\uc0\u49324 \u51208 \u46308 \u51008  \u52712 \u47532 \u55176 \u51032  \u51032 \u50896 \u46308 \u50640 \u44172  \u44368 \u54924 \u50640  \u47672 \u47932 \u47084  \u51080 \u46020 \u47197  \u44428 \u44256 \u54616 \u44256 , \u44368 \u54924 \u47484  \u46496 \u45208 \u49436 \u45716  \u44396 \u50896 \u51060  \u50630 \u45796 \u44256  \u51452 \u51109 \u54616 \u50688 \u45796 . \u44536 \u47084 \u51088  \u52768 \u48729 \u44544 \u47532 \u45716  \u45796 \u51020 \u44284  \u44057 \u51060  \u45824 \u45813 \u54616 \u50688 \u45796 . \'93\u44536 \u45824 \u46308 \u51008  \u51060 \u47084 \u54620  \u44256 \u49548 \u50640  \u55124 \u46308 \u47140 \u49436 \u45716  \u50504  \u46108 \u45796 . \u44368 \u54924 \u51032  \u44592 \u52488 \u45716  \u44536 \u47532 \u49828 \u46020 \u47484  \u52649 \u49892 \u55176  \u51613 \u44144 \u54620  \u48288 \u46300 \u47196 \u50640 \u44172  \u51060 \u47492 \u51012  \u51452 \u49888  \u48148 \u47196  \u44536  \u48152 \u49437 \u46104 \u49888  \u44536 \u47532 \u49828 \u46020 \u51060 \u49884 \u45796 . \u50612 \u46496 \u54620  \u45208 \u46972 \u50640 \u49436 \u46304 \u51648  \u52280  \u47560 \u51020 \u51004 \u47196  \u51452  \u50696 \u49688 \u45784 \u51012  \u48127 \u45716  \u49324 \u46988 \u51008  \u54616 \u45208 \u45784 \u44760 \u49436  \u44032 \u45225 \u54644  \u51452 \u49888 \u45796 . \u51652 \u49892 \u47196  \u50668 \u44592 \u50640  \u44368 \u54924 \u44032  \u51080 \u51004 \u45768 , \u51060  \u44368 \u54924 \u47484  \u53685 \u54616 \u51648  \u50506 \u44256 \u49436 \u45716  \u50500 \u47924 \u46020  \u44396 \u50896 \u51012  \u50619 \u51648  \u47803 \u54616 \u45716  \u44163 \u51060 \u45796 \'94 (D\'92Aubigne, London ed., b.8, ch.11). \u44536  \u54924 \u51032 \u51032  \u44208 \u44284 \u47196  \u44048 \u46021 \u51032  \u49324 \u51208 \u46308  \u51473 \u51032  \u54620  \u49324 \u46988 \u51060  \u44060 \u54785 \u54028 \u51032  \u49888 \u50521 \u51012  \u48155 \u50500 \u46308 \u51060 \u44172  \u46104 \u50632 \u45796 .\
\uc0\u44536  \u54924 \u51032 \u45716  \u52768 \u48729 \u44544 \u47532 \u50640  \u45824 \u54620  \u51312 \u52376 \u47484  \u52712 \u54616 \u44592 \u47484  \u44144 \u51208 \u54616 \u50688 \u51004 \u48064 \u47196  \u47196 \u47560 \u45716  \u49352 \u47196 \u50868  \u44277 \u44201 \u51012  \u54616 \u44256 \u51088  \u51456 \u48708 \u54616 \u50688 \u45796 . \u44536  \u44060 \u54785 \u51088 \u45716  \u50896 \u49688 \u46308 \u51032  \u51020 \u47784 \u47484  \u44648 \u45803 \u44256  \u48512 \u47476 \u51670 \u50632 \u45796 . \'93\u52432 \u46308 \u50612 \u50724 \u47140 \u47732  \u50724 \u45320 \u46972 . \u47560 \u52824  \u54028 \u46020 \u44032  \u45130 \u51076 \u50630 \u51060  \u51208 \u48317  \u50500 \u47000 \u47196  \u48128 \u47140 \u50732 \u51648 \u46972 \u46020  \u44536  \u51208 \u48317 \u51008  \u50864 \u46749  \u49567 \u50500 \u51080 \u45716  \u44163 \u52376 \u47100  \u45208 \u45716  \u44536 \u46308 \u47196  \u51064 \u54616 \u50668  \u50836 \u46041 \u54616 \u51648  \u50500 \u45768 \u54624  \u44163 \u51060 \u45796 \'94 (Wylie, b.8, ch.11). \u44536 \u47532 \u54616 \u50668  \u44368 \u54924 \u51032  \u51648 \u46020 \u51088 \u46308 \u51032  \u45432 \u47141 \u51008  \u50724 \u55176 \u47140  \u44536 \u46308 \u51060  \u48149 \u47736 \u54616 \u44256 \u51088  \u54616 \u45716  \u48373 \u51020  \u49324 \u50629 \u51012  \u46020 \u47532 \u50612  \u48156 \u51204 \u49884 \u53412 \u45716  \u44208 \u44284 \u47484  \u45236 \u50632 \u45796 . \u51652 \u47532 \u45716  \u44228 \u49549 \u51201 \u51004 \u47196  \u54869 \u51109 \u46104 \u50632 \u45796 . \u46021 \u51068 \u50640 \u49436  \u44060 \u54785  \u49324 \u50629 \u51012  \u51648 \u51648 \u54616 \u45716  \u49324 \u46988 \u46308 \u51060  \u47336 \u53552 \u51032  \u54665 \u48169 \u48520 \u47749 \u51004 \u47196  \u54620  \u46412  \u45209 \u45812 \u54616 \u50688 \u51004 \u45208 , \u49828 \u50948 \u49828 \u50640 \u49436  \u48373 \u51020  \u49324 \u50629 \u51060  \u48156 \u51204 \u46104 \u45716  \u44163 \u51012  \u48372 \u44256  \u44536 \u46308 \u51008  \u45796 \u49884  \u44592 \u50868 \u51012  \u54924 \u48373 \u54616 \u44172  \u46104 \u50632 \u45796 .\
\uc0\u52712 \u47532 \u55176 \u50640 \u49436  \u44060 \u54785  \u49324 \u50629 \u51060  \u54869 \u47549 \u46120 \u50640  \u46384 \u46972 \u49436  \u48276 \u51396  \u54665 \u50948 \u45716  \u51088 \u52712 \u47484  \u44048 \u52628 \u44172  \u46104 \u44256  \u51656 \u49436 \u50752  \u51312 \u54868 \u44032  \u52489 \u51652 \u46104 \u48064 \u47196  \u44060 \u54785  \u49324 \u50629 \u51032  \u44208 \u44284 \u44032  \u45208 \u53440 \u45208 \u44172  \u46104 \u50632 \u45796 . \u52768 \u48729 \u44544 \u47532 \u45716  \u44536  \u49324 \u49892 \u51012  \u45796 \u51020 \u44284  \u44057 \u51060  \u44592 \u47197 \u54616 \u50688 \u45796 . \'93\u49892 \u47196  \u50864 \u47532  \u46020 \u49884 \u45716  \u54217 \u50504 \u54616 \u45796 . \u45796 \u53820 \u46020  \u50630 \u44256 , \u50948 \u49440 \u46020  \u50630 \u44256 , \u49884 \u44592 \u46020  \u50630 \u44256 , \u53804 \u51137 \u46020  \u50630 \u45796 . \u47924 \u50631 \u51060  \u51060 \u50752  \u44057 \u51008  \u50672 \u54633 \u51012  \u44032 \u51256 \u50732  \u49688  \u51080 \u45716 \u44032 ? \u44536 \u44163 \u51008  \u50864 \u47532 \u51032  \u47560 \u51020 \u51012  \u54868 \u54217 \u44284  \u44221 \u44148 \u51004 \u47196  \u44032 \u46301  \u52292 \u50892  \u51452 \u45716  \u50864 \u47532  \u51452 \u45784 \u44284  \u50864 \u47532 \u51032  \u44368 \u54924 \u47564 \u51060  \u44032 \u51256 \u45796  \u51460  \u49688  \u51080 \u45716  \u44163 \u51060 \u45796 \'94 (Wylie, b.8, ch.15).\
\uc0\u44060 \u54785  \u49324 \u50629 \u51060  \u51216 \u51216  \u49849 \u47532 \u47484  \u50619 \u50612  \u44048 \u50640  \u46384 \u46972  \u48277 \u50773 \u45817 \u51008  \u51060 \u47484  \u48149 \u47736 \u54616 \u47140 \u44256  \u45908 \u50865  \u44208 \u49900 \u51012  \u44403 \u44172  \u54616 \u50688 \u45796 . \u48149 \u54644 \u44032  \u46021 \u51068 \u50640 \u49436  \u51652 \u54665 \u46104 \u45716  \u47336 \u53552 \u51032  \u50868 \u46041 \u51012  \u51652 \u50517 \u54616 \u45716  \u45936  \u48324 \u48152  \u54952 \u44284 \u44032  \u50630 \u45716  \u44163 \u51012  \u48372 \u50520 \u51004 \u48064 \u47196  \u44536 \u46308 \u51008  \u44060 \u54785 \u54028 \u51032  \u47924 \u44592 \u47484  \u44032 \u51648 \u44256  \u44060 \u54785 \u54028 \u47484  \u45824 \u54637 \u54616 \u44256 \u51088  \u44208 \u49900 \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u46308 \u51008  \u52768 \u48729 \u44544 \u47532 \u50752  \u53664 \u47200 \u51012  \u54616 \u44592 \u47196  \u51089 \u51221 \u54616 \u44256 , \u44536  \u51068 \u51012  \u51452 \u49440 \u54632 \u50640  \u51080 \u50612 \u49436 \u46020  \u53664 \u47200 \u54624  \u51109 \u49548 \u49104 \u47564  \u50500 \u45768 \u46972  \u53664 \u47200 \u51088 \u46308 \u51012  \u54032 \u51221 \u54624  \u49900 \u54032 \u51088 \u46308 \u44620 \u51648 \u46020  \u51088 \u44592 \u46308  \u49828 \u49828 \u47196  \u49440 \u53469 \u54632 \u51004 \u47196  \u48516 \u47749 \u55176  \u49849 \u47532 \u47484  \u54869 \u51613 \u54616 \u44256 \u51088  \u54664 \u45796 . \u44536 \u46308 \u51008  \u52768 \u48729 \u44544 \u47532 \u44032  \u51068 \u45800  \u44536 \u46308 \u51032  \u49552 \u50640  \u46308 \u50612 \u50724 \u44592 \u47564  \u54616 \u47732  \u44592 \u50612 \u51060  \u45459 \u52824 \u51648  \u50506 \u44192 \u45796 \u44256  \u50668 \u47084  \u44032 \u51648 \u47196  \u51456 \u48708 \u54616 \u44256  \u51080 \u50632 \u45796 . \u44536 \u46308 \u51008  \u51648 \u46020 \u51088 \u47564  \u52840 \u47925 \u49884 \u53412 \u47732 , \u44536  \u50868 \u46041 \u51060  \u44263  \u53444 \u50517 \u46112  \u51460 \u47196  \u49373 \u44033 \u54616 \u50688 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536  \u47785 \u51201 \u51008  \u51312 \u49900 \u49828 \u47101 \u44172  \u44048 \u52628 \u50612 \u51276 \u45796 .\
