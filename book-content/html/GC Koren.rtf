\uc0\u49828 \u50920 \u45940 \u50640 \u49436 \u46020  \u48708 \u53584 \u48288 \u47476 \u53356 \u51032  \u49373 \u47749 \u51032  \u49368 \u47932 \u51012  \u44600 \u50612  \u50728  \u52397 \u45380 \u46308 \u51060  \u44536  \u49368 \u47932 \u51012  \u51088 \u44592  \u45208 \u46972 \u51032  \u44397 \u48124 \u46308 \u50640 \u44172  \u45208 \u45572 \u50612  \u51452 \u50632 \u45796 . \u49828 \u50920 \u45940 \u51032  \u51333 \u44368 \u44060 \u54785  \u50868 \u46041 \u51032  \u46160  \u53360  \u51648 \u46020 \u51088  \u50732 \u46972 \u54532  \u54168 \u53944 \u47532  (Olaf Petri) \u50752  \u46972 \u50864 \u47116 \u54000 \u50864 \u49828  \u54168 \u53944 \u47532  (Laurentius Petri) \u45716  \u50724 \u47112 \u48652 \u47196  (Orebro) \u51032  \u45824 \u51109 \u51109 \u51060 \u51032  \u50500 \u46308 \u46308 \u47196 \u49436  \u47336 \u53552 \u50752  \u47708 \u46976 \u55176 \u53668 \u51032  \u47928 \u54616 \u50640 \u49436  \u48176 \u50864 \u44256 , \u44536  \u48176 \u50868  \u51652 \u47532 \u47484  \u50676 \u49900 \u51004 \u47196  \u45796 \u47480  \u49324 \u46988 \u50640 \u44172  \u44032 \u47476 \u52452 \u45796 . \u50732 \u46972 \u54532 \u46020  \u47336 \u53552 \u52376 \u47100  \u50676 \u49457 \u44284  \u50885 \u48320 \u51004 \u47196  \u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u51012  \u44033 \u49457 \u49884 \u53040 \u44256 , \u46972 \u50864 \u47116 \u54000 \u50864 \u49828 \u45716  \u47708 \u46976 \u55176 \u53668 \u52376 \u47100  \u54617 \u49885 \u51060  \u51080 \u44256 , \u49373 \u44033 \u51060  \u44618 \u44256  \u52840 \u52265 \u54620  \u51064 \u47932 \u51060 \u50632 \u45796 . \u46160  \u49324 \u46988 \u51060  \u45796  \u54616 \u45208 \u45784 \u51012  \u46021 \u49892 \u55176  \u48127 \u51012  \u49104  \u50500 \u45768 \u46972  \u49888 \u54617 \u50640  \u51221 \u53685 \u54616 \u50688 \u44256  \u51652 \u47532 \u47484  \u51204 \u54028 \u54616 \u45716  \u45936  \u51080 \u50612 \u49436  \u54869 \u44256 \u54620  \u50857 \u44592 \u47484  \u44032 \u51648 \u44256  \u51080 \u50632 \u45796 . \u48277 \u50773 \u44368 \u46020 \u46308 \u51032  \u48152 \u45824 \u45716  \u51312 \u44552 \u46020  \u44048 \u49548 \u46104 \u51648  \u50506 \u50520 \u45796 . \u44032 \u53672 \u47533 \u51032  \u49888 \u48512 \u46308 \u51008  \u47924 \u51648 \u54616 \u44256  \u48120 \u49888 \u51201 \u51064  \u49324 \u46988 \u46308 \u51012  \u49440 \u46041 \u54616 \u50688 \u45796 . \u50732 \u46972 \u54532  \u54168 \u53944 \u47532 \u45716  \u51088 \u51452  \u54253 \u46020 \u46308 \u50640 \u44172  \u54588 \u49845 \u46104 \u50612  \u44036 \u49888 \u55176  \u49373 \u47749 \u51012  \u44148 \u51652  \u51201 \u51060  \u50668 \u47084  \u48264  \u51080 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44536  \u44060 \u54785 \u51088 \u46308 \u51008  \u50773 \u51032  \u49324 \u46993 \u44284  \u48372 \u54840 \u47484  \u48155 \u50520 \u45796 .\
\uc0\u45817 \u49884 \u50640  \u49324 \u46988 \u46308 \u51008  \u47196 \u47560 \u44368 \u51032  \u53685 \u52824  \u54616 \u50640  \u48712 \u44260 \u51032  \u44618 \u51008  \u44396 \u47105 \u53573 \u51060 \u50640  \u48736 \u51256  \u51080 \u50632 \u44256 , \u50517 \u48149 \u51004 \u47196  \u45580 \u47532 \u50612  \u51648 \u45256 \u45796 . \u44536 \u46308 \u51008  \u49457 \u44221 \u51012  \u44032 \u51648 \u51648  \u47803 \u54616 \u50688 \u45796 . \u44536 \u46308 \u51008  \u47560 \u51020 \u50640  \u50500 \u47924 \u47088  \u48731 \u51012  \u51452 \u51648  \u47803 \u54616 \u45716  \u49345 \u51669 \u44284  \u51032 \u49885 \u47564 \u51004 \u47196  \u46108  \u51333 \u44368 \u47484  \u48127 \u51020 \u51004 \u47196  \u51060 \u44368 \u46020 \u50688 \u45912  \u44536 \u46308 \u51032  \u49440 \u51312 \u46308 \u51060  \u48127 \u45912  \u48120 \u49888 \u51201  \u49888 \u51312 \u50752  \u51060 \u44368 \u51201  \u49373 \u54876 \u47196  \u52264 \u52784  \u46028 \u50500 \u44032 \u44256  \u51080 \u50632 \u45796 . \u44397 \u48124 \u46308 \u51008  \u49436 \u47196  \u48516 \u51137 \u54616 \u45716  \u45817 \u54028 \u47484  \u51648 \u50612  \u45208 \u45572 \u50612 \u51276 \u44256 , \u53804 \u51137 \u51004 \u47196  \u47784 \u46304  \u44397 \u48124 \u51008  \u45908 \u50865  \u48520 \u54665 \u54616 \u44172  \u46104 \u50632 \u45796 . \u44536 \u47084 \u48064 \u47196  \u50773 \u51008  \u44397 \u44032 \u50752  \u44368 \u54924 \u50640 \u49436  \u44060 \u54785 \u51012  \u54616 \u47140 \u44256  \u44208 \u49900 \u54616 \u50688 \u45796 . \u44536 \u45716  \u47196 \u47560 \u44368 \u50752  \u49912 \u50864 \u44592  \u50948 \u54616 \u50668  \u44536  \u55192  \u51080 \u45716  \u51312 \u47141 \u51088 \u46308 \u51012  \u54872 \u50689 \u54616 \u50688 \u45796 .\
\uc0\u49828 \u50920 \u45940 \u51032  \u44400 \u51452  (\u21531 \u20027 ) \u50752  \u51648 \u46020 \u51088 \u46308  \u50526 \u50640 \u49436  \u50732 \u46972 \u54532  \u54168 \u53944 \u47532 \u45716  \u47196 \u47560 \u44368 \u51032  \u51648 \u51648 \u51088 \u46308 \u51012  \u45824 \u54637 \u54616 \u50668  \u44060 \u54785 \u51452 \u51032 \u51032  \u44368 \u47532 \u47484  \u53360  \u45733 \u47141 \u51004 \u47196  \u50745 \u54840 \u54616 \u50688 \u45796 . \u44536 \u45716  \u47196 \u47560 \u44368 \u51032  \u44368 \u48512 \u46308 \u51032  \u44368 \u54984 \u51060  \u49457 \u44221 \u44284  \u51068 \u52824 \u54624  \u46412 \u50640 \u47564  \u48155 \u50500 \u46308 \u50668 \u50556  \u54620 \u45796 \u44256  \u51452 \u51109 \u54616 \u44256 , \u49888 \u50521 \u49345 \u51032  \u51473 \u50836 \u54620  \u44368 \u47532 \u44032  \u49457 \u44221 \u50640  \u48516 \u47749 \u54616 \u44256  \u45800 \u49692 \u54616 \u44172  \u44228 \u49884 \u46104 \u50612  \u51080 \u51004 \u48064 \u47196  \u45572 \u44396 \u46304 \u51648  \u44536  \u44368 \u47532 \u46308 \u51012  \u51060 \u54644 \u54624  \u49688  \u51080 \u45796 \u44256  \u50669 \u49444 \u54616 \u50688 \u45796 . \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \'93\u45236  \u44368 \u54984 \u51008  \u45236  \u44163 \u51060  \u50500 \u45768 \u50836  \u45208 \u47484  \u48372 \u45236 \u49888  \u51060 \u51032  \u44163 \u51060 \u45768 \u46972 \'94 (\u50836  7:16) \u44256  \u54616 \u49512 \u45796 . \u48148 \u50872 \u46020  \'93\u50864 \u47532 \u44032  \u45320 \u55148 \u50640 \u44172  \u51204 \u54620  \u48373 \u51020  \u50808 \u50640  \u45796 \u47480  \u48373 \u51020 \u51012  \u51204 \u54616 \u47732  \u51200 \u51452 \u47484  \u48155 \u51012 \u51648 \u50612 \u45796 \'94 (\u44040  1:8) \u46972 \u44256  \u54616 \u50688 \u45796 . \'93\u44536 \u47084 \u48064 \u47196  \u45572 \u44032  \u44048 \u55176  \u52280 \u46988 \u46104 \u51060  \u51076 \u51032 \u47196  \u44368 \u47532 \u46308 \u51012  \u51228 \u51221 \u54616 \u50668  \u44536 \u44163 \u46308 \