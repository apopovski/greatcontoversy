\f0\b \cf0 \uc0\u44060 \u54785 \u51088 \u46308 \u51060  \u45817 \u54620  \u54872 \u45212 \
\pard\pardeftab720\partightenfactor0

\f1\b0 \cf0 \
\uc0\u45348 \u45916 \u46976 \u46300 \u52376 \u47100  \u44060 \u49888 \u44368 \u51032  \u44368 \u47532 \u47484  \u51068 \u48152 \u51201 \u51004 \u47196  \u48155 \u50500 \u46308 \u51064  \u44275 \u51008  \u50500 \u47924 \u45936 \u46020  \u50630 \u50632 \u45796 . \u46608  \u51060 \u44275 \u52376 \u47100  \u44060 \u49888 \u44368 \u47484  \u49888 \u48393 \u54616 \u45716  \u49324 \u46988 \u46308 \u51060  \u47924 \u49436 \u50868  \u48149 \u54644 \u47484  \u45817 \u54620  \u45208 \u46972 \u46020  \u46300 \u47932 \u45796 . \u46021 \u51068 \u50640 \u49436 \u45716  \u52852 \u50508  5\u49464 \u44032  \u44060 \u54785 \u51452 \u51032 \u47484  \u44552 \u51648 \u54616 \u44256  \u44536 \u44163 \u51012  \u48127 \u45716  \u49324 \u46988 \u46308 \u51012  \u52376 \u54805 \u49884 \u53412 \u44256 \u51088  \u54616 \u50688 \u51004 \u45208  \u51228 \u54980 \u46308 \u51060  \u44536 \u51032  \u54617 \u51221 \u51012  \u47561 \u50520 \u45796 . \u45348 \u45916 \u46976 \u46300 \u50640 \u49436 \u45716  \u44536 \u51032  \u44428 \u47141 \u51060  \u45908 \u50865  \u52984 \u51004 \u47728 , \u48149 \u54644 \u51032  \u47749 \u47161 \u51060  \u49888 \u49549 \u55176  \u46244 \u47484  \u51060 \u50612  \u48156 \u54644 \u51276 \u45796 . \u49457 \u44221 \u51012  \u51069 \u45716  \u44163 , \u44536  \u47568 \u50432 \u51012  \u46307 \u44144 \u45208  \u51204 \u54616 \u45716  \u44163 , \u49900 \u51648 \u50612  \u44536 \u44163 \u50640  \u45824 \u54616 \u50668  \u47568 \u51012  \u54616 \u45716  \u44163 \u44620 \u51648 \u46020  \u54868 \u54805 \u50640  \u52376 \u54624  \u47564 \u54620  \u51396 \u46972 \u44256  \u54616 \u50688 \u45796 . \u51008 \u48128 \u55176  \u54616 \u45208 \u45784 \u44760  \u44592 \u46020 \u54616 \u45716  \u44163 , \u50864 \u49345 \u50640 \u44172  \u51208 \u51012  \u54616 \u51648  \u50506 \u45716  \u44163 , \u46608 \u45716  \u49884 \u54200 \u51012  \u45432 \u47000 \u54616 \u45716  \u44163 \u46020  \u49324 \u54805 \u50640  \u54644 \u45817 \u46108 \u45796 \u44256  \u54616 \u50688 \u45796 . \u51088 \u44592 \u51032  \u51096 \u47803 \u51012  \u48260 \u47532 \u44592 \u47196  \u47609 \u49464 \u54620  \u51088 \u46308 \u46020  \u51221 \u51396 \u51032  \u49440 \u44256 \u47484  \u48155 \u50520 \u45796 . \u44536 \u47532 \u54616 \u50668  \u45224 \u51088 \u46308 \u51064  \u44221 \u50864 \u45716  \u44160 \u51004 \u47196  \u51453 \u51060 \u44256 , \u50668 \u51088 \u46308 \u51064  \u44221 \u50864 \u45716  \u49328  \u52292 \u47196  \u47588 \u51109 \u54616 \u50668  \u51453 \u50688 \u45796 . \u52852 \u50508 \u44284  \u54596 \u47549  2\u49464 \u51032  \u52824 \u54616 \u50640 \u49436  \u44536 \u50752  \u44057 \u51008  \u48169 \u48277 \u51004 \u47196  \u51453 \u51076 \u51012  \u45817 \u54620  \u49324 \u46988 \u46308 \u51008  \u51060 \u47336  \u54756 \u50500 \u47540  \u49688  \u50630 \u51060  \u47566 \u50520 \u45796 .\
\uc0\u54620  \u48264 \u51008  \u48120 \u49324  \u46412 \u50640  \u45208 \u50724 \u51648  \u50500 \u45768 \u54616 \u44256  \u44032 \u51221 \u50640 \u49436  \u50696 \u48176 \u54616 \u50688 \u45796 \u45716  \u51396 \u47196  \u54620  \u44032 \u51313 \u51060  \u51333 \u44368  \u51116 \u54032 \u44288 \u46308  \u50526 \u50640  \u45132 \u47140 \u45208 \u50728  \u51068 \u51060  \u51080 \u50632 \u45796 . \u51008 \u48128 \u55176  \u44592 \u46020 \u54620  \u44163 \u50640  \u45824 \u54616 \u50668  \u49900 \u47928 \u51012  \u48155 \u51012  \u46412  \u51228 \u51068  \u50612 \u47536  \u50500 \u46308 \u51060  \u45824 \u45813 \u54616 \u50688 \u45796 . \'93\u50864 \u47532 \u45716  \u47924 \u47502 \u51012  \u44999 \u44256  \u54616 \u45208 \u45784 \u44760 \u49436  \u50864 \u47532 \u51032  \u47560 \u51020 \u51012  \u44648 \u50864 \u52432  \u51452 \u49884 \u44256 , \u50864 \u47532 \u51032  \u51396 \u47484  \u50857 \u49436 \u54616 \u50668  \u51452 \u49884 \u44592 \u47484  \u44592 \u46020 \u54616 \u50688 \u49845 \u45768 \u45796 . \u50864 \u47532 \u45716  \u46608  \u50773 \u51012  \u50948 \u54616 \u50668  \u44592 \u46020 \u54616 \u50688 \u44256 , \u44536 \u51032  \u49884 \u45824 \u44032  \u48264 \u50689 \u54616 \u44256  \u44536 \u51032  \u51068 \u49373 \u51060  \u54665 \u48373 \u54644 \u51648 \u44592 \u47484  \u44396 \u54616 \u50688 \u49845 \u45768 \u45796 . \u50864 \u47532 \u45716  \u54616 \u45208 \u45784 \u44760 \u49436  \u51221 \u48512 \u51032  \u44288 \u47532 \u46308 \u51012  \u48372 \u54840 \u54644  \u51452 \u49884 \u44592 \u47484  \u44592 \u46020 \u54616 \u50688 \u49845 \u45768 \u45796 \'94 (Wylie, b.18, ch.6). \u51116 \u54032 \u44288 \u46308  \u51473 \u51032  \u47751  \u49324 \u46988 \u46308 \u51008  \u44618 \u51008  \u44048 \u46041 \u51012  \u48155 \u50520 \u45796 . \u44536 \u47084 \u45208  \u44536  \u44032 \u51221 \u51032  \u50500 \u48260 \u51648 \u50752  \u50500 \u46308  \u51473 \u51032  \u54620  \u49324 \u46988 \u51008  \u54868 \u54805 \u51012  \u49440 \u44256 \u48155 \u50520 \u45796 .\
\uc0\u48149 \u54644 \u44032  \u51216 \u51216  \u49900 \u54616 \u50668 \u51664 \u50640  \u46384 \u46972  \u49692 \u44368 \u51088 \u46308 \u51032  \u49888 \u50521 \u46020  \u45908 \u50865  \u44053 \u54616 \u50668 \u51276 \u45796 . \u45224 \u51088 \u49104 \u47564  \u50500 \u45768 \u46972  \u50672 \u50557 \u54620  \u48512 \u51064 \u46308 \u44284  \u49548 \u45376 \u46308 \u44620 \u51648 \u46020  \u54869 \u44256 \u54620  \u50857 \u44592 \u47484  \u45208 \u53440 \u45256 \u45796 . \'93\u50500 \u45236 \u46308 \u51008  \u45224 \u54200 \u46308 \u51060  \u45804 \u47140  \u51080 \u45716  \u54868 \u54805 \u51452  \u44225 \u50640  \u49436 \u49436  \u48520 \u50640  \u53440 \u44256  \u51080 \u45716  \u45224 \u54200 \u46308 \u50640 \u44172  \u50948 \u50504 \u51032  \u47568 \u51012  \u46308 \u47140 \u51452 \u44144 \u45208  \u49884 \u54200 \u51012  \u45432 \u47000 \u47196  \u48520 \u47084  \u51452 \u44592 \u46020  \u54616 \u50688 \u45796 .\'94 \'93\u50612 \u47536  \u52376 \u45376 \u46308 \u51008  \u47560 \u52824  \u48164 \u50640  \u51104 \u51088 \u47532 \u50640  \u46308 \u50612 \u44032 \u45716  \u44163 \u52376 \u47100  \u49328  \u52292 \u47196  \u51312 \u50857 \u55176  \u47924 \u45924 \u50640  \u46308 \u50612 \u44032  \u45572 \u50912 \u44256 , \u54841 \u51008  \u44208 \u54844 \u49885 \u50640  \u45208 \u50500 \u44032 \u45716  \u49888 \u48512 \u52376 \u47100  \u51339 \u51008  \u50743 \u51012  \u51077 \u44256  \u44368 \u49688 \u45824 \u45208  \u54868 \u54805 \u51109 \u50640  \u45208 \u50500 \u44032 \u44592 \u46020  \u54616 \u50688 \u45796 \'94 (Wylie, b.18, ch.6).\
\uc0\u45796 \u49888 \u44368 \u44032  \u48373 \u51020 \u51012  \u48149 \u47736 \u54616 \u44256 \u51088  \u45432 \u47141 \u54616 \u50688 \u45912  \u49884 \u45824 \u50752  \u44845  \u47560 \u52268 \u44032 \u51648 \u47196  \u44536 \u47532 \u49828 \u46020 \u51064 \u51032  \u54588 \u45716  \u50472 \u50519 \u51060  \u46104 \u50632 \u45796  (Tertullian, Apology, Paragraph 50 \u52280 \u51312 ). \u48149 \u54644 \u45716  \u51652 \u47532 \u51032  \u51613 \u51064 \u46308 \u51032  \u49688 \u47484  \u51613 \u44032 \u49884 \u53412 \u45716  \u50669 \u54624 \u51012  \u54664 \u45796 . \u48177 \u49457 \u46308 \u51032  \u51221 \u48373 \u54616 \u44592  \u50612 \u47140 \u50868  \u44208 \u49900 \u51012  \u48372 \u44256  \u44305 \u51201  (\u29378 \u30340 ) \u49345 \u53468 \u44032  \u46104 \u50612 \u48260 \u47536  \u50773 \u51008  \u54644 \u44032  \u44144 \u46317 \u46112 \u49688 \u47197  \u51092 \u50501 \u54620  \u51068 \u51012  \u45908 \u50865  \u49900 \u54616 \u44172  \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u44536 \u44163 \u51008  \u50424 \u45936 \u50630 \u45716  \u51068 \u51060 \u50632 \u45796 . \u44536 \u47532 \u54616 \u50668  \u47560 \u52840 \u45236  \u50724 \u47116 \u51648  (Orange) \u44277  \u50956 \u47532 \u50628 \u51032  \u51648 \u46020 \u54616 \u50640  \u54785 \u47749 \u51060  \u51068 \u50612 \u45208 \u49436  \u45348 \u45916 \u46976 \u46300 \u45716  \u54616 \u45208 \u45784 \u51012  \u50696 \u48176 \u54616 \u45716  \u51088 \u50976 \u47484  \u50619 \u50632 \u45796 .\
