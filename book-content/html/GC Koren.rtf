\uc0\u46020 \u54588 \u54644  \u44040  \u46412 , \u44536 \u46308 \u51008  \u51665 \u44284  \u51116 \u49328 \u44284  \u49373 \u54876  \u49688 \u45800  \u46321 \u51012  \u47784 \u46160  \u48260 \u47160 \u45796 . \u44536 \u46308 \u51008  \u50616 \u50612 \u50752  \u44288 \u49845 \u51060  \u51204 \u54784  \u45796 \u47480  \u45231 \u49440  \u45208 \u46972 \u50640 \u49436  \u45208 \u44536 \u45348 \u44032  \u46104 \u50632 \u45796 . \u44536 \u46308 \u51008  \u49373 \u44228 \u47484  \u50948 \u54616 \u50668  \u49352 \u47213 \u44256  \u49373 \u49548 \u54620  \u51649 \u50629 \u50640  \u51333 \u49324 \u54624  \u49688 \u48150 \u50640  \u50630 \u50632 \u45796 . \u51648 \u44552 \u44620 \u51648  \u48173 \u51012  \u44032 \u45716  \u45453 \u48512 \u47196  \u51648 \u45236 \u50772 \u45912  \u51473 \u45380  \u45224 \u51088 \u46308 \u51060  \u51060 \u51228 \u45716  \u44592 \u44228  \u44277 \u50629 \u51012  \u49352 \u47196  \u48176 \u50864 \u51648  \u50506 \u51004 \u47732  \u50504  \u46104 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44536 \u46308 \u51008  \u44536 \u47088  \u51068 \u51012  \u45804 \u44172  \u48155 \u50500 \u46308 \u51060 \u44256  \u48520 \u54217 \u51060 \u45208  \u44172 \u51004 \u47492 \u51004 \u47196  \u49884 \u44036 \u51012  \u54728 \u48708 \u54616 \u51648  \u50506 \u50520 \u45796 . \u44537 \u46020 \u51032  \u48712 \u44417 \u50640  \u48736 \u51652  \u46412 \u46020  \u51333 \u51333  \u51080 \u50632 \u51004 \u45208  \u44536 \u46308 \u51008  \u44536 \u46308 \u50640 \u44172  \u54728 \u46973 \u46108  \u52629 \u48373 \u51012  \u44048 \u49324 \u54616 \u44256  \u45130 \u51076 \u50630 \u45716  \u50689 \u51201  \u44368 \u51228 \u50640 \u49436  \u44592 \u49256 \u51012  \u48156 \u44204 \u54616 \u50688 \u45796 . \'93\u44536 \u46308 \u51008  \u51088 \u44592 \u46308 \u51060  \u49692 \u47168 \u51088 \u46308 \u51076 \u51012  \u50508 \u44256  \u51080 \u50632 \u44592  \u46412 \u47928 \u50640  \u44536 \u47084 \u54620  \u51068 \u46308 \u51012  \u44312 \u45392 \u52824  \u50506 \u44256  \u44536 \u46308 \u51060  \u44032 \u51109  \u49324 \u46993 \u54616 \u44256  \u49324 \u47784 \u54616 \u45716  \u45208 \u46972 \u47196  \u45576 \u51012  \u46028 \u47548 \u51004 \u47196  \u47560 \u51020 \u51012  \u54217 \u50504 \u54616 \u44172  \u44032 \u51276 \u45796 \'94 (Bancroft, pt.1, ch.12, par.15).\
\uc0\u47581 \u47749 \u44284  \u44256 \u45212  \u51473 \u50640 \u49436 \u46020  \u44536 \u46308 \u51032  \u48127 \u51020 \u44284  \u49324 \u46993 \u51008  \u45908 \u50865  \u44053 \u54644 \u51276 \u45796 . \u44536 \u46308 \u51008  \u51452 \u45784 \u51032  \u50616 \u50557 \u51012  \u44403 \u44172  \u48127 \u50632 \u44592  \u46412 \u47928 \u50640  \u54596 \u50836 \u47484  \u46384 \u46972  \u51452 \u45784 \u44760 \u49436 \u45716  \u54637 \u49345  \u44536 \u46308 \u50640 \u44172  \u51025 \u45813 \u54644  \u51452 \u49512 \u45796 . \u51452 \u45784 \u51032  \u52380 \u49324 \u46308 \u51008  \u44536 \u46308 \u51032  \u44225 \u50640 \u49436  \u44536 \u46308 \u51012  \u44201 \u47140 \u54616 \u44256  \u48537 \u46308 \u50612  \u51452 \u50632 \u45796 . \u44536 \u47532 \u44256  \u54616 \u45208 \u45784 \u51032  \u49552 \u51060  \u47680 \u47532  \u48148 \u45796  \u51200 \u54200 \u50640 \u49436  \u44536 \u46308 \u51060  \u44148 \u49444 \u54624  \u45208 \u46972 , \u49888 \u44368 \u51032  \u51088 \u50976 \u46972 \u45716  \u44480 \u51473 \u54620  \u50976 \u50629 \u51012  \u51088 \u49552 \u46308 \u50640 \u44172  \u45224 \u44200  \u51460  \u46405 \u51012  \u44032 \u47532 \u53020  \u51452 \u49884 \u45716  \u44163 \u52376 \u47100  \u49373 \u44033 \u46104 \u50632 \u51012  \u46412 , \u44536 \u46308 \u51008  \u51312 \u44552 \u46020  \u51452 \u51200 \u54616 \u51648  \u50506 \u44256  \u54616 \u45208 \u45784 \u51032  \u49453 \u47532 \u51032  \u44600 \u51012  \u46384 \u46972  \u51204 \u51652 \u54616 \u50688 \u45796 .\
\uc0\u44536 \u46308 \u51060  \u51060 \u50752  \u44057 \u51008  \u49884 \u47144 \u51012  \u45817 \u54616 \u46020 \u47197  \u54728 \u46973 \u46108  \u44163 \u51008  \u54616 \u45208 \u45784 \u44760 \u49436  \u45817 \u49888 \u51032  \u48177 \u49457 \u51004 \u47196  \u54616 \u50668 \u44552  \u45817 \u49888 \u51032  \u51008 \u54812 \u47196 \u50868  \u47785 \u51201 \u51012  \u51060 \u47336 \u46020 \u47197  \u54616 \u49884 \u44256 \u51088  \u44536 \u46308 \u51012  \u51456 \u48708 \u49884 \u53412 \u44592  \u50948 \u54632 \u51060 \u50632 \u45796 . \u44368 \u54924 \u44032  \u44536 \u52376 \u47100  \u45230 \u52628 \u50612 \u51652  \u44163 \u51008  \u54980 \u50640  \u45796 \u49884  \u45458 \u50668 \u51648 \u44592  \u50948 \u54632 \u51060 \u50632 \u45796 . \u54616 \u45208 \u45784 \u44760 \u49436 \u45716  \u45817 \u49888 \u51012  \u49888 \u47280 \u54616 \u45716  \u49324 \u46988 \u46308 \u51012  \u48260 \u47532 \u51648  \u50500 \u45768 \u54616 \u49888 \u45796 \u45716  \u51613 \u44144 \u47484  \u49464 \u49345 \u50640  \u48372 \u50668  \u51452 \u49884 \u44256 \u51088  \u45817 \u49888 \u51032  \u45733 \u47141 \u51012  \u44368 \u54924 \u47484  \u50948 \u54616 \u50668  \u48148 \u50556 \u55120 \u47196  \u45208 \u53440 \u45236 \u49892  \u44163 \u51060 \u50632 \u45796 . \u44536 \u48516 \u44760 \u49436 \u45716  \u49324 \u45800 \u51032  \u48516 \u45432 \u50752  \u50501 \u51064 \u46308 \u51032  \u44036 \u44228 \u47196  \u47568 \u48120 \u50516 \u50500  \u49373 \u44596  \u50668 \u47084  \u44032 \u51648  \u49324 \u44148 \u51012  \u45580 \u47084  \u48260 \u47548 \u51004 \u47196  \u45817 \u49888 \u51032  \u50689 \u44305 \u51012  \u46300 \u47084 \u45236 \u44256 , \u46041 \u49884 \u50640  \u45817 \u49888 \u51032  \u48177 \u49457 \u51012  \u50504 \u51204 \u54620  \u51109 \u49548 \u47196  \u45936 \u47140 \u44032 \u49884 \u44256 \u51088  \u54616 \u49512 \u45796 . \u48149 \u54644 \u50752  \u47581 \u47749 \u51008  \u51088 \u50976 \u50640  \u51060 \u47476 \u45716  \u44600 \u51012  \u50676 \u50612  \u51452 \u44256  \u51080 \u50632 \u45796 .\
\uc0\u52397 \u44368 \u46020 \u46308 \u51060  \u52376 \u51020 \u51004 \u47196  \u50689 \u44397  \u44368 \u54924 \u50640 \u49436  \u46496 \u45216  \u49688 \u48150 \u50640  \u50630 \u50632 \u51012  \u46412 , \u44536 \u46308 \u51008  \u51452 \u45784 \u51032  \u51088 \u50976 \u51032  \u48177 \u49457 \u51004 \u47196 \u49436  \'93\u51060 \u48120  \u44536 \u46308 \u50640 \u44172  \u50508 \u47140 \u51276 \u44144 \u45208  \u51109 \u52264  \u50508 \u47140 \u51656  \u54616 \u45208 \u45784 \u51032  \u47784 \u46304  \u44600 \u51012  \u46384 \u46972  \u45796  \u54632 \u44760  \u44152 \u50612 \u44032 \u51088 \'94 (J.Brown, The Pligrim Fathers, p.74) \u44256  \u50628 \u49689 \u55176  \u47609 \u49464 \u54632 \u51004 \u47196  \u54632 \u44760  \u44208 \u49549 \u54616 \u50688 \u45796 . \u50668 \u44592 \u50640  \u44060 \u54785 \u51032  \u52280 \u46108  \u51221 \u49888 , \u44263  \u44060 \u49888 \u44368 \u51032  \u51473 \u50836 \u54620  \u50896 \u52825 \u51060  \u45208 \u53440 \u45228 \u45796 . \u51060  \u47785 \u51201 \u51012  \u49457 \u52712 \u54616 \u44592  \u50948 \u54616 \u50668  \u44536  \u49692 \u47168 \u51088 \u46308 \u51008  \u45348 \u45916 \u46976 \u46300 \u47484  \u46496 \u45208  \u49888 \u45824 \u47449 \u51004 \u47196  \u51060 \u51452 \u54616 \u50688 \u45796 .\
