\uc0\u44536  \u55148 \u49373 \u51088 \u46308 \u51008  \u51092 \u51064 \u54620  \u44256 \u47928  \u45149 \u50640  \u51453 \u51076 \u51012  \u45817 \u54616 \u50688 \u45716 \u45936 , \u54868 \u54805 \u51012  \u51665 \u54665 \u54624  \u46412  \u44536 \u46308 \u51032  \u44256 \u53685 \u51012  \u45908 \u50865  \u50672 \u51109 \u49884 \u53412 \u44592  \u50948 \u54616 \u50668  \u44536  \u54868 \u47141 \u51012  \u50557 \u54616 \u44172  \u54616 \u46972 \u45716  \u53945 \u48324 \u54620  \u51648 \u49884 \u44032  \u51452 \u50612 \u51276 \u45796 . \u44536 \u47084 \u45208  \u44536 \u46308 \u51008  \u47560 \u52824  \u49849 \u47532 \u51088 \u46308 \u52376 \u47100  \u51453 \u50632 \u45796 . \u44536 \u46308 \u51032  \u51648 \u51312 \u45716  \u48320 \u54632 \u51060  \u50630 \u50632 \u44256 , \u44536 \u46308 \u51032  \u54217 \u54868 \u50640 \u45716  \u44536 \u45720 \u51060  \u50630 \u50632 \u45796 . \u48149 \u54644 \u51088 \u46308 \u51008  \u44536 \u46308 \u51032  \u54869 \u44256 \u48512 \u46041 \u54620  \u53468 \u46020 \u50640  \u50612 \u52236 \u54624  \u49688  \u50630 \u51020 \u51012  \u50508 \u44256  \u51088 \u49888 \u46308 \u51060  \u54056 \u48176 \u54620  \u44163 \u51012  \u45712 \u45180 \u50632 \u45796 . \'93\u45800 \u46160 \u45824 \u45716  \u54028 \u47532 \u51032  \u47784 \u46304  \u44144 \u47532 \u50640  \u49464 \u50892 \u51648 \u44256  \u54868 \u54805 \u51008  \u45216 \u47560 \u45796  \u44228 \u49549  \u51665 \u54665 \u46104 \u50632 \u45716 \u45936 , \u51060 \u47111 \u44172  \u49324 \u54805 \u51032  \u51665 \u54665 \u51012  \u48177 \u49457 \u46308 \u50640 \u44172  \u48372 \u50668 \u51468 \u51004 \u47196  \u51060 \u45800 \u50640  \u45824 \u54620  \u44277 \u54252 \u49900 \u51012  \u44054 \u44172  \u54616 \u45716  \u44163 \u51060  \u44536  \u47785 \u51201 \u51060 \u50632 \u45796 . \u44536 \u47084 \u45208  \u47560 \u52840 \u45236  \u48373 \u51020 \u51060  \u52572 \u54980 \u51032  \u49849 \u47532 \u47484  \u50619 \u50632 \u45796 . \u54028 \u47532 \u51032  \u47784 \u46304  \u49884 \u48124 \u46308 \u51008  \u51060  \u49352 \u47196 \u50868  \u51452 \u51032 \u44032  \u50612 \u46496 \u54620  \u51333 \u47448 \u51032  \u49324 \u46988 \u51012  \u47564 \u46308 \u50612  \u45244  \u49688  \u51080 \u45716 \u51648 \u47484  \u48380  \u49688  \u51080 \u50632 \u45796 . \u49692 \u44368 \u51088 \u47484  \u54868 \u54805 \u49884 \u53412 \u44592  \u50948 \u54616 \u50668  \u49939 \u50500 \u50732 \u47536  \u51109 \u51089 \u45908 \u48120 \u52376 \u47100  \u51339 \u51008  \u49444 \u44368 \u45800 \u51008  \u45796 \u49884 \u50630 \u50632 \u45796 . \u49324 \u54805  \u51665 \u54665 \u51109 \u51004 \u47196  \u45132 \u47140 \u44040  \u46412 , \u44536  \u49324 \u46988 \u46308 \u51032  \u50620 \u44404 \u50640  \u45208 \u53440 \u45212  \u51312 \u50857 \u54620  \u44592 \u49256 , \u49900 \u54620  \u48520 \u44600  \u49549 \u50640  \u49436  \u51080 \u45716  \u44536 \u46308 \u51032  \u50689 \u50885 \u51201  \u53468 \u46020 , \u47784 \u50837 \u50640  \u45824 \u54620  \u44536 \u46308 \u51032  \u50728 \u50976 \u54616 \u44256  \u44288 \u45824 \u54620  \u50857 \u49436  \u46321 \u51008  \u47566 \u51008  \u49324 \u46988 \u46308 \u51032  \u48516 \u45432 \u47484  \u46041 \u51221 \u51004 \u47196 , \u51613 \u50724 \u47484  \u49324 \u46993 \u51004 \u47196  \u48148 \u44984 \u50612  \u51452 \u50632 \u44256 , \u51200 \u54637 \u54624  \u49688  \u50630 \u45716  \u50885 \u48320 \u51004 \u47196  \u48373 \u51020 \u51012  \u50745 \u54840 \u54616 \u45716  \u48169 \u54200 \u51060  \u46104 \u50632 \u45796 \'94 (Wylie, b.13, ch.20).\
\uc0\u49888 \u48512 \u46308 \u51008  \u45824 \u51473 \u51032  \u48516 \u45432 \u47484  \u51208 \u51221 \u50640  \u51060 \u47476 \u44172  \u54616 \u44256 \u51088  \u45432 \u47141 \u54616 \u50688 \u44256 , \u54532 \u47196 \u53580 \u49828 \u53444 \u53944 \u50640  \u45824 \u54616 \u50668  \u44537 \u46020 \u51032  \u47924 \u49436 \u50868  \u48708 \u45212 \u51012  \u54140 \u48512 \u50632 \u45796 . \u44536 \u46308 \u51008  \u44032 \u53672 \u47533 \u44368 \u46020 \u47484  \u54617 \u49332 \u54616 \u47140 \u44256  \u51020 \u47784 \u54616 \u44256 , \u51221 \u48512 \u47484  \u51204 \u48373 \u49884 \u53412 \u44256 \u51088  \u54616 \u44256 , \u50773 \u51032  \u50516 \u49332 \u51012  \u46020 \u47784 \u54616 \u50688 \u45796 \u45716  \u46321 \u51032  \u51221 \u51396 \u47484  \u48155 \u50520 \u45796 . \u44536 \u47084 \u45208  \u44536 \u50752  \u44057 \u51008  \u51452 \u51109 \u46308 \u51008  \u51204 \u54784  \u44540 \u44144  \u50630 \u45716  \u44163 \u46308 \u51060 \u50632 \u45796 . \u44536 \u47088 \u45936  \u44536 \u52376 \u47100  \u47924 \u49436 \u50868  \u47924 \u44256 \u45716  \u54616 \u45208 \u51032  \u50696 \u50616 \u51004 \u47196  \u49457 \u52712 \u46112  \u44163 \u51060 \u50632 \u45796 . \u44536 \u47084 \u45208  \u44536 \u44163 \u51008  \u54532 \u47196 \u53580 \u49828 \u53444 \u53944 \u47196  \u47568 \u48120 \u50516 \u50500 \u49436 \u44032  \u50500 \u45768 \u44256  \u51204 \u54784  \u45796 \u47480  \u51077 \u51109 \u44284  \u54872 \u44221 \u50640  \u51080 \u45716  \u51088 \u47196  \u47568 \u48120 \u50516 \u50500  \u51204 \u50672  \u45796 \u47480  \u50896 \u51064 \u50640 \u49436  \u44048 \u54665 \u46112  \u44163 \u51060 \u50632 \u45796 . \u44032 \u53672 \u47533 \u51004 \u47196  \u47568 \u48120 \u50516 \u50500  \u51396  \u50630 \u45716  \u54532 \u47196 \u53580 \u49828 \u53444 \u53944 \u50640 \u44172  \u44032 \u54644 \u51652  \u47564 \u54665 \u51008  \u44536  \u48372 \u51025 \u51032  \u47924 \u44172 \u47484  \u45908 \u54616 \u50688 \u45796 . \u44536 \u47532 \u44256  \u54980 \u49464 \u50640  \u51060 \u47476 \u47084  \u51060 \u46412 \u50640  \u44536 \u46308 \u51060  \u50773 \u50640 \u44172  \u45824 \u54616 \u50668 , \u51221 \u48512 \u50640  \u45824 \u54616 \u50668 , \u49888 \u54616 \u46308 \u50640  \u45824 \u54616 \u50668  \u50696 \u50616 \u54620  \u44163 \u51060  \u44536 \u45824 \u47196  \u49457 \u52712 \u46104 \u50632 \u45796 . \u44536  \u51068 \u51008  \u47924 \u49888 \u47200 \u51088 \u46308 \u47196  \u47568 \u48120 \u50516 \u50500 , \u44536 \u47532 \u44256  \u48277 \u50773 \u44368 \u46020  \u51088 \u49888 \u46308 \u47196  \u47568 \u48120 \u50516 \u50500  \u49457 \u52712 \u46104 \u50632 \u45796 . 3\u48177 \u45380  \u54980 \u50640  \u54532 \u46993 \u49828 \u50640  \u44536 \u52376 \u47100  \u48708 \u52280 \u54620  \u51116 \u45212 \u51060  \u52488 \u47000 \u46108  \u44163 \u51008  \u44060 \u54785 \u51452 \u51032 \u51032  \u49688 \u47549  \u46412 \u47928 \u50640  \u46108  \u44163 \u51060  \u50500 \u45768 \u44256  \u44032 \u53672 \u47533 \u52769 \u51060  \u44060 \u54785 \u51452 \u51032 \u47484  \u54605 \u48149 \u54616 \u50688 \u44592  \u46412 \u47928 \u51060 \u50632 \u45796 .\
\uc0\u51060 \u51228  \u51032 \u49900 \u44284  \u48520 \u49888 \u44284  \u44277 \u54252 \u44032  \u49324 \u54924 \u51032  \u47784 \u46304  \u44228 \u52789 \u50640  \u54200 \u47564 \u54644 \u51276 \u45796 . \u51060 \u47084 \u54620  \u44277 \u54252 \u51032  \u46020 \u44032 \u45768  \u49549 \u50640 \u49436  \u44368 \u50577  \u51080 \u44256 , \u49464 \u47141  \u51080 \u44256 , \u54408 \u49457 \u51060  \u44256 \u44208 \u54620  \u49324 \u46988 \u46308 \u51032  \u47560 \u51020 \u49549 \u50640  \u47336 \u53552 \u54028 \u51032  \u44368 \u47532 \u44032  \u50620 \u47560 \u45208  \u44618 \u51060  \u49828 \u47728 \u46308 \u44256  \u51080 \u50632 \u45716 \u51648  \u45208 \u53440 \u45228 \u45796 . \u49888 \u51076 \u44284  \u47749 \u50696 \u47484  \u48155 \u44256  \u51080 \u45912  \u51088 \u47532 \u46308 \u51060  \u44049 \u51088 \u44592  \u48708 \u44172  \u46104 \u50632 \u45796 . \u51649 \u44277 , \u51064 \u49604 \u51064 , \u54617 \u51088 , \u45824 \u54617  \u44368 \u49688 , \u51200 \u49696 \u44032 , \u49900 \u51648 \u50612  \u50773 \u44417 \u50640 \u49436  \u49884 \u51333  \u46300 \u45716  \u49324 \u46988 \u46308 \u44620 \u51648 \u46020  \u47784 \u49845 \u51012  \u44048 \u52628 \u50632 \u45796 . \u51060 \u47532 \u54616 \u50668  \u54728 \u45796 \u54620  \u49324 \u46988 \u51060  \u54028 \u47532 \u47484  \u48260 \u47532 \u44256 , \u44397 \u50808 \u47196  \u54588 \u49888 \u54616 \u50668  \u44048 \u51004 \u47196 \u50024  \u48373 \u51020 \u54028 \u51032  \u49888 \u50521 \u50640  \u45824 \u54616 \u50668  \u54840 \u51032 \u47484  \u44032 \u51648 \u44256  \u51080 \u50632 \u51020 \u51012  \u52376 \u51020 \u51004 \u47196  \u45208 \u53440 \u45236 \u50632 \u45796 . \u48277 \u50773 \u44368 \u46020 \u46308 \u51008  \u44536 \u46308 \u44284  \u44057 \u51060  \u51648 \u45236 \u47732 \u49436  \u51032 \u49900 \u51012  \u48155 \u51648  \u50506 \u44256  \u51648 \u45236 \u50728  \u51060 \u45800 \u51088 \u46308 \u51012  \u49373 \u44033 \u54616 \u44256  \u49352 \u49340 \u49828 \u47101 \u44172  \u44221 \u51060 \u51032  \u45576 \u51004 \u47196  \u44536 \u46308 \u51012  \u48148 \u46972 \u48372 \u50520 \u45796 . \u44536 \u47532 \u54616 \u50668  \u44536 \u46308 \u51032  \u48516 \u45432 \u45716  \u44536 \u46308 \u51032  \u49552 \u50500 \u44480 \u50640  \u46308 \u50612  \u51080 \u45716  \u48372 \u45796  \u48708 \u52380 \u54620  \u45796 \u49688 \u51032  \u48373 \u51020  \u44368 \u46020 \u46308 \u50640 \u44172  \u50143 \u50500 \u51276 \u45796 . \u44048 \u50725 \u51008  \u52264 \u44256  \u45336 \u52452 \u45796 . \u48373 \u51020 \u51012  \u48127 \u45716  \u49324 \u46988 \u46308 \u51012  \u51669 \u48268 \u54616 \u45716  \u54868 \u54805 \u51032  \u50672 \u44592 \u47196  \u54616 \u45720 \u51060  \u50612 \u46160 \u50892 \u51648 \u45716  \u44163 \u52376 \u47100  \u48372 \u50688 \u45796 .\
