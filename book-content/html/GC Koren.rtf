\uc0\u44396 \u49549 \u48155 \u51008  \u49324 \u46988 \u46308 \u51060  \u54616 \u45208 \u45784 \u51032  \u49457 \u51004 \u47196  \u50689 \u51217 \u46112  \u46412 , \u51316 \u44221 \u51032  \u47560 \u51020 \u51004 \u47196  \u44592 \u49240 \u44172  \u50808 \u52824 \u45716  \u49548 \u47532 \u44032  \u44277 \u51473 \u50640  \u52649 \u47564 \u54644 \u51652 \u45796 . \u46160  \u50500 \u45812 \u51008  \u48148 \u50556 \u55120 \u47196  \u49436 \u47196  \u47564 \u45208 \u47140  \u54620 \u45796 . \u54616 \u45208 \u45784 \u51032  \u50500 \u46308 \u51008  \u54036 \u51012  \u48268 \u47532 \u44256  \u49436 \u49436  \u51064 \u47448 \u51032  \u49884 \u51312 , \u44263  \u51452 \u45784 \u44760 \u49436  \u52285 \u51312 \u54616 \u49888  \u51088 \u51060 \u47728  \u52285 \u51312 \u51452 \u44760  \u48276 \u51396 \u54616 \u44256 , \u44536 \u51032  \u51396  \u46412 \u47928 \u50640  \u51452 \u45784 \u51032  \u47800 \u50640  \u49901 \u51088 \u44032 \u51032  \u47803 \u51088 \u44397 \u51012  \u45224 \u44592 \u44172  \u54620  \u44536  \u49884 \u51312 \u47484  \u50504 \u51004 \u47140  \u54616 \u49888 \u45796 . \u51092 \u51064 \u54620  \u47803 \u51088 \u44397 \u51012  \u49885 \u48324 \u54616 \u44256  \u50500 \u45812 \u51008  \u51452 \u45784 \u51032  \u54408 \u50640  \u50504 \u44592 \u47140  \u54616 \u51648  \u50506 \u44256  \u44216 \u49552 \u54616 \u44172  \u51452 \u45784 \u51032  \u48156 \u50500 \u47000  \u44536  \u51088 \u49888 \u51012  \u45912 \u51648 \u44256  \'93\u51453 \u51076 \u51012  \u45817 \u54616 \u49888  \u50612 \u47536 \u50577 \u51060  \u50689 \u44305 \u44284  \u52268 \u49569 \u51012  \u48155 \u51004 \u49884 \u44592 \u50640  \u54633 \u45817 \u54616 \u46020 \u45796 \'94\u44256  \u48512 \u47476 \u51670 \u45716 \u45796 . \u44536 \u47084 \u45208  \u44396 \u51452 \u44760 \u49436 \u45716  \u52828 \u51208 \u54616 \u44172  \u44536 \u47484  \u50504 \u50500  \u51068 \u51004 \u53412 \u49884 \u44256  \u44536 \u44032  \u50724 \u47019 \u46041 \u50504  \u51923 \u44200 \u45208  \u51080 \u45912  \u50640 \u45940 \u51032  \u48376 \u54693 \u51012  \u45796 \u49884  \u54620  \u48264  \u48372 \u46972 \u44256  \u47749 \u47161 \u54616 \u49888 \u45796 .\
\uc0\u50640 \u45940 \u50640 \u49436  \u51923 \u44200 \u45212  \u54980 \u47196  \u50500 \u45812 \u51032  \u49373 \u50528 \u45716  \u49836 \u54548 \u51004 \u47196  \u52649 \u47564 \u54664 \u50632 \u45796 . \u49884 \u46308 \u50612 \u44032 \u45716  \u47784 \u46304  \u45208 \u47943 \u51086 , \u47784 \u46304  \u55148 \u49373  \u51228 \u47932 , \u50500 \u47492 \u45796 \u50868  \u52380 \u50672 \u44228 \u50640  \u45934 \u51060 \u45716  \u47784 \u46304  \u50516 \u50689 , \u51064 \u47448 \u51032  \u49692 \u44208 \u50640  \u45208 \u53440 \u45208 \u45716  \u47784 \u46304  \u50724 \u51216  \u46321 \u51008  \u51088 \u44592 \u51032  \u51396 \u47484  \u49373 \u49373 \u54616 \u44172  \u44592 \u50613 \u45208 \u44172  \u54616 \u45716  \u44163 \u46308 \u51060 \u50632 \u45796 . \u44536 \u44032  \u51396 \u50501 \u51060  \u52649 \u47564 \u54644  \u44032 \u45716  \u44163 \u51012  \u48148 \u46972 \u48380  \u46412  \u48155 \u51008  \u44032 \u52293  \u46412 \u47928 \u50640  \u45817 \u54620  \u48264 \u48124 \u51008  \u47924 \u49436 \u50868  \u44163 \u51060 \u50632 \u45796 . \u44536 \u44032  \u51396 \u47484  \u44221 \u44256 \u54616 \u47732  \u44536 \u45716  \u46020 \u47532 \u50612  \u51396 \u47484  \u45132 \u50612 \u46308 \u51064  \u45817 \u49324 \u51088 \u46972 \u45716  \u48708 \u45212 \u51012  \u48155 \u50520 \u45796 . \u44144 \u51032  1\u52380 \u45380  \u46041 \u50504  \u44536 \u45716  \u44984 \u51456 \u54620  \u44216 \u49552 \u51004 \u47196  \u51396 \u51032  \u54805 \u48268 \u51012  \u48155 \u50520 \u45796 . \u44536 \u45716  \u52649 \u49900 \u51004 \u47196  \u51088 \u44592 \u51032  \u51396 \u47484  \u54924 \u44060 \u54616 \u44256  \u54728 \u46973 \u54616 \u49888  \u44396 \u51452 \u51032  \u44277 \u47196 \u47484  \u51032 \u51648 \u54616 \u44256 , \u48512 \u54876 \u51032  \u49548 \u47581 \u51012  \u44032 \u51648 \u44256  \u51453 \u50632 \u45796 . \u54616 \u45208 \u45784 \u51032  \u50500 \u46308 \u44760 \u49436 \u45716  \u51064 \u47448 \u51032  \u49892 \u54056 \u50752  \u53440 \u46973 \u51012  \u44396 \u49549 \u54616 \u49512 \u45796 . \u44536 \u47084 \u48064 \u47196  \u51060 \u51228  \u49549 \u51396 \u51032  \u49324 \u50629 \u51012  \u53685 \u54616 \u50668  \u50500 \u45812 \u51008  \u52572 \u52488 \u51032  \u53685 \u52824 \u44428 \u51012  \u54924 \u48373 \u54620  \u44163 \u51060 \u45796 .\
\uc0\u50500 \u45812 \u51008  \u44592 \u49256 \u51004 \u47196  \u47784 \u46304  \u44163 \u51012  \u51082 \u50612 \u48260 \u47532 \u44256  \u51068 \u52237 \u51060  \u51088 \u44592 \u51032  \u44592 \u49256 \u51060  \u46104 \u50632 \u45912  \u50668 \u47084  \u44032 \u51648  \u45208 \u47924 \u46308 , \u44263  \u44536 \u44032  \u47924 \u51396 \u54616 \u44256  \u51600 \u44144 \u50912 \u45912  \u49884 \u51208 \u50640  \u49552 \u49688  \u44536  \u44284 \u49892 \u46308 \u51012  \u46388  \u45208 \u47924 \u46308 \u51012  \u51452 \u47785 \u54644  \u48376 \u45796 . \u44536 \u45716  \u51088 \u44592  \u49552 \u51004 \u47196  \u51204 \u51221 \u54620  \u54252 \u46020 \u45208 \u47924 \u46308 \u44284  \u54620  \u46412  \u49324 \u46993 \u54616 \u50668  \u51116 \u48176 \u54616 \u45912  \u54868 \u52488 \u46308 \u51012  \u48376 \u45796 . \u50500 \u45812 \u51008  \u44536 \u44163 \u51060  \u48516 \u47749 \u55176  \u50715 \u45216  \u44163 \u44284  \u44057 \u51008  \u44163 \u51076 \u51012  \u44648 \u45803 \u44256 , \u51221 \u47568 \u47196  \u54924 \u48373 \u46108  \u50640 \u45940 \u51076 \u51012  \u50508 \u44172  \u46104 \u47728 , \u51088 \u44592 \u44032  \u51923 \u44200 \u45216  \u46412 \u48372 \u45796  \u44536 \u44163 \u51060  \u45908 \u50865  \u50500 \u47492 \u45813 \u44172  \u46108  \u44163 \u51012  \u48372 \u44172  \u46108 \u45796 . \u44396 \u51452 \u44760 \u49436 \u45716  \u44536 \u47484  \u49373 \u47749 \u45208 \u47924 \u47196  \u51064 \u46020 \u54616 \u50668  \u48731 \u45208 \u45716  \u44536  \u50676 \u47588 \u47484  \u46384 \u49436  \u50500 \u45812 \u50640 \u44172  \u47673 \u51004 \u46972 \u44256  \u54616 \u49888 \u45796 . \u44536 \u45716  \u51088 \u44592  \u51452 \u50948 \u47484  \u46168 \u47084 \u48372 \u44256  \u54616 \u45208 \u45784 \u51032  \u45209 \u50896 \u50640  \u49436  \u51080 \u45716  \u44396 \u49549 \u48155 \u51008  \u44536 \u51032  \u44032 \u51313 \u51032  \u53360  \u47924 \u47532 \u47484  \u48376 \u45796 . \u44536 \u46412  \u44536 \u45716  \u44536  \u52268 \u46976 \u54620  \u47732 \u47448 \u44288 \u51012  \u48279 \u50612  \u50696 \u49688 \u45784 \u51032  \u48156  \u50526 \u50640  \u45912 \u51648 \u44256 , \u44536 \u48516 \u51032  \u44032 \u49844 \u50640  \u47800 \u51012  \u45912 \u51256  \u44396 \u51452 \u47484  \u54252 \u50745 \u54620 \u45796 . \u44536 \u45716  \u54889 \u44552  \u44144 \u47928 \u44256 \u47484  \u53444 \u45796 . \u44536 \u47084 \u51088  \u49849 \u47532 \u51032  \u45432 \u47000 \u44032  \u54616 \u45720  \u44277 \u44036 \u50640  \u50872 \u47140  \u54140 \u51652 \u45796 . \'93\u51453 \u51076 \u51012  \u45817 \u54616 \u49888  \u50612 \u47536 \u50577 \u51060  \u50689 \u44305 \u44284  \u52268 \u49569 \u51012  \u48155 \u51004 \u49884 \u44592 \u50640  \u54633 \u45817 \u54616 \u46020 \u45796 .\'94 \u50500 \u45812 \u51032  \u44032 \u51313 \u51008  \u51452 \u45784 \u44760  \u44221 \u48176 \u54624  \u46412  \u45432 \u47000 \u47484  \u48512 \u47476 \u47728  \u44396 \u51452 \u51032  \u48156  \u50526 \u50640  \u44536 \u46308 \u51032  \u47732 \u47448 \u44288 \u51012  \u48279 \u50612  \u45912 \u51652 \u45796 .\
\uc0\u50500 \u45812 \u51032  \u53440 \u46973 \u51012  \u48372 \u44256  \u45576 \u47932 \u51012  \u55128 \u47532 \u44256 , \u50696 \u49688 \u45784 \u44760 \u49436  \u48512 \u54876 \u54616 \u50668  \u49849 \u52380 \u54616 \u49892  \u46412  \u44592 \u48848 \u54616 \u44256 , \u50696 \u49688 \u45784 \u51032  \u51060 \u47492 \u51012  \u48127 \u44172  \u46112  \u47784 \u46304  \u49324 \u46988 \u46308 \u51012  \u50948 \u54616 \u50668  \u47924 \u45924 \u51012  \u50676 \u50612  \u51456  \u52380 \u49324 \u46308 \u51008  \u51060  \u51116 \u54924  (\u20877 \u26371 ) \u47484  \u47785 \u44201 \u54620 \u45796 . \u51060 \u51228  \u44536 \u46308 \u51008  \u44396 \u49549  \u49324 \u50629 \u51032  \u49457 \u52712 \u47484  \u48372 \u44256 , \u49548 \u47532 \u47484  \u54633 \u54616 \u50668  \u52268 \u50577 \u51032  \u45432 \u47000 \u47484  \u48512 \u47480 \u45796 .\
\'93\uc0\u51664 \u49849 \u44284  \u44536 \u51032  \u50864 \u49345 \u44284  \u44536 \u51032  \u51060 \u47492 \u51032  \u49688 \u47484  \u51060 \'94\u44596  \u51088 \u46308 \u51032  \u47924 \u47532 \u44032  \u48372 \u51340  \u50526 \u50640  \u51080 \u45716  \u49688 \u51221 \u44057 \u51060  \u47569 \u51008  \u48148 \u45796 , \u48520 \u51060  \u49438 \u51064  \u50976 \u47532 \u48148 \u45796 , \u54616 \u45208 \u45784 \u51032  \u50689 \u44305 \u51004 \u47196  \u52268 \u46976 \u54616 \u44172  \u48731 \u45208 \u45716  \u48148 \u45815 \u44032 \u50640  \u47784 \u51064 \u45796 . \u46405 \u50640 \u49436  \u44396 \u49549 \u48155 \u51008  \u49901 \u49324 \u47564  \u49324 \u52380  \u47749 \u51008  \u54616 \u45208 \u45784 \u51032  \u44144 \u47928 \u44256 \u47484  \u49552 \u50640  \u46308 \u44256  \u50612 \u47536 \u50577 \u44284  \u54632 \u44760  \u49884 \u50728 \u49328 \u50640  \u49440 \u45796 . \'93\u47566 \u51008  \u47932 \u49548 \u47532 \u46020  \u44057 \u44256  \u53360  \u45516 \u49457 \u46020  \u44057 \u51008 \'85\u44144 \u47928 \u44256  \u53440 \u45716  \u51088 \u46308 \u51032  \u44536  \u44144 \u47928 \u44256  \u53440 \u45716 \'94 \u49548 \u47532 \u44032  \u46308 \u47536 \u45796 . \u44536 \u47532 \u44256  \u44536 \u46308 \u51008  \u48372 \u51340  \u50526 \u50640 \u49436  \'93\u49352  \u45432 \u47000 \'94\u47484  \u48512 \u47480 \u45796 . \u44536  \u45432 \u47000 \u45716  \u49901 \u49324 \u47564  \u49324 \u52380  \u47749  \u50808 \u50640 \u45716  \u50500 \u47924 \u46020  \u48176 \u50872  \u49688  \u50630 \u45716  \u45432 \u47000 \u51060 \u45796 . \u44536 \u44163 \u51008  \u47784 \u49464 \u50752  \u50612 \u47536 \u50577 \u51032  \u45432 \u47000 , \u44263  \u44396 \u50896 \u51032  \u45432 \u47000 \u51060 \u45796 . \u44536  \u45432 \u47000 \u45716  \u49901 \u49324 \u47564  \u49324 \u52380  \u47749  \u50808 \u50640  \u50500 \u47924 \u46020  \u48512 \u47484  \u49688  \u50630 \u45716  \u45432 \u47000 \u51060 \u45796 . \u50780 \u45264 \u54616 \u47732  \u44536 \u44163 \u51008  \u44536 \u46308 \u51032  \u52404 \u54744 \u51032  \u45432 \u47000 , \u44263  \u45796 \u47480  \u50612 \u46500  \u49324 \u46988 \u46020  \u52404 \u54744 \u54616 \u51648  \u47803 \u54620  \u44221 \u54744 \u51032  \u45432 \u47000 \u51060 \u44592  \u46412 \u47928 \u51060 \u45796 . \u44536 \u46308 \u51008  \'93\u50612 \u47536 \u50577 \u51060  \u50612 \u46356 \u47196  \u51064 \u46020 \u54616 \u46304 \u51648  \u46384 \u46972 \u44032 \u45716  \u51088 \u47728 \'94, \u49332 \u50500  \u51080 \u45716  \u51088 \u46308  \u44032 \u50868 \u45936 \u49436  \u46405 \u51004 \u47196 \u48512 \u53552  \u45132 \u50612 \u50732 \u47548 \u51012  \u48155 \u51008  \u49324 \u46988 \u46308 \u51060 \u45796 . \u44536 \u46308 \u51008  \'93\u52376 \u51020  \u51061 \u51008  \u50676 \u47588 \u47196  \u54616 \u45208 \u45784 \u44284  \u50612 \u47536 \u50577 \u50640 \u44172  \u49549 \u54620  \u51088 \u46308 \'94 (\u44228  15:2, 3, 14:1~5) \u51060 \u45796 . \u46608 \u54620  \'93\u51060 \u45716  \u53360  \u54872 \u45212 \u50640 \u49436  \u45208 \u50724 \u45716  \u51088 \u46308 \'94\u51060 \u45796 . \u44536 \u46308 \u51008  \u44060 \u44397  \u51060 \u47000 \u47196  \u44536 \u46412 \u44620 \u51648  \u50630 \u45912  \u54872 \u45212 \u51032  \u49884 \u44592 \u47484  \u51648 \u45236 \u44256 , \u50556 \u44273 \u51032  \u54872 \u45212 \u51012  \u44204 \u46356 \u50612  \u54616 \u45208 \u45784 \u51032  \u49900 \u54032 \u44284  \u54805 \u48268 \u51060  \u47560 \u51648 \u47561 \u51004 \u47196  \u45236 \u47540  \u46412  \u51473 \u48372 \u51088  \u50630 \u51060  \u49440  \u51088 \u46308 \u51060 \u45796 . \u44536 \u47084 \u45208  \u44536 \u46308 \u51008  \'93\u50612 \u47536 \u50577 \u51032  \u54588 \u50640  \u44536  \u50743 \u51012  \u50491 \u50612  \u55148 \u44172  \u54616 \u50688 \'94\u51004 \u48064 \u47196  \u44396 \u50896 \u51012  \u50619 \u51008  \u51088 \u46308 \u51060 \u45796 . \u44536 \u46308 \u51008  \'93\u44536  \u51077 \u50640  \u44144 \u51667 \u47568 \u51060  \u50630 \u44256 \'94 \u54616 \u45208 \u45784  \u50526 \u50640  \'93\u55136 \u51060  \u50630 \u45716  \u51088 \u46308 \'94\u51060 \u45796 . \'93\u44536 \u46308 \u51060  \u54616 \u45208 \u45784 \u51032  \u48372 \u51340  \u50526 \u50640  \u51080 \u44256  \u46608  \u44536 \u51032  \u49457 \u51204 \u50640 \u49436  \u48164 \u45230  \u54616 \u45208 \u45784 \u51012  \u49452 \u44592 \u47588  \u48372 \u51340 \u50640  \u50505 \u51004 \u49888  \u51060 \u44032  \u44536 \u46308  \u50948 \u50640  \u51109 \u47561 \u51012  \u52824 \'94\u49892  \u44163 \u51060 \u45796 . \u44536 \u46308 \u51008  \u51060  \u49464 \u49345 \u51060  \u44592 \u44540 \u44284  \u51656 \u48337 \u51004 \u47196  \u54889 \u54224 \u54644 \u51648 \u44256 , \u53468 \u50577 \u51060  \u49900 \u54620  \u50676 \u47196  \u49324 \u46988 \u46308 \u51012  \u53468 \u50864 \u45716  \u44305 \u44221 \u51012  \u47785 \u44201 \u54616 \u44256 , \u44536 \u46308  \u49828 \u49828 \u47196 \u46020  \u44256 \u53685 \u44284  \u44592 \u44040 \u51012  \u45817 \u54616 \u50688 \u45796 . \u44536 \u47084 \u45208  \u51060 \u51228 \u45716  \'93\u51200 \u55148 \u44032  \u45796 \u49884  \u51452 \u47532 \u51648 \u46020  \u50500 \u45768 \u54616 \u47728  \u47785 \u47560 \u47476 \u51648 \u46020  \u50500 \u45768 \u54616 \u44256  \u54644 \u45208  \u50500 \u47924  \u46888 \u44144 \u50868  \u44592 \u50868 \u50640  \u49345 \u54616 \u51648  \u50500 \u45768 \u54624 \u51648 \u45768  \u51060 \u45716  \u48372 \u51340  \u44032 \u50868 \u45936  \u44228 \u49888  \u50612 \u47536 \u50577 \u51060  \u51200 \u55148 \u51032  \u47785 \u51088 \u44032  \u46104 \u49324  \u49373 \u47749 \u49688  \u49368 \u51004 \u47196  \u51064 \u46020 \u54616 \u49884 \u44256  \u54616 \u45208 \u45784 \u44760 \u49436  \u51200 \u55148  \u45576 \u50640 \u49436  \u47784 \u46304  \u45576 \u47932 \u51012  \u50491 \u50612  \u51452 \u49892  \u44163 \u51076 \u51060 \u47084 \u46972 \'94 (\u44228  14:5, 7:14~17).\
