\uc0\u50696 \u50616 \u51008  \u51664 \u49849 \u44284  \u44536  \u50864 \u49345 \u50640 \u44172  \u44221 \u48176 \u54616 \u45716  \u51088 \u46308 \u50640 \u44172  \u44221 \u44256 \u54620  \u54980 , \'93\u49457 \u46020 \u46308 \u51032  \u51064 \u45236 \u44032  \u50668 \u44592  \u51080 \u45208 \u45768  \u51200 \u55148 \u45716  \u54616 \u45208 \u45784 \u51032  \u44228 \u47749 \u44284  \u50696 \u49688  \u48127 \u51020 \u51012  \u51648 \u53412 \u45716  \u51088 \u45768 \u46972 \'94\u44256  \u47568 \u54620 \u45796 . \u51060 \u50752  \u44057 \u51060  \u54616 \u45208 \u45784 \u51032  \u44228 \u47749 \u51012  \u51648 \u53412 \u45716  \u51088 \u50752  \u51664 \u49849 \u44284  \u44536  \u50864 \u49345 \u51012  \u44221 \u48176 \u54616 \u44256  \u44536  \u54364 \u47484  \u48155 \u45716  \u51088 \u47484  \u45824 \u51312 \u51201 \u51004 \u47196  \u44592 \u47197 \u54620  \u44163 \u51012  \u48372 \u47732  \u54616 \u45208 \u45784 \u51012  \u44221 \u48176 \u54616 \u45716  \u51088 \u50752  \u51664 \u49849 \u51012  \u44221 \u48176 \u54616 \u45716  \u51088 \u51032  \u44396 \u48324 \u51060  \u54616 \u45208 \u45784 \u51032  \u44228 \u47749 \u51012  \u51648 \u53412 \u45716  \u44163 \u44284  \u48276 \u54616 \u45716  \u45936  \u51080 \u45716  \u44163 \u51060  \u48516 \u47749 \u54616 \u45796 .\
\uc0\u51664 \u49849 \u51032  \u53945 \u51669 \u44284 , \u46041 \u49884 \u50640  \u44536  \u50864 \u49345 \u51032  \u53945 \u51669 \u51060  \u46104 \u45716  \u44163 \u51008  \u54616 \u45208 \u45784 \u51032  \u44228 \u47749 \u51012  \u44648 \u46888 \u47532 \u45716  \u44163 \u51060 \u45796 . \u45796 \u45768 \u50648 \u51008  \u51089 \u51008  \u49108  \u44263  \u48277 \u50773 \u44428 \u50640  \u45824 \u54616 \u50668  \'93\u44536 \u44032  \u46608  \u46412 \u50752  \u48277 \u51012  \u48320 \u44060 \u53076 \u51088  \u54624  \u44163 \u51060 \u46972 \'94 (\u45800  7:25) \u44256  \u47568 \u54620 \u45796 . \u48148 \u50872 \u51008  \u44536  \u46041 \u51068 \u54620  \u49464 \u47141 \u51012  \u54616 \u45208 \u45784 \u48372 \u45796  \u51088 \u44592 \u47484  \u45458 \u51060 \u44256 \u51088  \u54620  \'93\u48520 \u48277 \u51032  \u49324 \u46988 \'94\u51060 \u46972 \u44256  \u48520 \u47104 \u45796 . \u44536  \u46160  \u50696 \u50616 \u51008  \u49436 \u47196  \u48372 \u50756 \u54644  \u51456 \u45796 . \u48277 \u50773 \u44428 \u51008  \u50724 \u51649  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51012  \u48320 \u44221 \u49884 \u53428 \u51004 \u47196 \u50024  \u51088 \u49888 \u51012  \u54616 \u45208 \u45784 \u48372 \u45796  \u45458 \u51068  \u49688  \u51080 \u50632 \u45796 . \u44536 \u47532 \u44256  \u45572 \u44396 \u46304 \u51648  \u51060 \u50752  \u44057 \u51060  \u48320 \u44221 \u46108  \u50984 \u48277 \u51064  \u44163 \u51012  \u50508 \u47732 \u49436 \u46020  \u44536 \u44163 \u51012  \u51456 \u49688 \u54616 \u45716  \u51088 \u45716  \u44536  \u50984 \u48277 \u51012  \u48320 \u44221 \u49884 \u53416  \u51088 \u50640 \u44172  \u52572 \u49345 \u51032  \u50689 \u44305 \u51012  \u46028 \u47532 \u45716  \u49480 \u51060 \u45796 . \u51060 \u50752  \u44057 \u51060  \u48277 \u50773 \u44428 \u51032  \u50984 \u48277 \u51012  \u49692 \u51333 \u54616 \u45716  \u54665 \u50948 \u45716  \u54616 \u45208 \u45784  \u45824 \u49888 \u50640  \u48277 \u50773 \u50640 \u44172  \u49692 \u51333 \u54616 \u45716  \u54364 \u44032  \u46104 \u45716  \u44163 \u51060 \u45796 .\
\uc0\u48277 \u50773 \u44428 \u51008  \u54616 \u45208 \u45784 \u51032  \u50984 \u48277 \u51012  \u48320 \u44221 \u49884 \u53412 \u44256 \u51088  \u54616 \u50688 \u45796 . \u50864 \u49345  \u50696 \u48176 \u47484  \u44552 \u51648 \u54616 \u45716  \u46168 \u51704  \u44228 \u47749 \u51008  \u50984 \u48277 \u50640 \u49436  \u51228 \u54616 \u50668  \u48260 \u47532 \u44256 , \u45367 \u51704  \u44228 \u47749 \u51008  \u50504 \u49885 \u51068 \u51012  \u51228 \u52832 \u51068  \u45824 \u49888 \u50640  \u51228 \u51068 \u51068 \u51032  \u51456 \u49688 \u47484  \u51064 \u51221 \u54616 \u45716  \u44163 \u52376 \u47100  \u44256 \u52432  \u48260 \u47160 \u45796 . \u44536 \u47084 \u45208  \u48277 \u50773 \u44368 \u46020 \u46308 \u51008  \u46168 \u51704  \u44228 \u47749 \u51012  \u49325 \u51228 \u54620  \u51060 \u50976 \u50640  \u45824 \u54616 \u50668  \u44536 \u44163 \u51060  \u52395 \u51704  \u44228 \u47749 \u50640  \u54252 \u54632 \u46104 \u50612  \u51080 \u51004 \u48064 \u47196  \u48520 \u54596 \u50836 \u54616 \u45796 \u45716  \u44163 \u44284  \u44536 \u46308 \u51060  \u54616 \u45208 \u45784 \u44760 \u49436  \u51060 \u54644 \u49884 \u53412 \u44256 \u51088  \u50896 \u54616 \u49884 \u45716  \u44536 \u45824 \u47196  \u50984 \u48277 \u51012  \u47560 \u47144 \u54644  \u51452 \u44256  \u51080 \u45796 \u44256  \u51452 \u51109 \u54620 \u45796 . \u44536 \u47088 \u45936  \u51060 \u44163 \u51008  \u49440 \u51648 \u51088 \u44032  \u50696 \u50616 \u54620  \u48320 \u44221 \u51060 \u46972 \u44256  \u47568 \u54624  \u49688 \u45716  \u50630 \u45796 . \u44536 \u47084 \u45208  \u44228 \u54925 \u51201 \u51060 \u50836  \u44256 \u51032 \u51201 \u51004 \u47196  \u48320 \u44221 \u54616 \u45716  \u51068 \u51060  \u51080 \u51012  \u44163 \u51012  \u45796 \u51020 \u44284  \u44057 \u51060  \u47568 \u54616 \u44256  \u51080 \u45796 . \'93\u44536 \u44032  \u46608  \u46412 \u50752  \u48277 \u51012  \u48320 \u44060 \u53076 \u51088  \u54624  \u44163 \u51060 \'94\u46972 . \u45367 \u51704  \u44228 \u47749 \u51032  \u48320 \u44221 \u51008  \u48148 \u47196  \u51060  \u50696 \u50616 \u51060  \u51221 \u54869 \u54616 \u44172  \u49457 \u52712 \u46108  \u44163 \u51060 \u45796 . \u51060 \u47084 \u54620  \u48320 \u44221 \u50640  \u45824 \u54616 \u50668  \u44536 \u46308 \u51060  \u51452 \u51109 \u54616 \u45716  \u50976 \u51068 \u51032  \u44428 \u50948 \u45716  \u44368 \u54924 \u51032  \u44428 \u50948 \u51060 \u45796 . \u51060  \u51216 \u50640 \u49436  \u48277 \u50773 \u51032  \u44428 \u49464 \u45716  \u44536  \u51088 \u49888 \u51012  \u54616 \u45208 \u45784 \u48372 \u45796  \u44277 \u44277 \u50672 \u54616 \u44172  \u45908  \u45458 \u51060 \u44256  \u51080 \u45796 .\
\uc0\u54616 \u45208 \u45784 \u51012  \u44221 \u48176 \u54616 \u45716  \u51088 \u45716  \u54616 \u45208 \u45784 \u51032  \u52285 \u51312 \u47141 \u51032  \u54364 \u51669 \u51060 \u50836  \u54616 \u45208 \u45784 \u44760 \u49436  \u51064 \u47448 \u50640 \u44172  \u51316 \u44221 \u44284  \u44221 \u48176 \u47484  \u50836 \u44396 \u54616 \u49884 \u45716  \u51613 \u44144 \u44032  \u46104 \u45716  \u45367 \u51704  \u44228 \u47749 \u51012  \u51316 \u51473 \u55176  \u50668 \u44592 \u45716  \u53468 \u46020 \u47196 \u50024  \u44536 \u46308 \u51032  \u53945 \u51669 \u51012  \u46748 \u47159 \u54616 \u44172  \u46300 \u47084 \u45236 \u45716  \u48152 \u47732 \u50640 , \u51664 \u49849 \u51012  \u44221 \u48176 \u54616 \u45716  \u51088 \u46308 \u51008  \u52285 \u51312 \u51032  \u44592 \u45392 \u51068 \u51064  \u50504 \u49885 \u51068 \u51012  \u51667 \u48159 \u44256  \u47196 \u47560 \u44368 \u44032  \u47564 \u46304  \u51228 \u46020 \u47484  \u45458 \u51060 \u44256 \u51088  \u45432 \u47141 \u54632 \u51004 \u47196  \u44536  \u53945 \u51669 \u51012  \u45208 \u53440 \u45236 \u44172  \u46112  \u44163 \u51060 \u45796 . \u48277 \u50773 \u51060  \u52376 \u51020 \u51004 \u47196  \u51088 \u44592 \u51032  \u44536  \u44144 \u47564 \u54620  \u51452 \u51109 \u51012  \u54616 \u44172  \u46108  \u44163 \u51008  \u51068 \u50836 \u51068 \u51012  \u50948 \u54632 \u51060 \u50632 \u44256  (\u48512 \u47197  33 \u52280 \u51312 ), \u46608 \u54620  \u44397 \u44032 \u51032  \u44428 \u47141 \u50640  \u51032 \u47280 \u54620  \u44163 \u46020  \u49324 \u49892 \u51008  \u51068 \u50836 \u51068 \u51012  \u51452 \u51068 \u47196  \u51648 \u53412 \u46020 \u47197  \u44053 \u50836 \u54616 \u44592  \u50948 \u54632 \u51060 \u50632 \u45796 . \u44536 \u47084 \u45208  \u49457 \u44221 \u50640  \u51452 \u51068 \u51060 \u46972 \u44256  \u54620  \u44163 \u51008  \u51228 \u52832 \u51068 \u51012  \u44032 \u47532 \u53416  \u44163 \u51060 \u50836 , \u51228 \u51068 \u51068 \u51012  \u44032 \u47532 \u53416  \u44163 \u51060  \u44208 \u53076  \u50500 \u45768 \u45796 . \u44536 \u47532 \u49828 \u46020 \u44760 \u49436 \u45716  \'93\u51064 \u51088 \u45716  \u50504 \u49885 \u51068 \u50640 \u46020  \u51452 \u51064 \u51060 \u45768 \u46972 \'94\u44256  \u47568 \u50432 \u54616 \u49512 \u45796 . \u45367 \u51704  \u44228 \u47749 \u50640 \u45716  \'93\u51228 \u52832 \u51068 \u51008  \u45320 \u51032  \u54616 \u45208 \u45784  \u50668 \u54840 \u50752 \u51032  \u50504 \u49885 \u51068 \'94\u51060 \u46972 \u44256  \u46104 \u50612  \u51080 \u45796 . \u44536 \u47532 \u44256  \u51452 \u45784 \u44760 \u49436 \u45716  \u49440 \u51648 \u51088  \u51060 \u49324 \u50556 \u47484  \u53685 \u54616 \u50668  \u44536 \u45216 \u51012  \'93\u45236  \u49457 \u51068 \'94\u51060 \u46972 \u44256  \u54616 \u49888 \u45796  (\u47561  2:28; \u49324  58:3).\
